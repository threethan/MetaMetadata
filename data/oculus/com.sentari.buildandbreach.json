nc_sid=6e7a0a&_nc_ohc=1KYuc6t40cMQ7kNvwFhkDbT&_nc_oc=AdrGR28ARe-70g0Wqbac2vypEXn9DuAmSzdQNSr5ENlcR-6O7-8NkC7xu4c9T4XbxRA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m1Vd4agpXZIP_EP77rzsp3ZvDjCAjJ1TAhWcVPCC2TA&oe=6A01F5FE"}, {"file_name": "Debrief.png", "id": "762054886950830", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_762054890284163_1698398193266029600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkWqfCrrqlMQ7kNvwFf9jWK&_nc_oc=AdrS_KIY1MbYw9NWItCCtrUUrvtY_FLLAF09pMCfFlXPgRnXozm8T0DOPnIAKqQ_T0M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ooLb_Fmq42SsFKfF-Qqwo0MwAr24dxUvoAR9Sk4Colg&oe=6A01CF0F"}, {"file_name": "WeaponVariety.png", "id": "904392862075806", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_904392865409139_7994271531177102502_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDdVzZKIy9UQ7kNvwE85FRi&_nc_oc=AdqJ9wDzIsuoSE-C-0h4xhq1EYp0dCTyjjr0p9tQI4ygtZ31jhpHZXWVKCusgEZzFVY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49AjPgoBnQnxffAxhOFH_UsO1l2ava6BYkF-MzmpbSYw&oe=6A01F8C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Build And Breach CQB", "keywords": [], "long_description": "\u200b\u200bBUILD & BREACH CQB is a mixed-reality close-quarters battle (CQB) simulator that lets you design and clear tactical environments inside your real-world space.\nUsing passthrough mixed reality, you can place walls, doors, furniture, and obstacles directly into your physical environment to create custom CQB layouts. Every object is anchored to the real world using spatial anchors, meaning your rooms stay locked in place even if you remove the headset or hand it to another user. This allows multiple people to experience the exact same scenario in the same physical space.\nBefore each run, you build the battlefield. Design tight hallways, doorways, and room layouts to create realistic clearing challenges. When the scenario begins, hostile AI units populate the environment and engage you as you move through your physical space. Enemies take cover, react to movement, and force you to clear rooms methodically using proper angles, positioning, and timing.\nWeapons feature realistic handling, requiring you to aim, reload, and manage your firearm under pressure. Every doorway is dangerous, every corner matters, and no two runs play the same.\nBuild & Breach is built for CQB enthusiasts who want a serious, immersive close-quarters battle sandbox that turns their own environment into the battlefield.\nBuild it.\nBreach it.\nClear it.", "short_description": "Build & Breach is a mixed-reality CQB simulator that lets you turn your real-world space into a fully customizable combat environment with Mixed Reality. Design rooms, place doors and furniture, and run dynamic clearing drills against AI threats \u2014 all inside your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25316770294646681"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PU
499296288_911361778159474_2938811641857589033_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KRfUPno3a0Q7kNvwHac_Os&_nc_oc=AdrrJBT1NL3vGIPnNCK5rRAPskW59sMQYqoAZbTPSCLuhacN21gN_1Dxq70KNslD4C4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCFrL72gl4l8LRY-q-Vy9vlnbMpRYqiZ3lg2HmyHOgUw&oe=6AF1F267"}, {"file_name": "cf26b02d9fc34647bfef51630f4f4320_2560x1440.png", "id": "935951815915965", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293669_935951819249298_7309390341385885752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5bWIr6gxMcQ7kNvwHh0rfB&_nc_oc=Adr233zOTYcJ7yzrmXQHi5e6jwJEc9t4nKkiCpcP_r8JGRJvPLH0ZXgyliygvWowFrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO1ysSP8yFaI0eibyOIYONWAu_XhdpuFvT8Kr9_Sdhdg&oe=6AF1FE47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Horizontal Thumbnail.png", "id": "1568157238688292", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623534_1568157242021625_5845514094167699709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLPdYzcP7uQQ7kNvwF2-PNM&_nc_oc=AdqsjqY9kDCBkDVk6IkPNKFw0jhybFGdX78ekvy3tlL-j8iSyYgKzXrnf1o7OAFxxaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjFkLn9yTQdBhmKo1RmwFgDSqc681nhkzat2YoxxZd-A&oe=6AF1F934"}, "display_name": "Build And Breach CQB", "keywords": ["CQB", "Tactical", "Shooting", "Military", "Training"], "long_description": "MAJOR UPDATE: Multiplayer is here.\n\nTry before you buy \u2014 play 15 minutes FREE and keep your progress if you purchase.\n\nBuild And Breach CQB turns your real-world space into a mixed-reality shoot house. Now you can clear rooms with another player in multiplayer, build custom layouts, place doors and furniture, generate randomized rooms, and take on AI threats together.\n\nFEATURES:\n- NEW: Multiplayer CQB \u2014 clear rooms with another player\n- Try 15 minutes FREE \u2014 progress carries over\n- Build and clear in your own real-world space\n- Randomized rooms for a different challenge every run\n- Place walls, doors, furniture, threats, and civilians\n- Multiple weapons and customizable loadouts\n- After-action review to analyze your run\n- Desktop app for additional building and tracking\n\nMultiplayer marks one of the biggest updates to Build And Breach CQB yet, expanding the game from solo room clearing into shared mixed-reality CQB.", "short_description": "Build, Breach, Engage. Try 15 minutes FREE and keep your progress if you buy. Turn your real-world space into a mixed-reality CQB shoot house. Build rooms, place doors and furniture, then clear AI threats solo or with your squad."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "28567905426199802"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620669_2160107708223340_5536449045186371994_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EHF2n7WAVUQ7kNvwGpShqR&_nc_oc=AdokMR4EyzfAxSwX9oXeEEq5ng3wnq8O1HqSgURjbE_8SRVL2uVm4GTePoGpk_rJbUo&_nc_zt=3&_nc_
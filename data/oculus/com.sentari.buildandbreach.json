wGm566O&_nc_oc=Ado_2Z4N9fe_fWeeMvwdXbW1W2-YStxgIeEJ8oplx4CtUm7BhPUmKNHn8WAv1KpiymY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONL0EtDWkiOnVBV6Du2wxSo2YgsK9iC5rWMUMRpLTjZw&oe=6AD39478"}, {"file_name": "BuildScene.png", "id": "1398877545309622", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499296123_1398877548642955_8554524778501526515_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olaDVdHOvEQQ7kNvwFWY3Mw&_nc_oc=Adrl7Crxgutajq3Yb9sFNM5pwZre8UY4wCYC7VO7lAdexusmuZtnwqZ8c_voGpSydTQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVTbVhrNfkheuE0DfUS5ZvL9bfRKJqtASCs-A9MQhk0Q&oe=6AD39635"}, {"file_name": "HandleUnknowns.png", "id": "2014570772775827", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307435_2014570776109160_3095425153663162056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzSpFc2OAvMQ7kNvwFBFAX7&_nc_oc=AdqRP8uc5iR4Ybfqsx68P3pTOm4wKh88cqp4DyfIkZsSjDa0RvhxPqaNFLKGSOp2rDs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOsbL5_px1e0B7MbnRNLct8nxrdJCYp84DL5CNCVS1uA&oe=6AD3947E"}, {"file_name": "Debrief.png", "id": "762054886950830", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296119_762054890284163_1698398193266029600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsHSNvEuQEQQ7kNvwHhXxz7&_nc_oc=Adq1_FA_SKv25Q3Wa8C3bZ6NKcNKomHDi0aWCH1rhr-Ts0hXvWda5MYw6eFq0GaHYuY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP1_yhWVFwDWqdFJR5qVV2M6gsjv01w-ZN3w7vN2-vtA&oe=6AD3A5CF"}, {"file_name": "WeaponVariety.png", "id": "904392862075806", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499296119_904392865409139_7994271531177102502_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXuQcWEuCz0Q7kNvwFgY-Pi&_nc_oc=Adrecpq5cVhF-XIWs6pj75O8LKNugvfLWfSFx14Zl3K32lR87VKGJwAAfRw3trOL_NA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEsNT_rkbT2IAiLJ9kHLEGuNfuGvfBjFZevFTuxsIvHw&oe=6AD39742"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Build And Breach CQB", "keywords": [], "long_description": "\u200b\u200bBUILD & BREACH CQB is a mixed-reality close-quarters battle (CQB) simulator that lets you design and clear tactical environments inside your real-world space.\nUsing passthrough mixed reality, you can place walls, doors, furniture, and obstacles directly into your physical environment to create custom CQB layouts. Every object is anchored to the real world using spatial anchors, meaning your rooms stay locked in place even if you remove the headset or hand it to another user. This allows multiple people to experience the exact same scenario in the same physical space.\nBefore each run, you build the battlefield. Design tight hallways, doorways, and room layouts to create realistic clearing challenges. When the scenario begins, hostile AI units populate the environment and engage you as you move through your physical space. Enemies take cover, react to movement, and force you to clear rooms methodically using proper angles, positioning, and timing.\nWeapons feature realistic handling, requiring you to aim, reload, and manage your firearm under pressure. Every doorway is dangerous, every corner matters, and no two runs play the same.\nBuild & Breach is built for CQB enthusiasts who want a serious, immersive close-quarters battle sandbox that turns their own environment into the battlefield.\nBuild it.\nBreach it.\nClear it.", "short_description": "Build & Breach is a mixed-reality CQB simulator that lets you turn your real-world space into a fully customizable combat environment with Mixed Reality. Design rooms, place doors and furniture, and run dynamic clearing drills against AI threats \u2014 all inside your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://ww
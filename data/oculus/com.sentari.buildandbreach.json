=6AF9EB62"}]}, "id": "1755637032175888", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2026-10-18 at 23.05.57.png", "id": "1081612658017640", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620316_1081612661350973_999627746394716909_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euLfZP_SUX4Q7kNvwH35LVf&_nc_oc=Adpy_sugo_ZSXic5ETa20fg7XZai6XM4LoZRPTOGAs5oBFuChlSS3TTRJz78hFHQ0no&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9u2rIXhd4C0VYDfs2SPU1OZwYLSkM_FF2xIWBVFtjzg&oe=6AF9C82F"}, {"file_name": "Screenshot 2026-09-30 at 15.04.07.png", "id": "1431075528447544", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623551_1431075531780877_1544016155164020523_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10o-qD0iuoIQ7kNvwFw6qFN&_nc_oc=Adqfc_ATl2yLLL1i58oMHHUSSgWG42KG5-NS4C_nCcW_Ww53kti2ClOeYEOV9fLaJR8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1j-dPgdsIJ9yba-Xlz8Ovm0FSxZfKSaXqpSdmzWL4Cg&oe=6AF9BC09"}, {"file_name": "Screenshot 2026-09-30 at 15.06.13.png", "id": "1073215405693457", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620341_1073215409026790_3770892558860514772_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_k894OrWTjIQ7kNvwGnDcFx&_nc_oc=AdqWw66Nl3nx4rVnRrMJkvwRQjpkSUC7ctS43iEoFqAH3m694uymVDeTY1M0zVu6Owg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTe90YS8zdC76erSkXK2F_p1ZeAGE82mZEld3F4wN5fg&oe=6AF9E5A8"}, {"file_name": "Screenshot 2026-08-09 at 22.54.34.png", "id": "911361774826141", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296288_911361778159474_2938811641857589033_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eItkDyBA_kQQ7kNvwEI-twF&_nc_oc=AdrH9XvG-uBHM6pIzU1h82hQhVvl2D05tovRqaVwgCPkXLrdxfcvZoudjlwV-0ZZ0i0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7D6kHTx4ppZKYvfFcDsdxX14VvRCzHOrKowUsJJisDQ&oe=6AF9DB67"}, {"file_name": "cf26b02d9fc34647bfef51630f4f4320_2560x1440.png", "id": "935951815915965", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499293669_935951819249298_7309390341385885752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-W-5C3tGRAUQ7kNvwFPx_Gp&_nc_oc=AdpY6WmewEoBaOmgw_OxjRik4NJi9yw3qiAy_FvfzfGrY59r8kOT0WF_E4ZGZCUyphQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiS4yR-G0V26bqdEpWzCtiMlNQ53SzU2bqfERe4SfVdg&oe=6AF9E747"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Horizontal Thumbnail.png", "id": "1568157238688292", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623534_1568157242021625_5845514094167699709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAjQgKqq8rcQ7kNvwGJy_H5&_nc_oc=AdpuCQlBKIsYt7BtQhAtEQ43lgeUDDqGKSxBNgT3R8EzwmZHsA6PW8ktHsvzDlZ3Dic&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzTNN3eILUYfvE3vGiIb6ssNE-s8XZG8pUucXedim4IA&oe=6AF9E234"}, "display_name": "Build And Breach CQB", "keywords": ["CQB", "Tactical", "Shooting", "Military", "Training"], "long_description": "Your house just became a shoot house.\n\nBuild And Breach CQB turns any room into a CQB mission in seconds. Stack on a real door, pie the corner, and breach. Nobody knows what's waiting on the other side.\n\nTry it FREE for 15 minutes. Your progress carries over if you buy.\n\nNEW IN 4.2\n\n- DAILY DRILL: one new mission a day, the same for everyone. PASS or FAIL, and see where you rank worldwide.\n- AAR WALKTHROUGH: relive the run at full size or as a mini model. Every shot, grenade, command and hit is marked. Squads review it together.\n- SECURE THE HOUSE: flex-cuff the innocents. It isn't clear until they're secured.\n- KNIFE HOSTILES: hands up while you're out of reach, then a charge the moment they see a way in.\n- VR MODE: no clear space? Switch to VR and move with the joystick through houses, offices and public buildings.\n- 100 STANDARD ROOMS, from a single center-fed room to full floor plans.\n\nBUILD IT. Draw walls, doors and windows in your space, add furniture and people, or let Fish Bowl throw a new random house at you every round.\n\nRUN IT. Hostiles fight from cover, civilians panic, and voice commands run on your headset. Go in on night vision. Rounds tear through drywall.\n\nSQUADS. Up to four players online from their own homes, with built-in voice chat.\n\nNo range. No facility. No excuses.\n\nRequires Meta Quest 3 or 3S. Mixed reality needs a clear play space; VR mode does not. Squads and the Daily Drill need an internet connection.\n\nBUILD & BREACH: TRAIN ANYWHERE, ANYTIME.", "short_description": "Your house just became a shoot house. Try 15 minutes FREE and keep your progress if you buy. Build And Breach CQB turns any room into a full CQB mission: stack on a real door, pie the corner, and breach. New in 4.2: a Daily Drill with a worldwide leaderboard, knife-wielding hostiles, flex-cuffing innocents, and an AAR Walkthrough that replays every run at full size or as a mini model. Play in mixed reality, or switch to VR with joystick movement. Solo or with an online squad of four."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], 
1-25/499304019_1492253485331426_5178619988882450914_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcY_SmmZKpUQ7kNvwG3SctQ&_nc_oc=AdpALT2iZR0pb9DKyMmgaNjxdyEQhMXm5rd6-TV9hBWP5lnB1odoWtYSzUjcmAOp3YQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyff1mjXnr6oenMSa1r4XW8ZbVo8Froa-wFSYlUHboiA&oe=6A857AEC"}, {"file_name": "3bb013e172c44d4e9d7cf256b1b420b8_2560x1440.png", "id": "1738130940497601", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499296069_1738130947164267_7604684690823882842_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLESKX2--O8Q7kNvwHb4IFv&_nc_oc=AdqDB4QFnfrV_5nYWm1p-FW7Fb2PSvswMGvi3DGjF_37kDSjMwAuyT09C92vUX6cEzY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZoKjOVXHrf3tLxwgFkbotjDAx2SgjUUe1DhfuPS958g&oe=6A857DCD"}, {"file_name": "bc2e99649e2b4797922cd2a4240c307d_2560x1440.png", "id": "4192047904373073", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499302344_4192047907706406_6073202627614621304_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbeQj6q21hUQ7kNvwGkrQb0&_nc_oc=Adr4Y_CvN1w4TdVpQfd3OfdmPDWnIA24yzsva7r7T6Ocv0vYsLWX6IilwNQmSeq6114&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxNLN_7yPQT_ZFIaP1H4_GKuxNzzIL73MhNb5-Pq44_w&oe=6A857FBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "B&B_logo_Wide.png", "id": "2309081742952119", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499296397_2309081746285452_6990029419969732399_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nGmTYTj5v4Q7kNvwE-GyxS&_nc_oc=AdpI2fzzsp1J799uysMMIm2FxqLoRV8uAIULeYoWPbtPnfvJHRpnCow0ghp3T_s9bXM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJQkQrcudn7mac8FAvV32q7m1zmt3f4HSQ4dbAmGJ8PQ&oe=6A85821A"}, "display_name": "Build And Breach CQB", "keywords": [], "long_description": "BUILD & BREACH CQB is a mixed-reality close-quarters battle (CQB) simulator that lets you design and clear tactical environments inside your real-world space.\n\nUsing passthrough mixed reality, you can place walls, doors, furniture, and obstacles directly into your physical environment to create custom CQB layouts. Scene understanding allows the simulator to recognize your real-world walls and surfaces, so AI and virtual structures interact naturally with your environment. Every object is anchored to the real world using spatial anchors, meaning your rooms stay locked in place even if you remove the headset or hand it to another user. This allows multiple people to experience the exact same scenario in the same physical space.\n\nBefore each run, you build the virtual shoot house. Design tight hallways, doorways, and room layouts to create realistic clearing challenges.\n\nWhen the scenario begins, hostile AI units populate the environment and engage you as you move through your physical space. Enemies react to movement, and force you to clear rooms methodically using proper angles, positioning, and timing.\n\nWeapons feature realistic handling, requiring you to aim and manage your firearm under pressure. Every doorway is dangerous, every corner matters, and no two runs play the same.\n\nBuild & Breach is built for CQB enthusiasts who want a serious, immersive close-quarters battle sandbox that turns their own environment into a virtual shoot house.\n\nBuild it.\nBreach it.\nReps on repeat.", "short_description": "Build & Breach is a mixed-reality CQB simulator that turns your real-world space into a customizable virtual shoot house. Build rooms, place doors and furniture, and clear dynamic AI threats inside your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category":
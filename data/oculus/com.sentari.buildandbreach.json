oc=Adr_NRxWMduWT5X2KEEMzJmJvYMLTL0-PPzgPuy2On7dEIz-dSGaelxy4_Wp0-LePko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIOn3273s4WkFO5MRT_7HnEknEhxDsq8VdtI2MajI7Uw&oe=6AAFDB07"}, {"file_name": "Screenshot 2026-09-11 at 13.14.31.png", "id": "1591326562637477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620630_1591326565970810_3981099872679886338_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr3L3l-ysT0Q7kNvwEMOMcr&_nc_oc=AdowU9XRMF7POQC0SBHcSAd6tvgHu_m_HZgBrOwkpPBj2swuEa-QNLtqlsbYVWaIhO4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4Cr5BHSKFFEbvygfElsB50WPTt81iIrO4UnmrT7wWeg&oe=6AB00768"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "B&BLogoWide.png", "id": "1024219917275333", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593854747_1024219920608666_5680279520874119006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1viD-41xlpAQ7kNvwELarYE&_nc_oc=AdojuJEx2u58zRozZLGhW5yBqZGdZrS3C0EQxD2fW5rS6aIv_Lrz11SaGBA7BiGyhw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTAg2gFH_VFJ8a6nvjHG7a85y1iAP-f4qV0BmGg4jzaQ&oe=6AB00033"}, "display_name": "Build And Breach CQB", "keywords": ["CQB", "Tactical", "Shooting", "Military", "Training"], "long_description": "With BUILD & BREACH CQB, turn your living room, garage, backyard, office, or training space into a room-clearing CQB environment in seconds. Build a layout, grab your weapon, stack on a door, clear rooms, identify threats, and run it again with a completely different scenario.\n\nBuild scenarios directly inside the headset by placing walls, doors, furniture, obstacles, and NPCs. Or use the free Build & Breach Builder companion desktop app to create custom rooms on your computer and send them directly to the headset.\n\nScan your real environment and use its actual walls, furniture, and objects as part of the scenario, then add virtual elements on top to create the layout you want.\n\nCustomize NPC behaviors for different situations, or generate randomized rooms to train against layouts you have never seen before.\n\nMove through your actual space, work angles, clear doorways, identify threats, and make decisions under pressure. Save, modify, replay, and review scenarios for repeatable training without a fixed virtual map or dedicated facility.\n\nBuild it. Run it. Review it. Improve it.\n\nBUILD & BREACH\n\nTRAIN ANYWHERE, ANYTIME.\n", "short_description": "Build & Breach is a mixed-reality CQB simulator that turns your real-world space into a customizable virtual shoot house. Build rooms, place doors and furniture, and clear AI threats inside your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28098401996483483"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593849888_1801865407900354_678590114598848857_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBCmfVRXitgQ7kNvwHyxuc3&_nc_oc=AdoZk11WOs-mV5RdijRGm4S8kEfaHQ2EULg49-LFxFhRK5_lfM87lvJDsMZ8MOQxadc&_
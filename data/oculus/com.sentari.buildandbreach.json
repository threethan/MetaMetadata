gTyCGVF0ZJJx0mqf38oCnNRvhA8MKfeEUlLhSXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6iFHNIITyCCMiFavEmYZg5MamulbjCn0-nlrxrOoPMQ&oe=6AF49B4F"}, {"file_name": "WeaponVariety.png", "id": "904392862075806", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_904392865409139_7994271531177102502_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50RMbdHqK-0Q7kNvwE-ukUp&_nc_oc=AdoyfdGyTplzcIqxjk43DrdanJBHztvyGNoFuAn_1EntBfzFvj5ZUK4pWDh-vjcZ4eY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMUQjHXLK6876-Xjpov_TRHi2pTvkH8rf4JdvWUAKOBg&oe=6AF48CC2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Build And Breach CQB", "keywords": [], "long_description": "\u200b\u200bBUILD & BREACH CQB is a mixed-reality close-quarters battle (CQB) simulator that lets you design and clear tactical environments inside your real-world space.\nUsing passthrough mixed reality, you can place walls, doors, furniture, and obstacles directly into your physical environment to create custom CQB layouts. Every object is anchored to the real world using spatial anchors, meaning your rooms stay locked in place even if you remove the headset or hand it to another user. This allows multiple people to experience the exact same scenario in the same physical space.\nBefore each run, you build the battlefield. Design tight hallways, doorways, and room layouts to create realistic clearing challenges. When the scenario begins, hostile AI units populate the environment and engage you as you move through your physical space. Enemies take cover, react to movement, and force you to clear rooms methodically using proper angles, positioning, and timing.\nWeapons feature realistic handling, requiring you to aim, reload, and manage your firearm under pressure. Every doorway is dangerous, every corner matters, and no two runs play the same.\nBuild & Breach is built for CQB enthusiasts who want a serious, immersive close-quarters battle sandbox that turns their own environment into the battlefield.\nBuild it.\nBreach it.\nClear it.", "short_description": "Build & Breach is a mixed-reality CQB simulator that lets you turn your real-world space into a fully customizable combat environment with Mixed Reality. Design rooms, place doors and furniture, and run dynamic clearing drills against AI threats \u2014 all inside your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25316770294646681"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1651550899755819"}, {"status": "PUBLISHED", "id": "988604444282224"}, {"status": "PUBLISHED", "id": "1439432625026033"}, {"status": "CANCELLED", "id": "1101783745813429"}, {"status": "PUBLISHED", "id": "1062258036203483"}, {"status": "PUBLISHED", "id": "1276486661330252"}]}, "baseline_offer": {"id": "1439432625026033"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1651550899755819"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28857133903943618", "version": "4.2.0"}, "id": "1302681891616081", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28857133903943618"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "4.2.0\n\n\u2022 Daily Drill: a new mission every day, the same for everyone, with a PASS/FAIL result and a worldwide leaderboard.\n\u2022 AAR Walkthrough: replay any run at full size or as a mini model, with tracers, grenade arcs, callouts and the hostiles' weapons. In squads, the host walks everyone through it together.\n\u2022 Secure innocents: order hands behind backs and flex-cuff them. Innocents must be secured to pass.\n\u2022 New enemy: knife hostiles who put their hands up while they can't reach you, then charge the moment they can.\n\u2022 VR mode on Quest 3 and 3S: no passthrough, joystick movement and turning, Guardian on. Choose MR or VR at launch.\n\u2022 100 Standard Rooms in five tabs, including full house floor plans and public buildings, now with windows and counters.\n\u2022 Every NPC voice now has its full set of lines.\n\u2022 Rifle rounds stay on their line through wall joints.\n\u2022 Steadier guns while you move, and the muzzle no longer pushes into walls.\n\u2022 Fish Bowl's random houses are furnished like real rooms.\n\u2022 Night vision shadows are softer and easier to see into.", "created_date": 1793999707, "id": "28857133903943618", "version": "4.2.0", "version_code": 417, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28857133903943618"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793946048, "id": "28848122021511473", "version": "4.2.0", "version_code": 416, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28857133903943618"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793765603, "id": "28817841551206187", "version": "4.2.0", "version_code": 410, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28857133903943618"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793563533, "id": "28785521291104880", "version": "4.2.0", "version_code": 394, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28857133903943618"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "4.1.0\n\n- New headset builder. Draw walls, rooms, doors and windows right in your space, then add furniture and people. Snap to a grid or place freely, undo anything, and see the whole house as a mini model.\n- 60 Standard Rooms. A library of classic CQB rooms and houses, from a single center-fed room to full houses. Play them as they are or open them in the builder and make them yours.\n- Templates with pictures. Start from an apartment, hallway, L-shaped house and more.\n- Place people with a behavior. Hostile, innocent, fake surrender or random, each marked with its color on the floor, plus patrol routes they walk.\n- Save and reopen your houses, trace your own room, and move the whole house to fit your space.\n- Squad Fish Bowl fixes, and menus that recover on their own if a click is missed.", "created_date": 1793114434, "id": "28712126758444334", "version": "4.1.0", "version_code": 353, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
PpHfsrMSCrNxBkmWuedpGauCA9I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LwIY6cW2yEKVch04YQ6bdwCmR8OJDD_l1YMPrSuqIqw&oe=6A3544BE"}, {"file_name": "screenshot 5.png", "id": "884450261280726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307931_884450264614059_446958265150437450_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpmA9mG-i3gQ7kNvwEiHD4W&_nc_oc=AdomkTvSYXEbtmCi7LOYi6iBVJcVVoYoIB-8aar0J3YfCoWqHK8g69w0e2X2S3BFta0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OawXzSYvJ8gLpJRu-Mk7P5MTNP31f_roqG3YaqFr3xw&oe=6A355C5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "979348921293240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619486_979348924626573_8765760940081526137_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Osumfcmkd5cQ7kNvwEgyCCC&_nc_oc=Adr8juFeDeDy1g2EXnajckq2IhS3OMjfn4RYZIDfy0t5KqEUWGE6mAphzdy8BGgcMxs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OFO9VsqQ2HaURKNBgaCvO98V22OsOITSC4Trw-UkasA&oe=6A3544D9"}, "display_name": "Fluid: Guest Pass", "keywords": [], "long_description": "# Join your friends in Fluid for free.\n\nFluid: Guest Pass lets you jump into multiplayer rooms with friends at **no cost**. Hang out together in a shared virtual space, use your **Meta avatar**, and watch videos or shared screens on the virtual Smart TV.\n\nGuest Pass is the free social companion to Fluid. It\u2019s designed for joining friends, socializing, and taking part in the room experience.\n\n# With Guest Pass, you can:\n- join friends in multiplayer rooms\n- socialize and hang out together in VR\n- use your Meta avatar\n- watch shared videos and screens on the virtual Smart TV\n# With Guest Pass, you can\u2019t:\n- access the full Fluid app experience\n- create your own rooms\n- use Fluid\u2019s full browser and entertainment features\n- host the complete premium experience available in Fluid", "short_description": "Fluid: Guest Pass lets you join friends in multiplayer rooms for free. Hang out in VR, use your Meta avatar, and watch shared videos and screens together on the virtual Smart TV. Guest Pass is made for socializing and joining the room experience, without access to the full Fluid app and its premium features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": null, "website_url": "https://www.fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26831506853108514"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303088_1459087869030806_9019624289568653391_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTONfjT8tcYQ7kNvwF0TgQs&_nc_oc=AdqUOSxrnv-E0FjxaVotE6jFxFFoisa1Ei1WI05YruOO2lw_-opa41q2xSEOyTSnlfw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DMbbP20enuKQmVjQnl5qmSq9XQm0AFAshVOoOrdHrdQ&oe=6A35736D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fluid: Guest Pass", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Community"
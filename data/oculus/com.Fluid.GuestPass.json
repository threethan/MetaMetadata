cNh3BV5IfuUIqfVwBLu1iwsBeAI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnyPY_mAbw8skWtMgcK3LrF50rfjafge3SOwgfE7J7mg&oe=6A918DBE"}, {"file_name": "screenshot 5.png", "id": "884450261280726", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499307931_884450264614059_446958265150437450_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUoXVtC7ACcQ7kNvwGRiLe7&_nc_oc=Adp-9zfp9kGq1WpXbHeuvzySMhRfSb4Y4jl9um5KoTSxb3Av4-nFu55MyFXzBX0IwgY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPFtQbiI24xUHPP3KoWxjX6Qwyyzcp5YMKKcvaGP7wCg&oe=6A916D1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "979348921293240", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619486_979348924626573_8765760940081526137_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5M-ePx7PsqAQ7kNvwFIZ9d3&_nc_oc=AdoU3Rmp4mugBJy5uHm3fcKV8mHq3tMjXYOaDULAxSXexVhuVYTrqNniH2e8RB1AeWI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv057KLQsQaatPw4NMvamoLsLjFbYZ_4fneYRCjnKhgQ&oe=6A918DD9"}, "display_name": "Fluid: Guest Pass", "keywords": [], "long_description": "# Join your friends in Fluid for free.\n\nFluid: Guest Pass lets you jump into multiplayer rooms with friends at **no cost**. Hang out together in a shared virtual space, use your **Meta avatar**, and watch videos or shared screens on the virtual Smart TV.\n\nGuest Pass is the free social companion to Fluid. It\u2019s designed for joining friends, socializing, and taking part in the room experience.\n\n# With Guest Pass, you can:\n- join friends in multiplayer rooms\n- socialize and hang out together in VR\n- use your Meta avatar\n- watch shared videos and screens on the virtual Smart TV\n# With Guest Pass, you can\u2019t:\n- access the full Fluid app experience\n- create your own rooms\n- use Fluid\u2019s full browser and entertainment features\n- host the complete premium experience available in Fluid", "short_description": "Fluid: Guest Pass lets you join friends in multiplayer rooms for free. Hang out in VR, use your Meta avatar, and watch shared videos and screens together on the virtual Smart TV. Guest Pass is made for socializing and joining the room experience, without access to the full Fluid app and its premium features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": null, "website_url": "https://www.fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26831506853108514"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499303088_1459087869030806_9019624289568653391_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yTBOUVYbdMQ7kNvwE6go9C&_nc_oc=AdpP10lm1q1vIWCnOI4WxOB4hsd7CTxXLa3A3Y5eRnfnAlBb0_sfVGI1D2xf2XNAt88&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKSVusCXT5EyR1DjHhiOKA4atSA2nrWqyryl1klgGqHg&oe=6A91842D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fluid: Guest Pass", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Community"
ether on the virtual Smart TV. Guest Pass is made for socializing and joining the room experience, without access to the full Fluid app and its premium features."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fluid.so/privacy", "developer_terms_of_service_url": "https://www.fluid.so/tos", "publisher_name": "Fluid", "support_website_url": null, "website_url": "https://www.fluid.so/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26831506853108514"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303088_1459087869030806_9019624289568653391_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9Hg70vlehwQ7kNvwEd9AVu&_nc_oc=Adp7d04mltJmL9VrKSg6RWRMKXlZ7l52zowvieMQ7ef322-8XVPowEDm1Pckt0L35VY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1pzzkDSGvAForYqN9T5b4UiAZ2s996ri7LUe00Zpdo9Q&oe=69F0AD2D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fluid: Guest Pass", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Community", "id": "1228796255027646"}, {"topic_name": "Events", "id": "2687655338230691"}], "release_date": 1775754900, "lastRevision": {"nodes": [{"id": "26831506906
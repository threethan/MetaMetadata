.oculuscdn.com/v/t64.5771-25/38984462_353827197661024_7863538524918513822_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-0yUJhwpwMQ7kNvwGNYxt9&_nc_oc=AdqnPdDRF8h1qpEff1LuRiP0grUGA-T5qDSsFZ5iDi7WOBharb47MN2DKczs6cAOTow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsT2QPoVUzbNBJVsyxkw7x0kWy3qBvgKtMt5P3FBgbNQ&oe=6A649CFD"}, {"file_name": "2560x1440-screenshot (30).png", "id": "1144667879939297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_1144667883272630_6614204905845258840_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2wDmnLw59EQ7kNvwHHojs8&_nc_oc=AdqmtKso7weqY3wt-GhfLUx50tg2lP-jaRl1PfvFPPcrOBIqx_p-UftINcpp3IEheIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeP5wpV3d2pglcN0-A46VE4cgBrN_e_TcEg9APZMDZHQ&oe=6A64AB3D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Driven", "keywords": ["racing", "arcade", "simulation", "immersive", "action"], "long_description": "# Immersive first person racing on the Meta Quest 2 & 3.\n\n- Compete against AI to gain credits to purchase cars and gain access to races. Win the race to be added to the Global Leaderboards.\n\n- Take part in Time Trials - navigate obstacles and get the fastest time on the Global Leaderboard.\n\n- Challenging Race Series - take part in a number of races to win the Race Series - 30 Race Series in total\n\n- Over 200 races to complete\n- Over  30 cars to collect\n- Multiplayer \n- Freeroam\n\nDriven is a physics-based \"simcade\" racing game incorporating realistic car-handling and aerodynamics.\n\n- Virtual steering and automatic or manual transmission.\n\n- 3 AI difficulty levels - extra credits awarded for racing against Pro AI & Reckless AI\n\nUpdated graphics for Quest 3\n\n- Damage feature\n\nTake to the track and have fun!", "short_description": "Immersive first person racing on the Meta Quest 2 & 3\n\nCompete against AI to gain credits to purchase cars and gain access to over 200 races. Win the race to be added to Global Leaderboards\n\nTake part in Time Trial mode navigating obstacles - get on the Leaderboard\n\nVirtual steering and automatic/manual transmission.\n3 AI difficulty levels - extra credits awarded for racing against Pro AI\n\nUpdated graphics for Quest 3\nDamage feature"}]}, "developer_name": "MK1", "developer_privacy_policy_url": "https://mk1vrracing.wixsite.com/driven", "developer_terms_of_service_url": null, "publisher_name": "MK1", "support_website_url": null, "website_url": "https://mk1vrracing.wixsite.com/driven", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25644555078505919"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031471_2290369157975931_964263671362916422_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AY8LeXIB1iMQ7kNvwHnfo0d&_nc_oc=Adoow1QcsPiQ3zR8Ti-IBXWw9MMSNuHd4GZBQa2VsCRAB50SYlYtN0LVTCzp-0eH7fI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpPYjharDityooXXe-IEs73RfifoiY769qbQq5kk91TQ&oe=6A64B507"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Driven", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id
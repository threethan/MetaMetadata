_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zg034g082HsQ7kNvwGTIhnM&_nc_oc=Ado2DWPT5_T8L0INHq1iXDzoMOEJLOYlLYhQC68S9kB_a24h6Av3yuSk_GSeaJOamag&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcqjc0mUWHBA3Fr86VvFEqxjj3CKaSNR1c2AXuz42f3Q&oe=6A940139"}, {"file_name": "RB Screenshot 4.png", "id": "26847484398183393", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75258662_26847484408183392_8129976340003056997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POv03N3SNCIQ7kNvwGEZaE2&_nc_oc=Adq6y__G257iMOo5RQhbnmFz7bTuQTIx_-HS8beqRiIm0xTJO2tQKPHIy-LD7cZ-qxM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-XQ23GLwzi9gsPlyoIYmfq0Ox_9Nt4ukkbzHqS4NzJg&oe=6A94177C"}, {"file_name": "Rumble - Classes.png", "id": "1908803792959002", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75280177_1908803796292335_2622630954260888299_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbo92paZCBUQ7kNvwHlkEkY&_nc_oc=AdrZoWHhhvEpdt1Oq5JgN6VK2BAheD66azvwK5C87z7iV4kK_uF1HuJKPzEA3eqYrlY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7yC2ddS46r85lQquis8L-OFs0XK3jjwbVK3X9TFsxUg&oe=6A940417"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RB - Cover - Landscape.png", "id": "897678472185993", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031354_897678475519326_3611105663611776785_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03xTIQNGE7EQ7kNvwFbo7NE&_nc_oc=Adr8MYvSV6HNOh3b7BU6w1vOLtr_HK_S9dunE-CRiIXqJGTSV9dNs_t0y6zGeWVrzdk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC8thaOz4lgK-OHaC107NvubkzDFQ4obib2DMMmX0d4g&oe=6A940440"}, "display_name": "Rumble Boxing", "keywords": [], "long_description": "Step into the ring with Rumble Boxing on Meta Quest, the ultimate virtual reality experience for the most popular boxing workout. Perfect for boxing enthusiasts and VR fitness fans alike, our app offers a dynamic range of workouts, including shadow boxing, high-intensity interval training (HIIT), and strength training, all designed to boost your strength, endurance, and confidence.\n\n**Key Features:**\n\n- **Immersive Boxing Experience:** Enter a virtual boxing studio that puts you right in the action, offering a realistic and engaging workout environment.\n\n- **Dynamic Workouts:** Experience a variety of workouts, from shadow boxing and HIIT to strength training, each tailored to push your limits and keep you motivated.\n\n- **Expert Trainers:** Learn from top trainers who provide expert guidance and encouragement, ensuring a fun and effective workout.\n\n- **High-Intensity Sessions:** Challenge yourself with high-energy workouts that blend cardio, strength, and boxing techniques to maximize results.\n\n- **Customizable Workouts:** Choose the intensity and duration of your workouts to fit your fitness goals and schedule.\n\nUnleash your inner fighter with Rumble Boxing on Meta Quest. Embrace the power of boxing, enhance your skills, and achieve your fitness goals with innovative virtual reality workouts. Step into the ring and unleash your potential\u2014your journey to becoming a champion starts here!\n{457292033938611}", "short_description": "Unleash your inner fighter with Rumble Boxing on Meta Quest! As the most popular boxing workout, Rumble brings you an immersive VR experience with shadow boxing, HIIT, and strength training. Led by top trainers, our dynamic classes are designed to boost your strength, endurance, and confidence. Whether you're a boxing enthusiast or a VR fitness fan, Rumble delivers a knockout workout that transforms your routine. Step into the ring and get ready to rumble!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": n
_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMkvy3c2PU8Q7kNvwFki8Q5&_nc_oc=AdplE6Yhqtg3Jrk_6E6CLMsQAAj1g_z2FzMX2E7zIzgWeQksT8vhzxHAX4wxmnLHVhQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2mIqJebrj7zlxVLWh8zDvySzStMZ8NJhmy4KcSUfrAQ&oe=6AC25DF9"}, {"file_name": "RB Screenshot 4.png", "id": "26847484398183393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258662_26847484408183392_8129976340003056997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6Y78D-QwFkQ7kNvwF4V8EM&_nc_oc=Adr2gdYu6Ej2b6eDRFqu1OHvVaYHu7QAwU5v8lVm1Ms2KSQiwgFm9OP9T4dDaXk-n-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMi5kJJAQ3JbUnU-qB3o5XBCkv_39bvQzxurXbxJpwOdA&oe=6AC2743C"}, {"file_name": "Rumble - Classes.png", "id": "1908803792959002", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75280177_1908803796292335_2622630954260888299_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bf5wuIrO-8QQ7kNvwFydEuU&_nc_oc=Adrs2na9jrmp0fU6rbgpIAKO4xPVpDhpcNKxjPdwTNfPe_AmEtM0iTr0DHi91v0OBgM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0I1uPzjmK_yYHkxH_Zzi0BHnxlYEza3tLdZAa8g5gSQ&oe=6AC260D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RB - Cover - Landscape.png", "id": "897678472185993", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031354_897678475519326_3611105663611776785_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_kh8IpMqo4Q7kNvwHLrvB-&_nc_oc=AdpR7mtghHkGMP834RdhEDOTXxR6OKdObI7g5zwvwYTCx7uxRJKvSkrIDXuz52bMmOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM97-l1tbbrjKzcbTmOiogd_9k5vQZmoVLX3P8_qaQWJQ&oe=6AC26100"}, "display_name": "Rumble Boxing", "keywords": [], "long_description": "Step into the ring with Rumble Boxing on Meta Quest, the ultimate virtual reality experience for the most popular boxing workout. Perfect for boxing enthusiasts and VR fitness fans alike, our app offers a dynamic range of workouts, including shadow boxing, high-intensity interval training (HIIT), and strength training, all designed to boost your strength, endurance, and confidence.\n\n**Key Features:**\n\n- **Immersive Boxing Experience:** Enter a virtual boxing studio that puts you right in the action, offering a realistic and engaging workout environment.\n\n- **Dynamic Workouts:** Experience a variety of workouts, from shadow boxing and HIIT to strength training, each tailored to push your limits and keep you motivated.\n\n- **Expert Trainers:** Learn from top trainers who provide expert guidance and encouragement, ensuring a fun and effective workout.\n\n- **High-Intensity Sessions:** Challenge yourself with high-energy workouts that blend cardio, strength, and boxing techniques to maximize results.\n\n- **Customizable Workouts:** Choose the intensity and duration of your workouts to fit your fitness goals and schedule.\n\nUnleash your inner fighter with Rumble Boxing on Meta Quest. Embrace the power of boxing, enhance your skills, and achieve your fitness goals with innovative virtual reality workouts. Step into the ring and unleash your potential\u2014your journey to becoming a champion starts here!\n{457292033938611}", "short_description": "Unleash your inner fighter with Rumble Boxing on Meta Quest! As the most popular boxing workout, Rumble brings you an immersive VR experience with shadow boxing, HIIT, and strength training. Led by top trainers, our dynamic classes are designed to boost your strength, endurance, and confidence. Whether you're a boxing enthusiast or a VR fitness fan, Rumble delivers a knockout workout that transforms your routine. Step into the ring and get ready to rumble!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": n
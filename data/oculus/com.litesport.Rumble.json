FE0Xkhc0AQ7kNvwG8Xsce&_nc_oc=AdqWcRJCRQGph6H2LRTa2IfErYPU0pZFdTRZC0B03mDj8SuOsmc0lcCBl70SGB9WxHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUyma-rYVcHEqpWecuXS0c-x58HpKoYXjRUyY0TSZFQwQ&oe=6B103BBE"}, {"file_name": "Rumble - Home.png", "id": "2680906275414060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036671_2680906278747393_9145551252642424708_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTCHc-Vo8DAQ7kNvwFeCjXh&_nc_oc=AdqSWPTDUR9J0arPIVblRAtszvXOS0RGRXtIi3kZ7BvBI7lAPSt7z2wP9zL4R07M020&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVz1vfNWmmfiQbkXjlzS6Q80fIm7B03JD6gcuH63eUYIg&oe=6B105EB9"}, {"file_name": "RB Screenshot 4.png", "id": "26847484398183393", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258662_26847484408183392_8129976340003056997_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qp3yB2k78m0Q7kNvwFneTaF&_nc_oc=AdrV6RBiCzaYg8P2A2EAjbWodvArc0V_XEDmqmeDS3-NVfXHw7m1RiYhslFNW4hLopQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXdK0KX60PgOcwQQkSsmk37ZnAqPcroQfF9QPpW0vBDxQ&oe=6B103CBC"}, {"file_name": "Rumble - Classes.png", "id": "1908803792959002", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75280177_1908803796292335_2622630954260888299_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2sNUWMb9fsQ7kNvwHIHF91&_nc_oc=AdqsgfCN2sA70iiU3xJXD5cvAFl-8gmzpR29IqnYYk5fLQua-hZ32f7cKZfutHATbxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVH61BKblOCkQBBQ6ietmnOg5561TiwBdK19cdRAymnSQ&oe=6B106197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RB - Cover - Landscape.png", "id": "897678472185993", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031354_897678475519326_3611105663611776785_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zB5HEpVMKdcQ7kNvwHVF1Xv&_nc_oc=Adphpv3uy9AqOEr544mp0lmxydBeIAYtULqcraERy_csqzBnBWDpnBkffYZe4ssQJf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXBqY17TzbVu_wBprC5hATddj_2LA-jluJNUB_ses27Og&oe=6B1061C0"}, "display_name": "Rumble Boxing", "keywords": [], "long_description": "Step into the ring with Rumble Boxing on Meta Quest, the ultimate virtual reality experience for the most popular boxing workout. Perfect for boxing enthusiasts and VR fitness fans alike, our app offers a dynamic range of workouts, including shadow boxing, high-intensity interval training (HIIT), and strength training, all designed to boost your strength, endurance, and confidence.\n\n**Key Features:**\n\n- **Immersive Boxing Experience:** Enter a virtual boxing studio that puts you right in the action, offering a realistic and engaging workout environment.\n\n- **Dynamic Workouts:** Experience a variety of workouts, from shadow boxing and HIIT to strength training, each tailored to push your limits and keep you motivated.\n\n- **Expert Trainers:** Learn from top trainers who provide expert guidance and encouragement, ensuring a fun and effective workout.\n\n- **High-Intensity Sessions:** Challenge yourself with high-energy workouts that blend cardio, strength, and boxing techniques to maximize results.\n\n- **Customizable Workouts:** Choose the intensity and duration of your workouts to fit your fitness goals and schedule.\n\nUnleash your inner fighter with Rumble Boxing on Meta Quest. Embrace the power of boxing, enhance your skills, and achieve your fitness goals with innovative virtual reality workouts. Step into the ring and unleash your potential\u2014your journey to becoming a champion starts here!\n{457292033938611}", "short_description": "Unleash your inner fighter with Rumble Boxing on Meta Quest! As the most popular boxing workout, Rumble brings you an immersive VR experience with shadow boxing, HIIT, and strength training. Led by top trainers, our dynamic classes are designed to boost your strength, endurance, and confidence. Whether you're a boxing enthusiast or a VR fitness fan, Rumble delivers a knockout workout that transforms your routine. Step into the ring and get ready to rumble!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8107154449303333"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8449966878355420", "version": "1.0.97"}, "id": "1099240471924312", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8107154439303334", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8449966878355420"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1728064473, "id": "8844148905603880", "version": "1.
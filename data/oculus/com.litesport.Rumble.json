_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_86g9BDxUKsQ7kNvwHs0t6r&_nc_oc=AdqxHMC69u_cegYcIVbDpnD2CP6s9Mwi0dEttvMaK24yAD9_cNhxHQkYJHAEOzvA9Lk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-84uKLel8vsXycozb3Xb4MNFyL_nDiFtQfv29ZwzmsKQ&oe=6A47C279"}, {"file_name": "RB Screenshot 4.png", "id": "26847484398183393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258662_26847484408183392_8129976340003056997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RFFRFG6eLwQ7kNvwESMaZD&_nc_oc=AdpkY43y0RN_YrNJP5qWuJH0IelkCnPKtYD0fot0hlyJ_bO8w9yfNU5KdBhAahf8o7s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89ezIDxABDq2MRlsO-pFloDWVEKCQYRjpZK-Qm1NznFQ&oe=6A47D8BC"}, {"file_name": "Rumble - Classes.png", "id": "1908803792959002", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75280177_1908803796292335_2622630954260888299_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQkE6JI2h_cQ7kNvwHHNzoT&_nc_oc=AdqfchOyLwL_paCdcFDsOHsjuizeCkeq-QSukHF2P_Zn3XFWYKMxCVt--d2ZMi7sxJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cR-YiYitLKfibNYZ8KsWc9go0vw9askzws-rIvYTKzA&oe=6A47C557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RB - Cover - Landscape.png", "id": "897678472185993", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_897678475519326_3611105663611776785_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fSHWKN0xicQ7kNvwH1LUp9&_nc_oc=AdqAMjuf8as3Pr4zEglBhd94RapyuZsHvddkszls746g1G7rSA-HJ5u4gM3UDs0on4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-78XYtlxXxGjD4H-P73KkkgSsfckd1Pmh69AcL6ntbTA&oe=6A47C580"}, "display_name": "Rumble Boxing", "keywords": [], "long_description": "Step into the ring with Rumble Boxing on Meta Quest, the ultimate virtual reality experience for the most popular boxing workout. Perfect for boxing enthusiasts and VR fitness fans alike, our app offers a dynamic range of workouts, including shadow boxing, high-intensity interval training (HIIT), and strength training, all designed to boost your strength, endurance, and confidence.\n\n**Key Features:**\n\n- **Immersive Boxing Experience:** Enter a virtual boxing studio that puts you right in the action, offering a realistic and engaging workout environment.\n\n- **Dynamic Workouts:** Experience a variety of workouts, from shadow boxing and HIIT to strength training, each tailored to push your limits and keep you motivated.\n\n- **Expert Trainers:** Learn from top trainers who provide expert guidance and encouragement, ensuring a fun and effective workout.\n\n- **High-Intensity Sessions:** Challenge yourself with high-energy workouts that blend cardio, strength, and boxing techniques to maximize results.\n\n- **Customizable Workouts:** Choose the intensity and duration of your workouts to fit your fitness goals and schedule.\n\nUnleash your inner fighter with Rumble Boxing on Meta Quest. Embrace the power of boxing, enhance your skills, and achieve your fitness goals with innovative virtual reality workouts. Step into the ring and unleash your potential\u2014your journey to becoming a champion starts here!\n{457292033938611}", "short_description": "Unleash your inner fighter with Rumble Boxing on Meta Quest! As the most popular boxing workout, Rumble brings you an immersive VR experience with shadow boxing, HIIT, and strength training. Led by top trainers, our dynamic classes are designed to boost your strength, endurance, and confidence. Whether you're a boxing enthusiast or a VR fitness fan, Rumble delivers a knockout workout that transforms your routine. Step into the ring and get ready to rumble!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": n
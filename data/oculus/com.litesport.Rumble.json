oh=00_AfsvfG-tJSc-OYWS4m76TWIAs1zCr7X6dHY8ooRMZ5PLsw&oe=69A599F9"}, {"file_name": "RB Screenshot 4.png", "id": "26847484398183393", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75258662_26847484408183392_8129976340003056997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZ15zyikVkAQ7kNvwHSBLsb&_nc_oc=AdlfetNCw1HzaurbY1K9hHZc7vG3ndykx_VfHLwsKWL-y9y2fxyPIgU8WmQ61R051-Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsnTF83tTT8FYZXSRdXerfZp7BY_1mjJ9NW4fHTLCyoow&oe=69A577FC"}, {"file_name": "Rumble - Classes.png", "id": "1908803792959002", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75280177_1908803796292335_2622630954260888299_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7dI1VsgFNEQ7kNvwEoKdha&_nc_oc=AdlZv7hMOgvEkS5zMk_jPxGiJpILhTYIrm2eRvAiI45h5OUJh1-lZmq69sOHop2BNco&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftIbGAQbyARhG2eOWsMYXFUxCiwfjPtp1Fa-KA-o9PfhQ&oe=69A59CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RB - Cover - Landscape.png", "id": "897678472185993", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031354_897678475519326_3611105663611776785_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pf3D-6kHKGIQ7kNvwHBx-Jy&_nc_oc=AdndYwuM-YCCMm8IRcR9IAQAil2CLf1jLWx1tw5mOY9J0vxcy9G94b5qgFDyIzD6jqA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvUF72xE_Jj2pyHprpTywitd9_UKaUNyMNLSvXOdvzyCQ&oe=69A59D00"}, "display_name": "Rumble Boxing", "keywords": [], "long_description": "Step into the ring with Rumble Boxing on Meta Quest, the ultimate virtual reality experience for the most popular boxing workout. Perfect for boxing enthusiasts and VR fitness fans alike, our app offers a dynamic range of workouts, including shadow boxing, high-intensity interval training (HIIT), and strength training, all designed to boost your strength, endurance, and confidence.\n\n**Key Features:**\n\n- **Immersive Boxing Experience:** Enter a virtual boxing studio that puts you right in the action, offering a realistic and engaging workout environment.\n\n- **Dynamic Workouts:** Experience a variety of workouts, from shadow boxing and HIIT to strength training, each tailored to push your limits and keep you motivated.\n\n- **Expert Trainers:** Learn from top trainers who provide expert guidance and encouragement, ensuring a fun and effective workout.\n\n- **High-Intensity Sessions:** Challenge yourself with high-energy workouts that blend cardio, strength, and boxing techniques to maximize results.\n\n- **Customizable Workouts:** Choose the intensity and duration of your workouts to fit your fitness goals and schedule.\n\nUnleash your inner fighter with Rumble Boxing on Meta Quest. Embrace the power of boxing, enhance your skills, and achieve your fitness goals with innovative virtual reality workouts. Step into the ring and unleash your potential\u2014your journey to becoming a champion starts here!\n{457292033938611}", "short_description": "Unleash your inner fighter with Rumble Boxing on Meta Quest! As the most popular boxing workout, Rumble brings you an immersive VR experience with shadow boxing, HIIT, and strength training. Led by top trainers, our dynamic classes are designed to boost your strength, endurance, and confidence. Whether you're a boxing enthusiast or a VR fitness fan, Rumble delivers a knockout workout that transforms your routine. Step into the ring and get ready to rumble!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": []
_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxZgxNWmh2oQ7kNvwExqxm0&_nc_oc=AdpYx-oJAiRm2zg8AHxMTjo6DJtQ_C6SlCtl9nhmhWect-lqHU4lsUCCLWZclSyd_Jw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z9UxH7i2EXJlHmloOtDMLWhPdOLGFLU7kf76l3-kCVw&oe=6A2AC179"}, {"file_name": "RB Screenshot 4.png", "id": "26847484398183393", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75258662_26847484408183392_8129976340003056997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XkkVhA5g4oQ7kNvwEXmUIo&_nc_oc=AdpZRQ6lgNz7Pq2Yxps9DE90f2LpNePqNlVMBqt585xDjRozMkK2sfhXPDnpWYDlV9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80b5Oq51Cd8G1yt-kjKRRBCGVEWXQCizjCgdPKnWVW9Q&oe=6A2AD7BC"}, {"file_name": "Rumble - Classes.png", "id": "1908803792959002", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75280177_1908803796292335_2622630954260888299_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHDOrmtTkisQ7kNvwETMV79&_nc_oc=AdoF9aMdXakzwPHgfyFd4B0UTMAfV85b2_HqBQBdbCEMGIyiHvAOu3ebpfvirPUsfFM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wQj53FFNHaecwJEjdA8bCWgm7ttuhxYkffakg3sW8-g&oe=6A2AC457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RB - Cover - Landscape.png", "id": "897678472185993", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031354_897678475519326_3611105663611776785_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMHHhNVVpBIQ7kNvwHupFaf&_nc_oc=AdqwczF8QUhL0x0lwEa9X6YE-4e1ueYtK5sH7q8WbeRw7m29oUM51TVhBOVBkfgA_ik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fV4TkefrgIARMCl3XMaHS6YDbSldNPiZ8IMkGTFCyrA&oe=6A2AC480"}, "display_name": "Rumble Boxing", "keywords": [], "long_description": "Step into the ring with Rumble Boxing on Meta Quest, the ultimate virtual reality experience for the most popular boxing workout. Perfect for boxing enthusiasts and VR fitness fans alike, our app offers a dynamic range of workouts, including shadow boxing, high-intensity interval training (HIIT), and strength training, all designed to boost your strength, endurance, and confidence.\n\n**Key Features:**\n\n- **Immersive Boxing Experience:** Enter a virtual boxing studio that puts you right in the action, offering a realistic and engaging workout environment.\n\n- **Dynamic Workouts:** Experience a variety of workouts, from shadow boxing and HIIT to strength training, each tailored to push your limits and keep you motivated.\n\n- **Expert Trainers:** Learn from top trainers who provide expert guidance and encouragement, ensuring a fun and effective workout.\n\n- **High-Intensity Sessions:** Challenge yourself with high-energy workouts that blend cardio, strength, and boxing techniques to maximize results.\n\n- **Customizable Workouts:** Choose the intensity and duration of your workouts to fit your fitness goals and schedule.\n\nUnleash your inner fighter with Rumble Boxing on Meta Quest. Embrace the power of boxing, enhance your skills, and achieve your fitness goals with innovative virtual reality workouts. Step into the ring and unleash your potential\u2014your journey to becoming a champion starts here!\n{457292033938611}", "short_description": "Unleash your inner fighter with Rumble Boxing on Meta Quest! As the most popular boxing workout, Rumble brings you an immersive VR experience with shadow boxing, HIIT, and strength training. Led by top trainers, our dynamic classes are designed to boost your strength, endurance, and confidence. Whether you're a boxing enthusiast or a VR fitness fan, Rumble delivers a knockout workout that transforms your routine. Step into the ring and get ready to rumble!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": n
618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANaUskqj6iIQ7kNvwF_sHJb&_nc_oc=AdooQTUncKacpESeNswKyUVtf6fjbryRT_IcT76_Hz2Xaw0n1mUskYfxNezx21OeJdU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSqaGqNGPwWeQm1OZdr5JINae-Whm6atVvIhyNvZQZFQ&oe=6A940336"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYaZyUX2A_wQ7kNvwH5QJIZ&_nc_oc=AdoAKBOEisRs-p7cqa9m1EViGT6FW0ZwsH5FSzRPPChjK1jNbCU8ohuzkfuoZaXjo-Q&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGHjKrBpMRIug3K8wNZR_N4EewiPtTpN3ygVZPNGJ9ZA&oe=6A9414C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XrZm0pZbFgQ7kNvwG_mTeD&_nc_oc=Ados6i-TuHHyb7Z3dD5gfDtSTBks1gqvplWl6HvVPt3Avrhu3gJoQ4ijH1iXa9YD3kc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD9VPG3B4lbPPi0iw4HfNdzTcYI-ig_VNxi5TraC7xNg&oe=6A94238D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
rd5-3.oculuscdn.com/v/t64.5771-25/499303585_1223622483144098_7063076556162011975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWhuhlHwVGsQ7kNvwHi0XgJ&_nc_oc=AdqjC72_assNUBX5p7Xq8rH3Rhk6rdTDIax9OSNZV4EM3UJXLpvG4QEeRu5EjmK8rGc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr-ocdIRzlFPbswrY1FYqV82xNf3uZV-c7DXX93yAttA&oe=6A63650C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Scroll", "keywords": ["RSS", "news", "feed", "Reader", "Articles"], "long_description": "RSS Scroll lets you add and manage your favorite RSS feeds, then browse articles in a stylish card-based interface or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article cards\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in card and list views."}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wysi7R1u1ysQ7kNvwFLKIoU&_nc_oc=AdqJMsUJyPM7VCQm-ejWmzEQMMTuNcMHRjWL-eAYf_Ky5BKIdm4CLMdADOkoxyLGf-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6xN6ee6KA-cumho1IJSis6ibGFDYtXqBz9O0veBpzMg&oe=6A635C0D"}, {"file_name": "icon.png", "id": "1598558734570356", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618264_1598558737903689_1704160935439350811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVGRqcN4n2MQ7kNvwGSWhgI&_nc_oc=AdqB3SNDWNZ2YoAZ1djTPerCmOB-QZtJ85Of5aZHI_7CHlqre3OgdGxz73v10MD0598&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD81UBx2UTAUg70u9hFBl
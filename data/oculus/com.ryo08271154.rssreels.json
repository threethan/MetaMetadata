618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrD7YP7A9GMQ7kNvwH6cCgm&_nc_oc=AdrGFtilzWWJxCPZ2Vk8dOfVjO7ofHxEro0rP91XQz3RQ2PLi6EJ1Ab7t6sg2Z9Jb4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtEB-HsDi7T_5MNJ0EXj1SbNcJ_SZclSD-5mWCb73PFA&oe=6A9EC776"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=En1LosKXaIUQ7kNvwEWZ7XY&_nc_oc=Adp5dGB-jR2AJPRo28ZYwbQDFMFabFQmpKFf7LOJg5VYFj0h1pQhefpzbCDRED26DAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqlQIbanJOf0_Vy0YV8Le0duNctuAOwUfKL0iBSX0-vA&oe=6A9ED902"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HjIvKQomvkQ7kNvwE5zivg&_nc_oc=AdpsA_PR-H9pcPCmMQVrrwh3nmntyTGSbDcyN-8fwKnQ-tLX0kV80_uYvQ5ZbETxoao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0A-J2fCs8VvP0RK-mdyZPMi_uwLGMiP8XvzbCJmp8eg&oe=6A9EAF8D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
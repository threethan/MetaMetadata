jc6-1.oculuscdn.com/v/t64.5771-25/499303585_1223622483144098_7063076556162011975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DUpFLmqissQ7kNvwGpSkfP&_nc_oc=AdrvLnXFKbcBB5mLfd2GoGYpXqYyXyr946XsP3JEzUw696coj7okIYRiVh9EYSdC8xs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBj2rSSbR5RJJdG4cf8g3foYcBIV3tC2FhxzCAlAYcQ2A&oe=6A5CCD8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Scroll", "keywords": ["RSS", "news", "feed", "Reader", "Articles"], "long_description": "RSS Scroll lets you add and manage your favorite RSS feeds, then browse articles in a stylish card-based interface or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article cards\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in card and list views."}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pScC2sZP7ZQQ7kNvwHAjpXz&_nc_oc=AdpG3u9o4rU1TpQffpIpavF6lG6dpD687bggTNIzpYmmIAkfD9YzQY4gFkE6CdBqtBY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHNBw07bfB6iAro67p3-uZtYgEllyzLpxhYU5dM3hRmA&oe=6A5CC48D"}, {"file_name": "icon.png", "id": "1598558734570356", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_1598558737903689_1704160935439350811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qk1VewGiJAMQ7kNvwFn8DoJ&_nc_oc=AdrSVVqnmbuXAA3bnWNXkgwcCPaM1Zu6gaXUpk1yKxkmYuFVyJDyFa7lv45mILZfBEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBp5WIgnd6_0TukKu7vXq
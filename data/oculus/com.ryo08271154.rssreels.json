618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUmdt8ahg04Q7kNvwGhIOtt&_nc_oc=AdpwyCb6ZZj5HUhr5ZvAfQ63GsucXsZ7-g2j8sfI6qHYWQEU9sXhjnzF3RIilIpn8GI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyHcWI_x78LOEch8027RrbVFymO8Sj9zNoAYCdcjuF8A&oe=6AB13C76"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbbfN_YLZqYQ7kNvwHa2avr&_nc_oc=AdqM0PE2xfViMFRjeH1-Jf0A6jk2vHHgdUACEAbLjHKzEag6Uz4xBVGQ_-SgOT--5CI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg-W91pgsZ0U0VbR69_5o9YudbKSkoPceTvwRHhvDPNQ&oe=6AB14E02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlzcMUMWs9cQ7kNvwFYvt33&_nc_oc=Adpb-HSZKqzRpbSDlJy9-oWiL2r81_B6KnmdZZilNGKNt8u_kDFCd7iZT0TL6jy3s2E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJG7KTQ7edF_ShhkxN6aLyDiSXI9LT8Er_NHoRMrHpHA&oe=6AB1248D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESKJ3sDkhrIQ7kNvwF8_79s&_nc_oc=Adq3hVHBo0Gk0TK-EdsrH3cHpkqRhCzS4pnzrk2MgQMpxHs_9vf4ON7as7iT4U72GXQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA_YRyW-4Gt5tG_N7ZXOs2LSnq2Nz5_u3UaNoNO96ijQ&oe=6AE203F6"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R66wPCSLpU0Q7kNvwGVMHFl&_nc_oc=Adr8Yf7dX-XWb5vXF5K2ztSvoGAu8mNMxnMSjZ27CLl0kkZxpvtc9KVMLI_oE-LxIYw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAYJr1l8sr6g0qGzSrc44yyDXq9nUTCzU-gTkQVWX19g&oe=6AE21582"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NouywAW7D4Q7kNvwHmfDQS&_nc_oc=Ado4U0IVDXV8NjZ-N3-8T__DFDXa0B_tKe8UBvMfRU1V9t7VO6TbSDvJFAJSY_Q1Kss&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxvj33edFUTapgUwcr6uQZ2uHi2Z71Ygd_yv_jHFgIRw&oe=6AE1EC0D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
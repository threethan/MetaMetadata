618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESKJ3sDkhrIQ7kNvwH8285d&_nc_oc=Ado9DYYJJD-aIy9svZzA2WZvn_59OUSHHnwsHlr-H4V3vLf2ot_tvojTp0WuEJg-fu0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO04lGfvDtOJz6gMbxPYAVl_OOgYlNsjVHv4LoK8z3idA&oe=6AE0B276"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdZEPZMLlwcQ7kNvwGwmJTu&_nc_oc=AdprIG9Ql6fLTJdO4A313QdK3j5QpUIhl0V5M2m5tfAWgM5urPM3MvehKqFjA3oO6yw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBx0SGBYF4qmO2MC_9MMoxclNwt1OwQg74IRfURIsXIQ&oe=6AE0C402"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NouywAW7D4Q7kNvwFhwM4I&_nc_oc=AdpdlrPs9nW5AnQ9eiqql_bJsVqTyTmAv_fmlylJP43t71WjUXn83msoJuiBEu9cTIs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeM6aK2kv2zxb_wf5iwjtxMWh9GnX0jwiY6xAnWxwR_g&oe=6AE09A8D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
jc6-1.oculuscdn.com/v/t64.5771-25/499303585_1223622483144098_7063076556162011975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyZKqKtSHwIQ7kNvwE_Rtis&_nc_oc=Adr68XEnDfFVAa_Hs-Qm4bYvr3Ra219U1hLST9ETAOtYuvwoYWoIh2J-vgimu6sunNc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f_avPXssZdMICNV8g83x6q6YPvT312BIhGHx2xvIZ1Q&oe=6A426F8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Scroll", "keywords": ["RSS", "news", "feed", "Reader", "Articles"], "long_description": "RSS Scroll lets you add and manage your favorite RSS feeds, then browse articles in a stylish card-based interface or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article cards\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in card and list views."}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYxbt_E8EnwQ7kNvwFOINaa&_nc_oc=AdqvSA7cR9tyovqCjRTBpyJDYVATIseobjAAj7Omof9CaEq-idoWlN0NAC92RLmP0I8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rfsptD_bfE22iSOCKCafAPn0GvXQ2AGH9q7gbvKr_KQ&oe=6A42668D"}, {"file_name": "icon.png", "id": "1598558734570356", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_1598558737903689_1704160935439350811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zM8LtCwLN2sQ7kNvwEvmVAM&_nc_oc=Adr3iz149hZXHP-qnQ1LeLG9-olFwM9xSnqmrz83b4RcsvU_kalDIMMKiQsg4UIZmxM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VUutdvXnvN1igI1T7GR
jc6-1.oculuscdn.com/v/t64.5771-25/499303585_1223622483144098_7063076556162011975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DUpFLmqissQ7kNvwE9mEZi&_nc_oc=AdoBQhMZy3oF3jdU6Fh8ALUAUau3Lm7LN4JUtMRzkPDeCC6NDZFMg3MfV5bH_LMdUeI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAksk9Sx8i4r6AakOBT0Z-4Vjn-eySqaw_O3UrfTCbww&oe=6A5B7C0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Scroll", "keywords": ["RSS", "news", "feed", "Reader", "Articles"], "long_description": "RSS Scroll lets you add and manage your favorite RSS feeds, then browse articles in a stylish card-based interface or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article cards\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in card and list views."}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60qbcDBrWF0Q7kNvwENgEvo&_nc_oc=AdrJM4vDK3nbJ1NgVEvTG6eI-BjeVB6JJfoDDm12K5-P2ustgCMsQ-8rsyuDeuCH_pA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdWdAViEY6IcFMnlmL60uf0CQQ17eL1m0iQrjhrasjNg&oe=6A5B730D"}, {"file_name": "icon.png", "id": "1598558734570356", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_1598558737903689_1704160935439350811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mK90SY3wX6MQ7kNvwFt6pSn&_nc_oc=AdpYFJ9FsHbjMbZx_56KyI-IHYbH9UY5oIx1pPnY2JL8xozL7vFYty7CFWRS-PBQpic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdS2wUGWRAf0Clyc2TPH
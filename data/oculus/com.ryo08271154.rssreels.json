618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fv66il1FndwQ7kNvwHEG-YN&_nc_oc=AdqbmVT9KX2h_wtRYpX06gBLbp-gBBH5Mzyrj_NZuC5riG3p7vAyzUMIQ7sORpuLep0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISrsu6um2lE1NzYTE_TFXK2dUPtl7NPk1XIC_BCy_3hg&oe=6A9AD2F6"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lliqnSVmD-kQ7kNvwE2G7d2&_nc_oc=AdqOlGGf82A1FIre-GtBxSBY2oM3C9tyqfrlTHHy54WU7Yr4GXn3K7qvKfOeajaIbyA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8DofHrMEp6bOLlesP9-_0AmYyCiyuvbash-DnzJwTZw&oe=6A9AE482"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAzv3PV_-OYQ7kNvwEIgLhZ&_nc_oc=AdqcTxg9CfM0zNdXtozO1GaG0IbmZiZtPY12wbTiMroxFxNsiPuSzfi66U41q97SquA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBF46O36r6ET5WgUDum_HOsz7-INteIftGWzGUiVg8hg&oe=6A9AF34D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6S7zQPxX_KwQ7kNvwFbpg2a&_nc_oc=AdpUm8OTuaES90jPkQA12DKHvLk6IcMOSNhet4Wq2BdxH2vsHVEeMseLX1nFyY5yDoE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-AJ04Lc2BkPqqWeTngU6jPzt998X9QXokdswtJQs5Kg&oe=6AE89B76"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itnzt89TJMUQ7kNvwGGjOZq&_nc_oc=AdrAnnoh4GRm6lO8sSIUWQ-Xk5nUPHcTthaqf7-fUrrJyFOH1i5vc18QU0hBQ6xs6UA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_ovKIeUFliaiUvWamA86xjJyOwINasx2YpVhDfxtxfg&oe=6AE8AD02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucR3LLvUJgUQ7kNvwE6lQ47&_nc_oc=Adph2OczFQkCyi403QxWcZPOWdakxvxk_BOuDJac7u5QStzPd9CI7wxbWqLCwlS8kO4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsZv9D3ubmIHbs1U6hVkebcYR3fYFdDo66PCU04KN2uA&oe=6AE8BBCD"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
rd5-3.oculuscdn.com/v/t64.5771-25/499303585_1223622483144098_7063076556162011975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qWZfG08BCcQ7kNvwFtYQbG&_nc_oc=AdrII1xutHrJNXi74sQ3FQIyIAFirWIzQ5hmvhVx4lGQbqSiSIGkzMAZr6KNaoxVvcc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DVfdZcNce59voTIucOqYyfDAn--a8jzJm0VNWf0i9GA&oe=6A43C10C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Scroll", "keywords": ["RSS", "news", "feed", "Reader", "Articles"], "long_description": "RSS Scroll lets you add and manage your favorite RSS feeds, then browse articles in a stylish card-based interface or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article cards\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in card and list views."}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYxbt_E8EnwQ7kNvwHt0xTe&_nc_oc=AdoWPpJmg7mSenu2T4LxXdCLzjiB43lroH4feb-VX5VPSGCE2ilIkTHf5u-AgRcoobc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cXUuqNOpC9nQEI4-MiI5cF0W-P3ICKN15odU20nVONA&oe=6A43B80D"}, {"file_name": "icon.png", "id": "1598558734570356", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618264_1598558737903689_1704160935439350811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zM8LtCwLN2sQ7kNvwFQeOak&_nc_oc=AdoBCTlk04-oDGBhU0TZCiFsH-7n-0B611RkE-jV78fkA53FeaDroOliO73c-klppDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rviRcgLyBEgs6ADtUzs
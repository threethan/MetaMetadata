618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltymDsUCK4oQ7kNvwEzoolT&_nc_oc=Adq9C_M9BxoIWcX5pEYPyUzXNCuAnKRHbRVsnomq8jgr1jx__LnBup_au7EdJkRUw2E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPj1w8cWQym9hUCvlEVyTARDdjEYMfJ4fE0hhZfpyEv5A&oe=6ACB9A76"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jnN_KtD5zcQ7kNvwEWP5Vj&_nc_oc=Ado_o07QjQCDKiZpv_V8DUVp5Y30ufcpr0sq8u7IGY9pUiFyRKF8aMI5ltOf9ek6yuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3ZPpTAEUowGtV7qDPOzEb0MGLCUHsEowPWPrCF_8wAw&oe=6ACBAC02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucCQiXkAs74Q7kNvwHI01dr&_nc_oc=AdpSt0qpx8--TpLhYxb0xu-ptAyp_tbQ8Rq4U6pl9JhySKUfmt94wvaFsW3oA9DtVEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOWpv_ycKYGJ0aDrALA25MSUR47q9XtmT3H35x6EPBMA&oe=6ACBBACD"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
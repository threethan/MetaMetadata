ad6-1.oculuscdn.com/v/t64.5771-25/499303585_1223622483144098_7063076556162011975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05zqQ5j21GgQ7kNvwGrhvZU&_nc_oc=AdqmIAX3xi_4F79e29is9XW30U8G-uZZNJ92-hmd6Mw6vlEnP5baE67r1v5AMlF7kgs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz44wZbZoXZNma7a1BEeh5CqO6lvAoZhTwrr8XtHRYDQ&oe=6A70940C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Scroll", "keywords": ["RSS", "news", "feed", "Reader", "Articles"], "long_description": "RSS Scroll lets you add and manage your favorite RSS feeds, then browse articles in a stylish card-based interface or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article cards\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in card and list views."}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmAOSZyvdgQQ7kNvwFaRbOs&_nc_oc=Adq5ELOPN7XRleIP4c0VJWPknD9SMRFGMMs52iMvCLtyaUGMFtliBwq56_1y32b-iU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwSZuJVpxUoJWDL_m4OEWbhrGakHHRPTrHLHHVdZQJbg&oe=6A708B0D"}, {"file_name": "icon.png", "id": "1598558734570356", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_1598558737903689_1704160935439350811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHNSWGfvgsUQ7kNvwE0JkFJ&_nc_oc=AdpvjC1Wo_wHUr2UjzErMOAeNh16aFyQiGiIX77rCfLTtS6VkIDpzxs9YtZaxgrQD_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzQET6caxr_HtYE9X1AS
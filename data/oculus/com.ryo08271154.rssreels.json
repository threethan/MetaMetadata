618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltymDsUCK4oQ7kNvwEq-bT_&_nc_oc=Adr9SDml07TX18EdG3JXOIcrVIqlUFamHAajzODzver73BRyZ7j2wyBVsWZO4ShYr40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjxvTqAZLtPjdlrgBQLevSadPDbSBp1w8E5aYkT2Z_-w&oe=6ACE3D76"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxI7KIwUvQQQ7kNvwE9h4xm&_nc_oc=Ado60qd5z5Iyk7BETcV3uCeS1iqIoQz9Ax3d9KkVCrLe6rHMg_-pcHOqXO2dYFBBsOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXhK0aAlX1_gQWF-iDrKMCtLMA_yxTUUQQCBs4SEQV4g&oe=6ACE4F02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucCQiXkAs74Q7kNvwGpxKuE&_nc_oc=AdpFowQDQyH7R4s1EeWRTqRjtp4UwOgiAcWR5-4Nzv32rg2ETdYQFWiObsUk6nicK7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6S8Iwj7EFjo60fiDthbtzT148fZSCnD6B6oXOf8vwgA&oe=6ACE5DCD"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
ea5-1.oculuscdn.com/v/t64.5771-25/499303585_1223622483144098_7063076556162011975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFuAjV55ZIQQ7kNvwEzRbyV&_nc_oc=Adq870FHvc27VeZl59iJ5SVIM5yPrY5pgsFEEYdurIgoy6z8mXQ9z5KRiB0FbJxhdk4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMy0vVBhhOiNWV5t-96aipOSlFp5H8su-o_g2VGxpnCg&oe=6A53930C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Scroll", "keywords": ["RSS", "news", "feed", "Reader", "Articles"], "long_description": "RSS Scroll lets you add and manage your favorite RSS feeds, then browse articles in a stylish card-based interface or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article cards\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in card and list views."}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9bVrDLK4egQ7kNvwHmW4bZ&_nc_oc=AdpbuL1_3aSsfk7AZD4ZEpnuDcgFfDj0pX1MIj2rT0W0mZfmh3Xwd-WnD7bJMiYI9Xo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFJzd7k2wF5EsRVcjOhuEo_0uvnDHkzAzTVMaekoLqUg&oe=6A538A0D"}, {"file_name": "icon.png", "id": "1598558734570356", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618264_1598558737903689_1704160935439350811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QIrstBVch8Q7kNvwGvF_UB&_nc_oc=AdqsdSm35vZ01AcFpFIGjeLogqd-cADd5S_GQiY4oZQkUSnsmB0hGjuTkewkAcNjx94&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9N_GasVNdGSxSwCgtbU
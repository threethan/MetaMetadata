618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtZYZUU1Kq8Q7kNvwH_rCzn&_nc_oc=AdpJyVTQYt4Q7OD0ELIKXgdxkab08IUAzKEN5VN2c2-2dYlfSeFdZ53hX9V0wIgusZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpIcDPbgDEYiCxP1hFs2PC2wCB-BkIl59E4Ae0_iv8gA&oe=6AE4A6F6"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R66wPCSLpU0Q7kNvwEQrglj&_nc_oc=Adp2ipH4-Z8WLpE1ztVtsoCnPzK6_L9DeT03G_LSAuB9wEBHS15VJd2utVyvky-VH6g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuadkxm2jwyD7j6otnoLObo7RHy0zvUlWqXq7wtIgfHw&oe=6AE4B882"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wqz75hBeaWgQ7kNvwHjtN9r&_nc_oc=AdpN52gUlYGCZq1h4Oby623BNqpdUKH2kml9aty3DRKAjrUNdhYmL9_rKqgp3OAI8Dc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcQr4dZc4fC-dd1Tv7-Tq8YeGy2qkmCM2o1yChRKG4jw&oe=6AE48F0D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
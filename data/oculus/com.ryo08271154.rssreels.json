ad6-1.oculuscdn.com/v/t64.5771-25/499303585_1223622483144098_7063076556162011975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-cIZzAteEMQ7kNvwF1ppgx&_nc_oc=AdrzYZUfqVG-b0EfVNwvDBNIgy8pdlWTe5IRV78qlrfk7q6-YTKzAafZmBwm6lsB104&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7MDZbAHWxuEcTljwQL0vLTXGGgHPjD2BvsSkqZmIOiA&oe=6A69FC8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Scroll", "keywords": ["RSS", "news", "feed", "Reader", "Articles"], "long_description": "RSS Scroll lets you add and manage your favorite RSS feeds, then browse articles in a stylish card-based interface or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article cards\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in card and list views."}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCchWWcUpwsQ7kNvwF-uAXv&_nc_oc=AdrI2pAaGZagVTYT2KAAlefWxdiOGv8N89LXjFo0G5fQlBfKmfdcPBUwyUp6MpWaEaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASiRWFCZ9lmn7TfxIIaYE--BOxOIc3gQTKCFh4-qFD3g&oe=6A69F38D"}, {"file_name": "icon.png", "id": "1598558734570356", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_1598558737903689_1704160935439350811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tL02kLIOy8wQ7kNvwFTa2x0&_nc_oc=Adr_aI3nXlME_pXNAAmpPd8Rx3PsvSlWIfeTYwQvoXt59cy7VUdg9ssg6RL5HUoJDhM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCh2IzaSQfa9YWNWE8S4D
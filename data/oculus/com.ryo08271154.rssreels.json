618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nq8x-YnX_bMQ7kNvwGnV0xm&_nc_oc=AdocgMDtixzoe5H5_WLOKMckDRXGc5aFI50hgUPToSjCbeBpAnKOe2uGB2CkxTXV8v0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsJfldRazWwT32g2Qn8F5G_mo-X8OQCPjWumJC9roMbA&oe=6AC65476"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js6TZeQKTQwQ7kNvwHbyv-Q&_nc_oc=AdpyCbJXKN2uR4PhKp8RHSd2f-GNHi4p66PUh8KcvUQ_x2MsOZS3XJSBZsZZRQvaklY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHKlk4KfTJ7qHtGU7_r82nrJHZHHSMybbPoS_B6ndcig&oe=6AC66602"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-v3VUHCag0Q7kNvwFBkgxO&_nc_oc=AdorZ-wXT8sc9BrIvNjwyPXZTwiIINwsDYvXhvmCsdAN0KsmYHM28QJqtLE6RAfv_nM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME-eVlyaO47dA0hCO7X6FGaNQ3VgWNpXCVLC4z9p_OcA&oe=6AC674CD"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
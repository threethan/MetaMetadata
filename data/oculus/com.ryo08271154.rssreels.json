618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANaUskqj6iIQ7kNvwGmy2If&_nc_oc=AdprWUw9Z1UAsfquPDXaQKUUDjwShpp1T_os1Cub8pn7C6ehGg5_hGsLlwxipU6tIEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM-M2qDPZOsXYzOcg6ZjjCtqW24gP05JfYeLeAxm_cqA&oe=6A95C536"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kb0SibS9DW4Q7kNvwHYDV0p&_nc_oc=AdpkJqVds4uPQ75kuqQmsOOp12YCpn6K2bmR0I7vbOH1fdf-XP1sskIQ3_sdKCUP3-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSesFlrDbhMBhvxqNjXIKGeSJMYCBy7q2yf9adJDHHeQ&oe=6A95D6C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XrZm0pZbFgQ7kNvwHfmAjd&_nc_oc=Adrhd3c3Qtf0CnRGXJtiT3_nByOtJrDUdKwstjH9NAfPMwOxOnUifP-DEi93-eiWEFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX8GOzr8APgqs-BCbn-aIufkLOW8wEBDLefQIJME2L1g&oe=6A95E58D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
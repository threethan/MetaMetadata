ad6-1.oculuscdn.com/v/t64.5771-25/499303585_1223622483144098_7063076556162011975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWhuhlHwVGsQ7kNvwGm8Iey&_nc_oc=AdrMDVApjcLlE6HQUX6Kh0V0ZqA9BDUmK-eOrUosekXz_GKQ78cu3OYDb2kbczAEBzw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcx_ozV7yT-VulwWIeMSFkSGZ1xCxlgmt1zevBcf5Aag&oe=6A64B68C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Scroll", "keywords": ["RSS", "news", "feed", "Reader", "Articles"], "long_description": "RSS Scroll lets you add and manage your favorite RSS feeds, then browse articles in a stylish card-based interface or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article cards\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in card and list views."}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lPgMzhncR0Q7kNvwEHBofF&_nc_oc=AdpmNeBUcN-nB4vPpanWapy4u_BwrRDKtgkkb48elzIjdaAq2szK_jocjj1wIiTToBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8PoEB_LNq04re95ax3RhZWShUAsHwdC2jvI117RZDvA&oe=6A64AD8D"}, {"file_name": "icon.png", "id": "1598558734570356", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_1598558737903689_1704160935439350811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaMwd_6OU-IQ7kNvwFNHkHk&_nc_oc=AdpkH0Lq3yORaUdr9nH2A1QUrdyv_mW89tp6NZ8JQf1FBw9xVNK38Whvt5eX8CY9hYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA0SSQCbo9cCcjKLko1q
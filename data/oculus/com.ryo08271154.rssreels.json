618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6S7zQPxX_KwQ7kNvwE4H78u&_nc_oc=AdqHMgFCTPQIL4YGCkLUTxBdJYEef56UVWgaMjkCE8etBhluj-LTvTycIbDTmbP2ZRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT96bRcf_s78hBO4c4_gK84MFxBEWmuakghw0XIFC_6wg&oe=6AE9ECF6"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alMFjTubeMgQ7kNvwEPfpJp&_nc_oc=Adpq3r3jt1OnOb3mF43S0qBe8w031zq5lmergFwo40kvrEiy9MELfRTR6gFViyiF4lM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbwQn6HYwIwvJyUfUqaQW7f7jYYqWCu1J7j11kKkadgA&oe=6AE9FE82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucR3LLvUJgUQ7kNvwHPC61v&_nc_oc=Adr0YTzACg5K_vXZnwWcdKiEMV2faHN9mrIXPTGie2RNRcjDOaLOQGQqFtli9UYArRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzukbPgvBwVl7qzYFBNHJ9S5xdLzuIgDImrHUNNVRyLg&oe=6AEA0D4D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
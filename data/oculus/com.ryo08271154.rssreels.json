618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7j3_GtCb1EQ7kNvwHEvLU2&_nc_oc=AdpI8r_2E8ZDLUOY82ArmeWK0GT5qSDLi3mm-Xr1W8m_uIl2F8G_44qYq2gBoStG6Z0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjDjIgzY3NUmx29cNZIrdEGLk7hp7IvJjTZS_LnL3x6g&oe=6AA801F6"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV7bdpDHjRIQ7kNvwGKC8PB&_nc_oc=AdqlDBj_h_6ARbeujOhuvxngR5snh-aZpODBKF3RsL0NKYt2IbCD_iTPRaEpjKHtQ-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbG0yfjD_48OsAxfjuTEz2ymIAuKBY1yrB-4Sqd7r_Kw&oe=6AA81382"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6mzjk5Cc9oQ7kNvwHivUY5&_nc_oc=AdqAfCaHDGN1LepOEQL8YnyfSHcZhZwXqtu0GObZiyggoM_CX_aEI7UbLNJMRl4PlGs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ80dUd4Mrt5cxfYdBsJ7rA2MlCPOJRVYkya4A2qWDPAA&oe=6AA7EA0D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUmdt8ahg04Q7kNvwEJWymF&_nc_oc=AdoGWDTNAMJQe7U_vJ_B1lpM35PcieIGUb13SPECYB1rSce1D-eWntnAkAKQimjGaQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8wsAjnb4i4HHQTj0F4H7g41QadFSpJEbuZz6QVQsSrQ&oe=6AAFEAF6"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbbfN_YLZqYQ7kNvwFH5JBj&_nc_oc=Adp7zLIwRi-tIdWMOLFERlntymWwY7eaSk1Dp25nLG7FOL-BMYuT65a7xWylfg2FfcQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ_7yhFRFser307M_WLj1k1DyCOCEP0AdiDQg5CZAvMA&oe=6AAFFC82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlzcMUMWs9cQ7kNvwEqOJGF&_nc_oc=Adp_wzyBFPguh5Yb75SdmGBUZOTiK2Hfk_1BIutsHnTNQmBCk9z0CdK7g1GS5kafi9s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3xca9GLFEbJXVnkaeoUZNE4sVBhl_7JwMccRiff7zUg&oe=6AAFD30D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
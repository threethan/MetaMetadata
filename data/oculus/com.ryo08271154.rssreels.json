618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmazGnXVx8IQ7kNvwGlhXPu&_nc_oc=AdpAOlEO6oUaT7Drz8rOOZDX_uWQOJc07Y6DdZkobYikP0aGxCoezXLArRcaDYWUYgg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO9STAat-46pxiT3or0obgR8sxuzl5Wv2xnVmSQjz7sw&oe=6A81C676"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJl1pd92mS0Q7kNvwEn9CiC&_nc_oc=Adq8wofYXjQ0c2F5v7ml04RGFNWtV-zLziTKSn4Ev_AsJPfHNIdgBqLEIOVLXGSEYIU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk8N6DkNPYQC1Z8QroQwq6ggFGzv7mU13Rux7Pb722pQ&oe=6A819FC2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5bl5gmqTIsQ7kNvwHYW5G0&_nc_oc=AdpOy05mjIYaSiBiob1qf9Ux17Gvqu7QVj3QxYRmWRvLryvmp6i7uOza4NpROYDzhbc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe1DCFk7Q3tmFOdpKNKmGvSA-jDXVd-sme5d5yq5G2ew&oe=6A81AE8D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
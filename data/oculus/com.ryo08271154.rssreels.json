_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBqvNHu1amUQ7kNvwGnU5Go&_nc_oc=AdrqeViKpur7wGK_Ue1L9lgQdclQXI2-5OQ7DwCkQF5NIP3c7_a5IQmIZyjv5zJn7cI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DlFASv2I7Qb9jxwxUoP2Ll0LTQb6yue7NhrNhxZP52w&oe=6A35741B"}]}, "id": "1341620461363949", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "\u30cb\u30e5\u30fc\u30b9"], "long_description": "RSS Reels\u306f\u3001\u8907\u6570\u306eRSS\u30d5\u30a3\u30fc\u30c9\u3092\u7c21\u5358\u306b\u8ffd\u52a0\u3057\u3066\n\u30ea\u30fc\u30eb\u5f62\u5f0f\u3068\u4e00\u89a7\u5f62\u5f0f\u3067\u8a18\u4e8b\u3092\u697d\u3057\u3081\u308bRSS\u30a2\u30d7\u30ea\u3067\u3059\u3002\n\n- \u597d\u304d\u306aRSS\u30d5\u30a3\u30fc\u30c9URL\u3092\u8ffd\u52a0\u30fb\u7ba1\u7406\n- \u30db\u30fc\u30e0\u753b\u9762\u306f\u30d5\u30eb\u30b9\u30af\u30ea\u30fc\u30f3\u306e\u30ea\u30fc\u30eb\u8868\u793a\n- \u30d5\u30a3\u30fc\u30c9\u753b\u9762\u306f\u4e00\u89a7\u3067\u30b5\u30af\u30c3\u3068\u78ba\u8a8d\n- \u30ab\u30c6\u30b4\u30ea\u3067\u8a18\u4e8b\u3092\u7d5e\u308a\u8fbc\u307f\n- \u8a18\u4e8b\u30bf\u30c3\u30d7\u3067\u30d6\u30e9\u30a6\u30b6\u3092\u958b\u304d\u5143\u8a18\u4e8b\u3092\u95b2\u89a7\n- \u65e5\u672c\u8a9e\u3068\u82f1\u8a9e\u306b\u5bfe\u5fdc\n\n\u30cb\u30e5\u30fc\u30b9\u30fb\u30d6\u30ed\u30b0\u30fb\u6280\u8853\u8a18\u4e8b\u30fb\u8da3\u5473\u7cfb\u30e1\u30c7\u30a3\u30a2\u306a\u3069\u3001\n\u81ea\u5206\u3060\u3051\u306e\u60c5\u5831\u96c6\u7d04\u30a2\u30d7\u30ea\u3092\u3059\u3050\u306b\u4f5c\u308c\u307e\u3059\u3002", "short_description": "RSS\u30d5\u30a3\u30fc\u30c9\u3092\u30ea\u30fc\u30eb\u98a8\u306b\u95b2\u89a7\u3067\u304d\u308b\u3001\u30b7\u30f3\u30d7\u30eb\u3067\u4f7f\u3044\u3084\u3059\u3044RSS\u30ea\u30fc\u30c0\u30fc"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ryo08271154.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ryo0827115
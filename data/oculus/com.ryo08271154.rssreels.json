618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bF6TH806uFgQ7kNvwH94eF7&_nc_oc=AdrHwCzERl05M7-80Z51g3xb-LrLGQ9iDl1qo41ZWf3YtQ8iBf4XS-luYJ4F9ti4U8A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaZuCmeOfa2U2BMmOUU0gSrYJJvgau_RqWtHKMs_mNrw&oe=6A8825B6"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0q-QYnZMymEQ7kNvwHuCzLX&_nc_oc=Adqo_hb-wuz4ANIjfP1ULMNRaObRKy8uXneyseatjkd7mBtbHqhcx6UZ_ajiat2_DIk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsSAUKzAhECTWop4VilXx9E9tBpmDJ_laSLP1Jt4KeYg&oe=6A883742"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zh5DIU9gQlUQ7kNvwHiej2T&_nc_oc=AdoYGjNFU4tyG00GuV0-mIE0D9mnjvrmf8YzKzvVn-WWtKqIW80XUD-NH2bm9zLkt20&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuQgY0xlvk8mWouD0n_mpzJdsJiESmTNVn6NG46a4ZVA&oe=6A88460D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
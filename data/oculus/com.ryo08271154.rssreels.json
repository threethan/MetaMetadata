618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFW7AwjcaYEQ7kNvwFm7WcM&_nc_oc=AdpD2NmvSoAuleEz8P7jkJfKNeYKAZPddnwiqKhKcN-HgmMSnc96yG-v-sdDAS8M3Ys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY4oiEMzLBCeE4PhWlUJxR7zHTwjYyipnz17srPNhKDw&oe=6A8C1A36"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWG9VigGOpIQ7kNvwH7FOU6&_nc_oc=Ado2kj05Gj00Gg-EhHT98Bg_nXxczPADJLrBocT9KYfyp3hG-zhI_zM6zi5CAyMtfq0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRqxmZ0iIeoTnrjKDseeQzA3OWqrQhnon14vQGKHby8w&oe=6A8C2BC2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WyMnLK75_sQ7kNvwGNXU-B&_nc_oc=AdqbmUCpSLzLB-17uWKtXuaVz-CtD9VFZ-Q3-h7yVZLEOS1env0TJBsjYCub5KfV09M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfcOYYTc7MsPniUhNygKrR9DIy3vO8eFYD2WlizqabMQ&oe=6A8C3A8D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
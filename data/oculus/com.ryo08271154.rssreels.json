jc6-1.oculuscdn.com/v/t64.5771-25/499303585_1223622483144098_7063076556162011975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35qsj-rF4XkQ7kNvwF4wLof&_nc_oc=Adr6XYXF4g7IyyPBuCGm6JfhyCilsZi4AYKWBMBZVbouvzLTSizr9BdEI4GXdDitMpA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p8KpmG-J08vg712HOcypSlcJT7Tjtf26HZh9J65GoFw&oe=6A3A868C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Scroll", "keywords": ["RSS", "news", "feed", "Reader", "Articles"], "long_description": "RSS Scroll lets you add and manage your favorite RSS feeds, then browse articles in a stylish card-based interface or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article cards\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in card and list views."}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD07hLM-_8oQ7kNvwHoafXd&_nc_oc=Adqa-edI98PFF-1smWZ3f8IlqmNu69BYz1cbpq4vQ5vj5BlqsNuLw5EWxCAN2qjSmQo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-atbEQ3GQDwJXYX-FCZl2LNrMpaegMq8CCu8GmX8gcTw&oe=6A3AB5CD"}, {"file_name": "icon.png", "id": "1598558734570356", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_1598558737903689_1704160935439350811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOIB86MvgJ4Q7kNvwFkk8JP&_nc_oc=AdoGHTCiQeCsc1HcWgOf1yZLM60HUg-v2ABnhFvX0Ln78n6K71fXH7x_aP8sGbYyf1g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EBvkCKSCQlBAj0BUM-N
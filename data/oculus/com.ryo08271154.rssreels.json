618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POzAzbQzShoQ7kNvwHJkVPl&_nc_oc=Adq0NatfwcmAVdSQMC_OSV1iiC9ZWqjyw6NM-6L0niOyP0Rx8VmRK4yhAkGt4ClxtME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLcac0xS5N76ScimmuOW6ZaALk-I4ZvLwh21MOtyF0JQ&oe=6AEB3E76"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alMFjTubeMgQ7kNvwFIAgpu&_nc_oc=AdobczCsLK9l3KS3X2rakShgbjAzBxvllyyvAn7tPQ0l3eMhjy2nnIuB6QSuTAo55OE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqxqDW6Wvky5nurER9E9JCayJMeXhlSzt2w58STCHRXQ&oe=6AEB5002"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9zGdV9t04sQ7kNvwEhOT_a&_nc_oc=AdrpFFY_-EdsQ3GeskI5mAIp-86xOxAEVIR7vkSFV0mPU0K-nTMDKhHSBEZJ225a618&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtdCSoa3361KlTAn13iPACyx-ArA_q4JzrP6tvL7HT3g&oe=6AEB5ECD"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
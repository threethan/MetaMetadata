618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fv66il1FndwQ7kNvwHlUoUB&_nc_oc=Ado7bkL_oF1bxBvRRF0twDCZLvXVVU0JuAp-mrwwATiHRtKAeFdDX5WJOuWUoO6Weg0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOxHL4Df4RmVGrZsw4kAOYT6XnXb0OMCOaJkYEJ5TMwA&oe=6A998176"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kb0SibS9DW4Q7kNvwGyCbbC&_nc_oc=AdoHLXC7XOpWsU0zf9LvS6F0w6aG9C2ocNScjNBSuT4CiOS71OHmJ-pDO48DCpJ8ASY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIjp_tsgraS7QsxbQg-aK75U5RbVwxSpyzLBw2Hk6bAA&oe=6A999302"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAzv3PV_-OYQ7kNvwHqU6Si&_nc_oc=AdodzawvUYHvMYe5ZXEf7gJGeiFooouy-bRoRKstfLwuSkbULOvQFHE0HmvqWEnLIc8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8UcNV7DbFAtMrvtpUNHQk56Pyfc4JG8nEIRHaY6kHVw&oe=6A99A1CD"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
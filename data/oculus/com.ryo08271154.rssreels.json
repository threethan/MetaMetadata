ea5-1.oculuscdn.com/v/t64.5771-25/499303585_1223622483144098_7063076556162011975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qWZfG08BCcQ7kNvwF7XOJ-&_nc_oc=AdrW3cg4aDQlP_x_OWxwoE_mZEtyfpiazkwDmxmKy0_rBO_zmn57nPS1AqKFp3Nxgx8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95uPJGrM_nrM-oGNVuOc6z6CQvd051cNLhfw0KgggGFA&oe=6A45128C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Scroll", "keywords": ["RSS", "news", "feed", "Reader", "Articles"], "long_description": "RSS Scroll lets you add and manage your favorite RSS feeds, then browse articles in a stylish card-based interface or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article cards\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in card and list views."}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7H2w30sFBYQ7kNvwEfEjez&_nc_oc=AdpA_NyjqVOAAMg3KuqSV8G0b5y3oaUfV81yVArwM6TLT4PW84XatK0-eYv0ywsTZN0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Zw3MRz7Uqa7IAQmUrnHIe6tFajMbg9kzR47Txa5PsNw&oe=6A45098D"}, {"file_name": "icon.png", "id": "1598558734570356", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618264_1598558737903689_1704160935439350811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9puR-ilMIYQ7kNvwFUauey&_nc_oc=Ado-iDsWq_frqCJFeg-IpkoM_H0CXBUO4lbRUG-0Tyi_dBrEq4Kj5U5XRwbIWNDSx3E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B4JPbguihpbP-z80u_s
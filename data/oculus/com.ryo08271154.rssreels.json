618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7bN0uRTXKcQ7kNvwGP8OOk&_nc_oc=AdpdvLtQUu3Bu8m72_6oVBpFZIVZkLu0gKAUnrz4z7zBCxD9VbiMxD61fd3UgjpP7tQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCa-q8Cz6rVDqHPsLqp8Vmg_o3XIQJ7nKRUxnbmwt8pg&oe=6AF9BEF6"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iPYwdYeJb0Q7kNvwFjMNfD&_nc_oc=AdpL2h0V5Vx_btsJ6aazrveWWrMeAQiGoWrUlyCEeeArjTE9DyiDOMmAmxZBWCz5pPQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3mdi_ppRGVHToQaizzSK0yOhPL-3OLOsfotpOv7oLUw&oe=6AF9D082"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doBC0I5gOgIQ7kNvwGQaU8G&_nc_oc=AdoVTuufXKAoMA2k5eQutk5nHmN-NuOcabEKI1ZQ4856o1ZB_gx_2CKf8ToEsisAIn8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPslR_hvGN27rtboN2ih2xW6XC0x8abc-ry3ijIgp-uQ&oe=6AF9DF4D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7bN0uRTXKcQ7kNvwEuh78H&_nc_oc=AdqPLJkWnIeaQYFTQyYVUh2W5JF_XCbBmMrV8nvIE3pDaxcw_2trLbq-LxrR4n8chKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT13aFwgs1mL4E98l3p16Da3zW1t1kZ6or4JKEjzbe9Gw&oe=6AF71BF6"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbdArwzP6XMQ7kNvwFsy7oP&_nc_oc=AdrwXNj07SOmh0dHjLH4bhwSDjPqGYhRozHCv4Rdmhpu-MNY1UhnHGeogAhm23opmQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdWthZaPsKGpXVsBPYci3WbkdV5jrAtmwUguzwmpqG7A&oe=6AF72D82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doBC0I5gOgIQ7kNvwGoCmyj&_nc_oc=AdopYwLZDs1N4h7FHKquys3N4J1j9I0Fe9wLcuUFkim8OIaOYo7uKnp_vBKWTwt5Rgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY_-xVKHjmWdaih9Un38goF_Cdf_LKG1wGz8mRhl5rAg&oe=6AF73C4D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
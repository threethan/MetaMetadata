6052", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619588_1001618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JAKfludNAYQ7kNvwGiDvLr&_nc_oc=AdqNZ8w6TdzpjK6GlgrO6_pQ0cMaMKnV7BExme5aXfFsXZDgXiW8IeN20uzVpodF4aM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99mGHOF44pzmOya3nkx4DSIScv2KmFLGTlrGBnkvM9gw&oe=6A36A0F6"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHK2ghLkDfoQ7kNvwFFO12E&_nc_oc=AdoETvWjMwjLfuJWjj5tcSzHnH3vWi_AvW1Xvxzh00dwo3_swotn2lI6AvvbVpuuyxs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l4IIuF5TpF-da6KQQuc9MDTrfl8SAI5wrh0mkZnlF5Q&oe=6A36B282"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Scroll", "keywords": ["RSS", "news", "feed", "Reader"], "long_description": "RSS Scroll lets you add and manage your favorite RSS feeds, then browse articles in a stylish card-based interface or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article cards\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in card and list views."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ryo08271154.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ryo08271154", "support_website_url": null, "website_url": "https://github.com/ryo08271154/rss-scroll", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id":
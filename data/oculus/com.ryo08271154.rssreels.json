618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4biU-2M3fzgQ7kNvwEyubeQ&_nc_oc=AdpWOIBCB1yUdpMp_AOBzVcCp0e9YVZTuAyVNQLbZ47ni-KnJeq2mKW_BCsnySZDZQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg3jlbA5OK1wECTGOlRKZDaeVwsvhB9uMPg1wRD4x_vg&oe=6ABFBCF6"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2qTIJ5dlgoQ7kNvwF7gJ8L&_nc_oc=AdptUGER7a-bn2qVP8MErx6iLfHxp1TvFZG0Vn5N0kecttSLVBTG2ES4d607kGMl4mA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlfIVRzaeAMTzFWGUh3-tjUm3y7lPTfgIyQaAA8cLWLA&oe=6ABFCE82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EC-2QxxCgcAQ7kNvwHKfPlg&_nc_oc=AdpO1FvcHi-1MSbhE2aPNveBEYkQU9mo0tSV4spruQJZTItVmvEbeN7WEmNdo9wBcsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7d7s6RRZpq58mXsAt6iHDUT8y9qBrNhyCatoKKGJ1Og&oe=6ABFDD4D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
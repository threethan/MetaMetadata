618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5wUJx3XUGAQ7kNvwExs0XO&_nc_oc=AdrTJ1B_JVpUTNZrCEXuBOr0FcbhMoAhQX7dyQXzS7Y03aVLSAkREFABzp5nCZpcnLs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqXeI1F7TNoyug9Y9AOmRByhUN9HvToq_2jJF2Rkx2Uw&oe=6ADE0F76"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdZEPZMLlwcQ7kNvwEbw-Az&_nc_oc=AdqVAOBvaZJTykDpw71jRmh7P2ueLHgbbEyaA-ZnNGIC-1Uz4hmXdn0QLn5b7vuGqgM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcR53DRDyHfnOQJHdbAhFqEKPDrKe6N7d4v_injCn3rA&oe=6ADE2102"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFRmeAwMbbcQ7kNvwGRm-Su&_nc_oc=AdoNECV_ZbzpLuUAwIC_n85rz9sj23dLTdrTG33Ge3Vt5dsj3w3Unxa6Ey7xltQ6MKk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM32hwnxwwhsCL-JkLdRMBvnyD2QQdawKCe5gwmTwtooA&oe=6ADDF78D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
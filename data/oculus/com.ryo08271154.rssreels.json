jc6-1.oculuscdn.com/v/t64.5771-25/499303585_1223622483144098_7063076556162011975_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAE5ZwsAMkYQ7kNvwG0Vnj1&_nc_oc=AdozU8ZAU3--EhRQo1eP7pw7WhHrHBucMQ_Gw9avE6bPeVkXjCEpjrA0DZa0dO3G9wI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA63SbAPzugWijcuPi_mqJP1VeXGd9guq3tA88xd0rXwA&oe=6A6DF10C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Scroll", "keywords": ["RSS", "news", "feed", "Reader", "Articles"], "long_description": "RSS Scroll lets you add and manage your favorite RSS feeds, then browse articles in a stylish card-based interface or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article cards\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in card and list views."}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqBYQf_-q-QQ7kNvwHV3E3s&_nc_oc=Adpy594Bw7vKzvOCOLKLfYaenanU567DhS-6MpBJQvJuLkUHrvDMV3MYBlNQ-MJMn2Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDT7Rfg0TMP-uDOHQk90TW3Ke5VV66_JIU7HVHZLcVJEg&oe=6A6DE80D"}, {"file_name": "icon.png", "id": "1598558734570356", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618264_1598558737903689_1704160935439350811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJpeE5A0d1QQ7kNvwFvmqFR&_nc_oc=Adr4TvCkfQl1QnWX9B6MfEtOGYmdWb911Y2lKPPt9R_-hjHPn0z3At6wp5NQOkmBXW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYMzK1PCKvFv8DA_puWW
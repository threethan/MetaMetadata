618869119385_1283050139905392624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6duVmLXEW40Q7kNvwEucU5Y&_nc_oc=Ado2hQGLUplLz5nP9Bh5GGvt3cwKM9lXlLBbAr6KEVmvtnnLeXNqiFdLBNbbuqwwJeU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTjvrLJAfb0hLhu3L8cf4WrJBY-Gi7aN4vX3J4kk1mvA&oe=6AA6B076"}, {"file_name": "Screenshot_1778905214.png", "id": "1401134038706839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_1401134042040172_2300170311161760758_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aV7bdpDHjRIQ7kNvwHA5beo&_nc_oc=Adrs3o2q9TKqTKLZ5JelZS0N13e9vwTkYiAM_UZoXhB4XmUTPpiPXqMuTpvjQEVQp0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs8eMVlbx_k-_UDPHDQ7mK2G6wd9ZPRikFESnvnnfwXg&oe=6AA6C202"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RSS Reels", "keywords": ["RSS", "Reels", "news"], "long_description": "RSS Reels lets you add and manage your favorite RSS feeds, then browse articles in a stylish reel layout or a traditional feed list.\n\n- Add any RSS feed URL\n- Home screen shows full-screen article reels\n- Feed screen shows a fast list view\n- Filter articles by category\n- Open articles in your browser\n- Supports Japanese and English\n\nPerfect for news, blogs, tech updates, and hobby sites \u2014 build your own personalized content stream.", "short_description": "A sleek RSS reader that shows your feeds in reel-style and list view"}, {"images": {"nodes": [{"file_name": "rss-reels.png", "id": "26677083185285001", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_26677083191951667_4710502587857460224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_YlL05XvYUQ7kNvwGmPMa-&_nc_oc=AdpDNRedWM-UnECRhz_EsWnraLZpb0zOGdKBcWDvY9FmQ8K-KLhPTjnsbXZbKpl04V8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH_-jXKl-UCHBcDQNVQFbaYRSVbvXseZTqF6iK05Nm3A&oe=6AA6988D"}, {"file_name": "icon.png", "id": "1598558734570356", "imag
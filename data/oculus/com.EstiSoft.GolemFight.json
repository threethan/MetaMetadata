c_ohc=iLM3HFQpmN8Q7kNvwHof8eX&_nc_oc=AdojeuEB5rf70XE_LGcQoUI-0BjBAha-hdN-snsRpkMNOq-dwDhz6YHy6hvGshLoy18&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Fs3MHtwu01w35-uHXLn0DJN7pGvKz4mXpgqNNAwTSoA&oe=6A1C5C1C"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-10 183056.png", "id": "1679184529605555", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57574720_1679184532938888_1629675207595944339_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7i4UX49C1AQ7kNvwE2lqVA&_nc_oc=AdoJfbIFjL7OGs0up5NSAlgVkEMoKQmYTM4Oqf-oXUjVGcnP6OWrLrKxBw_mu7LH7tw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61tWD9pS-eTuH0_GJW_A8SPSP33Qvw88eEFIQkN1LW4Q&oe=6A1C48AC"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-10 183153.png", "id": "581878690832173", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/65227798_581878694165506_3766623363989074323_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YF-IEjseTzcQ7kNvwGwwC2l&_nc_oc=AdoaR_M31bsfGLNActJrPGCiJ7v3TN7GYk5mjmozvPFx1Q4-CBo5yiIbamgBMy_R11I&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AVGOcuULVg9V7vxfGp4hh5QnSzr1oAXMNgJP1KIV68Q&oe=6A1C589D"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-10 183216.png", "id": "1075219343824134", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035452_1075219347157467_8211130423338084045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HUJXwmhITQQ7kNvwH2Uh1H&_nc_oc=AdoWSbLdQ3Yop9kekXAEy50z-mC0wW2bX5F5oFFD4vWImgqpwW6BNT2ukUbChXm_3rg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QV7oJFcMAUDP29UYAz_Nb_QPieSW18X-6hdvgssfIxw&oe=6A1C30E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-10 183129.png", "id": "1661381151086168", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982689_1661381154419501_8383096373754950663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0pGx6b-XCUQ7kNvwEGyfWP&_nc_oc=AdoTN3WCzAbleKPp2MU7ABLn42RN4b5ZKlpMx5kRyAQ8WPzk6CYpxFlAJezCwOmCj0U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wR_rIw-iELLS2320V7Wu7c8VjH2Ad5-CZmbtzlAQI5g&oe=6A1C314D"}, "display_name": "Golem Fight", "keywords": ["Golem", "Fight", "Action", "Elite", "Comfort"], "long_description": "Golem Fight immerses you in a fantastical world where ancient golems come to life, each with unique elemental powers and complex attack patterns. Engage in thrilling VR combat as you battle these formidable creatures across beautifully crafted landscapes, from fiery lava realms to frozen tundras. Armed with customizable weapons and powerful abilities, you must think strategically, dodging attacks and finding weak points to bring down each mighty golem.\n\nIn Golem Fight, your skill and reaction time will be tested to the limit. Choose from various combat styles, upgrade your weapons, and enhance your powers to face tougher foes. Each victory brings you closer to discovering the secrets behind the golems and the magic that animates them.\n\nWith immersive VR graphics, responsive controls, and intense battles, Golem Fight offers an unforgettable gaming experience. Can you rise to the challenge and defeat the golems that stand in your way?", "short_description": "Embark on an epic journey in Golem Fight, where you take on powerful golems in intense battles across mystical realms. Utilize unique weapons and strategies to overcome elemental challenges, customize your character, and uncover secrets of the golems\u2019 origins. Each encounter tests your skills and wit, keeping you on your toes with immersive VR action. Will you conquer the golems and become a legendary fighter? Dive into Golem Fight and start your adventure now!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1YREtHXXNdi4ChUND-y3CkTMW60-pwN1J/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "suppo
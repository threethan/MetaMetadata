771-25/38974662_1652131015652032_3992927585666001137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KxzWorQZg8Q7kNvwFmJwHc&_nc_oc=AdpfUomNvlt5VnA8q86er1AvM5QrSjBLlF27zjc1bDzysKoMMlGEaSjdAga2ijEfSKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pG2OFTW6I6GXH-h-hvynyDmVz8bRWrIEXQ2QhGj7eZQ&oe=6A0DA399"}, {"file_name": "Screenshot 5.png", "id": "878827037650990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974662_878827040984323_2420544056447245755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRbbhzT60VcQ7kNvwFL7PAc&_nc_oc=Ado95s1cVTj2a3bEafc8ML-dDmfF3vabH8xZZV8WpRFGaRCwj4qkrnTk4hv5zJPRfLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Eg3TuIjQQ_jiyvDVAV9PNc9HLgrzilF_I9L_g22Ul9A&oe=6A0D9DA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceStylistic_CoverLandscape_06.png", "id": "943067097914510", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984472_943067101247843_4051161228891620436_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZnfpAEfTg0Q7kNvwF-xcWL&_nc_oc=AdozzcTjO-Z4BUj41OXUpmh4eKGdiZWOx5V6HPyVrfmTfeHBz7LSa6DkGeUDA3maNEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ygKKh9THF2asrU9-xgF0MUkUHeTHNueBZ4AKBTtb_Kw&oe=6A0DC159"}, "display_name": "Into the Scaniverse", "keywords": ["travel", "explore", "photography", "3d"], "long_description": "Travel the globe and dive into incredibly vivid 3D scenes, from famous landmarks to hidden treasures, made by everyday explorers. Or create your own 3D scans with your phone, then experience them instantly in VR. \n\nThousands of new perspectives, with a community spanning 120 countries adding more every day... all waiting to be discovered when you step Into the Scaniverse.\n \nDownload now for free!\n\n- Explore 3D scenes in VR, captured from around the world\n\n- Over 50,000 scenes in 120 countries, with more added daily\n\n- Zoom in to any point on Earth to discover new perspectives\n\n- Create your own 3D scans on mobile and view them instantly", "short_description": "Travel the globe and dive into incredibly vivid 3D scenes, from famous landmarks to hidden treasures, made by everyday explorers. Or create your own 3D scans with your phone, then experience them instantly in VR. \n\nThousands of new perspectives, with a community spanning 120 countries adding more every day... all waiting to be discovered when you step Into the Scaniverse.\n \nDownload now for free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nianticlabs.com/privacy?hl=en", "developer_terms_of_service_url": "https://nianticlabs.com/terms", "publisher_name": "Niantic, Inc", "support_website_url": "https://community.scaniverse.com/c/its/22", "website_url": "https://nianticlabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9087287221386155"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "859666573033502"}]}, "baseline_offer": {"id": "859666573033502"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740513900, "status": "PUBLISHED", "id": "859666573033502"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9440376869410520", "version": "0.9.0"}, "id": "900679195347177", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primar
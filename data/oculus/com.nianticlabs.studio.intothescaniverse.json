 countries adding more every day... all waiting to be discovered when you step Into the Scaniverse.\n \nDownload now for free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nianticlabs.com/privacy?hl=en", "developer_terms_of_service_url": "https://nianticlabs.com/terms", "publisher_name": "Niantic, Inc", "support_website_url": "https://community.scaniverse.com/c/its/22", "website_url": "https://nianticlabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9087287221386155"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "859666573033502"}]}, "baseline_offer": {"id": "859666573033502"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740513900, "status": "PUBLISHED", "id": "859666573033502"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9440376869410520", "version": "0.9.0"}, "id": "900679195347177", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8575253579256191", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9440376869410520"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "cha
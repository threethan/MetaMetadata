 new perspectives\n\n- Create your own 3D scans on mobile and view them instantly", "short_description": "Travel the globe and dive into incredibly vivid 3D scenes, from famous landmarks to hidden treasures, made by everyday explorers. Or create your own 3D scans with your phone, then experience them instantly in VR. \n\nThousands of new perspectives, with a community spanning 120 countries adding more every day... all waiting to be discovered when you step Into the Scaniverse.\n \nDownload now for free!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nianticlabs.com/privacy?hl=en", "developer_terms_of_service_url": "https://nianticlabs.com/terms", "publisher_name": "Niantic, Inc", "support_website_url": "https://community.scaniverse.com/c/its/22", "website_url": "https://nianticlabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9087287221386155"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "859666573033502"}]}, "baseline_offer": {"id": "859666573033502"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740513900, "status": "PUBLISHED", "id": "859666573033502"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9440376869410520", "version": "0.9.0"}, "id": "900679195347177", "channel_name": "LIVE"}]}, "is_for_o
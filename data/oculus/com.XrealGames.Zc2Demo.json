?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_aH_3eHgcAQ7kNvwE3IBtP&_nc_oc=Adp2gF1v8vgxFyCbneMxttPNLvk0vGXTuqi1Yps4R7Q8OfU00w6LZ3iFv3z63kfMvwA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLVWfKCeXFsfPdg8sdgNHsmSuBqdF6iwkPHaeyxi6dRQ&oe=6A9C1010"}, {"file_name": "2k_SR_Screenshot01.png", "id": "1390489458973454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821191_1390489462306787_5057026409774328667_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGTVq3EAU0QQ7kNvwGShL6a&_nc_oc=AdqSeNt-dzB-klmDq39boiXj32LQ7JDNe9L97ovV13bPeAXQ2q0lVzeB7_JOUH-km1s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx-RDuIAWk0BYHFVskZ48GHCq0kPAllUmHoz7b_LDCZg&oe=6A9C405B"}, {"file_name": "2k_SR_Screenshot06.png", "id": "2946795042150773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824507_2946795045484106_8067382748074250919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3JtuOmHaQQQ7kNvwGLI5UI&_nc_oc=AdrMqJSGsOoFl6p9OIr7l7Fl5MnULFNRr6sjCCPXHwBsiLPFa--FeEh02ZnwQJBhwzQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv2GzK0R0mCoU9_bZw_APCJpqYArBB2SD0duMvzFmo-A&oe=6A9C386D"}, {"file_name": "2k_SR_Screenshot04.png", "id": "710336394682616", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819530_710336398015949_3751420875472518890_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bqM8s2RpBkQ7kNvwE42wKm&_nc_oc=AdpOA2i8Z7hc-KSuprGMlySUV1-SFCayVHFUF8AD3UDcMblz3di-xth6k1XkV_qJbV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUh6itDrPxiIbMqwB3cLQlTXYTZJpE_xtG1bnnD8sH8w&oe=6A9C3E80"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zero Caliber: Shooting Range", "keywords": ["shooting", "range", "weapons", "shooter", "fps"], "long_description": "**Hey there, Friend!**\n\nWelcome to the **FREE** Zero Caliber: Shooting Range experience - your all-access pass to over **40+ realistically modeled weapons**, complete with attachments and our signature, **state-of-the-art** gun handling and weapon physics.\n\nStep into the **fully unlocked** armory and grab any weapon that catches your eye. Whether you\u2019re all about precision sharpshooting or full-auto chaos, we\u2019ve got you covered!\n\n{650781714489237}\n\n**Here\u2019s what you can do:**\n\n- Choose from a **wide range** of pistols, SMGs, shotguns, assault rifles, snipers, and explosive weapons\n- **Customize your loadout** with scopes, grips, lasers, and more\n- Hone your aim at the **shooting range**\n- **Test your reflexes** in the fast-paced Killhouse(s), hidden in the basement\n- Prove your skills in one of **4 challenging minigames**\n\nLike what you\u2019re seeing? Keep an eye out for **exclusive coupon codes** hidden in the lobby to grab **Zero Caliber: Reloaded** and **Zero Caliber 2** at a discount - both packed with:\n\n- Single Player & Co-op Campaigns\n- Intense, action-packed PvP Multiplayer\n\nAnd don\u2019t forget to **join our Discord** - connect with the community, get in on giveaways, and be the first to hear about future updates and new drops:  \n-> discord.gg/xrealgames <-\n\n/// Lock. Load. And have fun out there, soldier! o7\n", "short_description": "Jump into this polished, FREE VR shooting experience! Try out tons of awesome weapons, mix and match attachments, hit the range to practice your aim, and race through the killhouse to test your skills. It\u2019s all about fun, fast action, and cool guns. Time to gear up!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrealgames.com/aboutus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://sites.google.com/xrealgames.com/aboutus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "45978150496
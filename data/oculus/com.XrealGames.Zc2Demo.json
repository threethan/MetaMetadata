?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbzGqCsdwAUQ7kNvwErAf91&_nc_oc=AdqCLlWZGNvo6wLuaaZ56NOQ6eckV8mWzlE6M7MuMFrcDrWyVEBswtJkMMMuX11bxmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7jhXKCWJqlOPO9wafWlLTd1WGDTvo9_iPBFSBZMO_Fg&oe=6A996D10"}, {"file_name": "2k_SR_Screenshot01.png", "id": "1390489458973454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821191_1390489462306787_5057026409774328667_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGTVq3EAU0QQ7kNvwGbGF6I&_nc_oc=AdpNZvYKAGBmB1gWXMjef7yPDfauZpa9_ByQ9VHxZzTZDDjJvTYJtxcNUPHDiM10BNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGYQI2SMN47ukjfHM2l1lQ4WooCPVOKrC7Dd_Q9J7O2Q&oe=6A999D5B"}, {"file_name": "2k_SR_Screenshot06.png", "id": "2946795042150773", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824507_2946795045484106_8067382748074250919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3JtuOmHaQQQ7kNvwFEvd9c&_nc_oc=AdoaZlVaGEr3u9P6ng7KBz-SsAK4Z-E7HQlbVZZKcyxN8zQWQSM7vQNhiumejOMcVS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJViPAlyLfvDUxoIasRBRPf_TTjLR8FZLTfXvlr3J-Fg&oe=6A99956D"}, {"file_name": "2k_SR_Screenshot04.png", "id": "710336394682616", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819530_710336398015949_3751420875472518890_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeiOCQPRI_UQ7kNvwFpSfiP&_nc_oc=Adr-HkCIw-qHQzi4N5Q4Q7naejMOtrEy4s2kVPwaayv6vn5ece0ZE8Ds9udH36i-EZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp-j1KO6_6F_Z3hgujTM7hTet-tyvir_ufDD_-egle4A&oe=6A999B80"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zero Caliber: Shooting Range", "keywords": ["shooting", "range", "weapons", "shooter", "fps"], "long_description": "**Hey there, Friend!**\n\nWelcome to the **FREE** Zero Caliber: Shooting Range experience - your all-access pass to over **40+ realistically modeled weapons**, complete with attachments and our signature, **state-of-the-art** gun handling and weapon physics.\n\nStep into the **fully unlocked** armory and grab any weapon that catches your eye. Whether you\u2019re all about precision sharpshooting or full-auto chaos, we\u2019ve got you covered!\n\n{650781714489237}\n\n**Here\u2019s what you can do:**\n\n- Choose from a **wide range** of pistols, SMGs, shotguns, assault rifles, snipers, and explosive weapons\n- **Customize your loadout** with scopes, grips, lasers, and more\n- Hone your aim at the **shooting range**\n- **Test your reflexes** in the fast-paced Killhouse(s), hidden in the basement\n- Prove your skills in one of **4 challenging minigames**\n\nLike what you\u2019re seeing? Keep an eye out for **exclusive coupon codes** hidden in the lobby to grab **Zero Caliber: Reloaded** and **Zero Caliber 2** at a discount - both packed with:\n\n- Single Player & Co-op Campaigns\n- Intense, action-packed PvP Multiplayer\n\nAnd don\u2019t forget to **join our Discord** - connect with the community, get in on giveaways, and be the first to hear about future updates and new drops:  \n-> discord.gg/xrealgames <-\n\n/// Lock. Load. And have fun out there, soldier! o7\n", "short_description": "Jump into this polished, FREE VR shooting experience! Try out tons of awesome weapons, mix and match attachments, hit the range to practice your aim, and race through the killhouse to test your skills. It\u2019s all about fun, fast action, and cool guns. Time to gear up!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrealgames.com/aboutus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://sites.google.com/xrealgames.com/aboutus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "45978150496
_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D92erweLMd8Q7kNvwGRIoHh&_nc_oc=AdqcfVko13lmpvZywbUuNiKlt4VfHu74WgFBUBBTpsdHh211lQWZY4zkskPadp6ySMw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ0geRkll_AJovV-5T2Vda3NdA2_hVUM-Kv1oxJTY1kg&oe=6AFF1F00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zero Caliber: Shooting Range", "keywords": ["shooting", "range", "weapons", "shooter", "free"], "long_description": "**Hey there, Friend!**\n\nWelcome to the **FREE** Zero Caliber: Shooting Range experience - your all-access pass to over **40+ realistically modeled weapons**, complete with attachments and our signature, **state-of-the-art** gun handling and weapon physics.\n\nStep into the **fully unlocked** armory and grab any weapon that catches your eye. Whether you\u2019re all about precision sharpshooting or full-auto chaos, we\u2019ve got you covered!\n\n{650781714489237}\n\n**Here\u2019s what you can do:**\n\n- Choose from a **wide range** of pistols, SMGs, shotguns, assault rifles, snipers, and explosive weapons\n- **Customize your loadout** with scopes, grips, lasers, and more\n- Hone your aim at the **shooting range**\n- **Test your reflexes** in the fast-paced Killhouse(s), hidden in the basement\n- Prove your skills in one of **4 challenging minigames**\n\n# If you enjoy the Shooting Range, check out the rest of the Zero Caliber universe for the whole package: \n\nhttps://www.meta.com/experiences/zero-caliber-reloaded/3591949650852844/ \nhttps://www.meta.com/experiences/zero-caliber-2/6072194326150034/ \n\n- Single Player & Co-op Campaigns\n- Intense, action-packed PvP Multiplayer\n\nAnd don\u2019t forget to **join our Discord** - connect with the community, get in on giveaways, and be the first to hear about future updates and new drops:  \n-> discord.gg/xrealgames <-\n\n/// Have fun out there, soldier! o7\n", "short_description": "Jump into this polished, FREE VR shooting experience! Try out tons of awesome weapons, mix and match attachments, hit the range to practice your aim, and race through the killhouse to test your skills. It\u2019s all about fun, fast action, and cool guns. Time to gear up!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrealgames.com/aboutus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://sites.google.com/xrealgames.com/aboutus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37647927824852040"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824215_699159326014188_5707121966023454245_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEmqYwnOFOYQ7kNvwEoSo1R&_nc_oc=Adq4-tfnF5zJIEL_YPOZExaagMBPXNDpLzJPVByRWxw8BAoLWtZ3ISUUQ-vml6b5CYc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYfA3h9GOuguL4LqPKGCxwX8diAP7tlRIJKOBKxKyYIw&oe=6AFF113E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zero Caliber: Shooting Range", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "37
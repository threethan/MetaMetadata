culuscdn.com&_nc_ss=7f20f&oh=00_AQEbboc94IcTe3rM6-AjzfsDAOEzj3xpv4KL6PZo2Lo5rA&oe=6A917C1B"}, {"file_name": "2k_SR_Screenshot06.png", "id": "2946795042150773", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491824507_2946795045484106_8067382748074250919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIxwOl-msa8Q7kNvwF5Zdlf&_nc_oc=AdqwuCKKpVG1gH2_ZEDnkSCWXqlCDa5sXrnvXlpXHSETfPKztFBw55o20JFRVKmJbis&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDpa5yWrQJE3j_1luWcuumyME0bSc5II0c3mBbhAk8bQ&oe=6A91742D"}, {"file_name": "2k_SR_Screenshot04.png", "id": "710336394682616", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491819530_710336398015949_3751420875472518890_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dg-VvVPzMcUQ7kNvwHGpsfu&_nc_oc=Adql4JZE-uMSImNVU721ogCHUO-AjIE5Q94isQKibmDazAY1OPn2NZNIoXhU8FpnDn8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQcXV0LqKr-R1uwzXjVTFnpO-zR73JsOHg1FxlwgA3jA&oe=6A917A40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zero Caliber: Shooting Range", "keywords": ["shooting", "range", "weapons", "shooter", "fps"], "long_description": "**Hey there, Friend!**\n\nWelcome to the **FREE** Zero Caliber: Shooting Range experience - your all-access pass to over **40+ realistically modeled weapons**, complete with attachments and our signature, **state-of-the-art** gun handling and weapon physics.\n\nStep into the **fully unlocked** armory and grab any weapon that catches your eye. Whether you\u2019re all about precision sharpshooting or full-auto chaos, we\u2019ve got you covered!\n\n{650781714489237}\n\n**Here\u2019s what you can do:**\n\n- Choose from a **wide range** of pistols, SMGs, shotguns, assault rifles, snipers, and explosive weapons\n- **Customize your loadout** with scopes, grips, lasers, and more\n- Hone your aim at the **shooting range**\n- **Test your reflexes** in the fast-paced Killhouse(s), hidden in the basement\n- Prove your skills in one of **4 challenging minigames**\n\nLike what you\u2019re seeing? Keep an eye out for **exclusive coupon codes** hidden in the lobby to grab **Zero Caliber: Reloaded** and **Zero Caliber 2** at a discount - both packed with:\n\n- Single Player & Co-op Campaigns\n- Intense, action-packed PvP Multiplayer\n\nAnd don\u2019t forget to **join our Discord** - connect with the community, get in on giveaways, and be the first to hear about future updates and new drops:  \n-> discord.gg/xrealgames <-\n\n/// Lock. Load. And have fun out there, soldier! o7\n", "short_description": "Jump into this polished, FREE VR shooting experience! Try out tons of awesome weapons, mix and match attachments, hit the range to practice your aim, and race through the killhouse to test your skills. It\u2019s all about fun, fast action, and cool guns. Time to gear up!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrealgames.com/aboutus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://sites.google.com/xrealgames.com/aboutus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29303492502628989"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1074211201393757"}]}
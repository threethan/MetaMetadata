n.com&_nc_ss=8&oh=00_Afyp-hbPB8tNKqHd0gnCDIEa7-WmXpojieHgjExTgqIwwA&oe=69AAB040"}, {"file_name": "ss03.png", "id": "1466671063756980", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86594844_1466671067090313_1309305107032942561_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2TmY9lAn2wQ7kNvwGuLqki&_nc_oc=AdmlLmmNrq30zyPgmNcAR44KnG5c2MNHMH-D7NKeM6vyp0GMzg38jvvAJ-h2Yz-hBo8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4QnuZROMvYs2Xku4zbh_3u6WxHWThrSubl5G43PMYpA&oe=69AABC33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_landscape.png", "id": "459150489394266", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39036653_459150492727599_4756986351249509452_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=615Hl3oei6QQ7kNvwEOIQ3f&_nc_oc=Adkq-YBqMDEruA9-RJHPIPkUyw67Vyt2wfegYMSRJeB8VQ4PaOKsgrplhNC6S9Ujmr8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxaq9Cc5XVKHuO_-VIL_wRxqnfmpivMeO2VWLRvVhWSeQ&oe=69AACD3C"}, "display_name": "PUNCH FIT", "keywords": [], "long_description": "Punch Fit is the answer to your exercise needs.\nFollow the example and punch and dodge for an easy and fun workout.\nLearn various combinations of punches, dodges, and rushes to make your play more exhilarating and pleasant.\n\nOVER 50 WORKOUTS\nEnjoy a workout that suits your needs in terms of time and difficulty.\nWe plan to add more and more new workouts in the future.\n\nEXERCISE REWARDS\nExercise and earn drop points to get skin packs.\nYou can get over 100 skins.\n\nEXCITING BACKGROUND MUSIC\nWe have prepared a variety of background music to match your workout.\nLet's get into the groove and have fun.\n\nUPCOMING UPDATES\n- Add new actions\n- Add new workouts\n- Add new skins\n- New environments\n- Manage play records\nand more...", "short_description": "Punch Fit is the answer to your exercise needs.\nFollow the example and punch and dodge for an easy and fun workout.\nLearn various combinations of punches, d
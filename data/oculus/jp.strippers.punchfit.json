66671063756980", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86594844_1466671067090313_1309305107032942561_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExOGjeuBYH8Q7kNvwGBwz0J&_nc_oc=AdnOQLsHc4DM7uh9sjTKV26K0QPpzd75fgurnhpcACCtm5dKGvpolwgowEcVapRAkNo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfunXrTe9ag8MyUE2i6iwKpedRpGXBX-_2lWFQGhmgDr-Q&oe=699C3BB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_landscape.png", "id": "459150489394266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036653_459150492727599_4756986351249509452_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hncQA5hg9gAQ7kNvwG7FkRj&_nc_oc=AdkJC5PdCDI20fSXTss7L4hBxWsCUmu9ruj7YIpo0WlyEWbKywf6wZUKpALO0g4AKo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu2RsyYA844Vs-vJ4cKWZsU5ttn_kpIpVvd53plI3uivA&oe=699C4CBC"}, "display_name": "PUNCH FIT", "keywords": [], "long_description": "Punch Fit is the answer to your exercise needs.\nFollow the example and punch and dodge for an easy and fun workout.\nLearn various combinations of punches, dodges, and rushes to make your play more exhilarating and pleasant.\n\nOVER 50 WORKOUTS\nEnjoy a workout that suits your needs in terms of time and difficulty.\nWe plan to add more and more new workouts in the future.\n\nEXERCISE REWARDS\nExercise and earn drop points to get skin packs.\nYou can get over 100 skins.\n\nEXCITING BACKGROUND MUSIC\nWe have prepared a variety of background music to match your workout.\nLet's get into the groove and have fun.\n\nUPCOMING UPDATES\n- Add new actions\n- Add new workouts\n- Add new skins\n- New environments\n- Manage play records\nand more...", "short_description": "Punch Fit is the answer to your exercise needs.\nFollow the example and punch and dodge for an easy and fun workout.\nLearn various combinations of punches, dodges, and rushes to make your play more exhilarating and pleasant."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
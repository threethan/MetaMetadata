 rushes to make your play more exhilarating and pleasant."}]}, "developer_name": null, "developer_privacy_policy_url": "https://the.strippers.jp/punch-fit-privacy-poricy", "developer_terms_of_service_url": "https://the.strippers.jp/punch-fit-terms-of-use", "publisher_name": "The Strippers Co., Ltd.", "support_website_url": "https://the.strippers.jp/punch-fit-external-services", "website_url": "https://the.strippers.jp/punch-fit", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1834614703399671"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "898029443016674"}, {"status": "PUBLISHED", "id": "1240281108050606"}, {"status": "PUBLISHED", "id": "852159260934727"}, {"status": "PUBLISHED", "id": "1545430980120255"}, {"status": "PUBLISHED", "id": "1904239023767786"}, {"status": "PUBLISHED", "id": "1784283656300238"}, {"status": "PUBLISHED", "id": "1676315886352218"}, {"status": "PUBLISHED", "id": "523063000862361"}, {"status": "PUBLISHED", "id": "1750435098838938"}, {"status": "PUBLISHED", "id": "949245410596827"}, {"status": "PUBLISHED", "id": "1040900230641818"}, {"status": "PUBLISHED", "id": "1736136923406820"}]}, "baseline_offer": {"id": "1040900230641818"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "898029443016674"}]}, "liveChannel": {"nodes": [{"latest_suppor
s, creating an intense and enjoyable gaming experience.", "short_description": "Paradox Legacy is a fast-paced multiplayer Horror game where players take on the roles of agile gorillas in a virtual Abandond Landscape. The objective is to Do Objectives while using parkour-style movements to navigate the environment quickly. It's a mix of strategy, reflexes, and parkour skills, creating an intense and enjoyable gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/paradoxllc/private-policy", "developer_terms_of_service_url": null, "publisher_name": "ParadoxLLc", "support_website_url": null, "website_url": "https://sites.google.com/view/paradoxllc/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9318311124873947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391760_1969664706890500_44897611528030469_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWHrJgAqbJcQ7kNvwEEiGhT&_nc_oc=AdmdS7CUV6N16aD3SuzdnecOYKBwY6U4IH1Q-pz-nyAQwtzfmn-IEGIxr14V_n9dwMg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwnFFCzdChRTwlMV3oFqFRJsiuNVVqShpvapSeb08at9Q&oe=69B3F406"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Paradox Legacy", "
1.oculuscdn.com/v/t64.5771-25/12386364_1146241945446987_678732287_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhRKOnWpyroQ7kNvwGCZOWN&_nc_oc=Ado2c2fB6gq5ZVtyKyBgD_mx9Dquw5YiCm845GCElXlnADQZHKTQYEPT7ueqJ8dIS14&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_PTBV6CXTpUV5E_5WyBzPGy6tagy6fMI2OUFiBZfX_w&oe=6B032469"}, {"file_name": "migrated_image.png", "id": "253566082337565", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162726_235634060272098_8823169264841129984_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iz8QpjrnDS8Q7kNvwF7U8oi&_nc_oc=AdoJaHFe1I7O9UVk1MuGsNDIFK7wH1rr0SFNB6s-del08dgqjX1TXGLWtRJPW61tYio&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5FTy_vvrOG1kDxtysWydpak6nb4mN2GFtmj0g_fjCrQ&oe=6B0334D4"}, {"file_name": "migrated_image.png", "id": "2444108945853220", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162678_462477734100836_3605383942707871744_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVo0ckAyNsoQ7kNvwEDmf8Q&_nc_oc=AdpSY7b9OfanqIA3wqPh7CUT2oYxX6541z_nU8IrRymZlv1ny-VjKIyld2CNLyb3vOg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIrwocR5TIJ9ZXt7QHIUOPTwYRb_cUkkliXhSzXFGurg&oe=6B030230"}, {"file_name": "migrated_image.png", "id": "210770770012273", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162675_1874396296147155_3340779223873748992_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYAAeluy9yAQ7kNvwG7_5UJ&_nc_oc=AdpLQgmMb7TTHts_QwDtCjNWfSt_UzTkbzMrYoWoCG6qkA-fjw7o_3Z4lZhlqmrN4rM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-Jmg-INvsJaSvg4usZntSGXCk2dnvZ22n45ZcmKdxww&oe=6B032847"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GEO101", "keywords": ["Geography", "Quiz", "Educational", "Geopolitical", "Map"], "long_description": "Geography in Virtual Reality! See the world around you in 360\u00b0. With this app you will discover, explore and test your knowledge of geography in an immersive virtual reality environment.\n\nYou will see the flag of the country, hear the anthem, and discover interesting information about each country.\nLearn geography in an easy and enjoyable way.\nDon\u2019t remember all the countries? Hints are available.\n\nDiscover, play and learn geography by gazing to find the countries and tapping your selection.\n\nBeautiful and interactive geopolitical map allows you to find and fly smoothly to any country.\n\nEducation and training app. It is aimed at anyone who wants to discover geography from a different point of view and with great precision.\n\nTwo ways of interacting: explore or play.\nHave fun while learning geography and practicing with our interactive geopolitical map.", "short_description": "Geography in Virtual Reality! See the world around you in 360\u00b0.\nWith this app you will discover, explore and test your knowledge of geography in an immersive virtual reality environment.\n\nHave fun while learning geography and practicing with our interactive geopolitical map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://s3.amazonaws.com/navteca/tos/privacy-geo101.pdf", "developer_terms_of_service_url": "https://s3.amazonaws.com/navteca/tos/ToS-Geo101.pdf", "publisher_name": "NAVTECA", "support_website_url": null, "website_url": "http://www.geovr101.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_in
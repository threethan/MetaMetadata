.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/2PCsiJE7H5btfUaJPqU8f1", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/2PCsiJE7H5btfUaJPqU8f1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1137826322016803"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1407946601474606"}]}, "baseline_offer": {"id": "1407946601474606"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790020320, "status": "PUBLISHED", "id": "1407946601474606"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1137882255344543", "version": "0.1.0"}, "id": "1036789819361242", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1137826318683470", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1137882255344543"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1036789819361242"}]}, "change_log": null, "created_date": 1789816078, "id": "
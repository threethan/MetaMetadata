ontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312267_1452474056733745_2523894806350098239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7Y38oElzLQQ7kNvwEqC-K5&_nc_oc=Adp_oRL5xJCTiv37OsE6z14ZPvpIWh5Lka-5hrbe83pKfoJiMrDFjI0epgml3UeFeLA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpSRcUFbkUv4Wg_F5jNsSRoh_V8jl21TNrzisZIGf0hw&oe=6AF880A6"}, {"file_name": "Screenshot_01_day_mirror_2560x1440.png", "id": "1143198604697169", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499297120_1143198608030502_8271532511001347340_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gt-6C9xncfwQ7kNvwGS_Drj&_nc_oc=AdoiJ5W6PnZDN3-EE69-WNy0bzceJTLzQmJr0qtyio8I1ADYUicDpX4r7eppVMe6Dfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3eTOg0uipcmV8W3qwp01TiLP8hZEq82XSDx3jz41Rmg&oe=6AF8A22B"}, {"file_name": "Screenshot_07_dash_shift_2560x1440.png", "id": "2274455563340187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298281_2274455566673520_4236961403197869104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxU1TLZgJZIQ7kNvwHZGD97&_nc_oc=AdpxXFQtGu6KhsNZzlZs48HWi7A4mm3enC4WXN5WslsEYoYjBwoLgRLMvnwerDDGjC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzLm2CG8pVpD686XxEmWyvswdL1Clt_c1JciQt9NNAXA&oe=6AF89E97"}, {"file_name": "Screenshot_08_couple_mirror_2560x1440.png", "id": "2591223374658831", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/755802518_2591223377992164_5459305396609186234_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INNQ_YaEnhQQ7kNvwHCex2o&_nc_oc=AdroEowIrT08EYhoIDkAzfgd4ut8p-UM3sqH2y13zRLOACcinFHA02IsMZeHWc2xARo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjsrpi3AD2rIo8JVdqx1wvbKeyeapzQKXZMLrsXiEDuQ&oe=6AF8ABA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "07_Trailer_Cover_2560x1440.png", "id": "1669313738134479", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312380_1669313744801145_7386318728901036450_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VpCuTjVL6sQ7kNvwEGzJjk&_nc_oc=AdqjatYPFQ6jMvs51sqxBa1M5zKKZTRM0U13n8yHV1lJrLqGZJHyYANlPPn5Z8pdnxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdonUMnHndNEgpi7FTQS729tCB5_elguMd0djT70OSig&oe=6AF87FC3"}, "display_name": "Heavy Truck VR", "keywords": ["truck", "trailer", "parking", "driving"], "long_description": "Climb into the cab and learn the craft of parking a heavy truck and its semi-trailer \u2014 in VR, from the driver's seat.\n\nGrab the multi-turn steering wheel with both hands and turn it hand over hand. Move the gear lever through a real shift pattern, with a live diagram on the dash. Reverse with nothing but your side mirrors: two main mirrors and two wide-angle mirrors, rendered in real time.\n\n10 missions take you from the basics to a timed challenge:\n\nSeat setup, engine start and a first stop\nFull-lock steering and gear practice\nA cone slalom without a trailer\nHitching the semi-trailer to the fifth wheel\nA wide turn without cutting the corner\nStraight-line backing, an offset bay and a 90-degree dock\nA loaded route against the clock\nChanging conditions. Every mission starts at a random time of day and in random weather, and the clock keeps moving: afternoon light turns into night, with headlights and a lit bay. Drive through clear skies, cloudy days, thick fog, rain, thunderstorms, snow and hail. Rain, storm, hail and snow reduce tire grip, so braking distances grow. You can also fix the time and weather in Settings.\n\nMade for comfort. The game is played seated and you never move the camera yourself; the cab carries you. It includes comfort presets, a motion vignette, horizon stabilization, adjustable cabin motion and seat calibration.\n\nFully offline, single player, in English and Spanish.\n\nFeatures (bullets, if the Dashboard asks for them)\n\nMulti-turn steering wheel you grab an", "short_description": "Back a real-size semi-trailer into tight bays from the driver's seat. Grab the multi-turn wheel, work the gear lever and trust your mirrors \u2014 by day, at night, in rain, fog or snow.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/2PCsiJE7H5btfUaJPqU8f1", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/2PCsiJE7H5btfUaJPqU8f1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1137826322016803"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_917255957799598_4884818380605383458_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0i8GqJwgwysQ7kNvwGvSpTl&_nc_oc=Adow0f50Lbnp0Aa7MQUeLwLihImlTU-W8iJj-MjIxvaS4WAaZXK5q4zyWXBm_lpU2dc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMFNQqEq_kj2yi-i6t8Kk__9FUzrEyroAw3HMybLd0gA&oe=6AF892CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Heavy Truck VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1790020320, "lastRevision": {"nodes": [{"id": "1137826328683469", "release_type": "SCHEDULED", "administration_status": "AP
plete freedom to operate using tools, non-conventional items, special weapons, other zombies, or simply tearing their heads off.\n\nFeatures:\n* Active ragdoll based interactivity with zombies\n\nA wide range of combat options including:\n* Using any dynamic object as a weapon\n* Tearing off zombie limbs with bare hands\n* Chopping body parts with an axe, etc.\n* Stabbing\n* Throwing zombies\n* Hitting zombies with another zombie\n* Or just using fists\n* And much more", "short_description": "Zombie Cleanup Service is a VR game in which the player must eliminate (clean up) sloppy physics simulated zombies with complete freedom to operate using tools, non-conventional items, special weapons, other zombies, or simply tearing their heads off."}]}, "developer_name": "HyperVR Games", "developer_privacy_policy_url": "https://zombiecleanupservice.com/privacy/zombiecleanupservice.html", "developer_terms_of_service_url": null, "publisher_name": "HyperVR Games", "support_website_url": null, "website_url": "https://hypervr.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "770444280598266"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1801895760158366"}]}, "baseline_offer": {"id": "1801895760158366"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1693501200, "
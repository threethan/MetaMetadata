0_AQN-wxeXi8WDzwzeRhl1NFhKPz7lj36hJHrvdHmET_nIkg&oe=6ADF4285"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-12-21 172306.png", "id": "953690723346864", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974439_953690726680197_5589141427893570850_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJtqoUq1HYgQ7kNvwFZN1E5&_nc_oc=AdrjyH9G9jmMH-0EJEIHlr6fg2LOldZAUPROgLL4WvIZAaj5cApyMUtqrg99myyfICo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyjbuCmhFtjIJ8jmr9H6Kgpi6k-6n_n6wqpuEQLZCEDQ&oe=6ADF43FA"}, "display_name": "Neon Blocks", "keywords": ["NeonVrGame", "FuturisticPuzzle", "ImmersiveGameplay", "GeometricChallenges", "virtualrelityadventure"], "long_description": "Step into a vibrant digital realm with this cutting-edge VR game, where futuristic design and neon aesthetics merge seamlessly. Traverse through captivating environments illuminated by glowing geometric shapes and vivid neon colors. Every level presents unique challenges, from mind-bending puzzles to high-speed obstacles, keeping you on your toes. This game isn't just about visuals; it's about immersing players in a fully interactive world where strategy and reflexes are equally important. The dynamic gameplay ensures that every session feels fresh, while the breathtaking visuals captivate your senses. Perfect for fans of innovative VR experiences, this game delivers a blend of excitement, challenge, and beauty in a neon-drenched universe.", "short_description": "Dive into the thrilling world of neon-lit virtual reality in this futuristic VR game. Navigate mesmerizing landscapes filled with glowing geometric shapes and radiant neon colors. Immerse yourself in dynamic puzzles and fast-paced challenges that test your agility and problem-solving skills. With stunning visuals and innovative gameplay, this game offers an electrifying experience in a beautifully designed digital universe."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/neon-blocks", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "275629210202852"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9071223759632716"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1533662385203111"}, {"status": "PUBLISHED", "id": "1286168507065097"}, {"status": "PUBLISHED", "id": "863510753316082"}, {"status": "PUBLISHED", "id": "1523050488903018"}, {"status": "PUBLISHED", "id": "717571174766642"}, {"status": "PUBLISHED", "id": "627754613430368"}, {"status": "PUBLISHED", "id": "1352505272457402"}, {"status": "PUBLISHED", "id": "1783582615870431"}]}, "baseline_offer": {"id": "1352505272457402"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787079600, "status": "PUBLISHED", "id": "1533662385203111"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9071450439610048", "version": "1.0"}, "id": "1651112622149784", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
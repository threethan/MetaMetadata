ZOXS4AtL7PdDPWXxExqxa1tMesyFQNMnl9jD5mMS6W5P4YXdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9xJEbFxFIA6A1iulWruiLcEUwoIYwQwbQxGZbYu3l1A&oe=6AB7C7C8"}, {"file_name": "Screenshot_protect_01.png", "id": "1221932993128876", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308050_1221932996462209_5950558399368851908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxDMCCq3Q84Q7kNvwHJkcSZ&_nc_oc=AdoWCO3uAoIZPWc8hUNvKTo51sGzkobLg5iSPJDcIR3FgjDA7m9j6qZPse0Z7K9eejw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHABUd_cQijvq61PDwBS65hYUVhgmp5EgxDdMRK5gqlg&oe=6AB7EC28"}, {"file_name": "Screenshot_protect_02.png", "id": "1578853566627030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299132_1578853569960363_1086125156912304726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH7zSG56Yl0Q7kNvwG_KDrB&_nc_oc=AdoBqZQR5vxhNFQGHtTzXgG358hv4wpyZiUCmPiO4HsQSA5BEucX4FSCLjCN1QDhEoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz9RxwmHVUQ-54dVrx6ZRM1fc5tsjVod9pkLaG49KvSQ&oe=6AB7E27D"}, {"file_name": "Screenshot_protect_05.png", "id": "1589298792087727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303100_1589298795421060_134160441941300696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP1o8ziael8Q7kNvwFde_kc&_nc_oc=AdpwsWBiU9uoq7F4PFlsLyhpeDhbEqI1TGjj6Gp1Hj0mXHDRmVBAuUxBmriCBsWvoF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9LRINPKCCn4LptM_jHbRxf8pGq5WpQcV85bEGW8KsOw&oe=6AB7D975"}, {"file_name": "Screenshot_protect_04.png", "id": "1638240790502060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821799_1638240793835393_6490501267611992241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ocTPoxfQsAQ7kNvwFA7N7w&_nc_oc=AdqK4SayxJANHGY3jMEryWOXo6bCWmdcxm-dpD0lmxlxnvEZi-kdQoZJL8nVxTZlYMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKloc3jhupo5Qz90tpDmna1-d02Is_SJkkzKE4DMgdWw&oe=6AB7D150"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Protect My Cow", "keywords": ["arcade", "roguelike", "bulletheaven", "action", "alieninvasion"], "long_description": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelike developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience\u2014perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "short_description": "Aliens are trying to abduct your cow and only you can stop them! In Protect My Cow, an action-packed arcade roguelike, you pilot a ship and defend your cows in the middle of chaos. Inspired by Vampire Survivors, the game blends strategy, quick reflexes, and tons of fun. Available in VR and mixed reality, it's time to see how long you can last!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.html", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://immersegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id"
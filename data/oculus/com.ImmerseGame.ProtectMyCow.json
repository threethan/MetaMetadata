ea2c5EL-QvGLXWwllgdelHuhJhJla65V2fCFJW0Ek_gNlGZ8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44YQ36iQP_RABjZbVIC3BZMequKDL9DRlyUrMUFpA3KA&oe=6A1ED9C8"}, {"file_name": "Screenshot_protect_01.png", "id": "1221932993128876", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308050_1221932996462209_5950558399368851908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LG2llFQHZKwQ7kNvwHPaX1w&_nc_oc=AdpgZy18hvZuDp3FaFu0F7rOdLMO73wgQM7T-w-JdU9dynuNReIck-6_Cp_PRNWCwN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u7hbXPL2ZdeFA8CG4R3ojx7ivjg3QHvqq1WnJDNl9WQ&oe=6A1EFE28"}, {"file_name": "Screenshot_protect_02.png", "id": "1578853566627030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299132_1578853569960363_1086125156912304726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbxsVKT1YmkQ7kNvwE9v0oZ&_nc_oc=AdpLEqU5PfEm_iJCcVY1XdpFDg1fjlvlDpc5va4e9fRplLyZF0HKPpHQ0ERjL1W3EAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B2p3uROWEPxVcAfP_nJEQusu3Cn9Jo2KrSvdN0Ox3DA&oe=6A1EF47D"}, {"file_name": "Screenshot_protect_05.png", "id": "1589298792087727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303100_1589298795421060_134160441941300696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xz-NooBm91wQ7kNvwGyun9e&_nc_oc=AdqnSR5XcScg0O5FBq_q0X09Umsg99MT7MOQETKoIVjvCr_Urm19K2HsIAd2z9W7xpE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6387Z87aeekneQHRFR3dIlyXKEphnU_wmxOXTrZlbaKw&oe=6A1EEB75"}, {"file_name": "Screenshot_protect_04.png", "id": "1638240790502060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821799_1638240793835393_6490501267611992241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0E80TWyhpaQQ7kNvwGJCc7v&_nc_oc=Adpbznok9X_UG7j107qdjXzULYfWKyf0fqyB6bov6YmcCQJ41E6AO1I9yf2ei_6pP98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jY8kGDa5S56ESoHxQpZCNUzIwwSHz-FBmg7puhSNIdA&oe=6A1EE350"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Protect My Cow", "keywords": ["arcade", "roguelike", "bulletheaven", "action", "alieninvasion"], "long_description": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelike developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience\u2014perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "short_description": "Aliens are trying to abduct your cow and only you can stop them! In Protect My Cow, an action-packed arcade roguelike, you pilot a ship and defend your cows in the middle of chaos. Inspired by Vampire Survivors, the game blends strategy, quick reflexes, and tons of fun. Available in VR and mixed reality, it's time to see how long you can last!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.html", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://immersegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id"
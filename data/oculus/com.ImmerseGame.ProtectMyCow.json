zzO7CuBlT6yt8GdSPuX_bA10uXEbK6ztvUdjtE_PhN1GSfqjc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZnRLYinJ9Ea8rCnCFIN0UG4Tj5kMsOzX-cTftQzDDsg&oe=6A8AF4C8"}, {"file_name": "Screenshot_protect_01.png", "id": "1221932993128876", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308050_1221932996462209_5950558399368851908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysxPjodUBk4Q7kNvwGcH-1e&_nc_oc=AdqXHNgyMLXjlC-E8VY_RQLOEBIck76rcaPYYha6TqvPe0WwJCAtl6Whwlrt2ymhkEQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWPfPmEEo33Q1mD6c1zUM-Hj7u8qLhePNCIam7uHjkUQ&oe=6A8AE0E8"}, {"file_name": "Screenshot_protect_02.png", "id": "1578853566627030", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499299132_1578853569960363_1086125156912304726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEn8dfgquU8Q7kNvwECWi8Z&_nc_oc=Adr5eASu-khMkvnRv48zXPypeSg_-OuUSuj9HURPDnkcEBPmH5Ga4lzc8eadEL0kcU0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtDxezvW44M83xD-nBs7YkPOo7G3f2Mwy75_fSaI7W5A&oe=6A8AD73D"}, {"file_name": "Screenshot_protect_05.png", "id": "1589298792087727", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303100_1589298795421060_134160441941300696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3t3NKcx45z0Q7kNvwEmWxVa&_nc_oc=Ado3Xsc0tkf_K3iBBWFGiULyo_MSU0Np9kEvY_9Mh_y-7efZGL-zqb-ldBvKZN0iP9k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqW_GzYymFPSkEBkrUblA7C2HxQoN6Gg6Xm68bNryvPg&oe=6A8ACE35"}, {"file_name": "Screenshot_protect_04.png", "id": "1638240790502060", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821799_1638240793835393_6490501267611992241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpFEVTAAXroQ7kNvwGhMDUw&_nc_oc=AdpnhfhYmQu0Fp22SH5jvX45nA5J37sFutNPaAYJIaXCyZS11EObAlHk7nSXoxGj6vM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgrW4pIOUd6xWZyVrlYK-WQoF9-2I52nmY_QO6jLx5WA&oe=6A8AC610"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Protect My Cow", "keywords": ["arcade", "roguelike", "bulletheaven", "action", "alieninvasion"], "long_description": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelike developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience\u2014perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "short_description": "Aliens are trying to abduct your cow and only you can stop them! In Protect My Cow, an action-packed arcade roguelike, you pilot a ship and defend your cows in the middle of chaos. Inspired by Vampire Survivors, the game blends strategy, quick reflexes, and tons of fun. Available in VR and mixed reality, it's time to see how long you can last!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.html", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://immersegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id"
ypWNbxQLfLl4ch8afwHgPhhHgMCARG-xJEePi99YEWNeaW4EA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hD17zPs2iSeu824E7zvMrO4KUAvE3vZ55q-GhicuwtA&oe=6A32A048"}, {"file_name": "Screenshot_protect_01.png", "id": "1221932993128876", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499308050_1221932996462209_5950558399368851908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PG2JIFAdUbUQ7kNvwGcvy9a&_nc_oc=AdpYAnVbxWrbV8hiN08gOSIKuypB_-rAdS7hiAazeLSVjQF-LIAGvMK8BXhO6TwSgq0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-viYDNvUGXAB7rfDXeh1_3E4qOB0sjx-lbW3JZ5a3AdA&oe=6A32C4A8"}, {"file_name": "Screenshot_protect_02.png", "id": "1578853566627030", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499299132_1578853569960363_1086125156912304726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBYBKYLJ5hMQ7kNvwFRFmrH&_nc_oc=AdqbGl8jOX_omEGRlVBNZ5uKi24DgZr4cymQmAKO1mD-oVhSe9QjL9hAEqZo103QXTg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-662qVOZziJWgx9ABA955U3qP5iTv_ER4Uk2o7niLUQQ&oe=6A32BAFD"}, {"file_name": "Screenshot_protect_05.png", "id": "1589298792087727", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499303100_1589298795421060_134160441941300696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ED-6joUADGAQ7kNvwH7ucrp&_nc_oc=AdoQ5Dcd-Owb9hRhUF_kSJFNg4db-pjdicb4xpkgwJsU8zybagVW_N8ye4LTu0x5k9E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z4_HzpgTMaH-vN3kR7X-erla71VnAEE96f_gvdjSIbg&oe=6A32B1F5"}, {"file_name": "Screenshot_protect_04.png", "id": "1638240790502060", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821799_1638240793835393_6490501267611992241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vJdIpasri0Q7kNvwGcy8yo&_nc_oc=AdoOjOIn2uSd53ickyOWPGa3VpwZnBVfFxQrm-BbIxW1W-CCfxFg0J8a_31h3h8Mng8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oAbvU-YpRO6LxuvuwVywZhvkmZbu0UR2CfLIfwMDWTg&oe=6A32A9D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Protect My Cow", "keywords": ["arcade", "roguelike", "bulletheaven", "action", "alieninvasion"], "long_description": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelike developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience\u2014perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "short_description": "Aliens are trying to abduct your cow and only you can stop them! In Protect My Cow, an action-packed arcade roguelike, you pilot a ship and defend your cows in the middle of chaos. Inspired by Vampire Survivors, the game blends strategy, quick reflexes, and tons of fun. Available in VR and mixed reality, it's time to see how long you can last!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.html", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://immersegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id"
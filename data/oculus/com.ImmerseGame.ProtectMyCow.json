hYJOiFKlNT7R0lKDUNQ-LYFFzJ-34ojdWZ7Qp7_P5YAu8QNH-XflHnb_Fzg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHExWwH31j-UVDk9w9Yno1SuMHnHOBV2tj8ohhoMmibfA&oe=6A8EE948"}, {"file_name": "Screenshot_protect_01.png", "id": "1221932993128876", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499308050_1221932996462209_5950558399368851908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0MLoMueIssQ7kNvwEf8E1B&_nc_oc=Adr7u9Q8j9px07q877H-DVhgVWtTzCbBAIpxtJmvzQoc40BBtiFauHBT9IKhIV4X0wQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoMBTKACfz1muYkRqLI-fP7LUF_o38OKhKl3Laaa3SUg&oe=6A8ED568"}, {"file_name": "Screenshot_protect_02.png", "id": "1578853566627030", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499299132_1578853569960363_1086125156912304726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNAmrVuqr54Q7kNvwF3v3fN&_nc_oc=AdqvTBZUbiHemiNYEJVvCa5t_2Mpe8IEBR-WIHxJGyAL85TEqFJuu7hATi6fAdhxDhM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-OSDWm5k0n7Fxr0XEWY_R6-oT4hDcXw_oRSCPSlf8xQ&oe=6A8ECBBD"}, {"file_name": "Screenshot_protect_05.png", "id": "1589298792087727", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499303100_1589298795421060_134160441941300696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNT60q8YHswQ7kNvwGqFrN3&_nc_oc=AdqVLZ-UruV9gkGv_6lXVq5Kx9_5MDfPmwnZFUxaeedxvkEC42n3Di5AX_PQ9ifigx0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlJCeGSvXTy2ha_yGBGnHCLNBr8fjzBZF5gr5-LgDzPg&oe=6A8EC2B5"}, {"file_name": "Screenshot_protect_04.png", "id": "1638240790502060", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821799_1638240793835393_6490501267611992241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkbXlFbn1m0Q7kNvwEKc9S3&_nc_oc=AdrHoP43ZsUSzASsuh_3djSq-IZmaevo2MmnUKGFKhmgLlhfeZJJ6J7jPypU3TRujTg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpHPsehgr_ch5i-ldmOktTRpRVR2qTb9J4R0eF18s4zQ&oe=6A8EF2D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Protect My Cow", "keywords": ["arcade", "roguelike", "bulletheaven", "action", "alieninvasion"], "long_description": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelike developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience\u2014perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "short_description": "Aliens are trying to abduct your cow and only you can stop them! In Protect My Cow, an action-packed arcade roguelike, you pilot a ship and defend your cows in the middle of chaos. Inspired by Vampire Survivors, the game blends strategy, quick reflexes, and tons of fun. Available in VR and mixed reality, it's time to see how long you can last!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.html", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://immersegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "374404007
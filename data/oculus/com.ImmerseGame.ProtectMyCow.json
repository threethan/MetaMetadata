JNQhhb_DpAPYFW11vasbdKqaXwH4rqilEx0Tqw6kJWLpi2hRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl62cr6oV2eeEvQ_p8iIXB87Spxo_ESXQMwP1goTlMYQ&oe=6AABEA48"}, {"file_name": "Screenshot_protect_01.png", "id": "1221932993128876", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308050_1221932996462209_5950558399368851908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCR4NqgbLM8Q7kNvwGMZo2b&_nc_oc=AdqUIZrH29wb6NDJppZqDdACvNcxDkOPMGfhmWbUj25zPyu9LzvuUFwZEC3a93_2rds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzw2PAEuuRBBFjqpHDUNbHV8YFCfc_5ERdIxDMpp6kXQ&oe=6AAC0EA8"}, {"file_name": "Screenshot_protect_02.png", "id": "1578853566627030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299132_1578853569960363_1086125156912304726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J687cmIeIrEQ7kNvwH4VXIK&_nc_oc=AdobYXbX3YHo8_m25jZMnQL5brdeJWQ7SkpThD2P6tlwhrhpOzceQDPEAxA3VweOCU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcc0bn8l8iKsq9qWcKcvAkjdbW8bjhkwogApFXO1amTw&oe=6AAC04FD"}, {"file_name": "Screenshot_protect_05.png", "id": "1589298792087727", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303100_1589298795421060_134160441941300696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mShpk0tXUWUQ7kNvwHf6IvQ&_nc_oc=Adp9j9ni5Hd8PqT7s1-DntuQk5scgwQy-60ZQGtidA3WUviYXecVEOkTXnB6rTcF4Jw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGwcda3ORyJhJmWsJf2YPCa5uDi3rz5Z3Jb502yDFHsQ&oe=6AABFBF5"}, {"file_name": "Screenshot_protect_04.png", "id": "1638240790502060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821799_1638240793835393_6490501267611992241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVQHTc4d84wQ7kNvwEs9m9_&_nc_oc=AdqRrJxPg_sZASlpeK5zJlQ88QIciWtFMudCC46l1vilH-wNoWXaiHvjJoE5aHaXgaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfi8q6F3oL_VuPhesYrKJyuGWfxBmLTC-rgE1yVMJnUg&oe=6AABF3D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Protect My Cow", "keywords": ["arcade", "roguelike", "bulletheaven", "action", "alieninvasion"], "long_description": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelike developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience\u2014perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "short_description": "Aliens are trying to abduct your cow and only you can stop them! In Protect My Cow, an action-packed arcade roguelike, you pilot a ship and defend your cows in the middle of chaos. Inspired by Vampire Survivors, the game blends strategy, quick reflexes, and tons of fun. Available in VR and mixed reality, it's time to see how long you can last!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.html", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://immersegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id"
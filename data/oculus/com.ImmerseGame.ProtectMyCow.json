xKk_WbaByb2KuHn2ZznYowpTFcXXA-3bnsIZV4R87ihQ1t3BI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0Aw12dk7HvS8LCVI3CKNC9a2kLg0sL8gzvk9OnHLMgQ&oe=6ACE6988"}, {"file_name": "Screenshot_protect_01.png", "id": "1221932993128876", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308050_1221932996462209_5950558399368851908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoMxFv8r1vUQ7kNvwEsFdrL&_nc_oc=Adq1v8uhCsPX4DJ8jjdIUqjV5kRCNG2Gih9YyDUXIpQhF2RieROddL8e5Ro6vnK3sX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcUV_CHwm2CvnvYPjYj_J6A9ld5ghGpMhqj6iJM0_0xQ&oe=6ACE55A8"}, {"file_name": "Screenshot_protect_02.png", "id": "1578853566627030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299132_1578853569960363_1086125156912304726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8m8b472jEsQ7kNvwFE5FDY&_nc_oc=Adp82MVZiW-EO5nnoYnOrcHUxg5TPd1xMwbq1dFvdxlYn3YFSvkcnSEtxEETCb08ibA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNVsDjf9tAKUkHKBq9RN4i7wj8CM0WIcpmJQ24wOyzMw&oe=6ACE4BFD"}, {"file_name": "Screenshot_protect_05.png", "id": "1589298792087727", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303100_1589298795421060_134160441941300696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNVuVTXfPi0Q7kNvwF8J4tk&_nc_oc=Adrg7wbSOJ5Py__0LObslbnJgoHgF_D7sym9G9nK5wAp4CGqMrgqxsfVglp3wZbb8lw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8LifKhmmtHzWXHzMglk9HH-PQ62Mb_tC5O50qW34nDg&oe=6ACE42F5"}, {"file_name": "Screenshot_protect_04.png", "id": "1638240790502060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821799_1638240793835393_6490501267611992241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RChbZ34P4e4Q7kNvwFZntgW&_nc_oc=Adq4N4Z_yIhx32MNdl8a1wnnWkN7c1SA-Gpkv0puZjlReAtAGEbKdIev8Yqf2-J3ceA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3T8uRD63ekHXS1msELgbP3iQr7qq_X_xnRKxHCBdu5Q&oe=6ACE3AD0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Protect My Cow", "keywords": ["arcade", "roguelike", "bulletheaven", "action", "alieninvasion"], "long_description": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelike developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience\u2014perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "short_description": "Aliens are trying to abduct your cow and only you can stop them! In Protect My Cow, an action-packed arcade roguelike, you pilot a ship and defend your cows in the middle of chaos. Inspired by Vampire Survivors, the game blends strategy, quick reflexes, and tons of fun. Available in VR and mixed reality, it's time to see how long you can last!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.html", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://immersegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id"
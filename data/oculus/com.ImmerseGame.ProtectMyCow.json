R_GeAJ-HBxcHgFDFoyKpkfKAQVRoHV1gPZ4OiOrkOfZx-uMbuYxI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Go9GMTDcIDfbpzpbEyPdEKnnG0wGsdMf5O2QX5jtu6g&oe=6A22CE48"}, {"file_name": "Screenshot_protect_01.png", "id": "1221932993128876", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499308050_1221932996462209_5950558399368851908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQvnNQ-e0vMQ7kNvwEqLWGI&_nc_oc=AdrwQELRSvB2MZYX0eTc1iKVwqZQ6LP3INjL_3l473UjwcNr9Seohf62Tn3G1CXWq1A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q6OLqjFCslW_cxOGVVtTEOx2tHUGerRonUwWAjbOO3A&oe=6A22F2A8"}, {"file_name": "Screenshot_protect_02.png", "id": "1578853566627030", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299132_1578853569960363_1086125156912304726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xx2sUpkkuU0Q7kNvwEN_-qW&_nc_oc=AdrRkBCYMjZ17D-41oICwzRyOB9kDjce_aGYAbQsh7PlgfgmA_-pf7Y2EL6uJ_SPWUA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d8FrnECCghw9cmfgqn9MRNn51Njei2syipFVPryx7mw&oe=6A22E8FD"}, {"file_name": "Screenshot_protect_05.png", "id": "1589298792087727", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499303100_1589298795421060_134160441941300696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gA92ey7kDqMQ7kNvwF9vc-_&_nc_oc=AdpYuEBGAiQ4-14ltuucVsLo41NrAfqrhtsgyEKeD7lkQSDbvhW5tAzmo-sLkj7q1Tk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I1Ya8c7bJ5ZCg-0P_rJ2IcPWuQycO3G-wIsQqjbh1Jw&oe=6A22DFF5"}, {"file_name": "Screenshot_protect_04.png", "id": "1638240790502060", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821799_1638240793835393_6490501267611992241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6q9D-HTiSQQ7kNvwF-bduY&_nc_oc=AdqynjDeXvrL5YBXVctGfiFtJ0Zs8eKnAHMmCx-J9h0mtPjoipViAzZWVgmGy6hihJ8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vp0K27UQPyZF6q-hGr2Z1ksuIcRe0v9s5xncSL3X0SA&oe=6A22D7D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Protect My Cow", "keywords": ["arcade", "roguelike", "bulletheaven", "action", "alieninvasion"], "long_description": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelike developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience\u2014perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "short_description": "Aliens are trying to abduct your cow and only you can stop them! In Protect My Cow, an action-packed arcade roguelike, you pilot a ship and defend your cows in the middle of chaos. Inspired by Vampire Survivors, the game blends strategy, quick reflexes, and tons of fun. Available in VR and mixed reality, it's time to see how long you can last!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.html", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://immersegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"},
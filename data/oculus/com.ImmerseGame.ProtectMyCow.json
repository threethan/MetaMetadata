YmWgC7lr6ujalCJHvZoS3R5eBnToD0FmNHjmn9sD7aJaZhT-4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsbCf6M92xQH3V3k63J0aiUT1nkKYMZnZyC4mdbbnf7w&oe=6AC4F6C8"}, {"file_name": "Screenshot_protect_01.png", "id": "1221932993128876", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499308050_1221932996462209_5950558399368851908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Urus9HUh0vcQ7kNvwH1h11w&_nc_oc=AdpKR1rcMqnapgCYNrLvXq9REOVM6ahAQV59v5rHQL-OkugBqIeXyrqS9EA2AqXxJf8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP56mBwuiN1rkNWr3jRm6OS99Lh-6om_ISi5CRyUXWC1A&oe=6AC51B28"}, {"file_name": "Screenshot_protect_02.png", "id": "1578853566627030", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499299132_1578853569960363_1086125156912304726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzuPGqtEkiwQ7kNvwGG2K7i&_nc_oc=Adpb2VRT9FFDJa4np6t_MJJbNpgA-JNWDac4Xbj1akiyx3XYPLD2PqfZE5ef3w7zbYw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOp1odkjv5fiB0gVD3LfU1UOkYK4ojuuCs94aoTOMYPww&oe=6AC5117D"}, {"file_name": "Screenshot_protect_05.png", "id": "1589298792087727", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303100_1589298795421060_134160441941300696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZckgUYy5mJcQ7kNvwHcdGO6&_nc_oc=AdpWi9q4GtPBkKbEdhSToQ65bNLLCUSu7NGAyZEJHXP12SBmUzWu-BWM0Aa_5vM9EEI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWV5oEmrSCcJDuiaBwv0ki6uaZAxsrq8Fxz-wOtjeutg&oe=6AC50875"}, {"file_name": "Screenshot_protect_04.png", "id": "1638240790502060", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821799_1638240793835393_6490501267611992241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii-oEDEh2WIQ7kNvwElOoX4&_nc_oc=Adr231TstXmc0Qv9eN9NYyS7LQhl0ZCXNcb6t_uvs3xHkm04hpaYC16lk8fKVFtpBso&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLJgI8-bFx1qYIFolmn8XUL8cg2y1U4tX0i4_S9zjRyA&oe=6AC50050"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Protect My Cow", "keywords": ["arcade", "roguelike", "bulletheaven", "action", "alieninvasion"], "long_description": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelike developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience\u2014perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "short_description": "Aliens are trying to abduct your cow and only you can stop them! In Protect My Cow, an action-packed arcade roguelike, you pilot a ship and defend your cows in the middle of chaos. Inspired by Vampire Survivors, the game blends strategy, quick reflexes, and tons of fun. Available in VR and mixed reality, it's time to see how long you can last!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.html", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://immersegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id"
jGuyw1ONtzOZUFl1WkIC9pONPKB1BRauKfrtBJwFPqaarOCLiJcM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CfpINjeGyyig6Fv4pCVrVkjAHLeJ48e7fnM1GZUraKQ&oe=6A4666C8"}, {"file_name": "Screenshot_protect_01.png", "id": "1221932993128876", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499308050_1221932996462209_5950558399368851908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU6JZ_xnblcQ7kNvwFwv9fa&_nc_oc=Adry3sQ8lXB83ihmmRmX0J2wmLoycY7Wp8dI0p-HaMvQgh9ctUFej_RN7N_c3gFXHDk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jM-0Jnp4ByGplKUhIS8IxX5binstHRfz9CZoXVzKwqA&oe=6A468B28"}, {"file_name": "Screenshot_protect_02.png", "id": "1578853566627030", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299132_1578853569960363_1086125156912304726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x22Oh9Sz_4cQ7kNvwFQh7sF&_nc_oc=AdpvFwrtQ9sRWj6s1FIpBaOOocrO5qABnPe9KwfwVGHt5P7T8RvyOqmmLvXul-d_000&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aCjxXrUd0FNpguSzdxQSI4TRANQWZOvxhVB_8389lZQ&oe=6A46817D"}, {"file_name": "Screenshot_protect_05.png", "id": "1589298792087727", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499303100_1589298795421060_134160441941300696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPw6Vklip6cQ7kNvwHqcDsm&_nc_oc=AdoKcenY8wuoUcjr0DEzPqnjrDSKlY-PaG3qUTb6HKp2XILZA_C_3lVWkN2QjL_R8Do&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MYeO99CZpEXm-Mk1xsVo89IgBJymZfILQ4h_vt3Kt5w&oe=6A467875"}, {"file_name": "Screenshot_protect_04.png", "id": "1638240790502060", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821799_1638240793835393_6490501267611992241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKQJAldcLtQQ7kNvwG7uLfn&_nc_oc=AdrxmoLknMWTO9ahwLWd7T-PTrhrqh8K1zCv3Sl6IoV7Gx0jFAiMQ7-8g7mCZI-GAH4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ip2tp1JxulTNc64FrEnXeYkuuB04r4KISipf_f1U_pg&oe=6A467050"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Protect My Cow", "keywords": ["arcade", "roguelike", "bulletheaven", "action", "alieninvasion"], "long_description": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelike developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience\u2014perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "short_description": "Aliens are trying to abduct your cow and only you can stop them! In Protect My Cow, an action-packed arcade roguelike, you pilot a ship and defend your cows in the middle of chaos. Inspired by Vampire Survivors, the game blends strategy, quick reflexes, and tons of fun. Available in VR and mixed reality, it's time to see how long you can last!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.html", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://immersegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"},
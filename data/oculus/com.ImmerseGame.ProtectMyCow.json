xGa2RGN3oGrtf6_BeuZyh0domvvVy-ZsCndBIAorYB1RoKSguqx0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX-A6iE8cC3u_OKGpXAhJlkp-XNzw5WLv_u9udUhGhog&oe=6AAE8D48"}, {"file_name": "Screenshot_protect_01.png", "id": "1221932993128876", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499308050_1221932996462209_5950558399368851908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCR4NqgbLM8Q7kNvwH-hlUu&_nc_oc=Adp9JjdYwCIICk8Qj-KJTDTBwbc7GWeeKpGSAIX6K3PrH350EEzYccKw7H2PSliV-_8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlbCaVCLe9DfO0W-92dPg_LlZRvpSz_IEorwO1aTnVbg&oe=6AAEB1A8"}, {"file_name": "Screenshot_protect_02.png", "id": "1578853566627030", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299132_1578853569960363_1086125156912304726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfsLkRAmHY8Q7kNvwEtWjCY&_nc_oc=Adpv3_sdaInkKytj6Wc5Z8u7j9DluVmfu52Q5g3mFggeVaY_iW4CpsqWlO2xchCd2OA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOm2yrRII2hv32kQXMaN_QJvo8YeCrOx4Yvmy_maQ1xA&oe=6AAEA7FD"}, {"file_name": "Screenshot_protect_05.png", "id": "1589298792087727", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499303100_1589298795421060_134160441941300696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxyhS6mAIpcQ7kNvwGc_4m0&_nc_oc=AdrHmSuK87_4ODEmQFaQf1T_w02BPpSEPb0k2rOcSU3R8oxsokp2dkyNRwonQf1O_nw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLNMo4XaoyT0Bi9hP2uqEt_Q2iNHxlykL-vuF75cvlDA&oe=6AAE9EF5"}, {"file_name": "Screenshot_protect_04.png", "id": "1638240790502060", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821799_1638240793835393_6490501267611992241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGEGCbOpJ4cQ7kNvwFpzS7i&_nc_oc=AdpVFgX9sQUJceqENoqnsnRAepUBZq56AIHMFAFP1y9WoQ2FuKf7REqBubvsFCIoQzI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmVOrtn6RfFpP-MoNz_zQgOm9wzOyy5B2gpKZ-9upQyw&oe=6AAE96D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Protect My Cow", "keywords": ["arcade", "roguelike", "bulletheaven", "action", "alieninvasion"], "long_description": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelike developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience\u2014perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "short_description": "Aliens are trying to abduct your cow and only you can stop them! In Protect My Cow, an action-packed arcade roguelike, you pilot a ship and defend your cows in the middle of chaos. Inspired by Vampire Survivors, the game blends strategy, quick reflexes, and tons of fun. Available in VR and mixed reality, it's time to see how long you can last!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.html", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://immersegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"},
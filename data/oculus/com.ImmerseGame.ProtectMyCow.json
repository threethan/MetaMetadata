0XNMdCWF3u8l98bZ4PQYfX16ol0wvKGgyQKOloMtzAOa1HNS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJQeuvPlkmYkURuYv0U4t0tH-Wc3yVqd8qfVDXN4pXlA&oe=6AF74808"}, {"file_name": "Screenshot_protect_01.png", "id": "1221932993128876", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308050_1221932996462209_5950558399368851908_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqCHXN0Y2sAQ7kNvwG14Z8H&_nc_oc=AdqR2Fyw1KzpaRPOXvG20Hfvngj0uQYyIVzAfFNcMFEhAnqdI9O4eO9hKDCXZN3S-6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQioNA2tMTJ1kvewL7AYcs7jX4rivdzPW5Lmj3azOIStw&oe=6AF73428"}, {"file_name": "Screenshot_protect_02.png", "id": "1578853566627030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299132_1578853569960363_1086125156912304726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8Gb6-MVL2IQ7kNvwHB4eY_&_nc_oc=AdrIPMArYl9pw4zF8LiLjT6z488NC3Sd0zViHrJZrNGgUscpq3qKQPXggkqL3l2F6pg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYXKeY9-MeMWSDVZU35l_gigkBPjEqR5fYYoSwp1tlIQ&oe=6AF72A7D"}, {"file_name": "Screenshot_protect_05.png", "id": "1589298792087727", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303100_1589298795421060_134160441941300696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqgzU7FTe8AQ7kNvwFVrxQS&_nc_oc=AdoJmmE20oEUzikPK9jGcSIWQocDZM961ZU0lcplyPV_lEXmZSmc7OYqOuhgnWHwKWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTop5FztVb3ssU5tmVVJj3lmUya077d0d0ExHdTNgX_qg&oe=6AF72175"}, {"file_name": "Screenshot_protect_04.png", "id": "1638240790502060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821799_1638240793835393_6490501267611992241_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC-Sjy8bsCUQ7kNvwGHCt5-&_nc_oc=Adr4_ywkpMW46slCQCEBwpzQcdXfe4HjZa2NF-M2q_4Qutf8yFnmSS1qiOk9q-zd4nM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcgwjmU958OMLKECyodv7D7BzE3u9TyhrKVRFjiovS8Q&oe=6AF71950"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Protect My Cow", "keywords": ["arcade", "roguelike", "bulletheaven", "action", "alieninvasion"], "long_description": "They want your cow. You're not letting that happen.\n\nProtect My Cow is an arcade roguelike developed for virtual reality (VR) and mixed reality (MR). You pilot a ship that moves freely across an island, shooting down enemies to stop an alien invasion. Your one and only mission: protect your cows from being abducted.\n\nInspired by games like Vampire Survivors, each match becomes a growing battle against endless waves of enemies. With simple, accessible, and addictive mechanics, the game offers a fast-paced, intense, and fun experience\u2014perfect for quick sessions or extended play.\n\n\u2714\ufe0f Single-player\n\u2714\ufe0f Intuitive controls with free movement in VR/MR\n\u2714\ufe0f High replayability with increasing difficulty\n\u2714\ufe0f Fun and charming visual style\n\u2714\ufe0f Perfect for fans of Vampire Survivors, Brotato, and other bullet-heaven games\n\nGet ready to laugh, sweat, and protect what\u2019s yours because no one messes with your cow.", "short_description": "Aliens are trying to abduct your cow and only you can stop them! In Protect My Cow, an action-packed arcade roguelike, you pilot a ship and defend your cows in the middle of chaos. Inspired by Vampire Survivors, the game blends strategy, quick reflexes, and tons of fun. Available in VR and mixed reality, it's time to see how long you can last!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersegame.com/eula.html", "developer_terms_of_service_url": null, "publisher_name": "Immerse Game", "support_website_url": null, "website_url": "https://immersegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id"
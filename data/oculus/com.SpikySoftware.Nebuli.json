_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "381876038142510", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035306_381876041475843_8539761597059958444_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0u_rob7cusQ7kNvwHPeIae&_nc_oc=AdlOVspE9D_mOLZYWzJH-eo7xx7At59bX_u3lXK8TwWVRJ-5xyU4ARBhG6QVsV6VAmU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs_mKmDSn5DZlNRnddUe85ZuMu6Zl5QuB_VuonT1QFk_Q&oe=69A44796"}, "display_name": "Nebuli", "keywords": [], "long_description": "Prepare for an exhilarating odyssey as you dive headfirst into the heart-pounding world of Nebuli! This fast-paced single-player first-person shooter will ignite your senses and push your gaming skills to the limit.\n\nIn Nebuli, you'll traverse through two gripping modes: Mission and Endless. Each mission promises new thrills and tougher challenges, propelling you deeper into the heart of the action-packed chaos.\n\nEquip yourself with an array of powerful guns and discover game-changing power-ups along the way. Whether you're slowing down time or blasting through obstacles, every move counts as you race against the clock to deliver the bomb and obliterate the enemy ship.\n\nAre you ready to jump, shoot, and seize glory in Nebuli? The challenge awaits\u2014good luck on your journey!", "short_description": "Jump into the heart-pounding action of Nebuli, a fast-paced arcade FPS! With Mission and Endless modes, unlock new levels as you blast your way through. Deliver the bomb, destroy the enemy ship, and rise victorious, but watch out for the escalating chaos! Can you survive the adrenaline-fueled mayhem? Find out now in Nebuli!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spikysoftware.com/home/contact-us/privacy-policy-nebuli", "developer_terms_of_service_url": null, "publisher_name": "Spiky Software", "support_website_url": null, "website_url": "https://spikysoftware.com/", "category": null, "comfort_rating": null
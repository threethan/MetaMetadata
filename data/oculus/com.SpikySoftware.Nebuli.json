bmBfHiQeP4E7XNhvMnPEEJo6gg1P4LzUMA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZRMsw-lGWlCY7crOdmCJpBvpMfKmOOhfYWcY64sII4w&oe=6AC7A022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "381876038142510", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035306_381876041475843_8539761597059958444_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTEeo9U4JNoQ7kNvwEfsYt0&_nc_oc=AdqqWrtqmVZrDWKu20ctt1BISBy-4jGVefk430WW-rW1eooADt5RHqNXhHV7Lvc9-pw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyHtjillY4jyF9VowZ26n666aI92t_pRt789Rjy1wrGA&oe=6AC7A316"}, "display_name": "Nebuli", "keywords": [], "long_description": "Prepare for an exhilarating odyssey as you dive headfirst into the heart-pounding world of Nebuli! This fast-paced single-player first-person shooter will ignite your senses and push your gaming skills to the limit.\n\nIn Nebuli, you'll traverse through two gripping modes: Mission and Endless. Each mission promises new thrills and tougher challenges, propelling you deeper into the heart of the action-packed chaos.\n\nEquip yourself with an array of powerful guns and discover game-changing power-ups along the way. Whether you're slowing down time or blasting through obstacles, every move counts as you race against the clock to deliver the bomb and obliterate the enemy ship.\n\nAre you ready to jump, shoot, and seize glory in Nebuli? The challenge awaits\u2014good luck on your journey!", "short_description": "Jump into the heart-pounding action of Nebuli, a fast-paced arcade FPS! With Mission and Endless modes, unlock new levels as you blast your way through. Deliver the bomb, destroy the enemy ship, and rise victorious, but watch out for the escalating chaos! Can you survive the adrenaline-fueled mayhem? Find out now in Nebuli!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spikysoftware.com/home/contact-us/privacy-policy-nebuli", "developer_terms_of_service_url": null, "publisher_name": "Spiky Software", "support_website_url": null, "website_url": "https://spikysoftware.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7583307135059289"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1126623988649022"}]}, "baseline_offer": {"id": "1126623988649022"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1712596620, "status": "PUBLISHED", "id": "1126623988649022"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7569562703100399", "version": "1.2.1"}, "id": "1115091956597963", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7297995293590476", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7569562703100399"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1115091956597963"}]}, "change_log": "Initial release", "created_date": 1712268252, "id": "7569562703100399", "version": "1.2.1", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count":
vjdKGDYMQ7kNvwF9eyfF&_nc_oc=AdrPiZXQCM_XBWTQGNokb8OYwj2O-EqEulYkbaznyKyV7t9O_g4swDz1n0AsKXC1Bjg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3Jhfzeb7Z52JGuOdiy07_Zp_O4B3UuXrsyGLxZQwqsg&oe=6AC51C57"}]}, "id": "1406404688025446", "locale": "en_US", "screenshots": [{"file_name": "screenshot_01_2560x1440.png", "id": "28005133979173858", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298930_28005133985840524_8026735706857572506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSRMDdoDD_cQ7kNvwFXLV7E&_nc_oc=AdouvoX-QI26Qz_661Oyk8NdXmH6w8Uu21VAV5iFZzuTTAdFGpb66DFyU15p19Uy-vE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_iB7ChGXeGD3sjeorGFbhIVzArlmnOjUpligzymt6_A&oe=6AC50057"}, {"file_name": "screenshot_02_2560x1440.png", "id": "2221130912073866", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499295969_2221130915407199_5732608902563337894_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qgElLpw-cMQ7kNvwHhQ1qt&_nc_oc=AdoY-U0i3X4xSDJASGrRPNJ8blZOeJfLq8pp6-jyd3z0mtxQGIkjFCI-D9U2qKzAcBs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlnZEA8rTEfjoHLooH7b-RRsZBIi0C60oHPp_8XLRIsw&oe=6AC4FB02"}, {"file_name": "screenshot_03_2560x1440.png", "id": "1059028929894639", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499292426_1059028933227972_8224839736889839673_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJ-n4rryasEQ7kNvwE1en8B&_nc_oc=AdqF3e-AogI5SPW8BkaDTeCu-KN4ms9EDOdC9HmIQhSd0NBbKzuQTyBU0JE2oZ3ixC8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9GXGsB1t0yApkPqSIQ5_JMuAuzZbIG6NqfxLQJRodzg&oe=6AC4F8E6"}, {"file_name": "screenshot_04_2560x1440.png", "id": "2917442258632486", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499299745_2917442265299152_1950182234078030633_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jce_9qpTaQgQ7kNvwFozzMF&_nc_oc=Adplsdy2wum7467hbh7nftWCPb1FjHwPFMi-hgkgvQeYFjqXntHxSAk-IRpTEjlvRzU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuxKEPh9590HZvaN06PnNvoTk85cmgynL6CIJa_CB-Ew&oe=6AC509A4"}, {"file_name": "screenshot_05_2560x1440.png", "id": "4471271286484027", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298790_4471271289817360_9007031121401367396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dQWZ26BiwEQ7kNvwHvnPWR&_nc_oc=Adp26EXLDWMDLuZ2ZoUyYK_5C6gGfM-n1zrKMzf2vSF2tyJkW48ylHsllsX0LlgOeR0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJvYhoi0t4jYD56OY0tVvEZgy13ycfPG0G8BGqUEXWGA&oe=6AC50B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1913001046033393", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303088_1913001049366726_1695032837739914282_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCg5dFnYDMEQ7kNvwFPxGAi&_nc_oc=AdrNHNpbvkMW86vhku-8JCokaEysWpPqvb-X6VNGM-8-Pe5KCIqkFdTT7W_CzkZWbVw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ0XejoEmHxlajeePFs8xWQRSoZhgmhsGmLM1HCUWRYQ&oe=6AC50E8B"}, "display_name": "Vice Horizon VR", "keywords": ["vice"], "long_description": "THE CITY IS YOURS. TAKE IT.\nVice Horizon VR drops you standing inside an open world of palm trees, neon and sirens. You're not steering a character with a gamepad here: you aim, you drive, you decide.\nDRIVE WHATEVER YOU FIND\nPull a sports car out of traffic, hop on a motorcycle and feel it lean into the corners, lift off in a helicopter to see the skyline from above, or cross the bay in a speedboat. Five vehicle types, all piloted from the driver's seat, your hands on the wheel.\nCOMBAT AT FULL SCALE\nDraw the pistol, the SMG or the bat and fight with real movement. You aim with your hand, not your head: every shot leaves from exactly where you point it, with haptics on every hit.\nA CITY THAT BREATHES\nMissions that pull you across the map, pedestrians that react, live traffic, patrolling enemies, a full day-night cycle and storms that change the mood. Explore high-rises, docks, backstreets and beaches.\nCOMFORTABLE FROM MINUTE ONE\nSnap turning, automatic comfort vignette, calibrated height and zero camera shake. Optimized for Meta Quest 3 with foveated rendering to keep it smooth.\nYOUR HORIZON, YOUR RULES\nRun contracts, build your reputation and find out what the city hides after dark.\nPut on the headset. The engine is already running.\n", "short_description": "Step into a neon city where you make the rules. Drive cars and motorcycles, fly helicopters and planes, race a speedboat across the bay, and hold your weapons in your own two hands. Take contracts, earn cash and build a name on streets that live and breathe, from golden sunset to midnight rain. Snap turning, a map always in view and controls built for Quest 3. The city won't wait for you: your horizon starts now.\n"}, {"images": {"nodes": []}, "id": "1031855486432439", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vice Horizon VR", "keywords": ["gta", "vice"], "long_description": "LA CIUDAD ES TUYA. T\u00d3MALA.\nVice Horizon VR te mete de pie en un mundo abierto de palmeras, ne\u00f3n y sirenas. Aqu\u00ed no mueves un personaje con un mando: eres t\u00fa quien apunta, conduce y decide.\nCONDUCE LO QUE ENCUENTRES\nRoba un deportivo en marcha, salta a una moto y siente la inclinaci\u00f3n en las curvas, despega en helic\u00f3ptero para ver la ciudad desde arriba o cruza la bah\u00eda en lancha. Cinco tipos de veh\u00edculo, todos pilotables desde el asiento, con tus manos al volante.\nCOMBATE A ESCALA REAL\nSaca la pistola, el subfusil o el bate y pelea con movimientos de verdad. Apuntas con la mano, no con la cabeza: cada disparo sale de donde t\u00fa lo diriges, con vibraci\u00f3n en el mando a cada impacto.\nUNA CIUDAD QUE RESPIRA\nMisiones que te llevan de un extremo al otro del mapa, peatones que reaccionan, tr\u00e1fico, enemigos que patrullan, ciclo de d\u00eda y noche y tormentas que cambian el ambiente. Explora rascacielos, puertos, barrios y playas.\nC\u00d3MODO DESDE EL PRIMER MINUTO\nGiro por saltos, vi\u00f1eta de confort autom\u00e1tica, altura calibrable y sin sacudidas de c\u00e1mara. Optimizado para Meta Quest 3 con render foveado para mantener la fluidez.\nTU HORIZONTE, TUS REGLAS\nCumple contratos, sube tu reputaci\u00f3n y descubre qu\u00e9 esconde la ciudad al caer el sol.\nPonte el visor. El motor ya est\u00e1 en marcha.\n", "short_description": "Ponte el visor y pisa una ciudad de ne\u00f3n donde t\u00fa pones las reglas. Conduce coches y motos, pilota helic\u00f3pteros y avionetas, navega en lancha y empu\u00f1a tus armas con tus propias manos. Acepta misiones, gana dinero y hazte un nombre en calles llenas de vida, del atardecer dorado a la lluvia de medianoche. Con giro por saltos, mapa siempre a la vista y controles hechos a medida para Quest 3. La ciudad no te espera: tu horizonte empieza ahora.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.claude.ai/code/artifact/7c3725a7-79ce-4a14-ac16-b46357150260", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almaz\u00e1n", "support_website_url": null, "website_url": "https://www.claude.ai/code/artifact/7c3725a7-79ce-4a14-ac16-b46357150260", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1108461064953329"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499312310_958370917224650_1341086999907741329_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUDvjdKGDYMQ7kNvwF9eyfF&_nc_oc=AdrPiZXQCM_XBWTQGNokb8OYwj2O-EqEulYkbaznyKyV7t9O_g4swDz1n0AsKXC1Bjg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjuaifkGt4lvgeIpwifhRX3v7cUt7CFl_rJRGBCV3PtQ&oe=6AC51C57"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vice Horizon VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1785698820, "lastRevision": {"nodes": [{"id": "1089632303502872", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1089632290169540", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1014550257866129"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1364229795233138", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vice Horizon VR", "keywords": ["gta", "vice"], "long_description": "LA CIUDAD ES TUYA. T\u00d3MALA.\nVice Horizon VR te mete de pie en un mundo abierto de palmeras, ne\u00f3n y sirenas. Aqu\u00ed no mueves un personaje con un mando: eres t\u00fa quien apunta, conduce y decide.\nCONDUCE LO QUE ENCUENTRES\nRoba un deportivo en marcha, salta a una moto y siente la inclinaci\u00f3n en las curvas, despega en helic\u00f3ptero para ver la ciudad desde arriba o cruza la bah\u00eda en lancha. Cinco tipos de veh\u00edculo, todos pilotables desde el asiento, con tus manos al volante.\nCOMBATE A ESCALA REAL\nSaca la pistola, el subfusil o el bate y pelea con movimientos de verdad. Apuntas con la mano, no con la cabeza: cada disparo sale de donde t\u00fa lo diriges, con vibraci\u00f3n en el mando a cada impacto.\nUNA CIUDAD QUE RESPIRA\nMisiones que te llevan de un extremo al otro del mapa, peatones que reaccionan, tr\u00e1fico, enemigos que patrullan, ciclo de d\u00eda y noche y tormentas que cambian el ambiente. Explora rascacielos, puertos, barrios y playas.\nC\u00d3MODO DESDE EL PRIMER MINUTO\nGiro por saltos, vi\u00f1eta de confort autom\u00e1tica, altura calibrable y sin sacudidas de c\u00e1mara. Optimizado para Meta Quest 3 con render foveado para mantener la fluidez.\nTU HORIZONTE, TUS REGLAS\nCumple contratos, sube tu reputaci\u00f3n y descubre qu\u00e9 esconde la ciudad al caer el sol.\nPonte el visor. El motor ya est\u00e1 en marcha.\n", "short_description": "Ponte el visor y pisa una ciudad de ne\u00f3n donde t\u00fa pones las reglas. Conduce coches y motos, pilota helic\u00f3pteros y avionetas, navega en lancha y empu\u00f1a tus armas con tus propias manos. Acepta misiones, gana dinero y hazte un nombre en calles llenas de vida, del atardecer dorado a la lluvia de medianoche. Con giro por saltos, mapa siempre a la vista y controles hechos a medida para Quest 3. La ciudad no te espera: tu horizonte empieza ahora.\n"}, {"images": {"nodes": [{"file_name": "hero_3000x900.png", "id": "3679073915565991", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312402_3679073922232657_4790715389582199110_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrNm8QCoVq4Q7kNvwGsaAos&_nc_oc=AdrQCXY0Cbr4dHfYhPrfT56K8E6it0npeGzdXpdOjr96dseYihYMGZdcc-yJ3YX4yck&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtsbjLGoSHmWafGQBe0-R8XS16o_4tVgf3f_TuX2VHHg&oe=6AC50C5A"}, {"file_name": "icon_512x512.png", "id": "2122926535768665", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312310_2122926542435331_4070637600494984440_n.png?_nc_cat=
=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftYY4LYjKDFdBWQia9omGrS4WmWqNPVgIhx6CINZZ4ptA&oe=699B07AA"}, {"file_name": "migrated_image.png", "id": "2500055866975203", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031573_2507900002609642_7014103991516659712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrfNYrrDLEkQ7kNvwF7emYZ&_nc_oc=AdkshlCi5if6l6RGI22UWFywCvzHxj8R5QHJYHLqrKmLAoNto3rcBRvcXBSGIZAULgA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvFc5sgCMxzmbWy0h4qOMHvlBbSEH295ryKXrZ5BxRkUw&oe=699B125E"}, {"file_name": "migrated_image.png", "id": "668206680647688", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982682_935700066774378_8281169393090560000_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7DItEOcnhwQ7kNvwGZYnEo&_nc_oc=Adml195FCYDg6K47otFBXASed8DJsLvNktH_jM1bUrfpzlEXhzEKG6VOJmGdQincjdI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfulA7Hi0Q2iqm_6tAzX11dulO4z43fbIrtFFTmsKMS1aw&oe=699B0A9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sounds Grate", "keywords": ["SoundsGrate", "NervSounds", "valup", "blackboard", "Dentist"], "long_description": "[Usage]\nThere are three doors lined up. Each door leads to a different room. You can enter each door by pointing the controller at the door and pulling the trigger. There are various items in each room.\nPoint the controller towards anything that makes an uncomfortable noise and move while holding the trigger. You\u2019ll hear some extremely squeamish sounds so please keep the volume at an appropriate level. \nTo leave the room, point the controller at the door and pull the trigger.\n\n[Sound Recordings]\n\u30fbNails scratching a blackboard\n\u30fbPlate and fork\n\u30fbDentist", "short_description": "\"Sounds Grate\" is an application that reproduces sounds that give you goose skin. Experience the unpleasant sounds that make everyone wants to close their ears in virtual space."}, {"images": {"nodes": []}, "id": "233534497918788", "loc
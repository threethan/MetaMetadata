t=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj4PEZreSKVeaThxgFsuBw9QogyI2ZHWF8VCkCUyA5pA&oe=6AFDC8D2"}, {"file_name": "tmtit_v2_04.png", "id": "1027493671614100", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982718_1027493674947433_3483165458685742339_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7PK7M92WPIQ7kNvwFauEh-&_nc_oc=Adq3_q5TDvzylZ7-mc-OYUemNRUtmAavaOtRMCUrgAlW6PvGZDY_nsWAWcYUmwFfvOU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeyR_aMyVXaZFgGhnAZorcDVG2VWycdsSoOuhJgids3Q&oe=6AFDCC2F"}, {"file_name": "tmtit_v2_05.png", "id": "872179664477709", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982472_872179667811042_2779209791881098486_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJmN2ugIXbsQ7kNvwEP6wB9&_nc_oc=AdosNmNfJGn9bLTpV9Yexjbi2Bxjmh1_m_kMFd0gp97VPUt87t6r-0RLDilHhb0STK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJFRzo2B9xKQS32fyZN4eAYwWu0BrBzCq1AjiRQINI_A&oe=6AFDD5E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_en.png", "id": "3158717561104523", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/227894679_3158717564437856_3124095420369263715_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQ2NUnDqnqsQ7kNvwHIiEl6&_nc_oc=AdqARLzHIp-MiI-iNN658w9Jz1TkHncW6tDuFZbzPNCavQUskFAlAsnoohoqcw4v8WU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn7MneWVwgVxqLRU9u-ARjFST04Kkbts31jXrT8koD4w&oe=6AFDCABF"}, "display_name": "Shooting Ground : VR Shooting Playground (Beta)", "keywords": ["shooting", "aim", "training", "target", "gun"], "long_description": "Shooting Ground is a single-player VR shooting range where you grip a gun with your controller and aim for real. Every round lasts 30 seconds: short, intense sessions that train your accuracy, reaction speed, prediction and tracking.\n\n\u25a0 Four training courses\n\u2022 Gridshot \u2013 Three targets always sit on the grid. Hit them as fast and as accurately as you can.\n\u2022 Jump & Trap \u2013 Robots leap up at random. Shoot the blue ones and leave the red traps alone. Hitting a trap breaks your combo.\n\u2022 Simple Defense \u2013 Targets close in from a distance. Take them all down before they cross the line.\n\u2022 Sphere Track \u2013 Keep your sights on a target that moves unpredictably. Hold your aim steady and the gun fires automatically.\n\n\u25a0 Four difficulty levels\nEasy, Normal, Hard and Hell. The higher you go, the smaller the targets get and the more focus it takes.\n\n\u25a0 Choose your weapon\nPick the pistol or the assault rifle and build a separate record for each.\n\n\u25a0 Records and stats\nAfter every round, check your score, accuracy, max combo, hits and hits per second. Follow your recent averages and score trend for each course, difficulty and weapon to see how you improve.\n\n\u25a0 Options\n\u2022 Left-handed grip and player height adjustment\n\u2022 Controller vibration and sound volume settings\n\u2022 Pause anytime and restart instantly\n\u2022 Korean and English\n\n\u203b Shooting Ground is in beta (Early Access). We plan to keep refining courses and features based on player feedback.", "short_description": "30-second rounds of VR aim training. Sharpen your accuracy and reaction time across four courses (Gridshot, Jump & Trap, Simple Defense and Sphere Track) on four difficulty levels."}]}, "developer_name": "StasisField", "developer_privacy_policy_url": "https://www.stasisfield.io/privacy", "developer_terms_of_service_url": "https://www.stasisfield.io/terms", "publisher_name": "StasisField", "support_website_url": null, "website_url": "https://www.stasisfield.io/shootingground", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}]
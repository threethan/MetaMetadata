c=AdqeXnzumXESnDKUbkYolrdOTp_j3aL696cplRGn50Z5NXHWeikVz5ZFFKNHvSdfGvE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcbFt38u4pn6_0z_k6pKGsQSRdfX5bT98ejQHbAsZJqQ&oe=6AF9CA84"}]}, "id": "1075083355503746", "locale": "en_US", "screenshots": [{"file_name": "tmtit_v2_01.png", "id": "1037780424073020", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984448_1037780427406353_5789734681785444390_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSRlBF0L1jgQ7kNvwFVwJrR&_nc_oc=AdpxjVtZYQu0Ld7yCeM3T1GweaiKtRItPQVU5ufD7cTKG8Skme0jzqKJ88ZHF5agt18&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjPoC5uTo8UerrNkCbCT_fK2PAebuXZknhq_O9n0Lx6A&oe=6AF9BE80"}, {"file_name": "tmtit_v2_02.png", "id": "959667351988722", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982623_959667355322055_7258143976892038525_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jNNt1m6Ys8Q7kNvwFCUnN2&_nc_oc=AdprcAHzXOY8h7-h-A5zJF7sd5Rgw0pkujV3DXymkevwgJXmT4xQpUqa1Hqwz9Ly4Xw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZm0uTQHoojdSh6WehWYr-NXxTNNe5aP4Zern-Of_8NA&oe=6AF9D0B7"}, {"file_name": "tmtit_v2_03.png", "id": "673149694741470", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031357_673149698074803_5597710534031742092_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RS2dFPzzmEAQ7kNvwHf0X8J&_nc_oc=AdoOjOxb0woOmIBZOT0K52bcppBnap3hxXYYtMTILqW2DuRHHl3cQwmNeI4MIGhkfYw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmlpbfIibt8D5sqmK1d_L9l-CnRVBed-VK3IN07ZKo5w&oe=6AF9D452"}, {"file_name": "tmtit_v2_04.png", "id": "1027493671614100", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982718_1027493674947433_3483165458685742339_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hje1dX0_QuwQ7kNvwGUlS3g&_nc_oc=AdreyjfUj5M2RzpRHAy3cQ4XJ34S5qdcNZfXSfUDSn4eTBXnhQG3HM1__YenUP4CbEg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAtWf8XMGD2KbJ7CqgNk3mMBRBY9V5EvGx1AZnNBmCUg&oe=6AF9D7AF"}, {"file_name": "tmtit_v2_05.png", "id": "872179664477709", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982472_872179667811042_2779209791881098486_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIPV4KqQJvAQ7kNvwFzFsR0&_nc_oc=Adr2lk3TC9dKwv2W-OlZl9WgBdQQYgal5xArMr728VGv5gGZ-ArfSEPSzbaSoLGCAuw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR52kisoQod7FQIRs8tzq2MJqdQK_H-UbhEKBen_rD5nA&oe=6AF9E167"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_en.png", "id": "3158717561104523", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/227894679_3158717564437856_3124095420369263715_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ax_Zi5JPFjUQ7kNvwGj_6nQ&_nc_oc=Adr-bd121ULtX8ZwuapEaufnh9FmosEa7jMy8pMjKrQUj9iVfHxStjB3-PBNotaeIDU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTauNYz3gHZ4Lba1TIJfe1DxFITGbABNY7WK6Of4Dl_gw&oe=6AF9D63F"}, "display_name": "Shooting Ground : VR Shooting Playground (Beta)", "keywords": ["shooting", "aim", "training", "target", "gun"], "long_description": "Shooting Ground is a single-player VR shooting range where you grip a gun with your controller and aim for real. Every round lasts 30 seconds: short, intense sessions that train your accuracy, reaction speed, prediction and tracking.\n\n\u25a0 Four training courses\n\u2022 Gridshot \u2013 Three targets always sit on the grid. Hit them as fast and as accurately as you can.\n\u2022 Jump & Trap \u2013 Robots leap up at random. Shoot the blue ones and leave the red traps alone. Hitting a trap breaks your combo.\n\u2022 Simple Defense \u2013 Targets close in from a distance. Take them all down before they cross the line.\n\u2022 Sphere Track \u2013 Keep your sights on a target that moves unpredictably. Hold your aim steady and the gun fires automatically.\n\n\u25a0 Four difficulty levels\nEasy, Normal, Hard and Hell. The higher you go, the smaller the targets get and the more focus it takes.\n\n\u25a0 Choose your weapon\nPick the pistol or the assault rifle and build a separate record for each.\n\n\u25a0 Records and stats\nAfter every round, check your score, accuracy, max combo, hits and hits per second. Follow your recent averages and score trend for each course, difficulty and weapon to see how you improve.\n\n\u25a0 Options\n\u2022 Left-handed grip and player height adjustment\n\u2022 Controller vibration and sound volume settings\n\u2022 Pause anytime and restart instantly\n\u2022 Korean and English\n\n\u203b Shooting Ground is in beta (Early Access). We plan to keep refining courses and features based on player feedback.", "short_description": "30-second rounds of VR aim training. Sharpen your accuracy and reaction time across four courses (Gridshot, Jump & Trap, Simple Defense and Sphere Track) on four difficulty levels."}]}, "developer_name": "StasisField", "developer_privacy_policy_url": "https://www.stasisfield.io/privacy", "developer_terms_of_service_url": "https://www.stasisfield.io/terms", "publisher_name": "StasisField", "support_website_url": null, "website_url": "https://www.stasisfield.io/shootingground", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39922988034014260"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035425_6891
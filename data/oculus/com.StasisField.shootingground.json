.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Jy93WpjYZMQ7kNvwHujgJz&_nc_oc=Adr-ciRXaOm27Y3T_pWjgZs5sHDmYd_4I40X5FpA0gLj5ZHj2GeNVr-s8ZYbT64nJvU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWQCejPPnCoEw45YU0vzo85J69xLTFQzY_gGq4BygQCw&oe=6AFB174A"}, {"file_name": "tmtit_v2_04.png", "id": "1400799630649860", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031474_1400799633983193_3772861020429588855_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fQJR8n5ndMQ7kNvwECOstm&_nc_oc=Adq5K0elHUUpLJjv5UOHm36PLsisS9uE2guGJbdd_CU90Ojq6KcAKkTmZD81Ok-wVB4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlSugUfXGGjGo2wzKT6YkEdafDVYxVxBpAGZqo4SOuWQ&oe=6AFB1F68"}, {"file_name": "tmtit_v2_05.png", "id": "323427950072114", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974843_323427953405447_1822432089500124608_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmcpHLeSC50Q7kNvwHE4Kv6&_nc_oc=AdoWkyHJZvvZjnwKNb3cCvBPSafnsXt0KSCFvCvgGjHVr2a6aiHRcfkboNRGx5bULbk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWgYrxiZ7ZI00iIP2jjSM7CvXlPH4K4yA_jjnMV2Jq9A&oe=6AFB2F84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_kr.png", "id": "669458018461238", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982670_669458021794571_799131040725984694_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOCyF8GPGhsQ7kNvwGwY5_3&_nc_oc=AdpyH3OK4zNYZ6Suz_ZBAUamrvN_YL3fYCQ4TDo6xEDd7NJkOxAzLcoLTpKhvUWj5-0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9AP7R1BJFuq4QeemBEy5GvB6GZZ22o33OPmxpaNqWwA&oe=6AFB45EB"}, "display_name": "\uc288\ud305 \uadf8\ub77c\uc6b4\ub4dc : VR \uc0ac\uaca9 \ub180\uc774\ud130 (\ubca0\ud0c0)", "keywords": ["shooting", "target", "gun", "aim", "shooter"], "long_description": "\uc288\ud305 \uadf8\ub77c\uc6b4\ub4dc\ub294 \ucee8\ud2b8\ub864\ub7ec\ub85c \ucd1d\uc744 \uc950\uace0 \uc9c1\uc811 \uc870\uc900\ud574 \uc3d8\ub294 1\uc778\uc6a9 VR \uc0ac\uaca9 \ud6c8\ub828\uc7a5\uc785\ub2c8\ub2e4. \ud55c \ud310\uc740 30\ucd08. \uc9e7\uace0 \uc9d1\uc911\ub3c4 \ub192\uc740 \ub77c\uc6b4\ub4dc\ub97c \ubc18\ubcf5\ud558\uba70 \uc815\ud655\ub3c4, \ubc18\uc751 \uc18d\ub3c4, \uc608\uce21, \ud2b8\ub798\ud0b9 \uc2e4\ub825\uc744 \ud0a4\uc6cc \ubcf4\uc138\uc694.\n\n\u25a0 4\uac00\uc9c0 \ud6c8\ub828 \ucf54\uc2a4\n\u2022 \uadf8\ub9ac\ub4dc\uc0f7 \u2013 \uaca9\uc790 \uc704\uc5d0 \ud56d\uc0c1 \ub5a0 \uc788\ub294 3\uac1c\uc758 \ud0c0\uac9f\uc744 \ube60\ub974\uace0 \uc815\ud655\ud558\uac8c \ub9de\ud788\ub294 \uae30\ubcf8 \uc5d0\uc784 \ud6c8\ub828\n\u2022 \uc810\ud504 & \ud2b8\ub7a9 \u2013 \ubb34\uc791\uc704\ub85c \ud280\uc5b4 \uc624\ub974\ub294 \ud30c\ub780 \ub85c\ubd07\uc740 \uc3d8\uace0, \ube68\uac04 \ud568\uc815 \ub85c\ubd07\uc740 \ud53c\ud558\uc138\uc694. \ud568\uc815\uc744 \uc3d8\uba74 \ucf64\ubcf4\uac00 \ub04a\uae41\ub2c8\ub2e4\n\u2022 \uc2ec\ud50c \ub514\ud39c\uc2a4 \u2013 \uba40\ub9ac\uc11c \ub2e4\uac00\uc624\ub294 \ud0c0\uac9f\uc774 \uae30\uc900\uc120\uc744 \ub118\uae30 \uc804\uc5d0 \ubaa8\ub450 \uaca9\ucd94\ud558\uc138\uc694\n\u2022 \uc2a4\ud53c\uc5b4 \ud2b8\ub799 \u2013 \ubd88\uaddc\uce59\ud558\uac8c \uc6c0\uc9c1\uc774\ub294 \ud0c0\uac9f\uc744 \uacc4\uc18d \uc870\uc900\ud574 \ub530\ub77c\uac00\uc138\uc694. \uc815\ud655\ud788 \uaca8\ub204\uace0 \uc788\uc73c\uba74 \uc790\ub3d9\uc73c\ub85c \ubc1c\uc0ac\ub429\ub2c8\ub2e4\n\n\u25a0 4\ub2e8\uacc4 \ub09c\uc774\ub3c4\n\uc26c\uc6c0 \u00b7 \ubcf4\ud1b5 \u00b7 \uc5b4\ub824\uc6c0 \u00b7 \uc9c0\uc625. \ub2e8\uacc4\uac00 \uc624\ub97c\uc218\ub85d \ud0c0\uac9f\uc774 \uc791\uc544\uc9c0\uace0 \ub354 \ub192\uc740 \uc9d1\uc911\ub825\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.\n\n\u25a0 \ubb34\uae30 \uc120\ud0dd\n\ud53c\uc2a4\ud1a8\uacfc \ub3cc\uaca9 \uc18c\ucd1d \uc911 \uc6d0\ud558\ub294 \ucd1d\uc744 \uace8\ub77c \ubb34\uae30\ubcc4\ub85c \uae30\ub85d\uc744 \uc313\uc544 \ubcf4\uc138\uc694.\n\n\u25a0 \uae30\ub85d\uacfc \ud1b5\uacc4\n\ub77c\uc6b4\ub4dc\uac00 \ub05d\ub098\uba74 \uc810\uc218, \uc815\ud655\ub3c4, \ucd5c\ub300 \ucf64\ubcf4, \ud788\ud2b8 \uc218, \ucd08\ub2f9 \ud788\ud2b8\ub97c \ubc14\ub85c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucf54\uc2a4\u00b7\ub09c\uc774\ub3c4\u00b7\ubb34\uae30\ubcc4 \ucd5c\uadfc \uae30\ub85d \ud3c9\uade0\uacfc \uc810\uc218 \ucd94\uc774 \uadf8\ub798\ud504\ub85c \uc2e4\ub825 \ubcc0\ud654\ub97c \ud55c\ub208\uc5d0 \uc0b4\ud3b4\ubcf4\uc138\uc694.\n\n\u25a0 \ud3b8\uc758 \uae30\ub2a5\n\u2022 \uc67c\uc190 \ud30c\uc9c0\uc640 \ud50c\ub808\uc774\uc5b4 \ub192\uc774 \uc870\uc808\n\u2022 \ucee8\ud2b8\ub864\ub7ec \uc9c4\ub3d9, \uc0ac\uc6b4\ub4dc \ubcfc\ub968 \uc124\uc815\n\u2022 \ud50c\ub808\uc774 \uc911 \uc77c\uc2dc\uc815\uc9c0 \ubc0f \uc989\uc2dc \uc7ac\uc2dc\uc791\n\u2022 \ud55c\uad6d\uc5b4 / \uc601\uc5b4 \uc9c0\uc6d0\n\n\u203b \ubca0\ud0c0(\uc5bc\ub9ac \uc561\uc138\uc2a4) \ubc84\uc804\uc785\ub2c8\ub2e4. \ud50c\ub808\uc774\uc5b4 \uc758\uacac\uc744 \ubc18\uc601\ud574 \ucf54\uc2a4\uc640 \uae30\ub2a5\uc744 \uacc4\uc18d \ub2e4\ub4ec\uc5b4 \uac08 \uc608\uc815\uc785\ub2c8\ub2e4.", "short_description": "\ud55c \ud310 30\ucd08, \uc3d8\uace0 \uae30\ub85d\ud558\uba70 \uc2e4\ub825\uc744 \ud0a4\uc6b0\ub294 VR \uc0ac\uaca9 \uc5d0\uc784 \ud2b8\ub808\uc774\ub2dd. \uadf8\ub9ac\ub4dc\uc0f7\u00b7\uc810\ud504 & \ud2b8\ub7a9\u00b7\uc2ec\ud50c \ub514\ud39c\uc2a4\u00b7\uc2a4\ud53c\uc5b4 \ud2b8\ub799 4\uac00\uc9c0 \ucf54\uc2a4\uc640 4\ub2e8\uacc4 \ub09c\uc774\ub3c4\ub85c \uc815\ud655\ub3c4\uc640 \ubc18\uc751 \uc18d\ub3c4\ub97c \ub2e8\ub828\ud558\uc138\uc694."}, {"images": {"nodes": [{"file_name": "icon_512_en.png", "id": "1510369369789522", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974886_1510369373122855_6301087923248548236_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhIW3wQX1skQ7kNvwHmYckd&_nc_oc=AdpwSu_qUaYxXUCzLGrMNQqU03B0Wd9D-hz6uTY42AkosUr48mNycOV4kNR9HWxt9QY&_nc_zt
QLA9as0kQ7kNvwFWWlzS&_nc_oc=AdoBHSWj4pNZymQEf-c3Vudhb5VdftO1tLNiYIDsaVkStDzAV1PqmRT4qwo2utLLbw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3sJEEbmZgo0AnkDcV6QPjZQk81rFBVq43qTUQrCuK6Q&oe=6AE76C43"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pqz4ptkszYsQ7kNvwG52uf-&_nc_oc=AdokSfatvHzQ_y4xCyFz-cvTFjQA0o-M0dGvYrxWNdH_NQwEnwh8UE8TmroEga1JTx4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzJFKG-HzkQnOFye8O63wIt_zu-KsvKTsGdLzJ0ovhjg&oe=6AE74403"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_SzTdtGnqUQ7kNvwH5uK-H&_nc_oc=AdqkvJhl8m1h5PymiETH0LUPo1LCK6r9zY8gRnl-6HN933lS67obf4CqDrKaG8VT_JQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2WIfIwNNkDJC_9Fs5kVI3PXfaV2DiQRwv6LxGu5YEDQ&oe=6AE75E6C"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPrSRpO_SHgQ7kNvwGgdlFM&_nc_oc=Ado00_FXz-48OriwYR3tF9X0L7qRlV5sG-PunG4hHwdcHMbWzkYoetUfD0qGQ0fHaqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLMT2lYBOhoGFKUO3kFIb6Qmymudh7-e7wSjT507Uosw&oe=6AE7443C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hqMl-g1l0sQ7kNvwGN_0Yr&_nc_oc=AdpgSY787uu90ydvFxuVln_-JQ1otamLvrzwjl7iHd8OfvkZvUDrH1L-o0p_xMLr_kE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRq_nCdi14ciFNzIn8lLYUU9icMVEH3SMSHI0CBX-C_-Q&oe=6AE74BF9"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
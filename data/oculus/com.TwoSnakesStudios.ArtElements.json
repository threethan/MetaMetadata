4WJAT9MEQ7kNvwH1GRZ9&_nc_oc=AdpMns4m3BRy8QI8oM4EJwFaQFCOgVS6KBw7QpUFNtOFoK3MiTu82XygXtdgA5r8mIQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxPKfGo4lvQxaHKUy32xrWZAatTQ-WP83jIZogfwtJ9A&oe=6AB90F83"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXMrIa3X3kMQ7kNvwHcy7Re&_nc_oc=AdoRGi2c_kO7Q5bXurcHowJg7GDTwGYhD8Za-1gQ8Rk4KbKmDPe2L2jYoKQi-lrCE_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK76gGcyBTDR1gzSJj0dUPwPtQnXmkaT6juTxOEzYNOEQ&oe=6AB91F83"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTJdNFokwHkQ7kNvwFfjp9Z&_nc_oc=AdosPv0htc1bp846VRcKNW70Nr6X-tCJu0MgdS7sH03TwKoj3ALhhGSoha7UXLC1hto&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCO5aTmYz5Zm-rcRV9v5IhbcrqXnjMrJ3O9qy1d-0TQA&oe=6AB939EC"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qJeEpq10nsQ7kNvwE0bknP&_nc_oc=AdqZWNrIfQQgpXkzBKFrduvRaXCPsVJm8LPfIs7oyaPNgKuZ8fG1Adbj1Wo1mRSIpHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFskwF3GLg7Xgez6_Aigb6LN_GyZp5o72BLhi7nxBmSw&oe=6AB91FBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoceUQjO3hQQ7kNvwEG8VF4&_nc_oc=AdoJdnKaaoxJbrBO2RR_ad_oWod1QBLB9OvyF8M3p5Zre3fVBfnOQJiuSRkT450ozb0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfRADC7aIwt5EwgiOjt77PpvpbHMKtOl8l_tzzDwKQiw&oe=6AB92779"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
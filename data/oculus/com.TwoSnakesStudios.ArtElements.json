4WJAT9MEQ7kNvwEVfw-5&_nc_oc=AdqOxGfyZvoDTS8SJn6p7Am9MHb1OGA_BeVq23hMZNxOIgYnM3E16X8q-rsiZuLei9s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjyrAGGbqFc0KwRNn3HXgRjCLKwg5yMlFHuzcVyanMdw&oe=6ABBB283"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFWHvmVfltcQ7kNvwH0nQIy&_nc_oc=AdrX_HZWtBVfhAGVs08JLLTAVLbsclirsGEOBk7pkDZW6vK9gyDpwSbTQwNHckzW_Gg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1NT5o7q8dEbgnNKxLgMLdUbyx90Iw733FtEWRRz1n-w&oe=6ABBC283"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTJdNFokwHkQ7kNvwGjGI8W&_nc_oc=AdrQHnyH90NwxEFEYlOZ2e848hJ7CxLZfiVr-Nng9waTMBckhxPMAd7LihV-7nk5S2E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrTXfvYvScRy7XjOqPT1Cr5N0doLC8UmaslfmL_A0OoA&oe=6ABBDCEC"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlch4rXVmMIQ7kNvwGTtP5k&_nc_oc=AdrPZOGaFjo3BQlm-F9l40kxur_kWaPyzsS2THQIrz5kLOhPrLVu8t7x_Y7zK5Y3204&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOLpO3cjnPtGAf69xMG1k_8GpX_97bni0RjoHm5qu-5w&oe=6ABBC2BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoceUQjO3hQQ7kNvwH6hCgm&_nc_oc=Adp-RmXEr_ciaz2Dbx29a8UObr8hAeNB9XVajz1cYXBn6ihPS_3rh6ZawQO0i7RDoa4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9ri6BQy3sBykK8u7vzbRt0fqqLguYJGxU3evlxZJGeA&oe=6ABBCA79"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
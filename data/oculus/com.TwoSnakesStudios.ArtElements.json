Z6NUI3UoQ7kNvwG_5u67&_nc_oc=AdolNw9ZL_rE_p8cqN1d_s016bkafdAoBV8j1QqPNSEt00b5JU3zsDwvpSuztxoI4sI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3iBhAVsF-AnxZ3KeDZQZXHBsuuCDjWnvoqXjBZDuGlA&oe=6AF9E143"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T46zoKdSnwQ7kNvwGgGCB_&_nc_oc=AdoaZr1MBdhugMNE2Mi-ky0Mp2l0BtxPKSLkcdx2KvrZs_2Ly41uUK8MkRB9eOA5uQw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdWT-fxTRPh9DQdbIsuUXsslxMsfLnXRae5EWmwcMWhw&oe=6AF9B903"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faY0WqS3ElAQ7kNvwHqo1wZ&_nc_oc=AdoEvjNbXg0QaGP0dpJUa8P2dh6wQnNafsAhJXRYJV1OOBT56RK5l64x9jrZ3sLtVI4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHvywQkKFuSQYGrx40oIWydh3TQ-HwQ_4yxJH9UATaqg&oe=6AF9D36C"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F404AV5BXMMQ7kNvwGxzXVw&_nc_oc=AdpvhZy6NHj1MbKUio-zr9HNAP-T2fyPTIpUajAt09skgtnQMgMdtS3Ct2X0527sY9I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAdXO9WiJz-VYgKfSAq803QM94petpGHGjjge2E6R4bw&oe=6AF9B93C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gUjYMk9f8UQ7kNvwF7lUEP&_nc_oc=AdqVRx7tRPeAoIctp70r5YCrD52MmysW9L3qNbUGqLkf-9vJ-KwOhzmbF1z9qlAP8V0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz7xiAD_-y53vyhuNjch2lzX_thx3zzf6SCHB-rrnk4A&oe=6AF9C0F9"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
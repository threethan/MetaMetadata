0MWr3UtYQ7kNvwGH9h6-&_nc_oc=AdqeZTVQZ9USq3auIpOgETWW1h5-MV2xwt0sSkAzry9vEDpXb8JXRdhZNcbwP5yAM58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jOAN96IcsR6yX5nfpkgilZ1TB7Uf3J0q0WZAgOh1NsQ&oe=6A1ED003"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOZfCWh9SvoQ7kNvwGTSygd&_nc_oc=Adqgt1lBctN7nL6wuzUn7aVOw7e_k-ytF0cs1ZuFB1Od7u-YcwZraCllPbOgnkLyDdA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KVd-bVTqlaCi6pREvdB5qDw7uZ3z1LWHIbxY2brZZvg&oe=6A1EE003"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7f6sKd1VZUoQ7kNvwHlFpkG&_nc_oc=AdqbBU9dcNYB0CvIMfFuRVAX76ebsYPzrtuR3emhSPPoo-0PcWWNfXCnLz55KBMYcsg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xozvytdF84LldlVGniN-l-n8xNSyQzE_FrOpbeA8v4g&oe=6A1EFA6C"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7hPUHwAdjIQ7kNvwEv7EsQ&_nc_oc=AdqJ6Urp2-Ty2Rc2W-aLQaz0d10Mx4QUwxPoY0h0rCYY4RfQqrpmKiTg0-e3lxUG2vY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ByXMT7DKoKVg5QcFCSQ6w3xM75b2XEAo1_hKlKxr05Q&oe=6A1EE03C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2Lvl3gnURgQ7kNvwHrRIh8&_nc_oc=Adp5--T3r4zl1fuHWaQ61bxULy9TreXIBeVxyaOV-PDnhIX5TGpHmX8JJYUvv4sPim8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-4lZoy3vPV35lyX_ixnmkneZEQvZvLn_3Q2E6WYd0qA&oe=6A1EE7F9"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
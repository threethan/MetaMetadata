EGx4wE2ZLaDPygTl3H4CM9Ek9D_VnVPFZj6U74lk0kNw&oe=6A846383"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHSEhDCUAwUQ7kNvwGHlKeD&_nc_oc=AdqB4wyK81nLFkFdqXnZ1VB9S0iRXH9X_2Gqsux7uk9kbd8wJZ4t0MEZ9mmfRGSL5MU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGphF5zpoJKWS4Bd-x66DUgv2RpnStI1hTd8h0LVefnzQ&oe=6A8445AC"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dO3b7RiBXWUQ7kNvwEuJX5I&_nc_oc=AdofqK-5XxxRO2Yr8CpB-YCsMzsxs5L2grOS8-1ENon19pWNWpp0vkOCXm4jlO8iR5I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbksGS8wPW1MWiG0Ccm1iUT76GOGPFj1OBGjclD5k4nQ&oe=6A8463BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_2oqxlGrK0Q7kNvwFeIVg8&_nc_oc=AdpfLbYpVXNaU8dYMy7O10EQjZmAwR9npjef2CW5QE5qE98U9zK_UgKJSkwg0onOQP4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-IwfJ7tVvH95NjTmkmRyEUIMlFofI6Gpmc3IBKMlLLg&oe=6A843339"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8280036828774786"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2164708247310205"}, {"status": "PUBLISHED", "id": "525851643738038"}, {"status": "PUBLISHED", "id": "1321969642348987"}]}, "baseline_offer": {"id": "1321969642348987"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755277200, "status": "PUBLISHED", "id": "2164708247310205"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "958293065
0Kj_H0vAQ7kNvwF2uys1&_nc_oc=Adq39mCkmsH09t9IifbBAXbT9aiCnzdQ1yNWnqaKwJQJx4LblfTw6UXKEIWC32FUix8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Yorzd9d0kR_SrqHeV08ok7G3QnVS94u1iIiqlQiSooA&oe=6A086683"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ri08ORRNAxUQ7kNvwG7Rc5r&_nc_oc=AdqPiyzLFNrpcAK6dEc9X12h5KN1MrVlFMVA08Nljt0xX1--dglFetYZsjzdkkqSihA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jVLgZMD-eRzZAxqu0kwGpq25Fn8PgHmPnNuqFr5pEqg&oe=6A087683"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KCDWoWo6T4Q7kNvwEtAmnK&_nc_oc=AdpfCEOVDiCTwP5W4m4pJ4zRraWvdBpIPpwoeYq5Sb5LtJ3RUwpjaCLw8MERKrKK80A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u5qcrP9aYCFVjQKoC89_xD-d_4taBDqP7LMsmDP4qPw&oe=6A0890EC"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ET-xQKD8WPkQ7kNvwEU3fJY&_nc_oc=AdrsILUNpUpHqE5mDaSapd3oq1dTcOp43-2HdOTzhQFY5uPzblt75OM4135yxuEZoHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_Q6jgHnWoNexRE369VJRjBB_iRmzDwJVVbNRGaUio1A&oe=6A0876BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkm9tXqUet4Q7kNvwHgGCGr&_nc_oc=Adpmd3Y2zPI3LDXOi_WqWMgY-0dzwT5b8hd8pWkHUwEV2Lwjxmfka80T_7DsHMOyTu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YkEPAZNOHsVaj4szACrpqogKMrNXSKP8o9DYpwG3Ypg&oe=6A087E79"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
iAmnEs_kQ7kNvwEjKWsk&_nc_oc=AdpQXDRYdNOQYvPuIDNLDq3ai-itWlKtfLvJk0yEfJyrkDokIFJGA1-z75r2bKoeRIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ETPXIvEwxJRDoqI2fjCPe3qFXvNP3XKHP1WV7gDF7Jg&oe=69EB6583"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgSFZte2AswQ7kNvwFVkTLj&_nc_oc=AdrxXc3gjHDa1cBNO1g7VfOo9GPt6zrdShzMfecMoOIUzrxBvpjKNlLICJLR6jsjT5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-UlFqTM4aFFsgkblY3aPkq1c__US_voBnto2wUfiEqQ&oe=69EB7583"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxExM06KZ4EQ7kNvwFKXKU_&_nc_oc=AdpyE50FdU7Rcpex3IF-Lc1zLlGfduGtQIZX-A96NkgrmB0VxWf325AFfAV7HF76o0M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Fpvq7hebm-ctcKegOJ8PuXW_9CqkOq9l6rTS7YokFcQ&oe=69EB57AC"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V2xUN2FCRQQ7kNvwE7itlK&_nc_oc=AdrglrV_FiH5ga0t8TPEnN9OyAAKlsrmL3jxnKV3qtAe7Oj9YA8j4tnoTbrN3L-RXQ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23JQbeQXrHRJFGVHRtodNe-zF-VRfP1QxszvcdG_JK5g&oe=69EB75BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NLwN51m8I4Q7kNvwHu54TN&_nc_oc=AdpnBWPqYXZjB7QBjzajXrsO2O-AIWtKrAfLUp8P1LBHLihzkeHLv5nB2aKKhOTKYt4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RBI2EKR_1UG65gW9aniouTw4K7rwsqF1n-CFfIPolWg&oe=69EB7D79"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
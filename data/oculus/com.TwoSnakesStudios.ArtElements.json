0wvAUvAwQ7kNvwH1kFWt&_nc_oc=AdosHuNmLG4g0-kG9OpT7kWL-OclS_kA4agXb-G7Y_UyAVDbg7r-Hea_bfCiMeHl1PM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3CkSAaiGYxOol2TpY8iD-0PODCFyyGVIWB5SjhC6QgQ&oe=6A75D303"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7xE-KDP4I4Q7kNvwF7el1B&_nc_oc=AdoGJ2rN4-osd-gqxXAzJFYBEvBu1sYrOMeSUV_hIsA6e-qu_zrk8q8LcuRnh5nQkDo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3U2kEcqXmIspUFWogTviE8hwyO5H93VDdDKWfvLD70A&oe=6A75E303"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asLXPyAKFogQ7kNvwERyiLJ&_nc_oc=Adr6D_g980jsx2JOAW90jXpFOWxHawU_4V4vZslA8KQ_GDVXCZcf-g3UTbe2WbBMXiM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjgA69YyHgWvlJHJdQUQzPTbRSYFsaiM9t9r4pBL1k8w&oe=6A75C52C"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxFDSOlqpNwQ7kNvwHE6QRq&_nc_oc=AdrMTvan0PRXecf7Nv4-vu_7NCUbP2dy-oG8U2kqE64dlAkk9krqmRTs3E6FZdpr2as&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqbPGO8fHNJg9hDXwYzNHLLNpAhES8Y3xG_9R6VTBPzw&oe=6A75E33C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cv9W51ec8QQ7kNvwHltHZF&_nc_oc=AdoRv9lQdbdPIy2YLjCIGYJIDvYubgLMCRwui8TkQ_QYBjBXBQCXopYahjrDfvs147Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA_fjSBxiXxBR5qh4Ztgo-voTXm__Zxl3NzOH46MEbyw&oe=6A75EAF9"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
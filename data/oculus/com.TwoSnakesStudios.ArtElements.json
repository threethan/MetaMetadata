50eS2mkMQ7kNvwFEggIP&_nc_oc=AdpyoxDqq--Vj7_PfpueUzLD0BiG2hk27-TFD7a_9OgX3hbqnx7k9VoPus4eM-X28oU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_63mw0BC-d_NCgaBqGsOIg0biaXboJPkQvi3A6-a9sJQ&oe=6A241603"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--hyQs_4zl8Q7kNvwFLFfq_&_nc_oc=AdqUpHE3mO--ACbs12M8AO_AZ2BmbXgpt5pci3aQTR6bhjPuIMSyDKTUFMl3DWWWGG4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HDkM58vIIUGuAjFiKkQrTqgNWXhLA81634ztZRueu9A&oe=6A242603"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyJhfi7Fw30Q7kNvwGDj2yL&_nc_oc=AdrxdnIxZo6AKzHXE_nDTeolmMetcLIfHCp1qqiZ8LXi3UbunXuW76rAVadEuxJ4lR8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PGMzhK0zXddEAvKSBvPKYJjIIAseRQmCV2kznctThIQ&oe=6A24406C"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TDobulUU5IQ7kNvwGgK8ya&_nc_oc=AdpviZ6jIZthQT-kuAcXLvPeejdWJl1TYSXWvni5JvMdjpFxZIRWsur0P5NZ7FCl5HU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F6gF6N8KdG-P74OSOXpGJfyfxjruu1qByjvatq_sijA&oe=6A24263C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUzPg896Xg0Q7kNvwErHuxx&_nc_oc=Ado8ag7LAcON8RUkJNwKT2HgO7LfqXubWQ1lFIHuLlJUvCpZx5D__z-Bg3IUsedzjOA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H9sF5T5-X32FZxYf5lcQjOlx9B4fnkFy-xARlVuUwRQ&oe=6A242DF9"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
zytmIWFQQ7kNvwHTHFFP&_nc_oc=AdqMb1Kncjympk98L4pQOJY0s6numONiDL_hLdnHHqUBKqg1THk6gYTFAGrm88HhA4o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJumDcgmVhbtGvBJqoIVmSu9CQ-pB60vHnAbKC-_gvcWA&oe=6ABD0403"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFWHvmVfltcQ7kNvwFr87R_&_nc_oc=AdpSfe1xpMHI0pmPvfhn5Kmny3Z-xyxatHBSVO1QcLoz8mdv-hiSF8qZyOpw9aAJ3Lo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC1raHFhBfWqvO1liJ-q3xP2ToPba6CmEfWOiTNJpHIw&oe=6ABD1403"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRZ0YGCaQoEQ7kNvwHevqX5&_nc_oc=AdqxThfv6AqjGfS3w0YFTewsywb7ADqtMhemls8xaTeROZZ5d2J_BkHUP2WWheeMo3M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGa1tsxbth9fuWmLY6-ytciCf__0dxCuziAWPoh10WRQ&oe=6ABD2E6C"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlch4rXVmMIQ7kNvwEhpE65&_nc_oc=Adp7VpxW5MHgGv9grfook1QgRnTAUsvGjgG50icp628D0zFndvBdrDFIbROZAAY7NOo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKAHcNRllwIgdTzZcH6pdNLc5ZAkf2pIkXe7pOqb8jvg&oe=6ABD143C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GY3ZH5fKE_8Q7kNvwEtkl46&_nc_oc=Adpz9oxtCPDNavUmvwDJw6Ehf5kg4ZP61pr0DiCToeNdbvU8oBWU1kEhkAXGlsvPbR4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7ryAX03S3jMi1x9sCS_PB4wbtmUPpWFRdIm7t7wbeAw&oe=6ABD1BF9"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
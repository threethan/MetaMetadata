z6JDphoQQ7kNvwHyF-Jx&_nc_oc=Adrqgc82glJhQ8L4U6JZ_EqT_SrQjyTXS5ywd-jWzfvjqn3bO2Pu6IFVAb-FDF7dxGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ybuyd8vL5gzC9BhWQ99hSPVCqk-Jm05Qi8RWvvoYOCA&oe=69E4CE03"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brmtFTOYgcwQ7kNvwGVmzTf&_nc_oc=AdqR0PKfJyY81WNl8fQlzUSKZWpkQG3rIgTjQnm4f9L3vcuhHCuaeHnE1GwocXf1ts8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f_A42Fn-wan88xOd9vVfDufKv8ilTq1SnyDwUce95sw&oe=69E4DE03"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6v50EZT5rwQ7kNvwHQxOJg&_nc_oc=Adqg4F_-CoB-L5ds6KJVUsUxAqkIEu_ZNwSCl1lv8uoxrDTwWtx0eAYeDZcA4FZlGe4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OYBFEZI-eF41K38F7QiFwykZBoAqKJIFtXUTG0MDlcQ&oe=69E4C02C"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uB7xNDSsnIQ7kNvwFSusoX&_nc_oc=Adpo8NMDV__JiEpDH9s1KcehexrYn7UGHW2cqVQQssKFiI9Z5Ret8Gxp0OzGptS4RZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dQvPrOaR50-eavsP7XXFnx4CJpUyyJGEACltUHjQ9SQ&oe=69E4DE3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8nPAT7mKuwQ7kNvwEgbrmp&_nc_oc=AdqgDdJRjrNsJJheeofrgsVNg6Pe7Sw8aRYeWdJRhk1SEEWucpZB2b4Ny6T2tbrlOag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pAmnP4j5Xz7Ch99sz9w08Tsef_HimfUzyFDfiQlSQXA&oe=69E4E5F9"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
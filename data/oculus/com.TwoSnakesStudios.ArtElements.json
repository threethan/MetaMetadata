J9C59YmQQ7kNvwFlkNuB&_nc_oc=Adrf-8T2W_6cObfIm6CuOdkz6nkDI3l9MsNJeNJDRIdyWsZmCjaaRPB-e71eEzihGlM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ1vPdyoaAqWRn5-Wiid6nR_F_0o19oOe2PN7HXnl-Jw&oe=6A973903"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFsi5PPvQwkQ7kNvwF-DNY9&_nc_oc=AdoVIuGp4WgZ4a-Rtk-ta4GfcbbQ2R-noN7f9hdkJrC40FRUhoKzE969pDN53B60bgo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJKH0xtSrlSjby-wErDQ4y0YL2kUESiSydjt-61rD6-g&oe=6A974903"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bV0_c980aN8Q7kNvwHJIZjT&_nc_oc=Ado1Wv9vuLsZp5won3dWOeF8Dmjs6xeSsCqievoWpkR9S1fzJwq4qeloEeLpTBwi0lM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHc4aZqsgkZvr2aLMhWkWMbLyJiHSRBMy4ZOZRzAaHlQ&oe=6A972B2C"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzByxXyYQH0Q7kNvwEQDoel&_nc_oc=AdqTTeZDxiMEf8BBHz7siwR3qS5SoSEtWdMWsHGP7r7mAjuPQ-mf0z3fxPoAL1sAyhk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET-R9sFA_GOfykCQHOM_Ex7A8Mpq-qVA9tlbptkJx-vQ&oe=6A97493C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsXvKbX2TdUQ7kNvwEjwaYE&_nc_oc=Adp6NJ3L0bLZhcghf_iN_ueucpz2kVawsnsBAFYFR1uaJ8cbIRe54uxZeOribUVNg8Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFpd6FOwd51ArSvLDbJdf1WFe7QElOGiWfuS0vJhJZgg&oe=6A9750F9"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
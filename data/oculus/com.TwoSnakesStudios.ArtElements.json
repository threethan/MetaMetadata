sNDYnOIgQ7kNvwEcY4i5&_nc_oc=Adqs0E-LzodMu7ZG4C6xz7suMf6w_KV5Z6e2ptHE7rXF_P1OwhpsDjlCDLwOc6n8H7k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4v22N4B2mYIl_g9hHOqBeBEG2iDKWu72N58a6IwzZng&oe=6AAA8F03"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHILmpt5LwoQ7kNvwHoDD6N&_nc_oc=AdrW_WpGIQmKLESwKxt2hVlOTXg_ahIRj-71nao8Nz2omtSFIO0BsWuGTtS4UgPHAS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAUwJKlbK2lrJI6F6ciS7KfhqaqQAP9EjT6iLfpyqD_Q&oe=6AAA9F03"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WFyUdQH_gYQ7kNvwED400F&_nc_oc=AdqIqffOKx8_vUpkWz7jNg8fUlUWIxNBOcxX92t6z1MLrxkLATe4tbJdIuqouI5kE9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRc7w9b49aYE_Dv0FH3649pUSsZuZcQPvxJt9KvlaVzA&oe=6AAAB96C"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzfjmohjpgUQ7kNvwGj8FwW&_nc_oc=AdrBiPlfwRFUIA1-_cIVMPcFD4_2nMMmCyTr764Ex3t_4_zqUPoY7S9tziKqmEH0T1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWO70Rdh4MbASYMlujpC3GYo5iP_Zx5M4qZ-YcooOHgQ&oe=6AAA9F3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4T1iD64pt4Q7kNvwFgtO_F&_nc_oc=AdpQI8Pg6wDGCJajBIOojJ3cBh2yL90pZu0jCCl_qg44BlCsS1dVWDTpyonNtZPQDhI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYgtF173eFjBSmDnadfKjTpR36u3a0tiaOfVHIJQ5mxg&oe=6AAAA6F9"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrPIyCaE6AHAzSoB3IIzVO5W_n48IQUho_aaXTRidKzw&oe=6A8EEF83"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7Tj_abUmNAQ7kNvwFOt9eJ&_nc_oc=AdpdNCFYRj6LlvYUr8OXynoNkDm59zUy2L51pS9KDSSEkD8JWCrf7AfI110WTseSV2g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBbysRpXoKehKYHs568zMUsaJz7yy7qbTjyQpMKbEWCg&oe=6A8ED1AC"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CITpq2_AjtIQ7kNvwEM4nGC&_nc_oc=Adrz6mJlQ39m7xQeXqCUWI8GFKgG-ZRFBprQX7lfRV5JeE_yyb2W7ZwDque77DJ-nd8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUO7qIEmkvM7ibBwV5m5JhXV8b3UoZJz7Rm_MpP_KJWw&oe=6A8EEFBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFAK2ywTDP0Q7kNvwFPgXHh&_nc_oc=Adqxfjw4aFMlb5dSYSVKhacViA4xohPNPBwgQ0302gIDaauqh5e5zCF2Tk-r7o0EYgg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUay-fkmG_D0avFiKOTM41R8hxNoU0CJCeMXGGzgG6Hw&oe=6A8EF779"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8280036828774786"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2164708247310205"}, {"status": "PUBLISHED", "id": "525851643738038"}, {"status": "PUBLISHED", "id": "1321969642348987"}]}, "baseline_offer": {"id": "1321969642348987"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755277200, "status": "PUBLISHED", "id": "2164708247310205"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_
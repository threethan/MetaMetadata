0mEkBfJAQ7kNvwE8TT7v&_nc_oc=Adrk4JRZWgLRTOHup7B3J60MRCTSDVXOs0srEfHkhJdQS8Lm6PBd-oSEEA2HdQfcgMU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiM-G9TjjT-dLpTSXfg2esrvFw3asZ_6o4hRXMnz4SuQ&oe=6A4E4603"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jY-gTnKWd60Q7kNvwFVFjXS&_nc_oc=AdqaNqwKUYgl1FB0CEy4DF7eTLHSOopNllfpq-wXcCmXRbSlPpdDz0WSJJ4BkMQwcuo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqlZLnJp01-7gl8JknN4iQYMuXr1yIc21qJBe_P4Ja4Q&oe=6A4E5603"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBMUq7NtDTwQ7kNvwGgoR9Z&_nc_oc=Adq7GFFudAvhPqlqNcne8PCtdbkZXrvJavss6_9ZgcZk1QDuTT8lcWM-9smOu3xwR-Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo7EZ1cYzEu_sZZICIhc0jqmbwG3Ud1712Wpai7KJoWA&oe=6A4E706C"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSPeFfG8ImkQ7kNvwGE824K&_nc_oc=Adqb9u8hLg6aaXnh7zwweG8MzuBFQmfqoOoRuRH947ZdmRkdQ3zduB51ZbUNl78_hpU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe7zGEjDnxiv306ByRHWxj4PzW-Bz9eQYmUQgW-GpKwg&oe=6A4E563C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFueYDwRa1MQ7kNvwEC6X48&_nc_oc=AdrND8W5s_8VKm17GszydWoWHqAqmK-aTIT_e0orA_gbbyh_MBcgQn4RgFZ7D1M8GlM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUwI0IHzBUAxOAcNa-UFfsGK6_AKZT94liVUukSr39uA&oe=6A4E5DF9"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
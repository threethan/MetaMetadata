aZJ8LB_8Q7kNvwFD4kra&_nc_oc=Adrs_TkyEhUUi5HsGTfzVUlk-0LyNiBPhG7qhI3w28cnT7gr7al5YJFJG6E8r692sIs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeQkAGOOnwzeS2245CmndpQjYkkBHo442HrI2NXeJejw&oe=6A942583"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFsi5PPvQwkQ7kNvwFzAzPM&_nc_oc=AdrlO81UEbYhMjT0WJrUZekeoL2gHW2-3DLN2zykIuq2Xhbr_NzisDHONrNy0ZKKLD4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSuMAVuffYZlrwSIPwP18bINUhVgb0X7FAbDBvSaz21w&oe=6A93FD43"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFZS5K36r3oQ7kNvwEmshES&_nc_oc=AdoxR29pS6jlBOVwfE7rbmKQMI4onJcPzzHd9m6OTSkeqhL2YqgpkjFpWzNkxPCHjK8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbeda9YxrJtphcIBFJaeVBRjB3kU3qdu2wFDvMusMLwQ&oe=6A9417AC"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZqkHWgIj6sQ7kNvwFmFdYf&_nc_oc=AdoKhayKJbYB5IvrXak4CxzbqDZYd5tL8Yh2SZcDdKyBXgpltvCKbpLuD5w6smQNTAI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkpukTVKbbHQK7M0RWEP2UBdPwXASdcXXXGfACXKgdGA&oe=6A93FD7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwkjlwTEaYIQ7kNvwH0jS4M&_nc_oc=AdqhCZ7T5exjsilfUr3aynPPCjHgelPnrYDxxoiE9lSDRLwFjimgDhayWvsZeqh5yLA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy4-iOfMSD4n0qr_wRR2vBjxbajRrWXwhIKV-0XCH6iA&oe=6A940539"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
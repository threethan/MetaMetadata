-3bpN7mwQ7kNvwG7OXwk&_nc_oc=AdqH6qlSOQOSqcPMQ4FEERz52-oi6bsHryElDBkFqc_VieCrPZVnaoAidcRaIjZMf60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzD0lZY9x2M3LukBzpQCg5HmFDlrtxEoLjj-sUDj9WvQ&oe=6A675283"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJwfFWrcZvIQ7kNvwEVx3Ac&_nc_oc=AdqYMQAnTU32fhGasgGYWnxF0248oMm5rUq72QDPltI0Buu-BlF3jfalYl4Qakl2xKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvGpre8vogt_yH1CKzRWxUDYZs8fHMjQhtItbqOS06xA&oe=6A676283"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDa-UdgDFecQ7kNvwEnPpJU&_nc_oc=Adp5e5iDC1IHCOl0S1Lo5Wjq_3iwINSLBI0QE5b_mhHyz4Tzls-OtEZIosE6qvAtNhQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvNkR524OHTM7LX9JDCyYvi4hBp5Jr-rhrbt4TcykMVw&oe=6A6744AC"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTsXO6thR_IQ7kNvwEpxLZx&_nc_oc=AdpIgs7IHOBlLu1o2TNAH1vec18Uf01rLCTUv1_q34UVlcbS0-ZbNCYidk1eBMve0pg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVrJdR1Vzc6swzkqOaGCSNlN16mFt3msY48H_DkyPrTg&oe=6A6762BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klIWa6-IIbkQ7kNvwFZw5OM&_nc_oc=AdotN0DzId4KGWTOJmuEwKehfQouLsyjtWS7YzN7D1AMSR81MHH92mexeRv9dIKnb_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCW2vPsmvlTHqZWwJK0sv-VPdc-cOR6z8YBfYR35IR-A&oe=6A676A79"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
0mEkBfJAQ7kNvwGSZI0Q&_nc_oc=AdrNauf75OwtnxK1PQTUTBGwzvk2isYBBLc1j6Jp-qYGf8YiK6jm7tQ86kY5Aul5N7M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5hKSYHBkT8XciCNBfYblKV1UjdvdCU6HJi-rtdkIBKA&oe=6A50E903"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKZAZQP_AY0Q7kNvwHw7m22&_nc_oc=AdqJ1ia4h0PTfxBCYRmehRGzFosOOCPG4uLaZiiXZbgXfqX8kWHW1_axO1maYhd4Dxw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_7rBPIPtUgEo8t93keVaydV8qfkQNzPQlaw-hEshIxg&oe=6A50F903"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBMUq7NtDTwQ7kNvwHA-PpB&_nc_oc=AdpPyMIH2KerIHMCEq1DW8recZpmUMtJ5GtSe8J1pA6Damcf3ieE7MzqgdANUfklIpc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2Tqn6ak-LtAzqYLDNKyZ1AxrsNcatGcGWjFXJIQBMaQ&oe=6A51136C"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GOEPEPsq7sQ7kNvwEZvsRQ&_nc_oc=Adr5TyZvfA8jBatq43bTEIMc2B0W_izbuXzqnSPlGVpCr304Es_4xQjDvWDbqOkxLio&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHXZUu3Y5RpBYTbzu4d1q3Yv18yv5zDJOChziTOEglXA&oe=6A50F93C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFueYDwRa1MQ7kNvwFlvmjX&_nc_oc=AdrrTcgzn3Eh95d-1XtYWRm6qxTRng_-B90UP__cotMNLmoXgf1yIqJPo7FL9JdzSwA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2NB_CvLjBM5CuCQaFrOpWCyi1twZ0SOFG_f95YSNdOg&oe=6A5100F9"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
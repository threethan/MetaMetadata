jH7depUcQ7kNvwGyO7Nj&_nc_oc=Adpj-w3VJ0xn3JSV6Zb8QDK8R_eASkxfq0WDM3kBV9An1T6wfCfPsxfESalqFmKm-Sk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGe2jzChf1DR-PZnx26a6-6yOyPf68lProjvaQynIjpw&oe=6ADCA803"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbicaTYnyXgQ7kNvwH3xfyv&_nc_oc=AdoznprzgN0yftJCahVphw_0UiD7zTzYH9_RUJkfvxcodolHAXc6l6t3edQNSPmuwMI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMia6nig-gAucnCw7C7kFQo8l207HU9DpIo8G5q1xH26w&oe=6ADCB803"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQh8n4tZVy0Q7kNvwFEM9fb&_nc_oc=Adrk6CexVByL6WQQyk56gYPF1Iolohn0usJOOn2gfUVKsIyraILDgdBh1yxr1ETNXMk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmT1KfvmBIrkAkdEZ8qtr1sAiRTRsghXlZ2QFfyazDzQ&oe=6ADCD26C"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UN2lp7AmVkQ7kNvwHH55NO&_nc_oc=AdqtTh-O-8Owqy9j_a7yDd1qKFk6nnlK2BT6EqP79ao4Dxy1rpKf-kevdNFoniduOL4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUWrUGgV9-XPxAyUCq2K8s6v7lCb9R0z9HWpo47E7evA&oe=6ADCB83C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxvtmlqXPBQQ7kNvwEQWKlE&_nc_oc=AdrByWe1oCvhtQ0oF4shkfTf1Vv1IOg5ruNTtaytz_65sq4RxWx84SPAcM_vPnU9nPw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcwiM8ZSsHxW6D6Utq0kTm8LwcDo_37upkfs9tpXn7AA&oe=6ADCBFF9"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
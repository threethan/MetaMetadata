kV4uZ26XtJUCSBXxcNizzjsp_KLoI3_TWiL77RLNSnM1scs8dOich1Xq6vznO58&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw1MxQ3wcYhRuKzv0WJN8Q8j5JOfCElFsf1l97jxVtNgg&oe=69B40683"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iRH2bVUq74Q7kNvwH6ksqO&_nc_oc=AdnOgZQ5m2lxyevorCj5QTNusicblWzDekLqcDS76A-gjAUECgRpXrC9KD_gJ1T4W0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJMzlFFGmXoflf-IRdvOTQToFbALavTv8n5UG5PdwAVQ&oe=69B41683"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Utrbp0O8JRUQ7kNvwHrd8sq&_nc_oc=AdlOkEIeQV8nCPKg9nGwtg6CN1C9Z2xTkM_9GN9ATYpHdaJ-SqIWs1hXi0XhhxswCxI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwP6OjaulS_a-IXXSGcTqF8T1BL3DP-PLLMG6wx1csEfQ&oe=69B3F8AC"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oKRmM47EN4Q7kNvwHdTQkp&_nc_oc=AdnfWV0iddVOJP4Nhkd2tETfMq4Oh4NmQjIy5qiSD1Kb4qc846krHNnzZGDkLKlT8g4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzrw6e9U4MTd3HnX3Cq5MBIPnkEncUcuxPjUxyt5gx5MQ&oe=69B416BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGzOH_ywRd8Q7kNvwGoBuFv&_nc_oc=AdkeuAsEcHq1u1-5PYJW57hTwXYSQYozEhr5xC81zf9pkjKKpPBtwSeNbNfZ3rORPbM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0Mq2U0LkHVxkE6NEbwH3y7qfD_Eder9c9Ub3IyFgiug&oe=69B41E79"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SING
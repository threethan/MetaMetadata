qeQi1tlEQ7kNvwHeAFUM&_nc_oc=Adrx5bZi3O4S2fvtWPmQgGFNTYNtBUuZS_coPWVRas9BOJHtHQQGmR3aIbLbMNIi4nM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PLDmY9nJgbM26lB-w0iZg_60YhqsQTepqsL3P3FimzQ&oe=69FB3783"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q98H4iZWqTcQ7kNvwExmm1s&_nc_oc=AdpNpzGEKoyZ-4PscgVoFvmuDo6S_g8LOXt1t9O-eyV8vW0_K1et16RP0o2zG4gpPbQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EOErseqzFCkCW1sYVV1jz32wp4xB_rl3D2xko8rbQxA&oe=69FB4783"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwXGw6bJQ_gQ7kNvwHqJld2&_nc_oc=AdquJfhUr3n26dy7KidhwFBDP9sIzXYmyynzacYTO5Z8m69aDC6prwy2T4VqIw4WiKk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GqKF4323oKYHpPAKg12pQX9kdOR2msCRM21mWg72RJQ&oe=69FB29AC"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwMENedUejEQ7kNvwHijjb-&_nc_oc=Adqhej-omHfpHwM4Lgq2jNIQNTPZFnWBwn-42ZEv9rWkwqotp446fNP1RswlIku0JlY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54pP5uihX21nxed5vaVaBPJ9SMG26ejOkrCUUY-JLhdw&oe=69FB47BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ljM2VLIFxMQ7kNvwGOaU2h&_nc_oc=Adq-JCeHTiAGH0v2bzJ0vYzAjIMjHlltgN81M_DiNyFWKBwefYiIm-MObRT9_xGlY5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71hbP4VGlFzhIAOZFni9BlIhJdS5jNyZlkSsIxRNqDGQ&oe=69FB4F79"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
U-LEBQ7sQ7kNvwGK93yp&_nc_oc=AdqKuJJixJH2MCGttmp9ctL3FWa0uE4AupLKnM_PHLwk5nXhyZp8Gb7vrfH5n0BFdvc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ewH5kqpusJ-WhCxG-Xgpqx7JVycOIU3-rfYDYHHZIlA&oe=69DF8803"}, {"file_name": "screen01.png", "id": "1837482943755463", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393511_1837482947088796_8813914851431540833_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PES1PjyePWwQ7kNvwGfaQAE&_nc_oc=AdoZGfHTh6ODSZrQHDOZwqUTd3Lz5WMshNrRocvrt_-EJxT5XSxrUGoL5R1efeL4UGI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wJnl6lXW9zlGz3vkS1p9ewmkNe3iKs48mfmZZJjU98w&oe=69DF9803"}, {"file_name": "screen04.png", "id": "849923700644886", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391888_849923703978219_1703671990563042613_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7v3Fh4BWDIQ7kNvwHz2xHn&_nc_oc=AdpFFeMos_nB2A72epomUHiLsLx_PYkZluEtrU4uxX9CK5VDxJfnKl3J2DrGJPd88hM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DR8R1fWZFYIZIrrX26CWM3-_jZZ9njk0q8xnQHYObxw&oe=69DF7A2C"}, {"file_name": "screen05.png", "id": "987578630020905", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392016_987578633354238_7601594027466031532_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR8NDfBBjg4Q7kNvwGTlxNP&_nc_oc=Adpd5YtArm0nhF2_MN2L-C0O2DCD55ggpq7bZIGPOOlX09HVv01dT2G6cUCTzC2KXG8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Pe1dDaTEg7bidCH1Q2DTPFMYSAQ0W4H8ct7c_owTS5w&oe=69DF983C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr_cover.png", "id": "1693159194661616", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391952_1693159201328282_3353353706858830982_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5MS3xYlRi4Q7kNvwFL6bSb&_nc_oc=Ado-XzRfozQ4VEQxNWddGzHNhb6YuQa0rf59vPvnwNjbRKzUHoWgdRZ2BtRF7wzL3M8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RaekOyoUm2p8m5hQmhsJt85Y-lP30sAF-xBiQcu72eQ&oe=69DF9FF9"}, "display_name": "ARTful Puzzles", "keywords": ["puzzle", "jigsaw", "education", "art", "paintings"], "long_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists.\n\nIn our collection of puzzles, you will find carefully selected paintings by artists from different eras, genres and countries. Thanks to the great detail of the images, you can pay attention to the smallest details of the paintings and discover the author's ideas in a new light.\n\nKey features:\n- Puzzles of various shapes and a wide range of difficulty levels\n- High-quality scans of paintings with high resolution that allows you to see the smallest details\n- AR mode\n\nARTful Puzzles are a great way to relieve stress and take your mind off daily worries. Enjoy the tranquility and beauty of collecting masterpieces from world painting.", "short_description": "Relax and immerse yourself in the exciting world of art. Collect jigsaw puzzles featuring iconic works by the most famous artists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/1bc3ac58-4c44-4f01-b4f4-d2364d91d4dc", "developer_terms_of_service_url": null, "publisher_name": "ART2team", "support_website_url": null, "website_url": "https://art2team.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_t
821725_1583896179487726_466696083619896199_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gImezdiMi8cQ7kNvwFYMk0V&_nc_oc=AdpaYd0YA-v8stF9bUn9OQvCV-aYCk7ZalCwSFNfLMntW7h0DP_4Ws1QCzL6bz6o6QY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYnzD-VSps30rdgFbGmwPEAt-eKJuwstMcVgjXxRvjaA&oe=6AF5E91A"}, {"file_name": "\u622a\u5c4f2025-12-31 05.39.58.png", "id": "1164391558782140", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820441_1164391562115473_8874463600929620068_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kXbg3gPA0sQ7kNvwHKQopq&_nc_oc=Adr-9if380igPTTkUTwv7Ffe7CD27guHNygn7JNzheWwSO99e-KcDn78JUL6TXR8IXU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJL8mZUe3DX87XlcHdMl5q99ux_2Fsn2fSk3zZKfZK2g&oe=6AF5C11E"}, {"file_name": "\u622a\u5c4f2025-12-31 05.38.52.png", "id": "1940933266845848", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821081_1940933270179181_5748549979807030051_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LunTLKC0WREQ7kNvwGvt6yE&_nc_oc=AdpsFIP4a6PvPAn8wVm5CSHUU7Mtsvf-ITmUhW9uRSOUpiJW0zbeczzwzE_ngvuV8a8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRyEL1MpVl2y-f4qZw4s-DK0i3S-LrHktrUK6YIcqB6w&oe=6AF5D817"}, {"file_name": "\u622a\u5c4f2025-12-31 05.33.14.png", "id": "1519427339170755", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314663_1519427342504088_8331921918338287964_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8JkSiPw9EUQ7kNvwHNHXJ_&_nc_oc=AdpmhfvZKpy_n9LEGs4-XFassnvQKej33V-zwOBusFxpO8OXvDbBZvTG6TqYb_Darwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoMUC-idMe9tKsJ1w7EHAOZ4iQdEM88FwbGuB6EfXPCg&oe=6AF5D8B7"}, {"file_name": "\u622a\u5c4f2025-12-31 05.35.33.png", "id": "3579213155571937", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_3579213158905270_32835796408060977_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDihumUNzm4Q7kNvwH3At6B&_nc_oc=AdrxgM_Pr2dOgC4LyWmF10CHdwSVBijt6s284V91ndiqfhXbmexMQU5S8hUo2XpI4VU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLEnBbD51PKrhbFs00emdoijpbO2F80ILJWB4ZVTHmRA&oe=6AF5E73F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mm.png", "id": "1407394331006569", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822818_1407394337673235_8604667818432831807_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmECQcgZMokQ7kNvwEekPUD&_nc_oc=AdpKzatq-MPxcMblU_pUAPdS2pckilWtiWtBAkf8R5UMhP65FijI602gWrK1Z3oSCNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPYKOyJk6Jr5MjBQm7otOBdrIN41UyGq6xAobj31E_iQ&oe=6AF5D01D"}, "display_name": "Monster Me: Kaiju Playground Simulator", "keywords": ["monster", "simulator", "sandbox", "kaiju", "openworld"], "long_description": "As Intern Monster #133458 at AHHH MONSTER LTD, you\u2019ll parachute into Crispy City\u2014a tiny town in the middle of the Pacific! Here, you\u2019ll take on the role of a young monster to start your demolition task and fight for a full-time spot!\n\n\n**\ud83c\udf06City-sized Open World\ud83c\udf06**\n{1728473058536197}\nWelcome to Crispy City \u2014  every inch of this place is your playground for wild, chaotic ideas! \n\n\n**\ud83e\udd96Giant Monster POV\ud83e\udd96**\n{1220554103362538}\nInstead of being a small animal, you now play with the city in a giant monster POV! Grab fleeing citizens to toss around, climbing up the skyscrapers like KONG!\n\n\n**\ud83d\udca5All You Can Destruct\ud83d\udca5**\n{1931792390738429}\nUnleash your rage in this city-sized physics sandbox \u2014 stomp on street cars to send them exploding, punch houses like toy blocks, and torch gas stations until they\u2019re reduced to ash!\n\n\n**\ud83d\udd28Insanely Destructive Weapons\ud83d\udd28**\n{753662344437688}\nWield a killer lineup of melee brawlers and ranged shooters! Flamethrower, Slingshot, Mj\u00f6lnir Hammer, you name it!\n\n\n**\ud83e\uddeaMonster Planet Technologies\ud83e\uddea**\n{1226651852721235}\nEarn more Monster Coins to unlock a variety of crazy prank tools exclusive from Monster Planet Technologies! Each has unique functionalities to experiment with!\n\n\n**\ud83d\udcf0Make The Headlines\ud83d\udcf0**\n{885527480797350}\n100+ wacky and funny mischief quests \u2014 You will get onto newspaper headlines and even television LIVE!\n\n\n**\ud83d\udcf7Chill Anytime Anywhere\ud83d\udcf7**\n{1614006186569196}\nTake a city walk, play with some fireworks, and chill with your airship buddy \u2014 Screaming Chicken and Chubby Butt in your monster-sized bed!\n\n\nTons of new gears, tasks and citizens added this Christmas! Will you rise to become the top monster at AHHH MONSTER LTD? Good luck!\n", "short_description": "As Intern Monster #133458 at AHHH MONSTER LTD, you\u2019ll parachute into Crispy City\u2014a tiny town in the middle of the Pacific! In order to fight for a full time position at the company, you\u2019ll climb to front-page fame and legendary status by unleashing total chaos to the city. Stack up Monster Coins to grab high-tech gadgets that supercharge your destructive power. You can even upgrade your skills and airship to unlock next-level gameplay modes. In Monster Me, the only limit is your imagination!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
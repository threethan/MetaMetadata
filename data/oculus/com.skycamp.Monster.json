8777_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEeV0INCwjQQ7kNvwGYGL2p&_nc_oc=Adq30_F1DKcSE1s3Q_L9KYXk3v9KXO0vb-39Fu5zjZRHy9hjfuDItPk6EcozC5Xf458&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9aycnBnQESxdj-Ky6oqRAhOmpOV73DRwRDWjS9vSYJg&oe=6AF5C33F"}, {"file_name": "\u622a\u5c4f2025-11-20 00.17.43.png", "id": "826725383296832", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619773_826725386630165_6388317777050178315_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81Ez6PmgEq0Q7kNvwH2WRx7&_nc_oc=AdrWDYuKb4SGQn1gEwfiv87FbsGxV-IqFpNwxTH5Lv5U3ry31bMqLYDmthOX27nPXD4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmo-lT0cAz4xsHkmFkz0BpOGOg--9Cfc9SC5YJED1w_g&oe=6AF5E5A2"}, {"file_name": "\u622a\u5c4f2025-11-20 00.19.49.png", "id": "1554111182524499", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_1554111185857832_6183532535659872038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kl4H14bD1ZkQ7kNvwEu9XcV&_nc_oc=Ado8O6RieHvrBLn_n28GgXsYttRHqIdlLvYokTqtngpMRQdXTW-R7ntqCEQQDA1biso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6aAtjfucwlT19fGZc-jbno1aVzNqj7QhWxzeiUjY3Ow&oe=6AF5C39B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440 (7).png", "id": "1351444416515433", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618064_1351444419848766_4152469622210404891_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6kBHZg7JIEQ7kNvwHLez8q&_nc_oc=Adp55giKzUDCWsfWiZOkyYUpN6QMMYTKd7XipLMxntBqdO0LKxtQ1VNKjZJxrzD9bQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDkZ_tE_nVaTJUrWVOa5fbjPnmk_WDW8vs5HhKz9vBmg&oe=6AF5F3B2"}, "display_name": "AHHHH MONSTER", "keywords": ["monster", "simulator", "sandbox", "kaiju", "funny"], "long_description": "As Intern Monster #133458 at AHHH MONSTER LTD, you\u2019ll parachute into Crunch Town\u2014a tiny city in the middle of the Pacific! Here, you\u2019ll take on the role of a young monster to start your demolition task, harvest human \"scream energy\" through destruction and mischief, and fight for a full-time spot!\n\n**Monster POV + All You Can Destruct**\n\n{817813327771954}\n\nPlay with the city in a giant monster POV! Stomp on street cars to blow them up, punch skyscrapers like they\u2019re building blocks, crash-land from an airship to smash the streets, and grab fleeing citizens with your giant paws to toss around\u2014live the satisfying thrill of doing whatever you want!\n\n**Wacky Quests + Open City Exploration**\n\n{1356887785907930}\n\nJump off from your small airship to complete daily wacky and funny mischief quests\u2014from destroying buildings and wrecking streets to pranking citizens and swapping landmarks. In this fully open and explorable Crunch Town filled with tons of interactables, every corner is a performing stage for your next viral clip!\n\n**Physics Sandbox + Insane Prank Props**\n\n{25930819446506074}\n\nEarn \"AHHH Coins\" to unlock a variety of crazy prank tools: a mighty Mj\u00f6lnir that can fly back, a giant slingshot that catapults citizens far away, a flame thrower that burns everything into ash, and a freeze blaster that ices over streets\u2014each prop delivers hilarious gameplay in this city-sized, true physics sandbox!\n\nWill you rise to become the top monster at AHHH MONSTER LTD?\n", "short_description": "As Intern Monster #133458 at AHHH MONSTER LTD, you\u2019ll parachute into Crunch Town\u2014a tiny city in the middle of the Pacific! Here, you\u2019ll take on the role of a young monster to start your demolition task, harvest human \"scream energy\" through destruction and mischief, and fight for a full-time spot!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/", "category": nul
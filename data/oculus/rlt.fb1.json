v/t64.5771-25/499619836_2676749812672663_1059684236567669956_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpG_iNykuR4Q7kNvwHzKA-V&_nc_oc=Adr2LFaKCpFD153FMFwu81xUaQDWCnFGErNB25OnPL3REeavX4jJ5ztIDrZhAPewyi8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFxYWRhLcIMDle83hFPU81Kidx8LT5fh6oP5Pv9FnaFQ&oe=6B083C61"}, {"file_name": "Frame (4).png", "id": "724986476773004", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618937_724986480106337_300947809516440288_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZZDp2yvPUkQ7kNvwGM1spQ&_nc_oc=Adpkmb-yEeO2tLjtj8JeU6kPKbPSpKf8wZ1jzuo2VP8_5Smjj0o9554oPO89EbTQ_Lk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHSyf_6eePucBq8ThlF-9qeRhnHNtstlMlMEulKHOfEg&oe=6B084F5B"}, {"file_name": "Frame (1).png", "id": "693831083514007", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618274_693831086847340_5067831640637937716_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYPJkvzbLr4Q7kNvwE-JTbF&_nc_oc=Adple8IUVVJndc81H4f2Tim3QNPSKQCysgDRcR6gmW0FRC0h0if0hb09v4iMgJ8Anjk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfMpN30bcajysgrJ2frr_9-x5ckQfqaFcBGVwktBB35w&oe=6B085628"}, {"file_name": "Frame (2).png", "id": "2050541855677718", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618069_2050541859011051_11379491950071561_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2VpuNzZV18Q7kNvwFFgavX&_nc_oc=AdpRPJFb-N_rCUsT_UepbTG_yTBRNI_ShoN67xKX0NJ2GJvkIlmFhFHnZgwmnGHiUqk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1Tvc35-Hswhg7VjE1-VqjdMdZZmxdz7OdrdunN0K5QQ&oe=6B08641D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AirVis", "keywords": ["gaussiansplat", "3d", "VR"], "long_description": "Experience the next generation of 3D capture with ultra-detailed, photorealistic rendering using the newly added Gaussian Splats technology.\n\n\nCreate in 3D Like Never Before \u2013 Right from Your phone\n\nWith AirVis, transforming the real world into stunning AR and 3D assets is easier than ever. Capture objects using any phone thanks to advanced Object Capture and Gaussian Splatting technology. Turn everyday items into detailed, immersive AR / VR content in just minutes.\n\n\nExplore & Discover\n\nBrowse an ever-growing library of 3D models and Gaussian Splats. Easily filter by tags, categories, styles, or creators to find exactly what you\u2019re looking for.\n\n\nShare Your Creations\n\nUpload your 3D models and showcase your talent. Build your portfolio, get feedback, and grow your following in a supportive creative community.\n\n\nConnect & Collaborate\n\nJoin a vibrant network of 3D artists and designers. Follow creators you admire, comment on their work, and spark new collaborations.\n\n\nMore Features You\u2019ll Love:\n\nFully customizable artist profiles\nSeamless integration with XR Devices\nReal-time Gaussian splat rendering for photorealistic visuals\nJoin the Next Generation of 3D Creation\n\nWhether you're a hobbyist or a professional, AirVis gives you the tools to create, explore, share, and connect \u2014 all from your pocket.", "short_description": "Share and Explore new dimensions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rocklandtechnologies.com/airvis", "developer_terms_of_service_url": "https://rocklandtechnologies.com/airvis", "publisher_name": "airvis", "support_website_url": null, "website_url": "https://rocklandtechnologies.com/airvis", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
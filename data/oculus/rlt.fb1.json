6sB_sW7Wd1Fzdq3-57SAPM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IzljGVaCvDtwQcHgAa9cDoGGlcP1OAXFpnFkbRNoJwA&oe=69D50EE1"}, {"file_name": "Frame (4).png", "id": "724986476773004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618937_724986480106337_300947809516440288_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WsgpLu7eYYQ7kNvwEmuh7P&_nc_oc=Adp6KP-h3bVNlO28468APznoALAB3JW9VO2nHQJDSjTxaQWyaK6mHvuCAGKOmBZFCmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2F0pWijf84aabyfackx0vFGtDtLds0iHuPVpqfxULVcQ&oe=69D4E99B"}, {"file_name": "Frame (1).png", "id": "693831083514007", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618274_693831086847340_5067831640637937716_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RE80o0Ha-EQ7kNvwHCJ3o0&_nc_oc=AdrYaCZkUWrd0Nl2Okt8dlyYAo_jl3TXikHswWy3U--VgIFVgzooApO6zTju4zt0liE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-BLQ5B0vHuS8GNM4S9g1Ik9F529NV-3NuS4C0kgK1Yw&oe=69D4F068"}, {"file_name": "Frame (2).png", "id": "2050541855677718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618069_2050541859011051_11379491950071561_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUITZo70F5EQ7kNvwHgh2Lt&_nc_oc=AdpTYCg8zXLjgsScDy_eHj7LadxqDKhBPq_t8kECOzn1jC5ROC_iCZFTHvZ_DG5j1z0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2H_4CaIbg0vc9SS4Pds6Dv8FctWg2V6-SCcHZAUl4AQQ&oe=69D4FE5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AirVis", "keywords": ["gaussiansplat", "3d", "VR"], "long_description": "Experience the next generation of 3D capture with ultra-detailed, photorealistic rendering using the newly added Gaussian Splats technology.\n\n\nCreate in 3D Like Never Before \u2013 Right from Your phone\n\nWith AirVis, transforming the real world into stunning AR and 3D assets is easier than ever. Capture objects using any phone thanks to advanced Object Capture and Gaussian Splatting technology. Turn everyday items into detailed, immersive AR / VR content in just minutes.\n\n\nExplore & Discover\n\nBrowse an ever-growing library of 3D models and Gaussian Splats. Easily filter by tags, categories, styles, or creators to find exactly what you\u2019re looking for.\n\n\nShare Your Creations\n\nUpload your 3D models and showcase your talent. Build your portfolio, get feedback, and grow your following in a supportive creative community.\n\n\nConnect & Collaborate\n\nJoin a vibrant network of 3D artists and designers. Follow creators you admire, comment on their work, and spark new collaborations.\n\n\nMore Features You\u2019ll Love:\n\nFully customizable artist profiles\nSeamless integration with XR Devices\nReal-time Gaussian splat rendering for photorealistic visuals\nJoin the Next Generation of 3D Creation\n\nWhether you're a hobbyist or a professional, AirVis gives you the tools to create, explore, share, and connect \u2014 all from your pocket.", "short_description": "Share and Explore new dimensions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rocklandtechnologies.com/airvis", "developer_terms_of_service_url": "https://rocklandtechnologies.com/airvis", "publisher_name": "airvis", "support_website_url": null, "website_url": "https://rocklandtechnologies.com/airvis", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_
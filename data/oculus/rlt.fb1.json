v/t64.5771-25/499619836_2676749812672663_1059684236567669956_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07h1LWPxhNsQ7kNvwGr1e4Y&_nc_oc=AdobDFc1TdPCm1yPSod9yMtepkjmSpwwMt4-dH53AdvSnTAypMQZ1IktUzJcIGQhpHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXuNz5CRIHoHJ3J5-uL4FrTWUE3XzEEJHwWtP_CAHmDVA&oe=6B105DA1"}, {"file_name": "Frame (4).png", "id": "724986476773004", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618937_724986480106337_300947809516440288_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRTso9SBv2sQ7kNvwEWvug_&_nc_oc=AdoUU8BtlS9AycLy5VgfGkclWUNqVH3xFTk8pFvveYn-cLOoESwyTAd7I5manKkqiKw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWd-lO_wJYYnJUXcc-WDNkT34JbuAFJ3s3kv2WmBWysxw&oe=6B10385B"}, {"file_name": "Frame (1).png", "id": "693831083514007", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_693831086847340_5067831640637937716_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFInKCpOgZwQ7kNvwGw-O_m&_nc_oc=AdqPmy2dWCuRIJQMYkYKFKEcyIzVk83Ipwm-tnTg4tpePhrzICCDE2MzxldUDllxiBg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVntIZcidL8UOWiJ5xh7Yl-8SRZnS-0Tis6DPObNikk-g&oe=6B103F28"}, {"file_name": "Frame (2).png", "id": "2050541855677718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618069_2050541859011051_11379491950071561_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rIwT8xYACkQ7kNvwFxUkGb&_nc_oc=AdoWJhe9oFVsp29HXyIQp9cn_Y6o7gJrrq4-kAp3fBeb1pwvB5qdtAPFS5w-D_GOI7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9mOwsh6jUu8KuAwYAnd0uHNm-Ltjy48OORv6qMAcg5Q&oe=6B104D1D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AirVis", "keywords": ["gaussiansplat", "3d", "VR"], "long_description": "Experience the next generation of 3D capture with ultra-detailed, photorealistic rendering using the newly added Gaussian Splats technology.\n\n\nCreate in 3D Like Never Before \u2013 Right from Your phone\n\nWith AirVis, transforming the real world into stunning AR and 3D assets is easier than ever. Capture objects using any phone thanks to advanced Object Capture and Gaussian Splatting technology. Turn everyday items into detailed, immersive AR / VR content in just minutes.\n\n\nExplore & Discover\n\nBrowse an ever-growing library of 3D models and Gaussian Splats. Easily filter by tags, categories, styles, or creators to find exactly what you\u2019re looking for.\n\n\nShare Your Creations\n\nUpload your 3D models and showcase your talent. Build your portfolio, get feedback, and grow your following in a supportive creative community.\n\n\nConnect & Collaborate\n\nJoin a vibrant network of 3D artists and designers. Follow creators you admire, comment on their work, and spark new collaborations.\n\n\nMore Features You\u2019ll Love:\n\nFully customizable artist profiles\nSeamless integration with XR Devices\nReal-time Gaussian splat rendering for photorealistic visuals\nJoin the Next Generation of 3D Creation\n\nWhether you're a hobbyist or a professional, AirVis gives you the tools to create, explore, share, and connect \u2014 all from your pocket.", "short_description": "Share and Explore new dimensions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rocklandtechnologies.com/airvis", "developer_terms_of_service_url": "https://rocklandtechnologies.com/airvis", "publisher_name": "airvis", "support_website_url": null, "website_url": "https://rocklandtechnologies.com/airvis", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphi
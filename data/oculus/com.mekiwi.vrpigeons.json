GUo5kRVYPEUL5P69paDWXqqJezhDaijsdnBNgtA&oe=6A8310A9"}, {"file_name": "shot 0015.png", "id": "440879667172126", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982584_440879670505459_5606495520519872624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4U9L3xMk2IQ7kNvwE0DC9p&_nc_oc=AdpdQrB2rJ5jT5N03XoaoRxx6TAHZPSCw_pFUBSD2yy4SJ4SEBdItQ13lXLO92N6gOg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElEq46UOMBtb8dvf9o2hvCge4PfUIq3BAnY25iRo0RPg&oe=6A83086F"}, {"file_name": "shot 0025.png", "id": "160260029196243", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982720_160260032529576_4963456793867992308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RHrNG7BQVwQ7kNvwG2l3_z&_nc_oc=Adoxyz-cM6Uu1wP6nSgzQ7X4dTlIa9aL6TTS-7xTXMmPn3-c-bDr4kNdVSGcl8taZfg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTcWrklSVYFAwPo1m8CEn1lK8UchADL81XEerNPS4gYA&oe=6A82F30C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "853816492160058", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003248_853816495493391_1038613569093630295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfRFjTXCDDUQ7kNvwH-8WKk&_nc_oc=AdrsLD5i3WYOSSKo5SUMpom9xERLkT2oHKPeknu-fRthHW-yLmaC8cfieGTF2GtpWGg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS-dmBhbieBUo21XukNdw2Y5xD2rxJ2R5fxBQqTwZC5w&oe=6A83138E"}, "display_name": "VR Pigeons", "keywords": ["silly", "weird", "party", "pigeons", "family"], "long_description": "Bob your head like a pigeon to use the unique movement controls to slip into your pigeon-self!\n\nAll the world\u2019s a rooftop, and all the men and women merely pigeons. \n\nUse the power of VR and absolutely unique movement controls to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the granny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!\n\n\nHow to become the ultimate VR Pigeon:\n\n\u2022 Channel to your inner Pigeon. Bob your head like a pigeon in order to move around and interact with your world\n\u2022 Unlock and discover four different levels\n\u2022 Protect your bread from other pigeons\n\u2022 Use power-ups and map shortcuts to be faster than other pigeons\n\u2022 Your pigeon enemies come in different shapes, avoid unnecessary conflicts!", "short_description": "Bob your head like a pigeon to use the unique movement controls to slip into your pigeon-self!"}]}, "developer_name": "Maestro Pivetta / Studio Seufz", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VRKiwi (MeKiwi)", "support_website_url": null, "website_url": "https://vrkiwi.org/portfolio/vr-pigeons/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8686874058044401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974693_462721473297291_583541181875223647_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1qG9qAXEYEQ7kNvwEzJIMB&_nc_oc=AdoE6I5tLxcm05Y4QJ-F-KrLBBbVuL42c_LruP-6iV7fM4FaJ9pkMWg3GmbrTuK2rok&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH14rWDGqCHc0BHdFK6NXQj9hu-TB8eM5-BayvbzPSmpA&oe=6A831164"}, "is_concept": false, "is_te
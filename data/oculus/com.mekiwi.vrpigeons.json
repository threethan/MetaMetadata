dn.com/v/t64.5771-25/38982720_160260032529576_4963456793867992308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uM68fQjbtawQ7kNvwEI9Fv-&_nc_oc=AdqIJTGq6rOSFggyIj8i-jqwMS5N6VRTLGBGNu9YXvTn_mAIok3Ql_o_ALQg5nxLdgc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43OjvkMA_S4sPM2qVEVleNkNZqMmKdoV6mn47Mao6ASg&oe=6A19B34C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "853816492160058", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003248_853816495493391_1038613569093630295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oON-UYI6JAQ7kNvwGH41iQ&_nc_oc=Ado8NKrJyPVOvCK9DmwC9RZOi52_QLqjr1B26qAhlSXRnTZGdOdN0lbEQdsJcU_2sm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GIA31BM9FkpXqbSSaAUcWjZNw8FwoLimSlOhKkBl5Xw&oe=6A199B8E"}, "display_name": "VR Pigeons", "keywords": [], "long_description": "All the world\u2019s a rooftop, and all the men and women merely pigeons. \n\nUse the power of VR and absolutely unique movement controls to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the granny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!\n\n\nHow to become the ultimate VR Pigeon:\n\n\u2022 Channel to your inner Pigeon. Bob your head like a pigeon in order to move around and interact with your world\n\u2022 Unlock and discover four different levels\n\u2022 Protect your bread from other pigeons\n\u2022 Use power-ups and map shortcuts to be faster than other pigeons\n\u2022 Your pigeon enemies come in different shapes, avoid unnecessary conflicts!", "short_description": "All the world\u2019s a rooftop, and all the men and women merely pigeons. \n\nUse the power of VR and absolutely unique movement controls to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the granny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!"}]}, "developer_name": "Maestro Pivetta", "developer_privacy_pol
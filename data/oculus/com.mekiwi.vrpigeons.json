5ZPantlvebDWeLfsKZAc4_KVM-PLQhLAl4wiLjQ&oe=69D267A9"}, {"file_name": "shot 0015.png", "id": "440879667172126", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982584_440879670505459_5606495520519872624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeYBAJS-YqoQ7kNvwFFLXQk&_nc_oc=AdpMuYICBvXj-eZbN4HKjzVp1HgDEeYtCQfUqUs3rfyh80ZSPYkY1VbFDWhYmMSWRfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YhUZK3OfBkw14z4Alfeo71M2uob-LsMHH73S2weY-1Q&oe=69D25F6F"}, {"file_name": "shot 0025.png", "id": "160260029196243", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982720_160260032529576_4963456793867992308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaJLoCA5szAQ7kNvwHRLK1W&_nc_oc=Adp6wXcVArXHiYjbsjwBlnJZpt_7jU1yG6Yke41WE-wAgIvO2hADidCyRAlsCqKcEZw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YodchiW1XiLcqGUBqFk18aAYLff3TBW2Wu2IX0gKOyA&oe=69D24A0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "853816492160058", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003248_853816495493391_1038613569093630295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02eq5FBSWvUQ7kNvwFOKlcI&_nc_oc=AdoPaXSWTVcAX4OvpALYQvV9MD-3NLM6vf2EwgGm2hJERA-eHtVI_3q8MAXzsmGP_8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EGQUGPPhySek-lHuQdva-WoFI02plT_lPhd93Ia-X7g&oe=69D26A8E"}, "display_name": "VR Pigeons", "keywords": ["silly", "weird", "party", "pigeons", "family"], "long_description": "Bob your head like a pigeon to use the unique movement controls to slip into your pigeon-self!\n\nAll the world\u2019s a rooftop, and all the men and women merely pigeons. \n\nUse the power of VR and absolutely unique movement controls to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the granny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!\n\n\nHow to become the ultimate VR Pigeon:\n\n\u2022 Channel to your inner Pigeon. Bob your head like a pigeon in order to move around and interact with your world\n\u2022 Unlock and discover four different levels\n\u2022 Protect your bread from other pigeons\n\u2022 Use power-ups and map shortcuts to be faster than other pigeons\n\u2022 Your pigeon enemies come in different shapes, avoid unnecessary conflicts!", "short_description": "Bob your head like a pigeon to use the unique movement controls to slip into your pigeon-self!"}]}, "developer_name": "Maestro Pivetta / Studio Seufz", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VRKiwi (MeKiwi)", "support_website_url": null, "website_url": "https://vrkiwi.org/portfolio/vr-pigeons/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8686874058044401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974693_462721473297291_583541181875223647_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUOrLkeR0QAQ7kNvwFS_56l&_nc_oc=AdrZuf6LUVU5PSq0XazXUXUHTvgBbqtQE9nfb4w-dcH7aO024rWqzXcb0cdtnYdp7Z4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FLfdlVyaTtvABs0uPA04Hl9xhbEdh6g-spKax34SvLw&oe=69D26864"}, "is_concept": false, "is_te
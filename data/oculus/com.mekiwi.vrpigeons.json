85rZyLvbchdpXe6wHagEkdBnUJrZDSUWVxUqMRg&oe=6AEC88A9"}, {"file_name": "shot 0015.png", "id": "440879667172126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982584_440879670505459_5606495520519872624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfv9anD8LIMQ7kNvwETB2Ip&_nc_oc=Adr9rwo6xgOCet4mrI2oeb8VcrkQDFJ6pLll_UseE9K1zUCc2xvJkdDnZxtZQRUYI2s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjLpp4pzhpBnbHCy7VUdd9EV674NCFlhVDQxiLWZWEjQ&oe=6AECB8AF"}, {"file_name": "shot 0025.png", "id": "160260029196243", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982720_160260032529576_4963456793867992308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmTGZnHmyGwQ7kNvwEWoYHy&_nc_oc=AdoGvKCTi_j6g-7rkQ-yVa5QvHYNt2x7RmhmyrQLYOlolbhA6IraMIydN58awhF5huw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA8lR9m4xSpQiuBqiaEEye7DitwVV22t-N6MdX-aZbtA&oe=6AECA34C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "853816492160058", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003248_853816495493391_1038613569093630295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9VrmB7N2eoQ7kNvwGpqaY3&_nc_oc=AdqUnXhEi961lTQ9h_-5wq5GIp1TH_1Nsb-yA8FrGENPD0JPpFy7PyF0zWHW5F0WgeY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-9yY7Gkx5BKg9UE0TvNbf5lWr-w2QOSpwkY3wNGXkTQ&oe=6AEC8B8E"}, "display_name": "VR Pigeons", "keywords": ["silly", "weird", "party", "pigeons", "family"], "long_description": "Bob your head like a pigeon to use the unique movement controls to slip into your pigeon-self!\n\nAll the world\u2019s a rooftop, and all the men and women merely pigeons. \n\nUse the power of VR and absolutely unique movement controls to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the granny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!\n\n\nHow to become the ultimate VR Pigeon:\n\n\u2022 Channel to your inner Pigeon. Bob your head like a pigeon in order to move around and interact with your world\n\u2022 Unlock and discover four different levels\n\u2022 Protect your bread from other pigeons\n\u2022 Use power-ups and map shortcuts to be faster than other pigeons\n\u2022 Your pigeon enemies come in different shapes, avoid unnecessary conflicts!", "short_description": "Bob your head like a pigeon to use the unique movement controls to slip into your pigeon-self!"}]}, "developer_name": "Maestro Pivetta / Studio Seufz", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VRKiwi (MeKiwi)", "support_website_url": null, "website_url": "https://vrkiwi.org/portfolio/vr-pigeons/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8686874058044401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974693_462721473297291_583541181875223647_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HljYTPTwsyYQ7kNvwFJ3Nab&_nc_oc=AdrOTwwbqmKOw_Hphb2MUUzU0eIqLKC6Mg51t1k68cYHC8qOjGI4w4Y-l3YFSCOv7Qw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY7E7b73_oVs7ARCXxCtV8MU_F0G1gQLBLCBdK07xjvw&oe=6AEC8964"}, "is_concept": false, "is_te
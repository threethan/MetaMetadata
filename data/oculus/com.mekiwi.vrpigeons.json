30YlkS8a2ahbft4cFo1VgJVh6rjjUxjMsNUq7sA&oe=6A3BDFA9"}, {"file_name": "shot 0015.png", "id": "440879667172126", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982584_440879670505459_5606495520519872624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQ49OQf74okQ7kNvwH5D32E&_nc_oc=Adovqr5RiyLlwYIn1nRK1DphiLPQBTpc00HujReMNm_PulilwT7aJnBP4GecrYbrllM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-inlAJbLWUMOEfcf3bNqCnYQaAU8WMvAeBQkiQAVygaA&oe=6A3BD76F"}, {"file_name": "shot 0025.png", "id": "160260029196243", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982720_160260032529576_4963456793867992308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8yzX4aNHdwQ7kNvwHcgoJy&_nc_oc=Adp90UNK9miYAvQVoyM3YsG4ZTCu1sqooVpnqFDxrXdxZuHzIB1BtT3s_70z5FqE8R8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xYH6uCZujUap6fvpTT79yQIZbZXAQxlplfQzjVEULAw&oe=6A3BFA4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "853816492160058", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003248_853816495493391_1038613569093630295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SSlDbG2DtcQ7kNvwEMIjJE&_nc_oc=Adrj-w4BKjPQB4Hol8KZLxW8NFMMOoOmI0iD5DxtK68O10GcBBqezWXt56GrRdgu2p8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s1B2Apu8gqfN-Y3YY_ZqQf9XQ1lTw_nn8Q_TtbxcHRw&oe=6A3BE28E"}, "display_name": "VR Pigeons", "keywords": ["silly", "weird", "party", "pigeons", "family"], "long_description": "Bob your head like a pigeon to use the unique movement controls to slip into your pigeon-self!\n\nAll the world\u2019s a rooftop, and all the men and women merely pigeons. \n\nUse the power of VR and absolutely unique movement controls to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the granny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!\n\n\nHow to become the ultimate VR Pigeon:\n\n\u2022 Channel to your inner Pigeon. Bob your head like a pigeon in order to move around and interact with your world\n\u2022 Unlock and discover four different levels\n\u2022 Protect your bread from other pigeons\n\u2022 Use power-ups and map shortcuts to be faster than other pigeons\n\u2022 Your pigeon enemies come in different shapes, avoid unnecessary conflicts!", "short_description": "Bob your head like a pigeon to use the unique movement controls to slip into your pigeon-self!"}]}, "developer_name": "Maestro Pivetta / Studio Seufz", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VRKiwi (MeKiwi)", "support_website_url": null, "website_url": "https://vrkiwi.org/portfolio/vr-pigeons/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8686874058044401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974693_462721473297291_583541181875223647_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTRTlr_gqQAQ7kNvwHmnAkU&_nc_oc=AdoFR79AQkTaYo0JzwJCJTRtOxP8R2zg7amJLnsG6cj0bflJOr152v_BfK6txGNMr3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DfH-0_1GXRJH1I70j9yIsttHGDbt-1mujn9yFV9to1Q&oe=6A3BE064"}, "is_concept": false, "is_te
dn.com/v/t64.5771-25/38982720_160260032529576_4963456793867992308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C73TjQCaIVAQ7kNvwEONsBG&_nc_oc=Adq7nLYE2_0UaCEf0q3vrt8JlCq9cgCf-aKikuGnfu17r7N1IVCcUbhcVBTJA9C_kfM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL9oTSIZoWUMk6vnVhvcQcnUjZs20Js-vgbVtjZlPkWA&oe=6A5B660C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "853816492160058", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003248_853816495493391_1038613569093630295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZUhi2ufbWoQ7kNvwH666hy&_nc_oc=Adqj6eLWYyvxrB3_kC724sctp_XdZzO5xH1IfhR55XN8SW51HUdgPDnPgE16oP7WRjI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKDiDeHebLgtjEs8Fb47KytDJZo9OMzU8L93wTmau0_Q&oe=6A5B868E"}, "display_name": "VR Pigeons", "keywords": [], "long_description": "All the world\u2019s a rooftop, and all the men and women merely pigeons. \n\nUse the power of VR and absolutely unique movement controls to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the granny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!\n\n\nHow to become the ultimate VR Pigeon:\n\n\u2022 Channel to your inner Pigeon. Bob your head like a pigeon in order to move around and interact with your world\n\u2022 Unlock and discover four different levels\n\u2022 Protect your bread from other pigeons\n\u2022 Use power-ups and map shortcuts to be faster than other pigeons\n\u2022 Your pigeon enemies come in different shapes, avoid unnecessary conflicts!", "short_description": "All the world\u2019s a rooftop, and all the men and women merely pigeons. \n\nUse the power of VR and absolutely unique movement controls to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the granny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!"}]}, "developer_name": "Maestro Pivetta", "developer_privacy_pol
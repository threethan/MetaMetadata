rjuPp7W63G69nQHIGvm_a2ZIWUvjs8OMinDhBNw&oe=6AE89429"}, {"file_name": "shot 0015.png", "id": "440879667172126", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982584_440879670505459_5606495520519872624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xh9I6HVPb1QQ7kNvwGcGUpn&_nc_oc=Adpjnvc5tsUi7a8cR7lGZO06w8GUBnKADzqiE4ztpf1fEDB3nsCGQ5AaN28UKK0yics&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvy_0ijl5UFvfHjjfMDN8FqzFXTLFedOgo6S2jgkkGkw&oe=6AE8C42F"}, {"file_name": "shot 0025.png", "id": "160260029196243", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982720_160260032529576_4963456793867992308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZe88Gn77WQQ7kNvwFLsHX1&_nc_oc=AdqehghQ8sy_Rf9OP39GCVGqAs9IAa0OnzkHUS5nlr8JH3cH3SM-xhZr6mHQn1r81Zs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZvxtlhJbfmmqREq0czzGtelUVAEWAdHyvLKM5JFBByQ&oe=6AE8AECC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "853816492160058", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003248_853816495493391_1038613569093630295_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyF8ZIn9sbAQ7kNvwFzLQy2&_nc_oc=Ado7LZchKs5pkKu197N8ynRycCgTU-wtDVu1a7mhC7AxKOchPmAeYiVlinccucItarQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlz1XwYigTdTZq7FEbM8nBWuxIkWOBpyHVvkIrBEcKlA&oe=6AE8970E"}, "display_name": "VR Pigeons", "keywords": ["silly", "weird", "party", "pigeons", "family"], "long_description": "Bob your head like a pigeon to use the unique movement controls to slip into your pigeon-self!\n\nAll the world\u2019s a rooftop, and all the men and women merely pigeons. \n\nUse the power of VR and absolutely unique movement controls to slip into your pigeon-self!\nGo out into the world and find a rooftop. Wait for the granny to throw some bread. Eat as much bread as possible! BREAD IS LIFE!\n\n\nHow to become the ultimate VR Pigeon:\n\n\u2022 Channel to your inner Pigeon. Bob your head like a pigeon in order to move around and interact with your world\n\u2022 Unlock and discover four different levels\n\u2022 Protect your bread from other pigeons\n\u2022 Use power-ups and map shortcuts to be faster than other pigeons\n\u2022 Your pigeon enemies come in different shapes, avoid unnecessary conflicts!", "short_description": "Bob your head like a pigeon to use the unique movement controls to slip into your pigeon-self!"}]}, "developer_name": "Maestro Pivetta / Studio Seufz", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VRKiwi (MeKiwi)", "support_website_url": null, "website_url": "https://vrkiwi.org/portfolio/vr-pigeons/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8686874058044401"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974693_462721473297291_583541181875223647_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_joU8IDEt8Q7kNvwHZm1QG&_nc_oc=Adqi43WQZImDbzDb96pJDarsKLbW1yGtmRbUeeNnTsxccEUqLXVhrWMCfBhb605J_hI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQah54NH3OjUzyz5RX23AAmgYRNmzEr0mEPjw14AX16Tw&oe=6AE894E4"}, "is_concept": false, "is_te
id=6e7a0a&_nc_ohc=06HMTlCi0l4Q7kNvwFf7S3b&_nc_oc=AdqpElmF_U_RQ77wJ4CEIj_IOHXfFkvgAXPfJWSglrbvpX8Jl8Lgtv93SBMcvmCPc40&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpL01RAPE4IyJWi2XPy8Fxg8t53ox0TwmCDyV-yPsyvg&oe=6AAE7FC2"}, "display_name": "Plantopia", "keywords": ["Game", "Grow", "Hangout", "Plant", "Plantopia"], "long_description": "Welcome to Plantopia, a peaceful and immersive VR experience where nature is in your hands.\n\nStep into a vibrant world where you can plant seeds, grow crops, and shape your own living environment. Every plant grows in real time, reacting to your care as you water, harvest, and expand your garden. Explore colorful landscapes, unlock new areas, and enjoy a calm, rewarding gameplay loop designed to help you relax and unwind.\n\nBuilt specifically for VR, Plantopia offers intuitive interactions, smooth movement, and a cozy atmosphere that makes you feel truly connected to the world around you. Whether you\u2019re tending to your garden, discovering new plants, or simply enjoying the scenery, Plantopia is the perfect escape into a growing world of creativity and calm.\n\nGrow at your own pace. Explore freely. Relax naturally.", "short_description": "Plantopia is a cozy VR world where you grow, explore, and bring nature to life. Plant seeds, watch your garden flourish, and relax in a vibrant, living environment built for immersive VR."}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://sites.google.com/view/plantopiapolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Pulser Games", "support_website_url": null, "website_url": "https://sites.google.com/view/plantopiapolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "528142316460358"}], "external_s
-iad3-2.oculuscdn.com&oh=00_Aft79-fj2iDSdC2dtpLWIg6niCKSAOmltWcHgy9FYvJlhw&oe=6999A43D"}, {"file_name": "Adobe Express - file (41).png", "id": "750664277650877", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821230_750664280984210_6110809953034321283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TwiZvKD2zUQ7kNvwH2LDY4&_nc_oc=Adm5Yr5zbYfPGSxcaBP-3wSZD2LMqjXn6O-8KnzyAwczis--T7kZ1w9nCGtehrkHCzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftfHt_MRb4SicX5NqpNkencdHgA169U0VSuKtG5OkP4WQ&oe=6999AD4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Adobe Express - file (33).png", "id": "4287474738238362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825009_4287474741571695_2412228842893516483_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rwkt_6Sqt38Q7kNvwE1_VBk&_nc_oc=Admepkr-Mg1hmOS5cwoq4maw4ERyJa463u1S_K9gRVkEbtljT-vI2o5jiU0D7FhIcgE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsYIr_oZy5te28i5-JrPQkmmgqKqJAXDNu5pi_luSVzbA&oe=6999A7AB"}, "display_name": "Plantopia", "keywords": ["grow", "game", "vr", "fun", "adventure"], "long_description": "Welcome to Plantopia, a peaceful and immersive VR experience where gardening meets discovery and friendly competition.\n\nPlantopia drops you into a vibrant world full of potential\u2014start with simple seeds, water and care for them, and watch them grow into colorful, exotic plants. But the real magic? Every seed has a chance to become a Big Seed\u2014a rare, massive plant that\u2019s perfect for showing off to your friends!\n\nCustomize your garden, trade seeds, and explore other players\u2019 creations. Whether you're growing for beauty, bragging rights, or just the chill vibes, Plantopia is your relaxing yet exciting garden getaway in VR.\n\n\ud83c\udf3c Collect. Grow. Show off.\nAre you ready to plant your legacy?", "short_description": "Grow your garden, grow your pride! In Plantopia, collect seeds, nurture unique plants, and hope to sprout a rare Big 
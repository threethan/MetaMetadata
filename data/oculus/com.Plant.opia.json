UTSp8vLiyqE74M_7tK-UMN-MhDSsMorlE90liHJXpZsvmzvBYhk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3K1qDPyZZAGRm2U41xlJEaceJ0FWPQZX1N86KWbK23sQ&oe=69F0A73D"}, {"file_name": "Adobe Express - file (41).png", "id": "750664277650877", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821230_750664280984210_6110809953034321283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSV2X6pZSD8Q7kNvwFqesMw&_nc_oc=AdqgLybdL1_Cc2pAG-c_c_UXCffUT-918VUhPiYRwjA2c9H1j9ZdXjGr1chJDvP5Xps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1zkJ9sOmFVkwpcmT2bWH_7Pqx_wq0nIhHW4_ijZi5LPg&oe=69F0B04F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Adobe Express - file (33).png", "id": "4287474738238362", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825009_4287474741571695_2412228842893516483_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUH9rliQqvgQ7kNvwFOKXfF&_nc_oc=AdpCrFh-pSbcnUG34mW6m6SDjw9iTDcs2le7mrFS6SXF011yKkQP-NaoYzmaLJlDxWs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1MfLjM1K_T4_rFUML1OWOaflz4u6tmuDHzYTEeJki2WQ&oe=69F0AAAB"}, "display_name": "Plantopia", "keywords": ["grow", "game", "vr", "fun", "adventure"], "long_description": "Welcome to Plantopia, a peaceful and immersive VR experience where gardening meets discovery and friendly competition.\n\nPlantopia drops you into a vibrant world full of potential\u2014start with simple seeds, water and care for them, and watch them grow into colorful, exotic plants. But the real magic? Every seed has a chance to become a Big Seed\u2014a rare, massive plant that\u2019s perfect for showing off to your friends!\n\nCustomize your garden, trade seeds, and explore other players\u2019 creations. Whether you're growing for beauty, bragging rights, or just the chill vibes, Plantopia is your relaxing yet exciting garden getaway in VR.\n\n\ud83c\udf3c Collect. Grow. Show off.\nAre you ready to plant your legacy?", "short_description": "Grow your garden, grow your pride! In Plantopia, collect seeds, nurture unique plants, and hope to sprout a rare Big Seed to show off to your friends in an immersive social VR world."}]}, "developer_name": "Zuse", "developer_privacy_policy_url": "https://sites.google.com/view/plantopiavr/home", "developer_terms_of_service_url": null, "publisher_name": "Plantopia", "support_website_url": null, "website_url": "https://sites.google.com/view/plantopiavr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24195274803418547"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1604042993832582"}, {"status": "PUBLISHED", "id": "1655102865198311"}]}, "baseline_offer": {"id": "1604042993832582"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771735500, "status": "PUBLISHED", "id": "1604042993832582"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25903523869260290", "version": "22.6"}, "id": "1085191409771308", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24181538178125543", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "259035238692602
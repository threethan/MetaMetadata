0B253E"}, {"file_name": "Adobe Express - file (40).png", "id": "1405557813858399", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824534_1405557817191732_7183077162532511097_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyrKo6sOJs8Q7kNvwEDvuBl&_nc_oc=Adotfh7-X0NIy_eSEQNUyDIhu3we-QLBQKDaq7OdBUU0LRf0o-xzR9ggi5ytGGLcKyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60nMY7Cvb4C0e0HBYsn5H2fELC7Q3NaFQCAQ9DP61U0Q&oe=6A0B053D"}, {"file_name": "Adobe Express - file (41).png", "id": "750664277650877", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821230_750664280984210_6110809953034321283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0Uc1q9oWeYQ7kNvwEC22on&_nc_oc=Adp6LWvV8_93_39r_B4hx0TPQv74gChmjN0JntNXtJ40eXI7MmjKAFeheE5MAvlVtLY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XMfqjI-Tw3uNbKJOXD6BvohBNH4A7asi6ihV7zKtHdw&oe=6A0B0E4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Adobe Express - file (33).png", "id": "4287474738238362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825009_4287474741571695_2412228842893516483_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diY7d4xC3S0Q7kNvwG2Qy68&_nc_oc=AdpbaWExUwxRgnSiWZFkfAIWPVN2naADHvmDdad3wIk763QzZ1nSrOkaI27VaJgbgIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TgYq26iqySydar9gbSTrloOdqv5lvUrYYv-PhEaOnjg&oe=6A0B08AB"}, "display_name": "Plantopia", "keywords": ["grow", "game", "vr", "fun", "adventure"], "long_description": "Welcome to Plantopia, a peaceful and immersive VR experience where gardening meets discovery and friendly competition.\n\nPlantopia drops you into a vibrant world full of potential\u2014start with simple seeds, water and care for them, and watch them grow into colorful, exotic plants. But the real magic? Every seed has a chance to become a Big Seed\u2014a rare, massive plant that\u2019s perfect for showing off to your friends!\n\nCustomize your garden, trade seeds, and explore other players\u2019 creations. Whether you're growing for beauty, bragging rights, or just the chill vibes, Plantopia is your relaxing yet exciting garden getaway in VR.\n\n\ud83c\udf3c Collect. Grow. Show off.\nAre you ready to plant your legacy?", "short_description": "Grow your garden, grow your pride! In Plantopia, collect seeds, nurture unique plants, and hope to sprout a rare Big Seed to show off to your friends in an immersive social VR world."}]}, "developer_name": "Zuse", "developer_privacy_policy_url": "https://sites.google.com/view/plantopiavr/home", "developer_terms_of_service_url": null, "publisher_name": "Plantopia", "support_website_url": null, "website_url": "https://sites.google.com/view/plantopiavr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24195274803418547"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1604042993832582"}, {"status": "PUBLISHED", "id": "1655102865198311"}]}, "baseline_offer": {"id": "1604042993832582"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771735500, "status": "PUBLISHED", "id": "1604042993832582"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25903523869260290", "version": "22.6"}, "id": "1085191409771308", "channel_name
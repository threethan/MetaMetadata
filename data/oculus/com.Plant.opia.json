e=6AFB1BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "43983.webp2zjl1780096709 (1).png", "id": "1819883999422376", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312338_1819884002755709_5969091619703365599_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4PODXI-5pIQ7kNvwFbVmqG&_nc_oc=Adrxqao_uUZp8iDpbCk2AuWjIuowF2c6eFbV9-xjycD6bo-_YMOG3LaV4j85_NliTsI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWh4iofn1qE70cxmAJoQjIPeJDr4uImh42MtWP5yAJ_g&oe=6AFB2F02"}, "display_name": "Plantopia", "keywords": ["Game", "Grow", "Hangout", "Plant", "Plantopia"], "long_description": "Welcome to Plantopia, a peaceful and immersive VR experience where nature is in your hands.\n\nStep into a vibrant world where you can plant seeds, grow crops, and shape your own living environment. Every plant grows in real time, reacting to your care as you water, harvest, and expand your garden. Explore colorful landscapes, unlock new areas, and enjoy a calm, rewarding gameplay loop designed to help you relax and unwind.\n\nBuilt specifically for VR, Plantopia offers intuitive interactions, smooth movement, and a cozy atmosphere that makes you feel truly connected to the world around you. Whether you\u2019re tending to your garden, discovering new plants, or simply enjoying the scenery, Plantopia is the perfect escape into a growing world of creativity and calm.\n\nGrow at your own pace. Explore freely. Relax naturally.", "short_description": "Plantopia is a cozy VR world where you grow, explore, and bring nature to life. Plant seeds, watch your garden flourish, and relax in a vibrant, living environment built for immersive VR."}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://sites.google.com/view/plantopiapolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Pulser Games", "support_website_url": null, "website_url": "https://sites.google.com/view/plantopiapolicy/h
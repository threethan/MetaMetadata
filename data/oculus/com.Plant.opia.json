-ord5-2.oculuscdn.com&oh=00_AfsfwoRRX87AW1JFdKs8DrYiAbxMJBNrL-ggKYCC2b7gDg&oe=699AF5BD"}, {"file_name": "Adobe Express - file (41).png", "id": "750664277650877", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821230_750664280984210_6110809953034321283_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TwiZvKD2zUQ7kNvwEVMrzs&_nc_oc=AdlaLjtnkpErxwoXWMdhygqyXvVGkVeCrGBCXiYeyI2itfhCdszJN2vcO7twVkqdPAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftRHnQ9eKmdT_bFa-pNo4cPEOiS_ncUICxHu8DEv7MZbg&oe=699AFECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Adobe Express - file (33).png", "id": "4287474738238362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825009_4287474741571695_2412228842893516483_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rwkt_6Sqt38Q7kNvwGhfoMx&_nc_oc=AdkQtg0P2Rs4JyMHLHdVBL5PJG4hkQZXF9pzZI7uevCeRvYuZ2BiwOI9ftbisrijYzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs1yzP-tItdWkbpaWY-f_tP8P9YZT5tzd0P3PFWpYu47A&oe=699AF92B"}, "display_name": "Plantopia", "keywords": ["grow", "game", "vr", "fun", "adventure"], "long_description": "Welcome to Plantopia, a peaceful and immersive VR experience where gardening meets discovery and friendly competition.\n\nPlantopia drops you into a vibrant world full of potential\u2014start with simple seeds, water and care for them, and watch them grow into colorful, exotic plants. But the real magic? Every seed has a chance to become a Big Seed\u2014a rare, massive plant that\u2019s perfect for showing off to your friends!\n\nCustomize your garden, trade seeds, and explore other players\u2019 creations. Whether you're growing for beauty, bragging rights, or just the chill vibes, Plantopia is your relaxing yet exciting garden getaway in VR.\n\n\ud83c\udf3c Collect. Grow. Show off.\nAre you ready to plant your legacy?", "short_description": "Grow your garden, grow your pride! In Plantopia, collect seeds, nurture unique plants, and hope to sprout a rare Big 
aWrm9gA6Oqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gi_KixrfPvOIL0HRLWdlrREQMAANIom_rFy8zzdGAhA&oe=6A3BFD75"}, {"file_name": "Adobe Express - file - 2025-11-18T130244.064.png", "id": "1425586265596934", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623295_1425586268930267_6812804091482337193_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pldBxGRhch0Q7kNvwF-Z08B&_nc_oc=AdrP8jeqBmBs7Y19cwXOBEaYjduVqKwRehj4_mkYeFAzOKdWljI0EM9RXWeYR5ADK_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P5-ILP47OYdTh1yeZxHbwZ9j3jfmKuU7mKBX10U6_YQ&oe=6A3BEA3B"}, {"file_name": "Adobe Express - file - 2025-10-17T104858.282.png", "id": "3394603190691008", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619485_3394603194024341_3560251468194123376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6s4FI1B5JekQ7kNvwHKk8H-&_nc_oc=AdqhFCEW3Z81D55L7etQjjQm3juEq0AbAor_dY49CttHsagJc2J95OlXw60XkTYJdVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L7dOoXTp47t_zZq04C9adzMA4YJ_P2xY-Na9PE2h53w&oe=6A3BD165"}, {"file_name": "Adobe Express - file - 2025-11-18T130203.332.png", "id": "1951228472940982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292426_1951228476274315_6807916975579011143_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bh9bBYQgYZ4Q7kNvwEtUJrB&_nc_oc=AdpuqtaWnL4A5iaoMp78ERUQOd-aCIwlF4qyR3PjFTnKHV16MvUE16r0LaNDtwFQJic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OkzSSJTZ8CCkddlhq_Qa2JZ6EGWbjS6qjGhvpRNC4tA&oe=6A3BF25C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "plantpaosi (1).png", "id": "1309977057855230", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1309977061188563_4160925059214217352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKA7dkD2sj0Q7kNvwEkNxpP&_nc_oc=AdolVxn3PTzwrmvZN7qnSDthm8LBouRLVfBMmLosz8lMlyiKoaUZuEQBamvd8RkjPHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PA9LtYvBMc0gsf3EQxbb_GHkjohJEIGS13slGZ8CHLA&oe=6A3BEE25"}, "display_name": "Plantopia 2", "keywords": ["Game", "Grow", "Hangout", "Plant", "Plantopia"], "long_description": "Welcome to Plantopia2, a peaceful and immersive VR experience where nature is in your hands.\n\nStep into a vibrant world where you can plant seeds, grow crops, and shape your own living environment. Every plant grows in real time, reacting to your care as you water, harvest, and expand your garden. Explore colorful landscapes, unlock new areas, and enjoy a calm, rewarding gameplay loop designed to help you relax and unwind.\n\nBuilt specifically for VR, Plantopia offers intuitive interactions, smooth movement, and a cozy atmosphere that makes you feel truly connected to the world around you. Whether you\u2019re tending to your garden, discovering new plants, or simply enjoying the scenery, Plantopia is the perfect escape into a growing world of creativity and calm.\n\nGrow at your own pace. Explore freely. Relax naturally.", "short_description": "Plantopia2 is a cozy VR world where you grow, explore, and bring nature to life. Plant seeds, watch your garden flourish, and relax in a vibrant, living environment built for immersive VR."}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://sites.google.com/view/plantopiapolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Pulser Games", "support_website_url": null, "website_url": "https://sites.google.com/view/plantopiapolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory
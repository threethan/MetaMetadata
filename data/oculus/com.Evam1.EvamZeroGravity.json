 "568641706315644", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819982_568641712982310_6745439840283997018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UUY-Pf-2E4Q7kNvwFhWMHY&_nc_oc=AdpuBhjP2Fh2-if2blKNukshGbdpyJDDfyq0wDsCDmE2RkgzU2YJ-UjpNoLbQTUQu5g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi9n_NH9yrT6GJUx6PZRmvyn1kZo_HuadtezmbxVu7Aw&oe=6A8D8CFC"}]}, "id": "1409636236961961", "locale": "en_US", "screenshots": [{"file_name": "z1.png", "id": "554163737633281", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823901_554163740966614_8427675564166498671_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYM5nT44KNMQ7kNvwED1M-K&_nc_oc=AdpKNB3Tyov2mUhCeZyW4MBIwAY65wybNVtDTUYdcpbi0-2iCHVWIMlBtJJxq6u4TTY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdlR6RvF6CUhehJJHDiKEcpeWoiINrJkYTv7b438ikIg&oe=6A8D9821"}, {"file_name": "z3.png", "id": "1055136496720132", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819354_1055136500053465_7358643729987096488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZB0aRWRlGMQ7kNvwGMMY49&_nc_oc=AdpfZWWZegMYYXuRC8SeYz-6nZTfHXPdZbRZg7vCC6KQjX5wkQxX18jWy7fSJCYfcls&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEzrmwqPycZwD6HoFJTfILe10hrosULt6WGtBp9dyvqA&oe=6A8D658D"}, {"file_name": "z7.png", "id": "1626743901497859", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827585_1626743904831192_2324859417658547741_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpNmC5Q5dFsQ7kNvwGz8K3Y&_nc_oc=AdpXYijbXW3r722fwSJDi3PgpK0Xhb03wD7YwJpyYykVCIWa2b9G-488SpVZKjFSjek&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJzaagfC4NDM7-Y9CsmFp1Xh994_pX3rVdc52qbeCOBQ&oe=6A8D89E1"}, {"file_name": "z4.png", "id": "1832412724033237", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491818885_1832412727366570_3396727229496506225_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5B9ECfWKUUQ7kNvwGkxTyp&_nc_oc=AdoMCJ_nwFVjE_gTOtXijGBIGmHnujaHc57V_yHNacefwZM63dan2uL-sdcGS6W8dLY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt1W1VSqJ3Gf7rQzzn4BjKKnDDoXA3EfS4TQHRwDDIQA&oe=6A8D81EB"}, {"file_name": "z6.png", "id": "566177899899598", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491819354_566177903232931_2408334674018583921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFaBTpYDkQMQ7kNvwGv9S6a&_nc_oc=AdrhE9LytwY5vmfInN5_8YMotsQ2JtePzGXEXp7fcppuiza8FfhI-JwlD_5GJaQlSno&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhDYa4069295c64T8y1cYWF6FZ2xB4yN5BlmQk1-jKvQ&oe=6A8D7F15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_2560x1440.png", "id": "1044786101119145", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499303316_1044786104452478_3665579453297917639_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2j8hMnNQnIQ7kNvwEI64x1&_nc_oc=AdojZr0uCnk_YGFKRNroWdcfm9jFJuQrIpOoeWY0SQG61HOBqWBRD5Sc2_8cCeruvNI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9CdzW4VuDPWPohuBFJA0VsfN7Fkmx-Wlb9QBny3zvUA&oe=6A8D8523"}, "display_name": "Zero Gravity - Float & Explore", "keywords": ["gravity", "space", "simulation", "learning", "education"], "long_description": "**Float. Interact. Discover.**\n\nStep into a hyper-realistic zero gravity environment inspired by the International Space Station. Zero Gravity: Float & Explore is a virtual reality experience designed to immerse students, educators, and curious minds into the fascinating world of weightlessness.\n\nYou\u2019ll find yourself gently floating in a controlled zero gravity chamber where everyday objects behave in extraordinary ways. Interact with a wide range of items\u2014like a table tennis ball and racket, a fidget spinner, a light ball, or even a kendama\u2014and observe how physics transforms when gravity disappears.\n\n{1101808365131447}\n\n{731367592640229}\n\nThis experience is ideal for:\n- Students curious about space and science\n- Educators introducing real-world STEM concepts\n- Anyone fascinated by the feeling of floating freely\n\n**Surprise Twist** \n\nThere\u2019s a hidden element in the experience, but we won\u2019t spoil it here. Download and explore to unlock something unexpected.\n\nEducational, fun, and mesmerizing\u2014Zero Gravity brings the cosmos closer than ever.\n\nKey Features:\n- Realistic zero gravity simulation \n- Interactive objects with true-to-space physics\n- STEM-focused educational value\n- Beautiful, calming visuals and soundscapes\n- Hidden surprise element revealed during use\n- Offline gameplay\n- No ads, no tracking, no interruptions\n\n{4133174676925231}", "short_description": "Experience zero gravity like never before\u2014float, play, and discover how objects behave without gravity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evamvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Evam VR", "support_website_url": null, "website_url": "https://www.evamvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10083619721692722"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typena
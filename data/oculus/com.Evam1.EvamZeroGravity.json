nGulX8Dasw2eXLyXQMuoIPoZVLqWZ-On0ldp7249WptpvZdZoGHM0TGc4-blLaDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWzzkYc-3LFUrVvTsVOROJJ2e7x2Xl7_Yc0aWWxLqX7g&oe=6AFDD1A1"}, {"file_name": "z4.png", "id": "1832412724033237", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_1832412727366570_3396727229496506225_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tq65VC9NcL8Q7kNvwHWZkaB&_nc_oc=AdrZcXwXyGH5NQDSSwYVl0eavQQXu87L9_l8-9GP7aZfHNwYHnc8Qs3wRFYWG-KBeho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSFgPx6A8m-dh7tgC5zen4zVASO1eiUQV7YfA1TZ2Vpw&oe=6AFDC9AB"}, {"file_name": "z6.png", "id": "566177899899598", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819354_566177903232931_2408334674018583921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oK_MVDR6hmoQ7kNvwEh3A3a&_nc_oc=AdqqWA4ioKVTNCS4ecb7rVN9AmUz2Wn3u0vAmCVZ8Kz-6AXwCQwFfFh5s7ksXT3DvaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhG1N_6zB3TDVGi4zPwBiAtWl0vCyqEi_0lh0kUjcq9Q&oe=6AFDC6D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_2560x1440.png", "id": "1044786101119145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303316_1044786104452478_3665579453297917639_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtQWlonC7tEQ7kNvwEpMiRW&_nc_oc=AdoJpcpO91b2VIEMP-ZBEId82ajjlfEDp5Q3Y5JuDdvryTTorj7Vs9Qq_R-lUR7xn2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl8LV0zcvkY4AHEnXFHJgvgqABXaWRGk0-Rr_tSucb8w&oe=6AFDCCE3"}, "display_name": "Zero Gravity - Float & Explore", "keywords": ["gravity", "space", "simulation", "learning", "education"], "long_description": "**Float. Interact. Discover.**\n\nStep into a hyper-realistic zero gravity environment inspired by the International Space Station. Zero Gravity: Float & Explore is a virtual reality experience designed to immerse students, educators, and curious minds into the fascinating world of weightlessness.\n\nYou\u2019ll find yourself gently floating in a controlled zero gravity chamber where everyday objects behave in extraordinary ways. Interact with a wide range of items\u2014like a table tennis ball and racket, a fidget spinner, a light ball, or even a kendama\u2014and observe how physics transforms when gravity disappears.\n\n{1101808365131447}\n\n{731367592640229}\n\nThis experience is ideal for:\n- Students curious about space and science\n- Educators introducing real-world STEM concepts\n- Anyone fascinated by the feeling of floating freely\n\n**Surprise Twist** \n\nThere\u2019s a hidden element in the experience, but we won\u2019t spoil it here. Download and explore to unlock something unexpected.\n\nEducational, fun, and mesmerizing\u2014Zero Gravity brings the cosmos closer than ever.\n\nKey Features:\n- Realistic zero gravity simulation \n- Interactive objects with true-to-space physics\n- STEM-focused educational value\n- Beautiful, calming visuals and soundscapes\n- Hidden surprise element revealed during use\n- Offline gameplay\n- No ads, no tracking, no interruptions\n\n{4133174676925231}", "short_description": "Experience zero gravity like never before\u2014float, play, and discover how objects behave without gravity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evamvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Evam VR", "support_website_url": null, "website_url": "https://www.evamvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nu
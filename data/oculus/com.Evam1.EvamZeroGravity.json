6_s9EZBOzPurZzADaExpS0W13Yl-uOgmProJUTijONqU9i-CHnG1hCmV3vMzoRwU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXJwOfgNjPXENcrrOYXJGahIyveLP0Tl07CV0qujoRl8Q&oe=6B0EF521"}, {"file_name": "z4.png", "id": "1832412724033237", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1832412727366570_3396727229496506225_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--5V7H3C31QQ7kNvwE5DY-c&_nc_oc=AdqTbzlUS07qLQgMq7E7gUxiytItn12MxKCyJe4bVnFpc8RBf8RTem1b-ZdiB_Tif-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTAZ39RLpU1Ht5Dwqh2cclGmDKPG47NTGIIsx6K2Sr4Q&oe=6B0EED2B"}, {"file_name": "z6.png", "id": "566177899899598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819354_566177903232931_2408334674018583921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S80-bKmG8KMQ7kNvwHpILjD&_nc_oc=AdpsgfxcNhdqtwQejSAU5q24SOeSUKQew9iPZurh0biBgGyVv-lXzPwQ3vUhSZw9gEY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUM21sPpOyLG3qqPmUvFrfc06vJ_cpZLGzWLdLgrCARnA&oe=6B0F2295"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_2560x1440.png", "id": "1044786101119145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303316_1044786104452478_3665579453297917639_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN9785mEQ4kQ7kNvwGo5cq9&_nc_oc=AdpvCUWrLWyq0ltQ0x9YpNEPT8QAxjLlHmbxDW7bcJnw_WQF5BOruJn07o3Bs4tOAg8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJJ4FE1ZoxDdveawpU0OZ4L3dedIO2F-H0f0lITO73EA&oe=6B0EF063"}, "display_name": "Zero Gravity - Float & Explore", "keywords": ["gravity", "space", "simulation", "learning", "education"], "long_description": "**Float. Interact. Discover.**\n\nStep into a hyper-realistic zero gravity environment inspired by the International Space Station. Zero Gravity: Float & Explore is a virtual reality experience designed to immerse students, educators, and curious minds into the fascinating world of weightlessness.\n\nYou\u2019ll find yourself gently floating in a controlled zero gravity chamber where everyday objects behave in extraordinary ways. Interact with a wide range of items\u2014like a table tennis ball and racket, a fidget spinner, a light ball, or even a kendama\u2014and observe how physics transforms when gravity disappears.\n\n{1101808365131447}\n\n{731367592640229}\n\nThis experience is ideal for:\n- Students curious about space and science\n- Educators introducing real-world STEM concepts\n- Anyone fascinated by the feeling of floating freely\n\n**Surprise Twist** \n\nThere\u2019s a hidden element in the experience, but we won\u2019t spoil it here. Download and explore to unlock something unexpected.\n\nEducational, fun, and mesmerizing\u2014Zero Gravity brings the cosmos closer than ever.\n\nKey Features:\n- Realistic zero gravity simulation \n- Interactive objects with true-to-space physics\n- STEM-focused educational value\n- Beautiful, calming visuals and soundscapes\n- Hidden surprise element revealed during use\n- Offline gameplay\n- No ads, no tracking, no interruptions\n\n{4133174676925231}", "short_description": "Experience zero gravity like never before\u2014float, play, and discover how objects behave without gravity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evamvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Evam VR", "support_website_url": null, "website_url": "https://www.evamvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nu
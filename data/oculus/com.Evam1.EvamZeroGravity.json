 "568641706315644", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819982_568641712982310_6745439840283997018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFV90iky2vYQ7kNvwGJdH-h&_nc_oc=AdoLuszabT84o1_imqEuKZInMl504FR30yuO20G-HyXjS9K2oau1RLyn9YAnwB6CKDE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyTK11WCHrwJbNLxDTMQnxVN1ztGpThKXoA3refI247Q&oe=6A8EDE7C"}]}, "id": "1409636236961961", "locale": "en_US", "screenshots": [{"file_name": "z1.png", "id": "554163737633281", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823901_554163740966614_8427675564166498671_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbZ0K61U2voQ7kNvwHcanxX&_nc_oc=Adr6w7OavxmFBI9MM8pnnEHdEqF_LqN8ip3_-4lvR1QxcQNuGcucCB80gvCLPJXN27c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhYcPx6t6wIGdhJqP-l__6ua5BmwclSdyJQ0S00A35tA&oe=6A8EE9A1"}, {"file_name": "z3.png", "id": "1055136496720132", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819354_1055136500053465_7358643729987096488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZB0aRWRlGMQ7kNvwFIK591&_nc_oc=AdpVZMmixcvpw0krNGXm2lTsdgr_HsGLxTaqHr9aznSJtyozWxGJM43ISTgJDwnlknY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPqSrslNM6OHItrOZa6pptsjnYrc29RK0kzIuDZFAzbA&oe=6A8EEF4D"}, {"file_name": "z7.png", "id": "1626743901497859", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827585_1626743904831192_2324859417658547741_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpNmC5Q5dFsQ7kNvwEtnRIW&_nc_oc=AdqExsZuWX2z6iBXksbQ5orDFERoYy6Z4A6vNqUj1YcWWYIylBLdvCu_GofhJEc1QmU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgm6iZ7noveb5TW0wtg0brL5x4e4XJG4xVvFLibjFAfw&oe=6A8EDB61"}, {"file_name": "z4.png", "id": "1832412724033237", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491818885_1832412727366570_3396727229496506225_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5B9ECfWKUUQ7kNvwEsTXO1&_nc_oc=AdqtqpjXEe7sGt-ued0phtbOxQe3HWv2LDeLUT9Fn4P0pBU9UcfULXRiK082xYeVZv4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHKY9E1BuoNE_RPXxhJiVcqx3mqMN_JeR6XlyEW5kP-Q&oe=6A8ED36B"}, {"file_name": "z6.png", "id": "566177899899598", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491819354_566177903232931_2408334674018583921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyvoWZzUVHQQ7kNvwEkiSXW&_nc_oc=Adq6xA8AajI7iBqI8Jg0JM0vVlp9A1BmMRm04DhD7wzHiPDVFUtkuA8QnGZEUADiaaE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSW8mzQhMo81Yt--C-ra_szzOsMXO46W_WddDSHTXR2A&oe=6A8ED095"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_2560x1440.png", "id": "1044786101119145", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499303316_1044786104452478_3665579453297917639_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cK7GtUGr7R8Q7kNvwHUTiXi&_nc_oc=Adod7GH5SKItIxpMBLBoVhj63M4Pt02R9U1iD0pinR93NXbjbZy-1UIewYbbcb1mKNs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyRTxXQ-xCmJqmYDa-VAQBiJpd0_JDwrrbYBMwuSoLRw&oe=6A8ED6A3"}, "display_name": "Zero Gravity - Float & Explore", "keywords": ["gravity", "space", "simulation", "learning", "education"], "long_description": "**Float. Interact. Discover.**\n\nStep into a hyper-realistic zero gravity environment inspired by the International Space Station. Zero Gravity: Float & Explore is a virtual reality experience designed to immerse students, educators, and curious minds into the fascinating world of weightlessness.\n\nYou\u2019ll find yourself gently floating in a controlled zero gravity chamber where everyday objects behave in extraordinary ways. Interact with a wide range of items\u2014like a table tennis ball and racket, a fidget spinner, a light ball, or even a kendama\u2014and observe how physics transforms when gravity disappears.\n\n{1101808365131447}\n\n{731367592640229}\n\nThis experience is ideal for:\n- Students curious about space and science\n- Educators introducing real-world STEM concepts\n- Anyone fascinated by the feeling of floating freely\n\n**Surprise Twist** \n\nThere\u2019s a hidden element in the experience, but we won\u2019t spoil it here. Download and explore to unlock something unexpected.\n\nEducational, fun, and mesmerizing\u2014Zero Gravity brings the cosmos closer than ever.\n\nKey Features:\n- Realistic zero gravity simulation \n- Interactive objects with true-to-space physics\n- STEM-focused educational value\n- Beautiful, calming visuals and soundscapes\n- Hidden surprise element revealed during use\n- Offline gameplay\n- No ads, no tracking, no interruptions\n\n{4133174676925231}", "short_description": "Experience zero gravity like never before\u2014float, play, and discover how objects behave without gravity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evamvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Evam VR", "support_website_url": null, "website_url": "https://www.evamvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10083619721692722"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typena
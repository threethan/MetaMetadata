tTv-m&_nc_oc=Adr708FWZf7endFmLHS5ejXQPevdge063yXZE5eLEibIqdAP_R0yDA_-uhWK5KxLhio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlvlzdyYlcUHTSQG_GT3Gh83jQi8ni7a5-z42OqLPXRA&oe=6AE7602B"}, {"file_name": "z6.png", "id": "566177899899598", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819354_566177903232931_2408334674018583921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pabdfhoG61wQ7kNvwF64Z_8&_nc_oc=AdqbdJvuYpWiZCK0NlLI5mdrfDcjjLZqXbZaHjCwqVd6baKxO9_VpJDPLHsTyLyWiyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWNb8AkkaFfEC8hoaikmYeYM0-g17aMtfMlFHwLkN8sA&oe=6AE75D55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_2560x1440.png", "id": "1044786101119145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303316_1044786104452478_3665579453297917639_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZEHONav690Q7kNvwHODdzj&_nc_oc=AdpUaS0dXNYLpbaU_Rh4F9dChIWas6vJcO9mIfT0IJQsw6nNfDfrJAU_6X3WUSlO2k4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCYU3Iu4I7cXDLt0DJJudt2V5pNTiFRqs5HpnfAphyHQ&oe=6AE76363"}, "display_name": "Zero Gravity - Float & Explore", "keywords": ["gravity", "space", "simulation", "learning", "education"], "long_description": "**Float. Interact. Discover.**\n\nStep into a hyper-realistic zero gravity environment inspired by the International Space Station. Zero Gravity: Float & Explore is a virtual reality experience designed to immerse students, educators, and curious minds into the fascinating world of weightlessness.\n\nYou\u2019ll find yourself gently floating in a controlled zero gravity chamber where everyday objects behave in extraordinary ways. Interact with a wide range of items\u2014like a table tennis ball and racket, a fidget spinner, a light ball, or even a kendama\u2014and observe how physics transforms when gravity disappears.\n\n{1101808365131447}\n\n{731367592640229}\n\nThis experience is ideal for:\n- Students curious about space and science\n- Educators introducing real-world STEM concepts\n- Anyone fascinated by the feeling of floating freely\n\n**Surprise Twist** \n\nThere\u2019s a hidden element in the experience, but we won\u2019t spoil it here. Download and explore to unlock something unexpected.\n\nEducational, fun, and mesmerizing\u2014Zero Gravity brings the cosmos closer than ever.\n\nKey Features:\n- Realistic zero gravity simulation \n- Interactive objects with true-to-space physics\n- STEM-focused educational value\n- Beautiful, calming visuals and soundscapes\n- Hidden surprise element revealed during use\n- Offline gameplay\n- No ads, no tracking, no interruptions\n\n{4133174676925231}", "short_description": "Experience zero gravity like never before\u2014float, play, and discover how objects behave without gravity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evamvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Evam VR", "support_website_url": null, "website_url": "https://www.evamvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10083619721692722"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary"
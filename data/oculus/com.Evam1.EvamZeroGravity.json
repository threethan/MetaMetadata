 "568641706315644", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819982_568641712982310_6745439840283997018_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F1zcgZ8SI0Q7kNvwFzJOCg&_nc_oc=AdrNLV_ApZay5XUpDP739QGrpeJw33NidDV2AW02sr_ihJIKoxFc5hTiD8xUEAYKKGw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGAiD2Kr3pDZKLChyOWXhLHOGPySxaPJ-Ygp0Ep8OJ9g&oe=6A85A3FC"}]}, "id": "1409636236961961", "locale": "en_US", "screenshots": [{"file_name": "z1.png", "id": "554163737633281", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823901_554163740966614_8427675564166498671_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5NmpUG1ykYQ7kNvwFKVAbi&_nc_oc=AdoqMb3jO8uybYcAhZ74WALEw_MVxjxfYSWkK7nRWcRZ5p0RHqoYMItcHSIbOCGqD1I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4KfouJzOPF8mKadcrZeYGNDequDYa4f4G2UXrk2vAMw&oe=6A85AF21"}, {"file_name": "z3.png", "id": "1055136496720132", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819354_1055136500053465_7358643729987096488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJY-dnMLTDkQ7kNvwEPDNJL&_nc_oc=AdrDVgCBenC920sQwsZta_wb15JJwe4-8rEjjKx8rmjkYr7CH82fWOWj36-psVus0mE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBJNRJ7LLELwrUPAxcKinGXUGoO0x4-D-fovtL2nuZww&oe=6A857C8D"}, {"file_name": "z7.png", "id": "1626743901497859", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827585_1626743904831192_2324859417658547741_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8GHnkiJQz0Q7kNvwEt_7dZ&_nc_oc=AdqsJ88MI6_NUQEG3ab1i3j-kvXCeTcx89wU1R6Wkv6q4JnLTFJehCpxg0iyhClSxNk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuly9tAdoGuH5b67tGZvwVKZU6j6q2DMikYzJfq4glcw&oe=6A85A0E1"}, {"file_name": "z4.png", "id": "1832412724033237", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491818885_1832412727366570_3396727229496506225_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHmVxWlodCYQ7kNvwGUGhcM&_nc_oc=AdoHekTf1hVQnmOsVrwn88UZlpIsdeAH7tcqWXMISrPdWT-RsU3ixK68N4V0Sz-21tg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjjE3fu1Wf128ldTNspKr33fUOCejUGw7U8Hy-d8lEig&oe=6A8598EB"}, {"file_name": "z6.png", "id": "566177899899598", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491819354_566177903232931_2408334674018583921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qefELXFvnkQ7kNvwGorO4b&_nc_oc=AdqmrxypWnsqx9ge6lUjmEdEwVpk1tLuCCIEuRBYfnS-JMnWQ2KheUCAZRuogmgSN1M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8jgI0rBXa0syMJOj8V65TqYI9kUyyW9ItcrMAeoiogA&oe=6A859615"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_2560x1440.png", "id": "1044786101119145", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499303316_1044786104452478_3665579453297917639_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQjsiWulzbEQ7kNvwEKc4-C&_nc_oc=AdplpyckS2j3l0ehc83bpaT-uGaSOCdS96eHM5jrPQ1hdkWmskP5AI5VZg5gdCQCCxo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBbeSVMg11HIbtDJPvYqxeD1cZoipbDPh63FynGIQpVw&oe=6A859C23"}, "display_name": "Zero Gravity - Float & Explore", "keywords": ["gravity", "space", "simulation", "learning", "education"], "long_description": "**Float. Interact. Discover.**\n\nStep into a hyper-realistic zero gravity environment inspired by the International Space Station. Zero Gravity: Float & Explore is a virtual reality experience designed to immerse students, educators, and curious minds into the fascinating world of weightlessness.\n\nYou\u2019ll find yourself gently floating in a controlled zero gravity chamber where everyday objects behave in extraordinary ways. Interact with a wide range of items\u2014like a table tennis ball and racket, a fidget spinner, a light ball, or even a kendama\u2014and observe how physics transforms when gravity disappears.\n\n{1101808365131447}\n\n{731367592640229}\n\nThis experience is ideal for:\n- Students curious about space and science\n- Educators introducing real-world STEM concepts\n- Anyone fascinated by the feeling of floating freely\n\n**Surprise Twist** \n\nThere\u2019s a hidden element in the experience, but we won\u2019t spoil it here. Download and explore to unlock something unexpected.\n\nEducational, fun, and mesmerizing\u2014Zero Gravity brings the cosmos closer than ever.\n\nKey Features:\n- Realistic zero gravity simulation \n- Interactive objects with true-to-space physics\n- STEM-focused educational value\n- Beautiful, calming visuals and soundscapes\n- Hidden surprise element revealed during use\n- Offline gameplay\n- No ads, no tracking, no interruptions\n\n{4133174676925231}", "short_description": "Experience zero gravity like never before\u2014float, play, and discover how objects behave without gravity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evamvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Evam VR", "support_website_url": null, "website_url": "https://www.evamvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10083619721692722"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typena
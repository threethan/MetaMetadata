VFKRkdH65s3yyBOj4vuWwCsnZcoEglLYOvfYmTZ_VSoqcSf4iLEFo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7C7p8kAkZOuelU-wJ54vSABFRyF_4fU04Do4zYbiy2w&oe=69CBB9C4"}, {"file_name": "1.png", "id": "554668830929130", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391952_554668834262463_1967931043555871589_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSq3ebsI8PQQ7kNvwF1Qq-V&_nc_oc=Adpew0aYqJaU7hnaJ7zfai_SD315r6A_yQrMm5VQC0UDjsg3QxdejweEKLbQ838ZMT4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwieDqZh1WkeLY09sDNyjxSwPNzyxGO7gUzqdFeHwYHMA&oe=69CBBDF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1146306933542578", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393649_1146306936875911_5286808308123407512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esRDHaLXkrMQ7kNvwFHfC1Y&_nc_oc=AdouIt_oe2h59t8pfzE8vOodVJxArbI432vWN8xyi2fRLpERPxgpCpld6tSYpKBCCwM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afywe8kRSixqQ2RtNZ64dgKeVqk7v1rmcZs8cGF4brM97w&oe=69CBA798"}, "display_name": "Hamster Simulator", "keywords": ["Hamster", "Simulation", "Adventure", "PetSimulator", "CasualGame"], "long_description": "Have you ever dreamed of experiencing life as a tiny, energetic hamster? Hamster Simulator VR brings that dream to life, offering a fully immersive and interactive experience where you take on the role of an adorable hamster in a giant, playful world. From exploring intricate tunnels to running endlessly on a hamster wheel, every moment is filled with excitement, curiosity, and fun.\nAs you navigate through your cozy, oversized environment, you\u2019ll have the chance to complete fun activities that capture the real-life habits of a hamster.  Along the way, you\u2019ll snack on delicious treats, interact with toys, and experience a world designed for both relaxation and thrilling exploration.\nHamster Simulator VR provides an enchanting escape into the life of one of the world\u2019s cutest pets. Whether you\u2019re looking for a casual, stress-free adventure or a playful challenge, this game offers something for everyone. Get ready to see the world through tiny eyes, feel the joy of scurrying through your habitat, and embark on an unforgettable VR journey as the most lovable little rodent around!", "short_description": "Step into the tiny, adorable world of a hamster in Hamster Simulator VR! :hamster: Explore colorful mazes, scurry through tunnels, run on wheels, and roll around. all in fully immersive VR! Snack on treats, interact with fun toys, and experience the joys and challenges of being a tiny furball in a giant world. Get ready for an adorable adventure full of curiosity, play, and endless fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://idzdigital.com/privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": " IDZ Digital Private Limited", "support_website_url": null, "website_url": "https://idzdigital.com/vr-games.php", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9220120184733989"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1451206256350529"}, {"status": "PUBLISHED", "id": "1344365030216758"}, {"status": "PUBLISHED", "id": "706137952537052"}, {"status": "PUBLI
5UQ0pxT21j-55o_mYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsoNpVkqdfohdkEU9wDuWGIrxKOy4TuGj6nUGvTmmjJEg&oe=69A81E27"}, {"file_name": "Screenshot4FIX.png", "id": "1171240378357903", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827727_1171240381691236_8510047687359511619_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iAO91fppjwQ7kNvwF3-diQ&_nc_oc=AdlBeBTZqyoy1U19dJzGPHp8qY7VpWE_A0ubFlQsPvQLqCzGBjO-IFtLRFPzOlikdeM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftr35M0UaDgTE3p0ZzISgXx6JsGkRwsT5h8thY5zE6l8g&oe=69A80D5E"}, {"file_name": "Screenshot5FIX.png", "id": "630816696679811", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823943_630816700013144_7727656603010524225_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rA-5JJizq5cQ7kNvwFyifWd&_nc_oc=Adnamj7utcsoxU-u5gsCMMgyKZ1W5S5H1jhnGDoVOuvOkh51FRTFtGp71Ger-eKX_Sg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftkhlU8fgH5rg4W731JY6l0AtyLEG3_jsepjeNE3EBKUQ&oe=69A80AEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adar Tags", "keywords": [], "long_description": "**Adar Tags** is a thrilling and immersive Gorilla Tag fan game that takes the core mechanics of fast-paced VR movement and adds a unique spin with custom maps, original environments, and enhanced gameplay features. Built for players who crave freedom of movement and the adrenaline rush of intense tag matches, Adar Tags delivers a community-driven experience where agility, strategy, and creativity are key.\n\nExplore a wide variety of environments\u2014from dense forests and abandoned structures to futuristic arenas\u2014all designed to challenge your parkour skills and keep you on your toes. Whether you're scaling high walls, launching off trampolines, or navigating tight spaces to escape your pursuers, every game feels fresh and unpredictable.\n\nAdar Tags isn't just about running and tagging\u2014it's about expression and connection. Customize your avatar with unlockable cosmetics, join lobbies with friends or strangers, and be part of a growing VR community that values fun, freedom, and fast action. With regular updates and a dedicated fanbase, Adar Tags is more than a game\u2014it's a movement.", "short_description": "**Adar Tags** is a fast-paced Gorilla Tag fan game that brings a fresh twist to the classic tree-running formula. With unique maps, custom movement mechanics, and a vibrant multiplayer community, Adar Tags offers an exciting and chaotic VR tag experience like no other.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyadar/home", "developer_terms_of_service_url": null, "publisher_name": "ReviveVR", "support_website_url": null, "website_url": "https://sites.google.com/view/adartag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9999475713435335"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1457233652102371"}]}, "baseline_offer": {"id": "1457233652102371"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749667740, "status": "PUBLISHED", "id": "1457233652102371"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23997202556569415", "version": "1.1.300"}, "id": "4173725002906767", "channel_name": "LI
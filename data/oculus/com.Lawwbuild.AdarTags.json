nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBK2KQ7MSdoyAFfAz7oZBZLyO2dyu2Aq_ctQ3sSljCdw&oe=6B03317D"}, {"file_name": "Screenshot3FIX.png", "id": "2545590822450583", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827096_2545590829117249_4393403088484320794_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRCKg4ByHYUQ7kNvwH_SXUA&_nc_oc=AdrZ410CnjOFp4VVvySL051BQk-UI4Q-NbtFFVnZnN7Wsruj5Um_EXl4o3YYQghDp_s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUSqZfGGPsIEtSh91-JJ8DlQeQIt1ILLnN4ktvM2rS1Q&oe=6B0310E7"}, {"file_name": "Screenshot4FIX.png", "id": "1171240378357903", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827727_1171240381691236_8510047687359511619_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDu6fWqhx8QQ7kNvwEa4JdC&_nc_oc=Adr5De-3bjgfeVUwsCV6E86PFGnR2hONNHH2dCTV_QN6R84GvXMAfS6AtcrbEyE4cxM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWQiAzMfHQZn8_r_xqn6PRKeucewHo9n7JqsMIEm21-g&oe=6B03001E"}, {"file_name": "Screenshot5FIX.png", "id": "630816696679811", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823943_630816700013144_7727656603010524225_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRU5FS29bLoQ7kNvwGhLl3t&_nc_oc=Adr8qi_Uo1j9jTSS5cbsgRUfJN2TZzplZkegDRohskA9bxrwCZKVYB-VwjaQXc-og6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_XelU4G-Yw-sh9uEQY5qKjbbZ6fqqwbibyLbFonvelA&oe=6B0335EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adar Tags", "keywords": [], "long_description": "**Adar Tags** is a thrilling and immersive Gorilla Tag fan game that takes the core mechanics of fast-paced VR movement and adds a unique spin with custom maps, original environments, and enhanced gameplay features. Built for players who crave freedom of movement and the adrenaline rush of intense tag matches, Adar Tags delivers a community-driven experience where agility, strategy, and creativity are key.\n\nExplore a wide variety of environments\u2014from dense forests and abandoned structures to futuristic arenas\u2014all designed to challenge your parkour skills and keep you on your toes. Whether you're scaling high walls, launching off trampolines, or navigating tight spaces to escape your pursuers, every game feels fresh and unpredictable.\n\nAdar Tags isn't just about running and tagging\u2014it's about expression and connection. Customize your avatar with unlockable cosmetics, join lobbies with friends or strangers, and be part of a growing VR community that values fun, freedom, and fast action. With regular updates and a dedicated fanbase, Adar Tags is more than a game\u2014it's a movement.", "short_description": "**Adar Tags** is a fast-paced Gorilla Tag fan game that brings a fresh twist to the classic tree-running formula. With unique maps, custom movement mechanics, and a vibrant multiplayer community, Adar Tags offers an exciting and chaotic VR tag experience like no other.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyadar/home", "developer_terms_of_service_url": null, "publisher_name": "ReviveVR", "support_website_url": null, "website_url": "https://sites.google.com/view/adartag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "i
nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlDhuEsxVVZc1I9_jEzpkOC2B_e_pFiMR3fmkuk1OJMQ&oe=6AFF04BD"}, {"file_name": "Screenshot3FIX.png", "id": "2545590822450583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827096_2545590829117249_4393403088484320794_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiwCiM4Mjl8Q7kNvwEUuPXi&_nc_oc=Adrtw7Qhq17lL02HZlc92QsPLRiGRgE36jZiY5TFScWr9dbRDG63szHkcC484aypBJs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS51J4yDp0eAZ4UCruBagArSChKncQlHKpKmKuxdSL24Q&oe=6AFF1C67"}, {"file_name": "Screenshot4FIX.png", "id": "1171240378357903", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491827727_1171240381691236_8510047687359511619_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqH1Fs1Ur-YQ7kNvwHX0RNU&_nc_oc=AdodjJii2LK-Iq0k17J276x5KbC9fQLLrm3uAv-f2wPw75miFhFyHBPp0o6PhUZ9eD0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM8MTA0F_rCuDpcUGV56YfooGbQz0W7yWhwfrkpWXXQw&oe=6AFF0B9E"}, {"file_name": "Screenshot5FIX.png", "id": "630816696679811", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823943_630816700013144_7727656603010524225_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeEHi98FhqMQ7kNvwFm0kUN&_nc_oc=Ado4CnrNn7oRZluQNmMPIPU5wS1HwZSlnIdm6THhpUXMzARdhezM2G9yjC5iNE4uxn4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfHlno_0joRPJEPSvR2inzWhQ-KwVPxeL0Q-jmrzy_TQ&oe=6AFF092C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adar Tags", "keywords": [], "long_description": "**Adar Tags** is a thrilling and immersive Gorilla Tag fan game that takes the core mechanics of fast-paced VR movement and adds a unique spin with custom maps, original environments, and enhanced gameplay features. Built for players who crave freedom of movement and the adrenaline rush of intense tag matches, Adar Tags delivers a community-driven experience where agility, strategy, and creativity are key.\n\nExplore a wide variety of environments\u2014from dense forests and abandoned structures to futuristic arenas\u2014all designed to challenge your parkour skills and keep you on your toes. Whether you're scaling high walls, launching off trampolines, or navigating tight spaces to escape your pursuers, every game feels fresh and unpredictable.\n\nAdar Tags isn't just about running and tagging\u2014it's about expression and connection. Customize your avatar with unlockable cosmetics, join lobbies with friends or strangers, and be part of a growing VR community that values fun, freedom, and fast action. With regular updates and a dedicated fanbase, Adar Tags is more than a game\u2014it's a movement.", "short_description": "**Adar Tags** is a fast-paced Gorilla Tag fan game that brings a fresh twist to the classic tree-running formula. With unique maps, custom movement mechanics, and a vibrant multiplayer community, Adar Tags offers an exciting and chaotic VR tag experience like no other.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyadar/home", "developer_terms_of_service_url": null, "publisher_name": "ReviveVR", "support_website_url": null, "website_url": "https://sites.google.com/view/adartag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "i
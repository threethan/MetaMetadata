4wKqdcVs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73ENSYrmpoUkz6GgQtx9KC2mqJWoYVFduSbLqiwNok2Q&oe=6A1AF1DF"}, {"file_name": "2.png", "id": "1677255619494966", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974662_1677255622828299_5204452643859196170_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nik8BfFrzM0Q7kNvwEb4N3q&_nc_oc=AdqnfK2ikhCSp2H_iqhF95iQ7lK-Z1GOqg7NtMZLn4HEyAHQ58DhxSHYYcNViN7W07Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54bfD1iL5sGk_piitWGNgppLKaylWI8IH4Br2SG9iEgQ&oe=6A1AD797"}, {"file_name": "1.png", "id": "570961582469253", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974663_570961585802586_7808211981859566385_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgsRNy113WMQ7kNvwGn9Pfk&_nc_oc=AdqZRQfuBL5HFpPworgtedAfpK-No_4MDMoLmRbKxCQrTTFqzYGTCJiYToJjQCe7FTw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xt8vJDs7hk71gSztishMORtXvp9pT0PZIxm7QKoJKuQ&oe=6A1AFFC1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Parking Master Real Parking", "keywords": ["ParkingGame", "CarParking", "ParkingMaster", "RealisticDriving", "SimulationGame"], "long_description": "Welcome to Car Parking Master, the ultimate parking simulation game! Perfect your parking skills as you take control of a variety of cars and a jeep in realistic parking scenarios. With the help of advanced parking sensors and a back camera, you\u2019ll navigate through tight parking spots and tricky environments.\n\nIn this game, you are the driver, and your mission is to park each vehicle in the designated spot without hitting obstacles, other vehicles, or going out of bounds. With increasing difficulty in each level, you will face new challenges that test your precision, timing, and strategic thinking.\n\n", "short_description": "Master the art of parking in Car Parking Master! Test your skills as you park a variety of cars and a jeep in tight, tricky spaces. Navigate through challenging parking scenarios, avoid obstacles, and park with precision. The game features realistic vehicle physics and progressively harder levels that will keep you hooked. Are you ready to become the ultimate parking master?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "RexxxStudio", "support_website_url": null, "website_url": "https://sites.google.com/view/rixxxstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9085209644903568"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "748642267796553"}, {"status": "PUBLISHED", "id": "709736424977609"}, {"status": "PUBLISHED", "id": "1215739123438856"}, {"status": "PUBLISHED", "id": "1779370969457267"}, {"status": "PUBLISHED", "id": "3545008592467670"}, {"status": "PUBLISHED", "id": "605451455193436"}]}, "baseline_offer": {"id": "748642267796553"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755877560, "status": "PUBLISHED", "id": "748642267796553"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9717257591698767", "version": "1.03"}, "id": "473267952132069", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_b
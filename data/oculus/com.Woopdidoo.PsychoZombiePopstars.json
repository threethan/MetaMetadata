ombiePopstars-20250911-215043_1.png", "id": "793100737218926", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823837_793100740552259_4917552995018530600_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A57ds2XkWZ8Q7kNvwEPcYcW&_nc_oc=AdoRkql5h48eE-X1RmWULWJP9-C0vbAe6yucMYchtQmbhj6-JGWQB28Q0KzPcgO3WG0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTblTkX_PNjRvmWUde91ZoSRFQsJxlMxU1-oMwiTW6XjA&oe=6AFB36E4"}, {"file_name": "com.Woopdidoo.PsychoZombiePopstars-20250911-215152_1.png", "id": "752478304134165", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310646_752478307467498_2476173850354490979_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpsnC2X1ESUQ7kNvwEuLisG&_nc_oc=Adp9qIEAzFy-GUl73Xh6bq7nJdF195xy2ViERh-ZKm2mto7WxcIfjM07_y4KBYtiy7I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8GV9ToFOoCLDv_PEZLOLlQiUBEZs2SuLbgh4ISRgb6A&oe=6AFB30C8"}, {"file_name": "com.Woopdidoo.PsychoZombiePopstars-20250911-215314_1.png", "id": "1282947513518668", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307466_1282947516852001_1058487549666451053_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Oqg-RmpOrYQ7kNvwGSrLzP&_nc_oc=Adq6wKmBIX5nW7SydPqgJQEPhvP0llvBKRsfd7BqR903Tnx8CfoBfyEFpqGEDir5eIQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMSBSA42K13AVHgpVyP-ic2SOjmewCCExaOcw7-Ikk4Q&oe=6AFB239C"}, {"file_name": "com.Woopdidoo.PsychoZombiePopstars-20250911-215345_1.png", "id": "1258039466012301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303864_1258039472678967_7514410798782316676_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxO-9YXaYPIQ7kNvwGeUwSp&_nc_oc=AdofenbnSuZZImlJ16VXh299ICUGUiUu6zzMhfII9mn2jZ0vY_9iArKLm5KX7EIPc-Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmcvlVAl9fxaEDk3VsMqNVxxmRoTzNCspBSWx4H9Ec2Q&oe=6AFB46D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Psycho Zombie Popstars", "keywords": ["apocalypse", "shooter", "zombie", "action", "platform"], "long_description": "The world is in danger of being consumed by the ultimate pop nightmare. An evil record label manager has unleashed a secret formula that transforms ordinary people into Psycho Zombie Popstars. His plan? To control the world by drowning it in glitter, screams, and mindless melodies.\n\nBut there\u2019s hope. You carry the cure \u2014 a powerful formula that can restore the infected back into hardworking citizens. Armed with your blasters, you\u2019ll battle hordes of zombie popstars across wild stages and surreal arenas, saving humanity one shot at a time.\n\n\ud83c\udfa4 Key Features:\n\nImmersive VR action \u2013 Grab your blasters and shoot with precision in fast-paced battles.\n\nSave humanity \u2013 Every cured popstar returns to normal life, bringing you closer to victory.\n\nEver-changing chaos \u2013 Survive waves of stylish, bizarre, and over-the-top enemies.\n\nFight for the future \u2013 Only you can stop the evil manager\u2019s plan for world domination.\n\nGet ready to shoot, cure, and rock your way through the ultimate VR showdown. The stage is set. The crowd is screaming. The world needs a hero.", "short_description": "Step into Psycho Zombie Popstars, a fast-paced VR shooter where the world is under threat from an evil record label manager\u2019s twisted formula. He\u2019s turning humanity into mindless zombie popstars to seize global control. Armed with a powerful cure, it\u2019s up to you to blast the infected back into ordinary hardworking citizens and save the world from a pop apocalypse!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.woopdidoo.studio/psychozombiepopstars/", "developer_terms_of_service_url": null, "publisher_name": "Woopdidoo", "support_website_url": null, "website_url": "https://www.woopdidoo.studio/", "category": null, "co
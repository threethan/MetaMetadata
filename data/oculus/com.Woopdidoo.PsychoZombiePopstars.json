=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZBvrccEJLgQ7kNvwGb3nIi&_nc_oc=AdpxbUMWaKoE2WQmWFA6AFKWoaOxFXpHXUrQZm6qUzOEwFvKhZ_umMH2dQgdQy_bj_A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpKTecyTqSyEuv8BHhkqNSHpmMv4HD3HSG9dVOpq07PA&oe=6AD106E4"}, {"file_name": "com.Woopdidoo.PsychoZombiePopstars-20250911-215152_1.png", "id": "752478304134165", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310646_752478307467498_2476173850354490979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHjMjNAPqqkQ7kNvwGix2x_&_nc_oc=AdrbnvSv2RlWUN2Z4UPM-9Yi2SHb14lNYD9a72sOi1EhdDebqtQp2bLTq8W21Fd3gFU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPsKL2k5jpjoP9JRSsAjLso6LA4Y6n1bLzsfZuS-5N4Q&oe=6AD100C8"}, {"file_name": "com.Woopdidoo.PsychoZombiePopstars-20250911-215314_1.png", "id": "1282947513518668", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307466_1282947516852001_1058487549666451053_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMbVh5kM-_gQ7kNvwEgwLDg&_nc_oc=AdqoJRVKpxYDTyjeHFFgK0uiyfkZLNB437dlWQN0aitoiABzG2b4Madw2R0cd8pGGUM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxkLCf1kTbH4I5DDe9dhs6sWfGVLJJIwzBsMeLJEflVQ&oe=6AD0F39C"}, {"file_name": "com.Woopdidoo.PsychoZombiePopstars-20250911-215345_1.png", "id": "1258039466012301", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303864_1258039472678967_7514410798782316676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8i8qFtFLHVQQ7kNvwH0BKZg&_nc_oc=AdqqLj6uocfDNbqeX7jKsvR9MmbVn-_N4_pCEOBZnNUIvqNsf2-RP8z_SGdPC2Gtz3A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaQEjSFWssYFcDY5_DA0Qi7S7gj41aefvjyhgCm7hlsQ&oe=6AD0DE96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Psycho Zombie Popstars", "keywords": ["apocalypse", "shooter", "zombie", "action", "platform"], "long_description": "The world is in danger of being consumed by the ultimate pop nightmare. An evil record label manager has unleashed a secret formula that transforms ordinary people into Psycho Zombie Popstars. His plan? To control the world by drowning it in glitter, screams, and mindless melodies.\n\nBut there\u2019s hope. You carry the cure \u2014 a powerful formula that can restore the infected back into hardworking citizens. Armed with your blasters, you\u2019ll battle hordes of zombie popstars across wild stages and surreal arenas, saving humanity one shot at a time.\n\n\ud83c\udfa4 Key Features:\n\nImmersive VR action \u2013 Grab your blasters and shoot with precision in fast-paced battles.\n\nSave humanity \u2013 Every cured popstar returns to normal life, bringing you closer to victory.\n\nEver-changing chaos \u2013 Survive waves of stylish, bizarre, and over-the-top enemies.\n\nFight for the future \u2013 Only you can stop the evil manager\u2019s plan for world domination.\n\nGet ready to shoot, cure, and rock your way through the ultimate VR showdown. The stage is set. The crowd is screaming. The world needs a hero.", "short_description": "Step into Psycho Zombie Popstars, a fast-paced VR shooter where the world is under threat from an evil record label manager\u2019s twisted formula. He\u2019s turning humanity into mindless zombie popstars to seize global control. Armed with a powerful cure, it\u2019s up to you to blast the infected back into ordinary hardworking citizens and save the world from a pop apocalypse!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.woopdidoo.studio/psychozombiepopstars/", "developer_terms_of_service_url": null, "publisher_name": "Woopdidoo", "support_website_url": null, "website_url": "https://www.woopdidoo.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscripti
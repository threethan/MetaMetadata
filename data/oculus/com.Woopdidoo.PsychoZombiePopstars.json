ombiePopstars-20250911-215043_1.png", "id": "793100737218926", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823837_793100740552259_4917552995018530600_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jQ3E0IvLnUQ7kNvwFTFpUt&_nc_oc=AdqXDSMvlD12pyQ7I_ZStHMtpubL6YmzORd-lRsJN69AeeP0rxfqZMO3vLJsX5qdqhg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTt90V-8vif7Dji0lbTnxUJMLfjRbmXLpAC71-UHil5mQ&oe=6B0B4124"}, {"file_name": "com.Woopdidoo.PsychoZombiePopstars-20250911-215152_1.png", "id": "752478304134165", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310646_752478307467498_2476173850354490979_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Y4que4ymdIQ7kNvwHi3cE0&_nc_oc=Adq4Ez1MDhY-VDjCGKckb806xegiGmPZH-xPhnJ4CKIQBdUgTvO61UyQfjmPbHwX_Lg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSTEGpcvC_xq67SxA1b00sX_g1KEKblz6fr-NzoVmWGEw&oe=6B0B3B08"}, {"file_name": "com.Woopdidoo.PsychoZombiePopstars-20250911-215314_1.png", "id": "1282947513518668", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307466_1282947516852001_1058487549666451053_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGSwxtG59pcQ7kNvwEQmENo&_nc_oc=Adrd8_nzu4nqi0GxyaVW2pjX422JMuAlJ_R3VlyWZE7CM_Y_XZ7EO1hDRNte68hQoLA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwgV_2HBhANTL3fDShZVTbuLm-5ym1sR_DdYBAVCzKrw&oe=6B0B2DDC"}, {"file_name": "com.Woopdidoo.PsychoZombiePopstars-20250911-215345_1.png", "id": "1258039466012301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303864_1258039472678967_7514410798782316676_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyAPIbSZo2cQ7kNvwFhmvC5&_nc_oc=AdpjenMa2E1Wdk3sp-ZcQNDQMAMa05G-MPe-OR_vTkyPhHP5FhX_1YDsI_2rbqgia9M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTIMaO_FnzTB7nCeUIYsUmKC_92dPyrOMGAV-5BVimjTA&oe=6B0B18D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Psycho Zombie Popstars", "keywords": ["apocalypse", "shooter", "zombie", "action", "platform"], "long_description": "The world is in danger of being consumed by the ultimate pop nightmare. An evil record label manager has unleashed a secret formula that transforms ordinary people into Psycho Zombie Popstars. His plan? To control the world by drowning it in glitter, screams, and mindless melodies.\n\nBut there\u2019s hope. You carry the cure \u2014 a powerful formula that can restore the infected back into hardworking citizens. Armed with your blasters, you\u2019ll battle hordes of zombie popstars across wild stages and surreal arenas, saving humanity one shot at a time.\n\n\ud83c\udfa4 Key Features:\n\nImmersive VR action \u2013 Grab your blasters and shoot with precision in fast-paced battles.\n\nSave humanity \u2013 Every cured popstar returns to normal life, bringing you closer to victory.\n\nEver-changing chaos \u2013 Survive waves of stylish, bizarre, and over-the-top enemies.\n\nFight for the future \u2013 Only you can stop the evil manager\u2019s plan for world domination.\n\nGet ready to shoot, cure, and rock your way through the ultimate VR showdown. The stage is set. The crowd is screaming. The world needs a hero.", "short_description": "Step into Psycho Zombie Popstars, a fast-paced VR shooter where the world is under threat from an evil record label manager\u2019s twisted formula. He\u2019s turning humanity into mindless zombie popstars to seize global control. Armed with a powerful cure, it\u2019s up to you to blast the infected back into ordinary hardworking citizens and save the world from a pop apocalypse!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.woopdidoo.studio/psychozombiepopstars/", "developer_terms_of_service_url": null, "publisher_name": "Woopdidoo", "support_website_url": null, "website_url": "https://www.woopdidoo.studio/", "category": null, "co
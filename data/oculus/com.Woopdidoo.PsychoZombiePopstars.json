=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lyact8eiBBkQ7kNvwE21BAY&_nc_oc=AdpeASZqS0oteQIEdk4J67NLQpXjCiXVTazoAawaY1zY3GW51LJhw_tf55ZbTL0XttQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW9sRW9Zy5RRqVcYXL_dOFjlNzt647cNrSja2nIXa3pg&oe=6AB670A4"}, {"file_name": "com.Woopdidoo.PsychoZombiePopstars-20250911-215152_1.png", "id": "752478304134165", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310646_752478307467498_2476173850354490979_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vY4p3ddCKMQ7kNvwGMHUbW&_nc_oc=Adr6G8NZgLFYy_5TwVgzYxRGXXgSIHpXY0rq9eNx5Y9Ig_tv5Z4qasxQ_5HtvSRTTPk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWuaHrL3QBGYhP_aagGnC_69LLstJKNI-GVru8-rICSg&oe=6AB66A88"}, {"file_name": "com.Woopdidoo.PsychoZombiePopstars-20250911-215314_1.png", "id": "1282947513518668", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307466_1282947516852001_1058487549666451053_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hIeMPGV0isQ7kNvwGIco-6&_nc_oc=AdqV2tupcMsgPw0BK6iTiH_KQ3Y8IQtysl8DzpcBDL0TySBPL69ZXbqCBxAp3gjgBSg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKTvIJ0Z1rnod3zmRKrdFmgyYTKAJelsHn_igTBFqBmA&oe=6AB6959C"}, {"file_name": "com.Woopdidoo.PsychoZombiePopstars-20250911-215345_1.png", "id": "1258039466012301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303864_1258039472678967_7514410798782316676_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwpB3mVaYMYQ7kNvwHgvEKr&_nc_oc=AdoYyiQOAIgAOS5dq6f8od6wvBPdHsT7Zegu_PWqjUz5qRWXwCDNRTcGOyLGqti_Tyc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM0EOpCk6QNNXxZ3hWKKMRrb2i5PFPvRiyxjjO3y8Pow&oe=6AB68096"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Psycho Zombie Popstars", "keywords": ["apocalypse", "shooter", "zombie", "action", "platform"], "long_description": "The world is in danger of being consumed by the ultimate pop nightmare. An evil record label manager has unleashed a secret formula that transforms ordinary people into Psycho Zombie Popstars. His plan? To control the world by drowning it in glitter, screams, and mindless melodies.\n\nBut there\u2019s hope. You carry the cure \u2014 a powerful formula that can restore the infected back into hardworking citizens. Armed with your blasters, you\u2019ll battle hordes of zombie popstars across wild stages and surreal arenas, saving humanity one shot at a time.\n\n\ud83c\udfa4 Key Features:\n\nImmersive VR action \u2013 Grab your blasters and shoot with precision in fast-paced battles.\n\nSave humanity \u2013 Every cured popstar returns to normal life, bringing you closer to victory.\n\nEver-changing chaos \u2013 Survive waves of stylish, bizarre, and over-the-top enemies.\n\nFight for the future \u2013 Only you can stop the evil manager\u2019s plan for world domination.\n\nGet ready to shoot, cure, and rock your way through the ultimate VR showdown. The stage is set. The crowd is screaming. The world needs a hero.", "short_description": "Step into Psycho Zombie Popstars, a fast-paced VR shooter where the world is under threat from an evil record label manager\u2019s twisted formula. He\u2019s turning humanity into mindless zombie popstars to seize global control. Armed with a powerful cure, it\u2019s up to you to blast the infected back into ordinary hardworking citizens and save the world from a pop apocalypse!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.woopdidoo.studio/psychozombiepopstars/", "developer_terms_of_service_url": null, "publisher_name": "Woopdidoo", "support_website_url": null, "website_url": "https://www.woopdidoo.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscripti
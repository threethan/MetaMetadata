-1.oculuscdn.com/v/t64.5771-25/75250458_468535435822747_1230677552996745658_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIf-s5lP0CIQ7kNvwHSBQX4&_nc_oc=Adp537Ap3KH8-QkhKhrlLp21uUNOLAJsusyzmh87lADWtlGubR67PWM4pAwWotZh99k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWZDmUcRh18kAO4JAmjbrLPfTsyX3ejJN_IJwG7T8hzbQ&oe=6B105174"}, {"file_name": "image_007_0005.png", "id": "477550874827704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982595_477550878161037_7113671620325822889_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0iPGr1AW-wQ7kNvwGovC9u&_nc_oc=AdqGgnsaGiwBk04EF3LA1YA09lsI8afuoQbxOGzs8VXnlbmpTXqzLDtsf0_z3JjOwCY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUpmBo1m1f6SFQUx199PqdvbmvVCWfWXlSwSNV2ki0iAQ&oe=6B1042E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spunky Monkey VR", "keywords": [], "long_description": "Welcome to this artificial facade of a reality where the leading species are monkeys who can transform into different species and move with their arms because they lack legs. Sounds pretty sick, doesn't it? Well, welcome to Spunky Monkey VR! A cartoony styled game based off of the widely popular game Gorilla Tag. In this game, you can explore the massive forest map the monkeys claimed as their natural habitat, a canyons where monkeys can swing and glide through the beautiful terraforming of the sandstone, a shop built by the monkeys where other monkeys can get in style, a deep cave found by the monkeys, but don't go there, reports have come that few monkeys came back alive, and an alternate reality where you can test and experience all of the things not yet added to the main thing.", "short_description": "Spunky Monkey VR is a hand-based locomotion game, and it's based around the popular virtual reality game, Gorilla Tag. Walk around in forest, climb in canyons, buy stuff in shop, and get jump scared in horror!
wETZu36&_nc_oc=AdollyIhqFGdMd2a3YMZQ2GFM67NsIKTwkYYZIenePL1DcsXj6AjIN8hxjxMrpBAsj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtqDI_d3RwT9qRV1B4mawzV2w0ml99VDWQifJwbGpPKQ&oe=6AF482B3"}, {"file_name": "Screenshot_speedbagMR.png", "id": "1564961942019750", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308050_1564961945353083_5436961975277312151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qf0Lz_MTGZsQ7kNvwGH0l36&_nc_oc=Adrim_jjOetWA8hKJnn3tqt83TMYluzVRoBA2-gR1_zNawjRuFVChy7z3fYT--aYc7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRFEHHs4Bd5eUADqSerVbXn0ggeaoEfPsn7CN0HIZUEg&oe=6AF4A37F"}, {"file_name": "leaderboard.png", "id": "1379838717665257", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829165_1379838720998590_3442699829920405357_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Io_78Fd4LN0Q7kNvwGKvoHW&_nc_oc=AdofKCEb9sdNCk4fllVTyJ2PWXWSdYtRqeWD9lO3vpkhfxNJbVyAfTpl7MOhepMU2NA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx0moU-dapapurI9NL9LrHK3QCQoDb3M2nh1S3fCX1JA&oe=6AF49574"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner6.png", "id": "1625924695834699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620599_1625924699168032_490818086782736582_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3T1w2bnXfwQ7kNvwH9AiUc&_nc_oc=AdoU4ovdxttuAzJEDHuxKnzmvpzPyw8VpbNh2hT4vNhUCdj4oPivPQo3LW2KJd_Z4KU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc2b7tnoNO7RNarA2dVl4vh6nr747eipaeRRzwKiv6Xw&oe=6AF48EBF"}, "display_name": "OmniPulse XR: Way to Fitness", "keywords": ["Fitness", "Cardio", "Training", "Boxing", "Gym"], "long_description": "Four coaches. 90+ workouts. Seven venues. VR boxing that blends high-intensity gaming with authentic athletic conditioning.\n\n* **Coaches In The Ring:** Luke, Maya, Elena and Marcus hold the pads, call every combo in their own voice, and slip, roll and step back as you work.\n{1414213087559836}\n\n* **Seven Venues:** Arena 1-3, Neon Rooftop, Atlantis Trench, Space Station and Mayan Summit. Pick your room for every workout.\n{1799494087914647}\n\n* **90 Structured Workouts:** Coach padwork, mitt rig, pair mitts and jump rope, across every difficulty and duration, with more updates to come.\n{1599249238458114}\n\n* **Jump Rope:** A real rope scaled to your height, with timed sessions, consistency scoring and integrated warmups.\n{1806078474057890}\n\n* **Custom Workout Creator:** Design, sequence and customize your own drills exactly the way you want.\n{1596452398736659}\n\n* **Stats & 100+ Achievements:** Track stamina, speed and precision, see your streaks on an activity heatmap, earn Energy and unlock 100+ skins for your gear.\n{1397912502240680}\n\n* **VR & MR Support:** Go fully virtual or bring the boxing ring into your living room with full spatial awareness.\n{1015240674608971}\n\n* **Leaderboards & Trophies:** Climb daily, weekly and monthly global boards for trophies and high-tier Energy payouts.\n{4389754828019080}", "short_description": "A coach stands in with you, holds the pads and calls every combo while you slip, roll, duck and jump. 90+ workouts across pad work, mitt rigs, pair mitts and jump rope. Train in seven venues, from the gym to a space station, or in mixed reality in your own room. Build custom combos, track speed, power and calories, climb the daily, weekly and monthly boards, and unlock 100+ skins for your gear. Your way to fitness starts now."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnipulsexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Mintanables", "support_website_url": null, "website_url": "https://www.omnipulsexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}]
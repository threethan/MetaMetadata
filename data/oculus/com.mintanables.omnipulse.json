sXavB37LY4doxrXoqG4es088GHx5IVUEhw3cCmCRemMCcGQx92THo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpSj30gypcX7wE-KoXA-UVJbg6KWgv8tiiunPFvF_KaA&oe=6A8C10C3"}, {"file_name": "Screenshot_mannquin.png", "id": "1455921659910266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312332_1455921663243599_6643511741037123083_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLF2pM4PeDIQ7kNvwFMF8b2&_nc_oc=AdqS6LRcSL0gGlfTPpQAGbRuEqsr19n14XAj8mGvUyCKRdKClVeg3gb5bLrg97uXZdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLArXeu8YR3bb-XLstWdpVRQrawGWHlr8EJ-nAMELWqA&oe=6A8C23F3"}, {"file_name": "Screenshot_speedbagMR.png", "id": "1564961942019750", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308050_1564961945353083_5436961975277312151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1fY3tSRW70Q7kNvwGLCiiS&_nc_oc=AdrrNtv03P0cpZRp1QCOknKrvK8R9yk_pSzYWMZkS_XkLWxq00B3wd3cd-j9mYwm3mU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0JOeh6iwt2his3YrLCqHTcHrxTf0MOgjO0oONYcZDWA&oe=6A8C44BF"}, {"file_name": "screenshot_speedbag.png", "id": "1992819631374870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620965_1992819634708203_976706635967688469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLubzKVcifMQ7kNvwFDstdX&_nc_oc=AdrMKUd3Dz4uvSbFb--qBcWASTDwaFO5nlkbPUm3ZrNh-5RA8grVvEZio-gKX8yB780&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRCAj2FMx1E9Mgzil5vyYsUCAXjoio5eNdxe_4lc_QZA&oe=6A8C33F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "foregroung+background.png", "id": "1382997423749370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828608_1382997433749369_1733001904524293920_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viM7oPs4RNIQ7kNvwHyP5WM&_nc_oc=AdqMMStVJczdq1pWwlgeu_qiNa4zUyOCmCU5ERna-45Z43RWkoIL4UHXKnA7IheXFQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVInXHY8pdKhZFcO7kJmnVvYm_qi0k4PG2TSUBx89KWg&oe=6A8C11A5"}, "display_name": "OmniPulse XR: Way to Fitness", "keywords": ["Fitness", "Cardio", "Training", "Boxing", "Gym"], "long_description": "Step into the ultimate VR boxing experience blending high-intensity gaming with authentic athletic conditioning. Perfect your striking form, torch calories, and sharpen your precision.\n\n* **75+ Structured Workouts:** Choose from a growing library of 75+ unique routines with varying difficulty and duration, with more updates to come.\n* **Rhythm & Mood:** High-energy music tracks with driving beats are paired with every section to encourage natural striking rhythms and elevate your mood.\n{1599249238458114}\n\n* **Custom Workout Creator:** If built-in routines aren't enough, design, sequence, and customize your own drills exactly the way you want.\n{1596452398736659}\n\n* **User Profile & Activity Heatmap:** Monitor in-depth stats tracking stamina, speed, and precision. Use the built-in activity heatmap to visually track your daily consistency and streaks.\n{1397912502240680}\n\n* **Missions & 100+ Achievements:** Stay motivated with rotating daily and weekly missions alongside over 100 long-term achievements to unlock. Progression rewards are coming soon!\n{3620667741419437}\n\n* **100+ Gear Skins:** Personalize your gym setup with more than 100 skins to customize your gloves, mitts, punching bags, speed bags, and training mannequins.\n{1385719143655358}\n\n* **VR & MR Support:** Go fully virtual to lock into your zone, or use Mixed Reality (MR) to transform your living room into a premium boxing studio while keeping full awareness of your home surroundings.\n{1015240674608971}\n\n\n* **Leaderboards:** Climb the ranks, compare points with friends, and dominate the daily, weekly, and monthly leaderboards.\n{4389754828019080}", "short_description": "Step into the ultimate virtual gym with OmniPulse XR, the premier VR boxing experience. Blend high-intensity gaming with authentic athletic conditioning to perfect your striking form, torch calories, and sharpen your precision. Build custom combos and track your speed and power in a fluid, heart-pumping workout environment. Strap on your headset, slip on your gloves, and find your rhythm. Your way to fitness starts now."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/mintanables/6b9fba8c19e6282279ab99793a960f5d", "developer_terms_of_service_url": null, "publisher_name": "Mintanables", "support_website_url": null, "website_url": "https://www.omnipulsexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1284979734690327"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622315_1076149515365472_2081456978498198634_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCUxssmF3PkQ7kNvwFtnSGr&_nc_oc=AdrV_seciHO3t8N3jdcq-O7zUZZc-uv1dabataGpNu4IoOB--p-KUDI3aMdAwHN2QB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4LW8K9lbgQ_RNdCtSIT9dfW-8jgf4TzPNCy8vMWmYzQ&oe=6A8C4019"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OmniPulse XR: Way to Fitness", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"
kNvwG1igH9&_nc_oc=AdqMqvF5dTff_SGrxKkeBd1DQx6LPuKauWk4wN7b5RTFz_Pj3y8CVzdMURjqn5D1WWw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwNmKPo4tnKjT7BoLoLLTZhfDg7RBx_zT_TCS3tFzF8A&oe=6AC90133"}, {"file_name": "Screenshot_speedbagMR.png", "id": "1564961942019750", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308050_1564961945353083_5436961975277312151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_EHLX5VcKwQ7kNvwHT1XSN&_nc_oc=AdoPJvKBUAZ_cKsb8kx-hYhN-B7yUPr037qODgGaGc_3cRW2YEq4EDRef1VQo3PohGI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAvmnr1tNQIObAtq4KcdDeJMXJ2wL-l6htkcZrgJ3gMQ&oe=6AC8E9BF"}, {"file_name": "leaderboard.png", "id": "1379838717665257", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491829165_1379838720998590_3442699829920405357_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOw-eIo56-YQ7kNvwGiYuQ3&_nc_oc=AdpDJzlofiT7bieJUPyxd9BJ217jYiELZJl3ogaDRhGZYUX7wXP1jaHNYtDXOeh0DVQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAllUgB6Tb-P8RCQiAQV-DbtvokLZLc4rLAsQW_elghQ&oe=6AC913F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner6.png", "id": "1625924695834699", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620599_1625924699168032_490818086782736582_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdD1PwdUa3UQ7kNvwETd6LF&_nc_oc=AdrnPrEVn6MMF50haOKlOY2yoEMKv7yjOyvUi-usCPOWEi5qZVVwT_pV2d91aMBqDVY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmt8g20xgGf_TUdYYshsOwz_qibYqORPOKb3k63SA6jA&oe=6AC90D3F"}, "display_name": "OmniPulse XR: Way to Fitness", "keywords": ["Fitness", "Cardio", "Training", "Boxing", "Gym"], "long_description": "Step into the ultimate VR boxing experience blending high-intensity gaming with authentic athletic conditioning. Perfect your striking form, torch calories, and sharpen your precision.\n\n* **75+ Structured Workouts:** Choose from a growing library of 75+ unique routines with varying difficulty and duration, with more updates to come.Train with ropes dynamically scaled to your height. Includes dedicated sessions, consistency scoring, and integrated warmups.\n\n* **Rhythm & Mood:** High-energy music tracks with driving beats are paired with every section to encourage natural striking rhythms and elevate your mood. \n{1599249238458114}\n\n* **Custom Workout Creator:** If built-in routines aren't enough, design, sequence, and customize your own drills exactly the way you want.\n{1596452398736659}\n\n* **User Profile & Activity Heatmap:** Monitor in-depth stats tracking stamina, speed, and precision. Use the built-in activity heatmap to visually track your daily consistency and streaks.\n{1397912502240680}\n\n* **Missions & 100+ Achievements:** Complete challenges, earn Energy, and smash open loot cubes to unlock 100+ skins for gloves, ropes, and bags.\n{3620667741419437}\n\n* **100+ Gear Skins:** Personalize your gym setup with more than 100 skins to customize your gloves, mitts, punching bags, speed bags, and training mannequins.\n{1385719143655358}\n\n* **VR & MR Support:** Go fully virtual or bring the boxing ring into your living room with full spatial awareness.\n{1015240674608971}\n\n* **Leaderboards & Trophies:** Climb daily, weekly, and monthly global boards to earn trophies and high-tier Energy payouts.\n{4389754828019080}", "short_description": "Step into the ultimate virtual gym with OmniPulse XR, the premier VR boxing experience. Blend high-intensity gaming with authentic athletic conditioning to perfect your striking form, torch calories, and sharpen your precision. Build custom combos and track your speed and power in a fluid, heart-pumping workout environment. Strap on your headset, slip on your gloves, and find your rhythm. Your way to fitness starts now."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/mintanables/6b9fba8c19e6282279ab99793a960f5d", "developer_terms_of_service_url": nul
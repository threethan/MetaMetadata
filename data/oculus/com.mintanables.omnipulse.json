bQYJs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwM1xncpONgNpB86w8LCgcZYWlHsZnFRkmj17zwdcOFw&oe=6A8990F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "foregroung+background.png", "id": "1382997423749370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828608_1382997433749369_1733001904524293920_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0K-RHPxUKs4Q7kNvwHq5es_&_nc_oc=Adrb9JdpRERpjdwLy1RwfTJz5ZpzBYo1CsqyERtc9n1nvcJ6r3WrinvtDjp-qW6o1zk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_SzpNy_7alel0LrHK4c1JGYZef6eTeKCA9xru3xvxQg&oe=6A896EA5"}, "display_name": "OmniPulse XR: Way to Fitness", "keywords": ["Fitness", "Cardio", "Training", "Boxing", "Gym"], "long_description": "Step into the ultimate VR boxing experience blending high-intensity gaming with authentic athletic conditioning. Perfect your striking form, torch calories, and sharpen your precision.\n\n* **75+ Structured Workouts:** Choose from a growing library of 75+ unique routines with varying difficulty and duration, with more updates to come.\n* **Rhythm & Mood:** High-energy music tracks with driving beats are paired with every section to encourage natural striking rhythms and elevate your mood.\n{1690882088858969}\n\n* **Custom Workout Creator:** If built-in routines aren't enough, design, sequence, and customize your own drills exactly the way you want.\n{1522290809580575}\n\n* **User Profile & Activity Heatmap:** Monitor in-depth stats tracking stamina, speed, and precision. Use the built-in activity heatmap to visually track your daily consistency and streaks.\n{973733835717972}\n\n* **Missions & 100+ Achievements:** Stay motivated with rotating daily and weekly missions alongside over 100 long-term achievements to unlock. Progression rewards are coming soon!\n{1518375759741115}\n\n* **100+ Gear Skins:** Personalize your gym setup with more than 100 skins to customize your gloves, mitts, punching bags, speed bags, and training mannequins.\n{1762794291748344}\n\n* **VR & MR Support:** Go fully virtual to lock into your zone, or use Mixed Reality (MR) to transform your living room into a premium boxing studio while keeping full awareness of your home surroundings.\n{1430366912297434}\n", "short_description": "Step into the ultimate virtual gym with OmniPulse XR, the premier VR boxing experience. Blend high-intensity gaming with authentic athletic conditioning to perfect your striking form, torch calories, and sharpen your precision. Build custom combos and track your speed and power in a fluid, heart-pumping workout environment. Strap on your headset, slip on your gloves, and find your rhythm. Your way to fitness starts now."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/mintanables/6b9fba8c19e6282279ab99793a960f5d", "developer_terms_of_service_url": null, "publisher_name": "Mintanables", "support_website_url": null, "website_url": "https://www.omnipulsexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1214607125060922"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1694696345116084"}]}, "baseline_offer": {"id": "1694696345116084"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784386140, "status": "PUBLISHED", "id": "1694696345116084"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1284116768109957", "version": "0.5"}, "id": "1334710888020572", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1214607111727590", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1284116768109957"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1334710888020572"}]}, "change_log": "\u2022 Much smoother performance - we eliminated the periodic stutter some players saw every few seconds, smoothed out the Shop / Achievements / Workouts panels, and cut app startup work so you get into your gym quicker.\r\n\u2022 New player onboarding - a guided first-launch tutorial that walks you through your first punches, plus a full interface tour of every panel (tap the guide icon in Settings to replay it).\r\n\u2022 Cloud sync - your profile, progress, and workout history now sync to the cloud, so your stats are safe and follow your account.\r\n\u2022 Leaderboards - see how you rank against other players, right beside your home menu.\r\n\u2022 New training gear - the new speed bag, refreshed boxing ring, and improved mitt drills (including paired mitts).\r\n\u2022 Glove aura - hold grip to reveal your glove aura, cycle styles with B, and see aura hints on mannequin and mitt targets.\r\n\u2022 Quality of life - controller keymap reference, haptic feedback with an info toggle, energy rewards for mission milestones, profile pictures, clearer labels, and a privacy policy link in your profile.\r\n\u2022 Bug Fixes - resolved a freeze when returning to the menu after a workout, music playback lag, panels drifting or misaligning, and many smaller bugs.", "created_date": 1785781093, "id": "1284116768109957", "version": "0.5", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1214607111727590", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1284116768109957"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1334710888020572"}]}, "change_log": "\u2022 Much smoother performance - we eliminated the periodic stutter some players saw every few seconds, smoothed out the Shop / Achievements / Workouts panels, and cut app startup work so you get into your gym quicker.\n\u2022 New player onboarding - a guided first-launch tutorial that walks you through your first punches, plus a full interface tour of every panel (tap the guide icon in Settings to replay it).\n\u2022 Cloud sync - your profile, progress, and workout history now sync to the cloud, so your stats are safe and follow your account.\n\u2022 Leaderboards - see how you rank against other players, right beside your home menu.\n\u2022 New training gear - the new speed bag, refreshed boxing ring, and improved mitt drills (including paired mitts).\n\u2022 Glove aura - hold grip to reveal your glove aura, cycle styles with B, and see aura hints on mannequin and mitt targets.\n\u2022 Quality of life - controller keymap reference, haptic feedback with an info toggle, energy rewards for mission milestones, profile pictures, clearer labels, and a privacy policy link in your profile.\n\u2022 Bug Fixes - resolved a freeze when returning to the menu after a workout, music playback lag, panels drifting or misaligning, and many smaller bugs.\n", "created_date": 1785705471, "id": "1282724461582521", "version": "0.4", "version_code": 4, "release_status": "PENDING", "
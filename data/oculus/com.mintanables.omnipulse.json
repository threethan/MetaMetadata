&_nc_oc=Adop5Fr-z2__8-s11KTQlmLFh7gBS4KhgK3-INuLb1bqRlOwIRhHx78Us038HNrC2mc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRNzzwLIsdV8B8RxIkO3O4Omofa60c-PetMYtQ4XLVow&oe=6B05C555"}, {"file_name": "Screenshot_mannquin.png", "id": "1455921659910266", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312332_1455921663243599_6643511741037123083_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM6wn4WgmKUQ7kNvwGmfeYn&_nc_oc=AdrmtTfsMfksiQ3QlBam0xFiY3zJlTpKZoOWL4Y5NVRjhHQYdhFI6upmtqZFfbsTm24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQktN0E9Ox6nSrYWjTQ8eVf930VyBecZ0YgKSmSHqCQPg&oe=6B05A633"}, {"file_name": "Screenshot_speedbagMR.png", "id": "1564961942019750", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308050_1564961945353083_5436961975277312151_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LnXVPtVaJEQ7kNvwFfZA44&_nc_oc=AdocQL192k7p8Y1GLP-etyFjIAs-AIHvMsEsyZgxRVlGVAZDhRKsF_ESv2tykrutJ6E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtEGaJeCmsCtAG1sn5sEVLXE7nmgEIjlJNLtxXUUKIxQ&oe=6B05C6FF"}, {"file_name": "leaderboard.png", "id": "1379838717665257", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829165_1379838720998590_3442699829920405357_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLfU9ySpVmwQ7kNvwHJN10d&_nc_oc=AdpOeT5i_Y82tb96MGGxVBqd63Uy1X3UP--HS35uYTU_Ok7a4kNMg2s0JHeNPsvw3eA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK64Zf80FSG61VuXZUCDMdY66twOnDsG-BrrABTrLJNQ&oe=6B05B8F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner6.png", "id": "1625924695834699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620599_1625924699168032_490818086782736582_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9BgrQSrbXAQ7kNvwFfTOuz&_nc_oc=Ado5iqnJeIyARScoq5m7ZTsqQtBVCZC5wJ07PHTo8UVnij_AzrI_UJ3qBJ0YxmG6ZyY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi6IWuMRakaCBUAqgJiczQzByvz_g6RbnHZgxtdZ7FcQ&oe=6B05B23F"}, "display_name": "OmniPulse XR: Way to Fitness", "keywords": ["Fitness", "Cardio", "Training", "Boxing", "Gym"], "long_description": "Four coaches. 90+ workouts. Seven venues. VR boxing that blends high-intensity gaming with authentic athletic conditioning.\n\n* **Coaches In The Ring:** Luke, Maya, Elena and Marcus hold the pads, call every combo in their own voice, and slip, roll and step back as you work.\n{1414213087559836}\n\n* **Seven Venues:** Arena 1-3, Neon Rooftop, Atlantis Trench, Space Station and Mayan Summit. Pick your room for every workout.\n{1799494087914647}\n\n* **90 Structured Workouts:** Coach padwork, mitt rig, pair mitts and jump rope, across every difficulty and duration, with more updates to come.\n{1599249238458114}\n\n* **Jump Rope:** A real rope scaled to your height, with timed sessions, consistency scoring and integrated warmups.\n{1806078474057890}\n\n* **Custom Workout Creator:** Design, sequence and customize your own drills exactly the way you want.\n{1596452398736659}\n\n* **Stats & 100+ Achievements:** Track stamina, speed and precision, see your streaks on an activity heatmap, earn Energy and unlock 100+ skins for your gear.\n{1397912502240680}\n\n* **VR & MR Support:** Go fully virtual or bring the boxing ring into your living room with full spatial awareness.\n{1015240674608971}\n\n* **Leaderboards & Trophies:** Climb daily, weekly and monthly global boards for trophies and high-tier Energy payouts.\n{4389754828019080}", "short_description": "A coach stands in with you, holds the pads and calls every combo while you slip, roll, duck and jump. 90+ workouts across pad work, mitt rigs, pair mitts and jump rope. Train in seven venues, from the gym to a space station, or in mixed reality in your own room. Build custom combos, track speed, power and calories, climb the daily, weekly and monthly boards, and unlock 100+ skins for your gear. Your way to fitness starts now."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnipulsexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Mintanables", "support_website_url": null, "website_url": "https://www.omnipulsexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1458842540637378"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_1076149515365472_2081456978498198634_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfr3hueocDQQ7kNvwEaY5Bm&_nc_oc=AdrvWUSlV7mzfdNme-QqjEQTSj2zjiSwCh-uYYArErq48Tte18N14W9jgmCqoeIOaCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu6orMrKWaH1hY8RSbChmwd5trfsYpfEl9CiQfKykCTA&oe=6B05C259"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OmniPulse XR: Way to Fitness", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1784386140, "lastRevision": {"nodes": [{"id": "1214607135060921", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_
NKwv&_nc_oc=AdrDJu2xLOZulMCKl9iEzSCgN22gJzNHbw5prH3zntx0JLvQG6LzQtcZhjaNGmdl0I8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVVhyUtXQnID2OhUN6YLqPcb-6DTPhTM0qFMA_zF0VAw&oe=6A660D83"}, {"file_name": "Screenshot_mannquin.png", "id": "1455921659910266", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312332_1455921663243599_6643511741037123083_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2hfBa9Cl6MQ7kNvwHUZUqY&_nc_oc=Adrnz0poZ8lxOluKhQbOkdN0cLeL2ICbxE6fK-qOpnKa9AgVRI0jgrgJoy-lDwNSMWU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd9dLR3B7h-r-p6wvH2VqwuiA0xxTZ93KB5-50N7N5Uw&oe=6A6620B3"}, {"file_name": "Screenshot_speedbagMR.png", "id": "1564961942019750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308050_1564961945353083_5436961975277312151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_M9vq0fGocQ7kNvwEa_uWg&_nc_oc=Adp8G0tCggguqhNejHn7Lj5c2WGk1UnfvnVGKc4SFyqPfdJM5pC-JK_3ByjOQbDHLBw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPYaUlyv0_zKEPDPXyJJGZQQLh9Sa9w-qy2MPIs7B6jg&oe=6A66093F"}, {"file_name": "screenshot_speedbag.png", "id": "1992819631374870", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620965_1992819634708203_976706635967688469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXrrJ9DQHpoQ7kNvwETxZYO&_nc_oc=AdpRNK-KN59L4J2xaaVpaMphk_yigLGXnxIasDOlx4HQvzrx_TuUj6MkOEPxBL46U2M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYdpfiEIzsXDqzwIu10RDoCa2ad1STXXyK0IVdBtmkRw&oe=6A65F877"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "foregroung+background.png", "id": "1382997423749370", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491828608_1382997433749369_1733001904524293920_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6AzXviPtbAQ7kNvwEJ39TF&_nc_oc=Ador_inls2Dhs2TeQIlrayPTtXW8ooH1TXSGeFQrODEbP0Tea0qk6UBFelazI_lIofk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB50OlECNi0pKUWf2VmTdkFhCxzfVmN0Llr1a0Hepa5Ww&oe=6A660E65"}, "display_name": "OmniPulse XR: Way to Fitness", "keywords": ["Fitness", "Cardio", "Training", "Boxing", "Gym"], "long_description": "Step into the ultimate VR boxing experience blending high-intensity gaming with authentic athletic conditioning. Perfect your striking form, torch calories, and sharpen your precision.\n\n* **75+ Structured Workouts:** Choose from a growing library of 75+ unique routines with varying difficulty and duration, with more updates to come.\n* **Rhythm & Mood:** High-energy music tracks with driving beats are paired with every section to encourage natural striking rhythms and elevate your mood.\n{1690882088858969}\n\n* **Custom Workout Creator:** If built-in routines aren't enough, design, sequence, and customize your own drills exactly the way you want.\n{1522290809580575}\n\n* **User Profile & Activity Heatmap:** Monitor in-depth stats tracking stamina, speed, and precision. Use the built-in activity heatmap to visually track your daily consistency and streaks.\n{973733835717972}\n\n* **Missions & 100+ Achievements:** Stay motivated with rotating daily and weekly missions alongside over 100 long-term achievements to unlock. Progression rewards are coming soon!\n{1518375759741115}\n\n* **100+ Gear Skins:** Personalize your gym setup with more than 100 skins to customize your gloves, mitts, punching bags, speed bags, and training mannequins.\n{1762794291748344}\n\n* **VR & MR Support:** Go fully virtual to lock into your zone, or use Mixed Reality (MR) to transform your living room into a premium boxing studio while keeping full awareness of your home surroundings.\n{1430366912297434}\n", "short_description": "Step into the ultimate virtual gym with OmniPulse XR, the premier VR boxing experience. Blend high-intensity gaming with authentic athletic conditioning to perfect your striking form, torch calories, and sharpen your precision. Build custom combos and track your speed and power in a fluid, heart-pumping workout environment. Strap on your headset, slip on your gloves, and find your rhythm. Your way to fitness starts now."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/mintanables/6b9fba8c19e6282279ab99793a960f5d", "developer_terms_of_service_url": null, "publisher_name": "Mintanables", "support_website_url": null, "website_url": "https://www.omnipulsexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1214607125060922"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823296_1049094197797214_6722757001730352052_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eS5Vz3ahlgQ7kNvwFYxMQP&_nc_oc=AdrtvI79qi70ZUQQcnsr0WuvxFG7NnbHKjsJC-aXNu4MJPrM-O6t_VVy1ir7ymZ_Mp0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDz0SCETgRlr-DeywCmCZbfAUnRAqUIV6tXUBmJLFfvEg&oe=6A65F454"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OmniPulse XR: Way to Fitness", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1784386140, "lastRevision": {"nodes": [{"id": "12146071
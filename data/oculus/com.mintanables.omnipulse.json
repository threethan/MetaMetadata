rQDRTz1jKLaSaFiWg2X_Gss0Q&oe=6ADF5783"}, {"file_name": "Screenshot_mannquin.png", "id": "1455921659910266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312332_1455921663243599_6643511741037123083_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9bHvtf0TJUQ7kNvwGtzGdV&_nc_oc=AdrD-bE6T85apFzRVStS0S6s738eCgl9EKYlMxNMi0ytoQCNw8zUHM2yWjrA0ejRFgE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo9_s7HLGF6HF_b2XCh0592zYY4WZa1wj8Br-cVGJ-Sg&oe=6ADF6AB3"}, {"file_name": "Screenshot_speedbagMR.png", "id": "1564961942019750", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308050_1564961945353083_5436961975277312151_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keGqEut_UpUQ7kNvwHnVxvq&_nc_oc=Adq3bAiOytcncO8Fifbj1NlAH7PtHmGPQSvREcxwKZCUqZNFZAAZvmVysWCpkOKZo7s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVhBy_dOa1qZRF0k2O8D-RMkoZZQnV6Ldn_hMDnkofdw&oe=6ADF533F"}, {"file_name": "screenshot_speedbag.png", "id": "1992819631374870", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620965_1992819634708203_976706635967688469_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEpuzezL5bAQ7kNvwGpSvY1&_nc_oc=AdobXHgGc7Aj87q98xb6HXDdAwBaXm5Rg3icK_m6zB-amNxzIGpyU2FQX-imF5B7HVQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO4d3K-0aOAX9qV29oeTKr9_jQqdxYMgTx4GkaW4gUgg&oe=6ADF7AB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "foregroung+background.png", "id": "1382997423749370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828608_1382997433749369_1733001904524293920_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwDC0h6dxMIQ7kNvwEoa7mb&_nc_oc=AdrfJNWq03Iok023B7ur_3lvAO2AbF1SzRI1zDKgm7mE-4TBnKDSA_1TbK1iXoPX7oQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEzba-q3VJMC68n_sgVpjNy2gch6ZVEpBuc6Q2Sn45Qw&oe=6ADF5865"}, "display_name": "OmniPulse XR: Way to Fitness", "keywords": ["Fitness", "Cardio", "Training", "Boxing", "Gym"], "long_description": "Step into the ultimate VR boxing experience blending high-intensity gaming with authentic athletic conditioning. Perfect your striking form, torch calories, and sharpen your precision.\n\n* **75+ Structured Workouts:** Choose from a growing library of 75+ unique routines with varying difficulty and duration, with more updates to come.\n* **Rhythm & Mood:** High-energy music tracks with driving beats are paired with every section to encourage natural striking rhythms and elevate your mood.\n{1690882088858969}\n\n* **Custom Workout Creator:** If built-in routines aren't enough, design, sequence, and customize your own drills exactly the way you want.\n{1522290809580575}\n\n* **User Profile & Activity Heatmap:** Monitor in-depth stats tracking stamina, speed, and precision. Use the built-in activity heatmap to visually track your daily consistency and streaks.\n{973733835717972}\n\n* **Missions & 100+ Achievements:** Stay motivated with rotating daily and weekly missions alongside over 100 long-term achievements to unlock. Progression rewards are coming soon!\n{1518375759741115}\n\n* **100+ Gear Skins:** Personalize your gym setup with more than 100 skins to customize your gloves, mitts, punching bags, speed bags, and training mannequins.\n{1762794291748344}\n\n* **VR & MR Support:** Go fully virtual to lock into your zone, or use Mixed Reality (MR) to transform your living room into a premium boxing studio while keeping full awareness of your home surroundings.\n{1430366912297434}\n", "short_description": "Step into the ultimate virtual gym with OmniPulse XR, the premier VR boxing experience. Blend high-intensity gaming with authentic athletic conditioning to perfect your striking form, torch calories, and sharpen your precision. Build custom combos and track your speed and power in a fluid, heart-pumping workout environment. Strap on your headset, slip on your gloves, and find your rhythm. Your way to fitness starts now."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/mintanables/6b9fba8c19e6282279ab99793a960f5d", "developer_terms_of_service_url": null, "publisher_name": "Mintanables", "support_website_url": null, "website_url": "https://www.omnipulsexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1214607125060922"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1694696345116084"}]}, "baseline_offer": {"id": "1694696345116084"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784386140, "status": "PUBLISHED", "id": "1694696345116084"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1410215138833452", "version": "0.40"}, "id": "1334710888020572", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1214607111727590", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1410215138833452"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1334710888020572"}]}, "change_log": "*  New venues - work out in the Neon Rooftop, Atlantis Trench, Space Station or Mayan Summit.\r\n* Jump dodge - a new move to get your heart rate up and blood pumping. Mitt rig and pair mitts only. Coach padwork does not have it.\r\n* Pick your venue - seven rooms: Arena 1, 2 and 3, Neon Rooftop, Atlantis Trench, Space Station and Mayan Summit. Each workout opens on its own. A change lasts for that session.\r\n* The edge of the floor - a light wall appears when you reach it. Step past it and the workout pauses, and the room goes to passthrough. Step back and your view returns. The pause menu stays up until you resume.\r\n*  Every coach on the rush - Elena and Marcus hold the round mitt in both hands, the same as Luke and Maya.\r\n*  The whole room in the clip - spectator recordings of the themed venues take in the scenery out to the horizon, instead of cutting it off close in.\r\n*  A calmer coach - between rounds they breathe in their stance. On pause they leave the frame, and the panels no longer cover them. Elena's shirt and portrait are updated.\r\n*  Bug fixes - a fist no longer pauses the workout by itself. Turning a workout type off hides that type, including sessions that mix in a rope warmup. The V gesture records again with hand tracking. A slip away from the punch now scores. Jump rope runs for the full time, and the count starts over each time you hit the target. Fingers no longer show through the pads. If the workout data did not finish downloading, you still land in the home gym, with a prompt to reconnect and update.", "created_date": 1791733149, "id": "1410215138833452", "version": "0.40", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "1410213712166928"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1214607111727590", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1410215138833452"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1334710888020572"}]}, "change_log": "\u2022 Four coaches - Luke, Maya, Elena and Marcus stand in with you, hold the pads and call every\r\ncombo.\r\n\r\n\u2022 Your pick - choose them in Settings. \r\n\r\n\u2022 Pads and round mitts - focus mitts for padwork, and a round mitt held in both hands for rush\r\nrounds, in the style you already own.\r\n\r\n\u2022 They move with you - slips, rolls and a step back. A duck on the coach is a roll. Maya and\r\nElena match your height.\r\n\r\n\u2022 Pads that answer - a ripple across the mitt when a punch lands.\r\n\r\n\u2022 Your first session - onboarding now walks through with the coach.\r\n\r\n\u2022 Their own voice - Luke, Maya, Elena and Marcus each call the punches, the rest and the\r\nencouragement.\r\n\r\n\u2022 Cleaner calls - every punch name was re-recorded and re-cut, so the word lands on the move.\r\n\r\n\u2022 Rush - they call \"rush\" when a rush round starts.\r\n\r\n\u2022 In time - onboarding is now Luke and Maya, timed to the animation instead of\r\none long track.\r\n\r\n\u2022 See the type - every card says what the session is: padwork with a coach, mitt rig, pair mitts\r\nor jump rope.\r\n\r\n\u2022 Filter the list - turn those types on and off so you only see the workouts you want.\r\n\r\n\u2022 Skip this session - from the pause menu, skip the current session and keep the workout going.", "created_date": 1790456778, "id": "1376013712253595", "version": "0.30", "version_code": 30, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "1376013362253630"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1214607111727590", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1410215138833452"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1334710888020572"}]}, "change_log": "\u2022 Your stats on the web - pair your headset with omnipulsexr.com. Settings \u2192 the \u24d8 icon \u2192 PAIR\r\nWITH APP shows a 6-digit code; type it on the site and that browser can read your stats. It's\r\nread-only, it can only ever see your own account, and one tap in the headset unpairs everything.\r\n\r\n\u2022 Hands on the rope - on controllers you now see your own hand closed around each rope handle,\r\nwearing your chosen hand skin, instead of a handle floating in mid-air.\r\n\r\n\u2022 Know your rope space - a heads-up before a rope section when your guardian area is too tight\r\nor you're standing near its edge, which is what was flipping the view to passthrough mid-skip.\r\n\r\n\u2022 Which way to turn - a card beside you during rope sections showing the direction to swing the\r\nrope, with a \"Don't show again\" once you've got it.\r\n\r\n\u2022 A better shadow boxer - the mirror avatar now stands in a proper squared boxing stance, turns\r\nits feet with you, slides less, and leaves the floor when you jump.\r\n\r\n\u2022 Hand skins - ten new hand styles in the OmniPulse Shop, with fresh normals and glow maps.\r\n\r\n\u2022 Spectator camera - record a third-person clip or photo of your workout straight to your\r\ngallery, framed how you like: four shapes, five camera moves, height, angle and distance, with a\r\nlive 3D preview of the shot.\r\n\r\n\u2022 Quality of life - a new splash screen, sharper medals, and Account & Support moved to its own\r\n\u24d8 card in Settings.\r\n\r\n\u2022 Bug Fixes - recording no longer costs frame rate, the stop button is reliable, panel backs\r\nstay out of your clips, and the rope no longer interferes with the glove glow.", "created_date": 1788112631, "id": "1330471566807810", "version": "0.20", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1214607111727590", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1410215138833452"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1334710888020572"}]}, "change_log": "\u2022 Jump Rope is here - a real rope in both hands, sized to your height. Ten timed rope sessions,\r\nrope warmups mixed into 20 existing workouts, a live consistency meter that rewards a steady\r\nrhythm, and five rope styles in the OmniPulse Shop.\r\n\r\n\u2022 Leaderboard rewards - finish in the top 3 of the daily, weekly or monthly board and earn\r\nEnergy - up to 1000 for a monthly win. You'll be told on your next visit, even if you missed the\r\nfinish.\r\n\r\n\u2022 Punch open your reward - your winnings arrive inside a metal cube. Hit it three times to\r\ncrack it open and watch your Energy tumble out.\r\n\r\n\u2022 Energy that follows you - your Energy balance and everything you've unlocked in the shop now\r\nlive with your account, so switching or reinstalling keeps your gear. Mission milestones pay out\r\nmore Energy than before.\r\n\r\n\u2022 Jump Rope tracking - rope reps count toward your stats, charts, calories and achievements,\r\nwith new rope-specific goals to chase.\r\n\r\n\u2022 Trophies on your profile - your leaderboard finishes are collected in lifetime stats.\r\n\r\n\u2022 Quality of life - a What's New card after each update, NEW badges on fresh workouts and shop\r\nitems so you can spot them at a glance.\r\n\r\n\u2022 Bug Fixes - the session no longer auto-pauses mid workout, no spike in performance, quicker start time, controller-held rope handles sit correctly in your hands, onboarding completion is reported properly, and a number of smaller fixes.", "created_date": 1787327999, "id": "1316166598238307", "version": "0.16", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1214607111727590", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1410215138833452"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1334710888020572"}]}, "change_log": "\u2022 Jump Rope is here - a real rope in both hands, sized to your height. Ten timed rope sessions,\r\nrope warmups mixed into 20 existing workouts, a live consistency meter that rewards a steady\r\nrhythm, and five rope styles in the OmniPulse Shop.\r\n\r\n\u2022 Leaderboard rewards - finish in the top 3 of the daily, weekly or monthly board and earn\r\nEnergy - up to 1000 for a monthly win. You'll be told on your next visit, even if you missed the\r\nfinish.\r\n\r\n\u2022 Punch open your reward - your winnings arrive inside a metal cube. Hit it three times to\r\ncrack it open and watch your Energy tumble out.\r\n\r\n\u2022 Energy that follows you - your Energy balance and everything you've unlocked in the shop now\r\nlive with your account, so switching or reinstalling keeps your gear. Mission milestones pay out\r\nmore Energy than before.\r\n\r\n\u2022 Jump Rope tracking - rope reps count toward your stats, charts, calories and achievements,\r\nwith new rope-specific goals to chase.\r\n\r\n\u2022 Trophies on your profile - your leaderboard finishes are collected in lifetime stats.\r\n\r\n\u2022 Quality of life - a What's New card after each update, NEW badges on fresh workouts and shop\r\nitems so you can spot them at a glance.\r\n\r\n\u2022 Bug Fixes - the session no longer auto-pauses mid workout, no spike in performance, quicker start time, controller-held rope handles sit correctly in your hands, onboarding completion is reported properly, and a number of smaller fixes.", "created_date": 1787252773, "id": "1314785745043059", "version": "0.15", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
25/12138804_322399771450726_3215021061028446208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-S2G6WIOgsQ7kNvwHrDm1E&_nc_oc=Adq-ANifHXEa8GCDfiOiR3sxfxzgKm9WcTso3WTl2YHQyIDSrx2cJ0njBUOhUabctGE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_u910Iq9O9-OhcvGx0RZBfh3jXn9fkAwgOGupuiXBtA&oe=6AA94C0D"}, {"file_name": "migrated_image.png", "id": "814838319019730", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12602238_211985769231165_1372716391555137536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENju88VpojMQ7kNvwHysi9G&_nc_oc=AdraeFFCY0evDHRCELLdU1I0X33pTErvy2S_O4aI6tkiT2ipd8GlJj26muB7GBaZb14&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFz2psKRsFMUMTNNiSvmjrkuEQr2DLJ2OyY1TOeLWt0g&oe=6AA935D4"}, {"file_name": "migrated_image.png", "id": "2602847149972297", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BiF1rMXJJgQ7kNvwGMQE2h&_nc_oc=AdrJH529_FfuE0wI3G3MezTDjm42Ia8FhEtQTqcEOda6jXTFXmW7uFtyT4IB2dvAJyA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZQKKlXYa0TaKl0leUBPx-N1l-slQBeqzC4sYUDdUA8Q&oe=6AA95B98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628810475039334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12680539_298805783828083_1949650017_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QY_A0cf2bqUQ7kNvwEGCJDn&_nc_oc=AdqQfV2hUHEHUhCQt6xJUrnyTXowFVALcvnJkztHNl3w0Iaya5eRM70YHLljBefeXXM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI38Z2nAZq0vZtOvqqqtmnMhRpoKPiwFDF9zsFd8uw6Qw&oe=6AA954C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Garden", "platform": "ANDROID",
nc_oc=Adn_qFgItF28CVcVeoLnK4xxPXvCvLbtKSvmD-d1cgS1P8WREbmKg9DR9L-R1SL9ong&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft8rCcZOpvrdymboQ0Mx4rQpcC1FgduLxC2fL4bjncOWA&oe=69A2F18D"}, {"file_name": "migrated_image.png", "id": "814838319019730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602238_211985769231165_1372716391555137536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHA7nh-EXgsQ7kNvwHNIOcm&_nc_oc=AdmNuvZD2l6JJPjixZCipXw-NvX1csSQYUJw_lKYbc71TPHIitE7YY3qiw25XhHDvE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuxm3xDiFWZC2c1kabnmrFlOo_otQ3IY_pDCq0Tnez4EA&oe=69A2DB54"}, {"file_name": "migrated_image.png", "id": "2602847149972297", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aUsYvvQmi4Q7kNvwGOj9af&_nc_oc=AdkgSZY9qWxnmdI742ntQJD7G8_Xb10vOjvDorRtOpRa48vWXLc_E_76j9lStdJv2Y8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftfmiF7RCjmdrUXgAHmIp8KCqQjsbXjWWvVmJbN4Pd9gQ&oe=69A2C8D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628810475039334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12680539_298805783828083_1949650017_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uvaopb4NG4Q7kNvwFcY5ez&_nc_oc=AdldK_ZJsDe7WUh0Q6_7zoeCWYOGGUnd_EMduGzscQdyp_Y4JyX_fMG8nasLEcyAKlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftQs0RVLmxqV_r_L27iw3TF9j9lZK8RbpmJd35RHNPzqA&oe=69A2FA40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Garden", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478070000, "lastRevision": {"nodes": [{"id": "1085868858162280", "release_type": "SCHEDULED", "administration_sta
446208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQQIQzCyzjYQ7kNvwHSksJh&_nc_oc=AdkokE9rJ3q-udY4HV31Yn6QBwWwS-26-5eKTPxRqd7W7TT5jsVsUz2EhlywUmiiNTk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlEzKUKhWu_4HNHc61m_hMMrg73DzsL3WyxChpfVS55w&oe=69BEA10D"}, {"file_name": "migrated_image.png", "id": "814838319019730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602238_211985769231165_1372716391555137536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF27yDsoPAkQ7kNvwG0Jcqh&_nc_oc=AdlHLbEp1pF8RjZBC60P_-xLKX52N0Hu3dGnB4lwb3e12GmqfY0kXY9QC06NA2wVyE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqO6s8l7vdolIso4pjluDhwBrLD6pFVgAJ_f5KKAwBDw&oe=69BE8AD4"}, {"file_name": "migrated_image.png", "id": "2602847149972297", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8QCBkwyAhYQ7kNvwGL9kYq&_nc_oc=Adkl0vfaksaC4GDA-d7O9WhsICRdyNb5QFb5A-Q6s7USeXxWiM9-Riiz5RpVmpsGF6A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxyz4K9tN0dqWJ2c5iL-0NnwrM2-J1BRmNGSZjpjMBtnA&oe=69BE7858"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628810475039334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680539_298805783828083_1949650017_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS7ZxVDsdPQQ7kNvwGxYuEY&_nc_oc=AdmBS8SwRc_h5X1GlHYfx_Uy4Rz9zCZSx-ncaD1bZhBNH9gWZA63oaUw7mYa26qeuFY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxy2xFdLF8t8sNDZQvgnrKyNY3dNa9CuWVI8eVxnbEh9g&oe=69BEA9C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Garden", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date
nc_oc=AdnFiBpDuCDEMMwgA6HSvFTMrgwi57qNkSyl49301SC3jrg1YIbl_maWmrBngz1GEt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvjHEGPYtQsBQb-o_IgQcdjGje7uvrCVTrS-IyUxoXPXg&oe=69A4430D"}, {"file_name": "migrated_image.png", "id": "814838319019730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602238_211985769231165_1372716391555137536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHA7nh-EXgsQ7kNvwG0zuMN&_nc_oc=AdnCtBUB2IlV4ckA0EBw03e9r5Qrgxp-aOgfIi_KnL8YuDLLaQ54tesX-oi9r4y9cjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsi3wMAAWOOdFFl37DH0B567AXzk8zM-8xXy5WFvGcr2g&oe=69A42CD4"}, {"file_name": "migrated_image.png", "id": "2602847149972297", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aUsYvvQmi4Q7kNvwHP6__B&_nc_oc=AdlYC-2HYFIaIVMqKKwzcDFysTUtBJntKm5V-t977x4wDHB_PRY3hZT7JZZkMzBjQsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftV26Oh-iMa3yUSNKTclx26Cv8FnxhX3vYLwnvzhyZ0qA&oe=69A41A58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628810475039334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680539_298805783828083_1949650017_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uvaopb4NG4Q7kNvwGfagcq&_nc_oc=AdlNt18ZAyfLF2Ags558ZMb58IMQ5mbhhR6jkIkhMwt-47nH1ipfosRgGHGGyNRqf1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuzLmyOTzW_Wr-5SvwwKhlsnRWFkGzkKbkqH1DCMDIQcw&oe=69A44BC0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Garden", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478070000, "lastRevision": {"nodes": [{"id": "1085868858162280", "release_type": "SCHEDULED", "administration_sta
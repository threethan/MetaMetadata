c_oc=Adr8vw5XwwMyeMA8bpNGbIwO16noNtEnEOaz14anlz6DR7_xR-Cui2jt7cJnyeloWJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGF3z6CFu35ziUJAV1FPMMhtGtJEzMid5Zv4-GFxuxMA&oe=6B0DA014"}, {"file_name": "migrated_image.png", "id": "1492063290959788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjxs0_-MzVwQ7kNvwE3dh7G&_nc_oc=AdrN9B0Rv7I05z1pb8WRFbC7tYPC4Vz8iLEo9KBdmoh7srnTd753KK3VAE2ZlirSvsw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjFqPf3S67c1DnJ6NOJNtjeYWDK52YEfXTnNajp1lwBg&oe=6B0DC5D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2016-10-23_23-01-55.png", "id": "1616196515340842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410309_1616196518674175_7744737753165725696_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_rGkXFryWUQ7kNvwEXtUbk&_nc_oc=AdoYIL2Db6CVz0OD4NCqkV6LWtWN3P9zFQ7AQUDt9WOK53wpT1R6kNBKLdrX-LDav9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSU2EiRtGm5oqOxJTkM01RDmsbWEBim-_-OSTqAqPMXUg&oe=6B0D9D37"}, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "808774870520606"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1165014866921142", "version": "1.1"}, "id": "1251538944886166", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1078672635555366", "is_concept": false, "latest_relea
138804_322399771450726_3215021061028446208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_KTxVRsWlEQ7kNvwEZi-ST&_nc_oc=AdqVw53L7IWbgP3lVqCTRTOgm5yEURsqOWC1eWFSSG_o611dpoXzG-XuDzfhpqYuBS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hAJl9LjjBUNLHM8cy487lwj5r6FEByeU67VtqCuaDSQ&oe=6A3E828D"}, {"file_name": "migrated_image.png", "id": "814838319019730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602238_211985769231165_1372716391555137536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hv_QvgsX2pkQ7kNvwH3xACL&_nc_oc=AdpyxzUjHAJz9rnNCld2UDEhjA-NOrKqhAIy9WiHNcYO2YN7Z6XqDDSwsKAaosjY1mE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VzUOjPjmXm1YNfqQeA7J6_eEVr80ugdUQsSHjFf9OlA&oe=6A3EA494"}, {"file_name": "migrated_image.png", "id": "2602847149972297", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_97zte-QEcQ7kNvwGLciUV&_nc_oc=AdokKpwRRkoR7X9fnrV7U3dv3PJXN_X_cEsgUhGnAMLrB7RFUrL8Qw7M15Pey_sH-Qk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CMQ-C7L1k2-koiHqJPGPgWIGd718-nljXXQlKQJ-r7A&oe=6A3E9218"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628810475039334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680539_298805783828083_1949650017_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHLxC210V8MQ7kNvwEyMWVd&_nc_oc=Adr5VwFpkdDjhqPtF_nRlD9Ye3q6HEc5ZnOmU3-bfUd3uPkaZla4L7R4Go9CjIImCkk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fIpGLjITS16V55LhdE_XuGtECB9cxPOxCmqtIQSxpCQ&oe=6A3E8B40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Garden", "platform": "ANDROID", "context_
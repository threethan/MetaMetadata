scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD7TkDXUYIzuqjWI4KAG6xAcemPGzvWSgG5NoV3xMKsQ&oe=6B05D793"}, {"file_name": "migrated_image.png", "id": "560005994617646", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138804_322399771450726_3215021061028446208_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yj9HyPPWoT4Q7kNvwElcYAW&_nc_oc=AdrvqQHRRd_tlay2tJwkzu2btiV12PPbSpwClLf8S229un1eU2fU-Bu-9irAhYGdt0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg-xVaamubnGTXFDnMAgBPxTUFjhX_fspy9d6BxBCkqw&oe=6B05CD4D"}, {"file_name": "migrated_image.png", "id": "814838319019730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602238_211985769231165_1372716391555137536_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiMV3OUntZ4Q7kNvwFuM1D4&_nc_oc=AdrYgnIIPPRR3xQ8RoOOgWoWNO6jyhbVXtgFDRyaK7251diO01eHMi2y2De7WHQupSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmTvtiCa-Y_B36Bsyke0wZf3OR9O3ROrqrM87faiFbsA&oe=6B05B714"}, {"file_name": "migrated_image.png", "id": "2602847149972297", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDjT-s5hxqYQ7kNvwGTHbkn&_nc_oc=AdqRZ2V1BIeKmdOPel8NpUlB9KuJtHGAqnCBh7fm7F29vNvYAYOrAAmjwingRmoGlo4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg6hf7YMtW85ajCW5VwGMn4h8OMD4b8Kl91DtRZaKlrA&oe=6B05A498"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628810475039334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12680539_298805783828083_1949650017_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2tSsu3c864Q7kNvwGcY
nc_oc=AdkG3xzJ3k9L7FOGspEy2tywbBjXT9-l28V_9fdnunw0RtLGUr4y28arRRc5hHhImT0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftc58Sy2hCsaKaUIjdB6WZSJEPp-VLVytI5-MW7GivOkw&oe=699EFD0D"}, {"file_name": "migrated_image.png", "id": "814838319019730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602238_211985769231165_1372716391555137536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMFrCP6wNJYQ7kNvwFmmpnD&_nc_oc=AdkegajEjPNYELVLaR8lyAA71ps8-W7Y9XDWaFMg6_f4-KmYznxyDW3s_92301yfqII&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afut9LZj_YYuGurvNLc7aWduFl2YQ5sATBLkhJe_EWYkfQ&oe=699EE6D4"}, {"file_name": "migrated_image.png", "id": "2602847149972297", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5yyhbC7ysgQ7kNvwHZfRXu&_nc_oc=AdldpTb3-Dk6iP3srpbs7ra7BGDMnO142whszfR9JZv0KPBhVnIJZqaBiiMa1dZzb68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvU9SWZj7RgIYi1FZ9fF7QDBGYa8iQnu_2x2bAKdHHV6g&oe=699ED458"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628810475039334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12680539_298805783828083_1949650017_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRq1MAXO8YEQ7kNvwG1vI2Y&_nc_oc=AdlClt-Sjt-d_1wx1sSLjzy9gPaGCcPZKN_ccGgvz-DOaC_Lo6EhOnJthO9yvY_Fnm4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftqoUjreuaY6Yjm0AOAHdNWaKtBEZi1f9Tzbib8VOVZyg&oe=699F05C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Garden", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478070000, "lastRevision": {"nodes": [{"id": "1085868858162280", "release_type": "SCHEDULED", "administration_sta
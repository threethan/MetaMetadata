138804_322399771450726_3215021061028446208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdG22IeeOoAQ7kNvwFq9No6&_nc_oc=AdoJgGWsZhTQUKau6y_zgiveatWsj22XQke0FgsLq5AqVjyOxeUwKGSEM7li4-kcmcU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J2AJLMzbgO0fCedE5SFk3xuw55BHdc8EyObhuwy5OCQ&oe=6A32A50D"}, {"file_name": "migrated_image.png", "id": "814838319019730", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12602238_211985769231165_1372716391555137536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSSBTFly8swQ7kNvwFxUww7&_nc_oc=AdrREtKeYsIPnzugpnty4AMCX2r4W8FWTWRMDOOfDW7Jn06tMAkA6HpAS-Vnzf4jmnM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hY5p_MTO--4TttF2FoHsa94kS79t_pV8WhtL-QSnqZA&oe=6A32C714"}, {"file_name": "migrated_image.png", "id": "2602847149972297", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNYW5ETHOA8Q7kNvwF92hg8&_nc_oc=Ado4omxQZmB6s8MZ5FyzDx53uqeHNAHpvFpddN066J3wOia0IBmOjqey8GKCw3WEs8Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M4ojLPbp6bO8XX_dfkfMQMTIU_ZiFljlGhZFPf7452w&oe=6A32B498"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628810475039334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12680539_298805783828083_1949650017_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKMN0xKJprQQ7kNvwHrxhg7&_nc_oc=Adpgm4cZVnRnLiBOXCxGLWOZqj8kZ4Y-R8pDmBgHa3GA9KanW6sQmN7_tPSFXQQXdyw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HzTtij7c6ps08ImKGGEB6zeLTKh0xIANGLZ531rKSiQ&oe=6A32ADC0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Garden", "platform": "ANDROID", "context_
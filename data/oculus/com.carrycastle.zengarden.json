138804_322399771450726_3215021061028446208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h37r6rriAMQ7kNvwE4gEpr&_nc_oc=AdpvjA_gSJ4FlCC22AzhFi9I6Lw2S6j8B3rNUnaTC14nE0TdGRyhlSVXkLz8dZnbZwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVpNfrG5PT7c6F-Ew4vjF5Z2Nc-p6mDv-ppShiZhHGOA&oe=6A5E268D"}, {"file_name": "migrated_image.png", "id": "814838319019730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602238_211985769231165_1372716391555137536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuLEna_Nr-MQ7kNvwH3MrLN&_nc_oc=Adqejjo2Pah9eA98Be9ElQh62rOKcwvMne8NMlwbE0cphRcznQoME7I5UXHlSdM4NBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe5vS7izVr97ucjK-SadX925RdWiTRT2sYnrDudK8sgw&oe=6A5E1054"}, {"file_name": "migrated_image.png", "id": "2602847149972297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21A7WiGU2YUQ7kNvwE7Gpp3&_nc_oc=AdqwMkStOjxxtXu6KOfPPCEicX7qvN6Lckbqe7zjtcSsiPGORE3crMvBX-LLUJBwFKw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6qOdlHjLElUrT9eqN_Eo1_C1ziKWXSvq5-qvRs-5Jwg&oe=6A5E3618"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628810475039334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12680539_298805783828083_1949650017_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObqeH529sMoQ7kNvwEqnBcP&_nc_oc=Adq7P9zUt2dJgggrCmhU4IFeiD36dRd-6f18Q4I97aE6jU-7K_VapJUOwv1H0kiu66U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyfiyN71KeZaRLgpQniVvJQ0Qjll_HlIBjGsw6_rfx6w&oe=6A5E2F40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Garden", "platform": "ANDROID", "context_
scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUgC_nBo15jufADkGRwWd5Kb8I9c2vESa9VisxEYkaaw&oe=6B0B1D93"}, {"file_name": "migrated_image.png", "id": "560005994617646", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138804_322399771450726_3215021061028446208_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gf6t12c45VUQ7kNvwFLYe51&_nc_oc=AdpVdmNS0NJbPMvsj52fX3hbZsyIyGtMqFHZK8mk5mysx1Fby6F2NgHa0xJl7DZWTB8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRcKYsJZwKcoverPSaNCTOnmllkIvjje-ILYyD5sGUqNA&oe=6B0B134D"}, {"file_name": "migrated_image.png", "id": "814838319019730", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602238_211985769231165_1372716391555137536_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pn_OKW62o-0Q7kNvwHVT9uy&_nc_oc=Adp_Kpec1ADS8nzYiXs0k0MIq_YUxAUah9lGezsKJ7nw0yMev1NlY2ojrPrRs55XP5M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-LifI72DbpBw0RIapbEGsy6gMve94w89H8GPJ1vAy8g&oe=6B0B3554"}, {"file_name": "migrated_image.png", "id": "2602847149972297", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjxs0_-MzVwQ7kNvwHcof1D&_nc_oc=AdqTsvsBEYElsMBTcL7HmWcKAoky7hz-cyXCXegzZxgJGlPf8MyICN1ggXI4LQ66Dc4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1H6WPNRHPnh7svX6-W2fUslRORTMSus-QEOlTgkrQkg&oe=6B0B22D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628810475039334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12680539_298805783828083_1949650017_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBQ-1JjyGUYQ7kNvwEXx
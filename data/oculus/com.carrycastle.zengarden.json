138804_322399771450726_3215021061028446208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PX26sd0V798Q7kNvwH-Hg3y&_nc_oc=AdoPAO2NJWdMGoHfZnQxSFsbNO2ihzEXhMQWMKnU7-Kl8F_keiK1NfvGcJI_-xTZgVM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2v-5w4KpJUfq93AhLq7cmLJCrYmmcZVyjEaUgVYAbZg&oe=6A24248D"}, {"file_name": "migrated_image.png", "id": "814838319019730", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12602238_211985769231165_1372716391555137536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffxjy45-qdUQ7kNvwEMmnYd&_nc_oc=Adrq2lizhTcTbmT8kpfKo2V3C6dNzEkJY7eOAiIiu4OgVZrx17N8_RSMZIWPwgf8ioE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tXtkpm8y7XtpM6DKPUUbBDyLln5YLR0gk12qVgwM2Cw&oe=6A244694"}, {"file_name": "migrated_image.png", "id": "2602847149972297", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZybFhVvO6oQ7kNvwFZ01w8&_nc_oc=Adq48e0TuhQyoh9wyOlagh47E_fAHkOGWregoDHgfmRkFePO2Z19Mz-T91ItU3pSBi0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1FLQJ_HEn9S-XtOnWa-txqTipYJLGQHG07VZQ2zpPHA&oe=6A243418"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628810475039334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12680539_298805783828083_1949650017_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f5dtjI9e-cQ7kNvwGffB0J&_nc_oc=Adp5CHJ-LfcHC5-Cigwf95ZRPdoL2Qr6j1bZW7MrJR_x-3QI3_XQzVk1vvvtQ5pjFEE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sZVtdqNIqE5MBXTCXF_PB1SouU_4knIWlzAlGByZ5tw&oe=6A242D40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Garden", "platform": "ANDROID", "context_
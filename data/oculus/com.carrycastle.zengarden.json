25/12138804_322399771450726_3215021061028446208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyCzfxU7nTAQ7kNvwFM4igy&_nc_oc=AdqkONo9mOFTytkLfl7BikmqoZMDAY0MPNSngs6jcyIS4k4Ew3HONvU_iT6ZbOsh0k8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9os-zFVwp3YAOtl1MJjRfh3uQwgKIeJxhaxw4kXoS6iA&oe=6A22D30D"}, {"file_name": "migrated_image.png", "id": "814838319019730", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12602238_211985769231165_1372716391555137536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PUCfLyRbwYQ7kNvwEwbZRH&_nc_oc=AdpQF70fQzLJ1AgiIK1Z2gOLfljVujFN42n7AwLb7CNFyNCDAp7ADfrAtF4fPyXDRAw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85ia6AabWIWunne9cDSdptcJD7QG2WtPn5sEIstpOp5Q&oe=6A22F514"}, {"file_name": "migrated_image.png", "id": "2602847149972297", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZybFhVvO6oQ7kNvwE58jwf&_nc_oc=AdqyTFAB5u7rm6LY0jUBU7K6c4hWl9ZvdIqWJhkGmTOkfrt7bzlstIsuIvCraTXGeus&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98BH73KyJ1NgpI3Zn5G97zWAjvly--Fm5XNU3FXCtk7g&oe=6A22E298"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628810475039334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12680539_298805783828083_1949650017_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fr8XxQmyFAEQ7kNvwHsJ0fI&_nc_oc=Adq35GJoo_zJfjyYK78TB4iCzek1F_sxZgqwfbEerGAtA21865u7DlsrI0cxP9MrATc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qxjr35A8tajD7aySgqakBtVSqg-a2utPs62M6MW-Seg&oe=6A22DBC0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Garden", "platform": "ANDROID",
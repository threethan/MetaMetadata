138804_322399771450726_3215021061028446208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDoiWja9PwUQ7kNvwHJxh5o&_nc_oc=AdqfQRSg4j_E7mb76Y9jPIXK4Eb9o_8P-KWLb453jD2KojZK8Ca1GCNfbZ_6KhHn_y0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG37UC8yxhKBZRMb3H90GXZopsg1UKIT0abVz-4fe-tIg&oe=6A8AC14D"}, {"file_name": "migrated_image.png", "id": "814838319019730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602238_211985769231165_1372716391555137536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5o76H9odU8Q7kNvwHcuKCD&_nc_oc=AdqFE0Mc8s-w6DfdHyx9rEAHVrj_8tYndGUokyDy0PpQR0XrA4yYGMYoDhjhUjmb1us&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOxWkPcdp8l7EwGEB1d80YSNPo-9DM7T6UwX3iMF9Xwg&oe=6A8AE354"}, {"file_name": "migrated_image.png", "id": "2602847149972297", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12728010_355300154811078_5740444530948177920_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9-1qtbUZrkQ7kNvwGTErHm&_nc_oc=AdpYq1syc7xo1Gkhp-mjC_7tqt4d03sEOf_npwXDM_2-8y54_v9x0yrrpRhlIVGbDZk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSUxDFaKksT5ChFeno-_SwtrTK_sBirHSzLuT76d33RQ&oe=6A8AD0D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Garden", "keywords": ["relaxation", "meditation", "music", "oriental", "asian"], "long_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. \n\nWe want to help you relax with musical instruments that react to your gaze, placed in calm, lush environments even in the most noisy and stressful of context.\n\nTemple: This scene is inspired by the famous dome structure of rome, Pantheon. It contains a great amount of cozy candles and heavenly choirs if you gaze up to the eye of the building.\n\nGarden: For ultimate relaxation we have the Zen Garden. It contains multiple instruments inspired by ancient china with the purpose to calm your nerves. Instruments include Spheres of light, wind chimes, gong gong and floating lanterns.\n\nOasis: Our more mysterious scene, taking place in the middle of the Sahara desert. Featuring a bedouin camp with a clear starry sky for roof. On the ground level there is a campfire giving a cozy but intense feeling to your own personal bedouin camp.\n\nEnjoy!", "short_description": "Noisy train trips or a shaky flight? Don't worry. Zen Garden gives you three unique musical environments, tailored for comfort and relaxation. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://carrycastle.se/privacy-policy-zen-garden/", "developer_terms_of_service_url": "http://carrycastle.se/terms-of-use-zen-garden/", "publisher_name": "Carry Castle AB", "support_website_url": null, "website_url": "http://carrycastle.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "628810475039334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12680539_298805783828083_1949650017_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_wqEDmzVuQQ7kNvwFrJOQq&_nc_oc=AdrokR63g09IZmQws0lO18uQLxjwtb6Hd7wiPhbw7a-PKWDJoJicsmXtP1C7WOgxEOM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDPF7UBhJWwy64s1JWk1w2umOXaIu2-6GYyxpDYMZj-A&oe=6A8ACA00"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zen Garden", "platform": "ANDROID", "context_
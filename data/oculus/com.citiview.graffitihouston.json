6239_257913156571944800_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHvWo9RfoO0Q7kNvwHGXTgF&_nc_oc=Adqu1qVebgvVYvMuMb7d45pb0RVA1ECcfYZEPUyhA1aZk6php3jTlhLPCDb-uwc2Qe4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-wB-XgiXs55h9pRp_bKt6gR40J50YA-sUv-yzGw73Vg&oe=6AFB1A1D"}, {"file_name": "screenshot_3.png", "id": "1451226456869475", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825470_1451226460202808_3757094023188618748_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHagTa3BcioQ7kNvwHpYeRP&_nc_oc=Adp0kZLJAT05BJ8zRRpTes5uYdjDn2D74HXeSc0qhvZF5N8ou95Vw4BNyItMWFpnKxY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXnkXADhVQQ4Ixq4dwGhp6y3Rd7XFr9Z8hAJjk1s_2Wg&oe=6AFB2141"}, {"file_name": "screenshot_4.png", "id": "2026584331339557", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823341_2026584334672890_3237237342693065839_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEgFuGLk7qUQ7kNvwHt7Pc8&_nc_oc=AdofX1-IpObt_5_00TJXqTtnJFdc9XOOIbqMwTJpt4gH44Nh1ozRnrrroaRG80p7gSY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6Z-sPHJnCWkCRqtNUHB4FAK5V6AT_vYodPeuReuWkFg&oe=6AFB3B23"}, {"file_name": "screenshot_5.png", "id": "1827242238294140", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825415_1827242241627473_1228435439523145452_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH4JIjFmzPYQ7kNvwGUKMMm&_nc_oc=AdqyJXTOAg8G5TalGrDBsRwI1nHl7enlNI3aRara7YovNTiwDsfBPdGzXc3tjXR1uNw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEoGou9PFmGUEApCbA2YgXJ-5iUkNa8CSEk-S2ceXyXQ&oe=6AFB3455"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1604224338067183", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825497_1604224341400516_6018011741526261975_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayd8W70_WK4Q7kNvwHwnst2&_nc_oc=AdqkeH8UPHeozxC8Q_wDma0M5BhrrReJTFsJS9dd49MRgmFtLdPIHfs5WV8Fe862p14&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI6AO43aSm3str0L9k_IBu38lYw-XdZ5b9RfriE6Edrw&oe=6AFB1D0B"}, "display_name": "Graffiti Houston", "keywords": ["graffiti", "houston", "painting", "art", "sandbox"], "long_description": "Graffiti Houston takes your spray cans to the walls Houston writers know.\n\nFOUR HOUSTON PLACES\n- EADO: a red-brick warehouse yard in East Downtown on a gold afternoon. The Lone Star flag painted big on the wall, murals down the street, downtown's towers right over the block wall, the light rail sliding past and a taco truck with a queue.\n- BUFFALO BAYOU: under the freeway bridges at blue hour. Paint the giant piers lit moon-blue while the bayou slides by under the live oaks, the skyline glows, and the bats pour out from under the bridges at dusk.\n- BE SOMEONE: a lot beside I-45 at sunset. Eight lanes of traffic stream past, a freight rumbles over the rail bridge with BE SOMEONE on its side, and downtown stands behind it.\n- SAWYER YARDS: the old rice silos on a bright humid morning. Painted silos tower over a red-brick studio dock, and two freight boxcars on the siding are yours to paint.\n\nTHE CITY IS ALIVE\nJoggers run the bayou trail, people watch the bats from the bank, photograph the bridge, queue for tacos and stop to look at your work.\n\nPAINT IT\nEight CITIVIEW spray cans, skinny, medium and fat caps, 32 stencils including A to Z, real mist and drips on 20 walls of red brick, concrete, cinder block, steel shutter and boxcar steel. Take a photo of your piece and switch places from the menu.", "short_description": "Spray paint the walls of Houston. Bomb the red-brick warehouses of EaDo, the freeway piers over Buffalo Bayou as the bats pour out at dusk, the sound wall under the BE SOMEONE bridge on I-45, and the boxcars at the foot of the Sawyer Yards silos. Four real Houston places, alive with people."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffitihouston/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/graffitihouston/", "website_url": "https://citiview-games.pages.dev/graffitihouston/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1285543137984992"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825546_1096629929772828_5716061896530539569_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNjmgNIbJB8Q7kNvwGEcPY_&_nc_oc=AdoVziwiCmMbVxK6ax8y07ysXM4xUnVXpNF6n6jcUO6aRQWmrDND_VsRa-btuKGAFa8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9bAlnyaH_rI8k359mKAN5ENXPgJXDFKYmRpaLVA20sg&oe=6AFB3B64"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Graffiti Houston", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1791812220, "lastRevision": {"nodes": [{"id": "1285543151318324", "release_type": "S
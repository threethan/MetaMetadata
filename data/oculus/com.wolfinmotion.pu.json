hc=uQn1wn-wdJMQ7kNvwHGgjgV&_nc_oc=AdpkBLCEFO2_Jy5g_buTK8_w05bFyJDJvbp4F-LRMS6lMZ4Mn87PjLVAi3qb6yqDhCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWj4SRsOleRdqCjHgkxZVgDRbdL9jYt_PdWaYk_ZRVfXQ&oe=6B0EED71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/LzU1n3", "id": "285428632306514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974561_285428635639847_1606030216348565504_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6UoXf6YIlEQ7kNvwEVsLr8&_nc_oc=AdpcgjA0LIzbAUQgo-VCCBdUUlqz7Iiv7DHX1NB7xDIGrq7XgLSASQKO_BqdVwUTT8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUAtjwg2UQM1ge8HMbFumPFGUEDPU2xYi5wPfRwbtDEPA&oe=6B0F09C4"}, "display_name": "Pilsner Urquell Virtual Brewery Tour SG", "keywords": ["brewery", "pilsner", "urquell", "beer", "tour"], "long_description": "Experience a unique and immersive virtual tour of the Pilsner Urquell brewery in Plze\u0148, Czech Republic. Be transported to our underground maturation cellars where we parallel brew our beer, watch our Saaz hop harvest, scoop Moravian barley in our Malthouse, soar to the top of the water tower, discover triple decoction in our Brewhouse, meet our expert Beermaster and see our coopers repitching huge lagering barrels in the cooperage. It\u2019s just like you\u2019re actually on a tour in Plze\u0148!", "short_description": "Experience a unique and immersive virtual tour of the Pilsner Urquell brewery in Plze\u0148, Czech Republic. Be transported to our underground maturation cellars where we parallel brew our beer, watch our Saaz hop harvest, scoop Moravian barley in our Malthouse, soar to the top of the water tower, discover triple decoction in our Brewhouse, meet our expert Beermaster and see our coopers repitching huge lagering barrels in the cooperage. It\u2019s just like you\u2019re actually on a tour in Plze\u0148!"}]}, "developer_name": "Wolf in Motion Ltd", "developer_privacy_policy_url": "h
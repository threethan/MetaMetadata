": "285428632306514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974561_285428635639847_1606030216348565504_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tY0kmVQrTEcQ7kNvwGqTYKU&_nc_oc=AdoKMoDnaaBcGKvmMaT8wE9Jss2KS_h3mGhsXAU8EczspvCttCESJsiTLxV2O3tEF_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJygNikmnXWSBu9XtXUM-3nhlyHVZfMosZtpFkL42ZKOw&oe=6AA55984"}, "display_name": "Pilsner Urquell Virtual Brewery Tour SG", "keywords": ["brewery", "pilsner", "urquell", "beer", "tour"], "long_description": "Experience a unique and immersive virtual tour of the Pilsner Urquell brewery in Plze\u0148, Czech Republic. Be transported to our underground maturation cellars where we parallel brew our beer, watch our Saaz hop harvest, scoop Moravian barley in our Malthouse, soar to the top of the water tower, discover triple decoction in our Brewhouse, meet our expert Beermaster and see our coopers repitching huge lagering barrels in the cooperage. It\u2019s just like you\u2019re actually on a tour in Plze\u0148!", "short_description": "Experience a unique and immersive virtual tour of the Pilsner Urquell brewery in Plze\u0148, Czech Republic. Be transported to our underground maturation cellars where we parallel brew our beer, watch our Saaz hop harvest, scoop Moravian barley in our Malthouse, soar to the top of the water tower, discover triple decoction in our Brewhouse, meet our expert Beermaster and see our coopers repitching huge lagering barrels in the cooperage. It\u2019s just like you\u2019re actually on a tour in Plze\u0148!"}]}, "developer_name": "Wolf in Motion Ltd", "developer_privacy_policy_url": "http://pilsnerurquell.com/pdfs/PU-Privacy-Policy.pdf", "developer_terms_of_service_url": "http://pilsnerurquell.com/pdfs/PU-Privacy-Policy.pdf", "publisher_name": "Pilsner Urquell", "support_website_url": null, "website_url": "http://pilsnerurquell.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "
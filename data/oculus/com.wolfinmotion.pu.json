hc=kQmQXzNgQEMQ7kNvwFu126x&_nc_oc=AdrE964-IIYjtxEUc0YhJj8DSzBuDzZy_zaIG9IwMr1DgbUIt5cxI6eED8Un0nhovXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQN7vJw3es8BeP6HNOtXv01B0_C93uoWlgNYt6LoeYFfA&oe=6B0C82B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/LzU1n3", "id": "285428632306514", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974561_285428635639847_1606030216348565504_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6UoXf6YIlEQ7kNvwH69XGQ&_nc_oc=Adq9bbVMA2QKxz2OKXuGDTwCYmBY4BwgbzeptPJZ957RCwqc-y0G2TxfiVeNHuvlGP4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRG6itb6vZqNZFijuYf6tg1aRHnenE90LiOUp_kY7MO4w&oe=6B0C66C4"}, "display_name": "Pilsner Urquell Virtual Brewery Tour SG", "keywords": ["brewery", "pilsner", "urquell", "beer", "tour"], "long_description": "Experience a unique and immersive virtual tour of the Pilsner Urquell brewery in Plze\u0148, Czech Republic. Be transported to our underground maturation cellars where we parallel brew our beer, watch our Saaz hop harvest, scoop Moravian barley in our Malthouse, soar to the top of the water tower, discover triple decoction in our Brewhouse, meet our expert Beermaster and see our coopers repitching huge lagering barrels in the cooperage. It\u2019s just like you\u2019re actually on a tour in Plze\u0148!", "short_description": "Experience a unique and immersive virtual tour of the Pilsner Urquell brewery in Plze\u0148, Czech Republic. Be transported to our underground maturation cellars where we parallel brew our beer, watch our Saaz hop harvest, scoop Moravian barley in our Malthouse, soar to the top of the water tower, discover triple decoction in our Brewhouse, meet our expert Beermaster and see our coopers repitching huge lagering barrels in the cooperage. It\u2019s just like you\u2019re actually on a tour in Plze\u0148!"}]}, "developer_name": "Wolf in Motion Ltd", "developer_privacy_policy_url": "h
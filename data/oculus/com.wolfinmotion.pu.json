hc=kQmQXzNgQEMQ7kNvwEm-KAx&_nc_oc=AdreridcactpUX4Y59yoCIetvPk63IEwBy8SEgmBdwQ9XNIJ4JmOgiZ2V2vn0rKDSps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZSbrDWlEErH9perAz98dzho04T3xCI7HySWCBvM2uog&oe=6B0D9BF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/LzU1n3", "id": "285428632306514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974561_285428635639847_1606030216348565504_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6UoXf6YIlEQ7kNvwE1-I5d&_nc_oc=Adoty3IC_VzS4xTD0o8L4HP3GR1CmBZ1a5X1hTB-kRbI6m1KKUzw72so7PTOBS42Gd8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNoK2F5u3l_nWZOkeJgAECNQhKVSoY2qYk2U75YfLx5Q&oe=6B0DB844"}, "display_name": "Pilsner Urquell Virtual Brewery Tour SG", "keywords": ["brewery", "pilsner", "urquell", "beer", "tour"], "long_description": "Experience a unique and immersive virtual tour of the Pilsner Urquell brewery in Plze\u0148, Czech Republic. Be transported to our underground maturation cellars where we parallel brew our beer, watch our Saaz hop harvest, scoop Moravian barley in our Malthouse, soar to the top of the water tower, discover triple decoction in our Brewhouse, meet our expert Beermaster and see our coopers repitching huge lagering barrels in the cooperage. It\u2019s just like you\u2019re actually on a tour in Plze\u0148!", "short_description": "Experience a unique and immersive virtual tour of the Pilsner Urquell brewery in Plze\u0148, Czech Republic. Be transported to our underground maturation cellars where we parallel brew our beer, watch our Saaz hop harvest, scoop Moravian barley in our Malthouse, soar to the top of the water tower, discover triple decoction in our Brewhouse, meet our expert Beermaster and see our coopers repitching huge lagering barrels in the cooperage. It\u2019s just like you\u2019re actually on a tour in Plze\u0148!"}]}, "developer_name": "Wolf in Motion Ltd", "developer_privacy_policy_url": "h
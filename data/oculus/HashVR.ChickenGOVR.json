: "623581051829562", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12727931_276264079470019_2122569839796027392_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymvZBkS4qTIQ7kNvwHQm2ZZ&_nc_oc=Adq1Pe9jX2W7r84kyV_skVgV6oVKPdT5l5q_Bf2VObwiVLZBtsf4pSjK3heVjXAOrTI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcy4gx92E69iImy3Qn7Jkix0Ls5gQeiLPKhCXbXQg89Q&oe=6A8ADCD5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ChickenGoVR", "keywords": ["arcade", "chicken", "zombie", "cross", "road"], "long_description": "\"To Go Or Not To Go, that's the question.\"-- by ChickenLet \nPut on your GearVR and welcome to the virtual world of Chicken GO developed by HashVR Game Studio. We need you to help the Chicken cross the busy roads and raging rivers. Pay attention the zombies and driftwood, and the GOLDEN COINS of course. Some items will help you move faster and some will save you from a crash. Get the game for FREE and enjoy your adventures with cute animals.", "short_description": "\"To Go Or Not To Go, that's the question.\"-- by ChickenLet \nPut on your GearVR and welcome to the virtual world of Chicken GO developed by HashVR Game Studio. We need you to help the Chicken cross the busy roads and raging rivers. Pay attention the zombies and driftwood, and the GOLDEN COINS of course. Some items will help you move faster and some will save you from a crash. Get the game for FREE and enjoy your adventures with cute animals."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hashvr.com/?page_id=178", "developer_terms_of_service_url": "http://www.hashvr.com/?page_id=448", "publisher_name": "HashVR Studio", "support_website_url": null, "website_url": "http://www.hashvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "ARCADE", "CASUAL"], "has_in_app_ads": null, "intern
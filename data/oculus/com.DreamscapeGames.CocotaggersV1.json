/491820639_688393186990306_2579670534763497390_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sDaGdV0pRcQ7kNvwHpwO0C&_nc_oc=AdloVfZdUmHO45NqM4V-y6lPzSOwH5q3_RRq8KIX0IgzfEWOQLGKx5JayKkAQhfmKws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftzeoeP8CCdZuJl2W52-yyDQLxA2MxrZxBVNJl4OZqxXQ&oe=699D8E2B"}, {"file_name": "Untitled design (8).png", "id": "2022789671582819", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822971_2022789674916152_8225931307284575180_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5V0QhXjbm2oQ7kNvwGyx9KP&_nc_oc=Admp8CWJ55THkzRNRM_VXwYVgvzbq1Nw47Hj2qh_OzQcXDzIilp4GtR9xDY1Gh2QUtc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1WQh9XAH0h5Y4diEseplsex1FGtdCsFWY2GaFl-huRw&oe=699DB0A4"}, {"file_name": "Untitled design (6).png", "id": "1727352667889113", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821877_1727352671222446_6869102793311040596_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVgpJPeoNqgQ7kNvwEHv67C&_nc_oc=Adn7Ev_w5srOiC-Pdd9DXhBaXElblUTpzBE8UNn0Xlw9cHj6D4XIr1YzHNHjrS4aQ4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftFSeLhFDkiL5YDu5vAcLcBxakaGzmG_4Dz78R13e4CnA&oe=699DA8DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco Taggers", "keywords": ["Taggers", "Tag", "Coco"], "long_description": "Introducing the ultimate thrill-seekers delight: the Coco Taggers! This exhilarating game is designed for those who love to unleash their inner monkey and engage in a wild chase with friends. Picture this: vibrant colors, playful designs, and a lightweight, portable setup that makes it perfect for any outdoor adventure! Whether you're at the park, beach, or backyard, this game is your ticket to endless fun. The rules are simple yet electrifying\u2014tag your friends and avoid being tagged, all while showcasing your agility and speed. Get ready to swing into action! But wait, there's more! The Coco taggers Game isn't just about tagging; it's about creating unforgettable memories with your loved ones. With its easy-to-understand gameplay, everyone can join in on the fun, making it a fantastic choice for family gatherings, birthday parties, or friendly competitions. So, gather your crew, unleash your playful spirit, and let the monkey business begin!", "short_description": "A Gorilla with no legs playing tag in forest"}]}, "developer_name": "Coco", "developer_privacy_policy_url": "https://sites.google.com/view/project-xmas22/home", "developer_terms_of_service_url": null, "publisher_name": "Coco", "support_website_url": null, "website_url": "https://sites.google.com/view/projectchristmasv1/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9291619347614759"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9351600361616657", "version": "SPRING23"}, "id": "693586523107589", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9291619340948093", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9
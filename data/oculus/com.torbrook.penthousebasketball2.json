c329-DusQ&oe=6AFB38B3"}, {"file_name": "s3.png", "id": "1396956778549981", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604293968_1396956781883314_166659766699515231_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6ILPsHa5boQ7kNvwEvU3kK&_nc_oc=Adp_qgJJt1vlrqu6E8I-p5l_1LtZ4-MIVjMxcjMHOIIKPj5eCqKC0nQOUE3oeXnIOKs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE2KnU-gkDFnXMEbqJE2hTl4DCrzjAU3jsXu_U-yJCjA&oe=6AFB4572"}, {"file_name": "s4.png", "id": "1399456674849638", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831299_1399456678182971_5510305031079551582_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndexF0l9FjAQ7kNvwG7xzEs&_nc_oc=AdoyNShlZtciQRJSaDVVMDmb_uM68qWlCrMGnKWIIr9IFheaedqTNsliacGXbl-jD94&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw4qY8Var0sXWvdlk1zPcDCJxo0sxzLqdkBDPoXpNR_g&oe=6AFB3FC7"}, {"file_name": "s5.png", "id": "1078695248478889", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595119480_1078695251812222_4637497221944645484_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuH17CedmRIQ7kNvwG3cqKo&_nc_oc=AdrKNFOpDsAx1PbDONOymDGbOv_w30brRbpWQToL1uvY-Cx46WfWjhm78OjsTzu8ocs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-eyMUPxmnFvcPEgMO6Lp2GmBLOdjUIDiIocanhdAk5g&oe=6AFB1956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1005309119198957", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831299_1005309125865623_2972676561731110979_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DC8tj7MmU0Q7kNvwFM8QZU&_nc_oc=AdrkpaCtpI6nBXM40m8s0hYSXJ8d0OZqgCjMPlFsUgtyQeLF1wpN_k0MJfuiM33adB4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb_0XQsSry_fiWxT0JzLGJoi_EODRfJh1SnyEUwudYqg&oe=6AFB167D"}, "display_name": "Penthouse Basketball 2", "keywords": ["basketball"], "long_description": "Penthouse Basketball 2 puts you at the top of a tower at golden hour, in a penthouse with a full-height glass wall on every side.\n\nUpstairs is somewhere to live: an open kitchen and dining room, a living space under a lit ceiling raft, a bedroom and a bathroom, panelled walls and warm oak floors, with the city burning orange and pink through the glass.\n\nDownstairs is where you play. A sunken hardwood basketball court runs out through the wall into a barrel-vaulted glass dome cantilevered over the city, so you shoot with nothing but glass between you and a 330 metre drop. There is a full bowling lane, a giant dartboard, ring toss and cornhole, a rack of twelve balls, and a balcony you can walk out onto.\n\nSHOOTING THAT ACTUALLY FEELS RIGHT\nGrab a ball and swing. It releases by itself at the top of your motion, the way a real shot leaves your hand. No timing a trigger, no fighting the physics. The ball is a real size 7 with a real bounce, and every basket counts on the board above the backboard.\n\nWHAT'S IN IT\n- A sunken hardwood court inside a glass dome over the skyline\n- Auto-release shooting, twelve basketballs, live scoring\n- A full bowling lane with automatic ball return and a RESET PINS button\n- Darts, ring toss and cornhole, all scored\n- A furnished two-floor penthouse to explore\n- A balcony with a table of things you can drop over the rail\n- A Miami-sunset city with air traffic and a skyline that runs to the horizon\n\nRuns at a locked 72 fps.", "short_description": "A two-floor penthouse 330 metres above a sunset city. Shoot hoops in a glass dome over the skyline, bowl, throw darts, and watch the sun go down."}]}, "developer_name": null, "developer_privacy_policy_url": "https://penthouse-basketball-2.pages.dev/", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://www.citiviewgroup.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_t
, "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312267_1584785633025807_1062992659246820534_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sETdNnKPaKwQ7kNvwH7GzAI&_nc_oc=Adp7T4_cRU__ksoeHuI0U3rveRsZYtGXh194gKZj4XC8dAL6PM0DpyXfT8dkHu_FcRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSny7Y79hquop-KR-UCZPbQ2QrL6IwDMfpaPsbBgcTLw&oe=6AF8776D"}, {"file_name": "s2.png", "id": "3898369290305178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596061819_3898369293638511_2334568445087658444_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rf4oNDpC3dwQ7kNvwFcBWpP&_nc_oc=AdoX7kjCQWezLrh29q9TlvIwl57srYzoumT06eTx0IPuZ5SBshbXopGv5YSw_PKR4XQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGXkFiYFXW6FmpHrRAhHxZxIF62cQ4xe83h0CH8nduuw&oe=6AF895B3"}, {"file_name": "s3.png", "id": "1396956778549981", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604293968_1396956781883314_166659766699515231_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcCMvfrlsncQ7kNvwH0xEyL&_nc_oc=AdrbmokI1AFikoU3Jf8kZceqCCylhL1RTeO42K7lKvLtDo8zL30eLClf0LyAYsRDzxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHWG6nqWreVwcJCA9LLEMi8NCDQfW7Klhkp-9IqkkmHw&oe=6AF8A272"}, {"file_name": "s4.png", "id": "1399456674849638", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831299_1399456678182971_5510305031079551582_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gaYyBbJ17UQ7kNvwFDUTbF&_nc_oc=AdoTYvvCRH4wFpIYVJv0SOdSuDdJnF7WbylP0nu3U7NSkvEjsNmnKdXW5bsz_KZgRmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtmD6jRerCeVY3ZKWXrPpjUAq-zE146IkOto78k9uSoQ&oe=6AF89CC7"}, {"file_name": "s5.png", "id": "1078695248478889", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_1078695251812222_4637497221944645484_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a09vVzrhJYEQ7kNvwFpZ09W&_nc_oc=AdpZCTSzTbzOtTlpljBymNaPZdo8SLqFEOqiquJSZevexSRW-nM4CdFLvYZEvzQ4Svc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjCWqmIiTTGwdXvtDDXNPzokIdDnEdx_oZI8nwZCzSUw&oe=6AF87656"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1005309119198957", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831299_1005309125865623_2972676561731110979_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Skhm7MAk1V8Q7kNvwH-4QUz&_nc_oc=Adof7wqnOD0uOktvfAjL-HL5gLtEkZs1LFfzJja-qDJ_yskQxsLM486bt5OzR8LHdOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGgu0LWQ_siqdV5NpBbxpHYXIWxmKPjtbL5dgmPdq-bg&oe=6AF8ABBD"}, "display_name": "Penthouse Basketball 2", "keywords": ["basketball"], "long_description": "Penthouse Basketball 2 puts you at the top of a tower at golden hour, in a penthouse with a full-height glass wall on every side.\n\nUpstairs is somewhere to live: an open kitchen and dining room, a living space under a lit ceiling raft, a bedroom and a bathroom, panelled walls and warm oak floors, with the city burning orange and pink through the glass.\n\nDownstairs is where you play. A sunken hardwood basketball court runs out through the wall into a barrel-vaulted glass dome cantilevered over the city, so you shoot with nothing but glass between you and a 330 metre drop. There is a full bowling lane, a giant dartboard, ring toss and cornhole, a rack of twelve balls, and a balcony you can walk out onto.\n\nSHOOTING THAT ACTUALLY FEELS RIGHT\nGrab a ball and swing. It releases by itself at the top of your motion, the way a real shot leaves your hand. No timing a trigger, no fighting the physics. The ball is a real size 7 with a real bounce, and every basket counts on the board above the backboard.\n\nWHAT'S IN IT\n- A sunken hardwood court inside a glass dome over the skyline\n- Auto-release shooting, twelve basketballs, live scoring\n- A full bowling lane with automatic ball return and a RESET PINS button\n- Darts, ring toss and cornhole, all scored\n- A furnished two-floor penthouse to explore\n- A balcony with a table of things you can drop over the rail\n- A Miami-sunset city with air traffic and a skyline that runs to the horizon\n\nRuns at a locked 72 fps.", "short_description": "A two-floor penthouse 330 metres above a sunset city. Shoot hoops in a glass dome over the skyline, bowl, throw darts, and watch the sun go down."}]}, "developer_name": null, "developer_privacy_policy_url": "https://penthouse-basketball-2.pages.dev/", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://www.citiviewgroup.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1307610359098494"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2121972605388924"}]}, "baseline_offer": {"id": "2121972605388924"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789558680, "status": "PUBLISHED", "id": "2121972605388924"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1307630959096434", "version": "1.0.0"}, "id": "1403968541928275", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "130761035576516
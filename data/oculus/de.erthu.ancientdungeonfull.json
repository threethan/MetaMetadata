.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ymHYI-6wA8Q7kNvwE53u_7&_nc_oc=AdkKttTmLWMIwDkHopFk2NPpHwpaFlXRIRoKFd2Lt-QuW4tbnE54-qidOW4UvMbNfrM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4anVmwHjZrjz50vBYVRcIIaFxogJfQqgh5A3cc73ilQ&oe=69AD692D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkTBEM0CC_sQ7kNvwHKt01H&_nc_oc=AdmYdVY60UT6g7imD4XntZwNbZPCFsw1N3Zg6BUmUcPvzvG-uiBSo-j1r48wJTtQ6LE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLqBwRo61JUfCCgtCBJBiQ8kGIEsiwhSDSZdnjxZlmWg&oe=69AD5ADA"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e45AU5WD1uMQ7kNvwExdZj2&_nc_oc=AdlOuXKTV02230lF2udCLXDCYoEqoHnV1xo0qma5PUTfQHK8rt4ifZ3_mBToQHotb4k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfywjbM0EvOB42FJySIZtuFaZkdGMNjbPLcAR2dG_Zqosg&oe=69AD5AFA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwzrgzH1v-0Q7kNvwGcPO_x&_nc_oc=AdltVOEbyDGgkFDHZnZMqLkYcUk-F2ea7MPEDQvMV3GD8hEEmdxwBauHDa4Iv45o6W8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4LQep9Cz_j0CnaBnHDls0uLllzI8AHkA-NjRALO9hGg&oe=69AD7E0C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8nsZF5ZUsMQ7kNvwFrAzMJ&_nc_oc=AdmqsFKgbDOo3sufKfkxM99t-mKHfN_TyKJpaY8I-jOknJZtwCH3-f93K8q39STZJyU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afytj2W48z-K1qwg2FlsZ5WzavyKD4Oi8ErgJiYv9e63qg&oe=69AD64CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
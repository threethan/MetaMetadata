": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRl6TDjPCf0Q7kNvwHFBEKz&_nc_oc=AdqaQAteOTklLvkeB5trTVaNLds2jejKMpT-rpEd2EdDqlM41mz1BC3qskVRBkYZMmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArydwa1Awni7p7nixUi4ppaTInWXYTVqHatZADpPfZwg&oe=6A5E122D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs0EaT67HQsQ7kNvwEdNKUW&_nc_oc=AdoxoNLEKyZ5FEqEewVNRoySFiVftk8-5cQC91Tbpd9qa30Im6UK2ahVqaqO6RHtvDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHNW_by0qpDcyq2hm8hr78nzuaAiDZGXgu549g5djYQw&oe=6A5E03DA"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDv-abEUmoUQ7kNvwGK9VUS&_nc_oc=Ado2qE5ijQ-qv4VWfomFUsGA9sPOZ4U6bVlUpyKYMjD7ZW6c-o8Spqr793l8cW0IbwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfMkIFZ8z6aN5aV6Orrn2EUlyJeM1tsLBcSEgVPPRIzw&oe=6A5E03FA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gK6n4JE2j3wQ7kNvwGKJeqg&_nc_oc=Adp9rgZIrZhh-f-7ULnlRYLgsO6r4ExiwbM8qBg8JhSSwMkHZrnPAaQSi3LTFbwZSVs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0-BEm1ABW2C9oIz5VDslgLI3nXtOezE2hbWtvqDm9Sg&oe=6A5E270C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O4_QbGHQlQQ7kNvwEzohGP&_nc_oc=Adoj42tE07v8QjmXBGkujK69KR5C1a9RLRUtyHdmBOhgN-gcyeYnN60z1bQEMEdd6uU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6j0wVxYexCNS5GEd6DX_yg0AgbKuDkBnlxnu0WGZaCQ&oe=6A5E0DCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
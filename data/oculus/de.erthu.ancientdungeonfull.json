": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBSbabNZF7UQ7kNvwHZA_lf&_nc_oc=Adp6wJTbkC4ZZWVLmYBB-7ZVzEkQbIO29q8m1NYUbj6N5hVUSNl1S4VP6epJ-bb1cwI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1BmyUng-87547x8kMg9DKmXkV2htu4UR7xdRB2ijM7g&oe=6ACA656D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Abq7onYC6_IQ7kNvwHsJC2c&_nc_oc=AdourmaNzBnUUfw5gUodDD57oUCsekn-pjuMXXx-jaitp2or0uaGgPoAnKe7vtjYyWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-iePcWNLCZ6TlzBeviEi3W_kSwXEx6mQ3RD9hPPgxmg&oe=6ACA571A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQQuzWepwZYQ7kNvwG5z07-&_nc_oc=Adqxd8vy7zGeQ_eiqvsPRGLLoRYZ73GLBd6WPfphvIEy6tIl7qCevJZBK2fVXa2Cmfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgLI0BH_OqRo-_JlaFOYHYYnoUzL1aCVp2kKvkVMBlBA&oe=6ACA573A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYDoLh0pcT4Q7kNvwH80Gc2&_nc_oc=AdqKI3Jshz6TMoVTuZapjEToZYXqVzdi0xx832iHKKKQrew45BJOpgZ5fUWVE0Nq-S0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa5CVRQwWQE8ZNQ6E0C5xsV4E0uEF9meaUKKIDBqmepw&oe=6ACA420C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugQclgITf3gQ7kNvwF8FZpX&_nc_oc=Ado77VzAJ81Gy2QZXRUcH5G8PEWJCcemwXCG2Rd-d27mxWVBU2f1Rares9L_ZLb-VIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeFWC6k__JcVnOxol3Ta1is_-yzW8opIRK3EKsXzyhxA&oe=6ACA610B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5GWYHXaZe0Q7kNvwFGWcF7&_nc_oc=AdqGCjWNimpV-rfmnlrFKdqHaJBt3ooW1_EOU_tik9dszE5Q7m5K-amx_LyjPM_DhpI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hk_W3saWZzbXdxSLbM5vIV008sp-Dvim84urldZkckg&oe=6A3D54ED"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vRhrq_2miIQ7kNvwGeVAOT&_nc_oc=AdqJkdh_QOhbVECs_uA5qVdOb7IzHcZbCzEKr3nPZUMiYJKU0tZcrWhjK6UooE8pzc0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VV8oQWVovjc840iGw4MZxC7QnlDnFc8I5TxGuHZ-imQ&oe=6A3D469A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL8WxHGqzh0Q7kNvwGcLrak&_nc_oc=AdpQJqjJYNXPlBh1IxPuKqJyBGKQ9KKxn0AGgEhapCJEgcW1WCT6ZsXNbRkj_2qnM0o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94rcDLmarIYY1gkzbk-yuEPfay-Ct39IVQbRgOUTRvzA&oe=6A3D46BA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEzr4Vm33PQQ7kNvwFQG1DE&_nc_oc=AdphhRqy-RpS0bvqcDpCKZiqNrLMymHNTb1MW9inumyjDeOhw0rK-lbz8NOPkk1dGU4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D8SWC4kSkGrCHcng2kO48xFKToWHeldFxQNXrG11mAA&oe=6A3D318C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NU9pbjnCtyEQ7kNvwHM2OC4&_nc_oc=AdrM41tuGpAdqcO-aV71ZxnSTFZWX0Ayc-rbR1DwKlKDI8ff_wy_7e4GUMFABciP3iM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gjXFx2m71ttCFAq1iWpuD4iipo1fPrNsliehe4ijY2Q&oe=6A3D508B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
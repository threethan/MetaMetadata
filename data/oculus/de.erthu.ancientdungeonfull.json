": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TO0uUBDAcdIQ7kNvwGtacpO&_nc_oc=AdrwBhqeqyuKNpr1RRvWvzO3Opwwn60FYO-i3ODuGMWhOfi_JQBkHygk9S8ZvFeTVW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1pC-heP06b5lzOykCPiT61JkYMAb5SzE18QehghtcqQ&oe=6AD24E6D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luP5MM0eH2kQ7kNvwFNB8Uh&_nc_oc=Adpc_vUcfFeQ3kma5ZD4KID_PNMFB9x-Kkfxo4ZRfPeHFLYTP5sT-cIJT3IE1ZGY9h0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOP-_scue3HkZHCK2tDRre892yzzBrGYA7suLkEKvbVbw&oe=6AD2401A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJSv6mZErl8Q7kNvwG7PdSp&_nc_oc=Ado8-UXg9_50mI9CnGDMiZPb5N0IDLwJxnkeYIHmWohaezJKq7ZdnouGI3Q-R0sn6wo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8xKGk0_n3Fq9APWDKilO2ZXFHBEtQ0dXedykuMkfcyA&oe=6AD2403A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igl47tVgzVYQ7kNvwE15CU0&_nc_oc=AdpbPNNH59hXqxOfTiFvkUKf_ukrs3YI5p40fIX2DFEKNtfJPU2btGHp8_-DdEwAVVA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrioPXpHoh673p5CIAMroS9JoQCGtFVxINCD1UUn2xug&oe=6AD22B0C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1YSmP_bqFcQ7kNvwF0my5F&_nc_oc=AdqTg_4HrYlfR3m4ZWY1V3FZX3iEHahFCzAg_eMVaRRMk0dy-joeK5XTjAP1bGfnPbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9OneiHOCiYbQ1uDzMAce1MhFk90mccSy1wdrKDjfAvg&oe=6AD24A0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
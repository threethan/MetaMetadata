": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JufQYF7fz0Q7kNvwHVARxP&_nc_oc=AdogJS_3UR0JDoLuB3D9FA0jqNEGmUeoYzNTPd_Zbr0Hmlt1NKA512PPhb3VW_ZmGD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kWyRglcJrwYfFE9-4pjie5WtvzVBG-2HmUzMXCMfNTg&oe=6A3AB1ED"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vRhrq_2miIQ7kNvwEQ421Y&_nc_oc=AdpiSEXkhOXdLAmdWPhuHdmlRgcVvaTPYfQFdT_-j2jC2jjbTpKPHjM2RK5zsy_m7Zw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W_BbagaA_stj6haY53dYDUcxfPVt1iK7tRGDbhfVt1Q&oe=6A3AA39A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d26TMzuRD4YQ7kNvwE0Gr1P&_nc_oc=AdpH097VqCxCbTtkor5iC9tyPkB6z3nYgegQjFHvE3sx0sJNdvb3QVUS1FDvoDWQLZg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_u_3Thsf_PhQ4Fo0rhrJOwL2P2JNkLaNO5Fe-2x-6bQw&oe=6A3AA3BA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYFLf545uegQ7kNvwHV2tIq&_nc_oc=AdrpOqmNZPjViG3EF-zoKenwmVfmPjcKmaNd4splkA2uJbk6FFdgYknSs9VsaO35Dkc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qrr1zjB72QtEnner9XsQM-KThpwqY9PY-YNUptJUH-Q&oe=6A3A8E8C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NU9pbjnCtyEQ7kNvwGH7E4P&_nc_oc=AdqtExzZp1ZlZyRqFgt2_GRN3zzdUE6ZQR3_mNTtiREsb7m0h3H5LMjNevqdqNCkaIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83fySyBabbpZSgKTuRywyRsvRbbc0kEOLr4Gns_wXYYQ&oe=6A3AAD8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
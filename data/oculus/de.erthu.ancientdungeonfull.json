": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rd-6GMw78W0Q7kNvwHfsa_j&_nc_oc=AdpfEzu9z4oCFt3ytwZ7tcxDq9ppundoC9izbkCWLvktj_yvB7eCJxyBE1B4nRsM4YI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPhleqffUJbhO9EsLx0cGny7b22ya0jMDTHOcyR5bP4A&oe=6A8AE52D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6nFqaDLz8UQ7kNvwGAp8jR&_nc_oc=AdpsBw8TnOEv4pIe3hhqulfUHKBEiJAKHqI17sT6-c5ULJjZtxrmPIE59-_1djW5huE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdV68QhelcQ73rY8S6YEm4fiQSPc4ct_T4HLZdQokcRA&oe=6A8AD6DA"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqbI83A3fCwQ7kNvwGgcMIg&_nc_oc=Adp_jTIUOwpdGvKsOFb4LnIkoNSaN8jAuEfnBv6RksQ5LGhO5N9xhMiHMGXJKXXbL2o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGSUZqnOVWzrJ3mNGxcaHx9JBkMwGOflKWJo58YxpQVw&oe=6A8AD6FA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPeJN3qOxjcQ7kNvwH-I4H9&_nc_oc=Adq5c6-UkqfOQPW7ZdMm9VL0n-g6LjC6qITEyeWAbwTR7pfXH29DiQ1mxt5OjFucBqY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_l0eCbKBCLV4aFoY0ihiCuy7FIezThl1k5UmIdwrH-g&oe=6A8AC1CC"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m579lVsJOEwQ7kNvwEDJAiM&_nc_oc=AdpTWHMXA3oINigZ3pI7HtzBEH3y7pnRb7JXaL4Mr4Hy1V28Ch1bNs_qUGJs2XtfO0g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgN7P-SXCFc2aV6wU-Ahz4md2_nc3TmEAOZHD7kZPU4A&oe=6A8AE0CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
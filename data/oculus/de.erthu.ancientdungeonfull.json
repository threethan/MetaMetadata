.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcD5IZklrzkQ7kNvwF7xdGT&_nc_oc=AdkIFcz0J0qy3ZDs7etV-G5Pn5p77bKiAWQGbXUu3VwrqTY5UJgZzm5MIV0GJ6gV_bU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqHJuYAXlBFSJcx-og3CurtBqO9YHAyTgsSe_Mo3mOaA&oe=69B15DAD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tXmB-vWApsQ7kNvwFpEWY4&_nc_oc=Adk5Qt5clRfEf1fWEUjG4jhUlEQ_VYDP4CB32AU8JO8pVo5VEEpkMhBUzi6awI5SD20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJBF7vpWCwaHx8y1Qg9T1owsMiwFT03SovNHwCj8qQTg&oe=69B14F5A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RB7Mib-QhREQ7kNvwHeWZJH&_nc_oc=AdlAc4p0H5bGCqPMO-nn28eW1D36rxzebXmNXdP_-__nI0Q-Kp9jpA5-Wv4iRFhJVAQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxck_V_h_e64he3xuWx4tgCR-GejG4l-Mi-O6JWky6Hzg&oe=69B14F7A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BhmP6zW52YQ7kNvwE27PtU&_nc_oc=Adlq8mILWM5ViKtmktdemYNeQc1NL7emR2nxM3AgUcf3nI52Dwx38PSewsjJG8MNO9c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwTq_45whIiqmSaxikZWTj5HN8vCnVZJc8HM7FxF1iqw&oe=69B1728C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9erBH7_KrzkQ7kNvwGYMV_B&_nc_oc=AdnSq2ON1pNHVH7b_gK39zlezPtJQg58UDmXFdp1tGSpZ4J4G4Q0y3YIvYtX8cJ0keM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfweqWF-wTn2RGaJPHdMJ-KV-yf8MAkfAdRSLwXe0LeCMg&oe=69B1594B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
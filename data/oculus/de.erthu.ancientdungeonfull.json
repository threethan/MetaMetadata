": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5GWYHXaZe0Q7kNvwEwqOAd&_nc_oc=Ado2ih7yKEkaI8wvLuIDK4eHucllt4kxg_vz-UTGUjstw7gJ2DXLXZTKtq2P2drNd8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pFOxeNDzSzwYPtAY98qu3JzHSoGQhIZZeS0tfmZb9Qw&oe=6A3EA66D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HL_NOeft_LsQ7kNvwGIf41J&_nc_oc=AdpDEHzie4t1sf1YQOhkNayfTMEjp5T92TziTlWLK5sur5tsQkR3GcylXFbbTlb97-E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TtOE1UhrEPAbwbmMRB6HSdxKdHDUM4bw-udD3COkFDg&oe=6A3E981A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL8WxHGqzh0Q7kNvwHBjU9W&_nc_oc=AdoObiUqQ7Glw6WtBUb0O1Q0oVegXMDvJ2VQjE83ntXNA-dchZZOMirhUVfsrVpUDHA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BzMjO6JrEKSE1w3l6rF0DQd-s-F1QLssVqJ5MAml2WQ&oe=6A3E983A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEzr4Vm33PQQ7kNvwG0vP0l&_nc_oc=Adq4wmEqKoE4QTtvwofxGiouQ1zgwmjMk1ONJVCGE_hZKCoLPqnOhDf8kuXz6hVvsYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CBwRTKeDS9nY8xTeYZQqRO09naj-72-bJTD063fORtQ&oe=6A3E830C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7erQhf775_QQ7kNvwHceaMs&_nc_oc=AdoSqmEng94Cij3SsEo5lXnPFdyUqT0eckdJui1bkcYGMyxMUpq4Mq0Pfqmhnayh3jk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Mc8Hs1586IUvek5FN4BRrWVAr5SQThyGU2n1Xyv4DEw&oe=6A3EA20B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
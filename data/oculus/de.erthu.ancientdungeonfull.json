": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wj6Y_lJcCTcQ7kNvwFVEB0M&_nc_oc=AdqDVpYVA8_40Xvugp_VFU2Y2aAT67nC3kawTBioYjwODoz2S_QfVZFABZ_bWhSJqXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKgJVmHs9eAoZtSCLjWSIRaT3GAmwyJCwxUBfpX1YaGw&oe=6A70872D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBgwfjnlQvgQ7kNvwGOHYpC&_nc_oc=AdriEnN964AgkktnDZrlFlU4Q0aMLygG6bQMycb2UN6e3kpLrb23C6rhewHwR9GjM_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGevx2jyxcRML9UqDCk8_1GNQOm0N7iU5N-Qu4IS0b0NQ&oe=6A7078DA"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRA4vHyPJRMQ7kNvwE8LiX8&_nc_oc=AdrHfyPxiQmBYbHihTxFsqNNxOhqcs7XGZU6QfHHTMo8yvsUjCisP4EsU8x30JyY3GU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmzbjxN4NbjkBZSNfaL3BhobxJnLfFEqjwrB0kvr_Nwg&oe=6A7078FA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S95mxPyVsZIQ7kNvwFRMfC-&_nc_oc=AdoR6Au1AlNntL8Nw8k4dMn7EqbElLLSNeEzasTJFNLyWnKpxvmQWc2JJ2PU-CObCDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENdMKdAlZnVL-MdDpo_NNS4V3gM1T0b5gw9CPZutTkVw&oe=6A709C0C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2IKJf4nqw8Q7kNvwHxB2de&_nc_oc=Adrn3jn289MBlVD6spjugBp-zQFvqrqMGbBAl1F3oG7udo8nLGMuZ8meu0XH_0w2AUQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyCA_P_z2vXcE2ndxUEfqmUU4M6So2tCkoGonvJGk6-w&oe=6A7082CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
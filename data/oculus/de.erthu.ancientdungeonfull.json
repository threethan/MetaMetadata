.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ti0XGYb6KCwQ7kNvwHYejJT&_nc_oc=AdnPLLd8Fg5Z_piGPcyeB7iwmQd5UBBmdPE0i6Aj8KKpfSZDvPq-_vO4FFX1PAZuOJs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzMphLiMljFzLdhnu4eSwKKytokyi2l_z5W4EdHY2hrqA&oe=69BA982D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCuwk05AfL8Q7kNvwFG93jO&_nc_oc=Adkd1ZET95rfnQW0tpe9o1zHcsXvq275dc0EAxl2iEKXo3bjBzxJKbjNTh6JxgIwaaE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLzPHCvitxPxjXyNZWFjnHKDb_h5f482B_BImTkyyWAg&oe=69BA89DA"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9QnVGxoScMQ7kNvwG7uJo1&_nc_oc=AdmRto3DeduoWwDt5ZqKAM8mstk6FW1Z-4mjoRuKjnkCsjXv8O6Q1MDDMyudo2Mu2UY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxpMDSsYSeDEyjEmTdXtDAWdoAh4jc_1LTknUyQPbga7Q&oe=69BA89FA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nnGqAYCVSkQ7kNvwE1C1iF&_nc_oc=AdlctQaGE1WRo1xp-xzOmaO4I1StspJhklXnoU9smOlJL1oYz_h2jnyDasC0QqRaPew&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8H1xCbfxhdXmacNptG1ytQd6awKxMJkBKwqTmzQ0Ncw&oe=69BAAD0C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw85_aDDRn0Q7kNvwED1ZmB&_nc_oc=AdnuS3uunIgnpkZnVAvdqxjyvzDb_AeFevbnDT_FPRxyHc_dSYuzqj_kvu4og1WmkCU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzcEav-7If0eIUaO9Tjhxe1EcJ7HHenzktvrBQsrkTtYg&oe=69BA93CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvALEhM_HZUQ7kNvwFnEO39&_nc_oc=AdrFH9qZvggwYcFFUX5MKqFcbr583aWL-4GQY_j0cXC5urAmlStCeBB-xaW6pUEBJEM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrfz6ntRQRoFecshXq16_K3wCbMdMBP-UuSJl5skAVpQ&oe=6AC51F6D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNjPyU_76_IQ7kNvwEoVFIl&_nc_oc=Adp1E3cOkz97xggLyVDjjWSxx1155iClRJ7-VTCy20dVdTK2KE8f7OCqppiRM5-wE1A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8ZjJUfBjjdaBFOgoGhJLjq1A-PY48HFbyJNVxCJDBGg&oe=6AC5111A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0i0c7YGB6ZQQ7kNvwGsT2NQ&_nc_oc=AdoUn5SlD6C_FHsTVEVq626bU8ZlgTGBdKKNphL6-QMQiIyUWJEaDgFnAiZL-MCKTcQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLie8T7I6Fu6M0U3zusjsxj_pWZraa0eYiBU1qB22Ckw&oe=6AC5113A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vv_7Kh7kC6cQ7kNvwHyW-nr&_nc_oc=Adq-GDcF8TY67Mx4bifhWxVFfJUW1pXCVrKVyNq4lzrLPLlLvLphmM_HGqEo8l3g1nU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0E-bV_pHFbsLHBvjbvJUr1XStyl-AX9wBDYWMnfHx7A&oe=6AC4FC0C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAoDNKU6A0IQ7kNvwEu36F7&_nc_oc=AdoKBsotNGCDd6Xo-Er4gfY3_7MuB95dZz2BQtrGEJ4RyxWfnRHIQWV5C4b0U_amsDI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsQ2eij6TqZbz-WLepVd2aRk-07VWpFuADpYuF_6T_GQ&oe=6AC51B0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
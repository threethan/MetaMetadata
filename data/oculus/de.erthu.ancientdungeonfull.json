": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5t27JLY2QYQ7kNvwGdxysu&_nc_oc=AdpeBxnLYJj9hGouY4VvbFGqEZMTyuEx_7Lsn607AQrcAzy3tc2YxYgXUJcisJ9RA0w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD32rKSOEc0U9pJLnuj3Q0cQ94BeqjN4zS5DDso3EdJVA&oe=6A6F35AD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBgwfjnlQvgQ7kNvwEpFsHn&_nc_oc=Adoa1616ILHZ_czBS434pBTJsRuTNYbDWkj_sxaJrJv5FOEZQX8AfbbKxu4-jZncAYE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDepQ4a4XZzBDhKPB_gWoZHpq7Wycdk1l2b9ydM18IKTQ&oe=6A6F275A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRA4vHyPJRMQ7kNvwEf2Jm4&_nc_oc=Adpqwp0kKDrTK0-rJFoNMS2Friw-tmCPVuh6RmP282iErKfDWav_lEKolp95fTl5h9U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBHyeb58W8ELG6KrpU6xl1GxRogMHgfj5DoItZtau8Tg&oe=6A6F277A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZPKIocvwW8Q7kNvwFcAmfy&_nc_oc=AdpbuZHRoHLYbHC7E5hV8Kk06VqoUeQGW_BPk9JsA4dHGiMpIQjgD8SLF13wkv9MhsA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWU6PAeYC87GsLk1o3x44jjEhH2GL7wOLyyT0_ZsWGRw&oe=6A6F4A8C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2IKJf4nqw8Q7kNvwE47Pqd&_nc_oc=Adrpltl5TR-sp6wVqK7jj0v2O9KjKtefyo4bfBpKZpTGnHf7tOefbXAMVeQkDZKxNn8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx2aU0wlHFcGd8oF_7DPLAS41kgOfif4QKTxEUb2cQ2A&oe=6A6F314B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT0mTfPX_bsQ7kNvwEj21zC&_nc_oc=Adrgw302_KP-aDvn-l5qdSA6AR263WMOEMxX8hfZlLagmJUvqTKN96plZ-vbDm5nzlo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhfAkOzxSP3bBFKJWoa1kymrBvSPSyTf3E5cxA3mfqpg&oe=6AB2722D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbxqz8I0JmMQ7kNvwGb4lga&_nc_oc=AdqxQnwRWv4dvQQx_ns4TWJ1wS6tnoz5YL9-HdmV9yqX9nxkrckBkAkIBjL9BmN4BMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw-4EF9c0wPOKt1gVUL7jx4YjdT1nKt44YBWadbp2jBg&oe=6AB29C1A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuGJq11Tj0EQ7kNvwHemDMR&_nc_oc=Ado6i5vOyBiUOVWW4swihx98GLganpwdlhSs3Z1RYQqPqoVFI7uXYqrsVSeCQn2Te5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyZp4H38nSh3LtjGt3XSNlxNbBq-QSsajZSM-dIbu4YQ&oe=6AB29C3A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqwpOvnw6rQQ7kNvwGfNCMH&_nc_oc=Adpv-lFbnbAo7UeU8BYoLU0KU6gJcq09MsK_PYyus_SanE14iRw10dgBYY78Kow0TD0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnHNH4VP92rPPkEd4ySlYYoAV67M4iOos4Qm63SHflFw&oe=6AB2870C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa-wXpl17ZYQ7kNvwFh4N4E&_nc_oc=AdqjHXR-TUlqKF5T6mPE02bakT-9bcIX_ZDxGeqy4TIXFi8nLhtLSuVuFUYRmuzykwE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc-tvGz-_CZsERNfjO94texVf4r7Vc4Rzz1ynp83BSfA&oe=6AB2A60B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
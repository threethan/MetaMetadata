": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9US0ueIb40Q7kNvwHq9Oj1&_nc_oc=Adqwf0NVOkytiVi7v3k_UFCl6y1g1fvmvmjqY8f2mmSbaXKK9zkgil_AyGFDe43X8YA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zGnXj0Rk18DVtO6gcPFSRGzFP2tOzvuuZuBqvX5T3ag&oe=6A356BED"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhV6Qmnq0osQ7kNvwEGUkdh&_nc_oc=AdrqhPAg29F-94LTd7OhMzVR2ZDzbYqaqe3di880ziQvMMP_HA1oeYk4zQCLaYCBBCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SWlufezNkRjIXmb7t08y4FaKbVBln4jjIR2c1RrbNzg&oe=6A355D9A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gj8e67Grzq4Q7kNvwE-yjmy&_nc_oc=Adp2zvl95agVN7xIiO9Ikc3sJ8qYphEeA1hpdhYx8dZBRD0qgaA-clRhGpdKadwaSb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qoXPGqFoH6P5hW9PV-qKg2MkIi2eOlZ9GJPMtCA4_-A&oe=6A355DBA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iN5OO2QinLwQ7kNvwE7RTJC&_nc_oc=Adqg5WFytjvM-C_CqjGhVeSJRABNSUUHjA85HrUCrlWVTyOqFRWfeXNkmkgUGTTS2fQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VWA74p-5nBau_5AdoF9gTgqMzNSob7wiDhRXhyJ1x3g&oe=6A35488C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gyd2r_ZemsUQ7kNvwEf6Bkw&_nc_oc=AdqQlHFfWdGbPiuoRrLrUuvhpJ6baZZLaAIxDWht4YXYz5djv1ZSOlQpJlIFcVTlS5I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88DWsYLSAf0D389C8d7OmYZPQP4Uk_WmLbGn3qj9Yi4g&oe=6A35678B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Rs2rqbes3UQ7kNvwGNoTaB&_nc_oc=AdrOKJQZ1jYCI6sWzR38yWqf6eUi3v7KPRp2zzeEWxSVQjY8zmwMYlDwwBpsaBsv-Hw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADV9kQKH1zD6sRMMMlZWRi7pByOy265Q6fanjQG-YH0Q&oe=6A4A83ED"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THQ7LlyGTyMQ7kNvwGFN4WV&_nc_oc=AdoYJtgGUjl0D0Uwt6DJW40U_FODmO0-2AmyGczOrmzZKqIVdiZb2AEgPRimN1LTH0M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbCfTOkZFP7VJQ1DP-9SO1eHJs22m-fmfOgq5gJh_Qww&oe=6A4A759A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvZm1hCmh8kQ7kNvwFz3kbZ&_nc_oc=AdpVUEJhAvT_E5tbdvAeGTxQePss86V6EICzBE0_eJKmX2g99JH_P3DRseBSmXXjhhc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwua0_iOmuk8-AZ1PcvAOu3pqhUJipx8_nT8GPaWSaxQ&oe=6A4A75BA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXnGFeFrA2EQ7kNvwF7tc4j&_nc_oc=AdpVZvqhpqe0ME0vw8VhmRUFwpaB5yFT17fOBuBdItzmaQXbcmD9HDaNP2whjqfemhI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnqD8Eorao-XzYvYvUuJk325nBko9jNRWQW_DzjV52_g&oe=6A4A608C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjAr7BS-IAkQ7kNvwH92vul&_nc_oc=AdqLcJxYuqhZwE0UVyx5hbqY9_lotpjtyS5d7Ck_blsI5PtPsCHvOJYFLiDE8fpmfXo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL-p-vpRnz4HxYYSK4OmWmIYd574yOl9GBgytPnJtGww&oe=6A4A7F8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbQAv8IqUJcQ7kNvwEV0VzX&_nc_oc=Adoy0CmBwMGhTn3k6mGFMtzqqK_E9WiujLbbCLHwKgACSmG-rWyI0ijWj267tYk-oR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vDQF11871YSi0B-1Fz13kI6bBLO1G2G_AZZ-RPLjQbA&oe=6A0B03AD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAosVMOj3cEQ7kNvwFqXxSu&_nc_oc=AdpMCYkhh-5ZEeb7AJTAYLXDH0rRATxce7gnm-vSpK9GnYW1Qmbgmz5k4tWQ3a35e7o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af495yE2SjIH1JvUu94Q_MZZosgJ3w68TMqIchhN8rXCQg&oe=6A0B2D9A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIGItFgDLbgQ7kNvwHvIRLC&_nc_oc=AdpXdKiststI52zaAIZTFjnKm4caXyJAaVdwj82GAZKS_O_JIjebjje3ZOfbs_KpdSg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7alyPzKGLuJ0Gvl0fuh6kwz9IkQwdWQCxAvgD4jFheOg&oe=6A0B2DBA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWFk8f41dVAQ7kNvwHJSg-a&_nc_oc=AdoQL1i1ge0kToWoJUix4ZNwoVpen37K2i82sy3v5BLvQHc1LT_Pg5f5bSK7ql2Uu2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TcOejnIoJ2etcOIPp8l7oSit09tvP7G_FgVJr9dDV0A&oe=6A0B188C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qVOKvOfSN4Q7kNvwG24cEL&_nc_oc=AdrxBR57rH5bumCCcBe_EysTbgyptqlCFta0bCEvZYVXflCsoYAApF2M4WkhoA3ED3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Rny7vv-D1T3K0S6os7pwgGow4E96nAEHzRXNGc6Xmhw&oe=6A0B378B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
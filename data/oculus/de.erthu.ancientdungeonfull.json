": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rd-6GMw78W0Q7kNvwFrvZke&_nc_oc=AdrKfuQKHFkS_dq5THwS6YGCF-NYJ1zswzaxqhaw7GRQsJ3k8hU7SVz0BMRptNUjG0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi85mG5Zp14hR9Z7-uXsAGfHeFGAI9pMtwnF1XlyhYeQ&oe=6A8993AD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6nFqaDLz8UQ7kNvwH0gDN1&_nc_oc=AdriM4NTlC_st8JwryEmp52PmgHuX5v75bpwEesnOPIKH61XWwHhvAeDKtuoBDAFbJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjtHiDMpKfLo5ZDaLcPg4a4BUhoC06jMOpwCXbpvezwQ&oe=6A89855A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrZhT-xsnTYQ7kNvwFvzHUq&_nc_oc=AdpxZvlbOiDUv2oj3W-0vHnZB94m2MX8z9xbs0mjR0478ZmJqnqais29dFJDPy9OVow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmhiuS-2G4P8pJtn5Z0X-u_94rSpx1TXVO-KfPFUhUhg&oe=6A89857A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPeJN3qOxjcQ7kNvwEkcgc3&_nc_oc=AdpIk0hTqP8V0l7xcMusTA6GndioMivTZD0Mn_SWtT8TYDG7efqZQDY0yiOZBGDxY7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdr9IvpV-N-4JlXlit03Zzj9uBaQnw8xrK2WOpKmU7Qg&oe=6A89704C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m579lVsJOEwQ7kNvwEg_jjQ&_nc_oc=Adq149mdelj86dYfPeUYmFUtNSd6SiHpWukCPUnR5lydXK9hWznQd_VfJJCtLLdX_10&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQSLCVl8yHO9if1CDpWdxzLSvyi_-t8wuUdjP-fz4TGw&oe=6A898F4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
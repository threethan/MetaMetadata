": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TO0uUBDAcdIQ7kNvwEEAFDK&_nc_oc=AdpAOBiZbKV9zhmYMHCG6f0p5ttywnizasm9SiKTvpE064UDaXC2r4FRgYRbvDJ7aWo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgdPY4Ndb5sRuGC7uAfouU9nhqi-G_AgI9iRPTbTxOIA&oe=6ACFAB6D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWOM2XjlL6gQ7kNvwHQdzZY&_nc_oc=AdqljjKJ6ojZO_j0B8_nhHehWumvbivfIG7zfWddlV1zPdvS_fHXQH5K26lH6r4ZqAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_iKkZjx6ImAKaQK2L-pNxSmC37hYpky1Uoodk4NSdPA&oe=6ACF9D1A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXGzG2MChXQQ7kNvwHtuYYM&_nc_oc=AdqWmwTI1QdoAos1yGfow78FI2gG90mHQvYp-bZX6uz1UV5z8IGhJ3pTnFk9UreAAfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHqkz9N0vntS8z-s44lk-dqrE6mKLEqE2joV9QI1Pr-A&oe=6ACF9D3A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igl47tVgzVYQ7kNvwEdRhS3&_nc_oc=Adp-K3Z8swO20kNbirnN4CU8k7uW5-TixS4NRZ4nEAr0vz0BLKjHD9g07M0lraGtlQo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFMv7PjPL0jx1Nf1n8o7YH52EAm_-w51eBOdcAwDgzOg&oe=6ACF880C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPXmxUjP6eQQ7kNvwG5GZYR&_nc_oc=AdqY1ApmOaHpLqAzI5JzdNzdZfntjZ8kgGdJk_iQk9y-aiDLbPs_TLHNevOVUwP3nyw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1lHKDmwaS19GL-j0odBo5jBRG0B3XzQ9HO6fqpfcn7A&oe=6ACFA70B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
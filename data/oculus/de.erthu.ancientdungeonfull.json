": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBSbabNZF7UQ7kNvwE9MzGo&_nc_oc=AdpNGYL3INwfwQ3CSnXmIHYZAzlh23ob5MgDpsoubtDm5S2eQG3pB-MAAsHbcxFp_8U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXoiRyzPINk9Dezhj2i9VYVgSFwJXO-HEHGFOu188ssA&oe=6AC7C26D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNjPyU_76_IQ7kNvwHa3P3G&_nc_oc=AdoXQtOAqNqQCAYYr2RQUnzEt-2KOg7e-cXnXAp-7-cKt7-HOwdzFYEL3eF6gib-VJo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmR82oSdJp56WMUcxPSFmGdTzez8f6rSl1LekYEMbsPQ&oe=6AC7B41A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ago2kLEHIUsQ7kNvwHbIaRg&_nc_oc=Adp4ZO6le9asHozDsHE_xn0yBGeog6X-lJ4NGgT7NP3RCqGPtPYCErftMaMs_3c7fdg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHCJ6t7HIikv6QmOKsJzCWg1rHZBibCVbDXeWv3s1iDA&oe=6AC7B43A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYDoLh0pcT4Q7kNvwHY_N1U&_nc_oc=AdrcwMxEO9Fzg5P1nm7tbypHH54RTo8Y9NEha_qHXRsQMe1vxc4sMwwiJId4N_Z7fd4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmypv_41oNYg1gtS8p1yOhWgfdjRM0rfUgkpFuclDDyA&oe=6AC79F0C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAoDNKU6A0IQ7kNvwEA8SDg&_nc_oc=Adq1G3-30ZRZOLF7AkSQ4y7ed-AYEgjeKzblMIiYArqU7Oztb9WSygSiCy2gPgaNhfo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqf-wCg0ch4cv2n29lZajsTT1qiuzlatDDTRJ-V_NCIQ&oe=6AC7BE0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JU8esPL2RwQ7kNvwGvryqS&_nc_oc=AdryQTNyd2dIAmBn2XPuIU8fBRvi4SELQQBEyElbuLFawbMzZB-Pxlvnp3WBKzu5RMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7afgTQFM_zXBTTXgTlKJ4LKM7zdcA5G1KwRVbglzGWsQ&oe=69F9E02D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoUPBl_QMKIQ7kNvwEWG8_r&_nc_oc=AdrWdmKDlLrElLgUf6mjp99avEVe9IKtj56hqJ-H22tXXr2WFmLOMebSY1cHLQL68Z4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LgrXmAtSbBqDMC4Vc6d2vFZA_HfYNCkm6OHUggZNcXg&oe=69FA0A1A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgQFksZj2JIQ7kNvwEFpwsE&_nc_oc=AdqZ8VhBeEGzciggW9HtPXVy_VcdyFL9M_5rC41ySQAEP1Wt9QLm9ObK8vPmDwgTXrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NGufiZU4m5-wrS8-EpuTTqo_nvQSgY9wx4yH6Ng-lbA&oe=69FA0A3A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9faYS96E9B8Q7kNvwE5Qbi7&_nc_oc=AdqSpQKpgej7vCwo2UJq0jDCEBOw7SOZY4p6PnosqTxKTcWp7UT1b079AOY0VBLMqxM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57URxsTWIqxfHqiggW9rHULTA7xNmn8fJdDsOxUBz8iA&oe=69F9F50C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnI9jHcqfeQQ7kNvwGDn8ks&_nc_oc=AdpjAzUyqNlmLq5_alS8jme3h9iohWRZ67ZpyEhCuo9P3If3QSPiNL7zOmrLcDzqJGA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kGlj_dGUu-_GoU57LW9o2VS6Bz47ygM90sSQpDIclfw&oe=69F9DBCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
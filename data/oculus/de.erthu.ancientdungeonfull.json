//scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yy1z854hzNwQ7kNvwEAVIiy&_nc_oc=AdqxdZhz1tcQsIDy-WyCcu8Fyk9rvEo-iC2m3yPJPCC3Kl-NNPwnWPVOKJrXTKWhdCo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKkZUifUxB9InG3QUDpzANv3eBcByIKypKT4h-zwlx_w&oe=6AFDE4CC"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvOyIMp9KwcQ7kNvwEyWoIm&_nc_oc=AdrrvNjboJGUpS9B7Bvt3c4zqy-JtOrmsn_LFKFnFWtUa5j1p3Mv9c-k27WlK_zSmtI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXYASMFJWo1ZG9D5iPEQ_dBLHCfPOUZS_L_LvWTQjsWg&oe=6AFDCB8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1333803263709570"}}]}, "scheduled_offers": {"count": 65, "nodes": [{"status": "PUBLISHED", "id": "2157876978183594"}, {"status": "PUBLISHED", "id": "1354940736722193"}, {"status": "PUBLISHED", "id": "1380171114243761"}, {"status": "PUBLISHED", "id": "1357539846591204"}, {"status": "PUBLISHED", "id": "1909489356421018"}, {"status": "PUBLISHED", "id": "1691280058722453"}, {"status": "PUBLISHED", "id": "1006379205171893"}, {"status": "PUBLISHED", "id": "1215159574119645"}, {"status": "PUBLISHED", "id": "4023294834627739"}, {"status": "PUBLISHED", "id": "2104431443700456"}, {"status": "PUBLISHED", "id": "1163690872601844"}, {"status": "PUBLISHED", "id": "1055310233223573"}, {"status": "PUBLISHED", "id": "1298935042024957"}, {"status": "PUBLISHED", "id": "1211532296800622"}, {"status": "PUBLISHED", "id": "951876313558436"}, {"status": "PUBLISHED", "id": "1213244186811155"}, {"status": "PUBLISHED", "id": "923997866480557"}, {"status": "PUBLISHED", "id": "1361803958130341"}, {"status": "PUBLISHED", "id": "471753082310564
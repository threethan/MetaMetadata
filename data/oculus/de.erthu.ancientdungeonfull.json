": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRBPdQuUj40Q7kNvwEoc3L-&_nc_oc=AdouIm40Ugb2dwge1AuWiEW0fC2WOMrCDeAtcVouFHhHdOcmC6jZwO-3upnRg7bRhxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFeUkAfVwMdtXGvs-qRfgnSzA5hOludQzweuVnOYCACQ&oe=6AB7F06D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJJqZwES6NIQ7kNvwFx-Ce3&_nc_oc=AdroGu_RR6fGaiwlCCYV6y4JtDwA7NaIOOx3xz7AQplNijuXABDLTHSDyNdCc5YgVik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN12e2_m8FjSqNEkINI8fcOKrIENi4AAyijOSaEGIbKw&oe=6AB7E21A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lP7ohWcB7EQ7kNvwE0hU69&_nc_oc=Adpn3jYEZpuZje-Dr9a3AnbpjmGoNwpW1w0EMCnvLqS6NBIGjvEOqBP7STDouqMxz3g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwwFnNx2cZ1G3IWdEmvg7JEXMZhYJ4dHphDmPNbwEn0Q&oe=6AB7E23A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gu3iw9B-fx0Q7kNvwHCIgkE&_nc_oc=Adp_IE8WFxcpIQIiop35lWlrpC9qz1zGelf0D0rP0CSMk3-Ce-ai_xYQC1ZmIFJJZaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqvN3SMZplkbb99NbbdYWcGX0w6WMnuacqZNI_st5tYA&oe=6AB7CD0C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bn2I750WBhMQ7kNvwEXvSiH&_nc_oc=AdqAzpNp7AYJKykHD1Vd2hhek1Wyh5i4bxZ6l7DEP6YKB5DAbDjDp8rwbxAhssFe4X0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGLUNA5zEphhZi1tLn6yoveHWydjg1_NiWAX1mFk46Xw&oe=6AB7EC0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
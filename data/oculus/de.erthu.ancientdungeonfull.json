": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM8xz8CwHq8Q7kNvwHGbWCn&_nc_oc=AdoZB8WWaTGm1s4jr0z0oRkihub-EZxLDkeSufBuDitXCFeoNl6-f6E-CWcFksdHlrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNyYezCFPw_k2NpnQOKEbrJsYxIztX6LcgoVckLh4WDQ&oe=6A75CD2D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6n8fhRLR6cQ7kNvwF620S5&_nc_oc=AdoDTRgenbAoBD265f6QgMDnlhkBjAXl81mf_7vGZMrHHt2aZfLPRAf-dU9Sjq-V6aE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqSrcpfTURFShRKQJpep1QZQHRVM_MiCqdKve6Qiwtzw&oe=6A75F71A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcJEo-XRGdIQ7kNvwE_CFF7&_nc_oc=AdqgHf_SKjJo83IdtFU7QIh72OdGFvrxjjMVbNkPPaqNAgT-o8w3ZYlqh7qr-jRsVwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB7WQXn4Ibvl5hTF2nD7AAbZTh3IdDmHvITCV41XqLCQ&oe=6A75F73A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3acYFL1LtfMQ7kNvwFR0S0x&_nc_oc=AdpuB2t0YQdnV3WjVE2WWSvsH-ihC69K-VVc7uxymWQtTnVMkTqbejCklLHsmLNJ5kI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZovsTpuTZjdGLd0IM79AyDo389r4tRb0i-Ok2hwy91g&oe=6A75E20C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuHMJhmUa3oQ7kNvwEQjFhe&_nc_oc=AdpRPyJLTIe9Jtl9DP1tAiA-ZX0CmNluKT4VzVJBqkMO1xZjSCzEW0ejGbqCxGS9sY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvq9zc5S94Dme2ZbearVIezJojOJA1HQM8DAf23lbKEQ&oe=6A75C8CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
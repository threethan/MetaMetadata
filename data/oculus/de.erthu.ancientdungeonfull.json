": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wELo1ZAIg5cQ7kNvwFZqfvv&_nc_oc=Adofy_-z9_Kapk2f5GslyGJdBzjTlNbWPJ9bEMhedEprRmrrc8TEUNVYmJLxaRpCFTo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAO3cWdM3Fosx-5DeVU2mkLNBq6XeLxCnWV_umKByYlsw&oe=6A60B52D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs0EaT67HQsQ7kNvwGC0mmA&_nc_oc=Adp_FZdyxMa3mWcgaelBoNH586_1mdhL_zSNnjUkrnCQBt6-D_lQkwVRL0vjDnztz7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASocGINwbLFGQDFtImQZ-4t6MM3WO3lPrGL1dcnKWrYg&oe=6A60A6DA"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFP913Ge6XoQ7kNvwF-yWJd&_nc_oc=Adq911P3vru47oaQGojC60y3vs939WFK3Y3b-IHf0C2RrE-fv_uYqKAWLuG3S7aj8PA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_JpzJrb6B9YM24cgT6evIWQh9qKNFii2zdSvXduEJuA&oe=6A60A6FA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTc8LhzS0eoQ7kNvwEStYJ_&_nc_oc=AdqJX576pKCOM7ej4w0L_9PJWkhsdM3pmAlU_-l9j5ouCBfL-bruZx0uOTVN1V7VJIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPeFvcsTGnxfDcKIycpZoOfOhN9sSVrUo7DRSqH5e1dQ&oe=6A60CA0C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O4_QbGHQlQQ7kNvwHcQdjM&_nc_oc=AdqhVh3pzKbted0zAfmfR_bKfbt4sCZX8rdQtJHOX9KJkZsgxfqo7NkjTJqYkl_BqYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiVhzKPK97aQxar_v5w8u_Fq2ESng6o1z8lEEMCeqZEw&oe=6A60B0CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
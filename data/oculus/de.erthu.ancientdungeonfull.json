": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6elaWabSa4Q7kNvwEpzAo1&_nc_oc=AdpVgXAym-F1gutYISKtJwgeuP0GjZTCGaJV_1lLl2PvcBYmartyDaxj17ediCfBQ7g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-hX1FMuJ7GaayyPHxzIm0zgfrO5QbbmxCzU-OAXU5kg&oe=6A941FAD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Sxu4RA8LxIQ7kNvwEJpFRy&_nc_oc=AdpwshJY9DD44hY7TKUqhgYgBzMuFTCPqj06zwBSh09oDDRE_fsvK14-J7OUA9pQmAg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzqlgus-GvcZq4DaK4hpSp3pmiCYM4_tE5fDMax4ptBQ&oe=6A94115A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NF-89Mmd0GEQ7kNvwEK6Oud&_nc_oc=Adqc4l9qQcC06BSbEDMnNqKXLfuUfrAXsm91tzmJy2koxZPEGsWaA5o0vnp-DzsFd4I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-GQD_PkpM55LlVXTYyjwWM19a3EIhvzLL_fQLkAWpzw&oe=6A94117A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDN4O1Qh9ggQ7kNvwGsTZ-N&_nc_oc=AdotXzEQLQpWkeqzTgkoEmvCokP1eSU5CEkqEgpXGnq6SSGimlvSq7K0MQyfmfjBwps&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtjpDxZsZYzDKLEOtemMpJgfNhlVSRseyCPyYRwKG5GA&oe=6A93FC4C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWEx16s9jfIQ7kNvwHuqVre&_nc_oc=Adpn0OAIN_Ta7YnsZbzxj7RV9I2z8gm42tGe_KekIi2t9HQQxpJlRpma8hxQz2gFA1U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv0uukbqxoPPe53C_7Cfe4QglWMV-YipYutcUyRTQuug&oe=6A941B4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
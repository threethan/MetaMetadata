": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dOh3IdzKw4Q7kNvwHwGQcD&_nc_oc=Adqj_VnFd7lurP2yxbkT3JZJ-YPk9k_MPozWUrYLAqnpB9WJAMuXCQVSKAUzO2uh7Y4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy4NeUXuRtAA85TV1_fHPk7BmJYNCZ-09B6G4aKir6fQ&oe=6A5234AD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv7CKLMr7DcQ7kNvwGxG0Zi&_nc_oc=Ado-TWffDeYDl4z6hpxf2w9i1GNs2dA_MSg87IBqUGDTZvSLoJXabj9TAR94h82Nceg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC14nbegZcnrj02rmpI6sBMFnzuZvfb2RFiZbmI47bQZw&oe=6A525E9A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PB16aPC9ooEQ7kNvwHzfTRg&_nc_oc=AdoSBLdcXUhnBpW6S7C-izpFmP2iqMNSa0SXM854RQh8OkuNP6u74Horp_wG68NJvhQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCehj3c2OtZAb_nBgAhtjAm6Yj57mOS8SUAAuPH-ri__g&oe=6A525EBA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USlLFDb8As8Q7kNvwGXGwlP&_nc_oc=Adpl2DBAUWjXIXZZIeDRzn6xSp8rTb6oOV9ToYjeyXBlMYeHvTssfFGaNPoKc3jYMks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4V6DU-CD3u8jKd6wKDVBmM_De43324D-tctRPOgnpeA&oe=6A52498C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAdc8dMZtf4Q7kNvwHZUICH&_nc_oc=Ado9zpCszZs7ApgqsCiD0eGcLok4akeisNcc4Gi7BPWr2FlYjkL1EYjsELTIQtAmAq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZHAf4snkP8dFZ1tMNdWFPrEVowpWJoJPa7yDlxipdsg&oe=6A52304B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
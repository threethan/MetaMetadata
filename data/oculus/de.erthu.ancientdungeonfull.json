": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VOQI3O8qvYQ7kNvwGYA9TI&_nc_oc=AdosUaeOo0vfpE2KXdoVOYWDWlfyaXsj5uboQQHd5OcSUPRE9BEkO_rlsjuKB94ksts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF19PV04fdwZX7P3J4zAgYp4qgT06NFfs2-erYoKpkVcQ&oe=6A7C64AD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7TOjdaSA2gQ7kNvwG-_Y18&_nc_oc=Adpk4M9f6VIuUrUR255VrC8Eb0XDb9XWZ9kuezbi3rEkMGqAZsBGwvDVXhAHEQo7fTg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK-2_V21jyGBIzfmwo7pKDtVRgdyJCzbnYg2dXuEYlyg&oe=6A7C565A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfJCyjub67UQ7kNvwFqsLjk&_nc_oc=AdqFj6qYrSA5eM4Z0IvBW7NQcnBwHugJP98fCoPduvniLXb1i1ejqBxVGdHmLQYrFuc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXuOKckAS3GHLNBP40ViM5jjUyo4Y3DcHpqsCrD59vow&oe=6A7C567A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgvH_MPKgogQ7kNvwGHaeof&_nc_oc=Adp0QvNjMf6uNy8gMqADLs-5EQ1BocH4sYXSWgirMgVpJfKtbvMsRELT3YCN-Kcun_I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6GlPiFoNBGyGctvwp51XyVLq--PK-nxtkas8j1uHydg&oe=6A7C798C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jb17wyQQLn4Q7kNvwGFaXjj&_nc_oc=Ado6IHwH2Sfalbk2kyubY5_JVCTZFy4LtFkgN36_BSt97kAKzS4j0cUGJeZbCtCIUY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD5AchOA9_wbRw1qfFGJ4QIwsmY8NO6uGEqSuQvpnsgQ&oe=6A7C604B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
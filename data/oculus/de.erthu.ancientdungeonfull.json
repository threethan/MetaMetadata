": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCYnIf2XdpQQ7kNvwFW43xZ&_nc_oc=Adp2FuUFGDWm-lObQ-Qlnm5-gMizsyjiCwgtfmH0RSOZ043I50zXfPl-rCUFU0HpM6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2sMUX8mLgnFVhjeZ_HoFeII1ouD0GBmgrK0w4P5rXAg&oe=6AEDFDED"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GomBwtQw1D8Q7kNvwHhfuVi&_nc_oc=AdqMQAQkXzysMDxCr1ycBkD6ovEk3taI9TpdV-BNQB4VgIeqyVkk9IN_xsOoalsBkRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSty5YIx0jTsVDZ9IARykjV4fAksApmU55M8g30VsPebw&oe=6AEDEF9A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkUIVUtQLMYQ7kNvwGwaDz5&_nc_oc=AdoM3QWRs93SNPKXsxv5j5HI9XnJ5gLLb0BLLgty-vtKcVEo92jqDlFGQnYZdP5c4HU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjxLbVf9B808h31qRi-S5xb2GJcEtqefix-nR5RjQndA&oe=6AEDEFBA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6d-cgFOKsAQ7kNvwFC3Hv2&_nc_oc=Adpa1FT02U8uYPLg9dJXsxBbQ6ua5eEYdse2pIPTC-ZLmLXVA4a6Yl_sn2jMhB-pHDs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ95r2D4it4UxOQM2HePvmkwUD9YdEst9Ua54ngvjMHg&oe=6AEDDA8C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYijKJzCwPAQ7kNvwEugbMn&_nc_oc=AdoE3OpFZYQSJmd7hq2N7qzjhGIl8gdambTj1GR90tPS9-qCGtINaT888W2oXFac0UA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_uXF1-eRb2nGF1pr2c0sR_j_Y7zXofFAhlSMJ6JapYw&oe=6AEDF98B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
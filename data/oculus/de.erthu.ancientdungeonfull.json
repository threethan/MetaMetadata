": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyPm99ov1KgQ7kNvwEn-BJN&_nc_oc=AdpFzylVqxIy4M-5R857JlJg3ub_rNPA42AWp2feWW6sOecM684vtOuBAUWLZBG5fsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y0lUWpQ5gohwGM_PcKT3fcBGXosWlKTaCIvQZntDNPA&oe=6A05BDAD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmUNWU3qGAgQ7kNvwE-LnCE&_nc_oc=AdoNTlI1p2ZTv5gK14Xo49HxrwFdx-2YhGIhhHuQvisdDJFZXaGXVsATt_IHPTlz9-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-wdyNR6OLjD0OFv9Cd7Oy2TBmduKUxvNPtl244kOTNA&oe=6A05E79A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hg_OjyCCzv0Q7kNvwGqLKAf&_nc_oc=AdquZs9RTzt7aWvXYMXXMb5ewTDygPUU_o3qA027RWgLv5SuMe9VjNKH3qsaYWtclJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o8vgEeJbvgfMNHaf_EaZDD7x85GRV2TWUxnrcGVkIFQ&oe=6A05E7BA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7M2-ihrxgDgQ7kNvwGspvJy&_nc_oc=AdpqL75QQymELxXRImE3gKshBGeUQV9FbbUP4ZHUziXk_Y9xxGUZaxMWdtkYTFySd5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5x-pQLkdJDAwXyQK3CtLNZPn1ROfH_C_qESJZAZykUVw&oe=6A05D28C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y5CK9dHs_UQ7kNvwGZ4uEb&_nc_oc=Adoti-Xi842puk_-3BIvQ1CWrhA3uVBIRV50R9_ddWs395BdZRslWrdoOSDJXC4b9BE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uS6m3ZcN8iGKaiwyZJYa010PEuv0R7QWl0gBySXy1Gw&oe=6A05F18B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
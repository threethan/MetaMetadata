": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bKN79PR2PUQ7kNvwFEEiT7&_nc_oc=AdpWfQKu4H9kOx2Cn9FLKe6hMgDf5_HbDldf5A5D-fxHO7Jx246G8AZkEyd9PQitItE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wSPJucnu3_Ga7DL4LUGsB2OTTweiKSy6H0qPQOaZvFA&oe=6A1ECA2D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqwN7IMUu3QQ7kNvwGWe4tQ&_nc_oc=AdrbEw5BhmduT8vefMxohqHCJssjriYvUkeic9B2a1f9YR7JgM7g2AapdYfbrhfUlco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CqR1ZZVlR3aQXEitBrICnHmE49g8Cw-mQHRPA1Z9Tyg&oe=6A1EF41A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah-89ya7a4cQ7kNvwFfsjbG&_nc_oc=Adq9VRor88non-wA_k67pi9VWDTMTOC_hMKyp753ovkjiaM6TfmMSF1vwGk0CNvqeCo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tIoKUIB8En4DdZI1ncA-bMw3tHHKCEqQifbWW51xKaQ&oe=6A1EF43A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPQelCnbOTwQ7kNvwEtWxTS&_nc_oc=AdrkLDg_iQAMVhhju1dxBva_pjQYqs-yYdXHOe2DSa5K2tAOk2LPGvDhwxzpUr36Sx0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5J0xrPp_4YN2iKIuxS7LCgmnkg2YV_TY5DuwDDwwNdtQ&oe=6A1EDF0C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxywZtxniD8Q7kNvwFcP5aJ&_nc_oc=AdqGSkRMG7W3UtMTUB1MGvrQzwLcgEWXVR5ESO-I_QWBf4pWFnPZDpevQtautguhl54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7igY-V0jaf7NWnRisGZVdU9mJPRIrofYzQ3fW0LLaH0A&oe=6A1EFE0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ti0XGYb6KCwQ7kNvwEEuiMN&_nc_oc=Adk-m2i8793MhNscbYsX4Sw3Ci0EbXWMa-p47LiDfkEUF-dmlOoM5hc5USDxA9xeinw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRc4hLH7sg1c0NNCQWEe9Al6EIi-AzlFMfjxiQSCWiSg&oe=69BD3B2D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFkt5Vh4JUsQ7kNvwF1St7J&_nc_oc=Adma9cJhk4ERtVYZj2_pAbI1dC43ZKtHQG74ZC_Rn6Zjdah87UILlxVKbfkotzTIOB4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLRnBtvSUkOjnMIPVMDst-RtYxY4_mTxKGshWQ-yj0rg&oe=69BD2CDA"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmwB4kdT5RoQ7kNvwHvPXrO&_nc_oc=AdmiTPuezkEJS2tb3JQ9M8XXQjMvZKAuRUs8EB9fAgVIQq2IKt0V7biMK37yGhl3r38&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLxyuLhPYy5vaifxJmoJSgdX9ztNHnwvwcntRg1ATkGQ&oe=69BD2CFA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nnGqAYCVSkQ7kNvwG4oXNn&_nc_oc=AdkxhPCJklLLTfKYj0dL6qoWTTG-xTtT3I2_06bejQ4XoCin3clLpiYh_GBwFAJalMA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxo-gxjfCo4X6EjyWi9cRZst1MMF-qW32bugzcNegflLQ&oe=69BD500C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_T2yHHU2MsQ7kNvwEJLF1S&_nc_oc=AdlLBYESuwCf_2dq1CN3lzSizGAIWl06oMohqFp2yqberCY4AhaAlL6La2i66sxs4gY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyw_km3h3zfrefnmVDaxYWnnJEv6Tow4VEYQto1zpalHw&oe=69BD36CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
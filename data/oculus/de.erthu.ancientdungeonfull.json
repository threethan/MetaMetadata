.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mPxZvZl7ecQ7kNvwEtBIYT&_nc_oc=Adn6N0o0GoqyVd2X8HjwdF6pdMdOzkWxnb3AS0U2MNRURItDJZLLnHhJfh_YLaU3-v4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiI5OtwOMlS69co0HIxMj-bIi5zk4p8_t8MznLkgABcw&oe=69B400AD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiN_DlbdLRQQ7kNvwH6c7PO&_nc_oc=Adko66R9sVLt1xQ43QixMOTZyMGgRucfwUTLKedhYlfzpJvTaCgzr-dEHVy38XyPW-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwlr82RhJ9rHqk0GCG3R-6Zed_fuXtL2qbnQY5kudh5yQ&oe=69B3F25A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RB7Mib-QhREQ7kNvwGFyjVn&_nc_oc=AdkGNRvx8CPyfZ3Xlu7iQIqYx_2F9nRI3TgcKGBUVgLktZ-SA07YjWvj9J5h2cgUvAo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrR5g3OhS9toRWsGW2ejTZdtnpfJ7xXaa_2d6T5I3zwg&oe=69B3F27A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rt2IEusFwO4Q7kNvwEWsu7S&_nc_oc=AdkmuNKvmx_D_V9K-oVeyUX20IH4-Y2sexrzSp8MSjJiBtRTqfTcLO_j5bZWYlQKE4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8pLmTWyePNOOOX4DWv2qzpHy8_i-STRvwXA0mZZqrzQ&oe=69B4158C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=821lMOFfIxMQ7kNvwGjNSDE&_nc_oc=Adlc8hM_in3AFebsEKsLZy5SzZD0suDcWwlvQ2WVWvQA62wspQqnDxi68UA7zHiL-9s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw1NpiO2UJ67qiSTVMN_46l1-s-KiTGrDiZunQyggb2fw&oe=69B3FC4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
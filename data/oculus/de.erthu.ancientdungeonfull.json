.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yb7tKkF9rIsQ7kNvwGmzvjF&_nc_oc=Adm74Kh3_eBizgzXcmYoOtKByC21OsFacVmTlWcdSaD5kw7FeQW97Drzea7-8vFOg0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvpc-5QHvwx5jk3e_C3GohDj4LazdN8PSykXKQemHe0uQ&oe=69A974AD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8gVucAb22EQ7kNvwFduWvn&_nc_oc=AdkM-2_SxPzDUlrGkLiD8Xg86Ugto-fZw113mXO1LTkCDztu3KgcKaZgp5nm5P52_PM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv65ErriHrt5MJTlbb34dIjv2yC_j_e8miCOm6GwAsUqw&oe=69A9665A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqGXjTCXw40Q7kNvwG-b_4Q&_nc_oc=AdnHt-DXeDEL6CezPMoq2v-QLE7BqEBpopLQYnzm-x28M_5xk6smMwRhdPzw_IxQ2To&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuthCcm89QYzybmLF66jUbQCUGNRf7XSGnjQ0VrIjqikQ&oe=69A9667A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44QwlDy3tfMQ7kNvwECgR9K&_nc_oc=Adk3iyBYM1xj7vw4ntdR5Mylg5IDUwJl127xMVPdPnLmfUllWCuhZZYET0bF5sC9vyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftYPLDUMv1Kk9P3MBb4K27tkjtAq4VOkOMHPbN02oZ7KA&oe=69A9898C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nsEtfFKNA0Q7kNvwEF-Pr-&_nc_oc=Adk5XM8mp3j_FRajPh7zGOtjzaVJysSmWcv_3OcIlTgpgxr5zflQvOR2K7OFa61W5sk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftmaYD05xfLx1GTVlvpV-HqD40C9T6J4gN-klKhtoo0jQ&oe=69A9704B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyPm99ov1KgQ7kNvwFMU2Ox&_nc_oc=AdqMjYd5XpUhyJUqMAElSxlyST_SiQyZc_3zV7vWVwCF-m18MY3vHBBorbu8PbYoor0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78hgMWLxY1fT-P-viU-_9-URquTKwSvYPFbX7QK-_ToQ&oe=6A0860AD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6uafzbyvkkQ7kNvwFs4MCS&_nc_oc=Ado6Sni6nad-vwaACTTkVWNp8VfxzIxqvdsEtQTau5V_HNYNY_FYPD2yUA7rokRikU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OyXdILjWH_jSC4ad2k6O4rG56PCSiKjiDpisJipJJ5g&oe=6A088A9A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIGItFgDLbgQ7kNvwEOKjBl&_nc_oc=AdoMrmqpgcv-SFC0Tyh07x-Scct3WbMUBkDKnWYeMBUNzKyHfpQtLEnsvQuX8Ar6VLE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yzV66Fwt24pe-llaK93KvQOW7XkaHzGZPSnyn6k7wFA&oe=6A088ABA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7M2-ihrxgDgQ7kNvwHrCa7R&_nc_oc=AdpERLaMFybSy1MtoOSqdmGaQ3YiwN4gW_Pv1f3hjAw3g4LmDURJFnTHMk--Z7Fvb3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fDN3bjtJC9RLzXZ-IWOVoYj7_ZSbO2Y_D_BuF8oeYmg&oe=6A08758C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F2T-yfnbIoQ7kNvwEHmqZ4&_nc_oc=AdpchcUozTQ_kjCQP7Jt9JzuZv1rLSjr3OJGz027xJM8Rm1JJrkzgdhuGoQfOoypeEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DIp_q_sHrdmGSr560f4tSDXl1HZ4y66vE4BgjSpoVgw&oe=6A08948B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
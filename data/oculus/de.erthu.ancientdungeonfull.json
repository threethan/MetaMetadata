": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvALEhM_HZUQ7kNvwGQSurc&_nc_oc=AdqpO9_zoJVBqKebnJ9-BoFvAII2veVuYxvFwEuuwvCfW3b2KKo1pLmctNNZNH6CaOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNez_DkugRnUgDD2xbR8lcLZjFR21rp4zpxq4MAmxJAdA&oe=6AC670ED"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNjPyU_76_IQ7kNvwEAy32m&_nc_oc=AdqB_38F-Vj6gNaDMQwes0f312IenYerPpyM5uF4zS3K1mvxW1Zezi9_Nh-Uf7WM20U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlB10TpHvYWp36tMhlrg1XcGZiQPwAhj3odtSdDiEsTQ&oe=6AC6629A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ago2kLEHIUsQ7kNvwFh1thG&_nc_oc=AdokrWgJVAbVD0Dfw2XpCgWf1LQlfCv86JoIMEuisE0qA039XQtij-epM9YVOy1610k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb2EPv0VcDC72XLQhcNdGZz2cITiiw8CmrLTb2JDyreA&oe=6AC662BA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vv_7Kh7kC6cQ7kNvwGdtg5l&_nc_oc=Adq-1ULWn4U1jOkeQ2IXAinLEosvLq2NENsVI1HLeKHnj6LgEpymCEG7yiWUv2Bw-uY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNT3pXlYgnqmOxeA7vbaf4nTpY5UpEfRY8rIuwTwfsGPA&oe=6AC64D8C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAoDNKU6A0IQ7kNvwHNZZxv&_nc_oc=AdrWQ4hRS7CV10FYeMZEvBLbNtMcrG5kH-w_rK8z2aoChEfCuIS2pzE_Yzq-HA9QY90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUv3hV4_RFeoLjE-EsGp8OtP7eytP7v_YhEGFbyftIyw&oe=6AC66C8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E34cwqzSFY0Q7kNvwF5fh84&_nc_oc=AdqqlU4xtRes2b5LqTQjbJ2zRb8kP7HiEgSooh2901g0wEcTujvm7cNIOd3sOIDVHU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXk2OQ7Udw83Q9wlKWOFMUVNzpWH74ntGqpZN_Cn734w&oe=6A78702D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6n8fhRLR6cQ7kNvwERW6c5&_nc_oc=Adqbaza52Sgl3mG4kDIYVNyp1Tgea_ibwNGOa37Ujqxp3zIwgWMc4CTbXmzbvEbBi0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGChbo58CmEQcZA69KtSndaCSzfi0Dhe_YdijXLSGq_mA&oe=6A7861DA"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyBYiS4a1fgQ7kNvwEw8LPj&_nc_oc=AdpuU5jVbjtAATjCT2vPHfYjOnnNWkR1kj6SUIPi73rIs725_cuCLGW2cC-gFgze6Z4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG778TAWEg4ywA5kWyEwMVr9BKDliyKeKnbeeZwdI_PZw&oe=6A7861FA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1ML8gxZRzMQ7kNvwEH8pkN&_nc_oc=AdqNK-vGF0EQ7CybGr0fGS-xdryQ_7XzEFlC6dQY5InioeRxWgt8MJh0_y4GT1q--JM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAuUyJjz6CNMhQmxbg8oUfnzEN1EVVeounNpmmA_IMJw&oe=6A78850C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuHMJhmUa3oQ7kNvwF7PSR-&_nc_oc=AdqWdsTJMDVyGKkyK9ZmVr8ItOvUXoKYpxwHmr2TYcE4UySPFldV2_Hxrd0PpOWxi0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpbJcmhBRtpjN9LBzU7ZxPdtLWnpKIADcrFmLCk_Z7NQ&oe=6A786BCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
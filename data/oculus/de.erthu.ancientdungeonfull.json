04184078", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VOQI3O8qvYQ7kNvwGnHtD5&_nc_oc=AdqtGCnoX_V9RPRGRess-HAtmfKZ3QX7VxsW8OtBWe9sIlCZQxe9AR27CQX_rnCJatE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZpxbYDLS9qtKNN4LhVSjQ3CCY5jtHO061lRq1WUgtbA&oe=6A7DB62D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyGPlWN-Qe4Q7kNvwEw7_bG&_nc_oc=AdpN_v-fZS90kn1Ma39U_JT1nJ_VEs6jD4bh0gST14kI6S6vdgEZ4wSNbjtuszJm5Og&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsrXbhf19-F_Z46I0u-FKMwvFrcWMRuFBTtpm2bfOj-A&oe=6A7DA7DA"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfJCyjub67UQ7kNvwGwXIUB&_nc_oc=AdrY0ImuCHkktI-PUMVRWmnsp3mZoKV5eUT__4ZpPo6bT3Y-RsC9jsSUfnGCgcoo_S8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb0u--eBaXmSuKN8SEnn9HKiXnOCAcM5aj_YfFyMLfSg&oe=6A7DA7FA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgvH_MPKgogQ7kNvwFbM_e5&_nc_oc=AdoPA1a08Rk86Q8-pPtSSd-ca4ynLKHCfAqrRUfm-By2ZiSzAcRb69Zm9QJw2i4puJ4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZZ72gwqdGhF630smQ1JsgK1C0yNvroIOG8REWzaxLgw&oe=6A7DCB0C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7JqToR41GMQ7kNvwE-QX76&_nc_oc=AdrhCb4pnE3lC7cLCG3xmj81LoeKExiKBuLfuYd_gyHpIX8Oa_wQmXdGpNW1fadIOzo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEctqr7HgApUDkrVZJR-gbFM1eCX0_Hy3CYipbnrMTJFA&oe=6A7DB1CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
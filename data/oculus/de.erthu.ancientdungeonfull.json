": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLTLi8VDyEQQ7kNvwFD2OnM&_nc_oc=Adr4zjE3eK7NXiOS7uyvFRdqzFoeNlHTN77Pogn6XOh4w5jeeL-Rsnz0rYxKvQC-Ec0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABYQfahcvZkQuknMqQyk58v6qaPkjYeMYCPlxTO7QZ8w&oe=6A69EFAD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPxJkJ-e8TEQ7kNvwFQk9-m&_nc_oc=Adp366Sg9afRj_tzW1wCILGkwtXf84LIoJ7Um2Obsw5pZUoWC9tJ_6grq7H6zoJcZVw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTmtVbkzXYOz5WIh8CptI8QbzdYjWB6R-d8-VCujuL6Q&oe=6A69E15A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fO2xvU4SKIQ7kNvwGTwlJE&_nc_oc=Adqu7QA_9oAseoYv3btxGETsXaFrlTliGZoXb5VxpAOlGx8Wj8TovUkvJZ00-m0owUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrafYrFEcG3xhU8i1Iptkf8X_lbGi21pl7pQRDfw08dQ&oe=6A69E17A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=litzu8MvV70Q7kNvwEgTmCC&_nc_oc=AdoI7AAAMMdNKrscM18G7m_mV2-0FCRpIh9luo9zaVPTYDUpRRoDkSYilwAHZj7_Vp8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDog8iHIpyLzFQ2bEo7kNszDfY8xA2b93ht7INiVeHF0g&oe=6A6A048C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRizJ8-1TdoQ7kNvwFp3Yho&_nc_oc=AdpYuDkk_KPky9N65pcmZ9ynfDOOdPh-RevVQI4ks2-tmIFotsM098fE7r2ieXdy5X8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0tBoCd5F38MQDQfgIGdL6hYfLKq-UdLJ77yyVQd5AJw&oe=6A69EB4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
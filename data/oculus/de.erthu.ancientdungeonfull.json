": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luy9D7d8oWUQ7kNvwGs7_qv&_nc_oc=Adp6MTrLlihLm6khGZrKZze54iWH7yLujTS0dl2T1OGpAdO9bR6sehgWSxkZ8_JxYi8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx6EPttGHP0w5loEoavufdARx1Q-5v0aiMgdjcz-JFLQ&oe=6A65FB2D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uYpP4_UafAQ7kNvwGzKDDz&_nc_oc=AdpzYQLwYf6_Ba0ZkZdsg3Af5sE1JS08EIdLr3h7XE6AHEt8LfS30vkd4886s57bInI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRMEerDm5kb9xZWLmUiHZSc9L98hp-pbd-xyldF7NIQw&oe=6A66251A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfQ-wiXAaKsQ7kNvwHyUghL&_nc_oc=AdrLrkkFGMB6SkAQXhSykTKkJmevk1q99F-zR7tdCK6tPys0kuAH5qEynSvjzlJfFwI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNgyAFbr11_f9yMhkCiDxmrHmg0Fy_U04LRG2BpG4xzg&oe=6A66253A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAYzX11oTycQ7kNvwFfWYXv&_nc_oc=Adrl0jsga2HqGTrxrCF8ZBH0xC573lrpin46dmQQC5oMScJr_yzzvo3oOa0UKtm65yc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAntxXCharxYEy-4dZ12xQC5RDv9_MJN90jhpyZ2lcF5w&oe=6A66100C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vEneKM_qM0Q7kNvwERG1Lq&_nc_oc=AdqbW4wX8Z-7hv7aSzRkozIg-SoMYH6hJ30_XNvXd2sfXe9pmOe8VkmXz9c3tAt2sMM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKIm3sqd-G4s3XlkYVKvBu5hdjyBj8C9KXfnBKjQ0sUQ&oe=6A65F6CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
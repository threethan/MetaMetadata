": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuvYBfpp9NwQ7kNvwFfc2fh&_nc_oc=Adp4gH6e93B3ypz1BhYXA02wSuCyz2k3qBK_dqON3XyV85-_BoYWB2sQrkdGm4O8bG0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0DeKzDRofaiCLGyHrOMYaBm67gB5XERCfoPl_ImaJ3g&oe=6A4E402D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7ehEbCPXuEQ7kNvwHNQ8Aw&_nc_oc=Adq4rZBLAU1y5_kf3c-qxRiUnessrPRgT7oU0h-BMEZUhsKNCUWGRc2vj2QsDrv3LQ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwdlyMChIpr10_9pvs-fcOEkyr4p9KJobvBFOehJXBDQ&oe=6A4E6A1A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGdxMdQMOssQ7kNvwEkuePt&_nc_oc=Adr-XdKBXzjNM4oMXUWjGk6XznPf8NvQIk8QO5fC0sL1r2CEpNGzQGNOlLp84N6lBes&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdIvnKuFDQ_PMoHdhnUt06u7SUnXbXLKnEbYNTIVFKrA&oe=6A4E6A3A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zB440PJh4sQQ7kNvwGtbXk5&_nc_oc=AdqSrJJlJbGt4jXoHoVpsZSYFtN9HdPzCbRoO_46XGJmv4DZTMtbcUbeudQvrIjFs1A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDz0VrJJR-MlnhYmADHpUXDJOblA_TJVt-zJ6iAR5OiJw&oe=6A4E550C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4yd5JDKRMQQ7kNvwHaVJlP&_nc_oc=Adq3Q480m-aityL1faDOh1ajqxi-B7JmELGSL-D_lfHDfV6i0VNbcjyZaWgBNsaxgNY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfqy3Qw0cYyk_-kexkKFYGGBf8c7l4Pn04ajUhv0FiqQ&oe=6A4E3BCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
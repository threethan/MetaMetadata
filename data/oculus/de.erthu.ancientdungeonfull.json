": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FSzSCDHndAQ7kNvwFI4Yzs&_nc_oc=AdpJ8XCOiIrJPGK7p_Ii8dpVjRlnsnSdFRvttwJidhAbn0A_qaoAiVax130OytC86R4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMitBHPUkv6sXZEATgDd7Ab_DMm5In0dSjR_ptP-_3UgQ&oe=6AC27C6D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCVI_h11OX8Q7kNvwGHk1EI&_nc_oc=AdqMZgq4nlyb5R6HR8iuuP-cOQDn-RK9Kbx1f3lNn2ojn_Tqx3FX_oqDun_ea2rSf1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo1-B6ogay4-36mxFUZoehqFCdGayJpS46NqA4vucYiA&oe=6AC26E1A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0i0c7YGB6ZQQ7kNvwHlai9Q&_nc_oc=AdqAQa1LTinRR96rYkVdIzlwSczjdqSNnjUZ-QdC1KHWUniXKb6Sk0YAxqzgRqXjk_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9EUA6JnL99nqKzgJyqfoT8kX7BOrrvqLZVfFkzVjCDA&oe=6AC26E3A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBw0c4f_tVkQ7kNvwHSnNCm&_nc_oc=AdoFIN4piuBziLPkd5sOvIAFfWFETJvia0ySuMDad6QwU3aZHePwQLz1EibdxNrLlRw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiOUJNl_cFwg-f1Y9aMcKkEJ3e8AU0fb7d0ZGFvQOcKA&oe=6AC2590C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2jRMh_30HoQ7kNvwGrP2tu&_nc_oc=Adrt5MTjToudRmEclyMquYU1Ff9fQFaQJBCabv8AhvmHDFJ1qWEim2fqMDd8qKRG5ss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9fkKyyLHDvg8wTvM8WFe5bcl7W1bluDkMn0uQfUYODA&oe=6AC2780B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
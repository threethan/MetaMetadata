": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUKU8kED7oAQ7kNvwHqL8_v&_nc_oc=AdoiC3MMQyaRc5B-a2rwyPmLr547LuoT46TO5tFlelIuvt_M5nyMOOW9A7Mk9nsiZgo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A4l8OCkrKv-c-KA5o8TyVsesThm-XA76RUhHf-fvngA&oe=6A26EB6D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFhYxj77cL0Q7kNvwFlzUhO&_nc_oc=AdrkMydb-R6gWCCm28ZSTS421-Lbb9rkA6suj7SMFf0Vc19y6XnS5Z3QJ_f7A5u7XeE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zKhNUPxxNAdNUXgyXfn7vf6BrOc6jTKTywQWn6BhsGQ&oe=6A26DD1A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GLaJxhRsi4Q7kNvwF9kgJ2&_nc_oc=Adpyc32tDyTpjyGo2M6DhDLGNeUg6ZyIkiaNKw1lNy2cbIidqrpMx_Rt-BESGZ556jQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HEowBsIGwea-hqIQtTFDrXWLR-FU9qnbgrn8rPhydbA&oe=6A26DD3A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsI2xA4zzhwQ7kNvwEP9ESo&_nc_oc=AdrMQiGRGVWmkbPeNzPw4RFoJYy3o1ov6vbm9L0RT_aJrW0WNa-P7nYT_3urn9SIGY4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nx04EWfcGRLmzQyw-Yt5TyOd3ty3To8asDHcU6fZ6vg&oe=6A26C80C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uflvrCmlwoQ7kNvwHWmpit&_nc_oc=AdqrflAb1Wt-CV6Ho5U-sscG4sidEzb3Hqg5bTlNRs3Y2cItC0o_oUW6mcpq8Fz3uJU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-njEBO9to1AGV62-idLM29E2zeCb_7Vmhj95rQ4eWRpQ&oe=6A26E70B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
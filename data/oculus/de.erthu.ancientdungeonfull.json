": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBMF1Lldg0UQ7kNvwEF7-k_&_nc_oc=Adrb8l-d-OgwRcx8RYUnmcLlcFL21slG3lJFav22NkMyZFBadB3DxVZQJLxGNTmO2UY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp22kGeK6DFKytP1OiWANJ0vMeYrc2jBZ24lpOAu3IQw&oe=6A984C6D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMnOPXgrC-wQ7kNvwH1DRP-&_nc_oc=AdrboGjx4iW1yvYFHeBZEy3bqzaC_D3GCERjDzoHZAjJ42Q7zEtJyi9slTauDJmtKgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINx5M-StD9mj-N6LtSsXILVLXIAQx3Ed6Q-66-zIjNBg&oe=6A983E1A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4VwLIvY6MQQ7kNvwH3h-LV&_nc_oc=AdroVssiY6d2HjTeaP1HuA2VXoM7XMDMmnrIyI5MmBdDKjCXB80il9P-lfTUQndWl5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtAFv2HEZMyb1U2hgVWsI1Zjv9hJ-cY-watGku7NHFSg&oe=6A983E3A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGEpiovyAYwQ7kNvwHfzkq3&_nc_oc=Adqm3xYCDnhQFr8AX3haoFn2UgSt3hVuN4tue5rfZsn297Fou-5xwv22HqAsHB5_67w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLF-XowMRB_cKy412XoylNK8maXyjv0pF9nVB8r0wWig&oe=6A98614C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98hvkghovpAQ7kNvwF7lWzc&_nc_oc=AdqbtrBzM1ksHxKEVrfzyCCCM68UQZufgilIAdbhuWBtP5HXBX5L4KuTbonMOZSr76g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuR3ARcwRluC5UjlbYwSiFaAKbW46vsiyflt_7IPZE6Q&oe=6A98480B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
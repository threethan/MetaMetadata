": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xd_Y8Evx-ugQ7kNvwFNpGuk&_nc_oc=Adr4i3Q5UxPphO8hsM1kWxNC-jZSeurBmHc3IzviRYs5Q6EDnvOoKkHbaJES6kU6RQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK95s81M033QJ7YzElEqryzP1ANdZGd_jP-nZNAyOz0sA&oe=6A9C40ED"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgKzISnMMQYQ7kNvwG0epd0&_nc_oc=Adpnuh4kKj1mSUAMWghr4kzpeJilCMhKNbHwojhl1QLnP7ed--IeFC5Jl-PS47Ye-pg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9JN7oqsw2H33wqUDJlOoGGMZfL2eWunEbzvMcn-Sqvw&oe=6A9C329A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1zjrQ0q5QsQ7kNvwHTFckH&_nc_oc=Adqp_Phr_Qy7GxwCmr-nkDBVobDv1JZvnkkE96JIa41XK3Id9IhBRDthKdXKLT003SY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmzMToAFbNQDTYRAY3BO2zv-Ny8REpRF9OcFQq-CSLRA&oe=6A9C32BA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr3Ef9kPfoAQ7kNvwGiWosk&_nc_oc=AdrTWuKriVqWnjcFHqGsFDqiXxFS8MCdRwah5W3BcqzO59XfyPM5GaSqk2a9crJPEq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLASway5DNYyfg2JjKakBZzHKEw-yhh59cJ9ASyQP_J2A&oe=6A9C1D8C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQw1F75NZUYQ7kNvwE3lafs&_nc_oc=AdqiDbxX59g7tZ3fFIwA38KaRVEm4r7LA8vAw9u75qedGQ5Wpm35msmUPoR7whfKe24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8c5G8twp2ofT4BbOHn6P7B7VHhsI73RL3YpWZyje7hA&oe=6A9C3C8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
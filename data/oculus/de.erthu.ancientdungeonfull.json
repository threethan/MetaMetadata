A3F9E5"}, {"file_name": "crossbow attack_improved.png", "id": "1514018119718811", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821682_1514018123052144_7580125456268556595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GseJxIpl-cQ7kNvwFYe01K&_nc_oc=AdoD4Xc5W_AJEp1V-oQHhS_nlwHLdzKPhWPHvKWtObYVTMtmhOZfeLscD6-kbYmYrlE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1jffMbvtqAqXXr9SiwTlmJbQGxrUkqbORbWsSCc5DCg&oe=6AA40037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1690547158620143", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491822550_1690547161953476_1269416168274696252_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ1fl37HnLMQ7kNvwHAKZc_&_nc_oc=Adp3yPuj4tYXrAiye_F4_xPs0q-f_Vv8W1aheRxW0uYRLC7UKk6bTYtDXSMIjhQMHKA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ21blj2NLAmd51LIla3HCYahVLJhJXCH6qEKJKGpkww&oe=6AA403F0"}, "display_name": "Ancient Dungeon", "keywords": ["roguelike", "fighting", "exploration", "fantasy", "adventure"], "long_description": "Find out why Ancient Dungeon is one of the best VR Dungeon Crawlers with over 40+ hours of fun. Constantly being updated with an active community, jump in solo or with up to:\n# 4 Player Coop for Maximum Shenanigans\n{23911230785173807}\n\n# Over 200+ Unique Powerups so Each Run is Different\n{1457509199001733}\n\n# Next Level Mechanics to Really Test Your Skills\n{709248778317868}\n\n# Randomly Generated Dungeons and Monsters\n{1228225468188881}\n\n# Permanent Progression, Milestones, and Unlocks\n{677469415154842}\n\nJoin our thriving community on Discord and meet the team: https://discord.gg/advr", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler featuring physics-based combat, procedurally-generated layouts, and 20+ hours of content and 4 player coop multiplayer. Ancient dungeon is actively still being updated and one of the highest rated Dungeon Crawler on Quest."}]}, "
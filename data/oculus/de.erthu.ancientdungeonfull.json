.png", "id": "343130604184078", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oao63whHYkoQ7kNvwHUIjQk&_nc_oc=AdpvKlJErvIjjipxnFuA4AtaQKbdfekt3uvm5qfeygTqbRBSsFydsg6zmUgNsA2epqc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29KNLtTuUfwzbAc9sfVcy5RWw7oR563mZwlGSLEz_C6A&oe=69DA3C2D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD-iLMK6ITAQ7kNvwFqPwpz&_nc_oc=AdqC-GXIqU4_uIGfkOxnjgyBgTEZ9ncQwTRRHNyY3olFe332CHAG9qg5dAP0b7LRlXQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12dpCZhbK9bb8rigMkitYPIjzeIpWk-TNqApIik_y3ww&oe=69DA2DDA"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQndaIjDFmMQ7kNvwE0qhWk&_nc_oc=Adq8iwBxVpxerouPfyn-VQpscNKOxeWsCjeDWJ7_Dwzv1NTZVh6FOlX8ogn38Jpq8L4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u2Tc37epSXbc4wInfw1mmqldbNvneMBc03e6en_1j2A&oe=69DA2DFA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJ3O4hXQW2oQ7kNvwFlJfP7&_nc_oc=AdqkRSJLSOPSCeNzXv0iQ5yNKplLk9zLwNdYm_4n4B27kaq-vvhMhUXVtBz13-pW_tE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hY6fwM-VYNgTXkxnPODxQKIcgmH3fhsJsc3XhEQpC-w&oe=69DA510C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkKpfz0KovQQ7kNvwGkPYe5&_nc_oc=AdqAtUeWZmctqBVdBsC8frxCTgZ6Lrr4u4CCs-6N20uUAdCho7gtuX1xQpUz5NqwByI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Hni8MZizBfffReUMAkyjhTXhEasRjDD5BNEhGCB1-LA&oe=69DA37CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_
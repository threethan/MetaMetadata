": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHn8ztedMoMQ7kNvwFMk3qG&_nc_oc=AdraCBVNtgwSavaKi8IS4LxwwyCCAMYbAIql6ZZK2YwcOk7pwPpmeIUEKwE4psT2Pzc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93mfL4nkiBM7oLsyXJBFEEVeeWTZRVSted-7PL2w50pQ&oe=6A24486D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5s8oy2IfTYsQ7kNvwGkKjbW&_nc_oc=Adr2GpvaJhpwCBlRBNQJWLunVe-afL_dRnQEuzHb6FuoEvz_JNi5-l0U09uj33a_3Hw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TUV1ArzGIYv4aqQ3aVPyCXtkisMlG3HFh9PA00ik7-w&oe=6A243A1A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GLaJxhRsi4Q7kNvwFqtcQ9&_nc_oc=AdpB3w-mF72Qb7-nvS6pYsC7Zc-HZksiSrnAny0cVOdY51lXtwe0tUVo-XvJYBLh5rE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90JZroJ-IwK3W04h72J0hiEKSWT6Wp9Xo94TSzW49Anw&oe=6A243A3A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WR-uV8nHRgQ7kNvwFFNGku&_nc_oc=AdpDJoz_84yE26DQz7Gj462k8S3Ke0eWMSRZFDiixFti2w1ZYqLMk3pExEMyfAiyUGU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j645z7NRPIfOxGnEiowvovjJx7gqQb-hZvPUrBanGFA&oe=6A24250C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmG4UBD-yiMQ7kNvwFNHb8h&_nc_oc=AdpLCeBYt_Q8C_YwaPMDLBr1dknJFHpSCSPeS_pjoAH14cMMipkDNuaSN0IXd_NN7Cs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U532pAvL_sH9WPsWcC99gANtqTKJ8JVc6SF43Dgbxgg&oe=6A24440B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
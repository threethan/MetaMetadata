.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mPxZvZl7ecQ7kNvwESD6fA&_nc_oc=Adk7oq9iittr8bfuQDqKTV7dLAxLHDiO93NcIPlKZRFzF-X1ATr9AeKjqnIlXXBN3wg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQUL9E3c2_K7VcuwjMEDJfBvZoIw-yXBn0Pwo9r9Lrfw&oe=69B2AF2D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tXmB-vWApsQ7kNvwEAx7rs&_nc_oc=AdlaGmtrfmxVmkbA_cc8rtMzVIA5Uj2voD8IA9pg6zcNgjwPaTUOPOb-f-sDMb90WAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfywXyPcW2FdUupaOAEaWtWm7WxIet6Vjrj-XI2Na3R7yA&oe=69B2A0DA"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RB7Mib-QhREQ7kNvwHD1swk&_nc_oc=AdmRdDXPxSB3FIEuX1WKuUiVg76CsaKLrcDgp6j1g3jUfMsfx0YZoHXbIJx52XJObn4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZvaMYMsqTK84iCVClyogpa1pFRMgwUY_UmSPnpX7bQw&oe=69B2A0FA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rt2IEusFwO4Q7kNvwEoPPM1&_nc_oc=AdnbCagFFR3vqrLGLx-sGHatVJoH4VNUaaEaF1l_hMdS9ImvTjwmr5YWxWGk_Iwh_cc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBKSlNK5GPbAfti6bvk8-iF6GwCtm0Uf7kseQhr7d8uA&oe=69B2C40C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9erBH7_KrzkQ7kNvwE6yqNS&_nc_oc=AdnSlMQaGBV2q1uEkge5v60oGUAwaqk8udGBuNVqfYDzyndbUDipJsNNVde0s9xImk4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzHBf68cvy32jxoo_KP30_Mzcs8vBP_6p38dRwCnsp5ZQ&oe=69B2AACB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
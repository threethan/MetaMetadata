": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PD75_zUeyFAQ7kNvwGA4rDx&_nc_oc=AdqXgNeWP96r0DHry8K01ZzHysOtHWX4Z1m_X9quJnlrgMVa-XD43umw90lNp0HH-VU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RcVmpj63elRcNGTn649_33gWf7MhTTvqH2ec9s_yzfw&oe=6A29562D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFhYxj77cL0Q7kNvwFjPPjV&_nc_oc=AdoFi0kNAf7QdYIFc6OV20-kwzScoQw2lWcLwuFCau8V1WPV76ImWR6QtDPUUsk9Ygk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bWjzdzkAumklPJAcrLTuhe7mZsN6eQuWdIF-p0e-WLQ&oe=6A29801A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LrbCNXgmc8Q7kNvwEHrD8y&_nc_oc=AdrI84IGp_1uD1jCCLM9f2RL9VM5uxLM2ffaeg6JRtVRCd36dDKlPRV7LuQJafwjriQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xiUel45LS-P8PJ351TXLG-czUCTU1EsbnsgEKdpL2jQ&oe=6A29803A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vK-c4BNKHw0Q7kNvwHRLfZk&_nc_oc=Adp1JfpaetmeEIRPYZD3ZDm5um4A1LhqbLTqV73mGtl7_JmMZ1DnHUw2arDjfkrV5kU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_K49yeayLY4yeKNzDxs5B1uT_zjBJu3qmTBmQtNwcSw&oe=6A296B0C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uflvrCmlwoQ7kNvwGUe5aX&_nc_oc=AdoJESiWj5NRNd_p8-EJ71WYQzXi_FtV4wxIsVCXEe9kSdaTl3hWGeCFtaPGZxZhKjg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WMxrhhCNeMRJitPUxt_Vij0WDElriVnW2LH1axoMeJQ&oe=6A298A0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
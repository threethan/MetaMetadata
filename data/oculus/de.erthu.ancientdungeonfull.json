.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ti0XGYb6KCwQ7kNvwEKg58i&_nc_oc=AdmrNen5XcP-Tm8ULTKHriL_PjXO_lzEg9JvqALxjBb-xOtcTWm9ZFiS6O04Zawwu30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVVX2kCCqEzc2-XuYhY9JPAmI_vfZDC8g9p2swY2LZOA&oe=69BBE9AD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFkt5Vh4JUsQ7kNvwF6uCy9&_nc_oc=AdkEY9x4SaW5GprTlIn5OdPlpCojlbmG8Hg8zHdk5DKVHUTb21jNOzvoGS7dspnjv3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAjBV5mq-I_VCwkTKWxdOs79EMVMFeZIVUKoGdI3lPng&oe=69BBDB5A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9QnVGxoScMQ7kNvwGS02qN&_nc_oc=AdkRO_hHit7WpgjfrObSYB_4LTTG-QHXepaG8Y5wIRLVDi-cUkdezlbtfIBvuxfr0S4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4fs0xWOd5W0-uCPIq2g8u7X8ec_V6gwGst-56475RFQ&oe=69BBDB7A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nnGqAYCVSkQ7kNvwFnqNTZ&_nc_oc=AdmpuVrC0OUXcYk0WvE6T1Ze31S0jMRbFj-AtIzh_XCi1kRbwBR1ZRs-xKDEZ9W_A-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxtkEK0P9yCLPs2Y2foMVFlbxHuLDJBWb4LFM0-ktGBOQ&oe=69BBFE8C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_T2yHHU2MsQ7kNvwE9zuHv&_nc_oc=AdkN-F5_DXEH8XmPWxkWdEXOkVNGhQj4Ih2qLH4uYmxfzUiFlPe95X76FZmAT6aCTZg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxlSgWM2NsH4aHEJLSNSOS6IBrjFNiFI90i9Y8zyo3q4g&oe=69BBE54B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nkh1qbODeoQ7kNvwFZwMdx&_nc_oc=AdrcXvZpFOIjHRkATg_zkFQVlYK-eJ5AM5_x_Mtoh1zBOKdJRFr-RHAqfbixtkOowP0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND-ZIwNfRimS5aMrZZAclGQz_hbwiZqPxMgW78rIOddQ&oe=6AE1E82D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bi9g4o5QznUQ7kNvwEYzgig&_nc_oc=AdqNlqb3MvWhlnb8Sp_9xo-0ccDRDUfjL3N8LdbiD2h07eWIHp9YiKcrO4QFjyRmLqA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj1N5ga1hoX_RRnGAHwE9j4oyhdaJs0VuM57hdLovIzQ&oe=6AE2121A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-G5hsP3AaYQ7kNvwHybkc9&_nc_oc=Adqhm0XGXPH09GBff40kJrwqTxCTHuVxm2Bnc5HW2kOiyr9wrx5NbVZzCZLsYEvSF8k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeG4jV0L_5AUbzmleelT8dz0tyo6FZHrt1QCBimEqyNw&oe=6AE2123A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7w9rPjafwkQ7kNvwEX4AYE&_nc_oc=Adq9lyrk2OZg6qB2oa62o0M7BEBj7aYY8vd7018czhHavzv0CIxyCjaP9Ndm4E6nbhw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgAxDrf8umkYXKEtip_VifJmsqG9rfRoMgN4Kz9axV5Q&oe=6AE1FD0C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpuqReUl1xQQ7kNvwEWPYE9&_nc_oc=Adq1xnmiPK29MulsLCaHzS9Ur54wxJ7oBYS2UZMfUnv5qvxAnNSOKefOQ5tnvNbWfoc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgOoDz0ZsYmBB51LaKdvxKkNaCCWvyZlNtZH_HlHGIeQ&oe=6AE21C0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mPxZvZl7ecQ7kNvwGL6KLT&_nc_oc=AdnPQEkumzQwHXrUEMlQPWHProzUhjGuxVF90nvTAJbK7OFYBvFHh3OAujCt6QZeB0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvBLNFVWzbDaot_V7xEpHKw2BIFsNyk64eYpwRvC6ulQ&oe=69B5522D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiN_DlbdLRQQ7kNvwFDNJSD&_nc_oc=AdnxDnHX04Rp2CqVGBh6IT8Nyv8rOB5JbS5Y0Q2dDXdlcXwBEwXg5Lj8gXeQD3O7b0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGELxwmdxY9k6IQ2EOenNFbpdFdTsUuHPrK9fdR0Noqw&oe=69B543DA"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqOsEnxPvDgQ7kNvwE_3eOg&_nc_oc=AdlkdsG5l5ciGo_d_07fFJgltQt8pir2ZFvrTPK48Pc_Aqx7B6UjLTT3q3kVwP42NVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy36dW3GbCMRknKLNzblrVfvMVye3twysmTrO6g746Ekg&oe=69B543FA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rt2IEusFwO4Q7kNvwGyNRSU&_nc_oc=AdmDKdLlDDVX-M8YWMEdPTd7ykuVUrghnxyDsWg0k7s_v9rumVdkJhwIWSBvBETteyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwq9Vbk3Q8u2t2If58m3dHTPNqelrhAibb3gdxdkfpSiA&oe=69B5670C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=821lMOFfIxMQ7kNvwE9gPFD&_nc_oc=AdlzcITzsO9caNr048dicnqCJje0qf1clZU7ZiBmQoeMzwciu1_cXwKs2oqPVhaZFEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8ubI0Oaf49gprTUF_Aj50fgzhLcQNqu7VnILQ4N5ZKA&oe=69B54DCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
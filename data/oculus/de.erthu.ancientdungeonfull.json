": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HF9MiGISVmUQ7kNvwF0M2Mg&_nc_oc=Adrq33dPZtIlTEbMY-u4TN60-iLYDnP5VFDL2y-la87ZG2FdQRce3DKObzBkgV5InTs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPKm3q9hQSj0luJs54bNm5TTFrxPna_MInAejibKLdPw&oe=6AF343ED"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jop3geNQdsQ7kNvwGk6EJX&_nc_oc=AdrshmcuvuupgkwlnkNrUocGkOe2CuTG1enGtuIvLEoa1ayU6f115-9wGgGi45YfSi0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS7qBivExr-iUW1zZqcmBIvJYcFpQATEG9BV4RNmMFtg&oe=6AF3359A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vur360FT60gQ7kNvwFV22_-&_nc_oc=AdrU0ty4G-1VkH9eub15fJndcbwS5gUlaDkGaaZ5RSnmRZ7K-WzRgKIc5dOGNwQg5dI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKyHzo5TE9LKgrSd1T2YFJwkAG8LMyYLvrThwrJSyoig&oe=6AF335BA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foxTmjZAGuUQ7kNvwFrxawV&_nc_oc=AdpMevbySj3dRWNxrfM0dDfI2FBnVpKZyTW04ae6i_2w9WxlK31qa7zmDlSkNXhGAz4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjeJjtW744MfH2XRggysN5TTLeTBmLcCk_hneNFTt7xQ&oe=6AF358CC"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9viyjkjFZgwQ7kNvwG47YA2&_nc_oc=AdqDq7kXNgkhmvMPXHuCwo1djR9LbcyPmXEuJCD6VVRoGvE8uBpKcp_bw5j1GlALNaQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT3T3ykNcxYgaYlhYmaKHFMGdYcgLd4o00Wm08VavUcA&oe=6AF33F8B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ0kU6AkbVMQ7kNvwGC5jy5&_nc_oc=Adr64TrwM0h5OouPjuvBJObnRlesh-mcblfQZbIbwwaA7GW94j_HVuPp16VUl64hFKs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXlPtGHs3R3SFQ5Z7zQGHrjeXbeEgHKxFmlGk4ESTPiw&oe=6A5A1DAD"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PnfejCM6hwQ7kNvwGISvNM&_nc_oc=AdoI_AYObdKkAIXrsvJQrRZ4JuVj-H6kS3JrGiCoVAz5KXzwnGCXuKbJwrHys7w6Pvo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJ8RwPILyy_gkhBvJtlxTiosPVh22zuHByLAStCjK1GQ&oe=6A5A479A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5dMhDTtd-oQ7kNvwE3ozFx&_nc_oc=Adq3scCfgrwGCmqG5qHZIjX0sBLJbvMrBZZDqqk2Bu8C9ptscxV1FCkXOK90BpvC2FM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1ylSPyg-3jej4Nyo8cRZcYNhEi6sYTmPHCOBLGVQoBQ&oe=6A5A47BA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rJ7SVGlUgcQ7kNvwGTw7pH&_nc_oc=Adpilb4431wCvrnUgLiMBCH-8-ugNHlDgwiWVCO6S54xhkI5Vk1nGUMVXHCPIh3n7CY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXdQkuoUW7tuDqpRQp8P3GoW3xfNa2SKz-g0aUoshz3w&oe=6A5A328C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fdWfRN_TFAQ7kNvwGVMqkM&_nc_oc=AdqeBu-IHlldKt2sQoC9uUisFIlZbiqnCHr7HKmNJLZTM7NowLf3EK2TjP1s40sTCE0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzHEcmRvmfudeeqxPjEh3jkjyiekhi6AhycOGSryaamw&oe=6A5A194B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
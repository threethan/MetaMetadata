25/491820887_1169358421713714_1017788617217784882_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHQ5DoHus2MQ7kNvwGctA5h&_nc_oc=AdnvGdyC3FUCYiA-gXpLaMejFNkyFoSPbTUmrf5UIkBK-I_K4BahCFF9Jgz7245pp48&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfszGCmxhKabsw8gVqCApNOBKdRQpHQ9PG-VRnJGOs1iyA&oe=699D8643"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Current Trailer Store Asset.png", "id": "1187268376650785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_1187268379984118_793157563654664844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzPGFZEAO6cQ7kNvwFc6Ar_&_nc_oc=AdluDa864aoislusvwdz2Rs0b7sB_4kJCacunBDg4eW6TyMcRsRrE5uw_x9RX3iDeQY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvr2TLIqUcbLAh2NO9VyYgWLMDnFEapb_4sygnLVsQ9Jg&oe=699D9436"}, "display_name": "Ancient Dungeon", "keywords": ["roguelike", "fighting", "exploration", "fantasy", "adventure"], "long_description": "Find out why Ancient Dungeon is one of the best VR Dungeon Crawlers with over 40+ hours of fun. Constantly being updated with an active community, jump in solo or with up to:\n# 4 Player Coop for Maximum Shenanigans\n{23911230785173807}\n\n# Over 200+ Unique Powerups so Each Run is Different\n{1457509199001733}\n\n# Next Level Mechanics to Really Test Your Skills\n{709248778317868}\n\n# Randomly Generated Dungeons and Monsters\n{1228225468188881}\n\n# Permanent Progression, Milestones, and Unlocks\n{677469415154842}\n\nJoin our thriving community on Discord and meet the team: https://discord.gg/advr", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler featuring physics-based combat, procedurally-generated layouts, and 20+ hours of content and 4 player coop multiplayer. Ancient dungeon is actively still being updated and one of the highest rated Dungeon Crawler on Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://erthu.github.io/pp_advr", "developer_terms_of_service_url": null, "publisher_name": "ErT
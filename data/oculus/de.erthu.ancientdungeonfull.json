.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe-crFjfx9IQ7kNvwFO4rBM&_nc_oc=AdkH-oU8a6GMtXqz-2-23r1nAupj4Ua2ErGe0BPDfn6ifpz2Ri4P5gNLV3xQM4RFbMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXlXAZ5ypTORQ_gitU-EweB9WIg2nMQvDdq8eJJTCSrw&oe=69B7F52D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCuwk05AfL8Q7kNvwHlWscr&_nc_oc=Adnsgdbggr-FWpn2HBQodXPSkV6XbB87jjDQyk1_EjtVVvlGb0AEqKu8AF_OAUN3Rs0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGrzmQGsnddlGwKeqVHy5CwGwNK9H1bre5gUgLyz55DQ&oe=69B7E6DA"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqOsEnxPvDgQ7kNvwHTzWQL&_nc_oc=AdmDDBv1UNZIG44Y7aff40_1j_9cFrwgeW87P-7fK6zd5tX-Mwuk3oCqossQmev5fd4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoBUPlv13Dm1XdvwMwC_Jbq_P7f0ao6h1AI2u8A4J4pg&oe=69B7E6FA"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtuMVZlZ7nEQ7kNvwFQAYVG&_nc_oc=Adm-YlQJH975V0uD2NbmGH_jR6DFyfGGqAww3EvOXdTEdBia3Mn6rpTHEqeHnfYcIUk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwKe_X5AzWw0f0TzIM_3MztHx5_O9-yrxgz0zfvGkMd3A&oe=69B80A0C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw85_aDDRn0Q7kNvwFd7eka&_nc_oc=Adm3-0FXGR1CmdPd7_yTeGr6RDFSB4nhEJuMCOWlc7ZnxrKGxv16FpW8ILXvVYVRJBw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxmwXRN2AjXao7vg_5i70dzqrnqnp3jXt7rN1kxGgsUKA&oe=69B7F0CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
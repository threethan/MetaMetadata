": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035318_343130607517411_8133227846411285295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkV7pR1qN64Q7kNvwGEwSHJ&_nc_oc=AdrD8VmMlZcSvv2e0UAGj2qDVQ2-boiSrReNFXCHm518fV4RSACRUFg4Cw_Bo3ld4Ac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_50ZMlqSRjIYl20kvV0ji9oCchChcTKweNHlCNpQsOmQ&oe=6A31776D"}, {"file_name": "flyingskull.png", "id": "660527268238255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569427_660527271571588_2212709501780119599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KQF3u1lzB8Q7kNvwGAsQj-&_nc_oc=AdrctR4HQESiNBAl9bssmPXNgX4L14WNAtmAtlvcRqBXuSLV1ur75-laQyKEG5ERd6A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zU2xdVafrlWgUAuGaGFVRJ0wD5bk5Sy3IxE6i6DK6nA&oe=6A31691A"}, {"file_name": "homebase.png", "id": "530408614736998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982488_530408618070331_5186067733722600790_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zovCOWuNFb8Q7kNvwEfcx45&_nc_oc=AdrU18O1mWElpTg12FdkSPPtcTjwFJEE-bAkqzZovBKm64MO-9C2WmzqAtj1_0TfSQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87J8fc30r_yJc-A8ey2seAbJMAqIpfCd_13w39eAUopw&oe=6A31693A"}, {"file_name": "itemcompendium.png", "id": "877360716203046", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_877360719536379_3125952312679375110_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_jqfec14zQQ7kNvwHkSXbH&_nc_oc=Adpzjcvnz5C-AXIsyuFRceyfZGNO-VMeqnD-lDk5VwM9mR95HWPxLUFM1Hm0v451gYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8frdIl_seQcRgBeBU41BHba6wds-U9rUd8xKFih4QVCA&oe=6A31540C"}, {"file_name": "bookattack.png", "id": "920511078499536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974824_920511081832869_8665382250875580201_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWQLgLdlfGgQ7kNvwFh5iF3&_nc_oc=AdriTwz3cuT24qghJBBJGrm87SYsLyHolUwcpHF80gPrzH8PPfck6H44IMslik3m1e0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SDMo943G4khProXuDLnaz8t7W5Ea7EbaTmJSJfA9s_Q&oe=6A31730B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "https://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proce
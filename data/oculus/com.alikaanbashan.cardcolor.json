_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6e3LWPZFbsQ7kNvwELr77h&_nc_oc=AdkpvPOnqowiuGk9gvyooLT3XqkokNeCDWZEDz63I070GYhu0Gg4rwFxqr9YeUVqdw8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1YtsWDkaUSZ4PCIiqcqXfI_S7p0Kb016tRBSCw_7iQw&oe=69BD5FE2"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lstM-Uf8AgAQ7kNvwE3LQGj&_nc_oc=AdnK8iO3VE9d_3OKdYLl48Z663zdSCgcLHhTvd3E674YxiInbaDEa8NXmYh8QEqtDDw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZowDFz-gLloqT9Uif0fFMZboYIqNemaJH8P_ABBRZ2Q&oe=69BD3735"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ypb-ZHR5BAQ7kNvwEfDXiG&_nc_oc=AdmG46E7SowZNZFfyMqOjriu0jluvf3MxvkPu9kOrQ0hocD2bW3H0MEMXEwwXcqzYZ4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUgJ0iVFehkAOMOh7o8d9kOVnKgIUXUFQM7DRm7me1wQ&oe=69BD47AD"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqQ6iqmUz84Q7kNvwETa64u&_nc_oc=AdnFfD8Ws8-LiX3S0hZF5qMHPPkn9Q-QFqI_xd02IB6Evf-46TJ3LGVH6SNm2Es8c_s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAbvGQ9FZ-KbAylAs2QcbTLUZLRQQseCxvpAes6yFdsw&oe=69BD572B"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPvHzBqKT8oQ7kNvwEdJmmW&_nc_oc=AdlBKJ-yAQCOylQXBEKEA2wH71nwDA5RTZjfB4e9ivl_NpoFZsNAlIJMqgNHbqRANFE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2qrZtO2hEbRA-pxS7UxN4sDcnVkY4k48gCzCh5t_Rxw&oe=69BD43CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRwDoiZ9MfYQ7kNvwHUEEgH&_nc_oc=Adl-DN3JUyZNVLnRx1cQhRPlp1t6rJxkNVUZmBe3P-GAvX6K2Aix3jhdGVCXWiVchuU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwzd7s6_jIImIQAec2DbCzUh-x7Kj0WICeSEhB1QkUmjg&oe=69BD3063"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_ser
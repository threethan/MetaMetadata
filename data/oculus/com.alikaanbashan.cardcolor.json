, "screenshots": [{"file_name": "2.png", "id": "723476487476124", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307435_723476490809457_5094365609907948591_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMA6wfNQyt0Q7kNvwGkBnab&_nc_oc=AdqeSzdoZ1eXtQDGelRdPUkKi90KzeCL_LeVtqbgdi495tPOCzcVmjMPoYOO4yJY0R0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjhmHxzqVVW-jk00gh1E6iizyJ1aQWi2iA1_mpGErG8A&oe=6AE9F5E2"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HCmIMc_PXsQ7kNvwFwlB_7&_nc_oc=AdruGvKGitMeJUUdhlju7Mr945m3tLg18D-VgV58iUMF9er56ookRi3_wRGmmjmy5jY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTETtqTkYBbYhyMEVDYptuvXxqrFfQREXX2kKWggbmphw&oe=6AEA0575"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKozm0-pof0Q7kNvwEBBDHt&_nc_oc=Adq-BmTa26mjGVseUXfx7Pe5HtdcqwRnEuBtvywD8e-LNNoGb9HYbvI3Rwz5zYztd6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe2dif5ngBvobk0v9cg8HJrcZDCZn1JCfTcqHObvJ3vw&oe=6AE9DDAD"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0ZpsOqsNIcQ7kNvwFIcasi&_nc_oc=AdobSi6exuY3hWVi51zXnK7xaAuZh_RQQiPDsoqNUa_CFnQ13owoAv-0PA7TpRVAkBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG_3flPUl0OTdszYeaL2t2jVzmh9YvXtgm7-KxqZo7_g&oe=6AE9ED2B"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FupFNU1o40Q7kNvwEHqnrQ&_nc_oc=AdrH_J57xjn0vDHhTsOea3DnYRvwl8RieVPEIShtJnCOrzBEgmdLc4XTpFyeQAXduLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUDPZvK2o39KqM3ryfhSfxDteTJ7kaNyLB_7KRs0la1g&oe=6AEA120B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HpTMuYeV8EQ7kNvwERasJz&_nc_oc=AdqoDYFIoL_p4HyuIvB3gux08m9bQNIzW5VrnsJqRaDWTIf68ZsvAbwBaQbtSj6_7Jc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyLjUinjCrRhSknCdN6X3618YAbG-m6kp1BVBCFG_UVA&oe=6AE9FEA3"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25835373279413387"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "2659282331191787"}, {"status": "PUBLISHED", "id": "1433718131533753"}, {"status": "PUBLISHED", "id": "1385985880337209"}, {"status": "PUBLISHED", "id": "1593918679031562"}, {"status": "PUBLISHED", "id": "1357003252980881"}, {"status": "PUBLISHED", "id": "911141918425203"}, {"status": "PUBLISHED", "id": "1291064562904932"}, {"status": "PUBLISHED", "id": "4459709487689473"}, {"status": "PUBLISHED", "id": "4253248098296213"}]}, "baseline_offer": {"id": "1433718131533753"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795118400, "status": "PUBLISHED", "id": "2659282331191787"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25979348031682577", "version": "0.3"}, "id": "1234040351964686", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pr
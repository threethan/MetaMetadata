_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3FnLeRFP5EQ7kNvwFlhvox&_nc_oc=AdmCsWbHyOE76ykW2OPiymczzYksP71aBTGVtxoHIcXdiZzb4k6r46wLgi-b9SIXYoI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwchIkli7Xt4X3C88khShv697feReO_FdXv66RNjJWkyA&oe=69B29BA2"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DiB-DrOWY4Q7kNvwEfNGKh&_nc_oc=Adlj6U8SF-nzONU8ieILYlyk1n_tuCj8SFKl3ujuRzS0TmKqyYsA3cmHlMk2v96WOVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsnhN71Gp1NuP4Ha6D8ahbnSm4G0wtQwObzOEYqcHuGQ&oe=69B2AB35"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLKgmkHBAFQQ7kNvwFQJXzh&_nc_oc=AdnAWdsseiZefVl6grKhndkvS9lhKpovcgsfbnFFXENFWOk5Qu7YC1fCGBBcjE5DIQc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPn4ci8SrJ8KA5k--LKvJ1QMWTiGKVwEPUZxJMz2WFDA&oe=69B2BBAD"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDfqNfU1lmIQ7kNvwE_pj6l&_nc_oc=AdkzNCe0qaACAkLTfclBa_N0VDm7PGjRhRr0Xtsm_2gsz52Pr8hv1LWvDh3maP5EknA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfypGVDFb0S3yo8zYA496IfGWHXui3Gm_tspi9l4ptNItw&oe=69B2CB2B"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wp1vsgE1aHQQ7kNvwEbmZnr&_nc_oc=Adk0PlGtZWQaIG0_CuOIjAf8M4qyw4mxvQcMW9kwJWyrCzy7FgVRjF7eWzMWjdOfMtI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxw0tg8KmbYKkOykAdU2Fr67fAX4azlAVMX2JOLtq61tQ&oe=69B2B7CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KAno6tLPcYQ7kNvwF8oiPf&_nc_oc=Adk120G0cRUt_kfzK5eq0TP4rExA7GskynExm4kzMfsvJFOucQscbCb0Y0LB8cj9pjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwxgV0Wl3VWuYbWhQtpiWKzZOH3jTXcu-TCehLzU5jskQ&oe=69B2A463"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_ser
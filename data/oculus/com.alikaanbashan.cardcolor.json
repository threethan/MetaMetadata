_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3FnLeRFP5EQ7kNvwHAsnFR&_nc_oc=AdlwT97GKLR4CiUlkZWQWIuqfGpOTjS5KgJIBaVTts1bNqc8vkMBM1HGBXfHRu_H0LY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-gIKNl5vaHZ4H_AbS5TBo6uJdnb3_AA0Y74U5Ry3zyg&oe=69B14A22"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DiB-DrOWY4Q7kNvwGBoGCz&_nc_oc=AdnbKAEJJDwW_KDXizmrxAlk7dCCWd_Lc-N0-wz6HjrCfmPOEOA1lcAWo8Lj0CYFk6w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOqaGQL_QfixRKAPQ9qKxZ4hMz3UQe0iSDzGLK1O_PZQ&oe=69B159B5"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfcwzpYQbWQQ7kNvwEkq0py&_nc_oc=Adn_WjnvrrAnlTsuTiQVuM2YKNsGqX9hXP28SZ7BL0k7sUtx98jMsYBL38zzEe58yKw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfztddUw9pvxOwVYxvycFGjswSRiiDisKSOkn8JzpQAW0Q&oe=69B16A2D"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDfqNfU1lmIQ7kNvwHwohOo&_nc_oc=AdlQMj0w2ZLVdvpOFxLS3RHvG7Ysord5InGuNCr-8dxsiKdjwv_uVHXD0AbTEmGljZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzcd3s1w0fL8LfY0dfd9Xa5OQdwMMPEdbzxqPDN2fQqNQ&oe=69B179AB"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wp1vsgE1aHQQ7kNvwGkQiK5&_nc_oc=AdkC4g4bWVRoPbnSx-eHKWNsH9MSItari43kvl7i_RHvfgE8YdOR9thuixvm258XBB0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoDbmYGVxBJ6cQxiCyUmmXBoSosxEeY5ZYuWBsoM5FGw&oe=69B1664B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KAno6tLPcYQ7kNvwEnHRUG&_nc_oc=AdkueoJxUYonaHHKqu6F63EcwG-SVD2vkJXIfej6FGkwk1FRrkes3DmE6--3SzeOmHg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfYOcwVZFhTZbQmD0SoHx_lsTiFJQPTTDQAjAzZGwVlA&oe=69B152E3"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_ser
_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK3alB5fZ58Q7kNvwFIx5Jl&_nc_oc=AdnKXw0pSLciKRtRPPLoKniYqn-DsUJ_EzpHgXSQZkR5N5MbZWAKnElptNzbRR-hW9k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxXF5stT3lv1TTnWDxcVLy9VHWA1ckVc2yHXq1Y6FVUXA&oe=69AC0422"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNmgl3jWzeIQ7kNvwEAaFwm&_nc_oc=Adle5EaUWFVfiUkExBB7FlkyNSIuT9RpvGMgUclHPlGS_yNUbX9ZMjjWmZ0doqsm-4U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8YSVHkKaIsLWdim7dmjYhCQFwJAY868KnA77u8-Tdqw&oe=69AC13B5"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Rf1xOTI0jkQ7kNvwEJsFy0&_nc_oc=AdkMkD-1E2u2-wrgjvw36VS2hNSgiy7SeS3Kzp_IMr-vXlA4D4ZycqOqqQF0dL4WX8w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyv6wEuxx8z4qeabJFrNBBxRpVdGSQ855awoNw5dAG9uw&oe=69AC242D"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pjek_DILXP0Q7kNvwEhWXA5&_nc_oc=AdnWM3SlkYxTq1VaD2bk776lhCwYQjfYwCswcCQnzsY5hMFYYuSUVgDYmz6Vo5p2vSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPDq1-2VHByCy1O2Ub7nC_YN2JgGsXKxWTgQXfzk1TCg&oe=69AC33AB"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqbI9Pimd5YQ7kNvwGGup_x&_nc_oc=AdnAZeH71zIaT0YxJvNYiQKA11nT7MmnpVzYgD9PUMd0_mh6PbxcwkNdn-jrnBoPjTo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxWLw6byuVJZ-O_dbEDllj6glPfFMk71i2F-fZ-Pue25g&oe=69AC204B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRQALxi6rM0Q7kNvwHr7mTe&_nc_oc=Adkx4EQCScpW3SiIujZB9gNp8f5xQqZ2zraMKyM-cIb0JTQyTdns9hwWXM7Vd5XaEHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRwVL4CkbRTRFU7eTlQWE1ZPTmELnKjuIoWk3P_2aF6g&oe=69AC0CE3"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_ser
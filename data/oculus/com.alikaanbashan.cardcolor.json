_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK3alB5fZ58Q7kNvwEooEmU&_nc_oc=AdniY8WsjgAzAWZIAVlyV9gUqjZWUdyq5befqjfQ-a6svDTEB-auBdjdpSSu_ZZNN20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzl8q2Z4ctRLRyTa9SyUrYMd1GrkpbyFthJgdnJ1sY7Lg&oe=69AD55A2"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNmgl3jWzeIQ7kNvwHB-0_B&_nc_oc=AdnlrwOjkN__TyuXXNyHkFhhHJKTUbn9XmgGcGpl6RqlFhbHxlXVEV5tgPu8Z4LUDgo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDgBJrYnmJxwOTzDV58Tf0lQ6lFhaw2x4XKgkmGeLsAw&oe=69AD6535"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Rf1xOTI0jkQ7kNvwF1E0TB&_nc_oc=AdmBZlj9KNkI4cGkIO9XNtwgBEdgo-RJBvQD1xGTsKZgIud7oJXadsyLK-G5foS6AlA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7xMNaBK7kAORrA-z7f_m6LXLJ5_rPRqw2J3prUVpGsQ&oe=69AD75AD"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1HDsI2uwT0Q7kNvwF1Csv1&_nc_oc=Adnz-W5PKCgzZ8kxNadiyYe5fakCGxFYkGeqo0A-MMsXLaO9wcWjsT3jM34cN05Lhlk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRm9JaEfTyiqWSKgL1TXIvOh7EBCwSO5_bDIG6IF-ykw&oe=69AD852B"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqbI9Pimd5YQ7kNvwENL6fw&_nc_oc=AdmjJFLS4ZoIAyzDbDkEctOOGoWjefOgOieELVvs_bp6ZMUCVUIvPZZTTQMXtPYPb5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx01dgw3tUPT7cuTWXMYY3cFcDPxbYs6GXc1qClFV2ZKg&oe=69AD71CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xboL2Fjj6p8Q7kNvwFEO0io&_nc_oc=AdlKka9W-6otTm856m0C21fRVmyY4uGKtnwQihvKe-F9Szf9CXGc8wKgjtI7HnBeFVY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaIwt4QHy4F9K926dw821n73d7nTHzL2SkZY3lUNqxcg&oe=69AD5E63"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_ser
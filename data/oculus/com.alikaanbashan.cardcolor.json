_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=387mD66uafUQ7kNvwGVczo_&_nc_oc=AdmcESoyAsSQ6xYjF65CEwYMp_MOkGWAjvN-Osb7-MsshsKEvGNXflZtMk1xbzfkJSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrgaFlEBIUpMGThqMvO6W7vIHBQV6NwBL3JAS_t0GAxA&oe=69BFCAA2"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gsMhubZO0wQ7kNvwHSw-TM&_nc_oc=Adkm6c3IaEs6or8F4gPWE9yI9CQMybxIrzcROnnfy1M3okb_sfEslxyAqcT_rbBJ9X4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZi4BbB5X0YkuuRfPPv_dKFgOdifLAzMSMXuWF-50hUg&oe=69BFDA35"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8l4qtIWRu1EQ7kNvwEH9PEC&_nc_oc=Adm02xly6ljutqD6jNpP7rCLconmiCgjVNMYQznYG98dvsgA3Iivq58aK2KR2MGO99U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtqYyUd5kMCPqjp3hYQpM5PljQcNnk6NdoaBr8ys1nwA&oe=69BFEAAD"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqQ6iqmUz84Q7kNvwG95Eco&_nc_oc=AdltGKOTm6h9HrngCvDZ2g_ystDP7TJvw892twqCfa_U3gDej8zD5TcCyUOb5ooEwv8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMNUbcBF_EBXoYz95-y6lgHy0k5yH55BMHFsRjt2sogg&oe=69BFFA2B"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZttBdBItxAQ7kNvwHlD9lh&_nc_oc=Adl5bg3JwgAciUWvH3C22qgSfzPjoibAuTInLJiATwKxutaiKj24c2jy6-jVhYKFE5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxEfREovkH80qGWvyEqeOuSqa_lkYf_Mhzqk65HL_uIA&oe=69BFE6CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRwDoiZ9MfYQ7kNvwE7lNH_&_nc_oc=Adn3_9aRGgbyKpr9z_6RPAPWOGlNFsBrSpMzFuj0_jIMl4sGZb81_ncBzrnuvUNgdh4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZQl92lGoOT7rUL2eZOvXXShMKoYFVwK4m0YzhvnoAHA&oe=69BFD363"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_ser
O4yZMMuILqg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46NF1UOP0OwLMRXytLT2iXTmGa32_ShoYE1q2s7KsYyA&oe=6A0732EA"}, {"file_name": "1.png", "id": "1188699053416544", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828104_1188699056749877_5865984231727230910_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TEQz7wRQKQQ7kNvwGU16-h&_nc_oc=AdpjqD_dEKJhWTNXbVsIsO2aXfXdWiohQjfMf4SrQja7zoG53NfGmCGfqS80DNMA0vs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OsIXg-z1JU0c5eyJIYo5eDKJnBtWP6RKy8vnF-Sv_RQ&oe=6A072E13"}, {"file_name": "2.png", "id": "2028350077708325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2028350081041658_2495581701112560758_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ebblWP-ZNIQ7kNvwFGQ2LI&_nc_oc=AdotYfljoGZ7-lByE8tmiUeYv8YePvCjeG2icMifG1wbPQWpQ7zc6YgrQygEMGZrIfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EauPOrRW4V5kCalYuaCqz0f7aTEZclzibVFCTB4vTPA&oe=6A070BE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=addLuhBm9MoQ7kNvwGBpRzo&_nc_oc=AdoEzhxw_fGx4O4RwNsK1Bqfnqw0tcCRBgRkGg3WLMC5JRKBEd-TBZHJt69H02dNonw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tATHVb2etn-FBj9IK-IAV_C-FJg-1dtQy16ZyCa7pJQ&oe=6A073CA3"}, "display_name": "Card Color VR: Match3 Time Attack", "keywords": ["VRMatch3Puzzle", "ColorMatchingGame", "TimeAttackVR", "BrainPuzzleVR", "ArcadePuzzleGame"], "long_description": "Card Color VR: Match3 Time Attack is a fast and satisfying VR puzzle game built for players who enjoy match-3 games, color puzzles, and time attack challenges.\n\nPlay on a grid of numbered cards where every tap changes a card\u2019s color. Use each move carefully, plan ahead, and create matches of 3 or more same-colored cards to clear space, score points, and build quick combo chains.\n\nThe game is easy to understand but gets more challenging as you improve. Each level tests your speed, focus, and puzzle strategy as you race against the clock. A simple idea turns into a fun brain-training challenge that rewards smart decisions and fast reactions.\n\nFeatures:\n- Fast-paced VR match-3 puzzle gameplay\n- Color-switching card mechanic\n- Time attack challenge across 10 levels\n- Easy to learn, hard to master\n- Score points with smart matches and combos\n- Great for quick play sessions and replayability\n\nIf you like VR puzzle games, match-3 mechanics, color matching, arcade-style challenges, and brain-training games, Card Color VR offers a simple but engaging experience you can jump into anytime.", "short_description": "Fast-paced VR match-3 color puzzle game. Tap numbered cards to shift colors, make matches, clear the board, and beat the clock. Easy to learn, challenging to master across 10 levels."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27081982661419103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
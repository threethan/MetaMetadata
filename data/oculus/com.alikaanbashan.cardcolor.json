91_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIPpspcsnokQ7kNvwGjJm04&_nc_oc=AdkTD-7HfPmyNrs1h8lESjBRqHp-7e3BgrTIZ8WmWQEhr6oNC4nXZS0N4S8OX1y9l3k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwELFAoVCjZJrfywqn_6sRoFWRWk_zXyBe8rpDu4f-ewg&oe=69AAB2A2"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Rp26nk367IQ7kNvwFqt0Y3&_nc_oc=AdnuyNR870aKGULsfBg0ZFF3WK6ZG6ENqUlt_32tirHWKIxojNLvSDTPVbrMGQpodoo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxN4nS2LMmyZ1On2qE5FfAYjSTGuiGyHZI9C-JYiam3cw&oe=69AAC235"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Rf1xOTI0jkQ7kNvwEiYgcP&_nc_oc=AdkOPjbeVD3VSbO9ZJg5PHia63TcK0-fcz4DKyGwlOh7hlGu55TGPnGnaChKwu07nrw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afy6_q09uLSCf6BfWCTYv9EZmrcDoXKrIeUg_1JrTivVIg&oe=69AAD2AD"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pjek_DILXP0Q7kNvwFzEinc&_nc_oc=AdnbjxdR869CD_HEQK1KfK5WUgOnhBe2F3NoHYjQOxlo_fK7PHNRUqQCkc2DEBSll-I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5jMc1bomWgwQHQCsfZYLAJy63wqwqsS_DKYPRz18OVQ&oe=69AAE22B"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6LTxGDdUKAQ7kNvwE2b7I7&_nc_oc=AdmD0TjPOZFBv5LTeu0Jxy_olNKxLTj1Q5W_58s9n1iuKz9Vlh7qPqihEjP6O6lVH7M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfytspImzZy6z3DeIkgEGnOCNtc3lRhwHfaYEJtNh-KJIA&oe=69AACECB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRQALxi6rM0Q7kNvwELmZQG&_nc_oc=AdlS2xakCGtiuhAjSAjNs13imsd2x-ACAfVUM2HD4nw-RzH_dBxnK3UoseUbnci564k&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfztP3s5VXY72xxQiXYg1FBhVNGNrdL340Tb-p4Tclakag&oe=69AABB63"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_
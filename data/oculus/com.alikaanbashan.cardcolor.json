c_sid=6e7a0a&_nc_ohc=egWJlNzqAWMQ7kNvwHHWnpo&_nc_oc=AdopXzgt499-GiOGg6nwOKi_VpKxtaAvdWY-BjkF2FOIkuRIr09Y0t8UhPT9tpQEgnM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-AEu25S1XsNcPMSZmKLW8TUZMmjC0KQp7YJo_4HRlxA&oe=6AFDB3AB"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVlZnzW2oAgQ7kNvwHDioUP&_nc_oc=Adoh3i_PMcKXlBiZnJrc6vI6ZifSNML61sJul8xNjU1-9nWyYOPVaoQ7dIh8XpGxwu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZheJ4XxBGAF3H8wU1LT9QxAPhGnKIiixTBi92RAMfBg&oe=6AFDD88B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtMYUJjnZ4UQ7kNvwG-335n&_nc_oc=AdrYn8xGAWSwVSHExc4VweB_afvg8d2KOVhPEYbx7SvQYx0-x4ZHiXtJByOVHOEonIg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqVti2L0gG5SK0NDr9mcF4BRCoNiVRIRKpCvwXCtt7Lg&oe=6AFDC523"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25835373279413387"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "2659282331191787"}, {"status": "PUBLISHED", "id": "1433718131533753"}, {"status": "PUBLISHED", "id": "1385985880337209"}, {"status": "PUBLISHED", "id": "1593918679031562"}, {"status": "PUBLISHED", "id": "1357003252980881"}, {"status": "PUBLISHED", "id": "911141918425203"}, {"status": "PUBLISHED", 
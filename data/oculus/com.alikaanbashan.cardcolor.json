9457_5094365609907948591_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzSFJymmB5oQ7kNvwFcJxyj&_nc_oc=AdoiaNSptBSSKGDA-o4rX3LbZlfBah3BCF_pvnVinFAt30Fbyr4NPO-5SkxzAKU8C1k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eTKxYPUd3J0AszBwtcl7jtFS22TqtDtf4Zz7Ut6fpTg&oe=69DCCBA2"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iF_zu5RyEkQ7kNvwHNWZG6&_nc_oc=AdoMYD8ZGmwxytuUIBm9AI9JwS5EvMDbEOY6R7l4_OB_qCOiqs6ppljJmsi-ofYhWVI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AOb-M8Qfcc7o6bnNgwBOOHupaaG8uHJQDAswAB_8hiQ&oe=69DCDB35"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pv_9AV2jthEQ7kNvwEhjkTE&_nc_oc=AdoTR7NF9ijwT7LCfsxZ5khZeJJt63fKFsobkX4xKpWLwhNxgObSgRBCzNVM3n_78dA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nyEGdr23HuHUTvmlTcYtPmeM-tin7x3qO_u-5tlxi2A&oe=69DCEBAD"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3q2nK5Jw7uoQ7kNvwEjxH89&_nc_oc=AdrMAriUD9k3QdCVAF_jh3ZJrHUyEy5-GU5lkjM-BCE8EAIqQQkgP5fUvDAo6os8xzw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dos_Hr0gj5tlCOzZfC5j63mFe-hOMvi11yEtK50wVTw&oe=69DCFB2B"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRfMyyF6LEwQ7kNvwHRubRK&_nc_oc=AdpfnRnNcGILw4NtxaBfrxgdqvoyN2w61DnXwWp3loRQ4FKo5Bxm064KsiEPjywlkXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mjIzGQoIBg0gpWONfNE49YFbP0ysd1G51lk5wfuGjHw&oe=69DCE7CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2_jgquZNs4Q7kNvwET5hH0&_nc_oc=Adp1C4HqE8vYYNV_Xy2f2Cq1FShldi2bw6-U9LuJvqsbcRLivuX5OqVhsiD7sxY8CwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2D_4ZYZ-Y55SXFPiiR506Ph6ZQQaaQjkD6uXfee1QbrQ&oe=69DCD463"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25835373279413387"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "911141918425203"}, {"status": "PUBLISHED", "id": "1291064562904932"}, {"status": "PUBLISHED", "id": "4459709487689473"}, {"status": "PUBLISHED", "id": "4253248098296213"}]}, "baseline_offer": {"id": "4459709487689473"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780081200, "status": "PUBLISHED", "id": "911141918425203"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25979348031682577", "version": "0.3"}, "id": "1234040351964686", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25835373249413390", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25979348031682577"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1234040351964686"}]}, 
_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiFCOEWlXK8Q7kNvwHZnb1h&_nc_oc=Adlz-XwqsKvlCyj5AS34J5tcVxnajclI0qQsasc51LzBlFv_aKNxSbvHVBqBaLwZreg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwKn4dMiuHGmJalefQMwiYqp9ByppBdryekoe4asLwAPw&oe=69BA84A2"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFq3S65MMdUQ7kNvwFNjAkP&_nc_oc=AdlABk7vA1O0FOJOKT3QCh7X61-zXF4Sh1wv_tQQd6RdeySyy2UjfcuYU-Yt-HL09Ys&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCaAC-NtQKXYpn86c6nNYYdEN0FU8BIxFoRSW7yW7KBg&oe=69BA9435"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ypb-ZHR5BAQ7kNvwG9wmjo&_nc_oc=AdnnRsYN1eR8J4DEnpEyGPWgivis1jiGRTh49liWZ3cuu_4ZTzmvWqSTTE1ZkSL4TcY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMayKffKUpeqgoxYpBHn4LzM3OvG9aJ8s1vgn5HsNGPA&oe=69BAA4AD"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oagf61gkSCkQ7kNvwF7j-Iv&_nc_oc=Adm-wJT3iuNMahRBHK6FbMIDxkLY7cnSC5lfGYKTfoCRM2NS3uGzC2CBU1wRWxig52M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx93HB9QQ21MDI3l6Hsm9okFhy1JCxRnLqHYbPEzwCeMw&oe=69BAB42B"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob9uMSRrwbwQ7kNvwHKU3J2&_nc_oc=AdkMPrr9QtxbowNKwzaZKGX7QIFbJx47heD1CBcbh80r0MgBhljsl6FCq0l3SaIqUJU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfywheVu9vMVoWfpaGUE83vKCulh1BTN_u2Tnvm-IvtVOw&oe=69BAA0CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYXHW1FBQmUQ7kNvwFPDeef&_nc_oc=AdkgZQ2eAnNUJHrgBMrRIUxiNuzImzeX2GWGM7agZEyjQaJ87ej92vWxx4qBzRqO86I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5yaNYl_P7hLBQI9r9Kqi7_mFMNnw_ZFyFRWgP2vM6lg&oe=69BA8D63"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_ser
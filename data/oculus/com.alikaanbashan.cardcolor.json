_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRxkHNPWLyMQ7kNvwHGiHWk&_nc_oc=AdkQEwTW-3g_4zPKF1RsHMbjJDz112uMpN8iOXK3QmhfbHgHPDYSsOaSoi_UtHiNLGc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWh0jVV_7i84Qxopk_ygUAZenWMBagdLG1MS9124Fksw&oe=69B53EA2"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehLQStKbdIoQ7kNvwEmPJFU&_nc_oc=AdlxvNx2OwlgSvzQC-0zp2U0zXaWX454GTA2e6RyURX99427A_CuDlYYAtOjs39QXIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzcDjWRIb-jqzziNTHm4eFj3r73tNg4HERJzX5Y4VPAyQ&oe=69B54E35"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLKgmkHBAFQQ7kNvwEK3Q9j&_nc_oc=Admv-EZ-RgCowNZtRH-beZYGlEKnZEYZpTgoq8KVHwHHZfUM3nWo4wBAylI9DDB2Ydo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyg99NFK2jIeyTYIqX8-0QlXiPMwK9ieOF15YAO5r9l-A&oe=69B55EAD"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4q3jB8SsjkQ7kNvwGzM_1x&_nc_oc=AdkO6fJ4UzqoVuLdBJPsao-DajBQ3tpdZz-jk-YEz8LyB9wvpEu0IX93F4M2c_BxHSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqMuVzle74Cfh3L5TeYzxagEzorNWK1DhwI7p2MNE2BQ&oe=69B56E2B"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiJlZ5yMo6IQ7kNvwE42Srb&_nc_oc=AdmiLEtmi-ZLLvW8YgskxANbfla5Xu0eS2kfx_CAr1MYXaXJyTP7VKVSVPfzWFtjJ_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXWMY78rXOzv4urw42cxXvDzgiWokLju8SIE3a8YRjjw&oe=69B55ACB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gS8HSV880YQ7kNvwHgWWTv&_nc_oc=AdkGs3tIA9zHda642j3zl5vdN430J9tHhahAgPLD-2OZKQlBZ5GVVB24_g8PXDbLHGc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwC2wofOn5LnE6B4jwTNJ-Eg3dVsL0AEcmxD9Ye2aX3Pg&oe=69B54763"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_ser
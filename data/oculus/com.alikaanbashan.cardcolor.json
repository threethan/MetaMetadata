_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK3alB5fZ58Q7kNvwEUBtVT&_nc_oc=AdkaNmafMDqv9mfG-IuGns7McojJsIPAX-YmG2vS47P4GNgfXe2ZQPxRkV82S4AJL9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtyfZD5GUZCP3lBsM-RJNfTeXzrUX1aaOivtOAW3f_kA&oe=69AEA722"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNmgl3jWzeIQ7kNvwGJCFYq&_nc_oc=Adlu8Uw1jrhVtm1vMjEoKj5Ixk1vIxks7aMzLzLPmPdeJKcp9JsZ3lZCoHZElj7EZYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy31Ajcuy59dwFP1aNPGOnhUngo7gV4LhPr9lhwbmCUyQ&oe=69AEB6B5"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfcwzpYQbWQQ7kNvwH3iqmw&_nc_oc=Adl1-RggunmoSkUQWlRbuIQGSevRNXZkpiFtt31WxoA1AmfY7XuWjA3p87Cmdyvvc6k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrOfiF3spmi52HmBkBTMYB0L6nlV8dgIgJIInR91GRFg&oe=69AEC72D"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1HDsI2uwT0Q7kNvwF8XK9H&_nc_oc=AdnXKA4k7cKR2LbtDayX3J7M_AQddjYf8Ulpn6fw4SgUIjSlx1jpS3IbAeKN8vuej0k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyE9VyMise7JbkKvqBdpq4TmK9SCmsa04nPWY-VdGlDeQ&oe=69AED6AB"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqbI9Pimd5YQ7kNvwF50HyI&_nc_oc=AdmHySBTj29y37b0uguiiSC6nEfzV8PsfFHRtSP7njmWo0z3Vy_Lcks3eZvkuoqeBZw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0fiTJyCZnJqup_JU1mnObdc46J6GSxrDozG2bFfBJgA&oe=69AEC34B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xboL2Fjj6p8Q7kNvwHXwELW&_nc_oc=Adnvepskj0649KWXe99_mCUrH2MLydDkAg92MP0pIcIB-yt73p62BUQBNfEQzixNUKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4NRrikJ2audIPYVuj1zbvAEZiDeJAdmgmWGuIVxbQjg&oe=69AEAFE3"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_ser
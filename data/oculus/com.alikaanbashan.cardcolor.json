9457_5094365609907948591_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ33ReoK6UcQ7kNvwGai9SI&_nc_oc=AdpUe8UeZZVZ104DGwug73q7gKrdwtbRi5YUDUz8m3IB-2stVC3NgTMCWq9iZd1XLnM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YU0tMtPkozwKYRarGA0K7B1j3F5ztnvsANHbcwdkYSQ&oe=69D90F62"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUe8paHgemIQ7kNvwGaxJQv&_nc_oc=AdpTXbNrmNcykUil6fvA_qlofs7zSRqGtb5LnvfS0-MTDj3pTnqyoW5b4Wvr_7QB8pQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20f0uLDBCG7TvLMQRyBYlRtSDEEJIqk_nGnhxtTroCQA&oe=69D8E6B5"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBSSzVutjygQ7kNvwFJAfHU&_nc_oc=Adpk4Y3P8SgnDv1-bQgKVQIChHpNeG1R64krpPUVAFRDEXJwompcsVZrFTa_yEkRRb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DB2WqAEw7V1566wVTkLzIL4Ia91rmMaT8u_LB2O478w&oe=69D8F72D"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xhfl1trnSToQ7kNvwG8VuaL&_nc_oc=AdoPtmICrpOAOPfqeKYJ_EdLx8wN61tg4XsH9k_7cj6suRoCBAY9KrnXr_nqgJReQy0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UWS7OcdtTEuPn4SCVMF_4Qa8RQeCZNks7NWPfYgJEqw&oe=69D906AB"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDLOlkdt1kAQ7kNvwEsSkme&_nc_oc=AdrH768LQjIPMeanJd7aMrLi-Ixf7tGKo0wfTM_XgBf1punTShrbmBhZSy3IstC0DCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZQs1FDw6-IIE5rGX4KVa3dA2dHPgfusD0cwDre0Jqyw&oe=69D8F34B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09UbvoPcKEsQ7kNvwEq4JGo&_nc_oc=Adpw2G6bB1i8RgAZDBNuwKF1Ypvgmd4rl64LKCWvM2r5x-cUkdHZBhSoleQcao3qnDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SYtqDxUc3j8eEGKAqhuA_JDWM3TpPN07OK026QLCYxA&oe=69D8DFE3"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25835373279413387"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "911141918425203"}, {"status": "PUBLISHED", "id": "1291064562904932"}, {"status": "PUBLISHED", "id": "4459709487689473"}, {"status": "PUBLISHED", "id": "4253248098296213"}]}, "baseline_offer": {"id": "4459709487689473"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780081200, "status": "PUBLISHED", "id": "911141918425203"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25979348031682577", "version": "0.3"}, "id": "1234040351964686", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25835373249413390", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25979348031682577"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1234040351964686"}]}, 
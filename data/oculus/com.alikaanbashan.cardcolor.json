zQa5qccQ7kNvwEstAJf&_nc_oc=AdmIy_GOkxXm-RtzCtl5HbI56u2QrZcyq4GVx9DcbSWJ9IxCp3ZOwPHCoSgvNuf6Bh4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftTs4bej0RsJ2yVPlb2AUli4nIrC33UsbK5vSXZ57tR_g&oe=699AE0A2"}, {"file_name": "4.png", "id": "2284100718782044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307470_2284100722115377_2767470955679571034_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fLh70dfluIQ7kNvwH_nwAK&_nc_oc=AdkbeCxpbNHB1RIc7tPzLXi1eYI7wuaLxtQvu0RC-6hzL2WQjUk6_s2ieob10JBYNv0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afueg66E3kpnv-c7WOvjG3ke8gjXW8geRM2_u0F74Fir6Q&oe=699AF035"}, {"file_name": "3.png", "id": "1584915352933792", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304938_1584915356267125_169014736298606728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01ZwZ1pUJJkQ7kNvwE_YMuA&_nc_oc=Adm5Y2wYjYwezYcCyyTLN4RiLqk15L6NrQXuLmpX02g2qjL4f65pKe57yTWbmCgt_W8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftZv8Zc9-WQljhlK67pbCqFXtU1o0SwKjBbdDnoAQBiZw&oe=699B00AD"}, {"file_name": "1.png", "id": "826452266970379", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303746_826452270303712_6599276965266985675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0lNEwInYj4Q7kNvwH_5WK3&_nc_oc=AdlZrMT-DidR1Fw3s_dQ6wAefgy-pPmdrNuWnIqDw6SUslXUIDn7y9qKdiQSG62Js6k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfseWX71-PkSZ_n-IqlDYN0ycr0KHgsiE1knblZxaqGS7w&oe=699B102B"}, {"file_name": "5.png", "id": "737818766023184", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303746_737818769356517_1538900343036212790_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9j3KYTCPRRsQ7kNvwFymOpH&_nc_oc=AdnMyvH0yy55I_orB1FufuhgsKpqqmEzsVihlLR7JeS_fiesOVYty9ckEUGsbBq9M7I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftYz-4Dv7Kqb-dehIIKv-KRZ81XWl-Sde-L0SvP9li_xw&oe=699AFCCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1186043999679090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818916_1186044003012423_8781887453315314659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rX0qEc-AaxIQ7kNvwGCWTFM&_nc_oc=AdnkAWfcNvDB6-8Itl80QsVDmcLq_vv-2vPe5Tq78-iVWhsfxmfJQZCqxg2RHU3B6-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsuMt3Hnoj-O2tF192xZ8HR9n9h5l6m2XtxTgfv5SBFgQ&oe=699AE963"}, "display_name": "Card Color", "keywords": ["cardpuzzle", "colormatching", "braintraining", "logicpuzzle", "casualvrgame"], "long_description": "Card Color is a focused VR puzzle game about thinking one move ahead. You face a grid of colorful numbered cards. Each tap rotates a card to the next color and reduces its remaining taps. Line up three or more cards of the same color to clear them, earn points, and gain extra time. Run out of time or taps, and the level is over.\n\nAt first it\u2019s simple, but later levels introduce more colors, fewer taps, and unusual board shapes that force you to plan routes and manage risk. Some stages are intentionally \u201cspike\u201d levels that feel intense, followed by easier \u201ccool-down\u201d levels so you can breathe before the next challenge.\n\nA clear color order bar shows which color will come next, helping you build satisfying chains and combos instead of just tapping randomly. Card Color is played entirely in VR with intuitive point-and-tap interaction, short level lengths, and no unnecessary menus\u2014perfect for quick brain workouts or longer sessions.\n", "short_description": "Card Color is a relaxing yet tactical VR puzzle game. Flip numbered color cards, manage your limited taps, and clear the board before time runs out. Plan smart moves, trigger big combos, and progress through 10 hand-crafted levels with surprising difficulty spikes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/2_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": null, "website_url": "https://w
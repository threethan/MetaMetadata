", "keywords": [], "long_description": "Coast guard game uses grenades to fight zombies invading the island. When you hold grenades, throw them at the boosters on the edge of the table. From there, the grenade will fly further and attack the zombies. The more zombies you kill, the more you will set new records and be recognized for your efforts.\nPress the A button to hold the grenade. Release to throw the grenade. And many other buttons to explore.", "short_description": "Coast guard game uses grenades to fight zombies invading the island. When you hold grenades, throw them at the boosters on the edge of the table. From there, the grenade will fly further and attack the zombies. The more zombies you kill, the more you will set new records and be recognized for your efforts.\nPress the A button to hold the grenade. Release to throw the grenade. And many other buttons to explore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/8117081b-63ef-4e52-a858-3c299892fc4a", "developer_terms_of_service_url": null, "publisher_name": "HUYEN THI MAI", "support_website_url": null, "website_url": "https://sites.google.com/view/coastal-protection/trang-ch%E1%BB%A7", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8089523124427952"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5
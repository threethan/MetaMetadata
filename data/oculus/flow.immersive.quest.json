}, {"file_name": "risk.png", "id": "1264632530902060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75240096_1264632537568726_720358860137500416_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM_wTfuSS5cQ7kNvwGlNq1B&_nc_oc=Ado0sCDIAXEXcl3wdVzXBiQ8e5DnVL_87TALJgd9OEdqdA5wzjmO3iXuNlEdiW2DJa0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFzSg_ZciQFCXjEgHEm79DdV1a3MAKuQBBa2Ww2aMR5w&oe=6B106A2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "285930314246426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982629_285930317579759_2764740648259903988_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Go0MfMxgCW4Q7kNvwFqqPU8&_nc_oc=AdpygKTUv0v4fBV5dxR0QZFYb-uRLcBZYID2e4DzbDmmzZONWWtG_pYsgmRQ_heGtvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXys1ZIkNYSd0QEtyWBJP7S1BSy3hZhTFDNjp0p2mIx6A&oe=6B1047CC"}, "display_name": "Flow Immersive", "keywords": ["Enterprise", "Data", "Productivity", "Collaboration", "Visualization"], "long_description": "\"What if you could see your data floating above a conference room table, and you can interact with every detail, collaborating with colleagues whether in person or remote to make great data-driven decisions?\n\nFlow Immersive helps enterprises and individuals more effectively explore, collaborate, and communicate data. The well-established SaaS platform includes the web-based Flow Editor to build interactive 3D data visualizations on the web and in augmented reality, found on the web at flowimmersive.com. It is used in collaborative in-person and remote meetings to drive better data-driven decisions and use data to reduce risk.\"", "short_description": "Flow experiences put you and your audience INSIDE your data to better UNDERSTAND your information with a  greater sense of detail and CREDIBILITY."}]}, "developer_name": null, "developer_privacy_policy_url": "https:/
29g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WGIiyWuh3s004kxKuhtdIka3MEYx-DtYubugyzvVJPw&oe=6A11C06B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "285930314246426", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982629_285930317579759_2764740648259903988_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KL9RHp9-XsQ7kNvwFZGY4M&_nc_oc=AdocozE8ZaH_r2mmCnQBEUQVAO2npqjK_no5R6IqhibbSlAmhJvSPVVTvEtSZFslqW0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yl5alF5I_yNgjR_0WmdKg2__4704q0OF6Q_yPAYBtyQ&oe=6A119E0C"}, "display_name": "Flow Immersive", "keywords": ["Enterprise", "Data", "Productivity", "Collaboration", "Visualization"], "long_description": "\"What if you could see your data floating above a conference room table, and you can interact with every detail, collaborating with colleagues whether in person or remote to make great data-driven decisions?\n\nFlow Immersive helps enterprises and individuals more effectively explore, collaborate, and communicate data. The well-established SaaS platform includes the web-based Flow Editor to build interactive 3D data visualizations on the web and in augmented reality, found on the web at flowimmersive.com. It is used in collaborative in-person and remote meetings to drive better data-driven decisions and use data to reduce risk.\"", "short_description": "Flow experiences put you and your audience INSIDE your data to better UNDERSTAND your information with a  greater sense of detail and CREDIBILITY."}]}, "developer_name": null, "developer_privacy_policy_url": "https://a.flow.gl/documents/privacy-policy", "developer_terms_of_service_url": "https://a.flow.gl/documents/terms-of-use", "publisher_name": "Flow Immersive, Inc.", "support_website_url": "https://docs.flow.gl/books/flow-documentation/page/submit-a-support-ticket", "website_url": "https://flowimmersive.com/flow-for-oculus", "category": null, "comfort_rating": n
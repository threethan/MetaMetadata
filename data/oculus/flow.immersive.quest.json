}, {"file_name": "risk.png", "id": "1264632530902060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75240096_1264632537568726_720358860137500416_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfeD1aZLjVcQ7kNvwGk99lI&_nc_oc=Adp7LueZXaqXM1GFDuAeqOaqdM60Fpg47a4zpVKzgs7F7Mmqwu47FfAuqs3V2h2dHlw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDes30XrCnFhjUe-z0r4Tj7o4mPedyl7ZtBQOIQqSFoA&oe=6B005FEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video thumbnail.png", "id": "285930314246426", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982629_285930317579759_2764740648259903988_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8avatsrO1p8Q7kNvwGdXBNt&_nc_oc=Adq4-FW6tStmhNYkkhwpp7rzp4m645SY2nN7R8uxyxN8AYeTtEnPS65OyjH9BxzkJno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkt1Lg4VxBSIDok48-jsh6Qf2L7pi8t9FLIUaIxXZ5aw&oe=6B0075CC"}, "display_name": "Flow Immersive", "keywords": ["Enterprise", "Data", "Productivity", "Collaboration", "Visualization"], "long_description": "\"What if you could see your data floating above a conference room table, and you can interact with every detail, collaborating with colleagues whether in person or remote to make great data-driven decisions?\n\nFlow Immersive helps enterprises and individuals more effectively explore, collaborate, and communicate data. The well-established SaaS platform includes the web-based Flow Editor to build interactive 3D data visualizations on the web and in augmented reality, found on the web at flowimmersive.com. It is used in collaborative in-person and remote meetings to drive better data-driven decisions and use data to reduce risk.\"", "short_description": "Flow experiences put you and your audience INSIDE your data to better UNDERSTAND your information with a  greater sense of detail and CREDIBILITY."}]}, "developer_name": null, "developer_privacy_policy_url": "https:/
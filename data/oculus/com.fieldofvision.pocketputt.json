1sg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBloFv6QylXC2kOIGU2mR4MBFdoNImsw4qk-pvVWVF3HQ&oe=6A576B18"}, {"file_name": "Shot2.png", "id": "1404574967787463", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296890_1404574971120796_2537459479013276649_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzNESplwDisQ7kNvwFfHUNs&_nc_oc=Adr7NZq8YIjlAhaclph4m23h4U0d8tmp5TMaFbwruTyvYAWLUXE62YrQe6Poqw593jM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdPh5Dz8WOWLntBcAbZrFtsj-bJCbUXFxlw4M7Q6cEeg&oe=6A578FB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OpenAlpha copy.png", "id": "776102222187828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821682_776102225521161_4172661974982605707_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdO0WTf6icEQ7kNvwEZ2xGx&_nc_oc=AdryKei2tMFBsi_gm7cPbadxVxJMk6A7fqt9IUs82BhfC6SAUXToeupwiRPn--C4E2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx8zcj93cKqD0BRjh3F2x8gdlGyrMvNBKjWNxvrJEELQ&oe=6A5791DD"}, "display_name": "Pocket Putt", "keywords": ["minigolf", "handtracking", "tabletop", "physics", "golf"], "long_description": "# Pocket Putt is now in Open Alpha\n\nJoin here: https://www.meta.com/s/7eCmQgmoX\n\nJump in early to play new features as they\u2019re added, share feedback and design holes that could become official courses. Be the first the join the community on Discord to know more: \nhttps://discord.gg/WHG825MbbT\n\n# -\nPocket Putt is a calm, seated mini-golf experience built from the ground up for natural hand tracking. Play comfortably at a table or on the floor, line up precise shots, and sling the ball with simple gestures.\n\n# -\n# Natural Hand Tracking + Microgestures\n{1397583094531783}\nPlay with full hand tracking to line up, pinch, pull, and release your shots naturally. Use Microgestures (subtle thumb inputs) for quick actions like opening menus, rotating around the ball, or teleporting back into position without breaking the flow.\n\n# -\n# Create & Share Your Own Holes\n{2235019570320293}\nDesign your own mini-golf holes, publish them, and let others play your creations. Explore community-made courses for fresh layouts, creative ideas, and new challenges.\n\n# -\n# Endless Play & Mastery\n{1214437757331809}\nReplay holes to refine your shots and improve over time. Compete on leaderboards, unlock achievements, and race against ghost runs as you chase cleaner lines, fewer strokes, and perfect putts.\n\n# -\n# Your Space, Your Course\n{1240116038008010}\nPlace mini-golf lanes on your floor or table and play seated or standing. Pocket Putt adapts to your room, turning everyday spaces into compact, comfortable courses.\n\n# -\nLine up your shot and play mini-golf right where you are.", "short_description": "Pocket Putt is a calm, seated mini-golf experience built from the ground up for natural hand tracking. Play comfortably at a table or on the floor, line up precise shots, and sling the ball with simple gestures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "https://pocket-putt.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1676485315806614"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [
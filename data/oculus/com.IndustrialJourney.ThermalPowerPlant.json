Af3g2NSowYa8EWltywtcgrv7jH7o-TuQU4GDLEXt8ifJ2A&oe=69F0BA63"}, {"file_name": "TransmissionLine (1) (1).png", "id": "1118306052698207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982652_1118306056031540_6464141157175375557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3SWVxjmH94Q7kNvwGQ_om7&_nc_oc=Adp3gvqXiA7royF0jvO-EvhZYHwrLT9-u94X6mjPmpzlncvkiR_NaVxSjfGCNeOpWzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1TeQY--i0UWCcVucuPZVefOzEKXyrgE8hkswyxQXRbVw&oe=69F0A07E"}, {"file_name": "ESP (1) (1).png", "id": "964151325246560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75443244_964151328579893_8461473694159931819_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9KLY8FjUmsQ7kNvwHfUCJ7&_nc_oc=AdrNyhfN4_nSCXS0_lNwQPpMmcWDwp4hhRT335O-IDrtfpRVfsGh6pyQ4LLg2IbHL7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3qkSeb5OA0UprL_0HvBUgxxlRpL8fkGKAPHqypeQT-Cw&oe=69F0BA27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-Thermal_Power_Plant_Image-01-Cover.png", "id": "710635164302527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035385_710635167635860_999737385406583038_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyWdfLletdkQ7kNvwGUp9rU&_nc_oc=Adr7e6tB8-8cZFcey9U6hiHUViFav_IzVeCTVp9E4XezLIu05EnZcy4nmWjv_xkAPGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0lBGH0i9zOAoko5bxScbTQgRmewLmP-4sRUI30JyMcsg&oe=69F0AECA"}, "display_name": "Industrial Journey - Thermal Power Plant", "keywords": [], "long_description": "Power Up Your Learning with Our New Thermal Power Plant Module! \n\nElevate your journey on our platform with this immersive add-on. Dive into a virtual Thermal Power Plant, choosing between a guided tour for detailed insights or the freedom of Explore Mode to roam at your will. Witness firsthand the intricate workings of power generation. This module isn't just an addition; it's a gateway to understanding the dynamics of energy like never before.\n\nJoin us in revolutionizing the way engineering is taught. Embrace the power of VR to gain practical, in-depth knowledge in a truly interactive environment. Our VR engineering modules are more than just a learning tool; they are your gateway to mastering engineering concepts through modern technology. \n\nStart your virtual educational adventure today!", "short_description": "Dive into a virtual Thermal Power Plant, choosing between a guided tour for detailed insights or the freedom of Explore Mode to roam at your will.\n\nStart your virtual educational adventure today!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ixrlabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IXRLabs", "support_website_url": null, "website_url": "https://www.ixrlabs.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26811272421811606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75451775_1460790338129127_7597273522986314967_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhu3BGT4h7YQ7kNvwGrdA7v&_nc_oc=AdpN-pVt-cNgWJXbDbIfgKZWNB2HJlXpC4TFkTMGIMX30Qn7Dxj8BahTLjVBeQgdstE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af208a3KodpK6qV9lTpctN5ULthGVSdiPdW5Rmr6kHeorg&oe=69F0AF89"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fa
kS8lcW1iARRbmyInR_Our7PLQF6P4fMErDZzTyxo99PHXKbUC4U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjMAYuxx8HzzmPBhEU_r8X5gNEvaJ5dCr3WljLPoKZ9Q&oe=6A749063"}, {"file_name": "TransmissionLine (1) (1).png", "id": "1118306052698207", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982652_1118306056031540_6464141157175375557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2m6I9xFmKEQ7kNvwH5rDfT&_nc_oc=Adp6duhWGJCiAlqkZPXj1I3e90Irv1t7FkfxvpbOHsuBVYeJ8Au-44Tt566ciEFM_Bg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRT0rMNWU92SJobVnNlD_ZX6w66nRY3QHrgED-CNtroA&oe=6A74767E"}, {"file_name": "ESP (1) (1).png", "id": "964151325246560", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75443244_964151328579893_8461473694159931819_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj2rPOGd-LYQ7kNvwGIUjrn&_nc_oc=Adqjfi21frjLu7iY-tv0sX764UeP6oM_qRgdnyIcm37C2CsntVeaFQYuhG8q1o2cWcU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnNQKCSWu3f8Hh93ZHIfwMCtP0XdcQaBe8f-oVDfbTsQ&oe=6A749027"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-Thermal_Power_Plant_Image-01-Cover.png", "id": "710635164302527", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035385_710635167635860_999737385406583038_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0JGDRLdiBAQ7kNvwFsZh6m&_nc_oc=AdpuFKZJdhLHGOx3ykQiAx20rV0Ja1MUFJ-vjWGns1f31Ss5tXD0lL2RdzAXXGiR8jc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErWe0YMTjR8Il-gIMx46gTq1BwhgdrEKnIvyz7rDUpQg&oe=6A7484CA"}, "display_name": "Industrial Journey - Thermal Power Plant", "keywords": [], "long_description": "Power Up Your Learning with Our New Thermal Power Plant Module! \n\nElevate your journey on our platform with this immersive add-on. Dive into a virtual Thermal Power Plant, choosing between a guided tour for detailed insights or the freedom of Explore Mode to roam at your will. Witness firsthand the intricate workings of power generation. This module isn't just an addition; it's a gateway to understanding the dynamics of energy like never before.\n\nJoin us in revolutionizing the way engineering is taught. Embrace the power of VR to gain practical, in-depth knowledge in a truly interactive environment. Our VR engineering modules are more than just a learning tool; they are your gateway to mastering engineering concepts through modern technology. \n\nStart your virtual educational adventure today!", "short_description": "Dive into a virtual Thermal Power Plant, choosing between a guided tour for detailed insights or the freedom of Explore Mode to roam at your will.\n\nStart your virtual educational adventure today!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ixrlabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IXRLabs", "support_website_url": null, "website_url": "https://www.ixrlabs.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26811272421811606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75451775_1460790338129127_7597273522986314967_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmM0R0XAWE8Q7kNvwH0aTg3&_nc_oc=AdqCsGfB5V0wf1OkbAcpt9tWoLhsp6zphUa6sF0vA8b1Iz0V8gNOTMowcXovNdlQDDE&_nc_zt=3&_nc_ht=sconten
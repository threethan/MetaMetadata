_Dp6LoqYY9SVWPoVzN4W3TWxMYM2kj4CLixU7SspZI4X-mLFXfK17A064&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xJu-1TjVQs3V4Skstw1Eu5L1247un7YyUVKJRYKkQAA&oe=6A11AFE3"}, {"file_name": "TransmissionLine (1) (1).png", "id": "1118306052698207", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982652_1118306056031540_6464141157175375557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cx5gYf3Uh4QQ7kNvwH0n20A&_nc_oc=AdpnxAXxbObm6R-p2OeixSLw93EoQ78QDFNlJIk1dAqGpxEUXYrY8ZIvpa_ZdDW7_G4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PkCSWFJCzljkjmbcK5TL-XJxnYthTZ0N4MfEDUyebCA&oe=6A11CE3E"}, {"file_name": "ESP (1) (1).png", "id": "964151325246560", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75443244_964151328579893_8461473694159931819_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEvjxHeg1oEQ7kNvwE-SE82&_nc_oc=AdpzH_OnuQI_kBo3s8oW1BIT33g0KK9rs9l0gUd4nmBM9FXlG73D61Fis-hiQ6ApgaU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lfrE7ia7pnJj4u4qF9hiQGli6UwM1OQsQq5hFjo_a7g&oe=6A11AFA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-Thermal_Power_Plant_Image-01-Cover.png", "id": "710635164302527", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035385_710635167635860_999737385406583038_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZAigGGf5XAQ7kNvwG28YqJ&_nc_oc=Adp0VO67C8VGTzgTs294FT0qaxXUj4JO3lcBB6OxsoacU1EEhAVC_kkMwy5r3-jdKeQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68kRStECkbo_Sdt1DAD8jccn6xyOeYlHQrMUEw4bbwdw&oe=6A11A44A"}, "display_name": "Industrial Journey - Thermal Power Plant", "keywords": [], "long_description": "Power Up Your Learning with Our New Thermal Power Plant Module! \n\nElevate your journey on our platform with this immersive add-on. Dive into a virtual Thermal Power Plant, choosing between a guided tour for detailed insights or the freedom of Explore Mode to roam at your will. Witness firsthand the intricate workings of power generation. This module isn't just an addition; it's a gateway to understanding the dynamics of energy like never before.\n\nJoin us in revolutionizing the way engineering is taught. Embrace the power of VR to gain practical, in-depth knowledge in a truly interactive environment. Our VR engineering modules are more than just a learning tool; they are your gateway to mastering engineering concepts through modern technology. \n\nStart your virtual educational adventure today!", "short_description": "Dive into a virtual Thermal Power Plant, choosing between a guided tour for detailed insights or the freedom of Explore Mode to roam at your will.\n\nStart your virtual educational adventure today!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ixrlabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IXRLabs", "support_website_url": null, "website_url": "https://www.ixrlabs.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26811272421811606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75451775_1460790338129127_7597273522986314967_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sreyvs4GowQ7kNvwGjXzW4&_nc_oc=AdpUjiCH-P7zo64eiCHuk_8lGseDbyTDXaJKe6uip1fZ5EwXOMRspj0KIpYilWLXpaY&_nc_zt=3&_nc_
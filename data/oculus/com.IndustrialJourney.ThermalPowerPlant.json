SmLzX1mNuAHrXpviM9JW8A8KX2v7baNK9hVEDnzjJF7VCScg5k8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDp-FzrPjJoHMEMbj3Syh1VtPNmVnNgMfIxBlolDENLg&oe=6A6B55E3"}, {"file_name": "TransmissionLine (1) (1).png", "id": "1118306052698207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982652_1118306056031540_6464141157175375557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIOWqcFSo2wQ7kNvwG1WQWx&_nc_oc=AdoESiwMTuq5y78N6bs1fUVIsA8eI563_pqs5hmfW1Id_Hc8E8m5fT6Ks2SY1YgEKlY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU1HuuspLUN9Xsjsx4-FVgxfvSF3ExJIc2g_eNKz9RAQ&oe=6A6B3BFE"}, {"file_name": "ESP (1) (1).png", "id": "964151325246560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75443244_964151328579893_8461473694159931819_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahOLU0VPZ4wQ7kNvwE4HQMy&_nc_oc=AdpkaXZ3dmkSZ6DOlwRN7AbOePXTMLw-8OuslF7gWK-ul43_7zo6ZOz2uphVYz1-b2Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMHFoF1cta-t6ZWMQuDcu0mDl4-Hxcz2DW_bYPDDinjQ&oe=6A6B55A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-Thermal_Power_Plant_Image-01-Cover.png", "id": "710635164302527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035385_710635167635860_999737385406583038_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6KcK_KanWUQ7kNvwGDudEr&_nc_oc=AdoN9LB63U9xubEnv0Iu9yLeDRNt8SoJLL6M8-RPlxZF_2BGLCVZbQcyoR_8crMVUo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDN63VIO8PrD-H9Vfr0_4JbEOCUblh81AZtQVuH56wUwQ&oe=6A6B4A4A"}, "display_name": "Industrial Journey - Thermal Power Plant", "keywords": [], "long_description": "Power Up Your Learning with Our New Thermal Power Plant Module! \n\nElevate your journey on our platform with this immersive add-on. Dive into a virtual Thermal Power Plant, choosing between a guided tour for detailed insights or the freedom of Explore Mode to roam at your will. Witness firsthand the intricate workings of power generation. This module isn't just an addition; it's a gateway to understanding the dynamics of energy like never before.\n\nJoin us in revolutionizing the way engineering is taught. Embrace the power of VR to gain practical, in-depth knowledge in a truly interactive environment. Our VR engineering modules are more than just a learning tool; they are your gateway to mastering engineering concepts through modern technology. \n\nStart your virtual educational adventure today!", "short_description": "Dive into a virtual Thermal Power Plant, choosing between a guided tour for detailed insights or the freedom of Explore Mode to roam at your will.\n\nStart your virtual educational adventure today!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ixrlabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IXRLabs", "support_website_url": null, "website_url": "https://www.ixrlabs.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26811272421811606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75451775_1460790338129127_7597273522986314967_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHeCKRsXOTUQ7kNvwEo9C2_&_nc_oc=AdrU1rVD-862h8NVuEiIY90jUoumRNhdthhQZR0d2ByEZoPdTIp63K5Aczhz7sWE4UM&_nc_zt=3&_nc_ht=sconten
q0C6xH5G46KizRNKgHGDc-jO6w-hp144KxsqhrfWTKDRbiMtq2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALYJk-PCU7d8HTklC2Kz8vnJbPLYIedvQl0rSRRLhcEw&oe=6A578F63"}, {"file_name": "TransmissionLine (1) (1).png", "id": "1118306052698207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982652_1118306056031540_6464141157175375557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwZE9yB-fXQQ7kNvwHGif8g&_nc_oc=AdrpC6THxtu9ZOC_CDeDdz7i2IvqrRo15FkA8d09k8kwgO-sJ4-VJqrAfE6V_y9C2d0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjCL3DmmishNZE-XY62mSAYNH5p2TobQcQfuKVuVRIug&oe=6A57757E"}, {"file_name": "ESP (1) (1).png", "id": "964151325246560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75443244_964151328579893_8461473694159931819_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqvCpZXgzsEQ7kNvwFW9Nf0&_nc_oc=AdrkbkMmtrXKp1MVMNeZ08yITfeVnMxfg7sbrC4nIZofrgGpx1rFwpaAb7JMlz83ZWU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz4UlvZWc9XpeNldRRH2qT0ObjG1CvPF6Zs-mZWy4N-Q&oe=6A578F27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-Thermal_Power_Plant_Image-01-Cover.png", "id": "710635164302527", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035385_710635167635860_999737385406583038_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GYuSItjX-UQ7kNvwEE9oBE&_nc_oc=AdoCDlf-M9r-W0BBvvsa6YRnhQ5CiuBUnAJkWJi_4iO2VGgXIx77NHs9lsHE_C-jqtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxaDke4xG7if4d1f_Q1CTDIZiGISEGqR5PPLW6gS1lQA&oe=6A5783CA"}, "display_name": "Industrial Journey - Thermal Power Plant", "keywords": [], "long_description": "Power Up Your Learning with Our New Thermal Power Plant Module! \n\nElevate your journey on our platform with this immersive add-on. Dive into a virtual Thermal Power Plant, choosing between a guided tour for detailed insights or the freedom of Explore Mode to roam at your will. Witness firsthand the intricate workings of power generation. This module isn't just an addition; it's a gateway to understanding the dynamics of energy like never before.\n\nJoin us in revolutionizing the way engineering is taught. Embrace the power of VR to gain practical, in-depth knowledge in a truly interactive environment. Our VR engineering modules are more than just a learning tool; they are your gateway to mastering engineering concepts through modern technology. \n\nStart your virtual educational adventure today!", "short_description": "Dive into a virtual Thermal Power Plant, choosing between a guided tour for detailed insights or the freedom of Explore Mode to roam at your will.\n\nStart your virtual educational adventure today!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ixrlabs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IXRLabs", "support_website_url": null, "website_url": "https://www.ixrlabs.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26811272421811606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75451775_1460790338129127_7597273522986314967_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gea16xbBq4gQ7kNvwFcxVbR&_nc_oc=Adrvfnm0Yl7SMQcylRuIqAVICAH6ZeZzNYJTNrhxiTMZFbYmu6a4SqlgWoMxCL5fkis&_nc_zt=3&_nc_ht=sconten
57_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YJXnvSUqKoQ7kNvwEY_5pN&_nc_oc=AdrJyAJe3h1Jd4B3781_oeAbdCr8u6Po3FkLcnpSfV1T-cXNgq8KnmTUxZK23mkS6hM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ov9REAhG_ziQWk42jtWKWTBor_oSnVtaLuZvzSOEmkQ&oe=6A0C883E"}, {"file_name": "ESP (1) (1).png", "id": "964151325246560", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75443244_964151328579893_8461473694159931819_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnKejsZXU3wQ7kNvwHy3lXx&_nc_oc=Adp-xJR0ZjmP84V9jtQ_6g9aKd_D8QH9AE14feIl_jo4agaU3Wih-8qqUCxg-UbBQ38&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42aexH5_FZrfK9EZ5gvcmh7hwGAWsy1ckA8Kb_giWekw&oe=6A0C69A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "01-Thermal_Power_Plant_Image-01-Cover.png", "id": "710635164302527", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035385_710635167635860_999737385406583038_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qIPtk_Fjm0Q7kNvwHdbrLQ&_nc_oc=Ado5zNbj3CQc8CQqMPTC2BuEu_6udvmYv5cL1b7eBzpTDzrzo0J9pF29NRzoe4Xrl6Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GAMwfJxPEIVAbInHkI7ItpziYklX_m5ThwYPh_Cx6dQ&oe=6A0C5E4A"}, "display_name": "Industrial Journey - Thermal Power Plant", "keywords": [], "long_description": "Power Up Your Learning with Our New Thermal Power Plant Module! \n\nElevate your journey on our platform with this immersive add-on. Dive into a virtual Thermal Power Plant, choosing between a guided tour for detailed insights or the freedom of Explore Mode to roam at your will. Witness firsthand the intricate workings of power generation. This module isn't just an addition; it's a gateway to understanding the dynamics of energy like never before.\n\nJoin us in revolutionizing the way engineering is taught. Embrace the power of VR to gain practical, in-depth knowledge in a truly interactive environment. Our VR engineering modules are more than just a learning tool; they are your gateway to mastering engineering concepts through modern technology. \n\nStart your virtual educational adventure today!", "short_description": "Dive into a virtual Thermal Power Plant, choosing between a guided tour for detailed insights or the freedom of Explore Mode to roam at your will.\n\nStart your virtual educational adventure today!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ixrlabs.com/privacy-policy.php", "developer_terms_of_service_url": null, "publisher_name": "IXRLabs", "support_website_url": null, "website_url": "https://www.ixrlabs.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7652998188065650"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1423349825007842"}, {"status": "PUBLISHED", "id": "288869297410657"}]}, "baseline_offer": {"id": "1423349825007842"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1726730340, "status": "PUBLISHED", "id": "1423349825007842"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7741152932583508", "version": "0.1"}, "id": "1459891708242277", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"_
654242531_3489175563609450703_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pThzAhUrNDwQ7kNvwHKbnTE&_nc_oc=AdrjY8l2MNDlUU5EWpDdwbm9ztl1wOTCrzpJuJFdDSBghnvOMMwyA0LC4t82_wHGT0I&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCyPkZVh_W1-N6Fysg6DcPbphsgy0HcrEZl0QhRpOtjQ&oe=6B09B818"}, "display_name": "No Hope: The Escape", "keywords": [], "long_description": "Unearth the chilling secrets of your past and make your escape, or be overwhelmed by the relentless, encroaching shadow that threatens to consume you.\n\nPlay as Benjamin, a survivor of the harrowing New Hope Orphanage. You must navigate a labyrinth of twisted puzzles and uncover the haunting memories you once suppressed. As the ever-looming shadow draws closer, it becomes a race against time to escape and confront the chilling truth of your past, or risk being forever consumed by the darkness.", "short_description": "Unearth the chilling secrets of your past and make your escape, or be overwhelmed by the relentless, encroaching shadow that threatens to consume you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nohopethegame.github.io/nohopethegame/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Sebastronix", "support_website_url": null, "website_url": "https://nohopethegame.github.io/nohopethegame/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_U
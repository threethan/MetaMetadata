": [{"file_name": "Screen1.png", "id": "974952803679312", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974593_974952807012645_2273420780151800961_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9aCcc-LV60Q7kNvwGf6TIP&_nc_oc=AdqrUW_lhHjN9-oI7SsU1u6xV_ti3owq5Lm8FWsGzTgWCmk8eJ0c4BzAAlNSDvIBVg8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OsTT5A8mnL_uM6eaMTZ8fjyhaFndrbZk_h_MW_bet9w&oe=69F4BDE5"}, {"file_name": "Screen2.png", "id": "740285451167381", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86597262_740285454500714_2441245165127717441_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKc0H9gyBZoQ7kNvwHKMMpG&_nc_oc=AdpFhAG93Mdaavhwjzu99ow6nBaaIXKRLcwPecVX2nrh1qLjMC_jorDcKZPZWjAZouc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1f9DPlCoE8rHGMib1cksPbduGzhrtCD2-vRf4sn7UVwA&oe=69F4A731"}, {"file_name": "Screen3.png", "id": "749687596639291", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031616_749687599972624_8966126731538132281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lqz-wjKQRv0Q7kNvwGWPvhi&_nc_oc=AdpUmUno06t02TOGwMpVsqY87J1ZMcm4IfOia3WiUmKznKNhLNdFpB5lI-0LGoWr7d8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2F4QjnwEBvsZg85SmgMZzpdqEBBkwlf--9r_1vckGCWQ&oe=69F4B156"}, {"file_name": "Screen4.png", "id": "1244144979810089", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974798_1244144983143422_1681704455242691437_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AealbT7tsGIQ7kNvwEGStrm&_nc_oc=Adqrk8faU-3VfxsLmvQ_MrQX2u-PKujicvr6KFUeSBBERXLCkJXal4v42o4RE2VJOGg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eu4LS4ZwgqikeY0jqBVUvt0tQUlRUazlMghs4EI_prQ&oe=69F4A6C1"}, {"file_name": "Screen5.png", "id": "746407370603414", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031560_746407377270080_7049822999817787277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jORlfFTHG3cQ7kNvwHY6foU&_nc_oc=AdrKJIzMN1mGAlgkbqyPTAzOVtRR40VqqEd5xfTqDL2GC5peT_8sWF4kW9tZmYVpUTA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nE7hAcE1lgXrJtCakLpaO9Og6J2h6K5D8aQdPCbH__g&oe=69F4A6B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "167636232574363", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984448_167636235907696_6696061602154100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLjpv5ALriAQ7kNvwEKhys0&_nc_oc=AdqbrZe7TQAWMO5ICgYPCvRihXfSvO_YZ0fal25EW8d0udELo4Mh3mnzbr7Hp0t5A8M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xZoP8qTUGK5retS41twiIZrGGwPqvUq5aVb0AfoxWSA&oe=69F4A209"}, "display_name": "Tennis On-Court", "keywords": [], "long_description": "Tennis On-Court is the ultimate tennis simulator to discover!\n\nIt's not only a video game, it's real tennis thanks to the experience of Decathlon & Artengo engineers, working every day on the design of tennis equipment : rackets, balls, accessories, ... used by top players on the ATP & WTA tours.\n\nLift, slice, dropshot, retro, perform all those effects and feel like a real tennis player..\n\n~Foundations~\n\n- Gameplay : Arcade or Realistic, choose your side!\n- 3 different types of moving: Teleport, Automatic, Manual\n- Fully customizable 3D male & female avatars\n- 13 rackets with different characteristics to match with your style.\n- 6 incredible stadiums with different evolutive surfaces : clay, grass, hard...\n- 5 assists to help you to perform: service hit assist, position assist, ball trajectory correction, ...\n- Spectator mode\n\n~Realism~\n\n- Play with your ball before serving\n- 1 handed or 2 handed backhand ? That works!\n- Umpire and linesmen are present on the court to follow your matchs\n- Playing in a crowed out stadium is perfect for immersion!\n- AI is almost human thanks to all motion-captured animations in match.\n\n~Game modes~\n\n- Play against AI in 1vs1 with 4 difficulty levels\n- Bonus : choose if your opponent is left or right-handed\n- Play with your friend in singles (1vs1) or doubles (2vs2) online match\n- Find perfect opponents thanks to matchmaking feature\n- Prove your are the best thanks to the online championship\n- Improve your skills with 5 training modes.\n", "short_description": "The ultimate VR Tennis simulator. Play with your friends or worldwide competitors in 1vs1 and 2vs2 online mode. Or practice in match against AI and various exercices. Physics has been worked with top players to transpose real tennis in VR."}]}, "developer_name": "Fishing Cactus", "developer_privacy_policy_url": "https://www.tennisoncourtvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Decathlon", "support_website_url": null, "website_url": "https://www.tennisoncourtvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr_BE", "fr_CA", "fr", "de", "de_CH", "it", "ja", "ko", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "229649783190906"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2240139153172718"}, {"status": "PUBLISHED", "id": "1903076017091707"}, {"status": "PUBLISHED", "id": "592130886788327"}, {"status": "PUBLISHED", "id": "1392239571492673"}, {"status": "PUBLISHED", "
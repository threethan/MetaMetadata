": [{"file_name": "Screen1.png", "id": "974952803679312", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974593_974952807012645_2273420780151800961_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQFvaJwBO2QQ7kNvwHMiYNU&_nc_oc=AdoPHP4dwvoR1YXLqHhB76y2tYE-KM2_K2XVFENj6dCJM6dVvAtzyZWdzSizrkvhYkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iuhQY4vDU_swuaRcxhCZh3AKfWZcr_di1xto8pSkNtg&oe=6A355765"}, {"file_name": "Screen2.png", "id": "740285451167381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86597262_740285454500714_2441245165127717441_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4hO756cTSkQ7kNvwGteTmW&_nc_oc=AdoNuVEO4ju9xxrkeOx3DxrXR8jf_VdQwLthGVgE2prdcqgUYueel7SRipDwO1BkgPM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_un_wMfpTaXQgPsnvB4gc81_wQSGFcm8Yl7HYWIziPqw&oe=6A3540B1"}, {"file_name": "Screen3.png", "id": "749687596639291", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031616_749687599972624_8966126731538132281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddMyqC-6TH0Q7kNvwF7TupR&_nc_oc=AdpsC3Tk-U9QAd1Bn0Sakj_XLeHJKe59FuNr46E9t49UHQIbJCKnXyaSrlLIpc5mN80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8chqw0bRZxKY5Gk6hUunXAL9-Eyvr_az6p_SnpXvYeQ&oe=6A354AD6"}, {"file_name": "Screen4.png", "id": "1244144979810089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974798_1244144983143422_1681704455242691437_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2cd0kenVeMQ7kNvwGUVbtR&_nc_oc=AdoUWtGCAxt6NJfLmQqWj5A1orBLUPu5a2qEfeQudKaY-tHUSgTVrGNGXa2F4jhKa9s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UxN6U1gDPnSDbMOVb7CPfn7bq23oS2fjpOlhwBoJrsg&oe=6A354041"}, {"file_name": "Screen5.png", "id": "746407370603414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031560_746407377270080_7049822999817787277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7zdRcJ11YcQ7kNvwHw41cA&_nc_oc=Adp3xuyVSYm1zVvCxbIbuGlhsPxgDbxSEB15IrjU5nHEjWS0F9l76C4Q1Y-0UslwD0A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VUiY2yzR8ZVrv6g-R2xnNrA6X-zdyu2pnrxN67onf_A&oe=6A354034"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "167636232574363", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984448_167636235907696_6696061602154100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gX70YCjvU84Q7kNvwFg4yVo&_nc_oc=AdrMfnt5ZJwdCto1-gIl_1nbgUcxyScV0HKjOQfDbQrsTzRr--Wchhy-J26Zd3jt7V0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Nl0egODq8KeyKryjofeOJak3VDCHD2NpSs0TYxIhdbA&oe=6A3573C9"}, "display_name": "Tennis On-Court", "keywords": [], "long_description": "Tennis On-Court is the ultimate tennis simulator to discover!\n\nIt's not only a video game, it's real tennis thanks to the experience of Decathlon & Artengo engineers, working every day on the design of tennis equipment : rackets, balls, accessories, ... used by top players on the ATP & WTA tours.\n\nLift, slice, dropshot, retro, perform all those effects and feel like a real tennis player..\n\n~Foundations~\n\n- Gameplay : Arcade or Realistic, choose your side!\n- 3 different types of moving: Teleport, Automatic, Manual\n- Fully customizable 3D male & female avatars\n- 13 rackets with different characteristics to match with your style.\n- 6 incredible stadiums with different evolutive surfaces : clay, grass, hard...\n- 5 assists to help you to perform: service hit assist, position assist, ball trajectory correction, ...\n- Spectator mode\n\n~Realism~\n\n- Play with your ball before serving\n- 1 handed or 2 handed backhand ? That works!\n- Umpire and linesmen are present on the court to follow your matchs\n- Playing in a crowed out stadium is perfect for immersion!\n- AI is almost human thanks to all motion-captured animations in match.\n\n~Game modes~\n\n- Play against AI in 1vs1 with 4 difficulty levels\n- Bonus : choose if your opponent is left or right-handed\n- Play with your friend in singles (1vs1) or doubles (2vs2) online match\n- Find perfect opponents thanks to matchmaking feature\n- Prove your are the best thanks to the online championship\n- Improve your skills with 5 training modes.\n", "short_description": "The ultimate VR Tennis simulator. Play with your friends or worldwide competitors in 1vs1 and 2vs2 online mode. Or practice in match against AI and various exercices. Physics has been worked with top players to transpose real tennis in VR."}]}, "developer_name": "Fishing Cactus", "developer_privacy_policy_url": "https://www.tennisoncourtvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Decathlon", "support_website_url": null, "website_url": "https://www.tennisoncourtvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr_BE", "fr_CA", "fr", "de", "de_CH", "it", "ja", "ko", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "229649783190906"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2240139153172718"}, {"status": "PUBLISHED", "id": "1903076017091707"}, {"status": "PUBLISHED", "id": "592130886788327"}, {"status": "PUBLISHED", "id": "1392239571492673"}, {"status": "PUBLISHED", "
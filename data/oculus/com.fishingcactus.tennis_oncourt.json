": [{"file_name": "Screen1.png", "id": "974952803679312", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974593_974952807012645_2273420780151800961_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luOJ2NG_79YQ7kNvwE69fvU&_nc_oc=AdogxGinnU7qrLi0vOXdNXJ6YKwOA8uxAWtPICcvRvS6BbWpcD3S12Tldbq_78onZZk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WTvzMO0Im3YH4eZgQCnFa2MsNjaQg7gxSWJwySIahuw&oe=69E78EE5"}, {"file_name": "Screen2.png", "id": "740285451167381", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86597262_740285454500714_2441245165127717441_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex0-lCHL8wMQ7kNvwGNzkix&_nc_oc=AdrSrkuhwLG9z7Oho5BROSPVXe6c8AV34xqNmvK-4rKQO9ioWj5zVYCg2xp1_hYjnTk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WXtTCoM5NvAQyNMxartZ26U7v_RiaHWFji4epNcYqAQ&oe=69E77831"}, {"file_name": "Screen3.png", "id": "749687596639291", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031616_749687599972624_8966126731538132281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OkfYLDXeJ0Q7kNvwE206xT&_nc_oc=AdoV0zqEEnKznMSAesx5DOIn4TvPWUbFEWVlYu-EIHhN6ZsCCt9okSt8NHSx1Fh6i3c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TSJhx9Rm1fiLbHc0Or8rHJcck2pc2gFlcE3nQ2zlELg&oe=69E78256"}, {"file_name": "Screen4.png", "id": "1244144979810089", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974798_1244144983143422_1681704455242691437_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYiBf215T1YQ7kNvwH7n7pL&_nc_oc=Adrjy4wZR97pKYR8KY1ZilDDI_3IpN1Y1qk_CqCW4llYGC50qRfRftP7F04Z5XNd-z4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20QSiJ2Tt1jUJo907IwMaPrW9tcGkl6oRIsoVdXrD42g&oe=69E777C1"}, {"file_name": "Screen5.png", "id": "746407370603414", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031560_746407377270080_7049822999817787277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kS_yiu4x7zsQ7kNvwH544tu&_nc_oc=AdqRSfFGmjeRLxAIjPCkYJglXoxm5vWbV2WPOTih_VUvTr0x6TaDYrznRQdYAY1EDXE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20aYZFiQOKRtrgNKuuLRQKJnKZ8FFeFvkqnwhUYsoC6w&oe=69E777B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "167636232574363", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984448_167636235907696_6696061602154100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RetQKIpRq04Q7kNvwFxUu_1&_nc_oc=AdohuqRUvdGodsz_wpzMiqKZd1As3WLDiXtsUtny3p9JAzUJha3H_8S9yGzATY3heSQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dhbS6eNfa5WVpg_wgmYIlVMHjs_RwvBqzaxkbAkV2gA&oe=69E77309"}, "display_name": "Tennis On-Court", "keywords": [], "long_description": "Tennis On-Court is the ultimate tennis simulator to discover!\n\nIt's not only a video game, it's real tennis thanks to the experience of Decathlon & Artengo engineers, working every day on the design of tennis equipment : rackets, balls, accessories, ... used by top players on the ATP & WTA tours.\n\nLift, slice, dropshot, retro, perform all those effects and feel like a real tennis player..\n\n~Foundations~\n\n- Gameplay : Arcade or Realistic, choose your side!\n- 3 different types of moving: Teleport, Automatic, Manual\n- Fully customizable 3D male & female avatars\n- 13 rackets with different characteristics to match with your style.\n- 6 incredible stadiums with different evolutive surfaces : clay, grass, hard...\n- 5 assists to help you to perform: service hit assist, position assist, ball trajectory correction, ...\n- Spectator mode\n\n~Realism~\n\n- Play with your ball before serving\n- 1 handed or 2 handed backhand ? That works!\n- Umpire and linesmen are present on the court to follow your matchs\n- Playing in a crowed out stadium is perfect for immersion!\n- AI is almost human thanks to all motion-captured animations in match.\n\n~Game modes~\n\n- Play against AI in 1vs1 with 4 difficulty levels\n- Bonus : choose if your opponent is left or right-handed\n- Play with your friend in singles (1vs1) or doubles (2vs2) online match\n- Find perfect opponents thanks to matchmaking feature\n- Prove your are the best thanks to the online championship\n- Improve your skills with 5 training modes.\n", "short_description": "The ultimate VR Tennis simulator. Play with your friends or worldwide competitors in 1vs1 and 2vs2 online mode. Or practice in match against AI and various exercices. Physics has been worked with top players to transpose real tennis in VR."}]}, "developer_name": "Fishing Cactus", "developer_privacy_policy_url": "https://www.tennisoncourtvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Decathlon", "support_website_url": null, "website_url": "https://www.tennisoncourtvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr_BE", "fr_CA", "fr", "de", "de_CH", "it", "ja", "ko", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "229649783190906"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2240139153172718"}, {"status": "PUBLISHED", "id": "1903076017091707"}, {"status": "PUBLISHED", "id": "592130886788327"}, {"status": "PUBLISHED", "id": "1392239571492673"}, {"status": "PUBLISHED", "
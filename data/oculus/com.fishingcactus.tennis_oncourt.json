": [{"file_name": "Screen1.png", "id": "974952803679312", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974593_974952807012645_2273420780151800961_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFOY8z6uE3UQ7kNvwFHBdLd&_nc_oc=Adr8Nfy7X0cedYZjRxm7lzkoxmrO7CePi1QxpbbFVSmwLJ4dQg6_6-SSgGWPstmN4DA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylmZ4bBibMNvHEdbYs6zy3W47JLRm3DZnSWUB4p_yVsQ&oe=69C7B2A5"}, {"file_name": "Screen2.png", "id": "740285451167381", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86597262_740285454500714_2441245165127717441_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcYOeZDscAkQ7kNvwFsHr0h&_nc_oc=Adp0No8D45lkRNgK1L14eZvrVhm6jlS9AjUOzP0HTfNIcKOjQTHxXVNf6lNgwTAm7oE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZUOeSejbHHFGdTk7Gd9M2fefQxHZDQUAWZxwTymWh1A&oe=69C7D431"}, {"file_name": "Screen3.png", "id": "749687596639291", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031616_749687599972624_8966126731538132281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Fv5ty5041UQ7kNvwEOiH8A&_nc_oc=AdoG0gvxeMemGiA_7OPCC6pdMEHCfuoGPp3qabyBvepDYHtz2OJT5H7feqA563RUJCI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwugqAeVPzRnimkZbdLa60HGGPq9Vksa00qFXEg2e9wAA&oe=69C7DE56"}, {"file_name": "Screen4.png", "id": "1244144979810089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974798_1244144983143422_1681704455242691437_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_ZD_5a85kAQ7kNvwE9CZsS&_nc_oc=AdqG64XHcRxm2cHyvNGKumUdU2r0HEiNk8iq1QrWe827rsurejBWlJbenL2MrNEq7Jw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbW6dUNOBF6LMp6Dk9dKWSkzugs0b2kWY9QQ-J6Bj6PA&oe=69C7D3C1"}, {"file_name": "Screen5.png", "id": "746407370603414", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031560_746407377270080_7049822999817787277_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UiAV2qyDGkQ7kNvwEqgYne&_nc_oc=AdrqBWm75gXCKddWas1yPjpRjOGMb6od4PHTGFvOF1dvxpIcKyi2syyfyODx1j1lsxQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6aMVupcTGFqp_-md_FJ9Z2qGpnCFWd9-xg4z2OBGb7w&oe=69C7D3B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "167636232574363", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38984448_167636235907696_6696061602154100125_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMZfXtGKCMwQ7kNvwFeJf3X&_nc_oc=AdoCd1Lr_4EdGyImQi6ysi8V5UDerlzHS93caw1hHhVdOAyiPXY8sndW_N9s5OmgKpE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPr0_h13z2kKXXQidikHpklHKGnCdR6n1wydFOlN3exQ&oe=69C7CF09"}, "display_name": "Tennis On-Court", "keywords": [], "long_description": "Tennis On-Court is the ultimate tennis simulator to discover!\n\nIt's not only a video game, it's real tennis thanks to the experience of Decathlon & Artengo engineers, working every day on the design of tennis equipment : rackets, balls, accessories, ... used by top players on the ATP & WTA tours.\n\nLift, slice, dropshot, retro, perform all those effects and feel like a real tennis player..\n\n~Foundations~\n\n- Gameplay : Arcade or Realistic, choose your side!\n- 3 different types of moving: Teleport, Automatic, Manual\n- Fully customizable 3D male & female avatars\n- 13 rackets with different characteristics to match with your style.\n- 6 incredible stadiums with different evolutive surfaces : clay, grass, hard...\n- 5 assists to help you to perform: service hit assist, position assist, ball trajectory correction, ...\n- Spectator mode\n\n~Realism~\n\n- Play with your ball before serving\n- 1 handed or 2 handed backhand ? That works!\n- Umpire and linesmen are present on the court to follow your matchs\n- Playing in a crowed out stadium is perfect for immersion!\n- AI is almost human thanks to all motion-captured animations in match.\n\n~Game modes~\n\n- Play against AI in 1vs1 with 4 difficulty levels\n- Bonus : choose if your opponent is left or right-handed\n- Play with your friend in singles (1vs1) or doubles (2vs2) online match\n- Find perfect opponents thanks to matchmaking feature\n- Prove your are the best thanks to the online championship\n- Improve your skills with 5 training modes.\n", "short_description": "The ultimate VR Tennis simulator. Play with your friends or worldwide competitors in 1vs1 and 2vs2 online mode. Or practice in match against AI and various exercices. Physics has been worked with top players to transpose real tennis in VR."}]}, "developer_name": "Fishing Cactus", "developer_privacy_policy_url": "https://www.tennisoncourtvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Decathlon", "support_website_url": null, "website_url": "https://www.tennisoncourtvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr_BE", "fr_CA", "fr", "de", "de_CH", "it", "ja", "ko", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "229649783190906"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2240139153172718"}, {"status": "PUBLISHED", "id": "1903076017091707"}, {"status": "PUBLISHED", "id": "592130886788327"}, {"status": "PUBLISHED", "id": "1392239571492673"}, {"status": "PUBLISHED", "
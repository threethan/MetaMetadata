HaAt4wPOcjYds866D4iDcvxMV3u3gA&oe=6AB66B5F"}, {"file_name": "ks_02.png", "id": "27239491242386756", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620856_27239491252386755_349893080488189736_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmCAbdds0HkQ7kNvwEf_qig&_nc_oc=AdoNo5CSI08E_qDazY321bYmkvBQDAPKaUaRMBvOwjZSSL-QlPHGrOAstZvaDB0kWts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp8DMXIegLZolfBORwFDFS0L-_iz5-oBQl3Q4mD4p63g&oe=6AB66A70"}, {"file_name": "ks_01.png", "id": "1534677498156270", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593869844_1534677501489603_8057008650805763528_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQvmDQkqAN0Q7kNvwFLc8KE&_nc_oc=Ado5bwv89TMJmchK3LUiQcFDgWauSZ5dVsc-BH7YVwsLnuRfOka7QNoiyPL50hQQNN0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSnq4F8l_1ADmZ4tOt-FUb3dpRTEM8gy5LGSx_QiSKIw&oe=6AB669FB"}, {"file_name": "ks_04.png", "id": "4427649347474961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620875_4427649354141627_1673645107448168791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqR0wlJISngQ7kNvwF6SBZZ&_nc_oc=AdoEvkNDU7Qmp9mNmyLTzuoIujVu8KYiR75gtV-BvUVn-LzYZHpnCxwDbBN_CGwY5Cg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmkUDAF6YjJMMzKokhQftuENPge5HiUTAJCmUuCfDNsQ&oe=6AB690A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kinetic Surge VR", "keywords": ["telekinesis", "shooter", "survival", "scifi", "arcade"], "long_description": "Unleash raw telekinetic power.\n\nIn Kinetic Surge VR you don't touch what you fight \u2014 you command it. Reach out, grip a floating object from across the dark arena, pull it to your hand, then flick to HURL it at the waves of hostile drones closing in. Two-handed: each hand seizes, holds, and throws on its own, so you can have two objects screaming through the void at once.\n\nSurvive the onslaught. Drones advance from the dark; smash them mid-air before they breach your energy core. Chain your kills for a x2 / x4 / x8 multiplier, ride the combo, and climb the leaderboard. Push your luck across Easy, Normal, and Hard as the swarm grows faster and thicker every wave.\n\nFEATURES\n\u2022 Telekinetic grab-and-throw combat \u2014 point, grip, pull, hurl\n\u2022 Dual-wield force \u2014 two hands, two objects in flight\n\u2022 Endless escalating drone waves with a combo multiplier\n\u2022 Three difficulty tiers + best-score progression and coins\n\u2022 A glowing, dark sci-fi arena built for standing-room VR\n\nNo motion sickness: you stand your ground and let the arena come to you.", "short_description": "Kinetic Surge VR is telekinesis-powered combat. Seize floating objects with a force grip and hurl them at escalating waves of hostile drones. Seize. Hurl. Survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kinetic-surge-privacy.pages.dev/", "developer_terms_of_service_url": null, "publisher_name": "NVR Labs", "support_website_url": null, "website_url": "https://kinetic-surge-website.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1273324252520624"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_27982480988003369_186997805177516128_n.png?stp=dst-png_s3
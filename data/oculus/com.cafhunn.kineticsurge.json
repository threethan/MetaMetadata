"1534677498156270", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593869844_1534677501489603_8057008650805763528_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYsgosCalXwQ7kNvwEGhKxx&_nc_oc=AdoBBN-37ZMtDO3f4YAzaNOyYAThHsu8w6oB41AYVRKMzXsOqtp5sZh6WRBTVcmAIV8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_AlTGhXRyxXIhcL__DMfzuOxvyURFUdxCM7K0QCaoSw&oe=6B10483B"}, {"file_name": "ks_04.png", "id": "4427649347474961", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620875_4427649354141627_1673645107448168791_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7njSYXAlYUQ7kNvwHXTiVH&_nc_oc=AdovCIgFP767mHKH9DJ3AkyhQZqeYtC0MPXT-8KjCEFNudBWnYkj2E57heimhjmvWc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUd2INED0ATYk2X6NCF_XJG_7p6A8llt6xo2VRCEz4nHg&oe=6B1036A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kinetic Surge VR", "keywords": ["telekinesis", "shooter", "survival", "scifi", "arcade"], "long_description": "Unleash raw telekinetic power.\n\nIn Kinetic Surge VR you don't touch what you fight \u2014 you command it. Reach out, grip a floating object from across the dark arena, pull it to your hand, then flick to HURL it at the waves of hostile drones closing in. Two-handed: each hand seizes, holds, and throws on its own, so you can have two objects screaming through the void at once.\n\nSurvive the onslaught. Drones advance from the dark; smash them mid-air before they breach your energy core. Chain your kills for a x2 / x4 / x8 multiplier, ride the combo, and climb the leaderboard. Push your luck across Easy, Normal, and Hard as the swarm grows faster and thicker every wave.\n\nFEATURES\n\u2022 Telekinetic grab-and-throw combat \u2014 point, grip, pull, hurl\n\u2022 Dual-wield force \u2014 two hands, two objects in flight\n\u2022 Endless escalating drone waves with a combo multiplier\n\u2022 Three difficulty tiers + best-score progression and coins\n\u2022 A glowing, dark sci-fi arena built for standing-room VR\n\nNo motion sickness: you stand your ground and let the arena come to you.", "short_description": "Kinetic Surge VR is telekinesis-powered combat. Seize floating objects with a force grip and hurl them at escalating waves of hostile drones. Seize. Hurl. Survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kinetic-surge-privacy.pages.dev/", "developer_terms_of_service_url": null, "publisher_name": "NVR Labs", "support_website_url": null, "website_url": "https://kinetic-surge-website.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1273324252520624"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1267180146468368", "version": "1.0.0"}, "id": "1172363685074101", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1267073486479034", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id
=1-7&_nc_sid=6e7a0a&_nc_ohc=ujbEG9Uks90Q7kNvwFJFD4-&_nc_oc=AdrPbzs4_4aSwf42XGrtFhsjM21MTDN4iRzk6wuFQGy-If6fPfglCk1-UFiZqacX88M&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdHsaqokFzr5H-xHWaZtXYSlFQc7xIOBaMO4u4KGsQcA&oe=6AFC831F"}, {"file_name": "ks_02.png", "id": "27239491242386756", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620856_27239491252386755_349893080488189736_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Blq8EoDkRiUQ7kNvwGKnIkl&_nc_oc=AdqrU82KGvC9c7zMC40U82-Y_P1R-TXQyhCnlgrQKPdRpTe8Oc4XlC3LN-JGF0wuET8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpFzCEVgVWzJG356PHchX_BdG0idCC3CZeR9p45iDkpw&oe=6AFC8230"}, {"file_name": "ks_01.png", "id": "1534677498156270", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593869844_1534677501489603_8057008650805763528_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHjQ0VQWxyQQ7kNvwHReZq1&_nc_oc=Adqy074ttzhW-mmVKyzDG2KID6eGbly4VSfZIIpWPF-BD8vvMLy3CjaOHZfGkh7qyLo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDZ5rvYCStBNCo0ZxJipf3Im8gbNiddwb7o6eHKLG_CQ&oe=6AFC81BB"}, {"file_name": "ks_04.png", "id": "4427649347474961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620875_4427649354141627_1673645107448168791_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UBTlRrU4nsQ7kNvwH7LnES&_nc_oc=AdqNx8gTT8UwFTfEMRHSt0T_L6r6nB_YVQlF_eT5wgbStVGSuB-7DigwYHybmXfJhKY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNUcJK5GZExpcnBBxGcs2sjqMUAW8az8VtjMGsPTEjkA&oe=6AFC7027"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kinetic Surge VR", "keywords": ["telekinesis", "shooter", "survival", "scifi", "arcade"], "long_description": "Unleash raw telekinetic power.\n\nIn Kinetic Surge VR you don't touch what you fight \u2014 you command it. Reach out, grip a floating object from across the dark arena, pull it to your hand, then flick to HURL it at the waves of hostile drones closing in. Two-handed: each hand seizes, holds, and throws on its own, so you can have two objects screaming through the void at once.\n\nSurvive the onslaught. Drones advance from the dark; smash them mid-air before they breach your energy core. Chain your kills for a x2 / x4 / x8 multiplier, ride the combo, and climb the leaderboard. Push your luck across Easy, Normal, and Hard as the swarm grows faster and thicker every wave.\n\nFEATURES\n\u2022 Telekinetic grab-and-throw combat \u2014 point, grip, pull, hurl\n\u2022 Dual-wield force \u2014 two hands, two objects in flight\n\u2022 Endless escalating drone waves with a combo multiplier\n\u2022 Three difficulty tiers + best-score progression and coins\n\u2022 A glowing, dark sci-fi arena built for standing-room VR\n\nNo motion sickness: you stand your ground and let the arena come to you.", "short_description": "Kinetic Surge VR is telekinesis-powered combat. Seize floating objects with a force grip and hurl them at escalating waves of hostile drones. Seize. Hurl. Survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kinetic-surge-privacy.pages.dev/", "developer_terms_of_service_url": null, "publisher_name": "NVR Labs", "support_website_url": null, "website_url": "https://kinetic-surge-website.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SIT
Q&oe=6A8EE091"}, {"file_name": "Screenshot 6.png", "id": "516561027925567", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974741_516561031258900_9140847307847813781_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xn40fcp_AQ0Q7kNvwF_bVDB&_nc_oc=AdoEQ7fWBzvVQ4llWy3Wp9FlWtP2InPnxqQyfP5UTfx23dV9OUaZa06jSiymLKKYBSM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtB_NnK3mA2hE95XJFR1QKbwWegg10cB1J-V9jpVacKQ&oe=6A8ECFCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440 N.png", "id": "1467589350585957", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982568_1467589353919290_4469202523836510644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1BtjallcaUQ7kNvwHONveq&_nc_oc=Adpj5FFbFVUbsRAD6ddvZ_VDkOC1VnckNgfDA4UuCMQ2lOTJorNNLKXcleHbKF8VBRk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIfprJCNL48UVUgKitPwvEZz4h_yjJzf6rhXw419RFUQ&oe=6A8ECC43"}, "display_name": "Beat Box VR", "keywords": ["BeatBox", "rhythm", "Music", "Boxing"], "long_description": "BeatBox is a VR game designed to help players release stress and manage their emotions. By immersing players in a rhythmic environment where they can punch, smash, and interact with objects to a pulsating beat, the game provides a therapeutic outlet for anger and frustration. The combination of physical movement and engaging visuals helps nervous players feel more relaxed and alleviates tension, offering a fun and effective way to unwind.", "short_description": "A VR rhythm game where players punch their way through music tracks, combining the excitement of beatboxing with intense boxing movements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raforelabs.wixsite.com/ra-forgelabs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ra-Forge Labs", "support_website_url": null, "website_url": "https://raforelabs.wixsite.com/ra-forgelabs/beatbox-vr", "category": null, "comfort_rating": "CO
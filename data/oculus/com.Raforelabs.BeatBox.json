content-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRi308Qnvqj6ELquUa0qqKiBDMtKdzRknoLnhIDlXXFg&oe=6B030883"}, "display_name": "Beat Box VR", "keywords": ["BeatBox", "rhythm", "Music", "Boxing"], "long_description": "BeatBox is a VR game designed to help players release stress and manage their emotions. By immersing players in a rhythmic environment where they can punch, smash, and interact with objects to a pulsating beat, the game provides a therapeutic outlet for anger and frustration. The combination of physical movement and engaging visuals helps nervous players feel more relaxed and alleviates tension, offering a fun and effective way to unwind.", "short_description": "A VR rhythm game where players punch their way through music tracks, combining the excitement of beatboxing with intense boxing movements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raforelabs.wixsite.com/ra-forgelabs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ra-Forge Labs", "support_website_url": null, "website_url": "https://raforelabs.wixsite.com/ra-forgelabs/beatbox-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9713310935349668"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982683_37757604793305
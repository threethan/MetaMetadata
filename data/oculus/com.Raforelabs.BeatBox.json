v/t64.5771-25/38974741_516561031258900_9140847307847813781_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7SYuRPtOKYQ7kNvwF8r46e&_nc_oc=AdnVcEyTEm9f14-7wjwsHyZq7ah5ovgHhWcwERyQlDmIbDQoCpcR1VySQZYdp160HMI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxmf_XVdj-c1CPtrqmqrKiEmDunymc7ovAB0YwGuXO4ig&oe=69AC0DCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440 N.png", "id": "1467589350585957", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982568_1467589353919290_4469202523836510644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5odgXUui9jcQ7kNvwF70JbS&_nc_oc=AdmAX0Vl4duV732gUIHYF0bMqnqO6DBHml7tjbEyRD_5-PeaA_XeQx94fsyNSvgPNIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxXIxzrZTYys5IMDOHLdDNZnrwDFDxF7GgM5tHU4eGC_g&oe=69AC0A43"}, "display_name": "Beat Box VR", "keywords": ["BeatBox", "rhythm", "Music", "Boxing"], "long_description": "BeatBox is a VR game designed to help players release stress and manage their emotions. By immersing players in a rhythmic environment where they can punch, smash, and interact with objects to a pulsating beat, the game provides a therapeutic outlet for anger and frustration. The combination of physical movement and engaging visuals helps nervous players feel more relaxed and alleviates tension, offering a fun and effective way to unwind.", "short_description": "A VR rhythm game where players punch their way through music tracks, combining the excitement of beatboxing with intense boxing movements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raforelabs.wixsite.com/ra-forgelabs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ra-Forge Labs", "support_website_url": null, "website_url": "https://raforelabs.wixsite.com/ra-forgelabs/beatbox-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topic
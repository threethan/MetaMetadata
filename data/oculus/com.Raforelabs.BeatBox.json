ontent-iad3-1.oculuscdn.com&oh=00_AfuL9tyi4tXOZSvPF2zjDQoNl8TR7HZBEN7CODMqJ73JFQ&oe=69A0304A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440 N.png", "id": "1467589350585957", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982568_1467589353919290_4469202523836510644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP3wQPsB494Q7kNvwFvLfvN&_nc_oc=Adloni__dgWUpsukSEXnkjYxCfoETip40Ts5-uDdAtnLgzr3dBgG0slTZqKpns3eL88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs8L8nfAi-7myy-NQjtcjDcvsAAXBXe53pfib00H2bzCQ&oe=69A02CC3"}, "display_name": "Beat Box VR", "keywords": ["BeatBox", "rhythm", "Music", "Boxing"], "long_description": "BeatBox is a VR game designed to help players release stress and manage their emotions. By immersing players in a rhythmic environment where they can punch, smash, and interact with objects to a pulsating beat, the game provides a therapeutic outlet for anger and frustration. The combination of physical movement and engaging visuals helps nervous players feel more relaxed and alleviates tension, offering a fun and effective way to unwind.", "short_description": "A VR rhythm game where players punch their way through music tracks, combining the excitement of beatboxing with intense boxing movements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raforelabs.wixsite.com/ra-forgelabs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ra-Forge Labs", "support_website_url": null, "website_url": "https://raforelabs.wixsite.com/ra-forgelabs/beatbox-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "r
n of physical movement and engaging visuals helps nervous players feel more relaxed and alleviates tension, offering a fun and effective way to unwind.", "short_description": "A VR rhythm game where players punch their way through music tracks, combining the excitement of beatboxing with intense boxing movements."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raforelabs.wixsite.com/ra-forgelabs/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ra-Forge Labs", "support_website_url": null, "website_url": "https://raforelabs.wixsite.com/ra-forgelabs/beatbox-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9713310935349668"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982683_3775760479330516_8289013514381719654_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_823UcewjUQ7kNvwH2GsbW&_nc_oc=AdmTLAvKj35k99eKDEXwBxL636HcMw0OC9blJzi9yT6P36iIn1r3TirVAV59xNKF4qk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsGVVc8TUYSEHs8jk0XMnxLIDluipiV7NQwL2OJFJrsEw&oe=69A05466"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beat Box VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274332603592553
=6e7a0a&_nc_ohc=vViPJVclpaAQ7kNvwGnQrHl&_nc_oc=Adq1yCOVKc1jduh0Q225d3EV3xrMT0hXXf7a843eoOu53GJNjiOM_Gu-vT57UPf57q0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBgWiDJSGwzTAWf_Hj2zjy8PHr9b8G_5RtfWAch5hOww&oe=6AFDB83D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Mage Cover.png", "id": "526846767112815", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391915_526846773779481_6373519753517243101_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_IET0Wdmc0Q7kNvwFQgae8&_nc_oc=AdpvhIeoWwDAcqLdOCtAf-KddUUxGTv2232aE69H_69gLoFOJG6-65TsizbJsTXrXxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRq9nYW31FyygdlyCJSH0C_xtYlSaQiX780wTZYVcpARQ&oe=6AFDB59A"}, "display_name": "MAGE", "keywords": ["magic", "physics", "flying", "time", "superhero"], "long_description": "# Unleash Explosive Magic\n\nUnleash the power of magic and bend space and time like never before in MAGE! Master 12 powerful spells (with more to come) and create explosive combos by dual-wielding magic. Fly through dynamic magical chaos with intuitive aerial controls, experiencing breathtaking 120FPS visuals with stunning VFX.\n\n{1339057120552530}\n\n# Control Time Itself\n\nTake control of time itself: slow it down, stop it, or even reverse its flow whenever you please. \n\n{955194030067095}\n\n# Experience Epic Physics\n\nDive into massive, high-intensity physics simulations with hundreds of props, with zero lag or loading screens, all powered by a custom engine with custom physics, purpose built for Meta Quest 3 and Meta Quest 3S. \n\n{1578021393588697}\n\nEmbark on your magical journey today.", "short_description": "Unleash magic and bend space and time in MAGE! Master 12 powerful spells (more to come) and create explosive combos with dual-wielding magic. Control time - slow it, stop it, or reverse it at will. Soar through dynamic chaos with intuitive aerial controls and enjoy stunning 120FPS visuals. Engage in high-intensity physics with hundreds of interactive props, all powered by a custom-built engine for Quest 3/3S. Embark on your magical journey today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mage-vr.com/privacy/", "developer_terms_of_service_url": "https://mage-vr.com/terms/", "publisher_name": "Charlie Shenton", "support_website_url": null, "website_url": "https://mage-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28813251404955081"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1593437308713927"}]}, "baseline_offer": {"id": "1593437308713927"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741747500, "status": "PUBLISHED", "id": "1593437308713927"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28970698342543719", "version": "0.2.32"}, "id": "657184576817457", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28813251371621751", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28970698342543719"}, "release_status": "RELE
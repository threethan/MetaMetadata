lriFjAbiF3FO3GIzXdQG4EQ5OrwD9xOA1T0Y-yI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOp_GLMTWDspNGon-DdkhnD728ofopbi476Ak6Y0ipNXw&oe=6AD22FF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VersX.png", "id": "905403181768105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035377_905403185101438_6180565823629151945_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUWOWi6ZqBwQ7kNvwFehVoG&_nc_oc=AdoY_ZuJfGrxu1qBuO9hP4P4bZFvxgN29e-eQH8FNpIUv8mU0EwFnZ7CokaHaVsetTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_VdH1LQn00_NwFLwACBQKyZ-l66rB5Ncq67itt8ee6w&oe=6AD236A0"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "\nJump into the magic world of Selinas mind and master tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!\n\n{462054049934411}\n{3846354725676153}\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\n\n{1270178880992449}\n\n{469944256054407}\n\n\n\n\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective into the mind of a child. Are you prepared to help Selina and push back against the sinister Aniles and her shadows?\n\n\n{1955927098148751}\n\n{655503446907375}\n\u201cSelina: Mind at Large attempts one of the most challenging tasks a game can achieve: transporting you into the shoes of a child. ... you return to feeling like a child yourself, in wonder for the gravity-changing hijinks that ensue, and the personal struggles underneath.. Isn\u2019t that what we want in games?\u201d - UploadVR\n\n{1358786278632654}\n\n\n\n\n", "short_description": "Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selinavr.com/selina-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trotzkind GmbH", "support_website_url": "https://www.selinavr.com/", "website_url": "https://www.selinavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "pt_BR", "zh_CN", "ja", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29448241418157985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001676_2233461320362684_788008089222440850_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmmRzRTDnQMQ7kNvwFSdaNB&_nc_oc=Adqvb80SI--S2_DiAzjo0ZYIFSFnq7i5Ca1KCn4fzu5bfD47gHUHtWquhdab5RvMZ-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXfMXOK1UXrmSLXknG4wdsSlyo0NwLgbafvGHUQJJIsQ&oe=6AD24A66"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Selina: Mind at Large", "platform": "ANDROID_
ttps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391934_2332433587219826_3583268111283018752_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9nsE4K0b_sQ7kNvwFrysHI&_nc_oc=AdpqeNX-uqfCw-wWMNTYasgUQUAQwaPSjcMr6wjAxNvMS6mQA5LQgWh7gWeNkyeqoOk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUqrofc1WSkhvGPNWwiqoRD4HR79Yz1hSmxZgR-E_GBQ&oe=6AA2AAB0"}, {"file_name": "1.3_PuzzleLevel_028.png", "id": "1836994227070784", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391911_1836994230404117_1890935279929871499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8RwznnpqlsQ7kNvwG2OZUb&_nc_oc=AdpWJWAgmp0WvYD_A8VzYEbiPxazgn67C6ubseQuq0i5ZCO8naKvodtdYyrhx46iMSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvnYacEeTeQMqt51ZviCY_qPT6SzMTza3S_eW1wYLOBw&oe=6AA2C9C7"}, {"file_name": "2.1_PuzzleLevel_023.png", "id": "980481747324553", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391934_980481753991219_471152226523097550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wlw4mJ9dYYYQ7kNvwEqaC0V&_nc_oc=AdohpKI5F8tMNvkPmec7KYGdGjNAErenlOGVy3kgMc9UG7rK4OFr5_OFPyz-uSwQDfQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnv7OWdXbgbgNXzrnUSnPwcyCv97OddlURKVehngIrQg&oe=6AA2BE66"}, {"file_name": "2.2_PuzzleLevel_005.png", "id": "629250039801395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_629250043134728_2118689073029424993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-U2NtXHf7cQ7kNvwE-r8Lh&_nc_oc=AdpVT4RP-Fng_hlP90YS2BIrJgZrZGnw42TzM49sIo-M5SNY9dDwObRNQs8FZhyp-XE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxknXKD3bRvwtnQdY_VNgl7yU7dss3PGlO-iZKBuCw5A&oe=6AA2ADD2"}, {"file_name": "2.3_PuzzleLevel_010_Vers3.png", "id": "640340928639659", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_640340931972992_938618552754180062_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUZh0CmvlbAQ7kNvwGLBN0-&_nc_oc=AdrK7J-LCNQ7w71CHoav06npnazGxfWAHlpmuoGunL_HmANeGdbYPZp0x4QRNyl5Hao&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUMwkLLd5Z6PlLJCJ0VOwPCpe4gglidkSL3LueKOkVGg&oe=6AA2B9F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VersX.png", "id": "905403181768105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035377_905403185101438_6180565823629151945_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVKUI8DH2cwQ7kNvwEZ_181&_nc_oc=Adp_0yUPwtpkcbyTgIUsI9q_qH77mKdNyQwwypaqao25so9-qiR_zLwjI1nQ76husTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYgFU1NVusXyIDa73UYc_R8_jhGEHew8SZMUyS_oLwRw&oe=6AA2C0A0"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "\nJump into the magic world of Selinas mind and master tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!\n\n{462054049934411}\n{3846354725676153}\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\n\n{1270178880992449}\n\n{469944256054407}\n\n\n\n\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective into the mind of a child. Are you prepared to help Selina and push back against the sinister Aniles and her shadows?\n\n\n{1955927098148751}\n\n{655503446907375}\n\u201cSelina: Mind at Large attempts one of the most challenging tasks a game can achieve: transporting you into the shoes of a child. ... you return to feeling like a child yourself, in wonder for the gravity-changing hijinks that ensue, and the personal struggles underneath.. Isn\u2019t that what we want in games?\u201d - UploadVR\n\n{1358786278632654}\n\n\n\n\n", "short_description": "Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selinavr.com/selina-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trotzkind GmbH", "support_website_url": "https://www.selinavr.com/", "website_url": "https://www.selinavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "pt_BR", "zh_CN", "ja", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29448241418157985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001676_2233461320362684_788008089222440850_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFmJCINwG6gQ7kNvwEt5rqh&_nc_oc=AdqPa6WzhxD8ZJQv1YhH6NlAzpS2FTc1V1uyf7Ev8zmCsGQm5j0fK9QspRZCKCm-N54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5ipBBISHYXk51Cz5G4O7Cx4zkDWxdXo8e-7JW8uw1ag&oe=6AA29C26"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Selina: Mind at Large", "platform": "ANDROID_
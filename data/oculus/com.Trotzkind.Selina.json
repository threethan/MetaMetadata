9670716_3050581873978924803_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG54jvQCeEEQ7kNvwH23sx4&_nc_oc=AdpuJkDKqON5W8nGCWPm974_Gq2_Y1ov1A37R0WUe_go_OMORif6MDaGNxXQAuczNEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVVH_AmCwZ_ArxaOfWmqT3TAU930-wQEkxr_z4KdW22Cg&oe=6B0F0230"}, {"file_name": "MusicBoxScreenshotWQHD.png", "id": "1039420814346092", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982687_1039420817679425_4204423075002585589_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBzO0uubyGsQ7kNvwGmTtRz&_nc_oc=AdpPG_klyEzv5Hss14urznr8oikZNjLcbrhdtsd0uP0WvB4WHW8qeTMuQZbTOMS6epE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWIEmCXOXW41uHS2yUD1DFdqUT1xYaYim4otquLpOvLeg&oe=6B0EF135"}, {"file_name": "AnilesCastleScreenshotWQHD.png", "id": "856820209950979", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_856820213284312_3619574751106088437_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8iiK-pNh3QQ7kNvwEdzL6B&_nc_oc=AdpMhPAH7Z4c83cxZIWUb_liWSwNNYqLLXk8zqnUMD1c0CCnehC2jmg1QcrZcHGRGCs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZtG8lccVpo1YEC2RTZSa5w0VcWyasiKAuKzhm1Q62aw&oe=6B0EF433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Selina_StoreCover.png", "id": "8727096237314676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001684_8727096250648008_2208213057538106781_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNJ77z3yWEMQ7kNvwFIr1An&_nc_oc=Adppu6lfxME7JaXbUDrBZYhJud9SrpDy0q5f0R51a3b1138TipR2TGA_Dq4yv9SL8YE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUcqdrOIIgDpQ6NrRi1mfiSHYSbH86x2UTC4xArgiu-Fg&oe=6B0F0BA5"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "Dive right into this mindbending adventure! The young girl Selina seeks the help of a brave hero to travel into her mind and restore her memories. Are you prepared to push back against the sinister Aniles and her shadows?\n\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective on the mind of a child. Step into the shoes of a brave and clever hero in this narrative puzzle adventure.\n\n Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!\n", "short_description": "Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selinavr.com/selina-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trotzkind GmbH", "support_website_url": "https://www.selinavr.com/", "website_url": "https://www.selinavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
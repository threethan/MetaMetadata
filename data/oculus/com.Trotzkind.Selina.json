9670716_3050581873978924803_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0FCML88DIkQ7kNvwHMFzsW&_nc_oc=Adp5WCs8Po1cdhIziMlyII_trDm47kYDl1K2nf3Fnb8xfCaimMG2yyOYdrvVk-k6NQU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTq4kNbxETGVKnBFQP4pJinJwB8biU9Vl5WBzQBUTxe8A&oe=6B0B0DB0"}, {"file_name": "MusicBoxScreenshotWQHD.png", "id": "1039420814346092", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982687_1039420817679425_4204423075002585589_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Px23G0FWdAQQ7kNvwGEzVDA&_nc_oc=Adq15XhT2o9e7gSVcxkxGZfDD2qG8KdnqQbr4gvBv1eS6GKpCFqxvx2kWdJ6vuenXZA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6vCdgcm7rUL4aM8SWIhJO8WuQMPRb_13DFN_6KtoPew&oe=6B0B34F5"}, {"file_name": "AnilesCastleScreenshotWQHD.png", "id": "856820209950979", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974733_856820213284312_3619574751106088437_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zL75zXQrbiUQ7kNvwFDHQ5p&_nc_oc=AdoL9l01kAABh5_UPfkcEVD0-I_vEuvdlNkqsLw53RlwWV02J_1MC26LKC6-Pb3uN0U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZcLzblLQvzwAVrw8hAz6Ux078tZ7jR9KF3P3BBV7GMA&oe=6B0B37F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Selina_StoreCover.png", "id": "8727096237314676", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001684_8727096250648008_2208213057538106781_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnG9Z2rlWo8Q7kNvwGFESeD&_nc_oc=AdrsrNjSZ99Xkk5qjm0fv2PZLn7hFhUyVe5Svl1nUBef9SAbjohPH7d-VMqsuCE7LgI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSh0pTXCcmwqUgzK2TRt8vxL5f4LJyJQRjEyOCDFYObaw&oe=6B0B1725"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "Dive right into this mindbending adventure! The young girl Selina seeks the help of a brave hero to travel into her mind and restore her memories. Are you prepared to push back against the sinister Aniles and her shadows?\n\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective on the mind of a child. Step into the shoes of a brave and clever hero in this narrative puzzle adventure.\n\n Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!\n", "short_description": "Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selinavr.com/selina-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trotzkind GmbH", "support_website_url": "https://www.selinavr.com/", "website_url": "https://www.selinavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
9670716_3050581873978924803_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAmqiDljLU4Q7kNvwE8n8lR&_nc_oc=AdoUvFLeCkyo7GsntEd6Kxu_U-8oJGdLdgRufPZXjUEu13niapscG8MtFCIlXCTqy3Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQlPJgCt0w5hyyRmNuVFslDVVFqYb9mACnez6RSv-uxQ&oe=6AFF3030"}, {"file_name": "MusicBoxScreenshotWQHD.png", "id": "1039420814346092", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982687_1039420817679425_4204423075002585589_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rolx2PPJbDUQ7kNvwEQMEbF&_nc_oc=Adr4P1zz_Zpn2U8QOzFMj0jjbFLdnKyr4MbUab41FRgsp7d7xRCF7l7fOwO8bIgxMeE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYZQr0RiD-C4NOAHQ_Ri3ePgQulT5DjXWAKzyyeYoGaA&oe=6AFF1F35"}, {"file_name": "AnilesCastleScreenshotWQHD.png", "id": "856820209950979", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974733_856820213284312_3619574751106088437_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ7gyLA6M1sQ7kNvwFo3gKM&_nc_oc=AdriSV8VGRJcJEMRzXHRIivUZfjaxubGuhzz2wnVqA8bO9ZWIGntegF14e-YU2pbUr0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZRvpIZtKsfobteAhrJ0kIBXEMePZHCmLR5eNjyHr6PA&oe=6AFF2233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Selina_StoreCover.png", "id": "8727096237314676", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001684_8727096250648008_2208213057538106781_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLD-wHKbe4YQ7kNvwGUuvEf&_nc_oc=AdpjnPuS7tXwQ-XeCICjYDOXid6RLYLuYguFMD5LKEV04GXu-PHkBSqpNsOJrr6NVYA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Irs9sPAoVXqMBdbOFJwKGxs6cLwT6SWRuN1Dhj1Bjg&oe=6AFF0165"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "Dive right into this mindbending adventure! The young girl Selina seeks the help of a brave hero to travel into her mind and restore her memories. Are you prepared to push back against the sinister Aniles and her shadows?\n\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective on the mind of a child. Step into the shoes of a brave and clever hero in this narrative puzzle adventure.\n\n Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!\n", "short_description": "Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selinavr.com/selina-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trotzkind GmbH", "support_website_url": "https://www.selinavr.com/", "website_url": "https://www.selinavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
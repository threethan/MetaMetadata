ttps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_2332433587219826_3583268111283018752_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7aYSXBMfmQQ7kNvwFSpwTZ&_nc_oc=AdqJwbHkMUOJd4IZRjyp6ymtjC1bYmgTpdvwdVOU-wIZ4MvuA0d30tL0DS9fA5DXOh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YSrz756Hw2JOE4-MvP_5LEStEziYGmQPKvBZLXNbadw&oe=69D8F530"}, {"file_name": "1.3_PuzzleLevel_028.png", "id": "1836994227070784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_1836994230404117_1890935279929871499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyXdVuno_B4Q7kNvwHGd0Gh&_nc_oc=Adq0QrRGwgytWD_h-MV6T2X6_MzcrqVAuk8A7N3K2KHMPaA0IozNCFhkDB8PI4xFT74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DknSj-O6dnnAi0kYia87rFIn8Tp1oNbTieUFxe6yDLA&oe=69D8DC07"}, {"file_name": "2.1_PuzzleLevel_023.png", "id": "980481747324553", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_980481753991219_471152226523097550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8I9CPhudANcQ7kNvwH8W-m7&_nc_oc=Adpi8N29yDhvUJtrC1vMGZk9GcDVnqZMOy2g8-9nBpv1AZfsHnrmMODHnz5G2wsegLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Lnkphy2QO1-oYY1bZtqL8gucwUFP-9YJULZmU_FHuZA&oe=69D908E6"}, {"file_name": "2.2_PuzzleLevel_005.png", "id": "629250039801395", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392016_629250043134728_2118689073029424993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kZE_QvsFTMQ7kNvwFvUCUH&_nc_oc=Adp3t9m90h8E7fFNzFN9mFsXdD6tw8K_zWfxt2n2_o2LenWWYW3RYoR5Gf1NKjOtCVs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1D85fiqcqK1OWrYZ5aQx70d8k23dinkSHAX_GWvM9g8A&oe=69D8F852"}, {"file_name": "2.3_PuzzleLevel_010_Vers3.png", "id": "640340928639659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392016_640340931972992_938618552754180062_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q10PdhSY9AQ7kNvwHv_Srp&_nc_oc=Adr7KOMyo4nuUMM3iojMArLxAz0kW3JM5ItcpM18p1ZONIi89UfNbZqaqb-bYIu6vIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wFP2VJbnu0RU2Y2g3cfTaVpesVxnOax6cVD1p3aAJEg&oe=69D90475"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VersX.png", "id": "905403181768105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035377_905403185101438_6180565823629151945_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOyV5MYAbaMQ7kNvwH9V_cB&_nc_oc=AdpBZcC2t38zouk9E7-wpvoNqXKhCmbRGE87yQ7fsRZHrqRILkPCIUmrfpZSLQZDY7M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gD8v6Ls7E_5Ay8iuknm_4A_PetX9zfF9raQ31hmDULg&oe=69D90B20"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "\nJump into the magic world of Selinas mind and master tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!\n\n{462054049934411}\n{3846354725676153}\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\n\n{1270178880992449}\n\n{469944256054407}\n\n\n\n\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective into the mind of a child. Are you prepared to help Selina and push back against the sinister Aniles and her shadows?\n\n\n{1955927098148751}\n\n{655503446907375}\n\u201cSelina: Mind at Large attempts one of the most challenging tasks a game can achieve: transporting you into the shoes of a child. ... you return to feeling like a child yourself, in wonder for the gravity-changing hijinks that ensue, and the personal struggles underneath.. Isn\u2019t that what we want in games?\u201d - UploadVR\n\n{1358786278632654}\n\n\n\n\n", "short_description": "Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selinavr.com/selina-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trotzkind GmbH", "support_website_url": "https://www.selinavr.com/", "website_url": "https://www.selinavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "pt_BR", "zh_CN", "ja", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29448241418157985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001676_2233461320362684_788008089222440850_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irAmvWEXhfQQ7kNvwGiDSoK&_nc_oc=AdrlSyibGseyqPSdSirqssGa8ipG4-UxGUB7YYzCpIbWf-DW_DEUxHpgSZVB0uUOYtc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2izrSwBslOV8y8z-0WvxarJomrJ3ebbK_OWyVHGX-uTQ&oe=69D8E6A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Selina: Mind at Large", "platform": "ANDROID_
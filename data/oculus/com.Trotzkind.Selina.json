ttps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_2332433587219826_3583268111283018752_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3LwvX_MMBIQ7kNvwGe_7CY&_nc_oc=Adq_y9zqN5mDrP0dKTt_3dJOCT-vj-RASyj6EpnHxK-cEWx2px_FKiEco5qnuVcjId4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MaPJcMJLGF1wQ2GdtM3mZgKCBLpeCMYmBOIzhwcaaoA&oe=6A1D8330"}, {"file_name": "1.3_PuzzleLevel_028.png", "id": "1836994227070784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391911_1836994230404117_1890935279929871499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uio5x9Dh0PAQ7kNvwFaptmE&_nc_oc=AdqfmQ1KLF9mkJ19FeoyuQFFnHZxx5J4IBUp3Cd_L573mzxZJv6wymOXd_fTPINkJrA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZD3wv47xLpFzb1GzS88n3of6hyot9vX8VtFtQmVuY-g&oe=6A1DA247"}, {"file_name": "2.1_PuzzleLevel_023.png", "id": "980481747324553", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_980481753991219_471152226523097550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-CPUmm1kLQQ7kNvwFhsYVa&_nc_oc=AdpUduFy3MlDCPOXjPTAitOLQfmxVW4sRF3FRzLsg0CjurTSECLvGobySHPxlu3DmEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MmKpW9TYCtt2MeBVzAA2btKftJ08MhS-3N7i_YO3G1g&oe=6A1D96E6"}, {"file_name": "2.2_PuzzleLevel_005.png", "id": "629250039801395", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392016_629250043134728_2118689073029424993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOUm1icuKDYQ7kNvwEPouIA&_nc_oc=AdoemINmgil_gZTqVsGZDRkoU0eLkmESK-XGICZp7pyAhLGHKnke-wgc-hq3RXcW-m4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UkBr_te7QQEY1nmPQ554Phh8aATlK4xDPttMmewNo6A&oe=6A1D8652"}, {"file_name": "2.3_PuzzleLevel_010_Vers3.png", "id": "640340928639659", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_640340931972992_938618552754180062_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ht3hpUZsUw8Q7kNvwFyjQvR&_nc_oc=Adpf_FofOEHg-1H6fuBdhmILwEpWG4nILxh7YVNw-3VBy1tB9CYm5wKvedgw_lD78A4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XJwjAjhCsHhmtfoRLeoNRoWrTzEhE9axZ7O2oGYbDbg&oe=6A1D9275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VersX.png", "id": "905403181768105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035377_905403185101438_6180565823629151945_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8xYavqDtCEQ7kNvwFQcos5&_nc_oc=Adom0EgtvBgc24FxDCypJFqhDFuguhDadK7gOvOnjF_QI0TlO0MA_j50QvGhW3__zhY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JnCaqeoIHilt28mg4Vp_ahb0aZJJuy-aVemb3oOtwog&oe=6A1D9920"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "\nJump into the magic world of Selinas mind and master tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!\n\n{462054049934411}\n{3846354725676153}\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\n\n{1270178880992449}\n\n{469944256054407}\n\n\n\n\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective into the mind of a child. Are you prepared to help Selina and push back against the sinister Aniles and her shadows?\n\n\n{1955927098148751}\n\n{655503446907375}\n\u201cSelina: Mind at Large attempts one of the most challenging tasks a game can achieve: transporting you into the shoes of a child. ... you return to feeling like a child yourself, in wonder for the gravity-changing hijinks that ensue, and the personal struggles underneath.. Isn\u2019t that what we want in games?\u201d - UploadVR\n\n{1358786278632654}\n\n\n\n\n", "short_description": "Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selinavr.com/selina-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trotzkind GmbH", "support_website_url": "https://www.selinavr.com/", "website_url": "https://www.selinavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "pt_BR", "zh_CN", "ja", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29448241418157985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001676_2233461320362684_788008089222440850_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuHt24ckQ9gQ7kNvwHb0a4Q&_nc_oc=Adp_s0pcB7aPNMfdJ_E1vV2cysrD8RwD9W1vb4CAsDo6vhZwDYbAchLQVvIx3pXBGWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uWExll7WsI85RHzEsOyNKR_akbPb2slggt7CumwOWZw&oe=6A1DACE6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Selina: Mind at Large", "platform": "ANDROID_
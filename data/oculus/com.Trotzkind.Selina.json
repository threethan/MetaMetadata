73391934_2332433587219826_3583268111283018752_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xiuwVE9mFoQ7kNvwGHmY7o&_nc_oc=AdlcjArpXMvTVa_hr6TMTL75GCzJCDPtvH25dlOwDzlHkjUU5p0VqCnygVwXlX_zhRg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyivGwsOhAgzyOsxcPL7QdUcsAVcAuKgBrEYZ3TykmDeA&oe=69BE9730"}, {"file_name": "1.3_PuzzleLevel_028.png", "id": "1836994227070784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391911_1836994230404117_1890935279929871499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eG8GlgyzbRoQ7kNvwF5Nk2v&_nc_oc=Adlm9a9av0W65jdIiKwGoEr8zF-IodzSkBO0SWW8odqNnBqJUtlTiVPu1d6XKbNDaq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqwcudbMChyLVPEzRvSjkgGsQPruV4faKf3Wz-IrzF1w&oe=69BE7E07"}, {"file_name": "2.1_PuzzleLevel_023.png", "id": "980481747324553", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391934_980481753991219_471152226523097550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsP__0xs0XUQ7kNvwE-uK-E&_nc_oc=AdkB9j17Bw2Q2zPuQgDAfUpWjHVB7UFq2prsf2aXCK3EpLvRwLwBI4JsTiFLI50eFV8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVvHOn_l3xl8OZiZwfDVhDOGIvAI8a56LVY188Xtj27g&oe=69BEAAE6"}, {"file_name": "2.2_PuzzleLevel_005.png", "id": "629250039801395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392016_629250043134728_2118689073029424993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9b6HMSz9LsMQ7kNvwFt0I4S&_nc_oc=AdkNpMLLU-GoiShwv-00Pd8dxEaPscJoZdTW_WCTcOIk62SVLZ14cyUevzhp6hEesuY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGwarjrPbDNGQQYmp2JJ1X3WI_6nbpKQXpxBobElGxlw&oe=69BE9A52"}, {"file_name": "2.3_PuzzleLevel_010_Vers3.png", "id": "640340928639659", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392016_640340931972992_938618552754180062_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roO7AHPzrnIQ7kNvwGyIDal&_nc_oc=Adl9QPm0hQ4sgkcfDPhWTTSlvyz2wF1LCu-L5DahJAMVDhYa-pAs_3kpEagHSaMJ9mk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyghuHWUEtk9YCwX5WVQJbM-aGErU4Gr5w2EqFAkBvuBA&oe=69BEA675"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VersX.png", "id": "905403181768105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035377_905403185101438_6180565823629151945_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47A8juFstQYQ7kNvwFo4hmS&_nc_oc=AdmqZlY-D_mHZ-o78lJcZGJjz7aYusJAtLj0q3hM4Rs0l7rzkhpchlzMKnQaLAq7OXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAgHDQJaVVk8-04wf0Gzw5cNQsmovzuymfC37-64_dpg&oe=69BEAD20"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "\nJump into the magic world of Selinas mind and master tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!\n\n{462054049934411}\n{3846354725676153}\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\n\n{1270178880992449}\n\n{469944256054407}\n\n\n\n\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective into the mind of a child. Are you prepared to help Selina and push back against the sinister Aniles and her shadows?\n\n\n{1955927098148751}\n\n{655503446907375}\n\u201cSelina: Mind at Large attempts one of the most challenging tasks a game can achieve: transporting you into the shoes of a child. ... you return to feeling like a child yourself, in wonder for the gravity-changing hijinks that ensue, and the personal struggles underneath.. Isn\u2019t that what we want in games?\u201d - UploadVR\n\n{1358786278632654}\n\n\n\n\n", "short_description": "Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selinavr.com/selina-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trotzkind GmbH", "support_website_url": "https://www.selinavr.com/", "website_url": "https://www.selinavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "pt_BR", "zh_CN", "ja", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29448241418157985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001676_2233461320362684_788008089222440850_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nziNQvVGfusQ7kNvwFVf518&_nc_oc=AdnUJIM5Knsb3uLf6HIgqT-IOMgtc21xXT1NXU98ZSPPQS1DmPdmhQfFtBc8fCQgGRI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxx95Ud6TUaW2col6UKQzS0JkHoHEtmHVR5kRy4XH9aDA&oe=69BE88A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Selina: Mind at Large", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534
73391934_2332433587219826_3583268111283018752_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnCt2iOUkXkQ7kNvwHoJbrm&_nc_oc=AdnPyfaw-_1fJXWOK9I7SoZVZKA6ardiFz5RG8c_AnN07zR19hgfAlEJzLCPhFFNwyQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9B9xOeH69raahOrgKw8WHslMHdWHj1dFkqdWcuQtpqw&oe=69BD45B0"}, {"file_name": "1.3_PuzzleLevel_028.png", "id": "1836994227070784", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391911_1836994230404117_1890935279929871499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eG8GlgyzbRoQ7kNvwEswF_b&_nc_oc=AdkiFkrV-al8Fd3JsFYHn7dxFwzvE_PIqpFgxMNUtPvTWLHWJWgr5ZKgVSY-PBLc09w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwT3LzerN8P0w1UfdVko5YkZOGyG0ZmuVPe3OpGXcwbvg&oe=69BD2C87"}, {"file_name": "2.1_PuzzleLevel_023.png", "id": "980481747324553", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391934_980481753991219_471152226523097550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMduLEo0nakQ7kNvwFzCNPR&_nc_oc=Adl5NEX1g5yyn6SN85OVpKI_niwx0EjyuMSd9xCw3X-sXWLUDlHnDbz8JPfb4OVAqZU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-UxsanXn1j6FtHU2yFxebmubMHnAZc2-a2sA38ZJlXg&oe=69BD5966"}, {"file_name": "2.2_PuzzleLevel_005.png", "id": "629250039801395", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392016_629250043134728_2118689073029424993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9b6HMSz9LsMQ7kNvwG68sGg&_nc_oc=AdnDO5IuLFypuxeZH71ib8Wtumf4D0cQgViT9_bhxfXtjitK_MxOEAcLENnKRTnnoQg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZV2yDVnnOdYHTkScHbOSshr3_vHS4j8mP5MBL07WZog&oe=69BD48D2"}, {"file_name": "2.3_PuzzleLevel_010_Vers3.png", "id": "640340928639659", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392016_640340931972992_938618552754180062_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teAatIrcGDUQ7kNvwGoYaUb&_nc_oc=AdkbeeApCVtaMW4ut_YLGm19aRKXXbT9CxhVXLlXGM8sgaPmfhLOzR3-0rY6PwJmzZ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxF2jZlluGCQ_rb9zIzfWsXRLtsoqNFotKuNpMbNkdb-g&oe=69BD54F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VersX.png", "id": "905403181768105", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035377_905403185101438_6180565823629151945_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhYOKtIyRfcQ7kNvwEGqMdD&_nc_oc=AdmKKXvk2dzOBMfW-kTgZyESwiAx-QltnqBUn9Fw1carmLGpdCBAwMn5KcmVEWsVD-0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxkZaqEiKgW1OpG3SIB35F2Xmv73nK-WpOf4Lh_kSSimw&oe=69BD5BA0"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "\nJump into the magic world of Selinas mind and master tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!\n\n{462054049934411}\n{3846354725676153}\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\n\n{1270178880992449}\n\n{469944256054407}\n\n\n\n\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective into the mind of a child. Are you prepared to help Selina and push back against the sinister Aniles and her shadows?\n\n\n{1955927098148751}\n\n{655503446907375}\n\u201cSelina: Mind at Large attempts one of the most challenging tasks a game can achieve: transporting you into the shoes of a child. ... you return to feeling like a child yourself, in wonder for the gravity-changing hijinks that ensue, and the personal struggles underneath.. Isn\u2019t that what we want in games?\u201d - UploadVR\n\n{1358786278632654}\n\n\n\n\n", "short_description": "Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selinavr.com/selina-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trotzkind GmbH", "support_website_url": "https://www.selinavr.com/", "website_url": "https://www.selinavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "pt_BR", "zh_CN", "ja", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29448241418157985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001676_2233461320362684_788008089222440850_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaqwMV5LAjwQ7kNvwEcgA7H&_nc_oc=AdlYF9XNSK0sy8of8GPMGlXVpvLQpu62iZyXHb7kVcjHQsovEJH1QKMQ4lvos_whOpY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzH01NNCV9d9ypUmXuERKQEGPhm_NsG57L2arJMUcWuRg&oe=69BD3726"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Selina: Mind at Large", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534
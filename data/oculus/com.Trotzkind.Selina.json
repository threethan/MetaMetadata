018752_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4ye_ZcmO4AQ7kNvwEMqTag&_nc_oc=Adra9bvIrKOAGlhnehY2xsZjYNiGYdxZWJIIaZhJjCKCztod1yg_C4MZgsGVsOYJ0kA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1i0ng8o2B9uDPN1DpWCppgPb-rWuFMi5jq5frB1NR3zg&oe=69F201B0"}, {"file_name": "1.3_PuzzleLevel_028.png", "id": "1836994227070784", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391911_1836994230404117_1890935279929871499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS2fa_it618Q7kNvwH-fB0R&_nc_oc=AdoYoLlmbN10bLWK0HH9QcLnkunKTjc9EeAItAJjrZPSwM3CzsiJz5NZUAuEGJCYaKY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1BfqRYyuHL6_LwGz1Ow9p9NOkBt6XdRbPtJonrIuaA0w&oe=69F1E887"}, {"file_name": "2.1_PuzzleLevel_023.png", "id": "980481747324553", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391934_980481753991219_471152226523097550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYhjL7IQWiwQ7kNvwFD2gxP&_nc_oc=AdqQZ29kldyIAwnQ0yvfpgYaxUNpBeMy9Dy_xKpw2eiG2Kgv37ms0uwnjrsrV7T_rSE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af05eX5E3cI20ckIxbJpCr7eM4J3048logILyupnQ1ojVw&oe=69F21566"}, {"file_name": "2.2_PuzzleLevel_005.png", "id": "629250039801395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392016_629250043134728_2118689073029424993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ec0Ud22BUsQ7kNvwFoILyW&_nc_oc=AdpX-eDozgDBpyutX6ro_J-W39JZSSszv_HpF0N5Wq36K1QtFT0QpLAU-B3TRwZ4jeA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3n5WRoR4sBjbwV1L1lG-hxHEt7_W5E2dJJyO4kN2rmmw&oe=69F204D2"}, {"file_name": "2.3_PuzzleLevel_010_Vers3.png", "id": "640340928639659", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392016_640340931972992_938618552754180062_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2zm2qJjdWcQ7kNvwG0CY6O&_nc_oc=AdpZymk6-pkQf90tA3mbdbuhPtPvFa5Dzt3FOo9gQSFSiny4GRRDm4Ij1EHt9zQv-UE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0j6fD_M5mZLUrXp13u93508vAy6e5otvmPJnAj4H7A_Q&oe=69F210F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VersX.png", "id": "905403181768105", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035377_905403185101438_6180565823629151945_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wj_fmHcp0qYQ7kNvwEQPsXr&_nc_oc=Adp2jXpz06NdfRSVEDovuY24GhxJBc_oDHQIflU9gXbBJVWm5T_ihYSJ_z5v08iaGvo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0TqeDlgT-uAZxkoiE3eRRM6wq7YKBltZo9FXog9TAHyg&oe=69F217A0"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "\nJump into the magic world of Selinas mind and master tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!\n\n{462054049934411}\n{3846354725676153}\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\n\n{1270178880992449}\n\n{469944256054407}\n\n\n\n\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective into the mind of a child. Are you prepared to help Selina and push back against the sinister Aniles and her shadows?\n\n\n{1955927098148751}\n\n{655503446907375}\n\u201cSelina: Mind at Large attempts one of the most challenging tasks a game can achieve: transporting you into the shoes of a child. ... you return to feeling like a child yourself, in wonder for the gravity-changing hijinks that ensue, and the personal struggles underneath.. Isn\u2019t that what we want in games?\u201d - UploadVR\n\n{1358786278632654}\n\n\n\n\n", "short_description": "Guide the magic waters of Selinas mind t
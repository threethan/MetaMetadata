{"file_name": "AnilesCastleScreenshotWQHD.png", "id": "856820209950979", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974733_856820213284312_3619574751106088437_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZ50vECy0lIQ7kNvwG4L8jC&_nc_oc=AdrYE6U2zkawrvOBtUhty1Qbl5P2iFRcfkqPsfn98Yd7buhuQvckjD5DQopb0VOzQHI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKMEEAeCsWCI1UFbfx-oNpINOuYLrgli-Q387---9QUA&oe=6AF0A1B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Selina_StoreCover.png", "id": "8727096237314676", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001684_8727096250648008_2208213057538106781_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDgsYj3jEF4Q7kNvwGusKHk&_nc_oc=Adpgny1voA1X8I7LfM1yzNbQYmbRwtwxOB8tfF3yVGIZpSLzq6KWr-VPTBQwf2kFbKo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmAtNHr5HJz6ULXZ7p2MFsJeEhnc4WAeveNfH8cw7Azg&oe=6AF080E5"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "Dive right into this mindbending adventure! The young girl Selina seeks the help of a brave hero to travel into her mind and restore her memories. Are you prepared to push back against the sinister Aniles and her shadows?\n\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective on the mind of a child. Step into the shoes of a brave and clever hero in this narrative puzzle adventure.\n\n Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!\n", "short_description": "Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selinavr.com/selina-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trotzkind GmbH", "support_website_url": "https://www.selinavr.com/", "website_url": "https://www.selinavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27006815642300587"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1542058556774732"}, {"status": "PUBLISHED", "id": "1182460969680804"}, {"status": "PUBLISHED", "id": "683696700724934"}, {"status": "PUBLISHED", "id": "1611635542809222"}, {"status": "PENDING", "id": "512041091500527"}]}, "baseline_offer": {"id": "1611635542809222"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755277200, "status": "PUBLISHED", "id": "1542058556774732"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29134533846195412", "version": "1.2.1"}, "id": "88898
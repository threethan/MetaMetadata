9670716_3050581873978924803_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwcw-Oq-TOkQ7kNvwFycGEd&_nc_oc=AdqAs64ZFARASylPaP5yWxJ41-vSlwXKnBHfVwtmSd4NPSDDgXLaYHCRSKD0qPRK800&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR73ObrZzohfgzJDdYWrsMboeuykTXoQAlpHYmoif5uwA&oe=6B0324B0"}, {"file_name": "MusicBoxScreenshotWQHD.png", "id": "1039420814346092", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982687_1039420817679425_4204423075002585589_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnSMVnco1sYQ7kNvwHOGhbc&_nc_oc=AdoFjynEjr2CT41GyhuC-8c8SLr6SGdwBXCX3HnJ2LsZTQSr3JvuCOSg5lzucP4CfeI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQW4D6XHYceuRK-_DUy_qYmtWOURQ66-5jxMQcVgEbAQ&oe=6B0313B5"}, {"file_name": "AnilesCastleScreenshotWQHD.png", "id": "856820209950979", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974733_856820213284312_3619574751106088437_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7UHimPNGFwQ7kNvwGXInIE&_nc_oc=Adobl0FZ120jo9xpKrjFUkXK8b6_GGQB12PRvrn9pRHRuKboeGTmlKUHPhJwf97o-lw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLeymTuiRLdiKj-1H-nH5rAE2cyW81EoOIH67mqvxXZw&oe=6B0316B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Selina_StoreCover.png", "id": "8727096237314676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001684_8727096250648008_2208213057538106781_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ETEv6CcqMEQ7kNvwG6BCmb&_nc_oc=Adrtuq2TQh8PCpP28nmXgkiDJkKE-vi_MbTiRyJZGTJQ7-JXWImOuu62PrMgKYmCxJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0caI8NZNXJLUoAvbCPzgCcLZurGnEUE2zivbhY-Yz1w&oe=6B032E25"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "Dive right into this mindbending adventure! The young girl Selina seeks the help of a brave hero to travel into her mind and restore her memories. Are you prepared to push back against the sinister Aniles and her shadows?\n\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective on the mind of a child. Step into the shoes of a brave and clever hero in this narrative puzzle adventure.\n\n Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!\n", "short_description": "Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selinavr.com/selina-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trotzkind GmbH", "support_website_url": "https://www.selinavr.com/", "website_url": "https://www.selinavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
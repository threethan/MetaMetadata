ttps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_2332433587219826_3583268111283018752_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKSIIn6sLGIQ7kNvwHqPnm3&_nc_oc=AdpKLkXtvMxXawTiZaE1DcnDiz8BPdR4TPN7fKFPNW7es25goNtZWNM1BAu3tCyV_fU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72PLmZdkDfhjlXnZ_O6iX5EG_IWoOV7IACmhEwJRBfyA&oe=6A01D3B0"}, {"file_name": "1.3_PuzzleLevel_028.png", "id": "1836994227070784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391911_1836994230404117_1890935279929871499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXBgZEY8O5UQ7kNvwG6owg_&_nc_oc=AdolwLcAiEpZCACXhiHLR-h7Yxnhb7Ov2682Tus_M9XE1YAl0lgxUEVTHQ35p18CBpk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FHPIM6waANNZ6GHNCCzdkzP_T1eOjCrkXYfsy-d3E7g&oe=6A01F2C7"}, {"file_name": "2.1_PuzzleLevel_023.png", "id": "980481747324553", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_980481753991219_471152226523097550_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZ3FS5g05o8Q7kNvwGpkxAp&_nc_oc=Adqhx6ZkxfJ3SOE_UkImTDg9lP9yFV4BTBOrMSDVpjUksA1ZmKTwZmhUEHuseNizjhE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40OATfE_j9wSIAMlR6BOtv0aWyBgs5yH2jd1P7L9AW7g&oe=6A01E766"}, {"file_name": "2.2_PuzzleLevel_005.png", "id": "629250039801395", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392016_629250043134728_2118689073029424993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrpIOTOcOB0Q7kNvwEfnFrm&_nc_oc=AdpFnenp_Or8F2BhdIVex-zE_HRn2mgmNPOl573uvDGT_6UxBZBovlSbqeuqZO_Pg1c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ha_4tIyjOQsPwZG_OxznP_R2b4-8ar1OKqqRFsY647g&oe=6A01D6D2"}, {"file_name": "2.3_PuzzleLevel_010_Vers3.png", "id": "640340928639659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392016_640340931972992_938618552754180062_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1D89z6WSn8Q7kNvwEMH4Ud&_nc_oc=AdquhD1_8J1upcsCNKgVKNuzqMEAc_b87gt8ggrOEqw6-A1qOOdxphsdDw-P5R8lPUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dI_KWbiDziDNu-sElU2df4FIQq75vXbnhdNdQZL1DIA&oe=6A01E2F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VersX.png", "id": "905403181768105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035377_905403185101438_6180565823629151945_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkHdeBvuDsUQ7kNvwEXy1mB&_nc_oc=Adr4MXGioZrUZvhq-fXNEvjzQgvgxCAFO5yNqRuuZ1pktMPxTe3Nv5Ou7j1Q9mev0vo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K6JkqmaY0R2m6RY6PDP2M8bhD1yE8Ahun_fKjV5WVcg&oe=6A01E9A0"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "\nJump into the magic world of Selinas mind and master tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!\n\n{462054049934411}\n{3846354725676153}\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\n\n{1270178880992449}\n\n{469944256054407}\n\n\n\n\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective into the mind of a child. Are you prepared to help Selina and push back against the sinister Aniles and her shadows?\n\n\n{1955927098148751}\n\n{655503446907375}\n\u201cSelina: Mind at Large attempts one of the most challenging tasks a game can achieve: transporting you into the shoes of a child. ... you return to feeling like a child yourself, in wonder for the gravity-changing hijinks that ensue, and the personal struggles underneath.. Isn\u2019t that what we want in games?\u201d - UploadVR\n\n{1358786278632654}\n\n\n\n\n", "short_description": "Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selinavr.com/selina-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trotzkind GmbH", "support_website_url": "https://www.selinavr.com/", "website_url": "https://www.selinavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "pt_BR", "zh_CN", "ja", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29448241418157985"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001676_2233461320362684_788008089222440850_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76-b4MpEekcQ7kNvwG2higv&_nc_oc=AdqUpRmbdkY03OisK_DgYGQnQfGQq4vnGQn8DWQrrPEB4hQd4NMwsZaBZ_AN8axFBIM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H21IdyPuJLboWC1RfQYAX1ZZXtf0VK_-FrL3XGLAYyw&oe=6A01C526"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Selina: Mind at Large", "platform": "ANDROID_
9670716_3050581873978924803_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVJaJm0aEVAQ7kNvwFrzIpd&_nc_oc=AdrWus1jEHP94wiU-Ts4i8583hV4UmEQZQSLwsOxdzUY0kdwvaIn8uPY24cFAopuTk4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuVAO6wXSSTdmEi6XWoue_n-tEWzUaoGF_QDlxMRw5Fw&oe=6AFC8D30"}, {"file_name": "MusicBoxScreenshotWQHD.png", "id": "1039420814346092", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982687_1039420817679425_4204423075002585589_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM2Lu2aEAFAQ7kNvwFqh_kh&_nc_oc=AdrBtda5iw76IHTu0Kfr0ixuP-rwPG8Bvpvoo2LwsNIQA0V-CA7W3PPshKARhoQxnrQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu18jgnYdX9BT7GQc_kfvwkw1Y3dycquI0-hv-Yi7xZg&oe=6AFC7C35"}, {"file_name": "AnilesCastleScreenshotWQHD.png", "id": "856820209950979", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974733_856820213284312_3619574751106088437_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCo2c8cMvTMQ7kNvwFcH_x-&_nc_oc=AdrjOqmzBRGZq9nkYDs-jrl0XAStXRDCaSbveSDOZzFwvAFbhh_nArY2ugTErfpD1So&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSbmtT4eMn3nMkS7eb5PkUzETveklT46dfyFZCmrmJqg&oe=6AFC7F33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Selina_StoreCover.png", "id": "8727096237314676", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001684_8727096250648008_2208213057538106781_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLD-wHKbe4YQ7kNvwFii9rt&_nc_oc=AdqkcC1nAxFibOYHmEwj1IwxD4fV0m9hUF8UADlRYYXv1-JBxlKvfHfO4MoskJZOL1w&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4c_QwMgZoWelMSUNNpBal7tYgOi8g73rfdPCmnw_UCA&oe=6AFC5E65"}, "display_name": "Selina: Mind at Large", "keywords": ["Puzzle", "Narrative", "Surreal", "Emotional", "Physics"], "long_description": "Dive right into this mindbending adventure! The young girl Selina seeks the help of a brave hero to travel into her mind and restore her memories. Are you prepared to push back against the sinister Aniles and her shadows?\n\n- Turn the world on it's head in a series of physics-based puzzles using the gravity defying *Escher-Teleport*\n\n- Embark on an heartwarming journey alongside Selina across otherworldly spaces of impossible architecture\n\n- Follow a moving tale about the shadows in our mind through fully animated character interactions\n\n\nInfluenced by the writings of Carl Gustav Jung, ***Selina: Mind at Large*** is offering a unique and imaginative perspective on the mind of a child. Step into the shoes of a brave and clever hero in this narrative puzzle adventure.\n\n Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!\n", "short_description": "Guide the magic waters of Selinas mind through tricky physics-based puzzles to protect her memories from looming shadows and immerse yourself in a bittersweet tale about courage that will captivate your heart and mind!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.selinavr.com/selina-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Trotzkind GmbH", "support_website_url": "https://www.selinavr.com/", "website_url": "https://www.selinavr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
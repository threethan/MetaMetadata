97_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cOpua_oQQ8Q7kNvwFIMsEq&_nc_oc=AdosD6C5NSus4vDp7ZSehD7ftGsOnCBV7hKhPPMVVgfv63KsO9gvAJ0ckf6nEXWPOZc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh495rQyhh_WVj9lc58kYNOMDDG3t2hOxcjmSpqYGygQ&oe=6AAE942D"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6rp_lxA_ZoQ7kNvwFXpTHo&_nc_oc=AdrlXTIz6c-5p4bjoO_vFqnc2NciaHwfjWhoZshvFgOVsZ_plKjZ3NRjyw0ez_Nflqg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnnFKZHvEkS5i6OAGg0cBvQMhaomz2YhqW7u1ZNG8jvA&oe=6AAEB08C"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuNMbOOlPTkQ7kNvwEszKkH&_nc_oc=AdrwPdcpbSaC65rDzVYHrVWESAQmb3l22LtexrnstLJx3IS9E2hcNfN40Xy_IiRdZYY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwyqUmcnQVMSr0cDuJIKgpPU7JAXKQuNud1Gk9SpTZdw&oe=6AAE9345"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sef1AO5jyXwQ7kNvwHAhSIt&_nc_oc=AdpzU98Z137SW7MEOdipb5MSLV4RA4d04Ega_v4S5dDiUljH5vJPW-U0hv1GpcGZpX4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAboDmysT5wpNMwBoEIlnJg2YSQQnAlA8JxqROFbB4Hw&oe=6AAE7E9F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9ZZ3pRied4Q7kNvwGBjOXh&_nc_oc=AdpBn4B55wUNyNCB9pTWhRQXOSnm9Aglswa9sDlEqp5fn28G_uKcgEVj1e_3l4YpItc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1MGo8o6XUN92yLHZ9xiNx-MMh4D8YhJqNS0becYHuyw&oe=6AAE8A99"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjSl-rZ-jI4Q7kNvwE92ClF&_nc_oc=AdoK_MbvmnS-hnI8MdOoF0FjYi8uXyvbKE7sMlK8HERIjI7eLNJITZF22-Z-yVrT-jM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM3jdZPGSj-rLwlaLSwcOa7UA9NPRgKNt23oEZmLliQw&oe=6AAE857B"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ncwtI48XCUQ7kNvwH4fn4o&_nc_oc=AdquunyH_fLchyBfS16je99YdbNPhEw-CB6_e11xFa1UK6_GeFOxgTBRS3XwJxdpNAI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDRhW5Nnj1C7HcKm2d7S3A_KF6JobhecSMbRVZOtqERA&oe=6AAE87A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer":
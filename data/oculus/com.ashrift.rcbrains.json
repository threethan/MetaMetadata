_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfRL8HWG2jcQ7kNvwHdd3Vm&_nc_oc=AdrV6LtOkO7TmKLacmsOZWhhR-_JqLQrraR8IwMM-Nzpulrt7GCWqL5D3wXEL8SXVI8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1LTPik6z-L3rLQLc6_66_YA9EFQYnLE4RNqsoeSXw6A&oe=6A539CAD"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cC_anWhNjIQ7kNvwGOWJgm&_nc_oc=Adr4qrg-X81LEOG1KeXGV5P4zzUdycq1-EUG4hdvHUAfxvanBBsnNFdkCs82fZMbqp4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW6J4mvQz9-KhH7F1Sm5WhamQRBIdBjn64p6ugQLp2nQ&oe=6A5380CC"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LmL_A7CGeAQ7kNvwHoXubU&_nc_oc=AdrWsNMByV9kuQhk5DtGI98r7CwTF9mSRobmRHvV2hqElA8QftsNrslCbI4ka7brQYI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWJBtcQ7LyRqwPsyw98jvMu13gPCS8BVEK9lt8wqliSQ&oe=6A539BC5"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiXvxCav7bMQ7kNvwEK0Ms1&_nc_oc=AdoWLyjp0ddNBKg6yE6fjTEyRjB8Leek60s0XrzUbRh4S29miEMb6FtuCba0V6WxBDs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNxjd-a2q6hHesWlHKcONO16YgUlTggn5caJNj7RIdfA&oe=6A53871F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNYoaroXCV8Q7kNvwG0Cbtk&_nc_oc=Adp68hCme7DwEG-IzVq34uLweeYufh9XGPbynPhDu4Zk9oPlFtzNncFgIwUOWZjMUkQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAssU8jVomiS1HV0IwyO9kcaKSsDat7vyJgf_uBeUaPgA&oe=6A539319"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STZGlyIsI2kQ7kNvwEaV6Gb&_nc_oc=Adpes4w4hSmDaO39C45fZjcPRXpjHCUSq7umj1062vAIesvOm3VHB2hz28pU6RFoLLg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQuIGt7iRn86-rzxsPkMFZIekskipwSxbCQ0AYQfK1wg&oe=6A538DFB"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmsoG42mTE4Q7kNvwGLDz_N&_nc_oc=Adp2rE50WDKaMBgUC_r2VhC6ucTBN8k8zqpsPI9ideSqfVHF5WeKO-NiKAyfZWLamdY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiovttfOUqJEBXGS_6NlAXdKSNU9IsFdJWZ5F82DopyQ&oe=6A539021"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "11
7_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92UqwJ5_z4QQ7kNvwELo97M&_nc_oc=AdoDQIZPgreUVtKqIV09ko06fouebKy3k1P8v38cr5WFCs0qeqesTEQO0yz1bdZQ3g8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCsNiJWThxThs25DQUJLp1vbh3EixEhpegSpirqZTzgQ&oe=6A6CA92D"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y6zuDRBaDkQ7kNvwGJH3M-&_nc_oc=AdqrkY63b-zv1n6Bja-i-CFrKcBm_r6R4qjrQebY9iNlNH5gOHq8HIqRP6XEy3DFWYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtANkgLGai8laRQ_HLBjAt5NYNrbOb1jemnB8H4Tdrhg&oe=6A6C8D4C"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHCpXbn0wgEQ7kNvwGkmK-F&_nc_oc=Adq4iIfdRj2OGm1sUQcEB2Qwe0RPD56XxPtaN_ULdChhzTGJS45rt8cgkTxv_EwSczM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrbx9v9LOg_f3qQ63YU-F_bIUlIqjsNwyg8n50ltt4PQ&oe=6A6CA845"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTeOIsUfGR4Q7kNvwG4HWm1&_nc_oc=AdqYZRbzkc5YDhlJA14wjLFuhncOIkFPS_QfIDOoFgKsCHD9ReeQhGnHpFgqG8njO1I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfttYUcJVqe8l_LllsxOZHjYVMqkX-fAONBZe73NUrDw&oe=6A6C939F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwXADM_IYqYQ7kNvwGtiFi-&_nc_oc=AdqfBGeTrh6-uMsQknfJ6TCvn9qgThWs-XiBzRdeEm0nVbQNpKBGdCGVZrR8B0NPjtk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR6VD69pY88brbc1T6mzI4uVYn7I_P7PebFUvorzSA2w&oe=6A6C9F99"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4Zi5WKuoegQ7kNvwGzqiiM&_nc_oc=AdoVj7C8kxBthbq8EVfn1FetIeZ4O2WepmctF25VFaC7tnn_c0YEE786L3blA_TC3Zo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp9gYCt93VjjCOUm9STw3jnMmEgVinr6rA0eU1B4YZcg&oe=6A6C9A7B"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBfdlq9AXf8Q7kNvwGaouU8&_nc_oc=Adpm6nKR_pOt7PlTjnPc7NyVny6zX46xZQJJpIfMrHGEC7tdSIWaEOJc75hnoYzwi4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4dHiRSfvV3_08Rp9BLYb25pyMxLP-2UY4v_2fVDbuyw&oe=6A6C9CA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "1
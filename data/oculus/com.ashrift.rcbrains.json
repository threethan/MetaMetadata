7_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Za1KlenxWMQ7kNvwGO7QZK&_nc_oc=Adop0Um7ryivY294YdXbmC12zNihuptivokdTo5Zs9HmxF08tSsLviiguobX1jQTIVk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBzMFjUajdZbUtw0Q0XHpHgIQ7iRP6vgVP6x-aOq_24g&oe=6A71EF2D"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUOYLDHxAvcQ7kNvwECRDYG&_nc_oc=AdqZMNeyd7oc0F69p-iX0n54s8Q_b7_I0ecqhl1qtFpsB1sRgTCNcXeRSlOPq8eIMPw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJBww0Rl1hQ03XvLSFfB1dZJXsAjMfWK0OWgdwI26YZg&oe=6A71D34C"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytzE9SNG5GQQ7kNvwHBx1i3&_nc_oc=AdoD6_B7eoEhsA0H6daQKAg-9IvnWb5du7EmdPfe-Pag7BSiHiGHM0QoQdsVpNk1wsg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAmLx7k7MNodtFoQoO-cLS5FeWufNVaGxMRJ-Wiz6Ztw&oe=6A71EE45"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZszM3-ln-dgQ7kNvwGyEOlC&_nc_oc=AdqX0EElDGLIvgtC85LF0en_s1dwj7RSWxBGAb2kdoog0IXYd-Xqc1WKMSNF-7s1epY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR4jGP0oCL1pv7iYaLZgLuU1psBhwWoLBugIemzAtdaw&oe=6A71D99F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-O1cflMUDwQ7kNvwEairH6&_nc_oc=Adq-G53lmUflJIZZOrsLvlKYW9d7RQsKGhkB1pW_RRhVkOeZSPwjNTeQlosLmc5pnAs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrp28HWDT_Kgl-6nplDCKBOoAtWYb7R7q8aqXTJIMdww&oe=6A71E599"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFqEXOyZT3sQ7kNvwEwe3Eq&_nc_oc=AdpSo87x_HwLp7qS03ysDyt_aso0Y3xDMe9UnfH4EpPmhNWslRbtQitNCkfckO7-B9g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTFrDDTed0QVpdYX4zSmqnujwFyXs3tTFypWZrcI6y4A&oe=6A71E07B"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMGjyf8zlkYQ7kNvwFXrSR0&_nc_oc=AdoSGLaXqLpg1TCPdMj-xxPZBkWZSOYH_6ciVN0Dmj-DrAotouzBy54gSTMlQKGZuo8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeCvkQwFAOkIJlI6mBW_VgHynK-HPE6oQPe0rXOCa67w&oe=6A71E2A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "1
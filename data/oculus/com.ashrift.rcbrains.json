97_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nW__ZV2FFJ8Q7kNvwHYUc4P&_nc_oc=AdrB2FP1ucCKQ3Tg7IqeDeRBaGCDAX8kivKjJffRYip77Ra2yeTHVQiSbGwIAMUEMw0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkAHVn-Wn5vj62_Ycfhv50d2xiTNgTWKxrKzT40HNgUA&oe=6AA94E2D"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9c2RkYfREXsQ7kNvwEtsAY4&_nc_oc=Ado6yqa6u5uV4xAWdCZATEINin-xFI0DfrDlxc6QskZm0Tp7T9VfmBsHH4MH1Jg9e6s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUOlc2n4KBt9RPSJwlYdBtKDaq2juh7kTL9TyNBHz4_g&oe=6AA96A8C"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kfeRFpH2vMQ7kNvwGAR4rU&_nc_oc=AdqRRUmtHa4ogQCa6GagfiBGN8QdXtRIeYfPnRJUiGjXo1LzbCL0UlD17nS8tCI63tw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkcTdyKhrWvtAwfODBLSf272zWxRX0XCOtfvob0XM1Cg&oe=6AA94D45"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUp1sHY2yAQQ7kNvwFrzvx_&_nc_oc=Ado7miBX1Lj53PLtedCM-DRHoODYtBC8SHK4MvmZRUeP44OLwCsmQKw83JCcDCJLl-0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfHsrB62mMtpc2jKYpqtqzOuN2M3RSIU1cEpFCrBLvEw&oe=6AA9389F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwPQy_pHeNMQ7kNvwGem9rP&_nc_oc=Adp17jAmE5wMfKM4E9YWu9heupcqaCaYYuRYhMl0SMkjklhatA1qJrKQ_2FA0YDLTAI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL8UWqwtKfAVIKJveQDhvyLsn5qyVKbG-VyoSIsEx6iQ&oe=6AA94499"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_O2_vnZ47FcQ7kNvwG8eYgY&_nc_oc=AdqVU6CsPMxFU3f7jjiXL0tOhxgxK5zS3NMvLLGWYtuJMpSHU90n-DzL68PdBrbROCM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiQDLlDtgiVsMgDNP-0pcfBvejWT8ckbzhjJ4ZWUmxtg&oe=6AA93F7B"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pGCYOF_vHIQ7kNvwHDUKDq&_nc_oc=Adoj54JXif31_55yKDs6VC18ly2PTNqbp41s6ahstBnT2N1mIZWF73ZhiQ0xgOv6IVM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkrZUFaQUOp16DItjGKE4lfNcbZOgqsxm-TstLkPwxog&oe=6AA941A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer":
_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUyOhfq1vroQ7kNvwGyzVU7&_nc_oc=AdpoY2QRyidQfsCqlBDjo_fCTkoWX7ZOrZH4znavhevT9g3gmDYravQQqT_GKtPpg18&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1aQA1Pq6DThr6wp05WTarM7XmMU16jdSRDb1hkUS3jw&oe=6A5A342D"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4K-UhBD98UQ7kNvwE7jqPN&_nc_oc=Adofya9WAKoIajgMprl3JtozuOBbx-QlTFY0jqvBgUBJRC4-dCvntlnNhqsLGLN9CaE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXb0gLq5QWHDGtJjBEDkvB__1iV5a6x7EfWYr99MYp_g&oe=6A5A184C"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDLym4pA1P0Q7kNvwE7v6LN&_nc_oc=AdonqORjIV6GBfeTz8kIh6rYWM2BI65nh_QghUhmrVbEzlCECmOFZ9dRCk556bOirys&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB5A8kRK9SqDsRywqBlxfNB7Ievcd9Y96pigEy9C_sSQ&oe=6A5A3345"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ap36jQ7Q5wQ7kNvwEnXcWL&_nc_oc=AdpTEynz-G78dKhOwFJ4955-9Jsr2kijH7P1-4rKkoRdtIGgPYgROBQURtFonaTxaaQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyKW5zlft-U3JTvWsyaTe2AC34Bsp_8Hyn9uk47jdKTQ&oe=6A5A1E9F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULJDVtxukBoQ7kNvwGH6Fr9&_nc_oc=AdpbWywXBfZxaeDBubHV5PdwB5BnTXhq7RcqrICrHncBK1r7DrjBZC0I0fBphUSubzI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIsxr8hYD8k8PKUEazzz9RKSZZ1oXUOkc6WJbb2Yzodw&oe=6A5A2A99"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MroNHRxIwmcQ7kNvwENYbgX&_nc_oc=AdptRZKNxe5xGwHTwZvyHc2wSv5ryMda6mXd4-Q6SBK1kHE4_KZKJmYCj2aPd-frGgA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbnZU4fJnRTYuCQzgP7-DUpK0e0nI1OJE9MgzQJWZ_-A&oe=6A5A257B"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMqVWKCmK_YQ7kNvwFpFclp&_nc_oc=Adr7BdcDeMI1C0rmSFZmsllij-_wZ9vT5DcoEC_DwiOyt4EC70wr70xHVVM3WklyO0M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgfEXvrlnhwKaCLFanT3KI6mLrQB6adO6bxo5c4gABPw&oe=6A5A27A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "11
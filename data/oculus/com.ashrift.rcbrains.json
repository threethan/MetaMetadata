6251", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMkfix_F7rUQ7kNvwE_Vu3J&_nc_oc=Adp-6lgVIvrGRMaW_mmNex7L1a-zEDOY-eZWpfFfOZWAHJBr75ufNO2Ff1XwEDvL8mg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDWTMzAH-9Pd32scgX81eSjvQG0BpEoqrq4pBjNvXImA&oe=6AE7675F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzw2FY4LIWkQ7kNvwGhFhE_&_nc_oc=Adre8-p7AdlQ8RI3zmgpcb3nR2S3aRnuCzHziKxUEaFU6BmeyMyLCXDoOcOFA3-ym7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFKLLXIpH266rE9GOwprF_5KmWDcngKu-aj5vL7RnBSg&oe=6AE73B19"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlJ6EYKVW_kQ7kNvwHOdI29&_nc_oc=AdqUNCj_XPrZczXfevopro1_31PhQjX-xgoCnZFtFNn8jFGLjczSHkzgv2HSPqhAkPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeXu1IbbXjL8K80wMtRGDYt6TkHA5iKTeKTGTJMrTUAQ&oe=6AE76E3B"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QTylOdg77UQ7kNvwEpURcd&_nc_oc=AdrvGArARz0Nm_bo_biSHUR77pFO1d77LXxzodyD8aA-EtQshMVBm4C2YhhtxsCM8Uo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRohgq39T7Bs6qf7ugiUyv-1LOqqWAMciTJCbnWZGCKzA&oe=6AE77061"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"i
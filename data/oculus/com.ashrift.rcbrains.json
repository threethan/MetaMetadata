_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-v6HpwLqfMQ7kNvwEd4XGS&_nc_oc=AdoTvA2_YdBIfwXIFqyDK6CNXkJj-Z1v9daL9t-1gqSeVU8anjB2X72hVZyka0Lf-6g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk0asX_uplrL_0aau9W18ZifITm6Uo7bOmRakQkesCOQ&oe=6A563FAD"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGJe4pKnYXIQ7kNvwGwF6cW&_nc_oc=Ado1cUIrWwA-4OEh5D_FCJmAdU0VDC1ds88vdTxBM7iDehtv5IoW7r1ohacO6gA7fxc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM-NzeAwnUr0i7rE-XWEdLULWOd_nJodwXACvmg2Zj1Q&oe=6A565C0C"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVD3zpx63g4Q7kNvwFvC-me&_nc_oc=Adq8oafC6T7AEhGlDZ-k_1FnVFcKQMydZ3eMe9NX0mg6VBkknSV8taRLlG7Vq5VTcAk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvpIY2A32HjcZTglOVdC74BZatRvMwcpod-kFasUsZeQ&oe=6A563EC5"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBHiIBPw8NoQ7kNvwGWOgLa&_nc_oc=Adq9qLR0br_4VILVgIKQtiLkNPJcKFoKyYPxBLqufFfHXTGdNigRdE7ifkTGceys7zg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsUrRv-InEDfE4SlmTc98bfkjLjzfwoQDKqIe0x5N50Q&oe=6A562A1F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skVcG8GH_DMQ7kNvwFwVJ6E&_nc_oc=Adra8-e90i9_2o0UQ3Q4qT7jzaE4SrtcSG79q1skoT24VfshlVE64sopuHyjOQiwq4s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKxbr7yCIHfGJLW1nXw8hJf257NEQaBx3EJBAnBBwTaw&oe=6A563619"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STZGlyIsI2kQ7kNvwFIih9z&_nc_oc=AdqrZ2g0e8UiR1mLhyg-lbSbxl6cGqbBfMIXZiSZ39vxxRy6T3fBdbbZGrSvrneE77Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4djV0usct1TF_JFkZAZN71LrIfdcBzCOrGSZCQ2UwEA&oe=6A5630FB"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR_LgbuvjMwQ7kNvwHfr2UY&_nc_oc=Ado2yRPOE-h9YFhoiB53YUZXKBq2hb1EHX8xCZmlu7XWBVcDLFrbyMS2iKI4lX6fYLE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUkSymqEwzIRNhY-ptiGNFxX-ho8f1U2goAXTl6qybxw&oe=6A563321"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "11
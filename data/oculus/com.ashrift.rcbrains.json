97_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h4SJKZ1C80Q7kNvwHo1zFK&_nc_oc=AdoF2Jl4_4CV3Va6jZsqZveDrppaGg6rOHzRNHOKrl980l0Iq_BbuEnLjrSo2Psutoc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqjtwa_vwJU30GeomvmxPf5NjJMbLSJgAZE62pFyfPJQ&oe=6AA4082D"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgXkV91JdBMQ7kNvwHK-JoX&_nc_oc=Adq05YBUJJUDuNtGJKVyCVAgg2fYfJCZoCmdMW5HzqpIC5VOYcLPf9A-JNI11pcFlrA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkFG0lAum4rfHVLxrSBXNCK1Q_aurAjGUtgLdua_u3mw&oe=6AA3EC4C"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdqAhS-f05sQ7kNvwEK2tB8&_nc_oc=AdoE4fC2clJ-S0JYH6I_nYONOF2fayQ_bd6o337wkElNN1eQwcw4KejISgZXjD1bbKw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4f62H7l38fiumXf27QXw-CzzF02uWmH4U14LfNHsr4g&oe=6AA40745"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLTKM7o_KwsQ7kNvwEO1paq&_nc_oc=AdpcGK4-2CHhr-4hcJKbJFO_mDdqxZshCueW6Nz61hFnwKoCGzsM0Jdo3RTlAY1IOw0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsC84bYYdSJyo3NTo5DQEZZTx8z7ldUDz_MH6Kf2j3ng&oe=6AA3F29F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rTPehHpkNQQ7kNvwFqzk2V&_nc_oc=Adqeqv0qnnowdzrrYm9riPjkVDWBYBAYIlDH_5C0tk4a8x3XOorDFn6i84rIOt74E7M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5YB6ZOYNgPxDpqVEyZm1-6Ui90_-zEclMQeBq_ePzKg&oe=6AA3FE99"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onVmriUy-_wQ7kNvwHsCNmj&_nc_oc=AdrRY1sq6UjFKjtwsnk1NeG9uIZkh87AQywk6PioE9O8rOtevHPFDc1hcu7AvJwY6sw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm0fRl_WP95qM4Ua5NA6b-XQTsHBZzsF8YZnqz0dA1kA&oe=6AA3F97B"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULQY1Lj5c80Q7kNvwFUyYMq&_nc_oc=Adp6bNgm7FW1fAu4WiTwxZ8NtpBsjKFJARByZes6ReUg3Ng2ieU5dWDnDoffNT_kT2M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIP0gu4Lx7bzNf7cHI6uPebDYZIFGRdLzXSPWU2pvlk8g&oe=6AA3FBA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer":
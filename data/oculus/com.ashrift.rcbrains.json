Y8SE8urpZHIPq1gfIfAnjealt6yXeLkOkpPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EaLForymYo4fjMpfwVBvvbOXFkV575ktgqun_owQjGw&oe=6A033664"}, "display_name": "RC Brains: Vehicle Possession Sandbox", "keywords": ["racing", "socialvr", "rccars", "vehicles", "cars"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race RC vehicles as a Brain \ud83e\udde0\ud83c\udfce\ufe0f\n\nNew updates, including cars, tracks, quests, and community-requested features, are coming every week!\n\n{3874153959558303}\n\n\nRC Brains has an Active Content Creator Program! You can join Discord to get your CC Badges! =>\n\nhttps://discord.gg/rcbrains\n\n{1668544704321624}\n\n{1707837363907587}", "short_description": "RC Brains is a Social VR racing game for Meta Quest where players play as Brains with Gorilla Tag-style locomotion. \n\nSet in a cozy suburban simulation, Brains race and hustle to EARN Races, Brain Bits, Brain Cups, and, of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "suppor
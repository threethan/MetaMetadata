0_2216760967844258869_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yh8tx9s5cEEQ7kNvwGq1I06&_nc_oc=AdpOzpHE1MQr5Vz4tJM8j_DJv6VC9ypyfFzDZOt8H1RREYCR2uGDCFG9zuU0OzX3JWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJ7CLCZxShSwqFFQzZytqWTxNOZOpn29nDFdGMmiCS4A&oe=6B0DB911"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RCBrains_Drift_land.png", "id": "1929634831744266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673573223_1929634835077599_7317223424650964347_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3ushD4hQTMQ7kNvwEX4HsW&_nc_oc=Ado0yMp5j0oAE_QJTQPGbLfpeAp4Sd5l5GmgTMvFcsoy67SYAGJHytyAA6RM4PS4_TM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQnsyiFDZcWUoVyCo6NW8K4RPCmHEznz8TP-qMyPBieVg&oe=6B0DB7E7"}, "display_name": "RC Brains: Drift Update", "keywords": ["racing", "socialvr", "rccars", "vehicles", "mechs"], "long_description": "\ud83c\udfc1 THE DRIFT UPDATE IS HERE \ud83c\udfc1\n\n\nRC Brains is a chaotic Social VR playground where you play as a Brain, jump into RC vehicles, and race, fly, crash, explore, and hang out with friends.\n\n**Join the Community=>** https://discord.gg/rcbrains\n \n\n \n# DRIVE RC CARS IN VR\n{3874153959558303}\n\n# PILOT GIANT MECHS\n{28354157054211153}\n\n\nEnter BrainTech City, suit up in a giant mech, and move with your own arms.\n\nClimb, launch, grapple, swing between buildings, and master the city with friends.\n\n# FLY RC DRONES & PLANES IN VR\n{3744554712353768}\n{2225960998146844}\n\n# PILOT GIANT MECHS\n{28354157054211153}\n\n\nEnter BrainTech City, suit up in a giant mech, and move with your own arms.\n\nClimb, launch, grapple, swing between buildings, and master the city with friends.\n\n\n# BECOME THE BRAIN\n{4300031590325704}\n\nJump into RC vehicles, hang out with friends, and create funny moments across the playground.\n\nRace, fly, crash, earn rewards, and become the Brain everyone remembers.\n\n{1526593175742234}\n\n", "short_description": "Play as a Brain in a chaotic Social VR playground! Jump into RC cars, fly RC planes, hang out with friends, earn Brain Bits, and build your RESPECT!"}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://sites.google.com/view/rcbrains-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "IRONHEAD", "support_website_url": null, "website_url": "https://sites.google.com/view/rcbrains-privacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "28108389955500948"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/756589809_2990776881271725_7448025773784396076_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqoAdw3ed2IQ7kNvwGPOmf8&_nc_oc=AdrXzbhkPqvI3bui56nWHgASyEDNk_2aXS5EaIEhPd7XaUyU2Y2BiepJzVi93pFXytU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3vbg_c4ONoWaYECiJU19DWWHzZ6m_KezRHjf0znB1GQ&oe=6B0DC0AE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RC Brains: Drift Update", "platform": "ANDROID_6DOF", "context_category": {"context_categ
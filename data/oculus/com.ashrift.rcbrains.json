7_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92UqwJ5_z4QQ7kNvwHGb8rE&_nc_oc=AdpuE7NokV7p4f2GPrIwqYP_BOGl3KigDSbudX_p9mucdWkI3e6i9R5ErJVBKDOA-zk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDim1Am17IRQ0hYPH576smQBRnAkVV0uUklvk6TnPDiCw&oe=6A6DFAAD"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y6zuDRBaDkQ7kNvwH9Mi97&_nc_oc=AdqVU0ptiSrujQ-hORxcwhLNWgmhZscDEQYMUJKGRM__uQ9NoEqfSCCy25Wwx1a9JkA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgk67d2VQHHZ0xnDz8-n5LRFtTyolB-2KIfzjyQsZ-hw&oe=6A6DDECC"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHCpXbn0wgEQ7kNvwGDcwH1&_nc_oc=AdoApRZ0BQQ_FEYT0_wTkG65Q9tU1YB6i3p83xv4BQ0GT1z4EY4osKQSBIAuVrF2qJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-8bu-a47XA1lE9naiMp36v30bBseKhjWG23zK9Q4M1Q&oe=6A6DF9C5"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTeOIsUfGR4Q7kNvwEvZeHo&_nc_oc=AdqRrjEPOlCz05IbKtG-rm3mzCem_TmZ1-c7FyoqfpegNiWPmoywkRn5hOA98DbOZLo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP_eQiuJimqb1f0dbCYTTyvCh3h00F-GoIu3KLV5YdDg&oe=6A6DE51F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSBh31VGDIQQ7kNvwGYM5pK&_nc_oc=AdpowmG1cVXW8Fa4_dlJPS_7yE0fc1LoAF5zMNcjSxjDmHPWf5V6HFuap10p2pl8MSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv3RQ_W423G0ZBl71DJmr6e-1R7-sn-SLq2VYV595_Aw&oe=6A6DF119"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4Zi5WKuoegQ7kNvwHX8uVM&_nc_oc=AdqaNnTsECjhxS-KtW9-fSq8ktaB_GAnpb4F6JkbpREF5fKglgqk8dz8sZ9rJbxJd7o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPzpdhorV76bapqmPq7AkPuL1HePN09EtVkIyB8dZM8g&oe=6A6DEBFB"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBfdlq9AXf8Q7kNvwFFHpNW&_nc_oc=AdpEaTH1eFROkwNl7JdYavgaWnjhUqGjxr2Et-FdimVe5Kt-duSVBW6Akq1wugEy0OY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRweH0ICMcVW508bBsIVoG5WfaIzdHVf5-d3a6HWROTA&oe=6A6DEE21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "1
7_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G14imgJM52gQ7kNvwGrle9V&_nc_oc=AdoeeHukfWJuwIUqfF-NgXjy97t3Pm-vaFOl-2EQ9FLECH3L3lLbpR1tsI2-zmfHN2I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAltO4i6VzB8HEou0sD2kQQnhNRAjfcJ3blMtoQqqkACg&oe=6A6611AD"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HrP3x4MdmgQ7kNvwGInbn0&_nc_oc=Adq7Mb9PIAjWeiXuSzZSv_CH5amkbpBAL_ccPOca4_LGiEdHWsmubshHJR-TxkMjuYg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy7IP0R2LPbERu8-41d6r7nlr8kNKplgg7ZTKfTy5A_w&oe=6A65F5CC"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slPwGPnv-ZIQ7kNvwH5gNAK&_nc_oc=Adp6yRwjnBbqynbb-RDV-nQaBMoy42tPdG0K413nDGxUjmo3L7HCG3EcAU_ui_N1STc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvo0eEjErG2rLZwaoto2SF9OOJaIje4ixaexmD5kLlLg&oe=6A6610C5"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX8GBhXj1xQQ7kNvwFJiceM&_nc_oc=AdrH5g6jti0-LLkwFiBqY8Oo_xadUPAhBVMsm4I7PT5EQcCv4CVHuOJbOv3rO_sXrNw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHfEcmHySFRTjoKAl57HPblSyE7gW8N5qS5L67kyIsiw&oe=6A65FC1F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wg0Xzz-lhwQ7kNvwF7ccXU&_nc_oc=AdqTwh-kmazAR89xL_CRLS3U_HGpRXw0s2R37AMzBHcY0Wl1wvTpr_Fttl2d2cAdXCY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMSeaHE2u5Spcb1mazbVBReiZgS5Pu_zScyoB2Ofe9KQ&oe=6A660819"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ms74-QJ6mtMQ7kNvwFW-t_R&_nc_oc=AdryhEq8wvvzALeecbVWKIwLStW5pvd8I0PM4PV2kHnZNsVLCVx3PrDfm6r2gKcw4d0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9KQUi9yCFPei0RBWP-pD_IPNHulldUFyKW1LIbXmlOQ&oe=6A6602FB"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3bAaWuYOscQ7kNvwHy_yQd&_nc_oc=AdqBqUEgiikDScgZb8pUiu942Gu8uD8VM3zK2VRHiHd_5FQLWN-zYiBvRLNvtx-5tAw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvUT0yi8z9LkOjScp1AImX79cCNkRzSu8oFOU3PedNRg&oe=6A660521"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "1
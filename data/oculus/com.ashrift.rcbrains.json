7_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92UqwJ5_z4QQ7kNvwGnmyWB&_nc_oc=AdpkM57EYJM0eNQOA03KEI5UrZzsT_4w_RfX5jFKmx9aYzGw7jzuMyIrTwQVAZKsR4g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgB7jK6rhF_Os29HJ3G7qAFBE5PtQqZttmp2aTmkcNuQ&oe=6A6F4C2D"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y6zuDRBaDkQ7kNvwEO84xU&_nc_oc=AdrotCmRJ4Ng3MqopClix0xpT4BurD798fxUeMumCvsF9YmK7tnnRajxf5LBClbkynE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV6jDBzhCsD4SrXWR5kG4a4Ma9Mud9cQbTPxhOzrFegw&oe=6A6F304C"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHCpXbn0wgEQ7kNvwFUPF5a&_nc_oc=AdrYplSYRQpb4m0wLWrosk1p9kc6PTwoOZ0XO0-KR-vqc_LXoekBf-ddS8OgJu8R0z8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMG6BkdWKO3lPgfN3CRtXNFyzaXkxi4TBOp67b7Yb8AQ&oe=6A6F4B45"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTeOIsUfGR4Q7kNvwET4yBz&_nc_oc=AdpfyLOqLiBHYf751IHQnJF9eUH4iuqmE6qZHHJPkC8AA0Cdp3Hxd5qtm2sEJXUeDjI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7oNGOCU760RpS3P5Drv9ZQGlupyMB6l92G25RD-4KOQ&oe=6A6F369F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSBh31VGDIQQ7kNvwHXDTS1&_nc_oc=Adq86VpkZRNUe-eclK8rZ1mNxdE_GeMGad3qD27kOupPbQy6yjgbqLfQJ3DbbWmHVlw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEEuDLzQUDifYfSngd9sLCEpvNAeDYI0t3bzFLhmPkNA&oe=6A6F4299"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFqEXOyZT3sQ7kNvwEdGTro&_nc_oc=AdruS8g4a9zimOFuo2QbKde990sBqYDfsOHAATLAzkxJuIxxLRSGswgR2pVnJ_tDYtg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_NFBj15qpTSSuGd_m1AYUQVqZmH0aLUEF4jdnzqwSAg&oe=6A6F3D7B"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBfdlq9AXf8Q7kNvwGpM6sd&_nc_oc=AdoeLzCAR5B8n4pBc8fPsj6dsG2dNxYxa7A1L-NEkwBmZIFkUwE8pLMSBlYIXIFsn_U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNjx3dgXiL0GvyKwXm7J4jV4fkbVhcApQJLoTKiFI9NA&oe=6A6F3FA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "1
7_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G14imgJM52gQ7kNvwFjOvH_&_nc_oc=AdqhwcgkQfWNxqTVycVPFr4lA0dUvO-DH69OEGh9EpD4dtrfFrfrJDe-JXtDplbPWl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ3KfdsoMEwowiwCzBVcBKWGa1_PvbModJMSds6reFaA&oe=6A67632D"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HrP3x4MdmgQ7kNvwH9LOLI&_nc_oc=Adr5OTDJ8WX13cXFaJjrX4T641A32Zfmmuthtbp9ELdz5b-emVS9DMTDtPJdNhF-10o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH9M3V89HkNKN1tfqa1-I6lCnLEZ5moTbmfAh-r25Pjg&oe=6A67474C"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slPwGPnv-ZIQ7kNvwFYnwgf&_nc_oc=Ado6eWZldbdTqSnw6vIu3uRLMHnDdXGN_MM18UzYx72xrOO1jpYxbtcSuQDP5_9TH5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbIyK4mdgOKHjCvjTYorUCoJy_26AmetgMUq1cmA2S1A&oe=6A676245"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX8GBhXj1xQQ7kNvwG0gLfq&_nc_oc=AdqTz9GYXMraFtDXuQYbWkPz2dhzOn_BzYHZWpVH6ft7isIPs_6v_yqK4H-PkqJRUng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtcTkJ9_v3xEObW0leu6VIVhwJGkorJ2LIwWs8MLZ5Fg&oe=6A674D9F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wg0Xzz-lhwQ7kNvwExDyne&_nc_oc=AdqGG7FBj0vM6attoFRoC6P_HQN0cEo1tS98FHKmKgA7b18tFaCGSAYcHq2qY1JAtOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI5SO6zNjdaqu_NFmuIauHW34_4uI8UBg5ZACweNAeKA&oe=6A675999"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aWzegA11uoQ7kNvwG6Kaxn&_nc_oc=Ado9HE5LKPcMkuSAoYIuCAt-VR2rzEXG1J6KG_Yne9fS0ps7VFa90E0Hmh4Xx4XMNRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNWK-LB4dsn9_rDtvz9HkL30vYMnlUVDUANWbxEfTPzg&oe=6A67547B"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3bAaWuYOscQ7kNvwHFTBUe&_nc_oc=AdrYlKKSL1MSdp-XLdiS4nRaQBE3JcjzTcAmRsa877DcdRax6o4vo1yA8vn0ez3UTmM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcBUmwnZO-zgYZMyIx5h1uTIR3aMCX4La-u_81zp2l6w&oe=6A6756A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "1
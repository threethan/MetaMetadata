_ML4Vo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BB4-wB5s1OdKo74nHAitQvIVF_07DjZftHO53eo5Pgw&oe=6A3154C5"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFgVzmBtHeMQ7kNvwE63ubb&_nc_oc=AdoeVb-8yn1J4L9OnSFTrAPXz5dGBdbrppx2ealYa1YnYeQtMAUqguSeEmbZ8qPY-sk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93uSzxp9g5XVGZFhcAiNAzUKC9cCIKO0XJ_6JbVIsBYg&oe=6A31785F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7m-gmnCNnxIQ7kNvwFrSuKE&_nc_oc=AdpsQXemzwT7Egmg6yeHBaIYwfTKPfrJo5rHYn8xneR54-p6sQnVDeSm9h9ebTASBPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ArCmXUXtEmoCRDYJxPRB5gi-7w1Okia3NgMJK4D_9lQ&oe=6A314C19"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJ8JULHK1ZsQ7kNvwHMrPer&_nc_oc=AdodY6M8QAi4DTdjXDxkMczmx57kAEu20NP2V3zjJ8BGuGPDCWRoqq-j0TpdwU1GGGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9549rJMjTf1EzDyP6t3PqqkxSh3kCYBaZ0eYwMx_3FgA&oe=6A3146FB"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AltZ-cWZBRQQ7kNvwF_XKnp&_nc_oc=Adpp1usSmL462_j9aOsaA3NFV3P3cE5JqmRS8Ux6ZcTQgtn-IFbMPAPet_DrCsCQdnw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HpP9-8i13U2mu6urWqwJuPTYwgfS6Ic9goa2QpFNesw&oe=6A314921"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": []
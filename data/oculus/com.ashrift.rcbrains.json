_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mk6AN8CHanoQ7kNvwH54iIF&_nc_oc=AdoVHIj_-1rA5_xG0EEJyNx7OoBwxbliylsC-2EUvx1ozbunyzRWEan3xBRn-Gxt9A0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7eIJo2vyZwLtlLMf79Q0d5SEZJpofS6kW-M8UWkxVgg&oe=6A621D2D"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDHJTE6qNjUQ7kNvwFbQy-2&_nc_oc=AdrKxyp5CoM2wimV0SA-1XcBWwXto7iBwpZZqlZlkNkwsdOyo3BsoN5oalzid6N_57g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-WOxentE9nUShzq6eI3NzidZA6VSgluTDhi98VJYeKw&oe=6A62014C"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDykWysPZkgQ7kNvwGl3f37&_nc_oc=Adq7bgzUbsti6jQ6vIJBRcg5GYq_F3Vk1lAOSvznzL42vze9xbfY5x6Vhr0iD_dXJKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb5s0C60Bg3e5ZuHzztikhT-UoCLu-V6fdgYoMQk5PEg&oe=6A621C45"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucsyP_jx-6AQ7kNvwEe9XFQ&_nc_oc=AdqBJpo5ETv0Np0E9cTxBjAYHwS-9SzyxzWT2m8SmwwM_VKJt_m9H9Hny8d_XR6Ctdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFnTR0ct8DtQMMb3ADM1RrEV6hvoVuo1cnxfEDjKt8ng&oe=6A62079F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXqAt8gT-3UQ7kNvwETYUra&_nc_oc=Ado7mqAN6nEKp6Xh0_zlEldC-gPe1pSblserv4pVo1-JQQAkddvK9fn04967oZDIaec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmMIH9Ush_VkCVWpf0W2nq36ss5ivQWF37bdNSjjXLXQ&oe=6A621399"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpeixB8laXMQ7kNvwE37tbb&_nc_oc=AdrUv16lcTErk-NWj803q_57vEiMrmbymXCmy5bfHGDS_kQBO-0E92q0P15-zM4CfwI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvjWRGmw54dRjJLx4gPlrSrLo5K4KwZK45ZSKtJLY0UQ&oe=6A620E7B"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ye1-X3Hl70Q7kNvwGDg3mx&_nc_oc=Adp5fTHTaUHCZvxnPfT3oCRmSNGE-P9pal5GNAtFZoqnLTBBh0YvfEaqKYom4Fcd9Ms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDP8zezyiN2m8Yg6dby7s0xVKYO7KWY9HparGFuwZjo8g&oe=6A6210A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "11
7_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3ht-iSo82QQ7kNvwH6dXER&_nc_oc=AdqycxO-Phj8xv60es6uc1JKPxwpt6dc9XiPJHre5nKjHopIjcQpyPmpAtVOdUgPfWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHL945s7L4b1YGYMNQUcSgrl_XqjFtMR-kMK7pCfUJt7w&oe=6A75E3AD"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2cay_eWXcAQ7kNvwHN2tPG&_nc_oc=AdomrusoL0ENt1hNpERoiUyXMxna3yx8T0AZoEx4SeYqCkhznaHKgulvMM3ScQsC_ek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf-G-97AtfpnDpZ-MjZln5nGP_-clAgKGyxeUi5YGoGw&oe=6A75C7CC"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGgss0Ab2kcQ7kNvwFCKiFQ&_nc_oc=AdqVWnXPpICbqHQgXsQIN6MP0tRyiFQ5BSffsSMOZ428sl6LIELOPjN3PIAP5XIbxIo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8Ppo2oGxGaOsVtLzjpyQw46YpcYw8c2Uq1gfns7ZDhw&oe=6A75E2C5"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoeCdG1VVi4Q7kNvwHIG1fn&_nc_oc=AdpHGmo2XTwqwh0KiiXnF_sFkB0S_FPR-vtWAyfxK_6UYLMZCNI-raP91XePsS-HQ5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQaVAKtGC7H452wn4vrQo-j3-bZjbuXlg3vqpISqp09Q&oe=6A75CE1F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHZoMnlYH80Q7kNvwEUZyE0&_nc_oc=Adq9wSXZQ_RUuw1hvySFTXn6evKxYgYeKVTqpa6BDk5ar-Y-7tyyXg6DT9vYWrVSYjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3sMQdQu6inBe20dp9EUT6yEmcUkH0qA0GfUa3SBYcBA&oe=6A75DA19"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpKLWoiEevIQ7kNvwEGC0wW&_nc_oc=AdpLphWfcWugojsq-siadef57r-Idc1-_gDCFV_aZXtVuHyyBhPrqPgkWIB2m2xvffE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw0dxlVHY4xWJWfuuZkA_pW9UyA9l5oPxNpwposR4atw&oe=6A75D4FB"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMausOCfleEQ7kNvwHPOVPb&_nc_oc=AdpN-A9VW3oxteubi-4YRUEal8qe_tXRaL7RlVetx2NXVV_JICEl_CzKePy183ktE-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlcH5X8QcB0FgIEXZ5CJLZQH38CGMMvza4c3D8q4ARCA&oe=6A75D721"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "1
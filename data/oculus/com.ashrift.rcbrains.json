_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75uoV6KL-C4Q7kNvwH1r2To&_nc_oc=AdrroaVloD-kSeAhndFo_TFowPBDjPn5SnQP9QvyQxj26gNRik0tBVWKxHc_kRJw21Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXhrOWa87Smg22uQSHWUx7ZhS3NI3_GrP31owTY2LfyQ&oe=6A4D052D"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HDtzpkJoLcQ7kNvwETdPEd&_nc_oc=AdpQl1_o04u5lC6s5DuTy9zPa4ZXmV9DNilCNWIv744_B_g5uMWLreyeVTC4li_BtRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC086dAlOoTa1xP6whfayznGfn1oTevHR9fNgCeJKSaqw&oe=6A4CE94C"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ci4qbbr1ajcQ7kNvwEvyHn1&_nc_oc=Adp42mSTSaBKZAG2OzuLgJCVBmGWlWESJjq7jWgUNmofkS5YPIoLIp6b9XM5aVqpeI4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOv_TMNnF04r0w6y88pSV7Tud9bEfwDEFqpC6qpN4Nbw&oe=6A4D0445"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moaHDJ_coLoQ7kNvwG4c5HR&_nc_oc=AdrgjZOmRpZD3VaCkR_t-7bq9QAtdLnMNmFtMrfS49XgBA1UpBSxL3MY1kQDd7IQjxQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwxlD0xlRNqT5DID9_h6CcQidR2RjxIyBH8OuluInERw&oe=6A4CEF9F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POnzcFSl3B4Q7kNvwEc60Cr&_nc_oc=Adr2TQy5BJ5BendA5llflZjyfit8oLY65UXzIBVWk8_HxvgrGnE23F6FgLEgeq5SJKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmL2ztXmi-acS16nGkaJ89cNp-OVfTbroiindhlkfY2w&oe=6A4CFB99"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMQqpjShMGMQ7kNvwHI4Vep&_nc_oc=AdqO5Og7W3rQg_Z0ei-nZ9J4SjaJ-T_ZfkBZKO036rRrwohZ6VTzp14aEGwECZbTzSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCl-_aaWge-c6c8tCxrnl8P-JKvxe0j6ivaxrvlhcbOhw&oe=6A4CF67B"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okY-yln4HdIQ7kNvwHtBO8d&_nc_oc=AdoW8749Px9duZIMwfrsbF_88ZNeH3W33dxk9MmYCF4HKxAwUyapdXJNX_NiosFjc_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA71WPXf1uWcKwlXZKm5qsVmhLg6DaIMoTdwAAChhz0MA&oe=6A4CF8A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "11
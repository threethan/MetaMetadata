7_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkWcNpw2kygQ7kNvwHwRIgJ&_nc_oc=AdqAcXCf0LuQYtbwScKX6eMp2m2N5I7unk5JirOpsOR5shCIIeCMSo6yL2XcBCxeEnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1B2uezqUcXLmkbrzH1MVQFUF7MmEHMQ5Nc2KQEEqytA&oe=6A79D82D"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJzNsdafs4AQ7kNvwGjZwsQ&_nc_oc=AdqS2XkwXNmwnv1gGWTd9IcMEgzy3G2Me7Cx4GC0382I_N_96qQNSiHeG2WsUczCv34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyt6JG_rLLEneI20FO_1JlI2VrW7FHkxtBPKkir1RFLA&oe=6A79BC4C"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7nK_NWFMcIQ7kNvwEa8M9Q&_nc_oc=AdoMtr6Cux9I_ucbBPF18XvRaRP_5z-C3IbWNA-qrwrOsrbwXYobvFsrFq3B6uckSeA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOjkwPX3Msqe12VDs_5JYEvmeAZ-wE5f9-tZAs-xFYWg&oe=6A79D745"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWLOpZ5mYc0Q7kNvwGDKeCR&_nc_oc=AdrOkLD7o8CItblk6AfytLMSJ-trEu3om313M4kOhyqbSZUiQkzUujMS_OW0JAEsmYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdGeM6cwp9GgZxQM5yYib917DI91AUHeJjLgc_utJHow&oe=6A79C29F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjw4qEJ4cJEQ7kNvwEn6ECn&_nc_oc=AdqGfctQJFrE7L8gEnDj_RLLdI2F5IDabGXQJZjwDrhtfQoXNjduZeAVISNhs5b3ubM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEarRDzQsgJ0p1II9wBkaoaJaW-1yr_TVn4J6ZpdG3lDA&oe=6A79CE99"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqkBnbmuBuMQ7kNvwFrX0l5&_nc_oc=Adqm3WjHTcRNh_avnvbAyjnyCT1mfI41u3grUl97Vx7ysCUM1EP6TP_3Sn1dR8feGrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcIlJm0r7N1qC_WuGV1C5xblhXt59zfu1Quss3OR2TwA&oe=6A79C97B"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfZRfV-EvOsQ7kNvwFhc0Od&_nc_oc=AdoDUNwZqsLc6l7yytDYH3vs14baxMo-Sr-WoSHqEBBJw19qtMFmB940tWOyOnxdN-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHa4LHnCCxari1ZZPbBXL4HPVUsJHv0DUvVAbJdHfLwYw&oe=6A79CBA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "1
7_1360417929134412_2810673684869633529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGN2ytsK8YIQ7kNvwFtBoPt&_nc_oc=AdpmdACTi-j9EWgUnsVup9y-6FfIvvniRWw5a8zRBmScLOc_tJ7L_eD3OH2Ol9Wgzcc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-URJ94oNjJXjgPuI9PRuzAgA3n1N4V7QM5TU8faVYhw&oe=6A68B4AD"}, {"file_name": "RCB Hero Cover.png", "id": "842690088363578", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618432_842690091696911_7686738864932529054_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49YIHs2lXIcQ7kNvwH948qb&_nc_oc=AdqKDWWTguUB0XKWuttae63W4o7zca0MDhtqNh9J2MNtc9Ra7xn4ICvzAsEpLIKiZy0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO4BIF9Lyv9oA1r875bd9rJubHKAJICuq8OcdrETaIgQ&oe=6A6898CC"}]}, "id": "855774153657648", "locale": "en_US", "screenshots": [{"file_name": "SS0 (1).png", "id": "2097483167677285", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819854_2097483174343951_7810866921235356625_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyoojs_Isr4Q7kNvwFaNeek&_nc_oc=AdrFr3kjAJAKq6gnN-MfyhFc6YWCVx0TRkwuaUJ63RF3FHqB1IM73SjR6lldv6Ze4ag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuxxwWUAqSWWSP6L5ooROGQdmfGfs1h_rVgh8dFu8KZA&oe=6A68B3C5"}, {"file_name": "SS0 (2).png", "id": "32676251345356251", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827585_32676251352022917_6643009885585739264_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX8GBhXj1xQQ7kNvwEqPbHR&_nc_oc=AdrbAcvq5f0n8T6FeepiTPJgfh-nAbbvUeN9bi0Odh_j3uLWOKUZEj8QlzefPbWHJSo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD30MUkLkT5KpIrXf8Qc83gcxGKZMKun5cIMekHyZZgnA&oe=6A689F1F"}, {"file_name": "SS0 (3).png", "id": "846209271291199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823790_846209274624532_5306726970749836577_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wg0Xzz-lhwQ7kNvwFAQ8bl&_nc_oc=AdpEAXtoIfndRpeHDVBDjx1A2n0BfrLMP2SNxu2LJbJq3bUuhDkXUJs5rFppXwo65Vc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4mGaVV0KXypd36Q1yCYrMXu07yhBy2aHNZh1AlJ0ReA&oe=6A68AB19"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aWzegA11uoQ7kNvwH5PwVU&_nc_oc=AdpuCn9PuMz6ql-STZ0AmwKcnkV1MVAwyWTwzLmPTi-Ly81W4TXdnsIyFCWL4u0HuQw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfwDNOE-RUwW087dIbIZPRsMrBkg50FXLF-KP0B2k0dw&oe=6A68A5FB"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBxSs-g9ymIQ7kNvwFnePe9&_nc_oc=AdruOU5VA3eEPnPj6zHjfNO58d54oS5f1bzJZHy8ilKOaLTpdMb_z2vUCQj7om0UDn8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM0upMSmzQnFZ-mRCicxlI38YgfCX_WPBPC5KtWaL6DQ&oe=6A68A821"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "1
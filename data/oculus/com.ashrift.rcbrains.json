E8dkdsaQBgbmc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKdw1qdbyUYd8001sse1xKg3OaR7ruIq2BM55aJil_rg&oe=6AAFDC19"}, {"file_name": "SS0 (4).png", "id": "789336280781761", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821702_789336284115094_148335083959484048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjSl-rZ-jI4Q7kNvwFMhYG3&_nc_oc=AdoRmMRjOu3uXz2x-trrO20GvISQBTfWQ4N-fK6VDZq8Ia1KV7pP7AGAv3WmTtVet6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6XVj9aMN5IfIHQErzCIrxkV807Rz6ZZHoh1ss7p0sIg&oe=6AAFD6FB"}, {"file_name": "SS0 (5).png", "id": "1168859691564546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1168859694897879_489238071598755168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAV1gx74u3UQ7kNvwGwGEjk&_nc_oc=AdrDvyG7gvK2CW-jEsVjlYCrRIBNjb3UMr0a_YWNtH56-yUZPDZHIR0pyg0Mbtz1Sok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgs3gWMPPUcMi00eVfsYwj4KepwKv5TLhqQOrPKrJEEg&oe=6AAFD921"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "R.C. Brains", "keywords": ["racing", "socialvr"], "long_description": "RC Brains is a fast-paced social VR game where you collect, customize, and race miniature RC vehicles while playing as a Brain. \n\nBuilt for chaos, creativity, and community, the game mixes arcade racing, physics-driven toys, and user-generated fun into one endlessly replayable world.\n\nExplore a series of handcrafted tracks, backyard arenas, and imaginative challenge zones\u2014each filled with hidden shortcuts, jumps, props, and interactive toys. \n\nEarn Brain Bits to unlock new RC vehicles, cosmetics, and seasonal rewards. Master your driving skills, pull off flips, drift around corners, and challenge others in competitive races or casual hangouts.\n\nRC Brains is designed to be simple, satisfying, and extremely social. Race with friends, compare your car collection, show off your Brain avatar, or just mess around with sandbox toys. Whether you\u2019re climbing leaderboards or chilling in the garage, the game rewards creativity and personality.\n\nNew updates add cars, tracks, quests, and community-requested features. RC Brains is being developed by a solo creator known as Dev Brain, who builds the game with direct input from players.\n\nJoin the community, leave your mark, and help shape the future of RC Brains!\n\nDiscord Link: https://discord.gg/bdmxcFUTZ4", "short_description": "R.C. Brains is a Social VR racing game for Meta Quest where players play as Remote Consciousness(R.C.) brain avatars that move using Gorilla Tag-style locomotion. \nSet in a cozy suburban simulation, Brains race and hustle to earn the Brain Cups and of course, RESPECT! "}]}, "developer_name": "AshRift Studios", "developer_privacy_policy_url": "https://www.rcbrains.com/privacy_policy", "developer_terms_of_service_url": "https://www.rcbrains.com/terms", "publisher_name": "AshRift Studios", "support_website_url": "https://www.rcbrains.com/", "website_url": "https://www.rcbrains.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "24383835711289743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1187337930066885"}]}, "baseline_offer": {"id": "1187337930066885"},
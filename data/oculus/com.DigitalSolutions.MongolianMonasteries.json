2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kelWU0Phb4IQ7kNvwFGM5NM&_nc_oc=AdoKr8qawZlzmICZZB6zjoWSH9WYLKi3CEv6VPpzIPhBaHSlqjMrHmjnyRrlKBuOyxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgJVpZxKhdHfC9Edq9dGI6BkwclLSCCjAxZ8YiNd1ORQ&oe=6AB15532"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dP0JNbQObA4Q7kNvwFqY5sy&_nc_oc=AdrEQ4PyutGnujsiw2a8-LXhFWisMiaQQ5I2lz0hkDs1eiDSxFEqxAcn1brrdZhr0eQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkQOiMjHWaE6jKY40i5MEQ9rC3sa3YPH2kFq89swbqyA&oe=6AB122FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2ij03YFwp0Q7kNvwGJq_fr&_nc_oc=AdqclJohFDnJwgqKWeCa1BeQ99n4upZgt4_2_PpmNZp8Aj3rdmOz-6Gw0c12R9nQR4o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY-LJd6kmX7VxPW7tqOsIZXmzJvsyEW0-qnZMkM7dVoA&oe=6AB14768"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
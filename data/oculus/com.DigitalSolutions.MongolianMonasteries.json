2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBEj8vy9XYQQ7kNvwEUWcLI&_nc_oc=AdqVR_Wf7irNDKPUzSiRDHqa9NDgUhb5FtFzjJrMSb1a31VTXvkD40D7whvcs7y3aYE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdHpfX46pz4LPGz26fjZT0cUlGILa5Zr-bKaFJ4ijbYg&oe=6AC91032"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJepzkHUZJQQ7kNvwGA4vkS&_nc_oc=AdraxXczuL7krCPLDHZI5iZrGkD5kKwW2ZexCseqAmKX8yitednH-NwCpDcgsm1iLCQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN315voPq2dd28ZH53TaVca5TYewl7kERsAnSDincyETg&oe=6AC9163B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xF32zDUiIzUQ7kNvwHTNwSS&_nc_oc=AdqxsX-YZRwrltm46yz6UIWoO4hB9iJzVrH8pgKoKrRnfagL6xhVaSOmQpE5gggb3gQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDFLk_4BeP4U_J_Fq0VRGDtc5kCK5NWZJjqZ1dyNVxKA&oe=6AC90268"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
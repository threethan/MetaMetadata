2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYOHvYVK8zEQ7kNvwEZAUdT&_nc_oc=AdpwUOPnXwedfhVSwGbAehYGF85W55Mb9ouy0cr-0Wqgz6KIHJjSX5i-FfYmUTWzDns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYVg9xDu57fbFgoq-DlFtRxpUgDPlbxcCpIM9EAPcJyQ&oe=6A999A32"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-rHtGz5n-cQ7kNvwHSil-l&_nc_oc=AdpHpSvxfpLZWX1SslDAz54J_dpTPi_dphVWMkaIjvFrqclanWJ3DktAmXcpGXZVPDE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXzXVlx4gNsyDIQhZeyL5IVn4kXF2GtqkZ_w35zwYlyw&oe=6A99A03B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkFAgVSPCWsQ7kNvwGL847e&_nc_oc=AdqWvaMYzD9QfI-Lr-BRM21ym7Do9EWMf4gfaGOh6pnVxIPEaDrCzUENMTH4AkEBhko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1knE1mceJHHeanrSR9KJ9IEONAL76dzONAve9Hwtmaw&oe=6A998C68"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
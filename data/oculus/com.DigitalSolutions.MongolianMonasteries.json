2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3XOD1Iq9TQQ7kNvwHDYAol&_nc_oc=Adqbf_ArBLUIfAo1hDNCv_EBLLJn-C2c2ari8KIQqwCs485yvepRw4MRNqn8yefohCs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjGdmLTs6JiWN-JXoM0cCGiXPDg30VMqR2qYmnQyw5OA&oe=6ADCD6B2"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWglFJplvvQQ7kNvwHe3Hvc&_nc_oc=Ado8bZM5M-5Hu26LzGu-RzbfiHLl-oh_EEapnbn1_tQ2vEfLDyYUOx1KFFq3XBmI-dU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ0nPTzNTqfBc5L0ulGZHXg2srdoh8nSFcFs3KS1le7Q&oe=6ADCA47B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhdpRbZGw3UQ7kNvwHZx_ly&_nc_oc=AdpcvkgauFCYExaBGOZ5XfYb18MDopOUd75FhEgxbW6_LsRbYswo2_Pm979QIfoORDM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzgbXIqDd5m9BztILAxhXsiKGhVwdSL6SiECgmBVYKQw&oe=6ADCC8E8"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZeAq7oIxIsQ7kNvwHQiT_L&_nc_oc=AdoDKTl76oRmafEezMxWC1Wanz6zd4F4H1zrf4YO6KU1Xo1MhbO2IL5mD67PjcjrquE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4KINA_bCj3XJufLo1tHd34T-j5TxMUvODIDv4Bg2TwQ&oe=6A9178F2"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2IK6qve7WsQ7kNvwGsegGN&_nc_oc=AdrL6T9wjE2H9GvDU6yi44VQf8j0fBQEbpRbqJEJwXCHfto7tFnbrWS0_0R7s74pXDk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKWQYGu102C98iwvQskAcRrN7jvzUKyc02U70WzrhEZw&oe=6A917EFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk5JAeY7uQ0Q7kNvwEfEV4_&_nc_oc=AdpU1PtfFc4LHSeYcs2rDVYZ7E_0eY5PfEGG7XgpLRIYx-_XDldF1_2cXMOMR-Ceng8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_qffwZ823OszLijPy_1LF3w6ZI01G3NbXOYhv_rv9Xg&oe=6A916B28"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
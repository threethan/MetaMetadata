2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agIHomaWW0IQ7kNvwGD69FC&_nc_oc=AdrHi6b9EL9HIYxQ51OMYiPDIYscpspqDwgqzv7QU27v401bzxPWWxesaBAifYsUILk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITguwszDOeKA3NQk02CSUBxcjbHn5bSyKv7V348h8SFA&oe=6AA29C72"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffnVOsYSNdkQ7kNvwF6CxvO&_nc_oc=Ado1-y6Bizi-zutrD9ZyvCYhVGsdB1q82dr5LlYDAO54JvteIR3-VMaXoQAbaAHiUvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFR3cF63QiRKAW9XdRRptJsiDWS1JFTY46FXKvyDln0Q&oe=6AA2A27B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALqUFILkK0kQ7kNvwG8Jx7T&_nc_oc=AdpEOzeaty4nRTqYj3_1y09jDR1z26NVx7UxnfHXbclo21y5FziQNF60a1FQ4Pclx5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgqjlbkgS5vsjVct3wzKZ5R6yti-qTfkSCYexCI5u2Ng&oe=6AA2C6E8"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeL_-l6llpsQ7kNvwHKAgPK&_nc_oc=Adq3P38ZjrsUr6-mRYnDDWlfOo_0dliYqoAydEf9Bw94Szc6S_YPthVJ5B0iGzKsq-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-OhIqDwAhC1LNqayl2HrKFDWu2T8v5lQCKEQLyazeSQ&oe=6AB93E32"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nz-db3IGDdsQ7kNvwHvaiMv&_nc_oc=Adps0nmuVTyRlvHKgb7Gl35BTPw3s7MbT61zuPqyJTNdq90P0I00qi0-WCuWAPevtZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV4z2I55hXqLkaqahWlJY5KBcMxP2GuEdf9IjIOrIAtA&oe=6AB90BFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIMUMOyCG3gQ7kNvwGBax-D&_nc_oc=Adp7pRK6-B9qqACU6yT8n9w5pdp3z59BTEhsOLbgmqoEN1EP-whTo6T9BOL1JTZexKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsWPvTm9IVf2q_CIBYZWiovRSkgFuOj67MlVJdTfpyTA&oe=6AB93068"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
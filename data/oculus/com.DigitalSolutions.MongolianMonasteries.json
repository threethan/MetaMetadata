2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRgM4phnV3UQ7kNvwF_FLdO&_nc_oc=Ado5cMA5Yy17vxafDAnFy9TjRJxzX_AK1Tb73oXHaqZr5jb2SwxgFOAVqQJ1yVGow8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIE2QTcGujmAP5Nf71dChRV3LKRBnWXq9OtVJga0h2Yaw&oe=6ABBE132"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyQTm_CW-5cQ7kNvwF4lJ1A&_nc_oc=AdrA4LbYefggISoxV5prs5ojjA6dgwZsfcblhkxt-_aGJgiicVCA1EuAvUnUszeD2R0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwZbqfQT2r-7_z3xhApPNddpBRNRqHeFNuMp6XVA-6dg&oe=6ABBAEFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_OifWN7wYEQ7kNvwE6YXNi&_nc_oc=AdrQqZNrgnJSQuhBEdGcaLzWVoWm_gkGmCmYDNIhxsLWwUojuNhal1xCNt3th6zZVZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU_GQyuLghg-oOswYpKlxVmsaHbGUhS53R4d1pNNez_g&oe=6ABBD368"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htkPU7Nv27cQ7kNvwFm8kQe&_nc_oc=Adr81AwDWaO7gDR2-EHDsknEZ5yxv0ZTbcRhKpQpBLxYb-gRZDUv1FHm7lwWN0YPdkg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6D6L0kJJHGsOAVTVqQyj-PvlXK57YmUQbgLcEqTsI4Q&oe=6AE0CB32"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6pcqpJMdVkQ7kNvwEhBlTD&_nc_oc=AdolKqQITJaHcRDS5jXzPvSIcmeBj6QOWq3WT_6c0Hfq8R6e6yuz-teB3FaojRXX4nk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ4CJhTk8OkrckCS9DG5zKpLCcsX14itcN0gpxn2q-zg&oe=6AE098FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HewBWYzMPkQ7kNvwF7NtKH&_nc_oc=AdrSwFhhlSDSWUTqbm0nGN7jNlnGPDSN-Ypmi0Oq2qTaM5u5U7wsoPRjTFwERaGic94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNluPbSgTo-69JQapzXEFL6m8hiD7_xwalgPGH65hL8zg&oe=6AE0BD68"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htkPU7Nv27cQ7kNvwHaWxFc&_nc_oc=AdqKvs2hzXZJsH3j0JPXEjnGUv2i6vPtEACg_VuruUrFLE_vNcwAB-0hi-nFMU46-OM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOplw96jOEI9Re3Nkvfo41Moh5F8gf6IAigJR3DaPL1MQ&oe=6ADE2832"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWglFJplvvQQ7kNvwHkPjwY&_nc_oc=AdpCbpIY76KneZ4g2MN0JQK-o8Bj3Y0K9CBXCDAdrPD3uH-1pliEF-mvF32mH9sqZqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3VQa6MYp_hoQDtdg_aHwmDyijoIxm3dbkHeLj795ihg&oe=6ADDF5FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HewBWYzMPkQ7kNvwHnHbpe&_nc_oc=AdoojYjlHDFH5KHHijMzvu027VL7HYKNcMCsxCpsFMjmbD2nFgjxTyPZkdIdsr83uzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfsr002Tnnzv4rVHf0p4pPrQyzT2h2d2lvorfBEE5dLg&oe=6ADE1A68"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
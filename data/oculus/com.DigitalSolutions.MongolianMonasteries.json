2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZkxNfmJ8CMQ7kNvwHzJ3E7&_nc_oc=AdqoYco7SdnyUAS6_4s5GSyIv76S_GtN1UzSrhYkk84n8oFgJX7LdcuahGQlVhIutR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRy3Bhe5fP9R00E_qWNHIvfnU6Rz-FPrBjPI1GckYCOg&oe=6AE4BFB2"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZR1BO8ioKJQQ7kNvwFFHPim&_nc_oc=AdoGYY82gNSrGaKqsVLOYVFz3tPQzR6yVLoSnkb8OBNmfoXhKW1j3slhi2gsFh1K0Wg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDQnI0wxtc7awtvGvxfM5A8ZPmqLqurgGj6jyX5H8sTA&oe=6AE48D7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc6b9mdsQxYQ7kNvwH6-LI5&_nc_oc=Adr4Qdu7pA_zaN5aB1lG2NQ2bsvsE7jbnOf02O7ezWXeV_nkC2A2e0xIiYQvB30d_TY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaEXJYqNg6bfIcXLKJPFG14uhJs2iLZObDtMgQWMhKiw&oe=6AE4B1E8"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
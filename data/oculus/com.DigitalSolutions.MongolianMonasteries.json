2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y45pnNbCLJ8Q7kNvwETYj_3&_nc_oc=AdoCoyvI3aJs9KBYRD0mONipxdhwid8IKUgggO8zItuAz7naGRkBUHO24ANOxBQk-HQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2C-hEhOrTK2NeV5KakGbUE_P0INauRoqSvaqW61VzVg&oe=6AF88632"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMzqjYuqb0IQ7kNvwFS6nlC&_nc_oc=AdrBQ38qGpKmqYSqZnoBX7TrU3ngO0m4yDPaeoNiQKOHuDKSoCLheC2VIR5G1NrRVnQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqqG8ZNJq-hpu81YTDMhuZR1LyZIz1HY8RNlJz8PNN8Q&oe=6AF88C3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXDxPetO2BkQ7kNvwE5PhQX&_nc_oc=AdpSpmD0RnLKE_1s7XNHhl35CiXP84p7DOYiRufD-JNbm_Eo5l3sTYal7Zud0ju7FW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzSTbw4hD2SXR5U7ZDaUgerpl_w0LAU15QVpDNi-sRjA&oe=6AF87868"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
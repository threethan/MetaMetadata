2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y45pnNbCLJ8Q7kNvwElo5Jt&_nc_oc=AdqTCXQ7iYHTM943-lUKm_UjRS9Ihnt8ShbhM3jVEzwSyYMpc1H6-XYCrEqEAMvl5r4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvBYOOfRPtyf4oTBS2GUOdi-lO8qMfdeIVihpYjPdmow&oe=6AF734B2"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMzqjYuqb0IQ7kNvwG44p-x&_nc_oc=Adq_zW0yjEdsddLEsqSLbZECM-WBAHeyG0-iK7n2ZXqbryFsrIyjqQ232qoznburQk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJskymbd25IKM4wVpQRBZEsXura_neKFb4kX8FY-Nuew&oe=6AF73ABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXDxPetO2BkQ7kNvwGSjnFj&_nc_oc=Adoz4R3T69Vqe_TnghELI5iaMOI9h_aXL3Jrgc7YG8sSZJEuw7W3jxWB-uD2IzQAAd0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5WtB9AW9de6AYFJN5X5nX7x3uK3_e8ZI_WWdAlKjRCA&oe=6AF726E8"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
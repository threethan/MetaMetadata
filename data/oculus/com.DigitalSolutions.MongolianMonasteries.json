2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuLBJsEkduoQ7kNvwFVZBUo&_nc_oc=Adpk4RhAz2paA4TB-YIaFMAttdshYfcE5VDLsKIIqmBjAiUfNAxP283faryIiYLN1cY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEY6VqKikTF_YiL9f32oHdtp9ljuOaRRlcR3nJm2ZSqg&oe=6AC3CA32"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj-mjlg2PI8Q7kNvwFtpH9G&_nc_oc=AdoihMy1i65PIJwQe6tgqYXBwLZFqgwuHVBTyiZ-n1dOvS4YftGhDwHj9GDqf1j_MrQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtae_JqPymSXxMc8bZBAys1hyEmCl9rl6HeCQEgIN__g&oe=6AC3D03B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKKu574WTKkQ7kNvwHZ28GD&_nc_oc=Adp7ThL1ZfXjZeiLdcD0-rLzfjWUxIJr8Ki30xMtXt2G5GRL0rsB5Vb-zC-JErlACdo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND2_IcbZ69TTa1eeJEuQcc_btkLQVESNYHwwuT7SpHoA&oe=6AC3BC68"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
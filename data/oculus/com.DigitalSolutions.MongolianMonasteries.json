2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmPw-F8MwDgQ7kNvwE2n6GJ&_nc_oc=Ado2kM8satqQ7OdIzEnVEN9jhTKIt2V8FBafQH2fQG63zYeU6-zkxeDXB6Nw_mgnIqk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNJag1qlixTwqxXEKrBYH_xdX-5iJIzcuvaRQy1DEL9A&oe=6AF09D32"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kY_PPF8t_RkQ7kNvwG0xmHN&_nc_oc=Ado9MVEFe91oxV_CA0eBK1T1qYy9t9NtTh7SlTXj0G-BATs1UMH4m7oO4vz0v560CEM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK2q1MlG_8cqRLlUSqvuk8OFYz66U4KVo_47H0P9tQbQ&oe=6AF0A33B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsIMrgVkQTMQ7kNvwEeEINT&_nc_oc=Ado46-V8uD5iAD7wZ1ldUEus-oQn8G8JlSBWq2Tuw3f_VdNauzoPlvQy4Ee-_jY_r9Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0F10VoBSgp2Pj9lKiJmwUU0JrhraqmrstVDPpgKfIUg&oe=6AF08F68"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
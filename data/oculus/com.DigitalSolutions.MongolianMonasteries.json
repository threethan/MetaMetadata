2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeL_-l6llpsQ7kNvwHkepYt&_nc_oc=AdpJYt84CTlIS_fHGViGgjV_hYUTeQV_TZjmQZ1zjI3owbeq_AP4Y5NzhFXUwdUK7zU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT_gbL1TkPlDM-X-WaBpMsRoxpFV0xQJRbP1uwyn4OzQ&oe=6AB7ECB2"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nz-db3IGDdsQ7kNvwFZ31vH&_nc_oc=Adpps7MvS2Q9CnTCyiid7ysTmW79OThSZegTFd_GGzTR_aJ9QCvIcwTTSo6s0O26Ef0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS6la5_MYmBhot7xOh3BRZe8liX2c58CiImOqjfXpOzQ&oe=6AB7BA7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIMUMOyCG3gQ7kNvwGctJUm&_nc_oc=AdqddUmylEoLMOMaziKOPtgxHfnzVxRrSfk1G03cvhh-VJutrlp3cOhickYSNrMIlc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKscf5azlhUhWQxtYl0NKdEV3pmSz67O0d115iItjsewA&oe=6AB7DEE8"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
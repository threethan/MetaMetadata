2565859508282523768_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sF9iIXFBPjcQ7kNvwHSPIAx&_nc_oc=Adq0k_ePKGP6DB-5d_mytatXwfb3u-TxTo-FJ3yfiLS-ZXPrxPR0FIxAWcVx_19c0XQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6Uc51rNAkBU5MjOHx9z0shRUz8A3D6s0IUKUPT1suaw&oe=6AC12732"}, {"file_name": "5.png", "id": "1873600503076651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569425_1873600516409983_2232898197983722663_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JZqFYq7G0UQ7kNvwGyN7DO&_nc_oc=AdpYSIfUFSeVdabtWBGOwXruHQBcPSp2ROG9efEnoy8VVLzDsslXiiCdNRLfY1I4Boo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpWJCU-FgTs4UjoWhr-YemfbWyKvgjCbvx5zICXmZFLg&oe=6AC12D3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1065033391267052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75230043_1065033394600385_2816752064701902333_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6S_Bbl5EIhQQ7kNvwFLR9ql&_nc_oc=AdqaQtFqExKxbqz7edfmLQnPQDLlosSmjlivxbGbeiL4m0vnYGzL9CHeZGOmoai9CMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL3cCmIiPlsuD6T9IA5F8lixYP57ZMC-cjW1U52OIrtA&oe=6AC11968"}, "display_name": "MongolianMonasteries", "keywords": [], "long_description": " Experience the architectural beauty and spiritual tranquility of these historic sites, from the intricate carvings and vibrant murals to the peaceful chants of monks. Each panoramic image brings you closer to the rich cultural heritage and religious practices of Mongolia, inviting you to explore at your own pace. Discover the history, art, and soul of Mongolian Buddhism through an interactive and visually stunning virtual reality experience.", "short_description": "This immersive VR app transports you to the ancient monasteries of Mongolia, offering a 360-degree journey through their serene and sacred spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/p
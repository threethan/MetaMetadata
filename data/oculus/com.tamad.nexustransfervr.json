\n\n\nFEATURES\n\n\u2022 Send or receive files and folders over your local Wi-Fi network\n\u2022 Transfer multiple files and folders at once\n\u2022 Optional PIN protection for incoming transfers\n\u2022 Secure HTTPS transfers with device authentication\n\u2022 Local device discovery over Wi-Fi\n\u2022 QR code scanning for quick connections\n\u2022 Send selected files and folders as a ZIP file\n\u2022 Web Sharing for sending or receiving files via a browser\n\u2022 Transfer history stored locally on your device\n\u2022 Choose where received files are saved\n\u2022 Light and dark themes", "short_description": "Send files or folders over your local Wi-Fi network."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tamad-privacy-policy.blogspot.com/p/nexus-transfer-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "TAMAD", "support_website_url": null, "website_url": "https://tamad-privacy-policy.blogspot.com/p/nexus-transfer-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1245319578675325"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "29042060475378027"}]}, "baseline_offer": {"id": "29042060475378027"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790215140, "status": "PUBLISHED", "id": "29042060475378027"
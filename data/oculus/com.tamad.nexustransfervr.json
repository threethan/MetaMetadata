6tIp&_nc_oc=AdqUw0kbNeC-Y7THppECutDwfYs65F-YAJzeub3GRrXJJkJRDt-WePvnY0bZVzfuITk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpErgmXzgAm_q0U8OPUQU2Zh5BUKTU10iAZWf1zpegKg&oe=6B09C9C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nexus Transfer", "keywords": ["file", "transfer", "send", "sharing", "folder"], "long_description": "Transfer photos, videos, documents, folders, and other files directly between devices without uploading them to the cloud. Nexus Transfer works across Android, Windows, and Quest, making it easy to share files between your devices. It is designed for local, offline-first sharing, so your files stay on your own network.\n\n\nFEATURES\n\n\u2022 Send or receive files and folders over your local Wi-Fi network\n\u2022 Transfer multiple files and folders at once\n\u2022 Optional PIN protection for incoming transfers\n\u2022 Secure HTTPS transfers with device authentication\n\u2022 Local device discovery over Wi-Fi\n\u2022 QR code scanning for quick connections\n\u2022 Send selected files and folders as a ZIP file\n\u2022 Web Sharing for sending or receiving files via a browser\n\u2022 Transfer history stored locally on your device\n\u2022 Choose where received files are saved\n\u2022 Light and dark themes", "short_description": "Send files or folders over your local Wi-Fi network."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tamad-privacy-policy.blogspot.com/p/nexus-transfer-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "TAMAD", "support_website_url": null, "website_url": "https://tamad-privacy-policy.blogspot.com/p/nexus-transfer-privacy-policy.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QB0VrANkp2AQ7kNvwHqReYB&_nc_oc=AdoQFgtuosDF-EEwMyrNJ17Vx1hQwCm8pvC8uy6_fOTs4osZauz7lf8aYNvXsS7-rt8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-koKIRmGP_sf9NbbqZkAV4pscQctR0_tU75aluqZfRIQ&oe=6A26B92B"}, "display_name": "Vegas Casino", "keywords": ["Casino", "Game", "Poker", "roulette", "Spin"], "long_description": "Welcome to Vegas Casino VR, where you step into the shoes of an ambitious casino manager determined to reach billionaire status. Start small by serving clients \u2014 delivering poker chips, equipment, and exclusive services to keep the tables running smoothly. As you earn profits, upgrade your casino with lavish d\u00e9cor, high-stakes poker rooms, and premium amenities. Manage demanding VIP guests, unlock rare equipment, and master the art of timing to maximize your earnings. Will you become a casino mogul or fold under pressure? The choice is yours in this thrilling, immersive VR experience.", "short_description": "Step into the world of high-stakes service in this immersive VR casino game. As a rising entrepreneur, your goal is to manage the floor, serve demanding clients, and keep the chips flowing. Deliver poker equipment, drinks, and VIP services to build your reputation. With each successful deal, you'll earn big and expand your empire. Can you climb your way to billionaire status and own the ultimate casino kingdom?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads":
oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXF9gHfkKUnjHgRMeK0VbOlPzCM_bFGqq4zrXpv6a-pA&oe=6AFDCC36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "958552416258629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391830_958552419591962_1110866827389008655_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGZNE4D2KCAQ7kNvwGe_AVK&_nc_oc=Adrz_BtXLsfYwlNdkLKn_lUFWhOisv4aeXreoLozzPWQvVIVHBAXLeAf-7witYaHXyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqZr5Y4XhEZmOVo4ElJP5Ic7AKB2J3NoysMU8z2UCjGw&oe=6AFDD5EB"}, "display_name": "Vegas Casino", "keywords": ["Casino", "Game", "Poker", "roulette", "Spin"], "long_description": "Welcome to Vegas Casino VR, where you step into the shoes of an ambitious casino manager determined to reach billionaire status. Start small by serving clients \u2014 delivering poker chips, equipment, and exclusive services to keep the tables running smoothly. As you earn profits, upgrade your casino with lavish d\u00e9cor, high-stakes poker rooms, and premium amenities. Manage demanding VIP guests, unlock rare equipment, and master the art of timing to maximize your earnings. Will you become a casino mogul or fold under pressure? The choice is yours in this thrilling, immersive VR experience.", "short_description": "Step into the world of high-stakes service in this immersive VR casino game. As a rising entrepreneur, your goal is to manage the floor, serve demanding clients, and keep the chips flowing. Deliver poker equipment, drinks, and VIP services to build your reputation. With each successful deal, you'll earn big and expand your empire. Can you climb your way to billionaire status and own the ultimate casino kingdom?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url
n.com&_nc_ss=7f20f&oh=00_AQSPcnbEYktYy5QJZbejR41H-3O3uyHxKX-f7mfwInZO6A&oe=6AF1D591"}, {"file_name": "playscreen3.png", "id": "1508748117945841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593767690_1508748127945840_6371510530272263231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlBW7LrqhkAQ7kNvwGakGgO&_nc_oc=AdqUJYvdl0SHOPEu5Z9Au7XKM8HaYaYGyaDXtSsekDfWgvsQClnlAmLyMxUlaWJJaZk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThleJjIFSgMOGoylc2iYJNaqSHgZG40nl11BdbzUkDyQ&oe=6AF1F540"}, {"file_name": "playscreen2png.png", "id": "2141629750032778", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622195_2141629756699444_4007357030527123398_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7hwE54jm18Q7kNvwFEzDfV&_nc_oc=Adou6Md1I9Dey1yl9HSdjm_EhxczxtcSI2H389imbH7qskML0_WfgXbLKKCbihhW6pE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOdioBfodp17yB3Mnu3ajY7-9-TipSfPmTkskn3kVM1Q&oe=6AF1E18F"}, {"file_name": "playscreen0.png", "id": "1390674822493844", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628909_1390674825827177_5444099470846936250_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoiKvLdkKr8Q7kNvwFdpKt8&_nc_oc=Ado2_lcBINau2PmRQ2jYGffnIjpXb72sd_JRUrfKjIgpwl35y0Y_f_w2mezCLprDhW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWkySe8t-NoMNqRFJpngaLh_-qHqYTDLXbN5hlgsnmWg&oe=6AF1E017"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoThumb.png", "id": "2133935010523589", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623512_2133935013856922_5956353856711629932_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-ayWMOpNk4Q7kNvwF0A4ZA&_nc_oc=AdosIJ4GXZOvbELciCGv7oAcsXE8tM-jE62HaP40wwsLRHE9KuKe1UhAmRXaqhnX5VQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRy4n3P1xGsjlmn-FC8Dq5s1hOSXJ_eNBt3yNDoAABug&oe=6AF1FAB2"}, "display_name": "Virtual Library", "keywords": [], "long_description": "# Virtual Library\n\n**Virtual Library is a gateway to high-impact experiential learning.**\n\nIt is a growing collection of educational VR modules designed to support specific learning goals and outcomes.\n\nTo provide a clearer understanding of our offerings, we have defined three types of experiences within Virtual Library: **Learning Environment, Training Lesson, and Research Experiment.**\n\n# **Learning Environment**\n\nA Learning Environment incorporates site-specific details, including spatial elements and orientations. Objects are purposefully designed and positioned to support meaningful learning within the context of the subject matter.\n\nLearning Environments are often created as replicas of real-world locations that are difficult or even impossible to access in person.\n\n# **Training Lesson**\n\nA Training Lesson is designed to provide skill-building activities, emphasizing hands-on tasks and interactions with objects and artifacts relevant to specific learning goals.\n\n# **Research Experiment**\n\nA Research Experiment is intentionally designed to investigate and measure participants' behavioral responses in alignment with specific research objectives.\n\nResearch Experiments may include embodied role-playing activities that are situational and context-driven. These experiences may be designed to evoke emotional distress or facilitate recovery through carefully planned activities, depending on the research objectives.\n", "short_description": "Virtual Library is a gateway to high-impact experiential learning.\nIt is a growing library of educational VR modules that are designed for the specific learning goals and outcomes.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.newimmersivedesign.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "New Immersive Design", "support_website_url": null, "website_url": "https://www.newimmersivedesign.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [],
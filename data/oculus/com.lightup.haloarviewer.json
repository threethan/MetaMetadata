8&oh=00_Afyrt1DwshuFpBVD47WHScPhAYV42l-5C4dsA9skimWMWw&oe=69BAA6E4"}, {"file_name": "screenshot5.png", "id": "1848474602341921", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035389_1848474605675254_3805838950077493323_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOGnUK0YPisQ7kNvwGKKA1P&_nc_oc=AdkqZvm5JMFJX9XtPNCgK471KCBwx2iqEl2fmtVWVMSlYlPsRM0se6eFD8WYPm8OhQA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx7WVhbn3MsleJX2cnvOYITFrab21ANO2PRNy1Smm24LQ&oe=69BAA449"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover (2560 x 1440).png", "id": "1076557090635014", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974857_1076557093968347_6620815350005885108_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBaBk6G93NwQ7kNvwHH0Vme&_nc_oc=AdnncTdMpvbQ7f9_PXuzna9HC26CCF7-hdMv4kYlRJoOY_ZVRq_tpIXMeCC56IQqsSA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwJQ6D7SZ_s4QtApxz-5hsOzgxigZVu6VI8h44ieirz9A&oe=69BA97D0"}, "display_name": "Mixed Reality Museum | By Halo AR (Early Release)", "keywords": ["augmented", "animals", "zoo", "safari", "marine"], "long_description": "Welcome to the Mixed Reality Museum, powered by Halo AR!\n\nOur virtual galleries are filled with an ever-expanding library of rich spatial 3D exhibits! Bring the best museum exhibits right into your home or classroom in all their stunning 3D lifelike glory, no school bus or field trip needed.\n\nLearn about real animals and scientific facts in the most realistic environment possible, the real world! Pick your learning experience, and then watch as nature\u2019s most dangerous, endangered, and incredible animals appear in front of you, along with educational narration and videos so you can learn all about them.\n\nExplore featured exhibits, including the fearsome hammerhead shark swimming right in your room, and thousands more made by Halo AR creators from 200+ countries around the world.\n\nBe one of the first visitors to the Mixed Reality Museum during our early access period, completely free of charge.\n", "short_description": "Welcome to the Mixed Reality Museum, powered by Halo AR!\n\nOur virtual galleries are filled with an ever-expanding library of rich spatial 3D exhibits! Bring the best museum exhibits right into your home or classroom in all their stunning 3D lifelike glory, no school bus or field trip needed.\n\nLearn about real animals and scientific facts in the most realistic environment possible, the real world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://haloar.app/privacy", "developer_terms_of_service_url": "https://haloar.app/terms", "publisher_name": "LightUp, Inc.", "support_website_url": null, "website_url": "https://haloar.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8385673444835804"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "7546541045441348"}]}, "baseline_offer": {"id": "7546541045441348"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1727797920, "status": "PUBLISHED", "id": "7546541045441348"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9236750293061444", "version": "1.0.5"}, "id": "798067012293919", "channel_name": "LIVE"}]}, "is_for_ocu
_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1li43lni94N-XJp_lXfPO3CTJoqQwiJcwhcqa4f590Ew&oe=69E0E264"}, {"file_name": "screenshot5.png", "id": "1848474602341921", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035389_1848474605675254_3805838950077493323_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7mZga5vojwQ7kNvwG6R5Yq&_nc_oc=Adp5faznqzQBZfrsBBU4JWxOkOjejuQ2657IMRzBg3pcl9bc2N3gKwrbxUmuxLHti7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0W_GF27F5n53SLeKVxTG5fGjuMGVkGOmcr2cd9BTC1dA&oe=69E0DFC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover (2560 x 1440).png", "id": "1076557090635014", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974857_1076557093968347_6620815350005885108_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7T3aYXz1g4Q7kNvwEfYbg1&_nc_oc=Adqs5H2ug7MHNZBYmGmbnp7bp---fp0JTfHYoTUf9zOTj3XAPYUiWNA9npIUb12miuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NFAGOx5N281Ial-U9HgYeI0__r7wDWZSbHc4feUC7hg&oe=69E0D350"}, "display_name": "Mixed Reality Museum | By Halo AR (Early Release)", "keywords": ["augmented", "animals", "zoo", "safari", "marine"], "long_description": "Welcome to the Mixed Reality Museum, powered by Halo AR!\n\nOur virtual galleries are filled with an ever-expanding library of rich spatial 3D exhibits! Bring the best museum exhibits right into your home or classroom in all their stunning 3D lifelike glory, no school bus or field trip needed.\n\nLearn about real animals and scientific facts in the most realistic environment possible, the real world! Pick your learning experience, and then watch as nature\u2019s most dangerous, endangered, and incredible animals appear in front of you, along with educational narration and videos so you can learn all about them.\n\nExplore featured exhibits, including the fearsome hammerhead shark swimming right in your room, and thousands more made by Halo AR creators from 200+ countries around the world.\n\nBe one of the first visitors to the Mixed Reality Museum during our early access period, completely free of charge.\n", "short_description": "Welcome to the Mixed Reality Museum, powered by Halo AR!\n\nOur virtual galleries are filled with an ever-expanding library of rich spatial 3D exhibits! Bring the best museum exhibits right into your home or classroom in all their stunning 3D lifelike glory, no school bus or field trip needed.\n\nLearn about real animals and scientific facts in the most realistic environment possible, the real world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://haloar.app/privacy", "developer_terms_of_service_url": "https://haloar.app/terms", "publisher_name": "LightUp, Inc.", "support_website_url": null, "website_url": "https://haloar.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8385673444835804"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "7546541045441348"}]}, "baseline_offer": {"id": "7546541045441348"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1727797920, "status": "PUBLISHED", "id": "7546541045441348"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9236750293061444", "version": "1.0.5"}, "id": "
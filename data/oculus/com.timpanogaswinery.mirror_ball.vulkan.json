dn.com&_nc_ss=7f20f&oh=00_AQC9ZEeGiMkR7tBDNHpSRtmehcRBsN7A1mqOW6HFp399GA&oe=6A6C911A"}, {"file_name": "com.timpanogaswinery.mirror_ball.vulkan-20260622-140402.png", "id": "1332728661612973", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299245_1332728664946306_6473386283140980780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqWRVHuS69sQ7kNvwGSzaR-&_nc_oc=AdpgMYYRYamj-AGsHYdHTWh5ilQVP6IyHjuU7sJa1rTzCflh1hzpcax95vS6HHWBxKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAetY9MoCpofjtE3xZmJBJo6ELILzBtxseBO_CJGey1rg&oe=6A6C912F"}, {"file_name": "com.timpanogaswinery.mirror_ball.vulkan-20260622-140652.png", "id": "2556446888148689", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619187_2556446891482022_2159870021636342632_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYO4qimXePEQ7kNvwHj2mdQ&_nc_oc=AdoHXqzKeth962s1ReH_mjaJdcmu-z90JzPtS1eVSLGqv6jJEjQM_uQSMfTUBchq-fk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgjd_BA2FBqx7nzNtW1yBrwkwuWHRIhnSzJwN34JcCHA&oe=6A6CA957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_b.png", "id": "4310639949197445", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622184_4310639952530778_4557864028633395888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmG2nJkGgRcQ7kNvwGON1mY&_nc_oc=AdrWJh_h7GLR7rcUqkwnHRigb-FHQ5lJTWmoykYXSygKlgMw7phrkwVCAid02so71aw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTC1WCI82SnesDjEQSjbBYjSsFksGYttTH2czg5wwtCg&oe=6A6CA58B"}, "display_name": "MirrorBall VR", "keywords": [], "long_description": "In the real world an infinity mirror is a collection of flat mirrors attached to each other to create a closed three dimensional shape. Inside the shape are light sources. Light repeatedly reflects off the mirrors. Because the mirrors are only partially silvered, you can see those reflections from the outside.\n\nMirrorBall VR simulates infinity mirrors. While it is generally not possible to step into a real world infinity mirror to see what it looks like from the inside, with MIrrorBall VR it is quite easy. It is a visually stimulating experience.\n\nEach mirror ball supports multiple color schemes that users can change at will. Mirror balls can be made to grow and shrink and moved about the virtual space at will in all three dimensions. Mirror balls are organized into galleries that the user can enter. Galleries can also contain other galleries. All the mirror balls and galleries are stored on the internet, starting in the World Gallery. Users can download mirror balls and galleries from the World Gallery to their Home Gallery which is stored on the VR headset so they can be viewed when there is no internet access. There is also a comprehensive Help Gallery, also on the internet, describing how the use MirrorBall VR.\n", "short_description": "MirrorBall VR is an infinity mirror simulator. It provides an art museum-like experience to its users. On entry, the user is presented with three galleries. The World Gallery contains infinity mirrors (AKA mirror balls) for the user to view. The Home Gallery, initially empty, is where the user can store mirror balls for off network usage. There is also a Help Gallery containing information on how to user the app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://timpanogaswinery.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Timpanogas Winery", "support_website_url": null, "website_url": "https://timpanogaswinery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor":
69096712939141_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOJfJQs2u1UQ7kNvwGHkpKc&_nc_oc=Adp_ey6cCCUToz5G2FB--ALqEPwK5Wxo7xqOV1pzDvPQQUMbsAsYNKxGR405Sbygq8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBmBvaYk8Dw4Zu_MGK2q07EM01adhOV158aPUl_UfKPg&oe=6AEA1141"}, {"file_name": "01-current-ct-detail-2560x1440.png", "id": "1447908070740817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620403_1447908080740816_6908627816015285862_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2HYCZZxTrsQ7kNvwGVfELM&_nc_oc=AdrYU9-ejChUVs8f2k3fPKIWqmzlb6mlj7aIDb_WPRhqRV7HQsxkophjD4kDeAAqCdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnErtZ1wyzlUufoYEbINfK2fa9NAJiCpxNqmTI2fEqOQ&oe=6AE9F7ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InteractVision - CT Painter", "keywords": ["CT", "3D\u6a21\u578b", "\u6df7\u5408\u5be6\u5883", "\u7a7a\u9593\u6a19\u8a3b", "\u91ab\u5b78\u6559\u80b2"], "long_description": "InteractVision - CT Painter \u662f\u7531\u82f1\u7279\u827e\u4e92\u52d5\u79d1\u6280\u6709\u9650\u516c\u53f8\u958b\u767c\u7684\u6df7\u5408\u5be6\u5883 CT \u4e09\u7dad\u6a21\u578b\u6aa2\u8996\u8207\u6a19\u8a3b\u5de5\u5177\uff0c\u8b93\u60a8\u5728\u771f\u5be6\u74b0\u5883\u4e2d\u89c0\u5bdf\u6a21\u578b\uff0c\u900f\u904e\u96d9\u624b\u64cd\u4f5c\u8207\u76f4\u7dda\u6a19\u8a3b\uff0c\u8f14\u52a9\u6559\u5b78\u3001\u5c55\u793a\u53ca\u6a21\u578b\u8a0e\u8ad6\u3002\n\n\u4e3b\u8981\u529f\u80fd\n\n\u30fb\u6383\u63cf QR code \u8f09\u5165\u6a21\u578b\uff0c\u4e26\u8a2d\u5b9a\u6a21\u578b\u7684\u521d\u59cb\u4f4d\u7f6e\u8207\u65b9\u5411\u3002\u8f09\u5165\u5f8c\u53ef\u81ea\u7531\u8abf\u6574\uff0c\u9700\u8981\u91cd\u65b0\u5b9a\u4f4d\u6642\u518d\u4e3b\u52d5\u91cd\u6383\u3002\n\u30fb\u79fb\u52d5\u3001\u65cb\u8f49\u8207\u7e2e\u653e\u6a21\u578b\uff0c\u4ee5\u4e0d\u540c\u89d2\u5ea6\u89c0\u5bdf\u4e09\u7dad\u7d50\u69cb\u3002\n\u30fb\u5de6\u624b\u6301\u63e1\u64cd\u4f5c\u6a21\u578b\uff0c\u53f3\u624b\u4f7f\u7528\u7b46\u982d\u653e\u7f6e\u76f4\u7dda\u8d77\u8a16\u9ede\uff1b\u7aef\u9ede\u4e5f\u80fd\u8a2d\u7f6e\u65bc\u7a7a\u4e2d\uff0c\u4e0d\u5fc5\u63a5\u89f8\u6a21\u578b\u8868\u9762\u3002\n\u30fb\u8abf\u6574\u6a19\u8a3b\u7dda\u689d\u7684\u984f\u8272\u8207\u7c97\u7d30\uff0c\u53d6\u6d88\u5c1a\u672a\u5b8c\u6210\u7684\u8d77\u9ede\uff0c\u6216\u64a4\u92b7\u6700\u5f8c\u4e00\u689d\u7dda\u3002\n\u30fb\u8abf\u6574\u9aa8\u982d\u6a21\u578b\u7684\u900f\u660e\u5ea6\uff0c\u8f14\u52a9\u89c0\u5bdf\u6a21\u578b\u8207\u6a19\u8a3b\u7684\u7a7a\u9593\u95dc\u4fc2\u3002\n\u30fb\u6a19\u8a3b\u8ddf\u96a8\u6a21\u578b\u540c\u6b65\u79fb\u52d5\u3001\u65cb\u8f49\u8207\u7e2e\u653e\uff1b\u5132\u5b58\u6a19\u8a3b\u7248\u672c\u6642\u4e0d\u91cd\u65b0\u532f\u51fa\u539f\u59cb\u6a21\u578b\u3002\n\u30fb\u5c07\u6a19\u8a3b\u7248\u672c\u5132\u5b58\u81f3\u914d\u5957\u7ad9\u53f0\uff0c\u4f9b\u5176\u4ed6\u4f7f\u7528\u8005\u4e0b\u8f09\u67e5\u770b\uff1b\u9019\u662f\u7248\u672c\u5206\u4eab\uff0c\u4e26\u975e\u5373\u6642\u591a\u4eba\u5171\u540c\u7de8\u8f2f\u3002\n\u30fb\u62cd\u651d\u7167\u7247\u4e26\u4e0a\u50b3\u81f3\u914d\u5957\u7ad9\u53f0\uff0c\u5728\u982d\u76d4\u5167\u9810\u89bd\u62cd\u651d\u7d50\u679c\u3002\n\u30fb\u5df2\u4e0b\u8f09\u7684\u6a21\u578b\u4fdd\u7559\u672c\u6a5f\u5feb\u53d6\uff0c\u6e1b\u5c11\u91cd\u8907\u4e0b\u8f09\u3002\n\n\u4f7f\u7528\u9700\u6c42\n\n\u672c App \u9700\u642d\u914d\u6a21\u578b\u7ba1\u7406\u7ad9\u53f0\u53ca\u6709\u6548\u7684\u6a21\u578b QR code\uff0c\u4e26\u975e\u7368\u7acb\u7684 CT \u5f71\u50cf\u6383\u63cf\u6216 DICOM \u95b1\u7247\u8edf\u9ad4\u3002STL \u6a21\u578b\u9808\u5148\u7531\u914d\u5957\u7ad9\u53f0\u8655\u7406\uff0c\u518d\u63d0\u4f9b App \u8f09\u5165\u3002\n\n\u9069\u7528\u65bc Meta Quest 3\u3001Quest 3S\uff0c\u4f7f\u7528\u5de6\u53f3 Touch \u63a7\u5236\u5668\u64cd\u4f5c\u3002QR \u6383\u63cf\u8207\u62cd\u7167\u529f\u80fd\u9700\u8981\u982d\u76d4\u76f8\u6a5f\u6b0a\u9650\uff1b\u9996\u6b21\u4e0b\u8f09\u6a21\u578b\u3001\u4e0a\u50b3\u6a19\u8a3b\u53ca\u7167\u7247\u9700\u8981\u53ef\u9023\u7dda\u7684\u914d\u5957\u7ad9
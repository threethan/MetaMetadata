tHIg3gEtiwngmweHzGLwrghD6tDnp-v_UazzZTZ8s5ng&oe=69984002"}, {"file_name": "Screensharing - in-app 2.png", "id": "3180666015495784", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75371510_3180666022162450_963874225581680306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkPSxgdY31IQ7kNvwERhFO_&_nc_oc=AdlAs9TEXxCvHPL1hXRwHzjCE6R7_3YduR86yBdmm1p042s2ecSxO25VlB8HC8SFHwk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afucco8K5PZ7FgMq2KfYq4s7FTzSMoj2qqG91tvBbVu2XA&oe=699865E5"}, {"file_name": "Whiteboard MUSE 1.png", "id": "1936220343216216", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75645000_1936220346549549_4326274920119628700_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYi3ZwKTtXQQ7kNvwF36ryk&_nc_oc=Adm3M11kSt9_tyHDhQpPS4zsDWU3MY7j72sU7a8v7l9EY9y4o9iYitY0qdztRpU3sX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuIBW9e1nP8dnox-Xw2nzv4CmZuhfhn4nIK7SAoK9XIoA&oe=69985F43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CollaborationVR_thumb.png", "id": "869876003716769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86597262_869876007050102_5704468721268995740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEEbLdU34TIQ7kNvwFzGF4n&_nc_oc=Adkc6A48PgQZpflcGP_5nxPy3F-cMm11d-w0EqC_w1iCjgYHUyEwwQMJAfP3CCIOFrY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuzGHml5lkJLIClJjXw2PN8VGoMG92rf0BJOjTeMlwb6Q&oe=69983F1E"}, "display_name": "CollaborationVR", "keywords": [], "long_description": "Meet your colleagues and customers from anywhere in the world with CollaborationVR, our platform for healthcare professionals to come together in a virtual space. CollaborationVR is a frictionless, low-cost way to enjoy all the benefits of teamwork without physical travel. Great for clinical training, product development, sales team engagement and customer meetings.\n\nCollaborationVR is a standalone, multiuser capability within our award-winning Fundamental Surgery platform. Adopted by life science companies worldwide \u2013 with outstanding results \u2013 CollaborationVR is designed to facilitate surgical, clinical and team training for users wherever and whenever. With ready-to-use tools, content-sharing capabilities and multiple environment options, CollaborationVR is immediately usable and compatible with leading VR headsets.", "short_description": "Meet your colleagues and customers from anywhere in the world with CollaborationVR, our platform for healthcare professionals to come together in a virtual space. CollaborationVR is a frictionless, low-cost way to enjoy all the benefits of teamwork without physical travel. Great for clinical training, product development, sales team engagement and customer meetings.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fundamentalsurgery.com/privacy/", "developer_terms_of_service_url": "https://fundamentalsurgery.com/terms-conditions/", "publisher_name": "FVRVS Ltd T/A FundamentalVR", "support_website_url": "https://fundamentalsurgery.com/support/", "website_url": "https://www.fundamentalsurgery.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "714769256597346"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1084917319045320"}]}, "baseline_offer": {"id": "1084917319045320"}, "is_approved": true, "firstOffer": {"nodes
0kaunAuzO9gWNNbpzGd58QqyD-03-rNxb6hfAYy0tMQA&oe=69F0CCC2"}, {"file_name": "Screensharing - in-app 2.png", "id": "3180666015495784", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371510_3180666022162450_963874225581680306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZtI1HJe-FgQ7kNvwGwTaPI&_nc_oc=Adpcdjmdnvk_TUtnKG8anmqn0bIHlLyWGBkk2CuCUtpV-Cck43At3DlWdhotv76UlNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af15xAWIpvsetmWyKSrExcaS1j89fd88vw9FRivvYvw-kg&oe=69F0BA65"}, {"file_name": "Whiteboard MUSE 1.png", "id": "1936220343216216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75645000_1936220346549549_4326274920119628700_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bUVSuLGAy0Q7kNvwGrCp0w&_nc_oc=AdqG0pq2ICvA2B5VZDFrMvHE_SsaE_2-EEQed_d59nifQPdA_BuynZcXskHVYdd-xGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3ok6n6SOfJI7DIY_d18IVx2IwuOANiw0ox6DS8LwH_Xg&oe=69F0B3C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CollaborationVR_thumb.png", "id": "869876003716769", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86597262_869876007050102_5704468721268995740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLg1ffXW07YQ7kNvwH4-qxk&_nc_oc=Adpv7Usu-E6G01M_ZRGQ7kD8EFQW00F094SywmSz0A3DXw-iRmMXf_JJoUUhEnDg4bE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0OrL9KlxL7RZnfq6bVrtexxD8NZuNK0hO52wHoY_1oVQ&oe=69F0CBDE"}, "display_name": "CollaborationVR", "keywords": [], "long_description": "Meet your colleagues and customers from anywhere in the world with CollaborationVR, our platform for healthcare professionals to come together in a virtual space. CollaborationVR is a frictionless, low-cost way to enjoy all the benefits of teamwork without physical travel. Great for clinical training, product development, sales team engagement and customer meetings.\n\nCollaborationVR is a standalone, multiuser capability within our award-winning Fundamental Surgery platform. Adopted by life science companies worldwide \u2013 with outstanding results \u2013 CollaborationVR is designed to facilitate surgical, clinical and team training for users wherever and whenever. With ready-to-use tools, content-sharing capabilities and multiple environment options, CollaborationVR is immediately usable and compatible with leading VR headsets.", "short_description": "Meet your colleagues and customers from anywhere in the world with CollaborationVR, our platform for healthcare professionals to come together in a virtual space. CollaborationVR is a frictionless, low-cost way to enjoy all the benefits of teamwork without physical travel. Great for clinical training, product development, sales team engagement and customer meetings.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fundamentalsurgery.com/privacy/", "developer_terms_of_service_url": "https://fundamentalsurgery.com/terms-conditions/", "publisher_name": "FVRVS Ltd T/A FundamentalVR", "support_website_url": "https://fundamentalsurgery.com/support/", "website_url": "https://www.fundamentalsurgery.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "714769256597346"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1084917319045320"}]}, "baseline_offer": {"id": "1084917319045320"}, "is_approved": true, "firstOffer": {"nodes
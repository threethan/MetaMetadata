qe6J51lAfP8x4FWwLTOTBsMH1NTpVAunDQ4AJNHjMeOnAXhMcy9Z_2P_dc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzLigXAL0pRcTEQxd3lAX6OJ8aHN1RIMNp-EaHj4x3Xw&oe=6AFDBDDE"}, "display_name": "CollaborationVR", "keywords": [], "long_description": "Meet your colleagues and customers from anywhere in the world with CollaborationVR, our platform for healthcare professionals to come together in a virtual space. CollaborationVR is a frictionless, low-cost way to enjoy all the benefits of teamwork without physical travel. Great for clinical training, product development, sales team engagement and customer meetings.\n\nCollaborationVR is a standalone, multiuser capability within our award-winning Fundamental Surgery platform. Adopted by life science companies worldwide \u2013 with outstanding results \u2013 CollaborationVR is designed to facilitate surgical, clinical and team training for users wherever and whenever. With ready-to-use tools, content-sharing capabilities and multiple environment options, CollaborationVR is immediately usable and compatible with leading VR headsets.", "short_description": "Meet your colleagues and customers from anywhere in the world with CollaborationVR, our platform for healthcare professionals to come together in a virtual space. CollaborationVR is a frictionless, low-cost way to enjoy all the benefits of teamwork without physical travel. Great for clinical training, product development, sales team engagement and customer meetings.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fundamentalxr.com/privacy-policy", "developer_terms_of_service_url": "https://www.fundamentalxr.com/terms-and-conditions", "publisher_name": "FVRVS Ltd T/A FundamentalVR", "support_website_url": "https://fundamentalsurgery.freshdesk.com/support/home", "website_url": "https://www.fundamentalxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "
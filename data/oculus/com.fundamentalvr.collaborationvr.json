Rb9oZ2YH1u3wQKHw&oe=6B071883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CollaborationVR_thumb.png", "id": "869876003716769", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86597262_869876007050102_5704468721268995740_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3Dlf7XiO2UQ7kNvwGcjFTD&_nc_oc=AdpDdxjyOO6K0duxOQETpX4Azm1r7XNS18Nj_FpzegAFH94N5wr8tX2VaRs9oeqU6Fg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLBrP8ZTupBi6YLj5G3LX1dqpdy3jrc0u8IW-TlsOz4Q&oe=6B06F85E"}, "display_name": "CollaborationVR", "keywords": [], "long_description": "Meet your colleagues and customers from anywhere in the world with CollaborationVR, our platform for healthcare professionals to come together in a virtual space. CollaborationVR is a frictionless, low-cost way to enjoy all the benefits of teamwork without physical travel. Great for clinical training, product development, sales team engagement and customer meetings.\n\nCollaborationVR is a standalone, multiuser capability within our award-winning Fundamental Surgery platform. Adopted by life science companies worldwide \u2013 with outstanding results \u2013 CollaborationVR is designed to facilitate surgical, clinical and team training for users wherever and whenever. With ready-to-use tools, content-sharing capabilities and multiple environment options, CollaborationVR is immediately usable and compatible with leading VR headsets.", "short_description": "Meet your colleagues and customers from anywhere in the world with CollaborationVR, our platform for healthcare professionals to come together in a virtual space. CollaborationVR is a frictionless, low-cost way to enjoy all the benefits of teamwork without physical travel. Great for clinical training, product development, sales team engagement and customer meetings.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fundamentalsurgery.com/privacy/", "developer_terms_of_service_u
tqBMSQ30EP8oIN8cyeEmL09Erb9-T4fhnyP_sExhVWpA&oe=699AE302"}, {"file_name": "Screensharing - in-app 2.png", "id": "3180666015495784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371510_3180666022162450_963874225581680306_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkPSxgdY31IQ7kNvwF2UIQ1&_nc_oc=AdnLEWtfLgegZreyFLz2YrPqBcAoXVf4Cv6eJL61lJS0CKs9GMkLK8xl2kgr6cLQd_Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsT-iiPIm6p1E13w0IPqpZzbvYCJTK2hfK5H7CHqZxXFQ&oe=699B08E5"}, {"file_name": "Whiteboard MUSE 1.png", "id": "1936220343216216", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75645000_1936220346549549_4326274920119628700_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhF5X2upQuUQ7kNvwE2Y9zy&_nc_oc=Adm-yVR_5rQONBauLX2bHvotETa6s9xndBmWjPHzQGFi48J6OVHhk-c7BbAvOr7n5sw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvvjz3_LlwA-Cyyz8BWwv_Tyts5iqeBP7tO2pKtupWE0Q&oe=699B0243"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CollaborationVR_thumb.png", "id": "869876003716769", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86597262_869876007050102_5704468721268995740_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W2O9luYROMQ7kNvwFvCDBS&_nc_oc=AdlH8IXW9pnSJJX61PD0YCA2N7yloL7Zlm5HqtvYXqy9mmyQycMSt1BjfHGPoS4ZboM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvNVPX2AiRWlxrgpFg1560ZV85TvS6LafIVyFpX_nAO5g&oe=699AE21E"}, "display_name": "CollaborationVR", "keywords": [], "long_description": "Meet your colleagues and customers from anywhere in the world with CollaborationVR, our platform for healthcare professionals to come together in a virtual space. CollaborationVR is a frictionless, low-cost way to enjoy all the benefits of teamwork without physical travel. Great for clinical training, product development, sales team engagement and customer meetings.\n\nCollaborationVR is a standalone, multiuser capability within our award-winning Fundamental Surgery platform. Adopted by life science companies worldwide \u2013 with outstanding results \u2013 CollaborationVR is designed to facilitate surgical, clinical and team training for users wherever and whenever. With ready-to-use tools, content-sharing capabilities and multiple environment options, CollaborationVR is immediately usable and compatible with leading VR headsets.", "short_description": "Meet your colleagues and customers from anywhere in the world with CollaborationVR, our platform for healthcare professionals to come together in a virtual space. CollaborationVR is a frictionless, low-cost way to enjoy all the benefits of teamwork without physical travel. Great for clinical training, product development, sales team engagement and customer meetings.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fundamentalsurgery.com/privacy/", "developer_terms_of_service_url": "https://fundamentalsurgery.com/terms-conditions/", "publisher_name": "FVRVS Ltd T/A FundamentalVR", "support_website_url": "https://fundamentalsurgery.com/support/", "website_url": "https://www.fundamentalsurgery.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "714769256597346"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1084917319045320"}]}, "baseline_offer": {"id": "1084917319045320"}, "is_approved": true, "firstOffer": {"nodes
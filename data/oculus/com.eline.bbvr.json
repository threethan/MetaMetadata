cdn.com&oh=00_AfvjMMhbOr0hZrHiEKQcs0YaH8oXMeajR9VmlesHtZOzKg&oe=699EFBC8"}, {"file_name": "kanaloa.png", "id": "859108606102578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375081_859108609435911_3307874530582770038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZRY_l5lOXsQ7kNvwFupxDO&_nc_oc=AdnmNiREztmbpZ06-GRoJhJAP3D3Hm1wkCHECAez8BYvINIoZyLK4GIuNb-xoVhf6G8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvlr75f-8kl5RTDCAXvn6NWefkPA7Uc_2gRJRAYIetstA&oe=699EE9DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Cover_Landscape Tara Sypherd.png", "id": "2624637021061875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984472_2624637024395208_8851356898454451615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pl4U2mT2t1sQ7kNvwFGv9C9&_nc_oc=Adn-ndPaaTqLDUHQJAXRp5oPir-8nCbNKrb1L3XcXeGcUPRTonh9-2k0Bs2xQgpXXOc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftwCWE64-eiCH68705l422pTs1zZLNEJpmvppNVarcNcw&oe=699EDF99"}, "display_name": "Beyond Blue: After the Storm", "keywords": ["underwater", "diving", "exploration", "science", "story"], "long_description": "After a severe tropical storm damages an underwater research station, Mirai and her crew are asked to help repair the damage and lend aid to the creatures in the surrounding biosphere.  What they uncover there is more dangerous than they could have realized and will take all their skills, and help from an unexpected ally, to make right.\n\n# Immerse Yourself in the Depths of our Ocean\nExplore our world\u2019s beautiful ocean in a game based in reality and set in humanity\u2019s not too far future. Swim through unique biomes, interacting with creatures that few have ever seen in person.\n{1650880305461747}\n\n# Dive Into a Brand New Adventure\nPlay as Mirai, voiced by Erika Ishii, in this entirely new story developed for VR.\n{898241192396453}\n\n# Teamwork Makes the Dream Work\nSwap between diverse characters, each with their own personality and abilities, to accomplish goals and uncover what is happening beneath the waves.\n{3873877772866871}\n\n# Science!\nUnlock Ocean Insights, mini-documentaries that explore the real-world science that inspired the game.\n{584416700625952}", "short_description": "After a severe tropical storm damages an underwater research station, Mirai and her crew are asked to help repair the damage and lend aid to the creatures in the surrounding biosphere.  What they uncover there is more dangerous than they could have realized and will take all their skills, and help from an unexpected ally, to make right."}]}, "developer_name": "E-Line Media, Chaos Theory Games", "developer_privacy_policy_url": "http://beyondbluegame.com/privacy", "developer_terms_of_service_url": "http://beyondbluegame.com/terms", "publisher_name": "E-Line Media", "support_website_url": "http://beyondbluegame.com/support", "website_url": "https://www.beyondbluegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8182839771815908"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "649008870885281"}, {"status": "PUBLISHED", "id": "624049863495641"}, {"status": "PUBLISHED", "id": "1378044666903585"}, {"status": "PUBLISHED", "id": "946772490723081"}, {"status": "PUBLISHED", "id": "578716937984888"}, {"status": "PUBLISHE
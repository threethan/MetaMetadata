c_ohc=oGfalD53-kEQ7kNvwHbcyCW&_nc_oc=Adr5rnZvKAZpN1ZWfEF2Qm73agvITNuRMHOgPpNRoGOqADPUI8sHwNt645D7_pVuJfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oPN5m_KJWtcDKy9KTXhBA_R2xVREzkqkfndkmvNQ2Lw&oe=69DBA0C8"}, {"file_name": "kanaloa.png", "id": "859108606102578", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75375081_859108609435911_3307874530582770038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyExGKEH5FsQ7kNvwEq5M5d&_nc_oc=AdqHqduWw1KGTiYDVUmNasXL67_0NebjTc_LZwc-bru9ZzgAtI89PyvxPV3W5aCs4tw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35O8tG6C7xvqewqNMDbpo2H5pqSINc_UTlYR5nwF7fAA&oe=69DB8EDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Cover_Landscape Tara Sypherd.png", "id": "2624637021061875", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984472_2624637024395208_8851356898454451615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4nKBGLsLAQQ7kNvwGsfQdE&_nc_oc=AdrGU3H9plbWERihRBuHgzM5dxg-FR6T9kqm9G1bbMmuFtrT4KRBVBRmVordNXtrhdw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hgr1GY7YjFif6F3XRDdVeGXqZp5SClR8wsdLaeubtng&oe=69DB8499"}, "display_name": "Beyond Blue: After the Storm", "keywords": ["underwater", "diving", "exploration", "science", "story"], "long_description": "After a severe tropical storm damages an underwater research station, Mirai and her crew are asked to help repair the damage and lend aid to the creatures in the surrounding biosphere.  What they uncover there is more dangerous than they could have realized and will take all their skills, and help from an unexpected ally, to make right.\n\n# Immerse Yourself in the Depths of our Ocean\nExplore our world\u2019s beautiful ocean in a game based in reality and set in humanity\u2019s not too far future. Swim through unique biomes, interacting with creatures that few have ever seen in person.\n{1650880305461747}\n\n# Dive Into a Brand New Adventure\nPlay as Mirai, voiced by Erika Ishii, in this entirely new story developed for VR.\n{898241192396453}\n\n# Teamwork Makes the Dream Work\nSwap between diverse characters, each with their own personality and abilities, to accomplish goals and uncover what is happening beneath the waves.\n{3873877772866871}\n\n# Science!\nUnlock Ocean Insights, mini-documentaries that explore the real-world science that inspired the game.\n{584416700625952}", "short_description": "After a severe tropical storm damages an underwater research station, Mirai and her crew are asked to help repair the damage and lend aid to the creatures in the surrounding biosphere.  What they uncover there is more dangerous than they could have realized and will take all their skills, and help from an unexpected ally, to make right."}]}, "developer_name": "E-Line Media, Chaos Theory Games", "developer_privacy_policy_url": "http://beyondbluegame.com/privacy", "developer_terms_of_service_url": "http://beyondbluegame.com/terms", "publisher_name": "E-Line Media", "support_website_url": "http://beyondbluegame.com/support", "website_url": "https://www.beyondbluegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8182839771815908"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "649008870885281"}, {"status": "PUBLISHED", "id": "62404986
ss=7f20f&oh=00_AQT0zebCtqpV_TzKeQv58nyv2Gz_7vH4bUVkM4Du1avIFA&oe=6AFDB40E"}, {"file_name": "cutting-tool.png", "id": "1540875089875716", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610711_1540875093209049_8963269463585226657_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaXG_3Q4zzMQ7kNvwFsucNf&_nc_oc=Adp3egcM9w9nGE3VrdXRbTSxB8wAzbTHV2oQbbELEPSEOl8KfiONPlS4XmdHbnG3iVM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-b8aBeRahmUE45ybgRHYcomK4QlqjWy01-9YdWlhC6A&oe=6AFDE308"}, {"file_name": "kanaloa.png", "id": "859108606102578", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375081_859108609435911_3307874530582770038_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwfzMnWNUbQQ7kNvwGzF0PV&_nc_oc=Adr7WFTIQMqIOOZGEJuOZx0lURmfDq4_zXV2xpbwb0ADRo5jKd5jlOUlqLNBYnQ40qU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9zk02wGTaAgaA0NdkKT1NuCflu7dh82wg3XlPMnIGSw&oe=6AFDD11B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Cover_Landscape Tara Sypherd.png", "id": "2624637021061875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984472_2624637024395208_8851356898454451615_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lnXpqu1JMUQ7kNvwFa_qGv&_nc_oc=Adq99Tzi8p92o0SMuKNwPDolmrcw_g3jAXIe_oi-T-0Bi_Q_JZlG8Dect7RVPTfHXxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLoezWQbB62kBxw3jR5_eqzQtEPER11IBMYu5xDUxyxg&oe=6AFDC6D9"}, "display_name": "Beyond Blue: After the Storm", "keywords": ["underwater", "diving", "exploration", "science", "story"], "long_description": "After a severe tropical storm damages an underwater research station, Mirai and her crew are asked to help repair the damage and lend aid to the creatures in the surrounding biosphere.  What they uncover there is more dangerous than they could have realized and will take all their skills, and help from an unexpected ally, to make right.\n\n# Immerse Yourself in the Depths of our Ocean\nExplore our world\u2019s beautiful ocean in a game based in reality and set in humanity\u2019s not too far future. Swim through unique biomes, interacting with creatures that few have ever seen in person.\n{1650880305461747}\n\n# Dive Into a Brand New Adventure\nPlay as Mirai, voiced by Erika Ishii, in this entirely new story developed for VR.\n{898241192396453}\n\n# Teamwork Makes the Dream Work\nSwap between diverse characters, each with their own personality and abilities, to accomplish goals and uncover what is happening beneath the waves.\n{3873877772866871}\n\n# Science!\nUnlock Ocean Insights, mini-documentaries that explore the real-world science that inspired the game.\n{584416700625952}", "short_description": "After a severe tropical storm damages an underwater research station, Mirai and her crew are asked to help repair the damage and lend aid to the creatures in the surrounding biosphere.  What they uncover there is more dangerous than they could have realized and will take all their skills, and help from an unexpected ally, to make right."}]}, "developer_name": "E-Line Media, Chaos Theory Games", "developer_privacy_policy_url": "http://beyondbluegame.com/privacy", "developer_terms_of_service_url": "http://beyondbluegame.com/terms", "publisher_name": "E-Line Media", "support_website_url": "http://beyondbluegame.com/support", "website_url": "https://www.beyondbluegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
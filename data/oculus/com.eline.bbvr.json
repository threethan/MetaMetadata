c_ohc=d_jEojB0xhcQ7kNvwE3F5kg&_nc_oc=AdoZFoni4cBRGWwhGTFC3Y_T9gUL_zxNnCp_TO6cdhEwvklhjbvATbkeAmx3igk07lI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3v0_rr97zCLQ8lWwG9fT4gK7ZYDOwpA1px_4wnLkjiHA&oe=69DF9548"}, {"file_name": "kanaloa.png", "id": "859108606102578", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375081_859108609435911_3307874530582770038_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRwsukQVaxIQ7kNvwHND6c6&_nc_oc=AdrVldgAeD9IT6QrGmXg6upsPK3h3ImKcxIEA8MYYV-SxTon2fgMu8uvP4XuhMDch_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Jhqu1BoZ-Lni-fzn9S7xKdpqyTt0MMVa98FDcSXfw5g&oe=69DF835B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_Cover_Landscape Tara Sypherd.png", "id": "2624637021061875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984472_2624637024395208_8851356898454451615_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHCFV5G12yEQ7kNvwHM6gGn&_nc_oc=Adpqew1lWkQ6F6UIAxlZAf9q9FcDZtvtAUdYrL80nxbH47-Bus6ctEHmuwcaR3Zj8FU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XawRhD81ixiK3foJC8Dz3QNxtB3fLpE6QYYqsE0aVRQ&oe=69DF7919"}, "display_name": "Beyond Blue: After the Storm", "keywords": ["underwater", "diving", "exploration", "science", "story"], "long_description": "After a severe tropical storm damages an underwater research station, Mirai and her crew are asked to help repair the damage and lend aid to the creatures in the surrounding biosphere.  What they uncover there is more dangerous than they could have realized and will take all their skills, and help from an unexpected ally, to make right.\n\n# Immerse Yourself in the Depths of our Ocean\nExplore our world\u2019s beautiful ocean in a game based in reality and set in humanity\u2019s not too far future. Swim through unique biomes, interacting with creatures that few have ever seen in person.\n{1650880305461747}\n\n# Dive Into a Brand New Adventure\nPlay as Mirai, voiced by Erika Ishii, in this entirely new story developed for VR.\n{898241192396453}\n\n# Teamwork Makes the Dream Work\nSwap between diverse characters, each with their own personality and abilities, to accomplish goals and uncover what is happening beneath the waves.\n{3873877772866871}\n\n# Science!\nUnlock Ocean Insights, mini-documentaries that explore the real-world science that inspired the game.\n{584416700625952}", "short_description": "After a severe tropical storm damages an underwater research station, Mirai and her crew are asked to help repair the damage and lend aid to the creatures in the surrounding biosphere.  What they uncover there is more dangerous than they could have realized and will take all their skills, and help from an unexpected ally, to make right."}]}, "developer_name": "E-Line Media, Chaos Theory Games", "developer_privacy_policy_url": "http://beyondbluegame.com/privacy", "developer_terms_of_service_url": "http://beyondbluegame.com/terms", "publisher_name": "E-Line Media", "support_website_url": "http://beyondbluegame.com/support", "website_url": "https://www.beyondbluegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8182839771815908"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "813441361811557"}, {"status": "PUBLISHED", "id": "24328505
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk4n3E7sDa4Q7kNvwE0umNC&_nc_oc=Adr0WD75VBR6l194r8vxQ4RihzZuG3n2GnM_2j5yb5iGHb2zHg0MCU-YC7E3wUciS7o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUg-jicMntmuFbFXR7AjRwB3oIQoCgJ9tPi569DGE-9A&oe=6B01BBEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail (1).png", "id": "941361177369533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982583_941361180702866_4912768721670633582_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BO9F5b_WsJAQ7kNvwGG09vY&_nc_oc=AdqO133U60u1bwWtwYrX-tkf0Bf1KrLqR9Xr7tJwdwg7iQrVSKkzr_yzpsAhlxwWvgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6XjMtrj5muC2OGeXrNxzgDyyyYXZkucZ7cAJBIoBr7g&oe=6B01DEC0"}, "display_name": "Simias", "keywords": [], "long_description": "Navigate through the labyrinthine corridors, leaping, swinging, and scrambling across the vast network of rooms while avoiding lurking dangers and strange entities. Utilize your monkey's agility and Gorilla Tag-inspired movement to outmaneuver obstacles and outsmart any threats that stand in your way.\nAs you progress deeper into the Backrooms, menacing creatures that will test your wit and agility at every turn.\nCan you guide your monkey through the endless corridors of the Backrooms, evade the dangers that lurk within, and ultimately find your way back to the real world? It's time to embark on an unforgettable adventure filled with monkeying around and heart-pounding excitement in \"Simiasg\"!", "short_description": "In \"Simias\" players find themselves in a surreal and endless maze of interconnected rooms known as the Backrooms, filled with eerie lighting and mysterious ambiance. However, there's a twist - you're not alone! You control a mischievous monkey equipped with the locomotion mechanics of Gorilla Tag."}]}, "developer_name": "FLUG", "developer_privacy_policy_url": "https://www.termsfeed.com/live/97e20b00-0e31-4d6d-869c-50f3aac9a83b",
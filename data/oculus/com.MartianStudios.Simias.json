cb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9jOJ5z3__0Q7kNvwGOC1ky&_nc_oc=AdpjMjbzHcwNc14-M0N_PPcIySYpxAIfiR1HJf7oHFqWmeywJsOB3d0ARMPfUbdumHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUC6e-kwbybMEABr0aKh-muxN0qMkAJgoOwheGKB9OpTA&oe=6B103C6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail (1).png", "id": "941361177369533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982583_941361180702866_4912768721670633582_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tbQ2vXMlO0Q7kNvwHvxFW9&_nc_oc=AdqrYbSmYXS4zF_4XGaa4WbsSbO95fR0PrCsy2CdbuYWeF0lg3jaaHcYEsYfvV0RsVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXt7C-h3SYmFjlWrwx8AFmZQzhJbBjpdkHB04C4wqQsKA&oe=6B105F40"}, "display_name": "Simias", "keywords": [], "long_description": "Navigate through the labyrinthine corridors, leaping, swinging, and scrambling across the vast network of rooms while avoiding lurking dangers and strange entities. Utilize your monkey's agility and Gorilla Tag-inspired movement to outmaneuver obstacles and outsmart any threats that stand in your way.\nAs you progress deeper into the Backrooms, menacing creatures that will test your wit and agility at every turn.\nCan you guide your monkey through the endless corridors of the Backrooms, evade the dangers that lurk within, and ultimately find your way back to the real world? It's time to embark on an unforgettable adventure filled with monkeying around and heart-pounding excitement in \"Simiasg\"!", "short_description": "In \"Simias\" players find themselves in a surreal and endless maze of interconnected rooms known as the Backrooms, filled with eerie lighting and mysterious ambiance. However, there's a twist - you're not alone! You control a mischievous monkey equipped with the locomotion mechanics of Gorilla Tag."}]}, "developer_name": "FLUG", "developer_privacy_policy_url": "https://www.termsfeed.com/live/97e20b00-0e31-4d6d-869c-50f3aac9a83b",
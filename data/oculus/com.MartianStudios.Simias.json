cb=1-7&_nc_sid=6e7a0a&_nc_ohc=EruCSlMpfA0Q7kNvwEu9POM&_nc_oc=Ado7-YQg9ojqEKJgG4zOcYfOx-vyjRlNiibIV-cThdVGPmPhCgNnMuoVoAmvzQhomHY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfIloGGj7O1uJc60E-5p5UxxmqDmv6kgk3JsROEhd05g&oe=6AFB246B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail (1).png", "id": "941361177369533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982583_941361180702866_4912768721670633582_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3KG3NdRwJ8Q7kNvwFevLej&_nc_oc=Ado33pjHB9OO2vNuA3NEXc0lcwxC9XCGC3V2ZjVKOKiXyIoQ9Gi2ia8RwxkhLD1CwYg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeAHTeF-wA93IKgSEBqRyo8WCSQJud6jDiBbkGrdsL3A&oe=6AFB4740"}, "display_name": "Simias", "keywords": [], "long_description": "Navigate through the labyrinthine corridors, leaping, swinging, and scrambling across the vast network of rooms while avoiding lurking dangers and strange entities. Utilize your monkey's agility and Gorilla Tag-inspired movement to outmaneuver obstacles and outsmart any threats that stand in your way.\nAs you progress deeper into the Backrooms, menacing creatures that will test your wit and agility at every turn.\nCan you guide your monkey through the endless corridors of the Backrooms, evade the dangers that lurk within, and ultimately find your way back to the real world? It's time to embark on an unforgettable adventure filled with monkeying around and heart-pounding excitement in \"Simiasg\"!", "short_description": "In \"Simias\" players find themselves in a surreal and endless maze of interconnected rooms known as the Backrooms, filled with eerie lighting and mysterious ambiance. However, there's a twist - you're not alone! You control a mischievous monkey equipped with the locomotion mechanics of Gorilla Tag."}]}, "developer_name": "FLUG", "developer_privacy_policy_url": "https://www.termsfeed.com/live/97e20b00-0e31-4d6d-869c-50f3aac9a83b",
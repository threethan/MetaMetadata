8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYy33OIkfX0Q7kNvwHAMWqG&_nc_oc=Adq1frOf95yUJts95A7IE06nRAqCjOwD80_S5jn01HCDNsivqmXTR-neBdCW86eYrXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a3nZt_GU3hfj2-Zq5_eBRbspxC4RiQJ4uSgT0H43GUA&oe=6A25814F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fmnvi6nMCJcQ7kNvwF65YPT&_nc_oc=Adr3Va00X8opDEXcXKSALk85t0XGfCrn5qn93V66QOYN93Hc4J6yEmGyBEhbQasOu8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5aPlZZ25kHlHsnBRnXfKz8DHqkpjs2LKoUW7HAZIsOw&oe=6A258CF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQsGh19sKHYQ7kNvwFtRmWY&_nc_oc=Adpoi-b0PY8RzAKW_pi-8V7ahzdCgHWlWR0D3OHGrGVfY-L2fXUDhqEMEIFtDFkQiIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cFHqf3OrnTNSjnw7gZxBLkuA356qDfSTrjRGo1bY1ow&oe=6A2588BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
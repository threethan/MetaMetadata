8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEJ7YNUsXM0Q7kNvwGECJ-G&_nc_oc=AdoCA2mwcyKgUG8cDMxggdvZ4O-KOdh1rk4w0pkGkHD_i2qOnvewI1q0S3xfzUhtloo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjuhRe35ihxK2qr1Igz8Vk5zecUwCVczFzwKVPBmWlQg&oe=6AF5CE4F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flN660y6ww4Q7kNvwFdWUs9&_nc_oc=AdpVTNCkKV5oHd5iueRwiXGsuJskXWU3SsRnA5LdxEkC6IKfPG9wI2cZmCGuDQubPtg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuIUGY1B0I0fSjEhFzBevoFavPCabqelWw8Fky75T3AA&oe=6AF5D9F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WO6lZkVzo60Q7kNvwEemZIC&_nc_oc=AdpxUaGa7FnIw0k7Bz6-LcDfIuDgc6AdX-WeWp3sE6qwMED86bp-73LnWdSOPPgZH14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtS1RbFBhaOo10yQTBr4K25RElpHcxLt-TYthO-H_Xag&oe=6AF5D5BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
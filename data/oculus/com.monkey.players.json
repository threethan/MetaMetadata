8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zz131a59EIQ7kNvwGOpY6-&_nc_oc=AdpuzJ693aff8n4Juo9HMiad-PVFCaOyCRyHsysqU4O9xVXdQi2epJGQjMFmisQf9XQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKQrSIX91tFm0vu_9FJ9obxEC1X9pFretSzJvLpXzL_A&oe=6AA2BFCF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fk2YMyEqLzYQ7kNvwFpR357&_nc_oc=AdqG8Qk1toZzeFN7OtG2o24tN0t81Ot48o7Hln7bUJS6Gx6o50VYVfg8aXvizpMBaQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1C_J2eQWmnE7LsCsnZpgolM1TJB9D182pewMJ2VfQvg&oe=6AA2CB74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu76tSvqOv4Q7kNvwHmF3hx&_nc_oc=AdrlCt-UOLplYwLEHOpm-E3kQlgVo-13cRkfbKyui1DuhxpTJcSnVSX1tvpb9wen5nQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPPSR-hNvOxc3TmqcwQQNDp3WzTaNa3HRW7a_VbI72DA&oe=6AA2C73D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vFtxsW2Yt0Q7kNvwHDJB0r&_nc_oc=AdpyJ8naFdQw6L2N8bLTHGC8riSPlDc6BAbBzqmva80f6fn80mcBnbTF1qFBSeO1Zqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf4N-KlKO5nLGE0iB571B-1DLdFQKvhADgxdorJFwwGQ&oe=6A5E31CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vd9M__GDXIQ7kNvwER2r9U&_nc_oc=AdqXF4QZVbWl78cOfQ_V9_JAqyF3oc0C7PWli0k2sI2Zdhsue4n-LtJDBKaeOmmBooI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2aHj83PJsCXx-lFpnd9NJlE2e7w4vccXX8SHIsA2Lkw&oe=6A5E0534"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx6gyYRAjN8Q7kNvwF7iE5y&_nc_oc=Ado4lxOHpCw2wDuuuBAnug0WfxiC1_rKhoFqAClV0StxUkIUMLXnSruONSv6D3ljyOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBj7OKJzh2niEXFlFWhnv1BZ7Tzf440Yng--F4TmOlf2w&oe=6A5E00FD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
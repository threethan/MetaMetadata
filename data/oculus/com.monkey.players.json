830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZvAA98CGpkQ7kNvwGMgh2a&_nc_oc=AdoizEXboLCY3-hfoOVK9OfzOFU3jYzK-cF7V_reFZoNzH484oCldYRmOsWMlg1v0l0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy38OwG9BGMnr6Ku63KOLhn6yeqyGcN370iQzFi-mba0g&oe=69C51734"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qO9xlZRnF9AQ7kNvwEsxBZn&_nc_oc=AdpwjXdZd6VWY_dGu9JCAOOhlpcK24NVAA9a4jFtXNXCg0eumyLvbofhbh_hAD50tWQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiWMZadF1rLGY7I77FXtjFUJw5QHqN2Q1Jp6h1LNDL-g&oe=69C512FD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_description": "This is a new and fun horror game with a lot of new stuff"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e5c55470-77b6-46fe-a089-6ddf82a8ff6d", "developer_terms_of_service_url": null, "publisher_name": "S4GE", "support_website_url": null, "website_url": "https://html.cafe/x30bb8e58", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "27433260359
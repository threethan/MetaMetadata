8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_V2fQfqde0Q7kNvwELzA6H&_nc_oc=AdqtV0dWdZ84MLKERRchmtIMy3dgG18Am9S41QICC-SkPzdciFS6jRCmbRe2a6XQjZQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0p8t0UlnPT_oeF9MrwSs9OjP05axPPxkNJz3CGOS4-rg&oe=69F4B9CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9p0-G9X_YNwQ7kNvwHqIx4b&_nc_oc=AdpIk3nfaj-A8RK4unTsy9W0O--06q8vQwf1ip6gLuAaaUWUStmjZYaUjiPgnSdPIg0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HZD5ddvtY_M2koNwkiDxk0YfFDRE09bHc7Wvww8DhBg&oe=69F4C574"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSbYChjSLRcQ7kNvwG-aGjM&_nc_oc=Adqx6VNwUee7R4wG1G7xTVeFhKv1NFQmPlNaS0JLGWUW_jKDzN3HAt3N030djeXfk1I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af22FU4MHxCJTNvzAjzVSCbcxvARvsOrrI791XKfbUUc9Q&oe=69F4C13D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
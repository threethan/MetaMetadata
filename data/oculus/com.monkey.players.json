8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3z1UUhNzU4Q7kNvwG0Ymf7&_nc_oc=AdqrGQHe1b-m5kShgBk_G9eECnbycoZMD_grqtBInvsrd100R_1acQLBCzouvgN7Lw4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdQbtrsAypUFCgphJJU9h_CZxY7WuLmCl-FvRn8ELDbg&oe=6AB291CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWZJOkoUCY8Q7kNvwF5qV5d&_nc_oc=AdrMgZDduNpk4U29S52s0QZhfVmHO8azeBTg3Bqjt6LZfnAOApJJvKbojfqDJKEKOuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-f265Afkp2RVpsy1wMqGbXnS9zcPQpamLe4tzUkattw&oe=6AB29D74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7BBuS_vKU4Q7kNvwGvHLMR&_nc_oc=AdoCHyTiFumbslyGJVdZLiwJAU8P6rSnMUjKK3AhischR36JU34rAqlSqeoTPYNjFek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzsnjQ-MHriK_InkXv7txi0Qwf2w5NQ2cUliT-XKNQZg&oe=6AB2993D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
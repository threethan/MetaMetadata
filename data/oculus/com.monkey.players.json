8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdDNtp8xZ4wQ7kNvwG49BhY&_nc_oc=Adrnh40V9V3Yico-Dib0DocdKUmAe7qKJrRFjBWNJSGmMGAw3DM-Yr9K0hJh7ntoHcU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLvwqgvnbo4kFg5dDrrldMentDAG5-NVjY_wkFsRZiMg&oe=6ABBCC4F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX4sPlTcZmcQ7kNvwHGvK7V&_nc_oc=AdpHu_bSNa8RgyuNLrQu5StyUeNB7_tYdSu9Tw327Ir6HbK52KiZR2K9cJ0kmqog-wk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLigbzqewdBGJi8hSx-7hQ9OEDpwdqcvqkrapP-IWdrJg&oe=6ABBD7F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqQ7s2MrG2IQ7kNvwGR4bxg&_nc_oc=AdqywzdUQBZaqI9moGpZpvwRp_bWRTJ4rIXF7oBUE-r7TwHlPl6nPYjXge7XWpFjVbI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsecXc7E4hMPl_jT7pkKXQ6CQxytlW1tT_t0q-iR57Mg&oe=6ABBD3BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_description": "This is a new and fun horror game with a lot of new stuff"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e5c55470-77b6-46fe-a089-6ddf82a8ff6d", "developer_terms_of_service_url": null, "publisher_name": "S4GE", "support_website_url": null, "website_url": "https://html.cafe/x30bb8e58", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8315286961832889"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974805_838537954836418_5919985423491465889_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDKv0iI4hKEQ7kNvwEob0z1&_nc_oc=AdpavGL5TqJg7J43R0CgeSLFRYlJAVpHIacTC3biXS4LsjrSOY5DyTdkA8l1CrHJ6M4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQYfolNZzKS46BTkJmjqsvPlaUzKabdrqaHDMtg_pZpw&oe=6ABBC8FE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scary chase", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1718139936, "lastRevision": {"nodes": [{"id": "8295422113819374", "release_type": "SCHEDULED", "administration_status": "APPROVED", "p
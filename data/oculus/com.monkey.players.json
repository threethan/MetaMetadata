8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et-bJN9zfvUQ7kNvwGLzpR6&_nc_oc=AdozM-FhVqKuTvMq-xzUYeFAVMuGLg2FpZCywwuZfLKaOueZV7RC5AiTuCIK1hcLuFQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fjW8myCpVa9NrWdNutoIMe0-VlmCe6oQHVT7u4JTVGw&oe=6A18524F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XG51By4GSP4Q7kNvwExjY43&_nc_oc=AdrOzavfPPnthtMUYjChy5ZeRli7TMOLpLI4uKnNS6SNkNJVADmbr4_K7bEj_1AyyGg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54F0PwwqOgWd9RipfH1yfGd0a1xDHnuueFC9iX_nXpaA&oe=6A185DF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCFS1-ixkDAQ7kNvwERQfJn&_nc_oc=Adr0N3z9FPDWuEFzv9EU8lMIW2GQGFBDdHzZ6hZNnd9jCN4D8ZxS8pFfDb9wbohDxQc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JXMsllyLN7VZjgduUuk6429JJ8HxtmBthrkU5b5T6pA&oe=6A1859BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
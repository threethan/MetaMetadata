8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbF6nHzp2kUQ7kNvwEiyier&_nc_oc=AdokEY3Bq-xbGelTlqENqYJbtCVlSAMKM5tmn8Ktu5Ui85ofOCpNd3w9Bk1ISdZyb9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ4-iNNPBNXJ3GUI7hxxkp_OBn-W7nPbrlD34A1lwF_A&oe=6AC3B54F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weuJp2N50z0Q7kNvwHXsm1l&_nc_oc=AdpLAD9UglD06nKvHPgYdBygbBwXPCeB4I0IQJ-i4LBHF8VUAMYNP3__e2qbANneHdg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbGC6RcNSbOKyV3TrI_WDO29Q26uZsNwhPEt8Fe7lb9A&oe=6AC3C0F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhg26Wo65B0Q7kNvwF3zmqQ&_nc_oc=AdqRMBZOTBLSnUdTHAqSqAgavg9ziwNmyonT7GRqFNrwiEf2cqfT07kgv9ajdLLCwgU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOULQEwl6l5rcQC-9XiYGtg66JT4McF_1yfLiVca4G3Mw&oe=6AC3BCBD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
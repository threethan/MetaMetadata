8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LK3DSzIZR0Q7kNvwH2it4u&_nc_oc=AdoVomUeuNv6i_q0bgDnm9OgvuQmnNhHwZgjM9_kA5kc-yutUKRHvYR0mcs3Rrdw2C0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xYKzm2DbBs4WITJR6WXRYR7prvz7jfLZ56Q2RmoEpIw&oe=69E78ACF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKlQ6a5BhfcQ7kNvwGiu1Fx&_nc_oc=AdrJvS2N0UDkmLpAzjtHAE7pcVktOuc-7sXI5J9boKDxv9eC1P3raKTvQalq_7ALoNI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l3IP7tZ9iNj6m_JPB23ruH_gHeQLoLEiuJ8GyTBZMxw&oe=69E75E34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUNQN5-zSYgQ7kNvwGmn7Lq&_nc_oc=AdrNBB1s7XyxGGLHvBznf149A9gxd0x6tRjBgLzW0A3E4jsbjXwyBsDqpdN-p0yxjx8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LuGq48TijpRN09P6qsLiEQ_HG8xWlTvZVw1_93rTnCA&oe=69E7923D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
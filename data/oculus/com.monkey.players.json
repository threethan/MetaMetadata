2595749493437_n.png", "id": "1899277120512036", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031500_1899277127178702_235149441825442390_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bAFXgzguRIQ7kNvwHHGUaJ&_nc_oc=Adq2D-jOkGolPhm27Ma5_HWra_UdJCbf11MwPwcud8frdUtDWTav-pYGDV0sIpUjtJk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdLoeaDJXTUtuIrH6jghAQ2PKtZRuJYdqEIz0JyItZrA&oe=6AFB4C8F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KFwyk7S5iwQ7kNvwGfZFsk&_nc_oc=Adr74ZgYAJTSv5EWFd2xCiSbJIU0cMA8uOKTcNFDkvYaCo_r5Ml0aKNh8uVWvAXTlyw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdezY7oTBj0rEnCD9L422h4Obr_L_DEHwkETNPD2U4-w&oe=6AFB1FF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pOIejjnvA4Q7kNvwE2E2rm&_nc_oc=AdqCmiYmCtx2KBTMbqcc8TWBaxuFAmkiET1rpN_Hr-zUwx6D290gmMVnPhS2yLsTOIU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsRCB8VoJABh_Lmdvq9RpqRuokDFGdoVTwLAa0noJRqw&oe=6AFB1BBD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_description": "This is a new and fun horror game with a lot of new stuff"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e5c55470-77b6-46fe-a089-6ddf82a8ff6d", "developer_terms_of_service_url": null, "publisher_name": "S4GE", "support_website_url": null, "website_url": "https://html.cafe/x30bb8e58", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8315286961832889"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8417530578275193", "version": "Cleaning"}, "id": "986162479622885", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8295422080486044", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8417530578275193"}, "release_status": "RELEASED"}, "binary_release_channels": {"
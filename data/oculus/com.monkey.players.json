8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOshpwTzCnoQ7kNvwFO7GRV&_nc_oc=Adp1GDTW5YJX6VeIhLQAu8SZM_88j0V9ZN_BNjRtiy6__eXgZ5Kc_qZE2fmb4xSvrTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ03-CdXzPB1GsSN7GdXP8Ge0MhKCWy_GduxXjegYIdA&oe=6ADE134F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fljYmsNutW4Q7kNvwGrLDtv&_nc_oc=AdqhqHRyZJV7Ypnp8br3E5u98MWePccJ2NiajxnOLenHaK0QOPkKtp5snsSLUw3tefA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn_vApCFedu3TeKv_KRLFaOvSSKlxdUUk91ycXcliX9w&oe=6ADE1EF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Q47y3oVTa0Q7kNvwFVx3xp&_nc_oc=AdqKEZjHLQVup1p83XtzuDpw-epQsjN4o7-uLD4NLE_cVTVbr3AbyMOWe3QrQJ6yHD0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwWeOBUiA1p4rmpWVGLgDpKOgOq5CKG_weMgpS37gSWA&oe=6ADE1ABD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_description": "This is a new and fun horror game with a lot of new stuff"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e5c55470-77b6-46fe-a089-6ddf82a8ff6d", "developer_terms_of_service_url": null, "publisher_name": "S4GE", "support_website_url": null, "website_url": "https://html.cafe/x30bb8e58", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8315286961832889"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974805_838537954836418_5919985423491465889_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqEhItf7utwQ7kNvwHBvJlV&_nc_oc=AdqZvHx2fza3cSAiPpI7BwNdWeynvjqVAwb7jWga_V1bt9dDMhXsmjmqiObKJt3I2Bk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhwKsxmVN_6kRw_ft0BKJVKENx6_IExnLp-Pe67lC62A&oe=6ADE0FFE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scary chase", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1718139936, "lastRevision": {"nodes": [{"id": "8295422113819374", "release_type": "SCHEDULED", "administration_status": "APPROVED", "p
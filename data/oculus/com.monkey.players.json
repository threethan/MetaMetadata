8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOcZG_baWgMQ7kNvwE5pl69&_nc_oc=Admyl2VfZgymrjPn4XEK0mtN9EhBIfRy4GgGG21534KTGztFYoWDMKaAshFpak8ofmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDKDsmhOPrxZ4a6lglMgj1CKxUD-2IjetDcf0y00edyw&oe=69AFF38F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZajJb23MW7AQ7kNvwGG-UjW&_nc_oc=Adl0_eWQUdz_70G2feic-QEDkMwBWcxKmwVbuzTlvWY9yo_3u3quVfmvLxJOiSMOQj0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzkv0xtCINUDJebQXt-E9n_bLNaImve_ZEflUv_o4IZhw&oe=69AFFF34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v293lNG5LYQ7kNvwEXH9O-&_nc_oc=AdmnkShiA7IB7VUOEGLSZk28hEsoO8vLBJXAkOmm5zJwSMcHBCfirQSH1Alf-geV3Ec&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsZxH3UtD3AE36v3c03mqBOP3MTvp61SKhtJ30PHaVIQ&oe=69AFFAFD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_descriptio
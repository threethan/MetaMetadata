8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pyvHh0Xf48Q7kNvwEhg_V-&_nc_oc=Adp1OdsmSsegMhNqg_F-HypNdG8a6mOb5SraRuZaWdcW_4EQhD_Y-GcadKCX_a9DrMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zlaVo7ypXk1ktspA3_PZA75aLDVav_XZzCC-bUDaTYA&oe=6A2EBBCF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0gVh0bsVA8Q7kNvwEmz57I&_nc_oc=AdoN-4YnzamrHKnkQS4BuV3YNHoxgbXjkZXRusZSSfwL7_zxdWP2YQSZSRwGMDirqhM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HaIcJVhl5LVIylp3Nc0Vz81mdMCSr4W-RmU5y4bL9PQ&oe=6A2EC774"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqPIOgb0dYIQ7kNvwHa_UUp&_nc_oc=Adqp1-T1Z5Q57Fp3k6niBuknCGxrnwm8BQhIpbtBSwnmaHEGefob446bdYSfG4wY0fo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PjvKb_YKkwT_PRJyE5ppIyLd3xHK-TX0drh1nppr9UQ&oe=6A2EC33D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
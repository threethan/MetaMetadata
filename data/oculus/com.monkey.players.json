8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_h7osyZ0kG0Q7kNvwFO_uW8&_nc_oc=AdrjMtxlBMsZVaL2go5x-2_0vn5Q9nX3jj7cCZRzm6rjwq6WT8Mo1lkUZwGDg9CcD4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkpWrCw0Xq-OM1WP36EpFXj5pIH3Q0m4KIqp7HVnJuuw&oe=6A62264F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRKm2yEL9-4Q7kNvwHgxubi&_nc_oc=AdpXgaEpIL_-iEZDjHZGozreosqIBgJNT6fsNFvKUVYYO87apJM1Fy_WhaHpqP3vS-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxbzUvQ-36EE8jjlP4D7_a3UC7iDtfIFZhPfs2exu-UQ&oe=6A6231F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpu9j2fy4l8Q7kNvwG1b6NW&_nc_oc=AdpUiU1ZH-6iDCszbO7Z0vyK87Cb9wf-U2h2_FkFHo-ud80gr9c3xhU0CN2uk9Rf_Po&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1CIrm1CgWFMMiXbVXwAQq4W17rjECYLte319a1VNL3Q&oe=6A622DBD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
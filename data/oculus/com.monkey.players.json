8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nyhlH3iyXQQ7kNvwFLVDyU&_nc_oc=Adqtq9sPUOQ2HmitmUEp4H4gQXtiBUIKaOP3jSU9-orUXWCwzV5HscXXPftKEVyVQBI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzdcsfc32nO7crksWdtTA1oBp4VvV60B39cI4WHT4MmQw&oe=69C7E6CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFWgGfvBKy8Q7kNvwH6eMwO&_nc_oc=Adq13Og5uKBW4ZtfAXR3itlY6ErKj-LTqUpfaZgpo0hPB9K9yBwPYfq0OQ38JetTMX0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhJ_t9rkHMZBTPlc7-vUpLkD7A2KPRQfnTLn9EAFjVzg&oe=69C7BA34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9isK8arrZ8Q7kNvwFdxpPY&_nc_oc=AdowGHGYLXydyKScOIbF5xKqN2hgIQxJmRP7pC2xYEwKc57eggifjAM1kJGd8l2eF-Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznudDZ5zTqlSwPH_BKGu8uphxBReGcpdVKUpNULr1ARg&oe=69C7B5FD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzHrQzryNYIQ7kNvwFY4Tvl&_nc_oc=AdpW7cFNqsVIwWbBf02TWNst_FvfXK2zZnCnP7WsISdOzkrVmcE9AE6zWQPpqpRCKaU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E60CX1bgsUCCFQ3u-dxcQmFaqUnnjsKGPY2p1_B4hMg&oe=6A2C18CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f-CKuoHZJMQ7kNvwGAr7x7&_nc_oc=AdqutljJItZaEP-AQGqDbKfljb5TzsDb_5u6a0cpuUwD-mDv0s2qh-vPI21Mbom1hU0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ipjkWdo87U2NoYPkf9hDq7A6s0m2TOe4ekqI8IO8pJQ&oe=6A2C2474"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhvF_ikEvr0Q7kNvwGB-KnK&_nc_oc=AdpHLgNnaPDBum02g-QDpLnn9sxD00BJoZcxEBeoS3dUe_P5oimiROClT7mE6a-aYOo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ujl_r4xrO3804PZ83ngN3XvQhY3jreVo_K2xm6AK52Q&oe=6A2C203D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
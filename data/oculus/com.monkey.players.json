8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe3INtQ4XlkQ7kNvwEbv4iY&_nc_oc=AdpURja6U2doQv6xEfKl4frf4gfKA3FtoD1S_lvoL61vaLJ7CVenOq9e6eC6IZfU72k&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUMWbgvw-b_FuM92c5CEMvW6vpEmgX7S0e4BuDk2H0Bg&oe=6A91640F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o0juu_W8bMQ7kNvwE9YKR5&_nc_oc=AdpGVMMxu8hgKn91NDuBKNfsBLkN-tg8DOKOAvarStHL4HMFqzyTkBdfmmNyG7RiwOI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw-o0cF4yHyDBeryVp_yRr9OYzn7ESkVblMXGcrVqFiA&oe=6A916FB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5toSfBVIdp4Q7kNvwGqm4d7&_nc_oc=Adq6evbRGfjmshkbbUtaXbOHFFoYfdyOQDKBubKSYPIXZzmreJ49VgXCYIfUt7zodWo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLIsqVIl6KXIfXF844tsnaMMdwUtQjgjQfZKcMhLxmng&oe=6A916B7D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
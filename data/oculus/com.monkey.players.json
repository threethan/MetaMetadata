8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMLmXjX-g_wQ7kNvwGqgvbJ&_nc_oc=Adqwam66IwQzzkQn-Dl8Qtz4uW0h5wrpJWABju3siMkbAikGZs6VwSR7BJvJ12tuZgE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_IjDocKiUSJWV83N02SNFkYNG-y-WCZlF0Gv2VDIXvw&oe=6A99854F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lEeTOTxeaEQ7kNvwElZxDu&_nc_oc=Adri7LZQfLzLy4kIqrYRxPAQqEUkMpIAmLmZBnwOwlNR-JGqHIkWN0Ev5iL-cuvxuX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-8_EXt9rd0zq_ZHCo_l84y_0BFqwmJCgYZ2aPMSpGTA&oe=6A9990F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pw_vN3dys18Q7kNvwHq2Ril&_nc_oc=Adr3dbcfLLT3ppZeCsXP3H8zewcM_z8F-Tk8WuaDw1y6ie0q8FH5-zXtJW8ci2DGZ94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzFFJaoCCpcOgVsupFx4DNi0fjytAOkQ23v5aOd1q-LA&oe=6A998CBD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
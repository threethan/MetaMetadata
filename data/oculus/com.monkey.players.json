8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSckVQP9kgkQ7kNvwGMHaSi&_nc_oc=AdoxcoGoZNnMI2riCHCKm5jSkMHrlPOmtl9zS899KsOr1hvHx-aA5J89LC7lotnlqSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFgvOo2zs86rWHKbSvqyf-gn97W2--oGCWSInD9ZvFZQ&oe=6AE74DCF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcJY6NjoK9YQ7kNvwF_gMho&_nc_oc=AdrMoCufCXELzh42_YoDHsc4-sfftg5MnkfyDebspBzGBXfxy7pE0LvCsp2Fhf0Bnfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjxuF3AYrOkVaayh4ySv-Y8z0Qpbi9epq8J4BLHjqdmg&oe=6AE75974"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXr-dsUQT0sQ7kNvwGimcTX&_nc_oc=AdpYDiNTnt46JdUtKsOGHPq-ihjcEwPMZo1pk4M6omAkXs26U_oxt-_KFaNJVj-jxE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpKwiqQ4LoG7srsjsx2o5999PwN2idnKAGhZhN67uxNw&oe=6AE7553D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
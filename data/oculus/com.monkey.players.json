8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vFtxsW2Yt0Q7kNvwHDmJNq&_nc_oc=AdpyPUxk7MNPbi8z4MWsdwQAV8uXyUD3dWnz2zjFr8DTvz73_1JkkTKG45fsdItJ_Iw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAERxgNF6dw-WnRg_Vr6fUBmwcbmH2SzCn7RQBEC-NrGg&oe=6A5F834F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vd9M__GDXIQ7kNvwEZkrg1&_nc_oc=AdpiL-tWrpfL6TmwhipRxS_C_hVHyCwVKdSbKRJZdTQFwTww2_jCPDbPfYpk_xEIuTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY_1Cz1woQln6M15jl2oKUOckVmOE4HbI3hKzxqDqy-g&oe=6A5F56B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bx6gyYRAjN8Q7kNvwHA-jA4&_nc_oc=AdpKJtDT8wsRgQmb2JwFX8m_DpjhOBiKO-C9IDpRHKsxGz6gQ-G06Aun_zyE-JX0RIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt43xph1M11PFzOXvnC_SQ-4vz_2p9GSBQgqrWB_oNQg&oe=6A5F527D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPxinl2-Yh4Q7kNvwHZrIWD&_nc_oc=AdpyE_HaYF_F_yHPM48WmXMRl-rvKTS52mThFFQK3q0WODeqN7Oly4t_c3N8-SxyzbE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AotL4leOahC53HXuti6KL8Fxnw3ELMlXV6Q6kPUNWRw&oe=69FDF44F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lFf_iwEJq0Q7kNvwGokXC7&_nc_oc=AdrZynbS6QJbH3ow1NL6sCg8pp489D-FcJik23aWlUL9CbkQp7CH7R3_w9amnhiSSmc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KlEzKrWG92SSg0MDnhZFY0DmSIMoFsWucisGO-yZR9g&oe=69FDFFF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPmiTynoSDEQ7kNvwGHUW91&_nc_oc=AdreDZa33_LdXLuFap4lWX8KQgV2nXlRO3qxwpwJO1CRq6D-G_zwCg93rTXd4cRzTew&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ky9XB2YvTigIgpP1C284Z22r-jTi0PGIJi4m6Y5hWLw&oe=69FDFBBD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
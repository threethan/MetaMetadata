8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9q_VmI47qsQ7kNvwHtvExW&_nc_oc=AdldOAtnYJt_1zxlffuF1a0NYrrza9K3JDGPrG6HK99KC9PiYIO-xGmg4m_GgGIPD6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwseKp-Pr_rMDxHITru1yw-_a_3YwDtx3w85sYaNsRJZw&oe=69B68B0F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IpNokKXF7oQ7kNvwEpnKFG&_nc_oc=AdnCXO220ZNcarJecjbElD7Mm_ije8__YK1NUmBH7P7_PAWwBbBUYm3BeECB1-UuJ-I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8mTlsu8CujEVK43kUmUq_iwCm10ES14TAIl0x1t4h9A&oe=69B696B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeBemGqx2MsQ7kNvwEgeyKl&_nc_oc=Adnr_M3Zt0VvGG3CVsK1mVYg7u3hnzVuQJleg90kNFKv9VyU7hspuIQJ2Y2IMad6VMI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-c4fQGtI27scRoRbg_fs-94apbjH05UAzg-ell8TgDA&oe=69B6927D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_descriptio
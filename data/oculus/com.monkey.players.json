8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76DYBJj2YT8Q7kNvwGfkrZ6&_nc_oc=AdoQ-7xZkxWg2rVr3jRKUmysH5ZM302P9xVcpAjxAg4OJvV89GWJrVScGRcftGzYUfE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBc8h--8SUHUxIUwrJWcXV7jS6RluHDTXNtEmps1XUuMQ&oe=6A661ACF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otqTX6VoXv0Q7kNvwElUKYN&_nc_oc=AdosYXXHc2aBYKUL04sCBD1UHLoyaB13HljnVM9TIpEa5tpMOc17HL_4-wNeJNRdeRE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYmQzwZsQT5bn1CLE3XN5pggN1JTKP3DBZWrz9nDUtoA&oe=6A662674"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb0JimfjrnEQ7kNvwEoztU-&_nc_oc=AdrdbfInT7pJKF5lT-J5ul6S8iMWbV9HAj68TqoNSC0Vgzaq9ebQXpdoeNa5LKawG0w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXlzdKavkkugxnwpubcchiWe74sXxrDNX89V88_Fk7Ug&oe=6A66223D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
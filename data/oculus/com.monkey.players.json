8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVxZf84yYi0Q7kNvwEyj_8d&_nc_oc=AdqS_Lm9k8iYo91xb1mflGwKHwqv5cnVlQW2W7Ad1Qz-YovdV2xOCybMzIXdkVS2Pf8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3VeSYOfN_X7LDOXOV8brYI4Ek7anW4uDwuaHVM1F76w&oe=6AC506CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weuJp2N50z0Q7kNvwGs8fri&_nc_oc=AdqBEYeLLnNWmSiq30ML_ovL5HYmsgvFelybi4kvkep9YEwdhVwYBMYyAvB1asEGkPI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd5IRJPEsG2CQ75zzXLr1feIhBrjUfCfdoWesdNtftWg&oe=6AC51274"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHvUNSuU1nAQ7kNvwGN1mNp&_nc_oc=AdoXiO3ngpjE6uMvFgk24NCkopZwjVM6s0tQi0VHFof25KHNht-OTBd0865iWp3HwzY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDSnbh0rc68WDXFwlIs5Z6K9TSI9w3vNS2ZESIWqKZHQ&oe=6AC50E3D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
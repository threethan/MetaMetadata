8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpGhqRCXzUsQ7kNvwGw6nSs&_nc_oc=Adoymgfo6VU_x-jEuEjNmaeThwsMyndF-f90_C3FE0Wg3YmzR7EM5v8J2nRsR7guY34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VUOC1VuLhtqFKfd2pcljyTtLVXISq5hBrSG9RvDDIkw&oe=69D6674F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LH0IXzP9kNcQ7kNvwE75q6u&_nc_oc=Adpx_RW0n-0NFIvW-cpOhqguG4pnGi4VhxcjkrzzbErXQS9GcYH5l9o29o28D0Hwu68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17QmmSNWceI3ZpPsgL7EpHqY9HSsFsr4aoXwKhis1Z3Q&oe=69D63AB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UG-P12ub0KoQ7kNvwH3tk1m&_nc_oc=AdoFyk3G0oL-Tdf3Ro5ytB7gfBFJRz50s0zPuINjT3lPAVr6EwsPaGUZPypPRqELAns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CbLWOWDkY5kGpcy0xDTSZSNFPMGi2giX5_yg8Gc1siw&oe=69D6367D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
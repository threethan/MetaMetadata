8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fmi7WTS4vsQ7kNvwGFysLJ&_nc_oc=Adohowbn0-vJYTFXKbvsFqwzAPQxID2hBPDWHfFB2vxj9MqYdScmTTcCR5dIZ9IzsSw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjOhibyeoEelSNRSii_dvlygFkdpwkpMlRg945k3BrGg&oe=6A579A4F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N14ouc1eqGsQ7kNvwF1ZVMC&_nc_oc=AdoBEzEYQgU3sVDHIC_ckTb5d3RkF9PoT3zHjXa2Y5ivjkWnyIjduVzITXdbzyKS43o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbGqtH52mRX8gKYFp6XBhmZ-9_wIvUun0VKL81d9VbAA&oe=6A576DB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6p8t6GQ1UxAQ7kNvwH9AnI3&_nc_oc=AdpWN_GD-XMThrCIQmeYzARsl-HZmYHuBjieqO4Svcfx-tAiflL4gE3vAUZQhd3s9jE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-CM_gx4GeLTYe5Ib-GbMBZA35ufN1od74kmA2olGZ8A&oe=6A57697D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
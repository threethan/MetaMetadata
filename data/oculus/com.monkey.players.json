8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncM-u1mYKm8Q7kNvwHbzhCA&_nc_oc=AdptxcZ1d64gTNMoqaHtuB9X0cDrlcpMZleNsYOabwhAR266FRepo1zgmJJ424VhQjg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCahzhz5JUo1iEfkcFI6KB9e2ut8Y5yRuhxRUI5DWHXHA&oe=6A6B60CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LhyCahvCkkQ7kNvwFck-QH&_nc_oc=AdrPg0rLeSiQ6hjefnHgacA4_X42-Td18E4h2x2o-JUfFQJo7Usdphdb0XHExMkmn-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkYknlF8EtA1tDVDZOr9Gfj45BzkJ4KaD1eGMcwyVYEg&oe=6A6B6C74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns93to4kmZYQ7kNvwEp_LcO&_nc_oc=Adp3mSJdLga70vCjFkuoemjYOrOM1LmP0l33sSm7kIAHGUgAEk9oh0n77NCRRVSjzlI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh_X7TSkmoUeDX7ckNU_na6i6enYB5SkrRPT0mTmk-Og&oe=6A6B683D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
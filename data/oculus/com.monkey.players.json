2595749493437_n.png", "id": "1899277120512036", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031500_1899277127178702_235149441825442390_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xzzl5sZfjZgQ7kNvwG3mJJE&_nc_oc=AdoLkPwuNcX37CVpUXHZAe6SthN9JOxSa2WNrV_TrtZDzn3n7ojJHWPCQcQXwAoCdOQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYUISCnBRWq09JWJ6-UPlwWG6tCCrvlAqGL8a9enXKTA&oe=6B0B1E8F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cldFeMr2ODcQ7kNvwFnJxOW&_nc_oc=Adr_HTPIDp-yjj9SokpKwf4JujdY2UTf4ttD6rdbo2B6p-5IupHCEnxe906s1wO87WY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7EnNbw9uLPQuaR08xm2N67bmqfI8XyHVmbn9SgBjT9A&oe=6B0B2A34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XZiesyIfncQ7kNvwFBj_Hr&_nc_oc=AdqZIf8qxnCCaLi0efU3-4gMDsgpAJL2cmOHOV8oNMPd5mKLNhVtKD8smvhCYPL5Ecs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR47G4Uhp0CopB1EokBGEyANFYfbpYJM7E6DuHx4Bbeng&oe=6B0B25FD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_description": "This is a new and fun horror game with a lot of new stuff"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e5c55470-77b6-46fe-a089-6ddf82a8ff6d", "developer_terms_of_service_url": null, "publisher_name": "S4GE", "support_website_url": null, "website_url": "https://html.cafe/x30bb8e58", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8315286961832889"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8417530578275193", "version": "Cleaning"}, "id": "986162479622885", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8295422080486044", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8417530578275193"}, "release_status": "RELEASED"}, "binary_release_channels": {"
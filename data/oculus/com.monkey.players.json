8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpGhqRCXzUsQ7kNvwFZgMyI&_nc_oc=Adqx56i7rv0uuNqpTGeK0qWiHXWNfdUZ3uZbhN_VwBXNrkLtYgekQc8RUsRzn7ISxnQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DOFWtM8pcK-sKrP4ugz0m4ON4bX28DRhVjeJxriKCzw&oe=69D3C44F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wbuiXYffxEQ7kNvwHUNHRy&_nc_oc=AdpxC7QFA3Z1rqpK0AmBDp30TPodL9SzSqJM1oXUffGMzV_84t5C4-qE2XgPa6qg3Dk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oiAxZ5JDskplRCZmpVSSL3AyOe5r18bHzWOzoChl9GQ&oe=69D397B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UG-P12ub0KoQ7kNvwEVV_tO&_nc_oc=AdrxF4GQOLKUdj_B68vpT35ElWax3B4ZQjxeKhlfazB03P5HBtFmtZGJHixjDhJCYFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22miQuImYcPSaTCkZcbL-BdaBhJWq-cW1LcQBFxQGKog&oe=69D3937D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
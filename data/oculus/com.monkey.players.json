8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCM7UX4Uv_IQ7kNvwHUm4L6&_nc_oc=AdqgpQSq8XVbRJ61uqIUYsKUQ6y6rQ2Md5O5rPOC6eYZ6TYURfD07b8F-aMde-V929I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLPULkt_TGPLtaXrGpvZzSeG2Fsir37sdGrhQl9a96Rw&oe=6A7F274F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efeNG2K6akUQ7kNvwEKH31T&_nc_oc=AdrWkqqUZu0rBkf4l35LRiRyI-twTB3sms81Z9Lpv5c7cayWNwpxA8YKREFPwemwOPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0lfRoifdtmoB4OyqlWw6VUt8pForYgk7nUpI3FB07rQ&oe=6A7EFAB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HzgnfXV6eQQ7kNvwFkU3Vh&_nc_oc=Adqc7U0nr9sXc6UqJsB0xSiBm6lXza2UcguARZk-xwM9eCmJ4-_rrQl56Ag8f5JNzGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgDLjYqhlgK7LVoedIeugVTfYlr29J4lhq8na0-g6dwQ&oe=6A7EF67D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
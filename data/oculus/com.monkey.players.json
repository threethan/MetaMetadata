8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BukfjfwPLoQ7kNvwFdqU9J&_nc_oc=Adohk2mDRd7HV2io-CCxB2eKyOhZ75RI1VnmmyPAKlUiG1X6uz4DD1azkxuAH2v1beM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgWvLzw-h7qK-3a6sLAjRNSuQ-Rd_ClaXZVbGHjF-sRw&oe=6AABFA4F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUdS84ec5XoQ7kNvwHe_aAy&_nc_oc=AdrATLGCJeGW2PFdVFwPEswo8kl-S8m4lKM6IapaXW3T8ZpZBu-JKiGP4RR9mKI94s4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1kbH4hoDbtmNOhx4bFLVpscQi0h5jZqPcgXsgS7dM6A&oe=6AAC05F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DR_KqM1d3eoQ7kNvwGovnRt&_nc_oc=AdqFmWwRVraXaXB6prm4ncziipbrmb3lhpY4cXCf-l5MMZbXnXVu_8zzL091g7u4Vjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCQduNUfxJhPxEW9S3llfJzWIp6ihudthipJ67oGVt7A&oe=6AAC01BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
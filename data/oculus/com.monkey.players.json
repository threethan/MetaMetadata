8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0Mf4GMlDfAQ7kNvwH8A5G6&_nc_oc=AdkfGiIOYcinYyqcJjNwOBHHcZtXfDcMake9ogj_tM-TmAejOXDmDeIbDvGh2I9y3pM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1QhkjXhx4EQ9f9C3DXM0P0LdgJdGiE4D75Phs-9Al7w&oe=69B9664F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IpNokKXF7oQ7kNvwE9vPaW&_nc_oc=AdlIlpDTDovBTHR1IZ6Nn6TjOJyPEe50FCxdSwJ9bdyi_cVRGcMTjUHkSE1T4hgBv-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxYpbx98KSA4gF4ByLJABMnT_ZdYiYEV60brBTdXssyjw&oe=69B939B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_5B5xS5ecwQ7kNvwEMjg6N&_nc_oc=AdmvKkrwxPC-t6WsmKsVB329Uv8LgwnGB2VYVLYnMOaJBriHC-DbickAFkxdJvfDDGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyex5xA2Jb-eGihbgUGacwlI_9pMPRXMmuxaVd3zwuSxg&oe=69B9357D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_descriptio
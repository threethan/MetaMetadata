8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FllbtYzlL7QQ7kNvwEW9oO3&_nc_oc=AdmgFNxY8dn-kClTMj6NZOwBBJOmkcEAKYeFpq-qBNPeEQhW431hTPUDDx3Y33Vy2ys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXwq956H7xGwz97OCWXOOvvzJ1M3NKTNAoXsz1j4UBQQ&oe=69BC094F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJY0OvC75I4Q7kNvwHvd8H5&_nc_oc=AdmovpWQWGmz7DZmg5y3ibS-w_YNpQFnrsR8FeIgQW1swbjz8X3dGEUnObW3fREoEqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxvJukMl5HLdG95BNxthsnWpzapGUJYSe-H9DwheiQxhg&oe=69BBDCB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_k8NzSX9wa8Q7kNvwHuNYsx&_nc_oc=AdlhaIl2M1O-Gu22r0ADY0vseDijx95mSouTQWZUPqcgRHb6xxBOokVHwE1Kr_SaAmU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzGKR6QoiJdbpqz0L2s9Xffzc9jQ_TSLEqD0vPjJRZsvw&oe=69BBD87D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_descriptio
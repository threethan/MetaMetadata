8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEf5qnI-KKoQ7kNvwH7byaz&_nc_oc=AdriWRaH6Vnpd70_VUaaCNcl8q1iA1fBsEwZuj3oPPI19tCQpBneCh9RklR17-YpOCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af638pyQJqCL-EMjNv1_n67NZ0vDCS-f0vVflk-K91FR3w&oe=6A05DD4F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XfcwrHbaxoQ7kNvwG83fzw&_nc_oc=AdrpD58XdeuCDtGrBBCv3WJF75Cue0mx-rXGryQIt9-zxdoM8WWmMYe29QqORvPC8eQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dLMAdeNCyJi_QINGuiQ1_ORXeY8drdremRx5LswfiUA&oe=6A05E8F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egC8z1UZiEoQ7kNvwG3LQrV&_nc_oc=Ado9RH6HzFLdeY1qTiYurTWs6zt8KgmEchxs4o7HqRYpfuYyH9wO24NqT-DPs2AwHws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MkdqfjFTwqi-E45X6OMcVQP7NSafERqCEkOKE-wNVbA&oe=6A05E4BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
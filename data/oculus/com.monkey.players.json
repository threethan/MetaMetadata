8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOcZG_baWgMQ7kNvwHVXO2L&_nc_oc=AdlMXNM-VvKSliKtZgKTJUzsn1q4EsPCFZmvBh2a3xE9o5gmIaFgXI782aeamF16b64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx85g0t3lLQ9qJ197oMCF_cbzHFC72fF-jZ02IDyDcEVw&oe=69B2CECF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pZTBcQ_ZUYQ7kNvwE6lSU6&_nc_oc=AdlanHnbj6MTrtqLOnjULOB4s-pIrFxhq0i1mfw7SBvaEB8QPBV8nAwtsB3Jyx7jQqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyDQbhTcbtVT1WwtB92xHRa14_9VYqOOgCFBqe7VXgKHA&oe=69B2A234"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v293lNG5LYQ7kNvwG5rTmz&_nc_oc=AdmNd6NArN5r9Wq2SeWTBSN8kLPayRq5K5aMicb-86D4Umq-Wpy2W0qUS92ccEyop2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwOiZ3gA0oEdA7MfCSFAyevQWPkLXxg_EVC7jBwypLAhA&oe=69B29DFD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_descriptio
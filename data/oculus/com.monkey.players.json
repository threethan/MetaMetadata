8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnHDUl1WWgQQ7kNvwHvtYzD&_nc_oc=AdqG2Dh_PLCsg5EzxEjZRLtlofdL7cUnJVIxQuAbTD5F1J3Ye8U4Tez8lcqdn3UkIxo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2fIfWJ30gZ7NvVCLVpI4uMTgGAOpkZdYpblZ5FDaDqw&oe=6A35534F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLRyC2QecokQ7kNvwF_VoXo&_nc_oc=AdoJ3CIVmKqEL7gEjALUs1c-lXSczmVCIO0seNbMZ_DN0Yr6Wehc63Zfj2LcnYdJrcE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QGHbjQsTad1Nd4EKZtlaCvxC2qz26Eahv5f34fkjqDg&oe=6A355EF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLYU8uAXkEMQ7kNvwFguB4F&_nc_oc=AdqBOzhbT2iWtUUSHx8NuRzz4IzG8_tAl_IzhcfLmshn8EOho2WZ7hHxu-CxVYK0RPc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h3koZ6G58SC4Ht6N7l8oUe4A7VQdXaR2oTCFak9VqKQ&oe=6A355ABD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9uL-hEloWQQ7kNvwHH_rDW&_nc_oc=AdozpFL8p3NGj_-d9wVxzP_ENQZLMQULAi4liJWfgvNIT7gF19PPZoOfjvlBgHGD6HI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q2K3LxW0yoNsbo89gaXqtos_Klr8Qn0wI5cEL3RRsTQ&oe=69E4E7CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vP0lB1SYUTEQ7kNvwE5ycDh&_nc_oc=Adq7JqpNxriyQ8w8I5PoQG5S9QCGOIhPVHXt7gFNbAfi2cpU61-MRDcl9LNi-jgNUP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T_t7REoit-iJRBrPq_DS5tFbELNJpnX_LuLb2itVsgg&oe=69E4BB34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-g9GHAuu3EQ7kNvwG-wVez&_nc_oc=AdolgVo0h59tvhCpEObjnqQ1ONAGCPnKt9_N0qiS-ENwLaGxxFkN4S9RMr-P-RkB1b4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ydPfEAlDuSv2MSMx0rwywu2v800d-Y5b1EAOdFc1uiQ&oe=69E4EF3D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzHrQzryNYIQ7kNvwFp3L8N&_nc_oc=Adr7xw7cwBhDP43KbWU-hsuLKHsojHT4JmtICPHZ4W2h_rwFhaCLO4UVuo8r5ZZqKQM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sEIyZa_B3CpZaadTg4AZI-jCI2_sl294eAgYNYY2kWw&oe=6A2AC74F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f-CKuoHZJMQ7kNvwEPcTwj&_nc_oc=AdrzxRRnWz6gVB-Ny-pOQcLKXVjgQGtqJJSJm8-KWB16gSi_eBHx9hm4-Bfu9Pu7xwk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XFTJU72NJQxzj7zB29ISQ59uGeoWvIedUOG5yUadv2g&oe=6A2AD2F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhvF_ikEvr0Q7kNvwEqmCuy&_nc_oc=Adoq9Rjs2o3epjdRZEmbGYF9ciV7IP5cfZM4m-gP2aUgX1xHMBI8b-tFNk7qjP9uKl0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e5tYOP2kwc84FDWmMfQi4-Vq6jQQHoofRBPX0x_3aTA&oe=6A2ACEBD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZHcBBNJV1oQ7kNvwFiAE_X&_nc_oc=Adpl2ZqbuMuiS3jA9aoWn6XUzxX17p-VmYS3ptBr_4sRiHrkIE79slue1HrWtAmhGyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a36nMgq8XTq2_sdYKTqUywTq8Qn9UoLUrYMMVi8hN-A&oe=6A3E8DCF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vdBtWJQMLkQ7kNvwGJnSa_&_nc_oc=AdoOqP2sbabxkfljaVFAwRDyjwtHDLO3CACtaov5cq8Bf3R9i2RWvfVrBC68eCQHt4g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O7cbrCcUwl5b42JEhPZTK55CVJK_g36Lb2IhQjafyyw&oe=6A3E9974"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnkFt0iUs28Q7kNvwHdypvJ&_nc_oc=AdqSRqYW6SC_IGw8njZWaygDCo9mh76PRKazSu6UdX93FWgm_xJLl8HzOMqpkAYtDSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ocua6s1N_EWLcjDpimIwN1tblNsleFM9Qemg2PRxuEA&oe=6A3E953D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
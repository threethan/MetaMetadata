8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jljuY3Ep2nUQ7kNvwEu4MS8&_nc_oc=Adqh2D8eJkNLj9HdTp0yDEp7e0qOMpYfUky-b0YNim79578ZK0dN5as6aDXC4Wm43RM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JvH0Of3rRDUpWS3BTf6ewGnTeXQWktkXnF0CCW1Ab4A&oe=6A3BEACF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GO9AwwxAckQ7kNvwGy4_wJ&_nc_oc=Adq_6SlxqHs7JrL6MgWv4bjoD8hUKpABJbsSN1n7vbFuyQXe2Ji6kn-FZcQBxHX_4Gk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nhgFp9GncHd8El4784VZXkGAdcclG3Fhd64CYOJ-oMA&oe=6A3BF674"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3rBvK18kQAQ7kNvwGFa_8R&_nc_oc=AdrveA8kOTqqvGLYHgsaVDrWBD6FWgHnaCtc7lgUEUHeFU4XeJ2UWPy71yRFLFoLytw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Sect8Sjm69xKozWHe4caUv3CLF5XB1J1VIuLpHXVaBA&oe=6A3BF23D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bJawfCI7OMQ7kNvwHBfK3b&_nc_oc=AdqH5vd7bktskn9cmWnulOPOfmoq99alKMvTpqJhkJtabaOAztiZTfOvB0GtYAz6jSM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRlUxSz7mx_5ePZjJoTgTRTBtUZJJg-HuEraDUKnc1RQ&oe=6A70A6CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0SjLUc645QQ7kNvwG61CP6&_nc_oc=Ado950UZVUrBR1Wuy0rAvN4zFS9ELN7BbZjMvmiS7cygoLC7i1soPniLLhIrmigUKOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEY07Dbg0RW0OmJGqBKgd70-xQtbXJkoj0AxElpMA0Tg&oe=6A707A34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEXiopSzdD8Q7kNvwHXxcqy&_nc_oc=AdpQF1JLsry9nIdxXTeurHobA7SCca57frhuTn239xqETKRbgpNHIQTOPtUlXfPgsok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBetQLCG_n2H2JdL1ueNRdipdj48-0FxAkQPK6m-bYrw&oe=6A7075FD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
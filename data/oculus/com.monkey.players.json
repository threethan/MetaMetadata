8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWLn3_pcjxgQ7kNvwFIhSJy&_nc_oc=AdqdkG9coULtES_QEllcNCEX_ECwECUaS2JWEkSAqqq9SSYaYkYqkQ_RX4N3TKa2FzQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEE5PvzfOuEjzGYpYafeLcMvnPWGxNV-VBM_hkjsAvjQA&oe=6A79E14F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKo9NGR6JMkQ7kNvwEW7N_U&_nc_oc=AdrAe9QA5FHl89F3_TsXT0kvT5erwHxC8-7S9Xdw3SNeXZTX8Y5un3vX0NJRjkVkLYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg7nbQtRepKH5TV7ITTAqUu-SQXOfPK_Pqe3tlsxf65A&oe=6A79B4B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dci2f-CUE8MQ7kNvwH7-7RB&_nc_oc=AdoCwbbPHqW5mt3oO2Iu07tGcO1OkA-F0YIYa6okZxGJOcLwvkoT1ug9xOJKlkulPo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjOkFx-_WRufHYtABDP4vOFLyW6huMLXB_gZsUfbFe2A&oe=6A79E8BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pfjkam8EKbcQ7kNvwGwzK4-&_nc_oc=AdrNU0qRkj0FF3Ymk-oNrwUt7gCLFyRtU88gtdERX3-PjNLX03iM00p9mN6Z5YMy7P8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yyKYpGC9RXqE76W8kWPRZNKwkOEapsneyCGZDs-kLcw&oe=6A0B234F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwKY_0KjgrsQ7kNvwHHWIcg&_nc_oc=AdoeOwWCsGb2QrS8jBbhINpPu33ZSu3SOkMSEmYc6UBolVuezMBJ5UILWmyf2zT3HtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gMX3Cpbba86z61qbX6T5rSlOWT8e00xIDxykGNtm8eQ&oe=6A0B2EF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMOq2XkG5TgQ7kNvwEYLR-T&_nc_oc=AdqlcuUoTsK4RreW1wCkMiwMxHuzL8y0DGG2HzFyym9eT9oWwwuxk0Vol4oY8egWRBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NzQ7YlRPPc7VYOw-MKoC9y6wTYvO5VnetltCxSERp4g&oe=6A0B2ABD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
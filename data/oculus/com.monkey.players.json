8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw_sno8WheAQ7kNvwEbpYLV&_nc_oc=AdoDL75O5C93xguggUDVoEwp75wLTznNhhwFWWgK0OmYg_GAenqKbNffplgGfajAYXA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa85ZZfzUxrW749CoJBvJrI6VXG-iTN5mzjx8LIPCcKQ&oe=6AC8FB4F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w49KJbPx7CgQ7kNvwFQJMhO&_nc_oc=Adqw-pkFxjkkw8fczAK2PK-WNuo-1ha4qbizWw4o5LwpnWgtyfn7hSF6aGK7cZFO16g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTOosbjfEPNog5vpP17gRvqFGM1XYqbjMLibFCXbO-NQ&oe=6AC906F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdrmUUsPJjkQ7kNvwG491Ie&_nc_oc=AdrHLF-Yye9MH3-EaEQjYXVDpGzpXY8fPrSjHwJIR00x4eRKf6JjSF_iM6frGOCUJ7o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV_SAfJxaZ27aOAGc6gQKcixvrpIlV81JIRI9CJXPrgQ&oe=6AC902BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
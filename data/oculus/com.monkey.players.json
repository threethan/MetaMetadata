8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJ7_ZFC3VR4Q7kNvwGH3HTs&_nc_oc=AdrnT0MTPjmrVIkNqEsruaC0Eb9BLRn5SAqtcBkKcBPW0-d5_TRP3sT0_RLlPvkKxeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5hAWJQOpX15aKWyTuEXqUGgx48e7gjbo0zg9HFP3Xhg&oe=6A8C1E0F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZ1URSuCUpAQ7kNvwHKRKm_&_nc_oc=Adr3BUNAc8yKHWe_sGHqmV82DfMN0MLxkStTrR8eRjQip8jUH-4gJCXIdQ_USluEli4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCinL6A8bMVWPJpPaSI-cSDcXINugRjvTA9Acv1sUhHA&oe=6A8C29B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EH0EVEdB0eMQ7kNvwEqgJJx&_nc_oc=AdrhltPfRu9c_8bPANE4D-aUz6BBnMEkTDMF1cOXDXv3ECRSgLC-qovfh_l_1k3c-zU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFSrUjGCFBzN_gbxmKMi6-TjMD9CdLEL6c0Iwi1wGMrw&oe=6A8C257D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7claV54A9MYQ7kNvwGPkDj8&_nc_oc=AdmPA0Aa6z-q4q35Q_VJU-U7wQYBxMyf9_aJW7N1knyItKXP9Q9Nx_PHUb62e6BXGTg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuQ_9Uy3EFL8E54fKsRtMpKqCmKPOnrKgXubvVt8Bj-w&oe=69BFFDCF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akt8dLryycAQ7kNvwE3Fogm&_nc_oc=Adk2K0R3E1Urd6QWeRQn7nNw8YIYf0xss1kd7cglmW7hV-GCwhr23hV9Dz1GHQbLlTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlUXCqcpFiZ1glwjKpq1qofv33R0gQXxFw5aTJf2TGsw&oe=69BFD134"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auMc0-Q5WfAQ7kNvwG_pHYI&_nc_oc=Adk9J5VnHlPLa3V_gc5xZxu28q6sVX0ViBDurM6-dlBO8FSGT737RKtjyG-Xdcd0oTc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXQZCi2weMn18gunVsHl7TrtTGaIUrv4-h1E0iuogo5Q&oe=69BFCCFD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_descriptio
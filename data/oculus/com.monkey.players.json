8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pfjkam8EKbcQ7kNvwECtOMG&_nc_oc=Adp2wTKtqUDedw6yMLe_4_67OlltBZzx41ULP5ojYyK8oZwhJE-FOq_r7S8NjPo1oX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72Q11FHk2jwsGUmNFfE2tbYMIRztqPwkDtmB0vC3wubw&oe=6A0DC64F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rp8w2V_RrxUQ7kNvwE4Ve0o&_nc_oc=Ado0DUVK7IY_kcurau-DBwCqddKnKBtMshSSaa-6hTGoqsw0SwquMRU4aGHOFrfBnK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bis_yIrRoz6GhIkFrU-b6RXE0CsFy_S8xMOxVTOgZJw&oe=6A0DD1F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMOq2XkG5TgQ7kNvwGiInUh&_nc_oc=AdopQOC7PBBFkg44c5QeXnVr-0I0hORpKUiE09p9LTguvS9PNdWmOYt0S9KmTntlG2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qvauf1SJ9i3OgCLWrhIXWPTqDD9t0iGK0-MuLHbeIoA&oe=6A0DCDBD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wmzJMv-dkUQ7kNvwHY5czr&_nc_oc=AdprSJsIRGX_j7w2GXp3TbLE3rfGh7QvhmyqP_QtsOVSgsQtr0g3nMTxuI3jV58g1Go&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFotd2LOuFJ6qjg495q-svEbaY3oAXiksKvPsrEg4bHA&oe=6A75ECCF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsTihsfUR3EQ7kNvwEAO-i7&_nc_oc=Adp2yuibVKWlDULrKt4Z6IKjscttG0wea87laDWoWIp-Nouf5_JN5GoIsStlZGqTgkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo96LYybVO33TnfxulApi67clbySgLxtooJ-9regF9Zg&oe=6A75F874"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0Fp-87qqrsQ7kNvwEPrNtX&_nc_oc=Adp4VEPsnEFXG8Iijbpqikv6mnVAI-r6HPtEZBPJ7rQrm7xKnVS6rICX3aCFOS0xRjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL3txXpIpTPArA2DqWzgH-4cqmBBAeD_W2kn1NaWUvpA&oe=6A75F43D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
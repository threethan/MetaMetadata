8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ-rtJ_AeSAQ7kNvwEyf6SK&_nc_oc=AdrkP8YjUbloFvR1uJIQ6bZwfBWtckkLR6Y9Ym-OJbJ5Tno_3czLhrzYCIDAeav_BgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0P9ikdv9XRE73HoYcLjumKLko60Avz6M1oO60MQ6k1pA&oe=69EE224F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxFJuXHWrCoQ7kNvwECaJeK&_nc_oc=AdpTCTCJVGQItPbfhgPHe4HOQ_pLs247tNkl6eaXUlppkdCQowQk1bO-TPhA8AbXIc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33jEGGx8mLawQAchqrirzgr4lDUAo-JMUb02cTb0pVkg&oe=69EDF5B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIgdkirCYn8Q7kNvwFyc4by&_nc_oc=AdpdbSn71G6OnYWqcjkzGisq1B3icwjBRuzgy7zcUTdGf0eEhwLJuRldOBbRfANuiLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w393wnzrjIjVWv7tjc_8Yyw06mfqr5KagOtibi4P5mA&oe=69EE29BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zz131a59EIQ7kNvwEVUk5V&_nc_oc=AdqJSuam6ahMv9eXtKZAidyTQX2guMX48msLiwRoQY8nYZFWyJqHm4iRxJ6EAdwMJQA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuVAiiTY173gX18XeGs_vc7xl7ouUXlNJywuvj2JCM2A&oe=6AA16E4F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fk2YMyEqLzYQ7kNvwEkO2qD&_nc_oc=AdrANl2DEofgBculCmDNHDAVOXBPJTN-MaYINNU4fjZVUVYhzwmlNb3htzFI_NA7nB8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9An3AGBBqyJN5eDzm0qHHWN8gP1lD0PQlt7I3cjITWg&oe=6AA179F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu76tSvqOv4Q7kNvwGyPvgT&_nc_oc=Adq-l8-5uITSNbPpBfEoiza09VeFhIBT-Om2XUkiH9x1gs_aniaqFUkz1dhoKOQVzRk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_75Ne3YRPDiE8w7XIaM5P-evpVaNKTl8vNNBKHe9jBg&oe=6AA175BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
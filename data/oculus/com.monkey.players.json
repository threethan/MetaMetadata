8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_h7osyZ0kG0Q7kNvwGTLtFS&_nc_oc=AdohoY2lONL4AjkYqlro_m2dePOqhdJY1Rn8jp38hC2WBizkWeWGi76Cwyn3ku4y3RA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA76qKXjmHffzh_i347VConUgFFlEQ592BhmTlvcSpUcA&oe=6A64C94F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otqTX6VoXv0Q7kNvwEjdFcY&_nc_oc=Adp4itWE0DLY4-48q7opcUX5d5D1lWyrg661nkAZWot2WvHNVWZbSjS4vYZULGPpIYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYU_BePcPXIVh-b5TMMJbdR5wkoWLik-7LT3Huk4yZbQ&oe=6A64D4F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpu9j2fy4l8Q7kNvwGCOuQu&_nc_oc=AdrZOBZUDRw3i-eiGZFoN3T5rMUFiiynvmQ2ohVDtfrG39LRnxfgG6aOIIlvEZ0eL90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgfko9g8xcrtXnQIvU-ghV2jC8nvtQvA-S_b4B18SeKQ&oe=6A64D0BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
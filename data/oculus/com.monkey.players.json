8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYy33OIkfX0Q7kNvwG7T1bE&_nc_oc=AdpytknE2VXTUiPcVMtJZQkSzPN4-w4Shf2Om02Odo1QPxJjVE1M1C8AOJts98jUPNM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vh24o_sT6hZ4W2gzGuDf8RrbdgKX_g_gzPN_6BCBvjw&oe=6A242FCF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yz_VKLUBi4QQ7kNvwG7wzWz&_nc_oc=AdopPaDD18ISbuutnOsn74HkHiKVWP5TfBpfJ1yp--Lxg0LT9-dgVntFrkTm6lUL7Cg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96SSnz-sqP-GglBCeQ2zikWPFaOuVOj3QxXm8hoMvHrg&oe=6A243B74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQsGh19sKHYQ7kNvwFXiFry&_nc_oc=Adq23XJOoZ4x8e_XOd-LHr0zRZogHnG7FYJaLv8xhyBhcSF5CgIKARaRbnA2qnXWyGw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iMx5KHun5bemTQrRrRitFlmNbCGLTZCQr2xxg4tWzew&oe=6A24373D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
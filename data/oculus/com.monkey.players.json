8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FllbtYzlL7QQ7kNvwGOnWfA&_nc_oc=AdnelgUx8Tv7XDzfJWmIcQKV_nGl1Rb9J1to_SL-J5vDlsXmDNKoeKayvdzgmjYCIlg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2BvHwlgTJLunA4PvWLte_3gYDtI6L9Z2DFVrinrvS1w&oe=69BEAC4F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akt8dLryycAQ7kNvwFyyiWw&_nc_oc=AdkSqm9lPqSPzcmxGVmylTgdjI-yOmKR0mmaDVKFmc_s87CbzgUYuPMZh3lLkLC9RAk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNXFx6g4qOcLUITkLYEmV9GIFwxYoivQD9WZzaS7UI2A&oe=69BE7FB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_k8NzSX9wa8Q7kNvwGKXwOR&_nc_oc=AdnKR_rKhDBRy6g3LkTfHC2gXfA7qvuvojR2W9wKy_JXIrFvVBHtqHPdCYka6ql-uOk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtZhy3FLvRM8ZT72P5m8CGwxK1BJNcB1-dMvw2wU903w&oe=69BE7B7D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_descriptio
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StZG-7fYRooQ7kNvwEXiNhQ&_nc_oc=AdoA_junSkCueVToZ7jjAeREM8nmb3N44DVBf4VARK4eCsMk5I-xN4V3zL-0gM017MA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWqTztGz4560a6Ccgy2oOxeh-n4ArvIwKhUvE_ceppfA&oe=6AD235CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jw_mXswwneoQ7kNvwH8_S_w&_nc_oc=AdpBbhixBAOy0O7Td5dh1c5yDaRJIJyFuzYlGrIRLMyuJKvqzd6TSTZiiQoQw_9bCDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4UdzFj-MQOwfxRzK35MXCx5HQoNM30OLjkweCntKMpA&oe=6AD24174"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUVW7IVjjgIQ7kNvwHvjDAr&_nc_oc=AdoV3rIN__bswqGRW5dlgSxLitejI8iRXqs_fVl9rq9tFI2ZDth8ApTiEiTJ1Wm9k78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe_tGRvxNTwoARWC-MVgNOCWzJHftIdmO2AX4zSx4j1Q&oe=6AD23D3D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
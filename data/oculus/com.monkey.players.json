8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FllbtYzlL7QQ7kNvwHiUzil&_nc_oc=AdlN_6BV_bLNkHT1t_9tLzQBj1xoJ6fxd0mP1AFyO66lrLCL9rV8-0TrkL4qznz6viE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxfc3bdFVZGI3YakNNm6SO3-06x-Z8ZfVR79ivaRKsZyQ&oe=69BD5ACF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJY0OvC75I4Q7kNvwHLITm6&_nc_oc=Adn6Uu5W3kjFXm9MccnFTwdIwtvY7I5XOvUdop7iAEXMI4tOTIAViLPsQIRqtje6VCM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwtx_UvSpNRi61ONIrBaeajYVJ3YUqnD-jGdDf3472BlQ&oe=69BD2E34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_k8NzSX9wa8Q7kNvwEYHYY4&_nc_oc=AdmUC_RDC6vLOzMJtVWquIOxTija3lVWO2hqE-tWIYtBDy089ClfEC812BoedEJ8hgI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzf6knFuNA5aP-HrqHiTH2wa3SwMFCOxTpYwbQnJHjFlA&oe=69BD29FD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_descriptio
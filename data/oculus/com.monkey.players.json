8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-UoQIaFYk0Q7kNvwFnuOz4&_nc_oc=AdpJxCJ0iG9hn-gpfpWlIuARJVTV0apHsd11xojQt2g1o5ehcGmv6s6FG-vA9na22fI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgWGhuEkhPg-DgxOhHFL4_0RSQNQESJRh_NlSqIpOtwQ&oe=6A84350F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4kh6Y434egQ7kNvwEqdPSd&_nc_oc=AdoD90Cw9QaXwFVVnxQ0l4EzrN1ZdkpxpX02F0lFN2fBApcf7XBKaqwNPJxlIxMjrO4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-zxgOw8QWZ_0OxZ-oQmu_g6qbuYGypRA_WEsmtZJtmQ&oe=6A8440B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1V_4qhwBjkQ7kNvwE1GnGm&_nc_oc=Adqh-KbRMSn3n6hJYrnxjhUWBe1h57rEebZ9hko7t7-wc6YnyOXtnTKRPQRMzVPLm9A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7sfOAv_BdY3KfwGvf9Ht4KfCo_o101y4LoT3yOk_XQQ&oe=6A843C7D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
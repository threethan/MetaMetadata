8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSckVQP9kgkQ7kNvwEl4uNl&_nc_oc=AdogCjc-zffQgo9nn4Ip3s_A43Uu96c_zQgSoIhCvTdhosmbdjPna4Nhc0zHpmIWpnA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-gTd6a26yBkLP8RX-GJwJYo2kvEEnBLw6AvFnCY_4cQ&oe=6AE4AACF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq2bGTwSQZwQ7kNvwEHVEyu&_nc_oc=AdrHgV219qw7ygGuXcXOti0T-XnnuNqb9PMPri3DilmktH7Ns0coZ2I2L7LRU2uY07c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPb0ecR7XkY-1m1F_GTLuveOBA2tMz42z82BmiVR1aiw&oe=6AE4B674"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXr-dsUQT0sQ7kNvwFARzyw&_nc_oc=AdrfzSoeHySc1biKToUgzS7NBvksGbs8vbWsXrRj46Uur-w4OD-kCIHbFGaW4UcZBIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYmjoGG9r1UnsQdqxTNzkjo9mOdBKHcqLEXRwhnIYoEw&oe=6AE4B23D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
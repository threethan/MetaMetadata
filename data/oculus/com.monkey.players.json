0_1899277127178702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaQA64n4DZUQ7kNvwG8Gi84&_nc_oc=AdrKsar46fOEbw-oRXau2l6rc8e7ca3tz5URqvdAxT8To_31DtPUWw1VXr7LR2dCpLw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxnef9HudKeCyJNaIMnsmCg_ga76QsOPe18fFzegVoTA&oe=6A8D6F8F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZ1URSuCUpAQ7kNvwELyAt6&_nc_oc=AdoE7-WKXDc2CcaFUXDM4Uy-atKDaWsX8qm8QeXCb5YNailiVvwXbPppnNaMNIIl7eU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHxtUy58iMCoklTafS3IqeT-vWLu8GXpNveFrWapihZg&oe=6A8D7B34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UxTw449nN8Q7kNvwEaoeTI&_nc_oc=AdqGYqNFaJij5rlO6zQG-TPRmK3JsyAavqw4vl9eRBEsGcTYfR9sptr9AI-hdFQln10&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqhMpsoJhiC5sKZwACo2tcU9OUOnz7nB2U2gWWZGltKw&oe=6A8D76FD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pum
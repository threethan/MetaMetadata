8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOcZG_baWgMQ7kNvwEEXnV6&_nc_oc=AdkEuAowuM8YZyWupn8qBMAmZ6YF8yW9Sm5X_FXnRmGBCzgClJ4Z3153uD2rsj20NUM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwp2E0m-W0gBhoQx99vkLSkSi0tXIzkq4pAcGWV97U4cg&oe=69B1450F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZajJb23MW7AQ7kNvwGVH5Nc&_nc_oc=Adn84LLooWvDMumpckRtMORreaVspMEvszUuBSxueDacxE6i0bTs8A0r3RrMZdpbM90&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3CSk5PHYmwJtobnB7nI-F9Q_KUq6Ed-m3iHA0If0q1g&oe=69B150B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9v293lNG5LYQ7kNvwEUGUp7&_nc_oc=AdliLjE7oo1qanYnL0DCLzxc4FEXm8F706trRe3l-2IFx_8OPL85JDMT0MebZI1oC_U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwN7XlBx1u58LvRKEanU7lufaRGIKofmcdxJK5EDAMD-g&oe=69B14C7D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_descriptio
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncM-u1mYKm8Q7kNvwFny8FJ&_nc_oc=AdryMQZeLdxrlEvHT2i8u0HFs2WzYlFTcPQVljssxtgfhEzD-RqW-igW0VyBPHqAIWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_pWkll3eiqxjc0VQG18QZE5ErmF6XbAMn3H_HwY9a0g&oe=6A6CB24F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCJw5FLZk34Q7kNvwF_3V_V&_nc_oc=AdoCS1zRtcbpyZlo8KNmY2O96bS2BeRjhflDphtOxibFWWcJaJEcd5POBF1Dxpi3hCA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwCkr0qFUJNLI7DOa9N4LJRe53f8q8mtoQ7rnUcM3uvA&oe=6A6CBDF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns93to4kmZYQ7kNvwFOztsq&_nc_oc=AdoRo8lhUGX1jRZHDKPbUQWSSZReFGIrf4lrAKMMJyvskd-chi5fgAv7zlfa-VHMA_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0LOMJy9xk6IGrv1fwaqlqAHvZCCiOhE2I_Smo6CngFA&oe=6A6CB9BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
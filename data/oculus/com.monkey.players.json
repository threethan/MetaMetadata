8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eA_87Y1DX0Q7kNvwFjzw62&_nc_oc=AdpMQM0L5dMpXEHMJ5tH6d82jamrIq6Ux5Pz8OC7tfmPlBtBtdBSlqU-EC3ouxiOkRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j1hfDJ12OEb9MzfRq-aZ781aka0UDBDI9lMCJMmDCaQ&oe=6A00974F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lFf_iwEJq0Q7kNvwEocB3v&_nc_oc=Adr0X7bT7XBXGvXU9TfORlGhDPjYmkDgbze3ytsoHspWvrc5AAkfBMYdwDsCUB0N-Ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54kOsxb74hLfDOS26OUwvWbLgY6V2LKLmd6FFevoIvzQ&oe=6A00A2F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nT53NyD6blEQ7kNvwEPReTf&_nc_oc=Adr1FlZ1NlPk0eg6nOdkq3vYrepiycXEUcNt3GmzGA7SQu73VCnnOUKDfI8ltnLnqBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nTz8EKmuJmQe7iS8zzXwJCpJUb25MfRENLrQSHD4BWw&oe=6A009EBD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
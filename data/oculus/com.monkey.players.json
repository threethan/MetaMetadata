8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzHrQzryNYIQ7kNvwGnmBMT&_nc_oc=Adr1P4nYQrVPFr1PbCtLhCVBUN1SVrEOFXC8YE-jIhsLBQ-YXNGIA0-N6EdCdYJGH-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WTx43A5COQszDGPUDPXKL20tAoJCexebFhZ8WaYzUOA&oe=6A2D6A4F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0gVh0bsVA8Q7kNvwEsPa-Q&_nc_oc=Adr3rh471QimRXVlX23ETq8sB6m1P6BTSrC5qbX_PeIJUw-JKPoxoKRaceLhLaiWVy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FtkUYimYq8BHs5je4ECB-QotroAS1xuyj3PK0x7gmEQ&oe=6A2D75F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhvF_ikEvr0Q7kNvwF-3RSp&_nc_oc=AdpBDUG-SbpDbhlpVgcy8C8E1_j2GUcDh8x5HoLbvWtRZ6-GtKOPJ0SSsHkY6s99T2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PFePOYES0AA4q5vSouFsEyFKlFppM3xOFf4AzHiiB2Q&oe=6A2D71BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0Mf4GMlDfAQ7kNvwGRLOOY&_nc_oc=Adl8TF4t9T3s7zOC3bEUVwpb-5Q7sn6pq6VatC99ceVUcy5cYpGHgg-Qb0vDyAUJMTA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxmgZ9IPrVugq2HZZ3akTRRc4mzzfSEjtmUCrbRq5y28A&oe=69BAB7CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJY0OvC75I4Q7kNvwGyZoRm&_nc_oc=Adlmd8Z186CLshnX1OPkUL4PIVqcwH4WRcAGbUMgOvA54vFw3QSe3c4VeFf4GQRwZvs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzq6tZVVN2fR6pHY6eqHPz1RvWXDzG8sE-2ej-pXA9Trw&oe=69BA8B34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_5B5xS5ecwQ7kNvwEAPK7L&_nc_oc=AdmQZd-8xaFu0TnjH8d-7NNfsD5DqBBZY4CJPSGEX-upBOjFnrXkfX6UmwK2sEDfQYs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyaSOpwXBqgKvqf_TtU9T18yZ30wQrtpsCJxKbXEsllVg&oe=69BA86FD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_descriptio
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPIo8rw5bcgQ7kNvwGVZsOd&_nc_oc=Ado0c9Q7qxFzjJdZaUxqMvotP__kxmoi0eF-3E96gRXfsxgPPzMwUjrVJTlXZdQcMR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2wT4wEcu8OURvQy4ebBpBMDvSuqlHQCpz50ePdpqD2Q&oe=6A4D0E4F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAUOmhzJAGIQ7kNvwEeg83t&_nc_oc=Adras0h_WBxta9bWF3JCWpZNYOkTL2NUv_zkntRB7GT34bcXjxjjVZbaUR5iXbQxGeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP8nHJ2FSFRqI1CDgVD5wENSe_LGAiH9QaBpwaWj8vww&oe=6A4D19F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aP7KHuUx-UwQ7kNvwFXsiBD&_nc_oc=AdrqeqIcWK80noBp4G1Z6Op1XGEsDY-TvzUi2glMYijUVVm-dSU45mM_MxUBmn_l2w4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb4uFGLIA2uQFC3HweFjxvOBT7nM-K2YUtCHygzaZnqQ&oe=6A4D15BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
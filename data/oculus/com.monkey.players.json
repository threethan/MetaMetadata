8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et-bJN9zfvUQ7kNvwGXfk6a&_nc_oc=Adpu3uC319xQxaoXCgzsaPjPulKq6Aslq3qH2k5hvrf9F_hqdogTABvnfAkiKzWB5qM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aGo34-0eYQkVHwhwbTEw9kePY0rinY-wTqvePkN6NNA&oe=6A1700CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XG51By4GSP4Q7kNvwHoJ9VV&_nc_oc=AdpqZqDpnzFBHQxL86a7v_0FMKhHDBdDDFUUIrmYUTcYnTMb7r9fcxW4JeNWBbZCZk0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74zEbWBijMHLku_a5Oru-viYLyFTbDYqu9cP-l45OQrg&oe=6A170C74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCFS1-ixkDAQ7kNvwEETbfo&_nc_oc=AdpGJO6alK7kX1ZLwjIbDSb9Dil2VgqocUcVEWxd0bHlplZAZO5OOGmvDfOdjnbBMfs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xGQNIhnJY7dBqMqCoAhJ49O8BJ15OwbFy2ZxxesmwHg&oe=6A17083D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
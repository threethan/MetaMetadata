8&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0Mf4GMlDfAQ7kNvwEC7mPY&_nc_oc=AdnVENfHCtCTz7AtnK0SVILiHZfN9ngEPEGos1psRL-DloTGPmj_UFLHjnqM0aC9WsE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMT2Lw7-E4z-qdxAxd8R2ByDensruvYZtZ5f7ZN3tTjw&oe=69B814CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IpNokKXF7oQ7kNvwGJ5SjY&_nc_oc=AdnwVZU0Np35B8SMf5WYxWEs__ZZzC-SSdAGGQAQ76MXOGtk7yqNlnr4hMDRSPL3Cho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwDXKmzEeJGen9HE-9V5QKDCAbphwx4rGK6Aisb-EfKmA&oe=69B7E834"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_5B5xS5ecwQ7kNvwHTo3hf&_nc_oc=AdmyRZ4S8sTtdyKL0NIKLXY4eFAQYlIt8ZZ0qKEgcurLVM8bfDXpVrlLG0FYJCq9UV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_MJduP4xkMYZAHtysCEc7Jw1xtFsJSjHXkYj_-c1MLQ&oe=69B7E3FD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills and unforgettable VR experiences.", "short_descriptio
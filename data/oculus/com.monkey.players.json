8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nyhlH3iyXQQ7kNvwGIo9xc&_nc_oc=AdqOQH1ttKnI6gazwdfIBmS7Zi65BrJRA9AKMnOaQMNXpnHJu7HJcNXGHlC4jUNCtlY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywwdJyLz2EzEHbiNftDge71hPq1hVn6djlejd12Hix8A&oe=69CA89CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlePfYShiEUQ7kNvwFC98E3&_nc_oc=Adq8_ywIKJK0MGCY8jIuw5k3Jd2GA2HpQHasS4AJdLhJ8f1msqY6XKNkVDPwkpJ0HEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFGROSSatjghkV-fEpDnGxO1bmht10h4O6P1SkXdj3pw&oe=69CA5D34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9isK8arrZ8Q7kNvwE6IrdW&_nc_oc=AdpGQmvlOH9tegR8vfiGikWM_1o-Sqp8XQuX06P0SWSObovyMgnJjg0kfb1e9BilCRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxhuj2fILspnElZGd65tWcCNp0B_btNlpvOu-Jp5KFpbQ&oe=69CA58FD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
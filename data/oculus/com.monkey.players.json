8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3kMJiDkTiIQ7kNvwE44LEl&_nc_oc=AdqV1K5RB_g5KpGmhpkkEwSYn_xznYOhQORmzPPAK0I3iSJgSZU5nCBbk8wl3jJ4z9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU63kTgAObX7fN2m7EGxfI41nYErKgQi1TFwV6BYyxsg&oe=6AA805CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtHvy_fi3HMQ7kNvwHIFBAB&_nc_oc=Adq_w92OdYYcyqSx9bNd1gPJnA_rAQ5apJ6PIQuOy_tW5nggzrNbB6VB5g04bob4ryI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf-767ziXQtQmoqvQEJ5Al6ftfY0KCbSbbKSDlhZnkHg&oe=6AA81174"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tU2ijB88zt4Q7kNvwHOZ84I&_nc_oc=AdpNshpjuszsTiTQlJgBLz9ZGD1qzFeUctGQcYYi4tf90qPYKeNaLA4FItTf4R5csro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICyPreNaYqEY7x4O3FmumrQg2xeBIbnNZKJ8QCtnklGw&oe=6AA80D3D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
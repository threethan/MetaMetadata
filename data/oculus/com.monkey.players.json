8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fPKNy_ICSkQ7kNvwERdi1-&_nc_oc=AdpIJhDf5wD8Mi8w1-jPWYo2Y5N4b5YHKcS6gg5schH_JvLbj-Gbt13WsB03lV8ijTA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuVJT_ORoCeqZ4qTSEBqtGjBXOifNjiYQ2j4H_Y67CJw&oe=6A54F74F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N14ouc1eqGsQ7kNvwEWoO7p&_nc_oc=Adojrg1jm6LrSLvl8fSPonoK5eYfLsNZjI-EBQuDSD2imJvgw4USh9ekbXLn-CHHbN8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeLOiv-mP0HVN-IKklmjeci1TfIr8EtVTQ9eDYKCdwIg&oe=6A5502F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHLVmtFOacUQ7kNvwFlKVki&_nc_oc=AdrDvnrAlfBVI1qNDUO6CvwrCeSmp0mFHJ1Lr1Tv_QoNm1yCJV4GFddB8sGwKEnKnk0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKAxV_5fQNekvr_8Hu4ms36iZA_iuJyjc2B7lYoJQyxg&oe=6A54FEBD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
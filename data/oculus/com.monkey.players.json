8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiVsZ8zNaXEQ7kNvwHoSiEu&_nc_oc=AdoDkERN8auQg_NyH0pZY905wxGOedODjYBrE9rh4Jyqe3w7BaGw6e4STyYXUcP84SU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu3vulmh6qUVo8e49N9wSYRKUnyvD8bHUaO6610RyV-w&oe=6AE0B64F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MlpEZpaewgQ7kNvwH-P1pT&_nc_oc=AdrkIulSAnY2UAxwrjz5uvtMDtIRLm-XdI9pepNi6hEIGjd3YIr1d3_IEWPbQGrSgls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGDuJ8YrjkU1nXH-3klmNQPXrM2t0E6AoUAb1PmHjE7Q&oe=6AE0C1F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRCCUV745D8Q7kNvwEqja_5&_nc_oc=AdqOeXP_6H73wnQC5evf88eCV2BhELu94RTDS9Il6Ys8MU-6yKFllGkXVkr2lOTPPrM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjaqXpWixtcsEwfNq5dkRXDyYrwymHV0GVLbd2pjob1w&oe=6AE0BDBD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
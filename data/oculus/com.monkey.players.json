8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jljuY3Ep2nUQ7kNvwFfLWa_&_nc_oc=Adqc_Ax8gOWhIhE7FVqyL1vmyi0H2RUaKj5Xz_AaNbJxvjQbxeGm9e8CU-FK-hzLhL0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jTGL7bbrcIe5xecSCPkf9Ia0Ns-AtjQ-71KsVbgr_-A&oe=6A3D3C4F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vdBtWJQMLkQ7kNvwGCkXNf&_nc_oc=AdpcpjSY6FAtYgF33EHL_Q4Wh8-we0HBR_hf4wZl_7MpFtn3RVpne5O2xEPAbZsz-Og&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Th7qPgWWZQ4Has4FzrZAc_NbQdoGW6fGLZGwN8In6aA&oe=6A3D47F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3rBvK18kQAQ7kNvwExOc0x&_nc_oc=Adph7tb0RXc_W40X0djyr1f1_At8VWre56cSoFb0lIy7kfsAlklqrPQ0q-wKME296So&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ctveev7gRTbdnQomrR_RxnoS1ZCmJfPHWnRJ5_n1rqg&oe=6A3D43BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
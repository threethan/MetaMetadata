8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2GWWXGQLnoQ7kNvwFDJa0h&_nc_oc=AdqBb47Jqd63Fm0WYMAFUQYJ5mj5qC4mbtQRAQy3WnmaBfMtGvKZH5-K-UnMgnegRko&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wJnGhy1ghIsl4hDo5YKzSfdZ2IoMssUB1uKrTJdh6Rw&oe=6A1AF54F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAcy4rXLSggQ7kNvwHgLxDJ&_nc_oc=AdoIo1P-Q8E7hiuD2McbmbsBS-oprJ4FZojgTzfxdkLM5R0YQ8glsbFxvWnw03cJi6Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DJRayUD0quHiT4QQqaM9rSZQtpX90i91FUjBHyAevew&oe=6A1B00F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAk8ZY2GO-gQ7kNvwEiHOz6&_nc_oc=AdqNl9Vnfhf1j_ty0iThwWxcsyL8hxzRf6euQ9oqQaWBBfdD9sy6FDAfufEWhSLrR2U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PSKfUwsEJFc6yUzUYYym2v-z3xd571urB-rWj1TWf8w&oe=6A1AFCBD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
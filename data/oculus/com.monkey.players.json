8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5HPJfnosWEQ7kNvwH4_x8B&_nc_oc=AdqFtYW-4l6EbI1OnRQsTk629YFOQl3DJBQXE4qch9e3K6NwKXTER_1rYm839U_Arro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sOjbhIblzdgbB31Be28FJuSEe0N_HVHQmM2cZeMzPsg&oe=6A37F64F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLRyC2QecokQ7kNvwGld2A2&_nc_oc=Adpg62J0H07oGuFKIO0RC8tKik1r9sFyiIMxtfKhKUuzCziEHke1gncKqz4xdrR_vjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dGoqAjY2RP-7wK9slmZO1Ux7rsgPY-oAA44Wzu6CCHA&oe=6A3801F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dYw24wfCvwQ7kNvwHnEOut&_nc_oc=Adpbgqh8HDPCGsL4phZeD506_7sWlKe1PqVD6sZtPSHKhyeVgulhvfJSUIdxI-3HzK4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yeCNqDDNggoIR6n5luF8zldI1vcrAWslH90aTc28-Xw&oe=6A37FDBD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jljuY3Ep2nUQ7kNvwEouNK4&_nc_oc=Adp3rx9BR_JBhtP4cKqLjgahw8naJKos6YRreptPqfTXfmZYYheBd3cTjLGGvtgjnoU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_clEessxzvCuLgZiu_Sivy_vHXmm5vqGBtCg5tkHeBHg&oe=6A3A994F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GO9AwwxAckQ7kNvwG6eojL&_nc_oc=Adqi1aAs270QrD-5PMWDm3IDV_CtR6GV2VTrYYT3x-XPCTpQTpPbpSYDeMRlP5i5vFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-62mtrcU_ed25DKmft71QaXFKhGPSLAHI66Gg0eY6cuA&oe=6A3AA4F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3rBvK18kQAQ7kNvwFP6jhT&_nc_oc=AdpkCEB1x0odGiSlBNC-rg0TFNUZLg5JAaMB2AT1WqgV1TjlBBf3HKngwj5NJNRmrlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fUL-9eGLrE_7y9L096UWVIrLUNcc2h0dPm0RF2odvkg&oe=6A3AA0BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
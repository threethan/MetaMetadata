8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka_gXDJ5fpwQ7kNvwHJHRDz&_nc_oc=Adpv-9jDf1vw_Hokh-9o_56S2yAuAGcTzle8nIh9rriGU-SzVcJTAnfMX7xOV_fOHck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQakOdyB__sBmjrX0NplFuPcnOPU7WVNZEcU8ABbJsWvA&oe=6AEDE54F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvrIu4RSmdEQ7kNvwGyh3b8&_nc_oc=AdrgL4bfZ3wpsafaNLVoENvck8s7iq1a_1osoL5MTSW5c1xhyDxtwoQAcSRX9bkfFeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOu7Cgh9x2Xjk8dVLYeyG2_WcasB63NL1fAolJY3XTug&oe=6AEDF0F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OzOc8-btFcQ7kNvwH7wYCE&_nc_oc=AdrcWsYVNqxfQiwZ_fS1xCYh7SRVDsdaqS9qSuHkgvYHXC7iCX1YAatYu0DjKyB3K0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoO8NmhLiQGZbJ2HT7GUyv-G-E0FSbQ5F9ObCu9VYA_Q&oe=6AEDECBD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWLn3_pcjxgQ7kNvwEpqEej&_nc_oc=AdqsyEKknxwAr1EdEfpRiThouW-6FYof2AB-f8Q3Pic8KFxEyJXpKgblAhICg_21-Pw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhu1wUPwtKnykTGpqxhlzinWf1YlVUWgitq7-uRdDVRQ&oe=6A7C4C0F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efeNG2K6akUQ7kNvwGie9o8&_nc_oc=AdpsgBb3pau8uCIFOOAwLxrCw4VAaeQp276SWUic-Cw_BFTiZWY5X3E7-UVeH3WhvWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQkR-3MrYPTawhAbriow58T4uPdpp7EXc8zKPJW8pG5Q&oe=6A7C57B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dci2f-CUE8MQ7kNvwFRXqqI&_nc_oc=AdpPEh80qyPOGHMxiQ3DlWPBQJlLqFohtqFazIuUPm8XERNeoNssaGNXvw2Vk1Qyl4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIyN9hmuWU2CJIdKUfxzutdkFCTED8ThaI2ZFJtjli1A&oe=6A7C537D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
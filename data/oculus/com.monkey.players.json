8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN4uGz6vlEoQ7kNvwHwO8lY&_nc_oc=Adokjvsl04FjIt39QbeThjy20IcsG7rpAAAVolPquJf2ls4lqJWlsnTqztoL0ipadDE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYw57k9Q77-q_vJ_GKylhc5FKP2pOKk2E_WXFVqPohFQ&oe=6A5CE04F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vd9M__GDXIQ7kNvwF1cSUs&_nc_oc=AdpapUEdGl_SDcWQquuAmsnLEINhDA7tAz9qWlexYbfyPesaJDKfBGix1PMtVtOQ_TE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWjFtzNrbvMfDXCV64jJHMM2W97L-VJRUipdCpc3amwA&oe=6A5CB3B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4x3sVYhKLcQ7kNvwHIdRCu&_nc_oc=Adq8lr-4zVhuXRnWEayuYfNqchfr4OixTWDBfw0FYXOoaZcQoqDMn42JVl8d6ztsfvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDosBZ-wnXMCTJugr1TToL6a_LFfWuhzw8ZyP4jO-0fUw&oe=6A5CAF7D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
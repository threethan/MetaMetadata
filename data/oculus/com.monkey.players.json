8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncM-u1mYKm8Q7kNvwHED7rm&_nc_oc=AdohpSmbZG3GEP5NkZLbDLk0U5eRUFLFc4RqVf7wfXGJuC_BdxlzonVDDWmVQ8aLr_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm8yEkkIbl_UrXF-JIny0iONrff_Xg0BGHZuX-wOSkwA&oe=6A6A0F4F"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LhyCahvCkkQ7kNvwGjIE5C&_nc_oc=Adr-Skdx_kh7pD2pXlaaJKmHBeaYtKcrZz_6chOgiClLLEjh6dRvgYBZO4FDaKMAAHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzQDkwXrWscxqHyMYsHQQeEktetX8jwoWj9YOqq-KChg&oe=6A69E2B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns93to4kmZYQ7kNvwG6UVsN&_nc_oc=AdrCc5Q--ECWeTOnnUpuc5tqk0ZGY5IFV5tKY0-WnGEXuGfrwcabJ8gZsJtES0El4dw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQbE_LvsqCLUkiBtGy1oOXxoEJvbGwtGXmphpxHlHilA&oe=6A6A16BD"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
8702_235149441825442390_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fPKNy_ICSkQ7kNvwFjVI5F&_nc_oc=Adr9oueUgng-xsEOLZ8Rc-xPWNqckPwAILht0sEOuc9guaGYecIJ3WrEEi3lL56s8Eg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiN4sVnKbrvCEEaN4Pc72Tn0NGt_eOFTwjau7n9YlcPw&oe=6A53A5CF"}, {"file_name": "75203620_983714499810928_6706572595749493437_n.png", "id": "1176208616893144", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003266_1176208620226477_6498589137223951830_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7l-NtSn1xQQQ7kNvwGQ9Ktb&_nc_oc=AdpYjwygSBA8ThZ_qcZX6H5FeyMB0wOaC3xtZlts4BGlw68Jysp5OF4zWMN9jSrB_io&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOdLDnlJBvrlvEwcRR0iP1sRmZs2U7lC07HYxUsoHE8A&oe=6A537934"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75307247_1488187795096207_761985499779344499_n.png", "id": "2418574011674639", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75272211_2418574015007972_8038691987207114510_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHLVmtFOacUQ7kNvwFUGH0_&_nc_oc=AdrEE0VKFCB5UysE5jW2yqkGgPVfRM_z-9aC8J841MgoC0MbARZ2gD2goWBWMxoYq2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcZk2Wr6uo6-Juwa-NM-egzBo4h5a28-f-HVQsSPiYYQ&oe=6A53AD3D"}, "display_name": "Scary chase", "keywords": [], "long_description": "\"Scary Chase\" is an exhilarating virtual reality game that thrusts players into a jungle-like environment where they embody agile gorillas navigating through lush, obstacle-laden landscapes. With intuitive VR controls, participants swing through trees, leap across platforms, and engage in heart-pounding chases as they attempt to outmaneuver opponents. Players can tailor their gorilla's appearance and enjoy immersive multiplayer action, strategizing to evade pursuers or become the apex predator. Whether darting through dense foliage or engaging in high-flying acrobatics, \"Scary Chase\" promises adrenaline-pumping thrills a
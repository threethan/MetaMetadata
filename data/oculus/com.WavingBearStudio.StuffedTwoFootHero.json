mqhIIk32hP9JL0-oiw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjbLY2loY2D0uffa4ZvU5UtEnKzEkflQGLOTb09omlHw&oe=6AF725A0"}, {"file_name": "ShadowMonster.png", "id": "1376062217796363", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654877283_1376062221129696_5226018893390426234_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRGrhNiN-XIQ7kNvwE_6Do7&_nc_oc=AdrdkyOaCmNJLft1EcJD-frcZQhp_qqoArHSfDhrYpmFQtiwsuc6AyjJwHoRBQCtGCA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR45CumVkWSx7eX0paU1_X4-hln_8_GKH4rxNKr5pNAuw&oe=6AF72BA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StuffedTwoFootHero_TrailerCover.png", "id": "2754464571606658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827987_2754464574939991_4476522205228553549_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lnFH8nZHHIQ7kNvwF8XUU2&_nc_oc=AdqddTIcB_rlGau5aoIuVC-TidGkIL3s-IhLNi9KLMf-zm-Ez-wQWCCtjkzc1366UDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtEYdCguvjsbfZKEUdxS_cObok_dRGL2-YKOBDDDZvHw&oe=6AF7281E"}, "display_name": "STUFFED: Two Foot Hero", "keywords": ["Shooter", "FPS", "Multiplayer", "Survival", "Fun"], "long_description": "# \ud83d\udc3b Protect your owner!\n\nStep into the paws of a teddy bear and fight to protect your owner from waves of nightmares invading her dreams. Armed with homemade weapons and defences, you'll battle through twisted dream worlds in an action-packed VR shooter that blends frantic combat with strategic survival.\n{1950592968965057}\n\n# \ud83d\udc3b Play solo or with friends\n\nFace the nightmares alone or team up online with up to 4 players.\nCoordinate your defences, revive fallen teammates and survive increasingly overwhelming enemy attacks together.\n{1559880799201793}\n\n# \ud83d\udc3b Survive the nightmare\nBattle through six unique dream-inspired maps as you face everything from garden gnomes and rubber ducks to skeletons and shadow monsters.\nComplete ten escalating waves to conquer each night, or jump into Endless Mode and see how long you can survive.\n{3071908983008907}\n\n# \ud83d\udc3b Fight with homemade weapons\nBlast enemies with an arsenal built from everyday household objects, dual-wield your favourites, physically reload in VR and upgrade your firepower at the weapon station.\n{1078011794753648}\n\n# \ud83d\udc3b Build the perfect defence\nConstruct barricades, traps and manual turrets to hold back the nightmare hordes. Upgrade and repair damaged defences, reinforce your position and prepare before the next wave begins.\n{2499590267223555}\n\n# \ud83d\udc3b Make your teddy truly yours\nLevel up your teddy and unlock outfit and fur customisations to create your own unique Two Foot Hero. Master your favourite weapons to unlock exclusive skins.\n{1065414052680899}", "short_description": "Become a two-foot-tall teddy bear in this wave shooter where you wield homemade weapons, build defences, and protect a little girl from her nightmares. Play solo or online in up to 4 player co-op."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wavingbearstudio.com/stuffed-two-foot-hero-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Amplified Games | Waving Bear Studio", "support_website_url": null, "website_url": "https://www.wavingbearstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "
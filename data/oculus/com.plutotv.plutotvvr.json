 crime, sports and more. Pluto TV is 100% free and legal: no credit cards, contracts, or bills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://corporate.pluto.tv/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pluto TV", "support_website_url": null, "website_url": "https://pluto.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "MEDIA_PLAYER", "NEWS_AND_INFORMATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "786417129104030"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "489950756518097"}, {"status": "CANCELLED", "id": "1234832057413642"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1666306800, "status": "PUBLISHED", "id": "489950756518097"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8095175977186097", "version": "2.0"}, "id": "3063352820645016", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5146165292087195", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8095175977186097"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", 
_nc_ss=7f20f&oh=00_AQGSVroUDU29BCUKvzXtzw20XE2mk6DRWL4MmF0FIdyAPw&oe=6A7DA251"}, {"file_name": "r11.png", "id": "1753802831979829", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499307413_1753802835313162_5494748122449912642_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zReAZfgl7sEQ7kNvwEL7UFb&_nc_oc=AdoA445uUezB2HbOZfkUj3620tqPmvbihrXOea60DHhaY8UGzXJbtp5Uy1_QK8aRCcw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0ouLARZN_6gciQ1wJlbISRdascasaDQFSGe6Ci706xw&oe=6A7DA65C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1938220176907743", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491821193_1938220180241076_6624404950043252757_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUnwRbTgA_QQ7kNvwEGDd5s&_nc_oc=AdpXlJV-7eJvhCCg0BvDfJ-onui_PoW4jvfIV8_cvL1Z9Lachk1r7F_OtC5_1dtG0cE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEGEnVQSQ3IhOSoIZVH7LmcvfQVpgMyH9VcfgmmVSpVQ&oe=6A7DD109"}, "display_name": "Street Ballet Hands Free VR", "keywords": [], "long_description": "\ud83c\udf3f Street Ballet Hands Free VR\n\nMove with your hands. Move with your body.\nA ballet-inspired VR learning experience using hand-tracking only, designed for comfort and natural motion. No controllers. Just you.\n\nBallet technique comes from walking, running, jumping, turning. These are human movements, refined \u2014 not invented.\n\nBy placing ballet on the street, you return it to the body and make it human again.\n\nThere are three levels in the APP: \n\ud83e\ude70Beginner\n\ud83e\ude70Intermediate\n\ud83e\ude70Advanced \n\nThere are about 100 Ballet movements and sequence exercises in the APP.\n\n\u2728 Key Features\n\n\ud83d\udc40 Interactive 3D Instructor\nRotate your AI instructor to any angle with a simple finger swipe. Watch every detail from the perfect perspective \u2014 just like training with a personal tutor.\n\n\ud83d\udc3c Slow Motion Replay\nTap the Panda button to replay movements in slow motion. Adjust the speed to learn at your own pace and refine each technique step by step.\n\n\u23e9 Fast Forward & Rewind\nJump directly to any form with easy navigation controls. Focus on specific movements without starting over.\n\n\ud83c\udf04 Immersive Environments & Music\nChoose from over 20 calming backgrounds \u2014 mountains, rivers, oceans, grasslands, and more. Each environment is paired with relaxing music to keep you centered and motivated. Switch instantly with just one tap.\n\n\ud83c\udf1f Train Freely. Move Naturally.\n\nWith Street Ballet Hands Free VR, your hands are free to move just like real Ballet. No controllers. No barriers. Just you, the forms, and the flow.\n", "short_description": "\ud83c\udf3fStreet Ballet Hands Free VR\n\nStep into ballet like never before\u2014hands free, no controllers, fully tracked in VR. Move, jump, and spin through natural environments with rhythmic, expressive music. \n\nTrain at Beginner, Intermediate, or Advanced levels with an interactive 3D instructor, slow-motion replay, and easy navigation. \n\nFeel the flow. Own the movement. \n\nStreet Ballet Hands Free VR, reimagined for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tianlingamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tianlin Game Studio LLC", "support_website_url": null, "website_url": "http://www.tianlingamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING",
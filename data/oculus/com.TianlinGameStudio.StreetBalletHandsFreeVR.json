2_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtbz_bB0VrYQ7kNvwGNcO88&_nc_oc=AdrFpwRvkwTFsgbjMkTtbJsn0j1QjCh8-ofttc0GLvpxbfpF_9DhgJEifyOVQhzmatw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ-b2Qp9acO_T7joQwaR70LbOj92n36rapZbc-DiMi2g&oe=6A7DCA6F"}, {"file_name": "s4.png", "id": "3630860723736264", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499307413_3630860727069597_2190603724261982260_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cH-uqksJ084Q7kNvwHhNoHY&_nc_oc=AdqMJj9MpPfMUZ3xrNPX3zh-lCtw8LHyDI9qMErex1z06QMT2xwsBpXPax-rAoHNM_Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiiOkuwpG0rQv2nY5YV8dbTFZcxNfKn7AlPJU_3dRs6A&oe=6A7DCF8C"}, {"file_name": "s6.png", "id": "975714191546735", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499303788_975714194880068_7437131344787266942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6tv65pDgFsQ7kNvwFETIy3&_nc_oc=Ado2A5gR0kfFjguRTzx8H6sR1MvlYMHjpD2A0mtuob7B0_rbLmoLaAQeauRYuuDuCEM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcGGuXDPnewapOJ8Dab4TqkORvPCHO0k4ugIWKy7AyrQ&oe=6A7DA7B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s6.png", "id": "1193029829405419", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499301053_1193029832738752_207325808444063040_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7y6ngPM9xQQ7kNvwH3Wd_W&_nc_oc=AdqcG5biNdRovWyi2cL5KAzl_zugau5-jr5xp1cW7XZKyKpzj5zCuotHXxtd5m8M6II&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhhnLo03uyEJri1GKIPbMBY0hjfRFmm2CGfLP-34mtGg&oe=6A7DB03F"}, "display_name": "Ballet Dance Fundamentals VR", "keywords": [], "long_description": "\ud83c\udf3f Ballet Dance Fundamentals VR \u2014 Hands-Free Training\n\nLearn classical ballet through structured, immersive practice in VR. Using full hand tracking, you move naturally\u2014no controllers, no distractions.\n\nBallet is built on fundamental human movements\u2014refined through discipline, precision, and control. This experience brings those principles into a focused learning environment, helping you develop real technique step by step.\n\n\ud83e\ude70 Structured Levels\nBeginner \u2022 Intermediate \u2022 Advanced\n\nPractice nearly 100 ballet movements and guided sequences designed for progressive skill development.\n\n\u2728 Key Features\n\n\ud83d\udc40 Interactive 3D Instructor\nObserve technique from any angle. Study posture, alignment, and timing with full control of your viewpoint.\n\n\ud83c\udf00 Motion Trails for Precision Learning\nVisual motion trails show exactly how each hand and foot moves, making it easier to understand, follow, and replicate every action with accuracy.\n\n\ud83d\udc3c Slow Motion Replay\nBreak down movements at your own pace and refine every detail.\n\n\u23e9 Flexible Navigation\nJump to any movement or sequence instantly\u2014no need to restart.\n\n\ud83c\udf04 Focused Practice Environments\nTrain in calm, elegant settings with music that supports concentration.\n\n\ud83c\udf1f Train with Discipline. Move with Grace.\nHands-free VR designed for real ballet practice\u2014clear, structured, and true to classical technique.", "short_description": "\ud83c\udf3f Ballet Dance Fundamentals VR \u2014 Hands-Free Training\n\nLearn classical ballet through structured VR practice using full hand tracking\u2014no controllers needed. Follow a 3D instructor, study movements from any angle, and use motion trails to replicate each step with precision. Includes beginner to advanced levels with nearly 100 movements and guided sequences. Train with discipline and move with grace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tianlingamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tianlin Game Studio LLC", "support_website_url": null, "website_url": "http://www.tianlingamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags"
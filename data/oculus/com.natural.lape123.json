 nightmare?", "short_description": "Project Blaze V2 is a spine-chilling VR horror experience where survival is never guaranteed. Trapped inside shifting, nightmarish levels, you must explore, solve, and escape before the darkness\u2014or something far worse\u2014catches you.\n\nPlay solo for an intense, heart-pounding challenge, or join friends in cooperative multiplayer to explore together, share scares, and strategize your escape. "}]}, "developer_name": "Natural", "developer_privacy_policy_url": "https://docs.google.com/document/d/1JU2eSqC_JUy6v4uGfgUPom4EdN2-WpFBV3HuL1CwY6Q/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Natural", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1TiArPRcsWdNuGeV0irK37o_3-PEfX5-YJTdG0DHvt4s/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28021864350788165"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825257_1623059962877386_3447167600292518776_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wzxc9U-MTvgQ7kNvwGcELRA&_nc_oc=AdphmyNhR8kCo4pC9iM2BZ1TnPSLsj4oHgmtqkTpCwm44dalObsALqZud4s2IzqTAbk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgbjtd8vAamyZW4axC5juIRNN9RU08zGbh5p2MIHl6XA&oe=6AA013C7"}, "is_concep
gwQQ7kNvwG50ISs&_nc_oc=AdpcH5yX5L3EmqGgRz2mOcFPMWtGYF9-CIvpCuRyPK5fyec_pcyY94i50LR0iQr8KRk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKm1HuhSxFnrMBpufqq4QPnxqlh1_s_VpTB4-P9w5YfQ&oe=6B01D4BD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape Ultra Mods", "keywords": ["lethal", "ape", "scary", "mods"], "long_description": "Lethal Ape Ultra Mods is a spine-chilling VR horror experience where survival is never guaranteed. Trapped inside shifting, nightmarish levels, you must explore, solve, and escape before the darkness\u2014or something far worse\u2014catches you. Every corridor hides danger, every shadow conceals a threat, and every choice matters.\n\nPlay solo for an intense, heart-pounding challenge, or join friends in cooperative multiplayer to explore together, share scares, and strategize your escape. With immersive environments, terrifying enemies, and unpredictable twists, Lethal Ape Ultra Mods pushes you to the edge of fear and keeps you coming back for one more run.\n\nDo you have what it takes to survive the nightmare?", "short_description": "Lethal Ape Ultra Mods is a spine-chilling VR horror experience where survival is never guaranteed. Trapped inside shifting, nightmarish levels, you must explore, solve, and escape before the darkness\u2014or something far worse\u2014catches you.\n\nPlay solo for an intense, heart-pounding challenge, or join friends in cooperative multiplayer to explore together, share scares, and strategize your escape. "}]}, "developer_name": "Natural", "developer_privacy_policy_url": "https://docs.google.com/document/d/1tW9NyMyxonLjENY6R1HIuh4Qs8inJ9Cyi9aOP1QQp_c/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Natural", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1tW9NyMyxonLjENY6R1HIuh4Qs8inJ9Cyi9aOP1QQp_c/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "con
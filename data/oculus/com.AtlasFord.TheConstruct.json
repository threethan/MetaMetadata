nt-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk233Nn6zI8weOVE2BsB09VR5T2nihWY5tdtasfQBkhQ&oe=6AFC66AF"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (3).png", "id": "327393085166629", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974869_327393088499962_5070684300865766863_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTyfm9jLxbMQ7kNvwE3uJNS&_nc_oc=AdoIAFQ3jWa5KH2nHOEXoEoSZ6ijhKbrwA7-rpMgix6Iyo2s7w-rIlvFCsF3zJXCEqA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVk9q8MURcyXwORVG_KKpcCY0VXDMedsw9CE0ypaUTnQ&oe=6AFC8ACB"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (2).png", "id": "313102016549273", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/86610716_313102019882606_8290101124020842441_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPHmHsu2ZcQQ7kNvwGbrPzf&_nc_oc=AdoWVGI5k3gYI3M7U-u5HSMKD6ldLEilZJyS-77PnggwDW-YaH070ZVbDXJf2EFwhpc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsq556aaEgKEnY-oQbMB70EDRxTIhKO43lFwjZPmG4RQ&oe=6AFC641F"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1].png", "id": "995636664198337", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86609235_995636670865003_6789415966943366450_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9g93FoFAxgQ7kNvwHPY0HO&_nc_oc=AdqxSPtfuM-WAk_bXnlmquLV0EAVVVekG_v1cP5m3iTR0Bc0brGijBqMolzMYBBvw4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRALeShckWBxRltebTlYoBG2F4XfBfqNx7fwgW03u_hRA&oe=6AFC826B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.AtlasFord.TheConstruct-20200723-120237[1] (1).png", "id": "309057476902192", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974531_309057480235525_2429073677034493164_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vy3iwuTOS8Q7kNvwHzwNsZ&_nc_oc=AdoS-QVVrss3XhBCm1hhCvWxIeQOxnWYy2zdVk1lJ372Y3kf3pLjk-Flv2lqOxi4Ifg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTARMRQCwfMtMwu1DW1-Zp29f342ybiwlSpzDWNQkPlKw&oe=6AFC6C63"}, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of basic geometric and various other objects to build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "Find yourself within an interactive randomly generated world where each experience is unique! Watch while nature changes around you as plants and creature grow and age! Build a personalized experience using nearly 100 objects including basic geometric objects, plants, and creatures with plenty more to come! Change size, color, and physicals properties of objects and use your controller to move them in 6DOF. Updates are released nearly every two weeks."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": "https://www.atlasfordinteractive.com/privacycom/atlasford/privacy", "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": "https://www.atlasfordinteractive.com/forum/_help", "website_url": "https://www.atlasfordinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genr
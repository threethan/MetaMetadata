nt-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEXhr3m6yf3EEDO6AGtsEnoY3-3pd7DKr-0rGQ0szC_w&oe=6B10656F"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (3).png", "id": "327393085166629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974869_327393088499962_5070684300865766863_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USDFIh5hfKgQ7kNvwF2biE1&_nc_oc=AdpD2mvbuZSr1OFe_gwWFJmOBhuiIy2c5o-Esrc1su81G7nYzKohiF1x3n_FSrqBq0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVRiKv0Dnt0BbvM1HHJHYuvsv3UPINEl9K3pCN1_-NrdQ&oe=6B10514B"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (2).png", "id": "313102016549273", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610716_313102019882606_8290101124020842441_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUObX_f0kBoQ7kNvwHvcABx&_nc_oc=AdqUm6O2KsXMM0RjTVxrOTEGHAMr22YTDB1f_z3u9i94G9PEKiJxmxTgRBZ0l6mQ3cw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV979yLwTWDR-XlS0vd9kQjZRmmCve4qTIK5H9FdIOC8g&oe=6B1062DF"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1].png", "id": "995636664198337", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86609235_995636670865003_6789415966943366450_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJWj8Au0iaYQ7kNvwEZuI7p&_nc_oc=AdoEMTbeBsAq-6ss7-g9UvdMBp5dNsLRJlVVy52_UT2wPQHkjYZ8YMRg79q8Y6U0A8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVF5Ge2zO7FFxE2juJw8GHKtkFiy4_S0pVBaLAT43nR8g&oe=6B1048EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.AtlasFord.TheConstruct-20200723-120237[1] (1).png", "id": "309057476902192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974531_309057480235525_2429073677034493164_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ase8HmJqCKYQ7kNvwFCWb_9&_nc_oc=AdphaTI7b_qaGAyTZaJRbBotNNlQjoup0_anJjPntPXjx-CxvcZCVEvjNbLzGR8RupY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWwkPW3DtPXMmZYGoC_ZEnC4u7ugzjGH_AGwZht_Nxs3g&oe=6B106B23"}, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of basic geometric and various other objects to build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "Find yourself within an interactive randomly generated world where each experience is unique! Watch while nature changes around you as plants and creature grow and age! Build a personalized experience using nearly 100 objects including basic geometric objects, plants, and creatures with plenty more to come! Change size, color, and physicals properties of objects and use your controller to move them in 6DOF. Updates are released nearly every two weeks."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": "https://www.atlasfordinteractive.com/privacycom/atlasford/privacy", "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": "https://www.atlasfordinteractive.com/forum/_help", "website_url": "https://www.atlasfordinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genr
nt-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNAd0Eob8JdeqipWZx58vQFDJEGoEdachKy-9y966VgQ&oe=6B03366F"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (3).png", "id": "327393085166629", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974869_327393088499962_5070684300865766863_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbVjGG2Hi68Q7kNvwEKZLo5&_nc_oc=AdpN7gzmHFE5KBI7yIwrY_-EdQDuamhijyvVTds_khYvrB0gfH7v_bB1qV3Jk0l_xlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHPD3ovMZbErYEH8VtKrk8cOlCMqKxL5uIYshM3_tQEw&oe=6B03224B"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (2).png", "id": "313102016549273", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610716_313102019882606_8290101124020842441_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk1KxprTzZgQ7kNvwG9zYtx&_nc_oc=AdqDXH-_aCN0UAHYa_3A66SPON18H9HEbhOpvBSCq7fCKBfbrQ9VRSJ7eT2wrv-G8Qw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ95i0CA6Hp_PTVPn3185XNBeLBfOEBcFs5FYQczwCd2Q&oe=6B0333DF"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1].png", "id": "995636664198337", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86609235_995636670865003_6789415966943366450_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQhnv-uatEsQ7kNvwED8PLL&_nc_oc=AdpmUPa_F41Rc57aR1uvfmGJpYLNpTv30k63U_a17ZTW2vdKfCz_TPueGRrK2Dlq9-A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6rXeaoW9HhbK31L5xv0prtbBKIgxQNW3SU0oFcBNwLA&oe=6B0319EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.AtlasFord.TheConstruct-20200723-120237[1] (1).png", "id": "309057476902192", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974531_309057480235525_2429073677034493164_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1cmhCFAPfIQ7kNvwE4Ov1I&_nc_oc=AdqSE3C7VZYifneZdhIEFJm6pjb94fkaKvmjU9XyDteJ3dM4pOetTqO9qTo22WKLkVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjrhGI6AF6YVkujB8y0vKxBv_gRHAjKSMfoEkBaW0szw&oe=6B0303E3"}, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of basic geometric and various other objects to build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "Find yourself within an interactive randomly generated world where each experience is unique! Watch while nature changes around you as plants and creature grow and age! Build a personalized experience using nearly 100 objects including basic geometric objects, plants, and creatures with plenty more to come! Change size, color, and physicals properties of objects and use your controller to move them in 6DOF. Updates are released nearly every two weeks."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": "https://www.atlasfordinteractive.com/privacycom/atlasford/privacy", "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": "https://www.atlasfordinteractive.com/forum/_help", "website_url": "https://www.atlasfordinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genr
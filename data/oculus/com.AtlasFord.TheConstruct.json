327393088499962_5070684300865766863_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqQCeCc4AJoQ7kNvwF_qu4m&_nc_oc=AdlJ5SByKK0R3NGJ7o0XJ6ghNRADv88MsVb6BTOrpb2FSj5gC2Yx6R_W_P-M8Knppqo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXAW8I5hamhbVf-Q-67bgOTA5yruuihyNOdWygQR-Jpw&oe=69B2BB8B"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (2).png", "id": "313102016549273", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610716_313102019882606_8290101124020842441_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z07P5P9CoBkQ7kNvwEGMG3u&_nc_oc=AdklKToKRA84RneZuPWUn72ylJR3gWhJyenn-qH-EoDQPXbctWO3dezDhGEMYO8zrnc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwp1S7kacv6qzcEmv_rWD1ZEUV983iJLq8l6t6uK60o4w&oe=69B2CD1F"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1].png", "id": "995636664198337", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86609235_995636670865003_6789415966943366450_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjDRdqWXsV0Q7kNvwF7BnKT&_nc_oc=AdmTdWsOBe-XQzBKUVOKHKCwTFbJyHn_ndR0KzjjqgezxU9NNe2VPWEuhqi1GtdawmM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEM7x20lk_VtIaBdsessrqpjk0R7tu2Oyk7-afhDz57Q&oe=69B2B32B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.AtlasFord.TheConstruct-20200723-120237[1] (1).png", "id": "309057476902192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_309057480235525_2429073677034493164_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Qc7uJCEB3MQ7kNvwHRwZU-&_nc_oc=Adm9jxtcTG-9uaKwtq3-Om--OX9VfUIeqb7XmIPol2wGe8zMNQOlv01ml06ylHXEUtk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyrAOKzNbJIDa-Xw3v3GZf6bkAzhPaTHeQE_yjj2w8Sdg&oe=69B29D23"}, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of basic geometric and various other objects to build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "Find yourself within an interactive randomly generated world where each experience is unique! Watch while nature changes around you as plants and creature grow and age! Build a personalized experience using nearly 100 objects including basic geometric objects, plants, and creatures with plenty more to come! Change size, color, and physicals properties of objects and use your controller to move them in 6DOF. Updates are released nearly every two weeks."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": "https://www.atlasfordinteractive.com/privacycom/atlasford/privacy", "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": "https://www.atlasfordinteractive.com/forum/_help", "website_url": "https://www.atlasfordinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_i
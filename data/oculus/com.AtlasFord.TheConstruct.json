nt-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsEBFc1jJiQOSonwEJMP-UC45TUbm8I742Q3ErFejKcw&oe=6B09CDEF"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (3).png", "id": "327393085166629", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974869_327393088499962_5070684300865766863_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc6KpiT7bv8Q7kNvwFS-Mzw&_nc_oc=AdrAU8Os5frjByhYOXzhzZygUQbBFRV49LYc79VySQ3zPJFtj72ucLsmrOoFNNmbdfQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn8RJyHrpTIQPCxdISnKx_ajkJ6nk4hpSIE_tWjpEwIQ&oe=6B09B9CB"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (2).png", "id": "313102016549273", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/86610716_313102019882606_8290101124020842441_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hil1GWyIBz8Q7kNvwEH6a_m&_nc_oc=Adqj0EABMTJ6msSlrHhQ_uUc_r--hGqyX7D3bcmJVDHZ_6vHjrwRIMWZtVxER4AtUTY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEQyVPeJHkZwMFhY6SvydOH_ZEImkY0mnHmVwvJ8wpRQ&oe=6B09CB5F"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1].png", "id": "995636664198337", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86609235_995636670865003_6789415966943366450_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oerxRtqNoCAQ7kNvwGny7Fx&_nc_oc=AdrxLoLPIChu-l3L6znBIRzZcdAcLHm_t3R7R9Hvu6xPve1bzbsh09RimWH54fWE3Dw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeNbt_QRylErvqCzGXPH04AHS012Mj3FW5oYbdAnKWEg&oe=6B09B16B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.AtlasFord.TheConstruct-20200723-120237[1] (1).png", "id": "309057476902192", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974531_309057480235525_2429073677034493164_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKW_RzHkpq4Q7kNvwFFZfOM&_nc_oc=AdoVaGsG00TG4wPQRk-CpLZWzIVm_Q3gcG5Ahgsmf8UAFRxogz-soQ1ku5RkD8fp4c4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0jx9HcaFOK-Ex-vxrD27YwMgWXJKQ6GA-WXUVqmUZKw&oe=6B099B63"}, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of basic geometric and various other objects to build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "Find yourself within an interactive randomly generated world where each experience is unique! Watch while nature changes around you as plants and creature grow and age! Build a personalized experience using nearly 100 objects including basic geometric objects, plants, and creatures with plenty more to come! Change size, color, and physicals properties of objects and use your controller to move them in 6DOF. Updates are released nearly every two weeks."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": "https://www.atlasfordinteractive.com/privacycom/atlasford/privacy", "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": "https://www.atlasfordinteractive.com/forum/_help", "website_url": "https://www.atlasfordinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genr
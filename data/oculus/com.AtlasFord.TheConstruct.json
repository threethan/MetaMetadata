766863_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02eEUyvInT8Q7kNvwF_dLLs&_nc_oc=AdoxLh6lUoOJZoAz3mTIXTQYVz3ThXr9H5LO9LIPeEn9VamIx-gkC-3epEVhloaa4Qs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3XZvvPoU0tQ0qZ-tLpFzB824AOaEbF8h8iLg_DIGfJKA&oe=69F2038B"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (2).png", "id": "313102016549273", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86610716_313102019882606_8290101124020842441_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=573rPlZ3tfUQ7kNvwGSlPRt&_nc_oc=AdpKUUUfJv2l6pHjYGaIm4lY6_bu1iTh8NVFFgvtVg8C4pVBDWsmUz_UDAXtR--_7fo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af08QVCdWntz2fMKhQyFQMdht-1ykKMsHKvzu66cTQhhIw&oe=69F2151F"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1].png", "id": "995636664198337", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86609235_995636670865003_6789415966943366450_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feWSmhfEXV8Q7kNvwGfyqNo&_nc_oc=AdoSwIQELdlU6tLriEFGi3SlbsUNgGggoTcK3_88ps7XpgSeG2awfub_EkxQPvq9fcY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2MZaab_bp77palexUijaew0Di8BmorF5gGNgPfi7Zwog&oe=69F1FB2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.AtlasFord.TheConstruct-20200723-120237[1] (1).png", "id": "309057476902192", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974531_309057480235525_2429073677034493164_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FecdGKPpyQsQ7kNvwGrkyWd&_nc_oc=AdpZCOrVbfaPs3gKo3Ut2JolcoYFBLnL8pC8kjSLfHOc7zHSzj6gPAUqtSeeCGMpyhY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1dBJiKyIpYj_dUu3v2VpcLVQpluGSeEbWiPFoMsgZ9qg&oe=69F1E523"}, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of basic geometric and various other objects to build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "Find yourself within an interactive randomly generated world where each experience is unique! Watch while nature changes around you as plants and creature grow and age! Build a personalized experience using nearly 100 objects including basic geometric objects, plants, and creatures with plenty more to come! Change size, color, and physicals properties of objects and use your controller to move them in 6DOF. Updates are released nearly every two weeks."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": "https://www.atlasfordinteractive.com/privacycom/atlasford/privacy", "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": "https://www.atlasfordinteractive.com/forum/_help", "website_url": "https://www.atlasfordinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "492207189
_ohc=BY72siis_WsQ7kNvwF6gh2O&_nc_oc=AdnuiCbPi3oGfG3LkLA2jpc9vtMYuM0GEN_ebhutXkUaao1leuBM3pSnMkILyvZjUAQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHNJ_FztEtvYJtxdyXzh7JX-faHJO0BRI_7muJyTjzDg&oe=69AAD03D"}, {"file_name": "Screenshot_1.png", "id": "696110741179787", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035327_696110744513120_2214884794999014410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfJUdWair9kQ7kNvwFhtTli&_nc_oc=Adl9KK8sip8wfjGAw2XtDRdm8SkL6ppqdWK0bCT0IGDJL2WeMmTBa1T_eljW2_mDv-k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afzy0tO401Qt1FttrnvATXnQop-0K2_Dj_fXp806AD3ZtQ&oe=69AAC3F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of simple 3D objects and build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "The Construct is a physics sandbox simulator that allows you to create and manipulate simple 3D objects within a virtual environment. Save and load scenes with up to 2000 objects to your device to pick up where you left of, with exact positions, color, size, and effects! Build within an infinite world on all sides and create your own personal VR space. Please note that The Construct is currently under-development and all features are subject to change."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": null, "website_url": "https://silvajacobf.wixsite.com/atlasford", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "315564483947534"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3289122461108356", "version": "0.2.44"}, "id": "936605086796127", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3024128414274430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3289122461108356"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1597761490, "id": "3300825823271353", "version": "0.2.44.3", "version_code": 2071, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isApp
nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG31XMnfv3_LTPCWn8E6qd9uh2m1VDiSzb61_yRKj36A&oe=6AFDB82F"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (3).png", "id": "327393085166629", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974869_327393088499962_5070684300865766863_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTyfm9jLxbMQ7kNvwEBkUDD&_nc_oc=AdqBbch5kAfyVwEj5mPvYMuu1scg7ctw7BVEHMVtACJz2MfTnO0ESmMEG6Uh1yAOJ7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlsJhK0d8gmOYLaXMg7sh0C4nhfZz8ijCW2VJg68uc_w&oe=6AFDDC4B"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (2).png", "id": "313102016549273", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610716_313102019882606_8290101124020842441_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPHmHsu2ZcQQ7kNvwH7pCZN&_nc_oc=AdoBnpvQXaOC_xeemRnCF8jFRn_SZ2SCeGMzSJnKI7W0m2iNQEGt9B4HjCBFUuRew4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLTatiqbn8N8uuV6tqWKZMlAwwhrKEqnkV9h-Powf8gg&oe=6AFDB59F"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1].png", "id": "995636664198337", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86609235_995636670865003_6789415966943366450_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9g93FoFAxgQ7kNvwH-8dSh&_nc_oc=AdoupmxAvvf8XqnwLW2AG2ZcS2fv9ZTR_IeYfUaZWiDe-tl3rYGRL5xB7M6GKlupFUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOXCleloBBkyGMok90V6c_zAgz6s5hMPA9ugNmAU-wZw&oe=6AFDD3EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.AtlasFord.TheConstruct-20200723-120237[1] (1).png", "id": "309057476902192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_309057480235525_2429073677034493164_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vy3iwuTOS8Q7kNvwFp0XBv&_nc_oc=AdqoFYRAmmKhwdAq_xMPDow-It2xOCGpBDV14y9I4GNFdJQ6iKECFYLGfYdZ36D5LdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXp7IUqemhDdwRj1l6zuFLU7EHSRXKMLgjhnvj0TV_Cw&oe=6AFDBDE3"}, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of basic geometric and various other objects to build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "Find yourself within an interactive randomly generated world where each experience is unique! Watch while nature changes around you as plants and creature grow and age! Build a personalized experience using nearly 100 objects including basic geometric objects, plants, and creatures with plenty more to come! Change size, color, and physicals properties of objects and use your controller to move them in 6DOF. Updates are released nearly every two weeks."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": "https://www.atlasfordinteractive.com/privacycom/atlasford/privacy", "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": "https://www.atlasfordinteractive.com/forum/_help", "website_url": "https://www.atlasfordinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genr
nt-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0PaOZlnYEqzWCsaGyd3Wu56G0geUpGjIacCbhOOQMmQ&oe=6B0B1F6F"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (3).png", "id": "327393085166629", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974869_327393088499962_5070684300865766863_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc6KpiT7bv8Q7kNvwHVT2qd&_nc_oc=Adon2_Q2ZqAbJe0oNKWjEwE47iAAQixy45jx2iI4mvzf0dY2y6XRtguGmdzmNShpm8A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQJZF5-RXcHvFDaxlBeDOWVQ6A26aeZVZH3f5jUl8B87Q&oe=6B0B438B"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (2).png", "id": "313102016549273", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86610716_313102019882606_8290101124020842441_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5V48NTVLFcMQ7kNvwEefsHF&_nc_oc=AdoLObvKbPZY4P_RIMrClqzGp1KxokQVaVwO7psM3MOXk10iubICIPZZsOunuTfPi_Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3KK0131CZUIQIj3LUzbV1ZOyD1v5a9I_lC_9VlG2J5Q&oe=6B0B1CDF"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1].png", "id": "995636664198337", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86609235_995636670865003_6789415966943366450_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVxfr1v4idwQ7kNvwGEoA92&_nc_oc=AdobS3RGWxb0WTwNCGcd576uzHuLJ9psIjnVkig9bDJsoanADOUIvA4at5Rd9iMj5Tg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbawkOo_xCf9NWoLijSbBD7WuHAYJfy7XC_mlMsAkULQ&oe=6B0B3B2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.AtlasFord.TheConstruct-20200723-120237[1] (1).png", "id": "309057476902192", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974531_309057480235525_2429073677034493164_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXQT3qwnvI0Q7kNvwG0-zw_&_nc_oc=Adprd7qdDcXbkvEADNlglc5XIjXFOxAWuGZjgO4IQIQJhnFkK4TndKwvJQ8kVfmgXbE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQH4rX6M7DTCWWEWuaBu15jEnEnKWA87jOKgc0nrJQdVg&oe=6B0B2523"}, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of basic geometric and various other objects to build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "Find yourself within an interactive randomly generated world where each experience is unique! Watch while nature changes around you as plants and creature grow and age! Build a personalized experience using nearly 100 objects including basic geometric objects, plants, and creatures with plenty more to come! Change size, color, and physicals properties of objects and use your controller to move them in 6DOF. Updates are released nearly every two weeks."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": "https://www.atlasfordinteractive.com/privacycom/atlasford/privacy", "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": "https://www.atlasfordinteractive.com/forum/_help", "website_url": "https://www.atlasfordinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genr
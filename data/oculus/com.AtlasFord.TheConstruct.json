t-lhr6-1.oculuscdn.com/v/t64.5771-25/38974869_327393088499962_5070684300865766863_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtC460bsGfIQ7kNvwFso5ML&_nc_oc=Adri6IokFje4oBH-w_NnKpPO_beR5o0FIZN5YXYPtgUB3ZWQvwxo2aECc_qRGB99wPY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKRuPK0cRhEVykij6diF5v1DsEKpwnh7J31487TdZsKw&oe=6A85AB8B"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (2).png", "id": "313102016549273", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86610716_313102019882606_8290101124020842441_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyq41CUSya4Q7kNvwHbxuAU&_nc_oc=AdqJYyPvDRPGrmCJ6XZujXjO_ZxWB77pwgKf1DHTPqWAwpd3PbN7QLzWBcuGj3fAJao&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJLa8s7LFT6cGRhqAAcRCSBP01yVW73fkbEUyEvao5AQ&oe=6A8584DF"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1].png", "id": "995636664198337", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86609235_995636670865003_6789415966943366450_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCb2dG9y2J8Q7kNvwE7Jjqj&_nc_oc=AdpMqTQHtIovlbsugErMkeZP6G0DrWrDBKdObHOQptLoSwSNNy8U8iapbibm15X-bi4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPrIG4a4qN3hBvwO7Hu2VAMR_Tn4BuW1pYyTom9b6EZQ&oe=6A85A32B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.AtlasFord.TheConstruct-20200723-120237[1] (1).png", "id": "309057476902192", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974531_309057480235525_2429073677034493164_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuQ8evtWsFMQ7kNvwGFWBpM&_nc_oc=AdoBZFDVCnqCwNCE2wI3_09G9d8R8n0PW-T1tdUiWdidJtdeIbOcO657LEZaXrT8ChM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF02JkrtzhVVR7ufZ9fmS093cfXkRw92cbWMNDcYPswg&oe=6A858D23"}, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of basic geometric and various other objects to build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "Find yourself within an interactive randomly generated world where each experience is unique! Watch while nature changes around you as plants and creature grow and age! Build a personalized experience using nearly 100 objects including basic geometric objects, plants, and creatures with plenty more to come! Change size, color, and physicals properties of objects and use your controller to move them in 6DOF. Updates are released nearly every two weeks."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": "https://www.atlasfordinteractive.com/privacycom/atlasford/privacy", "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": "https://www.atlasfordinteractive.com/forum/_help", "website_url": "https://www.atlasfordinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "su
nt-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYWhBiZTR2MJB0_saqeeBaYaiBYY81LeZpdrnTCWBulg&oe=6B08442F"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (3).png", "id": "327393085166629", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974869_327393088499962_5070684300865766863_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc6KpiT7bv8Q7kNvwGz1oB-&_nc_oc=AdoXBFgD2D61cBBYCItil4IVYfOwSRwh_VYyrxLm54lQgqMf0l4OI04f30KPhifWbEc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-ajnlmpfRNzj_2eLOVK7UuvNjbkKgOKMI8uqLrbEtIg&oe=6B08684B"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (2).png", "id": "313102016549273", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610716_313102019882606_8290101124020842441_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hil1GWyIBz8Q7kNvwGuY7ge&_nc_oc=Adp6T6Ls5QOyioyCY7cSwqPKXZIfHMACvXhf_g6NlygK5lc-pdRbrjeokVqSbvWuNWw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwf4sN3S9eMI71BBdtuYm3nFEeLWy0zVsBu0K11JJm9A&oe=6B08419F"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1].png", "id": "995636664198337", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86609235_995636670865003_6789415966943366450_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oerxRtqNoCAQ7kNvwGgFdLE&_nc_oc=Adovv9tfCdEtM-Ab2k1drjeomo8z1UZ05q3hp2brblG50JuRmzqHFvhtkMR2cy_JnKA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB2VGjAQvw0PdZCvqNS8ukhaACt4GKW7LqX_V_UPOybQ&oe=6B085FEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.AtlasFord.TheConstruct-20200723-120237[1] (1).png", "id": "309057476902192", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974531_309057480235525_2429073677034493164_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKW_RzHkpq4Q7kNvwG35gxC&_nc_oc=Ado7e_5I2SamYbLNjh0e6ISp75gejw-dhgqYh2742seSbF6qq8mOWN4EtrSfqcUm3k8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8kCrja52aShlAqebLVPhuxJe3n5k2l_4pS0k29XatGw&oe=6B0849E3"}, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of basic geometric and various other objects to build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "Find yourself within an interactive randomly generated world where each experience is unique! Watch while nature changes around you as plants and creature grow and age! Build a personalized experience using nearly 100 objects including basic geometric objects, plants, and creatures with plenty more to come! Change size, color, and physicals properties of objects and use your controller to move them in 6DOF. Updates are released nearly every two weeks."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": "https://www.atlasfordinteractive.com/privacycom/atlasford/privacy", "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": "https://www.atlasfordinteractive.com/forum/_help", "website_url": "https://www.atlasfordinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genr
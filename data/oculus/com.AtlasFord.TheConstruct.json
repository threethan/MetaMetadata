nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3px9o7MLeVz-59yVjfUGODobUB8pK9jZpFen7YmJqsw&oe=6B05A12F"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (3).png", "id": "327393085166629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974869_327393088499962_5070684300865766863_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7J2NYk1-V8Q7kNvwHbOUOC&_nc_oc=AdoU-SOI1ojRj8INn0MOwuxsSq1X3mEB8R2ih-XslBCRFJv_TCCsoHW7Wt9bNTvzU2I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR22t9uL0m901oQtmmAgvBzzjhyHXCrOTJwH8ZyPFhNw&oe=6B05C54B"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (2).png", "id": "313102016549273", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610716_313102019882606_8290101124020842441_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk1KxprTzZgQ7kNvwGZsFlq&_nc_oc=AdrAr3OdBwaSbNAJTfXKDjeSW2Ns3oBTk5rpBPgk_QvIFRH5qEmoEzjhX4_xiZVfo4s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNFWM7go-RfPghUgubdSm1KUuIVE1c35-rEQNASE4xcw&oe=6B05D6DF"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1].png", "id": "995636664198337", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86609235_995636670865003_6789415966943366450_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQhnv-uatEsQ7kNvwFlZzaV&_nc_oc=AdozkMGc99yEBZp9Iog4cpt-FCF9H0Awk3Z_hGZjN9e1VPhwFIcyyA7BHQLMR7rPR3s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZdkEC2ysjkQ7SHIHnYz8C2D3eNIc2bCQX9LV-kReSng&oe=6B05BCEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.AtlasFord.TheConstruct-20200723-120237[1] (1).png", "id": "309057476902192", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974531_309057480235525_2429073677034493164_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1cmhCFAPfIQ7kNvwHl0fO3&_nc_oc=AdrLg6OQddtUkzz-jePK37P7O1eTXT61uNy5MPVc41mjAtEoemyCibbjGiVGMh6qawY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuvTGlSoBtKPCsd1o1DSwETukKU47i2SdWMM06RhIlkA&oe=6B05A6E3"}, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of basic geometric and various other objects to build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "Find yourself within an interactive randomly generated world where each experience is unique! Watch while nature changes around you as plants and creature grow and age! Build a personalized experience using nearly 100 objects including basic geometric objects, plants, and creatures with plenty more to come! Change size, color, and physicals properties of objects and use your controller to move them in 6DOF. Updates are released nearly every two weeks."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": "https://www.atlasfordinteractive.com/privacycom/atlasford/privacy", "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": "https://www.atlasfordinteractive.com/forum/_help", "website_url": "https://www.atlasfordinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genr
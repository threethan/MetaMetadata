nt-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRW7CxddOMF7PrXidpkbzeD07bZH046TSY14HeR6K9YnA&oe=6B0DC26F"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (3).png", "id": "327393085166629", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974869_327393088499962_5070684300865766863_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJw_LwDUw1wQ7kNvwF7r3mt&_nc_oc=AdqfsoaaH2jN-tdj2JuUTkQJnMImP41QSsAJG5u7lUqVzrfJmF_uoPsMxaHwnVh4Reg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRKI5ReFTQslNBlsnWeyluGyenXXcEdlnANxrR1DEg8SQ&oe=6B0DAE4B"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1] (2).png", "id": "313102016549273", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610716_313102019882606_8290101124020842441_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5V48NTVLFcMQ7kNvwEgsyvU&_nc_oc=Adp84ENjM5mszoKsWVZ58ttILWQ_vDkwnu3gI4dgmjHXkDVBJi4OgoJeJl2ADQb-JVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyF2BB4jjU2pu3ymPn6kYdHm_brw59yUlHKxbAJFpIBA&oe=6B0DBFDF"}, {"file_name": "com.AtlasFord.TheConstruct-20200729-194719[1].png", "id": "995636664198337", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86609235_995636670865003_6789415966943366450_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVxfr1v4idwQ7kNvwH0FRV_&_nc_oc=Adq4ouaSgm1TUPgyK4N-ynx-esndeX3PdOk7yIKmVdLwjcir_g3fiEiZFhDJY8iu0Sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgEJlxhZ7j6upEc4nIc-7sLC-_1Xwp23ncvIyulYQshg&oe=6B0DA5EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.AtlasFord.TheConstruct-20200723-120237[1] (1).png", "id": "309057476902192", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974531_309057480235525_2429073677034493164_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXQT3qwnvI0Q7kNvwE4X62w&_nc_oc=AdofIsQ7vT6Guh6srEVj2ohqAxbcImegaVQXE8Wdmx1at1aSSiaeslnJPx7ftE-tOOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRbN773eGvXBbnCy09baj38-HVeFO7jbSKQc-0vNX9EJw&oe=6B0DC823"}, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of basic geometric and various other objects to build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "Find yourself within an interactive randomly generated world where each experience is unique! Watch while nature changes around you as plants and creature grow and age! Build a personalized experience using nearly 100 objects including basic geometric objects, plants, and creatures with plenty more to come! Change size, color, and physicals properties of objects and use your controller to move them in 6DOF. Updates are released nearly every two weeks."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": "https://www.atlasfordinteractive.com/privacycom/atlasford/privacy", "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": "https://www.atlasfordinteractive.com/forum/_help", "website_url": "https://www.atlasfordinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genr
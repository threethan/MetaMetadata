7kNvwH3zL4i&_nc_oc=Adk9uH9U_6iKkV3Zff5imxBtx907RJqvgbxj1_I9fULCtr5CNWsa1-5zguSbrHbbMNw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwOU6HPBnnnxK3dfdtQ-shmjWetSE0GMRkbZc7kO7QoHg&oe=69BD453D"}, {"file_name": "Screenshot_1.png", "id": "696110741179787", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035327_696110744513120_2214884794999014410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU7EtOgKytgQ7kNvwGI2eJ0&_nc_oc=Adn2Y7U9iOwlaRustyMGcpBfJBpF2EwrPNoyTNnfa8tCdnZMe6TnaEH-3G5akDYSobU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxklTMGMPPbIog2TNDj2SoI162Kp0txxKi2T1Quehwi_g&oe=69BD38F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of simple 3D objects and build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "The Construct is a physics sandbox simulator that allows you to create and manipulate simple 3D objects within a virtual environment. Save and load scenes with up to 2000 objects to your device to pick up where you left of, with exact positions, color, size, and effects! Build within an infinite world on all sides and create your own personal VR space. Please note that The Construct is currently under-development and all features are subject to change."}]}, "develop
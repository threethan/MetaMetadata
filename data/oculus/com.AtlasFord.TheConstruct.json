63232530365259_1477155681714775521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bkt0qbp0ix8Q7kNvwGc7CrA&_nc_oc=AdohIlxyr3jGlBJq2fYLxNmVPWsszj7_kkAU5N5lr7kYoxey2sHy_xQvjDkWT_sJWr8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MYtHjrOw8bVzDko0UTwi2FbGbTUNVyH1cWMCPQkDJ_Q&oe=6A1ADFBD"}, {"file_name": "Screenshot_1.png", "id": "696110741179787", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035327_696110744513120_2214884794999014410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RuVTJ4-c8sQ7kNvwHH4Q2k&_nc_oc=AdoHbP_XKYX_8iOwC7ZdjwSVMC4LP8ioPwIoWPYccbJJMV6ycSpg1IExYVcIK5gM7Ws&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lRGLWwKEfHF8oQ7Ipiu52r81xi0ZNHdhrgvpGMgxViA&oe=6A1B0BB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Construct", "keywords": ["Simulation", "Physics", "Sandbox", "Building", "Creative"], "long_description": "The Construct is an exclusive Oculus Go VR title. Enjoy a unique physics sandbox simulation game set in an open world with free movement! Choose from a set of simple 3D objects and build a world of your dreams, or just play around with cool effects! Saving and loading features allow users to build a vast world with thousands of objects. Easy and intuitive controls make manipulating your environment easy with gaze UI control, and 6DOF object grabbing. Simple sound effects add interactive elements when controlling aspects of gameplay. The Construct was developed by AtlasFord and is a project currently under-development. All features are subject to change in the future.", "short_description": "The Construct is a physics sandbox simulator that allows you to create and manipulate simple 3D objects within a virtual environment. Save and load scenes with up to 2000 objects to your device to pick up where you left of, with exact positions, color, size, and effects! Build within an infinite world on all sides and create your own personal VR space. Please note that The Construct is currently under-development and all features are subject to change."}]}, "developer_name": "AtlasFord", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "AtlasFord Interactive", "support_website_url": null, "website_url": "https://silvajacobf.wixsite.com/atlasford", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "315564483947534"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3289122461108356", "version": "0.2.44"}, "id": "936605086796127", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3024128414274430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3289122461108356"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1597761490, "id": "3300825823271353", "version": "0.2.44.3", "version_code": 2071, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__i
[{"channel_name": "LIVE", "id": "2167794850820199"}]}, "change_log": "V2 brings new ways to watch and feel your own music. Optional controller haptics combine rhythmic impacts, subtle musical waves and gentle arrow-following texture, with adjustable strength. Show surroundings places the arrow, trail, ball and tiles in your room. Play local MP3 and FLAC files; search songs live with the Quest keyboard; create playlists and add multiple songs directly. Improved controller targeting and menu movement, clearer switches, shuffle/repeat, volume, seek jumps and playback speed controls. Recenter preserves your colours and listening settings. Faster cached loading and background library preparation. Includes two licensed CC0 demos. Your music and analysis stay on the headset.", "created_date": 1791794471, "id": "1364434763424439", "version": "2.0.0", "version_code": 23, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1351478084720107", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1378260172041898"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2167794850820199"}]}, "change_log": "\"Enjoy your own MP3 music with a moving arrow, 3D trail, glowing ball and tiled floor or wall. Includes the CC0 Saltarello and Through Fire violin/flute demos. Live colour controls, named saved views, smooth library controls and playback speeds from 0.5x to 2x.\"", "created_date": 1791659841, "id": "1361953680339214", "version": "1.0.12", "version_code": 22, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499347496_1002188638359529_2024822131461354903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YT2gh3D35-QQ7kNvwG_5n03&_nc_oc=AdpPvSNO9QHXjhb_VqVmsbo3joBhv6hLzg5fQ4Y1n1N-fJz13oca0IwvtYdgKp8SpZs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_Z-5d22_f9Lz0660Rz-HiWRYGIcQ6IZYRWrVqaKerQw&oe=6A204A3D"}, {"file_name": "CC_Screenshot_2560x1440_5.png", "id": "1377870490193650", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392057_1377870493526983_5613847404176538347_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DV0l1-E3JoQ7kNvwHqDM9k&_nc_oc=AdqqCt-R7e1hn4vaSZyT_Oy1IQ8Bn7L3k7v88NVkJgqv9SjrM1vueaCXcrV-ojD3tFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e4VOjmOcGbXTePKHNxP14iBi78b9lhbg25MHevR25CQ&oe=6A204C9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClickClack_Store_2560x1440.png", "id": "995045572841797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307443_995045576175130_2666890995825443971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUMNFo95w9gQ7kNvwH9zm5z&_nc_oc=Adq3nbyy7sXOaswVniNclOHBAcTiiFnr9R3rmRsZ1upelNyNavg89TZufGjLAk29tqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48oj_Lj_48scMLATT2ruyrn7CfpFKmsVRKR57hMXCRbg&oe=6A203E49"}, "display_name": "Click Clack Mixed Reality", "keywords": ["fps", "tactical", "mixedreality", "shooter"], "long_description": "CLICK CLACK MIXED REALITY\n\nThe only adult mixed reality FPS on Quest. Your home. Real weapons. Digital blood on your walls. No mercy.  \n\nNo pew pew lasers and cartoon portals. Click Clack MR brings brutal, tactical combat into your actual living space \u2014 walls, hallways, furniture and all. The enemy is in your house.  \nThis is Mixed Reality built for people who don't want easy.\n\ud83d\udd2b Tactical Breach & Clear \u2014 Stack up on real doors, sweep real rooms, neutralize threats hiding behind your actual couch.\n\ud83c\udfaf Hostage Rescue \u2014 Breach, identify, and execute under pressure. Some enemies blend in. Make the wrong call and face the consequences.\n\ud83d\udc80 Shoot-Out Survival \u2014 Endless wave mode. No respawn timers. No hand-holding. Be the last one standing or start over.\n\ud83e\udd86 Hunt Ducks/Target Practice \u2014 Sharpen your aim in your real space before the real fight begins.\nRealistic weapons. High difficulty. Gore enabled.\nBuilt for adult players who want their mixed reality to have weight.\nEarly Access \u2014  Updates drop fast.", "short_description": "Breach, dodge, shoot and paint your real walls with the enemy.  Search suspects for weapons, rescue hostages and protect your house. \nNo levels to load. Your room is the battlefield.  The bad guys are inside. \n\nTake Doors, Save Hostages! "}]}, "developer_name": null, "developer_privacy_policy_url": "http://ClickClackMR.com/", "developer_terms_of_service_url": null, "publisher_name": "Lopes Media LLC", "support_website_url": "http://ClickClackMR.com/", "website_url": "http://ClickClackMR.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32890952747215979"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301458_671588369049314_5468058057492259680_n.png?stp=dst-png_s360x360&_
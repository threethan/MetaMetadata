dn.com/v/t64.5771-25/473392057_1377870493526983_5613847404176538347_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMCW9cwchJgQ7kNvwEXOhhn&_nc_oc=AdoB8rP8ABL80zhimGbqiEywbmYRW0xs1kDpN5fxs5Gm5jki_3bIYxE3eUr3iRoU4PQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg1z4YdTLZagrIQFM6D0nB62RD1VFJADAjTEJvJCOk0Q&oe=6AC1239A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClickClack_Store_2560x1440.png", "id": "995045572841797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307443_995045576175130_2666890995825443971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35gAU7UvnFIQ7kNvwHsY3Vf&_nc_oc=AdqQ17eAvv1zAIaZ8GfTRi3nILEmLxBvvsqDSOKJZGW4o9jpNYOAlVJXac77qMt60co&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR1vYhafJfVUQwN8sJ79fkgBjeMcoxP9DnHtdmgvcjzA&oe=6AC11549"}, "display_name": "Click Clack Mixed Reality", "keywords": ["fps", "tactical", "mixedreality", "shooter"], "long_description": "CLICK CLACK MR is the first mixed reality shooter built with AI by a dev who doesn't know how to code.\n100% vibes. 10,000% fun. Zero programming. Just AI, Unity, and a wild dream.\n\nYour house is the battlefield.\nDodge, shoot, breach doors, rescue hostages, and search suspects \u2014 all inside your own real-world space.\n\nFEATURES:\n\ud83d\udfe9 Hostage Rescue \u2013 Breach, clear, and save the VIP. But beware\u2026 some enemies hide in plain sight.\n\ud83d\udfe5 Shoot-Out \u2013 Endless wave survival with \u201cDoubleTap Respawn.\u201d Be the Baba Yaga.\n\ud83c\udfaf Target Practice \u2013 Scatter targets around your space for fast-paced drills.\n\ud83e\udd86 Ducks \u2013 Yep. There are ducks. And they\u2019re in your living room. Take em out! \n\nThis is an Early Access release. Big updates coming soon:\n\u2705 Custom Map Builder\n\u2705 Local Co-Op Mode\n\u2705 More chaos, more doors to kick, more vibes\n\nBuilt with AI. Played with courage.\nTake doors.\nClickClackMR.com", "short_description": "CLICK CLACK MR is the first mixed reality shooter built with AI by a dev that doesn't know how to code! 100% Vibes. \nBreach, dodge, shoot, and survive as enemies storm your real-world space. Search suspects for weapons, rescue hostages and more!\nNo levels to load. Your room is the battlefield.\n\nThis is an Early Access release \u2014 with Map Builder and Local Co-op coming soon.\nTake Doors! "}]}, "developer_name": null, "developer_privacy_policy_url": "http://ClickClackMR.com/", "developer_terms_of_service_url": null, "publisher_name": "Lopes Media LLC", "support_website_url": "http://ClickClackMR.com/", "website_url": "http://ClickClackMR.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29551277771183510"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "2046363439349267"}, {"status": "PUBLISHED", "id": "1405009394681922"}, {"status": "PUBLISHED", "id": "2084790648681742"}]}, "baseline_offer": {"id": "2084790648681742"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "2046363439349267"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38683673834610479", "version": "1.3.22"}, "id": "670727019172657", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38683673834610479"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "Scope, map builder improvements and more. \nPatch notes on Discord www.ClickClackMR.com", "created_date": 1790188700, "id": "38683673834610479", "version": "1.3.22", "version_code": 57, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38683673834610479"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "New: scopes that zoom the real room\n\nRifle scopes now magnify your actual room, not just enemies.\n\n\nAttachment wheel\n\nThe right slot now cycles HOLO, SCOPE, SIGHT OFF on Picatinny rails. \n\nUnder the hood\n\nNew camera permission in the manifest.\nRoom scan package embedded with fixes for Unity 6.4.\n\nUI\nNew UI for all menus.", "created_date": 1790038105, "id": "38633164769661386", "version": "1.3.20", "version_code": 55, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38683673834610479"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "Full patch notes on Discord. Check out www.ClickClackMR. to join\n\n1.3.18\n-----MAJOR------\n\nMAP VARIANTS\nFire + Night Mode\n\nATTACHMENTS\nLight + Laser\n\nVISOR\nNight Vision, Heat Detection and UAV display on your visor. \n\nMAP BUILDER\nNew materials, shapes + movements. \n\nNPCS\nHostages and Imposters now move, check for weapons before you shoot. \n\nCO-OP FIXES\n\nFixed the second player losing alignment after the first scene change. Custom maps and the other player's avatar now stay in place for the whole session.", "created_date": 1789671846, "id": "38526960960281768", "version": "1.3.18", "version_code": 53, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38683673834610479"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "Bug Fix for Grenades\nwww.ClickClackMR.com to join Discord to see patch notes", "created_date": 1789637286, "id": "38515504221427442", "version": "1.3.17", "version_code": 52, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38683673834610479"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "Patch notes on Discord at www.ClickClackMR.com", "created_date": 1789574806, "id": "38497463119898219", "version": "1.3.17", "version_code": 51, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
c_ohc=nvqFnnYf-XEQ7kNvwFltnzX&_nc_oc=AdoZhKdAgF460qoTEJOJ_diknmnt8hesXFLvdE8F0LgZ9vGFZ20j4QK0CONrO55f6DA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5da6PzZA_MV_WeohVGxsRJ_O6hKKIDk0YSeSv9zYv1LQ&oe=69FF1C7D"}, {"file_name": "CC_Screenshot_2560x1440_5.png", "id": "1377870490193650", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392057_1377870493526983_5613847404176538347_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqNVfAziRKIQ7kNvwGVItPc&_nc_oc=Ado6y9k6qm80DiRasBxP-lZK7xjVkdE-G2Pb7c4g_w3jiLoAiPnKMDwYnNxZiHXgO0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GlgmtjN5_mEMRvrYYd7sl7jxdnCJAPuGI9JScxEDKow&oe=69FF1EDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClickClack_Store_2560x1440.png", "id": "995045572841797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307443_995045576175130_2666890995825443971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i04VSC3VLjsQ7kNvwEqdIff&_nc_oc=Adq0hQjZh0ne1TSRPxrS03pTVnRcMGFDMJN3uW5b7v2Mn-sSDdTNJuIKxRdFaYI3RhA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5htBgrrASIGBKPwNNH7ar0d7kzCtmbEQGAlyV8pYAdUQ&oe=69FF48C9"}, "display_name": "Click Clack Mixed Reality", "keywords": ["fps", "tactical", "mixedreality", "shooter"], "long_description": "CLICK CLACK MR is the first mixed reality shooter built with AI by a dev who doesn't know how to code.\n100% vibes. 10,000% fun. Zero programming. Just AI, Unity, and a wild dream.\n\nYour house is the battlefield.\nDodge, shoot, breach doors, rescue hostages, and search suspects \u2014 all inside your own real-world space.\n\nFEATURES:\n\ud83d\udfe9 Hostage Rescue \u2013 Breach, clear, and save the VIP. But beware\u2026 some enemies hide in plain sight.\n\ud83d\udfe5 Shoot-Out \u2013 Endless wave survival with \u201cDoubleTap Respawn.\u201d Be the Baba Yaga.\n\ud83c\udfaf Target Practice \u2013 Scatter targets around your space for fast-paced drills.\n\ud83e\udd86 Ducks \u2013 Yep. There are ducks. And they\u2019re in your living room. Take em out! \n\nThis is an Early Access release. Big updates coming soon:\n\u2705 Custom Map Builder\n\u2705 Local Co-Op Mode\n\u2705 More chaos, more doors to kick, more vibes\n\nBuilt with AI. Played with courage.\nTake doors.\nClickClackMR.com", "short_description": "CLICK CLACK MR is the first mixed reality shooter built with AI by a dev that doesn't know how to code! 100% Vibes. \nBreach, dodge, shoot, and survive as enemies storm your real-world space. Search suspects for weapons, rescue hostages and more!\nNo levels to load. Your room is the battlefield.\n\nThis is an Early Access release \u2014 with Map Builder and Local Co-op coming soon.\nTake Doors! "}]}, "developer_name": null, "developer_privacy_policy_url": "http://ClickClackMR.com/", "developer_terms_of_service_url": null, "publisher_name": "Lopes Media LLC", "support_website_url": "http://ClickClackMR.com/", "website_url": "http://ClickClackMR.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29551277771183510"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1405009394681922"}, {"status": "PUBLISHED", "id": "2084790648681742"}]}, "baseline_offer": {"id": "2084790648681742"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "1405009394681922"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35367528042891758", "version": "1.3.5"}, "id": "670727019172657", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35367528042891758"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.5\n----MAJOR----\n\nADDED\nShotgun to back holster of player.\nShotgun ammo above magazine pouch\nExtra pistol holster below magazine pouch\nLore in main menu. RIP MY DOG!\n\nTWEAKS\nEnemy AI improvements.  These improvements drastically up the difficulty. Good luck. \n\nKNOWN ISSUES\nStats tracker in hostage mode. \nDev is an idiot.", "created_date": 1777910631, "id": "35367528042891758", "version": "1.3.5", "version_code": 38, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35367528042891758"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.3\n----MINOR----\n\nADDED\nUI to main menus. Fixed ray cast. \n\nREMOVED\nSplash Screen & music causing initial load errors.\nGun respawning directly in socket during player death.\n\nTWEAKS\nReduced enemy bullet spread from 6 to 3. \n\nKNOWN ISSUES\nDev is an idiot.", "created_date": 1777730416, "id": "35326909226953640", "version": "1.3.4", "version_code": 37, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35367528042891758"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.3\n----MINOR----\n\nREMOVED\nSplash Screen & music. \n\nTWEAKS\nReduced enemy bullet spread from 6 to 3. \n\nKNOWN ISSUES\nDev is an idiot.", "created_date": 1777724941, "id": "35325517850426111", "version": "1.3.3", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35367528042891758"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.2\n----MID----\n\nFIXED\nAll detachment bugs.  \nAll XR Origin bugs. Desk and hands should always be level. \nLess crashes. \n\nADDED\nHand model for immersion\n\nTWEAKS\nAdjusted AI performance to be more aware and deadly. Good luck. \n\n\nBACKEND\nRestructured how controllers work. Optimized tracking. \n\n\nKNOWN ISSUES\nDev is an idiot.", "created_date": 1777511894, "id": "35273032705674626", "version": "1.3.2", "version_code": 35, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35367528042891758"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.0\n----MAJOR----\n\nFIXED\nHand detachment bug\nRagdolls are 10000% better and satisfying. Still need to rework hostage/imposters a bit more but enemies are perfect. \n\nADDED\nMore blood!  Blood spurts from gun shot wounds and puddles the floor. \nHostage/Imposter skin randomizer. The combinations are hilarious. You never know what goes on in peoples homes. \nMore animations for hostage/imposters\nCan push open doors with gun.\n\nTWEAKS\nAdjusted tac vest colliders and placement. \nAdjusted door placement ray\nMainMenu button size\nAdjusted vest for magazine pouch and weapon placement\nHand interactions and pistol grip.\n\nUPDATED\nVRFPS Kit\nBlaze AI\nMeta SDK\n\nBACKEND\nNPCs restructured for easier customization down the road.\nUpdated VRFPS Kit, Meta SDK, Blaze AI, Unity\nNPC Skin randomizer added in 1st iteration\n\nREMOVED\nShotgun?\nWin conditions/stats need to be reworked.\nWill fix on next update. \nBullet impact/pass sounds need to be reworked\n\nFUTURE\nMore sounds.  Fix Ragdolls on Hostage/Imposters.\nMake doors less wonky, add locks and better hinges. \nMoving hostages\nLocation based gun shot reactions\nGuess Who? Game mode\nBomb Game mode\nAI adjustments\n\nKNOWN ISSUES\nSome items are in funny rotations (grenade)\nGrenade pin has visual stutter\nWeird visual gun stutter in certain positions\nDev is an idiot", "created_date": 1777064208, "id": "35155161300795101", "version": "1.3.0", "version_code": 33, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
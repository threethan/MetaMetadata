f&oh=00_Af5L3Jl9xgmIcTfGAzVO--d3_mG9aJObK3kZfwDXB0s8sA&oe=6A107C85"}, {"file_name": "ClickClack_Store_1440x1440.png", "id": "671588365715981", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499301458_671588369049314_5468058057492259680_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8lyoclac98Q7kNvwEsTvql&_nc_oc=AdrkKy0dC2bYNz6Hpkpoc_16bcE8hlhpoPVLQpAuUFEUMikvU9-zRAtmwJ3mP8cfEFk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pwCNQwJ_aDd77MXCyEIOrqCEYE-4Ytt6IunTN3QJAAw&oe=6A106C6B"}]}, "id": "2281273112316384", "locale": "en_US", "screenshots": [{"file_name": "CC_Screenshot_2560x1440_1.png", "id": "1260351732354635", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499349925_1260351735687968_8792305266476707694_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dkR1SbkZRoQ7kNvwHE0oZZ&_nc_oc=AdoMvYgjSScFd9rO6OnXkfwprgQICDZW8iLUpXvXm9k0gJbQHN44rpKJHcmZ_E0iZVw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46YdLcCH08xdh-trzcQpnmbrhsXCgIsGcMGizdRx8K3g&oe=6A104998"}, {"file_name": "CC_Screenshot_2560x1440_2.png", "id": "1375206417075057", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391887_1375206420408390_3298375023160633184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sx-zvelpMMsQ7kNvwEcmdMn&_nc_oc=AdrmKaLsSjkS1PaRRXZA5aB10w1_g-rNp32sfqUr5wGSeLly8xTvJrsbree_jDA956w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73XlywKyLL77vON5kMiJ8e17V9Yq9yCX7GxX55nixzXA&oe=6A105219"}, {"file_name": "CC_Screenshot_2560x1440_3.png", "id": "1851607025682209", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499300597_1851607029015542_1347141700245828064_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uwb3YWSHfssQ7kNvwHvwFNC&_nc_oc=AdorVUygy8f87gWVL0I-fhvkLqvcicKJY5goczsOBsBhh7vlDqbKaOJfNVd7Il1BHWM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UYmty_mDQjsgKanEhHtb9oOd1CvJNKMpgS4J_tnfqVQ&oe=6A1058CC"}, {"file_name": "CC_Screenshot_2560x1440_4.png", "id": "1002188631692863", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499347496_1002188638359529_2024822131461354903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOiV_MUftngQ7kNvwF4f2Qo&_nc_oc=Adp9yeTrcnYNGzEhtD1JUMbP2gwSx-6xuOn6vfKt06W90VgUGD0GiXvTb-3Se31mYEA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6trmeCPZfwdCX7b2fivLjb8tOL0l8Ub-Uhx2zLYjOztQ&oe=6A10783D"}, {"file_name": "CC_Screenshot_2560x1440_5.png", "id": "1377870490193650", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392057_1377870493526983_5613847404176538347_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ww_1VZ34HY8Q7kNvwF8xLnE&_nc_oc=Adr0yeLsvYQW8-0yOpB2WnpD7Mr6c3YcksEgocUNheR6ajQACqneur1ylt9dxnnwWsc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59xfUNN4TibXf9jUHUm75FRmFelsAOgjr_iY365dcPvQ&oe=6A107A9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClickClack_Store_2560x1440.png", "id": "995045572841797", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499307443_995045576175130_2666890995825443971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61ky60rJgl0Q7kNvwH_NeW5&_nc_oc=Adr4sl4qMkFUR8eWTIvB2bspJArjMgYNHkEf5oKt_nObDBACUiIk2Z_Wsyb0ZmIof_o&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W-RXSjVFQrVt5KtddJnylbffmAhbVX6QO93yO6iqg9g&oe=6A106C49"}, "display_name": "Click Clack Mixed Reality", "keywords": ["fps", "tactical", "mixedreality", "shooter"], "long_description": "CLICK CLACK MR is the first mixed reality shooter built with AI by a dev who doesn't know how to code.\n100% vibes. 10,000% fun. Zero programming. Just AI, Unity, and a wild dream.\n\nYour house is the battlefield.\nDodge, shoot, breach doors, rescue hostages, and search suspects \u2014 all inside your own real-world space.\n\nFEATURES:\n\ud83d\udfe9 Hostage Rescue \u2013 Breach, clear, and save the VIP. But beware\u2026 some enemies hide in plain sight.\n\ud83d\udfe5 Shoot-Out \u2013 Endless wave survival with \u201cDoubleTap Respawn.\u201d Be the Baba Yaga.\n\ud83c\udfaf Target Practice \u2013 Scatter targets around your space for fast-paced drills.\n\ud83e\udd86 Ducks \u2013 Yep. There are ducks. And they\u2019re in your living room. Take em out! \n\nThis is an Early Access release. Big updates coming soon:\n\u2705 Custom Map Builder\n\u2705 Local Co-Op Mode\n\u2705 More chaos, more doors to kick, more vibes\n\nBuilt with AI. Played with courage.\nTake doors.\nClickClackMR.com", "short_description": "CLICK CLACK MR is the first mixed reality shooter built with AI by a dev that doesn't know how to code! 100% Vibes. \nBreach, dodge, shoot, and survive as enemies storm your real-world space. Search suspects for weapons, rescue hostages and more!\nNo levels to load. Your room is the battlefield.\n\nThis is an Early Access release \u2014 with Map Builder and Local Co-op coming soon.\nTake Doors! "}]}, "developer_name": null, "developer_privacy_policy_url": "http://ClickClackMR.com/", "developer_terms_of_service_url": null, "publisher_name": "Lopes Media LLC", "support_website_url": "http://ClickClackMR.com/", "website_url": "http://ClickClackMR.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29551277771183510"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1405009394681922"}, {"status": "PUBLISHED", "id": "2084790648681742"}]}, "baseline_offer": {"id": "2084790648681742"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "1405009394681922"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35636955449282348", "version": "1.3.9"}, "id": "670727019172657", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35636955449282348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "hot fix for v 1.3.9\nVERSION 1.3.9\n----MINOR----\n\nADDED\nCops walking around your police office. \n\nTWEAKS\nGrab interactors on player hands. Should be much tighter grabbing. \nGrab position on c4.  \nRain. \n\nKNOWN ISSUES\n\nHeight displacement still not fully fixed\nDev is an idiot.", "created_date": 1778898468, "id": "35636955449282348", "version": "1.3.9", "version_code": 43, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35636955449282348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.9\n----MINOR----\n\nADDED\nCops walking around your police office. \n\nTWEAKS\nGrab interactors on player hands. Should be much tighter grabbing. \nGrab position on c4.  \nRain. \n\nKNOWN ISSUES\nStats tracker in hostage mode still not fixed.  \nHeight displacement still not fully fixed\nDev is an idiot.", "created_date": 1778892944, "id": "35635444459433447", "version": "1.3.9", "version_code": 42, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35636955449282348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.8\n----MINOR----\n\nADDED\n\nUI for Instructions / Legal & Error Easter egg\nAudio in Menus.\n\nTutorial Video requires input from player with computer mouse to start. \n\nREMOVED\nEnemy Reaction coding was causing unwanted animations.  Working on fixing them for return. \nLighting from Bomb mode. Will tweak and return but it was causing unwanted visual distraction\n\nTWEAKS\nMoved wrist menus to static menu for most game modes. This excludes Duck, Range and Open Space modes. \n\"Doorbell\" is now a Menu. \n\n\nATTEMPTED FIX\nSome users still reporting problems with the floor origin. Adding a floor origin check and bounceback. Hopefully. I'm having trouble with this one because it's hard for me to reproduce. Things really work for me. No joke. \n\nKNOWN ISSUES\nStats tracker in hostage mode still not fixed.  \nDev is an idiot.", "created_date": 1778793271, "id": "35605068992470994", "version": "1.3.8", "version_code": 41, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35636955449282348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.7\n----MAJOR----\n\nADDED\n\nMulti Language Support - Now supporting: Chinese, English, French, German, Italian, Japanese & Spanish.\nTranslations and alignments may be off. Report on Discord. \n\nBomb Game Mode-  Eliminate enemies, find and defuse the bomb before time runs out.  Hold Bomb for 3 seconds to defuse. \n\nAssault Rifle - AR is behind head around shoulder level. Shotgun is located in lower back. You will feel haptics. \n\nReal time lighting added to mesh in Bomb mode. This is specific for this mode as lighting is a bomb indicator. \n\nFlashlights added to all guns. Press in Right thumbstick to activate/deactivate while holding gun. Not useful and only fully operational in bomb mode, just cool. \n\nNew UI to Main Menu for game instructions/updates\n\nCoffee and donuts before a hard shift\n\nTWEAKS\nAdjusted TAC Vest placements for pistol.\nAdjusted shotgun hand front hand placement.\nEnemy AI. Enemy should react to player gun aim by ducking, shooting faster or changing position.\n\nKNOWN ISSUES\nStats tracker in hostage mode still not fixed.  \nDev is an idiot.", "created_date": 1778279694, "id": "35465629473081614", "version": "1.3.7", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35636955449282348"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.6\n----MAJOR----\n\nADDED\nNEW GAME MODES - \nThe List! Kill \"The Creeper\" and his \"Protectors\" before they hurt more innocents. \n\nGuess Who? No clear enemy NPCs, each NPC has to be cleared for weapons or eliminated, but who is the enemy?\nBoth modes are available in Room Scan and Large Open Space modes. \n\nTWEAKS\nSmoke grenades look cooler at the cost of performance per grenade. Expect stutter if you are standing on the grenade. \nEnemy AI to re position if too many shots are missed. \n\nFIXED\nLarge open space modes were not spawning NPCs throughout the map, this is fixed. \nPlayer health values to better reflect difficulty in open space modes. \n\nKNOWN ISSUES\nStats tracker in hostage mode still not fixed.  \nDev is an idiot.", "created_date": 1778128651, "id": "35422955340682361", "version": "1.3.6", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
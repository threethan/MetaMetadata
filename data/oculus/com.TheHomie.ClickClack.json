.com&_nc_ss=7f20f&oh=00_AQKuteM7I58SL7fH9YZtoLndfFhkF_A18xbi05iU9vWoEg&oe=6AAEB085"}, {"file_name": "ClickClack_Store_1440x1440.png", "id": "671588365715981", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499301458_671588369049314_5468058057492259680_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W58DSh7lKwEQ7kNvwFgpXx_&_nc_oc=Adp45fb9b_0yuYzuWZHiNjqrQLeCH3Wip7G_KVvamqS2tPT1Xfe3yAa2HWkp9gXeMQ0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb3_-He-BjGMyEyVjpAiO3GW2nuXSpiq_4IYsUGhBkXw&oe=6AAEA06B"}]}, "id": "2281273112316384", "locale": "en_US", "screenshots": [{"file_name": "CC_Screenshot_2560x1440_1.png", "id": "1260351732354635", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499349925_1260351735687968_8792305266476707694_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHY9mg_fRY0Q7kNvwEQVdq4&_nc_oc=AdpN9N3qwV9SIpQNFUB9K_50gd2vIUGGN8ogUqBZ773Qtp_wPHymZNDPNhxKDMaxmjQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOhmHRtC-kNv7iyVruwqZsSIJdQVq_pShgoY0-0-iubg&oe=6AAE7D98"}, {"file_name": "CC_Screenshot_2560x1440_2.png", "id": "1375206417075057", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391887_1375206420408390_3298375023160633184_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bk0DX1VipIYQ7kNvwEHT4XO&_nc_oc=Ado7BfwpZJaM0gczorb7z-gq9xLPSRrLFo07TvMp_9h23fecMicO_9sXi0EMSPlL3F8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeJlozsc8WAjevBZKGnHzcaf2S_tjovvKWuQxUAwTXsg&oe=6AAE8619"}, {"file_name": "CC_Screenshot_2560x1440_3.png", "id": "1851607025682209", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499300597_1851607029015542_1347141700245828064_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZWossL4gP4Q7kNvwGXk2BE&_nc_oc=AdpR35gNdQQc0Lw6ML4HaAeghhcpwETSS4XWxkPpeLgXWm5ARBejHxlwK8bQHJAk-3Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsfgaPx47Hdza5fed0-7IgPN3TW2KsZFOfhxOfLtpcSw&oe=6AAE8CCC"}, {"file_name": "CC_Screenshot_2560x1440_4.png", "id": "1002188631692863", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499347496_1002188638359529_2024822131461354903_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgDceNqG6-QQ7kNvwGmAfWd&_nc_oc=Adp0KDjWW1OOnvBtbvgpTNXo78Mr3RQ03ivm3dn_RC_7aHMPXweLzklnMhuan6pFaAU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZNf0TyQ0zTJXZvccSO447lEV-Oo5BUXGEUO8NJOuZcw&oe=6AAEAC3D"}, {"file_name": "CC_Screenshot_2560x1440_5.png", "id": "1377870490193650", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392057_1377870493526983_5613847404176538347_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-jiWi2shv0Q7kNvwESHtHP&_nc_oc=Adro0CJzpAcWgaStBTMZkDtuwY7ZQ11JK1m5yf3sb20bhraatVchrqoe9yXUS295yJU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8IkVH8mfNLdDreZ-CyW8I7R-AbIQF1-zQkxR4JnHPGA&oe=6AAEAE9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClickClack_Store_2560x1440.png", "id": "995045572841797", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307443_995045576175130_2666890995825443971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYxqWkAjDxgQ7kNvwHTyoFK&_nc_oc=AdqlCqqit6dWLz_DIlE-I1r7EfhYN0ts35hT1kcWof5rQwvscADqDlctNffedozqHxI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjtFzG2pi7LLgB2VUT4hR1cCMKnMM8rfaFVZRgWS9m0Q&oe=6AAEA049"}, "display_name": "Click Clack Mixed Reality", "keywords": ["fps", "tactical", "mixedreality", "shooter"], "long_description": "CLICK CLACK MR is the first mixed reality shooter built with AI by a dev who doesn't know how to code.\n100% vibes. 10,000% fun. Zero programming. Just AI, Unity, and a wild dream.\n\nYour house is the battlefield.\nDodge, shoot, breach doors, rescue hostages, and search suspects \u2014 all inside your own real-world space.\n\nFEATURES:\n\ud83d\udfe9 Hostage Rescue \u2013 Breach, clear, and save the VIP. But beware\u2026 some enemies hide in plain sight.\n\ud83d\udfe5 Shoot-Out \u2013 Endless wave survival with \u201cDoubleTap Respawn.\u201d Be the Baba Yaga.\n\ud83c\udfaf Target Practice \u2013 Scatter targets around your space for fast-paced drills.\n\ud83e\udd86 Ducks \u2013 Yep. There are ducks. And they\u2019re in your living room. Take em out! \n\nThis is an Early Access release. Big updates coming soon:\n\u2705 Custom Map Builder\n\u2705 Local Co-Op Mode\n\u2705 More chaos, more doors to kick, more vibes\n\nBuilt with AI. Played with courage.\nTake doors.\nClickClackMR.com", "short_description": "CLICK CLACK MR is the first mixed reality shooter built with AI by a dev that doesn't know how to code! 100% Vibes. \nBreach, dodge, shoot, and survive as enemies storm your real-world space. Search suspects for weapons, rescue hostages and more!\nNo levels to load. Your room is the battlefield.\n\nThis is an Early Access release \u2014 with Map Builder and Local Co-op coming soon.\nTake Doors! "}]}, "developer_name": null, "developer_privacy_policy_url": "http://ClickClackMR.com/", "developer_terms_of_service_url": null, "publisher_name": "Lopes Media LLC", "support_website_url": "http://ClickClackMR.com/", "website_url": "http://ClickClackMR.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29551277771183510"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1405009394681922"}, {"status": "PUBLISHED", "id": "2084790648681742"}]}, "baseline_offer": {"id": "2084790648681742"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "1405009394681922"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38448841908093674", "version": "1.3.16"}, "id": "670727019172657", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38448841908093674"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.16\n---- MAJOR ----\nFULL LIST ON DISCORD https://discord.gg/qYgWW8sSG\n\nADDED\nMap Builder: cylinders and spheres, fully editable (height/diameter, tilt)\nMap Builder: floating objects \u2014 draw tables, cabinets, light fixtures, and ceilings at any height\nMap Builder: Remove Floor tool, works like Add Floor but cuts instead\nMap Builder: full UI redesign \u2014 grouped categories, color-coded tools, Select/Deselect, Save/Load\nDrone + mini-tablet system \u2014 launch a scout drone from your backpack, track it live on a hand-held minimap of your actual room\nDrone and tablet are fully networked in co-op \u2014 each player gets their own\nMini-tablet: press trigger to rotate the map 90\u00b0, with an on-screen reminder\nNew game font throughout (Map Builder, mini-tablet)\n\nIMPROVED\nCo-op: guests can now see everything the host sees (props, enemies, imposters) at any distance \u2014 previously they'd pop in only up close\nCo-op: a guest's own room scan no longer creates phantom walls that block the host's map\nDrone: fixed enemies never showing up on the mini-tablet\nAttachment wheel: matches the new game font, sized down for a cleaner look\nCustom maps: shooting over a low or broken wall section now works correctly \u2014 no more invisible collision\nCustom maps: target practice targets now spawn on the floor where they belong, not floating near the ceiling\n\nTWEAKED\nShotgun pump-action no longer fires erratically when both hands are on it\n\nKNOWN ISSUES\nDev is an idiot, but a little less than last time.", "created_date": 1789421795, "id": "38448841908093674", "version": "1.3.16", "version_code": 50, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38448841908093674"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": null, "created_date": 1789304667, "id": "38412217341756131", "version": "1.3.15", "version_code": 49, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38448841908093674"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.14\n\n---- MAJOR----\n\nADDED\nMap Builder (in beta and very techy right now)\nCo-Op + PvP (in beta)\nTutorial\nBackpack to holster heavy weapons, frag grenade and second pistol\nFrag grenade deaths\nAttachment wheel to all weapons except shotgun\nHit reactions + stunned state to enemies\nEnemies have a chance to revive if you don't hit headshots. Double tap. \nPvP only mode with round countdown, score, timer\n\nIMPROVED\nHands across the board. No more laggy hands or hands that disconnect from the body.\nOpen space level generator prop placement. \n\nTWEAKED\nGun sounds\nTwo handed weapon interactions\n\nREMOVED\nFlashlights\n\n\nKNOWN ISSUES\nDev is an idiot.", "created_date": 1789268624, "id": "38401477679496764", "version": "1.3.14", "version_code": 48, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38448841908093674"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.13\n\n---- MAJOR----\n\nADDED\nLevel Generator Modes - Actual digital props, obstacles in your play space, procedurally arranged.  Available in Large and Small open space modes. \nFire Modes - 3 Round Burst to AR and removed single fire.  Selections are Safe/Burst/Auto, defaults to Burst.  I removed single fire bc the pistol takes care of that, wanted to make the AR different as they use same bullet damage values. \n\nIMPROVED\nEnemy AI - Enemies don't automatically know your location and just start blasting behind walls.  That being said, they are still tough but less \"cheap\".  Still trying to find a balance but the last update wasn't it. \nSmoke grenades -  Mucb better for performance and more in tune to what I want visually. Smoke will come in 2 bursts. The first will stun all enemies (as normal). Smoke is no longer transparent to enemies, the second puff of smoke is now cover from enemy vision. \n\nTWEAKED\nHands- Hands/Controllers should be better optimized for performance. Removed redundant, conflicting scripts.  Tweaked visual transforms.  Still needs work for better grab to visual transform. \nBomb Mode - Re-added mesh lighting to bomb mode. I did not improve performance issues but working on it. \nEnemy Stun animation.\n\nREMOVED\nLanguage localization-   Too many visual tweaks need to be made. Will continue to work on this but I got overzealous.\n\nKNOWN ISSUES\nStill can't use Meta recenter in Room Scan Mode. Level Generator is not perfect, placement and some mesh are still frustrating. WHY CANT I SHOOT THROUGH THAT!!! I get it.\nDev is an idiot.", "created_date": 1780618915, "id": "36117698881208000", "version": "1.3.13", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38448841908093674"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.12\n---- MAJOR----\n\nADDED\nAttachments. Suppressor, Holographic sight, micro red dot sight added to office desk and breach doors. Attachments are attachable and detachable and will survive resets in game modes.  Added to room scan and open space modes. \nNew UI to Main Menus and Breach Door. \n\nFIXED\nHand detachment issues to about 95%. \nHostage/Imposter slide movement\n\n\nKNOWN ISSUES\nSmoke grenades cause performance hiccups. \nProbably still some bugs because\nDev is an idiot", "created_date": 1779416940, "id": "35777561585221733", "version": "1.3.12", "version_code": 46, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
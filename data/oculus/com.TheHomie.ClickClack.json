zQEt-uZqWYLcxWqPosS2-ecAJvfA2exUEN4bhxo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lXuxaX4mjAseD_PcIjl8mr9A8KGzYncNW5vVIopPtyQ&oe=69F1ED7D"}, {"file_name": "CC_Screenshot_2560x1440_5.png", "id": "1377870490193650", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392057_1377870493526983_5613847404176538347_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49wcZ8RhbJMQ7kNvwFjnRZg&_nc_oc=AdotHKGE2jPAh2SWInadYyuRjkJTQHDkfYtSquSGd0JldA2DJm3lh_TXoC8nqAtTr9w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1K5QPv49iMgYXvPIKFgLeaNjwTkPagcAtCy-YWOTuh-w&oe=69F1EFDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClickClack_Store_2560x1440.png", "id": "995045572841797", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307443_995045576175130_2666890995825443971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7wmmHmphzwQ7kNvwGO1a2t&_nc_oc=AdqD9TMpXi36L4TmwpCX8W0qhtnWYfNTaxCBkCYK6AM5Yg4EQv4NzzlinS_lvX_v1sw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af18QGpo9ewbNGa9OGWXn74nNpH-3As4ZAOo3y0As-A3bA&oe=69F219C9"}, "display_name": "Click Clack Mixed Reality", "keywords": ["fps", "tactical", "mixedreality", "shooter"], "long_description": "CLICK CLACK MR is the first mixed reality shooter built with AI by a dev who doesn't know how to code.\n100% vibes. 10,000% fun. Zero programming. Just AI, Unity, and a wild dream.\n\nYour house is the battlefield.\nDodge, shoot, breach doors, rescue hostages, and search suspects \u2014 all inside your own real-world space.\n\nFEATURES:\n\ud83d\udfe9 Hostage Rescue \u2013 Breach, clear, and save the VIP. But beware\u2026 some enemies hide in plain sight.\n\ud83d\udfe5 Shoot-Out \u2013 Endless wave survival with \u201cDoubleTap Respawn.\u201d Be the Baba Yaga.\n\ud83c\udfaf Target Practice \u2013 Scatter targets around your space for fast-paced drills.\n\ud83e\udd86 Ducks \u2013 Yep. There are ducks. And they\u2019re in your living room. Take em out! \n\nThis is an Early Access release. Big updates coming soon:\n\u2705 Custom Map Builder\n\u2705 Local Co-Op Mode\n\u2705 More chaos, more doors to kick, more vibes\n\nBuilt with AI. Played with courage.\nTake doors.\nClickClackMR.com", "short_description": "CLICK CLACK MR is the first mixed reality shooter built with AI by a dev that doesn't know how to code! 100% Vibes. \nBreach, dodge, shoot, and survive as enemies storm your real-world space. Search suspects for weapons, rescue hostages and more!\nNo levels to load. Your room is the battlefield.\n\nThis is an Early Access release \u2014 with Map Builder and Local Co-op coming soon.\nTake Doors! "}]}, "developer_name": null, "developer_privacy_policy_url": "http://ClickClackMR.com/", "developer_terms_of_service_url": null, "publisher_name": "Lopes Media LLC", "support_website_url": "http://ClickClackMR.com/", "website_url": "http://ClickClackMR.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29551277771183510"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1405009394681922"}, {"status": "PUBLISHED", "id": "2084790648681742"}]}, "baseline_offer": {"id": "2084790648681742"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "1405009394681922"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35155161300795101", "version": "1.3.0"}, "id": "670727019172657", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35155161300795101"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.0\n----MAJOR----\n\nFIXED\nHand detachment bug\nRagdolls are 10000% better and satisfying. Still need to rework hostage/imposters a bit more but enemies are perfect. \n\nADDED\nMore blood!  Blood spurts from gun shot wounds and puddles the floor. \nHostage/Imposter skin randomizer. The combinations are hilarious. You never know what goes on in peoples homes. \nMore animations for hostage/imposters\nCan push open doors with gun.\n\nTWEAKS\nAdjusted tac vest colliders and placement. \nAdjusted door placement ray\nMainMenu button size\nAdjusted vest for magazine pouch and weapon placement\nHand interactions and pistol grip.\n\nUPDATED\nVRFPS Kit\nBlaze AI\nMeta SDK\n\nBACKEND\nNPCs restructured for easier customization down the road.\nUpdated VRFPS Kit, Meta SDK, Blaze AI, Unity\nNPC Skin randomizer added in 1st iteration\n\nREMOVED\nShotgun?\nWin conditions/stats need to be reworked.\nWill fix on next update. \nBullet impact/pass sounds need to be reworked\n\nFUTURE\nMore sounds.  Fix Ragdolls on Hostage/Imposters.\nMake doors less wonky, add locks and better hinges. \nMoving hostages\nLocation based gun shot reactions\nGuess Who? Game mode\nBomb Game mode\nAI adjustments\n\nKNOWN ISSUES\nSome items are in funny rotations (grenade)\nGrenade pin has visual stutter\nWeird visual gun stutter in certain positions\nDev is an idiot", "created_date": 1777064208, "id": "35155161300795101", "version": "1.3.0", "version_code": 33, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35155161300795101"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.2.9\n----HOT FIX----\n\nTEMP FIX FOR KNOWN ISSUE \nMeta v85 update and Click Clack don't like each other.  There is a chance for your hands to be disconnected from your body\nwhen you load a new scene.  If this happens hold B+Y for 3 seconds to reset you back to the Main Menu. This should reset your body. \nThis is a temp fix just so you don't have to fully reset the game.  I'm working on it. \n\nADDED\nShotgun behind your shoulders. \nShotgun shells to tac vest\nRay to menu for proper selection of game modes\n\nTWEAKS\nAdjusted tac vest colliders and placement. \nAdjusted door placement ray\nMainMenu button size", "created_date": 1770869267, "id": "33787518224226089", "version": "1.2.9", "version_code": 32, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35155161300795101"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.2.8\n----MID----\nNEW GAME MODE\n\nADDED\nBomb Defusal mode. Bomb will be randomly placed in your space. You have 30 seconds to eliminate enemies, locate and defuse the bomb. Good luck. \nThump sound when bodies hit the floor. \nMore \"lore\" and UI elements to desk. \n\nTWEAKED\nEnemy ragdolls. \nParticle systems for performance\n\nHOTFIX\nRe-applied controller tracking fix that was accidentally removed", "created_date": 1770340827, "id": "33680013298309916", "version": "1.2.8", "version_code": 31, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35155161300795101"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.2.8\n----MID----\nNEW GAME MODE\n\nADDED\nBomb Defusal mode. Bomb will be randomly placed in your space. You have 30 seconds to eliminate enemies, locate and defuse the bomb. Good luck. \nThump sound when bodies hit the floor. \nMore \"lore\" and UI elements to desk. \n\nTWEAKED\nEnemy ragdolls. \nParticle systems for performance", "created_date": 1770318342, "id": "33675484582096121", "version": "1.2.8", "version_code": 30, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35155161300795101"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.2.7\n----MINOR----\nUI OVERHAUL PT. 2\n\nADDED\nOpen Space \"Detective Desk\" with interactable desk items.\nLore and more tutorial items Desk. \n\nCHANGED\nSpawner ratios for hostage modes. \n\nFIXED\nGun tracking and placement. Gun should track better and feel better in hand.", "created_date": 1770162722, "id": "33642137235430856", "version": "1.2.7", "version_code": 29, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
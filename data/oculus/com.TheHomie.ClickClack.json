dn.com/v/t64.5771-25/473392057_1377870493526983_5613847404176538347_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKbrf4ySX5wQ7kNvwHw-J8i&_nc_oc=AdphJxlp9_ZcDk-Xa3brS6iwbvk11qRx1R1DGV7xj8BVcWyNZ-BkV-XXuR2N1yJ2NIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUrQLxrpo8Zmi1x2ZapJ1jItywMT955Nkd5ULqu5bOMg&oe=6AB5461A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ClickClack_Store_2560x1440.png", "id": "995045572841797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307443_995045576175130_2666890995825443971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dqYIwlEzKoQ7kNvwFWN3Zw&_nc_oc=AdpH_qEJSTiRq62tkdtOez0I-jh91kwodbRTAQtrvd6jhTXvj7cPH3tXF0fk0Yl-wlY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnt1C71KwdA5oI6aJent6wnEOFQwblQFF9FIKGtFNvaA&oe=6AB537C9"}, "display_name": "Click Clack Mixed Reality", "keywords": ["fps", "tactical", "mixedreality", "shooter"], "long_description": "CLICK CLACK MR is the first mixed reality shooter built with AI by a dev who doesn't know how to code.\n100% vibes. 10,000% fun. Zero programming. Just AI, Unity, and a wild dream.\n\nYour house is the battlefield.\nDodge, shoot, breach doors, rescue hostages, and search suspects \u2014 all inside your own real-world space.\n\nFEATURES:\n\ud83d\udfe9 Hostage Rescue \u2013 Breach, clear, and save the VIP. But beware\u2026 some enemies hide in plain sight.\n\ud83d\udfe5 Shoot-Out \u2013 Endless wave survival with \u201cDoubleTap Respawn.\u201d Be the Baba Yaga.\n\ud83c\udfaf Target Practice \u2013 Scatter targets around your space for fast-paced drills.\n\ud83e\udd86 Ducks \u2013 Yep. There are ducks. And they\u2019re in your living room. Take em out! \n\nThis is an Early Access release. Big updates coming soon:\n\u2705 Custom Map Builder\n\u2705 Local Co-Op Mode\n\u2705 More chaos, more doors to kick, more vibes\n\nBuilt with AI. Played with courage.\nTake doors.\nClickClackMR.com", "short_description": "CLICK CLACK MR is the first mixed reality shooter built with AI by a dev that doesn't know how to code! 100% Vibes. \nBreach, dodge, shoot, and survive as enemies storm your real-world space. Search suspects for weapons, rescue hostages and more!\nNo levels to load. Your room is the battlefield.\n\nThis is an Early Access release \u2014 with Map Builder and Local Co-op coming soon.\nTake Doors! "}]}, "developer_name": null, "developer_privacy_policy_url": "http://ClickClackMR.com/", "developer_terms_of_service_url": null, "publisher_name": "Lopes Media LLC", "support_website_url": "http://ClickClackMR.com/", "website_url": "http://ClickClackMR.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29551277771183510"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "2046363439349267"}, {"status": "PUBLISHED", "id": "1405009394681922"}, {"status": "PUBLISHED", "id": "2084790648681742"}]}, "baseline_offer": {"id": "2084790648681742"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "2046363439349267"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38526960960281768", "version": "1.3.18"}, "id": "670727019172657", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38526960960281768"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "Full patch notes on Discord. Check out www.ClickClackMR. to join\n\n1.3.18\n-----MAJOR------\n\nMAP VARIANTS\nFire + Night Mode\n\nATTACHMENTS\nLight + Laser\n\nVISOR\nNight Vision, Heat Detection and UAV display on your visor. \n\nMAP BUILDER\nNew materials, shapes + movements. \n\nNPCS\nHostages and Imposters now move, check for weapons before you shoot. \n\nCO-OP FIXES\n\nFixed the second player losing alignment after the first scene change. Custom maps and the other player's avatar now stay in place for the whole session.", "created_date": 1789671846, "id": "38526960960281768", "version": "1.3.18", "version_code": 53, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38526960960281768"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "Bug Fix for Grenades\nwww.ClickClackMR.com to join Discord to see patch notes", "created_date": 1789637286, "id": "38515504221427442", "version": "1.3.17", "version_code": 52, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38526960960281768"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "Patch notes on Discord at www.ClickClackMR.com", "created_date": 1789574806, "id": "38497463119898219", "version": "1.3.17", "version_code": 51, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38526960960281768"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": "VERSION 1.3.16\n---- MAJOR ----\nFULL LIST ON DISCORD https://discord.gg/qYgWW8sSG\n\nADDED\nMap Builder: cylinders and spheres, fully editable (height/diameter, tilt)\nMap Builder: floating objects \u2014 draw tables, cabinets, light fixtures, and ceilings at any height\nMap Builder: Remove Floor tool, works like Add Floor but cuts instead\nMap Builder: full UI redesign \u2014 grouped categories, color-coded tools, Select/Deselect, Save/Load\nDrone + mini-tablet system \u2014 launch a scout drone from your backpack, track it live on a hand-held minimap of your actual room\nDrone and tablet are fully networked in co-op \u2014 each player gets their own\nMini-tablet: press trigger to rotate the map 90\u00b0, with an on-screen reminder\nNew game font throughout (Map Builder, mini-tablet)\n\nIMPROVED\nCo-op: guests can now see everything the host sees (props, enemies, imposters) at any distance \u2014 previously they'd pop in only up close\nCo-op: a guest's own room scan no longer creates phantom walls that block the host's map\nDrone: fixed enemies never showing up on the mini-tablet\nAttachment wheel: matches the new game font, sized down for a cleaner look\nCustom maps: shooting over a low or broken wall section now works correctly \u2014 no more invisible collision\nCustom maps: target practice targets now spawn on the floor where they belong, not floating near the ceiling\n\nTWEAKED\nShotgun pump-action no longer fires erratically when both hands are on it\n\nKNOWN ISSUES\nDev is an idiot, but a little less than last time.", "created_date": 1789421795, "id": "38448841908093674", "version": "1.3.16", "version_code": 50, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29551277687850185", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38526960960281768"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "670727019172657"}]}, "change_log": null, "created_date": 1789304667, "id": "38412217341756131", "version": "1.3.15", "version_code": 49, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
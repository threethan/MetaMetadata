dset. Crie, edite, conclua e organize tarefas nas listas Pessoal, Trabalho e Estudos. Defina prazos, prioridades, etiquetas, notas e etapas; encontre itens pela busca e acompanhe o que precisa ser feito hoje, o que vem pela frente e o que j\u00e1 foi conclu\u00eddo. Programe lembretes locais e repeti\u00e7\u00f5es di\u00e1rias, em dias \u00fateis, semanais ou mensais. Seus dados ficam salvos localmente no dispositivo e n\u00e3o s\u00e3o enviados para a nuvem. A interface horizontal, com alvos grandes para toque, ajuda a navegar pela rotina com clareza. D\u00ea um passo de cada vez.", "short_description": "Organize tarefas sem sair do Meta Quest 3. Crie listas, defina prazos e lembretes, acompanhe seu progresso e avance no seu ritmo \u2014 em uma janela 2D feita para o headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bramble-jasper-0d2.notion.site/Pol-tica-de-Privacidade-Tarefou-3e64231770df80fa9c18e1d75f677035?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Allyson Athyrson", "support_website_url": null, "website_url": "https://github.com/Allyson1602", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1595476912337091"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2841750302856744"}
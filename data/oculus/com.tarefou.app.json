6XrCtqo0vtXgNRD0X5QNKbU83ry_SRqGScgbYDzJxpq7JubgRaY_PaEA527HPlUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6S4FZLQKF1VLbCLwZOBAaloH5Gnb-6JvpeTf0Qg-Xhw&oe=6AFF2914"}, {"file_name": "2026_09_24T12_47_32_000Z.png", "id": "1458394736152282", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830904_1458394739485615_3435839857593190683_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyWvYgxbXHMQ7kNvwG9ZRle&_nc_oc=Adoem0ctRUV-6n9dfja-Obs4tawkk0QemKEYraINPstzbLoCkqYfmUYsloUo7LPHCiI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFsLJnXtEdg7hxxZB8hSw0G9MPOcx8jLzQQ3EgudA0Kw&oe=6AFF2B53"}, {"file_name": "2026_09_24T12_48_36_000Z.png", "id": "2812256335836411", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491831279_2812256339169744_5497368550698685457_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouOFBRA1DSEQ7kNvwGnFhrR&_nc_oc=AdqIBXxtb3v8azgNjQLYG76URFfw3xwm4lKw_7iKmB1lmOhl9OGRCpZBtBp3DZ5smSE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsNt9Bxtcs7E7lgccvjOURZeuNqfwsrLfk7K462Qnbmw&oe=6AFF2364"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tarefou", "keywords": ["lembretes", "organiza\u00e7\u00e3o", "produtividade", "tarefas"], "long_description": "Traga sua lista de tarefas para o Meta Quest 3 com o Tarefou, um app em janela 2D pensado para usar no headset. Crie, edite, conclua e organize tarefas nas listas Pessoal, Trabalho e Estudos. Defina prazos, prioridades, etiquetas, notas e etapas; encontre itens pela busca e acompanhe o que precisa ser feito hoje, o que vem pela frente e o que j\u00e1 foi conclu\u00eddo. Programe lembretes locais e repeti\u00e7\u00f5es di\u00e1rias, em dias \u00fateis, semanais ou mensais. Seus dados ficam salvos localmente no dispositivo e n\u00e3o s\u00e3o enviados para a nuvem. A interface horizontal, com alvos grandes para toque, ajuda a navegar pela rotina com clareza. D\u00ea um passo de cada vez.", "short_description": "Organize tarefas sem sair do Meta Quest 3. Crie listas, defina prazos e lembretes, acompanhe seu progresso e avance no seu ritmo \u2014 em uma janela 2D feita para o headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bramble-jasper-0d2.notion.site/Pol-tica-de-Privacidade-Tarefou-3e64231770df80fa9c18e1d75f677035?source=copy_link", "developer_terms_of_service_url": null, "publisher_name": "Allyson Athyrson", "support_website_url": null, "website_url": "https://github.com/Allyson1602", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1595476912337091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604375581_1751597412741931_2741748829364089518_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nobkkjXrXLAQ7kNvwECcFbG&_nc_oc=AdqYUrM2-TcfoqVz0VOQ1whnaLUflunQlhFGBHhqHPKq6JKyCk0IrDYQKK52HeRZ2Xw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_Xg92KLmhjOsaR3dYuY3k3A6l7JImzeOhcyAf-bk6qA&oe=6AFF17DB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tarefou", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", 
re also able to meet new people by joining a multiplayer server and talking to them using voice chat."}]}, "developer_name": "Z3nLLC", "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-bouncersv4/home", "developer_terms_of_service_url": null, "publisher_name": "Z3nLLC", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-bouncersv4/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1235086203012533"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/673745728_1379359477369592_1756167570497354157_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPCx5CYXxtsQ7kNvwHEiTGE&_nc_oc=AdrS9jOOd9a1G4OJRYLPpiIpiVbzzrAXzX6_1oAkase0XMx02qBBfGQUuigKKeVaILc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93k8ZU9r6HCav6pV4LBlHphddEUkBucy9NXJQMiiGUPw&oe=6A36C14B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla Bouncers V4", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1780962360, "lastRevision": {"nodes": [{"id": "1235086223012531", "release_type": "SCHEDULED",
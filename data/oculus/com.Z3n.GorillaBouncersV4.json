ntrols and breathtaking graphics, \"Gorilla Bouncers V4\" delivers an exhilarating jungle experience like no other. Hop on your headsets and download our game, we promise not to disappoint!", "short_description": "Gorilla Bouncers V4 is a fun game that allows you to test a new kind of locomotion system. Experiment with the fun locomotion system and have fun! You are also able to meet new people by joining a multiplayer server and talking to them using voice chat."}]}, "developer_name": "Z3nLLC", "developer_privacy_policy_url": "https://sites.google.com/view/gorilla-bouncersv4/home", "developer_terms_of_service_url": null, "publisher_name": "Z3nLLC", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilla-bouncersv4/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1235086203012533"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673745728_1379359477369592_1756167570497354157_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNdN4YxUo60Q7kNvwGYwlvp&_nc_oc=AdpnYPpogj_bIIMDJZtuK-pLZzYK8e36qDSX2FnIpgVTArt4TbQH2GddKQL46vRGUmE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLonmlYWtzk9saoEHXpv8AcaJVatpoRTWKTD3L2KcL_A&oe=6ADDF78B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name"
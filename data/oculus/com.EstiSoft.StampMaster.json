 "id": "903454968057090", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982619_903454971390423_9075678582236878454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpLGFnT-tukQ7kNvwGX8qnb&_nc_oc=AdmwmCtQPK0xsv8STNWWBjY7vuTG71ZfTELlNe3wR_1HZcsNxTB0xwlgp8ofFJGG26s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHN9uBpJFprus_DGf5ideuJya2lbZ3JnmC5lxxn6s02w&oe=69B00AA6"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-10 035826.png", "id": "2338510103155557", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031409_2338510106488890_4069826466342518364_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-Cl84JuQlQQ7kNvwE2qh_B&_nc_oc=AdnhPf4_yO6cXtE7hzHn1GEcSXQjbIoPpswsL1N_1zgzkNPXZadmqyj-HYWlNiiwSbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1DY5-brpj2s-_h0JQTzWXQBRWkNzGsQCgHskYIKLGxw&oe=69AFFB4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-11-10 035811.png", "id": "863603102289860", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031362_863603105623193_611662570202572726_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyxaOheLlXIQ7kNvwHGZhqX&_nc_oc=AdlZq4tzEPn-waypvdTUCak3MZNaOxXNIVkqSSS_D6vGB0P_IcAMsY4mTgy-lfqG-8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrdeycN_2pGiz-y9ElNPoM-dQF4P9NI2kpCHrEbBBkhA&oe=69B01A06"}, "display_name": "Stamp Master", "keywords": ["Stamp", "Puzzle", "Casual", "Brillant", "Elite"], "long_description": "Welcome to Stamp Master, the ultimate game of speed, precision, and skill! In this immersive game, you take on the role of a stamp master tasked with stamping, sealing, and approving documents at lightning speed. With each level, the challenges grow, testing your accuracy and timing as new patterns and unique stamping requirements are introduced. Will you keep up as the pressure rises? Perfect each stamp, earn points, and unlock a collection of special stamps that bring new features and designs. But beware\u2014mistakes can cost you, and only the most skilled players will reach the top. Stamp Master combines fun, fast-paced gameplay with strategic challenges that keep you engaged and striving for perfection. Compete with friends, track your progress, and master the art of stamping in this unique and rewarding game. Dive into the fast-paced world of Stamp Master and show off your stamping prowess! Are you ready to make your mark?", "short_description": "Become the ultimate Stamp Master! In this addictive and fun game, your goal is to stamp, seal, and approve documents with precision and speed. As the levels progress, the challenges increase with complex patterns and tricky timing. Master your skills, unlock unique stamps, and rise through the ranks. Stamp Master combines reflexes and strategy, giving you the thrill of accuracy under pressure. Are you ready to become the most efficient stamper? Dive into the world of stamps and prove your skills"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/stamp-master", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes"
jXaum7J3aWjkzKtUGWqM8sWg&oe=6AA2A923"}, {"file_name": "vlcsnap-2025-02-03-17h41m43s120.png", "id": "9149230138491771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392123_9149230141825104_5810103566508950029_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXxTMyFLKJIQ7kNvwF_MUtK&_nc_oc=AdqF5Q13DQONp7JrcW1JXWp147VrOphfetDtVT_9xh1iHHaP1V0No8duoDb_eGAXORw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrzwjn7SaDGng8wKhUPKZCvBCGKwFR06s0EonwehoULA&oe=6AA2AB97"}, {"file_name": "vlcsnap-2025-02-03-17h44m37s980.png", "id": "598102189674674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393620_598102193008007_2735937038484105525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsorLJd9IDwQ7kNvwHUDNq3&_nc_oc=Adppky7wdlKaNldibH7VjJAZjdSIc1yrVSPXgiS1S_iPPJnNhlskuzCn4ZriyeHSZ8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ4qCPN4uhLOIM_XUkPv1ciOESORHBL33D0lfUE8I83A&oe=6AA2A8BC"}, {"file_name": "vlcsnap-2025-02-03-17h45m08s196.png", "id": "963346795761478", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_963346799094811_892296290153043650_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiOnukqnYOIQ7kNvwFGfF8k&_nc_oc=AdpxJn-os5P99RQMG1RX9u2kqx1phZKQCDzMHCJgD2P4k6oki5My_ttsoSCIBrvIkD4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfvALvqPDZIy2Dbc12cuZrUvsCNC-7R05CzmF9El00OQ&oe=6AA2C9C8"}, {"file_name": "vlcsnap-2025-02-03-17h40m50s433.png", "id": "635622445647915", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473398258_635622448981248_3438246790668467954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4ePtQBcuIkQ7kNvwE2Z3U8&_nc_oc=AdorCsHfFpNDb3VMa80klUU_BS-znQD4OG5uVImPkq2IyvvJRqdm1yL_LtytmcB09Es&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpG0HGAAMJMiAy_XN8TZ5y9LvD96A6wCw_VP2be-ix2g&oe=6AA2CE96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified HVAC Associate", "keywords": ["HVAC", "ImmerseLearn", "VR", "Training"], "long_description": "Certified HVAC Associate is a comprehensive VR training app designed to provide hands-on experience in HVAC fundamentals. This interactive simulation covers:\n\n- Fire Extinguisher Essentials: Learn proper handling and usage.\n- Personal Protective Equipment (PPE) \u2013 Understand safety best practices.\n- Basic Tools & Equipment: Master essential HVAC tools.\n- Copper Tubing Essentials: Explore cutting, bending, and joining techniques.\n- Refrigeration System & Refrigerator: Understand system components and operation.\n- Electrical Components & Controls: Learn wiring and troubleshooting.\n- Wiring Diagram Interpretation: Develop skills in reading and applying diagrams.\n\nTrain in a risk-free, realistic environment that enhances learning and skill retention. Whether you're an aspiring technician or an industry professional, this app prepares you for real-world HVAC scenarios. Start your training today!", "short_description": "Master essential HVAC skills in an immersive VR training experience! Certified HVAC Associate covers fire extinguisher safety, PPE, tools, copper tubing, refrigeration systems, electrical components, wiring, and more. Train in a realistic virtual environment to enhance hands-on expertise, improve safety awareness, and build a strong foundation for a successful HVAC career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT"
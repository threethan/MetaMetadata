&_nc_oc=AdpICa0V9biHcrAIjqlAsZJ4Ijl6FO-b2e612j5MvQ5hxsX45Z3Qica5p8-SKFQCcjk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s-rQrPBJ6ElBt8NiwPhWyN4Y6rRTaU32UpTWjf4uE1g&oe=69FDDD3C"}, {"file_name": "vlcsnap-2025-02-03-17h45m08s196.png", "id": "963346795761478", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391934_963346799094811_892296290153043650_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vmz5kIvGGgQ7kNvwEo89aq&_nc_oc=Ado03DvKt_DShYUvLMV07yqT0NcbTRJEA5cmGB_tzgPZfvsZ18xR1vvLkR1_Gv_TeSI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af518F3IiCx1KfsrExQA5LH-rtwnqtYnlUg3f47KsHSrKg&oe=69FDFE48"}, {"file_name": "vlcsnap-2025-02-03-17h40m50s433.png", "id": "635622445647915", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473398258_635622448981248_3438246790668467954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yI1uTwK5YCkQ7kNvwElUSNC&_nc_oc=AdopOgf92qWH25doYlu-W6srOFOJOHCUq7Cww9zJ-5AXLHFzkvMuwqP1_jKrVoJPavw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v851MPjF5Yn9HUPAluEzi3cfXsSzFnluCvMt6uG_wRQ&oe=69FE0316"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified HVAC Associate", "keywords": ["HVAC", "ImmerseLearn", "VR", "Training"], "long_description": "Certified HVAC Associate is a comprehensive VR training app designed to provide hands-on experience in HVAC fundamentals. This interactive simulation covers:\n\n- Fire Extinguisher Essentials: Learn proper handling and usage.\n- Personal Protective Equipment (PPE) \u2013 Understand safety best practices.\n- Basic Tools & Equipment: Master essential HVAC tools.\n- Copper Tubing Essentials: Explore cutting, bending, and joining techniques.\n- Refrigeration System & Refrigerator: Understand system components and operation.\n- Electrical Components & Controls: Learn wiring and troubleshooting.\n- Wiring Diagram Interpretation: Develop skills in reading and applying diagrams.\n\nTrain in a risk-free, realistic environment that enhances learning and skill retention. Whether you're an aspiring technician or an industry professional, this app prepares you for real-world HVAC scenarios. Start your training today!", "short_description": "Master essential HVAC skills in an immersive VR training experience! Certified HVAC Associate covers fire extinguisher safety, PPE, tools, copper tubing, refrigeration systems, electrical components, wiring, and more. Train in a realistic virtual environment to enhance hands-on expertise, improve safety awareness, and build a strong foundation for a successful HVAC career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8458895244210844"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1291777325442416"}]}, "baseline_offer": {"id": "1291777325442416"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742191980, "status": "PUBLISHED", "id": "1291777325442416"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25447171784956591", "ve
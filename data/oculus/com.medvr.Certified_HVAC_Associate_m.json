08s196.png", "id": "963346795761478", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391934_963346799094811_892296290153043650_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UfXqOfn50IQ7kNvwFEBw0k&_nc_oc=AdrmatVcG-qmvQr5s5VghNHKcYZFR5patKNG3l44ocF2abAspXFnOu0e7T42DYf2CvI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P5D2h5jjQ3MePp5vuCj_gJ3AWEQGbzmttloAbRjBdiQ&oe=6A355D48"}, {"file_name": "vlcsnap-2025-02-03-17h40m50s433.png", "id": "635622445647915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473398258_635622448981248_3438246790668467954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5PfKznYvt8Q7kNvwH_Ke2f&_nc_oc=AdqamJlR1CTlL159QMXvsKgvvR2I_Kyatlymnb7LcOQlUwQVQ2eD-PJ40TXoONSnkIw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xEDS5bVbhoY3MD8uliV0T9UO7JV2jTYDX8pqbpbmNTg&oe=6A356216"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified HVAC Associate", "keywords": ["HVAC", "ImmerseLearn", "VR", "Training"], "long_description": "Certified HVAC Associate is a comprehensive VR training app designed to provide hands-on experience in HVAC fundamentals. This interactive simulation covers:\n\n- Fire Extinguisher Essentials: Learn proper handling and usage.\n- Personal Protective Equipment (PPE) \u2013 Understand safety best practices.\n- Basic Tools & Equipment: Master essential HVAC tools.\n- Copper Tubing Essentials: Explore cutting, bending, and joining techniques.\n- Refrigeration System & Refrigerator: Understand system components and operation.\n- Electrical Components & Controls: Learn wiring and troubleshooting.\n- Wiring Diagram Interpretation: Develop skills in reading and applying diagrams.\n\nTrain in a risk-free, realistic environment that enhances learning and skill retention. Whether you're an aspiring technician or an industry professional, this app prepares you for real-world HVAC scenarios. Start your training today!", "short_description": "Mas
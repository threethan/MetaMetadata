ttps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392123_9149230141825104_5810103566508950029_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyMj0EpBfLYQ7kNvwGeVjwl&_nc_oc=AdobLeSUe3c6LgzQdJ7kEIVFAg_dXQYmo7HA5UyUMRqUNtyNaKM3r22A8OlIuXj3f6s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69FAYndmAQjs75775bRr5G3yS5NgG2qz48BCenw21_Yw&oe=6A0B0F17"}, {"file_name": "vlcsnap-2025-02-03-17h44m37s980.png", "id": "598102189674674", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393620_598102193008007_2735937038484105525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VleA-5Bh1MsQ7kNvwHCBHJJ&_nc_oc=AdrqD1Cjbai94vyZURM39Th_9Z9frIn2QSQzbdfd75AhSgeXev838WeSKjhmqP87RTQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UDgBRfXHb-um0hplJy7m3fywxAazxzKfMVc9QfXP1Fw&oe=6A0B0C3C"}, {"file_name": "vlcsnap-2025-02-03-17h45m08s196.png", "id": "963346795761478", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391934_963346799094811_892296290153043650_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhBQkBNmjnIQ7kNvwEaoOnb&_nc_oc=Adpc5YIagtSu46bj269zOvTatFagXKgBuFic9FcPtKXMMBu7GtclubgE8rKtjdt9GKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pHCt2B6G-uarQOwSUjHv9n2Y--5pfnXTHh3R4yeHpTQ&oe=6A0B2D48"}, {"file_name": "vlcsnap-2025-02-03-17h40m50s433.png", "id": "635622445647915", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473398258_635622448981248_3438246790668467954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-4fFDKbe5UQ7kNvwF3KQcP&_nc_oc=Ado20XTasOmVhx6UvfjUdywqmlWvefE1YtF8flV5aooK__edKnSgW3YrbFRURwt-UKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5huPUCyLLRJiUB6_7y4DR17Z9kaWwG2dcavzpPGKP71A&oe=6A0B3216"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified HVAC Associate", "keywords": ["HVAC", "ImmerseLearn", "VR", "Training"], "long_description": "Certified HVAC Associate is a comprehensive VR training app designed to provide hands-on experience in HVAC fundamentals. This interactive simulation covers:\n\n- Fire Extinguisher Essentials: Learn proper handling and usage.\n- Personal Protective Equipment (PPE) \u2013 Understand safety best practices.\n- Basic Tools & Equipment: Master essential HVAC tools.\n- Copper Tubing Essentials: Explore cutting, bending, and joining techniques.\n- Refrigeration System & Refrigerator: Understand system components and operation.\n- Electrical Components & Controls: Learn wiring and troubleshooting.\n- Wiring Diagram Interpretation: Develop skills in reading and applying diagrams.\n\nTrain in a risk-free, realistic environment that enhances learning and skill retention. Whether you're an aspiring technician or an industry professional, this app prepares you for real-world HVAC scenarios. Start your training today!", "short_description": "Master essential HVAC skills in an immersive VR training experience! Certified HVAC Associate covers fire extinguisher safety, PPE, tools, copper tubing, refrigeration systems, electrical components, wiring, and more. Train in a realistic virtual environment to enhance hands-on expertise, improve safety awareness, and build a strong foundation for a successful HVAC career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en
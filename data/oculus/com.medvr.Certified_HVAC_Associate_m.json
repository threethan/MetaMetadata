7&_nc_sid=6e7a0a&_nc_ohc=FaOEh3gnbRoQ7kNvwGG99Xy&_nc_oc=AdpaFhP7GoMOgoKtUCUDrTviiAYuzcE35NqOB3wXbtz7Y1UU21_8fiVLUTHtXeXagA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJHkRvmVxW7CpzifZ8r9KLaGkd1nTxGUNDNRm5w-6mhQ&oe=6A578617"}, {"file_name": "vlcsnap-2025-02-03-17h44m37s980.png", "id": "598102189674674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393620_598102193008007_2735937038484105525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzfZBgl1_v8Q7kNvwEXu32x&_nc_oc=Adom8wqfO724P1EPqJdbxuvhlHSrDueYsAqzwYapvPrWFDV0ZeYHF1tAoZXfUadMkRw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqO6f_oQAcPoZOtlX0dLhBJWEhi4O54szCVQHUbixH4Q&oe=6A57833C"}, {"file_name": "vlcsnap-2025-02-03-17h45m08s196.png", "id": "963346795761478", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391934_963346799094811_892296290153043650_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3c8Qf9sfU0wQ7kNvwEvsZnE&_nc_oc=Adq-ST-wgmCz9Wrt2DUl3LU2xGvIXTMx5YPBhaJ5Y-VsKXw5OntWR4mVheHRCS3gLsM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_vTAEE7HND_xPdOW3MuhZr0cPc3Kkt4PMhZHbdXGMxg&oe=6A576C08"}, {"file_name": "vlcsnap-2025-02-03-17h40m50s433.png", "id": "635622445647915", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473398258_635622448981248_3438246790668467954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdUyGH_9RDcQ7kNvwHyRGNp&_nc_oc=AdrUaAnLqzMyRdDwgjqEVS18Ent4vdMCvtiysv8-4L4KL40PngbIJVcwGkhwPebCq70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIdKY_taaRxFsC8clfN3MmAQoRDLl5DVh-dHeFYFdaHA&oe=6A5770D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified HVAC Associate", "keywords": ["HVAC", "ImmerseLearn", "VR", "Training"], "long_description": "Certified HVAC Associate is a comprehensive VR training app designed to provide hands-on experience in HVAC fundamentals. This interactive simulation covers:\n\n- Fire Extinguisher Essentials: Learn proper handling and usage.\n- Personal Protective Equipment (PPE) \u2013 Understand safety best practices.\n- Basic Tools & Equipment: Master essential HVAC tools.\n- Copper Tubing Essentials: Explore cutting, bending, and joining techniques.\n- Refrigeration System & Refrigerator: Understand system components and operation.\n- Electrical Components & Controls: Learn wiring and troubleshooting.\n- Wiring Diagram Interpretation: Develop skills in reading and applying diagrams.\n\nTrain in a risk-free, realistic environment that enhances learning and skill retention. Whether you're an aspiring technician or an industry professional, this app prepares you for real-world HVAC scenarios. Start your training today!", "short_description": "Master essential HVAC skills in an immersive VR training experience! Certified HVAC Associate covers fire extinguisher safety, PPE, tools, copper tubing, refrigeration systems, electrical components, wiring, and more. Train in a realistic virtual environment to enhance hands-on expertise, improve safety awareness, and build a strong foundation for a successful HVAC career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking
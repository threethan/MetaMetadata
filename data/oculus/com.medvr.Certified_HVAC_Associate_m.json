ttps://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473392123_9149230141825104_5810103566508950029_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7IhbEWFFDEQ7kNvwEyk6zo&_nc_oc=AdrYRTkTdroRJGRP5JVXeFHnmtljl0KIBweiSIsUz_Ml_bQAvSOZjQ8toKMS9e3p2h4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4edMXa7KvwYjCoAyXp_SJYVadIflTHTlM-VMtDz5KOBw&oe=6A105517"}, {"file_name": "vlcsnap-2025-02-03-17h44m37s980.png", "id": "598102189674674", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473393620_598102193008007_2735937038484105525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5sPNuijWB8Q7kNvwGjwLaK&_nc_oc=AdpLpie2XvTF60uMClkBlFOnw_q37XLvaFqZyLlib5d1FBCXc6nqmLgXa7DR73Izna8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kwv6cF8QQNcmeenYdwZmiKA7C3OeS9bE32Ia3jRpu5g&oe=6A10523C"}, {"file_name": "vlcsnap-2025-02-03-17h45m08s196.png", "id": "963346795761478", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391934_963346799094811_892296290153043650_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqFdfBq0xLsQ7kNvwE61svO&_nc_oc=AdqgOv1_EsqpVvF7-tIRPv9kHjVUUsWvqbUp77szJU5rlA_H7xaP5AwpyLTNG0tmgHI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ORdlNjlIBmVevHaChXHFwzvpGpnemiZp9rgl0ZHJgaQ&oe=6A107348"}, {"file_name": "vlcsnap-2025-02-03-17h40m50s433.png", "id": "635622445647915", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473398258_635622448981248_3438246790668467954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN-9C2m0RTQQ7kNvwH4Jil5&_nc_oc=AdqvqsSb9gGHqb9z_-9D0ZChV4YgArDxg51reJfTKJq3_idZyJR2jWrGJVUu0C_NGyk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jBX_40fTs_3RQKN7Cbv6puOUq-tczByD5mo8M69vszg&oe=6A107816"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified HVAC Associate", "keywords": ["HVAC", "ImmerseLearn", "VR", "Training"], "long_description": "Certified HVAC Associate is a comprehensive VR training app designed to provide hands-on experience in HVAC fundamentals. This interactive simulation covers:\n\n- Fire Extinguisher Essentials: Learn proper handling and usage.\n- Personal Protective Equipment (PPE) \u2013 Understand safety best practices.\n- Basic Tools & Equipment: Master essential HVAC tools.\n- Copper Tubing Essentials: Explore cutting, bending, and joining techniques.\n- Refrigeration System & Refrigerator: Understand system components and operation.\n- Electrical Components & Controls: Learn wiring and troubleshooting.\n- Wiring Diagram Interpretation: Develop skills in reading and applying diagrams.\n\nTrain in a risk-free, realistic environment that enhances learning and skill retention. Whether you're an aspiring technician or an industry professional, this app prepares you for real-world HVAC scenarios. Start your training today!", "short_description": "Master essential HVAC skills in an immersive VR training experience! Certified HVAC Associate covers fire extinguisher safety, PPE, tools, copper tubing, refrigeration systems, electrical components, wiring, and more. Train in a realistic virtual environment to enhance hands-on expertise, improve safety awareness, and build a strong foundation for a successful HVAC career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en
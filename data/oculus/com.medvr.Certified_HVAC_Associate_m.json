RxPbElDTNAo7n8ZcjOqK0Q3y8a2w&oe=6AA940A3"}, {"file_name": "vlcsnap-2025-02-03-17h41m43s120.png", "id": "9149230138491771", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392123_9149230141825104_5810103566508950029_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTuCMFY1Al0Q7kNvwEyMDBZ&_nc_oc=AdqgsfGcg3GRJxYSG-cC6qydpgi2foQ4zorBrRON8h4zT7FzRPJ20lL34TMXi0UeSys&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeaLtZz3-Zs81-T4fJ2oXA6JRQcSjGfMEWoSXbnN_Fbg&oe=6AA94317"}, {"file_name": "vlcsnap-2025-02-03-17h44m37s980.png", "id": "598102189674674", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393620_598102193008007_2735937038484105525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvWMscNnE4kQ7kNvwESlqGb&_nc_oc=AdrSuFf5tqO8jyoVFyRmHUzgWmqZzNLtPB-J7h55alh8NCgJEWSt8ppjq8IR2OEOZns&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJC_UN9ce2yNx-hihEZDIIMn2Yc-adZWxzbHksBXvnDQ&oe=6AA9403C"}, {"file_name": "vlcsnap-2025-02-03-17h45m08s196.png", "id": "963346795761478", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391934_963346799094811_892296290153043650_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLae0K5ykykQ7kNvwFo7T8n&_nc_oc=Adrm9n7vRpW_KiiOtAeak0jXZkXaakQj2943igH6KdA7KFAmyLrfMjtJQNBaZRYtVoM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbc2ODaJW9ZnXw47S2opj0Pbr87NHO1ICOoOsfwkiy7w&oe=6AA96148"}, {"file_name": "vlcsnap-2025-02-03-17h40m50s433.png", "id": "635622445647915", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473398258_635622448981248_3438246790668467954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQDm33no29oQ7kNvwHNWYym&_nc_oc=Adow_feFRXIxrQJCi7aSeYu-YPdzhedyhq-Ie9lu1-PBnCT6a8CIvsZFxZ5DcDxnF_U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLizSSdljoOASgo-5mbIz6s3UEujy3VIdp4Ey5cbkZYg&oe=6AA96616"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified HVAC Associate", "keywords": ["HVAC", "ImmerseLearn", "VR", "Training"], "long_description": "Certified HVAC Associate is a comprehensive VR training app designed to provide hands-on experience in HVAC fundamentals. This interactive simulation covers:\n\n- Fire Extinguisher Essentials: Learn proper handling and usage.\n- Personal Protective Equipment (PPE) \u2013 Understand safety best practices.\n- Basic Tools & Equipment: Master essential HVAC tools.\n- Copper Tubing Essentials: Explore cutting, bending, and joining techniques.\n- Refrigeration System & Refrigerator: Understand system components and operation.\n- Electrical Components & Controls: Learn wiring and troubleshooting.\n- Wiring Diagram Interpretation: Develop skills in reading and applying diagrams.\n\nTrain in a risk-free, realistic environment that enhances learning and skill retention. Whether you're an aspiring technician or an industry professional, this app prepares you for real-world HVAC scenarios. Start your training today!", "short_description": "Master essential HVAC skills in an immersive VR training experience! Certified HVAC Associate covers fire extinguisher safety, PPE, tools, copper tubing, refrigeration systems, electrical components, wiring, and more. Train in a realistic virtual environment to enhance hands-on expertise, improve safety awareness, and build a strong foundation for a successful HVAC career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOV
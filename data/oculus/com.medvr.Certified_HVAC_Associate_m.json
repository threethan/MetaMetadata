tIR6foPYD8ekJZi-eElIfIoHZ12w&oe=6AA3FAA3"}, {"file_name": "vlcsnap-2025-02-03-17h41m43s120.png", "id": "9149230138491771", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392123_9149230141825104_5810103566508950029_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXxTMyFLKJIQ7kNvwGyLut1&_nc_oc=Adq8s4-J8XYpzd8i762n-3XL12546LsG40LEUsOuGh0xzHPhYqzwATXKzyOi_pXyP7w&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtmnpbj-YauPanOW_ozBYicZbmoMyWV3BUP4Tm1EgP3g&oe=6AA3FD17"}, {"file_name": "vlcsnap-2025-02-03-17h44m37s980.png", "id": "598102189674674", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393620_598102193008007_2735937038484105525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgw6XaFw9pgQ7kNvwEaAPly&_nc_oc=Adr1Eo7p4hSblJ-dRTlie5Q0GXvZ8mjaQjQX5q1HrxjpYMf6PyICR8BWlYUCfeeP-2Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzYMWKna-sApLACi8NAe8q4zdN_nWtktH3ncuQrHLiMw&oe=6AA3FA3C"}, {"file_name": "vlcsnap-2025-02-03-17h45m08s196.png", "id": "963346795761478", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391934_963346799094811_892296290153043650_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiOnukqnYOIQ7kNvwE9crUL&_nc_oc=AdrohxYKGdlFfUJjGbOb5C0Mp6ZhIWObJnbmrcvp61Q57siv7FT3WgrRN9RWo8gbRKo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0spfXqlwCtEjHrQGQ240dvTGrplDxOmya8zCtI-4bfA&oe=6AA41B48"}, {"file_name": "vlcsnap-2025-02-03-17h40m50s433.png", "id": "635622445647915", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473398258_635622448981248_3438246790668467954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHeSzsnilisQ7kNvwEp12G9&_nc_oc=AdpuY93kqZivQ5LhAJR_CpdjJD0ZlCzLLbNlBU-GzWkVKHTgh_mQuWk6D8IGvuPuWNM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyjtqBxSQaFJmmy-_G5-JpUABNTcawGrRsQoMhqs0nJw&oe=6AA42016"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified HVAC Associate", "keywords": ["HVAC", "ImmerseLearn", "VR", "Training"], "long_description": "Certified HVAC Associate is a comprehensive VR training app designed to provide hands-on experience in HVAC fundamentals. This interactive simulation covers:\n\n- Fire Extinguisher Essentials: Learn proper handling and usage.\n- Personal Protective Equipment (PPE) \u2013 Understand safety best practices.\n- Basic Tools & Equipment: Master essential HVAC tools.\n- Copper Tubing Essentials: Explore cutting, bending, and joining techniques.\n- Refrigeration System & Refrigerator: Understand system components and operation.\n- Electrical Components & Controls: Learn wiring and troubleshooting.\n- Wiring Diagram Interpretation: Develop skills in reading and applying diagrams.\n\nTrain in a risk-free, realistic environment that enhances learning and skill retention. Whether you're an aspiring technician or an industry professional, this app prepares you for real-world HVAC scenarios. Start your training today!", "short_description": "Master essential HVAC skills in an immersive VR training experience! Certified HVAC Associate covers fire extinguisher safety, PPE, tools, copper tubing, refrigeration systems, electrical components, wiring, and more. Train in a realistic virtual environment to enhance hands-on expertise, improve safety awareness, and build a strong foundation for a successful HVAC career."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOV
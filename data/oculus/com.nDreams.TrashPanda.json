SBS67j5_HLzIAQpLBtgluEkGS7Q&oe=6999ABC1"}, {"file_name": "TRA_SC_XMAS_2560x1440_Arcade.png", "id": "787594697637039", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825257_787594700970372_9064620625178508424_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJNJS8t_LuMQ7kNvwEdmn6U&_nc_oc=AdlLXcECSJgnnt2ii2990Q8m2_1KDwQlLCey7e52xXG4JLjp9WblkXDmq-FVhEgPyLc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft5BIrPg6bAHViAHtPpo38m1qpvRc0pUFqAOGrndbXyQA&oe=6999AF64"}, {"file_name": "TRA_SC_Launch_Meta_Cooking.png", "id": "720114244381914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831382_720114247715247_1055412068435514891_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lu6d-ouemlUQ7kNvwGICDum&_nc_oc=AdkaHKCFkZ-VwPuyDXOKn4weLQVnr8KqIOKqx2wJynG6i3qV9OF90r6LbADN54SLaUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuyUtMY45rWZYhoYTCSNOybSXcSYDm0TefPHBJGLsAnOw&oe=69999DE3"}, {"file_name": "WR_Launch_store_Screenshot_01.png", "id": "906844638518643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_906844641851976_2040734056263022299_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JLeYu18p3cQ7kNvwGw3TYP&_nc_oc=AdmGPtGaFV9apQJ7jAx1xvvgzNn9cw5RaaZMM647oUFgfVxK8b1SvnSM08n6IesqMiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afux8B0UbE1rFI2fHvREte4Fs5lWsZK4WkmcqGR-MYrFJA&oe=69999828"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRA_KV_LAUNCH5_Meta-Store_16x9_LandscapeCover (1).png", "id": "824585653959865", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820141_824585657293198_8844667691705806760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8vnmTEkBv8Q7kNvwFNOKsh&_nc_oc=Adnc-5gZMxSvbYIwpif2KgF-AGKHvHDzL_vzRRAbfv29Tta-FkVtwvclxzZzHrZuZw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsDjv9xzhzIfTyqfjuDcOVaO1_lmZbxKyYRa_PtNQdubg&oe=6999AED8"}, "display_name": "Wreckin' Raccoon", "keywords": ["sandbox", "cat", "chaotic", "sim", "playground"], "long_description": "Embrace your inner trash panda and step into the paws of a mischievous raccoon as you sneak and scamper through a roadside diner in search of food and more than just a little chaos. Watch out for the grumpy chef and pesky pest controller who will try and put a stop to your mischief making.\n\n\ud83e\udd9d **You are the Raccoon** \n{1145281954424153}\n\nStep into the paws of a mischievous raccoon with a love for food and a knack for causing chaos.\n\n\ud83d\udedd **Your Personal Playground** \n{843032821806912}\n\nBecome the ultimate troublemaker as you sneak, scamper, and stir up chaos in a pitstop diner.\n\n\ud83d\udca9 **Create Maximum Mischief** \n{24920749837553105}\nBreak plates, raid the kitchen, zipline from the roof or even fry your own poop. There\u2019s no limit to the chaos you can create. Bonus points if you make the chef rage quit.\n\n\ud83d\udc4b **Interact with Everything**\n{1366963918774223}\nFrom exploding pop cans to food guns, use anything and everything in the diner to add to the mayhem.\n\n\n\n**What\u2019s new since launch**\n\nWreckin' Racoon is now in full launch!\n\nCheck out the customization update to cause chaos in style\ud83d\ude0e\n\nWhat says Christmas more than lighting everything on fire? Grab a flamethrower and spread the festive cheer\ud83d\ude02\n\nChainsaw go BRRRRRRRR! It's a Raccoon with a Chainsaw, yee-haw!\ud83e\udd20\n\nIt's the holiday season, so we've decorated the diner to celebrate! We've also added an Arcade Machine \ud83e\udd73\n\n**Full details at discord.gg/raccoonvr**\n\n\n\n\n- For reporting bugs and in-game problems, please also reach out to us on Discord  **discord.gg/raccoonvr**\n\n- **Follow us on TikTok: @wreckinraccoon**\n\n- Tag us in any of your chaos using **#wreckinraccoon** on social media!\n", "short_description": "Wreak havoc. Steal snacks. Be The Chaos."}]}, "developer_name": "nDreams Compass", "developer_privacy_policy_url": "https://ndreams.com/wreckin-raccoon-privacy-notice", "developer_ter
dMCufegd9nlAr84Ak9RwKHyc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfveWK1sx1i0-mV9d14c5df4V--fK8DVHr_bfvwiz9CZfg&oe=69A5939E"}, {"file_name": "WR_SS_2560x1440_Launch_FoodAssasination.png", "id": "1346989733691270", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827725_1346989737024603_4756553131921847071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OC9wwL4sX9AQ7kNvwG2_63F&_nc_oc=Adk-gbplTJl3XzkaxwvS6hYQ4JYzSbSWdRiz5QGvUzzv5ESBuaiScLslOxas6gj8JIs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfszpNdb3PF3OL3cuLHB3gBTGiqEq5K395Sn7dcrlrvIAg&oe=69A57ECC"}, {"file_name": "WR_SS_2560x1440_Launch_Chase.png", "id": "1494030171912401", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824611_1494030175245734_5399647611576116504_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o67Rb8EXWJQQ7kNvwHAVDF5&_nc_oc=Adncg_DLcdBWCVv3vHBquBkyny7yfs_I118Y-cjMFL_a94Z_zcwxOiQVq2CZFzWboXo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuXIolZ3gOW5nx5oVgJrePwxNDj0Y4XyrkQiGDKTh3jsQ&oe=69A58C95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRA_Meta-Store_16x9_LandscapeCover.png", "id": "1829265824640852", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827282_1829265827974185_3850226507087690629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGfPHldZRS4Q7kNvwEWpJok&_nc_oc=AdlL12St7g809RqdJYeSa4YCLFi3xZkQ5Iko_qAbqEXlwL-jPOFYzjHn84kzWg2m0KA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aftjh78e3I56qnw3KHibJndBGyhsGgSMsYqq6pn_OL_Pdw&oe=69A574A0"}, "display_name": "Wreckin' Raccoon", "keywords": ["funny", "cartoon", "sandbox", "cat", "cute"], "long_description": "Wreak havoc. Steal snacks. Be The Chaos.\n\n**You are the Raccoon**\n\nStep into the paws of a mischievous raccoon with a love for food and a knack for causing chaos.\n\n**Your Personal Playground**\n\nBecome the ultimate troublemaker as you sneak, scamper, and stir up chaos in a pitstop diner.\n\n**Create Maximum Mischief**\n\nBreak plates, raid the kitchen, zipline from the roof or even fry your own poop. There\u2019s no limit to the chaos you can create. Bonus points if you make the chef rage quit.\n\n**Interact with Everything**\n\nFrom exploding pop cans to food guns, use anything and everything in the diner to add to the mayhem.\n\n\n- Join the official Wreckin' Raccoon Discord server for community events and update info\n\n- For reporting bugs and in-game problems, please also reach out to us on Discord\n\n- **Follow us on TikTok: @wreckinraccoon**", "short_description": "Wreak havoc. Steal snacks. Be The Chaos."}]}, "developer_name": "nDreams Compass", "developer_privacy_policy_url": "https://ndreams.com/wreckin-raccoon-privacy-notice", "developer_terms_of_service_url": "https://ndreams.com/wreckin-raccoon-end-user-licensing-agreement", "publisher_name": "nDreams", "support_website_url": null, "website_url": "https://ndreams.com/games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24256161277349789"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "2073447683437429"}, {"status": "PUBLISHED", "id": "1245589360785183"}, {"status": "PUBLISHED", "id": "1961687128064926"}, {"status": "PUBLISHED", "id": "1368980881184631"}, {"status": "PUBLISHED", "id": "821118
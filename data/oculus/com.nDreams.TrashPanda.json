nS6pHFrTfaBFLW5M9X3J9C06IuqC7-ib2DUqmNDW6-NB01-T0KlB-4sEZmF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsXOZ8snAjnMnBFf3jkL1qzb-HK8VH_Br4o3eDeMOXxSg&oe=699AE9D2"}, {"file_name": "WR_SS_2560x1440_Launch_Plunger.png", "id": "1119064869665718", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830007_1119064872999051_5430629116524503082_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Kx7PhwD5eYQ7kNvwH3lX1m&_nc_oc=AdmP8cv2Q-2cS_ibkW0xV15y-4ea7PfngPVLNS6lvIH2U5XheuCBSxT5QnTKp3Rrb-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvF1OslNK4sWkFVc1yIHsdMqdYjXT5WW0tZqlVqpjXFVQ&oe=699B079E"}, {"file_name": "WR_SS_2560x1440_Launch_FoodAssasination.png", "id": "1346989733691270", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827725_1346989737024603_4756553131921847071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isosdqrwPtQQ7kNvwFmX77d&_nc_oc=Admv9ExghqcLznE5A00U3HeVHfmJqGGtPJvdJWj3XN4cONgKuVm9VvDPP30mtMTj58o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu5AB5KvJGYLqPXs5mXAHMJGmNByiE4cb1A7YeFjjOkXA&oe=699AF2CC"}, {"file_name": "WR_SS_2560x1440_Launch_Chase.png", "id": "1494030171912401", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824611_1494030175245734_5399647611576116504_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xj4xc3AH-aAQ7kNvwGb7XCl&_nc_oc=Adn73EuN5opP83RWk94w26Na7D7XuUm7rmZZ4Tp22gP9glfNCY4cgSJhgIiW3cuVeIM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftUw7AXh5ZtgqORoD9b97II6ySyH4__i8CVhD4EgI90rA&oe=699B0095"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRA_Meta-Store_16x9_LandscapeCover.png", "id": "1829265824640852", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827282_1829265827974185_3850226507087690629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REV3ErPOR6QQ7kNvwGSb-Ji&_nc_oc=AdlyNEdDVZXjukgi37FLEiIOzyDiiIZ3f_oNqLIuTsfOa3g_p7EKW_CubksjKZNeMOY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuVkS4oWRQRonJRKNWt28FYCQLtjZqNXja-o65dJjIiww&oe=699AE8A0"}, "display_name": "Wreckin' Raccoon", "keywords": ["funny", "cartoon", "sandbox", "cat", "cute"], "long_description": "Wreak havoc. Steal snacks. Be The Chaos.\n\n**You are the Raccoon**\n\nStep into the paws of a mischievous raccoon with a love for food and a knack for causing chaos.\n\n**Your Personal Playground**\n\nBecome the ultimate troublemaker as you sneak, scamper, and stir up chaos in a pitstop diner.\n\n**Create Maximum Mischief**\n\nBreak plates, raid the kitchen, zipline from the roof or even fry your own poop. There\u2019s no limit to the chaos you can create. Bonus points if you make the chef rage quit.\n\n**Interact with Everything**\n\nFrom exploding pop cans to food guns, use anything and everything in the diner to add to the mayhem.\n\n\n- Join the official Wreckin' Raccoon Discord server for community events and update info\n\n- For reporting bugs and in-game problems, please also reach out to us on Discord\n\n- **Follow us on TikTok: @wreckinraccoon**", "short_description": "Wreak havoc. Steal snacks. Be The Chaos."}]}, "developer_name": "nDreams Compass", "developer_privacy_policy_url": "https://ndreams.com/wreckin-raccoon-privacy-notice", "developer_terms_of_service_url": "https://ndreams.com/wreckin-raccoon-end-user-licensing-agreement", "publisher_name": "nDreams", "support_website_url": null, "website_url": "https://ndreams.com/games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
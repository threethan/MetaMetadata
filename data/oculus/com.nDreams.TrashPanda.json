CwJm2SssWH0t1kSKxYk-aFCkg&oe=699AFD41"}, {"file_name": "TRA_SC_XMAS_2560x1440_Arcade.png", "id": "787594697637039", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825257_787594700970372_9064620625178508424_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VNbB4ERuasQ7kNvwF1s-bS&_nc_oc=AdlU3X5kPYkrl3fm2pbbVjYU89W0Ry0LYRUOMx0mzj3Meg_AKgApGDyRuaIYtCmb03g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu9SN8bzINVtSJheO_olsf8pYsxTZkcoD4Po3DYo8rirg&oe=699B00E4"}, {"file_name": "TRA_SC_Launch_Meta_Cooking.png", "id": "720114244381914", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491831382_720114247715247_1055412068435514891_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lu6d-ouemlUQ7kNvwFFB-K6&_nc_oc=AdmUYbM0rf0w1MQaZ0UhoQACMF1CzVJXU6_2k_j3O1hfIOL3yQCLr-xGlsPrv3DcAU0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvu9iWOipKEXB5Zw5o7H-kV7S9RD2TctZ9iCCf_07-3Pg&oe=699AEF63"}, {"file_name": "WR_Launch_store_Screenshot_01.png", "id": "906844638518643", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_906844641851976_2040734056263022299_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Do9Jjr6sWuwQ7kNvwEJR37W&_nc_oc=AdlpwX8_nuV4fOwoGxyPjNMBiuOKxLMnWEhQ3kNrUTCUd4A3U-uJEEk8vkEhSEbQVd0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuIuL6mF22rbuqUM7gweL-2c9W0ESU5LH1wODdUeVcIjw&oe=699AE9A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRA_KV_LAUNCH5_Meta-Store_16x9_LandscapeCover (1).png", "id": "824585653959865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820141_824585657293198_8844667691705806760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8vnmTEkBv8Q7kNvwHQ0dqK&_nc_oc=AdkQynUPQ9Ca1c8W1GD2nvMpo6Llm88GrMV8ysC0aRYiF8TNoi93i5mrqkS39hSZR1Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv17XqWqno_lRr1lN_CEP3oHGe4j6sTSIvu_DeKkYGvow&oe=699B0058"}, "display_name": "Wreckin' Raccoon", "keywords": ["sandbox", "cat", "chaotic", "sim", "playground"], "long_description": "Embrace your inner trash panda and step into the paws of a mischievous raccoon as you sneak and scamper through a roadside diner in search of food and more than just a little chaos. Watch out for the grumpy chef and pesky pest controller who will try and put a stop to your mischief making.\n\n\ud83e\udd9d **You are the Raccoon** \n{1145281954424153}\n\nStep into the paws of a mischievous raccoon with a love for food and a knack for causing chaos.\n\n\ud83d\udedd **Your Personal Playground** \n{843032821806912}\n\nBecome the ultimate troublemaker as you sneak, scamper, and stir up chaos in a pitstop diner.\n\n\ud83d\udca9 **Create Maximum Mischief** \n{24920749837553105}\nBreak plates, raid the kitchen, zipline from the roof or even fry your own poop. There\u2019s no limit to the chaos you can create. Bonus points if you make the chef rage quit.\n\n\ud83d\udc4b **Interact with Everything**\n{1366963918774223}\nFrom exploding pop cans to food guns, use anything and everything in the diner to add to the mayhem.\n\n\n\n**What\u2019s new since launch**\n\nWreckin' Racoon is now in full launch!\n\nCheck out the customization update to cause chaos in style\ud83d\ude0e\n\nWhat says Christmas more than lighting everything on fire? Grab a flamethrower and spread the festive cheer\ud83d\ude02\n\nChainsaw go BRRRRRRRR! It's a Raccoon with a Chainsaw, yee-haw!\ud83e\udd20\n\nIt's the holiday season, so we've decorated the diner to celebrate! We've also added an Arcade Machine \ud83e\udd73\n\n**Full details at discord.gg/raccoonvr**\n\n\n\n\n- For reporting bugs and in-game problems, please also reach out to us on Discord  **discord.gg/raccoonvr**\n\n- **Follow us on TikTok: @wreckinraccoon**\n\n- Tag us in any of your chaos using **#wreckinraccoon** on social media!\n", "short_description": "Wreak havoc. Steal snacks. Be The Chaos."}]}, "developer_name": "nDreams Compass", "developer_privacy_policy_url": "https://ndreams.com/wreckin-raccoon-privacy-notice", "developer_terms
-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOK1tNykKWM1W3aVr2mvDuxnCYCWculBS35MXaINjc9g&oe=69CBB152"}, {"file_name": "WR_SS_2560x1440_Launch_Plunger.png", "id": "1119064869665718", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830007_1119064872999051_5430629116524503082_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZePZotrOakQ7kNvwHGcZqS&_nc_oc=Adrt5t3zEis-n3W56wzKyXEFWECrNJvq7ZoVbkJhcosqK7nbQs2r9DZx4l4Dl7RemRY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPzpSEOY5oGzxPbKO4quUQGmaR8DyWH1NgvJiczVqlKg&oe=69CBCF1E"}, {"file_name": "WR_SS_2560x1440_Launch_FoodAssasination.png", "id": "1346989733691270", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827725_1346989737024603_4756553131921847071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOZShhrDkR0Q7kNvwEF9DLG&_nc_oc=AdqDGkzaUQsLUKvun8eXxhnX_j0mmdazCJnAPl8VTRLGXCEVo8hBKqrGWzjAwSotvhQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnyIluxpPx3hOC3FAYnTlThf6jwktgniUbp25pLi-osQ&oe=69CBBA4C"}, {"file_name": "WR_SS_2560x1440_Launch_Chase.png", "id": "1494030171912401", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824611_1494030175245734_5399647611576116504_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXlaFJR4H3kQ7kNvwG5O-HM&_nc_oc=Ado_bvICnEQdAE1AnxPpIPwX-ra-6YkW7gCxVikOCVwJednK0zCCrzntFeGpk4bkn6Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2Ui197Zq-h7ycJ5b89Wpe82ww3e5GzAhHUuawnwXCWw&oe=69CBC815"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRA_Meta-Store_16x9_LandscapeCover.png", "id": "1829265824640852", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827282_1829265827974185_3850226507087690629_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNte_ODKEGYQ7kNvwGLFUFt&_nc_oc=AdrqUdb2o67TMIaCJ5TLGKRIGPjAB0W1SG4TESTFh73iWMn791FRt0ZUcFRaY-EKW6Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0eOsSdfkWBwJuTuSSOB33xZIHfJzTsV3p0FSzeNgpQA&oe=69CBB020"}, "display_name": "Wreckin' Raccoon", "keywords": ["funny", "cartoon", "sandbox", "cat", "cute"], "long_description": "Wreak havoc. Steal snacks. Be The Chaos.\n\n**You are the Raccoon**\n\nStep into the paws of a mischievous raccoon with a love for food and a knack for causing chaos.\n\n**Your Personal Playground**\n\nBecome the ultimate troublemaker as you sneak, scamper, and stir up chaos in a pitstop diner.\n\n**Create Maximum Mischief**\n\nBreak plates, raid the kitchen, zipline from the roof or even fry your own poop. There\u2019s no limit to the chaos you can create. Bonus points if you make the chef rage quit.\n\n**Interact with Everything**\n\nFrom exploding pop cans to food guns, use anything and everything in the diner to add to the mayhem.\n\n\n- Join the official Wreckin' Raccoon Discord server for community events and update info\n\n- For reporting bugs and in-game problems, please also reach out to us on Discord\n\n- **Follow us on TikTok: @wreckinraccoon**", "short_description": "Wreak havoc. Steal snacks. Be The Chaos."}]}, "developer_name": "nDreams Compass", "developer_privacy_policy_url": "https://ndreams.com/wreckin-raccoon-privacy-notice", "developer_terms_of_service_url": "https://ndreams.com/wreckin-raccoon-end-user-licensing-agreement", "publisher_name": "nDreams", "support_website_url": null, "website_url": "https://ndreams.com/games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
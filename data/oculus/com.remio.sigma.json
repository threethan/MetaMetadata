-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7sSxhxhFxqW2hPbc2f7OyjKKGoMf6YrPU6piyN3afxQ&oe=6AF330DC"}, {"file_name": "shot3.png", "id": "2178035599505212", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624069_2178035602838545_8926045488051028948_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvAzPvKH5xcQ7kNvwHAP6Zj&_nc_oc=AdqbEyAL_9AseY-QpTBk1N-eHaThkkO40MoALDP7U_8pjUgAQhuRWW26Qd3FSwU9EqA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS68wysRsMuVro1gnGVelTyCbgRb7TcEah3SccomOt6rw&oe=6AF33625"}, {"file_name": "shot2.png", "id": "1141633251866444", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624606_1141633255199777_9209827296852371216_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlWtWhkRRMoQ7kNvwHs1hvd&_nc_oc=Adr8vrmcHv0etrOPPktLcOr-nP2xtuHdzsidBkjiNOh1MM8EeiV8wypR9TFg7O49S6w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM48IJ7Ao7E85T5eyZ4VOG0pSGG18pC_IuBiCOGtslXw&oe=6AF32E8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Faceless Ape Corp", "keywords": ["monkey", "gorilla", "guns", "monsters", "multiplayer"], "long_description": "**FACELESS APE CORP is hiring. Together, we make survival profitable.**\n\nSuit up, grab your blaster and join your friends hostile alien worlds. Your job is simple: wipe out every creature that crawls, flies or burrows, then haul back anything valuable you can carry. FACELESS APE CORP thanks you for your service.\n\n{1090728183753167}\n\n## EXTERMINATE THE ALIEN INFESTATION\nHordes of hostile aliens stand between you and your payday. Armored spiders swarm across the floor, giant worms burst up with mouths full of teeth, and winged hunters dive from above. Keep moving, keep shooting and don't let them surround you.\n\n{3336349713240302}\n\n## YOUR PET HAS YOUR BACK\nYou never fight alone. Your loyal robot companion hovers at your side, blasting enemies while you fight. Keep it alive, level it up and watch it become a deadly partner in the field.\n\n{2305653893308005}\n\n## EXTRACT. UPGRADE. REPEAT.\nEvery mission is a chance to get richer. Extract valuables from each planet, bring them back to base and spend them at the Store to improve your gear. The more you haul, the stronger you get, and the more dangerous the planets the Corporation sends you to.\n\n{2346391292795997}\n\n## FEATURES\n- Fast, physical VR combat against swarms of alien creatures\n- A robot pet companion that fights beside you and levels up with you\n- Loot valuables and upgrade your gear between missions\n- Deploy to distant alien biomes, each more hostile than the last\n\n{1872120827087357}\n\n**Report for duty, recruit. Together, we make survival profitable.**", "short_description": "FACELESS APE CORP sends recruits like you to distant planets to exterminate hostile aliens and extract any valuables to improve your gear.\n\nUse your arms in this multiplayer shooter to travel across space station biomes. Fight back waves of small pests and team up for challenging boss battles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://facelessapecorp.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "RemioVR", "support_website_url": null, "website_url": "https://facelessapecorp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "su
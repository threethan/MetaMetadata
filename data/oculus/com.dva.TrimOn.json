ords": [], "long_description": "Trim On is a new way to learn how to sail, making sailing accessible for everyone.\n\nIn this virtual reality experience, you will learn the basics of sailing, including how to maneuver the boat in different wind and weather conditions. You will also learn how to trim the sail for different wind speeds and race around a course. ", "short_description": "Welcome to Trim On, a virtual sailing camp with World Champion sailor Lars Linger. "}, {"images": {"nodes": [{"file_name": "FinalTrimOnLogo-1024.png", "id": "1642177052874027", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75302223_1642177056207360_5612847827572532811_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kQGdl-TFtgQ7kNvwGIPytb&_nc_oc=AdqtkcRa7mKrD5A8bUSFlZdkUI9wyEPk3cJ9m4lg5cB5LqHjdC3ei3qEDRpgtKqPz4A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3xAHMPfsXNvvuUg1Xa2nrlO47EaNLHB8uTBSD5QeL3qw&oe=69F20C1E"}, {"file_name": "landscape.png", "id": "1295706801334539", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974810_1295706808001205_724905378906675555_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zl6UW-JwJoQ7kNvwEX9LOB&_nc_oc=Adq7_T4W76TL0sYrigK3qt3Ungpo9r0AD5wY2sfpvRk5S-g37drONafW8XHrjlcfNNo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3aI3qJeEkncWRF28SULoRjXl_keZehuuCyRnEF5Vg5ag&oe=69F212EA"}, {"file_name": "portrait.png", "id": "914371839657678", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75203615_914371842991011_3663834439540489973_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_iquWR2IyMQ7kNvwGTFMzF&_nc_oc=Adot_j_SnuZwP4rSe3mmrxvw6fDrgvCY2GoRz2zakFjo-g-xcKYm9RXzNkUl_0deonM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0julZV4rDI8jSA18djpJkob-0DK4s1iLL37y3hQyFOhw&oe=69F21625"}, {"file_name": "square.png", "id": "770701324760568", "image_type": "APP_I
ren Lars Linger."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.trim-on.com/Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "Trim On", "support_website_url": "https://www.trim-on.com/", "website_url": "https://www.trim-on.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1741861632890999"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031612_1446686069417971_8474295543066210836_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HMoU0OMOmsQ7kNvwHSM0pT&_nc_oc=Ado0m5SNKTqEy70HwegBwGJFTux7cKF_SEj_33HPfJsIqBGmo7qY4AUcMtZ1h4ebwM8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7mLgfRfG_ZkajxZIxenL2qxEpktbZQAMyWgUy5fgvRQ&oe=6AFB4BCD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trim On", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1686845976, "lastRevision": {"nodes": [{"id": "6219553511426063", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6219553501426064", "is_first_party": false, "enables_in_app_ads"
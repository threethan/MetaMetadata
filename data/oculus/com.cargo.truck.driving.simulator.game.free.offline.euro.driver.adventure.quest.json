34159_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyVWZFyH6UkQ7kNvwFjLnne&_nc_oc=AdoB71TymRPbGMh4tWl40OeD4ffo4bUkEs8xUbCaJ90Ay1db0IlT7zm2BnCQz7Bgw2c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQXFdaUVjcaks3MxSgofift_on3ZKHGmgwljZ_nFpXDw&oe=6AEB3BD8"}, {"file_name": "4.png", "id": "320487627203618", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974575_320487630536951_1086995296708962057_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-u2UGggx-cEQ7kNvwEWuMjZ&_nc_oc=AdpOcZHGZfblDhA5LnNBwXzJspnIaOnBQLPLrOxEzR1_AHTWbTjStuhiomaqSuyfsKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUGH3bnT7iLITEepmrdAe0RJuWO_WGNwNRgRUfWXzCTA&oe=6AEB4B23"}, {"file_name": "5.png", "id": "1510625539684698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974558_1510625543018031_275209904781023883_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bpdtGQYQtAQ7kNvwG5ic7C&_nc_oc=AdqUIN_S4AUHwYo_Y9idyP7MYH3KOYG5qf69_mEyov6bdet2FQdH9tnwE7q-yP1Kpuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZHDi3WEZwvWVGo0yGVuco7SWfzGf707um77cOMebkNA&oe=6AEB47A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Truck Simulator - Truck Driving Game", "keywords": [], "long_description": "Welcome to the ultimate Side Quest Virtual Reality Truck Parking Game and Industrial Cargo Transporting experience! Get ready to immerse yourself as a VR truck driver in virtual world of trucking like never before, all from the comfort of your VR headset. The VR road is waits, and the cargo can't wait to reach its destination.\n\nSide Quest VR Truck Parking Features:\n- Feel the virtual power as you rev engine and hit the open road.\n- Explore diverse terrains from bustling city streets to challenging mountain roads.\n- Transport valuable cargo across the map while delivering goods to different locations.\n- Take on mind-bending parking challenges that require finesse and precision.\n- Unlock a fleet of trucks, each with its own unique characteristics and handling.\n- Immerse yourself in stunning VR graphics and physics that recreate the roar of an engine.\n- Team up with truck drivers from around the world to complete missions in multiplayer mode.\n- Be alert as you encounter various obstacles and unexpected events.\n- Earn rewards and rise through the ranks as you complete missions from rookie to expert.\n- Explore a variety of beautifully crafted environments, from vibrant cityscapes to tranquil landscapes.\n\nVR Truck Parking Game Availability:\nWaiting time is over,  put on your VR headset, buckle up, and prepare to embark for VR truck driving journey through the world of cargo transportation and truck parking. Whether you are a pro driver or a newcomer, Side Quest's VR Truck Parking G", "short_description": "Get ready for the great truck driving adventure in Side Quest's Virtual Reality Truck Parking Game! Step into the driver's seat, navigate diverse terrains, and tackle truck parking challenges in outstanding VR environments. With realistic graphics, dynamic obstacles, and endless exploration, it's the ultimate truck parking experience in virtual reality world. Strap in and hit the VR road today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulipapps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "suppor
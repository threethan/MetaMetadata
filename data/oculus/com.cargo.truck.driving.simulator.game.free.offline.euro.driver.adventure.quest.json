 []}, "id": "7559855800707827"}, "id": "217313031074689"}]}}, "binary": null, "live_binary": null, "created_date": 1721646501, "id": "8780819615278100", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "8780820371944691"}, "release_status": "RELEASED", "id": "7431374663555942"}, "id": "8780820371944691", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7431374663555942", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1023382558809730"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1673192386750867", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Truck Simulator - Juego de conducci\u00f3n de camiones", "keywords": [], "long_description": "\u00a1Bienvenido al mejor juego de estacionamiento de camiones en realidad virtual Side Quest y a la experiencia de transporte de carga industrial! Prep\u00e1rese para sumergirse como camionero de realidad virtual en el mundo virtual del transporte por carretera como nunca antes, todo desde la comodidad de sus auriculares de realidad virtual. El camino de la realidad virtual espera y la carga no puede esperar a llegar a su destino.\n\nCaracter\u00edsticas del estacionamiento de camiones Side Quest VR:\n- Siente el poder virtual mientras aceleras el motor y sales a la carretera.\n- Explora diversos terrenos, desde las bulliciosas calles de la ciudad hasta desafiantes caminos de monta\u00f1a.\n- Transporte carga valiosa por el mapa mientras entrega mercanc\u00edas a diferentes ubicaciones.\n- Afronta desaf\u00edos de estacionamiento alucinantes que requieren delicadeza y precisi\u00f3n.\n- Desbloquea una flota de camiones, cada uno con sus propias caracter\u00edsticas y manejo \u00fanicos.\n- Sum\u00e9rgete en impresionantes gr\u00e1ficos y f\u00edsicas de realidad virtual que recrean el rugido de un motor.\n- Forma equipo con camioneros de todo el mundo para completar misiones en el modo multijugador.\n\nDisponibilidad del juego VR Truck Parking:\nEl tiempo de espera ha terminado, p\u00f3ngase sus auriculares de realidad virtual, abr\u00f3chese el cintur\u00f3n y prep\u00e1rese para embarcarse en un viaje de conducci\u00f3n de camiones de realidad virtual a trav\u00e9s del mundo del transporte de carga y el estacionamiento de camiones.", "short_description": "\u00a1Prep\u00e1rate para la gran aventura de conducci\u00f3n de camiones en el juego de estacionamiento de camiones en realidad virtual de Side Quest! Ponte al volante, recorre diversos terrenos y enfr\u00e9ntate a desaf\u00edos de estacionamiento de camiones en entornos de realidad virtual excepcionales. Con gr\u00e1ficos realistas, obst\u00e1culos din\u00e1micos y exploraci\u00f3n sin fin, es la mejor experiencia de estacionamiento de camiones en el mundo de la realidad virtual."}, {"images": {"nodes": []}, "id": "860497775953649", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Truck Simulator - Juego de conducci\u00f3n de camiones", "keywords": [], "long_description": "\u00a1Bienvenido al mejor juego de estacionamiento de camiones en realidad virtual Side Quest y a la experiencia de transporte de carga industrial! Prep\u00e1rese para sumergirse como camionero de realidad virtual en el mundo virtual del transporte por carretera como nunca antes, todo desde la comodidad de sus auriculares de realidad virtual. El camino de la realidad virtual espera y la carga no puede esperar a llegar a su destino.\n\nCaracter\u00edsticas del estacionamiento de camiones Side Quest VR:\n- Siente el poder virtual mientras aceleras el motor y sales a la carretera.\n- Explora diversos terrenos, desde las bulliciosas calles de la ciudad hasta desafiantes caminos de monta\u00f1a.\n- Transporte carga valiosa por el mapa mientras entrega mercanc\u00edas a diferentes ubicaciones.\n- Afronta desaf\u00edos de estacionamiento alucinantes que requieren delicadeza y precisi\u00f3n.\n- Desbloquea una flota de camiones, cada uno con sus propias caracter\u00edsticas y manejo \u00fanicos.\n- Sum\u00e9rgete en impresionantes gr\u00e1ficos y f\u00edsicas de realidad virtual que recrean el rugido de un motor.\n- Forma equipo con camioneros de todo el mundo para completar misiones en el modo multijugador.\n\nDisponibilidad del juego VR Truck Parking:\nEl tiempo de espera ha terminado, p\u00f3ngase sus auriculares de realidad virtual, abr\u00f3chese el cintur\u00f3n y prep\u00e1rese para embarcarse en un viaje de conducci\u00f3n de camiones de realidad virtual a trav\u00e9s del mundo del transporte de carga y el estacionamiento de camiones.", "short_description": "\u00a1Prep\u00e1rate para la gran aventura de conducci\u00f3n de camiones en el juego de estacionamiento de camiones en realidad virtual de Side Quest! Ponte al volante, recorre diversos terrenos y enfr\u00e9ntate a desaf\u00edos de estacionamiento de camiones en entornos de realidad virtual excepcionales. Con gr\u00e1ficos realistas, obst\u00e1culos din\u00e1micos y exploraci\u00f3n sin fin, es la mejor experiencia de estacionamiento de camiones en el mundo de la realidad virtual."}, {"images": {"nodes": [{"file_name": "WithOUT UI.png", "id": "6964490900249781", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982457_6964490906916447_9001163385522397245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHW2pOkBepoQ7kNvwE3KkdK&_nc_oc=AdrKR8hluI0a1obp4ImJmb7a1DLvZTWqBiT1TT04Ix8eLeUc_Y317Kmotnp05M2M24o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f2
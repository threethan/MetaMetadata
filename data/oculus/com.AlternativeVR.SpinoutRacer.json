_Af8xGyQOJOATDJmcPiHAvgEGpStwm3vfeWlYXD0ZuNqDnQ&oe=6A43E915"}]}, "id": "1409918743423997", "locale": "en_US", "screenshots": [{"file_name": "Level_01_028_0022.png", "id": "1107418904244521", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303971_1107418907577854_4180029967409918722_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0RMdrm523UQ7kNvwHGFOt0&_nc_oc=AdrlHd8RwiiZyp5YhwqR-7q05QLwYBTiVduj6tAN3Ph2gwUsUVLa8fXXmOBFSjn3z10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZbhufziqdH0ZrMw0TwopVZKFztHUucaIYT_VDWQgqEg&oe=6A43DD85"}, {"file_name": "Level_02_001_0000.png", "id": "1502541550907771", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307339_1502541554241104_3731233789548938405_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ymM7P10la8Q7kNvwFYH15R&_nc_oc=Adq5eXbiRa9bKzNbiWp9BEicnwjc_gx2eEeyYJkhCpuZOeucIBq7lOV1BDAi33oO5-M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-61biZbHDzCneO-np9EpmvnKCCspRJzi7wmIuMw-G9-Q&oe=6A43B8C1"}, {"file_name": "Level_03_020_0000.png", "id": "745420644776294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823943_745420648109627_8193416977504675729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WCcGQ5tAk8Q7kNvwEfvKnR&_nc_oc=Adp2zqcyHXE-c0Z5tjlKXpTQrkdY_9uXSliNPqJDYspG4uBovwa6jFtt4SiIyGqUexk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HOQ8CgwKC8nf_55Gl9-UXHXx6dSCuWg13m2MOGNI-lQ&oe=6A43C24C"}, {"file_name": "Level_04_001_0000.png", "id": "3180320208799334", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307931_3180320212132667_6699985375180928753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHe0uV0qG2kQ7kNvwEUJTJm&_nc_oc=AdrKVETuBrzQHWNjBA9NAvM95pK3B3M7SO-q9dM1IxRBFr841Byt4l-zkHQ_r1TTED4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G9vSgTs38VYOzNnsNLy-myIZNMoqmpceHipp4obCwow&oe=6A43BAAA"}, {"file_name": "Level_04_002_0000.png", "id": "711518745220296", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305027_711518748553629_5598252149491871329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2l-PViZz6IQ7kNvwHPQ3Ai&_nc_oc=AdrkglL_YsL7vrhiFoXaqlD2GNodebzEI8NtYyOxHvV3Zo-j_kG6T57C1mIvW5qBq1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s033594SAj6rrp0hmdX5RVBziPvw6U_76qh-dxXX55g&oe=6A43D112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "M_Image.png", "id": "2705628192968776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820141_2705628196302109_7845722753997328030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAPlVhQiI2sQ7kNvwHd5RUa&_nc_oc=Adow_EBdiZdaJ6kiHmIoerbpksqlaPEoNshXaw7BCeoj7u-digPz1gAOFGVpTq9wEs8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u-W6rk3xUQI9Kc2MRVFB6DxpBTunckL5IEsSoqCL0nw&oe=6A43EC2B"}, "display_name": "Spinout Racer", "keywords": ["Track", "Racing", "Speed", "Car"], "long_description": "Spinout Racer brings high-speed arcade racing into VR with a playful twist. Instead of ordinary racetracks, you\u2019ll find yourself competing in extraordinary locations, each designed to surprise and challenge you.\n\nStart with the Skyline Circuit, a simple yet fast-paced course set inside an office \u2013 the perfect place to learn the basics and test your first cars. Move on to the Dino Circuit, where you\u2019ll race through prehistoric landscapes surrounded by towering dinosaurs. Keep your focus as you push the limits on the Rooftop Circuit, drifting across the tops of skyscrapers while enjoying breathtaking city views. Finally, shrink down to toy size in the Tiny Racers Circuit, weaving around a giant teddy bear, a crib, and playful toys in a child\u2019s bedroom.\n\nAlong the way, you can purchase new cars, each with its own unique style and performance, giving you fresh ways to master the circuits. Whether you\u2019re chasing victory against AI opponents or simply enjoying the thrill of these unusual tracks, Spinout Racer offers a racing experience that is fast, fun, and full of surprises.\n\nAre you ready to become the ultimate Spinout Racer?", "short_description": "Spinout Racer is a VR arcade racing game where you collect cars and race through incredible tracks. Speed through an office on the Skyline Circuit, dodge dinosaurs on the Dino Circuit, drift across skyscraper rooftops, and shrink down for the Tiny Racers Circuit inside a child\u2019s bedroom full of toys."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24670428495884094"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1303058328701333"}, {"status": "PUBLISHED", "id": "2162394054617847"}, {"status": "PUBLISHED", "id": "1745414780238226"}, {"status": "PUBLISHED", "id": "1232668878524531"}, {"status": "PUBLISHED", "id": "732230546027998"}, {"status": "PUBLISHED", "id": "1525707318564673"}, {"status": "PUBLISHED", "id": "4009304475996322"}, {"status": "CANCELLED", "id": "1150264527151300"}, {"status": "PUBLISHED", "id": "1632695750662611"}]}, "baseline_offer
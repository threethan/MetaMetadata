_AQMzdzqFEc12UkgRVJnW9TZXTHV4mGILqF_KEjuZGpargw&oe=6AC91095"}]}, "id": "1409918743423997", "locale": "en_US", "screenshots": [{"file_name": "Level_01_028_0022.png", "id": "1107418904244521", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303971_1107418907577854_4180029967409918722_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G88MpR4KjU4Q7kNvwGqxMZ4&_nc_oc=AdpidaBNGLMdtoKN4C3M0MzUgVr5HcQkuHvozDZu2HwnU_Vd8tfnokuhwiZbatvpoAw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgCklm8uGMoxTKnsTivdQFYvuDCZCQIl-puXlPTFgx0A&oe=6AC90505"}, {"file_name": "Level_02_001_0000.png", "id": "1502541550907771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307339_1502541554241104_3731233789548938405_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCSnTLwZ7XIQ7kNvwGEc6N9&_nc_oc=AdqInmzdj_7rfgEaqt2c5C0ZCHvzLVuvRXXqov1Y6Ok3tbDIJ7P8wjDsDnDXO3bXgf8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2XqqSw22TFJKeJ1z-y3D-JU9ZorOGHn9jGApx3FOUdw&oe=6AC91881"}, {"file_name": "Level_03_020_0000.png", "id": "745420644776294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823943_745420648109627_8193416977504675729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCS13kfknaAQ7kNvwH0U6Wc&_nc_oc=Adp-DfPyAyc6PfO4eGfEPuDGFR7DG2__1etHumJacKcUBpAR37hW-5erhqeiYyL1XBY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3taiwunDdEn5X7fP7oAbEO0__FiDHqBxvWnD6peiZDw&oe=6AC8E9CC"}, {"file_name": "Level_04_001_0000.png", "id": "3180320208799334", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307931_3180320212132667_6699985375180928753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BTt_BgVbEwQ7kNvwFkzF_X&_nc_oc=Adp6JyRYtromF9muSmCz0jD8x8OB7p0Q7jgToWpHEMgluZ42dtnrXZY-dSl0CRm4-WA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE0uSwwVeti0QsmbhGPVOqjcyLpnz82scghGG1TXntYQ&oe=6AC91A6A"}, {"file_name": "Level_04_002_0000.png", "id": "711518745220296", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305027_711518748553629_5598252149491871329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AlzdT6POZQQ7kNvwHMWhTt&_nc_oc=AdqPDjEpE76Jjf9Fm0lXCgR__gvYF-CCug8VpaOljLmZEzkwZJO7uSvsnjgUunzD08A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4ocTvnHEMvTu-90naXOGJcuLzJowgHywUE0uoR5_nSg&oe=6AC8F892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "M_Image.png", "id": "2705628192968776", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820141_2705628196302109_7845722753997328030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFZfczvjGmgQ7kNvwGdA2xE&_nc_oc=AdrMZMmVUZeh2cKIUe-N6wcDhnhHzRC2xbcxX5pOdLs_uTIl9-S06tLJj2g8taIdhZI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNih6JoXImHBpsEqRS5N7NNQcpHQXiaZqJHRM1-tY8HrA&oe=6AC913AB"}, "display_name": "Spinout Racer", "keywords": ["Track", "Racing", "Speed", "Car"], "long_description": "Spinout Racer brings high-speed arcade racing into VR with a playful twist. Instead of ordinary racetracks, you\u2019ll find yourself competing in extraordinary locations, each designed to surprise and challenge you.\n\nStart with the Skyline Circuit, a simple yet fast-paced course set inside an office \u2013 the perfect place to learn the basics and test your first cars. Move on to the Dino Circuit, where you\u2019ll race through prehistoric landscapes surrounded by towering dinosaurs. Keep your focus as you push the limits on the Rooftop Circuit, drifting across the tops of skyscrapers while enjoying breathtaking city views. Finally, shrink down to toy size in the Tiny Racers Circuit, weaving around a giant teddy bear, a crib, and playful toys in a child\u2019s bedroom.\n\nAlong the way, you can purchase new cars, each with its own unique style and performance, giving you fresh ways to master the circuits. Whether you\u2019re chasing victory against AI opponents or simply enjoying the thrill of these unusual tracks, Spinout Racer offers a racing experience that is fast, fun, and full of surprises.\n\nAre you ready to become the ultimate Spinout Racer?", "short_description": "Spinout Racer is a VR arcade racing game where you collect cars and race through incredible tracks. Speed through an office on the Skyline Circuit, dodge dinosaurs on the Dino Circuit, drift across skyscraper rooftops, and shrink down for the Tiny Racers Circuit inside a child\u2019s bedroom full of toys."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24670428495884094"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1303058328701333"}, {"status": "PUBLISHED", "id": "2162394054617847"}, {"status": "PUBLISHED", "id": "1745414780238226"}, {"status": "PUBLISHED", "id": "1232668878524531"}, {"status": "PUBLISHED", "id": "732230546027998"}, {"status": "PUBLISHED", "id": "1525707318564673"}, {"status": "PUBLISHED", "id": "4009304475996322"}, {"status": "CANCELLED", "id": "1150264527151300"}, {"status": "PUBLISHED", "id": "1632695750662611"}]}, "baseline_offer
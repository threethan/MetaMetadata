_AQIrdqmQvqDRcCPGkcKsakgt0jvh5md2peTc-gY16NejXw&oe=6AA14B55"}]}, "id": "1409918743423997", "locale": "en_US", "screenshots": [{"file_name": "Level_01_028_0022.png", "id": "1107418904244521", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303971_1107418907577854_4180029967409918722_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaELJkeSC90Q7kNvwHEPgsL&_nc_oc=AdpnxWOc9mGkGZjert3Qxv3iPHDLWKSTwESSgH2trwVFXWBPxMIDvynoUmtgv3t1qTE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4urjXw5ii5WiNkXoxQKmBHbmewgUVpbB8qObblQnhFw&oe=6AA17805"}, {"file_name": "Level_02_001_0000.png", "id": "1502541550907771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307339_1502541554241104_3731233789548938405_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ay7_2gmvod8Q7kNvwEm3O-e&_nc_oc=Adofv5aG4AlE6y7m-d1F-p6nITOP7iWfqHrFAQNnJz3EGgVoiIndJZiOhCRWbvtElTo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfbfgLINA3g4IQ9oy60pAEJOBNn53H3Yc3AViZtsUaEQ&oe=6AA15341"}, {"file_name": "Level_03_020_0000.png", "id": "745420644776294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823943_745420648109627_8193416977504675729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mG7tRkH1akQ7kNvwHl6_p-&_nc_oc=AdqILrhX-bHPYXUU_JAMF2tONLVZYhoMK8pMADXZoIXZgPrMK4BQZhFD39XG5gxvQTw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz3dc9F99sjZXkCLx6-0Zvw_KyL4O0mRf5WXYsC8epQg&oe=6AA15CCC"}, {"file_name": "Level_04_001_0000.png", "id": "3180320208799334", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307931_3180320212132667_6699985375180928753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ_4LZlXY-4Q7kNvwGXpich&_nc_oc=AdrRH97AS2xTJ05TsklHMN4CLYN59aPVU5RaY-0bSuATMXsdgDQW5hqM7oZmQ7I4w3U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9tPNFZKqDhr5ZLR9isfFcdilbQlZOWxMWrrRpbuXpVA&oe=6AA1552A"}, {"file_name": "Level_04_002_0000.png", "id": "711518745220296", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305027_711518748553629_5598252149491871329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZM-tKOfX-gQ7kNvwG2vvsN&_nc_oc=AdoNyDR2SnOsG9mzqUKmfxe0Y-_iYYRClGLprXqBkD-kgoDXwmcM1hyKy10PjAHt8JQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK3UGwyweUL_B05bkOTHLoVMBGfOdkRv6cZVOACyplug&oe=6AA16B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "M_Image.png", "id": "2705628192968776", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820141_2705628196302109_7845722753997328030_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OM6L9ZEL70wQ7kNvwF78rqo&_nc_oc=AdquVsMIMPrPZJRGl2leJjLMwdztU7gIW2oH-vqe9zNtGk4lr_b6lBhaZaHcQBproGQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0btEv_dD7RP-Q7vM0ZZTJBOfK2zSx1O9_siXXuZe0LA&oe=6AA14E6B"}, "display_name": "Spinout Racer", "keywords": ["Track", "Racing", "Speed", "Car"], "long_description": "Spinout Racer brings high-speed arcade racing into VR with a playful twist. Instead of ordinary racetracks, you\u2019ll find yourself competing in extraordinary locations, each designed to surprise and challenge you.\n\nStart with the Skyline Circuit, a simple yet fast-paced course set inside an office \u2013 the perfect place to learn the basics and test your first cars. Move on to the Dino Circuit, where you\u2019ll race through prehistoric landscapes surrounded by towering dinosaurs. Keep your focus as you push the limits on the Rooftop Circuit, drifting across the tops of skyscrapers while enjoying breathtaking city views. Finally, shrink down to toy size in the Tiny Racers Circuit, weaving around a giant teddy bear, a crib, and playful toys in a child\u2019s bedroom.\n\nAlong the way, you can purchase new cars, each with its own unique style and performance, giving you fresh ways to master the circuits. Whether you\u2019re chasing victory against AI opponents or simply enjoying the thrill of these unusual tracks, Spinout Racer offers a racing experience that is fast, fun, and full of surprises.\n\nAre you ready to become the ultimate Spinout Racer?", "short_description": "Spinout Racer is a VR arcade racing game where you collect cars and race through incredible tracks. Speed through an office on the Skyline Circuit, dodge dinosaurs on the Dino Circuit, drift across skyscraper rooftops, and shrink down for the Tiny Racers Circuit inside a child\u2019s bedroom full of toys."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24670428495884094"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1303058328701333"}, {"status": "PUBLISHED", "id": "2162394054617847"}, {"status": "PUBLISHED", "id": "1745414780238226"}, {"status": "PUBLISHED", "id": "1232668878524531"}, {"status": "PUBLISHED", "id": "732230546027998"}, {"status": "PUBLISHED", "id": "1525707318564673"}, {"status": "PUBLISHED", "id": "4009304475996322"}, {"status": "CANCELLED", "id": "1150264527151300"}, {"status": "PUBLISHED", "id": "1632695750662611"}]}, "baseline_offer
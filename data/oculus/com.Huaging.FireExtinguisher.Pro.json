&_nc_oc=Adrsa_EWkxkCTdNLrZsrs-kn_Y51w4tWNvGBU0k3gQDMGG_xsqbg-9CxWeu-wCN4P4g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTbGSmmpcGG1Fhydx2ANS18I9iv5Jl1o65rlc93vZ0mw&oe=6AA166C2"}, {"file_name": "\u6392\u884c\u699c\u767b\u8a18.png", "id": "1498489307961852", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822952_1498489311295185_1967479435804117443_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cscWc0OHUcwQ7kNvwHMdqUZ&_nc_oc=Ado6NCc6qUFgGP7-cz62XOZUrXPH2zzFVBQ1qI2_VLiUvqRejlw6B5Zfs4dSrhZCwRE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVZvHL0Ni3dMd4VGU4gVlJmgp4QVbcFZWJL5agoBpdgw&oe=6AA14832"}, {"file_name": "\u6392\u884c\u699cList.png", "id": "1111057621170387", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821952_1111057624503720_5738018721817672512_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uIgpQDHAkgQ7kNvwEnposi&_nc_oc=AdoDbJbVXURMG2mlfzAIk5YWNysvTZ7PLN4-jqTgAMFiCiHj_o4TrmPK8L2r4dnsfNU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoMhDL10KWwsYSfjWdukUlLuAXvXUiIZxkurz_q6A07A&oe=6AA16D3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FireSwift: VR Fire Extinguisher Training", "keywords": ["fire", "extinguisher", "training", "simulation", "firesafety"], "long_description": "# Fire can\u2019t be replayed \u2014 training prevents disasters!\nDownload now to sharpen your reaction speed and skills in a virtual fire scene, and become the first line of defense in real emergencies!\n\n**Key Features:**\n\n- \ud83d\udd90 Realistic Hand Gestures: Pull, aim, squeeze, and spray \u2014 follow the full extinguisher procedure.\n- \ud83c\udf0f Multi-Language Support: Multiple language options for global training needs.\n- \ud83d\udcda Professional Training Guidance: From tutorials to test mode, master extinguisher use and learn to choose the right type (CO\u2082, dry powder, water).\n- \ud83d\udd25 Multiple Fire Scenarios: Train in realistic environments such as apartments and high-rise buildings.\n- \u23f0 Timed Challenge Mode: Race against the clock to test your reaction and accuracy.\n- \ud83c\udfc6 Global Leaderboard: Compete worldwide for the top firefighting performance and accuracy.\n\n**\ud83d\udca1 Notes:**\n\nThis product includes an online leaderboard. A stable internet connection is recommended for the best ranking experience.\n\nFor questions or partnership opportunities, please feel free to contact us.\n\n\ud83d\udce9 contact us:\nhuagingofficial@gmail.com", "short_description": "\ud83d\udd25Fire Can\u2019t Be Replayed \u2014 Training Prevents Disasters!\nExperience realistic fire extinguisher training with hand gestures in a virtual fire scene. Pull, aim, squeeze, and spray while competing in timed challenges and global leaderboards!"}, {"images": {"nodes": [{"file_name": "Landscape_TW.png", "id": "2246971505738074", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820566_2246971509071407_2504519871756657520_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zagtdX-FI2oQ7kNvwGLcsDA&_nc_oc=AdoYf6OE2MntrWoq4_Wnva_DSLIlBpXRUJXAC0-_xralnxv2xvqUsZEIgqpV3ckmfYs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcaM1N6N1ubfKie7hXnMPpQ4-x07fCaqWIVZ7ok7uJkw&oe=6AA15A9B"}, {"file_name": "GestureExtinguisherLogo_Icon_Foreground_TW.png", "id": "1449573723035877", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821799_1449573726369210_5925664253148186976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnZz2zk9yu0Q7kNvwEDuUjb&_nc_oc=AdrHuOR9-eP35qHfvEmtuEVoJ-8vJqihwBTL2aIQ6AdADL5S4KSdkR4reG0EPhVELOs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLaNB-M1oHFg66gd4szt1qs2jjFDlv-vC_y81wzjZpGQ&oe=6AA174EF"}, {"file_name": "Cube_TW.png", "id": "1287879339460408", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/49182
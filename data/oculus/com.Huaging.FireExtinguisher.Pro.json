&_nc_oc=AdqrjgqEeme4qwGLOhs5-dLxn1tmN9m_vaR6A--IaE9t9NamriQ-O15r7Cm8NIbVwtE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFX7u5HCfh5PjxxUCONJOk7wZkdLG9oohS7d7OmM3AKQ&oe=6AA2B842"}, {"file_name": "\u6392\u884c\u699c\u767b\u8a18.png", "id": "1498489307961852", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822952_1498489311295185_1967479435804117443_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6vTWuzZbcgQ7kNvwG963c4&_nc_oc=Adp93FkJwnn7W54Vq6G6O_ZjD4HRzN30YD_qPCTT4Lqcjbk2D87b02KedhaYrlPWihc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMPxPmoxysOSlG44gaUygrA58Cz3v3KRQuyc3Zq7AgKA&oe=6AA299B2"}, {"file_name": "\u6392\u884c\u699cList.png", "id": "1111057621170387", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821952_1111057624503720_5738018721817672512_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWxkph0IlJEQ7kNvwFurnSu&_nc_oc=AdpRmAGlSLtG_Qd4ptwu8LW7MIAqOHESww8f6e4FDGPGG9kvGM02RF4B84Gb9H2-BC0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVnb4degQY9Y5KuCyf7uWWMsw3qxe6dGApDbXrvzYhoQ&oe=6AA2BEBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FireSwift: VR Fire Extinguisher Training", "keywords": ["fire", "extinguisher", "training", "simulation", "firesafety"], "long_description": "# Fire can\u2019t be replayed \u2014 training prevents disasters!\nDownload now to sharpen your reaction speed and skills in a virtual fire scene, and become the first line of defense in real emergencies!\n\n**Key Features:**\n\n- \ud83d\udd90 Realistic Hand Gestures: Pull, aim, squeeze, and spray \u2014 follow the full extinguisher procedure.\n- \ud83c\udf0f Multi-Language Support: Multiple language options for global training needs.\n- \ud83d\udcda Professional Training Guidance: From tutorials to test mode, master extinguisher use and learn to choose the right type (CO\u2082, dry powder, water).\n- \ud83d\udd25 Multiple Fire Scenarios: Train in realistic environments such as apartments and high-rise buildings.\n- \u23f0 Timed Challenge Mode: Race against the clock to test your reaction and accuracy.\n- \ud83c\udfc6 Global Leaderboard: Compete worldwide for the top firefighting performance and accuracy.\n\n**\ud83d\udca1 Notes:**\n\nThis product includes an online leaderboard. A stable internet connection is recommended for the best ranking experience.\n\nFor questions or partnership opportunities, please feel free to contact us.\n\n\ud83d\udce9 contact us:\nhuagingofficial@gmail.com", "short_description": "\ud83d\udd25Fire Can\u2019t Be Replayed \u2014 Training Prevents Disasters!\nExperience realistic fire extinguisher training with hand gestures in a virtual fire scene. Pull, aim, squeeze, and spray while competing in timed challenges and global leaderboards!"}, {"images": {"nodes": [{"file_name": "Landscape_TW.png", "id": "2246971505738074", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820566_2246971509071407_2504519871756657520_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zagtdX-FI2oQ7kNvwEeIysR&_nc_oc=AdpaBVhkX04xDCDpKsMV9xetKRR5HsdE-ms6P20GIBWctxil6NdG-6mvtCj2ZpSXsp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtUUpD8ec3EjS_anXYjrmtGwPvAulqMesSrDgj4g9mgA&oe=6AA2AC1B"}, {"file_name": "GestureExtinguisherLogo_Icon_Foreground_TW.png", "id": "1449573723035877", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821799_1449573726369210_5925664253148186976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnZz2zk9yu0Q7kNvwFwcgRU&_nc_oc=Adok2TDb3fv__IkzKsXTCDic8Asclp36rkJZ_CN2GEdvCDefRWX0_un4sMuAK0OIQ0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAkzTzM9I3cBzwx2O2EddOXaBW-V6po46l1wEXdIVWYg&oe=6AA2C66F"}, {"file_name": "Cube_TW.png", "id": "1287879339460408", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/49182
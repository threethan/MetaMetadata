34021783141888_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVos2BWt_h0Q7kNvwGCxfoF&_nc_oc=AdqQNTikwY3vmE1FOYEoa-iP440JuDp7Ah8lNVNde3i7Ylzt7NxneGUYx9U-v6DtnOE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW6KMjyd7ZlNljuDKBOX630SRJk7_ofZ2syGbOCpkMWw&oe=6B085232"}, "display_name": "Monkey Mayhem", "keywords": [], "long_description": "Monkey Mayhem is a multiplayer VR game for Meta Quest 1/2 or pro. There are multiple maps such as Forest and Beach map (Soon). The best part is there is a custom username system. Explore the map(s) with friends in this hangout like game! This game is heavily inspired by gorilla tag. \n\nThis game is not affiliated with Gorilla Tag or Another Axiom LLC and is not endorsed or otherwise sponsored by Another Axiom LLC. Portions of the materials contained herein are property of Another Axiom LLC. \u00a92022 Another Axiom LLC.", "short_description": "This game has unique locomotion where you play as a monkey and run around alone or with friends. What more would you need other then to be a free monkey!?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/calebplayzgamez/Monkey-Mayhem-Privacy-Policy/main/FrostyDoggoVR.txt", "developer_terms_of_service_url": null, "publisher_name": "FrostyDoggoVR", "support_website_url": null, "website_url": "https://www.youtube.com/@FrostyDoggo/videos", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "
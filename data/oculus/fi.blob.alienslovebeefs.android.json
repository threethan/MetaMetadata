kg3cyRe8pA2fA14ptfhWCZ81F1qH6QuY8b01g6DTPSX-UrlYPElGL1ajQbOb_z80Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3AaOeVA-D6aGCx0ln7fvTQMlolly3y2tMb2eaVK19hQ&oe=69B2A17A"}, "display_name": "Aliens Love Beefs", "keywords": [], "long_description": "# Aliens are hungry and they would LOVE to bite some tasty Beef.\n\nAbduct the Beefs on each planet, while avoiding missiles, explosions and lasers. Casual indie Virtual Reality game using cool spherical gravity game mechanics.\n\n**Current episodes (6 levels on each):**\n- Episode 1 - Beef Regular\n- Episode 2 - Beef Evolution (Small, Medium, Large, XL)\n- Episode 3 - Beef in Chili Sauce\n- Episode 4 - Beef BBQ\n\n**Leaderboards!** (per episode / total game score)\n\nBlob Lab is a small single person indie game studio. Please support my work!", "short_description": "Aliens are hungry and they would LOVE to bite some tasty Beef.\n\nAbduct the Beefs on each planet, while avoiding missiles, explosions and lasers. Indie Virtual Reality game using cool spherical gravity game mechanics.\n\nCurrent episodes (6 levels on each):\n- Episode 1 - Beef Regular\n- Episode 2 - Beef Evolution (S/M/L/XL)\n- Episode 3 - Beef in Chili Sauce\n- Episode 4 - Beef BBQ\n\nLeaderboards! (per episode + total score)\n\nBlob Lab is a small single person indie game studio. Please support my work!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blob.fi/netti/alb/ALB_Privacy_Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Blob Lab", "support_website_url": null, "website_url": "https://www.blob.fi/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_gr
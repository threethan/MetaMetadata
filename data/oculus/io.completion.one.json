31408_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qk-0p999r9YQ7kNvwHnhRMa&_nc_oc=Adqx0sf0vjgzV06Q8wA47rcFn_FDYdekuXA5JWe4JpzsO_TxLsv-EAvG-4zZOwUNJM8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7ehPGNkp7YXLseHu9od8KJ82E-0t4SxwJSPPFJaDDCg&oe=6AAEA222"}, {"file_name": "screenshot2.png", "id": "1384986248661902", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001667_1384986255328568_1337755954686437533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9KW_fWkRgAQ7kNvwG8o5p9&_nc_oc=AdqPsBNT_7xwE0f7hrOaBu9PyrJUiRxx7G8xTJfs6RhrOI8xPoDPaQAUvJabddKOvaI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv4HTCSvPxIbePDQFzcEbC52h2PvU_o4yjcnBAwe7iIA&oe=6AAEB09A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "775034610582140", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/43931334_775034613915473_3603160377056272763_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUbC5kXizbQQ7kNvwHtOTUW&_nc_oc=AdomF5OuSAErii69NtjcLKdb01JO2BDMTnF4zEu0YiKJSmshk7TH61LD0fEpmosidbs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITeJd6mjwg9WHI1wD7__hyK67DYCp8MEuq6BMJrwG9Zw&oe=6AAE9275"}, "display_name": "Completion", "keywords": [], "long_description": "Completion is a platform for spaces that nurture fulfillment.\n\nCompletion redefines transformative art using 360\u00b0 fractal experiences that induce a state of wonder and awe. \n\nThe Completion experiences have been curated in collaboration with the best fractal and music artists to create incredible visual universes with corresponding soundscapes that elevate each experience.\n\nWe are on a quest for a more balanced, harmonious and empathetic world where you can empower yourselves and others; a place where community is at the core of this metaverse movement for transformative experiences.\n\nThe Completion App includes :\n\n- 1 FREE 5MIN EXPERIENCE\nWhich you can try to get a feel for power of the Completion experiences.\n\n\n- 1 PAID 10MIN EXPERIENCE\nFor everyone who is not into NFTs there is an incredible experience that you access with your Oculus payment.\n\n- 3 TRAILERS FOR THE NFT EXPERIENCES\nTo get a glimps of the 3 full experiences requiring our NFTs to access.\n\nComing Soon : \n\n\n- 3 EXCLUSIVE", "short_description": "Completion is a platform for spaces that nurture fulfillment.\n\nCompletion redefines transformative art using 360\u00b0 fractal experiences inducing a state of wonder and awe. \n\nThe Completion experiences have been curated in collaboration with the best fractal and music artists to create incredible visual universes with corresponding soundscapes that elevate each experience.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://completion.one/", "developer_terms_of_service_url": "http://completion.one/legal", "publisher_name": "Completion", "support_website_url": null, "website_url": "http://completion.one/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "716581202780158"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8650330981746127
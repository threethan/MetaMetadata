8617031920_3633179649839142930_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5liKxjul0T8Q7kNvwHFY0CH&_nc_oc=AdlP9rO6Pjqx2JyMt9DtmSIWWxlpgmyRdwH5MgPlvJbEXe1DhmW1CUj9KZ6Nk6kdOB4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft4jkGwX4jGOOnQ9pkLD0Pl1OkAyDhfutI4uwXJPDLuOw&oe=69A58433"}, {"file_name": "screenshot3.png", "id": "5432778516779422", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982708_5432778526779421_5801614786847331408_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzgqjkKpkaQQ7kNvwG_sMLk&_nc_oc=AdkJz66Y-tYvh62v8bR4CYreVCLYXwL-i0CaBkgMdlssGkAcaPrgIblJB20nKJ4A67Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu1UFbnFLvM8n8kpLN0IVAQubViUMFEq2q5Z0IAuBS_UA&oe=69A56C62"}, {"file_name": "screenshot2.png", "id": "1384986248661902", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001667_1384986255328568_1337755954686437533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3GuDgriYNwQ7kNvwFeBSAw&_nc_oc=AdlEPVUoBTeEMF8UfZB1-0bhTt72VnWIc5lXhFA5Veh0PexW2WKiWpEYWwDcBeLkksE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft5eLknLMDnKnL8sw1kBcwRBr2IW5N-l2s7jkVVmVu_cQ&oe=69A57ADA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2022-09-07 at 16.33.29.png", "id": "1780164955664047", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86646352_1780164958997380_1314327246187457407_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsjNpKRRhFgQ7kNvwEDaan7&_nc_oc=AdnPXKqG6yfw_2FZKdnXw3m7mm-rrvuQZTn21xrQ59NFh0KxXg4ZAdIZAZl-BlkocFs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvmICWX0LG-Ge_RRIOkstorGglleDBSWImIaK7BX4QeWA&oe=69A59BD6"}, "display_name": "Completion", "keywords": [], "long_description": "Welcome to a new category of leisure experience.\n\nCompletion is a platform for 10-minute visual journeys to help neurodivergent children with calm and concentration.\n\nCreated by some of the world's best visual artists and musicians, Completion takes you through a range of beautiful sensory experiences that are helpful for challenges related to stress and anxiety.\n\nFor more information about the effects of Completion, and to get full access, visit completion.one\n\n*Note that the files are too large to stream on most connections, so you have to download them to get a proper experience.", "short_description": "Welcome to a new category of leisure experience.\n\nCompletion is the VR platform for transformative art, based on 10 minute fractal journeys that are both entertaining and empowering.\n\nCreated by the worlds best visual artists and musicians, Completion is helpful for letting go of stress and limiting narratives, while increasing empathy, creativity, and self-esteem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://completion.one/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Completion", "support_website_url": null, "website_url": "http://completion.one/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6507899929252835"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75340706_612049107146661_47012193401840122_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1J4YlKaCBa0Q7kNvwEPkvDm&_nc_oc=AdkL6t0SykkHuXvb_VVArCN6HHD
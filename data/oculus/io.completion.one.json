8617031920_3633179649839142930_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=we3Wk65W10IQ7kNvwGJu0eh&_nc_oc=AdmK4Hi8Zw2DeiOsOoqfsfqcsyyR3lIDkyLXz82VxOLOxbYwVrBIt9xEnfGT4tWJ9HA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv_yWFw-0-F4fh5QKKz9n5lE1ExYbDhTj2mNWluz7c1bg&oe=6999A6B3"}, {"file_name": "screenshot3.png", "id": "5432778516779422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_5432778526779421_5801614786847331408_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSRX0AzHntkQ7kNvwH7jqwb&_nc_oc=AdmuacdETR3pqV3V-QGRprnCIz2HFV2hw8gtOvq9ctjvNLjXDNfPG4Pga0Mm3QkJs7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftlYOwsVjl3zTFiWq0h52_mMXqhQPt6MdUfhbWJjqzUlQ&oe=69998EE2"}, {"file_name": "screenshot2.png", "id": "1384986248661902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001667_1384986255328568_1337755954686437533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoF3-5aMjvQQ7kNvwFMCoXm&_nc_oc=AdkRTIdImpsS2LybujfUuy-51h82kxjgpYRkh6XHqzzogPIWGsyBPjz5ZJk9fhaczsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsL-bhlRT920zYXk8IOiksQQZvB6VfBz0ZFWzjUuVlzNA&oe=69999D5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2022-09-07 at 16.33.29.png", "id": "1780164955664047", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86646352_1780164958997380_1314327246187457407_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7biOtReLu3cQ7kNvwH6KLEu&_nc_oc=AdnWT0mK8Jj7PqWjJ9c6VfMlY4AnkILllLkhedtuSm4qnHL8eHZF-icXGoyXoJa0GyI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftz7J3Plob1WRagmWnyk9-QaULhSi26BDnt4Qyu_x2Egg&oe=6999BE56"}, "display_name": "Completion", "keywords": [], "long_description": "Welcome to a new category of leisure experience.\n\nCompletion is a platform for 10-minute visual journeys to help neurodivergent children with calm and concentration.\n\nCreated by some of the world's best visual artists and musicians, Completion takes you through a range of beautiful sensory experiences that are helpful for challenges related to stress and anxiety.\n\nFor more information about the effects of Completion, and to get full access, visit completion.one\n\n*Note that the files are too large to stream on most connections, so you have to download them to get a proper experience.", "short_description": "Welcome to a new category of leisure experience.\n\nCompletion is the VR platform for transformative art, based on 10 minute fractal journeys that are both entertaining and empowering.\n\nCreated by the worlds best visual artists and musicians, Completion is helpful for letting go of stress and limiting narratives, while increasing empathy, creativity, and self-esteem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://completion.one/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Completion", "support_website_url": null, "website_url": "http://completion.one/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6507899929252835"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75340706_612049107146661_47012193401840122_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKDy3fS9lrkQ7kNvwFkrl5m&_nc_oc=Admt02ge9LHrN4WqCpws5nGE6UK
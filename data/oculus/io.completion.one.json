reenshot4.png", "id": "3299158603698588", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031359_3299158617031920_3633179649839142930_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cw85ca7baXoQ7kNvwEYbNOM&_nc_oc=AdpnV8ZodEWc6jxpF1LrNHjpVhpWUj5rJ6dG2toa45Ot6c6zzp4ILhSSnwM-XH67_xs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOj8S_WSJOuTp2_gnrr7AMYoOgMejlE1rWSjQS3aZmJA&oe=6A5A21B3"}, {"file_name": "screenshot3.png", "id": "5432778516779422", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982708_5432778526779421_5801614786847331408_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VVhd37R2awQ7kNvwFgB9AZ&_nc_oc=Ado4uTwHFdVsUjrDxeXZCiChstqLn3fqjsY7r-IpI64ebefLlZA9H4v6f6w-c-OyI3c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBB8PyEH-qADykEbFJnHJYFGi-cH8tC7ozJk4bVvP9gJA&oe=6A5A4222"}, {"file_name": "screenshot2.png", "id": "1384986248661902", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001667_1384986255328568_1337755954686437533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNoH5I-ENVgQ7kNvwG0vb_m&_nc_oc=Adr1CvvbmtFKjZNrCM3csqS6prp7eV6s9wn_GY_GJiQpwN-wJreKmgns1eZE9j-EmGk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxe1sAaA52m6qaPaqKadjQdP5XzsE6kVvX9GnF0XloqA&oe=6A5A185A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2022-09-07 at 16.33.29.png", "id": "1780164955664047", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86646352_1780164958997380_1314327246187457407_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CKdDicvPWYQ7kNvwHMABmW&_nc_oc=AdpZ3AxY8bdHUmyvJ0mpyqA_WdAXe2FaE6ytixQueazr72bMuwpZcB3tpMkI1J8gNe4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkgPhlGB_2klEhfidb4WJ27G55NJ6SL-XrSAdhf5Js5Q&oe=6A5A3956"}, "display_name": "Completion", "keywords": [], "long_description": "Welcome to a new category of leisure experience.\n\nCompletion is a platform for 10-minute visual journeys to help neurodivergent children with calm and concentration.\n\nCreated by some of the world's best visual artists and musicians, Completion takes you through a range of beautiful sensory experiences that are helpful for challenges related to stress and anxiety.\n\nFor more information about the effects of Completion, and to get full access, visit completion.one\n\n*Note that the files are too large to stream on most connections, so you have to download them to get a proper experience.", "short_description": "Welcome to a new category of leisure experience.\n\nCompletion is the VR platform for transformative art, based on 10 minute fractal journeys that are both entertaining and empowering.\n\nCreated by the worlds best visual artists and musicians, Completion is helpful for letting go of stress and limiting narratives, while increasing empathy, creativity, and self-esteem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://completion.one/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Completion", "support_website_url": null, "website_url": "http://completion.one/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6507899929252835"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75
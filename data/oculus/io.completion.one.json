reenshot4.png", "id": "3299158603698588", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031359_3299158617031920_3633179649839142930_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jf4pMH9GpgQ7kNvwE9SrBj&_nc_oc=Adq81bDI1h7YEkBjD0Zt_eNkcOUy0W4nmcCJrEqf79B9znil_tzhLwQCbYpSwIr1HAI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ciNRaG3zyIFUkjM3Jzp-uIWoHXKJBcKoa7kBuaHAvQQ&oe=6A12F0B3"}, {"file_name": "screenshot3.png", "id": "5432778516779422", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982708_5432778526779421_5801614786847331408_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loM4dq8vqx8Q7kNvwFrbvG1&_nc_oc=AdohFFOAIGWi0tPJta_Yr0kKO9C3Ar7GgdzA-GWz2qcBxiVt1gwtdGDJuNJ54ekqSCo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-nKOnfszbVKt0WdUxDML62KW0EA8Ci6buR7rSNnFyvQ&oe=6A131122"}, {"file_name": "screenshot2.png", "id": "1384986248661902", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001667_1384986255328568_1337755954686437533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWniJ15qIHYQ7kNvwEF-qkn&_nc_oc=AdoY3uPL1R8usdc3JzJqm8xy-CggOiF262Ta86lyxM-OuJr1VtJQV8dzWiVdqXL_ElM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ll5b9M_jYU_a7Q7ZYf02m-TPGhZulvBCvgAfAkdY7rg&oe=6A131F9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2022-09-07 at 16.33.29.png", "id": "1780164955664047", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/86646352_1780164958997380_1314327246187457407_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kiU1KHdm7oQ7kNvwFpqUyh&_nc_oc=AdqDlhUIyHTKYzNKv2t4b-vlrWQ57uyzqGd8Gwdp6VGfmixfA3WkpOXRFcrSsi4VFg0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-p5ZJxayWw5-8PHqfb120uUB3Z5yamk9fR74yzsoT_g&oe=6A130856"}, "display_name": "Completion", "keywords": [], "long_description": "Welcome to a new category of leisure experience.\n\nCompletion is a platform for 10-minute visual journeys to help neurodivergent children with calm and concentration.\n\nCreated by some of the world's best visual artists and musicians, Completion takes you through a range of beautiful sensory experiences that are helpful for challenges related to stress and anxiety.\n\nFor more information about the effects of Completion, and to get full access, visit completion.one\n\n*Note that the files are too large to stream on most connections, so you have to download them to get a proper experience.", "short_description": "Welcome to a new category of leisure experience.\n\nCompletion is the VR platform for transformative art, based on 10 minute fractal journeys that are both entertaining and empowering.\n\nCreated by the worlds best visual artists and musicians, Completion is helpful for letting go of stress and limiting narratives, while increasing empathy, creativity, and self-esteem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://completion.one/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Completion", "support_website_url": null, "website_url": "http://completion.one/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6507899929252835"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75
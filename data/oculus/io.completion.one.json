reenshot4.png", "id": "3299158603698588", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031359_3299158617031920_3633179649839142930_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0E4fbqsGaj8Q7kNvwEQvHWb&_nc_oc=AdrUqxDBQRvHXuRc0LHI_zn-5PpB8NYMSa3DRv_WVx_1iK7Huj-UN6y-5D-yY_mLhyg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgdORLFz-wxXm14NY1s_pFJFGEXMJVZkXDUW0kb3bZPQ&oe=6AAD3033"}, {"file_name": "screenshot3.png", "id": "5432778516779422", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982708_5432778526779421_5801614786847331408_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftPOKV_5weQQ7kNvwG1qWMy&_nc_oc=AdpM7EWYFrFRcHdRmXXSx7G6rpr0JVHnLteSIIU8PX8Dt3KVJry0jr1a61Lj7v8h3Os&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOKWnDd-pfrsjvBw_1UK31ngG-_1gjriod-H9gOyk_AQ&oe=6AAD50A2"}, {"file_name": "screenshot2.png", "id": "1384986248661902", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001667_1384986255328568_1337755954686437533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9KW_fWkRgAQ7kNvwHiFvex&_nc_oc=AdrHxDkuaO9nRTkF-9BuBnFfgpxr84T_Np81Mke8HI8n9Gmf3nQ_-ehRma6ut4h5ck0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZSRWdwVpGxbGaBu5FU9cSXDXr3FM9uYMvY_faqDb56Q&oe=6AAD5F1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2022-09-07 at 16.33.29.png", "id": "1780164955664047", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86646352_1780164958997380_1314327246187457407_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4T5KikxTWdcQ7kNvwHqfcwB&_nc_oc=AdoTMi7QKt-eCIy7oM3aOZcscETz0PejiJNb5QK9y-JV0bHfSJZ7WNY_vohY5xCWi-M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItEqMSqBI917AKP3YhfxxP81PhYdEGw9_z2dfNa4OF0w&oe=6AAD47D6"}, "display_name": "Completion", "keywords": [], "long_description": "Welcome to a new category of leisure experience.\n\nCompletion is a platform for 10-minute visual journeys to help neurodivergent children with calm and concentration.\n\nCreated by some of the world's best visual artists and musicians, Completion takes you through a range of beautiful sensory experiences that are helpful for challenges related to stress and anxiety.\n\nFor more information about the effects of Completion, and to get full access, visit completion.one\n\n*Note that the files are too large to stream on most connections, so you have to download them to get a proper experience.", "short_description": "Welcome to a new category of leisure experience.\n\nCompletion is the VR platform for transformative art, based on 10 minute fractal journeys that are both entertaining and empowering.\n\nCreated by the worlds best visual artists and musicians, Completion is helpful for letting go of stress and limiting narratives, while increasing empathy, creativity, and self-esteem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://completion.one/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Completion", "support_website_url": null, "website_url": "http://completion.one/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6507899929252835"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75
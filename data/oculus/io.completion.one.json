reenshot4.png", "id": "3299158603698588", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031359_3299158617031920_3633179649839142930_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7M1KQvzNdpcQ7kNvwFLpxHB&_nc_oc=Adqvj8bKHqHqxCdZ9W10qy89Vl098f72-DS2r87EBADDisbHp1SiDY0hT_hKpoGWSJw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTGIQ5AeeT48d2vg76zTCbS5qoyQvlYmUvApxpBNAf0Q&oe=6A747FB3"}, {"file_name": "screenshot3.png", "id": "5432778516779422", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982708_5432778526779421_5801614786847331408_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fL-p68Mn_TEQ7kNvwE-4v2W&_nc_oc=AdpDC7x2p_hivGAnbNXBQku531U4EgmZpa8OdKIoIkJMJrC8Bx3j9UvWWhkevhmrZ44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY36euvR99gWso8bkDzAxm1oky5v1zp54tAkcUdONYjg&oe=6A74A022"}, {"file_name": "screenshot2.png", "id": "1384986248661902", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001667_1384986255328568_1337755954686437533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QcQ7uANJqIQ7kNvwG5GLsD&_nc_oc=Ado0tzuCul9bfwXXlv41nSDR9xP1sN_tx4Mer9UUHvk7oioG7KQpOi3ua7Z2PrEPtKE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHutJStr3k-cOW2LuP49MpD_mG3FbPaR6o8s4sfrlKvIw&oe=6A74765A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2022-09-07 at 16.33.29.png", "id": "1780164955664047", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86646352_1780164958997380_1314327246187457407_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yY6KHJaeiMQ7kNvwHluLR2&_nc_oc=AdphDqYN6Ewc4bNbSJin2aDm_5He6_BeDi9QzsPnV4Ayz6gEbX7p7K_pDyB2sI9Gj4o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZEx9f5lAldfu5ZLX0EvKFwr5QQoMF3gOOcKWogrZwKQ&oe=6A749756"}, "display_name": "Completion", "keywords": [], "long_description": "Welcome to a new category of leisure experience.\n\nCompletion is a platform for 10-minute visual journeys to help neurodivergent children with calm and concentration.\n\nCreated by some of the world's best visual artists and musicians, Completion takes you through a range of beautiful sensory experiences that are helpful for challenges related to stress and anxiety.\n\nFor more information about the effects of Completion, and to get full access, visit completion.one\n\n*Note that the files are too large to stream on most connections, so you have to download them to get a proper experience.", "short_description": "Welcome to a new category of leisure experience.\n\nCompletion is the VR platform for transformative art, based on 10 minute fractal journeys that are both entertaining and empowering.\n\nCreated by the worlds best visual artists and musicians, Completion is helpful for letting go of stress and limiting narratives, while increasing empathy, creativity, and self-esteem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://completion.one/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Completion", "support_website_url": null, "website_url": "http://completion.one/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6507899929252835"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75
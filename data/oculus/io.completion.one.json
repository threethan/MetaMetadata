588", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031359_3299158617031920_3633179649839142930_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wLu1XfAAfAQ7kNvwFt2nEj&_nc_oc=AdnoCFLgYMUwYEwnG8_wTxBOGgo97TYO3u_pjhjQr3shCCBhW-jiF2Fmw6_yVZWS22Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9aFnc68WrRPm2YOkswQZuEOu3MzaIQyD-Q-iHnrpW9w&oe=69B01033"}, {"file_name": "screenshot3.png", "id": "5432778516779422", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_5432778526779421_5801614786847331408_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q26LXJ-9e8YQ7kNvwGxeo4I&_nc_oc=AdmLwFF-ALHcGXThfsqWDtF_HH5b4imE9Au9cG8xeqPXXUqSq6TDY_hPxK05qWyU4JU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3dDCuEhIoOYXZBbyIrRNDV8jR3SuJh9gPpZ6_QJr1Jw&oe=69AFF862"}, {"file_name": "screenshot2.png", "id": "1384986248661902", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001667_1384986255328568_1337755954686437533_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8k1JfjMlmoQ7kNvwELVU8l&_nc_oc=Adnb0Xz8pGVRW_p1EJswRPJlo34FmQfgOEoXW_XAWDnLR53DDEwvabLTfnRO8o2TtY4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHv0BV-shhYotP6YMm45FHTXWj7jr6FB0-us-Qnc7t0A&oe=69B006DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2022-09-07 at 16.33.29.png", "id": "1780164955664047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86646352_1780164958997380_1314327246187457407_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsOByGRlj2gQ7kNvwHCa-RC&_nc_oc=Adnnp2Sm3_nw7Wffr0axlKvuVv_x0h2IlOasMQsKFMBXbQuaa3qJfLRNPVyxk8syjqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmY-3GItPXk-Q7ART_3Pg9Kd49U6PcFqgfVqsFRWK72Q&oe=69B027D6"}, "display_name": "Completion", "keywords": [], "long_description": "Welcome to a new category of leisure experience.\n\nCompletion is a platform for 10-minute visual journeys to help neurodivergent children with calm and concentration.\n\nCreated by some of the world's best visual artists and musicians, Completion takes you through a range of beautiful sensory experiences that are helpful for challenges related to stress and anxiety.\n\nFor more information about the effects of Completion, and to get full access, visit completion.one\n\n*Note that the files are too large to stream on most connections, so you have to download them to get a proper experience.", "short_description": "Welcome to a new category of leisure experience.\n\nCompletion is the VR platform for transformative art, based on 10 minute fractal journeys that are both entertaining and empowering.\n\nCreated by the worlds best visual artists and musicians, Completion is helpful for letting go of stress and limiting narratives, while increasing empathy, creativity, and self-esteem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://completion.one/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Completion", "support_website_url": null, "website_url": "http://completion.one/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "6507899929252835"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75340706_612049107146661_47012193401840122_n.png?stp=d
dRyTX0YRPN3lw2G5nBO7sg&oe=6A69E9F6"}, {"file_name": "6.png", "id": "1056892768691012", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031352_1056892772024345_7144680210710675606_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yF0o50P96joQ7kNvwHwv2Cx&_nc_oc=AdrkQwHy95lQClMXhtPQj9CBaIBpXfwoWWXXuduGk74U9qbY-ExH4P_VP_MR7ufYkLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY4mSFgO1K92R4eE6mBHAw6ud7kF023EWIT_jhCMZRpg&oe=6A69FF72"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tractor Simulator VR \u2013 Farming Games | Tractor Games - Become a Country Farmer", "keywords": [], "long_description": "Escape to the tranquil world of Tractors & Fields VR: Virtual Farmer!\n\nStep into stunning landscapes, cultivate diverse crops, operate realistic tractors, and nurture your livestock in this immersive VR experience.\n\nPlant, harvest, and trade: Choose from a variety of crops, take control of meticulously crafted tractors, and sell your produce at the local market.\n\n- Build and expand: Construct barns, sheds, and other structures to create your dream virtual farm.\n- Explore and discover: Journey across vast landscapes, uncovering hidden areas and unique encounters.\n- Master the art of farming: Learn about crop rotation, animal husbandry, and different farming techniques.\n- Relax and de-stress: Find peace in the serene world of VR farming, away from the daily grind.\n- Immersive experience: Enjoy realistic weather systems, a day/night cycle, and intuitive VR controls.\n- Regular updates: Stay engaged with new content and features added regularly.\n\nTractors & Fields VR: Virtual Farmer is your gateway to a rewarding and peaceful virtual farm life. Put on your headset and embark on an unforgettable agricultural adventure! Any Suggestions or Questions are welcome at info@tulipapps.com.", "short_description": "Dive into VR farming with Tractors & Fields VR: Virtual Farmer! Cultivate your land, plant crops, and harvest bountiful yields using realistic VR controls. Operate tractors, explore sprawling fields, and experience the beauty of virtual agriculture. From seed to supper, Tractors & Fields VR offers an immersive and rewarding experience for aspiring virtual farmers of all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8001897376532957"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982509_1132948128069219_3260637749027116437_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GimJmk1llYcQ7kNvwFW8gf6&_nc_oc=AdpKj86-LdWl2b5j8gVw4U-O6izDTXAekFKVmDpzsPiVLEob42JUzol5GfUjHmSpjTA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD05dwYZHQjLb5oB8tPMAFssMki2rWJ7PM3dIpTsMPUfg&oe=6A6A01A0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tractor Simulator VR \u2013 Farming Games | Tractor Games - Become a Country Farmer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_da
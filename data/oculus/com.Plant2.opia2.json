c_ohc=0h0PeXwTybAQ7kNvwFdi5qD&_nc_oc=AdoAfaZAeKk8tL70V0w9hjcElasj0Gufs1dbNlZayJp4SqVApH4QHG1VogwFTEpBJ9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRD3FKMu03H8kb2ZrY6eL51v3kKs-jRbn_Ml1kVKx--5A&oe=6B0DB0C4"}, "display_name": "Plantopia 2", "keywords": ["Plant", "grow", "garden", "steal"], "long_description": "Welcome to Plantopia 2, the ultimate VR gardening and farming adventure! Plant a wide variety of crops, care for your growing garden, and harvest everything from common plants to incredibly rare finds. Earn coins to unlock new seeds, expand your farm, upgrade your tools, and customize your garden to make it truly your own.\n\nPlay solo or with friends as you build the perfect farming paradise, discover exciting surprises, and collect unique plants to show off. With constant progression, rewarding gameplay, and endless opportunities to grow, there's always something new waiting in Plantopia 2. Grab your shovel, start planting, and watch your dream garden come to life!\n", "short_description": "Plantopia 2 is a relaxing VR gardening and farming game where you plant crops, harvest rare plants, unlock new seeds, decorate your garden, and build the ultimate farming paradise with friends. Expand your garden, earn rewards, and discover new surprises as you grow your own thriving world."}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://sites.google.com/view/plantopiapolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Pulser Games", "support_website_url": null, "website_url": "https://sites.google.com/view/plantopiapolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED
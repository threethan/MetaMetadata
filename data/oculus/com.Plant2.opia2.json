1furJudDK-vgOtTo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH1R2O9-k2vQwtUSNnet0nGn-nRCWFM9HX2ljRMlHCtg&oe=6AB3E82E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Img4ws (1).png", "id": "3615212505314036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_3615212511980702_3085854073525985375_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwECcxxfD6YQ7kNvwHPgxRU&_nc_oc=AdowD2gdTtImZ8IIjGIm_7NIriSCfyFOAO4IlVPts8NwJOV62i0IKmSdPwLxWROB04k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxVgU3LfAxJyR6tLzv4l5jHBZDZp7VvmD3WeoR677IsQ&oe=6AB3D284"}, "display_name": "Plantopia 2", "keywords": ["Plant", "grow", "garden", "steal"], "long_description": "Welcome to Plantopia 2, the ultimate VR gardening and farming adventure! Plant a wide variety of crops, care for your growing garden, and harvest everything from common plants to incredibly rare finds. Earn coins to unlock new seeds, expand your farm, upgrade your tools, and customize your garden to make it truly your own.\n\nPlay solo or with friends as you build the perfect farming paradise, discover exciting surprises, and collect unique plants to show off. With constant progression, rewarding gameplay, and endless opportunities to grow, there's always something new waiting in Plantopia 2. Grab your shovel, start planting, and watch your dream garden come to life!\n", "short_description": "Plantopia 2 is a relaxing VR gardening and farming game where you plant crops, harvest rare plants, unlock new seeds, decorate your garden, and build the ultimate farming paradise with friends. Expand your garden, earn rewards, and discover new surprises as you grow your own thriving world."}]}, "developer_name": "Pulser Games", "developer_privacy_policy_url": "https://sites.google.com/view/plantopiapolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Pulser Games", "support_website_url": null, "website_url": "https://sites.google.com/
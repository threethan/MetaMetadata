c_sid=6e7a0a&_nc_ohc=oNBrPnF_vi0Q7kNvwGWzEZH&_nc_oc=AdrRlh_TGBrg9sQeaNDlN15gI_wZNEJmYflPyL2-dlQqWyj8gO4N86zjl4k-ta-I8N0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTWvAeh0j2bggj97ypF7pOMJ4PH7ZK9Lqhlb2q-CAuXgQ&oe=6B0DAAA2"}, {"file_name": "new_arena_2.png", "id": "292676427146092", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982448_292676430479425_2235918166081777569_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4d4GiqN2wcQ7kNvwEkh1N5&_nc_oc=AdpjYemOuY6vEr6yx1FLOlV3WjG3ZdDQdwiEGysQhJLrIK8KFnd_VkrCISvReYOEfYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqYrXY4T9b0mGShqRWGmODeQhg5E5rVqhA7TUvXDxigA&oe=6B0DA05F"}, {"file_name": "scr_2.png", "id": "256137685871429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003274_256137689204762_140882877740874286_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpYeTOtBHBkQ7kNvwHC8XTU&_nc_oc=AdoE-N6Cq4HLrP-tb6-Ss9YqMoTdCzJjRvHvrJkQOkc8w8f2Ngm_3Phm0HCuLmSwGig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSFNNAIfApzh64iie2UqQbLrrvW1NgyXRww8a1__fUxqw&oe=6B0DAE63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash.png", "id": "234827682049961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031400_234827685383294_2291046045821978373_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddXJGBCRw8oQ7kNvwFa4R6O&_nc_oc=AdrzN-e0fSWJferqCAvavAFxuoRa96CJfsLxdNL16Q3WE4QKhkFdQ5aYMlBosN_lcjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEh5RiA-MnIEvGSzwS4T1i0BqbXfndDQOTTGb15NZv7A&oe=6B0D9FC0"}, "display_name": "X-Fitness", "keywords": ["fitness", "music", "workout", "mp3", "fun"], "long_description": "Level up your fitness game with **X-Fitness**, the ultimate VR full-body workout that makes getting in shape an exhilarating adventure!\n# Why Choose X-Fitness?\n- **Burn Calories in a Fun Way:** Turn your workouts into a calorie-burning experience that feels more like a game.\n- **Hit the Beat:** Punch targets in time with the music! Choose from our original tracks or add your own MP3s and train to your favorite tunes.\n- **Dynamic and Varied Moves:** Keep things fresh and exciting with a variety of moves such as striking, punching, cutting, blocking, avoiding, and dodging.\n- **Full-Body Engagement:** Engage your entire body in the virtual arena for a comprehensive workout.\n- **Precision and Timing:** Improve your precision and timing to achieve higher scores and climb the leaderboards.\n- **Customizable Experience:** Adjust the intensity to match your fitness level, from warm-ups to intense challenges, or create your own workout routine.\n# Features:\n- **Music Integration:** Enjoy your workout with our handcrafted tracks or your own music.\n- **Virtual Arena:** Step into the arena and perform a wide range of movements to stay fit.\n- **Fun and Engaging:** Stay motivated with varied moves and exciting challenges.\n- **Track Your Progress:** Monitor your performance with detailed stats and compete on the leaderboards for the top spot.\n# Get Started Today!\nMake your workouts more enjoyable and effective than ever before. Put on your VR headset, start moving to the beat, and get fit while having fun with **X-Fitness!**", "short_description": "Make your workouts more enjoyable and effective than ever before. Put on your VR headset, start moving to the beat, and get fit while having fun with X-Fitness!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/x-fitness-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://www.facebook.com/groups/xboostercommunity", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "81013935
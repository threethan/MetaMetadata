ience brings you a mix of high-energy tag gameplay and heart-racing horror elements, all set within a sprawling jungle environment. Also Go Subscribe To My YouTube Channel! https://youtube.com/@sparktrixxvr?si=WigONYnughbMTSkf", "short_description": "This Is a Fun Fan game based on gorilla movement and you can make Friends and play for maps! Also Go Subscribe To My YouTube Channel! https://youtube.com/@sparktrixxvr?si=WigONYnughbMTSkf"}]}, "developer_name": "SparkTrixxVR", "developer_privacy_policy_url": "https://sites.google.com/view/flushy-tag-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "SparkTrixxVR", "support_website_url": "https://youtube.com/@sparktrixxvr?si=-Kg3U7UgKYoS8sow", "website_url": "https://sites.google.com/view/flushy-tag-website/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26125542880459234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75278188_1777981203011610_3671929638165121637_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djQ_xt9WmKYQ7kNvwE5n9h6&_nc_oc=Adq51_w2UpFhw0pMO-feKHYqM0T1-VATTsw3fGxmULuivKR_H7bKnaXfQW6knHWx05Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kOlrpc11oqgfyeoJyZFTKbWX86bSwgTJ8BrEfsmScsg&oe=69D4FBB0"}, "is_concept": false, "is_test": false, 
ushy Tag VR,\" a game inspired by the popular \"Gorilla Tag,\" but with a twist that will keep you on your toes. This VR experience brings you a mix of high-energy tag gameplay and heart-racing horror elements, all set within a sprawling jungle environment. Also Go Subscribe To My YouTube Channel! https://youtube.com/@sparktrixxvr?si=WigONYnughbMTSkf", "short_description": "This Is a Fun Fan game based on gorilla movement and you can make Friends and play for maps! Also Go Subscribe To My YouTube Channel! https://youtube.com/@sparktrixxvr?si=WigONYnughbMTSkf"}]}, "developer_name": "Will", "developer_privacy_policy_url": "https://sites.google.com/view/flushy-tag-privacy-policy/home?authuser=2", "developer_terms_of_service_url": null, "publisher_name": "Will", "support_website_url": null, "website_url": "https://sites.google.com/view/flushy-tag-website/home?authuser=2", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27946396611707176"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75278188_1777981203011610_3671929638165121637_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUV0C37va5IQ7kNvwEJgn9E&_nc_oc=AdpStNE3AxMoJ1ELrZdRnchBkseblMa52VuNJrJZR1Q4Vg-2dh3ozzbxsp6bviQaxyk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ-ZNO9IY4orSI5FSK
_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhmU-_C_MYIQ7kNvwG6bfdx&_nc_oc=AdknGaaJCMEoDMN1MoNAk26IEaguSmp4dO9G63lBZ-7f_HSuiDoJIKFhlZj1GvkcWWE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJDH9tTO3PwJ1T9-nFgLRY-larmW3W-no6HhWLU5YkgQ&oe=69BA9800"}, {"file_name": "Adobe Express - file (5).png", "id": "2062950764559001", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819854_2062950767892334_5236632941060949132_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvD4ZauOezoQ7kNvwEa7Zpr&_nc_oc=AdkZI-brOrAoRFqdAe0l4hIpbILROlduiWGw4hcyyE8wQMIQLfP-ubRdm_9QK6qVCcM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwR7wPGe0V5uzzhmrMob9gXQSM1h7jdbj2CmWq_vt3Qkg&oe=69BA8DAC"}, {"file_name": "Adobe Express - file (6).png", "id": "4404776013143213", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828008_4404776019809879_8472594714087527448_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qJ1Ja-HaF4Q7kNvwHYDhBn&_nc_oc=AdkeX2vL2GpGwo6HgIxStTvr8GAJ5LI4Y3aezIYeOJHWQHxnP_n7WdEadPEQvJX709o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMq9_1YOMdbZmf1LzIPL-giqEB12d_Q3uElTTduOjubA&oe=69BA959A"}, {"file_name": "Adobe Express - file (7).png", "id": "1412601827206780", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823910_1412601830540113_6870072553569486308_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cpts-I8QNa4Q7kNvwFahbp0&_nc_oc=AdmgvjQJOF0n5dA8WYiqZq3-URF_jYNvN1y-JEbAt9tRm1JsjaN1yS4qWWL4eXa32qA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwt62ZNHtNXosmYIEP47XukYhdVkR_OzGCtVbf0AJJAgw&oe=69BA8267"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pebbel tag", "keywords": ["Multiplayer", "Adventure", "competitive"], "long_description": "2023 Spring Cleaning \u2013 Gorilla Tag Copy\n\nThis project is a full spring-cleaning pass on my Gorilla Tag\u2013style game, focused on polishing, optimization, and overall quality improvements rather than adding unnecessary features. Over time, the project had built up unused assets, messy code, and small bugs that impacted performance and stability. This update was all about cleaning that up and making the experience smoother, faster, and more reliable.\n\nDuring the 2023 Spring Cleaning, large sections of outdated or unused code were removed or rewritten to be more efficient and easier to maintain. Core movement mechanics were refined to feel smoother and more consistent, helping improve player control and overall flow. Performance optimizations were applied across the project to reduce lag, improve frame stability, and make the game run better on a wider range of systems.\n\nMaps and assets were reviewed and cleaned up, with unnecessary objects removed and layouts adjusted for better performance and readability. Various bugs and small issues were fixed, including collision problems, movement inconsistencies, and minor visual glitches. Internal project organization was also improved, making future development easier and cleaner.\n\nThe goal of this update wasn\u2019t to change what makes the game fun, but to refine it. Everything should feel more stable, polished, and intentional. This spring cleaning sets a stronger foundation for future updates and experiments", "short_description": "A modded gorilla tag copy to have fun based in 2023 spring cleaning"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/e528f2d6-d5ef-46dd-a02c-6d25f6fe42d5", "developer_terms_of_service_url": null, "publisher_name": "Pebbel Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/pebstudcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
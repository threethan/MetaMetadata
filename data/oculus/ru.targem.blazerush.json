"keywords": ["racing", "arcade"], "long_description": "BlazeRush is a dynamic arcade racing survival game with no health, no leveling, and no brakes! Explore dozens of fun tracks on 3 distant planets. Choose a car to your taste out of 18 unique vehicles available. Use a variety of cool guns to chase, blow up and cut your opponents off! Adapt your style and tactics to new enemies, obstacles, and tracks. Earn lots of medals for various tricks and antics.  Enjoy simple multiplayer with up to 8 players over the Internet. Welcome to the World Of Racing and Frantic Fun!", "short_description": "BlazeRush is a dynamic arcade racing survival game with no health, no leveling, and no brakes. Choose a car to your taste and chase, blow up and cut your opponents off! Welcome to the World Of Racing and Frantic Fun!"}]}, "developer_name": "Targem Games", "developer_privacy_policy_url": "http://blazerush.com/?page_id=595&lang=en", "developer_terms_of_service_url": "http://blazerush.com/", "publisher_name": "Targem Games", "support_website_url": null, "website_url": "http://blazerush.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "RACING", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "407804147788971"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "638763273477438"}, {"status": "PUBLISHED", "id": "2262012370481549"}, {"status": "PUBLISHED", "id": "248924945669536"}, {"status": "PUBLISHED", "id": "783129548870599"}, {"status": "PUBLISHED", "id"
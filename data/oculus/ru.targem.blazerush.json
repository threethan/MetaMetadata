bT-xpWmz1XsfVk6EusJ7lgenZA&oe=69FC9CED"}, {"file_name": "screenshot-211015-142335.png", "id": "738452684218189", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974677_738452694218188_7895797566816713473_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NN-aipS1vpUQ7kNvwFue1OR&_nc_oc=Adp_FSJuPLPE9rOvNSnSLagTz60gcpUrCUviZN_6zd2KDe9mYfZqK_wWjLjzrxa5YKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MiqDLbl3p3ybe3K10odryRnXsUAtiVIWMTawZH7eKsA&oe=69FC7F0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "blazerush_2560_1440_\u043e\u0441\u043d\u043e\u0432\u0430.png", "id": "2878332072476999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031400_2878332079143665_822140938889537713_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qz0clgb5BA4Q7kNvwFK0CIl&_nc_oc=AdohvCLEV1Qky0aZlVqZjoUezIg1LzF0OLTOArBhMj7t0FffdPtO8ypUvwF7w1yFw6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gyxwgtTJGMB1b8bELKE2nLw6gpNT8ng-QFVrJaauy4g&oe=69FCA07F"}, "display_name": "BlazeRush: Star Track", "keywords": ["racing", "arcada"], "long_description": "BlazeRush: Star Track is a dynamic arcade survival racing game in a new space-themed setting. In this game, everyone can assemble a team of friends in local or online multiplayer. Choose a car to your taste and chase, blow up and cut your opponents off \u2014 welcome to the world of racing and frantic fun!\n\nThe special BlazeRush update for Oculus Quest 2 features:\n- A campaign that includes 30 missions\n- New type of vehicles \u2014 spaceships\n- New types of weapons: laser, mines and chain lightning\n- Special space-themed race track for multiplayer\n- New powerful enemy \u2014 a massive spaceship. Use new weapons and come up with your own strategy to win!\n\nKey features of the BlazeRush game:\n\n- Up to 4 players locally and up to 8 players online\n- The option for local players to arrange races online\n- The ability to join the game at any time\n- Dozens of vibrant race tracks on three planets, 20 cars and a variety of cool guns\n- Many medals for various tricks and frills", "short_description": "BlazeRush: Star Track is a dynamic arcade racing survival game with no health, no leveling, and no brakes. Choose a car to your taste and chase, blow up and cut your opponents off! Welcome to the World Of Racing and Frantic Fun!"}, {"images": {"nodes": []}, "id": "408873993949307", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlazeRush: Star Track", "keywords": ["racing", "arcada"], "long_description": "\u0412\u0441\u0442\u0440\u0435\u0447\u0430\u0439\u0442\u0435 BlazeRush: Star Track \u043d\u0430 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435 Oculus Quest 2! \u0412\u0430\u0441 \u0436\u0434\u0443\u0442 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u044b\u0435 \u0430\u0440\u043a\u0430\u0434\u043d\u044b\u0435 \u0433\u043e\u043d\u043a\u0438 \u043d\u0430 \u0432\u044b\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0432 \u043d\u043e\u0432\u043e\u043c \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0441\u0435\u0442\u0442\u0438\u043d\u0433\u0435. \u0417\u0434\u0435\u0441\u044c \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u043e\u0431\u0440\u0430\u0442\u044c \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u0434\u0440\u0443\u0437\u0435\u0439, \u0438\u0433\u0440\u0430\u044f \u0432 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u043c \u0438\u043b\u0438 \u043e\u043d\u043b\u0430\u0439\u043d \u043c\u0443\u043b\u044c\u0442\u0438\u043f\u043b\u0435\u0435\u0440\u0435. \u0412\u044b\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0442\u0430\u0447\u043a\u0443 \u043d\u0430 \u0441\u0432\u043e\u0439 \u0432\u043a\u0443\u0441 \u0438 \u0433\u043e\u043d\u044f\u0439\u0442\u0435, \u0432\u0437\u0440\u044b\u0432\u0430\u0439\u0442\u0435 \u0438 \u043f\u043e\u0434\u0440\u0435\u0437\u0430\u0439\u0442\u0435 \u2014 \u0434\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 \u043c\u0438\u0440 \u043d\u0435\u0438\u0441\u0442\u043e\u0432\u044b\u0445 \u0433\u043e\u043d\u043e\u043a \u0438 \u0431\u0435\u0437\u0431\u0430\u0448\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u0435\u0441\u0435\u043b\u044c\u044f!\n\n\u0412 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0438 \u0438\u0433\u0440\u044b BlazeRush \u0434\u043b\u044f Oculus Quest 2 \u0432\u0430\u0441 \u0436\u0434\u0443\u0442: \n- \u041a\u043e\u043c\u043f\u0430\u043d\u0438\u044f \u043d\u0430 30 \u043c\u0438\u0441\u0441\u0438\u0439 \n- \u041d\u043e\u0432\u044b\u0439 \u0432\u0438\u0434 \u0442\u0435\u0445\u043d\u0438\u043a\u0438 \u2014 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043a\u043e\u0440\u0430\u0431\u043b\u0438\n- \u041d\u043e\u0432\u044b\u0435 \u0432\u0438\u0434\u044b \u0432\u043e\u043e\u0440\u0443\u0436\u0435\u043d\u0438\u044f: \u043b\u0430\u0437\u0435\u0440, \u043c\u0438\u043d\u044b \u0438 \u0446\u0435\u043f\u043d\u0430\u044f \u043c\u043e\u043b\u043d\u0438\u044f\n- \u0421\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0440\u0430\u0441\u0441\u0430 \u0434\u043b\u044f \u043c\u0443\u043b\u044c\u0442\u0438\u043f\u043b\u0435\u0435\u0440\u0430 \u0432 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0441\u0435\u0442\u0442\u0438\u043d\u0433\u0435\n- \u041c\u043e\u0449\u043d\u044b\u0439 \u0432\u0440\u0430\u0433 \u2014 \u043e\u0433\u0440\u043e\u043c\u043d\u044b\u0439 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043a\u043e\u0440\u0430\u0431\u043b\u044c. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043d\u043e\u0432\u043e\u0435 \u043e\u0440\u0443\u0436\u0438\u0435 \u0438 \u043f\u0440\u0438\u0434\u0443\u043c\u044b\u0432\u0430\u0439\u0442\u0435 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044e \u0434\u043b\u044f \u043f\u043e\u0431\u0435\u0434\u044b!\n\n\u041a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0438\u0433\u0440\u044b BlazeRush:\n\n- \u041c\u0443\u043b\u044c\u0442\u0438\u043f\u043b\u0435\u0435\u0440: \u0434\u043e 4-\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e \u0438 \u0434\u043e 8-\u043c\u0438 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u043f\u043e \u0441\u0435\u0442\u0438\n- \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0434\u043b\u044f \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\u0433\u0440\u043e\u043a\u043e\u0432 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044c \u0433\u043e\u043d\u043a\u0438 \u043f\u043e \u0441\u0435\u0442\u0438\n- \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u0442\u044c\u0441\u044f \u043a \u0438\u0433\u0440\u0435 \u0432 \u043b\u044e\u0431\u043e\u0439 \u043c\u043e\u043c\u0435\u043d\u0442\n- \u0414\u0435\u0441\u044f\u0442\u043a\u0438 \u0434\u0440\u0430\u0439\u0432\u043e\u0432\u044b\u0445 \u0442\u0440\u0430\u0441\u0441 \u043d\u0430 \u0442\u0440\u0435\u0445 \u043f\u043b\u0430\u043d\u0435\u0442\u0430\u0445, 20 \u043c\u0430\u0448\u0438\u043d \u0438 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440", "short_description": "\u0412\u0441\u0442\u0440\u0435\u0447\u0430\u0439\u0442\u0435 BlazeRush: Star Track \u043d\u0430 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435 Oculus Quest 2! \u0412\u0430\u0441 \u0436\u0434\u0443\u0442 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u044b\u0435 \u0430\u0440\u043a\u0430\u0434\u043d\u044b\u0435 \u0433\u043e\u043d\u043a\u0438 \u043d\u0430 \u0432\u044b\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0432 \u043d\u043e\u0432\u043e\u043c \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u043c \u0441\u0435\u0442\u0442\u0438\u043d\u0433\u0435. \u0417\u0434\u0435\u0441\u044c \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u043e\u0431\u0440\u0430\u0442\u044c \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u0434\u0440\u0443\u0437\u0435\u0439, \u0438\u0433\u0440\u0430\u044f \u0432 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u043c \u0438\u043b\u0438 \u043e\u043d\u043b\u0430\u0439\u043d \u043c\u0443\u043b\u044c\u0442\u0438\u043f\u043b\u0435\u0435\u0440\u0435. \u0412\u044b\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0442\u0430\u0447\u043a\u0443 \u043d\u0430 \u0441\u0432\u043e\u0439 \u0432\u043a\u0443\u0441 \u0438 \u0433\u043e\u043d\u044f\u0439\u0442\u0435, \u0432\u0437\u0440\u044b\u0432\u0430\u0439\u0442\u0435 \u0438 \u043f\u043e\u0434\u0440\u0435\u0437\u0430\u0439\u0442\u0435 \u2014 \u0434\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 \u043c\u0438\u0440 \u043d\u0435\u0438\u0441\u0442\u043e\u0432\u044b\u0445 \u0433\u043e\u043d\u043e\u043a \u0438 \u0431\u0435\u0437\u0431\u0430\u0448\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u0435\u0441\u0435\u043b\u044c\u044f!"}]}, "developer_name": "Targem Games", "developer_privacy_policy_url": "http://blazerush.com/?page_id=595&lang=en", "developer_terms_of_service_url": "http://blazerush.com/", "publisher_name": "Gaijin Distribution Kft", "support_website_url": null, "website_url": "http://blazerush.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "RACING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH"], "supported_player_
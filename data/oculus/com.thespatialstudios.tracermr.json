?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F617RfGLBbcQ7kNvwGl8re3&_nc_oc=AdrOmmPLSohWPdQnBrPCUgUyZSzvaMGMt9rDQenca8LbptBF2ZG8v4ytwJVumzZLzKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCza2YMbnLz4-RgHEeGH6OmeoCF-FnaYrNdG_GbFl54A&oe=6AE5F5B4"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7GlmNR8rrsQ7kNvwFAzf_Y&_nc_oc=Adr3DHdxrb2da80LSSSI_NU0htM8Eub6xuMh6fwnpLGr7pzGN0CyX0KlOG3Rkffaxos&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr73J18DdprD3KZDDUvUarjLMKSG6K4-iQGTl9h5NuOw&oe=6AE61259"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzD4E3IRuUwQ7kNvwHSkVb7&_nc_oc=AdrB0F-MR5IjnyEFZrQBhwk6sjdoE6ckgcjDTogfwi7YfUZZzTFb7zO-D9zmZoJHgVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmayKFUOBg3LN5qVVHuoUHTEvqWBKp84sPkL9FlHX_Yg&oe=6AE5F8B2"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OoiI_3dY6MQ7kNvwFXn6In&_nc_oc=AdrxLNrFsgoJ4g8z7PzuHTdKPAw-MwGYn2uUAoovn-I4leetaw1dltlOFOshYKvgu2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2KvjngjqdqPSH08xGqxzJNP-hEs-mQix-hRVOAp12Fg&oe=6AE5F944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6v_d0NJvnQQ7kNvwGVZ-0u&_nc_oc=Adp9eGWxTtue26ZarRyn4xw2tgJh7ANQWtQwVFIoG55cU0mb2O9w2T2lYFeQZ7OUzCI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNb3KUAVnSGbt6_WKyc8DJePFmsa53NtkdGqjVKcfN-g&oe=6AE612E2"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
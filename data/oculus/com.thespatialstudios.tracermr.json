?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrxSY8210MMQ7kNvwFC1W9F&_nc_oc=AdoKfhmebuMQD3ZfC31P4x-LO_S2jq2G9Ju-2edtuWTzieGQ_NWskX3pUHDQ9u0L-xc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRKtmwvmBreX_zf-aqUBoiEmWiC2feGeanQK0Rgy0OZg&oe=6AEDDEB4"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWZgsaNu4JAQ7kNvwFCVEkP&_nc_oc=Adpotb9Taii_Fqd9OGdtav2ZMLxfu1MY4vHFYKLoiY61hkTgNf0CNqMlH_vDnjoNuhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjCAQXrr0khFXMFapxsUedVqV4Wex6wOXEh6cQjjvHRw&oe=6AEDFB59"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gj5WWAsmYcQ7kNvwE5lRqE&_nc_oc=AdokB_YQ77qMidcoRIse2QtWoSTgOD5JOg4nzStZgnrRQok8BZmAUAXmpU054uz8cpc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgEeMOU5V0k4cl0PWkeCv44e2-r3daHc19TIEYIXC18A&oe=6AEDE1B2"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OshJ4EsybsQ7kNvwGSxpVo&_nc_oc=Adp7bPiUTb5YSNJM_ZwEgdPfMo1hS0Ueh99fFYseY9GHlD5LQRaD-8rRXHpGukwiEqw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsM78NZC2A8zZGZISGSNi0TT9R7jfxXp83FjIkAmqZIQ&oe=6AEDE244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgN4HK3Nd6oQ7kNvwG3-9Z1&_nc_oc=Adqvg6MR4u3lUgik0xfW3IRLvtDMsop8j8zpBdF1hIdznl9VQVyI16WbeFAi0H7aS10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT73ml7DbmMWgqxe4gFiRPH8PmEGUxiPvfCop7qjWfA2g&oe=6AEDFBE2"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
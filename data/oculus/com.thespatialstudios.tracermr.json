?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gou66StEOAIQ7kNvwED57my&_nc_oc=Adotpr2rBNm7D7hYiVS8nRZvFrnIteeOQ3gKpYm3YZrbl_NLbry6aY2TvLW2mD8LnX4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvpL7XSXnbkAcd9ljVC3-ah_f1fbb7dBrPDcpcg7c1Bg&oe=6AE352B4"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSbf5V1cefoQ7kNvwFe0-kZ&_nc_oc=AdrSNpmOnDam1jro3YWLtkys1D4TYY00jnMvqAwR2iY37-5E1EoMeXnHqbu3aXN1Nf0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmGJC2rlZyDO6SJ0rD-doeyJx2BQVqGeSSe32dt7AM8A&oe=6AE36F59"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHOUJtUwsvEQ7kNvwHvB75J&_nc_oc=AdpMVF9sAnFkC6y_3BvT3ujWV9NkqiBmJ8955FJgtLSF4qrTHzxxKwWN8_bY5SIUaGw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3x3Umc6BAVfohNKlJdd50n3MpLU-8rNwcZDmz34oo6w&oe=6AE355B2"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUvoiBhSuWoQ7kNvwGgPf9A&_nc_oc=Adq-e-ESelXqeoBXIMBNDPwTX1eBCt8WZ-qTc1cqNrPL6Wo22Ob1EqCL8uOoQUxm4Y4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQHYf1YSRgaOZxGdZ1sNLkqU2JqQ-S8e4K_gEMqs-qBA&oe=6AE35644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8pw6lJQTXQQ7kNvwHbxzon&_nc_oc=Ado4NO19yRX06AixfzEIVNaC_Rmeu5mdz69cM2sdijsPKk1xh17nzNwm37Zh6byBFD0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQRuMayVNH_2YwlUlQGASkzK386ujnEhGjOA7UmP5KPQ&oe=6AE337A2"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
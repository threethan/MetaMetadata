?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1O7NNphaG4Q7kNvwGaMkH0&_nc_oc=Adrdd2cmit7GumrX8FCGcjp-84-XwbNNNH5JNa1xOndHVwV9LNN4hinh9HuSA2C5eWc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU7wLx-LuucG7e1vN5DiN4G2UAOGamJXHSkz-XpmMeew&oe=6AE9EA34"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akukx6MvPHIQ7kNvwHwc0YK&_nc_oc=AdrgrhrRUi_BuS0cPdmM858CVQdN5rXFtHRjrKCNlFnwodYcBlvfH-fmcwcqBOOxmL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9ze4RiZqxMjHMjbTdiLNRMWuyq2mIaiouKwv0iBF2gw&oe=6AEA06D9"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7bSsTOTi1sQ7kNvwGqLxGH&_nc_oc=AdpDzgrrpPwypEm1cbv1dP9yfbIbXxRTAvlt6VnWYb81mCxxKeH2FYr2r2bEeWjeOts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa7MaZZmNs2wBDHXWQ5kTnZtdQKICLGEpndqpeYKVpVA&oe=6AE9ED32"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ABJrKcpX-wQ7kNvwGjpnOa&_nc_oc=Ado58COtRZ_rexa0MNKfgvH6M2jyxJ08Fj0Q6PfDwNEze33QMEjudXCAUfoP_UbDIoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2yaMYj4dXw4sNFUzo4d8Vn1RZc6QaPF7kt8EuDf-5Eg&oe=6AE9EDC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_5S0Px1OnsQ7kNvwHQp1sX&_nc_oc=Adp1wMvgNaZQnog1BjvY8APizxNeMFCCwWDhjHil90V9htErLkaTNB7etjP6vzvfI90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpjSVzzVHFlR__9CAYJ7mjh1p0pkSTfFpFe55NEchmZA&oe=6AEA0762"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
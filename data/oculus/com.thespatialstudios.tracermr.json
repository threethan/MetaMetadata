?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ox2is5FvpT0Q7kNvwGxTEZe&_nc_oc=AdqO5d6pwPaoiR4WAuaDgcuDMKuOmeAQ88ycgSRxsTTAosgpGGdoMP_nJFtWlpt_SPc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS_Yf5ADvZv624tnp_lvjgY57AZ3hf3heVJPfXX7byJw&oe=6AF20B74"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=145Z2NSvoB8Q7kNvwFq-1oJ&_nc_oc=AdqfZTvFE1sgByg7UhvW3tQS5FMfZl9WdmC_oirE4V0DZw4eF_azkJj2UbJEQ15JOeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5y7vdDJUDNA06VUlCY_FlEnbvqJld8nqpBCyUCe9Sqw&oe=6AF1EFD9"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjTYRnOH21oQ7kNvwHXcsYv&_nc_oc=Adp3zumzGCzXM47eEr46PX-URh2Zuthop3bpzxrrzV1miX2iZ9sE0YWIzeR9_2aqup8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWhZSJwmEJPa2yb2axhN9iWCXUv-F4Z5gzgAWHiL02HA&oe=6AF1D632"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ameeH8M16PwQ7kNvwGUuO6_&_nc_oc=AdpEkMax_MNIGAgQTFsKoiEczbClWJ9SuQufo4vhrt-Sm4fWNG90-kS5ICBWkF8NqrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1T82MopyO_GPGyoKAGVtGFx6ketZH-5Ur446GYJW0Ag&oe=6AF1D6C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVfgFxut2ooQ7kNvwFVyh5S&_nc_oc=AdqeVomvSPb5cKoER77SYAxXdTwlNwakzGcThZF5Kzxy8iXlOBgidipLCJhKQuGMAdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSg8vwn9rEV8EStnfQr-88_kcZAt2XFAXXqxr45MngnMQ&oe=6AF1F062"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1O7NNphaG4Q7kNvwG7hoT2&_nc_oc=AdqRUIXUCynJJ6FL0UfYq_UW0fy-rFEbcAQAOipW8aY0tDtDavOxnLYtGkjgP9s2Qko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1A9nR3KPZnottaTvBFVz72aeN5hZ6cR3S2dw5O2WTuQ&oe=6AEB3BB4"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWZgsaNu4JAQ7kNvwGO7arA&_nc_oc=AdrzgwnhCvO_gnoUKtG_rIlRXtPlfqjWQRmOT03ZDebh11y53zSCitqVRHRr0f025Gc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-r_Ib-_qKI2yL0nEzZcq5DWPFVBWwPbYQDL_aa1Hh6Q&oe=6AEB5859"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7bSsTOTi1sQ7kNvwHz3xdH&_nc_oc=Adow8na-Vwxz-azqJzYJ57vZ-tvdUaU-soFi_agM1OArasKcScrTxrxnqERH4y_v1jM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEQWUJk09WgyVguUC3acUJyc5PZn8g9oDI0v5GRoHxQQ&oe=6AEB3EB2"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ABJrKcpX-wQ7kNvwEWhVEB&_nc_oc=AdrQDEv6uc4NmzptpHqGF6DhNwoHUWCHlYiTRNtv1aJ1MFkPSignwPljTt4XPMLMCUg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-1l_-BxKk4k-D_e2QOCSAOEJFWMmbUZS67er2TwQf-A&oe=6AEB3F44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_5S0Px1OnsQ7kNvwEYLz6f&_nc_oc=Ado_Uo_Dfke-8SlReiPeSBfEuN6p9txbKVSYE55HwdB8ksTfoCmN-nKF6GSRcIjkNfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF44PdDmMfpPpdo5IAyD_RJ0COhg0HzWdAzsCsM-T-Kw&oe=6AEB58E2"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
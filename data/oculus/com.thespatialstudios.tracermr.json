?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ox2is5FvpT0Q7kNvwG-3EgM&_nc_oc=AdpciMENEbtv_pp3jgMsXBWbyW9CP286IMxbAN2AvzPA7V4VjNF7tfs6G9wwKloH_sw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw3s-99-CZNwvA0cBpMlyS2Uv1DpxhISZAD5drobv8BA&oe=6AF47634"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s09JwyVzuUwQ7kNvwHM2rEE&_nc_oc=AdoxXLqYomb4iUBOvQB1TNcDKZPE_vCsl5MDJJgAIDoCXqNUQmzhrayiOF_5-dBrdI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ-Kl65J0ViGB8cVykN7WbyLOgRDhJEVgmwyhuUnKcyw&oe=6AF492D9"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NlbzNfK7vAQ7kNvwEgvO0w&_nc_oc=AdoprRN5E2euFx3kXvmQNy3PjSM3UrWQCpMeTU3Ri10vtGmT_CERB_13sq6jUom6Rzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShlSesKd_LnCJmW6SmgxTgendEB9iYzVX8P00PebG18g&oe=6AF47932"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmoqZy8brMoQ7kNvwGnD7E_&_nc_oc=Adpg0UhBZK44fCE3h5Rse9EmIbYdn03tmGztCIgVoa7P77VPOya7_FhTlMnS6d14jZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlVAUh_Cdu74CHpnUOYg-7T-qirFkjgx7VuwNWyaN3MQ&oe=6AF479C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5o7v8YrM38Q7kNvwEFwE4P&_nc_oc=AdqY9l63C9JZwCttwTSAWtRmGnHqQvkUt3vZAM7MpAPnWm6Se0DS9t9OI3Ftnk1Lb3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5u2U1v1_8lUidPQLO1QzuoM_TqGABopOhEZus5pm2nQ&oe=6AF49362"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
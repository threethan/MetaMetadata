?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ox2is5FvpT0Q7kNvwGi2iY9&_nc_oc=AdqExIUdZ0nRPCtKZUbEO_JkZ2BAx5maPCrGSjPCU06rnhd6Cia6dLQ-O8_a1MkyUoI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhliyPi_M5mIK1_Qz3vJt4RJkVBZ7rdOsS7ZUIyFnIGw&oe=6AF324B4"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s09JwyVzuUwQ7kNvwF7mL0G&_nc_oc=AdrsTCqCuyw5XkvLnPsmtObus5ZYm6U8zQ3i1yFXYm_jNg5ozh-ng09OgTw8XP0PID8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRLtwvcsmM6hv0X4RUBIlDMjpNuGTvx9bfx0CaYZwdvw&oe=6AF34159"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjTYRnOH21oQ7kNvwEBmy12&_nc_oc=AdrnQXdCxgzBKxqiVfscd90_t8iUprkc8Gp8m4ybKzHs2HSCVioUFUHyuqlsdxkNyUo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfPVFtiihoWlID4CzYhRbBcEryskr8Q0FpJCgtibKJEA&oe=6AF327B2"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ameeH8M16PwQ7kNvwHzT7V2&_nc_oc=AdpupfnXPecVlmGPJF9uVrISIuCwuoqna38ikIbXj_x62ixZtlIjl519k6hqTheO1fc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQat5BN_dVmaahcS3-6X1HTCeKG-3GuY7R6h9-ycxcJUA&oe=6AF32844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVfgFxut2ooQ7kNvwEaWrCO&_nc_oc=AdoVNIZj6Gt3DFjUjJMFPqlrUS-K1AKUzBHjoSHTT2YNvGcSOT-FWmJu77NW8wTURdY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPdKAdKLsuCEn6iRah90EjHonJICqW2zm9yg-g1l7_0w&oe=6AF341E2"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gou66StEOAIQ7kNvwEPc9Xe&_nc_oc=AdolYpuVuDqaC1Qqmi0ZGB9m5LNup2oce-u0Hvyl0NMSaf9oxKQo3KDq20OIejouCOQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiLOueUorPbQctr72fLjYt7sddIOt_ky107auEIdiwew&oe=6AE4A434"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7GlmNR8rrsQ7kNvwHYVLXQ&_nc_oc=AdpknE1xmKN6HHqthBxT-EOv0FVUnrQJ1g57FzBUqOgkgZVe55FArF-VwOsK5dcbOyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKp8LxuRWQ-v3U674Q2Z9YrezuDhxHsRIwqymLjWrc4w&oe=6AE4C0D9"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzD4E3IRuUwQ7kNvwGF_UZs&_nc_oc=Adp_W1LrUTJASOZrYXlIE2LK4la9ANV8-aZPhuBlBTKMQtnHNdXWNk_wwOGyB3UBfbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP58y7mS4Rd6PffoH3RAGQ5C_1ncvOg5m1FlVHZPUmDvQ&oe=6AE4A732"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OoiI_3dY6MQ7kNvwENikZr&_nc_oc=Adp8P2fl5DvmNhFH6QO5PuP9vB-hZ5-TRfibqqSxTJdw7GHKHY-w9ua4ZasUr9ytLPc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl-kSdfffTFJvXnomcHAeV1sDrevj-Vo1iWMaTZI-GXQ&oe=6AE4A7C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8pw6lJQTXQQ7kNvwG-xZx8&_nc_oc=Adpgb5d_Qk3UBizGeSTKqNQ-8DhQQBx7WDIv4-fAugkcDXIG_UXsI2BqMxa_UkEw9-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-gQZmtqcZHOXobIUhcpeRSZIOxrzYeUQdp4-c6S19Kg&oe=6AE48922"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
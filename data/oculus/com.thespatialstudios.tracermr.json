?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvFIXn82F80Q7kNvwETLL_W&_nc_oc=Adr2fCuKJDVwBEGdP7gmzU-0RHxUx2n7RC38FOit4am42_FKjUzLJNvt-6URtKqL4K4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMhSdsTSWU898XcnNch6IGg1B3nFV9tP3n-ijJJl9Iug&oe=6AF71934"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkQSD-aghW0Q7kNvwFinuj4&_nc_oc=AdoiLm_bDbz5UsZA785ptrg7w28mpb8ti6UKbHfcaqji9irKHtZaVLDaDzPhDDuDL0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxDVh__clNETaC_mteLi_yjq64gUUkxKiRyJ-Ei4mGGw&oe=6AF735D9"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NlbzNfK7vAQ7kNvwG3kXjj&_nc_oc=AdpxQIxbI4jRZTrOPqc3NXyNvogMcWzzV_U7taVuUhfuq2YLiVdB6uJYofqaZO4StF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5LyAgKDX7BE0VHEykqunj3lmaCit9VEBnj06ezgjYUQ&oe=6AF71C32"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmoqZy8brMoQ7kNvwEn1tlJ&_nc_oc=AdrL-HrUmMdlzHjZHX535rU1gHE8NVCCav2HkrRidGzMlRle4cT30fyYcSt9FlqOUnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY5hOkPq3s2mN_nwyVkWaFDcQG4IwpcY1c0jUrR0zF5Q&oe=6AF71CC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5o7v8YrM38Q7kNvwElLjX_&_nc_oc=AdrXChxkdhJhi3yS32bL3XrGOqP0KHMLHYkIihF-9-h1rEWkSh_SD6qm5PdK_8OYB60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS8nTEh4Z61zNLaemjnfcu0w5UBH3CWGWELfkzEWOK_Q&oe=6AF73662"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
9CA04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBOBTeddvAwQ7kNvwFxNZ3q&_nc_oc=AdqXpLQvzGn8FM42XgUZLReFELPxIiEuxHPyFJ4DoAnflO9gpn7Gcfbj748pcu-gAWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7Gk_atItxVwLw3I91xWvU9R3w3SRVwolyt9w47vBsfw&oe=6B09AB62"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "51408770786
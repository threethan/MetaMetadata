?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvFIXn82F80Q7kNvwGk_HAi&_nc_oc=AdoPYv43Zeszv73f_cnCNl-g8x2LSlkMeilBy_bVF9NjiVH3a2vvpFkmt6F3dmlBRz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRkSPGXmU47oGNoC6Zc7Zg3OVDumjB9npx9AxFbWzAhQ&oe=6AF8A2F4"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkQSD-aghW0Q7kNvwECu-Hr&_nc_oc=AdqOC1EqCqKgbubKaLnjN0OMfkaxzmT1OXSa1zqlcMGofKM0-BuLGEybU_ONAT3Z89w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvV5elRNvblkQ4Go_YbTBgJOpCEzt2kBhkrWnchLHQGQ&oe=6AF88759"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEqJr_JLMcEQ7kNvwHOfrJN&_nc_oc=Adr2G2sU2wH0xq-o3efpZebVL5n_M5wt4sN7-Y8f7o-t7B66hBULtPk0E_ACbPyA6kU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPTuHwHTwI4jr7NsGR2b34FcPIvc8K5AkGLITGxAo3Sg&oe=6AF8A5F2"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiB9QGJ0c14Q7kNvwHDrFf5&_nc_oc=Ados9Jco9fV5BiW_6OZcLjh36t91rAGMzv7_sO7fqeJL_OSPbcimtXeNfR1qiAxhH7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfXaTBo19t-TMm-QdztLJO8n1vNwys3Om7EKJxG9TBfQ&oe=6AF8A684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzCPcXxBmMAQ7kNvwHgBiKo&_nc_oc=Adpx1fgN2tMynCFeRdyizjMXXeOG7UoDBQgQy7Xf4pmfVii8czELkePZiEzh4Xifj5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyVatwpjkOo1IwWV-BRyLSzZB5jQzskUqr5oi1t-Pr9A&oe=6AF887E2"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
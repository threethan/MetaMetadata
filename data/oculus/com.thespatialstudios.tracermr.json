?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIeW23bpLB4Q7kNvwHtbXQH&_nc_oc=AdrRop9Bd_139RjqA9loqO_MfbItqGN5twVi7Ewu5qLZJT45W7gxdDJkflDo805Ny38&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9yLRxU89q7SwYd2nqdQwy1UZXY-EYqnWkhMzqYYm_OQ&oe=6AF9BC34"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkQSD-aghW0Q7kNvwEtwt7y&_nc_oc=AdqKcbl3EJyriR1FTsC1MKEM2K-gtAuYpqoJ_EcCgSA8JIrFgkwtxkwJsC0rIq_e48M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeEYIRPWUbh3RhUJQZP7xBcqoKcf4AGK2nDQUJ4wZjMA&oe=6AF9D8D9"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEqJr_JLMcEQ7kNvwHVDu87&_nc_oc=AdoNM-NPFh142pxNqwXbWJTOjpibLZX5OX59S30w4IqVjGqP8XOQhN5PgQnhTe9Bevs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_knj3rlOgYSAQ6ATEN9Q_JopN-Qu2ZAV8JxWH_Bp1FQ&oe=6AF9BF32"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiB9QGJ0c14Q7kNvwEqmK7Y&_nc_oc=Adrt2pwrHeNotl8vqUrnKhoXsqJvvBdDPm9ugIVv4nRieNNvzCrgRSwAzUGD3Fil4oI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWrZ_AItewx9QowdOrusu3-kueO1lWkl8zX6zZfvePxA&oe=6AF9BFC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzCPcXxBmMAQ7kNvwHrd6Fj&_nc_oc=AdqrgayVYfkcHu1AQ47hgI5js1BeN6tkk7rhxqVafTJkb327fOKqWK3hUWhfQ9TdLPw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYrtNRnIYsjNmDXyqfyN3vRwUf56rbu6izXxmJEE0wnw&oe=6AF9D962"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
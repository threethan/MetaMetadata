?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F617RfGLBbcQ7kNvwEWwxaJ&_nc_oc=AdoeAP7lg8H1jnuuTQgiZRSOP9CVbU4AiRxtIguNKvlDscxCh6BObmK9iivEDlGotuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwpscBBSZh-ilwnIrY3NC_auyQHEC9RuwGx1fE4Yvn0g&oe=6AE74734"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akukx6MvPHIQ7kNvwFqrzR6&_nc_oc=AdpUMrLbGCAk5qFZ_1ZG_zrd5JlvibPNS6OHs8R_-QYJc7M4ttnK9MAExTTWG5Klit0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWWaoyYKGpCxcMqISTwORV-51beQmtUeGixtHEThBEdg&oe=6AE763D9"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzD4E3IRuUwQ7kNvwFp2mKe&_nc_oc=AdrmTKSQXW9RAELTvNX4I_m7rG0Do9j1s5A0xBKIzJYQGQPB3CgbQJ1sELGXgFCx0Mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkTEW_uQ_zYoJyQe2JohvgCxN_bMdHdXdA2DEReM1JqA&oe=6AE74A32"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OoiI_3dY6MQ7kNvwFG343A&_nc_oc=Adp4DHDhkBp_BErMO5QfnhRw4D8cS0nTHOPXzdKHR0jjq44FkXmf4u4-oKqqBuY74X4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROuBivsCOue_NdJyoZVZ3IQXohxQ9rFtrH1ZRb4Qp__A&oe=6AE74AC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6v_d0NJvnQQ7kNvwGROQFA&_nc_oc=Adp9zTc15E0t6hJRmQgiQrolFr7mtMql0DvOOQ5vD0yM8ahrr_U-VBQfj8m59Y4SAs0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWKCOh-7mic_DiC1CJvOTd4xWqKIHt8VX9kv4LD7L0Ew&oe=6AE76462"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
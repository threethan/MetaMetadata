?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F617RfGLBbcQ7kNvwGo8St_&_nc_oc=AdrRwgcqWEH49hIOZDlEk_F0OHyloD9-fHzHw2q6fV0b60XIDYjGSeuX04PGkjAR9Jo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSspG5iKpzibqq-tr0rVqFJuT39H8Md4dJi1Xnt3u4tUA&oe=6AE898B4"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akukx6MvPHIQ7kNvwFogoE1&_nc_oc=AdpPoGBErLfsXUZV_GTFz_GgCkpOAq-oVJAyIeJUl2GRyB9VmAn2aPy1wTrTF48qKgs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQla_dxsRl9IfRrB45AJ6ByeqF4Sv_2DbSAfLlwBhbFkg&oe=6AE8B559"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7bSsTOTi1sQ7kNvwFK-z_k&_nc_oc=Adoc47D0pFSwqn2uG6aZurMwB7F6r-5fNgwWFkyCz9d4loiElm-5ubigGXBgMNVE3_U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKwuF_ATWVQSTEhKuaNrwdp-ig-tYdw6JWYYUvd1Byyg&oe=6AE89BB2"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ABJrKcpX-wQ7kNvwHZU-OL&_nc_oc=AdrU-TWR1nD9XpunAFYbIIkxEEMSIxBPs7ZY6l8V0fvBD4-Vng_JLKcLneNMzEwUNd8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiY3S89pSRUofNKu6DrDNNx4DaSAUmN_xVldyCgzCb_A&oe=6AE89C44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_5S0Px1OnsQ7kNvwHG20zd&_nc_oc=AdqFlF5_SbSTvRRXWxqWMb_vADwvo2WlLTxuyr6m_s5LeLDFGi9JeE6L4hbK5I0bdOw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkfkNkgdFYSeK7izdiNpmMVaiJ41fvmZJDXOg6OUNPAw&oe=6AE8B5E2"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
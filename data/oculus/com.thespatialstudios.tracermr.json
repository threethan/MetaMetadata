?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrxSY8210MMQ7kNvwG_D8Ag&_nc_oc=AdqTBe-Dj4Qtu6P8ug1Pm0YvLPJN1qzCSkK4K-gGhExwNKAxrxva90_dAIgezjDoFHE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMe7M50w3D9LXrCNyi_jbkwKRsGxaqcvSE0w-M-HRt_w&oe=6AEF6874"}, {"file_name": "screenshot_3.png", "id": "1886028452562622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_1886028455895955_129622018516878070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=145Z2NSvoB8Q7kNvwEHeRG1&_nc_oc=AdpVfbzDj_BBkPXqagtQn8phVe2HZ4J5ehMrUj3dnwCBTw6dir82xE_Ks-nEqdtkeoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWgy2onxWuqU-kBUiZ3LH2fbouM3gkffGxI6WcKHK7yA&oe=6AEF4CD9"}, {"file_name": "screenshot_5.png", "id": "1078798784927219", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_1078798788260552_14916125302430101_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gj5WWAsmYcQ7kNvwGkx5GV&_nc_oc=AdpkHYtNGQTM6fYzovIFeYeOiatkgsDsnBrp3sPxFOMpppTs2XVlvkxmAJXRyNGN-y0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcbW6Io3s13xruU5nROQUVLTIQz3Mm4hrJ_PhpRU12tA&oe=6AEF3332"}, {"file_name": "screenshot_4.png", "id": "1365234412132026", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1365234415465359_8825300279507934677_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OshJ4EsybsQ7kNvwEK2Fxm&_nc_oc=AdqOWUR4BKYPB7sCBvDa5TL20tYeNavzZ58Ghgy-EJGAOqN_-cQV_ZfLya11hFnBnaw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqQ0U1OmSjkp_g5Nnjpa6xEztzEPexsVuLaASYId66bw&oe=6AEF33C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "1791666935412208", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_1791666938745541_8648290330020497764_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgN4HK3Nd6oQ7kNvwHFOcIA&_nc_oc=AdpAbaKH9MH5pmSNAKueS0dcpcoVaDuSKgCXHfqachtut0pGWF3THSlDhVW54DELin8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1HTUADsJm-QcYg2RCoBj8KfTPMtbUZlTdWQyoXk9x0w&oe=6AEF4D62"}, "display_name": "TracerMR", "keywords": ["Drawing", "Draw", "Painting", "Art", "Kids"], "long_description": "Trace Anything. Create Anywhere.\n\nTracerMR brings your images into mixed reality so you can use them as a visual guide while drawing, sketching, tracing, or practicing.\n\nSimply bring an image into your Quest, position it in your space, and start tracing it naturally in mixed reality. Your reference stays visible while you work, letting you focus on your lines without constantly looking back and forth between a screen and your drawing.\n\nWhether you're learning to draw, practicing a new subject, recreating an illustration, or simply experimenting with mixed reality, TracerMR turns your Quest into a hands-free visual tracing tool.\n\nYour image. Your space. Your creativity.\n", "short_description": "Trace your favorite images in mixed reality with TracerMR.\nBring your images into your space, position and resize them, and start drawing.\nPerfect for artists, beginners, practice, and creative projects.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zarakob.github.io/TracerMR/", "developer_terms_of_service_url": null, "publisher_name": "Zarak Khan", "support_website_url": null, "website_url": "http://Devstackstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_t
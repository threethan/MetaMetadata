rAjIx_GmkLcjJiIkvwI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FEt34TBcTyZg1JOdzWepZkG3mk73fDYvJJt8WlY8unA&oe=69E39672"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape1.png", "id": "915496134401409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825470_915496137734742_7747993497519194354_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLDbb7Z9h1AQ7kNvwHUdeBp&_nc_oc=AdqhpvHtyzhqgBK_FoFv1SCmoOE_fNXI5GKIElqkIVLzQ_XcSZF9XQ7ePJSkEA_hQBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24g_JUXssIjPYPsfGk-riaYsQVGVxG4YMGd8Ct18pzbQ&oe=69E39331"}, "display_name": "Route Master Bus Simulator : Off-Road", "keywords": [], "long_description": "Gear up for the most demanding bus driving challenge yet! Route Master Bus Simulator: Off Road throws you into the driver's seat of powerful all-terrain buses, built to conquer the wilderness.\n\nTest your skills on unforgiving mountain trails, muddy jungle paths, rocky desert tracks, and remote rural roads. Every route is a new adventure where precision driving, careful gear management, and a steady hand are the keys to success.\n\nFEATURES:\n\nVR Immersion: Feel every bump, tilt, and skid in stunning virtual reality.\n\nConquer Extreme Terrain: Drive through dynamic weather and hazardous landscapes that push your vehicle to the limit.\n\nMaster Your Bus: Handle realistic bus physics, manual transmissions, and all-wheel-drive systems.\n\nComplete Challenging Jobs: Pick up and drop off passengers on time across a variety of dangerous and scenic off-road routes.\n\nUpgrade & Customize: Earn your way to better buses and personalize them for the trials ahead.\n\nProve you have what it takes to keep your passengers safe and on schedule, no matter what the trail throws at you. Your license to adventure awaits in Route Master Bus Simulator: Off Road \u2013 where the road ends, your mastery begins.", "short_description": "Become the ultimate off-road bus driver! Navigate treacherous terrain, master challenging routes, and deliver passengers safely in this realistic and thrilling VR bus simulator. Are you the Route Master?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gameonstudios/home", "developer_terms_of_service_url": null, "publisher_name": "Game On Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/gameonstudios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26235383462763706"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822307_1238195741079067_6275720544196509532_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6wv7Gtst9sQ7kNvwFGNyYv&_nc_oc=AdrV1y2olmk-9y05QClAPfQ0TTiJnzUerPyLzRlWH9yMlerqosnsYwtx9L5N9Qfl8sw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BiJk60bTaLXghXA_mGZDel9d2MCefYSSLZCegNKBBzQ&oe=69E397C3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Route Master Bus Simulator : Off-Road", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1771245720, "las
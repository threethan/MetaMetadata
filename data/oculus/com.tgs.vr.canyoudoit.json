k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43biRhOunRVqBn1BoWWy0uJnGpkxvOCDT3ObAvDddYmg&oe=6A1D8EAC"}, {"file_name": "NPcbuild Screenshot 2021.02.25 - 15.03.51.30.png", "id": "387339895748339", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031638_387339899081672_8407340713667451402_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_G6FD4H3FqkQ7kNvwF4fk0q&_nc_oc=AdoOVYFuFeFhjYZL2A9j0q1VEpFmzZlTTsv0hryAQrKSVxG-R_nQ9MOObuMVWzNtOFc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uXqdahD-JdysMS2v4cGaONKALSUrkMAN6befK9VuoJA&oe=6A1DA3C7"}, {"file_name": "NPcbuild Screenshot 2021.02.25 - 15.01.47.82.png", "id": "4012435722207959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031322_4012435732207958_3100689301828259796_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IObnE4xyWEYQ7kNvwGjku62&_nc_oc=AdozvW3tXKH3m65yXkpZo6wmgwVtVcrqwCnGiMQKFh9j8U2PYQmDR8udeZbCBTYLuvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6E0VHI5x81Bemv9GDuSnPGQlXUaageF1Nbhl2KXPPp-Q&oe=6A1D86F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "186704189490343", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462206_186704199490342_8127873361575264646_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYBSEPPNuFwQ7kNvwFo5WYq&_nc_oc=AdoVv9gcPpkN7br8AIkkY6xfhCVsAaebIO1u1Ct4FjYlUqIEM1odIDXoex1Jq_ClPUU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U5Q3uFxWVlQAut10Ww_ds_RI4m5Vrl9_gfGvfyOS3nA&oe=6A1D76F7"}, "display_name": "Can You Do It - VR Experience", "keywords": [], "long_description": "Can You Do It is the epic experience of Virtual Reality Technology.\n(Supports 90Hz/120Hz on Oculus Quest 2)\nExperience and play with hang gliding, city crossing, shooting, ladder climbing, zip-lining, Elevator failure, and many more coming soon in an update.\n\nCan you do it? If Yes then don't release the grab button during play else you might fall down.\n\nPlay in free mode and time challenge mode.\n\n+++ Features +++\n= Gun Hunt Mode\n= Hand Gliding\n= Dual Rope Crossing\n= Zip Lining\n= Elevator Failure\n= Ladder Climbing\n\nExperience city from the top of the sky by doing Hang Gliding, Feel real - Climb the ladder and cross the road with rope, shooting, like a real experience.\n\nExperience the power of virtual reality.\n\n(To enable 120Hz, open the universal menu, go to Settings > Experimental Features, and then enable 120 Hz, Software version 28 required)", "short_description": "Climbing, Flying, Shooting, Falling, Handling and more fun"}]}, "developer_name": "Thunder Game Development Studio", "developer_privacy_policy_url": "https://www.thundergamestudio.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.thundergamestudio.com/privacy_policy.html", "publisher_name": "Thunder Game Development Studio", "support_website_url": null, "website_url": "https://www.thundergamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["GAMEPAD_VIA_TOUCH", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1135453547233463"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "3393805104129810"}, {"status": "PUBLISHED", "id": "2029592634288480"}, {"status": "PUBLISHED", "id": "9651883859
oculuscdn.com/v/t64.5771-25/75462206_186704199490342_8127873361575264646_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2M8a51SBjcMQ7kNvwF2J3CO&_nc_oc=AdqTsw0P10omUk4mP2gg2cHOmi8OO5jpLQhNDV2_Yx3h4Svu1_-8EVGU93wqTr2FmLk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShy5Ep1P7OysrdN34sOspaoxjukn2AsoBQ6Mg1OtAIZg&oe=6B031437"}, "display_name": "Can You Do It - VR Experience", "keywords": ["climbing", "shooting", "adventure", "fun", "experience"], "long_description": "# **Can You Do It \u2013 VR Experience**\n\n**Can You Do It** is the **epic VR experience** that pushes your limits in **immersive virtual reality gameplay** on Meta Quest.\nStep into a thrilling **VR simulator** packed with adrenaline-pumping challenges: **hang gliding, city crossing, shooting, ladder climbing, zip-lining, elevator failure** and many more coming soon in free updates.\n\n**Can you handle the height, speed, and precision?** If yes, then hold tight \u2013 because if you let go of the grab button, you might fall!\n\nPlay in **Free Mode** to explore or in **Time Challenge Mode** to test your speed and skill.\n\n+++ **Features** +++\n\n* **Gun Hunt Mode** \u2013 Aim and shoot in realistic VR shooting gameplay\n* **Hang Gliding** \u2013 Soar through the sky with breathtaking city views\n* **Dual Rope Crossing** \u2013 Balance across high ropes between buildings\n* **Zip Lining** \u2013 Speed through the skyline in thrilling VR rides\n* **Elevator Failure** \u2013 Feel the tension in realistic VR survival moments\n* **Ladder Climbing** \u2013 Experience height and balance challenges in full VR\n* **Helicopter City Experience** \u2013 Fly through the city at different speeds, experiencing the thrill of aerial navigation\n* **Spider-Man Web Experience** \u2013 Swing through the city using web-like mechanics, feeling like a superhero in full VR\n{2570128149997401}\nEnjoy **realistic VR physics**, **immersive 3D environments**, and a variety of adventure & action challenges designed for **Meta Quest VR gamers**. Whether you love **extreme sports VR** or **realistic climbing simulators**, this is your next **virtual reality adventure**.\n\n{1462974381559413}", "short_description": "\"Can You Do It\" is an action-packed VR experience. Test your skills in hang gliding, rope crossing, shooting, ladder climbing, zip-lining, helicopter experience, spiderman web experience, and more. Enjoy immersive gameplay, realistic VR physics, and thrilling challenges in this ultimate virtual reality adventure and VR simulator."}]}, "developer_name": "Thunder Game Development Studio", "developer_privacy_policy_url": "https://thundergamestudio.com/policy/metapolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Thunder Game Development Studio", "support_website_url": null, "website_url": "https://www.thundergamestudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28472167042476075"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75429292_766368654084324_5897401224434428264_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZpZiqQ5y6QQ7kNvwEwVv6a&_nc_oc=Adq28y1kj
25569456197643_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aMHDs7ItEUQ7kNvwFy1TsZ&_nc_oc=AdlFg__-22_bJMY23GpJ74Tzdgvgk0kXAmgG6hReymqwuZUoBxcFzmk9Q3EyCWjt-y0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftD6wvqc0AEovMh6jZB2QkJM8WwF-OObC-0-fpDBbCMJg&oe=69A6CAFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_Quest.png", "id": "212483057592508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75367594_212483060925841_4649205383762646054_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9U0SR3OhMoAQ7kNvwHx2DRW&_nc_oc=AdnF1XL9FtqX7w50HvjGlCtpCcKoEx-Apff2atnY8bHX5qq2e2QDu-3WzfL24UeCaJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvgZP9C0wZSVlrNSVvxNH6JWGocD9MtofsM6JyN9R1arA&oe=69A6CCF6"}, "display_name": "Space Docker VR", "keywords": [], "long_description": "A \u201cNewtonian physics\u201d space-flight simulator for VR! \nGet in the cockpit, pilot a spacecraft, navigate hazardous environments, and compete with your friends to become the ultimate docker!\n\n\"There's no drag in space\" -- Realistic physics means that 'docking' becomes a skilful task, as you learn to master your momentum.\n\nFeatures\n- Career Mode: authored missions with unique twists to train and test your docking abilities\n- Additional Procedural Content: Weekly missions, as well as 'on-demand' random jobs\n- Race Mode: push your flying skills to the max\n- Re-bindable Virtual Cockpit Controls\n- Compete via Friends/Global Leaderboards\n- Unlockable Achievements", "short_description": "A \u201cNewtonian physics\u201d space-flight simulator for VR! \nGet in the cockpit, pilot a spacecraft, navigate hazardous environments, and compete with your friends to become the ultimate docker!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catcommandos.com/sdvr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cat Commandos Ltd", "support_website_url": "https://www.catcommandos.com/contact", 
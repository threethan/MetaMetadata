8&oh=00_Afydb5TzAvimKMAF6mhGaAomJ864E9UPBdj3QhASTbv4Mw&oe=69B2ACB8"}, {"file_name": "4_SCREEN_Flight101.png", "id": "145517417797439", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568684_145517421130772_1401625569456197643_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_7DfudkywEQ7kNvwHn4uxy&_nc_oc=Adk1uyvQNA6EmWEAU1aaBqb1OUoCNBXb2xjLjEclYIjzvTzDEqquRvj36f1EE0uCw9k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyx8WOOAzYUQt9xARn7v-SbNS2CxBieJKFE3IStVQ-MAA&oe=69B2A87B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_Quest.png", "id": "212483057592508", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75367594_212483060925841_4649205383762646054_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTELK5_gXEsQ7kNvwFzwCwp&_nc_oc=AdkjMJWvCylLWslf5S02TAsuC5HKV0UaGIGOtkDj2SVmXJz8tU8JJQ4tpzfRhWVWRMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-NhDY5dpzdd1nQZjurk7WD8wGdSSUVTEuyxtlzABkgg&oe=69B2AA76"}, "display_name": "Space Docker VR", "keywords": [], "long_description": "A \u201cNewtonian physics\u201d space-flight simulator for VR! \nGet in the cockpit, pilot a spacecraft, navigate hazardous environments, and compete with your friends to become the ultimate docker!\n\n\"There's no drag in space\" -- Realistic physics means that 'docking' becomes a skilful task, as you learn to master your momentum.\n\nFeatures\n- Career Mode: authored missions with unique twists to train and test your docking abilities\n- Additional Procedural Content: Weekly missions, as well as 'on-demand' random jobs\n- Race Mode: push your flying skills to the max\n- Re-bindable Virtual Cockpit Controls\n- Compete via Friends/Global Leaderboards\n- Unlockable Achievements", "short_description": "A \u201cNewtonian physics\u201d space-flight simulator for VR! \nGet in the cockpit, pilot a spacecraft, navigate hazardous environments, and compete with your friends to become the ultimate docker!"}]}, "develo
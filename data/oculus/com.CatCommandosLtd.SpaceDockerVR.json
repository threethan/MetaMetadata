8&oh=00_Afz7fZFKxs8AgnvTIzWmYyV6cNJcTVEDvWYNRXYlvEw-nA&oe=69B7F2B8"}, {"file_name": "4_SCREEN_Flight101.png", "id": "145517417797439", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568684_145517421130772_1401625569456197643_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qosoHSp0TVwQ7kNvwEgjy17&_nc_oc=AdkzVZibmRkOk4SItTl6h3uyX5HSx7aXxXV0KWPMkG9-6cYAi1R33ejixAZrIL6cm2E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0rhZq3s4_3T3Udk-PVQPRdTTTSYVxvr1iq1RYVujI4g&oe=69B7EE7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_Quest.png", "id": "212483057592508", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75367594_212483060925841_4649205383762646054_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PS0kKGdzvAIQ7kNvwFqGxd0&_nc_oc=AdmXscSUKVFXmvivPluw-czp64tRuBZFHat7t36tuWt4HeK-qv7Gq_F8OcISFI3A1UM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmWldsd048EvKcPZ2HrRiCNbZ5ldpvZXdCLgWIYDEbZw&oe=69B7F076"}, "display_name": "Space Docker VR", "keywords": [], "long_description": "A \u201cNewtonian physics\u201d space-flight simulator for VR! \nGet in the cockpit, pilot a spacecraft, navigate hazardous environments, and compete with your friends to become the ultimate docker!\n\n\"There's no drag in space\" -- Realistic physics means that 'docking' becomes a skilful task, as you learn to master your momentum.\n\nFeatures\n- Career Mode: authored missions with unique twists to train and test your docking abilities\n- Additional Procedural Content: Weekly missions, as well as 'on-demand' random jobs\n- Race Mode: push your flying skills to the max\n- Re-bindable Virtual Cockpit Controls\n- Compete via Friends/Global Leaderboards\n- Unlockable Achievements", "short_description": "A \u201cNewtonian physics\u201d space-flight simulator for VR! \nGet in the cockpit, pilot a spacecraft, navigate hazardous environments, and compete with your friends to become the ultimate docker!"}]}, "develo
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwCn6Dv9sWzuRUgCSRJvBLATfKmrfldjoArsSurGJ-oQ&oe=6B0705B6"}, "display_name": "Space Docker VR", "keywords": [], "long_description": "A hardcore space-flight simulator for VR! Get in the cockpit, pilot a spacecraft, and navigate hazardous environments on a journey to become an expert docker!\n\n\"There's no drag in space\" -- Realistic Newtonian physics means that 'docking' becomes a skilful task, as you learn to master your momentum.\n\nFeatures\n- Career Mode: authored missions with unique twists to train and test your docking abilities\n- Random Jobs Content: Weekly missions, as well as 'on-demand' procedural work orders\n- Race Mode: push your flying skills to the max\n- Customizable virtual cockpit controls\n- Compete via Friends/Global leaderboards\n- Unlock flair and upgrades for your cockpit", "short_description": "A hardcore space-flight simulator for VR! Get in the cockpit, pilot a spacecraft, and navigate hazardous environments on a journey to become an expert docker!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catcommandos.com/sdvr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cat Commandos Ltd", "support_website_url": null, "website_url": "https://www.catcommandos.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7894835707260614"}, "rev
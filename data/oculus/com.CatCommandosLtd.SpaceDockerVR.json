25569456197643_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxwGsMbPFcsQ7kNvwEGOgCj&_nc_oc=AdnBQ58B0ndA0TGycB6O_8rIbG6P3fxL57AbNwmzOsyYsDjb6nPv71jFfEOgXidsTQ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvV0_K1Vne5eqLHAFISR1UErW3rjGXOLWXgkx9r0VYKHA&oe=69A0337B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_Quest.png", "id": "212483057592508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75367594_212483060925841_4649205383762646054_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBZYQBEhh3sQ7kNvwFCO_2p&_nc_oc=AdladKofYpyiumFS9_AvztYlpVkj79EOSEsu18tBsKzF3LKZAiTMaczFZx2fFfyeykw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftfrRMqCHXj7yiZOqWh8bAs27nMmjXpQQ78l7azMaYnlQ&oe=69A03576"}, "display_name": "Space Docker VR", "keywords": [], "long_description": "A \u201cNewtonian physics\u201d space-flight simulator for VR! \nGet in the cockpit, pilot a spacecraft, navigate hazardous environments, and compete with your friends to become the ultimate docker!\n\n\"There's no drag in space\" -- Realistic physics means that 'docking' becomes a skilful task, as you learn to master your momentum.\n\nFeatures\n- Career Mode: authored missions with unique twists to train and test your docking abilities\n- Additional Procedural Content: Weekly missions, as well as 'on-demand' random jobs\n- Race Mode: push your flying skills to the max\n- Re-bindable Virtual Cockpit Controls\n- Compete via Friends/Global Leaderboards\n- Unlockable Achievements", "short_description": "A \u201cNewtonian physics\u201d space-flight simulator for VR! \nGet in the cockpit, pilot a spacecraft, navigate hazardous environments, and compete with your friends to become the ultimate docker!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catcommandos.com/sdvr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cat Commandos Ltd", "support_website_url": "https://www.catcommandos.com/contact", 
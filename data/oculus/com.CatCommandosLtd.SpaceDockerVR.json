.com/sdvr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cat Commandos Ltd", "support_website_url": "https://www.catcommandos.com/contact", "website_url": "https://www.catcommandos.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1017856772101593"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "981538228376018"}, {"status": "PUBLISHED", "id": "2693580954310712"}, {"status": "PUBLISHED", "id": "1321352949731693"}, {"status": "PUBLISHED", "id": "1410427880247283"}, {"status": "PUBLISHED", "id": "1162624988923475"}, {"status": "PUBLISHED", "id": "1108176990933117"}, {"status": "PUBLISHED", "id": "1027132569098667"}, {"status": "PUBLISHED", "id": "1167105064382900"}, {"status": "CANCELLED", "id": "1018367116438970"}, {"status": "PUBLISHED", "id": "857878953106618"}, {"status": "PUBLISHED", "id": "672117304227495"}]}, "baseline_offer": {"id": "672117304227495"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "981538228376018"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25879958094988433", "version": "0.2.215"}, "id": "953261628786403", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typena
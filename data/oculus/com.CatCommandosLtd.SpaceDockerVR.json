25569456197643_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxwGsMbPFcsQ7kNvwF3mb42&_nc_oc=Adm8NIYkvTAYJGygl8HqYB7NzOfsBPIifbc0K9UGh5mSNWFhFKs0OkewPejd3DtdScQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMbc_4OrKdDfg8ltvG1KGlAWFQp3qNP5KRompc6hhGwQ&oe=699D907B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail_Quest.png", "id": "212483057592508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75367594_212483060925841_4649205383762646054_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8p24vXFGzIQ7kNvwFtHv0_&_nc_oc=AdkLAFiTslNhf4Erv28qYagPl-bbjDunOII9pGkqQuIqrjKnO8YaEifGZpUpxYE0yZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuIXOpvKqaBLPy8AAw-YWMjRIufCa6HL67h68InA8qVlg&oe=699D9276"}, "display_name": "Space Docker VR", "keywords": [], "long_description": "A \u201cNewtonian physics\u201d space-flight simulator for VR! \nGet in the cockpit, pilot a spacecraft, navigate hazardous environments, and compete with your friends to become the ultimate docker!\n\n\"There's no drag in space\" -- Realistic physics means that 'docking' becomes a skilful task, as you learn to master your momentum.\n\nFeatures\n- Career Mode: authored missions with unique twists to train and test your docking abilities\n- Additional Procedural Content: Weekly missions, as well as 'on-demand' random jobs\n- Race Mode: push your flying skills to the max\n- Re-bindable Virtual Cockpit Controls\n- Compete via Friends/Global Leaderboards\n- Unlockable Achievements", "short_description": "A \u201cNewtonian physics\u201d space-flight simulator for VR! \nGet in the cockpit, pilot a spacecraft, navigate hazardous environments, and compete with your friends to become the ultimate docker!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catcommandos.com/sdvr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cat Commandos Ltd", "support_website_url": "https://www.catcommandos.com/contact", 
-25/491823790_762895110145847_6958826102933603805_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKkmbfWrgZIQ7kNvwEtD_cf&_nc_oc=AdquozIVc2xkAHsGXCxg7zjrS5Ap6e17Y-KTCiDv3TRwdi60uPDt7N2HvalWf3uat9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8BqS04dk-QhW7Kh7vvwQHERSNgsetpD0b7wfAaS_gYQ&oe=6A7C4B4C"}]}, "id": "919461341074777", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "1655946822311546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_1655946825644879_5549145747409154794_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2kbU76A23AQ7kNvwGlq2qR&_nc_oc=AdrQIJlQKNziNDZ7DiMP_HdKMTgZc9NqNblwdrv9cyaY6VYOlhc7ua4Kig_sWBl6n4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-lc1bjyMG7utbPjMurRp4vTktsZip5jTbzR82WaQ6Hw&oe=6A7C4574"}, {"file_name": "screenshot6.png", "id": "1292048613029579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820387_1292048616362912_3239813944987540703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_YPJ0SLy3UQ7kNvwF_uOuk&_nc_oc=AdrMNSCt1zwK-hmyGYEhFA2HagmHRppXrXkalMPX_LpLYGke8a7dlKX8FPvJ-9QZ4AA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFNyosR9sO_RANzyMbp3oUo_ik43b4M1lL0Z41Oo78Lw&oe=6A7C5C84"}, {"file_name": "screenshot2.png", "id": "2507383819776479", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_2507383823109812_8407578872967366457_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuYjdP8icDoQ7kNvwFHnxfc&_nc_oc=AdqlNoqrkk1czBqwoKe9wMtTDfmOkAcZE1t6LInYTnHPOt4Uf7xDATHNql2JGwVbsh4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ9IW_gMy7S0lqqpEZVz7x1kirlU4AOjLvLyFXJ3g6VA&oe=6A7C719E"}, {"file_name": "screenshot3.png", "id": "1882901162391828", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1882901165725161_1226002220659682192_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p53BSgh7ZLkQ7kNvwFy5-Yh&_nc_oc=AdoG4frDPdoKzwaf8dlfgXxUkl2XbklfqhTHVIXADFS5ZJWItQ9Liwm6wpT9_8IZoBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs2zIHjITqTyz6Sw7ZwTnRfhgkTSwncF3fkgAFzsY_Ww&oe=6A7C62DC"}, {"file_name": "screenshot4.png", "id": "3451698914995243", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_3451698918328576_1718153503230931330_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgWJgl0WnQ8Q7kNvwGyU0kt&_nc_oc=AdpOBfapfm4hPnMzog8Lp1Cuhggoo4WEYeQK0GCCAPc0JuhmWsBvh3pK3vYJLjRSLy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQYfzeIVUfRKbhNv9kRqdGKfIN_WjwAHniywTwUc-BYg&oe=6A7C767A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Emei VR Video Player", "keywords": ["media", "video", "player", "cinema", "videoplayer"], "long_description": "**Emei VR Video Player** is a immersive video player built for cinematic media playback in VR. Enjoy your local, USB, and network media with high-quality rendering, powerful format support, and intuitive hands-free controls.\n\n# Features\n\n- Powerful playback engine with support for 8K VR video, AV1, and common media formats\n- Supports 2D, 3D, 180\u00b0, and 360\u00b0 video formats\n- Ambient lighting around the video panel for a more immersive viewing experience\n- Hand tracking and micro-gesture controls for media navigation\n- High-resolution UI designed for exceptional clarity and readability\n- USB storage support, including exFAT and NTFS drives\n- SMB and WebDAV network storage support\n- Advanced subtitle rendering with extensive customization options\n- External subtitle support\n- Video chapters support\n- HDR and Dolby Vision support\n- Passthrough mode with passthrough dimming\n- Multiple curved panel options for comfortable viewing\n- Optimized startup performance\n\n###\n\n\n# Coming Soon\n\n- Environments\n- Fisheye and frame-sequential 3D support\n- DLNA and FTP storage support\n- ISO playback support\n- Cloud storage support\n", "short_description": "Emei VR Video Player is an immersive VR player for playing local, USB, and network media. It supports 8K VR, AV1 and all other common video formats/codecs, 2D/3D, 180\u00b0/360\u00b0, HDR/Dolby Vision. It features advanced/external subtitles, USB exFAT/NTFS support, SMB/WebDAV, passthrough dimming, ambient lighting, curved panels, high-res UI, video chapters, hand tracking, micro-gesture controls, and fast startup. Coming soon: environments, fisheye/frame-sequential 3D, DLNA/FTP, ISO, and cloud storages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emeivr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "KJapps", "support_website_url": null, "website_url": "https://emeivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26918300151115644"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_762895110145847_6958826102933603805_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKkmbfWrgZIQ7kNvwEtD_cf&_nc_oc=AdquozIVc2xkAHsGXCxg7zjrS5Ap6e17Y-KTCiDv3TRwdi60uPDt7N2HvalWf3uat9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEE9jRq8TwJg0YVkKRG-IvwI1caiyNEI-JbW_kpDq2TgA&oe=6A7C4B4C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Emei VR Video Player", "platform": "ANDROID_6DOF", "context_
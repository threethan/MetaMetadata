content-atl3-3.oculuscdn.com/v/t64.5771-25/491823279_2507383823109812_8407578872967366457_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UcZcSkoa0sQ7kNvwEON_LZ&_nc_oc=AdqBhxl50FpCfpEfRN4HJShI60Gmyvg43_UuPwhEPIL-oled_ZYnKA7PABSsfCRQsi0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rowhOCghibWgFNnYGombSFK1zpm3OLoA-6gqKJEdaFg&oe=6A411E1E"}, {"file_name": "screenshot3.png", "id": "1882901162391828", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824322_1882901165725161_1226002220659682192_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rKjjrBvqlYQ7kNvwG8W4V-&_nc_oc=Ador3lEWISq5DjlD3vNwnQYSPdIz5nyqdPhF8iZbBjnO865AZ66v8lnswuDfgrVexbk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YuUdk3nOMwjOdwCs9RMUHBBClH3VcOZK-128b9IDSqw&oe=6A410F5C"}, {"file_name": "screenshot4.png", "id": "3451698914995243", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819859_3451698918328576_1718153503230931330_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpwDBgVtwiIQ7kNvwHTnfcx&_nc_oc=Adq5H4DsH8E6tHKihIWfKbyT0YWLLIaPy3C0wP3chbaPkzwnOUl9T6cnSQdBK5_JR2k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MT5jLREdOkjyJJF7NZPtFpjXrYgkloAdtQQKnYntanA&oe=6A4122FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Emei VR Video Player", "keywords": ["media", "video", "player", "cinema", "videoplayer"], "long_description": "**Emei VR Video Player** is a immersive video player built for cinematic media playback in VR. Enjoy your local, USB, and network media with high-quality rendering, powerful format support, and intuitive hands-free controls.\n\n# Features\n\n- Powerful playback engine with support for 8K VR video, AV1, and common media formats\n- Supports 2D, 3D, 180\u00b0, and 360\u00b0 video formats\n- Ambient lighting around the video panel for a more immersive viewing experience\n- Hand tracking and micro-gesture controls for media navigation\n- High-resolution UI designed for exceptional clarity and readability\n- USB storage support, including exFAT and NTFS drives\n- SMB and WebDAV network storage support\n- Advanced subtitle rendering with extensive customization options\n- External subtitle support\n- Video chapters support\n- HDR and Dolby Vision support\n- Passthrough mode with passthrough dimming\n- Multiple curved panel options for comfortable viewing\n- Optimized startup performance\n\n###\n\n\n# Coming Soon\n\n- Environments\n- Fisheye and frame-sequential 3D support\n- DLNA and FTP storage support\n- ISO playback support\n- Cloud storage support\n", "short_description": "Emei VR Video Player is an immersive VR player for playing local, USB, and network media. It supports 8K VR, AV1 and all other common video formats/codecs, 2D/3D, 180\u00b0/360\u00b0, HDR/Dolby Vision. It features advanced/external subtitles, USB exFAT/NTFS support, SMB/WebDAV, passthrough dimming, ambient lighting, curved panels, high-res UI, video chapters, hand tracking, micro-gesture controls, and fast startup. Coming soon: environments, fisheye/frame-sequential 3D, DLNA/FTP, ISO, and cloud storages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emeivr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "KJapps", "support_website_url": null, "website_url": "https://emeivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interact
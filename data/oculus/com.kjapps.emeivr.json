-25/491823790_762895110145847_6958826102933603805_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsCrQvGIf0YQ7kNvwHAebX3&_nc_oc=AdpQY3JEOEyhJoBhfsx6o1YBKUR0nEOESS72XUA2OvSBLXl2myCKGFcyuwa9WU5tFyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6MV71K5IybsKan5FEPToxCT1eJ8_cBYGGQyL1rAUYeg&oe=6A6A0E8C"}]}, "id": "919461341074777", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "1655946822311546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_1655946825644879_5549145747409154794_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cb_FDN-LTdcQ7kNvwHgDQLS&_nc_oc=AdpZpkB1s_Tghz4TSi4t2I64WCEYA2xUGCF6SSt3wScCYDb6mV_-3Wk1Y1eSdEaSxVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeuFGbOrDyyM_6tciCSxn9qEhd8TafVqN-dkfQtYx6dw&oe=6A6A08B4"}, {"file_name": "screenshot6.png", "id": "1292048613029579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820387_1292048616362912_3239813944987540703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adF7N57xAw8Q7kNvwF4go5b&_nc_oc=AdqSN2XkW5bj8p8XZSpU060RguMIoq9vaRMROjSsdQ8PkKyO3G5oXFdsoF6Tl1zzM5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFOk52-VJs_dLyPwxGV1lfyqGC5H_MGEILxf6kmGo2Tg&oe=6A69E784"}, {"file_name": "screenshot2.png", "id": "2507383819776479", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_2507383823109812_8407578872967366457_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4UpDu-ymKQQ7kNvwEJS2Xr&_nc_oc=AdrsQLWT4RRYzGWeJibfbXM273B-gAH73IUqztCFw3ltKCtZ1U6B1cFF5n2YrF9-UGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO3eOCTzOy06_BjIZOa5dvpyAYUW-xuySIv6p67qvMOQ&oe=6A69FC9E"}, {"file_name": "screenshot3.png", "id": "1882901162391828", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1882901165725161_1226002220659682192_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jy529HMx_aUQ7kNvwESSmPq&_nc_oc=Adoih8Fqd7DXGeN_kA_i5pQcnAPZAuMAu2pkZefVG5lq3c3Tgcov_D9wnCcIp5nGC0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYlIkahoy8VRmuPVR3w2-Li17Wx2uxkKZ_NltIWde5JA&oe=6A69EDDC"}, {"file_name": "screenshot4.png", "id": "3451698914995243", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_3451698918328576_1718153503230931330_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZwoqiD4w6QQ7kNvwHW52pR&_nc_oc=AdqVYdfWVKDKxSqHAr_kftczNU7mn6nm4uOvb-NvUb9met5HfwBaRE1v9rBxo3EKe9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaySQm59mCFq8s6fkLQytTMAObpdh1vglZtvR_PIAiQw&oe=6A6A017A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Emei VR Video Player", "keywords": ["media", "video", "player", "cinema", "videoplayer"], "long_description": "**Emei VR Video Player** is a immersive video player built for cinematic media playback in VR. Enjoy your local, USB, and network media with high-quality rendering, powerful format support, and intuitive hands-free controls.\n\n# Features\n\n- Powerful playback engine with support for 8K VR video, AV1, and common media formats\n- Supports 2D, 3D, 180\u00b0, and 360\u00b0 video formats\n- Ambient lighting around the video panel for a more immersive viewing experience\n- Hand tracking and micro-gesture controls for media navigation\n- High-resolution UI designed for exceptional clarity and readability\n- USB storage support, including exFAT and NTFS drives\n- SMB and WebDAV network storage support\n- Advanced subtitle rendering with extensive customization options\n- External subtitle support\n- Video chapters support\n- HDR and Dolby Vision support\n- Passthrough mode with passthrough dimming\n- Multiple curved panel options for comfortable viewing\n- Optimized startup performance\n\n###\n\n\n# Coming Soon\n\n- Environments\n- Fisheye and frame-sequential 3D support\n- DLNA and FTP storage support\n- ISO playback support\n- Cloud storage support\n", "short_description": "Emei VR Video Player is an immersive VR player for playing local, USB, and network media. It supports 8K VR, AV1 and all other common video formats/codecs, 2D/3D, 180\u00b0/360\u00b0, HDR/Dolby Vision. It features advanced/external subtitles, USB exFAT/NTFS support, SMB/WebDAV, passthrough dimming, ambient lighting, curved panels, high-res UI, video chapters, hand tracking, micro-gesture controls, and fast startup. Coming soon: environments, fisheye/frame-sequential 3D, DLNA/FTP, ISO, and cloud storages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emeivr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "KJapps", "support_website_url": null, "website_url": "https://emeivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26918300151115644"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_762895110145847_6958826102933603805_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsCrQvGIf0YQ7kNvwHAebX3&_nc_oc=AdpQY3JEOEyhJoBhfsx6o1YBKUR0nEOESS72XUA2OvSBLXl2myCKGFcyuwa9WU5tFyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6V5-1ojJZyGMZfU7PilKEegg3Dfbf3ro0pOWpss4JEw&oe=6A6A0E8C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Emei VR Video Player", "platform": "ANDROID_6DOF", "context_
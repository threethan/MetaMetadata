-25/491823790_762895110145847_6958826102933603805_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QywZgJvrNrcQ7kNvwHcJ47o&_nc_oc=Ado69hYVtfian4YFTdFfzyu0Jt0Q9e2lOf1eZrGCe-4Y8jT3AdIhP8ymGfPb6GpYcTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-Su3CbrK-suDxgHXALOWXOZnii_CLLPvOgOQzR_zPCQ&oe=6A6E030C"}]}, "id": "919461341074777", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "1655946822311546", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821115_1655946825644879_5549145747409154794_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_ClrJDdU44Q7kNvwGKsl5G&_nc_oc=Adp5KJGKyR55KfGiulkGKmjqxRD8zNiO7AyufQcGNnN61CSnx8tM0Qasntjd0G1nk-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArQy-Mh52KqQDxU4kK-p05ObjZZ12FD05ODKni5Ohltg&oe=6A6DFD34"}, {"file_name": "screenshot6.png", "id": "1292048613029579", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820387_1292048616362912_3239813944987540703_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnHysO9GHSsQ7kNvwEzkf42&_nc_oc=AdpCakVkKyiuY9s0bf8CSRnKfCTaY3tG7VAahRlxD6rsPMdKUPerhUg3Zft_w1IanKU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTQQ0wQasW6gsu8BqzFj4NjSkL0JVzRH_Vc0au51koWw&oe=6A6DDC04"}, {"file_name": "screenshot2.png", "id": "2507383819776479", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823279_2507383823109812_8407578872967366457_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgj50Ew-hAYQ7kNvwEWQ0DN&_nc_oc=AdqviS-zpdv-w1XGtqQ7BeO2NMYnA_tcg9RlvdNOpPICzARW0_fdGB3LC1AuhSEN1fg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZh1rTeBXagt7XvQU3X8i1Td7ERlPjWgd9YZ46MUs_YQ&oe=6A6DF11E"}, {"file_name": "screenshot3.png", "id": "1882901162391828", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_1882901165725161_1226002220659682192_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ua2dIND1GSQQ7kNvwHzOV7t&_nc_oc=AdqsGh0mZtYALAONuUg-dFlcTu9BKkcQsoPMLEHk4yJPDGtjPn6si5kWUvcmlO_S6zU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfT6z-01FodhDr44D8i-9v677I-Otwyv7GeCQj1a3q7w&oe=6A6DE25C"}, {"file_name": "screenshot4.png", "id": "3451698914995243", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819859_3451698918328576_1718153503230931330_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KonwnQ8FV_AQ7kNvwHwtA32&_nc_oc=AdrVJkJgcMysdsvs_uE8KZ6AdPv0w683XWSeUiow99CZ7jTIpy27ZCcOmW04eiKKUG0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1fKMncf1hWzh4FBz0ZgHoYe4ATAh-msLZ1aWljB_dbw&oe=6A6DF5FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Emei VR Video Player", "keywords": ["media", "video", "player", "cinema", "videoplayer"], "long_description": "**Emei VR Video Player** is a immersive video player built for cinematic media playback in VR. Enjoy your local, USB, and network media with high-quality rendering, powerful format support, and intuitive hands-free controls.\n\n# Features\n\n- Powerful playback engine with support for 8K VR video, AV1, and common media formats\n- Supports 2D, 3D, 180\u00b0, and 360\u00b0 video formats\n- Ambient lighting around the video panel for a more immersive viewing experience\n- Hand tracking and micro-gesture controls for media navigation\n- High-resolution UI designed for exceptional clarity and readability\n- USB storage support, including exFAT and NTFS drives\n- SMB and WebDAV network storage support\n- Advanced subtitle rendering with extensive customization options\n- External subtitle support\n- Video chapters support\n- HDR and Dolby Vision support\n- Passthrough mode with passthrough dimming\n- Multiple curved panel options for comfortable viewing\n- Optimized startup performance\n\n###\n\n\n# Coming Soon\n\n- Environments\n- Fisheye and frame-sequential 3D support\n- DLNA and FTP storage support\n- ISO playback support\n- Cloud storage support\n", "short_description": "Emei VR Video Player is an immersive VR player for playing local, USB, and network media. It supports 8K VR, AV1 and all other common video formats/codecs, 2D/3D, 180\u00b0/360\u00b0, HDR/Dolby Vision. It features advanced/external subtitles, USB exFAT/NTFS support, SMB/WebDAV, passthrough dimming, ambient lighting, curved panels, high-res UI, video chapters, hand tracking, micro-gesture controls, and fast startup. Coming soon: environments, fisheye/frame-sequential 3D, DLNA/FTP, ISO, and cloud storages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emeivr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "KJapps", "support_website_url": null, "website_url": "https://emeivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26918300151115644"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_762895110145847_6958826102933603805_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QywZgJvrNrcQ7kNvwHcJ47o&_nc_oc=Ado69hYVtfian4YFTdFfzyu0Jt0Q9e2lOf1eZrGCe-4Y8jT3AdIhP8ymGfPb6GpYcTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_1Oml_SUl8_9F5XjD1f-2Z4fYJQnkwyOUys_v-sIyMQ&oe=6A6E030C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Emei VR Video Player", "platform": "ANDROID_6DOF", "context_
AB"}, {"file_name": "04-add-server.png", "id": "1465911335506261", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1465911338839594_7580081139895577819_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_1Qdcy2X_MQ7kNvwGL4FrZ&_nc_oc=AdoSncymMgQG8_QMhr63wr6xFYk1lsnHP9Hy6IvUKDSxZ-9nuZ00oxmXu3GkhNamFD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpKij26pNDCmwBFU-5WVcTyIPjOjah7_l6BvrzxemNBw&oe=6AFDD4FD"}, {"file_name": "05-cinema-ambilight.png", "id": "2300700770712987", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_2300700774046320_6595180790835559840_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QoNAGxhAJMQ7kNvwHSrkJy&_nc_oc=Adrz9ih2Us5Wb82BKkN_szOF4X19wQi3BNOcseAdZjgalrWYwwBNAOuP1yr9ZpYgUOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLv3xszAigq99zf9CfpgmTbHcrSTjov138dFORNuhxKg&oe=6AFDD304"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Emei VR Video Player", "keywords": ["media", "video", "player", "cinema", "videoplayer"], "long_description": "**Emei VR Video Player** is an immersive player for your own videos. Play them from the headset, a USB drive or your network, and watch on a big screen in a home cinema, a dark void or your own room.\n\n# Ambient lighting\n\n- Soft light from the video surrounds the screen and changes with every scene\n- Choose how bright it is and how far it reaches into the room\n- In the home cinema, the film lights the walls; in passthrough, dim your real room around it\n- Flat or curved screen, at any distance\n\n# Plays it all\n\n- 8K VR, AV1 and all standard video and audio formats\n- HDR and Dolby Vision\n- DVD and Blu-ray disc images (.iso), including Blu-ray 3D (MVC)\n- 2D and 3D, 180\u00b0 and 360\u00b0, frame-sequential and many more\n- Chapters, tracks, playback speed and picture controls\n- Top-notch performance from a custom playback engine built for VR\n- Crisp, beautifully rendered subtitles, including styled and Blu-ray/DVD subtitles\n- Subtitles and audio in your preferred languages, picked automatically for every video\n\n# Your videos, wherever they are\n\n- Videos stored on the headset\n- USB drives\n- Network shares over SMB and WebDAV\n\n# Made for VR\n\n- Controllers or hand tracking, with micro-gestures: tap your thumb to pause, swipe it to skip\n- Sharp, high-resolution panels you can place anywhere around you\n\nQuestions, ideas or want to discuss the app? Join us on Discord: https://discord.gg/KaTHweqYjR", "short_description": "Emei is an immersive VR player for your own videos, from the headset, a USB drive or your network. Watch in a home cinema, the void or your own room, with ambient lighting that spills the picture's colors around the screen and carries every scene into your space. 8K, AV1, HDR, Dolby Vision, DVD and Blu-ray images (.iso) and 3D MVC. 2D/3D, 180\u00b0/360\u00b0, frame-sequential and many more. Superb subtitle rendering, top-notch performance, curved screens, chapters, hand tracking and micro-gestures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emeivr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "KJapps", "support_website_url": null, "website_url": "https://emeivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"],
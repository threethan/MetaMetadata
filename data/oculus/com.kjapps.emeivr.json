sJfr9x7XhY_wS1rqhdispxM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPpZLzietV1sNdAlTIDGXhnCXZ6oM-3PQxQPVdtLKrSg&oe=6A984A9C"}, {"file_name": "screenshot4.png", "id": "3451698914995243", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_3451698918328576_1718153503230931330_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apVroABfsFUQ7kNvwGTk0RW&_nc_oc=Adq_rgyCXk7JaHok46a2jyxzsnLNg2i-zVs2NekriEDA0UGmw9Wg0amiGkqTy0qXgfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAs-VJiimandGKTcJ5yPVxpIfA02owvMLz0c43Jm4vLQ&oe=6A985E3A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Emei VR Video Player", "keywords": ["media", "video", "player", "cinema", "videoplayer"], "long_description": "**Emei VR Video Player** is a immersive video player built for cinematic media playback in VR. Enjoy your local, USB, and network media with high-quality rendering, powerful format support, and intuitive hands-free controls.\n\n# Features\n\n- Powerful playback engine with support for 8K VR video, AV1, and common media formats\n- Supports 2D, 3D, 180\u00b0, and 360\u00b0 video formats\n- Ambient lighting around the video panel for a more immersive viewing experience\n- Hand tracking and micro-gesture controls for media navigation\n- High-resolution UI designed for exceptional clarity and readability\n- USB storage support, including exFAT and NTFS drives\n- SMB and WebDAV network storage support\n- Advanced subtitle rendering with extensive customization options\n- External subtitle support\n- Video chapters support\n- HDR and Dolby Vision support\n- Passthrough mode with passthrough dimming\n- Multiple curved panel options for comfortable viewing\n- Optimized startup performance\n\n###\n\n\n# Coming Soon\n\n- Environments\n- Fisheye and frame-sequential 3D support\n- DLNA and FTP storage support\n- ISO playback support\n- Cloud storage support\n", "short_description": "Emei VR Video Player is an immersive VR player for playing local, USB, and network media. It supports 8K VR, AV1 and all other common video formats/codecs, 2D/3D, 180\u00b0/360\u00b0, HDR/Dolby Vision. It features advanced/external subtitles, USB exFAT/NTFS support, SMB/WebDAV, passthrough dimming, ambient lighting, curved panels, high-res UI, video chapters, hand tracking, micro-gesture controls, and fast startup. Coming soon: environments, fisheye/frame-sequential 3D, DLNA/FTP, ISO, and cloud storages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emeivr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "KJapps", "support_website_url": null, "website_url": "https://emeivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26918300151115644"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_762895110145847_6958826102933603805_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8x7OQIxjFuoQ7kNvwFvuXdO&_nc_oc=AdrjS3f5I3hMQa55d2h3IMwTEUX3XPKBawqfhNIsTdXIyzpVnslKhl_uzlcbJd8E6UY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHgDXQdv3Ge_aiRFBQk1H1nV6o8LfitmHza03-As-k6A&oe=6A986B4C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Emei VR Video Player", "platform": "ANDROID_6DOF", "context_
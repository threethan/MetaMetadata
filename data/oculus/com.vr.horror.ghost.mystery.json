/v/t64.5771-25/39035385_742409631055655_4909940761295147975_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nc2odqqHKxQQ7kNvwEIJtQ9&_nc_oc=Adnoo_DeENl2D0OYXyvjC8OlsFSWcqR7eNO1p_XWSZEHFkEMeB-2a-GwmdAQMTrS4Lc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzbag5K_G6M-927JwvcDnjg3IEwaqMnaHJYH9fupHTX5w&oe=69B68E7C"}, {"file_name": "\u622a\u56fe010.png", "id": "407379448901774", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982712_407379452235107_1692871520243990106_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2_p2bNaroUQ7kNvwFMLcMw&_nc_oc=AdnrTmpVB1ymF3aKxuVuRJcKXiv_9P5ALVTlF1IGhmBNaL9myA7ltPy82F8WqYGazfo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1IaLn1UzTtrLsfxp5EOnaM5efTMoJesZ-0F3ObQWR8w&oe=69B68FDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440\u50cf\u7d20.png", "id": "803765327752192", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982572_803765331085525_3218085887941074641_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbAv8I8TMhcQ7kNvwFSGWOS&_nc_oc=AdlPghP-Ho22qzAoxrkKqomS1dqnJJ9XXJzQI5osEHZvwYJu2fXtpEnNLzUh8e-nGSw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPC4LvHjtBT6fVTkeZLFEOBY_NyCeRakjLDh-ZW-CJcw&oe=69B6AFE4"}, "display_name": "Horror: Evil Residents", "keywords": [], "long_description": "Horror: Evil Residents is a thrilling 4-player co-op, psychological horror adventure, where you step into the shoes of a brave exorcist, venturing alone or teaming up with friends to explore a mysterious mansion plagued paranormal forces. Armed with seven sacred artifacts, you'll delve deep into their powers to unveil the demons' true names, fulfill your exorcism mission, and claim hefty rewards.\n\n\u3010Multiplayer Co-op & Voice Chat\u3011\n- Co-op: Join forces with up to three friends in co-op mode, unearthing the terrifying mysteries hidden in the dark and revealing the demons' true names.\n- Custom Avatar: Choose the exorcist avatar of your own style.\n- Real-time Voice Chat: Stay in communication with your teammates, strategize together, share clues, and increase your chances of successful mission.\n\n\u3010Investigate\u3011\n- Demons: 10+ types of demons, each with unique features, personalities, and powers, offering a fresh experience with every exploration.\n- Sacred Artifacts: Seven artifacts of exorcism, each closely linked to a sin. Only by deciphering three sins can the demon's name be determined.\n- Unprecedented VR Immersion: Built exclusively for VR. Meticulously designed visuals and audio effects bring an unprecedented immersive experience.\n\n\u3010Hunting Mode\u3011\nDemons will do everything to scare you away, chase you off, or even kill you. Your sanity level is your only defense against the darkness. Once depleted, the demons will initiate hunting mode. Find the demons' names before your San value runs out! ", "short_description": "Horror: Evil Residents\" is a thrilling 4-player co-op, psychological horror adventure, where you step into the shoes of a brave exorcist, venturing alone or teaming up with friends to explore a mysterious mansion plagued paranormal forces. Armed with seven sacred artifacts:, you'll delve deep into their powers to unveil the demons' true names, fulfill your exorcism mission, and claim hefty rewards."}]}, "developer_name": "Suplife Games", "developer_privacy_policy_url": "https://vrsuplife.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Suplife Games", "support_website_url": null, "website_url": "https://vrsuplife.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": nu
scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827611_1081178418139247_2921572149364907420_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6X-T4fvvsgIQ7kNvwEajn9I&_nc_oc=AdpgQkpoVgUfr6iM3OSzRD24wYwyjoEmHttgcqrTizNyO1cwNdyFFaftcj5nVYqmeCE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCehvElH7okcogWtfnBbIq-XvH57vuaQC3Vj-uUeQJxQ&oe=6AF88E26"}, {"file_name": "screenshot-car-2560x1440.png", "id": "2225147308882065", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827601_2225147312215398_1305622301573777179_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfZfOTu6ulIQ7kNvwGHJNCN&_nc_oc=AdrDsPzv727sfMyP5JVpPsbq7-EN3M5cMLzCUSSRVPRhnRyLBrAhZJGqwWz1kft0PVI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHzk1ubNxZjLpsKcjwCowUuXJ9oZAR9nOih75gjbSdsQ&oe=6AF890B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Classic Paint", "keywords": [], "long_description": "## Create. Relax. Express Yourself.\n\n**Classic Paint** brings the timeless experience of painting into virtual reality.\n\nStep into your own creative space, pick up a brush, choose your colors, and start creating. Whether you have a specific idea in mind or simply want to experiment, Classic Paint gives you an intuitive and enjoyable way to paint in VR.\n\n### \ud83c\udfa8 Paint Your Way\n\nCreate at your own pace and explore your imagination directly in virtual reality.\n\n- Pick up your brush and start painting\n- Experiment with colors and creative ideas\n- Enjoy an intuitive, hands-on VR experience\n- Create without complicated workflows or distractions\n\n### \ud83d\udd8c\ufe0f A Virtual Space for Creativity\n\nClassic Paint is designed to make painting feel **simple, natural, and relaxing**. Focus on the canvas, experiment freely, and enjoy the satisfaction of creating something with your own hands.\n\nWhether you're discovering painting for the first time or you're an experienced artist looking for a new medium, Classic Paint offers an accessible creative experience.\n\n### \u2728 Your Canvas Awaits\n\nPut on your headset, enter your virtual creative space, and see where your imagination takes you.\n\n**Pick up a brush and start creating with Classic Paint.**", "short_description": "Step into a virtual studio and enjoy the simple pleasure of painting in VR. Pick up a brush, choose your colors, and create at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://paint.cadnodes.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rafa\u0142 Ostrowski", "support_website_url": null, "website_url": "https://paint.cadnodes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2869975486707805"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_2445655249298680_9042668088105567009_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Di8CTx2K_wMQ7kNvwH4mMb0&_nc_oc=AdpphjkZYaucnt0qRQHedT1TIITY0qh3fffquM0q_sJmDUafWzqKzLnUY_Bvuigazhk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP_k3g32rKIvWiIDTqNj-fkVH24ffXJCo0yqwpJUj7dw&oe=6AF89BC2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Classic Paint", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "3
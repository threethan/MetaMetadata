E2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerSplash.png", "id": "802053137461781", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974751_802053140795114_7471707500399662595_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKmz61B06vAQ7kNvwHDvIon&_nc_oc=Adq5B89K6pkOAFVxFZs-vX5L1VcRvKWxGsz85F0GxzXs8yHBOslIu3k7rI7rJaBUuRo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0qcECK4sy2k34qpf3hbfaNBXGgRqRuK5RFiEy_HGGaQ&oe=6AD24A49"}, "display_name": "Cactus Cowboy - Emilios Adventure", "keywords": [], "long_description": "The AR spinoff Cactus Cowboy mini game featuring Emilio in his very own Quest 2 Passthrough enabled adventure fighting the bugs in your home.\n\nYou help Emilio, the little cacti soldier, in his adventure. Climbing buildings, shooting enemies, helping friends and survive the relentless attacks. Even you as a player gets attacked by the evil forces and need to dodge shells and rockets.\n\n\nThis game requires Passthrough mode! Alternative VR mode available for Quest 1 users.\n\n", "short_description": "The award winning AR spinoff Cactus Cowboy mini game featuring Emilio in his very own Quest 2 Passthrough enabled adventure fighting the bugs in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cactusvrstudios.com/about/", "developer_terms_of_service_url": null, "publisher_name": "Cactus VR Studios", "support_website_url": null, "website_url": "https://cactusvrstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "s
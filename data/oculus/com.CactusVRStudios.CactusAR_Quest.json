y the evil forces and need to dodge shells and rockets.\n\n\nThis game requires Passthrough mode! Alternative VR mode available for Quest 1 users.\n\n", "short_description": "The award winning AR spinoff Cactus Cowboy mini game featuring Emilio in his very own Quest 2 Passthrough enabled adventure fighting the bugs in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cactusvrstudios.com/about/", "developer_terms_of_service_url": null, "publisher_name": "Cactus VR Studios", "support_website_url": null, "website_url": "https://cactusvrstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1182224799305696"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1454159722904012"}, {"status": "PUBLISHED", "id": "1391908372311650"}, {"status": "PUBLISHED", "id": "2726953451031272"}, {"status": "PUBLISHED", "id": "1665483754109074"}, {"status": "PUBLISHED", "id": "1429523958426885"}, {"status": "PUBLISHED", "id": "1126343979221064"}, {"status": "PUBLISHED", "id": "1771463480065630"}, {"status": "PUBLISHED", "id": "1122547333048287"}, {"status": "PUBLISHED", "id": "853813846718992"}, {"status": "PUBLISHED", "id": "692186608943561"}]}, "baseline_offer": {"id": "692186608943561"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 177644520
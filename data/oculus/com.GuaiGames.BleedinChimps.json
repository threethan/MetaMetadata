771-25/473393831_1331557198087035_8218733100414865701_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMXnIRRfJQUQ7kNvwGWBwT4&_nc_oc=Adk07IABObvUVclwambvGmSvVmiEbQGQEJPXAQtx_8tiiRshZYV3a4TlBbX42OpjamA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwW3irzlaVRzP-81TBypawg02nSpPgEH7hyoQ-_V28oFQ&oe=69BC0510"}, {"file_name": "aergegsrgser (5).png", "id": "506722142501806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394284_506722145835139_5259598749051883089_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZpFRP2ELBgQ7kNvwEWVgoD&_nc_oc=Adnhal_IwLH4FN7JIMxYiY89CsYV_vfqz6BFj_7frYODlO7WCJoqerQB5oqaxOpYrt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzXCurSjTYWZkoI7hpGcE2IRH5z501DD7_6467D3rY8gg&oe=69BC0AAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled Project (6).png", "id": "1707103050163746", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393831_1707103053497079_4760111756138893383_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StrAOb2ErxYQ7kNvwGVp9Og&_nc_oc=AdkmUqUKBg1rCDFeHh-kXr2wHrvHBsV_D7CE5IWParRoQQ5_h4sAS3PbPb5SGqjGejw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTV0ToaVKYFT_NnWa0rcDZBRQTY5tjHSiXzspXtzj0LQ&oe=69BBDFE8"}, "display_name": "Bleeding Chimps", "keywords": ["Bleeding", "Chimps", "Horror", "Scary", "Thriller"], "long_description": "A fun horror game where you run with your hands? In this game, you try to survive one of many maps by navigating with your hands. Meet and make friends along the way and try to survive the mysterious places. Either face you fears one to one or out number the competition with many friends up to 11 people (Including you!). While this game is still in work in progress and still needs some updates to finish everything. There are small amounts of lag and bugs, but that shouldn't stop you! Download Bleeding Chimps for the full VR horror experience! (WHILE MOVIN' WITH YOUR HANDS!!!)", "short_description": "A fun VR horror experience with friends!"}]}, "developer_name": "OdenPoden & RickyVR", "developer_privacy_policy_url": "https://sites.google.com/view/bleeding-chimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "OdenPoden", "support_website_url": null, "website_url": "https://sites.google.com/view/bleeding-chimps/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9387718337962694"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "9775101582540399"}]}, "baseline_offer": {"id": "9775101582540399"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742832000, "status": "PUBLISHED", "id": "9775101582540399"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9438779029523291", "version": "0.11"}, "id": "1164605908504792", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9348498075218054", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9438779029523291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1164605908504792"}]}, "
c_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb8lRRzxphjIQpmgLboFO3ByJi1q-S8b69acf2akxHgg&oe=6A6F2BE8"}, "display_name": "Bleeding Chimps", "keywords": ["Bleeding", "Chimps", "Horror", "Scary", "Thriller"], "long_description": "A fun horror game where you run with your hands? In this game, you try to survive one of many maps by navigating with your hands. Meet and make friends along the way and try to survive the mysterious places. Either face you fears one to one or out number the competition with many friends up to 11 people (Including you!). While this game is still in work in progress and still needs some updates to finish everything. There are small amounts of lag and bugs, but that shouldn't stop you! Download Bleeding Chimps for the full VR horror experience! (WHILE MOVIN' WITH YOUR HANDS!!!)", "short_description": "A fun VR horror experience with friends!"}]}, "developer_name": "OdenPoden & RickyVR", "developer_privacy_policy_url": "https://sites.google.com/view/bleeding-chimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "OdenPoden", "support_website_url": null, "website_url": "https://sites.google.com/view/bleeding-chimps/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9387718337962694"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scon
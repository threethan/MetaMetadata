 horror experience with friends!"}]}, "developer_name": "OdenPoden & RickyVR", "developer_privacy_policy_url": "https://sites.google.com/view/bleeding-chimps/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "OdenPoden", "support_website_url": null, "website_url": "https://sites.google.com/view/bleeding-chimps/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9387718337962694"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "9775101582540399"}]}, "baseline_offer": {"id": "9775101582540399"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742832000, "status": "PUBLISHED", "id": "9775101582540399"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9438779029523291", "version": "0.11"}, "id": "1164605908504792", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9348498075218054", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9438779029523291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1164605908504792"}]}, "
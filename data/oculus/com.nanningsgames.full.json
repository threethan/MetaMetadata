}, {"file_name": "ed0e956a1a8cb5a28bbbf5ec1956ab26.png", "id": "1191872286444647", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820441_1191872289777980_7662948543259879652_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5jVfCDY0AgQ7kNvwEO5xSB&_nc_oc=Adoha6tDcnynuMwRAJ0wHiKu6SFjJ_d9Gg1fNwSqjrxintS4obpEIpi2AqBdCupO4-4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yr8xh4H2J3kUnRsBx9KNVoUvbhLOMv5v1PtmZQE3VxQ&oe=6A22CCDB"}, {"file_name": "20e096324b925b31b20a9b4df7968772.png", "id": "1800724930563586", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819356_1800724933896919_6603648196888186356_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjfXTklKsQIQ7kNvwEHcw7o&_nc_oc=AdqJKYP20eAb7io4ZVq1ViaEMPpNMn91lM0yDrM0Fnyx72uYPKIAmsyagiAJmJx3z0c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hrJhBxUsQwJDggbFWbp7jrhMcnshItzF3kvjdqrS3wA&oe=6A22E0F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "library_hero.png", "id": "1576428020234538", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491825503_1576428026901204_8821921097681858327_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlcZs5HEXDYQ7kNvwHiw3Po&_nc_oc=AdpWbarCi_GWQIa1wvlUCO16udsmueonRvHDUPf9LiAm25fMK9QVQLB5KDa3EnMNqmE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yr1VFzQNuLY4IMs6OYq2cZLfStsE7Ym0TGRN4pnIBfg&oe=6A230082"}, "display_name": "The Gallery: VR Secrets", "keywords": ["puzzle", "relaxed", "museum", "gallery", "mistery"], "long_description": "Step Into The Gallery: VR Secrets\n\nImmerse yourself in a VR art gallery where every painting holds a hidden puzzle. Wander through 20+ rooms filled with interactive artwork. Interact with a varity of different buttons and switches to uncovering clues in a 3D world brimming with mystery.\n\nDelve deeper into the galleries, each alive with mind-bending challenges tied to the art around you. Decipher cryptic hints, manipulate paintings, and explore at your own pace. There are no timers, just pure discovery. The immersive environment draws you into a narrative of intrigue and beauty.\n\nCrafted with VR passion, this journey awaits. Wishlist now and prepare to unlock the gallery\u2019s deepest mysteries!", "short_description": "Step Into The Gallery: VR Secrets - Immerse yourself in a VR art gallery where every painting holds a hidden puzzle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nannings.nz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NanningsGames", "support_website_url": null, "website_url": "https://www.nannings.nz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26435837642669773"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491824318_1233526128986845_825607218310210448_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWliuZ3S7f4Q7kNvwHll7MY&_nc_oc=AdreJZagrWstjDLvwLeC6AeO7CzVlP9CzyGhxbYeyf5zu4Q8-LoRfymmq0ljZHADAPc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QeG93T9GdS-v0AKSuguSAof94q7Zz6vcKDU-uamEDfQ&oe=6A22DE4A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Gallery: VR Secrets", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GA
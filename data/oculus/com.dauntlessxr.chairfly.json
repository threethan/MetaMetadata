c=AdqaReJLa6l5-AslLr-mGyDITMz6Zfkrf95vwtMZzRvYDH_7zTkfN2yr-V5E2m98LQA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s3v_Vu4cvsktRk5YTHDxb1dTc7jiEBlrmVVSUUBCPzQ&oe=6A369B6A"}, {"file_name": "2.png", "id": "1642708476697737", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618103_1642708480031070_6819952978243252343_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43n3lKV2jzoQ7kNvwF68O4n&_nc_oc=AdpoMqDmLY_70FJk7kWxdAueSExoGWCOOstUWAi82holMmBExgJde42xTLkJZmlT1dw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93uMbnNIdD0voa8GJbEvbrgGOu3CWgWNQ2UGgNOYsQnQ&oe=6A369A36"}, {"file_name": "3.png", "id": "2311467875976721", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618235_2311467882643387_783567655747691745_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dee4Oyw85eUQ7kNvwHd-xXg&_nc_oc=Adr6BSmuM4vyNFW5K8KWabzou0ZTmoFRGpU34CmQg38PPIPXXD8G_WGR-qtd7Xd3vu4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O97Baj1q1UDpmTJtanvv4ZV6JLKRBRU_oJwA6iQ2I7g&oe=6A36B9BC"}, {"file_name": "4.png", "id": "1474053583814645", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617762_1474053587147978_5971392831088762027_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBzQGSVowCwQ7kNvwEGojsf&_nc_oc=AdrNrvYRvATb2ZKp1IikT24u9bkiyty5or-kOKTZe-nOlZGljR-OuIa3FTnSPoq7AWc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8avviAGDpWV1LnR0J-ZOad8uHEtX1P1ETiWFrzO5Uz5A&oe=6A36A818"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest Assets - Flight Deck (2560 x 1440 px).png", "id": "4289714801248205", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499298543_4289714804581538_4685964198935483194_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkiezkegjGcQ7kNvwEGGGGp&_nc_oc=Ado5Ez7vd0TxVOFwbMzp2gqsoXlJoYTfFVL4YcjEE4bAffDsjepp5YeeAA-np-ESmC0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BtURFuizAbHSR4rp_SlhRdY3bLF0YoZZvuX7CKgir7g&oe=6A36B0CC"}, "display_name": "Flight Deck", "keywords": ["cessna", "flight", "training", "pilot", "cockpit"], "long_description": "Upgrade your cockpit posters with Flight Deck: the most immersive and hands-on Cessna 172 cockpit experience. For student pilot\u2019s & licensed aviator alike, Flight Deck brings a true-to-size, high-fidelity 3D Cessna 172 cockpit into your living room.\n\nFlight Deck is a digital to-scale cockpit, that complements simulator time, but is not a flight simulator. Flight Deck lets you physically move through flows and cockpit procedures on the ground using your own hands, in mixed reality, no cockpit posters required. Save your simulator hours and your instruction time with your CFI for the tough stuff and put in the reps and sets to build your cockpit flow muscle memory from home. \n\n**Key Features:**\n\n- **Interactive Avionics:** Every switch, dial, and control is touchable, just like in the real aircraft.\n- **To-Scale Realism:** Step into a meticulously 3D-scanned Cessna 172 cockpit for maximum immersion.\n- **Hands-On Chair Flying:** Practice cockpit flows and procedures in a distraction-free environment.\n- **Affordable & Accessible:** Get professional-level cockpit training at home, without the cost or hassle of a simulator.\n\n**Why Choose Flight Deck?**\n\n- Build real-world cockpit muscle memory with hands-on repetition.\n- Practice flows and procedures using your own physical checklists anytime and anywhere.\n- Stay sharp and confident between lessons or flights.\n\n*Note: Flight Deck does not simulate flight or include built-in checklist automation. It is not affiliated with Textron Aviation.*", "short_description": "Transform your living room into a Cessna 172 cockpit and upgrade your pilot training experience. Practice real procedures, cockpit flows, and checklists in mixed reality with a to-scale and interactive 172 cockpit. No paper posters required."}]}, "developer_name": null, "developer_privacy_policy_url": "https:/
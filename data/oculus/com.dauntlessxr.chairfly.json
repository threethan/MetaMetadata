d=6e7a0a&_nc_ohc=Qae2_XXTKgYQ7kNvwEnv-pv&_nc_oc=AdqaReJLa6l5-AslLr-mGyDITMz6Zfkrf95vwtMZzRvYDH_7zTkfN2yr-V5E2m98LQA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s3v_Vu4cvsktRk5YTHDxb1dTc7jiEBlrmVVSUUBCPzQ&oe=6A369B6A"}, {"file_name": "2.png", "id": "1642708476697737", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618103_1642708480031070_6819952978243252343_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43n3lKV2jzoQ7kNvwF68O4n&_nc_oc=AdpoMqDmLY_70FJk7kWxdAueSExoGWCOOstUWAi82holMmBExgJde42xTLkJZmlT1dw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93uMbnNIdD0voa8GJbEvbrgGOu3CWgWNQ2UGgNOYsQnQ&oe=6A369A36"}, {"file_name": "3.png", "id": "2311467875976721", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618235_2311467882643387_783567655747691745_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dee4Oyw85eUQ7kNvwHd-xXg&_nc_oc=Adr6BSmuM4vyNFW5K8KWabzou0ZTmoFRGpU34CmQg38PPIPXXD8G_WGR-qtd7Xd3vu4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O97Baj1q1UDpmTJtanvv4ZV6JLKRBRU_oJwA6iQ2I7g&oe=6A36B9BC"}, {"file_name": "4.png", "id": "1474053583814645", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617762_1474053587147978_5971392831088762027_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBzQGSVowCwQ7kNvwEGojsf&_nc_oc=AdrNrvYRvATb2ZKp1IikT24u9bkiyty5or-kOKTZe-nOlZGljR-OuIa3FTnSPoq7AWc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8avviAGDpWV1LnR0J-ZOad8uHEtX1P1ETiWFrzO5Uz5A&oe=6A36A818"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest Assets - Flight Deck (2560 x 1440 px).png", "id": "4289714801248205", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499298543_4289714804581538_4685964198935483194_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkiezkegjGcQ7kNvwEGGGGp&_nc_oc=Ado5Ez7vd0TxVOFwbMzp2gqsoXlJoYTfFVL4YcjEE4bAffDsjepp5YeeAA-np-ESmC0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BtURFuizAbHSR4rp_SlhRdY3bLF0YoZZvuX7CKgir7g&oe=6A36B0CC"}, "display_name": "Flight Deck", "keywords": ["cessna", "flight", "simulator", "training", "pilot"], "long_description": "Take your pilot training to the next level with Flight Deck, the most realistic and interactive Cessna 172 cockpit experience available on Meta Quest. Designed for student pilots and licensed aviators alike, this app brings a true-to-scale, high-fidelity Cessna 172 cockpit into your living room. Practice anytime, anywhere without cringy posters taped to your wall. \n\n**Features:**\n\n- **Full Avionics:** Every switch, dial, and control is interactable, just like in the real aircraft.\n- **To-Scale Realism:** High-fidelity, 3D-scanned cockpit for maximum immersion.\n- **Chair Flying, Perfected:** Move through flows and checklists with your hands in mixed reality.\n- **Solo Practice:** Ideal for pre-solo flight students and current pilots looking to stay sharp between flights.\n- **Affordable & Accessible:** Train like a pro, without the cost or hassle of a simulator.\n\n**Why Choose Flight Deck?**\n\n- Practice flows, checklists, and cockpit procedures in a safe, distraction-free environment.\n- Build muscle memory and confidence before you ever set foot in the real aircraft.\n- Stay current and sharp between lessons or flights.", "short_description": "Transform your living room into a Cessna 172 cockpit and upgrade your pilot training experience. Practice real procedures, cockpit flows, and checklists in mixed reality with a to-scale and interactive 172 cockpit. No paper posters required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dauntlessxr.com/privacy-policy", "developer_terms_of_service_url": "https://www.dauntlessxr.com/katana-xr-terms-of-service", "publisher_name": "Dauntless XR", "support_website_url": null, "website_url": "https://www.dauntlessxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categor
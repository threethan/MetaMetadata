EqVa8xZ0IFQZOYJoTo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3-xq_gQt3JZBt9a1-WQAveAKzlyxRIu5E4Na5bfEVVw&oe=6AF8863C"}, {"file_name": "4.png", "id": "1474053583814645", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617762_1474053587147978_5971392831088762027_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmvoQfRy6LcQ7kNvwGc54sm&_nc_oc=AdpS19JGPeDsRi_hUfV_vnbv3ypK6PmTCa_BzG0Zae5283mvWCKyrQINGDkqKD-thLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs8K6ZSHGjl8ijGimW1IuLCA5ct33rNa2pCm4N1LD_tw&oe=6AF8ACD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest Assets - Flight Deck (2560 x 1440 px).png", "id": "4289714801248205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298543_4289714804581538_4685964198935483194_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NH-_lxrVs3sQ7kNvwHxOyeg&_nc_oc=AdoAhnsLkWYxR-pMrJsw-LHSyAqzNdCx1ekUCievWcXtVUzXv8nk7HJFTlRHI1n7LdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVD8dIxiybQTLWBJzqibPSHU877m7ucMwsYl89PcvrpQ&oe=6AF87D4C"}, "display_name": "Flight Deck", "keywords": ["cessna", "flight", "simulator", "training", "pilot"], "long_description": "Take your pilot training to the next level with Flight Deck, the most realistic and interactive Cessna 172 cockpit experience available on Meta Quest. Designed for student pilots and licensed aviators alike, this app brings a true-to-scale, high-fidelity Cessna 172 cockpit into your living room. Practice anytime, anywhere without cringy posters taped to your wall. \n\n**Features:**\n\n- **Full Avionics:** Every switch, dial, and control is interactable, just like in the real aircraft.\n- **To-Scale Realism:** High-fidelity, 3D-scanned cockpit for maximum immersion.\n- **Chair Flying, Perfected:** Move through flows and checklists with your hands in mixed reality.\n- **Solo Practice:** Ideal for pre-solo flight students and current pilots looking to stay sharp between flights.\n- **Affordable & Accessible:** Train like a pro, without the cost or hassle of a simulator.\n\n**Why Choose Flight Deck?**\n\n- Practice flows, checklists, and cockpit procedures in a safe, distraction-free environment.\n- Build muscle memory and confidence before you ever set foot in the real aircraft.\n- Stay current and sharp between lessons or flights.", "short_description": "Transform your living room into a Cessna 172 cockpit and upgrade your pilot training experience. Practice real procedures, cockpit flows, and checklists in mixed reality with a to-scale and interactive 172 cockpit. No paper posters required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dauntlessxr.com/privacy-policy", "developer_terms_of_service_url": "https://www.dauntlessxr.com/katana-xr-terms-of-service", "publisher_name": "Dauntless XR", "support_website_url": null, "website_url": "https://www.dauntlessxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25157061813974113"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1686586896463182"}, {"status": "PUBLISHED", "id": "2258738441328656"}, {"status": "PUBLISHED", "id": "1964591724238086"}, {"status": "CANCELLED", "id": "1019890530609203"}, {"status": "CANCELLED", "id": "798755439765003"}, {"
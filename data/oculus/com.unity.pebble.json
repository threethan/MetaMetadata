d=6e7a0a&_nc_ohc=TNQ20TCQDCEQ7kNvwEl3R62&_nc_oc=AdkvGYd8Zk1fnzjooSBkcNsSki4IRNQ9l7DY8AsnZnvYeHD1Cud3p7T8X0Aq2elC3GY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsOd4ToYjUPV4FsY0sqh0PZ8tZwhZ5sIGe8w5TDGbIZyA&oe=69A2E581"}, {"file_name": "ScreenShot_05.png", "id": "1222069622926664", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391888_1222069626259997_4405722189874426066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IWwwTGUZLkQ7kNvwHi4myq&_nc_oc=AdkOwzvKrt7JI-AU7vZLNd-OEPZZ_Cs1XcaNbkrApMrOMEWyy7p2IwxavlIKyxDif5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsynhzY24O5-qEDmb3vS7TeS3fgvyca3BiXbc5jr9HNbw&oe=69A2EA0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pebble", "keywords": ["sandbox", "build", "survival", "island", "base"], "long_description": "Pebble is a mixed reality hand tracked sandbox survival game where you play as a tiny pebble with god like powers. In a world that responds to your touch, you can shape terrain, move objects, and manipulate your surroundings using only your hands. Though you are small, threats still exist as strange enemies roam the land, and survival means staying alert and using your abilities wisely. Explore, build, and reshape the world around you as a powerful force in a miniature ever changing landscape.", "short_description": "Pebble is a mixed reality, hand-tracked sandbox survival game where you play as the smallest thing with the greatest power. Live and survive as a humble pebble in a vast, mysterious world, but wield the abilities of a god. Shape the environment, control the elements, and forge your own miniature universe. In Pebble, creation and survival go hand-in-hand."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTA
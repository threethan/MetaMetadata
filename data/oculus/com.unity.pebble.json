kBdvNC-Ug9DvP3xxqdvw&oe=69AABCDF"}, {"file_name": "ScreenShot_04.png", "id": "1220951096210863", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393887_1220951099544196_7079528060426058615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKhHCbFREbIQ7kNvwGxHUyK&_nc_oc=Adm0DAa_o9NlPoOAljbMabIrkj2Ldkjw9Wq3xpkIjFJDbXNIlt17vssD4OFBwsDh1Zw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxP5m0zF5V74wWllQAlsLJWA3YwmMP-b_qiydXiymCL_w&oe=69AACE81"}, {"file_name": "ScreenShot_05.png", "id": "1222069622926664", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391888_1222069626259997_4405722189874426066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKAmd_ePUQsQ7kNvwGn2c59&_nc_oc=AdndJKPPvdVUtwkKCb7dak4XyPH0eq1mxdi4J2t4DUOIzV5H7woFGMxcad8xVpcWmr0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKynsC-Y3GNdaw7igGr4kYBwS1JjtYef5mO0QUNtb5Kg&oe=69AAD30B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pebble", "keywords": ["sandbox", "build", "survival", "island", "base"], "long_description": "Pebble is a mixed reality hand tracked sandbox survival game where you play as a tiny pebble with god like powers. In a world that responds to your touch, you can shape terrain, move objects, and manipulate your surroundings using only your hands. Though you are small, threats still exist as strange enemies roam the land, and survival means staying alert and using your abilities wisely. Explore, build, and reshape the world around you as a powerful force in a miniature ever changing landscape.", "short_description": "Pebble is a mixed reality, hand-tracked sandbox survival game where you play as the smallest thing with the greatest power. Live and survive as a humble pebble in a vast, mysterious world, but wield the abilities of a god. Shape the environment, control the elements, and forge your own miniature universe. In Pebble, creation and survival go hand-in-hand."}]}, "developer_name": null, "deve
culuscdn.com&_nc_ss=7f20f&oh=00_AQTNr2G6p-TZHCO2dBGUA1-JTJFQa-qQyq6fLrwzBgMRaQ&oe=6B01D14B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "855748003427763", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821972_855748006761096_4662749616296701140_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N6yXbJRWJMQ7kNvwEsCuGz&_nc_oc=Adq1tMgjdsuY7bp7enpGlG9i5hLcu4dwipRtsVH3bzwXpO3vw_MlYriffYEWBIo0Mas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS33kcAQuyGZOUxYxKryB_ImVDPYcGrrPwS0ndl-DvZuA&oe=6B01E5A9"}, "display_name": "Pebble", "keywords": ["sandbox", "build", "survival", "island", "base"], "long_description": "Pebble is a mixed reality hand tracked sandbox survival game where you play as a tiny pebble with god like powers. In a world that responds to your touch, you can shape terrain, move objects, and manipulate your surroundings using only your hands. Though you are small, threats still exist as strange enemies roam the land, and survival means staying alert and using your abilities wisely. Explore, build, and reshape the world around you as a powerful force in a miniature ever changing landscape.", "short_description": "Pebble is a mixed reality, hand-tracked sandbox survival game where you play as the smallest thing with the greatest power. Live and survive as a humble pebble in a vast, mysterious world, but wield the abilities of a god. Shape the environment, control the elements, and forge your own miniature universe. In Pebble, creation and survival go hand-in-hand."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAM
=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtkcrYJujkRsUMWWhCKdUYPvsxbuuDzd8IoINcVk7-gw&oe=6A67435F"}, {"file_name": "ScreenShot_04.png", "id": "1220951096210863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393887_1220951099544196_7079528060426058615_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqlXgEi5dzsQ7kNvwHi_Ip_&_nc_oc=Adq9iCAQ-_3_29bwJBpBw1xUWzM5rAusUQYA60zCKxhgIs1eotldiS__xIjopB99WSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5HqiLIoDgsHyqpngF70gaHMm21ZRRb1yfJXL0x_gGOQ&oe=6A675501"}, {"file_name": "ScreenShot_05.png", "id": "1222069622926664", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391888_1222069626259997_4405722189874426066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60Jrhrcq5BMQ7kNvwHpRFbb&_nc_oc=Adof4-wiTEPRw9DIufiTXauCVGbOL5cFUf1XNxCYekCzgEDy7uthH9H1Zx7toNAr-V8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBN66qv2SAwMxXhCipmwUnMjjkMnzbLo-ATT1LmNm4Uw&oe=6A67598B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pebble", "keywords": ["sandbox", "build", "survival", "island", "base"], "long_description": "Pebble is a mixed reality hand tracked sandbox survival game where you play as a tiny pebble with god like powers. In a world that responds to your touch, you can shape terrain, move objects, and manipulate your surroundings using only your hands. Though you are small, threats still exist as strange enemies roam the land, and survival means staying alert and using your abilities wisely. Explore, build, and reshape the world around you as a powerful force in a miniature ever changing landscape.", "short_description": "Pebble is a mixed reality, hand-tracked sandbox survival game where you play as the smallest thing with the greatest power. Live and survive as a humble pebble in a vast, mysterious world, but wield the abilities of a god. Shape the environment, control the elements, and forge your own miniature universe. In Pebble, creation and survival go hand-in-hand."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Doubt Not", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9526708927433463"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2163501677449188"}]}, "baseline_offer": {"id": "2163501677449188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746137460, "status": "PUBLISHED", "id": "2163501677449188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9574445682659787", "version": "1.1.80"}, "id": "1249010206171851", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8906663346104694", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9574445682659787"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1249010206171851"}]}, "change_log": null, "created_date": 1746620134, "id": "9574445682659787", "version": "
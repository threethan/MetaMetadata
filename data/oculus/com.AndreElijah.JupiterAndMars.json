74_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAChy503gt0Q7kNvwG3WlwS&_nc_oc=Adqdp5t2F5AUiFbu4wJqDYbZpy5iYo4m2GxcIZT5pzNvRmsVrdp2iotdEyTthzeV4VE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZhSQZOPTOsBMIVGPYNcJUONyWrefT556tB21MybRLDQ&oe=69D24DB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest Trailer Cover.png", "id": "1260883048049042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035336_1260883051382375_4154211881763509051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM7D3yFgqcAQ7kNvwG_0GIn&_nc_oc=AdpAmNWZm7J00DWlByZ0TQ42jg8oBZd_utuyavSaAEbfRizVZenznm-qEjtqItnLRBI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VTBVAteRD7v9lOtlgrVWcYOhNmqt3473IamZocWdKcg&oe=69D257F1"}, "display_name": "Jupiter & Mars", "keywords": ["Dolphin", "Ocean", "Sea", "Eco", "underwater"], "long_description": "Experience the definitive edition of Jupiter & Mars, the acclaimed VR underwater adventure game where you control two dolphins, Jupiter and her sidekick Mars, and save the oceans! \n\nFully enhanced for Quest with improved graphics and gameplay, Jupiter & Mars takes you on an unforgettable journey through submerged cities like New York and London as you neutralize machines that are disrupting sea life. Use Jupiter\u2019s dolphin sonar and Mars\u2019 ramming abilities to explore the ocean depths, gain new power-ups, and encounter legendary sea creatures! \n\n\u201cA beautiful and surreal undersea adventure\u201d - GameSpot\n\u201cA VR treat with a vital message\u201d - Eurogamer \n\u201cThe visuals are awe-inspiring\u201d - IGN\n\nGame Features:\n\n* Stunning underwater visuals and mesmerizing soundtrack\n* Unforgettable story that's guided by Elder whales\n* \u201cMetroidvania\u201d-style power-up progression system \n* Turtles, manta rays, and other sea life to rescue \n* Bonus treasures and secrets to discover  ", "short_description": "Experience the definitive edition of Jupiter & Mars, the acclaimed VR underwater adventure game where you control two dolphins, Jupiter and her sidekick Mars, and save the oceans! \n\nFully enhanced for Quest with improved graphics and gameplay, Jupiter & Mars takes you on an unforgettable journey as you neutralize machines that are disrupting sea life. Use Jupiter\u2019s dolphin sonar and Mars\u2019 ramming abilities to explore the ocean depths, gain new power-ups, and encounter legendary sea creatures! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tigertron.eco/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tigertron", "support_website_url": null, "website_url": "http://www.tigertron.eco/jam", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "it", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "307906564618372"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "4462156467337795"}, {"status": "PUBLISHED", "id": "2152113815212994"}, {"status": "PUBLISHED", "id": "599910603027877"}, {"status": "PUBLISHED", "id": "2018000938719289"}, {"status": "PUBLISHED", "id": "1028074879090619"}, {"status": "PUBLISHED", "id": "1915046788948535"}, {"status": "PUBLISHED", "id": "612943000450920"}]}, "baseline_offer": {"id": "2152113815212994"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLI
74_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVUjBBXr3iIQ7kNvwFgNKBd&_nc_oc=AdoWoP49H57NF2IF19fh8S8MEVn-arluFCOGBgXLxRDB7MW8g8UKLGVt384bEwNtxl8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g2Z9xwfO1aaduw54pVZuHryIGcW9NhV-bClouOKJVSA&oe=6A107C79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest Trailer Cover.png", "id": "1260883048049042", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39035336_1260883051382375_4154211881763509051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09HS61jwYE8Q7kNvwHMy1id&_nc_oc=AdrBJilwvR1IQEdHAs8Dk7FllfrYeCTl_VMLRcKL5Ax_VjbU-2OcytdJxJiBC9dxMH4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vaRoqKrUoeN35cd3_sVtq23cqlYh4rEU6mkxRPdR6Xg&oe=6A104E71"}, "display_name": "Jupiter & Mars", "keywords": ["Dolphin", "Ocean", "Sea", "Eco", "underwater"], "long_description": "Experience the definitive edition of Jupiter & Mars, the acclaimed VR underwater adventure game where you control two dolphins, Jupiter and her sidekick Mars, and save the oceans! \n\nFully enhanced for Quest with improved graphics and gameplay, Jupiter & Mars takes you on an unforgettable journey through submerged cities like New York and London as you neutralize machines that are disrupting sea life. Use Jupiter\u2019s dolphin sonar and Mars\u2019 ramming abilities to explore the ocean depths, gain new power-ups, and encounter legendary sea creatures! \n\n\u201cA beautiful and surreal undersea adventure\u201d - GameSpot\n\u201cA VR treat with a vital message\u201d - Eurogamer \n\u201cThe visuals are awe-inspiring\u201d - IGN\n\nGame Features:\n\n* Stunning underwater visuals and mesmerizing soundtrack\n* Unforgettable story that's guided by Elder whales\n* \u201cMetroidvania\u201d-style power-up progression system \n* Turtles, manta rays, and other sea life to rescue \n* Bonus treasures and secrets to discover  ", "short_description": "Experience the definitive edition of Jupiter & Mars,
74_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7J3BuXEfq4IQ7kNvwEGW-80&_nc_oc=AdoEOYm9Lxv-FDdMNZDOvqmx9uMQkNTSWHcNUdxNIB53Yppr9Xb_IMRGU9yKtqYoaCU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmIluUYTFYKo49X3MnEtYdSx4lJezPSHeF-OhnMz6dNA&oe=6A941A39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest Trailer Cover.png", "id": "1260883048049042", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39035336_1260883051382375_4154211881763509051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYVJjBk8QE4Q7kNvwEWzttO&_nc_oc=AdpBVIYBge5L8OEOd2xEAS4ih6QkKtTEM9FX_rAT12v02fUkJSe_98KsadVe0GY67VA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhyGUojG3lHbgMoe7gv_4K4ja7sPExESc4GV-tRiThWQ&oe=6A942471"}, "display_name": "Jupiter & Mars", "keywords": ["Dolphin", "Ocean", "Sea", "Eco", "underwater"], "long_description": "Experience the definitive edition of Jupiter & Mars, the acclaimed VR underwater adventure game where you control two dolphins, Jupiter and her sidekick Mars, and save the oceans! \n\nFully enhanced for Quest with improved graphics and gameplay, Jupiter & Mars takes you on an unforgettable journey through submerged cities like New York and London as you neutralize machines that are disrupting sea life. Use Jupiter\u2019s dolphin sonar and Mars\u2019 ramming abilities to explore the ocean depths, gain new power-ups, and encounter legendary sea creatures! \n\n\u201cA beautiful and surreal undersea adventure\u201d - GameSpot\n\u201cA VR treat with a vital message\u201d - Eurogamer \n\u201cThe visuals are awe-inspiring\u201d - IGN\n\nGame Features:\n\n* Stunning underwater visuals and mesmerizing soundtrack\n* Unforgettable story that's guided by Elder whales\n* \u201cMetroidvania\u201d-style power-up progression system \n* Turtles, manta rays, and other sea life to rescue \n* Bonus treasures and secrets to discover  ", "short_description": "Experience the definitive edition of Jupiter & Mars,
FJib7h0Cq1FBpEQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sxTfTKTVaxXPNjPkwDVcI7YETYISeEjjmseb3fJj90Q&oe=69DE3EA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hw video cover.png", "id": "1200993144167708", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036603_1200993147501041_3099629966141745233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZ3NtNLGzewQ7kNvwEeQwZ2&_nc_oc=AdoONrtciIljEI8e6BUgxMDuUtmdqXmy_PgDx_SX_Yv6CnezNiQgvH-UkPwQhXspcdk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3R-_MYAWvkpIk-b1uY_txKIvrM4aqivd55UQMxGwhYwg&oe=69DE54C6"}, "display_name": "Hot Work", "keywords": [], "long_description": "Provide safe, efficient, and accessible hot work training anywhere. The Hot Work Welding Training application provides a simulation of real world training with all the advantages that VR has to offer. Learn how to ensure a safe work space, choose and inspect the proper equipment, and take in important information in a safe, easy, and practical way. Experience the real world scenario anytime, anywhere. The guidance is so easy no VR experience is necessary, just pick up a controller and get started with a few clicks. If you make a mistake, you can review your results and try again. Our guidance system will ensure no two attempts are quite the same! Try the demo today or visit www.vobling.com and subscribe to the license for full access to all this and more to come.", "short_description": "The Hot Work Welding Training application provides training and guidance through everything you need to learn to safely do welding according to industry standards."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vobling.com/privacy-policy-hotwork/", "developer_terms_of_service_url": null, "publisher_name": "Vobling AB", "support_website_url": null, "website_url": "http://www.vobling.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_ca
work screenshot 2.png", "id": "702997390923317", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982586_702997397589983_4159237898094102005_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqiI8qh6ST8Q7kNvwFszgh8&_nc_oc=AdpxeO9NhHh_GzZ1RruRpn9vivGbqB412NE5dAFnDpyaiOZx4Ifooinu5Mm953ugj9Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS31IjO6iXB4uQ9oev7MMtUICpOpbtyBvoUpjFxF76Kvw&oe=6B01D264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hw video cover.png", "id": "1200993144167708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036603_1200993147501041_3099629966141745233_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSaofmMJ-n4Q7kNvwEY99xr&_nc_oc=AdpCtdiiK8HVyYNj8Fs5XbWBDNUN45h1cUth5nqf6lSdXE9u5Msa22NRQd9DwI0RbfM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2Fv_QUez-JCjo31z27o2RsmPhhOqOD9Y5XWPcHkv7gw&oe=6B01E886"}, "display_name": "Hot Work", "keywords": [], "long_description": "Provide safe, efficient, and accessible hot work training anywhere. The Hot Work Welding Training application provides a simulation of real world training with all the advantages that VR has to offer. Learn how to ensure a safe work space, choose and inspect the proper equipment, and take in important information in a safe, easy, and practical way. Experience the real world scenario anytime, anywhere. The guidance is so easy no VR experience is necessary, just pick up a controller and get started with a few clicks. If you make a mistake, you can review your results and try again. Our guidance system will ensure no two attempts are quite the same! Try the demo today or visit www.vobling.com and subscribe to the license for full access to all this and more to come.", "short_description": "The Hot Work Welding Training application provides training and guidance through everything you need to learn to safely do welding according to industry standards."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vobling.com/privacy-policy-hotwork/", "developer_terms_of_service_url": null, "publisher_name": "Vobling AB", "support_website_url": null, "website_url": "http://www.vobling.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5922275737792662"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982466_909132333352483_5632266239913712058_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fEAUC_IzpgQ7kNvwGrQdlh&_nc_oc=Adre-uLOTGEGsPOzS_ebiSyO_HOmhGaZO-IddT4oLY9-9_syZ1xYQNpfbLjPVT3Z4Ho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtlgTzEXr8RzOUvMtNwRGjIUdHIazYjNzOEiqEivnT_A&oe=6B01DB66"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hot Work", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1674201600, "lastRevision": {"nodes": [{"id": "5524793220952227", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5524793174285565", "is_first_party": false, "enables_in_app_ads": false, "
gJUgNLRKT-I3JbA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSCyDNDKUe-2uOU9igtbHzPakelYm6mB2MmgiaqdNbFw&oe=6AE347A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hw video cover.png", "id": "1200993144167708", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036603_1200993147501041_3099629966141745233_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atZhjutnk0IQ7kNvwFvQSqO&_nc_oc=Adr5-npnydxWZ8hFhcVz4AXJKqwHhgKGZmCuokKmYGu0sI9B3daTUx0UPuMkx3yhAp8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpP3gzBkJCFnt_hDNOL-2MG89OB_ejyne4lzVn2_S-eg&oe=6AE35DC6"}, "display_name": "Hot Work", "keywords": [], "long_description": "Provide safe, efficient, and accessible hot work training anywhere. The Hot Work Welding Training application provides a simulation of real world training with all the advantages that VR has to offer. Learn how to ensure a safe work space, choose and inspect the proper equipment, and take in important information in a safe, easy, and practical way. Experience the real world scenario anytime, anywhere. The guidance is so easy no VR experience is necessary, just pick up a controller and get started with a few clicks. If you make a mistake, you can review your results and try again. Our guidance system will ensure no two attempts are quite the same! Try the demo today or visit www.vobling.com and subscribe to the license for full access to all this and more to come.", "short_description": "The Hot Work Welding Training application provides training and guidance through everything you need to learn to safely do welding according to industry standards."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vobling.com/privacy-policy-hotwork/", "developer_terms_of_service_url": null, "publisher_name": "Vobling AB", "support_website_url": null, "website_url": "http://www.vobling.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_ca
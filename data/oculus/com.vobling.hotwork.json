work screenshot 2.png", "id": "702997390923317", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982586_702997397589983_4159237898094102005_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbpBgN-nKg4Q7kNvwEUC3k-&_nc_oc=Ado89a61ISha0AhOdD2sPJXenpPEtsM3XNIho4-80cP8VDUPOd1pqb7iauVkzd4oHLY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGSWkarepXgc-_NQQsF3OPHOdDS3fQdySTe4yjxwbfEQ&oe=6B09BB64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hw video cover.png", "id": "1200993144167708", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036603_1200993147501041_3099629966141745233_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb2Aa6zEbEQQ7kNvwF-pWlx&_nc_oc=Adq41_NRsn95CNMULynh-n1e-_1ui5c-MLr-m8C_BdlimcWyH9u2nIwPUM_V71I6m3s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-mGs71qxQcQoBrOg54k_Ri9FYIhh-E2YfvXhlaSoXDA&oe=6B099946"}, "display_name": "Hot Work", "keywords": [], "long_description": "Provide safe, efficient, and accessible hot work training anywhere. The Hot Work Welding Training application provides a simulation of real world training with all the advantages that VR has to offer. Learn how to ensure a safe work space, choose and inspect the proper equipment, and take in important information in a safe, easy, and practical way. Experience the real world scenario anytime, anywhere. The guidance is so easy no VR experience is necessary, just pick up a controller and get started with a few clicks. If you make a mistake, you can review your results and try again. Our guidance system will ensure no two attempts are quite the same! Try the demo today or visit www.vobling.com and subscribe to the license for full access to all this and more to come.", "short_description": "The Hot Work Welding Training application provides training and guidance through everything you need to learn to safely do welding according to industry standards."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vobling.com/privacy-policy-hotwork/", "developer_terms_of_service_url": null, "publisher_name": "Vobling AB", "support_website_url": null, "website_url": "http://www.vobling.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5922275737792662"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_909132333352483_5632266239913712058_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFQt6fTNmrMQ7kNvwFzqYDi&_nc_oc=Adq01bserArxL9iQmrwuPrDOrEN-zXnbFb8OZ4mRGubUqKKWo-G92xbMdWxeYUdvcsI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr4y9i6giprfJcVL9XVDDLZDHXTx7-KTnaiANAzbnCgA&oe=6B09C466"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hot Work", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1674201600, "lastRevision": {"nodes": [{"id": "5524793220952227", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5524793174285565", "is_first_party": false, "enables_in_app_ads": false, "
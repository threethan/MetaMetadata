AekwRi4tfzBl4NysFqn0pv1Vq8nOCsQoYCyGHdtdfLHqAYTgs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LUK6Ey9FlNl8ffnU5WZYphMG_fcjkKcSDJYKG3yEcqg&oe=6A105CEE"}, {"file_name": "3.png", "id": "1567713271246134", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491825415_1567713274579467_5603568670051917211_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NOdl3JJA-cQ7kNvwFhKUPr&_nc_oc=AdqQG4cK5-Sgj18yFYDeklORVwCuQh5_-hNph_13he7zhOeBZXWngQNitOWbzOAbIho&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E3KrOFJm9KHX6BwcUCLmE7IZk4N8zaFCFMRvt2fAtvA&oe=6A105E98"}, {"file_name": "1.png", "id": "1097419789130917", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821568_1097419792464250_7887384488868374703_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6IlpTUvIjgQ7kNvwHLK8rX&_nc_oc=AdrJHia9rxfUWnUU5qr73hKpv_wcMqpHHmKHiSczp5ofJ2egYReVbE6Ft6zzED7X_1c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76pqaGbfrbeN7hM8ieTOu7i_qVyLKDF-JE9cxQzQm8Dw&oe=6A10732A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jet Strike : VR Fighter Jet Warfare", "keywords": ["vr", "jet", "fighter", "combat", "shooting"], "long_description": "Step aboard a powerful battleship and prepare for intense aerial combat in Jet Strike: VR Fighter Jet Warfare \u2014 an immersive VR shooting experience where you control the deck gun and defend your ship from waves of enemy aircraft.\n\nEngage in thrilling dogfights as fighter jets soar overhead, performing deadly dives and bombing runs. Your mission: aim, track, and destroy them before they take down your ship.\n\nWith intuitive VR controls, realistic explosions, and immersive 360\u00b0 visuals, every encounter feels cinematic and adrenaline-filled. Experience the roar of engines, the thunder of gunfire, and the satisfaction of perfect aim as you dominate the skies.\n\nWhether you\u2019re a fan of air combat, shooting games, or simply love action in VR, Jet Strike: VR Fighter Jet Warfare delivers nonstop excitement and fast-paced battles that test your reflexes and precision.\n\n\ud83c\udfaf Features:\n\nRealistic VR gun controls and immersive combat\n\nIntense fighter jet attacks and explosions\n\nDynamic waves with increasing difficulty\n\nFull 360\u00b0 defense experience aboard a battleship\n\nLock, aim, and strike \u2014 the sky is yours to defend!", "short_description": "Take control of a heavy gun on a battleship and defend the skies in Jet Strike: VR Fighter Jet Warfare! Aim, lock, and fire at incoming enemy planes in this thrilling VR air combat experience. Feel the power of the turret, track fast-moving jets, and survive wave after wave of intense aerial attacks. Realistic sound, smooth controls, and immersive VR action put you right in the heart of the battle."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24711638121869420"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/4918
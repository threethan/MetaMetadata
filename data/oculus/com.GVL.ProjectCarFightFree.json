n.com/v/t64.5771-25/38974905_405479791969066_6466713203342625023_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4zsq5_3pMUQ7kNvwHr0u0O&_nc_oc=AdlrJ61P0xVySaYh0qwZHtMWLLYXpEAeY_fIvqf-Uo8nzQs7e84SeJAo0il6R38g1IE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOgTsfEJ32Gh647AqUo_xza9Dp7o-qh5P1xuI4NkainQ&oe=69BA8F71"}, "display_name": "Battle of Nowhere - Free Demo", "keywords": [], "long_description": "Purchase the ea version to unlock the full game: https://www.meta.com/experiences/6448853188462469/\n\nYou guard a base in the middle of nowhere against waves of weird enemies. Shoot them before they take you down.\n\nFeatures:\n- An immersive and addictive VR arcade shooting game.\n- A variety of weapons. Different properties, upgrades, scatter rates, and recoil. It has an excellent shooting feel.\n- A variety of support props. Provides various tactical combinations for the ever-changing battlefield.\n- Unique art style and changeable weather and day and night systems.\n- Mild roguelike. Replayability.\n\n\nJoin our discord at https://discord.gg/2UqhEjfEAj to tell us what you like/dislike about our game, and what you want us to add.", "short_description": "You are guarding a base in the middle of nowhere against waves of weird enemies. Shoot them before they take you down."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greatvictorylegends.notion.site/Privacy-Policy-80c4a267b20643cf9550850f5402e418", "developer_terms_of_service_url": null, "publisher_name": "Great Victory Legends, Inc.", "support_website_url": null, "website_url": "https://www.greatvictorylegends.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics
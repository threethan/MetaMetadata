&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o18zNSY0j7YQ7kNvwGqDQ72&_nc_oc=AdrEhkiabNevKYHq0ADgHwu-82I9aFUIYe8bGYRH0ZpYNai3tSoqGTCSHO10dAYTNO0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE_i1RLkRl8HWMbiAsOlcyfO_23UhBP-qLXR7j931W7Q&oe=6AFF2B83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BoN_New_CoverArt(Landscape) Xavier Grubb.png", "id": "1203318951498516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491826683_1203318954831849_6839097814337184548_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUNjHqL2cqsQ7kNvwGUbYD6&_nc_oc=AdrJcnCegLKOXUsiWgGH7Rg1CDfICz-g-dUmCQVzKNlzqd_yMZfSJ4StTrZyEP8S-t4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPq-9V9rgeVaIjldWxAKrwSDxvrk_nJRtND5kztsjOzQ&oe=6AFF30CF"}, "display_name": "Battle of Nowhere - Free Demo", "keywords": ["Zombie", "Shooter", "Survival", "Action", "FPS"], "long_description": "Purchase the paid version to unlock the full game: https://www.meta.com/experiences/6448853188462469/\n\n\ud83d\udc80 Battle of Nowhere \u2013 Fast-Paced Zombie Mayhem! \ud83d\udd25\n\nThe world is overrun, and survival is all that matters. In Battle of Nowhere, speed, skill, and firepower decide your fate. Blast through relentless zombie hordes, upgrade your arsenal, and fight your way to the top of the leaderboards.\n\n\ud83d\udd2b Arcade-Style Action \u2013 Fast, intense, and addictively satisfying gunplay.\n\ud83c\udfc6 Leaderboard Competition \u2013 The faster you clear a level, the higher you rank.\n\ud83d\udca3 Explosive Upgrades \u2013 Unlock powerful weapons, grenades, and deadly enhancements.\n\u26a1 Non-Stop Progression \u2013 Earn Survivor Credits to upgrade and dominate.\n\nHow long can you survive? Lock. Load. Fight. \ud83d\udd25\n\nJoin our discord at https://discord.gg/tsj9j78Bm9 to tell us what you like/dislike about our game, and what you want us to add.", "short_description": "\ud83d\udc80 Battle of Nowhere \u2013 Fast-Paced Zombie Mayhem! \ud83d\udd25\n\nBlast through relentless zombie hordes, upgrade your arsenal, and climb the leaderboards. Speed, skill, and firepower decide your fate. Survive, dominate, repeat! \ud83d\udd2b\ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://greatvictorylegends.notion.site/Privacy-Policy-80c4a267b20643cf9550850f5402e418", "developer_terms_of_service_url": null, "publisher_name": "Great Victory Legends, Inc.", "support_website_url": null, "website_url": "https://www.greatvictorylegends.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8922799381157070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396247_2371979383167824_3445898542083677584_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9Rp2FxvMvYQ7kNvwH_e9aC&_nc_oc=AdrFGTRb2imW69ejaA1zeZielwfNyX07Lk-rb3J8U1ow0U29qsSl-kTxO7eBsKPooEM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxZbPm3yo7cE4ZUJBtaXv53wMXkdpwehLHBp_6hHKumQ&oe=6AFF24CE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Battle of Nowhere - Free Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "c
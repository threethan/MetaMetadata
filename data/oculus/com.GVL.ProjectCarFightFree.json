umbnail": {"file_name": "BONCoverArt.png", "id": "405479788635733", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974905_405479791969066_6466713203342625023_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRjen2Fl1OgQ7kNvwFpxx5W&_nc_oc=Adr2NyIZd7UmAP60lGu85uzE9RQ5_64KmThbAA_7Pig54fKnvXxO7KkloGQsdgS8G44&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U5kdGqVjPWtSScxEodBuJ-zUDNrG4JLCKKFSpgMsPKA&oe=6A2C28B1"}, "display_name": "Battle of Nowhere - Free Demo", "keywords": [], "long_description": "Purchase the ea version to unlock the full game: https://www.meta.com/experiences/6448853188462469/\n\nYou guard a base in the middle of nowhere against waves of weird enemies. Shoot them before they take you down.\n\nFeatures:\n- An immersive and addictive VR arcade shooting game.\n- A variety of weapons. Different properties, upgrades, scatter rates, and recoil. It has an excellent shooting feel.\n- A variety of support props. Provides various tactical combinations for the ever-changing battlefield.\n- Unique art style and changeable weather and day and night systems.\n- Mild roguelike. Replayability.\n\n\nJoin our discord at https://discord.gg/2UqhEjfEAj to tell us what you like/dislike about our game, and what you want us to add.", "short_description": "You are guarding a base in the middle of nowhere against waves of weird enemies. Shoot them before they take you down."}]}, "developer_name": null, "developer_privacy_policy_url": "https://greatvictorylegends.notion.site/Privacy-Policy-80c4a267b20643cf9550850f5402e418", "developer_terms_of_service_url": null, "publisher_name": "Great Victory Legends, Inc.", "support_website_url": null, "website_url": "https://www.greatvictorylegends.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], 
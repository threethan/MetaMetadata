=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJJD6MWtaRQQ7kNvwEekoB7&_nc_oc=AdpEnkAuWxcQ8E0b1t62f5iEYkrGYEdvB_wz7Z_cydSoloctemnRl2F3HDr2a177w0c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0FeBLNAyVTnlOEuQvAZ4PVa0dhrTTHQe_ZDvtRsnFJaw&oe=69F2176D"}, {"file_name": "hv6XsP.png", "id": "924820468059132", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974702_924820471392465_7561884887428129009_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vDOTsIt1CgQ7kNvwHwMi0e&_nc_oc=AdqiNvQ7D7JcHv-6qIloBId0BxVXj0Kb_b3Hw28pVqVDHaNDjbbhf4BxOp0wbdrBNtQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2_sGAJGtknUk0LFk1fJ3MF6-yS9RBEoo5OzAYO2nxsyg&oe=69F1E72A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4BR6zK.png", "id": "3067317450154600", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031468_3067317456821266_5989603035678189572_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oi0KsamG2LQQ7kNvwF8TKOs&_nc_oc=Adq8tHwCXdXh8FRtq1KbwhDA-60XjBUo_gWjf2QeB-Pe87Ynw3XyQbe6DQhKf9Hk78w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28jFCmmlmlmHgVZ6Gij8XBmWVSNI1IRWqxaBEInapykw&oe=69F20305"}, "display_name": "Dissection Simulator: Invertebrate Edition", "keywords": [], "long_description": "VictoryXR\u2019s virtual dissection software is a hands-on opportunity experienced through the power of VR. Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality dissection. Learn the fundamentals of dogfish anatomy through its various systems in our fully immersive VR experience using Carolina Biological\u2019s expert curricula and process.\n\nThe entire program adheres to the Next Gen Science Standards (NGSS), America\u2019s framework for science learning. In addition, we\u2019ve implemented the processes and procedures of Carolina Biological--America\u2019s leading supplier of science education materials. Using original and lifelike physical models, the dissection experience is recreated to the finest detail and is a comparable substitute for actual live specimen classroom dissections, without the safety and ethical implications.", "short_description": "VictoryXR\u2019s virtual dissection software is a hands-on opportunity experienced through the power of VR. Join Wendy Martin, national award-winning science teacher, to guide you through a virtual reality dissection. Learn the fundamentals of dogfish anatomy through its various systems in our fully immersive VR experience using Carolina Biological\u2019s expert curricula and process."}]}, "developer_name": "VictoryXR", "developer_privacy_policy_url": "https://victoryxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VictoryXR", "support_website_url": null, "website_url": "https://victoryxr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "498545464965340"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4036964239713550", "version": "1.0"}, "id": "179749010429091", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_app
ss=7f20f&oh=00_AQQtdJ336OSI7d3tuAUU1Nw37JFKJtKST9jffRM3zA7oLg&oe=6AF0AF42"}, {"file_name": "Nursing_HeroBG.00_01_09_53.Still001.png", "id": "2944693052593741", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_2944693055927074_6127534523904985521_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlngudUJWy0Q7kNvwHMzc7K&_nc_oc=AdoGRSbpPemDTpQjZHR4ne4ICUqTr64N4tZu8ThD_-NMwHYI8DTIy1x-DtgHXi1Lhf8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwF1OLt5_yg102WOBezl7wpfwjnMVxiW4ppBzhIfzODQ&oe=6AF0A4C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Nursing_ProdVid_Fall2026 FullVR.00_01_36_04.Still001.png", "id": "1118403254320151", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/646418798_1118403257653484_2414846729438237698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUesjYXyWxIQ7kNvwGsNiOB&_nc_oc=AdqfpVnnXBOBaynbO4H7YVl16heBkqz-z4BbKk_-Ca2y-5QWrXejqgDWBGmsyA7hplA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxxnTA3UY8ICDT69azqYcPO47YNTPROrXMFBTcPh9B9A&oe=6AF09324"}, "display_name": "SIMVANA Nursing", "keywords": ["nursing", "healthcare", "training", "nurse", "hospital"], "long_description": "**Practice nursing skills. Build confidence. Deliver better patient care.**\n\nSIMVANA Nursing brings clinical training to life through immersive virtual reality. Designed for nursing students, new hires, and experienced nurses, SIMVANA provides realistic, repeatable scenarios that develop both clinical competence and essential communication skills.\n\n**Experience Nursing in Virtual Reality**\n\n- **Hands-On Clinical Training:** Practice essential nursing procedures, patient assessments, infection prevention, patient safety, and more in interactive clinical environments.\n- **Realistic Patient Interactions:** Strengthen empathy, communication, and critical thinking through conversations with virtual patients. In select scenarios, AI-powered patients respond naturally and display emotion.\n- **Learn by Doing:** Complete guided objectives, tackle clinical challenges, and receive feedback to reinforce learning.\n- **Practice Anytime:** Repeat scenarios at your own pace, build confidence, and track your learning progress.\n\nFrom foundational nursing skills to challenging patient conversations, SIMVANA Nursing provides a safe place to practice, make mistakes, and prepare for real-world patient care.\n\nA SIMVANA account and access to training content are required. Learn more at simvana.com.", "short_description": "Build confidence in nursing care through immersive virtual reality. SIMVANA Nursing combines hands-on clinical training with realistic, interactive patient conversations. Practice essential procedures, patient assessments, communication, and decision-making in a safe environment where you can learn, repeat, and improve at your own pace."}]}, "developer_name": "SIMVANA", "developer_privacy_policy_url": "https://simvana.com/privacy", "developer_terms_of_service_url": "https://simvana.com/tc", "publisher_name": "SIMVANA", "support_website_url": "https://simvana.com/support", "website_url": "https://simvana.com/nursing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28337843982560468"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/
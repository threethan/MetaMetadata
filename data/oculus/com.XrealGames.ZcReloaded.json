ogA3E90kRc2WxX8uD_k74Vb7m6AFqhK18lgcti474VgJ_7Ypkpr9km6Y-Mg03xyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVxP4Dhiyxj8Ar3YKha_TwQlK_E2QHifPgvZtebV2JUCg&oe=6B103E2F"}, {"file_name": "SS_NML_Coop.png", "id": "4021722981223665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_4021722991223664_2514267223949853207_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EzWNgbkC3QQ7kNvwHI7fFA&_nc_oc=AdpOGly1oTNB5DSpHdHW0aCzNFUXIvgZG7rToqyY5xkyuWVWiqVAvvy3OKvb_4nkqsI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVGzijI1CjwoUT7V0nnL7slIi3lsiUIMKyZv4AxLYpHmA&oe=6B10519B"}, {"file_name": "SS_NS_DEagle.png", "id": "455736925762084", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982695_455736929095417_7881349438133933608_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJkzgIj8WnAQ7kNvwEnhKfn&_nc_oc=AdrrmNxcRmzFhZwFii3bSzSOGGnh6CV7L4JD1v_4FF_pQ0g7kP2M3j8zICUHZ0r_gEE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUEUoloUMty4uhYaSy8THNrw6N9742aE2T7b6PY0h1n6w&oe=6B10472A"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPqhAKYUeJcQ7kNvwFqiHAD&_nc_oc=AdrQXpgJ7EDhwe3sQHLSYqJ_xPcnaH4F-XkX0MyfsllTEpsjYvMfuNMbzMMMQ2A59Cg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUgvZQJghJt9xQa7tAuRTlSj90nLJzDhtaTF6uBGOv2jg&oe=6B10556D"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccDuioPPKzMQ7kNvwGZKoUS&_nc_oc=AdqTt1I7FHoqfNhF6qLyg549LK3iFCg9VuG1LN15_ukyQSdFAcgMrIFqV_xprWNWcQw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUaWCb6GteGsdEAq6y9DSdScaiP1dcttGyL4An4I1knhQ&oe=6B106139"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZCR_TrailerCover.png", "id": "862707597642544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031331_862707600975877_8899701686782483767_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1gLwJahVSsQ7kNvwGNFsUt&_nc_oc=AdplxJhcUyT0JYZHVaB6VmCu3U5xspFQu_oFrxtUVl5N6GofDMinC6o6U9XiQz-4Ou8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWYysvQAcGDA_GWZtjoWGC-rI61_OFO0efeR1lOutJFwQ&oe=6B105590"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["fps", "shooter", "military", "coop", "single"], "long_description": "Grab your favourite guns, customize them and experience action like you never have before!\n\n# GAMEPLAY\nRise through the ranks to unlock a wide variety of weapons and attachments, climb, jump, crouch, shoot, reload, repeat - be prepared for a mind-blowingly immersive experience! \n\n# SINGLE PLAYER CAMPAIGN\nYou'll find yourself in a war-ridden, dystopian United States as a newly enlisted OSA soldier. What does OSA stand for? Outer States of America, the last bastion of hope. \nWar over water destroyed the world as we know it. You have an important mission: fight your way through the mysterious Tlalokii and find out the secrets they hold.. \n\n# CO-OPERATIVE MODE\nInvite your friends to your Co-op session, communicate via the built-in voice chat feature and fight through the whole campaign together ! \n\n# POST-RELEASE UPDATES\nKeep an eye out for future updates, the fun doesn't end here. ;) ", "short_description": "Zero Caliber: Reloaded is a story based military shooter with a full-blown single player campaign and Co-operative mode (up to 4 players).\nRise through the ranks to unlock a wide variety of weapons and attachments, customize them, climb, jump, crouch, shoot, get to cover, reload, invite your friends, repeat - be prepared for a mind-blowingly immersive experience! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrealgames.com/pp/", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://www.xrealgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "266374032273680"}}]}, "scheduled_offers": {"count": 91, "nodes": [{"status": "PUBLISHED", "id": "1146191884414670"}, {"status": "PUBLISHED", "id": "986808561113755"}, {"status": "PUBLISHED", "id": "1100957059260794"}, {"status": "PUBLISHED", "id": "2901007513581278"}, {"status": "PUBLISHED", "id": "1532632715205330"}, {"status": "CANCELLED", "id": "1312811090346657"}, {"status": "PUBLISHED", "id": "35034618539517281"}, {"status": "PUBLISHED", "id": "1691122005578209"}, {"status": "PUBLISHED", "id": "921854787056945"}, {"status": "PUBLISHED", "id": "1502900224143893"}, {"status": "CANCELLED", "id": "1244397190872845"}, {"status": "PUBLISHED", "id": "839364665694915"}, {"status": "PUBLISHED", "id": "1369746787850660"}, {"status": "PUBLISHED", "id": "1360604705775510"}, {"status": "PUBLISHED", "id": "1124353519621173"}, {"status": "PUBLISHED", "id": "1786675605391610"}, {"status": "PUBLISHED", "id": "1187145823170366"}, {"status": "PUBLISHED", "id": "1422392632010791"}, {"status": "PUBLISHED
&oh=00_AQI1aFIQgSCoAu1hiV5BmcL_pUZ4PXU21SR08ymQ1CIO9g&oe=6ABD0ADB"}, {"file_name": "SS_NS_DEagle.png", "id": "455736925762084", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982695_455736929095417_7881349438133933608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foJmXq5qXT8Q7kNvwG0chmD&_nc_oc=AdoKRDO0Wa7Bz6WkWq8YsUyYmSiamccOKM1-QiDId2AtDVXAxAPtF6_7plt1FZdVQcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKifup_IaNSI97Krh30LHYfHd0U_mTxzIr9Lo5XP76d-A&oe=6ABD38AA"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMINfS0TtGgQ7kNvwHlOFvn&_nc_oc=Adp4FX0qBWrYIw3Ylg8ulBoQA-IiIUdYl1UzvQiFJuhYrBj0D7b30KpCnth1nuWY4gE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkQu5JkvSvA4cjYN9WFNjwlp8IxZjQMx4HefAsqTt8Ig&oe=6ABD0EAD"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CM6egKT-dZAQ7kNvwE5K4Qc&_nc_oc=AdqfFk67b4iAixOq5EG_Y-ZCPXLBB0VoQdKiKZ2BOQWBJ5deJJkpYOhbEwr1ygUTfmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFJ0MTNTViwaQP4-4q-x7MbPrA5nNZuxJE7cNd5Pm02A&oe=6ABD1A79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZCR_TrailerCover.png", "id": "862707597642544", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031331_862707600975877_8899701686782483767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eU6l3d3BfB4Q7kNvwHCPvh7&_nc_oc=Adr1DnCiyhFzUzvpHlBisSsa5oIpAD-OnGl_Ncg1RwVu4poakOtm2gJok7-cqyQ31IY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0EuX_WZ0rmcVBnCjvbq9udt49nCAnklxoIcAwAycyUQ&oe=6ABD0ED0"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["fps", "shooter", "military", "coop", "single"], "long_description": "Grab your favourite guns, customize them and experience action like you never have before!\n\n# GAMEPLAY\nRise through the ranks to unlock a wide variety of weapons and attachments, climb, jump, crouch, shoot, reload, repeat - be prepared for a mind-blowingly immersive experience! \n\n# SINGLE PLAYER CAMPAIGN\nYou'll find yourself in a war-ridden, dystopian United States as a newly enlisted OSA soldier. What does OSA stand for? Outer States of America, the last bastion of hope. \nWar over water destroyed the world as we know it. You have an important mission: fight your way through the mysterious Tlalokii and find out the secrets they hold.. \n\n# CO-OPERATIVE MODE\nInvite your friends to your Co-op session, communicate via the built-in voice chat feature and fight through the whole campaign together ! \n\n# POST-RELEASE UPDATES\nKeep an eye out for future updates, the fun doesn't end here. ;) ", "short_description": "Zero Caliber: Reloaded is a story based military shooter with a full-blown single player campaign and Co-operative mode (up to 4 players).\nRise through the ranks to unlock a wide variety of weapons and attachments, customize them, climb, jump, crouch, shoot, get to cover, reload, invite your friends, repeat - be prepared for a mind-blowingly immersive experience! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrealgames.com/pp/", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://www.xrealgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
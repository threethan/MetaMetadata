7kNvwFCYD1p&_nc_oc=AdoRUyXsv5McSyfYoT32Dc-8Yh-v1kyG7d2UJv6v6jJV1dfriLi5MLbgwhWTa0_G5L0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGML6bXbfzzqxZzGRNcO8RIE_Y5up2PupLFuPZc2LvPAw&oe=6A75CF6A"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5fKzUWboTIQ7kNvwGLinCY&_nc_oc=AdoSCDvIvrKEZ8IeUKJb-fSK1kpmZDjzscKh6FtRAvSdwt7zRUm9LNSaRwDaUawkPf0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0567FqKLY8LQ8WYxXFO874OFXEJnCQBCw_xOuHIDK2w&oe=6A75DDAD"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqFfXNAcZCQQ7kNvwFMaiUm&_nc_oc=Adq5tyukL9-0_WuD2ZnmbBOGuPJeMte6TPunI2a459Ia1KZCV4HMLiQ9uSbzk09j6bA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvS56PSDUe_HbqF8C5Q0rcsYruy2pckkDEnXnsrXESrA&oe=6A75E979"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZeroCaliber_TrailerCover.png", "id": "6218093698276088", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974744_6218093704942754_7915310249497354316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u_Urh7Gy2sQ7kNvwFGySsT&_nc_oc=Adp9fQEsxyF4itbK3xcJkUJtt_EQyROx6TIIquwdc8foFkrukR0S0E45lMxH3zs-lPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9mvyJZS2wDkckuSTAuTuUp1rbnzNc1NtKUQLR6NQolQ&oe=6A75E4F6"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["military", "coop", "story", "pvp", "shooter"], "long_description": "**07/31/2026: NEW UPDATE IS LIVE - JUMP IN AND CHECK IT OUT!**\n\nZero Caliber: Reloaded is the all-in-one VR military FPS: play solo or in 4-player Co-op, jump into PvP, survive enemy waves, fight zombies, and explore community-made content with native mod support.\n\n# \u25c0 SINGLE-PLAYER CAMPAIGN \u25b6\n\nFight through 20+ story-driven missions in a war-torn, dystopian US as an OSA soldier and rise through the ranks to save what remains.\n\n{1061312729716830}\n\n# \u25c0 CO-OP & PVP \u25b6\n\nPlay the full campaign with up to 3 friends (or strangers) using built-in voice chat, or battle with, and against other players in Gun Game, TDM, DM, and more on dedicated servers.\n\n# \u25c0 SURVIVAL & ZOMBIE MODES \u25b6\n\nDefend key objectives in Survival, or take on the undead across 3 Zombie maps with limited ammo - for a change. ;)\n\n{2272861963525180}\n\n# \u25c0 CUSTOMIZE YOUR GEAR \u25b6\n\nChoose from 40+ firearms and melee weapons, 50+ attachments, and 100+ unlockable skins. Customize your weapons in real time and build a setup that fits your playstyle.\n\n{1474730788015779}\n\n# \u25c0 MOD SUPPORT \u25b6\n\nDownload community-made missions and PvP maps, or create your own content in Unreal Engine through mod.io. (Details on our Discord.)\n\n{937214432744845}\n\n# \u25c0 FUTURE UPDATES \u25b6\n\nMore updates are on the way, including a combat overhaul, better visuals and effects, smarter enemy AI, regular challenges, more unlockable content, and further improvements. Stick around, it'll be worth it!\n\n- Join our Discord: https://discord.gg/xrealgames\n- Support: support@xrealgames.com", "short_description": "Zero Caliber: Reloaded is an action-packed VR shooter featuring a full single-player and 4-player Co-op campaign, Survival, PvP and ZOMBIE modes, plus native mod support.\n\nBuild your loadout from a huge arsenal of weapons and attachments, customize every detail, then climb, jump, crouch, take cover and fight your way through intense missions with friends or on your own. Gear up, squad up and keep coming back for more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrealgames.com/aboutus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "supp
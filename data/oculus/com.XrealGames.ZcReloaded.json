ogo.png", "id": "1086018135226239", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982466_1086018138559572_7081831439368505789_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SGmGSetr8wQ7kNvwFxNcBg&_nc_oc=AdnsdXXBPlAoSq9ggXbVIbonyqwehP0uBOz9DZzo3giiheDUw7Sq5_w2B4tEbsRHnDQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afwhlq4SxRZOAUOnJET8-PlhvG5jUljZEUQVslGA10TjJQ&oe=69AAD647"}]}, "id": "427392751735711", "locale": "en_US", "screenshots": [{"file_name": "SS_Lobby.png", "id": "517983419570667", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982535_517983422904000_961509076414854592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vouvLIcVswQ7kNvwGGLLMs&_nc_oc=Adm1wsT5lRT3SDFhE54Q6gXMydapi-0Fv_LHoMPqGLmhDLFFwxluhL5-BJ3l8aj05GA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2YTOqu-g3OpOcFgJqQH8EZukah5yupmuiNxyXU_qNZA&oe=69AABF6F"}, {"file_name": "SS_NML_Coop.png", "id": "4021722981223665", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974503_4021722991223664_2514267223949853207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8bkaDSLTEQQ7kNvwGAHTRl&_nc_oc=AdkYlv_i_03XQv1pogC2LZpdEpWvnYQD9Se0pcreLJYZ7subLv8ugZt5A4fr-nemcKE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGOxEMFxdDaNzE43M8NcHTUUOPOBV96vf9il4LgkrHvA&oe=69AAD2DB"}, {"file_name": "SS_NS_DEagle.png", "id": "455736925762084", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982695_455736929095417_7881349438133933608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpiVZ5ObBdUQ7kNvwFlsxcS&_nc_oc=AdnvDEVGdlwmthFedm445BBv9bDZdhIL2CHo8MjLOcIjCZpZOLbb0v3UQ8CDhuKM7sI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZpLLnEoL_YQaD1MHMFHFz5cNTAUPMw4FcYl8gYZqNdw&oe=69AAC86A"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tgtm9-R4rhUQ7kNvwHJ4ftY&_nc_oc=AdlEOLPgPIwnLSVKPvxzRTYK1QzymDBTfGkdGI0PihJDiDPT51qCZQfscniav2TRVXk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afyuc9_uWAd8dcVEUfIeJUULDcV84XGLrOndntoxTs8L4Q&oe=69AAD6AD"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmsYBOeptesQ7kNvwGlTlIE&_nc_oc=AdlaOsXTzafYV9zKQ_FZlkrseFFsPZQzFAkjhKie9tVsHcQSwdgFRNN1TSGj74UPNDM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyE5ABgzIAn1npQX4FGyQtKI_l3qUl6dKMBppEE6udCgA&oe=69AAE279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZCR_TrailerCover.png", "id": "862707597642544", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031331_862707600975877_8899701686782483767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raebDclPyeEQ7kNvwFQ7pYk&_nc_oc=AdnSOzQBaq1FsLYcrgqVvx8WIa31FUcs-RfzTs3kZj-uHmxbgpQmwtwv0nqh1cKQ-gM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxI9ETVDO-3t-Hoj-in3v_ytKy6_pH95cfljZC8uTc0jA&oe=69AAD6D0"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["fps", "shooter", "military", "coop", "single"], "long_description": "Grab your favourite guns, customize them and experience action like you never have before!\n\n# GAMEPLAY\nRise through the ranks to unlock a wide variety of weapons and attachments, climb, jump, crouch, shoot, reload, repeat - be prepared for a mind-blowingly immersive experience! \n\n# SINGLE PLAYER CAMPAIGN\nYou'll find yourself in a war-ridden, dystopian United States as a newly enlisted OSA soldier. What does OSA stand for? Outer States of America, the last bastion of hope. \nWar over water destroyed the world as we know it. You have an important mission: fight your way through the mysterious Tlalokii and find out the secrets they hold.. \n\n# CO-OPERATIVE MODE\nInvite your friends to your Co-op session, communicate via the built-in voice chat feature and fight through the whole campaign together ! \n\n# POST-RELEASE UPDATES\nKeep an eye out for future updates, the fun doesn't end here. ;) ", "short_description": "Zero Caliber: Reloaded is a story based military shooter with a full-blown single player campaign and Co-operative mode (up to 4 players).\nRise through the ranks to unlock a wide variety of weapons and attachments, customize them, climb, jump, crouch, shoot, get to cover, reload, invite your friends, repeat - be prepared for a mind-blowingly immersive experience! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrealgames.com/pp/", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://www.xrealgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "266374032273680"}}]}, "scheduled_offers": {"count": 83, "nodes": [{"status": "PUBLISHED", "id": "921854787056945"}, {"status": "PUBLISHED", "id": "1502900224143893"}, {"status": "CANCELLED", "id": "1244397190872845"}, {"status": "PUBLISHED", "id": "839364665694915"}, {"status": "PUBLISHED", "id": "1369746787850660"}, {"status": "PUBLISHED", "id": "1360604705775510"}, {"status": "PUBLISHED", 
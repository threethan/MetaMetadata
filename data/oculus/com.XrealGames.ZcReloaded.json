8982535_517983422904000_961509076414854592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7oDY4ZBPcwQ7kNvwGrKf1n&_nc_oc=AdrBoJxalmB-p7IUaC1OG80-g8EBEUWr0JkSdNVmFyNfHtuJoscC2N6FR9MExWRyQKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6Nk4G0VWHkBe3rdGEbM2r3_sZVHdnSHnEfmonIgqgyA&oe=6A9C3A2F"}, {"file_name": "SS_NML_Coop.png", "id": "4021722981223665", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_4021722991223664_2514267223949853207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU6Mor-AjpkQ7kNvwHEEZkn&_nc_oc=AdqHM54WvU7Gb2OZiQw_ofFsUVBWhTvN9BnyejKz3P1qBrQoEdXqM81SMVAfVJ7AgG4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAGTOBUxYBV8nqYaMmH94B7AVcsyEM4q-iRVrg4jJ3dw&oe=6A9C155B"}, {"file_name": "SS_NS_DEagle.png", "id": "455736925762084", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982695_455736929095417_7881349438133933608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cynZHq0qqKoQ7kNvwEwCwdC&_nc_oc=Adqisl8rczGNBg-eSB__uEAH7YWKrAk1TJ1nLdaRG9HvIT5kjq7dK3khbHzWtODBpxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnEkcOHmHbiT9H4fgaWAm1nh14agCpQ4O47dNLwLI_hQ&oe=6A9C432A"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M6HEJlHaxcQ7kNvwEXrRKL&_nc_oc=AdopZ8Cs3OhjI35JbYGim3nsTGx1rMuSnnxcUajOTy6jByB9N8b5Z3EG2lQ1xfcSh_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAG_RG6BLujv_XWVq8JzX0eIRYm36TZnaBvgYwQIdG2g&oe=6A9C192D"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA01CkETVsEQ7kNvwHmmc7h&_nc_oc=AdoeorzyxeQ5C_O5SUXQBVnQhzSVrZNP44gTN8TmNERkeEGGrf90ZttQfj8IMAGJBfM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI30cpQRs0WLNWaaK-uVOfmca6-Iw6wmXbG9OrNHNFIUQ&oe=6A9C24F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZeroCaliber_TrailerCover.png", "id": "6218093698276088", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974744_6218093704942754_7915310249497354316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ghBrw6DuhcQ7kNvwGJ_3li&_nc_oc=AdoQ7DtAeJ3sL2H7oBdaCDKqYyx2_5xmljTUNsIW7a9BxLJjbh2vKIlSdOfqSUbbrG0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI567csPNw2R0pqWgYf5wOsewziUhyxpykVIhwbDkY5Ow&oe=6A9C2076"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["military", "coop", "story", "pvp", "shooter"], "long_description": "**08/08/2026: NEW UPDATE IS LIVE - JUMP IN AND CHECK IT OUT!**\n\nZero Caliber: Reloaded is the all-in-one VR military FPS: play solo or in 4-player Co-op, jump into PvP, survive enemy waves, fight zombies, and explore community-made content with native mod support.\n\n# \u25c0 SINGLE-PLAYER CAMPAIGN \u25b6\n\nFight through 20+ story-driven missions in a war-torn, dystopian US as an OSA soldier and rise through the ranks to save what remains.\n\n{1945361609486962}\n\n# \u25c0 CO-OP & PVP \u25b6\n\nPlay the full campaign with up to 3 friends (or strangers) using built-in voice chat, or battle with, and against other players in Gun Game, TDM, DM, and more on dedicated servers.\n\n# \u25c0 SURVIVAL & ZOMBIE MODES \u25b6\n\nDefend key objectives in Survival, or take on the undead across 3 Zombie maps with limited ammo - for a change. ;)\n\n{1045391571560586}\n\n# \u25c0 CUSTOMIZE YOUR GEAR \u25b6\n\nChoose from 40+ firearms and melee weapons, 50+ attachments, and 100+ unlockable skins. Customize your weapons in real time and build a setup that fits your playstyle.\n\n{1687144575919760}\n\n# \u25c0 MOD SUPPORT \u25b6\n\nDownload community-made missions and PvP maps, or create your own content in UE4 through mod.io. (Details on our Discord.)\n\n{1660636295004509}\n\n# \u25c0 FUTURE UPDATES \u25b6\n\nMore updates are on the way: combat overhaul, better visuals and effects, smarter enemy AI, regular challenges, more unlockable content, and further improvements.\n\n- Join our Discord: https://discord.gg/xrealgames\n- Support: support@xrealgames.com\n\n# \u25c0 THE SEQUEL \u25b6\n\nIf you like Zero Caliber: Reloaded, you'll LOVE the sequel: \nhttps://www.meta.com/experiences/zero-caliber-2/6072194326150034/\n\n{1030261253251673}", "short_description": "Zero Caliber: Reloaded is an action-packed VR shooter featuring a full single-player and 4-player Co-op campaign, Survival, PvP and ZOMBIE modes, plus native mod support.\n\nBuild your loadout from a huge arsenal of weapons and attachments, customize every detail, then climb, jump, crouch, take cover and fight your way through intense missions with friends or on your own. Gear up, squad up and keep coming back for more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrealgames.com/aboutus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://sites.google.com/xrealgames.com/aboutus", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27700195222934950"}, "review_messages
8982535_517983422904000_961509076414854592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7oDY4ZBPcwQ7kNvwHnQOnp&_nc_oc=AdrEI-cJtg_1c7Ds4zl2AFi3VU3x0lwPlx-h6JYRPH3XTGbPRgrbxMUfK0_WFqF6tGU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5dUa8K4abKxTQHSiDFYpcqe8onW1-sSifB2rZz8eBNg&oe=6A9AE8AF"}, {"file_name": "SS_NML_Coop.png", "id": "4021722981223665", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974503_4021722991223664_2514267223949853207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU6Mor-AjpkQ7kNvwEZLit3&_nc_oc=AdoamO6LKWzZ3WfoBx5gKGvAcXYqasuuBJlr5QhI82izSLR1jc7qH1tYQ608kRXlK7Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9RmCVHhf1cq8ZVwHu1uP3G8QeNwVYWQalPxptZf-PXA&oe=6A9AC3DB"}, {"file_name": "SS_NS_DEagle.png", "id": "455736925762084", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982695_455736929095417_7881349438133933608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cynZHq0qqKoQ7kNvwEFG3px&_nc_oc=AdrRCSNQo5_ZdueiLJZdcEMsIGKLmXsAsj4rzWMPLVjd24guSeX6F1cxOYSKNP8QT6Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdH0Z2FN957G0BRhrLu1H7Qt-OfY-qQSTx7tPaAWFetw&oe=6A9AF1AA"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M6HEJlHaxcQ7kNvwFcjcsG&_nc_oc=AdoGjyBdamvwh7KEtdOmYsc0QTq5q9m2inSqnlmx-kJDpqVloZcBbHAI-YeedNuGbTw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdynEfnsQqtzQod0w4vAQixOdR8GS9knFVNCXF3w2jgg&oe=6A9AC7AD"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yU4P9CbHARUQ7kNvwGxz-Vl&_nc_oc=AdpIKQVw_d3iRccMtGyS6skR2ogwW_w2dZ3_TMMD6YHHelT1zcNvQHXII6St315ZX0g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDK_cYREIOS7VE9xAkx40WQZxuUcvgN5RT-WqZgJkcEw&oe=6A9AD379"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZeroCaliber_TrailerCover.png", "id": "6218093698276088", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974744_6218093704942754_7915310249497354316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XuxBqlEQLMQ7kNvwGIfhnR&_nc_oc=AdouPFBcrVGn4ROcr08hee1s8zPRg87VrCgMCFXI2Nta8bS8hYOhj9PhL55zasNTp90&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXVsGh3jl6flwnGNxpEFO2eRtQzjBu9OhjxBpjx5on6g&oe=6A9ACEF6"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["military", "coop", "story", "pvp", "shooter"], "long_description": "**08/08/2026: NEW UPDATE IS LIVE - JUMP IN AND CHECK IT OUT!**\n\nZero Caliber: Reloaded is the all-in-one VR military FPS: play solo or in 4-player Co-op, jump into PvP, survive enemy waves, fight zombies, and explore community-made content with native mod support.\n\n# \u25c0 SINGLE-PLAYER CAMPAIGN \u25b6\n\nFight through 20+ story-driven missions in a war-torn, dystopian US as an OSA soldier and rise through the ranks to save what remains.\n\n{1945361609486962}\n\n# \u25c0 CO-OP & PVP \u25b6\n\nPlay the full campaign with up to 3 friends (or strangers) using built-in voice chat, or battle with, and against other players in Gun Game, TDM, DM, and more on dedicated servers.\n\n# \u25c0 SURVIVAL & ZOMBIE MODES \u25b6\n\nDefend key objectives in Survival, or take on the undead across 3 Zombie maps with limited ammo - for a change. ;)\n\n{1045391571560586}\n\n# \u25c0 CUSTOMIZE YOUR GEAR \u25b6\n\nChoose from 40+ firearms and melee weapons, 50+ attachments, and 100+ unlockable skins. Customize your weapons in real time and build a setup that fits your playstyle.\n\n{1687144575919760}\n\n# \u25c0 MOD SUPPORT \u25b6\n\nDownload community-made missions and PvP maps, or create your own content in UE4 through mod.io. (Details on our Discord.)\n\n{1660636295004509}\n\n# \u25c0 FUTURE UPDATES \u25b6\n\nMore updates are on the way: combat overhaul, better visuals and effects, smarter enemy AI, regular challenges, more unlockable content, and further improvements.\n\n- Join our Discord: https://discord.gg/xrealgames\n- Support: support@xrealgames.com\n\n# \u25c0 THE SEQUEL \u25b6\n\nIf you like Zero Caliber: Reloaded, you'll LOVE the sequel: \nhttps://www.meta.com/experiences/zero-caliber-2/6072194326150034/\n\n{1030261253251673}", "short_description": "Zero Caliber: Reloaded is an action-packed VR shooter featuring a full single-player and 4-player Co-op campaign, Survival, PvP and ZOMBIE modes, plus native mod support.\n\nBuild your loadout from a huge arsenal of weapons and attachments, customize every detail, then climb, jump, crouch, take cover and fight your way through intense missions with friends or on your own. Gear up, squad up and keep coming back for more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrealgames.com/aboutus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://sites.google.com/xrealgames.com/aboutus", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27700195222934950"}, "review_messages
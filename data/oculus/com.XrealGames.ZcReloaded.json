&oh=00_AQKmduZMGVYDKF606wSz2xXTOzDf3MfdBWDCI80kpsF6jA&oe=6AB3D05B"}, {"file_name": "SS_NS_DEagle.png", "id": "455736925762084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982695_455736929095417_7881349438133933608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgYt298sOTwQ7kNvwGg5PR6&_nc_oc=AdqYGaWI0-iODHrtgv-HlyDXXiqqQP4jp6rNbgNkCUlXNff0R-lpz9hdsRfSDWZSPT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaDXCwUOm9iPKJCHEXs_rsFw4FnNOoC1DqroPtn9rNXg&oe=6AB3C5EA"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt5uTDHWEzYQ7kNvwFqtA0s&_nc_oc=AdovHtwE_fgtZ8z8eyAXYiTl3HlhGEu2UsMtInd_CxiW8ugbvSGPhJOphPec8slYedg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9q1xIfNOQZ24V6-tGe3bC15VlAz4BwXPc3mFCY5t6Ow&oe=6AB3D42D"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UCDybD_GYkQ7kNvwFYKjFo&_nc_oc=Adq-sC9njp1ytOOgE1ouGwMYcG0xUGi1DNoLs1TLFvx7MDOlWSVYdIQg_jcoMCDA8HM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiJtvghCTBwKkLXkWGZFElL_DqBXTHFpI18Ja68PfxLA&oe=6AB3DFF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZCR_TrailerCover.png", "id": "862707597642544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031331_862707600975877_8899701686782483767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnYs9WXNnT0Q7kNvwHzoYRA&_nc_oc=Adqh6pTBDDWRAFarFt5EaoWt71alljwsiXwrkrxwl6e8HBol4oY_fLpxgTGJD4OBp0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWYRIAJNjGQFaK5JiHoaEqujShwddCs4zo5INUgClgFA&oe=6AB3D450"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["fps", "shooter", "military", "coop", "single"], "long_description": "Grab your favourite guns, customize them and experience action like you never have before!\n\n# GAMEPLAY\nRise through the ranks to unlock a wide variety of weapons and attachments, climb, jump, crouch, shoot, reload, repeat - be prepared for a mind-blowingly immersive experience! \n\n# SINGLE PLAYER CAMPAIGN\nYou'll find yourself in a war-ridden, dystopian United States as a newly enlisted OSA soldier. What does OSA stand for? Outer States of America, the last bastion of hope. \nWar over water destroyed the world as we know it. You have an important mission: fight your way through the mysterious Tlalokii and find out the secrets they hold.. \n\n# CO-OPERATIVE MODE\nInvite your friends to your Co-op session, communicate via the built-in voice chat feature and fight through the whole campaign together ! \n\n# POST-RELEASE UPDATES\nKeep an eye out for future updates, the fun doesn't end here. ;) ", "short_description": "Zero Caliber: Reloaded is a story based military shooter with a full-blown single player campaign and Co-operative mode (up to 4 players).\nRise through the ranks to unlock a wide variety of weapons and attachments, customize them, climb, jump, crouch, shoot, get to cover, reload, invite your friends, repeat - be prepared for a mind-blowingly immersive experience! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrealgames.com/pp/", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://www.xrealgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
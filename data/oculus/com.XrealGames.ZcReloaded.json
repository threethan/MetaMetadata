kK2er8a-XwEiMMi1JmSr-zxd0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs6RkSyFPucniaIED1LgVyVlzjPqmh3QKjtKixVWDnCJg&oe=69A04AAD"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zty2pMgM5mcQ7kNvwF57R69&_nc_oc=Adm9Ira8D_LVmWOpzBVPAEGju3Xq22QzqR-7tv1hxmtvynLWqBbWF98yAgIM_p_Q2dg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuTYF2V5wGvCS5xBuowXd-WIWNxNHdIfuCMo7OVfAi6zg&oe=69A05679"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZCR_TrailerCover.png", "id": "862707597642544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031331_862707600975877_8899701686782483767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RinwEwJDNQ0Q7kNvwHh-skT&_nc_oc=AdmFYp-yKV5VW5c9uasE2P378-WzplBpM0wgHo6oV1IaXxqYSrS19mW0s3NclSI_GPY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsS1O2HaabqW1QMpXhY6Q4XIueaJAyGSkMOq2WxpTsOAA&oe=69A04AD0"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["fps", "shooter", "military", "coop", "single"], "long_description": "Grab your favourite guns, customize them and experience action like you never have before!\n\n# GAMEPLAY\nRise through the ranks to unlock a wide variety of weapons and attachments, climb, jump, crouch, shoot, reload, repeat - be prepared for a mind-blowingly immersive experience! \n\n# SINGLE PLAYER CAMPAIGN\nYou'll find yourself in a war-ridden, dystopian United States as a newly enlisted OSA soldier. What does OSA stand for? Outer States of America, the last bastion of hope. \nWar over water destroyed the world as we know it. You have an important mission: fight your way through the mysterious Tlalokii and find out the secrets they hold.. \n\n# CO-OPERATIVE MODE\nInvite your friends to your Co-op session, communicate via the built-in voice chat feature and fight through the whole campaign together ! \n\n# POST-RELEASE UPDATES\nKeep an eye out for future updates, the fun doesn't end here. ;) ", "short_description": "Zero Caliber: Reloaded is a story based military shooter with a full-blown single player campaign and Co-operative mode (up to 4 players).\nRise through the ranks to unlock a wide variety of weapons and attachments, customize them, climb, jump, crouch, shoot, get to cover, reload, invite your friends, repeat - be prepared for a mind-blowingly immersive experience! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrealgames.com/pp/", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://www.xrealgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "266374032273680"}}]}, "scheduled_offers": {"count": 82, "nodes": [{"status": "PUBLISHED", "id": "1502900224143893"}, {"status": "CANCELLED", "id": "1244397190872845"}, {"status": "PUBLISHED", "id": "839364665694915"}, {"status": "PUBLISHED", "id": "1369746787850660"}, {"status": "PUBLISHED", "id": "1360604705775510"}, {"status": "PUBLISHED", "id": "1124353519621173"}, {"status": "PUBLISHED", "id": "1786675605391610"}, {"status": "PUBLISHED", "id": "1187145823170366"}, {"status": "PUBLISHED", "id": "1422392632010791"}, {"stat
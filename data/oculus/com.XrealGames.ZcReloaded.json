&oh=00_AQLztL_qrZ-c_nGaajgRqEFr_1FJ1Th267uRz1ZKEuCmKA&oe=6AAFDBDB"}, {"file_name": "SS_NS_DEagle.png", "id": "455736925762084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982695_455736929095417_7881349438133933608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1jNOmzL--0Q7kNvwEhF4eO&_nc_oc=AdrbZqFeiioQCTDDvKj4_dOWnq22YB-EktU2zCnRVjeUcZ4GHT6-PZIZsxq-b1C9ueo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLniNvav1_oEjqlFMx7fRlpPmYYDBO99uOzESRZpuPGgw&oe=6AAFD16A"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlQbNzlV-AgQ7kNvwGt0Wnu&_nc_oc=Ado0sCzt5Zt5Geb-xRkQe8qr0HUFBLyTK_QzEcFOni0cObzGIGKHN60x0kST8USTJ90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJi-WzZ6lx_U7jLd9N2dHcclwT67KmkupwG8ygerEqiw&oe=6AAFDFAD"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28OePSX7U5wQ7kNvwFvsdzC&_nc_oc=AdqBBO-H9p7qRgw0-cnPvFQsKGoLASR3NNqX_dvwSjyjPZ1n58jFf4ShAI5XX5wk_Fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpJr2nKVMgDVz7J5bu1tiZ5vJrogi8gBsxbzpdM09I1w&oe=6AAFEB79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZCR_TrailerCover.png", "id": "862707597642544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031331_862707600975877_8899701686782483767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6xBFlTQeKAQ7kNvwE-r3O0&_nc_oc=Adojc81V1ecFKq8RIM5K-rH8keBcTbVzWcOHKiT7Olkg6PPZh20BUZpRbsGLf1bcFpE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzN6uceKAVp-ndBwg16Wkc3n1Mn2WJ7XfNfdgPRTPV2g&oe=6AAFDFD0"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["fps", "shooter", "military", "coop", "single"], "long_description": "Grab your favourite guns, customize them and experience action like you never have before!\n\n# GAMEPLAY\nRise through the ranks to unlock a wide variety of weapons and attachments, climb, jump, crouch, shoot, reload, repeat - be prepared for a mind-blowingly immersive experience! \n\n# SINGLE PLAYER CAMPAIGN\nYou'll find yourself in a war-ridden, dystopian United States as a newly enlisted OSA soldier. What does OSA stand for? Outer States of America, the last bastion of hope. \nWar over water destroyed the world as we know it. You have an important mission: fight your way through the mysterious Tlalokii and find out the secrets they hold.. \n\n# CO-OPERATIVE MODE\nInvite your friends to your Co-op session, communicate via the built-in voice chat feature and fight through the whole campaign together ! \n\n# POST-RELEASE UPDATES\nKeep an eye out for future updates, the fun doesn't end here. ;) ", "short_description": "Zero Caliber: Reloaded is a story based military shooter with a full-blown single player campaign and Co-operative mode (up to 4 players).\nRise through the ranks to unlock a wide variety of weapons and attachments, customize them, climb, jump, crouch, shoot, get to cover, reload, invite your friends, repeat - be prepared for a mind-blowingly immersive experience! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrealgames.com/pp/", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://www.xrealgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
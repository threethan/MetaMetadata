53207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6z9IuIhluIQ7kNvwHL7lmI&_nc_oc=AdrAnYkSx5wbL5vBsVJlalrvcLr-rB6E91VnlaLe_90-e_ZUwylyX-8jbNbcn0N5_Do&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0WTGmheEmKBqVtm-48YQMOcTMWkdQVR0pVT3xtP1efQ&oe=6A7C715B"}, {"file_name": "SS_NS_DEagle.png", "id": "455736925762084", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982695_455736929095417_7881349438133933608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOzbLlnaua4Q7kNvwH0b1nj&_nc_oc=AdqRtQZtPLnxlm_G34Q-0-29OKUlMZs5iR9ijm3vGABXBtcSZ-asVbonqdJgP_rOvJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEhFbPT8gxFHdlWVboaQCxgqVVHZJzzACgvWzjvrAu_A&oe=6A7C66EA"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6tIsHLF0OMQ7kNvwG7U868&_nc_oc=Adqy9JNDCTQ7Np__wEpOlYznSiaA2o-WN1wWYN26OpNc0e3GvWsWij4yi9hlkXhb9XM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEW9nMQT7sfuaZapwV6UPkg7sU6HaJK2ubQC-FeS_XXQ&oe=6A7C752D"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2fLDARNq8oQ7kNvwH0qagf&_nc_oc=AdoqQrfu7RjjBvAwpO_SQI0XE9JGVJeUKozZefAegLSH4o6h6R4UMim8KqDMh2CJFls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6BCYDlACdBoEvBqDMdHnpO4OUHHQOc67uUAA4IsbL7Q&oe=6A7C48B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZCR_TrailerCover.png", "id": "862707597642544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031331_862707600975877_8899701686782483767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHGFBn1_mgEQ7kNvwGpDODJ&_nc_oc=Adqp4z6pMY802mDFl49j80osBlLMaGJxy2-4PXkbCQCe5ZhMjt4ZvtI1I9B1zL-jKR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERxBmkOEd06zIGy8nUHDbDc1Vc1492YFHe62HmEv6QNA&oe=6A7C7550"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["fps", "shooter", "military", "coop", "single"], "long_description": "Grab your favourite guns, customize them and experience action like you never have before!\n\n# GAMEPLAY\nRise through the ranks to unlock a wide variety of weapons and attachments, climb, jump, crouch, shoot, reload, repeat - be prepared for a mind-blowingly immersive experience! \n\n# SINGLE PLAYER CAMPAIGN\nYou'll find yourself in a war-ridden, dystopian United States as a newly enlisted OSA soldier. What does OSA stand for? Outer States of America, the last bastion of hope. \nWar over water destroyed the world as we know it. You have an important mission: fight your way through the mysterious Tlalokii and find out the secrets they hold.. \n\n# CO-OPERATIVE MODE\nInvite your friends to your Co-op session, communicate via the built-in voice chat feature and fight through the whole campaign together ! \n\n# POST-RELEASE UPDATES\nKeep an eye out for future updates, the fun doesn't end here. ;) ", "short_description": "Zero Caliber: Reloaded is a story based military shooter with a full-blown single player campaign and Co-operative mode (up to 4 players).\nRise through the ranks to unlock a wide variety of weapons and attachments, customize them, climb, jump, crouch, shoot, get to cover, reload, invite your friends, repeat - be prepared for a mind-blowingly immersive experience! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrealgames.com/pp/", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://www.xrealgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"
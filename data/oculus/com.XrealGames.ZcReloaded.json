7kNvwFO1lYC&_nc_oc=AdoKaxbXBU_gBqpW19c41msDVvMZMKzrf8enBqOeSf7P5nQW0G9HVSbQ1ewFDIpRgGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKUVkbYxbssfjhim0jzsS_HRAlSGypFJbrZbKUpm0V_w&oe=6A79C3EA"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6tIsHLF0OMQ7kNvwFMVLnc&_nc_oc=Adq22D_GZsJGeyd9jtdrFtzd2LGX_44Sf-6EvOfEhZvWi9Bw-Z0HJCNXMhn6V2SNipM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVaSOgEe27A4_YWjlW7DlDPNydr_4-PlliLwhTnnIp8w&oe=6A79D22D"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apz2Wv-LHygQ7kNvwEzefRB&_nc_oc=Adomd8La0t4x0pmuofa0QjK6DCLE18BrFq34PSpxW_Z8NjkjFxfYxzkEsfVJHTZT8Oc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6MLS_37tZIBNo6zS96LEu3OywC5QVFfglD2ZrjQgK9Q&oe=6A79DDF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZeroCaliber_TrailerCover.png", "id": "6218093698276088", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974744_6218093704942754_7915310249497354316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WYTw1VcHF0Q7kNvwFnLvdu&_nc_oc=AdrHVShChgsYXg5g9x3xYMHmIhrUjYGcLJzLUKF_2SYbOSTMYml2lmirXdeRCG3Xaq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw9zVz1EroZgvjtj7CKna7aX1R7zcalOiyftqC0UaZ3A&oe=6A79D976"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["military", "coop", "story", "pvp", "shooter"], "long_description": "**07/31/2026: NEW UPDATE IS LIVE - JUMP IN AND CHECK IT OUT!**\n\nZero Caliber: Reloaded is the all-in-one VR military FPS: play solo or in 4-player Co-op, jump into PvP, survive enemy waves, fight zombies, and explore community-made content with native mod support.\n\n# \u25c0 SINGLE-PLAYER CAMPAIGN \u25b6\n\nFight through 20+ story-driven missions in a war-torn, dystopian US as an OSA soldier and rise through the ranks to save what remains.\n\n{1061312729716830}\n\n# \u25c0 CO-OP & PVP \u25b6\n\nPlay the full campaign with up to 3 friends (or strangers) using built-in voice chat, or battle with, and against other players in Gun Game, TDM, DM, and more on dedicated servers.\n\n# \u25c0 SURVIVAL & ZOMBIE MODES \u25b6\n\nDefend key objectives in Survival, or take on the undead across 3 Zombie maps with limited ammo - for a change. ;)\n\n{2272861963525180}\n\n# \u25c0 CUSTOMIZE YOUR GEAR \u25b6\n\nChoose from 40+ firearms and melee weapons, 50+ attachments, and 100+ unlockable skins. Customize your weapons in real time and build a setup that fits your playstyle.\n\n{1474730788015779}\n\n# \u25c0 MOD SUPPORT \u25b6\n\nDownload community-made missions and PvP maps, or create your own content in Unreal Engine through mod.io. (Details on our Discord.)\n\n{937214432744845}\n\n# \u25c0 FUTURE UPDATES \u25b6\n\nMore updates are on the way, including a combat overhaul, better visuals and effects, smarter enemy AI, regular challenges, more unlockable content, and further improvements. Stick around, it'll be worth it!\n\n- Join our Discord: https://discord.gg/xrealgames\n- Support: support@xrealgames.com", "short_description": "Zero Caliber: Reloaded is an action-packed VR shooter featuring a full single-player and 4-player Co-op campaign, Survival, PvP and ZOMBIE modes, plus native mod support.\n\nBuild your loadout from a huge arsenal of weapons and attachments, customize every detail, then climb, jump, crouch, take cover and fight your way through intense missions with friends or on your own. Gear up, squad up and keep coming back for more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrealgames.com/aboutus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "supp
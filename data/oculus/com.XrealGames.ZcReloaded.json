g", "id": "1086018135226239", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1086018138559572_7081831439368505789_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SGmGSetr8wQ7kNvwEAEdDE&_nc_oc=AdkNt5ANmwZIy1zFmqNX-J50x8DJdJVzKT6ZZmid_dY2cprCmotOjtQ8n4ayml-vdtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOSpSqpNRGizxUJmKC7ySmW-LlNlB_mvmpmk17uMD_Rg&oe=69AC27C7"}]}, "id": "427392751735711", "locale": "en_US", "screenshots": [{"file_name": "SS_Lobby.png", "id": "517983419570667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982535_517983422904000_961509076414854592_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vouvLIcVswQ7kNvwFV4E0o&_nc_oc=AdkGULdupT9Q7q0iOMtvPy7Gm9g9LXItGiLbkMXjfVdnKadfZJ_v0YOHOLlOBlwtFZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzo_vmLgG9UdvNZUHBAgGr1EgY8_4yr-bIPbiZxap8L_w&oe=69AC10EF"}, {"file_name": "SS_NML_Coop.png", "id": "4021722981223665", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974503_4021722991223664_2514267223949853207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8bkaDSLTEQQ7kNvwH3SItQ&_nc_oc=AdktzOXbgzpsZO61BnIMR09uIByhZ67t30eI2Dp8RwX6Rtb8E_2KOijhopog3jO8ItY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyH-qT2EJAkAuhtlnH4TNt8C6peo183DpKwmmQOjP1b1Q&oe=69AC245B"}, {"file_name": "SS_NS_DEagle.png", "id": "455736925762084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982695_455736929095417_7881349438133933608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGQQAccOBBgQ7kNvwFlXJL2&_nc_oc=AdnV7gg1SuGFOgXJcC78plnvFs3v9e7WqtzkJoh8B5P7MqgP0GW7KVwpVbeUJucUjv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXQUanURhpAbaUP7em0zXXFVQyS_Jqda2lQdB-HxSzXg&oe=69AC19EA"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8oxsyb4PioQ7kNvwF7WqGp&_nc_oc=Adk0y3igFrtRLu2Kay6AyrpS0Q99qDmiPGoSuMEdEpDiUSgsE4drnNbsSOZ771OWrUE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz3-OeVXtFMOxLrJACHStFwS_A1t3suG38w8bi9O3x1Qw&oe=69AC282D"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmsYBOeptesQ7kNvwEHrmFG&_nc_oc=Adnf6Tc8sf2BpHjFbXjmhhjGvW1EFJklRB9f8QL9cXaF1ME2uX9D8tlWfQ7KPu3N62A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz52_Vbe5tMvIYbrwc5rcrfZ7Ejrr8-Hj15pTn3gxXf0g&oe=69AC33F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZCR_TrailerCover.png", "id": "862707597642544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031331_862707600975877_8899701686782483767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raebDclPyeEQ7kNvwHNnYD4&_nc_oc=AdkKonAFy3emzWXrXCk_9acv_x1BpFNWfJm52AhKnJ-TjhEIs8wdIDqHL3KRlHuDY44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPNYUfia902_XR8DUiESNkAcjmMgtG61DLW900xBa7hw&oe=69AC2850"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["fps", "shooter", "military", "coop", "single"], "long_description": "Grab your favourite guns, customize them and experience action like you never have before!\n\n# GAMEPLAY\nRise through the ranks to unlock a wide variety of weapons and attachments, climb, jump, crouch, shoot, reload, repeat - be prepared for a mind-blowingly immersive experience! \n\n# SINGLE PLAYER CAMPAIGN\nYou'll find yourself in a war-ridden, dystopian United States as a newly enlisted OSA soldier. What does OSA stand for? Outer States of America, the last bastion of hope. \nWar over water destroyed the world as we know it. You have an important mission: fight your way through the mysterious Tlalokii and find out the secrets they hold.. \n\n# CO-OPERATIVE MODE\nInvite your friends to your Co-op session, communicate via the built-in voice chat feature and fight through the whole campaign together ! \n\n# POST-RELEASE UPDATES\nKeep an eye out for future updates, the fun doesn't end here. ;) ", "short_description": "Zero Caliber: Reloaded is a story based military shooter with a full-blown single player campaign and Co-operative mode (up to 4 players).\nRise through the ranks to unlock a wide variety of weapons and attachments, customize them, climb, jump, crouch, shoot, get to cover, reload, invite your friends, repeat - be prepared for a mind-blowingly immersive experience! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrealgames.com/pp/", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://www.xrealgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "266374032273680"}}]}, "scheduled_offers": {"count": 83, "nodes": [{"status": "PUBLISHED", "id": "921854787056945"}, {"status": "PUBLISHED", "id": "1502900224143893"}, {"status": "CANCELLED", "id": "1244397190872845"}, {"status": "PUBLISHED", "id": "839364665694915"}, {"status": "PUBLISHED", "id": "1369746787850660"}, {"status": "PUBLISHED", "id": "1360604705775510"}, {"status": "PUBLISHED", "id": "112
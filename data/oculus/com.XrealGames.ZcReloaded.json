zANxMs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEycGBjijIzvq0BxU9DJUhqfwWKD3NktxnB13UxIRVAtw&oe=6A8065DB"}, {"file_name": "SS_NS_DEagle.png", "id": "455736925762084", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982695_455736929095417_7881349438133933608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE8KrN3v5jkQ7kNvwGSCfQq&_nc_oc=AdpXgxcVKoyJSZAczPMfwwmd9Xf64USrrxWhbPyihYMmPmfj1btxikPnu9d_HS9lOqA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMGfkQGZTjCkyMjokFfaUPlCFzrKLUVEJDkf8xRP3RoA&oe=6A805B6A"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovHWpskrKb0Q7kNvwEJJX3c&_nc_oc=Adr-stEARXUhoTzBzCiBfoditPLj0ZfvdQcAlRi-qwEfDpMcBZZbVcuxMxyb5lEPBRg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC8CIQY4x1bo9J3IDCzErWQDcSUepxmWPipgxp-rzVqA&oe=6A8069AD"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqCnASZmFcQQ7kNvwGHU8TZ&_nc_oc=AdrLW2gNkt0MQ355MTRRiZ3FdK0EfUg339lq98pJs13tFoRYH4MNYtLeI3KPCy7tmKU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1WMIRRXImtQJuvk2vQMxLOa2nke6CRxONaY5LFTzZdg&oe=6A803D39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZeroCaliber_TrailerCover.png", "id": "6218093698276088", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974744_6218093704942754_7915310249497354316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnGqqGRMP7IQ7kNvwEuk3VF&_nc_oc=AdpfItBu9Soy1uH1EzpuIGbw_L5WIYPuRRfghy6-iscQ8BS7w_6OIYtKxzsrmS5oIjE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFju9Y9OkOlma6e7JWuuk3K_wCiNzDLW3j3lYx-wpaECA&oe=6A8070F6"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["military", "coop", "story", "pvp", "shooter"], "long_description": "**08/08/2026: NEW UPDATE IS LIVE - JUMP IN AND CHECK IT OUT!**\n\nZero Caliber: Reloaded is the all-in-one VR military FPS: play solo or in 4-player Co-op, jump into PvP, survive enemy waves, fight zombies, and explore community-made content with native mod support.\n\n# \u25c0 SINGLE-PLAYER CAMPAIGN \u25b6\n\nFight through 20+ story-driven missions in a war-torn, dystopian US as an OSA soldier and rise through the ranks to save what remains.\n\n{1945361609486962}\n\n# \u25c0 CO-OP & PVP \u25b6\n\nPlay the full campaign with up to 3 friends (or strangers) using built-in voice chat, or battle with, and against other players in Gun Game, TDM, DM, and more on dedicated servers.\n\n# \u25c0 SURVIVAL & ZOMBIE MODES \u25b6\n\nDefend key objectives in Survival, or take on the undead across 3 Zombie maps with limited ammo - for a change. ;)\n\n{1045391571560586}\n\n# \u25c0 CUSTOMIZE YOUR GEAR \u25b6\n\nChoose from 40+ firearms and melee weapons, 50+ attachments, and 100+ unlockable skins. Customize your weapons in real time and build a setup that fits your playstyle.\n\n{1687144575919760}\n\n# \u25c0 MOD SUPPORT \u25b6\n\nDownload community-made missions and PvP maps, or create your own content in UE4 through mod.io. (Details on our Discord.)\n\n{1660636295004509}\n\n# \u25c0 FUTURE UPDATES \u25b6\n\nMore updates are on the way: combat overhaul, better visuals and effects, smarter enemy AI, regular challenges, more unlockable content, and further improvements.\n\n- Join our Discord: https://discord.gg/xrealgames\n- Support: support@xrealgames.com\n\n# \u25c0 THE SEQUEL \u25b6\n\nIf you like Zero Caliber: Reloaded, you'll LOVE the sequel: \nhttps://www.meta.com/experiences/zero-caliber-2/6072194326150034/\n\n{1030261253251673}", "short_description": "Zero Caliber: Reloaded is an action-packed VR shooter featuring a full single-player and 4-player Co-op campaign, Survival, PvP and ZOMBIE modes, plus native mod support.\n\nBuild your loadout from a huge arsenal of weapons and attachments, customize every detail, then climb, jump, crouch, take cover and fight your way through intense missions with friends or on your own. Gear up, squad up and keep coming back for more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrealgames.com/aboutus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://sites.google.com/xrealgames.com/aboutus", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27700195222934950"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75395604_710016364330296_5275738623776481080_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVlzo44M7XsQ7kNvwEUWh1I&_nc_oc=AdqL5s1y3k1LP0NB3dkaxTkecFM30f8hi62g_hPmMusisqjXnJ7z7kHdhALw78U03Hg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF0rUnY5t6mMKpOaRNJT8tei0gnRG_9ja0oTfnsSRVPg&oe=6A8056BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zero Caliber: Reloaded", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", 
3664_2514267223949853207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6z9IuIhluIQ7kNvwHT4kxa&_nc_oc=AdryFxO_V4BJ09JLz-TFN-hFKXY1IMs8PQqkA09BP4LXsWqKXqo89vQMGypEtZVl8Jk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcmtISuUIfB9R2sGBV0_ZK-FOaS9mHWQ4jLghulJGIKA&oe=6A7DC2DB"}, {"file_name": "SS_NS_DEagle.png", "id": "455736925762084", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982695_455736929095417_7881349438133933608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE8KrN3v5jkQ7kNvwGTgyTf&_nc_oc=Adp77Kx_jI3Bk0yu6Kkf-GVO7vHnvF4z-fVY7OGaAeCW0XLw2vxKCJgubsuilcO9UXU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUBCOzCWpHSYFBmFjOp2mGhSdiKgqvhSwCn0vLAGiO3Q&oe=6A7DB86A"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovHWpskrKb0Q7kNvwFiIuFq&_nc_oc=AdrWjwZIN-GbPiVzzgH_Bosyrd4VVWArsZTyEIZLJdnzsiQbvT03DUgWm0rSxJAjh7k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnj0isg94nuZLtyTqL9xTK_CHBffQaqxi0uDv1gxwsOg&oe=6A7DC6AD"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2fLDARNq8oQ7kNvwF8ILRr&_nc_oc=AdpuK7GmgmIdaP7a0fgos4JBa-SMliL8gAoPk9H1RG7jI5bUmDHdVa3IFoE_5snVJQ0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG02x41kbAjMXVv5qfESWT8ayDCVyQFbExEsbIC1_YHVw&oe=6A7D9A39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZCR_TrailerCover.png", "id": "862707597642544", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031331_862707600975877_8899701686782483767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHGFBn1_mgEQ7kNvwHW2DEo&_nc_oc=AdqR9fqLSmZnffLwLfZaP2cjxLNrcaV9LzxEjt2GufIWYi8thDhSH94TWkd91c2znsI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXCLzksSlr5UH4EnLWIBu06gm33BMCEdkxk873vpIa0g&oe=6A7DC6D0"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["fps", "shooter", "military", "coop", "single"], "long_description": "Grab your favourite guns, customize them and experience action like you never have before!\n\n# GAMEPLAY\nRise through the ranks to unlock a wide variety of weapons and attachments, climb, jump, crouch, shoot, reload, repeat - be prepared for a mind-blowingly immersive experience! \n\n# SINGLE PLAYER CAMPAIGN\nYou'll find yourself in a war-ridden, dystopian United States as a newly enlisted OSA soldier. What does OSA stand for? Outer States of America, the last bastion of hope. \nWar over water destroyed the world as we know it. You have an important mission: fight your way through the mysterious Tlalokii and find out the secrets they hold.. \n\n# CO-OPERATIVE MODE\nInvite your friends to your Co-op session, communicate via the built-in voice chat feature and fight through the whole campaign together ! \n\n# POST-RELEASE UPDATES\nKeep an eye out for future updates, the fun doesn't end here. ;) ", "short_description": "Zero Caliber: Reloaded is a story based military shooter with a full-blown single player campaign and Co-operative mode (up to 4 players).\nRise through the ranks to unlock a wide variety of weapons and attachments, customize them, climb, jump, crouch, shoot, get to cover, reload, invite your friends, repeat - be prepared for a mind-blowingly immersive experience! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrealgames.com/pp/", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://www.xrealgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"
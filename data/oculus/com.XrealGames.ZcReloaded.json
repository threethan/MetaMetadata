53207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6z9IuIhluIQ7kNvwEJ_pCV&_nc_oc=Adr8rpKTrZYFvRzb1Ppobpu7oD7aVheATfQYt5Meq2Y_HbvBHjQGYf_1QslahCUmR9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaOUgv6jLKeJ6FAqrZz3mheg16mz6FHQGbJE4cQhI5yg&oe=6A7B1FDB"}, {"file_name": "SS_NS_DEagle.png", "id": "455736925762084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982695_455736929095417_7881349438133933608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOzbLlnaua4Q7kNvwH9_jFV&_nc_oc=AdrjMw0jJi1auf1ZWY3ucVYyOF5O6ALvzRAnac9AGnd2c_1N88UrhrbOjLFRapwtKmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwF6MH2v7C-AM9ghp722u2lXJ05lDQx2sUChhx3oq7dw&oe=6A7B156A"}, {"file_name": "SS_NS_Melee.png", "id": "2869850269929384", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001725_2869850273262717_4175302387196588685_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6tIsHLF0OMQ7kNvwGXTuko&_nc_oc=Ado_-X3gN9XwomzpBeAmAy_-cOvX0ysw88zLer88SJrgsRL-_VCd7Tfio-AbIcsqdTU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsxt2Gw4cCScozAAB2kiJeN8D3ink8IdqSgFg2QwlL_Q&oe=6A7B23AD"}, {"file_name": "SS_Sewers_Attach.png", "id": "1183420602096445", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982555_1183420605429778_8197905822731023677_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apz2Wv-LHygQ7kNvwEjTOd0&_nc_oc=AdpYrOMRSy7eC1nSxutjHDlWZvQMmao32_hz6cFDC2c_GMqCOeHloaHk959384-SftY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcOEy1R9ilXAVYIELRTYMwOmdEJMb_y5YcEMQoH6D3ww&oe=6A7B2F79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZCR_TrailerCover.png", "id": "862707597642544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031331_862707600975877_8899701686782483767_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BE8wAjXGrpkQ7kNvwGGkw9Q&_nc_oc=Adp95cnD2qQGPLRaoNr8cuw6K4TGHsfeMYRLmaGHqPZfibEam6VXpfTW5pGfv2QHeAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcaBdpt7Ux3cAhchD2DYWE2oKShIBVvkTGm62QgPpeQA&oe=6A7B23D0"}, "display_name": "Zero Caliber: Reloaded", "keywords": ["fps", "shooter", "military", "coop", "single"], "long_description": "Grab your favourite guns, customize them and experience action like you never have before!\n\n# GAMEPLAY\nRise through the ranks to unlock a wide variety of weapons and attachments, climb, jump, crouch, shoot, reload, repeat - be prepared for a mind-blowingly immersive experience! \n\n# SINGLE PLAYER CAMPAIGN\nYou'll find yourself in a war-ridden, dystopian United States as a newly enlisted OSA soldier. What does OSA stand for? Outer States of America, the last bastion of hope. \nWar over water destroyed the world as we know it. You have an important mission: fight your way through the mysterious Tlalokii and find out the secrets they hold.. \n\n# CO-OPERATIVE MODE\nInvite your friends to your Co-op session, communicate via the built-in voice chat feature and fight through the whole campaign together ! \n\n# POST-RELEASE UPDATES\nKeep an eye out for future updates, the fun doesn't end here. ;) ", "short_description": "Zero Caliber: Reloaded is a story based military shooter with a full-blown single player campaign and Co-operative mode (up to 4 players).\nRise through the ranks to unlock a wide variety of weapons and attachments, customize them, climb, jump, crouch, shoot, get to cover, reload, invite your friends, repeat - be prepared for a mind-blowingly immersive experience! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrealgames.com/pp/", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://www.xrealgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"
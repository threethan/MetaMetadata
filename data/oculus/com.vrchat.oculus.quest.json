8&oh=00_AfyATYnXI2ekCBwRLLGBlJAlg7mrOW6Te4fzMoR5KCHzcQ&oe=69C13404"}, {"file_name": "PlayStore_Shoot_Collage_Landscape_NoTitle_2k.png", "id": "1520943939337567", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308578_1520943942670900_8005736560501524525_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjhwKPat7FIQ7kNvwHGVapb&_nc_oc=Adp6czBSTRTfJkQRZ8tlQYBVX_4rfvvg2C7_IjyqYQJZUK33R9h961AnwZf-IsQbCx0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwyGAFQsBEMkvS8INLhSZYeWpkvju7TwWDrH9gxxjHRXQ&oe=69C13A35"}, {"file_name": "PlayStore_Shoot_PuttPutt_NoTitle_2k.png", "id": "648580667709787", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303766_648580671043120_8602335941330498729_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwjiiS8xrd0Q7kNvwHSaoyk&_nc_oc=Ado5rerBenWEH0Gb8I0ExoboP2L1IAJXZGlgodRQPWyoRWWN8t62KNqlSeTkX5EJCIA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwUT64x5c_TYZFu22hcXcA36GM4Io37qhR0TGDVcMo4eA&oe=69C1417B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_300DPI_VRC_Landscape_FingerTracking.png", "id": "1136410263649539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75195911_1136410266982872_7400914850211442315_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwV5qErfctMQ7kNvwH_Hzwp&_nc_oc=AdpZz_ldJRl7dnZw0IZQWoPawJs0LiFPa6o11uyNHnsVPMQgVZ-YjthQzUAsXsxqUwM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzw9XIw3dBSTRg6rVFtN0JbpAK1rXWGHIa8xpOYUM4UxA&oe=69C13B95"}, "display_name": "VRChat", "keywords": ["social", "roleplaying", "adventure", "casual", "Funny"], "long_description": "Imagine a space filled with limitless possibilities. \n\nSpend your afternoon dogfighting in fighter jets, before winding down in a treehouse that exists floating in a nebula. Make a new best friend while exploring a haunted mansion, right before playing a hand of cards with a robot, alien, and eight-foot tall wolf.\n\nIn VRChat, there are hundreds of thousands of worlds, millions of avatars \u2013 all created by the users. No matter what you\u2019re into, there\u2019s a space in VRChat for you. And if there isn\u2019t, we\u2019ll give you the tools to make your dream a reality.\n\nVRChat was built to take advantage of VR headsets in many unique ways. That means avatars that flow with your movement, and systems that work alongside various hardware platforms to provide full-body tracking, finger tracking, and much, much more.\n\nThere\u2019s something magical around every corner. Come take a look, and see what you find.", "short_description": "Make Friends and Explore an Endless Stream of Community Made Worlds and Avatars"}]}, "developer_name": "VRChat Inc.", "developer_privacy_policy_url": "https://vrchat.com/privacy", "developer_terms_of_service_url": "https://vrchat.com/legal", "publisher_name": "VRChat Inc.", "support_website_url": "https://help.vrchat.com/", "website_url": "https://vrchat.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPLORATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_BE", "fr_CA", "fr", "zh_CN", "zh_HK", "zh_TW", "de", "de_CH", "it", "ja", "pl", "pt_BR", "ru", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24878754268492783"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/4
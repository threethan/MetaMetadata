d5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hM8NMCJcOftIVaSLUZVWxExqg2msuOe8ynS0SBuVOMw&oe=69DCE384"}, {"file_name": "PlayStore_Shoot_Collage_Landscape_NoTitle_2k.png", "id": "1520943939337567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308578_1520943942670900_8005736560501524525_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3rb_Jw_oYAQ7kNvwGNTdD5&_nc_oc=Adodk5ResamS1IGwcRH4JhtAmSSnfIYwHJzNT-pZh0e6lb807EycMOo6fiFPYEiD2q4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r0WpjJuhcphL9B_i9utJrKN1OjWcTlc97cmJEWhpVHw&oe=69DCE9B5"}, {"file_name": "PlayStore_Shoot_PuttPutt_NoTitle_2k.png", "id": "648580667709787", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303766_648580671043120_8602335941330498729_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEpiFQLM0ioQ7kNvwHKyCWs&_nc_oc=AdqvGW4O72_g5Aiog-AjaeuCiv4TmjInxmqEawIv9doD2FFHSkgcswGf7xmDxDtbmao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0toS2EyiudFBhxDcMbfxYoshGwtRt0735G7gePr-YV5A&oe=69DCF0FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_300DPI_VRC_Landscape_FingerTracking.png", "id": "1136410263649539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195911_1136410266982872_7400914850211442315_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lz4Q-DQkblUQ7kNvwHa5Ivc&_nc_oc=Ado3HSUi_q28N-HzTrXOrZReOm4zlcv9Gvlf-EwjhvM92DLe0Wa3uKOh2W4rIcxm-bI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dpNBSRCk-f6bm1DcQoxrLgDiXzgwIsCZxesaptn1FFw&oe=69DCEB15"}, "display_name": "VRChat", "keywords": ["social", "roleplaying", "adventure", "casual", "Funny"], "long_description": "Imagine a space filled with limitless possibilities. \n\nSpend your afternoon dogfighting in fighter jets, before winding down in a treehouse that exists floating in a nebula. Make a new best friend while exploring a haunted mansion, right before playing a hand of cards with a robot, alien, and eight-foot tall wolf.\n\nIn VRChat, there are hundreds of thousands of worlds, millions of avatars \u2013 all created by the users. No matter what you\u2019re into, there\u2019s a space in VRChat for you. And if there isn\u2019t, we\u2019ll give you the tools to make your dream a reality.\n\nVRChat was built to take advantage of VR headsets in many unique ways. That means avatars that flow with your movement, and systems that work alongside various hardware platforms to provide full-body tracking, finger tracking, and much, much more.\n\nThere\u2019s something magical around every corner. Come take a look, and see what you find.", "short_description": "Make Friends and Explore an Endless Stream of Community Made Worlds and Avatars"}]}, "developer_name": "VRChat Inc.", "developer_privacy_policy_url": "https://vrchat.com/privacy", "developer_terms_of_service_url": "https://vrchat.com/legal", "publisher_name": "VRChat Inc.", "support_website_url": "https://help.vrchat.com/", "website_url": "https://vrchat.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPLORATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_BE", "fr_CA", "fr", "zh_CN", "zh_HK", "zh_TW", "de", "de_CH", "it", "ja", "pl", "pt_BR", "ru", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25855569067477960"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sco
atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy741LnaJoIP6dBPcN6HmlHwo-QR9mTAIw4OAigJoT8Rw&oe=69CBC004"}, {"file_name": "PlayStore_Shoot_Collage_Landscape_NoTitle_2k.png", "id": "1520943939337567", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308578_1520943942670900_8005736560501524525_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlfNFKAxEBMQ7kNvwFC45tO&_nc_oc=AdooPBRJoLTwa_y9J9NNUvJ8pgiF_b8ZOMRulXkEkBw9eYIIXvWXPm3GhUAlRdv-4Q4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGqJ6iE3CIisnXKpSSx2J9ufbdr9ILenjgsqUG0SjizQ&oe=69CBC635"}, {"file_name": "PlayStore_Shoot_PuttPutt_NoTitle_2k.png", "id": "648580667709787", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303766_648580671043120_8602335941330498729_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOg3fTh73DwQ7kNvwG7HFlA&_nc_oc=AdqVlSQBCBAaGZBFMKKcbA2iu53IF3O8dHFnc2e8JQhD-sPaxB487XHvBq8qT4XwkaQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyyRGlcty3qKEDpHx6tZBW99v3O2t9yI50Bw3g2bAarIQ&oe=69CBCD7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_300DPI_VRC_Landscape_FingerTracking.png", "id": "1136410263649539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75195911_1136410266982872_7400914850211442315_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syVdz-yyevAQ7kNvwGl7gUh&_nc_oc=Adp-VYOdonSSfHMXj8YAQP2LcI-tzBbFPUAg6YZ4EehwmxR07heznSFORKjtSSbd3Js&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzeal4LEKEzXB6fL-pIE_dvxqBGcpcB3VfQqriUBh8m7A&oe=69CBC795"}, "display_name": "VRChat", "keywords": ["social", "roleplaying", "adventure", "casual", "Funny"], "long_description": "Imagine a space filled with limitless possibilities. \n\nSpend your afternoon dogfighting in fighter jets, before winding down in a treehouse that exists floating in a nebula. Make a new best friend while exploring a haunted mansion, right before playing a hand of cards with a robot, alien, and eight-foot tall wolf.\n\nIn VRChat, there are hundreds of thousands of worlds, millions of avatars \u2013 all created by the users. No matter what you\u2019re into, there\u2019s a space in VRChat for you. And if there isn\u2019t, we\u2019ll give you the tools to make your dream a reality.\n\nVRChat was built to take advantage of VR headsets in many unique ways. That means avatars that flow with your movement, and systems that work alongside various hardware platforms to provide full-body tracking, finger tracking, and much, much more.\n\nThere\u2019s something magical around every corner. Come take a look, and see what you find.", "short_description": "Make Friends and Explore an Endless Stream of Community Made Worlds and Avatars"}]}, "developer_name": "VRChat Inc.", "developer_privacy_policy_url": "https://vrchat.com/privacy", "developer_terms_of_service_url": "https://vrchat.com/legal", "publisher_name": "VRChat Inc.", "support_website_url": "https://help.vrchat.com/", "website_url": "https://vrchat.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EXPLORATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_BE", "fr_CA", "fr", "zh_CN", "zh_HK", "zh_TW", "de", "de_CH", "it", "ja", "pl", "pt_BR", "ru", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24878754268492783"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://s
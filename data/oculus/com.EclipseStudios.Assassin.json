01BA0"}, {"file_name": "Untitled design (76).png", "id": "2485204968593981", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303174_2485204971927314_2838980881694026545_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-BZqP2ywIMQ7kNvwGbA7z4&_nc_oc=AdqSuPxqfI3r_Ffd093AmqcVMfr0eW8YKE3lTGkUCx5enlDCgO9o7KE27Y-Yn5x4wRM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEoKhXozbJegGQygih04ElUm0TKPEWA5cLK_IKlqQxOw&oe=6A902AE4"}, {"file_name": "Untitled design (75).png", "id": "1763339901785120", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/654961355_1763339905118453_1109346249519491896_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCjKAqTrvk4Q7kNvwGqMTiA&_nc_oc=AdrprlIg38j9AeYLV5kB-PsbIHv8bzcWBeqUojnLCFuiKCPQFB2B4HG9tFPGkfWmUq4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrAmAMbp8H_VB2XYigP-2U5OHpH95DgrUz5A9vkIn1Gw&oe=6A903E32"}, {"file_name": "Untitled design (77).png", "id": "1984345822212281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593749142_1984345825545614_152126111379276765_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJI5ClHmDqMQ7kNvwEIZOX9&_nc_oc=AdoJmNubXNbj-pn3fFj0WlbPUB92zV9tMRAwty66JYWH9-STOZCCkCe13zHC6k8v76I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_0Gy7PJNfFTN4pgDi2ep4VIs4Z2Wta_QpaTbsQOwWTw&oe=6A902742"}, {"file_name": "Untitled design (78).png", "id": "1548113020144125", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593909648_1548113023477458_258094946857372033_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qa_bhPzIj0Q7kNvwG3vDZS&_nc_oc=AdrW7zCJn9FOiV52n_5yLzOqTvGMNW8WigMWvVtav9jbBBVWOAE2_mQEDHjcms4RJYw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGQIq3xnC7kEV6lBI9u6Y1eG8ntFpudWiSo0fzXoeBpQ&oe=6A902C53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Assassin", "keywords": [], "long_description": "In Assassin, you are dropped into a big map with a bunch of other players, and everyone has one goal: don't get caught. The game is all about being sneaky and using the map to your advantage. You have to find good hiding spots and wait for the right moment to strike so you can take out other players without anyone seeing you. If you go running around like crazy, you\u2019ll probably get eliminated pretty fast, so you have to be smart and stay quiet.\n\nAs the game goes on, it gets harder because there are fewer people left and the map feels smaller. You have to keep an eye on your surroundings at all times because someone could be right behind you. If you manage to outplay everyone and stay alive until the very end, you become the winner. For every person you kill and every match you win, you get rewards. You can use these to get better cool new looks for your character, or better knife to become more stylish.", "short_description": "In Assassin, you play a game where you have to be sneaky to survive. Your main goal is to hide from other players while trying to find and kill your targets. If you can stay alive and be the last person in the game, you win! As you play and get more kills, you earn cool rewards that make the game even better."}]}, "developer_name": "Eclipse Studios", "developer_privacy_policy_url": "https://sites.google.com/view/esprivacypolicys/home", "developer_terms_of_service_url": null, "publisher_name": "Eclipse Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/assasinvr/assassin", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2710427532541308"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pro
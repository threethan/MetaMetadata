2258136696212981760_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzTW2O-YgJsQ7kNvwGPZ2w5&_nc_oc=AdqJQ7PN6L1FMjC6dgr7aTz3duvUHGSCWlPkQl3lzDDQqE5cULESDefRqZRzbkpdHUI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTno57FG6RmSbyky8k7S7bMA461XHaVEuCljKzja6IJQ&oe=6A93FCA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TCU_Meta_2560x1440.png", "id": "484832004325846", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/43997708_484832010992512_6891411827692122990_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1dDeFs3u3UQ7kNvwGxjYvG&_nc_oc=AdqlDPt2NrbNs-BKtNxdf4rZRkw2d5W0Tx86VPuZjAVjA7-TFRdLJskWFYRyXoR-SwI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm_Xtqk7_NR579w-QSW32W8iWTXWUdl1LU2Lji4wA23A&oe=6A940616"}, "display_name": "Trombone Champ: Unflattened", "keywords": [], "long_description": "Trombone Champ: Unflattened will take the charming and quirky gameplay of the original Trombone Champ and bring it to life in a fully immersive virtual reality environment. In this reimagined version, players will honk, blow, and toot their way through over 50 unique songs, all within a vibrant and dynamic 3D space. \n\nCore Features at Launch:\nSingle Player Campaign Mode: Embark on a solo journey to become the ultimate Trombone Champ, mastering tracks and uncovering the mysteries of the Trombiverse.\n50+ Songs: A diverse soundtrack that spans anthems, marches, classical pieces, electronica, folk classics, and more.\nUnique 3D Environments: Play in various animated 3D spaces designed to complement the musical experience, with each environment adding a unique visual flavor to the tracks.\nAnimated Background Videos: Each song comes with its own animated background, making every performance a new visual treat.\nTrombone Cards: Collect and unlock trombone cards as you progress, each adding new layers of gameplay and customization.\nCollectible Trombones: Start with 10 trombones and unlock an additional 40 as you play, each with its own distinctive style and sound.\nCustomizable Trombones: Personalize your trombone to match your style, offering a truly unique musical experience.\n\nWhether you\u2019re a long-time fan of the original Trombone Champ or new to the world of trombone-based rhythm games, Trombone Champ: Unflattened promises to deliver a unique, immersive, and endlessly hilarious experience.", "short_description": "Trombone Champ: Unflattened takes the charming and quirky gameplay of the original Trombone Champ and bring it to life in a fully immersive virtual reality environment. In this reimagined version, players will honk, blow, and toot their way through over 50 unique songs."}]}, "developer_name": "Flat2VR Studios, Holy Wow Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1JMV2MCP_sz2CD3GrpfVIovagwTrUOHBbpMD9tb27kis/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Flat2VR Studios", "support_website_url": null, "website_url": "https://flat2vrstudios.com/projects/trombone-champ-unflattened/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26502921739353507"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1312821243700938"}, {"status": "PUBLISHED", "id": "1619742595870185"}, {"status": "PUBLISHED", "id": "1396521218778506"}, {"
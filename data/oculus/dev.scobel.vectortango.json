-iad6-1.oculuscdn.com/v/t64.5771-25/499296214_2117644209585961_7956427769769125157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KmSqWhKi9UQ7kNvwHgf_lv&_nc_oc=AdrNh9njjCQd2yxdylzylUwMW4zbB5R3SKiHOBo9ZRhm7QPrqZdlhvSx1iQwyyq3KC4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcv4kGGNTfrZhMb9LKxkGkMTub3EhYIEIaCrptcTkCXA&oe=6AF1DC2E"}, {"file_name": "04-toronto-board.png", "id": "1076793802004654", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299051_1076793805337987_5134655876056167188_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfdXM2-Fhs0Q7kNvwHXmDom&_nc_oc=AdroTlWoYkNhbFWkOy4pmZdObjUJVFnVWGB7RQcq8Xc_coCwKXy_fxBQOfN1tW4sJGI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaE5bS32Kk4_I3HwDixskcjr5LvC6OytA3kJhNAdVG-w&oe=6AF1F02D"}, {"file_name": "media (2).png", "id": "29186998114246474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830576_29186998120913140_6116693940805868270_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIrI-Sq94N0Q7kNvwG8CwAd&_nc_oc=AdruLTU4PVhKPG1dK64O0iQNQYCTPe-CL1hYZM6q0JHIKFnl2zfpvrYpahS5ut997Y0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiP9EN__T7vgo3QE6iDUuF5vMQObK8znC2WZV79oHrag&oe=6AF1D202"}, {"file_name": "meta-store.png", "id": "2025348921497867", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_2025348924831200_4339260311944223146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBjDKPr2H08Q7kNvwGdXGc0&_nc_oc=AdpvVcDQlIxoZ5fdwtBI3V2YiwIiDXWiNvG_uEZ8Y4BQElsxD4kNQjSYiUDdOxOM0cc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmxA3_wc7zGShsHCsvaojGbwW_chRdWGgv2UKIjc_2tg&oe=6AF1EDAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VectorTango-Trailer-Cover-2560x1440.png", "id": "2923411478019339", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596168449_2923411481352672_3833593977786963202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8V4Hwe7ouQQ7kNvwETzJAj&_nc_oc=Adqm5-TSl6Wkgy8DuIa4DqfC55OTD4pDkuPdUsGsm3du3kSQtTD9xlctA8gBXWzF_jU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzMNjp_GO4HzOaBBre08Gw89LYMtpKeMNDhXTI6v-shA&oe=6AF1D7EE"}, "display_name": "Vector Tango", "keywords": ["airport", "simulation", "flight", "airplanes", "flying"], "long_description": "# Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw paths through the air to guide planes and helicopters safely home. Line up arrivals, release departures and route passing traffic onward. Read the flight strips and keep aircraft safely separated. Play on your table or switch to a VR control tower.\n\n# Become an Air Traffic Controller\n\nFollow a real Air Traffic Control career through six iconic airports in Canada including Niagara Falls, Hamilton, London, North Bay , Toronto, and Gander. Instructor John guides you through new traffic and increasingly busy skies.\n\n# Climb the Leaderboards\n\nCompete at any of six airports. Every ten safe flights raises the pressure. Handle takeoffs, landings, flyovers, circuits, weather, military airspace and emergencies. Keep going until your first crash.\n\n# Build Your Own Airport\n\nExplore Sandbox at your own pace. Start with an existing airport or build your own. Place runways and a helipad, choose a tower, and set the traffic, weather and time of day. Play on your table or spread the airport across your room.\n\n# Make Yourself at Home\n\nKeep radar, flight strips and live performance stats close at hand on your instrument console. Move and resize the airport to suit your space, then get back to bringing everyone home.", "short_description": "Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw flight paths and guide planes and helicopters safely home across Campaign, Competitive and Sandbox modes in Vector Tango, a mixed reality air traffic control game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vector-tang
085_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY3zD4GwkfkQ7kNvwFJjojB&_nc_oc=AdqBFOEhamLap_YSMejAC1OMiIjG3Dp3AlBKftPzhc0xJRxbGbj-Ht8P6qy4Z5tK_nE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlJ_5h614vf7G-zz2PKdhEB5-4_cUkCbKt5QNACDqX5g&oe=6B01EEAF"}, {"file_name": "04-toronto-board.png", "id": "1076793802004654", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299051_1076793805337987_5134655876056167188_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUy9ItdF-WMQ7kNvwH5fi1f&_nc_oc=AdpgBp7jCPZZmaMhKXskxzi4pK6pVWFKImynAYEZvrdjOeqcvHRJrHyH8F0IDb7URgw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrES6gRgKA0oN47UEkMeNv44_vIsSTY91qtwc4fEUbmA&oe=6B01C22D"}, {"file_name": "media.png", "id": "2549011632251228", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_2549011638917894_6705380027368372027_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mCYa5TUgNUQ7kNvwFJdVAn&_nc_oc=AdorwE9UTuzuZmTfo0-QXTv_1nb2-PBMuzrA_u1s2dfL2WH6kwZhLa1tmsQhsPiu0Fg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPpR1NeLr4275DwTp2DvaNgQ8WxBw98fB2B1_TfL8eEw&oe=6B01EF50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VectorTango-Trailer-Cover-2560x1440.png", "id": "2923411478019339", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596168449_2923411481352672_3833593977786963202_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_cUGWND4mgQ7kNvwEvTL7a&_nc_oc=AdrWwkiPwBjqZ8XR30BxUcqcM0C0F9lJFr9VrSi-mgezaBaG4mtUi8tZpQIK2GbH2I4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbuTlwUldsar20d2Bwe6-lBBRx9IDWo9Fmfu8RWAjdGQ&oe=6B01E22E"}, "display_name": "Vector Tango", "keywords": ["airport", "simulation", "flight", "airplanes", "flying"], "long_description": "Take the controller's seat in Vector Tango, a mixed reality air traffic control game where a miniature airport comes to life in your space.\n\nDraw paths through the air to guide propeller planes, jets and helicopters. Line up arrivals, release departures and route passing traffic to its next sector. Every clearance needs room: watch the approaches, read the flight strips and keep aircraft safely separated.\n\nFollow a campaign across Niagara, Hamilton, London, North Bay and Toronto. Fifteen authored shifts introduce new traffic and increasingly busy skies, with instructor John guiding you through the essentials.\n\nChoose Competitive and compete against other air traffic controllers across the metaverse on a single airport with escalating difficulty. Deal with takeoffs, landings, flyovers, circuits, weather conditions, military airspace, and even emergencies. \n\nOr choose Sandbox play to arrange your airfield and explore at your own pace either on your own custom table top interface or at room scale where every surface becomes it's own runway!\n\nYour instrument console keeps radar, flight strips and operational information close at hand. Move and resize the airport and console to suit your play space, then get back to bringing everyone home.", "short_description": "Little Planes. Big Responsibilities.\n\n Vector Tango is a 3D Air Traffic Control Simulator. Bring a miniature airport into your room, draw flight paths, and guide planes and helicopters safely to their destination across three different modes (Competitive, Campaign and Sandbox)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vector-tango.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Scobel Media", "support_website_url": null, "website_url": "https://www.vector-tango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
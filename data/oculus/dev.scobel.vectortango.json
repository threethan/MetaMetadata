-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_2117644209585961_7956427769769125157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KmSqWhKi9UQ7kNvwF6MUfo&_nc_oc=AdpCpT9p3lFZ26ObeZFTgR-2Rd05A7pygx4tYj6QCB3Kl31DA8i3Xuo5HVGqlH0_vPI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5o6tjmy0ZWdIeUnJZCLYAilnUZw5gwZGTld5ID5RcBA&oe=6AF47F2E"}, {"file_name": "04-toronto-board.png", "id": "1076793802004654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299051_1076793805337987_5134655876056167188_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyK6dBvMrUkQ7kNvwHNFSCK&_nc_oc=Adr9D0GYEufGUYTSRt9d-bj6ssu1PHJji3OMKNIHc6VOH2lGEBlVino8a98IayYtzrg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrsbdq_T-8nMSiK6yf9Snl4J48fmNLfNRThQxmEd_Oug&oe=6AF4932D"}, {"file_name": "media (2).png", "id": "29186998114246474", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830576_29186998120913140_6116693940805868270_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIrI-Sq94N0Q7kNvwGT3n9S&_nc_oc=AdpbPNMD5mDEI9hjxa6ZQgcchW4Zrn4HLrs9P22NYhpGtoHm_iBFbkGfvI0BLEuZePM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyFJReMM5p6Sf3FfJ985tiHaZkBymPGHG82YKxVft9Ow&oe=6AF47502"}, {"file_name": "meta-store.png", "id": "2025348921497867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_2025348924831200_4339260311944223146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yMX2dfO7AwQ7kNvwH9e3wA&_nc_oc=Adrm0salaS7sETalcEL1EaT5yeVjjZmzY8pKodGncm-yfHgmcZvL-7NIWAwNJhtn9w8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYBAbJkrk25DJEzQdN5DWSU3AK0-R7j4KOKeO4KS8rmw&oe=6AF490AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VectorTango-Trailer-Cover-2560x1440.png", "id": "2923411478019339", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_2923411481352672_3833593977786963202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8V4Hwe7ouQQ7kNvwE8T5BM&_nc_oc=AdoFZBWjNg4kKyz9qakQdepI1Pri1tpCo85-cj5s7qv86z9EO-giYiNzEh_OCEfg0bU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8lNWQHf0botMdF7YImTbbKbfZKprHpHOIxZ0Bqa92Vw&oe=6AF47AEE"}, "display_name": "Vector Tango", "keywords": ["airport", "simulation", "flight", "airplanes", "flying"], "long_description": "# Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw paths through the air to guide planes and helicopters safely home. Line up arrivals, release departures and route passing traffic onward. Read the flight strips and keep aircraft safely separated. Play on your table or switch to a VR control tower.\n\n# Become an Air Traffic Controller\n\nFollow a real Air Traffic Control career through six iconic airports in Canada including Niagara Falls, Hamilton, London, North Bay , Toronto, and Gander. Instructor John guides you through new traffic and increasingly busy skies.\n\n# Climb the Leaderboards\n\nCompete at any of six airports. Every ten safe flights raises the pressure. Handle takeoffs, landings, flyovers, circuits, weather, military airspace and emergencies. Keep going until your first crash.\n\n# Build Your Own Airport\n\nExplore Sandbox at your own pace. Start with an existing airport or build your own. Place runways and a helipad, choose a tower, and set the traffic, weather and time of day. Play on your table or spread the airport across your room.\n\n# Make Yourself at Home\n\nKeep radar, flight strips and live performance stats close at hand on your instrument console. Move and resize the airport to suit your space, then get back to bringing everyone home.", "short_description": "Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw flight paths and guide planes and helicopters safely home across Campaign, Competitive and Sandbox modes in Vector Tango, a mixed reality air traffic control game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vector-tang
085_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir2QZwRFNTkQ7kNvwGcFqov&_nc_oc=AdpopDLSu2ZVGiWwIEZ_5k5la7z1qwircRO8GlJxy_be0cb756cPshiNcpMD7-zTz7c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ49BaDAa53zvALrPzK3MULspgXwKe-I_EExpSiVuWrAw&oe=6B084DEF"}, {"file_name": "04-toronto-board.png", "id": "1076793802004654", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299051_1076793805337987_5134655876056167188_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7oYV-LH9UMQ7kNvwEGgkQC&_nc_oc=AdqRcoTBrASxX7FE9Y2stNuK_qDntpAbrH-lozTScu6m3sF9Rxk-nmondsyAiuVqfqA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjyque4z6R6axrtbPg1mceYfPlgUrF98JU4E0xqFzYdQ&oe=6B0859AD"}, {"file_name": "media.png", "id": "2549011632251228", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491823783_2549011638917894_6705380027368372027_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_C6vGKtbFYQ7kNvwG72_Ta&_nc_oc=Adp3UUvEzRohFXJbil4Uf9WRVgFJ6IrfwyjPd1wzZe7OY0SZBIBTE9Z0aJ9fUt9CB5Q&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzl2m-nWLQrDEAX4M2KQQuG8Lg9ch2QEz6s6wYaNKqMg&oe=6B084E90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VectorTango-Trailer-Cover-2560x1440.png", "id": "2923411478019339", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/596168449_2923411481352672_3833593977786963202_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6397wWkX-gQ7kNvwEAdPoH&_nc_oc=AdrbYNWxzjzrj5g28eQhSNUm-8F7JjIG0uDRYDbAWqso33-f7tw0Yui4a2DFAiHPqLQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqBHttroGPralSC66qFEo1S7gYqJppbXI9OEj3SkHYOA&oe=6B08416E"}, "display_name": "Vector Tango", "keywords": ["airport", "simulation", "flight", "airplanes", "flying"], "long_description": "Take the controller's seat in Vector Tango, a mixed reality air traffic control game where a miniature airport comes to life in your space.\n\nDraw paths through the air to guide propeller planes, jets and helicopters. Line up arrivals, release departures and route passing traffic to its next sector. Every clearance needs room: watch the approaches, read the flight strips and keep aircraft safely separated.\n\nFollow a campaign across Niagara, Hamilton, London, North Bay and Toronto. Fifteen authored shifts introduce new traffic and increasingly busy skies, with instructor John guiding you through the essentials.\n\nChoose Competitive and compete against other air traffic controllers across the metaverse on a single airport with escalating difficulty. Deal with takeoffs, landings, flyovers, circuits, weather conditions, military airspace, and even emergencies. \n\nOr choose Sandbox play to arrange your airfield and explore at your own pace either on your own custom table top interface or at room scale where every surface becomes it's own runway!\n\nYour instrument console keeps radar, flight strips and operational information close at hand. Move and resize the airport and console to suit your play space, then get back to bringing everyone home.", "short_description": "Little Planes. Big Responsibilities.\n\n Vector Tango is a 3D Air Traffic Control Simulator. Bring a miniature airport into your room, draw flight paths, and guide planes and helicopters safely to their destination across three different modes (Competitive, Campaign and Sandbox)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vector-tango.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Scobel Media", "support_website_url": null, "website_url": "https://www.vector-tango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFGGsPEzHNv_mPDBeW3hqmPxzEkJWdfl_MmY8RNcI8ew&oe=6B0C4BAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VectorTango-Trailer-Cover-2560x1440.png", "id": "2923411478019339", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596168449_2923411481352672_3833593977786963202_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAtYk_jZLKAQ7kNvwEAwKeB&_nc_oc=Adq0mNNjXr-yOLk0OejDW1u463C-KY34fAUJl-6C3JH0ZCdm0GatjVH2fSk9eQXXzF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSBgEyp8uWV0ZyFd7tOhoCWjvBMcjuup04q2cZgzudzA&oe=6B0C6E2E"}, "display_name": "Vector Tango", "keywords": ["airport", "simulation", "flight", "airplanes", "flying"], "long_description": "# Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw paths through the air to guide planes and helicopters safely home. Line up arrivals, release departures and route passing traffic onward. Read the flight strips and keep aircraft safely separated. Play on your table or switch to a VR control tower.\n\n# Become an Air Traffic Controller\n\nFollow a real Air Traffic Control career through six iconic airports in Canada including Niagara Falls, Hamilton, London, North Bay , Toronto, and Gander. Instructor John guides you through new traffic and increasingly busy skies.\n\n# Climb the Leaderboards\n\nCompete at any of six airports. Every ten safe flights raises the pressure. Handle takeoffs, landings, flyovers, circuits, weather, military airspace and emergencies. Keep going until your first crash.\n\n# Build Your Own Airport\n\nExplore Sandbox at your own pace. Start with an existing airport or build your own. Place runways and a helipad, choose a tower, and set the traffic, weather and time of day. Play on your table or spread the airport across your room.\n\n# Make Yourself at Home\n\nKeep radar, flight strips and live performance stats close at hand on your instrument console. Move and resize the airport to suit your space, then get back to bringing everyone home.", "short_description": "Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw flight paths and guide planes and helicopters safely home across Campaign, Competitive and Sandbox modes in Vector Tango, a mixed reality air traffic control game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vector-tango.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Scobel Media", "support_website_url": null, "website_url": "https://www.vector-tango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "40689732560613984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1243140841300724_8179694623350355653_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF7CkVSQoxwQ7kNvwGszRmy&_nc_oc=Adqr6SnViGlfQBM2Oaq2IBEnFD6x8bLCLNesiv7udWhdwfmdRd3nVazNWJ6vawxFAbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQze9UkEdm8_TZnLVyVqP5G-Lzxr9F5bf7cd8VVgYY1hA&oe=6B0C7499"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vector Tango", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAM
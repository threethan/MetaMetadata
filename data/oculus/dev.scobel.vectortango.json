-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_2117644209585961_7956427769769125157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X2nnwWjbMEQ7kNvwHCeWd5&_nc_oc=AdqHkYPniHbYQyBzCqHuOHtA-1RcOtA0phYKbjfywUHdu03qoFYYHqYlOZrFF3LNuvw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8IYTE82lxrk7a0_lyE4CBNqLRnue7IxazcJ8Fq3WfPg&oe=6AF7222E"}, {"file_name": "04-toronto-board.png", "id": "1076793802004654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299051_1076793805337987_5134655876056167188_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyK6dBvMrUkQ7kNvwGiMuQ0&_nc_oc=AdpFFJ5tcdCwW0610Y5B8w3OE1trXsQMqlNTL1UrG2d11YF9ymzbLxSQeoUQt18grvw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9eehfmvoKzRDLpHTBGwJjrQr7GpOqIEe-rKzZO9QaFQ&oe=6AF7362D"}, {"file_name": "media (2).png", "id": "29186998114246474", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830576_29186998120913140_6116693940805868270_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD6EFStvvrgQ7kNvwEPPNvD&_nc_oc=AdoACyW57-mZCRk-60YM1cC4QLEtMVqTRqS_EstyfVNC2D4TctPRk84hS1eQzR9cBkY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzhTPdoRvCXhgEBtWWY1u2vIzX8UbvK1xvI3qMCvGUcQ&oe=6AF71802"}, {"file_name": "meta-store.png", "id": "2025348921497867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_2025348924831200_4339260311944223146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yMX2dfO7AwQ7kNvwEjgpJp&_nc_oc=AdprEibHL7wyaE8eWKxXH0vn8HmQOElLzhJbtGENaHygkD1OOWZMjxuEvYJ-7rgzRgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh43PD0QQUhjNMVEEeEOqhG0KDkEBPWAXYwDSmBDu5dg&oe=6AF733AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VectorTango-Trailer-Cover-2560x1440.png", "id": "2923411478019339", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_2923411481352672_3833593977786963202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwTStr6WR-MQ7kNvwFCkcQZ&_nc_oc=Adoshk0ohPy5ZfWCyVbzbSjULjdy4bhbSGywxvQRqPgxAKzXSLjaT_a2gTUzj8APh_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjdY81uM6VjaUG-hCsdsWycfzNTsh5Yjz9Lbj41e7_jg&oe=6AF71DEE"}, "display_name": "Vector Tango", "keywords": ["airport", "simulation", "flight", "airplanes", "flying"], "long_description": "# Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw paths through the air to guide planes and helicopters safely home. Line up arrivals, release departures and route passing traffic onward. Read the flight strips and keep aircraft safely separated. Play on your table or switch to a VR control tower.\n\n# Become an Air Traffic Controller\n\nFollow a real Air Traffic Control career through six iconic airports in Canada including Niagara Falls, Hamilton, London, North Bay , Toronto, and Gander. Instructor John guides you through new traffic and increasingly busy skies.\n\n# Climb the Leaderboards\n\nCompete at any of six airports. Every ten safe flights raises the pressure. Handle takeoffs, landings, flyovers, circuits, weather, military airspace and emergencies. Keep going until your first crash.\n\n# Build Your Own Airport\n\nExplore Sandbox at your own pace. Start with an existing airport or build your own. Place runways and a helipad, choose a tower, and set the traffic, weather and time of day. Play on your table or spread the airport across your room.\n\n# Make Yourself at Home\n\nKeep radar, flight strips and live performance stats close at hand on your instrument console. Move and resize the airport to suit your space, then get back to bringing everyone home.", "short_description": "Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw flight paths and guide planes and helicopters safely home across Campaign, Competitive and Sandbox modes in Vector Tango, a mixed reality air traffic control game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vector-tang
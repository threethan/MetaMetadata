CdEjyTRtHA&oe=6AF5E6B3"}]}, "id": "2173327693564187", "locale": "en_US", "screenshots": [{"file_name": "03-toronto-dusk.png", "id": "4590792181239518", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300725_4590792184572851_7323581480196008481_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTN3cXJMUH8Q7kNvwE96We9&_nc_oc=AdrhkIcqwHZePOFRE_uVHgMrTeG9ypEKfneSzMI4Unep3mnonZA5ul4VvBoxeRSS1IA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRftUjb-o41k9DSJ9i8MdwrB41KgdxBCSIUzQziHMuehA&oe=6AF5F5B4"}, {"file_name": "02-vr-tower.png", "id": "2117644206252628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296214_2117644209585961_7956427769769125157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X2nnwWjbMEQ7kNvwFOght7&_nc_oc=AdptJJpG_EA5p9H950qwKNjDyxA9dvvZrMsC_dEK2FVfGq-4951aA38TtZ32i5J_3K4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCWu0aNKo-NTu2nMWQEGh-ohzw5Sa19h_7qJwVRgIJMw&oe=6AF5D0AE"}, {"file_name": "05-toronto-night.png", "id": "1874280976894320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308043_1874280980227653_1381804306399825085_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hG_nIbR4Rf4Q7kNvwGDjLPb&_nc_oc=AdrHsgcaqJYD5CgcMjqKjjndG--6xfpv3juybBKS5GLS9wvUntmYRqgXY894wbwF0jU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ83kv_2CLChxOQksBhmYevSgQY5kcV8_fc2j3caFto7Q&oe=6AF5D8EF"}, {"file_name": "04-toronto-board.png", "id": "1076793802004654", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299051_1076793805337987_5134655876056167188_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyK6dBvMrUkQ7kNvwHAdPr9&_nc_oc=Adra4UydJd1vuF-OWVHXAxCqrsXAq8Zmrqj5_er7Zg5WB0nosZzaYtpWuTYUpkpFBgk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvO4hC_jCViYiU81LoKSAJhRhs9NLoAPi7-ddyq4CI5w&oe=6AF5E4AD"}, {"file_name": "media.png", "id": "2549011632251228", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_2549011638917894_6705380027368372027_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1VWqkJz-dgQ7kNvwGMRHxV&_nc_oc=AdprsowaAPaiQ-ExZhkvIAfRuixubpeoxJqbYKFGsCm3cCq92mCI0rTIpb1MrIwVdH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJn0kWlEv-IR_LBBjbCxxpo_8C6BrZrud0I-DQ4yp5mQ&oe=6AF5D990"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VectorTango-Trailer-Cover-2560x1440.png", "id": "2923411478019339", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596168449_2923411481352672_3833593977786963202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwTStr6WR-MQ7kNvwECeLiK&_nc_oc=Adr8ZlXP2qOFbmaVfZ1mdKS0mjC-znDc2OAjdlsyf6nBLYU4fFjZQ1D0rjGJQy4FAp8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8Pw3JT-UiTuSeJd6cZkLzicz-mgvWiXA5i6HvE6q5Lg&oe=6AF5CC6E"}, "display_name": "Vector Tango", "keywords": ["airport", "simulation", "flight", "airplanes", "flying"], "long_description": "Take the controller's seat in Vector Tango, a mixed reality air traffic control game where a miniature airport comes to life in your space.\n\nDraw paths through the air to guide propeller planes, jets and helicopters. Line up arrivals, release departures and route passing traffic to its next sector. Every clearance needs room: watch the approaches, read the flight strips and keep aircraft safely separated.\n\nFollow a campaign across Niagara, Hamilton, London, North Bay and Toronto. Fifteen authored shifts introduce new traffic and increasingly busy skies, with instructor John guiding you through the essentials.\n\nChoose Competitive and compete against other air traffic controllers across the metaverse on a single airport with escalating difficulty. Deal with takeoffs, landings, flyovers, circuits, weather conditions, military airspace, and even emergencies. \n\nOr choose Sandbox play to arrange your airfield and explore at your own pace either on your own custom table top interface or at room scale where every surface becomes it's own runway!\n\nYour instrument console keeps radar, flight strips and operational information close at hand. Move and resize the airport and console to suit your play space, then get back to bringing everyone home.", "short_description": "Little Planes. Big Responsibilities.\n\n Vector Tango is a 3D Air Traffic Control Simulator. Bring a miniature airport into your room, draw flight paths, and guide planes and helicopters safely to their destination across three different modes (Competitive, Campaign and Sandbox)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vector-tango.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Scobel Media", "support_website_url": null, "website_url": "https://www.vector-tango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39373400705580516"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4297764780368414"}, {"status": "PUBLISHED", "id": "1090474703603087"}]}, "baseline_offer": {"id": "4297764780368414"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793728800, "status": "PUBLISHED", "id": "4297764780368414"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40879481974972374", "version": "37.1103.1338"}, "id": "1051376351225341", "channel_name": "LI
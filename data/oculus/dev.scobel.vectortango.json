-dfw6-2.oculuscdn.com/v/t64.5771-25/499296214_2117644209585961_7956427769769125157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VK-MNfbrwDEQ7kNvwGgO982&_nc_oc=Adp_mVxHgc3CgrrNnswrYfVPDS7ghwq-vWsHD-zycgzJXPr97yBKys4dEBowV6SgGPM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxSugACDZUgtW0HdtvUQyXnSxEA6X1xmiv6hqjCY0uJg&oe=6AF9C52E"}, {"file_name": "04-toronto-board.png", "id": "1076793802004654", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499299051_1076793805337987_5134655876056167188_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4X_ij4qHYUwQ7kNvwH2cC7D&_nc_oc=AdoPXbk7IZJ3_aWtvcm7D8tAteZm5Dri7G60qdx7IfImlKWp4tZqRbN7fDN7qQuOdVs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHISnwFsJvAzfsyvrjWsiupai0HEQGymRYietnlpx06w&oe=6AF9D92D"}, {"file_name": "media (2).png", "id": "29186998114246474", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830576_29186998120913140_6116693940805868270_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uScfeKELW-0Q7kNvwFFnqpU&_nc_oc=Adq4NRLG0-f4LEi4XQUbrPOT83OdRcCPjo_fSrGOMvFmUU8fV80lqoHh--48e8uZ7Fs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREY5QS2mRyAYwrsR_jSIfjuzdvV9Dcz9I0RmW0-A06sw&oe=6AF9BB02"}, {"file_name": "meta-store.png", "id": "2025348921497867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604360590_2025348924831200_4339260311944223146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4YhCYaH338Q7kNvwEjCHpM&_nc_oc=AdrmNLPoX0HqZ0iCdbGBOid3rqDU1A0g5G9kbZ28PhSrydWiMJoTtzrX6ZotVyEYvvY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwsHs3eD8gBY7k5_ZE-E_qqI9v8FPFEd8pkxz9XNp89w&oe=6AF9D6AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VectorTango-Trailer-Cover-2560x1440.png", "id": "2923411478019339", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/596168449_2923411481352672_3833593977786963202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOudSBYyvXgQ7kNvwFDydVu&_nc_oc=AdpNu26PRtdZp-3yZVENkv6RutvICMKTeKc1iA-fUPKbmgciUo6VywWt0-fDFozHSok&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTuxJk_tJsHDoyQMJd11b3h1ExMbEfTrUpQNWYe64iFQ&oe=6AF9C0EE"}, "display_name": "Vector Tango", "keywords": ["airport", "simulation", "flight", "airplanes", "flying"], "long_description": "# Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw paths through the air to guide planes and helicopters safely home. Line up arrivals, release departures and route passing traffic onward. Read the flight strips and keep aircraft safely separated. Play on your table or switch to a VR control tower.\n\n# Become an Air Traffic Controller\n\nFollow a real Air Traffic Control career through six iconic airports in Canada including Niagara Falls, Hamilton, London, North Bay , Toronto, and Gander. Instructor John guides you through new traffic and increasingly busy skies.\n\n# Climb the Leaderboards\n\nCompete at any of six airports. Every ten safe flights raises the pressure. Handle takeoffs, landings, flyovers, circuits, weather, military airspace and emergencies. Keep going until your first crash.\n\n# Build Your Own Airport\n\nExplore Sandbox at your own pace. Start with an existing airport or build your own. Place runways and a helipad, choose a tower, and set the traffic, weather and time of day. Play on your table or spread the airport across your room.\n\n# Make Yourself at Home\n\nKeep radar, flight strips and live performance stats close at hand on your instrument console. Move and resize the airport to suit your space, then get back to bringing everyone home.", "short_description": "Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw flight paths and guide planes and helicopters safely home across Campaign, Competitive and Sandbox modes in Vector Tango, a mixed reality air traffic control game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vector-tango.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Scobel Media", "support_website_url": null, "website_url": "https://www.vector-tango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "40689732560613984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823279_1243140841300724_8179694623350355653_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhi2QSRaeQUQ7kNvwEiR-wt&_nc_oc=AdoLzOfI4oO5Tz7lt_nmWI3jO0Glsaknp_7wkNGHQyeYJapPixfCg8eeSat82pmxmXk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHdWGqAOmwFf_8ExW71QHbZMRQyInY_DMzNxTReRKlEA&oe=6AF9C759"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vector Tango", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1793728800, "lastRevision": {"nodes": [{"id": "39373400732247180", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "39373400642247189", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1397840875102001"}, "iarc_
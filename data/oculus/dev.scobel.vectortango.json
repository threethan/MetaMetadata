-sea5-1.oculuscdn.com/v/t64.5771-25/499296214_2117644209585961_7956427769769125157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KmSqWhKi9UQ7kNvwEpOV4w&_nc_oc=AdptgrV7b_B7pF56mITgFsBxH49GrCtU3Jv0qCi1G1NIZtvCisH9Wg4sx0qCXIPDnrY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUfhNp-xMucjnu9DTLpfoOYBQjqKYhu3jYa3kVr1FNAg&oe=6AF32DAE"}, {"file_name": "04-toronto-board.png", "id": "1076793802004654", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299051_1076793805337987_5134655876056167188_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfdXM2-Fhs0Q7kNvwHe_Y6I&_nc_oc=AdpDQ1M6TYTTjFksEyBfh7Cdrixj_U7jfI1MXtgtmcyQ8lMOyYnFSG0KWhFIGI1qTe4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAf7xtzhwfTuRrYNICWpNyHxsnzhCuqEjlYGOaI_10IQ&oe=6AF341AD"}, {"file_name": "media (2).png", "id": "29186998114246474", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830576_29186998120913140_6116693940805868270_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIrI-Sq94N0Q7kNvwHn4fBs&_nc_oc=AdpPHWVL82JtR9H-o7Fo9vEbf-zoREkkRrWZ0TsGTR3c4e98mNqlAtI1fKGUzJKUELw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy8UJxdJxgV3nibPjQuw0Tpo0R_HD7BwzNMXSWCE47BA&oe=6AF32382"}, {"file_name": "meta-store.png", "id": "2025348921497867", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_2025348924831200_4339260311944223146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBjDKPr2H08Q7kNvwH2KCMe&_nc_oc=AdoUPAZOcHV8cYQOOaF-B3zRTq5ri-_-bE-xncKq3moDWtARKjVxmGC2tyLZEN3yHHE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLHvR8Sx0DiKxiiJLtqtM7HOKVpCGIg8w0oV8WpL10yQ&oe=6AF33F2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VectorTango-Trailer-Cover-2560x1440.png", "id": "2923411478019339", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_2923411481352672_3833593977786963202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8V4Hwe7ouQQ7kNvwG_Imyd&_nc_oc=Adr1YFjdactOudj0ou-8TSyWFQWPyYW8eocB6Ru9H4zKonGZ-D-jHPj6GeQfOvPW1TU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSrBGahpZ6hUWBAxWv1vy2y-D8ubIKZNZ0ihMt2-3dDQ&oe=6AF3296E"}, "display_name": "Vector Tango", "keywords": ["airport", "simulation", "flight", "airplanes", "flying"], "long_description": "# Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw paths through the air to guide planes and helicopters safely home. Line up arrivals, release departures and route passing traffic onward. Read the flight strips and keep aircraft safely separated. Play on your table or switch to a VR control tower.\n\n# Become an Air Traffic Controller\n\nFollow a real Air Traffic Control career through six iconic airports in Canada including Niagara Falls, Hamilton, London, North Bay , Toronto, and Gander. Instructor John guides you through new traffic and increasingly busy skies.\n\n# Climb the Leaderboards\n\nCompete at any of six airports. Every ten safe flights raises the pressure. Handle takeoffs, landings, flyovers, circuits, weather, military airspace and emergencies. Keep going until your first crash.\n\n# Build Your Own Airport\n\nExplore Sandbox at your own pace. Start with an existing airport or build your own. Place runways and a helipad, choose a tower, and set the traffic, weather and time of day. Play on your table or spread the airport across your room.\n\n# Make Yourself at Home\n\nKeep radar, flight strips and live performance stats close at hand on your instrument console. Move and resize the airport to suit your space, then get back to bringing everyone home.", "short_description": "Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw flight paths and guide planes and helicopters safely home across Campaign, Competitive and Sandbox modes in Vector Tango, a mixed reality air traffic control game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vector-tang
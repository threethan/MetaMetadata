085_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gb3Fvovis_0Q7kNvwHGIOv4&_nc_oc=AdpPcQ5xS-1ELrk1ebmy1EuiYCor4J85O5WquveB_t7-EdiyvPvigxpISmfDy0GV8iE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwEjb3s8D5hx6FQ31IMHTylwL7ilNRsAiq-uy2JeqjVA&oe=6B099F6F"}, {"file_name": "04-toronto-board.png", "id": "1076793802004654", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499299051_1076793805337987_5134655876056167188_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7oYV-LH9UMQ7kNvwGl9ymt&_nc_oc=AdoeoSJ1j4bbLlLfQIJzHRrrPfMTKzwZ_-7f3r_le0NkLIWXkPOdgcoc_XzdPqGluP4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfJl95IJnNoVzuLDymAApLtrmZDJzjLBaOuwVa0YSXvw&oe=6B09AB2D"}, {"file_name": "media.png", "id": "2549011632251228", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_2549011638917894_6705380027368372027_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_C6vGKtbFYQ7kNvwENiw7F&_nc_oc=Adqjp1p2z5jEAUp4RRU6onkpahNTtcb9By4mfHSQ6i2Wvld8oLq77BAqVs15SP9e6Ag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnJuXV5wMqik3vHc9KHGeHr1ExoiTzg6L4mJwuls1Ziw&oe=6B09A010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VectorTango-Trailer-Cover-2560x1440.png", "id": "2923411478019339", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_2923411481352672_3833593977786963202_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAtYk_jZLKAQ7kNvwEL2b6M&_nc_oc=AdpHGJ7QKFLK9ylYh9yu8M4q_SUEZf3cPIoDGaiMttXYU_TRu-s21js9QZQUPuY8-_M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf8J02oSWuaC6KiPIZ7HElmt4UN6sApylMbnSO_PMn0w&oe=6B09CB2E"}, "display_name": "Vector Tango", "keywords": ["airport", "simulation", "flight", "airplanes", "flying"], "long_description": "Take the controller's seat in Vector Tango, a mixed reality air traffic control game where a miniature airport comes to life in your space.\n\nDraw paths through the air to guide propeller planes, jets and helicopters. Line up arrivals, release departures and route passing traffic to its next sector. Every clearance needs room: watch the approaches, read the flight strips and keep aircraft safely separated.\n\nFollow a campaign across Niagara, Hamilton, London, North Bay and Toronto. Fifteen authored shifts introduce new traffic and increasingly busy skies, with instructor John guiding you through the essentials.\n\nChoose Competitive and compete against other air traffic controllers across the metaverse on a single airport with escalating difficulty. Deal with takeoffs, landings, flyovers, circuits, weather conditions, military airspace, and even emergencies. \n\nOr choose Sandbox play to arrange your airfield and explore at your own pace either on your own custom table top interface or at room scale where every surface becomes it's own runway!\n\nYour instrument console keeps radar, flight strips and operational information close at hand. Move and resize the airport and console to suit your play space, then get back to bringing everyone home.", "short_description": "Little Planes. Big Responsibilities.\n\n Vector Tango is a 3D Air Traffic Control Simulator. Bring a miniature airport into your room, draw flight paths, and guide planes and helicopters safely to their destination across three different modes (Competitive, Campaign and Sandbox)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vector-tango.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Scobel Media", "support_website_url": null, "website_url": "https://www.vector-tango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
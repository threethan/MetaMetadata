5Up6GPKDRA&oe=6AF9DB33"}]}, "id": "2173327693564187", "locale": "en_US", "screenshots": [{"file_name": "03-toronto-dusk.png", "id": "4590792181239518", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300725_4590792184572851_7323581480196008481_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvHDEhN9skEQ7kNvwEJafC8&_nc_oc=Adrlm2l_BMHrItNiXktOfCdVSa5gi1vmyyXDek_XWshyCy2X-lEO7-kDAiDCvOiwpFA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU2WLO_YoxXyzIQAw7J26opHyD5tFNcHhiUaah21lWEA&oe=6AF9EA34"}, {"file_name": "02-vr-tower.png", "id": "2117644206252628", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499296214_2117644209585961_7956427769769125157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VK-MNfbrwDEQ7kNvwGgO982&_nc_oc=Adp_mVxHgc3CgrrNnswrYfVPDS7ghwq-vWsHD-zycgzJXPr97yBKys4dEBowV6SgGPM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxSugACDZUgtW0HdtvUQyXnSxEA6X1xmiv6hqjCY0uJg&oe=6AF9C52E"}, {"file_name": "05-toronto-night.png", "id": "1874280976894320", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308043_1874280980227653_1381804306399825085_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pkl0T0_pzR8Q7kNvwGRR_X2&_nc_oc=AdpsAV_dZZeG5wTjVVk4Qs-IaxycnlRwomYZuA2dlDJP0H3seUPomH4zcJ8g0Z8p-7Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtS42OJ8Odkac_hH_B7-uLjTXWu4NupxXBwPjOmGegVA&oe=6AF9CD6F"}, {"file_name": "04-toronto-board.png", "id": "1076793802004654", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499299051_1076793805337987_5134655876056167188_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4X_ij4qHYUwQ7kNvwH2cC7D&_nc_oc=AdoPXbk7IZJ3_aWtvcm7D8tAteZm5Dri7G60qdx7IfImlKWp4tZqRbN7fDN7qQuOdVs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHISnwFsJvAzfsyvrjWsiupai0HEQGymRYietnlpx06w&oe=6AF9D92D"}, {"file_name": "media.png", "id": "2549011632251228", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823783_2549011638917894_6705380027368372027_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksHrCnyGRK0Q7kNvwG4Vdn6&_nc_oc=AdqBh7qnt4i6-8sphm_fw1UeoXxVSEMdnZGqoaatYAsRc3mjgdeV6xydlx9eyB2shQo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR68sX2kCXj7omTeLJawdmY08xhwhQ1phkmrYwMLk3HIg&oe=6AF9CE10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VectorTango-Trailer-Cover-2560x1440.png", "id": "2923411478019339", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/596168449_2923411481352672_3833593977786963202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOudSBYyvXgQ7kNvwFDydVu&_nc_oc=AdpNu26PRtdZp-3yZVENkv6RutvICMKTeKc1iA-fUPKbmgciUo6VywWt0-fDFozHSok&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTuxJk_tJsHDoyQMJd11b3h1ExMbEfTrUpQNWYe64iFQ&oe=6AF9C0EE"}, "display_name": "Vector Tango", "keywords": ["airport", "simulation", "flight", "airplanes", "flying"], "long_description": "Take the controller's seat in Vector Tango, a mixed reality air traffic control game where a miniature airport comes to life in your space.\n\nDraw paths through the air to guide propeller planes, jets and helicopters. Line up arrivals, release departures and route passing traffic to its next sector. Every clearance needs room: watch the approaches, read the flight strips and keep aircraft safely separated.\n\nFollow a campaign across Niagara, Hamilton, London, North Bay and Toronto. Fifteen authored shifts introduce new traffic and increasingly busy skies, with instructor John guiding you through the essentials.\n\nChoose Competitive and compete against other air traffic controllers across the metaverse on a single airport with escalating difficulty. Deal with takeoffs, landings, flyovers, circuits, weather conditions, military airspace, and even emergencies. \n\nOr choose Sandbox play to arrange your airfield and explore at your own pace either on your own custom table top interface or at room scale where every surface becomes it's own runway!\n\nYour instrument console keeps radar, flight strips and operational information close at hand. Move and resize the airport and console to suit your play space, then get back to bringing everyone home.", "short_description": "Little Planes. Big Responsibilities.\n\n Vector Tango is a 3D Air Traffic Control Simulator. Bring a miniature airport into your room, draw flight paths, and guide planes and helicopters safely to their destination across three different modes (Competitive, Campaign and Sandbox)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vector-tango.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Scobel Media", "support_website_url": null, "website_url": "https://www.vector-tango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39373400705580516"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4297764780368414"}, {"status": "PUBLISHED", "id": "1090474703603087"}]}, "baseline_offer": {"id": "4297764780368414"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793728800, "status": "PUBLISHED", "id": "4297764780368414"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40879481974972374", "version": "37.1103.1338"}, "id": "1051376351225341", "channel_name": "LI
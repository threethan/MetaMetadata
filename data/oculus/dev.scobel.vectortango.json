-iad6-1.oculuscdn.com/v/t64.5771-25/499296214_2117644209585961_7956427769769125157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X2nnwWjbMEQ7kNvwFOght7&_nc_oc=AdptJJpG_EA5p9H950qwKNjDyxA9dvvZrMsC_dEK2FVfGq-4951aA38TtZ32i5J_3K4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCWu0aNKo-NTu2nMWQEGh-ohzw5Sa19h_7qJwVRgIJMw&oe=6AF5D0AE"}, {"file_name": "04-toronto-board.png", "id": "1076793802004654", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299051_1076793805337987_5134655876056167188_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyK6dBvMrUkQ7kNvwHAdPr9&_nc_oc=Adra4UydJd1vuF-OWVHXAxCqrsXAq8Zmrqj5_er7Zg5WB0nosZzaYtpWuTYUpkpFBgk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvO4hC_jCViYiU81LoKSAJhRhs9NLoAPi7-ddyq4CI5w&oe=6AF5E4AD"}, {"file_name": "media (2).png", "id": "29186998114246474", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830576_29186998120913140_6116693940805868270_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD6EFStvvrgQ7kNvwETc5k6&_nc_oc=AdonGBxNeJYaAuq8DVCItRBmJPrVQNlrYtfeE9JZYM2nyanfm6FOhIwsGxpVUUSwjsI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNPluoTLq4ktyT2_mhFqMHD3uUEFaa9U1sMJf7LE9UXw&oe=6AF5C682"}, {"file_name": "meta-store.png", "id": "2025348921497867", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_2025348924831200_4339260311944223146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yMX2dfO7AwQ7kNvwHahX9o&_nc_oc=AdoN-z8yEPyEZjmqmjWvBFythxyr6J-VoIz1NZs3r5gTFqeuXA2PZ1hFgfqnrc2dDVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFPw2YPX9YDFn8vMbE-YSy62k4l3EH1tQ22Yzqjn70_g&oe=6AF5E22A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VectorTango-Trailer-Cover-2560x1440.png", "id": "2923411478019339", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596168449_2923411481352672_3833593977786963202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwTStr6WR-MQ7kNvwECeLiK&_nc_oc=Adr8ZlXP2qOFbmaVfZ1mdKS0mjC-znDc2OAjdlsyf6nBLYU4fFjZQ1D0rjGJQy4FAp8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8Pw3JT-UiTuSeJd6cZkLzicz-mgvWiXA5i6HvE6q5Lg&oe=6AF5CC6E"}, "display_name": "Vector Tango", "keywords": ["airport", "simulation", "flight", "airplanes", "flying"], "long_description": "# Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw paths through the air to guide planes and helicopters safely home. Line up arrivals, release departures and route passing traffic onward. Read the flight strips and keep aircraft safely separated. Play on your table or switch to a VR control tower.\n\n# Become an Air Traffic Controller\n\nFollow a real Air Traffic Control career through six iconic airports in Canada including Niagara Falls, Hamilton, London, North Bay , Toronto, and Gander. Instructor John guides you through new traffic and increasingly busy skies.\n\n# Climb the Leaderboards\n\nCompete at any of six airports. Every ten safe flights raises the pressure. Handle takeoffs, landings, flyovers, circuits, weather, military airspace and emergencies. Keep going until your first crash.\n\n# Build Your Own Airport\n\nExplore Sandbox at your own pace. Start with an existing airport or build your own. Place runways and a helipad, choose a tower, and set the traffic, weather and time of day. Play on your table or spread the airport across your room.\n\n# Make Yourself at Home\n\nKeep radar, flight strips and live performance stats close at hand on your instrument console. Move and resize the airport to suit your space, then get back to bringing everyone home.", "short_description": "Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw flight paths and guide planes and helicopters safely home across Campaign, Competitive and Sandbox modes in Vector Tango, a mixed reality air traffic control game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vector-tango.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Scobel Media", "support_website_url": null, "website_url": "https://www.vector-tango.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "40689732560613984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1243140841300724_8179694623350355653_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTf6JcKnWNgQ7kNvwEOsGxx&_nc_oc=Adp8uv0QDafXBwaGrj8s6hOdBMVayVLL5uax7sC-lwU_0N0UnzXY-t5BmMt4bzrnjKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRle1FG9Sm9qOGQcMunejgdZpNeTMxByybcLW_DVbNwNg&oe=6AF5D2D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Vector Tango", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1793728800, "lastRevision": {"nodes": [{"id": "39373400732247180", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "39373400642247189", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1397840875102001"}, "iarc_
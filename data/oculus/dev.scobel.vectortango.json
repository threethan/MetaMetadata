-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_2117644209585961_7956427769769125157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-X2nnwWjbMEQ7kNvwGUq5Z5&_nc_oc=Adrqies3MZExktreCaF1680RrdSKi_JjULMpD0yB0X0PL7EUAKRb9rnqUOrd7Nkt9uE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqD4OR-AXfUBAzXj9orqV2u9XPDkda4KBTJSiV9rmiXg&oe=6AF8ABEE"}, {"file_name": "04-toronto-board.png", "id": "1076793802004654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299051_1076793805337987_5134655876056167188_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4X_ij4qHYUwQ7kNvwHtWjmU&_nc_oc=Adq002HBoH3s1QpckuvsKjlf6OYKgX_m4-XJnHbx0ieMFdxlBIUI3jrdgWKNGSLxhsM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEVP5yxH0BRMPDoyNPNQyng7FZPwjLFy9uKG939LHI2Q&oe=6AF887AD"}, {"file_name": "media (2).png", "id": "29186998114246474", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830576_29186998120913140_6116693940805868270_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD6EFStvvrgQ7kNvwGwNqIA&_nc_oc=AdqlkaCbDwTU7IKjhmoK3WMxCrk_I3YQ3zxpMWEPsznTN55M2JlkIsJNJnmYcZSk0bA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqK5GbTcXueWQkK2EpaaOmaDZci8EzKsoEJRUkn42RXA&oe=6AF8A1C2"}, {"file_name": "meta-store.png", "id": "2025348921497867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604360590_2025348924831200_4339260311944223146_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4YhCYaH338Q7kNvwH4DHQ3&_nc_oc=AdrbVHOAmLqFbrCPMeGiOe_AQjTFAmDbkmOlO-ppL7r6xnArFMH78g3QQafLhVkfA_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRekcwij_G0knHVxNlySbJpiMHwfwrHKZ9O-pUkXaZB-w&oe=6AF8852A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VectorTango-Trailer-Cover-2560x1440.png", "id": "2923411478019339", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_2923411481352672_3833593977786963202_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwTStr6WR-MQ7kNvwEqAY8Z&_nc_oc=AdpbXMISy0tMIE9kD1zhbLHMaq5UwXWh_vjcReMoojuj_xfzccR18iLEmZh-G4mnSqA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxJC_uGGMMgJWvvvy1acFQmjHsDsiflj1ehlRH0OcphA&oe=6AF8A7AE"}, "display_name": "Vector Tango", "keywords": ["airport", "simulation", "flight", "airplanes", "flying"], "long_description": "# Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw paths through the air to guide planes and helicopters safely home. Line up arrivals, release departures and route passing traffic onward. Read the flight strips and keep aircraft safely separated. Play on your table or switch to a VR control tower.\n\n# Become an Air Traffic Controller\n\nFollow a real Air Traffic Control career through six iconic airports in Canada including Niagara Falls, Hamilton, London, North Bay , Toronto, and Gander. Instructor John guides you through new traffic and increasingly busy skies.\n\n# Climb the Leaderboards\n\nCompete at any of six airports. Every ten safe flights raises the pressure. Handle takeoffs, landings, flyovers, circuits, weather, military airspace and emergencies. Keep going until your first crash.\n\n# Build Your Own Airport\n\nExplore Sandbox at your own pace. Start with an existing airport or build your own. Place runways and a helipad, choose a tower, and set the traffic, weather and time of day. Play on your table or spread the airport across your room.\n\n# Make Yourself at Home\n\nKeep radar, flight strips and live performance stats close at hand on your instrument console. Move and resize the airport to suit your space, then get back to bringing everyone home.", "short_description": "Little Planes. Big Responsibility.\n\nBring a miniature airport into your room. Draw flight paths and guide planes and helicopters safely home across Campaign, Competitive and Sandbox modes in Vector Tango, a mixed reality air traffic control game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vector-tang
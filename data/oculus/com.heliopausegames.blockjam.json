94871137915709897_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fu-vO3UqSf8Q7kNvwE4cUkC&_nc_oc=Adq6m0M4SPy0te9CL9cOjN1nIRNFpFn8ZDuLOMNyHFfZloPd22r-mQcBsEgs9zytypY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcLE41weARamBJ26l9vBMVGTzh_GJ0Fr5wQnVb3AzeFw&oe=6AFB3A16"}, {"file_name": "image4.png", "id": "1346775566550105", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823901_1346775569883438_9195274222790997056_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9TrvLHVoeoQ7kNvwEgvWFb&_nc_oc=AdqeS3vzSy7AZbTfp9o6881A9xSGEK8Ww9hl1_Gd46SjbR_SmsNdiLBrO7CN8V5FNDw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpyd3s3rqD2AKKhkNjT4EZSfiSRkpaN8Qi_Qt20GwVIg&oe=6AFB2A40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Block Jam", "keywords": ["Puzzle"], "long_description": "# Block Jam \u2013 The Ultimate Puzzle Challenge\n\nStep into a visually immersive puzzle world where your hands are the key to unlocking 3D structures. Shift, slide, and remove cubes in the right direction to clear each intricate formation.\n\n**How to play**  \nGrab a cube, find the correct direction, and slide it out without getting blocked. Think ahead, plan your moves, and dismantle the structure piece by piece. Precision and spatial logic are your best tools.\n\nEasy to pick up, tough to put down.\n\n\n**Features** \n\n- 50+ handcrafted puzzles with increasing complexity\n- Intuitive hand tracking \u2013 play with just your hands, no controllers needed\n- Mixed Reality passthrough for seamless gameplay in your real environment\n- Calming visuals with minimal design\n- Play standing, sitting, or even lying down\n\nPerfect for fans of tactile puzzles, spatial reasoning, and immersive design.\n", "short_description": "Block Jam is an impressive puzzle experience where players move cubes in their own directions to clear complex 3D structures. Use your spatial skills to overcome challenges and test your logic and precision. Enjoy a dynamic gameplay environment by solving puzzles that become increasingly complex with each level. It\u2019s the perfect game for those who enjoy mental challenges and immersive experiences!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vT2CeIScEXwUicLjXpgKofrWXaL5HkcUbgzwgztt1gfw5Z14wl14Q--bJwRFLZcpa5OsgAlMP8RVBVq/pub", "developer_terms_of_service_url": null, "publisher_name": "Heliopause Games", "support_website_url": null, "website_url": "https://kaankaankaann.github.io/block-jam/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10002051033147571"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1267795755383007"}, {"status": "PUBLISHED", "id": "1017221601266294"}, {"status": "PUBLISHED", "id": "956477460293750"}, {"status": "PUBLISHED", "id": "1283405750503177"}, {"status": "PUBLISHED", "id": "759881743695308"}, {"status": "PUBLISHED", "id": "1315267623545830"}, {"status": "PUBLISHED", "id": "1373971260562811"}, {"status": "PUBLISHED", "id": "686254780862756"}]}, "baseline_offer": {"id": "686254780862756"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1267795755383007"}]}, "liveChannel": {"nodes": [{"latest_supported_bina
BD5235"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jack Tag", "keywords": [], "long_description": "Jack Tag is an exciting game that offers players a unique blend of fun and competitive gameplay. With four engaging game modes, players can enjoy a variety of experiences, all while showcasing their agility and teamwork skills in a vibrant, monkey-themed environment.\nDive into the world of Jack Tag and experience the thrill of monkeying around with friends and players from around the globe! Whether you prefer casual play or intense competition, there's something for everyone in this dynamic fangame.", "short_description": "A new interesting Game where you move with hand"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTIaAkxHs_9vPP6twQqS9uQ51bP7_EnWcq5tIdv4JSG-TRX3CnYfEteHeoLwH908ggsWTC0OXCx1ElK/pub", "developer_terms_of_service_url": null, "publisher_name": "JustieVR", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vSuBB8TkhUx6drkRWYu8rzIaZSXxk2E8n_TD8he-8BK5lL7AwwN4u5VB0BoPxJLhC_hXy-8XugWaelD/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9856950301003103"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"lates
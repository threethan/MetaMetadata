f\u30f3\u30b0\u3067\u7121\u6599\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u624b\u8efd\u306b\u4f53\u9a13\uff01\n\u9ad8\u753b\u8cea3DVR\u30842D\u52d5\u753b\u306b\u3082\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\uff01\n\u8feb\u529b\u306e3DVR\u30d7\u30ec\u30a4\uff01\u52d5\u753b\u30d7\u30ec\u30a4\u4e2d\u306f\u982d\u3092\u52d5\u304b\u3057\u3066\u30dd\u30a4\u30f3\u30bf\u3092\u5408\u308f\u305b\u308b\u3060\u3051\u3067\u7c21\u5358\u306b\u64cd\u4f5c\u3067\u304d\u307e\u3059\u3002\n\u30b9\u30c8\u30ea\u30fc\u30df\u30f3\u30b0\u3067\u306f\u30b9\u30e0\u30fc\u30ba\u306b\u52d5\u753b\u304c\u95b2\u89a7\u3067\u304d\u307e\u3059\u3002\u30ed\u30fc\u30ab\u30eb\u8996\u8074\u3067\u306f\u304a\u597d\u304d\u306a\u52d5\u753b\u3092PC\u304b\u3089\u5165\u308c\u3066\u304a\u697d\u3057\u307f\u3044\u305f\u3060\u3051\u307e\u3059\u3002\n\n\u8868\u793a\u65b9\u5f0f\nVR\u52d5\u753b\uff1a360\u00b03D TOP\u30dc\u30c8\u30e0\u65b9\u5f0f(\u30d5\u30a1\u30a4\u30eb\u540d_TB.mp4)\u53ca\u3073\u3001\u30b5\u30a4\u30c9\u30d0\u30a4\u30b5\u30a4\u30c9\u65b9\u5f0f(\u30d5\u30a1\u30a4\u30eb\u540d_LR.mp4) \u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u3002\n\u52d5\u753b\u30b3\u30fc\u30c7\u30c3\u30af\u306f[ MP4(h264 h265\u30b3\u30fc\u30c7\u30c3\u30af) ]\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u3002\n\u203b\u5404\u52d5\u753b\u306e\u4f5c\u308a\u306b\u3088\u308a180\u00b0\u3067\u6620\u50cf\u90e8\u5206\u3092\u5207\u308a\u53d6\u3063\u305f\u3082\u306e\u304c\u3042\u308a\u307e\u3059\u304c\u5207\u308a\u53d6\u3089\u308c\u305f\u9ed2\u3044\u90e8\u5206\u3092\u542b\u3081\u57fa\u672c\u7684\u306b360\u00b0\u3067\u518d\u751f\u3055\u308c\u307e\u3059\u3002\n\n\u30b9\u30c8\u30ea\u30fc\u30df\u30f3\u30b0\u52d5\u753b\u4e00\u89a7\u30da\u30fc\u30b8\n\u30fb\u5bfe\u5fdc\u30b5\u30a4\u30c8\u306b\u3066\u8cfc\u5165\u3057\u305f\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u8996\u8074\u3067\u304d\u307e\u3059\u3002\u30b5\u30a4\u30c8\u306eID\u30fb\u30d1\u30b9\u30ef\u30fc\u30c9\u3092\u5165\u529b\u3057\u3066\u30ed\u30b0\u30a4\u30f3\u3067\u304d\u307e\u3059\u3002\n\u30fb\u5927\u304d\u304f\u3066\u9078\u3073\u3084\u3059\u3044\u30b5\u30e0\u30cd\u3092\u63a1\u7528\u3057\u3066\u3044\u307e\u3059\u3002\u30b5\u30e0\u30cd\u3092\u62bc\u3059\u3060\u3051\u3067\u518d\u751f\u304c\u59cb\u307e\u308a\u307e\u3059\u3002\n\nVR\u52d5\u753b\u518d\u751f\u6642\n\u30fb\u4e00\u6642\u505c\u6b62\u306f\u624b\u6301\u3061\u306e\u30ea\u30e2\u30b3\u30f3\u306e\u30dc\u30bf\u30f3\u3092\u62bc\u3057\u307e\u3059\u3002\n\u30fb\u4fbf\u5229\u306a\u30b7\u30fc\u30af\u30d0\u30fc\u3064\u304d\u3067\u623b\u308b\u9032\u3080\u3082\u753b\u9762\u30dd\u30a4\u30f3\u30bf\u3092\u8996\u70b9\u3067\u5408\u308f\u305b\u308b\u3060\u3051\u3067\u64cd\u4f5c\u53ef\u80fd\u3002\n\u30fb\u30ea\u30bb\u30f3\u30bf\u30fc\u3057\u305f\u3044\u5834\u5408\u306f\u4e2d\u592e\u306e\u300c\u30ea\u30bb\u30f3\u30bf\u30fc\u300d\u306b\u8996\u70b9\u3092\u5408\u308f\u305b\u308b\u3060\u3051\u3067\u7c21\u5358\u306b\u30bb\u30f3\u30bf\u30fc\u304c\u30ea\u30bb\u30c3\u30c8\u3055\u308c\u307e\u3059\u3002\n\u30fb\u4e00\u89a7\u306b\u623b\u308b\u5834\u5408\u306f\u52d5\u753b\u5185\u306e\u300c\u623b\u308b\u300d\u3092\u898b\u308b\u3060\u3051\u3067\u4e00\u89a7\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\n\n2D\u518d\u751f\u6642\n\u30fb\uff12D\u6620\u50cf\u3082\u30b7\u30a2\u30bf\u30fc\u30e2\u30fc\u30c9\u3067\u7dba\u9e97\u306b\u518d\u751f\u3002\u3086\u3063\u305f\u308a\u5ea7\u3063\u3066\u6620\u753b\u3092\u898b\u3066\u3044\u308b\u3088\u3046\u306a\u7a7a\u9593\u304c\u697d\u3057\u3081\u307e\u3059\u3002\n\u30fb\u4e00\u89a7\u304b\u3089\u52d5\u753b\u3092\u9078\u3073\u52d5\u753b\u3092\u518d\u751f\u30fb\u753b\u9762\u4e2d\u592e\u306e\u4e38\u3044\u30ea\u30e2\u30b3\u30f3\u306e\u7d75\u306b\u30dd\u30a4\u30f3\u30bf\u3092\u5408\u308f\u305b\u3066\u624b\u6301\u3061\u306e\u30ea\u30e2\u30b3\u30f3\u3092\u62bc\u3059\u3068\u64cd\u4f5c\u30d1\u30cd\u30eb\u304c\u51fa\u73fe\u3057\u307e\u3059\u3002\n\u30fb\u30ea\u30bb\u30f3\u30bf\u30fc\u3057\u305f\u3044\u5834\u5408\u306f\u624b\u6301\u3061\u306e\u30ea\u30e2\u30b3\u30f3\u3092\u30c0\u30d6\u30eb\u30af\u30ea\u30c3\u30af\u30
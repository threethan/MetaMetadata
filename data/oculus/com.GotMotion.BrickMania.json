L57zI&_nc_oc=AdrG5g_g10AN6Su5cvK4Hs7BAHA9saoATtBFS93eCTRQEt1SXme8me8A_asdKL7AgcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSk0OtAQjQwXIWmcRblXIwhneyae4uoJlLgeTBnOKMEbQ&oe=6B0DBEA2"}, {"file_name": "5.png", "id": "439398765677918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/43931331_439398769011251_6832019495182883720_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejIhU0LV5pQQ7kNvwEovXLB&_nc_oc=AdqvOobiff0AztSMcN_eTgg6fcwlU-RvnLY5ppv-dpGn3D-m-tGOeZggMCeV-Vn4zm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQCUuEJ7aEOKPSC0j5vy-lI-w8S0GhKz7scydZ5GQi8FQ&oe=6B0DA119"}, {"file_name": "2.png", "id": "800507275395357", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_800507278728690_8370916924605575234_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u12c9c8rwsAQ7kNvwEAF1NE&_nc_oc=AdrIBW9u1ktJSHr6jHKQYTBhTMOjHZH1eHdMspOZ8mZBwOnLLGqx8ALC2DYbbEIvhxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRADrf08P6RSzPf2pW-1fTKiYTQx5zcyRWexcHWcfB8dw&oe=6B0DB343"}, {"file_name": "Untitled.png", "id": "332917583088461", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035363_332917586421794_8831279654688852183_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNUNDNWXINUQ7kNvwFX3Ffl&_nc_oc=AdrOA54PD-bharMiug6IVbE_0jUVSYwDcNiOnL4DJGbY5S2EExrnmLIlAGJvYV3uOXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJZX6SVQd0hdfuVNR2oZg35NUeZHlxe8uE5rLjVQcU8Q&oe=6B0DBC27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 59.png", "id": "1524970634865802", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984452_1524970638199135_826433915348957463_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DrtD_go4R4Q7kNvwFgx3BN&_nc_oc=Adq2bl3GTxvk7oRPRBXqvGJw2BoL880dmOeNFLUIvVahvz4aU5Daqp4JsZbeewV8Usg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHvuKqa5atYn6ygyLBluKnZ6Bde6o-ASN8HsY2IOjX1A&oe=6B0DB68C"}, "display_name": "Brick Mania", "keywords": [], "long_description": "\n\n\ud83e\udd8d **BRICK MANIA: UNLEASH YOUR INNER BRICK \ud83e\udd8d**\n\nShrink down to action figure size and explore an exciting room as a brick. With no legs and a lot of personality, you\u2019ll run on your hands through various fun-filled activities.  \n\n\ud83e\udda0 **BUILT IN MODS** \ud83e\udda0\n\nExplore the COOLEST mods that are easy to get. Rockets, Fly, No Clip, Speed Hacks, X Ray, Teleport, Laptop, and much more!\n\n\ud83d\udcf8 **FREE CAMERA MOD: MOST ADVANCED CAMERA \ud83d\udcf8**\n\nOur built-in camera mod lets you switch between first-person, third-person, and other exciting perspectives to enhance your gameplay experience.\n\n\ud83c\udfe0 **GAME MODES\ud83c\udfe0**\n\nHave fun and talk with other bricks in our casual mode or show your inner brick and jump into an infection lobby. More game modes soon to come..\n\n\u2757\ufe0f\u2757\ufe0f**BIG UPDATES CONSTANTLY\u2757\ufe0f\u2757\ufe0f**\n\nWe do our best to get out updates every week or every other week to best support our community. We built what the community wants!\n\n\n\ud83c\udfc0 **SHOOT HOOPS LIKE NEVER BEFORE** \ud83c\udfc0 \n\nHit the basketball court for some epic trick shots. Whether you\u2019re a baller or just want hit some jumpers, the court is yours.\n\n\n\n\n\ud83d\udecd\ufe0f **EXPLORE THE MALL AND GET COSMETICS \ud83d\udecd\ufe0f**\n\nVisit our in-game mall and deck out your brick with an array of cosmetics. From funky outfits to stylish accessories, there\u2019s something for everyone.\n\n\ud83e\udd73 **JOIN THE BRICK MANIA NOW \ud83e\udd73**\n\nReady to experience life as a brick? Join the Brick Mania now and embark on a tiny, yet massive adventure. Play for free and let the fun begin! Join our Discord to get support or find people to play with: https://discord.gg/brickmania", "short_description": "Step into the shoes of a miniature, brick in a room-sized adventure.Run, Jump, Tag, Shoot hoops, Explore mods, take videos using in game camera mod, and customize your look at the in-game mall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gotmotion.gg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Got Motion", "support_website_url": null, "website_url": "https://gotmotion.gg/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7775382612575240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031358_1008229424144764_8454664177896328679_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phHeoGcv7iAQ7kNvwFSQWhs&_nc_oc=Adpsk9CKSAtvgEZbERQxlAwRaUqihYI-lQsxNExXBYikEtQtr7KfZv8uQsteUg1LJic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIMgOo9eEfbRJZdazZ7_cCWchjKie9J7TxSH6PE9WWzg&oe=6B0DB8AC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brick Mania", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1722647181, "lastRevision": {"nodes": [{"id": "7775382652575236", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metad
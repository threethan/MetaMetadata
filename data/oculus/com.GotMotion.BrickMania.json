cvcg0&_nc_oc=AdoM5uXPbVZPTaMNcQhJ1L169LXDdQBaJcYzYkYEPkLFkynwaTV8i9rhzwEZtPzlBL4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRKk2knsjGS15iVVV3yZIlwOV0Ed3c1ky3waGVlWmfNA&oe=6B084062"}, {"file_name": "5.png", "id": "439398765677918", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/43931331_439398769011251_6832019495182883720_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v04rWbi9ZTwQ7kNvwFlcPVK&_nc_oc=AdqpyQEuubkcSVxPKBNtic1hltY-tu5zkY1uRgOgLMlv6WZ1vfkTR2DSTF49ruVkh_A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXaNfwd7qjTtjdMN3Kr_HAnVkqXpCTueOW2_dh-c08rg&oe=6B085B19"}, {"file_name": "2.png", "id": "800507275395357", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974714_800507278728690_8370916924605575234_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9lF9Mt7vu4Q7kNvwH9Uit6&_nc_oc=AdqwQ4q3crVJQ5ZwsdNkQS0GIRbSVm-J4T5_BZuMTAwah81Jxm0da71gL2nHmfEAez0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyyPn80CeZO6csLDegH8VZjskd3SEkT36H0bqOvS63Zw&oe=6B086D43"}, {"file_name": "Untitled.png", "id": "332917583088461", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035363_332917586421794_8831279654688852183_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g32wYPK-kikQ7kNvwFfpTvU&_nc_oc=Adq_pfShOnfbKE_cGWG8WCNEzDGNM8XQvnI-ohevGqK_FQazi7agWdNEOosxq_fL3PE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_JTsd4jGA82SXlA1Ttu7myEtxxiiN6HHEGgJ3zcAeOQ&oe=6B083DE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 59.png", "id": "1524970634865802", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984452_1524970638199135_826433915348957463_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZ1gGSNqb5sQ7kNvwFIeuAZ&_nc_oc=AdpAT2ToFxEvHiSQZKY_OfUU-Bzs-YO_MWlOLv2bfyQVumWwZxYoQFO4WvNp7Ug1BWo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb_nVVs6kGmpTuq5LMSaReJuw-j-m4EVm_JzPylqNN3Q&oe=6B08708C"}, "display_name": "Brick Mania", "keywords": [], "long_description": "\n\n\ud83e\udd8d **BRICK MANIA: UNLEASH YOUR INNER BRICK \ud83e\udd8d**\n\nShrink down to action figure size and explore an exciting room as a brick. With no legs and a lot of personality, you\u2019ll run on your hands through various fun-filled activities.  \n\n\ud83e\udda0 **BUILT IN MODS** \ud83e\udda0\n\nExplore the COOLEST mods that are easy to get. Rockets, Fly, No Clip, Speed Hacks, X Ray, Teleport, Laptop, and much more!\n\n\ud83d\udcf8 **FREE CAMERA MOD: MOST ADVANCED CAMERA \ud83d\udcf8**\n\nOur built-in camera mod lets you switch between first-person, third-person, and other exciting perspectives to enhance your gameplay experience.\n\n\ud83c\udfe0 **GAME MODES\ud83c\udfe0**\n\nHave fun and talk with other bricks in our casual mode or show your inner brick and jump into an infection lobby. More game modes soon to come..\n\n\u2757\ufe0f\u2757\ufe0f**BIG UPDATES CONSTANTLY\u2757\ufe0f\u2757\ufe0f**\n\nWe do our best to get out updates every week or every other week to best support our community. We built what the community wants!\n\n\n\ud83c\udfc0 **SHOOT HOOPS LIKE NEVER BEFORE** \ud83c\udfc0 \n\nHit the basketball court for some epic trick shots. Whether you\u2019re a baller or just want hit some jumpers, the court is yours.\n\n\n\n\n\ud83d\udecd\ufe0f **EXPLORE THE MALL AND GET COSMETICS \ud83d\udecd\ufe0f**\n\nVisit our in-game mall and deck out your brick with an array of cosmetics. From funky outfits to stylish accessories, there\u2019s something for everyone.\n\n\ud83e\udd73 **JOIN THE BRICK MANIA NOW \ud83e\udd73**\n\nReady to experience life as a brick? Join the Brick Mania now and embark on a tiny, yet massive adventure. Play for free and let the fun begin! Join our Discord to get support or find people to play with: https://discord.gg/brickmania", "short_description": "Step into the shoes of a miniature, brick in a room-sized adventure.Run, Jump, Tag, Shoot hoops, Explore mods, take videos using in game camera mod, and customize your look at the in-game mall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gotmotion.gg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Got Motion", "support_website_url": null, "website_url": "https://gotmotion.gg/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7775382612575240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031358_1008229424144764_8454664177896328679_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E87I_mdT5xIQ7kNvwGx2XlI&_nc_oc=Ado0u9GiS1SQAnuH9Zgt9g4bUX5EfU6ZyAYdlKLel1Z6zNQUze6rx503wIlmf1j5ADc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6uFmNFwx3Ui5tOLrreyGRN69k9GR_RVAzzVJGTyXPJA&oe=6B0872AC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brick Mania", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1722647181, "lastRevision": {"nodes": [{"id": "7775382652575236", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metad
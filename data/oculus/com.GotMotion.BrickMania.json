KJ3tC&_nc_oc=AdrfGD5IsBb0V5KCJsMBRPiWis76SHSGbNxi1D2pmPOITwVG_2_jt_9u7XU5ahwRPVU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsAqjM8oStc3qWLzLK5kdG6WNbcIlvZL6zT18tua4FOQ&oe=6AFC62E2"}, {"file_name": "5.png", "id": "439398765677918", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/43931331_439398769011251_6832019495182883720_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l6Q54l3ujAQ7kNvwEk36Fm&_nc_oc=Adrl55CBYKa5RXiQvpzGFKF-BLvc6vcUIEsAlJf2Dojdg0wbrmHd9c2kG40fEtBqPfY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhWfdG_rKjMOIu_fqipOleOUcDSrXGm8r6f16ctLQzQw&oe=6AFC7D99"}, {"file_name": "2.png", "id": "800507275395357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974714_800507278728690_8370916924605575234_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcTFpC4eUVwQ7kNvwHkFqXZ&_nc_oc=AdqZUBG7nDCVSIRVlaPl_ahL7WhCahsPN73FVyiGPX365udk0wMo7noWkAEiZWMof1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9jZ4TGVOqCLto2nTswkVXj9asgp5dJf--RxMQfSielg&oe=6AFC8FC3"}, {"file_name": "Untitled.png", "id": "332917583088461", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035363_332917586421794_8831279654688852183_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNLEEry23JcQ7kNvwFVJbH_&_nc_oc=Adq3Lp6VgKb-Zs0ii-YQkctF8SKHchv-GrBMeLgMZ4bSShO42RbhZ9Yx7g_YxNSFPZg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSac6zfyf9x50hfMTurAuIU5pxXVTzUsDHux_IEYXUbkw&oe=6AFC6067"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 59.png", "id": "1524970634865802", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984452_1524970638199135_826433915348957463_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjMaJkBNKhkQ7kNvwF75nkJ&_nc_oc=Ado3YyoNem5hrgKznjqodSgy8WsfXBvAv5vKsvrLHdhu2KygBCCbHCUkwKzuKOvh92c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7cLV_4lv614ynl9XPs-j2rhL2OBan9bTKtoczRZFvyA&oe=6AFC930C"}, "display_name": "Brick Mania", "keywords": [], "long_description": "\n\n\ud83e\udd8d **BRICK MANIA: UNLEASH YOUR INNER BRICK \ud83e\udd8d**\n\nShrink down to action figure size and explore an exciting room as a brick. With no legs and a lot of personality, you\u2019ll run on your hands through various fun-filled activities.  \n\n\ud83e\udda0 **BUILT IN MODS** \ud83e\udda0\n\nExplore the COOLEST mods that are easy to get. Rockets, Fly, No Clip, Speed Hacks, X Ray, Teleport, Laptop, and much more!\n\n\ud83d\udcf8 **FREE CAMERA MOD: MOST ADVANCED CAMERA \ud83d\udcf8**\n\nOur built-in camera mod lets you switch between first-person, third-person, and other exciting perspectives to enhance your gameplay experience.\n\n\ud83c\udfe0 **GAME MODES\ud83c\udfe0**\n\nHave fun and talk with other bricks in our casual mode or show your inner brick and jump into an infection lobby. More game modes soon to come..\n\n\u2757\ufe0f\u2757\ufe0f**BIG UPDATES CONSTANTLY\u2757\ufe0f\u2757\ufe0f**\n\nWe do our best to get out updates every week or every other week to best support our community. We built what the community wants!\n\n\n\ud83c\udfc0 **SHOOT HOOPS LIKE NEVER BEFORE** \ud83c\udfc0 \n\nHit the basketball court for some epic trick shots. Whether you\u2019re a baller or just want hit some jumpers, the court is yours.\n\n\n\n\n\ud83d\udecd\ufe0f **EXPLORE THE MALL AND GET COSMETICS \ud83d\udecd\ufe0f**\n\nVisit our in-game mall and deck out your brick with an array of cosmetics. From funky outfits to stylish accessories, there\u2019s something for everyone.\n\n\ud83e\udd73 **JOIN THE BRICK MANIA NOW \ud83e\udd73**\n\nReady to experience life as a brick? Join the Brick Mania now and embark on a tiny, yet massive adventure. Play for free and let the fun begin! Join our Discord to get support or find people to play with: https://discord.gg/brickmania", "short_description": "Step into the shoes of a miniature, brick in a room-sized adventure.Run, Jump, Tag, Shoot hoops, Explore mods, take videos using in game camera mod, and customize your look at the in-game mall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gotmotion.gg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Got Motion", "support_website_url": null, "website_url": "https://gotmotion.gg/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7775382612575240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031358_1008229424144764_8454664177896328679_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRtI6ZsD2XEQ7kNvwHG9opV&_nc_oc=Adpyho9paxbI6lcMYVej8gVFQS-L5owAMB3-Zv5BnD0nJrphPLWQYL5g2IiAKusHZ3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3sBoWXzqwEsFT9x4X2F_D9KCCCcy7pBn0h3XDTGPkQQ&oe=6AFC5CEC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brick Mania", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1722647181, "lastRevision": {"nodes": [{"id": "7775382652575236", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metad
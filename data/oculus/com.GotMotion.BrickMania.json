oculuscdn.com&_nc_ss=8&oh=00_Afz-E50vtHEUnZ__Riz-jHhiYGRMk7IvbH8tHuOH8reQPw&oe=69B028E2"}, {"file_name": "5.png", "id": "439398765677918", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43931331_439398769011251_6832019495182883720_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AasmILEDA48Q7kNvwHqaIMx&_nc_oc=Adk39_a7ow20F2NeO7-BHgqgACak7NOQKQz39czhgY2wuiF_qCLQqvWoxhEF5qB3iO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeglH7Rl2tTMYcq7hpTFT7uGVXkHnnUE1Bh7pi8Fi0rw&oe=69B00B59"}, {"file_name": "2.png", "id": "800507275395357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_800507278728690_8370916924605575234_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAHyDJKmQh4Q7kNvwEYX-eN&_nc_oc=Adm6QcMOKKk_i3ys4B6EoYyY-Ogd5E-_lnV3fs5iaM3sf8qvJD53KwpbO3OOA_-tQjw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuRiNvtduHxnc6QEy_RRjH3x_JlrhCWayUtrUN4uqa9w&oe=69B01D83"}, {"file_name": "Untitled.png", "id": "332917583088461", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035363_332917586421794_8831279654688852183_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJFTirGJeIcQ7kNvwG4hN00&_nc_oc=AdnIOJPA1n7ihoA9DI0JJP9DKaMlVSD5T3dGpBE06qdAf6oqr6vvfZiwuIDbLfJseFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2vJ7BaAew249YomnlgXT2yiz94kT-XqLek3C19N_E5w&oe=69B02667"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 59.png", "id": "1524970634865802", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984452_1524970638199135_826433915348957463_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upcVHYtZLzcQ7kNvwGVrg_w&_nc_oc=AdlGf87A9MCmu9sIE5dNFiR2fwdbWxBd3JbLl3_7WSMR0PDDhAjLnGGc4aYiq3b3NdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjlM_uGToM5AlAdyneFdDfuhso8vnyfGpNcSHHRMsJmw&oe=69B020CC"}, "display_name": "Brick Mania", "keywords": [], "long_description": "\n\n\ud83e\udd8d **BRICK MANIA: UNLEASH YOUR INNER BRICK \ud83e\udd8d**\n\nShrink down to action figure size and explore an exciting room as a brick. With no legs and a lot of personality, you\u2019ll run on your hands through various fun-filled activities.  \n\n\ud83e\udda0 **BUILT IN MODS** \ud83e\udda0\n\nExplore the COOLEST mods that are easy to get. Rockets, Fly, No Clip, Speed Hacks, X Ray, Teleport, Laptop, and much more!\n\n\ud83d\udcf8 **FREE CAMERA MOD: MOST ADVANCED CAMERA \ud83d\udcf8**\n\nOur built-in camera mod lets you switch between first-person, third-person, and other exciting perspectives to enhance your gameplay experience.\n\n\ud83c\udfe0 **GAME MODES\ud83c\udfe0**\n\nHave fun and talk with other bricks in our casual mode or show your inner brick and jump into an infection lobby. More game modes soon to come..\n\n\u2757\ufe0f\u2757\ufe0f**BIG UPDATES CONSTANTLY\u2757\ufe0f\u2757\ufe0f**\n\nWe do our best to get out updates every week or every other week to best support our community. We built what the community wants!\n\n\n\ud83c\udfc0 **SHOOT HOOPS LIKE NEVER BEFORE** \ud83c\udfc0 \n\nHit the basketball court for some epic trick shots. Whether you\u2019re a baller or just want hit some jumpers, the court is yours.\n\n\n\n\n\ud83d\udecd\ufe0f **EXPLORE THE MALL AND GET COSMETICS \ud83d\udecd\ufe0f**\n\nVisit our in-game mall and deck out your brick with an array of cosmetics. From funky outfits to stylish accessories, there\u2019s something for everyone.\n\n\ud83e\udd73 **JOIN THE BRICK MANIA NOW \ud83e\udd73**\n\nReady to experience life as a brick? Join the Brick Mania now and embark on a tiny, yet massive adventure. Play for free and let the fun begin! Join our Discord to get support or find people to play with: https://discord.gg/brickmania", "short_description": "Step into the shoes of a miniature, brick in a room-sized adventure.Run, Jump, Tag, Shoot hoops, Explore mods, take videos using in game camera mod, and customize your look at the in-game mall."}]}, "developer_name": null, "developer_privacy_policy_url": "htt
D4DjT59RSMgpu_azjp9iyMpMMS2GnziIBL98ZqayiWHdXuMjpQPOHLY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sdgoiUyU4yFU3GQWaoQb6M6V0wgAO4L0uC5yLGuPPSQ&oe=6A15AC62"}, {"file_name": "5.png", "id": "439398765677918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/43931331_439398769011251_6832019495182883720_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECEE8FeTKwgQ7kNvwGITKL3&_nc_oc=AdrVI0qerbdvAXpHUTewBojDUcSvN9bVTckOgCBxogyW2v3APh0OAQQEeTFzC2hGPhg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wsC8yZYuDsDitZpZF-Klpd-Pyjc3Ehqf4yCwkGdjpEw&oe=6A158ED9"}, {"file_name": "2.png", "id": "800507275395357", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974714_800507278728690_8370916924605575234_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzRtT-lMKmsQ7kNvwHtV441&_nc_oc=AdpCWQVVZa03QUrnD06FJ3wDJ4QH9FKDorwrrDq9ecoJVjBuwJYzjgl2hsOExjCNehA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c844nhnoMY6K8u7eh6dNSbamq5EDeOLyou80IZ_gIcg&oe=6A15A103"}, {"file_name": "Untitled.png", "id": "332917583088461", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035363_332917586421794_8831279654688852183_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gam8q2wTb-wQ7kNvwG9M2So&_nc_oc=AdoZ9GTL7ktb1ZRoh56Ky710Csr7Bs8aamqzUDcGaQ_vPczKqyQX5KFGKfFe5tFZHvU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RLKebC2a1jX4LFq9rYv2j-SUzpvM48PnFicjhSFpqzA&oe=6A15A9E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 59.png", "id": "1524970634865802", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984452_1524970638199135_826433915348957463_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlTcUoVg4e4Q7kNvwG49IwQ&_nc_oc=Adomi58T2HbzA3dyvc6wh4urr51pxNg221XbV1K_Vz0UMMiOQRDZUXaMOJX3uKpjgBE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xjKPrk-yeLAGso4KAP7PajXtb3An4dcX89I_FNL-8GQ&oe=6A15A44C"}, "display_name": "Brick Mania", "keywords": [], "long_description": "\n\n\ud83e\udd8d **BRICK MANIA: UNLEASH YOUR INNER BRICK \ud83e\udd8d**\n\nShrink down to action figure size and explore an exciting room as a brick. With no legs and a lot of personality, you\u2019ll run on your hands through various fun-filled activities.  \n\n\ud83e\udda0 **BUILT IN MODS** \ud83e\udda0\n\nExplore the COOLEST mods that are easy to get. Rockets, Fly, No Clip, Speed Hacks, X Ray, Teleport, Laptop, and much more!\n\n\ud83d\udcf8 **FREE CAMERA MOD: MOST ADVANCED CAMERA \ud83d\udcf8**\n\nOur built-in camera mod lets you switch between first-person, third-person, and other exciting perspectives to enhance your gameplay experience.\n\n\ud83c\udfe0 **GAME MODES\ud83c\udfe0**\n\nHave fun and talk with other bricks in our casual mode or show your inner brick and jump into an infection lobby. More game modes soon to come..\n\n\u2757\ufe0f\u2757\ufe0f**BIG UPDATES CONSTANTLY\u2757\ufe0f\u2757\ufe0f**\n\nWe do our best to get out updates every week or every other week to best support our community. We built what the community wants!\n\n\n\ud83c\udfc0 **SHOOT HOOPS LIKE NEVER BEFORE** \ud83c\udfc0 \n\nHit the basketball court for some epic trick shots. Whether you\u2019re a baller or just want hit some jumpers, the court is yours.\n\n\n\n\n\ud83d\udecd\ufe0f **EXPLORE THE MALL AND GET COSMETICS \ud83d\udecd\ufe0f**\n\nVisit our in-game mall and deck out your brick with an array of cosmetics. From funky outfits to stylish accessories, there\u2019s something for everyone.\n\n\ud83e\udd73 **JOIN THE BRICK MANIA NOW \ud83e\udd73**\n\nReady to experience life as a brick? Join the Brick Mania now and embark on a tiny, yet massive adventure. Play for free and let the fun begin! Join our Discord to get support or find people to play with: https://discord.gg/brickmania", "short_description": "Step into the shoes of a miniature, brick in a room-sized adventure.Run, Jump, Tag, Shoot hoops, Explore mods, take videos using in game camera mod, and customize your look at the in-game mall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gotmotion.gg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Got Motion", "support_website_url": null, "website_url": "https://gotmotion.gg/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7775382612575240"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8036482436465255", "version": " 0.1.22"}, "id": "448105074758644", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7775382595908575", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8036482436465255"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "448105074758644"}]}, "change_log": null, "created_date": 1724051197, "id": "8036482436465255", "version": " 0.1.22", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0},
00, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5744790372259386", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "23994744196837392"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "290150226215138"}]}, "change_log": "The new PCOVR (version 2.0.0) has the following new features and enhancements\n- New game Texas Hold\u2019EM\n- New game Roulette\n- Controller and gesture optimization\n- Bug fixing", "created_date": 1680276016, "id": "9046414595430264", "version": "2.0.0", "version_code": 200200, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
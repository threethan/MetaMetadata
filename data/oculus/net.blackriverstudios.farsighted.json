uscdn.com/v/t64.5771-25/11162679_1628880993852369_3701800387930488832_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPDg9-BlMGkQ7kNvwE3o0-0&_nc_oc=AdksFRuLoqfjYmdNbiQTjOcmZ7pfb7BLGLCnFkuPr6xLyOm0LPIa6wlqOrAiHbrSAuE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2P_sQ4OKoEDhs-vtt9NZTcZx6evgtsyNsrpJyR5wKGg&oe=69BFEE25"}, "display_name": "Angest", "keywords": ["Angest", "Adventure", "Narrative", "Soviet", "Space"], "long_description": "Immerse yourself as Valentina, a cosmonaut aboard a ship in the company of Konstantin, the AI that oversees and takes care of you while doing daily tasks for your mission. But as the days go by, your perception of reality can be affected. Will you embrace it? Break free? Or find an answer somewhere else?\n\nFrom the creators of Finding Monsters Adventure and Rock & Rails, ANGEST is a story-driven game where your actions can affect the narrative, making each experience unique. A surreal journey presented by Black River Studios to play in the Gear VR.", "short_description": "Immerse yourself as Valentina, a cosmonaut aboard a ship in the company of Konstantin, the AI that oversees and takes care of you while doing daily tasks for your mission. But as the days go by, your perception of reality can be affected. Will you embrace it? Break free? Or find an answer somewhere else?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null
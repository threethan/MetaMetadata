0a&_nc_ohc=vo_ePssHUpoQ7kNvwFKTGSO&_nc_oc=AdkdoCXVA8jJJwDIjm6UakrwNLGRcCmloDeics3ScMCiP3XJGFy8uOBCZXRrYDD5vI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvSouTrjYNrFTbA6WZtHx0i-eNJJPbQl3BOIUCaN1WFcg&oe=699DA725"}, "display_name": "Angest", "keywords": ["Angest", "Adventure", "Narrative", "Soviet", "Space"], "long_description": "Immerse yourself as Valentina, a cosmonaut aboard a ship in the company of Konstantin, the AI that oversees and takes care of you while doing daily tasks for your mission. But as the days go by, your perception of reality can be affected. Will you embrace it? Break free? Or find an answer somewhere else?\n\nFrom the creators of Finding Monsters Adventure and Rock & Rails, ANGEST is a story-driven game where your actions can affect the narrative, making each experience unique. A surreal journey presented by Black River Studios to play in the Gear VR.", "short_description": "Immerse yourself as Valentina, a cosmonaut aboard a ship in the company of Konstantin, the AI that oversees and takes care of you while doing daily tasks for your mission. But as the days go by, your perception of reality can be affected. Will you embrace it? Break free? Or find an answer somewhere else?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blackriverstudios.net/docs/privacy-policy.html", "developer_terms_of_service_url": "http://blackriverstudios.net/docs/privacy-policy.html", "publisher_name": "Black River Studios", "support_website_url": null, "website_url": "http://blackriverstudios.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
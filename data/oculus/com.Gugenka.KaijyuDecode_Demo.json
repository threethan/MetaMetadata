y3CM3HmZgc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0R61oaMG66UJZCsQNUAq9HLizhUKIu5ptx_mmwKIZfKA&oe=69EF4CCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KDMR_2560 x 1440.png", "id": "7265491160176826", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031447_7265491166843492_4027023738540594348_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jE_MHLfBD0Q7kNvwHN6sRV&_nc_oc=Adr-BE42cFcjwLZM05wRkf8izbop11BcvHccTh3el-n_qRn6hF8krxb-IWipNGtma8w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Zoy62ms8KWOIDi-dInMPKyZw-n6X_hfO1jymDNC9hLA&oe=69EF5590"}, "display_name": "KAIJU DECODE -super multiverse MR-", "keywords": ["KAIJU", "KAIJUDECODE", "Arcade", "Rhythm", "\u602a\u7363"], "long_description": "The super multiverse MR game of the original anime \u201cKAIJU DECODE\u201d by TSUBURAYA PRODUCTIONS x TOEI ANIMATION is now available!\n\nIn the game, due to The Singularity Point, Kaiju appear from another dimension into the real world. Players control The Guardian \"UKU\" in this arcade-style action game, battling \"The Transcendental Warriors\" to repair the universe, now known as The Transcendental World.\n\n\u3010How to Play\u3011\n\u30fbDefeat enemies appearing from each lane at the correct timing to defend your base.\n\u30fbAttacking at the right time leads to higher scores.\n\n\u3010Tips\u3011\n\u30fbThe game becomes more challenging as you progress through stages.\n\u30fbCharacters from TSUBURAYA PRODUCTIONS and TOEI ANIMATION feature in various stages.\n\u30fbCompete for scores with \"The Transcendental Warriors\" from around the world!\n\n\u3010Notes\u3011\n\u30fbSet up your play area before starting the game. Make sure the table and walls that form your playfield are ready.\n\n\u24b8TSUBURAYA PRODUCTIONS, TOEI ANIMATION", "short_description": "In the game, due to The Singularity Point, Kaiju appear from another dimension into the real world. Players control The Guardian \"UKU\" in this arcade-style action game, battling \"The Transcendental Warriors\" to repair the universe, now known as The Transcendental World."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gugenka.inc/kaijudecode/terms", "developer_terms_of_service_url": "https://gugenka.inc/kaijudecode/terms", "publisher_name": "Gugenka Inc.", "support_website_url": null, "website_url": "https://gugenka.inc/kaijudecode", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9398663266915957"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/65396729_2292638257592468_1711606700660349563_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGRfwVoOd1UQ7kNvwHY4M3M&_nc_oc=AdoJCuhssP-54-ureK6U_E6fzZ3ncONEYkGtUrRF6nO-QxwvhJyQdcLK27H_LJb5Iz4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oXiUM86iNAXMb7dLRXdmgaYcyZfijHAryCCtB7QB-Bw&oe=69EF7B1B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "KAIJU DECODE -super multiverse MR-", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Rhythm", "id": 
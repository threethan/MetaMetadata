ontent-iad3-2.oculuscdn.com/v/t64.5771-25/43997710_949733722990927_8943458896876512529_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qP-L9HbcN1gQ7kNvwH3l9cp&_nc_oc=AdpKHavKaqmXzfTOQogKuNmctcBOrc6C2aCiIq5HdI9DuOHzuT5nRGkpTaZdbEmNukQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQTkLMsk5z95hvEm7kryhLNziAWnC8hfKjE9JaFPskoA&oe=6B047A9D"}, {"file_name": "4.png", "id": "594443766237323", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982461_594443769570656_5387682328602488307_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoyeQyLSNKwQ7kNvwFwLMtO&_nc_oc=AdprO03-pG2zGeZRd0p1cI4wBLOu9PeHsDjHYHmgAY7oT4nwwwbxkFBkjsB5lY79L0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9XUyKlAxknWMCQhIyuIr5Zh7iAt_wSxwUHcZGCEZqgA&oe=6B045955"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2023-08-16-15h42m36s143.png", "id": "320692743730358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003263_320692747063691_3711652947288885943_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shxxEC2BzeoQ7kNvwEmymxe&_nc_oc=Adp81H2kdEcLpu_AWLI0q2R2JSJszTWCLcJ2p4JDp380hIkWBtlmrbw-rCoJjudVT-g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhhGwCmd4bHlRI8JriQa9aFyGNPPtPNTkwdyZlrFPVBw&oe=6B046265"}, "display_name": "VRflow C172S G1000", "keywords": [], "long_description": "- This is the individual/student version of VRflow -\n\nVRflow C172 G1000 is the interactive cockpit procedure trainer for pilots flying and training on the C172 with G1000 avionics. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for flight procedure training. Train with or without visual help, track your errors, see your training time, and much more.\n\n13 normal procedures and 11 emergency procedures are included with dynamic checklists and step by step explanations.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.\n\nThe individual/student version does not include multi-crew functionality.", "short_description": "- This is the individual/student version of VRflow - \n\nVRflow C172S G1000 is the interactive cockpit procedure trainer for pilots, used by flying schools and airlines worldwide. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their flight training.\n\nThe individual/student version does not include multi-crew functionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25938495999114624"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974531_949717356130516_6004264477683604602_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qX8w8VQ40rQQ7kNvwGbxFV-&_nc_oc=Adrj8
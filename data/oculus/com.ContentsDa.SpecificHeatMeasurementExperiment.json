VCHtliTQCrVc0aAa869iOo9BqZ7GjPg&oe=69B5564E"}, "display_name": "Specific Heat Measurement Experiment  - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "measurement", "science", "contentsda"], "long_description": "1. check the land and sea temperatures every hour and record them on a graph to compare the temperatures over time\n2. hold the thermometer, point it at the location you want to measure, and use the A and X buttons to measure the temperature.\n3. press the B button to make an hour go by\n4. watch the graph recorded on the whiteboard as time passes\n5. Notice how the temperature changes from day to night.\n6. It is now midnight. Check the temperatures on land and at sea\n7. record the temperature change over land and sea by 6:00 a.m.\n<Conclusion\n Sand is warmer during the day and water is warmer at night", "short_description": "Unravel the mysteries of heat capacity in different materials. The Specific Heat Measurement Experiment offers a practical approach to understanding how different substances absorb and retain heat, a fundamental concept in thermodynamics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pla
bPtAANx6eRELqv9jErU7t-4nq6Ti43Rk2iBTtRW-Nc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzuOqhT3awqhYFh3YqDTojr1Y1aJeCpm_MX1pvTpGnkJA&oe=69BBEF3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Specific Heat Measurement_Landscape.png", "id": "715623254039305", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031498_715623257372638_5898930354408331472_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIw2evaC7hMQ7kNvwHpNI2y&_nc_oc=AdknyXUz7Yu2tRT4GhqCeteSSDcS2DdjHGX2T7rp8-ECZ1Kfo0HwKMxvG7DuItOfZ68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTpJua1o8gguBf12o2BifcJOC7aS3UC7EHRaHswLrV_Q&oe=69BBEDCE"}, "display_name": "Specific Heat Measurement Experiment  - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "measurement", "science", "contentsda"], "long_description": "1. check the land and sea temperatures every hour and record them on a graph to compare the temperatures over time\n2. hold the thermometer, point it at the location you want to measure, and use the A and X buttons to measure the temperature.\n3. press the B button to make an hour go by\n4. watch the graph recorded on the whiteboard as time passes\n5. Notice how the temperature changes from day to night.\n6. It is now midnight. Check the temperatures on land and at sea\n7. record the temperature change over land and sea by 6:00 a.m.\n<Conclusion\n Sand is warmer during the day and water is warmer at night", "short_description": "Unravel the mysteries of heat capacity in different materials. The Specific Heat Measurement Experiment offers a practical approach to understanding how different substances absorb and retain heat, a fundamental concept in thermodynamics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_websit
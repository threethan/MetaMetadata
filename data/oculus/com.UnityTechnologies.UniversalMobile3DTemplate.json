 "screenshots": [{"file_name": "GuruLok_Mqdh11.png", "id": "882744360780379", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618472_882744364113712_7912391346646537723_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDUGtI2_j7QQ7kNvwGqk-Fl&_nc_oc=AdooX0KPOqCgJTQKw2FoSxL5ozOQl-Mz7syvIaRhrYguEwKgjgdPLT3wuv3TQOG3aFc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZHDMMZqLCrR-tYSfSn6AWVqCSCZekHDMyM1NNChJqJg&oe=69FA01E0"}, {"file_name": "GuruLok_Anisha.png", "id": "903399249009366", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618254_903399252342699_2052006410973078620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dU4eQeOh7iAQ7kNvwETPelD&_nc_oc=Adop1cjxdG6nAe2EaIc-lBHpiAEbnDDMNcVxhwHuZ0qom2wRMTtsZ38jSBgdwTMvAc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HVwTdr9JbUu9Q-IT1hDQ62D26A7wWvYw6LSdpYL6Hmg&oe=69F9F36B"}, {"file_name": "GuruLok_Shiva.png", "id": "1441690200646840", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831584_1441690203980173_1267375000905937595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbpQ9vFhRSkQ7kNvwFyb2E7&_nc_oc=AdrM-boimfTK3SmRf8Pfmk44IGEFqUa6HqaHUPb09uIVuvekrAuuJ9FVz7NeekcLcGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wmiTkcMRvq4vL5oQoPgmpoFYIBXS2mIpvV4Z0xWWBUg&oe=69FA0D15"}, {"file_name": "GuruLok_view.png", "id": "905859061881288", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618472_905859065214621_161018402558146391_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBdaYB44XzsQ7kNvwEjbqdA&_nc_oc=AdoT7v5G2_SNWkxRPKXeL1fLJgzKVWN1_Jdnx4ncaYPI7clO1jMo-76_q0kHlaB60D4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6evX0tTUKI8VjfilmxyYfnPzUyabs0wvJRP6wOM8Vb-Q&oe=69FA10C4"}, {"file_name": "GuruLok_view2.png", "id": "2362414527558959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619685_2362414530892292_9027505116081759542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h43pD628JX8Q7kNvwEGILgT&_nc_oc=AdpVJnOZtGcXPH9WFMBw9zQPrvaY-GMfC59JL3omR8NoZooar1xVT4SEdxNfHw7GOmE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46yBIlC2vC-Hnei5EH418lPAUyoYqIhGVf-tByek6u-g&oe=69F9F3B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GuruLok_landscape (2).png", "id": "1184751173860676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820983_1184751177194009_1762050554881295725_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmvq5uUJYPUQ7kNvwHH3HrC&_nc_oc=Ado8NHiGlsyY71C34Vr-TJl998Of5bdTt-CUPcdnNqc6r5Qes-i1HTgPqf87rF3p74Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D8emlbDMbNvc3yegA1zSh8ZzRPVJeUCXlcTE4ynWBxQ&oe=69FA134B"}, "display_name": "GuruLok: A Spiritual Multiverse", "keywords": ["meditation", "temple", "india", "spiritual", "multiplayer"], "long_description": "Experience spirituality like never before in \"GuruLok: A Spiritual Multiverse.\" Step inside a meticulously crafted ancient Indian temple complex \u2014 photorealistic detail, classical ragas, faithful Sanskrit pronunciation, and three traditional modes of practice in one immersive space.\n\n**Key Features in Update 2.0:**\n\n* **Kirtan** \u2014 Devotional celebration. Walk the temple grounds at your own pace while traditional kirtan music plays. Communal, exploratory, joyful.\n\n* **Satsang** \u2014 Spiritual inquiry. Sit with Guru Anisha and ask any question in your own voice. Receive authentic responses in the style of revered saints \u2014 Sant Kabir Das or Pujya Premanand Ji Maharaj \u2014 woven around real dohas and shlokas. Available in Hindi and English. (Requires Microphone)\n\n* *Inner Journey (NEW)** \u2014 Daily contemplative practice. Begin with Ram Japa: a guided breath-and-name meditation that opens at the riverbank at dawn and moves into the temple mandapa. The Shiva Lingam pulses gently with your breath. Perfect for a daily 10-minute practice.\n\n* **Multiplayer (NEW)** \u2014 Up to 4 practitioners share the temple together with spatial voice chat. Connect with family across continents in a shared sacred space.\n\n* **Authentic Indian classical music**, environmental ambience, and time-of-day lighting throughout.\n\nRequires Quest 2 or Quest 3. Internet required for multiplayer and Satsang. Microphone required for Satsang.", "short_description": "Step into a photorealistic ancient Indian temple for an authentic spiritual journey. Three traditional modes of practice rooted in real Hindu tradition: explore and chant in 3D Kirtan, sit face-to-face with a virtual Guru in voice-led Satsang, and complete daily Samadhi breath meditation by the river or at the temple altar. Now with Multiplayer \u2014 share the temple with up to 4 friends or family across continents with spatial voice chat. Available in English and Hindi."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.trigunai.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TrigunAI Innovations Pvt Ltd", "support_website_url": null, "website_url": "https://www.trigunai.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "35616728384578935"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618293_900641255737635_6214506223622098563_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_n
8_6O4qds9-09jmSQICdLsuos&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqCAREEQod7hdbrNGi3h9ipshEA9cZEaBdBcekBOvF5Q&oe=69AABE84"}, {"file_name": "GuruLok_view2.png", "id": "2362414527558959", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619685_2362414530892292_9027505116081759542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13VTddMsaP8Q7kNvwF00Vtq&_nc_oc=AdnWvT8iVQ8xxzpwbwB_oE4Bic4_aru3HE4VbIeK2ZuVIqySnL_Kc2-O6bwRy15y6Ak&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8j0eQZgrUPIzK1x7xW8l9ZKpSUj-4LY4WjP-49lRLwg&oe=69AAD9B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GuruLok_landscape (2).png", "id": "1184751173860676", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820983_1184751177194009_1762050554881295725_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfvMt6D9eo4Q7kNvwHP6WXB&_nc_oc=AdmnSK_Z3x32nJVJ6a8jHw_nZPMSTO1NvLJKBxUL2_8tNKgi4av-vd3LHRNFaVe6zZU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbzGhkQyBzdZD_x-ce3U4OVIFSR7Fs2liBUor8ybVm5A&oe=69AAC10B"}, "display_name": "GuruLok: A Spiritual Multiverse", "keywords": ["meditation", "temple", "india", "spiritual", "kirtan"], "long_description": "Experience spirituality like never before in \"GuruLok: A Spiritual Multiverse.\" This Early Access application invites you to step inside a meticulously 3D-scanned Indian Temple, brought to life with photorealistic detail and immersive audio.\n**Key Features in Update 1.2:**\n*   **Interactive Satsang (NEW):** Meet Guru Anisha and Suresh, a digital spiritual guide. Use your voice to ask questions and receive wisdom in a face-to-face virtual setting. (Requires Microphone permissions).\n*   **Immersive Kirtan:** Experience a 3D spatialized musical meditation session.\n*   **Virtual Darshan:** Walk freely through sacred temple courtyards and ancient architecture.\n*   **Snap-Turn Locomotion:** Designed for comfort in both standing and room-scale modes.\nJoin us 
8cy3Zwgd8uacmB4EvCr-_i2WxaG7s1XqAruv6gD682h8DnDFkrk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oWEvQdwWN4svwKE-v83DmjVExL3l-qfEHgVCg4_kSfA&oe=69E0CC04"}, {"file_name": "GuruLok_view2.png", "id": "2362414527558959", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619685_2362414530892292_9027505116081759542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9kC0Smlhx4Q7kNvwF3sE3r&_nc_oc=Ado5sk_w8c1kx0QxX4_qwV6QAVCohwX6erLd1ujR8Ufh4dfkcqjX7RNO-1-YGEYqQZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uinAB1B1HeZtMETtGZk-QmlRf02xAKyP-Idm93o73iw&oe=69E0E735"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GuruLok_landscape (2).png", "id": "1184751173860676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820983_1184751177194009_1762050554881295725_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaqL1eP0BZcQ7kNvwGQgxki&_nc_oc=AdqwIYHirWggpbvQcYJW74s5uokGB_Wq49smm_qFtdx4-ZM33RwJgOsqZvTX_kvX0OU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZUC4otyQURyP1gOpaHMouJAgLU5wOM0AeKieWMwCz5Q&oe=69E0CE8B"}, "display_name": "GuruLok: A Spiritual Multiverse", "keywords": ["meditation", "temple", "india", "spiritual", "kirtan"], "long_description": "Experience spirituality like never before in \"GuruLok: A Spiritual Multiverse.\" This Early Access application invites you to step inside a meticulously 3D-scanned Indian Temple, brought to life with photorealistic detail and immersive audio.\n**Key Features in Update 1.2:**\n*   **Interactive Satsang (NEW):** Meet Guru Anisha and Suresh, a digital spiritual guide. Use your voice to ask questions and receive wisdom in a face-to-face virtual setting. (Requires Microphone permissions).\n*   **Immersive Kirtan:** Experience a 3D spatialized musical meditation session.\n*   **Virtual Darshan:** Walk freely through sacred temple courtyards and ancient architecture.\n*   **Snap-Turn Locomotion:** Designed for comfort in both standing and room-scale modes.\nJoin us in this growing multiverse of peace and mindfulness.", "short_description": "Step into a photorealistic ancient Indian temple for a spiritual journey. Experience immersive 3D Kirtan, explore the sacred grounds, and engage in an interactive voice-guided Satsang with a virtual Guru."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.trigunai.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TrigunAI Innovations Pvt Ltd", "support_website_url": null, "website_url": "https://www.trigunai.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33733549762896816"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618293_900641255737635_6214506223622098563_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oldbHj8xPEQ7kNvwFh1KhV&_nc_oc=AdoT10vZgFxZYdMXh9L38u1R7ao_eQobpHQDBg3LKd11Z1PajYVcXW9luIZeAZXyDAo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ls33A1gk-hJvTsIF-Wf9DaQH-jiGLVFZql9M8iKMPwA&oe=69E0D761"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GuruLok: A Spiritual Multiverse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Explora
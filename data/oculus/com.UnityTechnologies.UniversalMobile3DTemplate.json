dpEr1VlyAJkduLD-IwQP-Cs5ZXT6qlsKmVptldo8QfAhKgmuYroBSO2nNW4KjksiyU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESqZaKd_MUhw9FCMdVEcv2ZAu9zYOmUsNy2j1NtAh8nw&oe=6A90260B"}, "display_name": "GuruLok: A Spiritual Multiverse", "keywords": ["meditation", "temple", "india", "spiritual", "kirtan"], "long_description": "Experience spirituality like never before in \"GuruLok: A Spiritual Multiverse.\" This Early Access application invites you to step inside a meticulously 3D-scanned Indian Temple, brought to life with photorealistic detail and immersive audio.\n**Key Features in Update 1.2:**\n*   **Interactive Satsang (NEW):** Meet Guru Anisha and Suresh, a digital spiritual guide. Use your voice to ask questions and receive wisdom in a face-to-face virtual setting. (Requires Microphone permissions).\n*   **Immersive Kirtan:** Experience a 3D spatialized musical meditation session.\n*   **Virtual Darshan:** Walk freely through sacred temple courtyards and ancient architecture.\n*   **Snap-Turn Locomotion:** Designed for comfort in both standing and room-scale modes.\nJoin us in this growing multiverse of peace and mindfulness.", "short_description": "Step into a photorealistic ancient Indian temple for a spiritual journey. Experience immersive 3D Kirtan, explore the sacred grounds, and engage in an interactive voice-guided Satsang with a virtual Guru."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.trigunai.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TrigunAI Innovations Pvt Ltd", "support_website_url": null, "website_url": "https://www.trigunai.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33733549762896816"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "745113944699596"}]}, "baseline_offer": {"id": "745113944699596"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768578360, "status": "PUBLISHED", "id": "745113944699596"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35820055667579538", "version": "1.4.1"}, "id": "1142403860893479", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32526571810261290", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35820055667579538"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1142403860893479"}]}, "change_log": "Build 727: continued LOD optimizations using Meta Link Play Mode workflow. Builds on Build 726 baseline. Same workflow as 726: connect Quest via Meta Link, hit Play in Editor (Game view renders through actual VR camera), wear headset to walk structures and observe LOD swap distances at true Quest FOV, take headset off and adjust LODGroup Transition % in Inspector while still in Play Mode, put headset back on for live confirmation. Persistence step before exiting Play Mode: right-click LODGroup component header > Copy Component, then exit Play Mode, re-select scene instance, right-click LODGroup > Paste Component Values, save scene. All overrides applied as per-instance scene edits (not prefab edits) to preserve aggressive 0.05 cull baseline elsewhere. Asset bundle ancienttempleenv unchanged (prefabs untouched throughout) - only scene_group_scenes bundle hash changed (06f22a77 to f24cb1db) reflecting the new per-instance LODGroup tuning iteration. Untouched from Build 726: render scale 0.9; URP m_EnableLODCrossFade flag still 1 but harmless since all LODGroups are FadeMode None; Build 715 lighting (Day GI no-shadow re-bake at 30 texels/unit); MainMenu Directional intensity 0.7 + No Shadows; Shiv Lingam realtime light deleted; Build 696 character lighting via Characters rendering layer; Build 597 voice chat + lip sync. XR Plug-in Management Android tab unchanged (Oculus loader, Multiview, Quest 3 target). Quest 3 test plan: 1) install fresh from BETA channel; 2) walk full map with focus on the per-instance bumps applied this iteration; 3) confirm LOD swap distances feel correct in headset; 4) identify any remaining structures with visible pop during locomotion; 5) iterate via same Meta Link workflow if needed.", "created_date": 1778073193, "id": "35820055667579538", "version": "1.4.1", "version_code": 727, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32526571810261290", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35820055667579538"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1777995876, "id": "35800473959537709", "version": "1.4.1", "version_code": 726, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBina
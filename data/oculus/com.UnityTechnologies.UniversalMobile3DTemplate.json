b150fqTl59MQ7kNvwFew2Gc&_nc_oc=AdoKruOiffVgm66JmAoN-ICxiwogBxSnCQ5VAy3vfECRT3tdPOCCXlr2-GGDjGxYwio&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUYI2FczKxrrdPEdIaMIjowHgFOlILw3sdD0eGwIQK5Q&oe=6A903EB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GuruLok_landscape (2).png", "id": "1184751173860676", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820983_1184751177194009_1762050554881295725_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKsZAMq4TGgQ7kNvwEVtj6Q&_nc_oc=AdpEr1VlyAJkduLD-IwQP-Cs5ZXT6qlsKmVptldo8QfAhKgmuYroBSO2nNW4KjksiyU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESqZaKd_MUhw9FCMdVEcv2ZAu9zYOmUsNy2j1NtAh8nw&oe=6A90260B"}, "display_name": "GuruLok: A Spiritual Multiverse", "keywords": ["meditation", "temple", "india", "spiritual", "multiplayer"], "long_description": "Experience spirituality like never before in \"GuruLok: A Spiritual Multiverse.\" Step inside a meticulously crafted ancient Indian temple complex \u2014 photorealistic detail, classical ragas, faithful Sanskrit pronunciation, and three traditional modes of practice in one immersive space.\n\n**Key Features in Update 2.0:**\n\n* **Kirtan** \u2014 Devotional celebration. Walk the temple grounds at your own pace while traditional kirtan music plays. Communal, exploratory, joyful.\n\n* **Satsang** \u2014 Spiritual inquiry. Sit with Guru Anisha and ask any question in your own voice. Receive authentic responses in the style of revered saints \u2014 Sant Kabir Das or Pujya Premanand Ji Maharaj \u2014 woven around real dohas and shlokas. Available in Hindi and English. (Requires Microphone)\n\n* *Inner Journey (NEW)** \u2014 Daily contemplative practice. Begin with Ram Japa: a guided breath-and-name meditation that opens at the riverbank at dawn and moves into the temple mandapa. The Shiva Lingam pulses gently with your breath. Perfect for a daily 10-minute practice.\n\n* **Multiplayer (NEW)** \u2014 Up to 4 practitioners share the temple together with spatial voice chat. Connect with family across continents in a shared sacred space.\n\n* **Authentic Indian classical music**, environmental ambience, and time-of-day lighting throughout.\n\nRequires Quest 2 or Quest 3. Internet required for multiplayer and Satsang. Microphone required for Satsang.", "short_description": "Step into a photorealistic ancient Indian temple for an authentic spiritual journey. Three traditional modes of practice rooted in real Hindu tradition: explore and chant in 3D Kirtan, sit face-to-face with a virtual Guru in voice-led Satsang, and complete daily Samadhi breath meditation by the river or at the temple altar. Now with Multiplayer \u2014 share the temple with up to 4 friends or family across continents with spatial voice chat. Available in English and Hindi."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.trigunai.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TrigunAI Innovations Pvt Ltd", "support_website_url": null, "website_url": "https://www.trigunai.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "35616728384578935"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618293_900641255737635_6214506223622098563_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_n
ient Indian temple for a spiritual journey. Experience immersive 3D Kirtan, explore the sacred grounds, and engage in an interactive voice-guided Satsang with a virtual Guru."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.trigunai.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TrigunAI Innovations Pvt Ltd", "support_website_url": null, "website_url": "https://www.trigunai.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33733549762896816"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618293_900641255737635_6214506223622098563_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1n0QjqJOsIQ7kNvwE68JS7&_nc_oc=AdmFoW33nI3rom27x6pWXZ26LGEMBWQUHbqjJvZL-_uReWg7aHV4viFPTfp1R41q-eg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvqaESI1y1IlMPVTm9XHEb8Bg78Kgd_JB-5vLSfaMhspg&oe=699C4961"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GuruLok: A Spiritual Multiverse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1768578360, "lastRevision": {"nodes": [{"id": "32526571896927948", "release_type": "SCHEDULED", "administr
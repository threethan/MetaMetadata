000905937595_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDS08TeB1ZgQ7kNvwFFKHXD&_nc_oc=AdrDoh7K2FU5-IOg0ZmD5I-jA9SNqUhYg-KqrRL6cJWhUdaXoAVIFqxyEwmBke24eog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iCqKJpIqSVPU0L5XaJsnHliEhI9k3aBprpw_N4elYlA&oe=69ECA5D5"}, {"file_name": "GuruLok_view.png", "id": "905859061881288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618472_905859065214621_161018402558146391_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNujdjEgSA8Q7kNvwF7-VAV&_nc_oc=Adqq6pYja8i01bN4aN99njKILpsHc8OIPZ6DyYinBmG7lS7UPp-FmZco_84U-v_V_Ro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cSTB_mwPTvdY7Y3SDjKzoembZrqaDMoxA5pRaxnaz7g&oe=69ECA984"}, {"file_name": "GuruLok_view2.png", "id": "2362414527558959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619685_2362414530892292_9027505116081759542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eEvOU9OpaEQ7kNvwH9Z25n&_nc_oc=AdrAtQwBhF05UXbXOssVwWyUMhAWA-Ryg0tjWDlBbw5N52v-vaQ-5J-Xcy5sMXuoDfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CdyRUA-_5sS5foRdpb7aRYzukGf0hjrsKfoag6a1WIA&oe=69ECC4B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GuruLok_landscape (2).png", "id": "1184751173860676", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820983_1184751177194009_1762050554881295725_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0m9PCAL2eEQ7kNvwFnONL-&_nc_oc=AdpqEJ2QNazilkTt4YiOD4Ibz1HRwCPAvfj2MRWBSooWdW2MiBUv7cTerL72edQUmQA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a5jP7Ive_DC2pq_wcv_YgnhWdJ5C3KDa1MEuXwKda8g&oe=69ECAC0B"}, "display_name": "GuruLok: A Spiritual Multiverse", "keywords": ["meditation", "temple", "india", "spiritual", "kirtan"], "long_description": "Experience spirituality like never before in \"GuruLok: A Spiritual Multiverse.\" This Early Access application invites you to step inside a meticulously 3D-scanned Indian Temple, brought to life with photorealistic detail and immersive audio.\n**Key Features in Update 1.2:**\n*   **Interactive Satsang (NEW):** Meet Guru Anisha and Suresh, a digital spiritual guide. Use your voice to ask questions and receive wisdom in a face-to-face virtual setting. (Requires Microphone permissions).\n*   **Immersive Kirtan:** Experience a 3D spatialized musical meditation session.\n*   **Virtual Darshan:** Walk freely through sacred temple courtyards and ancient architecture.\n*   **Snap-Turn Locomotion:** Designed for comfort in both standing and room-scale modes.\nJoin us in this growing multiverse of peace and mindfulness.", "short_description": "Step into a photorealistic ancient Indian temple for a spiritual journey. Experience immersive 3D Kirtan, explore the sacred grounds, and engage in an interactive voice-guided Satsang with a virtual Guru."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.trigunai.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TrigunAI Innovations Pvt Ltd", "support_website_url": null, "website_url": "https://www.trigunai.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33733549762896816"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "745113944699596"}]}, "baseline_offer": {"id": "745113944699596"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768578360, "status": "PUBLISHED", "id": "745113944699596"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35446604301591345", "version": "1.4.1"}, "id": "1142403860893479", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32526571810261290", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35446604301591345"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1142403860893479"}]}, "change_log": "# GuruLok v1.4.1 \u2014 Release Notes\n\n## The biggest update since launch \u2728\n\nGuruLok has been completely transformed since v1.3.1. The temple is now a living, shared spiritual space you can experience with friends and family from anywhere in the world.\n\n---\n\n## \ud83c\udfb5 Multiplayer Kirtan (new)\n\n**Sing bhajans together, from anywhere in the world.**\n\n- Up to **4 players** can join the same Kirtan session\n- The music plays in perfect sync \u2014 everyone hears the same beat, in the same moment\n- **Voice chat** with 3D spatial audio \u2014 hear fellow devotees as if they were standing next to you\n- **Real-time lip sync** on remote avatars, powered by Meta Avatars\n- Seamless late-join \u2014 step into an active session anytime\n\n## \ud83d\ude4f Improved Satsang\n\n**Ask the guru anything \u2014 now faster and more stable.**\n\n- **3\u00d7 faster responses** \u2014 streamlined audio delivery\n- Pipeline hardened \u2014 the guru continues gracefully even if a question fails\n- Input returns to listening mode the instant the guru finishes speaking\n\n## \ud83c\udf05 Environment System (new)\n\n**Transform the sky with a single button press.**\n\nPress **Y** on your left controller anytime to open the environment panel and choose from 10 beautifully crafted presets:\n\n- \u2600\ufe0f Day, \ud83c\udf07 Sunset, \ud83c\udf04 Dawn, \ud83c\udf06 Dusk\n- \ud83c\udf19 Moonlit Night, \ud83c\udf11 Dark Night\n- \ud83c\udf0c Northern Lights, \ud83d\udc9c Aurora Purple\n- \ud83e\ude90 Space, \u2601\ufe0f Overcast\n\nTransitions fade smoothly over 2.5 seconds. Skybox, lighting, ambient tone, and atmosphere all shift together.\n\n**In multiplayer**, any player can change the environment \u2014 everyone sees the same sky, lighting, and creatures in real-time. Players who join late automatically sync to the current environment.\n\n## \ud83e\udd8b Living Temple (new)\n\n**The temple now breathes.**\n\n- **Butterflies** flutter through daytime environments \u2014 colorful species drifting among the pillars\n- **Peacocks** wander the grounds, breathing, eating, walking, and occasionally displaying their magnificent tail feathers\n- **Fireflies** emerge at dusk and glow softly throughout the night\n- All creatures appear in the same position for every player \u2014 you and your friend will see the same butterfly at the same moment\n\n## \u2728 Polished Experience\n\n**Every interaction refined.**\n\n- **Contextual controller rays** \u2014 hidden during immersive Kirtan and Satsang, automatically shown when menus open (B or Y)\n- **Laser that knows when to stop** \u2014 rays end exactly at buttons, not past them\n- **One-time welcome tooltip** \u2014 a gentle 3-second hint introduces the Y shortcut\n- **Click-through prevention** when multiple panels are stacked\n- Smoother avatar tracking\n- Subtle comfort vignette during movement\n\n## \ud83d\udee0 Under the Hood\n\n- Avatar tracking and animation stability improvements\n- Memory management for extended sessions\n- Cleaner production logs (no dev-diagnostics in release)\n- Multiple multiplayer stability fixes\n- Optimized asset streaming via Addressables\n\n---\n\n## \ud83d\ude4f Thank you\n\nIf GuruLok brings you a moment of peace, please share it with someone you love. Every fellow devotee makes the sangat stronger.\n\n**Om Namah Shivaya** \ud83d\udd49\ufe0f\n", "created_date": 1776587545, "id": "35446604301591345", "version": "1.4.1", "version_code": 640, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 10}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32526571810261290", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35446604301591345"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1776578153, "id": "35444757208442721", "version": "1.4.0", "version_code": 637, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 10}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32526571810261290", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35446604301591345"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1776572865, "id": "35443754125209696", "version": "1.4.0", "version_code": 636, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 10}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "32526571810261290", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBina
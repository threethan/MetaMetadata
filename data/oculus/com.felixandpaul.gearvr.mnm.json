HJCQ_G_IPYGZ7Qyg&oe=6B047DEF"}, {"file_name": "migrated_image.png", "id": "638892110229704", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974678_743271359388486_8359024789251162112_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHr5UU7Z5NsQ7kNvwEEuquq&_nc_oc=Adpj5NvClMpzM3HSpqjyxQaTvlg2jkpmhwBLN9hdTyqRblqds_sMK9WqzhcyG0p18VY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFbRgq2IgDva10io8E9ehW7UGzn2Pu3sG9HgC-97QDcg&oe=6B04531E"}, {"file_name": "migrated_image.png", "id": "500203477316600", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974708_317856575534629_3633437307580710912_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5qPwv_nKQQQ7kNvwGGGY36&_nc_oc=AdqKh5B2Go5PNy5ubKcp93hl8DkVt75nOYlVySsA5yS_G-K9e7syZagJjWQSSnMmGmA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD_pbI2uhvjxQDN852wal0ipkdawqCLTdeOG8A_v1qWQ&oe=6B04877C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/IiQnJg", "id": "2129494757144720", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974745_2129494760478053_4652084631137419264_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHYPM-7mTYUQ7kNvwGrQCDc&_nc_oc=AdrxNNJovKqO0lnkjV9uuPDv-NFUpDUYTtjmhrmSw8r1bPOCFuDBvXdQxQT6OnR8aps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1NBxN4LQN4LOiFXFbnKK6RulZFqLwk5bi8JgVjd45HQ&oe=6B047AD9"}, "display_name": "Marshall From Detroit", "keywords": ["Felix", "Eminem", "Marshall", "Detroit", "Music"], "long_description": "Growing up, Marshall Mathers dreamed of rapping his way out of Detroit. Years and fortunes later, he still hasn\u2019t left. Now in this intimate VR experience, take a surreal ride on a cold winter night with Sway Calloway and Eminem himself. Witness Detroit as never before as the two old friends swap stories, discuss dreams and keep it 100. Detroit is a land of historic paradoxes: a cornerstone of commerce, a post-industrial nightmare, a bastion of music, a cautionary tale. But to many it remains a symbol of strength, grit and reincarnation. With a front row seat down memory lane, this lyrical experience offers an unprecedented glimpse into its eponymous titans. Marshall From Detroit is an atmospheric study of a legend, his hometown, and how a place can shape you.", "short_description": "Growing up, Marshall Mathers dreamed of rapping his way out of Detroit. Years and fortunes later, he still hasn\u2019t left. Now in this intimate VR experience, take a surreal ride on a cold winter night with Sway Calloway and Eminem himself. Witness Detroit as never before as the two old friends swap stories, discuss dreams and keep it 100. Marshall From Detroit is a lyrical and atmospheric study of a legend, his hometown, and how a place can shape you."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "NARRATIVE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6853522511404428"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974625_376913676217781_7286347661874036736_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc
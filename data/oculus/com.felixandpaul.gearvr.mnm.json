kNvwFqRyFw&_nc_oc=AdrpyUqvq_AQTk6QQj7VDPHWmtInKl9StcYtS-YZ3w2bcjWK_O8KzWMxUqE0TFnUiv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LsnTQoC1eQGKJvyriWTeKhNv2JfCekSxC3J20Hx1HaQ&oe=6A297A1E"}, {"file_name": "migrated_image.png", "id": "500203477316600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974708_317856575534629_3633437307580710912_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8eo51KmM2QQ7kNvwE5tR8x&_nc_oc=AdpEn170f2vLg1w_KCfNvTnBvjj02aiFkR4ZK1NDodzacYTWaxa0nEP_A4StcigwBn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yfxKPMyRK1QI0tmlHBN6LvzOzbmwFfzfmf9aJKpQGWQ&oe=6A29763C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/IiQnJg", "id": "2129494757144720", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974745_2129494760478053_4652084631137419264_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOWX7CxEdtkQ7kNvwE6XoUA&_nc_oc=AdpnSR5A4OsMn_P0HwSfL7FPWvOQfkcKTiRaLAa3fXryH8P7TvlcrJdJUnUr3yQKL38&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s0afObvxDN02eYFcfrkQCiWLXlg5Ipmp0szD-VRPl7A&oe=6A296999"}, "display_name": "Marshall From Detroit", "keywords": ["Felix", "Eminem", "Marshall", "Detroit", "Music"], "long_description": "Growing up, Marshall Mathers dreamed of rapping his way out of Detroit. Years and fortunes later, he still hasn\u2019t left. Now in this intimate VR experience, take a surreal ride on a cold winter night with Sway Calloway and Eminem himself. Witness Detroit as never before as the two old friends swap stories, discuss dreams and keep it 100. Detroit is a land of historic paradoxes: a cornerstone of commerce, a post-industrial nightmare, a bastion of music, a cautionary tale. But to many it remains a symbol of strength, grit and reincarnation. With a front row seat down memory lane, this lyrical experience offers an unprecedented glimpse into its eponymous titans. Marshall From Detroit is an atmospheric study of a legend, his hometown, and how a place can shape you.", "short_description": "Growing up, Marshall Mathers dreamed of rapping his way out of Detroit. Years and fortunes later, he still hasn\u2019t left. Now in this intimate VR experience, take a surreal ride on a cold winter night with Sway Calloway and Eminem himself. Witness Detroit as never before as the two old friends swap stories, discuss dreams and keep it 100. Marshall From Detroit is a lyrical and atmospheric study of a legend, his hometown, and how a place can shape you."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "NARRATIVE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6853522511404428"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974625_376913676217781_7286347661874036736_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZW4ndHL9JoQ7kNvwGpccPm&_nc_oc=AdrctpcsMtGIisC-3t5T9_NSPi59lAS5dVez-tbwYvAjgJpi0IesLN8Ciz7tNoBtzts&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h15aK0dZxcL-6gRe1Q-JVAAW82f-MN7fE0r6xSd7eDw&oe=6A2958E2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marshall From Detroit", "platfo
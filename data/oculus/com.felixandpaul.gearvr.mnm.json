kNvwFRd__V&_nc_oc=Adr6VuQZKRwSgno4dtLo0ZikOXZvlnM4jF98J7ofMKQUUb5u46YYnvKZkTHcDFpac40&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lo3zSJimlKPVeDNr_gZGyHcNjyI3bO5fergRuA5zoIA&oe=6A19A81E"}, {"file_name": "migrated_image.png", "id": "500203477316600", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974708_317856575534629_3633437307580710912_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcO542yWyysQ7kNvwHS98If&_nc_oc=AdrcW_yHfq8ixHlWz9AU26WqCzmRkgr6svSHpvdh4dytzU2V2jrCtoUMpnCRoSs_VuE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43bKksedFw2JEtnEETHxccxM9hvcpctfx1lC3WpzpMiQ&oe=6A19A43C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/IiQnJg", "id": "2129494757144720", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974745_2129494760478053_4652084631137419264_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sd6y48ja85wQ7kNvwFyvCBj&_nc_oc=AdoNnCRdlbE8RPy1lnfLr1g0x-5odjBcx_t0Q4XF-nZjyizec9dBmTyLHr-BREZY7ss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nIWwDQTaHgIqn8TbTxvUu8a_R1sfiAOhmz4NWIoBjCg&oe=6A199799"}, "display_name": "Marshall From Detroit", "keywords": ["Felix", "Eminem", "Marshall", "Detroit", "Music"], "long_description": "Growing up, Marshall Mathers dreamed of rapping his way out of Detroit. Years and fortunes later, he still hasn\u2019t left. Now in this intimate VR experience, take a surreal ride on a cold winter night with Sway Calloway and Eminem himself. Witness Detroit as never before as the two old friends swap stories, discuss dreams and keep it 100. Detroit is a land of historic paradoxes: a cornerstone of commerce, a post-industrial nightmare, a bastion of music, a cautionary tale. But to many it remains a symbol of strength, grit and reincarnation. With a front row seat down memory lane, this lyrical experience offers an unprecedented glimpse into its eponymous titans. Marshall From Detroit is an atmospheric study of a legend, his hometown, and how a place can shape you.", "short_description": "Growing up, Marshall Mathers dreamed of rapping his way out of Detroit. Years and fortunes later, he still hasn\u2019t left. Now in this intimate VR experience, take a surreal ride on a cold winter night with Sway Calloway and Eminem himself. Witness Detroit as never before as the two old friends swap stories, discuss dreams and keep it 100. Marshall From Detroit is a lyrical and atmospheric study of a legend, his hometown, and how a place can shape you."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "NARRATIVE", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6853522511404428"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974625_376913676217781_7286347661874036736_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPWiMexsnAsQ7kNvwHHPoEw&_nc_oc=AdomQexeeKbOt9fnYIA2FAajdl3Mzxi87FEeDZeTait-rMSmIknCVDyK0ljpI6VTdJc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L1Gs78O3BCQ0PyvP5fcA-95R5t-9sc67EHc4TA9UagA&oe=6A19BF22"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Marshall From Detroit", "platfo
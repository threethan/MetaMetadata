646_5967608817086415607_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbSbyMEjtR4Q7kNvwELU0OH&_nc_oc=AdosydOsIs12tu26mUJkneB_PnIkoY_ge7mY068XBkDKq-Mu7j25pGKiMC42zeK2D1A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMXtFV1J2murU5h1_P2Jhp5ZevD19IVHP5Qj_huZHcWg&oe=6A8D6D7D"}, "display_name": "Phenomena Lobby", "keywords": [], "long_description": "\"Our platform provides a cutting-edge free-roam virtual reality gaming and operation solution for LBE venues looking to enhance their experience offering and grow their business. With an extensive library of exclusive games, our software solution enables FECs and arcades to seamlessly integrate our VR eSport attractions into their existing location. This cost-effective and flexible option is ideal for customers seeking to elevate their entertainment offerings while maintaining control over their hardware choices.\"", "short_description": "The base Lobby / \"Arena Grid\" for Phenomena VR eSports guests.  Required for arcade functionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vresportarena.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Phenomena", "support_website_url": null, "website_url": "https://www.vresportarena.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "9079423645482429"}, "review_messages": []}]}, "c
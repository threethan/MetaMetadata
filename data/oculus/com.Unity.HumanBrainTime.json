W9I2YhQew-QjH3usLgtJdCKE5SG3Qm1c1Hw&oe=6B01BE09"}, {"file_name": "screenshot5.png", "id": "399916539442236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982574_399916542775569_8496828432910334725_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcZFmI0TXaUQ7kNvwG6Vf4x&_nc_oc=AdrH9BnOypXpOYpsXPay8n-qWVE8XLG0JvdgFWvbhMxpS0vnjg-ZHIDICp5Rd78C5QA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIfL6XjgWDSJZjh7_i-7odW6S48MH6MBMQbxg8Jd2eKg&oe=6B01ED16"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Human Brain Time", "keywords": [], "long_description": "The Human Brain Time app is an interactive and informative way to learn about the human brain. It works great as a study tool for students! Play with the model and see the different regions of the brain. See how they are positioned in relation to other brain structures. Break apart the brain and try to put it back together! Quiz yourself and play the Brain Structure Position Game.", "short_description": "Experience the human brain in an interactive and interesting way. Grab a piece of the brain, look at it all angles, see detailed areas highlighted and labeled, throw it around the room, or leave it hovering in place for reference later!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/61cc6cfe-5e89-4e80-9e37-1718e1b47c0b", "developer_terms_of_service_url": null, "publisher_name": "HAE Studios", "support_website_url": null, "website_url": "https://virtualrealityforeducation.com/human-brain-time/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
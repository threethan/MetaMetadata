82492_636944081850276_2378128627661877297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QhxY6rWf5YQ7kNvwFw77Vu&_nc_oc=AdkzHEPTEkgZoSvB_EP084_4Oj4EOEbRB5AxCpU6J50CoNco22B2DO43niAzHzE-ns0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfspsA4fDPx1rXubBGYq5fhcsTP1Dug52rqKfsqJfvpU0g&oe=699DA9C0"}, {"file_name": "meta adjusted4.png", "id": "667660598814625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRVeBC07nNUQ7kNvwEXB2kS&_nc_oc=AdkBHJb5Sp_VEfvydrMfFahPqKEBSl5hFga5pMwf5q2S-UWyMk1wBQcOP7D0_gW5G7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afta5wsLsIYZmGQeMuPgkejbV0LwSrCjDOk08bjVpBKMtQ&oe=699D8EDB"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0N7k3yIG6oQ7kNvwEoTlr3&_nc_oc=AdnZHxz20LSs-sNqP-6haq5OdSzIUVoVTauZW-4QKpO2AyJrHHPjLPrptkZeb73KqPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuknirtpJPIbLp7cJLVcL87voPU89bunYCxWrZkOCskBw&oe=699DA724"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighQ Edited2(1).png", "id": "375150995413131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_375150998746464_5132883893584051015_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMsKkE2iZAUQ7kNvwEGy7iI&_nc_oc=AdnuxYUlAN7pindTvQiYLZpHPoKXXrteaOe7VlkDTBOBQNOvz8MNLoh9zHpRSY2n68Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsxcOk7TuSJ1nxkvd1kMwS9xS7ZGBkjBRv-c1irpB6cSw&oe=699DB78F"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "An Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nHorrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8936186246462220"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974817_719006560083276_1128898082731884764_n.png?stp=dst-png_s360
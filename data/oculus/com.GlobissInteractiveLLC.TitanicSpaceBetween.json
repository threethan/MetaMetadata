82492_636944081850276_2378128627661877297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nB4DnG5VJcQ7kNvwFAyHjL&_nc_oc=AdmIWEuFHGiaK3Jj_6VbEnZvef8z0rkoD7UaADWy1YsOByKTT5NaAWoR9kWENuqv-pA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvJ4fDGEzwe3-v42vMW6EeuAROqQ3hiM_tMFB_rZk13Mg&oe=69A592C0"}, {"file_name": "meta adjusted4.png", "id": "667660598814625", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFlKn7nG5LMQ7kNvwEjT1RG&_nc_oc=AdmXYPTLubUR0PILoa30nPuMPAIyu9zP5kXiVRhS_FsUxdefrdnWIt1X9MQD44gVuBI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afur_vktboVrCueM4WbQzz8xIXvBENU2OBTTk4YKDsx4ow&oe=69A577DB"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C17oeuXQm8gQ7kNvwHFRey5&_nc_oc=AdkzMRrz3GYHiNQmhTyjbZDpVqUiZEj12co3ArVXTNHgM3D3BPy9BBe9tOOTSn8FObQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftE1CfMkskz-YZba_jVDls84dICKscaoNrP1Z69Jx9Pqg&oe=69A59024"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighQ Edited2(1).png", "id": "375150995413131", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982460_375150998746464_5132883893584051015_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PsU5lwAwD4Q7kNvwFgVW9a&_nc_oc=Adm18EzfKWMrheq9L_zBBOyE4R2Tdexy2Ttz6kpE4YSGouU1bljTVPP_F4aO2SAeVDA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftLWfZyfjPQo_S9YUQuaxXZ9fLZxcBMwkejfFDoKs_0xw&oe=69A5A08F"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "An Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nHorrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8936186246462220"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974817_719006560083276_1128898082731884764_n.png?stp=dst-png_s360
E"}, {"file_name": "meta adjusted1.png", "id": "636944078516943", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982492_636944081850276_2378128627661877297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjRdjmpqBRMQ7kNvwG3zvcs&_nc_oc=Adr2b-tKpx4k6zOu6QVfrna0adkE0z4IR1p2pWi2AVNTAMsn9IUhTHT610BytU8sLww&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEdYhK0T5gD7m0lL6EWZGUYY_ShR1HAVGKojI4novosA&oe=6A8D9AC0"}, {"file_name": "meta adjusted4.png", "id": "667660598814625", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsdeOF-05JUQ7kNvwGSwKjN&_nc_oc=AdrLQpNN05hDSIw4os4yySLEsUCXWJWFUSf4dkHTOj9k-D1WekjudOsKOpRGtE3KEYs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzqUJtuRP2245DNNTdZL8I5YW4yXqwtF1I4QK5whDUug&oe=6A8D7FDB"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dq_M8ymaTtoQ7kNvwGiXClM&_nc_oc=AdqC1SPTUMgBPQHajKDDnuzpTVust03KKTyt6RXwN_aKp5ne9hs53lcK_OfUinyLoBE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAGB6vk0EE0AmHPr76cBOER4xF-gmyy-lf_W2IQHMouA&oe=6A8D9824"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighQ Edited2(1).png", "id": "375150995413131", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982460_375150998746464_5132883893584051015_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xX3GLBtoe3gQ7kNvwGRsMdF&_nc_oc=AdpzYbA53-KlQVyFYtq1ESAI9GLpqEBYtowPrRCC79Nu3pmE4rjUMQ6OVudvYZd2TDU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4Cv9bOH8hKenwH-nYPUWs8JQnd4G8Mlt16IxazNk_Vg&oe=6A8D704F"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "An Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nHorrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "893618624
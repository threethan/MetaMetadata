82492_636944081850276_2378128627661877297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3C87bjy9d0Q7kNvwG4Sy1W&_nc_oc=AdntDFZlPJoyYkPyeSDRwy_2qOlil5p76jPZJmfWHwlwio8CRJHz_dlgZWKTojc-Be0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftlI3O1aNuMTZ_dyJj09gMHpJuVbYYRdYN3IM_HumMUZg&oe=69A19E40"}, {"file_name": "meta adjusted4.png", "id": "667660598814625", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2FP9Fu8tIgQ7kNvwFf_TLe&_nc_oc=AdkfL3qq6g8Na65eQG7uHj_-CS71GsQnCU0SVQJSMj6DdS--IN9a4UFRUtaIf-5x2_k&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afth5vf7ocnH99pw0SPnzC764x8DQsIF5oh7wXyDpvSNfA&oe=69A1835B"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRThanFxhVoQ7kNvwHsbTrX&_nc_oc=AdnjEllfBwb_HJVVU4UAZD1QUDuAMXz2cK-o640wQnn5t5rZCZhGwbEGWsrJRMFL7ag&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsOGOw-2Kw0hUNitEbM_-on7uUBSGTl8bhVHFX5PWV70Q&oe=69A19BA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighQ Edited2(1).png", "id": "375150995413131", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38982460_375150998746464_5132883893584051015_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuO_IZkT9qQQ7kNvwHY6cPA&_nc_oc=AdnL-Ey1xv4_PjMm-VGQqs9T-1jv4JJ4R_AmvC4b_awPcEKVH1i2O0JOngRaX-wQ6q4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afv5CxBdTRwLmgAw4Qk2SbApOJpNbLkCd4ePJgfmqmqbkA&oe=69A1AC0F"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "An Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nHorrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8936186246462220"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974817_719006560083276_1128898082731884764_n.png?stp=dst-png_s360
name": "meta adjusted1.png", "id": "636944078516943", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982492_636944081850276_2378128627661877297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0h2YL5W-obIQ7kNvwGig2cm&_nc_oc=AdplxgvQwiCfqqvw8uvsb_wSbLSv4Kmy9jFVnJJhrAdU8T5hFoaQTOHPg0b6PmjINqg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4wNzfVhnTox0b4hCxLQbnqikITfgR-5vGrxrt8tIjkg&oe=6ABA6DC0"}, {"file_name": "meta adjusted4.png", "id": "667660598814625", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xihtfHscWw4Q7kNvwE_13bT&_nc_oc=Ado2RbWebNnAidrqfCaBnUpUy0aH8pj0A2q2XYm-G7rU1qnOTwGvinPWmga37ugHH0k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSSpjzRh3Yl7hNr8i3F8lvaA5wXzUcnFvVzsWMRyX-Cg&oe=6ABA8B1B"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnIQmpOHZhgQ7kNvwEkZCeH&_nc_oc=Adr7VX_5AdAbSQyR-WUJ7wmyk-SDaPJdLPFemdpZMVj-dA-hU02KPzghBGtXCNJEC2U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8qc8JWYjB0NC1F1LoNJw_d8DXhoJYDwrnlGvCTIGj9A&oe=6ABA6B24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighQ Edited2(1).png", "id": "375150995413131", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982460_375150998746464_5132883893584051015_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqSf6H3youMQ7kNvwFCK-pl&_nc_oc=AdrfLVfRmYFhESTJl5VLHWhcgIjenIOnKIUjDrnO7Y69Utf1It7QcCOxtO6bUQiYmeg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRM3wFfe-LFYUtgxszaaptw7gbCGSXdWJeA1Dc0bMLyA&oe=6ABA7B8F"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "An Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nHorrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8936186246462220"}, "review
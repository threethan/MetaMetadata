=oApuV8v2C_cQ7kNvwE76ogj&_nc_oc=AdrjE3zONXfpAJEqamNqVsMPK8a4cEeZmq82g3yyZJIesSthDuGTS-GgjI6Mqx4RrcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgapRlzt3QUOvIc-sQJe-Fc8MGyvZMEMrh9QtlD61Tvw&oe=6B071D2E"}, {"file_name": "meta adjusted1.png", "id": "636944078516943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982492_636944081850276_2378128627661877297_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VEUDWQU5wcQ7kNvwFJ964E&_nc_oc=Adpup4fj8hrzAAcoxj_dxx5-xq4NhQ_JLRR9l6YnLWOUUr_t73e53Xf3U_dZbkBo93k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRKusMWO2OyX4Gr2GHoE4g5W7i0GU5ybofHB_2KxeF9w&oe=6B071D00"}, {"file_name": "meta adjusted4.png", "id": "667660598814625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FysNd-f8XkQ7kNvwHlWfh3&_nc_oc=AdqU129oWtxZ4bXKcu_Y06bbzX_kdH5ZafaPPsGMx5wt7eiRKdsEMZuNfwzGQcmBMc8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJfL-vRKvUmTUhs3ZBcEfgCxiTDh4EFlXC08Dh5tq0mg&oe=6B07021B"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQtQOcdJb6kQ7kNvwHrc6yk&_nc_oc=Adq-tLiZv33M9VsKXzS-X1gAHfvIwL-h41wZ0NqLz09964UtvfvMZ9ePGAJviQqeg3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRubPeh53_0eJjMXe7rA_Ot2HgoucSjYQUW0OTDnwA5rg&oe=6B071A64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighQ Edited2(1).png", "id": "375150995413131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_375150998746464_5132883893584051015_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWAyX5BKKDkQ7kNvwH8neLI&_nc_oc=AdqOforBDNsr1R_NS6kLdnUYs37kjhB_Wps0ROfFfpiB7oT7nHRt1hsYQdUtQPwI1MQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTne2nFlcU5aYivIoQHlVKCH02fSZPzo5NFWQlXNEZENg&oe=6B06F28F"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "An Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nHorrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommende
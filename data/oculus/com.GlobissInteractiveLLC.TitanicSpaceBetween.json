=Ohv7BYnH5F4Q7kNvwH1mXHx&_nc_oc=AdoRIO4O0GW9p1pZDWh2rstWXu3ik6dPhzEZy2hNpTJF7tn3aShlLYlrawbmGHWxUx0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0TTZZSgqrZEMfYmlmbtSP6NPcYQ5ZBAl6UWXAiQGjgA&oe=6B0C632E"}, {"file_name": "meta adjusted1.png", "id": "636944078516943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982492_636944081850276_2378128627661877297_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyrIIz59umMQ7kNvwEIOQd3&_nc_oc=AdqoYk2NCpQ-B8Md52ljID9h5h6Ce6qWWZJiRMQ3rPQgQuI8ppCA70gSnjIV9LJvQ2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4rS4jeJS-X2m1lOMi0aBUMmiA72pbS9HENAItOeE0dg&oe=6B0C6300"}, {"file_name": "meta adjusted4.png", "id": "667660598814625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe09KFW0ZxAQ7kNvwG3lgX2&_nc_oc=Ado6unBeI112ohbZzoZUIRQEZe1AWtPk6eGGqL21E3yUsu_7J59cKJ9hFzsbrz4GhKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIpxMCobePbyVu3Blm0_bVtMeCXujyyLn5e0b7KwjJwg&oe=6B0C805B"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02lXHp4K5hMQ7kNvwGYTGrX&_nc_oc=Adr70IybD836Je5i76-qwXgJlB_DZ3blkhoSKAD4jNi32ulD6UWndx7mJyixuwle_dU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5N0x7kh8UQQJwQCYEHqmenfLqXD3lfDWP-S1dRwC--w&oe=6B0C6064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighQ Edited2(1).png", "id": "375150995413131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_375150998746464_5132883893584051015_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr15cHqlfA0Q7kNvwGWQVIx&_nc_oc=AdpUMHLZm4gz-PolTPLLOtnnTkJi5yjZO3EY9Jdln3yy0YjQFdEM_8sfYzSFbWtfQ1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRL096Kn03NKt45tTvjK7Zwa61puMTvmpLV82QA173uCQ&oe=6B0C70CF"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "An Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nHorrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommende
.png", "id": "667660598814625", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYnA4b-nPr8Q7kNvwHUWSAi&_nc_oc=AdoDhSCzhc6KpQ1kAIR86bFoUCvmaRp5N_NJJPfcldFcRvArX3d1akpWwpKsF8Ezd7w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW9hUXw4yGUUBQY3EIFqCRklaj3D2m2OkhaTimX8Hx7g&oe=6AAEAD9B"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSeUW8Ep774Q7kNvwG4W6Zq&_nc_oc=Adr1pEM-mdZjno3mCu6yni7kz1MmZCp96PQsh7qTusGhxk0lWdDOkGmLDjSzyM_OxvA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVjfDYway_MCHwctXYPe0-e4its3fLUoT41nNWPBZOIg&oe=6AAE8DA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILER ART.png", "id": "1371364770129428", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974688_1371364773462761_6159438874966926798_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQQJJvxoOCwQ7kNvwEAzwJU&_nc_oc=AdrmkZRhkBQt_5kIvhPxAebVb7Odv17fcA9Wcc8lWorQybkjinrY6flxt8v2aB8SFRY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLsUrNbGfq5427eFRjqnN3KD9C0_Q6JkLyBEdgvCcdKA&oe=6AAEAA36"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "Horrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nAn Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6991490680931796"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1280419430905009"}, {"status": "PUBLISHED", "id": "839715252165965"}, {"status": "PUBLISHED", "id": "743732414764759"}, {"status": "PUBLISHED", "id": "1335538291439336"}, {"status": "PUBLISHED", "id": "1177747144171756"}, {"status": "PUBLISHED", "id": "1171571058108738"}, {"status": "PUBLISHED", "id": "629543809544825"}, {"status": "PUBLISHED", "id": "550979750675876"}, {"status": "PUBLISHED"
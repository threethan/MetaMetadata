=Ohv7BYnH5F4Q7kNvwH9eQY5&_nc_oc=AdrWVGTf-Yfist8weDXTmVtz632I6t8MulvwEhfLV8LJeIw5YYIuX5fFAGfTVD7HXDk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoepiQh3F5leDG_gPYFMYJ7sZ8q2er9JYLUJPhnt_n3A&oe=6B09C02E"}, {"file_name": "meta adjusted1.png", "id": "636944078516943", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982492_636944081850276_2378128627661877297_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyrIIz59umMQ7kNvwGUqQoY&_nc_oc=AdqzzBtD1fwDDlEnmSPW7GM2MsfsFE2rvldHUnG23pWp5XQWTrYjEyMPK6vDYxOZ7aY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMI8hdsoORJMsMxV5keIGU6F31WCrzFm_xjg68dFtzng&oe=6B09C000"}, {"file_name": "meta adjusted4.png", "id": "667660598814625", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FysNd-f8XkQ7kNvwEz1laN&_nc_oc=AdqcEMCph-a5rEHPqEyTt6EeFLApi_Q8yuD6fKLDF-YBCGu5NpJLRoBzEUhu7I90hzI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnlHA8kYr-jJ5cP4vJ1UQP1Mt7nPb1UkEMvkDFkIA9rA&oe=6B09A51B"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYk5i0Y-CiQQ7kNvwGXD61O&_nc_oc=AdqY3r1TMNboxV7ht56y6njnDxOpWBEXVIhWHKyc0aNBGrUV-e4pifl9ZonqMl9h6tE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi6SmsgMXGTaWXKXj-QQsCWIiO5DrxznYoL2zqe-EFVw&oe=6B09BD64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighQ Edited2(1).png", "id": "375150995413131", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982460_375150998746464_5132883893584051015_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr15cHqlfA0Q7kNvwFgM6_8&_nc_oc=Adof2RkFYz_TLKR6daXs9VZWvImBpFIfUFexV5uhEmmZoN_V55yW4eNEURWtpH-8RZM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe1D_g_tNEsF2THTUnESg2uEun4NH_Iw1LlFGswDRf3A&oe=6B09CDCF"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "An Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nHorrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommende
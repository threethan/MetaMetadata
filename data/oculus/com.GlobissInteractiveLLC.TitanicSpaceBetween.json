=C35y61q2AjAQ7kNvwHbjEUN&_nc_oc=AdrUJR7737gz40WQt6z9l9ykzxIk7vZhzuugAnHUZPn82xG7ePkXnPYRO2sIRN6fKWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-RUaxWjpzyYw_LFSzjAtPyZBZFyqmlumVoGrWLdV2Dw&oe=6B0085AE"}, {"file_name": "meta adjusted1.png", "id": "636944078516943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982492_636944081850276_2378128627661877297_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viTrZQGQ8fAQ7kNvwHp72bI&_nc_oc=AdrnFUcHGsNV2WB3JZ4ckK-P-tGTlaIbuJCa9sDfbYDqTJu1bXPV06Srz4wa2KNjYeM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKxIGgpCLXj_BxMRn7ueHy7q_0K89FLdOsmh0Ld8ZNjA&oe=6B008580"}, {"file_name": "meta adjusted4.png", "id": "667660598814625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bvua6S7fjMcQ7kNvwGjfwq-&_nc_oc=AdoWnQavjzZLUyif3nlvbEmgQlNHtqoCJsKlmJjda7qJY90TR5UfpO-n_VYWH3SPLio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR76bKU-VFz0PnfzoyLs0ouXWIdJCeIDOreKkK0qfjzqg&oe=6B006A9B"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2Ua7jB3DqIQ7kNvwGzzzTB&_nc_oc=Ado3wKA1g2A5oAi8llnDLpbQmvCoqu-UcLLIa7pkoaglXXiZhOlbp8X5f4XqxYTILKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQflQMLmX-TIG71TDUC0zWLuLHcQ5ewx1zm1prRaA1o9A&oe=6B0082E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighQ Edited2(1).png", "id": "375150995413131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_375150998746464_5132883893584051015_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryYlGqULQOUQ7kNvwHFUw1d&_nc_oc=AdrMtPfaNvCh_Zwzh5Bl2omq9votIWiB2JDJrATz9ffSwBG44dVKSIQpbpveGr4IFzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR0sfVa2hTPxp5Gv7ftYfVMnHXVMsH8ayfxWsk2Gr9_g&oe=6B005B0F"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "An Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nHorrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommende
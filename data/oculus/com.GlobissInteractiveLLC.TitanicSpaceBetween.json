636944078516943", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982492_636944081850276_2378128627661877297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WzUIJLl6YoQ7kNvwGPkcHH&_nc_oc=Adm-Y02Hp89A8UjgURH1rEUt-pwbnpS8WvMxESM2uHFIZgBwiOu2rhtd0Yl5JCUJmKU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgpBx2I6FStWprl_-9VnlhzAaT4tVuEXNx75YzvMEB5w&oe=69AECD40"}, {"file_name": "meta adjusted4.png", "id": "667660598814625", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSANNPWOQEAQ7kNvwGGBTYh&_nc_oc=AdmFkAhv-Txq8He9A2OqRww15UsaFLrhaqNsnfZ8BNLix1wDtmA8eXm1RgeMo3H8DSs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQxKtSNLtJ6DHGapKLi81J_m0I8bklHAz33_TcPZPnyA&oe=69AEB25B"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuBU2T9Bd3MQ7kNvwFznslp&_nc_oc=AdkdMB66ppiRwXGh7s4r_kULCcjWezt7Y0Nx7U7qD8ry_XTwu8o0wFYpQzMWabP0LaI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEaBsgBynFU1VtfvxTlA0AkRpSvd_0uBsRV3Z__E9mkg&oe=69AECAA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighQ Edited2(1).png", "id": "375150995413131", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982460_375150998746464_5132883893584051015_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1iS8MkYSI8Q7kNvwH8Sm99&_nc_oc=AdkOc4zfffA95G2RipMy5hxbSyu7HVtlrmrBvujKgp5ZdoG82asS3kT-ShKPa1NLBSM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyP8RHiA7ERnZGEx1W1I7Pl9LQTXFj4UHv01-rurAuUvg&oe=69AEA2CF"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "An Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nHorrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8936186246462220"}, "review_messages": []}]}, "cover_square_image": {"uri": "ht
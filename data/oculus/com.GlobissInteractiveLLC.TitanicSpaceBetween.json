name": "meta adjusted1.png", "id": "636944078516943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982492_636944081850276_2378128627661877297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rl17pMoj7rcQ7kNvwEb0yOr&_nc_oc=AdrWYX0m317dhpNZ2qS10PQYata8077QTz_ILulUk1mDaOl8oKCeRQTAyFZzYxYd9qo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqF8tdOaO1Aurcun3zAyFeJU_V5hliHfoEAtyJvYz1uw&oe=6AA7F8C0"}, {"file_name": "meta adjusted4.png", "id": "667660598814625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjXiaJd-0J8Q7kNvwGJIRk3&_nc_oc=Adokf3ZQfZxajuo8rFtj7268mifU83K-HURR7h21gaLCwqkAtHaijr8-i-kUGVQ4nNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYZ2ahnLnTWN1JTMOT-cKKyn-P2L-wd0egl4I7ANoRKw&oe=6AA8161B"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KB1sqM53FXQQ7kNvwGZCfwd&_nc_oc=AdpH7fKrcdr7yZSCovbxtKB62wSXyrfAkZDO_HRpvVBGR3j0_7zkeWfEaXazRFu_ykk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNUr6PMwvZBKoUE0kBYWi03Zbeq61lDCXaGNQpKIzoBg&oe=6AA7F624"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighQ Edited2(1).png", "id": "375150995413131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_375150998746464_5132883893584051015_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDpWGO9vKpMQ7kNvwFBuHIf&_nc_oc=AdpR1X8sEUIKz6mSSpFR2_xoWmzuiIEAfKAgLE1FOjIS5R-7b_fUbUWGCnuhbLhIIY4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-h7_OLzazrZ_dbJ5rO5jnv0Z1OZjiJhXiu7DGfVl9xQ&oe=6AA8068F"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "An Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nHorrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8936186246462220"}, "review
=kWd0U8pvkPoQ7kNvwEco-FD&_nc_oc=AdrxlZ-xu0zjFPB9d6PICDgpWlaecFS3t3wwMvdRuRG94FZAl6jcZ1j0v8OQFpzL-Eg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSIIyqtDINpaSWpNjDVpPNP_1SWVINJPaTeoggQXYacw&oe=6B0328AE"}, {"file_name": "meta adjusted1.png", "id": "636944078516943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982492_636944081850276_2378128627661877297_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GMlVitaqjAQ7kNvwGetnxI&_nc_oc=AdoUeW2RlFrMeAIF4DR57mxPUya0YmK_aUYkPN1sL8NsQJeHjTznhV7-VjdytGVRt_M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjBw0YcBHjBs5zkoKyK7xxr6NWzVkXOBPijLEYEGJctQ&oe=6B032880"}, {"file_name": "meta adjusted4.png", "id": "667660598814625", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR-V-xPjHz8Q7kNvwE-mMoT&_nc_oc=Adob6RiypdlpqFLSqGmuUNjG3R-rwqMOIqMjaB5ymGTL_FW6SElH4Nfbmgnnp_B07Y0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUZ2Qf54swIzlvNafzuTRc7jGQkyDxTRacyftG7mPD1w&oe=6B030D9B"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2Ua7jB3DqIQ7kNvwFLEPtC&_nc_oc=Adpvx6jTIOo54iszn_BLcNw5pGwXfLh1GCj6PV9B1KnopmJp7OpxFBmRKOTPZytbmGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjP68iRpYmx9xo2aLI78Mrvx_HpTNNFsUyqbR3BmJIcQ&oe=6B0325E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighQ Edited2(1).png", "id": "375150995413131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982460_375150998746464_5132883893584051015_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O88MPMGNTj4Q7kNvwFttCPf&_nc_oc=Adr8IS_hv9GN7OhZnAbRrwzLTylmsI2DPgA6UU9fjP1JB8A53rsiH_qZDCd8yn-183c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPOb4-V2dEMoWbi8zKqAUdJqc0eFogATtHewUEvhw-Ug&oe=6B03364F"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "An Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nHorrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommende
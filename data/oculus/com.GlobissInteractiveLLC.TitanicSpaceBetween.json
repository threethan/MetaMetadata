=kWd0U8pvkPoQ7kNvwGGsgXA&_nc_oc=Adqm7OqxhQ98nXz_pDCSrQ955LsUZKModEbdmoKONXyhB9L01ooNXaqkk5KNzr_3Tbk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn_p3Pp-_YMWzxDyKegWLNXblfNphivcUYmmh-9apigA&oe=6B047A2E"}, {"file_name": "meta adjusted1.png", "id": "636944078516943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982492_636944081850276_2378128627661877297_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GMlVitaqjAQ7kNvwFoMpV7&_nc_oc=AdoYTUJ0FTpc04B6srS_4y70v2amdF9cZJ_XuIfwgHt3k_WA6OpOS0A9Fq2iyW5a47U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSouVv_tycHYDsQ1QCJeSTGz8o73Np9sPB6I5hHLrmwNg&oe=6B047A00"}, {"file_name": "meta adjusted4.png", "id": "667660598814625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974880_667660602147958_5199318130331184951_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR-V-xPjHz8Q7kNvwF_xT-P&_nc_oc=AdqXbuquo5TR9J84lBSsccKURkWIKdVOPyKF5eYiwxnHIHLcqmh2jaQu05sR1Nd0gGA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRumNvkd7c_a80Yo8PCN7h8MbXJpfIk__o5JCvGcDrS7w&oe=6B045F1B"}, {"file_name": "meta adjusted2.png", "id": "1003931280869354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031597_1003931284202687_6629047901617471290_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQtQOcdJb6kQ7kNvwGGUIeB&_nc_oc=Adpvt1n7mLOwS2m1kXBUf7m-Fk48K79Wq7jcNHXVAtQQEvR9I7ju_6Gu3Lev4_TdeEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf7cGcNcqOoof91d4MsTSIJ3Ln-IugDfagfP4FwtKNUQ&oe=6B047764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HighQ Edited2(1).png", "id": "375150995413131", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_375150998746464_5132883893584051015_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O88MPMGNTj4Q7kNvwH3MMBK&_nc_oc=AdolD1-FKafL8_CKQI6O5EMbTMJGGDkTq_eLjFz3Y2EIddNouq1CCGfJyI9wsnbwjQw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7zRT5iKNr_q2c-IHfYVl3bpYK2ivd54-EvMG4WC8OvA&oe=6B0487CF"}, "display_name": "Titanic: A Space Between", "keywords": [], "long_description": "An Urgent Escape:\nGet thrown into the bowels of the Titanic, and use your wits to escape the ship, deck by deck. Solve countless puzzles, and manipulate your environments in order to avoid the ever-rising water. Utilizing a weighted physics system, interactions feel natural and diverse.\n\nHorrors of Time-travel:\nBecome Hendrik van Eden, a specialist who gets sent back to the Titanic in order to uncover the mysterious disappearance of a previous traveler, Diana. Slowly uncover the truth about time-travel and the horrors that come along with it. \n\nTop-Of-The-Line Graphics:\nExperience the Titanic in all of her glory, utilizing top-level lighting and water systems. Through countless optimization and tricks, we've achieved a high-fidelity experience that draws parallels to PCVR experiences. ", "short_description": "Titanic: A Space Between is a time-travel horror adventure where players get sent back to the RMS Titanic. With a focus on realism and immersion, this multi-layered horror experience mixes puzzles and escape mechanics without compromise."}]}, "developer_name": "Globiss Interactive LLC", "developer_privacy_policy_url": "https://www.globissinteractive.com/titanicasbprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "BoomBox Games", "support_website_url": null, "website_url": "https://www.globissinteractive.com/coming-soon-01", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommende
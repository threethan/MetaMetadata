f&oh=00_AQRqKTtGLa-FzatfoqrLHeELUrZzIdoXWiepyslN5SdigA&oe=6B084D3F"}, {"file_name": "EndOfGameExplosionsWithBallCloseUp.png", "id": "1202028777023012", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974680_1202028780356345_5736632251378491264_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZTBqXsaI3sQ7kNvwFs214X&_nc_oc=AdokyJuCQcXU2TiiApT_ftFH6Xcq_pnV0NXl0NfU4hpxbRXKvS1fpmx40PwcmoWF0xY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaYOSGw5g7oX47zoj5ObwuoDBtbeosp3nimYiMYlJXcw&oe=6B086EBD"}, {"file_name": "Fireworks-with-sevens.png", "id": "857360595238911", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75580066_857360605238910_8049334364338319927_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esRwtwuy0p0Q7kNvwGxzr8j&_nc_oc=Adofijfb9qJReDF1caN46gN6iiiMDEA6uJzxT2TCKg0jXeXxhPh8aQWcum1x5eSKi9s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe07H2EvtAo7iZcR3SOQr97uS9DYoBrdNtCBnmAToQwQ&oe=6B085A8B"}, {"file_name": "BothCabinetsWithNookAndfireworks.png", "id": "477373334225643", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974469_477373337558976_3100733574534167559_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sEggaW6b0cQ7kNvwHX_8ga&_nc_oc=Adr7S_fl8W0xoTj9MModby0xdVuUWIOKvneh2Z8vFRhyqNOVo_00qqzXs7tdwyoyhp8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtD5NcIDySQJ9JcaVbrad-JSgG4h_n8r9X_J7qM4BlYg&oe=6B084294"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBallcadeCoverArt.png", "id": "1021833251820122", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031591_1021833255153455_7254767828407868574_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kY54GiGqc4Q7kNvwEvBxja&_nc_oc=Adqt2wi9bey6Grh_IG8P1nOiVbEGOrm7_WwO62xKm-BmsUXdjJsRliZAReY2fg3GgkA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLUOunuTZpVuTHbhez3i9B9RSu7pF6XsRUgl3vskI2og&oe=6B0864EA"}, "display_name": "VR Ballcade", "keywords": [], "long_description": "Experience Retro Arcade Basketball Action with VR Ballcade! 210 Arcade levels to challenge your reflexes and endless Freeplay mode to practice your shots! Customize your balls in thousands of different ways by unlocking new patterns and texture combinations! Use the practice court to hone your skill at various basket heights. Play H.O.R.S.E. or go Head to Head with a friend via local WiFi! \n\nPlayers: 1-2\nModes: Arcade, Freeplay, Hard Mode! Practice court\nArcade levels: 210\nFreeplay modes: Timed( 30, 60, 90, 120 seconds), Infinite\nHard Mode: Smaller basket, backboard has more bounce!", "short_description": "Experience Retro Arcade Basketball Action with VR Ballcade! Over 200 Arcade levels to challenge your reflexes and endless Freeplay mode to practice your shots! Challenge your friends in Head to Head Multiplayer! Looking for a challenge? Try HARD mode and put your skills to the test!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://daveandmikegames.com/vrballcade/vrballcade-private-policy/", "developer_terms_of_service_url": "http://daveandmikegames.com/vrballcade/vrballcade-private-policy/", "publisher_name": "Dave and Mike Games", "support_website_url": "https://daveandmikegames.com/vrballcade/f-a-q/", "website_url": "http://daveandmikegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULU
f&oh=00_AQTbEykgrn5O2JC622hGqFN8-HnXs-8GPopeTAUziv5GvQ&oe=6B05AA3F"}, {"file_name": "EndOfGameExplosionsWithBallCloseUp.png", "id": "1202028777023012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974680_1202028780356345_5736632251378491264_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06DQzSjT68oQ7kNvwGMuvkS&_nc_oc=AdrDH3GfO5cJQcVLh6OFpBS39_OjLBfjt7hPgdxqrCHEwjF-qT4gIqIBWJRWRr48HGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRjjXNdNDaPDvEKjphUr6Gw0k1e5wvpdl52vMIyCY7LQ&oe=6B05CBBD"}, {"file_name": "Fireworks-with-sevens.png", "id": "857360595238911", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580066_857360605238910_8049334364338319927_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u22N-o9rhs8Q7kNvwHU1VKv&_nc_oc=Ado_Kh7RGSUFUyPa5ub_NlxJFgceHW6Cd7kfE0YTUiTEZnU-oQF8UHEu_UsxzWB5Tkk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp-ypZdYTTwbD6WRTNxr9HyyJRxu0yy77QWbYuM0u46g&oe=6B05B78B"}, {"file_name": "BothCabinetsWithNookAndfireworks.png", "id": "477373334225643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_477373337558976_3100733574534167559_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdrxwrhMP4QQ7kNvwH01Qd5&_nc_oc=Adppzt8O0LPBipVYY9EXDt1yAKLK0Hd8FuYpK8nGZKJAoXMxrleUxcnalx3UJbLXOmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiIV3huwWYcdBdGUrVx9kcl7wfogfXNBKhudNppEZXPg&oe=6B05D7D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBallcadeCoverArt.png", "id": "1021833251820122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031591_1021833255153455_7254767828407868574_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kY54GiGqc4Q7kNvwFDuT-i&_nc_oc=AdrG5xZuEa6UVxgTAvLSlgZ2By6T-oFSgb6qD_3vrghYn0N6Wvi0uFLrcZfiFEJl8B8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQ7i7tcBajJ8rXhWW49blCv5u-5EJS_YsxvjVnhP__pg&oe=6B05C1EA"}, "display_name": "VR Ballcade", "keywords": [], "long_description": "Experience Retro Arcade Basketball Action with VR Ballcade! 210 Arcade levels to challenge your reflexes and endless Freeplay mode to practice your shots! Customize your balls in thousands of different ways by unlocking new patterns and texture combinations! Use the practice court to hone your skill at various basket heights. Play H.O.R.S.E. or go Head to Head with a friend via local WiFi! \n\nPlayers: 1-2\nModes: Arcade, Freeplay, Hard Mode! Practice court\nArcade levels: 210\nFreeplay modes: Timed( 30, 60, 90, 120 seconds), Infinite\nHard Mode: Smaller basket, backboard has more bounce!", "short_description": "Experience Retro Arcade Basketball Action with VR Ballcade! Over 200 Arcade levels to challenge your reflexes and endless Freeplay mode to practice your shots! Challenge your friends in Head to Head Multiplayer! Looking for a challenge? Try HARD mode and put your skills to the test!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://daveandmikegames.com/vrballcade/vrballcade-private-policy/", "developer_terms_of_service_url": "http://daveandmikegames.com/vrballcade/vrballcade-private-policy/", "publisher_name": "Dave and Mike Games", "support_website_url": "https://daveandmikegames.com/vrballcade/f-a-q/", "website_url": "http://daveandmikegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULU
f&oh=00_AQTQ2L9aUAUjTM-VXvkt0HqrjLMJJV0eFkFuWqHzQFpeBA&oe=6AFDC13F"}, {"file_name": "EndOfGameExplosionsWithBallCloseUp.png", "id": "1202028777023012", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974680_1202028780356345_5736632251378491264_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2ewSJ3SMsMQ7kNvwEPaCJa&_nc_oc=Adr6xxqurAeBn6XuDqKRPwH0k7cUXQU1TRz10Zc27TE6wkW02pfMRTBBIEXBJET3V-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqh3W0dbSlBoOSUdy_S6PxrcdvqKagcFmGzP1NTkc3Dg&oe=6AFDE2BD"}, {"file_name": "Fireworks-with-sevens.png", "id": "857360595238911", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580066_857360605238910_8049334364338319927_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_epbnGMI7oQ7kNvwGAA0u-&_nc_oc=AdoRzyvfe9aqans5sEn-BMFADwOb9f5bw7BBHqln0gOaPTTsWevUHXWtBD3SIcoejHs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXkGwnYuvFbF86uZ_XkziWN3gHE6x29qas2lT11oxn2A&oe=6AFDCE8B"}, {"file_name": "BothCabinetsWithNookAndfireworks.png", "id": "477373334225643", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974469_477373337558976_3100733574534167559_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYqxKQ1N5p8Q7kNvwGSCeqC&_nc_oc=AdpMz9PwV75XuiYJEX7C77dcIrWdHh5vm_q-rYuPyR8VKtSt4aXs0EGF6zsAOa4S_jQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTITEx8iA59lI9peTEja73TSDuLs8jRNaVhwsny-5NANg&oe=6AFDB694"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBallcadeCoverArt.png", "id": "1021833251820122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031591_1021833255153455_7254767828407868574_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDY-0PtOeDUQ7kNvwEjOVN9&_nc_oc=AdqMGaaWzjrg8YvDdkaITBBBivz2T9042CzmMk6lPcpQdyUpfY8AvyazlfHAq27PuLY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJpOmsL4y9pzbYI-HQl7_EvQJGK8IwIVi5tAmcda_Ybg&oe=6AFDD8EA"}, "display_name": "VR Ballcade", "keywords": [], "long_description": "Experience Retro Arcade Basketball Action with VR Ballcade! 210 Arcade levels to challenge your reflexes and endless Freeplay mode to practice your shots! Customize your balls in thousands of different ways by unlocking new patterns and texture combinations! Use the practice court to hone your skill at various basket heights. Play H.O.R.S.E. or go Head to Head with a friend via local WiFi! \n\nPlayers: 1-2\nModes: Arcade, Freeplay, Hard Mode! Practice court\nArcade levels: 210\nFreeplay modes: Timed( 30, 60, 90, 120 seconds), Infinite\nHard Mode: Smaller basket, backboard has more bounce!", "short_description": "Experience Retro Arcade Basketball Action with VR Ballcade! Over 200 Arcade levels to challenge your reflexes and endless Freeplay mode to practice your shots! Challenge your friends in Head to Head Multiplayer! Looking for a challenge? Try HARD mode and put your skills to the test!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://daveandmikegames.com/vrballcade/vrballcade-private-policy/", "developer_terms_of_service_url": "http://daveandmikegames.com/vrballcade/vrballcade-private-policy/", "publisher_name": "Dave and Mike Games", "support_website_url": "https://daveandmikegames.com/vrballcade/f-a-q/", "website_url": "http://daveandmikegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULU
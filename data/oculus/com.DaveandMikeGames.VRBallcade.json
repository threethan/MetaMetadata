345_5736632251378491264_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpC__0YPgE4Q7kNvwEKgML7&_nc_oc=AdoyP9tmBttNdxQlPeYxFMqPk5w6WokfyFRnvpf9lSGZXVWe2yGaECq4HRx7zF--UOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6cwb1YAD0qMeggwngSagRPtDjVP0mjUU0e7oZYVpyPg&oe=6AB527FD"}, {"file_name": "Fireworks-with-sevens.png", "id": "857360595238911", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75580066_857360605238910_8049334364338319927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOeI66cLVVkQ7kNvwHKy_3Z&_nc_oc=AdpftcZsZLKc8XqCVo4lM_v0moaQ6LEgskdN62coKR6OKKWQx3PNrFTl2vx7gVnJkYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJpwn-6HuF8k7OEuFY_DXUsCqy65BDbs7j-1Gq6ElCjw&oe=6AB54C0B"}, {"file_name": "BothCabinetsWithNookAndfireworks.png", "id": "477373334225643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_477373337558976_3100733574534167559_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQxJqPH12LEQ7kNvwHozxRT&_nc_oc=Adr5-KX-OF_HugSNjpbUZYF3qODiPtK8LHUFYbEvSUJAByDwYjtnWetqRlyKXd-2dkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdYaf2EdBiQ7rICPeFTJpiVAJNOaIoLsM2ywt_3at9bw&oe=6AB53414"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBallcadeCoverArt.png", "id": "1021833251820122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031591_1021833255153455_7254767828407868574_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zop5lY9heEAQ7kNvwHPSxmB&_nc_oc=Adr1EXr8T1uyl4ph-u9dc7J--DJtsZx_2BMU8v0t8BCEDBFGTAPqQlAXYMOHaJcSdpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH6psxBx_kC1XI5uIjvRQS9CNUcrsf627O5kTAJMwxmA&oe=6AB51E2A"}, "display_name": "VR Ballcade", "keywords": [], "long_description": "Experience Retro Arcade Basketball Action with VR Ballcade! 210 Arcade levels to challenge your reflexes and endless Freeplay mode to practice your shots! Customize your balls in thousands of different ways by unlocking new patterns and texture combinations! Use the practice court to hone your skill at various basket heights. Play H.O.R.S.E. or go Head to Head with a friend via local WiFi! \n\nPlayers: 1-2\nModes: Arcade, Freeplay, Hard Mode! Practice court\nArcade levels: 210\nFreeplay modes: Timed( 30, 60, 90, 120 seconds), Infinite\nHard Mode: Smaller basket, backboard has more bounce!", "short_description": "Experience Retro Arcade Basketball Action with VR Ballcade! Over 200 Arcade levels to challenge your reflexes and endless Freeplay mode to practice your shots! Challenge your friends in Head to Head Multiplayer! Looking for a challenge? Try HARD mode and put your skills to the test!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://daveandmikegames.com/vrballcade/vrballcade-private-policy/", "developer_terms_of_service_url": "http://daveandmikegames.com/vrballcade/vrballcade-private-policy/", "publisher_name": "Dave and Mike Games", "support_website_url": "https://daveandmikegames.com/vrballcade/f-a-q/", "website_url": "http://daveandmikegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "477491847103873"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036688_1186213585283150_180635646260
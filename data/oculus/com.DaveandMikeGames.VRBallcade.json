28780356345_5736632251378491264_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYNhkuZ6L2EQ7kNvwGv9rt_&_nc_oc=AdrOE-yRxCD7BTd1MLrAvZCP2SennoIRWQh2z69WLUyGpNKNkSpIpiVpnMJwEUdwT2M&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl4JlAsS6JhiJXU7B11r_n7qP-mf73HjbAE8G0gInHGg&oe=6A8D9AFD"}, {"file_name": "Fireworks-with-sevens.png", "id": "857360595238911", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75580066_857360605238910_8049334364338319927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDVXjc6i8ZcQ7kNvwFgsoIz&_nc_oc=Adqa9eogaOcDQwBnDO2AosKxze4L2eEM-_K7_Vhb8ITRHkdpy0SsI2l7Y7HvJ4zZC80&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVoyR2gW3oJqpnhpLmApQSB-ucvEhBt-LksusWJcgRKg&oe=6A8D86CB"}, {"file_name": "BothCabinetsWithNookAndfireworks.png", "id": "477373334225643", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974469_477373337558976_3100733574534167559_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IX_yJdb9ffsQ7kNvwHtORW6&_nc_oc=AdoFcrrvp1mhooe-AYZpxa54CsN3WDmIVZd8s-Rg12RoqL1826uBS2g3TVWXssvk5fY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEydQouDmZHF1unXwLXvIyQ2G7twFPrtRS78ZcGFjqMvg&oe=6A8D6ED4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VRBallcadeCoverArt.png", "id": "1021833251820122", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031591_1021833255153455_7254767828407868574_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9T56gey-GuAQ7kNvwF8bhE5&_nc_oc=Adq-EpfmRbVNGuweluJ5s5TCM5B4IhS3krwi9XbxXv9fBnYa1fZUr3QJ3QvhY_5aTjo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNCVvHm1gkx53No5972XL3eT8M06XzfI_WIkpIayIZ6A&oe=6A8D912A"}, "display_name": "VR Ballcade", "keywords": [], "long_description": "Experience Retro Arcade Basketball Action with VR Ballcade! 210 Arcade levels to challenge your reflexes and endless Freeplay mode to practice your shots! Customize your balls in thousands of different ways by unlocking new patterns and texture combinations! Use the practice court to hone your skill at various basket heights. Play H.O.R.S.E. or go Head to Head with a friend via local WiFi! \n\nPlayers: 1-2\nModes: Arcade, Freeplay, Hard Mode! Practice court\nArcade levels: 210\nFreeplay modes: Timed( 30, 60, 90, 120 seconds), Infinite\nHard Mode: Smaller basket, backboard has more bounce!", "short_description": "Experience Retro Arcade Basketball Action with VR Ballcade! Over 200 Arcade levels to challenge your reflexes and endless Freeplay mode to practice your shots! Challenge your friends in Head to Head Multiplayer! Looking for a challenge? Try HARD mode and put your skills to the test!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://daveandmikegames.com/vrballcade/vrballcade-private-policy/", "developer_terms_of_service_url": "http://daveandmikegames.com/vrballcade/vrballcade-private-policy/", "publisher_name": "Dave and Mike Games", "support_website_url": "https://daveandmikegames.com/vrballcade/f-a-q/", "website_url": "http://daveandmikegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "477491847103873"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036688_1186213585283150_
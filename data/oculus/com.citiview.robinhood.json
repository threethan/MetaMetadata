3fXGkUT7gUqq4OpT-wfWQk48HMUqmYKUZONNdKbOh4r-kWtXNA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR75g4x1che6OyOIvDE1lk5857V-W0f-El33WdutsRbyA&oe=6AFB2360"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1645506106983564", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620403_1645506110316897_6031997427926665335_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6z2rS1_JPAQ7kNvwHVhC8D&_nc_oc=AdrCaJxO8au1R4loRPoI7orPq0CvPBucPWtjkTFa57PtT-yOdK8yoDIlubMQWI86HtA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNrSXqsGKkw1_702GEg9mSod_nS4OXooVpptrQH3ADiw&oe=6AFB4C83"}, {"file_name": "screenshot_4_2560x1440.png", "id": "28947403841509593", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499627502_28947403848176259_164031150161924191_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daY4uq93cF8Q7kNvwHj1GMg&_nc_oc=Adpq1p6aAOqiZ-6PDgj2qWZkU1ccQ6B5q8hAyZGNRx8z1OwQ_iqDhcNTBvTmOqYjGFM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDCtGVQ-ATKiLQd7OFqUCW7S2RfIShceahsFPA4-FNhA&oe=6AFB45A4"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1556274602939990", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499626808_1556274606273323_3944725635049964665_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHvyVErlc58Q7kNvwE7zsgJ&_nc_oc=AdphI-Yt-tfQmmv3qzwHZmXpugG3EpSC3vAHEKQbQpQHLaj_dVVMkHy8St7qSlIVFOI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREgwVc26D4_hsFBsJ0aqBGyDqWpg-ar2Q9GZWBk4sF6g&oe=6AFB3B6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1869302644051502", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673745728_1869302647384835_155129794926733367_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82PaRIWDhtoQ7kNvwHqzDgD&_nc_oc=AdqSsAQErr1FfaM5JzIMHwTHIk3d612eHvJOBpex3leBCZJljXIbuM9iaPGbEZ2vGzQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbTsT0DCcKv8pCEiYZ3Ow9kOY8IGNjERIhykZkcPdROg&oe=6AFB4780"}, "display_name": "Robin Hood", "keywords": ["archery", "bow", "arrow", "medieval", "forest"], "long_description": "ROBIN HOOD is VR archery the way it should feel: a real longbow in your hands, in a bright storybook Sherwood Forest.\n\nA REAL BOW\nHold the bow out in one hand. Bring the other hand to the string, squeeze, and draw it back to your cheek. The pull clicks in your hand, the string snaps when you let go, and a longer draw sends the arrow faster and flatter. Left-handed archers can swap hands.\n\nTEN TALES, FIVE PLACES\nA sunny glade, a river crossing, the Sheriff's autumn road, Nottingham Fair and Sherwood in winter. Every Tale is a run of waves with three stars to win.\n\nSO MUCH TO HIT\nBullseyes that tip over when you hit them, targets swinging on ropes, apples on posts, bottles tossed into the air by Friar Tuck, coin pouches you cut down by the rope, barrels drifting down the river, and the Sheriff's tax wagon - shoot the padlock and the chest bursts open with gold.\n\nTHE SHERIFF'S MEN\nHis guards peek out from behind rocks and crates. Hit one and his helmet flies off and he runs for it. Nobody gets hurt.\n\nGOLD FOR THE POOR\nHit streaks raise your multiplier up to x5. Eight hits in a row, or a golden crown shot out of the sky, earns a Golden Arrow worth double. Every coin you rob flies home to your belt.\n\nROBIN HOOD'S CAMP\nStart under the Major Oak with its treehouse, the campfire and the Merry Men, and warm up on the practice range between Tales.", "short_description": "Pick up a real longbow in storybook Sherwood Forest. Draw it back to your cheek, let fly and hit the gold. Shoot apples, swinging targets, coin pouches and the Sheriff's tax wagon across ten Tales - and give the gold to the poor."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-robinhood.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-robinhood.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1231427566729883"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1844592790238434"}]}, "baseline_offer": {"id": "1844592790238434"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790017380, "status": "PUBLISHED", "id": "1844592790238434"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1244614218744551", "version": "1.0.0"}, "id": "937559735512916", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1231427560063217", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1244614218744551"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "937559735512916"}]}, "change_log": "Robin Hood 1.0.0 - first release.", "created_date": 1789757687, "id": "1244614218744
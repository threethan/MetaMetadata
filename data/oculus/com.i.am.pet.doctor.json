f&oh=00_AQM1LjG6-8wSTxcJWlHeYRNAoDThOHpxtCe0gJRoM1HqvA&oe=6AD397BF"}, {"file_name": "6.png", "id": "1546632516996629", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617729_1546632520329962_577433391134672871_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qh1NliPvLQQ7kNvwHB2DOn&_nc_oc=Adow-VLBcrq2YqojXd2ka4mpAWveSmjzbD7h8ZEkt261Fl-O_o4MFJs6PSHouHRlZjg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_t60FkmLikkwKuKRh7Uzud6lZEsYMwjLfBns-Dw2UxA&oe=6AD38917"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Pet Doctor", "keywords": ["pet", "doctor", "veterinary", "animal", "hospital"], "long_description": "Step into I Am Pet Doctor VR, a fun Meta Quest VR game where you become a caring pet doctor in a colorful cartoon animal hospital. Treat cute pets, use interactive doctor tools, complete pet care checkups, and enjoy immersive hands-on pet doctor gameplay designed for fans of animal care, doctor games, vet games, and VR simulator adventures.\n\nExplore a playful veterinary simulator filled with cute animals, clinic tasks, medical mini-games, pet rescue missions, pet hospital activities, and animal treatment challenges. Check heartbeats, clean wounds, give medicine, scan pets, use medical equipment, and help puppies, kittens, and other adorable animals feel healthy again.\n\nBuilt for relaxing and family-friendly virtual reality gameplay, I Am Pet Doctor VR combines animal games, pet care games, hospital simulator tasks, vet clinic roleplay, doctor roleplay, cartoon VR interactions, and casual simulation gameplay in one charming experience. Every activity is easy to understand, fun to play, and designed for players who enjoy casual VR games, animal rescue, medical games, simulation games, and creative roleplay.\n\nBecome the pet doctor your animals need in I Am Pet Doctor VR, complete veterinary challenges, unlock fun clinic moments, and experience a cute cartoon veterinary simulator made for Meta Quest players who love pets, animals, doctor tools, mini-games, animal hospital gameplay, and immersive VR simulator fun.", "short_description": "Step into I Am Pet Doctor VR, a fun Meta Quest pet doctor and veterinary simulator where you treat cute animals, use doctor tools, complete pet care checkups, and heal pets in a cartoon animal hospital. Enjoy family friendly pet doctor gameplay with animal care, vet clinic tasks, medical mini-games, rescue missions, and immersive VR simulator fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rebelsgamestudio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rebels Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/rebelsgamestudio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26852643711064010"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619113_1712514889917878_914399959992875484_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_2FlG9bR4sQ7kNvwFgEJGV&_nc_oc=AdryXotduvWxGvfXVF53Gb9alj0LBiz-7uMWIX-HVv9hdDnygcv5R1ngdt526EAfTZg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyZHzpBPCmmKN5nLcDRHUgyq5evrWzsNRfHqRfGHyZSQ&oe=6AD39210"}, "is_concept": false, "is_test": false, "is_trial_offer_valid"
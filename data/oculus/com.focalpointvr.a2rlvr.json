culuscdn.com/v/t64.5771-25/38982588_1097481434797455_6052519219973323555_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31-7bqi01pwQ7kNvwGIqY26&_nc_oc=AdoQA3RLfhYSWZlGp3CjgFdN_hph_Y8mV0yKJVF1j7CGtwpY22_Epk9HeFXn1vvaeh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKDl7z9sajNX34bBbWYgeuHkQKzUKR9TTeQwDjRlwfBQ&oe=6AFDD805"}, {"file_name": "com.focalpointvr.a2rlvr-20240321-144038.png", "id": "278063665360060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036623_278063668693393_7943965453410782702_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7d3_e0mUXkQ7kNvwEl750m&_nc_oc=AdqG0OKNMTDef4soImYcwWGpsgigjsW9VpiD9h5TVeBVlCpxbMoIp39JUCNQCCuM4Qs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYqXc90PQG5Aqw79-uXqAI1cAQSrkB52KOWjbFVIx-3Q&oe=6AFDD36D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A2RL VR", "keywords": [], "long_description": "Experience the future of motorsport with A2RL VR! Dive into the heart of the action at the Abu Dhabi Autonomous Racing League, where cutting-edge AI technology meets adrenaline-fueled racing.\n\nA2RL VR transports you directly into the cockpit of A2RL's autonomous racing cars, immerse yourself in ultra-high-resolution onboard VR video and witness every twist and turn of the Yas Marina Circuit in stunning detail.\n\nWith our innovative integration of 3D data visualization and live telemetry, you'll have access to an unprecedented level of engagement, offering a truly immersive and thrilling viewing experience.\n\nDon't just watch the race \u2013 be part of it with A2RL VR!", "short_description": "Step into the future of motorsport with A2RL VR! Immerse yourself in the adrenaline-fueled world of autonomous racing, experiencing every twist and turn from inside the A2RL cars. With ultra-high-resolution VR video and live telemetry, A2RL VR offers unparalleled engagement for sports enthusiasts. Get ready to race like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://focalpointvr.com/a2rl-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ASPIRE UAE \u2013 Sole Proprietorship LLC", "support_website_url": null, "website_url": "https://a2rl.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25338181279129641"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "938316904446500"}]}, "baseline_offer": {"id": "938316904446500"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1714114800, "status": "PUBLISHED", "id": "938316904446500"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38663063166641319", "version": "0.9.16156"}, "id": "721189079496695", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24264469556500824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38663063166641319"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790250523, "id": "38714152404865
ms2-1.oculuscdn.com/v/t64.5771-25/39036623_278063668693393_7943965453410782702_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0haBazSpsQQ7kNvwFwXiAI&_nc_oc=AdlB-3I12mEyiSmfhNKXBuFR3H2QmioVai7dB5i0v6cqGVX83Z3wMs2weoCjnKZPecE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxe_mYw5A7AkOu0RBVaPSlTaGmJlM0e6O8uomOd2n3aug&oe=69AD6CAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A2RL VR", "keywords": [], "long_description": "Experience the future of motorsport with A2RL VR! Dive into the heart of the action at the Abu Dhabi Autonomous Racing League, where cutting-edge AI technology meets adrenaline-fueled racing.\n\nA2RL VR transports you directly into the cockpit of A2RL's autonomous racing cars, immerse yourself in ultra-high-resolution onboard VR video and witness every twist and turn of the Yas Marina Circuit in stunning detail.\n\nWith our innovative integration of 3D data visualization and live telemetry, you'll have access to an unprecedented level of engagement, offering a truly immersive and thrilling viewing experience.\n\nDon't just watch the race \u2013 be part of it with A2RL VR!", "short_description": "Step into the future of motorsport with A2RL VR! Immerse yourself in the adrenaline-fueled world of autonomous racing, experiencing every twist and turn from inside the A2RL cars. With ultra-high-resolution VR video and live telemetry, A2RL VR offers unparalleled engagement for sports enthusiasts. Get ready to race like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://focalpointvr.com/a2rl-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ASPIRE UAE \u2013 Sole Proprietorship LLC", "support_website_url": null, "website_url": "https://a2rl.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "27765422
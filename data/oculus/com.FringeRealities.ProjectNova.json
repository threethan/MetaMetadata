380_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A01Pz7YjbmUQ7kNvwFQWVs3&_nc_oc=Adrj8iZsgrosCEuIVFun5ABYErr-Ezk70vm5MFwiWJJJar9htQM2x1M2lig6IfXqrRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iQDt-fre8q14o5faydifiCipN28Gorei39pXlR_mcZQ&oe=69DA5FE2"}, {"file_name": "LifeSupportPuzzle_Meta.png", "id": "2584273858602063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618515_2584273861935396_5670801023408605776_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Po8J_hdkdLIQ7kNvwFoa8cL&_nc_oc=Adqy23FVw6xDehKbndvhj8yQ9FXKZBY7zPIvcC1ljVYTmk3UCFuJgqkrkdSJE8FNA-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ejCyKRTE108ewrp2TkPv2UEJQzeHuX6CxcpTXLLi39Q&oe=69DA2D70"}, {"file_name": "Valve_Meta.png", "id": "1709467116420789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619668_1709467123087455_8809373153596058726_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueoNfjyBdf4Q7kNvwGJYVvu&_nc_oc=AdqF0DvIV1SDU_KXLubC1sRTFbURwvCGN5Ihs2xOsTXZfBTlr81525MPG6RNPzOlcuw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o7oqZT7i7a8L-M-iBflZkp55ntijf8xMAb0wyE-7Xyg&oe=69DA2BDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project: Nova", "keywords": ["Space", "Puzzle", "Isolation", "Narrative", "Walking"], "long_description": "Greetings Engineer and Welcome Aboard the Nova Aurora\n\nYou enlisted to work aboard the Nova Aurora to ensure it completes its voyage, but years of training did not prepare you for the situation you would find yourself in. You awake from stasis to find yourself as the last Engineer onboard the ship, which is now in disarray.\n\nWith the help of the ship AI it is up to you to try to repair the Nova Aurora and get it back on its voyage!\n\nProject: Nova is a VR puzzle game centred around the feelings of astrophobia and isolation. As an Engineer it is your job to find and repair faults the ship has suffered on its voyage, using your wits and handy tools. Along the way you will need to be careful not to do more harm than good, and find out what exactly happened aboard while you were in stasis.\n\n\nKey Features\n\nAstrophobia and Isolation\nThe mood of Project: Nova focusses on the eeriness of an empty ship, devoid of life and humanity, and the fears of space and being lost amongst the stars.\n\nBranching Narrative\nAs you progress through the ship you will be faced with certain puzzles and decisions which, depending on your outcome, will lead to alternative endings.\nDo you have what it takes to save the Nova Aurora?\n\n", "short_description": "Solve puzzles in VR, Explore the Nova Aurora, Repair its damaged systems! \nAs the last engineer onboard, experience the isolation of being stranded alone. \nAs you progress through the story you will face puzzles and consequences which will determine the fate of the voyage. \nHow will you proceed?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://fringerealities.wixsite.com/my-site/copy-of-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fringe Realities", "support_website_url": null, "website_url": "https://fringerealities.wixsite.com/my-site", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24839555055746137"}, "review_messages": []}]}, "cover_square_image": {"uri": "https
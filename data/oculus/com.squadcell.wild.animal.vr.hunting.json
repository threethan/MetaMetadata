/t64.5771-25/38982548_1999325547128322_2359855048317788001_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdgPhIvgaA0Q7kNvwHHEyBj&_nc_oc=Adpze40CJIcWWbNyOZTQxOFkAI1nrpDBnFRjolUqUf6LcZeZAvpCS9cftOYhKXJFblo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQULzJwO7DVcujPkBnLGbdiRGA_qEmQI0QRID4dMZTCKBQ&oe=6B0F1D14"}, {"file_name": "2560X1440_02.png", "id": "1594142981449554", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203615_1594142988116220_5261504339699403538_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tpygbt7EZIUQ7kNvwHbNLyx&_nc_oc=AdqmL-Z3rWTpqZhoBahAeG8lLN4_h8tFay7cTgmrA0t1Oq7KImEyt6SkXINWHHkZKIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCaMpGzmy40vzcFxgqrUoKEU0gMgthks0bGYfk-OcE2A&oe=6B0EEC60"}, {"file_name": "2560X1440_05.png", "id": "2238191173178676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035452_2238191176512009_5747981842467859759_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RU7qoC0SyhkQ7kNvwFijags&_nc_oc=Adr9ZAL8Wwk3Pz5WLjj-SQrO3lOcD9syZ42i9FD-J9TAD6MFXAL9baQSaRgGgC8_WnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWLhdnHw3_2QKo2dAw5EAEPPvrYvXYBaAgPTxN7qvT_vQ&oe=6B0F0145"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Animal_Hunt.png", "id": "351247857973900", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982554_351247864640566_69740848166528796_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPaFbIHT2pkQ7kNvwEzEeCB&_nc_oc=AdpQmLks8jEIEbWbYzJR2TQ7GBJL0fjCjMuLH6v8hizsP9SZM62m5UBmw5ETgbsbEo0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqfxgvb55BmSYUKGV-pvgkgtRfYU3_STVSiPsIwVPf_Q&oe=6B0F14DE"}, "display_name": "Wild Hunter VR", "keywords": [], "long_description": "Prepare for the ultimate hunting adventure in Wild Hunter VR! Step into the virtual wilderness and explore diverse landscapes teeming with wildlife, including graceful deer, elusive ducks, and powerful tigers.\n\nWith your VR headset on, immerse yourself in stunningly realistic environments, from dense forests to serene lakeshores. Track your prey using advanced tools and keen observation, whether you're patiently waiting in a duck blind or stalking a majestic deer through the underbrush.\n\nBut be warned, you're not alone in these wild lands. Majestic tigers roam the shadows, adding an extra layer of danger to your hunts. With their keen senses and lightning-fast reflexes, they'll keep you on your toes as you navigate the challenges of the wilderness.\n\nChoose your weapons wisely, from traditional bows to high-powered rifles, and adapt your strategy to each hunting scenario. Whether you prefer the thrill of a close-range encounter or the precision of a long-distance shot, Wild Hunter VR offers endless opportunities for excitement and adventure.\n\nExperience the thrill of the hunt like never before in Wild Hunter VR. The wild awaits \u2013 are you ready to test your skills and become the ultimate hunter?", "short_description": "Immerse yourself in the thrill of the hunt with Wild Hunt VR.\n\n\n\n"}]}, "developer_name": "Squad Cell", "developer_privacy_policy_url": "https://squadcell.com/frenzygamesstudios-privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Squad Cell", "support_website_url": null, "website_url": "https://squadcell.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUC
gM6jsVezV0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXpLL0G93r1FP2LI6No2IJg3yx30vUQCtspxg8Kw8HXw&oe=6ABA84FE"}, {"file_name": "SCREEN4.png", "id": "663160196483534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307370_663160199816867_6297554599890389273_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBDP_Aguz9sQ7kNvwFV3wSJ&_nc_oc=AdodyQFQb-7626pjs4ZRQxaD5KX00epYDz_A2t4DdvWQJCik-2f4KAum3wWpWXe4HGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7QPNQFsTdMAXP7RjOIqkeoQv9PVGfgi9RETcac1MxGQ&oe=6ABA5BDD"}, {"file_name": "SCREEN5.png", "id": "1034980578763554", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499292641_1034980585430220_4360221781292995774_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Juo5_YQIiVgQ7kNvwEzfQco&_nc_oc=AdrMa8JJYDzSzJapkL3Rwp8CdKxMgS2avXB0xja2hxZuZdORzj8QcoYGWPubNBTIOIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQdSl-EvyehyFFqfe0kHtaM4EnySFya1rYhETwlT-bTw&oe=6ABA7A6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "1810118946214212", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393856_1810118949547545_5444014341054817772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAGYSuEDv6cQ7kNvwGxHn-9&_nc_oc=Ado4FjfJEZ72CHQBUkwVyBosnPMzEmytoWd6gw9FsZEuFXXRbz22Bt7EXK_MPQ4p6Xo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEQ_voM2_CKgVqDfOMR9AtPbJgi6HGrL8nZkV_gTExRw&oe=6ABA7EA7"}, "display_name": "Zombie Students", "keywords": ["dead", "horror", "shooter", "fun", "action"], "long_description": "\ud83c\udfaf Zombie Students! A Math Survival VR Game! \ud83e\udde0\ud83d\udd2b\n\nStep into the eerie hallways of Zombie High, where education has taken a deadly turn. In Zombie Students, the walking undead are former students turned into brain-hungry zombies \u2014 but there's a twist. Each zombie staggers toward you with a math operation floating above their head (like 3 + 5), and multiple numbers plastered across their bodies.\n\nYour job? Solve the problem and shoot the correct number!\nGet it right \u2014 and the zombie is vaporized.\nGet it wrong \u2014 well, you'd better run!\n\nGreat for sharpening mental math skills under pressure", "short_description": "\ud83c\udfaf Zombie Students! A Math Survival VR Game! \ud83e\udde0\ud83d\udd2b\nIn Zombie Students, the walking undead are former students turned into brain-hungry zombies, but there's a twist. Each zombie staggers toward you with a math operation floating above their head"}]}, "developer_name": "Kdanss Games", "developer_privacy_policy_url": "https://www.biims.net/zombiestudents", "developer_terms_of_service_url": null, "publisher_name": "Kdanss Games", "support_website_url": null, "website_url": "https://www.biims.net/zombiestudents", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1043107547362485"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24282160031389623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499332231_1765995613956067_4367262971403305430_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E8SIadE1vAQ7kNvwFmG_Wf&_nc_oc=AdobsTeH9jAdEzLv2_zwMB9E2p1HkTbDrTKIaC35lGG1y9P2qvE5xvmbWneGB87hPIw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJf1_uvI0EkWg4dXbAx8cn_zz6P_kOyZL1sfWYH2mIkQ&o
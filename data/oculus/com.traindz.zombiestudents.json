I-6fpuzDeQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHN3jFBLXQg4UaQzR_veZDYoM3VdZ38tsAcwl0fUZoRQ&oe=6A7353FE"}, {"file_name": "SCREEN4.png", "id": "663160196483534", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307370_663160199816867_6297554599890389273_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlJcE_67kK8Q7kNvwGtvjBI&_nc_oc=Adr3iyH4nQMLJWMQTaMXwfaBzIA4pawV6U2Va7bTaL7buD3dB2lq_kpUhYmI44EwXkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6ZIA_i5YC0YC76Y4hdCpjrXuwEs6OKFp9o7lwHz2Fug&oe=6A732ADD"}, {"file_name": "SCREEN5.png", "id": "1034980578763554", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499292641_1034980585430220_4360221781292995774_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-q44Q7-0XMQ7kNvwEBwc5C&_nc_oc=AdpxWnEJaIvJLpsPvoBKy7QBmzMmqUKUYHFwfdbhNh7zftZwpHy7tL2HuHff-bpGgx0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgrukRSGKlI2_YX9B2OUsHJfbjQ73TKFt6aDDF0_2_7A&oe=6A73496B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "1810118946214212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393856_1810118949547545_5444014341054817772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb6s-LQgmVoQ7kNvwE8-2Rz&_nc_oc=AdrU6CX3eAo3cdVTiaEgzaINBJQGi3_itFi4H6YXMvmJCkm3k26xNkWTGlW0I9Pq1do&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQA4PfesPRHCXUPdXUX43lcVGkIRGWCx1_d65WK62_2w&oe=6A734DA7"}, "display_name": "Zombie Students", "keywords": ["dead", "horror", "shooter", "fun", "action"], "long_description": "\ud83c\udfaf Zombie Students! A Math Survival VR Game! \ud83e\udde0\ud83d\udd2b\n\nStep into the eerie hallways of Zombie High, where education has taken a deadly turn. In Zombie Students, the walking undead are former students turned into brain-hungry zombies \u2014 but there's a twist. Each zombie staggers toward you with a math operation floating above their head (like 3 + 5), and multiple numbers plastered across their bodies.\n\nYour job? Solve the problem and shoot the correct number!\nGet it right \u2014 and the zombie is vaporized.\nGet it wrong \u2014 well, you'd better run!\n\nGreat for sharpening mental math skills under pressure", "short_description": "\ud83c\udfaf Zombie Students! A Math Survival VR Game! \ud83e\udde0\ud83d\udd2b\nIn Zombie Students, the walking undead are former students turned into brain-hungry zombies, but there's a twist. Each zombie staggers toward you with a math operation floating above their head"}]}, "developer_name": "Kdanss Games", "developer_privacy_policy_url": "https://www.biims.net/zombiestudents", "developer_terms_of_service_url": null, "publisher_name": "Kdanss Games", "support_website_url": null, "website_url": "https://www.biims.net/zombiestudents", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1043107547362485"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24282160031389623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499332231_1765995613956067_4367262971403305430_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMemS2Hk02AQ7kNvwHZ5YnJ&_nc_oc=AdqyNEFOOepgzmIOVeCZPoyqwRLqV7s5xd-yiNRAT2W4Md1V12wnj-Y4Q4Hf5TfcJoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqA049TTH2yaYr2OpyS8UF0bwL_XGtoOIDZi-aWVq4Yg&o
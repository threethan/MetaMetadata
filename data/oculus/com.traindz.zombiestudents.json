_kq8a1J1O4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02xur0uZ6_LQIINQ9Qmq3gosU75qLcmQpAuVXx9WFC6A&oe=69DB7F3E"}, {"file_name": "SCREEN4.png", "id": "663160196483534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307370_663160199816867_6297554599890389273_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwCwZ86OTHkQ7kNvwFoatH5&_nc_oc=AdqhvfmNs_3-8zWpuZwyCmGZ8Vy5Wu2SMUmxitsYdMoWViZ3FTx_HWGrfm_KmN7gC9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1idFXIKG4FRB3oKDbNIA5S06q0Sipnzvmkyioay93izw&oe=69DB8E5D"}, {"file_name": "SCREEN5.png", "id": "1034980578763554", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499292641_1034980585430220_4360221781292995774_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q635U17VLZAQ7kNvwFuLUbn&_nc_oc=AdqRz52s7OV_DW2NcScH7hlEN66beIspFy1CTcji9ucF9QVWNE7nbITmrMr-oE51zCQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1obmm-9ivC5pyJTD-iVsaTwF7oU0zS0zmlcdO1b0-F_g&oe=69DBACEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "1810118946214212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393856_1810118949547545_5444014341054817772_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZwkA4u4-J0Q7kNvwELri40&_nc_oc=AdrY_NCNUSNd-MrMAaLSk0OVVtFevm7YJ3cMH5efGQvAcRxmw90FC2qsMKR4nvisrWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c6OdOUjGaR4IB7wMUTPpBpQ9duVR84fvur2qLCzhnsw&oe=69DBB127"}, "display_name": "Zombie Students", "keywords": ["dead", "horror", "shooter", "fun", "action"], "long_description": "\ud83c\udfaf Zombie Students! A Math Survival VR Game! \ud83e\udde0\ud83d\udd2b\n\nStep into the eerie hallways of Zombie High, where education has taken a deadly turn. In Zombie Students, the walking undead are former students turned into brain-hungry zombies \u2014 but there's a twist. Each zombie staggers toward you with a math operation floating above their head (like 3 + 5), and multiple numbers plastered across their bodies.\n\nYour job? Solve the problem and shoot the correct number!\nGet it right \u2014 and the zombie is vaporized.\nGet it wrong \u2014 well, you'd better run!\n\nGreat for sharpening mental math skills under pressure", "short_description": "\ud83c\udfaf Zombie Students! A Math Survival VR Game! \ud83e\udde0\ud83d\udd2b\nIn Zombie Students, the walking undead are former students turned into brain-hungry zombies, but there's a twist. Each zombie staggers toward you with a math operation floating above their head"}]}, "developer_name": "Kdanss Games", "developer_privacy_policy_url": "https://www.biims.net/zombiestudents", "developer_terms_of_service_url": null, "publisher_name": "Kdanss Games", "support_website_url": null, "website_url": "https://www.biims.net/zombiestudents", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1043107547362485"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24282160031389623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499332231_1765995613956067_4367262971403305430_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6m7gM_gsQgQ7kNvwFhBhvf&_nc_oc=AdoIv4oS75cZZrtJy1vRRRiTb5WXPPlsqiibq15dDGjqjkbz3zqEbToIBqXyJz73lGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xWST7Sbi4i3LgKR8X0WN2jcY20GAux_z4gjgGTnJuoA&o
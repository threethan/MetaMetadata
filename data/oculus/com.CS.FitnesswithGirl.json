e=6A9AEC50"}, {"file_name": "Scr_2.png", "id": "1432512751710342", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818852_1432512755043675_1422409952545984507_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCj9aaNJ5E0Q7kNvwEKtDOT&_nc_oc=AdrlY-o-89LZWauA42-GrCVuKE1g93ZeDu-7LLvR8RUMy2S4B5EBSk8GsNkPtuSqsig&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXi5jHwBABJMuTvd-UGGMYi5x_Zja9L2hnazYOmLRTaQ&oe=6A9AECC5"}, {"file_name": "Scr_3.png", "id": "1150085070438160", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824292_1150085073771493_2962792045543310774_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wY8fIK8rSdMQ7kNvwETv9Xr&_nc_oc=Adorlml7WxbYhNqP0K1eQ6D3hUTQck8Rxq0sENhoy-0QSOBz-Zeh-cX53vV3Jki1sL4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0L-SPhYP3GIvlNUIWkhQ22MSnnQhmZvSaAAR_Hteo8Q&oe=6A9AEA77"}, {"file_name": "Frame 26.png", "id": "1571846224727413", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/593858738_1571846228060746_2739416032527382518_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMqmJBWkHWsQ7kNvwFgUI4U&_nc_oc=Ado1myrF9ktXnWBsgO9O5EV6ztAmsdC-LwYMHcec8djLJX68Nm5SjByOogeLxQ0zPno&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNASXvVJCG_1YyaW9IgLmzZesK8oSisLNX1LZWzU_l8Q&oe=6A9AC991"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fitness with girls", "keywords": ["girl", "girls", "woman", "fitness", "gym"], "long_description": "Fitness VR: The Ultimate Immersive Workout\nStep into the most realistic fitness experience ever created. Fitness VR bridges the gap between gaming and reality, putting you in the center of a private gym with stunning environments and motivating coaches. Train alongside virtual trainers who motivate you to push your limits.\nKey Features:\nHyper-Realism: Experience 1-on-1 sessions with virtual coaches, creating an unmatched sense of presence and motivation.\nDiverse Workouts: Choose from a curated library of workouts, ranging from high-intensity HIIT and strength training to relaxing yoga and deep stretching.\nPrivate Atmosphere: Transform your living room into a premium fitness studio where you can focus on your goals without distractions.\nPersonalized Pace: Pick your favorite trainer and workout style to match your mood and energy level.\nDitch the standard gym. Get fit, stay motivated, and achieve your goals. Ready for your first set?", "short_description": "Experience the future of home workouts! Fitness VR brings you face-to-face with stunning fitness models in high-definition 360\u00b0 video. No more boring routines\u2014just pure motivation and immersive energy.\nGame Features:\nReal Coaches: Train with live-action video of beautiful trainers for a true 1-on-1 feel.\nUltimate Choice: Select from a library of sessions, from intense cardio to relaxing yoga.\nTotal Privacy: Your personal gym, available 24/7, right in your headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://monsterrush.online/Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cacao Mobile SP Z O O", "support_website_url": null, "website_url": "https://monsterrush.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26671663942451932"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.co
56CYQCZyvlySM-FcP8zuyK6P-I-CJaBibl8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3DL94Exb19D6tuDA6nB_wetGF8bkdp48pGy9ftzeHZw&oe=6AC3CF4F"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "1372697795052730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823259_1372697801719396_2156882901186734712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3X609bv0_cQ7kNvwHyEgLV&_nc_oc=Adq_CR35xnJqdFmJvbySncZ8lpsWL7tUjDcBsVYBkCZSFKf8gSPVXBxoRjUGUKeG7nI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCQ6WEjWih3aY3JlLeL3HIUpmjv-QU64RCGxCOJUIt2A&oe=6AC3DA1F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Collision", "keywords": ["gorilla", "collision", "project", "pc"], "long_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun.\n\n\ud83c\udfaf Key Game Features\n\n\u00b7 Unique Movement: Run, climb, and jump by physically swinging your arms and pushing off surfaces. There are no buttons or joysticks\u2014your body becomes the controller.\n\u00b7 Game Modes for Every Taste: From dynamic competitions to relaxed socializing. Take part in epic team battles in Paintbrawl mode or chase a personal goal in Hunt mode.\n\u00b7 Social Space: Beyond the games, you can simply chat and hang out with friends or new acquaintances in the dedicated non-competitive Casual mode.\n\u00b7 Freedom of Expression: Visit the in-game shop to purchase and wear various hats, glasses, clothing, and other cosmetic items.\n\n\ud83e\udd8d How to Play\n\nThe gameplay is based on intuitive movements:\n\n\u00b7 To run, swing your arms as if you were running in place.\n\u00b7 To jump, simply press your palms against the ground or any surface and push off.\n\u00b7 To climb a tree or ledge, grab onto it with both hands and pull yourself up.\n\nThese simple rules are easy to learn, but it takes practice to become a true parkour master in gorilla form.\n\n\ud83c\udf0d Game Worlds\n\nExplore diverse maps, play with friends, and have a blast.", "short_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun."}]}, "developer_name": "PC-DEV", "developer_privacy_policy_url": "https://docs.google.com/document/d/1V79n4yLR0YVi0e514Hal5yIGxjR3jszbwpDyYvmvumA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PC-DEV", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CSgkis75_xiJ7yLm4ZS4kHUJ4soUs84hfvwcSjOhBw4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1194786627061187"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1222320567641126", "version": "1.1.117"}, "id": "2324656481402710", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bi
cdn.com&_nc_ss=7f20f&oh=00_AQQw29EOHkOGatgsyXSVCX2jfnTjEi05nunoyvMKN8zUTw&oe=6B09AECF"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "1372697795052730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1372697801719396_2156882901186734712_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ii6ZzWcJE38Q7kNvwFYP5cg&_nc_oc=Adrdlp6VKy45zyk0EmtLWVD4rqxO4dkuX4btShzPhCizX3uBNquCoE4Vu9yzedVCtmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo70m9djHgXC-5htuoFmf1APEdercXj7gz9q2JG0qRpQ&oe=6B09B99F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Collision", "keywords": ["gorilla", "collision", "project", "pc"], "long_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun.\n\n\ud83c\udfaf Key Game Features\n\n\u00b7 Unique Movement: Run, climb, and jump by physically swinging your arms and pushing off surfaces. There are no buttons or joysticks\u2014your body becomes the controller.\n\u00b7 Game Modes for Every Taste: From dynamic competitions to relaxed socializing. Take part in epic team battles in Paintbrawl mode or chase a personal goal in Hunt mode.\n\u00b7 Social Space: Beyond the games, you can simply chat and hang out with friends or new acquaintances in the dedicated non-competitive Casual mode.\n\u00b7 Freedom of Expression: Visit the in-game shop to purchase and wear various hats, glasses, clothing, and other cosmetic items.\n\n\ud83e\udd8d How to Play\n\nThe gameplay is based on intuitive movements:\n\n\u00b7 To run, swing your arms as if you were running in place.\n\u00b7 To jump, simply press your palms against the ground or any surface and push off.\n\u00b7 To climb a tree or ledge, grab onto it with both hands and pull yourself up.\n\nThese simple rules are easy to learn, but it takes practice to become a true parkour master in gorilla form.\n\n\ud83c\udf0d Game Worlds\n\nExplore diverse maps, play with friends, and have a blast.", "short_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun."}]}, "developer_name": "PC-DEV", "developer_privacy_policy_url": "https://docs.google.com/document/d/1V79n4yLR0YVi0e514Hal5yIGxjR3jszbwpDyYvmvumA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PC-DEV", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CSgkis75_xiJ7yLm4ZS4kHUJ4soUs84hfvwcSjOhBw4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1194786627061187"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828104_1074210705044042_1491346687909639031_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dFSSkxTLy4Q7kNvwGi591k&_nc_oc=AdpyYu6VpjCrO5C3ljurOZAu7s7l_X9H4CKsIhBHZCPRKIxWQOjgBZ8Ir3nKSQmumpw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzDhrY7txwyLionWYbOnQSi5Lt
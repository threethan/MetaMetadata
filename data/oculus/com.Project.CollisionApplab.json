": [{"file_name": "Screenshot3FIX.png", "id": "1751797559277243", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823930_1751797562610576_914057546180646270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbgDk_YTXGwQ7kNvwGoJxSC&_nc_oc=Adr8rOWxd8LnxTidV3q3kEH3mrkiQ_qMkkFyMpCOx7WlztHrr9l5QO5XvEDqhthwqYM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId6hRmJ46HBO1E2Vxrfq86TLFGC7VH1ODG9yO8x0NLhA&oe=6A9C14B9"}, {"file_name": "Screenshot2FIX.png", "id": "2039430114114303", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825481_2039430117447636_3355871493159004429_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YddRth2xQIEQ7kNvwEZsULm&_nc_oc=AdpfiurXOqarVvowlbT3vSAfyobY0wuGU-Rr-mjLPpao7JZDAGjSSU7BKC84P-Bf1V0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA__57TPDqSlyKfuGgcGR2mUmNqcIA3bc7-BbKLrdpWw&oe=6A9C167E"}, {"file_name": "Screenshot4FIX.png", "id": "4581137535477161", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820914_4581137538810494_2492436386684484298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSQAOQtkXvcQ7kNvwFpuKC8&_nc_oc=AdobrU0nGimlEgdaGsqnsh9KTOTZCprgBprNOlFJnQGALA38VkMj8KjeYAj8JwPOZvY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1JyZbLYGnTD7zI5dtQoC7cp-aW7Xj21ZGfwFCxE1btw&oe=6A9C3040"}, {"file_name": "Screenshot5FIX.png", "id": "986297817764173", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825481_986297821097506_5882885779528009029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB90sNgGlN4Q7kNvwGcUzUj&_nc_oc=Ado2lfqfxGoS2XfxtRsC0ffL2yvVR-kHGI8ax_ws9qripP2D7vylzpi4pa7ZybZEfhc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7SQAITXlmQ9Uh-GyAl4_4nlKos9X4gtT4GSrkZyqeCw&oe=6A9C424F"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "1372697795052730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823259_1372697801719396_2156882901186734712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXqfN4bGT3UQ7kNvwHxbRPv&_nc_oc=AdqHJNUkuvO5-D79_VjEeom6QHOLa5VQZ5rhnemQDjxZcM3Eq5HFOW5QfbqofJqv8Ow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6RtmT6Mk9If5xXMrW-hMA8KutUPB6x7QWd5ZsSO8cyA&oe=6A9C14DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Collision", "keywords": ["gorilla", "collision", "project", "pc"], "long_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun.\n\n\ud83c\udfaf Key Game Features\n\n\u00b7 Unique Movement: Run, climb, and jump by physically swinging your arms and pushing off surfaces. There are no buttons or joysticks\u2014your body becomes the controller.\n\u00b7 Game Modes for Every Taste: From dynamic competitions to relaxed socializing. Take part in epic team battles in Paintbrawl mode or chase a personal goal in Hunt mode.\n\u00b7 Social Space: Beyond the games, you can simply chat and hang out with friends or new acquaintances in the dedicated non-competitive Casual mode.\n\u00b7 Freedom of Expression: Visit the in-game shop to purchase and wear various hats, glasses, clothing, and other cosmetic items.\n\n\ud83e\udd8d How to Play\n\nThe gameplay is based on intuitive movements:\n\n\u00b7 To run, swing your arms as if you were running in place.\n\u00b7 To jump, simply press your palms against the ground or any surface and push off.\n\u00b7 To climb a tree or ledge, grab onto it with both hands and pull yourself up.\n\nThese simple rules are easy to learn, but it takes practice to become a true parkour master in gorilla form.\n\n\ud83c\udf0d Game Worlds\n\nExplore diverse maps, play with friends, and have a blast.", "short_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun."}]}, "developer_name": "PC-DEV", "developer_privacy_policy_url": "https://docs.google.com/document/d/1V79n4yLR0YVi0e514Hal5yIGxjR3jszbwpDyYvmvumA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PC-DEV", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CSgkis75_xiJ7yLm4ZS4kHUJ4soUs84hfvwcSjOhBw4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1194786627061187"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828104_1074210705044042_1491346687909639031_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGF9ngmKZmQQ7kNvwFRzsCc&_nc_oc=AdoyVPfQrYTx7cgtJp21ZWxcZGWzfUWse-UIZp7AEes_QpeUhDzPGcuyf6zcCVixYho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzLd0QoLWrObDvJKhXfhTmAcxYQ1pNRVQJr0TeJc-oJQ&oe=6A9C3F33"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project Collision", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460
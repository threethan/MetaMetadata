": [{"file_name": "Screenshot3FIX.png", "id": "1751797559277243", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_1751797562610576_914057546180646270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FO9LV2bkGhoQ7kNvwGFIBpU&_nc_oc=AdoaEtGfVdAGuWRHprkGZLh9ZPiGzfzNbaPXbtAeCgmKydgqFelOeOyrb92l5SMTpYU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYe0HoqnolqsMx-wKR0scPLXZXF1becJmNChF26KYupA&oe=6AE0A2B9"}, {"file_name": "Screenshot2FIX.png", "id": "2039430114114303", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_2039430117447636_3355871493159004429_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2gmbGmksAkQ7kNvwGJm719&_nc_oc=AdqQvFUPAwxgpA8AD63Af_I1qUrr3NJzH2QCcEl3-GdXKU668dRJOjbszbFXWzcYxY8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUPqgCvGppjsZlOiTk1BRAM_OOnmIjZ426vQGWLWv6TQ&oe=6AE0A47E"}, {"file_name": "Screenshot4FIX.png", "id": "4581137535477161", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820914_4581137538810494_2492436386684484298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOJF0mpDtAAQ7kNvwHoBoKj&_nc_oc=AdpeXPyhsgpVXr3RQMn0Xrj61QQG0n_tCNKGdx7bkn2Op9u-yw1os8HBflGNLRt81Vg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQHgCi9d2v8tBO8rg79ZAz9RPeZt8RMXPOlk0BnX6Fhw&oe=6AE0BE40"}, {"file_name": "Screenshot5FIX.png", "id": "986297817764173", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_986297821097506_5882885779528009029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGv-uWu8UIYQ7kNvwFqJisa&_nc_oc=AdpReBzLXLi52SBtIHfqnI4sKvZvH6iyyZ17hhVO0-rN_6Fxo6Y22tQheg79bgX3P2w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7JuC8w8cRZDQ_TLpZul8ODRg1GyMw6kEjJhCMMReKBg&oe=6AE0980F"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "1372697795052730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_1372697801719396_2156882901186734712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6gMQDUYfRcQ7kNvwG3W_hU&_nc_oc=AdobGdCEjz1LIwtVNB7Cq35coRwi91pEscV0SSmUpiBXjmYGYmsvZ1Ie0QOURC0e-eI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWUOBm1gMkJjMAMG9wrgyAuD-hggk3ny67Q-tOrJn7zw&oe=6AE0A2DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Collision", "keywords": ["gorilla", "collision", "project", "pc"], "long_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun.\n\n\ud83c\udfaf Key Game Features\n\n\u00b7 Unique Movement: Run, climb, and jump by physically swinging your arms and pushing off surfaces. There are no buttons or joysticks\u2014your body becomes the controller.\n\u00b7 Game Modes for Every Taste: From dynamic competitions to relaxed socializing. Take part in epic team battles in Paintbrawl mode or chase a personal goal in Hunt mode.\n\u00b7 Social Space: Beyond the games, you can simply chat and hang out with friends or new acquaintances in the dedicated non-competitive Casual mode.\n\u00b7 Freedom of Expression: Visit the in-game shop to purchase and wear various hats, glasses, clothing, and other cosmetic items.\n\n\ud83e\udd8d How to Play\n\nThe gameplay is based on intuitive movements:\n\n\u00b7 To run, swing your arms as if you were running in place.\n\u00b7 To jump, simply press your palms against the ground or any surface and push off.\n\u00b7 To climb a tree or ledge, grab onto it with both hands and pull yourself up.\n\nThese simple rules are easy to learn, but it takes practice to become a true parkour master in gorilla form.\n\n\ud83c\udf0d Game Worlds\n\nExplore diverse maps, play with friends, and have a blast.", "short_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun."}]}, "developer_name": "PC-DEV", "developer_privacy_policy_url": "https://docs.google.com/document/d/1V79n4yLR0YVi0e514Hal5yIGxjR3jszbwpDyYvmvumA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PC-DEV", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CSgkis75_xiJ7yLm4ZS4kHUJ4soUs84hfvwcSjOhBw4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1194786627061187"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828104_1074210705044042_1491346687909639031_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59wic2QN6IQQ7kNvwHDFBKD&_nc_oc=Adoy6-_SluqLrF8am8W7rP8eGrirJqIuB3NBj83I9CYNzHk4G0VLVn44R0C1yOzqchM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMphXDxxGjN6TYDXaEzcsfFc0TV4Ks2_XG230hCKrTz3g&oe=6AE094F3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project Collision", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460
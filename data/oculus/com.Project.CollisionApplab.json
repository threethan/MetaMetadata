": [{"file_name": "Screenshot3FIX.png", "id": "1751797559277243", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1751797562610576_914057546180646270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRRQ-h0MWOIQ7kNvwEvzB4g&_nc_oc=AdrtyoeUsWric-9wGwgddjtFSbxxU6jo6UTF2VRfBTKATlohoDUD4aP5hQSrcARQ2QM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5MT7wjG1fVRl-Zx54s6Gf5yuaumwzMBufUnd9UzlSkw&oe=6AF1FE79"}, {"file_name": "Screenshot2FIX.png", "id": "2039430114114303", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825481_2039430117447636_3355871493159004429_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQg3QmamTIAQ7kNvwHAYwzj&_nc_oc=AdpmUyl4adRB7RW5xVoIRFUGceWdaKZ2khMmcwXqTAIaN3OOScK17IoBcmJpQpzP1Q8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj0a3GMJVWJdHKhzv_r2cmI1Spy0SRciM6xQ96cGB1-w&oe=6AF2003E"}, {"file_name": "Screenshot4FIX.png", "id": "4581137535477161", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820914_4581137538810494_2492436386684484298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kan7gqgBE-QQ7kNvwE4JLwZ&_nc_oc=Adr303q4OPTU31rO4eTOj2z0Ov2jrR8ECXBft9-M1CVLqTnOHLmrb4jy4wiBFfuXc7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR71V47Xoze_ZiStYQjyeUyJ0eIEIOBAvYo7g7mIu9_Tw&oe=6AF1E1C0"}, {"file_name": "Screenshot5FIX.png", "id": "986297817764173", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825481_986297821097506_5882885779528009029_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMu0pA1gyj4Q7kNvwE4VaiN&_nc_oc=AdqDUTPY-hCzM0nf5uAq5rxow-jJGJ3rbwKTGkzovukjiyscnIqxsDJ9oCUsnxA10kE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWygrdOaD-voYTuqpp6IAP8ryXSjvIobzCxxYkHiQzug&oe=6AF1F3CF"}, {"file_name": "SCREENSHOT 1 (FIXED).png", "id": "1372697795052730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823259_1372697801719396_2156882901186734712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOWHFNQqEkMQ7kNvwE7zG24&_nc_oc=AdqrdU13WHjc7x7Eg6qqJm4C6vTQfxY1mCkI1L8efRPxnjPwh2CgnY7kS0PsUEzAqbE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ5wBAk_WzsPW82Rm-DYUtOefxiQT72bOLY5F0Y2FeBw&oe=6AF1FE9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Collision", "keywords": ["gorilla", "collision", "project", "pc"], "long_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun.\n\n\ud83c\udfaf Key Game Features\n\n\u00b7 Unique Movement: Run, climb, and jump by physically swinging your arms and pushing off surfaces. There are no buttons or joysticks\u2014your body becomes the controller.\n\u00b7 Game Modes for Every Taste: From dynamic competitions to relaxed socializing. Take part in epic team battles in Paintbrawl mode or chase a personal goal in Hunt mode.\n\u00b7 Social Space: Beyond the games, you can simply chat and hang out with friends or new acquaintances in the dedicated non-competitive Casual mode.\n\u00b7 Freedom of Expression: Visit the in-game shop to purchase and wear various hats, glasses, clothing, and other cosmetic items.\n\n\ud83e\udd8d How to Play\n\nThe gameplay is based on intuitive movements:\n\n\u00b7 To run, swing your arms as if you were running in place.\n\u00b7 To jump, simply press your palms against the ground or any surface and push off.\n\u00b7 To climb a tree or ledge, grab onto it with both hands and pull yourself up.\n\nThese simple rules are easy to learn, but it takes practice to become a true parkour master in gorilla form.\n\n\ud83c\udf0d Game Worlds\n\nExplore diverse maps, play with friends, and have a blast.", "short_description": "Project Collision \u2014 is a multiplayer virtual reality game where you become a legless gorilla and interact with the world only through the movements of your hands. Break away from reality and immerse yourself in a world of simple, physically active fun."}]}, "developer_name": "PC-DEV", "developer_privacy_policy_url": "https://docs.google.com/document/d/1V79n4yLR0YVi0e514Hal5yIGxjR3jszbwpDyYvmvumA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "PC-DEV", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1CSgkis75_xiJ7yLm4ZS4kHUJ4soUs84hfvwcSjOhBw4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1194786627061187"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828104_1074210705044042_1491346687909639031_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWr_XIz7Mk8Q7kNvwGVWuuf&_nc_oc=AdpBFHHyJxOEnnLTboUtf8H-1ov1S46E-8gcfdiV1fcIgpcbJ9-k3B6AMm6GTwIr1ZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1Ecdmdo3kdTpM3_merSoOBDqQOuI_0jV_3O7TKEI7cA&oe=6AF1F0B3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project Collision", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460
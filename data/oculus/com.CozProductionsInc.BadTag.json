 all, explore and have fun in Bad Tag!", "short_description": "Bad Tag VR is a Hand-Based locomotion game with various maps and gamemodes."}]}, "developer_name": "coz", "developer_privacy_policy_url": "https://sites.google.com/view/badtagvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "coz", "support_website_url": null, "website_url": "https://sites.google.com/view/badtagvr/home?authuser=0", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8691306184221509"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982520_1131198658314335_1431810560175362135_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EawU9g_fPSgQ7kNvwHye1PZ&_nc_oc=AdnsVntu65S0Oed-whuBnaQT0h1aThDZLEcIcDU1cLfV2IHcgf0Bfza8Xc4IObzIU9M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwP7uvtJCsdmQPIm-6m8y2NC1FiCJajD3PRFyioWyy84w&oe=69BD52E7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bad Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1671748273, "lastRevision": {"nodes": [{"id": "6538647532820729", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"app
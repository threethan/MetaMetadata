ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1181761889963864_1861328126144077167_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVCgKtZhg1YQ7kNvwEKIfFr&_nc_oc=AdnIst6TRPOeSxWrHa5CHI3RhXv2oAJvgr0mJY_cNUtqkjh_724jhpaOYk6jbuCbShE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1_f2cWxjMg1P360587Yc1sdNIQX_cyERe4JQhTd0csQ&oe=69B2CFEA"}, {"file_name": "scrren5-gigapixel.png", "id": "1075951500960095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393450_1075951504293428_8677301279836180164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PktZhxsbL4Q7kNvwH6ciPs&_nc_oc=Adl6dWo9wWTIdCLURgA9ELmKQxNfa8TPBKgqR03VS8R6MyOp0D4P2__MLyQOolDqreA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0fnvWwsIhNAxSVsbw_1-gBHOvQW18VSK9axyehu0Xiw&oe=69B2ACD7"}, {"file_name": "scrreen6-gigapixel.png", "id": "1705891326663982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_1705891329997315_6854797555304381315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOchjujE79AQ7kNvwHcoKW7&_nc_oc=AdlITjDjE8zSzi99YcjuuW3Fx3DhuXxZNzUpauFDEDUfsXQIpiyeGO8p1hY6Y4KD5D4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwE0x03gpa86aAh6_ZhR_SZr6hDX9AqUHdlbD05U3md6Q&oe=69B2BBFB"}, {"file_name": "screen8-gigapixel.png", "id": "1015950523712643", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391986_1015950527045976_5643297361330918065_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5iyv1bHjE4Q7kNvwExf1F7&_nc_oc=AdkhrG1LX3PpPLxWFWzdC3fUpcSSNea7oSvL04lA_5rP9YCnk78vcvgFcGl_QdTj9-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTId093sS0pljFQCyv0wDezRZ9a9Wecgc0dvdthGhglQ&oe=69B2A68C"}, {"file_name": "Frame 85 (2).png", "id": "3446464315484780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_3446464318818113_6493831992126808035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6sZ4Pb3a2gQ7kNvwFzNCde&_nc_oc=AdmIHG8gLoRpK9bIAXB3vLFvXq9kuN8z8jXuFnSZKPdKNBuRi4hQD1gl-SgIUFR21qI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVt7DWZ6c6KjeIlthSUpcdmMgPTwThnRef4BPx9EXXcQ&oe=69B2ACAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Game - 2025-03-08T155745.494.png", "id": "946088974174490", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_946088977507823_3083774822136714315_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3AsIY0L5NsQ7kNvwFgsBhH&_nc_oc=AdlTsR39wqyn-oB-179CQO0YnuY8d2tT6DXgbSURamg9SABI_CG7-7n4Ez84yOt_StU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6YMG69ph2AKlPo-eS_UFIzBN4dLebUz7pSrBD3wZjtQ&oe=69B2B1FF"}, "display_name": "Alien Shooter", "keywords": ["shoot", "gun", "zombie", "spatial", "ops"], "long_description": "# **Alien Shooter: Transform Your Home Into an Interdimensional Battlefield!**\n\nBattle waves of challenging invaders with high-tech laser weapons in this thrilling immersive solo adventure! Level up weapons with gun upgrades!\n\n\n{935001668494068}\n\n\n## **Key Features:**\n\n- **Immersive Magic** \u2013 Portals open right in your home, blending real-world environments with virtual enemies and cosmic battles.\n\n- **Fast-Paced Combat** \u2013 Use laser-equipped weapons to take down enemies, dodge laser beams, and survive escalating waves of attacks.\n\n- **Diverse Arsenal** \u2013 Unlock and upgrade four unique weapons, including a revolver, tommy gun, grenade launcher, and shotgun, all enhanced with cutting-edge laser technology.\n\n- **Perks and Bonuses** \u2013 Customize your gameplay with powerful perks and earn bonus points to climb the leaderboard.\n\n- **Challenging Waves** \u2013 Tackle 40+ levels of increasing difficulty, featuring flying enemies, asteroid strikes, and laser-shooting foes.\n\n- **Global Leaderboard** \u2013 Compete with players worldwide for the highest score in single-session gameplay.\n\n- **Immersive Enemy Design** \u2013 Each enemy is uniquely animated, adding to the thrill as they flutter, zoom, and attack.\n\n{2838179406362066}", "short_description": "Transform your home into an interdimensional battlefield. Arm yourself with high-tech lasers, dodge incoming attacks, and conquer over 40 thrilling levels. Upgrade your arsenal, customize your strategy with unique perks, and climb the global leaderboard. Each enemy brings a new challenge\u2014can you survive the invasion?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2-privacy/", "developer_terms_of_service_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2/", "publisher_name": "Frame Sixty Labs, LLC", "support_website_url": null, "website_url": "https://framesixty.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29353907754196362"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393518_552435297858841_9008749266159931750_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyknyAxf3foQ7kNvwF4X3HI&_nc_oc=AdkGNgoIelPRrBB4fPIr5h4gjwXOCQPp9RlMG2h8-Phc6oXGzSvadfCHhYd1i1Hzs4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUimmKP0I07uqMXLBQFEKDg2W7ziu4sZj3ILhdZFz7pQ&oe=69B2C024"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Alien Shooter", "platform
c=AdlEUP77s9jhxmQvxhpte2se6pmuKz7ctv2pE0XPxNJuXLKAdkZbRDfbKhG9n9lMsbA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvEr9Pq2UZO6xEOTG95iBUvmFqVYK5kvDv5EGJbuV5Ydg&oe=699AEF30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Game (93).png", "id": "638449175307921", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391906_638449178641254_8198345118090531201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYU9O1w1tPkQ7kNvwGbqSMf&_nc_oc=AdlinFwPuQolu6wwc0vie4koQB0z73zrLUYvKiPL1Jfz4WHgEWVTroNbQdpkkTwi8EY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvtJalrLDr2EExQenIGjFRMHC0g19AJszsJPcOl53sz0Q&oe=699AFFD5"}, "display_name": "Astro Intruders", "keywords": ["fps", "shoot", "gun", "zombie", "spatial"], "long_description": "# **Astro Intruders: Transform Your Home Into an Interdimensional Battlefield!**\n\nTransform your living room into a mixed reality arena, battling waves of challenging invaders with high-tech laser weapons in this thrilling solo adventure.\n\n{935001668494068}\n\n\n## **Key Features:**\n\n- **Mixed Reality Magic** \u2013 Portals open right in your home, blending real-world environments with virtual enemies and cosmic battles.\n\n- **Fast-Paced Combat** \u2013 Use laser-equipped weapons to take down enemies, dodge laser beams, and survive escalating waves of attacks.\n\n- **Diverse Arsenal** \u2013 Unlock and upgrade four unique weapons, including a revolver, tommy gun, grenade launcher, and shotgun, all enhanced with cutting-edge laser technology.\n\n- **Perks and Bonuses** \u2013 Customize your gameplay with powerful perks and earn bonus points to climb the leaderboard.\n\n- **Challenging Waves** \u2013 Tackle 40+ levels of increasing difficulty, featuring flying enemies, asteroid strikes, and laser-shooting foes.\n\n- **Global Leaderboard** \u2013 Compete with players worldwide for the highest score in single-session gameplay.\n\n- **Immersive Enemy Design** \u2013 Each enemy is uniquely animated, adding to the thrill as they flutter, zoom, and attack.\n\n{2838179406362066}", "short_description": "Transform your home into an interdimensional battlefield where portals bring cosmic chaos right to your living room. Arm yourself with high-tech lasers, dodge incoming attacks, and conquer over 40 thrilling levels. Upgrade your arsenal, customize your strategy with unique perks, and climb the global leaderboard. Each enemy brings a new challenge\u2014can you survive the invasion? Prepare for an exhilarating mixed reality adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2-privacy/", "developer_terms_of_service_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2/", "publisher_name": "Frame Sixty Labs, LLC", "support_website_url": null, "website_url": "https://framesixty.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29029965456590595"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1223340302446380"}, {"status": "PUBLISHED", "id": "1728328911426180"}, {"status": "PUBLISHED", "id": "1504590620927686"}, {"status": "CANCELLED", "id": "1352312679125818"}, {"status": "PUBLISHED", "id": "1085708076197410"}]}, "baseline_offer": {"id": "1085708076197410"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time":
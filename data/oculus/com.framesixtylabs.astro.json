YVM0Q7kNvwG4HCFp&_nc_oc=AdoYWLn2UqlRvEwYku5XS2iSM7FYH4WsScIx_VLOIeUOxNsnhzAYx6x8DmCzCjwa7jM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2_R2wkLEx-xw48W5iuQoqCZ3QtbBg80KuX4_PcKaiVw&oe=6A57782B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Game - 2025-03-08T155745.494.png", "id": "946088974174490", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_946088977507823_3083774822136714315_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHINWlWaD_4Q7kNvwHqkMD4&_nc_oc=AdpwwugP0tVAK-mblRGGlbFVQhusWdgHT7VB1yp_FmJV8iRHRBoEB3Ua1YIAO8Fhdus&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6Iy2yLVt7zCxAo0Zh5rgp50wJSnWhfC9nS8rZh5b_WA&oe=6A577D7F"}, "display_name": "Alien Shooter", "keywords": ["shoot", "gun", "zombie", "spatial", "ops"], "long_description": "# **Alien Shooter: Transform Your Home Into an Interdimensional Battlefield!**\n\nBattle waves of challenging invaders with high-tech laser weapons in this thrilling immersive solo adventure! Level up weapons with gun upgrades!\n\n\n{935001668494068}\n\n\n## **Key Features:**\n\n- **Immersive Magic** \u2013 Portals open right in your home, blending real-world environments with virtual enemies and cosmic battles.\n\n- **Fast-Paced Combat** \u2013 Use laser-equipped weapons to take down enemies, dodge laser beams, and survive escalating waves of attacks.\n\n- **Diverse Arsenal** \u2013 Unlock and upgrade four unique weapons, including a revolver, tommy gun, grenade launcher, and shotgun, all enhanced with cutting-edge laser technology.\n\n- **Perks and Bonuses** \u2013 Customize your gameplay with powerful perks and earn bonus points to climb the leaderboard.\n\n- **Challenging Waves** \u2013 Tackle 40+ levels of increasing difficulty, featuring flying enemies, asteroid strikes, and laser-shooting foes.\n\n- **Global Leaderboard** \u2013 Compete with players worldwide for the highest score in single-session gameplay.\n\n- **Immersive Enemy Design** \u2013 Each enemy is uniquely animated, adding to the thrill as they flutter, zoom, and attack.\n\n{2838179406362066}", "short_description": "Transform your home into an interdimensional battlefield. Arm yourself with high-tech lasers, dodge incoming attacks, and conquer over 40 thrilling levels. Upgrade your arsenal, customize your strategy with unique perks, and climb the global leaderboard. Each enemy brings a new challenge\u2014can you survive the invasion?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2-privacy/", "developer_terms_of_service_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2/", "publisher_name": "Frame Sixty Labs, LLC", "support_website_url": null, "website_url": "https://framesixty.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29353907754196362"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393518_552435297858841_9008749266159931750_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaAF7PMbtdoQ7kNvwGjjM29&_nc_oc=AdrNAiNURZvWfPnikJEQ1Vk_0E329fTsP25fIbQzlV2lJI-muhI_LJxnDyjc7cg8M_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfEMBwpQYBqeYTpwBdlfmQpmeesvqV9xpV2owX0X5p_Q&oe=6A578BA4"}, "is_concept": false,
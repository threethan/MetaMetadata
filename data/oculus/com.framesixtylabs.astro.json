ps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1181761889963864_1861328126144077167_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijX3e3H_6DcQ7kNvwFc0fXX&_nc_oc=AdkfZX1kZEkdXsJxddOmDxzcgTXKpG5pYti0q0_VqiR_D2MPSOJmyINBtDZDVnEmKdY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftVWG4UwaXWu5zOOFeEN-Pj1CNk0wQvLQ4aufYIY99CLA&oe=69A80BAA"}, {"file_name": "scrren5-gigapixel.png", "id": "1075951500960095", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393450_1075951504293428_8677301279836180164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQ5mz0F13DQQ7kNvwHvPd_F&_nc_oc=AdnxAXS-EE5D2FkJ-dgf6SbVtsxk_Hx7yaEmLO6NEi2LpIcUAQr0lWrV-JUAsvayEhc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs7ygsOVlkss18Gq6SGZ34Wva8yZwTjjSCA-Q0SuXmLZw&oe=69A820D7"}, {"file_name": "scrreen6-gigapixel.png", "id": "1705891326663982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391974_1705891329997315_6854797555304381315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZaaPMrIHYUQ7kNvwH83dwP&_nc_oc=AdnVWHCTL8qv_ALH0lBiItNE4_Wo9lxz4r2zj-JzFBIWbvthxvG8-9T8_Y104Mp_fh0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft8RFe4Bq48yu3H5UwfBL_NkDT8zgUYTsrOEQV3T08vNg&oe=69A82FFB"}, {"file_name": "screen8-gigapixel.png", "id": "1015950523712643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391986_1015950527045976_5643297361330918065_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ex_OTu8u6HQQ7kNvwH8UFVW&_nc_oc=AdmnhDycwKKYwFDWC75DlITOw5qzk2kwRzxNnmuzcNc7CISNUjaHX7uRSL_BM22nlmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuYEBRynhMmm0FGmpDNPOPvxt74Vw1qg8qLvtlRpWRZOA&oe=69A81A8C"}, {"file_name": "Frame 85 (2).png", "id": "3446464315484780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_3446464318818113_6493831992126808035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBCgQqIgFDcQ7kNvwFB50VE&_nc_oc=Adlr6QQ4Yma7MXOIRTp55oVj7QwCGIfiqZO4urs07nPZBHOCqKsTXkcDMDyIiGJRNnc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftHbzsaqnQrSCsP_VmWyUi1ggsTCP3pKlm67ldUqNrr-g&oe=69A820AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Game - 2025-03-08T155745.494.png", "id": "946088974174490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_946088977507823_3083774822136714315_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izitoHEiY1EQ7kNvwFAUPaR&_nc_oc=AdkREG-UCJxr1sd_oDaRGj2gSyH9I66SEZ-U2R__qUg-htLR4WxMsP3g1A2ozXzE814&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuQtefUfHexkIdK8_I2HnELlw_ibeLfFbm5PTMAktYcHg&oe=69A825FF"}, "display_name": "Alien Shooter", "keywords": ["shoot", "gun", "zombie", "spatial", "ops"], "long_description": "# **Alien Shooter: Transform Your Home Into an Interdimensional Battlefield!**\n\nBattle waves of challenging invaders with high-tech laser weapons in this thrilling immersive solo adventure! Level up weapons with gun upgrades!\n\n\n{935001668494068}\n\n\n## **Key Features:**\n\n- **Immersive Magic** \u2013 Portals open right in your home, blending real-world environments with virtual enemies and cosmic battles.\n\n- **Fast-Paced Combat** \u2013 Use laser-equipped weapons to take down enemies, dodge laser beams, and survive escalating waves of attacks.\n\n- **Diverse Arsenal** \u2013 Unlock and upgrade four unique weapons, including a revolver, tommy gun, grenade launcher, and shotgun, all enhanced with cutting-edge laser technology.\n\n- **Perks and Bonuses** \u2013 Customize your gameplay with powerful perks and earn bonus points to climb the leaderboard.\n\n- **Challenging Waves** \u2013 Tackle 40+ levels of increasing difficulty, featuring flying enemies, asteroid strikes, and laser-shooting foes.\n\n- **Global Leaderboard** \u2013 Compete with players worldwide for the highest score in single-session gameplay.\n\n- **Immersive Enemy Design** \u2013 Each enemy is uniquely animated, adding to the thrill as they flutter, zoom, and attack.\n\n{2838179406362066}", "short_description": "Transform your home into an interdimensional battlefield. Arm yourself with high-tech lasers, dodge incoming attacks, and conquer over 40 thrilling levels. Upgrade your arsenal, customize your strategy with unique perks, and climb the global leaderboard. Each enemy brings a new challenge\u2014can you survive the invasion?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2-privacy/", "developer_terms_of_service_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2/", "publisher_name": "Frame Sixty Labs, LLC", "support_website_url": null, "website_url": "https://framesixty.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29353907754196362"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393518_552435297858841_9008749266159931750_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XUmwz--ob8Q7kNvwFPBg8r&_nc_oc=Admr_O6rTY76a3ZW65ietqzxnxVF-IqpoWUhCX7aSxqc2XdVPhS2gYUcetz9pdntjRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvQ3NE6TxFldRVA8I6TsVlyK5-ae8hu01R8iNrEgZKKJQ&oe=69A83424"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Alien Shooter", "platform
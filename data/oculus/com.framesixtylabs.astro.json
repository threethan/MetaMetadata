783_1140456324491373_5075609557800218315_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csk2SEcr3k8Q7kNvwGpusH8&_nc_oc=AdqWGHLIYA4QWoUDN3PiQVsptipiQQqkBXKsSEIpEqdwA8g5Nerq6i3gbqwIQ0Ucc1I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLaGUVwlPENjX3upcykcl5WjBv4uI5vQfzYLCXJxTn4w&oe=6ABA647D"}, {"file_name": "Screenshot_2.png", "id": "588919083760829", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393351_588919087094162_6265043631596004728_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaw1LEACak8Q7kNvwEFOjJc&_nc_oc=AdqfQxCs1CR3-6xvOo2_RiNbPALyw4P3QOQGc7Ee_uShDRa_-kUL0_xU3NjHGg8nYB4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNeJ-vOCv9bC_Y9VvRzm6H6hgAJEvzIeoD_70tFHiagw&oe=6ABA8E70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Game (93).png", "id": "638449175307921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391906_638449178641254_8198345118090531201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crQK9FtZIaIQ7kNvwH3fvmS&_nc_oc=AdqZi3cF263CZFQStYLeKu9sVf9KyMtqKwgxWfuwOOK3woQ3FqHVsxP3u424x6noIkc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuINZjwhy0HGI1kxRVqljZa9UNmgH3_CgG5nwmj-tYlQ&oe=6ABA66D5"}, "display_name": "Astro Intruders", "keywords": ["fps", "shoot", "gun", "zombie", "spatial"], "long_description": "# **Astro Intruders: Transform Your Home Into an Interdimensional Battlefield!**\n\nTransform your living room into a mixed reality arena, battling waves of challenging invaders with high-tech laser weapons in this thrilling solo adventure.\n\n{935001668494068}\n\n\n## **Key Features:**\n\n- **Mixed Reality Magic** \u2013 Portals open right in your home, blending real-world environments with virtual enemies and cosmic battles.\n\n- **Fast-Paced Combat** \u2013 Use laser-equipped weapons to take down enemies, dodge laser beams, and survive escalating waves of attacks.\n\n- **Diverse Arsenal** \u2013 Unlock and upgrade four unique weapons, including a revolver, tommy gun, grenade launcher, and shotgun, all enhanced with cutting-edge laser technology.\n\n- **Perks and Bonuses** \u2013 Customize your gameplay with powerful perks and earn bonus points to climb the leaderboard.\n\n- **Challenging Waves** \u2013 Tackle 40+ levels of increasing difficulty, featuring flying enemies, asteroid strikes, and laser-shooting foes.\n\n- **Global Leaderboard** \u2013 Compete with players worldwide for the highest score in single-session gameplay.\n\n- **Immersive Enemy Design** \u2013 Each enemy is uniquely animated, adding to the thrill as they flutter, zoom, and attack.\n\n{2838179406362066}", "short_description": "Transform your home into an interdimensional battlefield where portals bring cosmic chaos right to your living room. Arm yourself with high-tech lasers, dodge incoming attacks, and conquer over 40 thrilling levels. Upgrade your arsenal, customize your strategy with unique perks, and climb the global leaderboard. Each enemy brings a new challenge\u2014can you survive the invasion? Prepare for an exhilarating mixed reality adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2-privacy/", "developer_terms_of_service_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2/", "publisher_name": "Frame Sixty Labs, LLC", "support_website_url": null, "website_url": "https://framesixty.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
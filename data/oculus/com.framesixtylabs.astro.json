ps://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391924_1181761889963864_1861328126144077167_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHdbZuBpGK8Q7kNvwFHojii&_nc_oc=AdlYYM1ktY9zSuTd86PqhXsv6wdzG_DWzASg3KsZueSP2BepuK_clW7cQrOqsnXTtfo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfynGRJum3J5luh-33t3mCxvAlK68kHtsk72xo4FwL6FKw&oe=69BEAD6A"}, {"file_name": "scrren5-gigapixel.png", "id": "1075951500960095", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393450_1075951504293428_8677301279836180164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kg_BSEj6pMQ7kNvwF6mm3T&_nc_oc=Adnr8Cm0T-KtzGQ5UK-EPOfCLrmud5_s-pp11vPUUvq9uR0cmBmfU4JqBJESHFoSrnU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaOSS8DITqNpwGus6Wv6NtrU4Br5pbY2Zy46_ZZ-NjDA&oe=69BE8A57"}, {"file_name": "scrreen6-gigapixel.png", "id": "1705891326663982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391974_1705891329997315_6854797555304381315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZimNCqIrp6wQ7kNvwGNfPu0&_nc_oc=AdmrIfseHfvl2II_exZvP9_1_JvTq_y4f3aYeIjmplk0siGHdEGo-rrKhzPI5UWTZpk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzthCHnLIHgOyNftuzEly-AFIkq9E-MC3LJOtaQr2lGwQ&oe=69BE997B"}, {"file_name": "screen8-gigapixel.png", "id": "1015950523712643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391986_1015950527045976_5643297361330918065_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4QGEMGc1JYQ7kNvwGtwrfm&_nc_oc=Adlgu0KHB5Feb-Q0KuD2tYS2DIsCvdjzJq3yo3pydlLJNTIWE3JwGvxNz3_EB9U-Pu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw11itqlim4PeZAbTRcom63GLbe4AEO7_82Pr1edu6vhA&oe=69BE840C"}, {"file_name": "Frame 85 (2).png", "id": "3446464315484780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_3446464318818113_6493831992126808035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1w8fes7tEIQ7kNvwFXbAxB&_nc_oc=Adm0WgU2mqaMQBZ0C-iOqp04HMezrU8jdjuHlzE7OlvjFxf2Rbh6CMlX6Y7aJ4so4vY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-pk0LD4idRLVs-3rnBrkMQxPzv06Wz8BvYD2-ZuZ58g&oe=69BE8A2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Game - 2025-03-08T155745.494.png", "id": "946088974174490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392305_946088977507823_3083774822136714315_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Q13OkYffXoQ7kNvwFeV5-i&_nc_oc=AdlJyEyll1daF21dgJJ1OYSKGRvyeo-7uK7Je-a3XCgrqOdY77gudQDuXtIPF6ZZ0jg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCgPXA15Gp-7GpsKsjF7bVmME8OtMZAxT9F2VTjhdjbQ&oe=69BE8F7F"}, "display_name": "Alien Shooter", "keywords": ["shoot", "gun", "zombie", "spatial", "ops"], "long_description": "# **Alien Shooter: Transform Your Home Into an Interdimensional Battlefield!**\n\nBattle waves of challenging invaders with high-tech laser weapons in this thrilling immersive solo adventure! Level up weapons with gun upgrades!\n\n\n{935001668494068}\n\n\n## **Key Features:**\n\n- **Immersive Magic** \u2013 Portals open right in your home, blending real-world environments with virtual enemies and cosmic battles.\n\n- **Fast-Paced Combat** \u2013 Use laser-equipped weapons to take down enemies, dodge laser beams, and survive escalating waves of attacks.\n\n- **Diverse Arsenal** \u2013 Unlock and upgrade four unique weapons, including a revolver, tommy gun, grenade launcher, and shotgun, all enhanced with cutting-edge laser technology.\n\n- **Perks and Bonuses** \u2013 Customize your gameplay with powerful perks and earn bonus points to climb the leaderboard.\n\n- **Challenging Waves** \u2013 Tackle 40+ levels of increasing difficulty, featuring flying enemies, asteroid strikes, and laser-shooting foes.\n\n- **Global Leaderboard** \u2013 Compete with players worldwide for the highest score in single-session gameplay.\n\n- **Immersive Enemy Design** \u2013 Each enemy is uniquely animated, adding to the thrill as they flutter, zoom, and attack.\n\n{2838179406362066}", "short_description": "Transform your home into an interdimensional battlefield. Arm yourself with high-tech lasers, dodge incoming attacks, and conquer over 40 thrilling levels. Upgrade your arsenal, customize your strategy with unique perks, and climb the global leaderboard. Each enemy brings a new challenge\u2014can you survive the invasion?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2-privacy/", "developer_terms_of_service_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2/", "publisher_name": "Frame Sixty Labs, LLC", "support_website_url": null, "website_url": "https://framesixty.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29353907754196362"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393518_552435297858841_9008749266159931750_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqJm5zDFva8Q7kNvwGFfyf3&_nc_oc=AdkhxRHs2OMNhv86mK7rS6jbBuo1qTQeD1pkPfin76QaZvLgjaq6SFxRJIiwGkUhQq4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnVqPktajTPrxPubnibi2IFtZV1xzyMgdzSNsI56UzWg&oe=69BE9DA4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Alien Shooter", "platform
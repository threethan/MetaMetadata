ps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1181761889963864_1861328126144077167_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKgD9ZYYbe8Q7kNvwEGLc9f&_nc_oc=Adk2SyCb3trp1SGDmfnpJSP8auX_4DOAr2GV62CSbzFagjW4HsILdDLv-LJ3E9nxCpo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfJ0E3g64KXKIseO4uLu7_GxjQzrpRGn8XSnaRehjTeQ&oe=69AD89EA"}, {"file_name": "scrren5-gigapixel.png", "id": "1075951500960095", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393450_1075951504293428_8677301279836180164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNsovaA9n8EQ7kNvwGRSV-k&_nc_oc=Adljpoh4DDsmHebLiyjfqtrjciaVAeMUW43wauSN2H0aoiInVja8iNdMpZcAERpl2Qw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDeIdNLoTCn6GbgwiMX-x8Y-6MvuJIaGwCmTPJIj1YqA&oe=69AD66D7"}, {"file_name": "scrreen6-gigapixel.png", "id": "1705891326663982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391974_1705891329997315_6854797555304381315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cgtn_-fJQz0Q7kNvwHbgWV9&_nc_oc=Adn_K7eStBISdCMNP9UYtGJ_5c0SjLouW623lsPCsmcOhoHbmyymr4VIA58fa7IIHEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxiq-8CpuOz35H1T3RKx8SJiOGKIuD_ZMoHZfu7eaWJEQ&oe=69AD75FB"}, {"file_name": "screen8-gigapixel.png", "id": "1015950523712643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391986_1015950527045976_5643297361330918065_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=We6iqwux_YsQ7kNvwHkKBjh&_nc_oc=AdmTM4Z6icHTfgw9nD3rMYgafDMmmeqf7Y2QSamwpFWpND3Odm2CxJhbq-D88pjihas&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqVx94Z2y9kRF9RAUmISjdIxppgkgdTcjNAEyzLvYcOA&oe=69AD608C"}, {"file_name": "Frame 85 (2).png", "id": "3446464315484780", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_3446464318818113_6493831992126808035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRP0QoeA3fYQ7kNvwEtszkR&_nc_oc=AdkjuflD6TIX6DQwXJEY2hXuXOKIl2p2Ib931puruZZ3KaQJF95zRUnsJDuAxuF48ho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfySgoZNJwjAxCd4PYWfdqdWHf-yW-exMXxHzlHfZ0QTBQ&oe=69AD66AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Game - 2025-03-08T155745.494.png", "id": "946088974174490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392305_946088977507823_3083774822136714315_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDR8CVTLiw8Q7kNvwHHpNOU&_nc_oc=AdnYQ7W15UWiFkrNEJAsaYnc1V1NH126Uo2ojSDFiY2zTiUVYlm8vQzJ29MCEKQg7Ys&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwfxFDkCHcea8AJyZqP6e1LEB1msMLBRQckD-9Ysgc7g&oe=69AD6BFF"}, "display_name": "Alien Shooter", "keywords": ["shoot", "gun", "zombie", "spatial", "ops"], "long_description": "# **Alien Shooter: Transform Your Home Into an Interdimensional Battlefield!**\n\nBattle waves of challenging invaders with high-tech laser weapons in this thrilling immersive solo adventure! Level up weapons with gun upgrades!\n\n\n{935001668494068}\n\n\n## **Key Features:**\n\n- **Immersive Magic** \u2013 Portals open right in your home, blending real-world environments with virtual enemies and cosmic battles.\n\n- **Fast-Paced Combat** \u2013 Use laser-equipped weapons to take down enemies, dodge laser beams, and survive escalating waves of attacks.\n\n- **Diverse Arsenal** \u2013 Unlock and upgrade four unique weapons, including a revolver, tommy gun, grenade launcher, and shotgun, all enhanced with cutting-edge laser technology.\n\n- **Perks and Bonuses** \u2013 Customize your gameplay with powerful perks and earn bonus points to climb the leaderboard.\n\n- **Challenging Waves** \u2013 Tackle 40+ levels of increasing difficulty, featuring flying enemies, asteroid strikes, and laser-shooting foes.\n\n- **Global Leaderboard** \u2013 Compete with players worldwide for the highest score in single-session gameplay.\n\n- **Immersive Enemy Design** \u2013 Each enemy is uniquely animated, adding to the thrill as they flutter, zoom, and attack.\n\n{2838179406362066}", "short_description": "Transform your home into an interdimensional battlefield. Arm yourself with high-tech lasers, dodge incoming attacks, and conquer over 40 thrilling levels. Upgrade your arsenal, customize your strategy with unique perks, and climb the global leaderboard. Each enemy brings a new challenge\u2014can you survive the invasion?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2-privacy/", "developer_terms_of_service_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2/", "publisher_name": "Frame Sixty Labs, LLC", "support_website_url": null, "website_url": "https://framesixty.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29353907754196362"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393518_552435297858841_9008749266159931750_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzvsTwdhR5EQ7kNvwEw6iIc&_nc_oc=AdlvaxQcWFTUBXv4r6pkasGBGc8kVY7yt87FAktW6HC7GjC0wuy14PoWvE9JpHx5tgg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfybhM6YjaayezYo8qZ1QmWEy30RjZfbLWzoqDeRFOQlmw&oe=69AD7A24"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Alien Shooter", "platform
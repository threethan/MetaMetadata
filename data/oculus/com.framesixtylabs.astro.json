ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1181761889963864_1861328126144077167_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVCgKtZhg1YQ7kNvwFKb1Yz&_nc_oc=AdmmuZWEoPyXtzI7tHdwS5itvDzj54DRE1yWtGO80om1vjiddoqrHjts5Z2eYQB85aM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwok7bymM2XuoRD28tQzmNN0OAR9_5dpaPFdO1ELYCqVw&oe=69B4216A"}, {"file_name": "scrren5-gigapixel.png", "id": "1075951500960095", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393450_1075951504293428_8677301279836180164_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PktZhxsbL4Q7kNvwHGstgR&_nc_oc=AdkA2YwhG4z32fkoegM-1sP2Sxj11ezCjG3cao72GboHKUfKbU8TCBRJrUWiSKQCSV8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz5Qjv_pI74QYhJw6Df1puKWv5Z8UI_0ifycALVMdXd9A&oe=69B3FE57"}, {"file_name": "scrreen6-gigapixel.png", "id": "1705891326663982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_1705891329997315_6854797555304381315_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJSzACoAviQQ7kNvwHRjp4B&_nc_oc=Admai_FO-Aqs-E1fKuHqnZ0muKtoAwcVKIOKeb95XdoSF7BIaJzY7-x1f0rg8FQPrzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZFTbVJclAfKS0Tv_mZJMJJdSCTXcp7wBB8q6gc_nD5w&oe=69B40D7B"}, {"file_name": "screen8-gigapixel.png", "id": "1015950523712643", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391986_1015950527045976_5643297361330918065_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5iyv1bHjE4Q7kNvwHNEXcS&_nc_oc=Adk-VfFz-LtLgRioLzyi7EtR0cbgW6bU-iQZYOq4wPakL39I2NqpbCrPZmSkrPtUK94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwcsr9tEU5xnFNEk0FnR4E3unriO_xohlOllPoakYMVNQ&oe=69B3F80C"}, {"file_name": "Frame 85 (2).png", "id": "3446464315484780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_3446464318818113_6493831992126808035_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFNAPdeloIcQ7kNvwGTvEni&_nc_oc=AdkxYjN4Lts1HqJl2Dew66fU0P3F_iLiRkMmUOwPGjOhnngiBvvwgu6kqQijouyvFUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkZfifkEn2SHj12ToEKJhWEkZe364C88UMKsnop48TcA&oe=69B3FE2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Game - 2025-03-08T155745.494.png", "id": "946088974174490", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392305_946088977507823_3083774822136714315_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPRI4J06MtMQ7kNvwHgc4Da&_nc_oc=AdlyF33NLyudq_RXAR6NB0OsAmZMU0kDLGDP7E5KxO-N0dxuW2THZNYkiXfy50waqnU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIo-lqnwSATqSUMmVx7kHMHhMTkpohYFAk2uJQWV0X1g&oe=69B4037F"}, "display_name": "Alien Shooter", "keywords": ["shoot", "gun", "zombie", "spatial", "ops"], "long_description": "# **Alien Shooter: Transform Your Home Into an Interdimensional Battlefield!**\n\nBattle waves of challenging invaders with high-tech laser weapons in this thrilling immersive solo adventure! Level up weapons with gun upgrades!\n\n\n{935001668494068}\n\n\n## **Key Features:**\n\n- **Immersive Magic** \u2013 Portals open right in your home, blending real-world environments with virtual enemies and cosmic battles.\n\n- **Fast-Paced Combat** \u2013 Use laser-equipped weapons to take down enemies, dodge laser beams, and survive escalating waves of attacks.\n\n- **Diverse Arsenal** \u2013 Unlock and upgrade four unique weapons, including a revolver, tommy gun, grenade launcher, and shotgun, all enhanced with cutting-edge laser technology.\n\n- **Perks and Bonuses** \u2013 Customize your gameplay with powerful perks and earn bonus points to climb the leaderboard.\n\n- **Challenging Waves** \u2013 Tackle 40+ levels of increasing difficulty, featuring flying enemies, asteroid strikes, and laser-shooting foes.\n\n- **Global Leaderboard** \u2013 Compete with players worldwide for the highest score in single-session gameplay.\n\n- **Immersive Enemy Design** \u2013 Each enemy is uniquely animated, adding to the thrill as they flutter, zoom, and attack.\n\n{2838179406362066}", "short_description": "Transform your home into an interdimensional battlefield. Arm yourself with high-tech lasers, dodge incoming attacks, and conquer over 40 thrilling levels. Upgrade your arsenal, customize your strategy with unique perks, and climb the global leaderboard. Each enemy brings a new challenge\u2014can you survive the invasion?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2-privacy/", "developer_terms_of_service_url": "https://framesixty.com/terms-and-conditions-astro-intruders-v2/", "publisher_name": "Frame Sixty Labs, LLC", "support_website_url": null, "website_url": "https://framesixty.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29353907754196362"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393518_552435297858841_9008749266159931750_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEgUi_BQdQkQ7kNvwHgwoV9&_nc_oc=AdmId_e5o-WAxCaky9cq2rygASWWkmgLhvT0YbgUU4sh8x1_RXDuaUY90AtLDTT4g6U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9i1RZHCgd8oeqoL8pbg4aoEGCpXeBZvcGjFxWFWJnAA&oe=69B411A4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Alien Shooter", "platform
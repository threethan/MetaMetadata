33393_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mxxdnL-C0gQ7kNvwEVBeYB&_nc_oc=AdrYMsONBeVAr_4IUravxFb5tK4-Yay7UMqRLv6gQg6vkOhtn_k-AAnRual9qK5wFRk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUNRx3mA_XVL-h1DyeHmrWZfvUzKaBO7Nm7lj5PedyUw&oe=6A6DFA2B"}, {"file_name": "Level 2-2.png", "id": "2076997383151610", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821782_2076997389818276_2621023907090167604_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5F1dsNWxSvYQ7kNvwEuC16g&_nc_oc=Adp4oAl4Ue5Vuk_2nRyABUUWp2sgDyj9nPOFNdSnezWKaDGKXI-5Ducuy3zrEC18Rqo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC25LT8D83VbvXKECukCUQkNK4_AydtzLgqiBmQleJkrA&oe=6A6DEF3D"}, {"file_name": "Level 4-3 RESIZED.png", "id": "2148167172382029", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819859_2148167175715362_3935357651198051741_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvvGT_RjdUQQ7kNvwFL6yWR&_nc_oc=AdqCGVkhf5avcUckqhbHxUfNKJlxxf3BQvMuX3KHSQDlTCwdazOhAvQzHSNyHBMUd5w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfYAFEQIKBqN08M2-sxBG33aP91hGeOkQBViJelMvxCA&oe=6A6DD84E"}, {"file_name": "Level 6-3.png", "id": "1561116975105624", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825345_1561116981772290_345956733405517056_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKzHRITW-8YQ7kNvwHkMyIT&_nc_oc=AdqXITy56c4mIRGk4F6eLOIET1SME6ItoRPo_GKZBNsuM9NIUk8ed4AWEMJ1w4Z28IU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdYc_xVmRhaNFOIAVNDNNe3MG3cJhHN9Y2FloDHjqBiQ&oe=6A6DFE60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Kynetik Cover 2.png", "id": "1382601690313293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818885_1382601696979959_7251445562830774563_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHL-ZRdsq24Q7kNvwEqIV7i&_nc_oc=Adpv9ltb0qoFtpV0CSw3ef2M7jowsGxVPTccjpKc8Lcboj3_nk4GaIW4nHDpNHGJT_M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNWo_7uJ4-KBf3II-fuMx5Ndd0dkziyoXA9x5rXxUukA&oe=6A6DDD5F"}, "display_name": "KYNETIK", "keywords": ["Hands", "Shooter", "Scifi", "Futuristic", "Combat"], "long_description": "Step into the future of movement.\nKynetik is a sci-fi hand-tracking wave shooter that transforms your body into a weapon of energy and speed. Using nothing but your hands, unleash powerful blasts, deflect enemy fire, and crush waves of rogue robots in fast, rhythm-like combat arenas.\n\nDesigned for fun, fitness, and flow, Kynetik keeps you on your toes with evolving challenges and dynamic environments that react to your every move. Every punch, dodge, and blast strengthens your reflexes and stamina \u2014 no controllers, no limits.\n\nWhether you\u2019re looking for a quick energy burst or an intense full-body session, Kynetik delivers instant action, glowing visuals, and pure motion satisfaction.\n\nFeatures:\n\n\u26a1 Hand-Tracked Combat: Feel the thrill of shooting, blocking, and dodging using only your hands.\n\n\ud83e\udd16 Wave-Based Action: Face waves of robots that get faster, smarter, and more intense.\n\n\ud83c\udfcb\ufe0f\u200d\u2642\ufe0f Fitness Through Fun: Burn calories while fighting in fluid, high-energy sessions.\n\n\ud83c\udf0c Futuristic Arenas: Immerse yourself in glowing sci-fi worlds powered by motion and light.\n\n\ud83c\udfaf Easy to Play, Hard to Master: Perfect for both casual and competitive players.", "short_description": "Kynetik is a sci-fi hand-tracking wave shooter that turns movement into power. Blast enemy robots with pure energy from your hands, dodge attacks, and push your reflexes to the limit in a fast-paced, hyper-casual fitness experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.mixeal.com/Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "https://www.mixeal.com/", "category": null, "comfort_rati
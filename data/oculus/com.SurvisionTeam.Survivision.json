ps://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604366035_1432985085675010_7925446619426464843_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cuR9ySmH8oQ7kNvwHziLU8&_nc_oc=AdpLqY9aaJGL2NaP3Fkv5xu3vB4uh3R2kBCBVL8lXmOPJC-3dPEzZ-FL8lnS9Lwscjw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi2H8NCLzEyY8cL7JDKI0_chh6UzBQ9PXeiV9ZVY8QdA&oe=6AF9B9C7"}]}, "id": "1153573377247422", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_3_Dogfight_2560x1440.png", "id": "29358031327133895", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/595129854_29358031330467228_3169016941393679858_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEdYcQnfKFUQ7kNvwGc88Av&_nc_oc=AdoHT-CV8KYzkRf-e5d9ZKXJCFUJTk4pS82wRSgjHj-0JX21PhXSc-GuDhekVOWeYWU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjAgp5tIPvvaWvoFHN92e0Mznd3hHZzBwq7NyRsSumoA&oe=6AF9CCE4"}, {"file_name": "Screenshot_4_Race_2560x1440.png", "id": "1113235077774523", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/792716465_1113235081107856_1087100361415058725_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTnZAF-E_Y4Q7kNvwE0FU6k&_nc_oc=Adr54STM73Ge-EShYDBBdToIVuWyNA32zXL8hexUx-ke4G3WmZf-59VBNVsk4BrMKZQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGmPQKO7f40Z5a-dER-NQY8NuvKfkxQyG0YPwjtMH27A&oe=6AF9D13D"}, {"file_name": "Screenshot_1_Speed_2560x1440.png", "id": "872998515835200", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/741360331_872998519168533_6906968583812638269_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWfy4eZMwRQQ7kNvwGoIobr&_nc_oc=AdplrrgW3IZ_tMMotFpA8p9xcqnYiC2D_HoA4VD-9oxjqErUnSCc4aE8Vu0Rxqu4kU8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLuuj0zrgSG2mrihvJuqBpfiIssXvqs6GcY8bu3G6xzQ&oe=6AF9E0D9"}, {"file_name": "Screenshot_2_ChasePursuit_2560x1440.png", "id": "2333379210737622", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673745728_2333379214070955_6091902103269369047_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Onc9KFPQ9I4Q7kNvwEsUd4I&_nc_oc=Adq9MKhMVmoAiwrF3dJBP3hFJ5epYOhAU1EDPD_s57Y3ohjEk6yKqkIH8Dquuu-v5yk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF9d0yPDzyDbBoNE3NwaT0FHDj9fuWBkZCjDOhbxAFVQ&oe=6AF9D5C9"}, {"file_name": "Screenshot_5_Thunderstorm_2560x1440.png", "id": "1594259105356067", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/811533601_1594259108689400_2279573343155117376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgsLIsf6ANAQ7kNvwEIhysR&_nc_oc=AdoZ0WrcVxLWInTf_iUcLo1m62w1mhvrBPSfyuspEZZI5TRGeoUzWrYIx7y82L7i4GI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQg_1ztZu6_B4aRTWzYgMj7OfWzgr95fpQ8dZ5-86zPg&oe=6AF9E9D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Survision", "keywords": [], "long_description": "SURVISION puts you in the suit of a super-speed hero. There are no buttons for speed: you run by pumping your arms, and the harder you swing, the faster you go - from a jog to past the sound barrier with a thunderous sonic boom.\n\nPOWERS\n- Super speed powered by your own arms, with lightning trailing behind you\n- Phase through walls, cars and buildings\n- Charge and throw lightning bolts\n- Split off a speed clone that fights beside you\n- Freeze time and move people around like statues\n- Run across water, backflip, and land like a superhero\n\nGAME MODES\n- Free Play: explore a huge open city with downtown streets, suburbs, highways, hills and coastline\n- Missions: stop a runaway truck, rescue people from a burning building, defuse a ticking bomb, blast falling meteors, and chase down bank robbers in a getaway car\n- Chase Pursuit: a rival speedster hunts you through the city - it shoulder-checks you, vaults over your head, traps you in a lightning vortex and trips you up. Keep running or get caught\n- Dogfight: a one-on-one lightning duel against an AI speedster that dodges, leads its shots and fights up close\n- Race: sprint through giant glowing gates across the island against three rival speedsters\n\nEvery mode has Easy, Medium and Hard difficulty.\n\nMAKE IT YOURS\nChoose your suit and lightning colour, then set the time of day and the weather: clear skies, rain, snow or a full thunderstorm with lightning strikes.\n\nCOMFORT\nHigh-speed movement in VR can be intense. Comfort options a", "short_description": "Become the fastest hero alive. Pump your arms to break the sound barrier, phase through walls, hurl lightning and outrun rival speedsters across a huge open city in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1opLH5CgPss9kRkC5_4hxMUBSXeeJQ-Gt1G4pCI3-NqM/preview", "developer_terms_of_service_url": null, "publisher_name": "Survision Team", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1opLH5CgPss9kRkC5_4hxMUBSXeeJQ-Gt1G4pCI3-NqM/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1533003689885358"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604366035_1432985085675010_7925446619426464843_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cuR9ySmH8oQ7kNvwHziLU8&_nc_oc=AdpLqY9aaJGL2N
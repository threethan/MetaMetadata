6Pg6Cm5UmenyfSEbu0cFl_5JHk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaB2OtSupWYDM2yGpsVuKnoQfDWEV9mAg_tWRJKx_H_Q&oe=6ACCEEAF"}, {"file_name": "com.dogelabs.deadeye-20250226-230254.png", "id": "1306183940636346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393444_1306183943969679_6163388153480635481_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkQjy3uhsFsQ7kNvwEbHLTp&_nc_oc=Adr1BU9HGm_aTuchS00-FPugxjzu-cBgQWcUqGhuJIfAI8J8prTnVXPLeABOCUHRTQk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQ15i1Paq85kQ3GCbOAhq7oXSur3Wv2PUddGJyh6sD9g&oe=6ACD0BAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadeye: Animal Squad", "keywords": ["gorilla", "shooter", "competitive", "combat", "guns"], "long_description": "# DEADEYE EARLY ACCESS\nDeadeye is a 5v5 hardcore tactical shooter with free flowing parkour movement. Sneak, dodge and aim your way with deadly accuracy to win. Headshots do bonus damage.\n\nTeam up with up to 4 friends and compete in 16 rounds of combat against your shell shocked opponents. \n\n# Gameplay tips:\n- Your gun is accurate only while your body is still\n- Aim for the head\n- You move quietly while moving slowly\n- Work together with your team\n- Use utility to stun or confused your opponents\n\nOnly the best will win. ", "short_description": "DEADEYE EARLY ACCESS\nDeadeye is a 5v5 hardcore tactical shooter with free flowing parkour movement. Sneak, dodge and aim your way with deadly accuracy to win. Headshots do bonus damage.\n\nTeam up with up to 4 friends in ranked matchmaking and compete in 16 rounds of combat against your shell shocked opponents. \n\nOnly the best will win. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1oqEVMeNm0IpLq7EqCh0z7XfLHjpnFUVn", "developer_terms_of_service_url": "https://docs.google.com/document/d/1sEQQS2l1eYYM91QlfDmK0Aqv8urBV_xc/", "publisher_name": "Doge Labs, Inc.", "support_
d83e\udd56 Fresh updates every week. \n\n\ud83d\udd2b Challenge opponents to duels\n\n\ud83d\udcb5 Earn Foundation Coins to unlock new weapons & gear \n\n\ud83d\udcdc Complete contracts to build WILD Loadouts\n\n\ud83c\udfc6 Become the G.O.A.T.\n\nJoin thousands of rivals in the Discord for updates, challenges, giveaways and sneak peaks! \n\nDiscord.gg/animalrivalsvr\n\nPlay now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1oqEVMeNm0IpLq7EqCh0z7XfLHjpnFUVn", "developer_terms_of_service_url": "https://docs.google.com/document/d/1sEQQS2l1eYYM91QlfDmK0Aqv8urBV_xc/", "publisher_name": "Doge Labs, Inc.", "support_website_url": "https://animalrivalsvr.com/discord", "website_url": "https://animalrivalsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28387547440902890"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/791586454_2301376924049061_295935726376113801_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex00lWlDcbUQ7kNvwEAi-Gf&_nc_oc=AdqmkWt2D-C9tmk_4v2idQxdX-Cw2y-2VO06twzhOVp6_evX0TQA-dT0cL3l_QhDSVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP2uAhIYv2z7IffKMuFd6LF2Pcp6a7EeOkv9FtCGB4MQ&oe=6ACCED7A"}, "
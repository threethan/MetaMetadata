.com&_nc_ss=7f20f&oh=00_AQRTJ6JIIRVtw-UXMFuRSk8ilrBr7AVZ8A3PsvfMfkGTcg&oe=6AF47F6B"}, {"file_name": "473393328_2358765701164074_3605043121470140197_n (1).png", "id": "3042325685956697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828857_3042325689290030_1574866392979588850_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxKA63yzIIIQ7kNvwGFDOgP&_nc_oc=Adofe_gcOGQ02Fp4sjcZGdusWtvMAGnn6i9HG5ENij8sy4OUbeUEkrdYcifqS9MBHyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRoxeUt2Oq-uTlr8cIrU5r0L71WAheeRK40XZVcRjuSQ&oe=6AF48C65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AltCoverHalloweenV5_BlueAK.png", "id": "1658906625836044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628436_1658906629169377_5907984028043823855_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAYJzAXLbu0Q7kNvwHdjJeO&_nc_oc=Adrqo6L6mMyXWVt7YehgJErGPL8tvzbRoywBwn6g2gzCeArd5KXvMshSv9ayOflBqQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkNkOF_6-NK5FtAWNmusDRGidzjxJ7CnZq9xHxL-3JLg&oe=6AF4819E"}, "display_name": "ANIMAL RIVALS", "keywords": ["shooter", "competitive", "combat", "guns", "animal"], "long_description": "Welcome to ANIMAL RIVALS, the most intense monkey shooter on Meta Quest. Inspired by classic shooters and the gorilla movement system, you can challenge friends (or enemies!) to 1v1, 2v2, or 3v3 duels,  get chaotic with Team Deathmatch, or defeat a zombie horde in the Infected mode!\n\n{1311649540363978}\n\n\ud83e\udd56 Fresh updates every week. \n\n{1280046613308085}\n\n\ud83d\udd2b Challenge opponents to duels\n\n{1560127508537594}\n\n\ud83d\udcb5 Earn Foundation Coins to unlock new weapons & gear \n\n\ud83d\udcdc Complete contracts to build WILD Loadouts\n\n\ud83c\udfc6 Become the G.O.A.T.\n\nJoin thousands of rivals in the Discord for updates, challenges, giveaways and sneak peaks! \n\nDiscord.gg/animalrivalsvr\n\nPlay now!\n", "short_description": "Welcome to ANIMAL RIVALS, the most intense monkey shooter on Meta Quest. Inspired by classic shooters and the gorilla movement system, you challenge players to 1v1 to 3v3 duels. \n\n\ud83e\udd56 Fresh updates every week. \n\n\ud83d\udd2b Challenge opponents to duels\n\n\ud83d\udcb5 Earn Foundation Coins to unlock new weapons & gear \n\n\ud83d\udcdc Complete contracts to build WILD Loadouts\n\n\ud83c\udfc6 Become the G.O.A.T.\n\nJoin thousands of rivals in the Discord for updates, challenges, giveaways and sneak peaks! \n\nDiscord.gg/animalrivalsvr\n\nPlay now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1oqEVMeNm0IpLq7EqCh0z7XfLHjpnFUVn", "developer_terms_of_service_url": "https://docs.google.com/document/d/1sEQQS2l1eYYM91QlfDmK0Aqv8urBV_xc/", "publisher_name": "Doge Labs, Inc.", "support_website_url": "https://animalrivalsvr.com/discord", "website_url": "https://animalrivalsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28551319384525694"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620532_1642978404228755_1108295079458749613_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VsqqVUoFDUQ7kNvwHsiVww&_nc_oc=Adoi0shL4Mnsvdyh0JQ9zBFuzn1AMNH3TE4eJHg7Llp0Wsx9Y8
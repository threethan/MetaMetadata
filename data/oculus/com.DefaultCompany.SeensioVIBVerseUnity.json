cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuOhR0HbBNUQ7kNvwGL7PXo&_nc_oc=AdqwDDrllTnhh3BMnY4cHXDYC8BBjIRBBQVwen2b4ObqJ0gg_BmHFD7ajOupomR_Wr0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRBKJtgIOaAFXBx-EVIZcEgsnfEpFE80PNr9GkJKxwdA&oe=6AFB3E63"}, {"file_name": "2.png", "id": "471515532223784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036692_471515535557117_7381538198738259856_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ub4SFQTN6MQ7kNvwH5AwpU&_nc_oc=Adq2nQXgC4Szww0s4uMkMoW0r2OypXB08h8b1fIwBppZwZXmM9AbP0BiYE-Z8yG1ODk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqPPus66nmFsVe-W7QNC8FLSFeyRdyPYaqi7IGSyWm7g&oe=6AFB4CF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.2 Cover Landscape.png", "id": "447879878176094", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035310_447879881509427_6152545594938277359_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyH3h5G2QcAQ7kNvwEchMNA&_nc_oc=AdpwTpXWs-izJz59hsX_TuyMWL2yBhj_r5etYlpCvN5kTjC0SBxIyHu7t1o_KqPHpTM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEQxJ6h9J_QsX8VuDIBb-ESn9vP-LK-oLVKfiFjhLFcg&oe=6AFB36ED"}, "display_name": "VIB Verse", "keywords": [], "long_description": "Here are some key features of VIB Verse app\n- Immerse yourself in and experience a virtual banking city with numerous zones dedicated to separate products\n- Customize your avatar to appear in VIB Verse\n- Convenient and flexible movement\n- Easy to access with quick access\n- View card information\n- Find a card that suits your needs\n- Select cards and compare their features\n- View the visually engaging car with realistic dimensions \n- Calculate and receive the loan payment details\n- View VIB promotions and campaigns displayed on the street, in parks, and even in the sky\n- Leave contact information, VIB will call then\n", "short_description": "VIB Verse is the Virtual reality app - a product of Vietnam International Bank (VIB). Users need to use VR headset to immerse themselves in VIB city banking with numerous zones dedicated to separate products such as Auto Loan and Credit Card, as well as entertainment areas like beach, bar, park, and fountain. Users can customize their appearance by editing character's face, hair, clothes, and shoes, as well as selecting a nickname. Surely, VIB Verse app will provide a delightful experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vib.com.vn/i/en/vib-verse/chinh-sach-bao-mat", "developer_terms_of_service_url": null, "publisher_name": "VIB Bank", "support_website_url": null, "website_url": "https://www.vib.com.vn/i/en/vib-verse", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "vi"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7516763178449258"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "354458587384418"}]}, "baseline_offer": {"id": "354458587384418"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1721644725, "status": "PUBLISHED", "id": "354458587384418"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7603135299812045", "version": "1.0023"}, "id": "1843548639476736", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{
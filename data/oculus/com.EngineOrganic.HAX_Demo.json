eo_trailer_thumbnail": {"file_name": "HAXdemo_AppLab_MASTER_01.png", "id": "589614775359963", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974833_589614778693296_5485784398770618357_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMAj_9pzujsQ7kNvwE18DD6&_nc_oc=AdoZr-XeikIozSOfck-TpSMMqE2UT3Nt9EJ1rx3x0HH0rApwP5G69WaxtybmSwbt7Rg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbk4HjfOl1eQ5j6_EYcOcycuRs_sNTNEpQuSwKIrivyQ&oe=6AFC5F58"}, "display_name": "HAX Demo", "keywords": [], "long_description": "Battle Sentient Intelligent robots with digital weaponry in this fast-paced, early-access, VR shooter. With intuitive VR controls, HAX aims to stay true to the fun and excitement offered by traditional shooters, while harnessing the power and immersion of virtual reality. While this demo is single player only, when complete, HAX will be a multiplayer game.\n\nHAX is currently in development by Engine Organic Ltd. The Multiplayer version of the game is currently in pre-alpha testing and will be released later this year (2024). For more insight into HAX please visit EngineOrganic.com/HAX\n\nDiscord: https://discord.gg/XjsSVQKRwt", "short_description": "HAX blurs the lines between digital and physical warfare. Battle robots with digital weaponry in the single player demo of this fast-paced, early-access, VR shooter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.engineorganic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Engine Organic", "support_website_url": null, "website_url": "https://www.engineorganic.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
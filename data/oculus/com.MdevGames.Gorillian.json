7_653679230823239_6529135816054905452_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feV7bXz2u5MQ7kNvwFoKyb5&_nc_oc=Adr1H3MLjD30kreaPY6HhfrxCgLqkJ--05ja_bY3kwURxpDsjwVdGwIFmF3itrf6qiU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArA3yDTaIEHmg3OhLQ2oMEmVEBtyyZtYYIgf9e2pIrQw&oe=6A6A11E4"}]}, "id": "997620825918503", "locale": "en_US", "screenshots": [{"file_name": "gorillian_screenie_1.png", "id": "4091216821124669", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393158_4091216831124668_4369559626386733640_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mR5BozKTSu8Q7kNvwF1SlQA&_nc_oc=AdoLiPyN_NiNQNagBd3ROTwMzaPiA2I2kL8-RzvchhBz7IIX3wknOvBKDTnZEY6CgIQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGBmdk9DQpxAc1KJKtVtcRIKrd5R9SZTLSx2j9Yyjc8w&oe=6A69F5B5"}, {"file_name": "Gorillian_screenie_6.png", "id": "1248499970169836", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391785_1248499973503169_3144025418679357357_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoPdvUkA3G8Q7kNvwE1P8EI&_nc_oc=Adq9QLNqkP9uS25WTEuYEpULif83TEUYZpkAB3f44SXPZFiPP10JbNrxo8DZR-_jvlM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA78ZoFp1qzTH_oTI43yc3NwWKknIS8Ff1egpeGiwWWhg&oe=6A69E98B"}, {"file_name": "gorillian_screenie_2.png", "id": "693710219919230", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391811_693710223252563_5493005561316122418_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lK_Gj6GmeWwQ7kNvwHDQPVp&_nc_oc=AdoTXxVXUoiRBEwN3MO0zJtzhji_FDykCTjEw9Z50xxbs0Qy8YwT03hZcNwFOWqJ5DE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFbUWRvwLiv9PV9cmI25diLj0MGLr96zYjU15Rrly7RA&oe=6A69FCD9"}, {"file_name": "gorillian_screenie_7.png", "id": "1043597341070642", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821115_1043597344403975_8072380761725418315_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYoDCRJw4zwQ7kNvwGPgnMv&_nc_oc=Adr01ypQB7d9cBV9sQHbKQySA7GisYsB9ngdGODL8PBVBtoOQ_2RX2pFX8AmihDaitE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_LjZ9SE0Pz-HH3KOHRdJRGb0tQHWHN4223uR9H6sqaw&oe=6A6A1680"}, {"file_name": "gorillian_screenie_3.png", "id": "1599985387330632", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393145_1599985393997298_146030878042772857_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjnKHMG4rlsQ7kNvwEvCLBJ&_nc_oc=AdrXBhH5_INo1b-Zufkr1yyr3IPxGUEyUWuC9MW5uUIoY7SknkQdYT8_NfMMr4Vwpwc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgrmDwY4d0haz-pNPJM6UHx5hfRghSdXlanzXbqmr5NA&oe=6A69F27E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GorillianCoverShit.png", "id": "1002113325378892", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393545_1002113328712225_759630498357774454_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVjn8qc5EaUQ7kNvwG_AzeR&_nc_oc=AdpHDlG1c6-HC-pwm8fyUMyG4b9H3z2qE8pAIaaP9PmaPobz1rbYJOPpAzGGUbma6rY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5a9YDZ2hdwDaIAkJTdltJYsuE8WKX1dKy8GsVh5ZVng&oe=6A6A127F"}, "display_name": "Gorillian VR", "keywords": ["gorilla", "tag", "hide", "fun", "adventure"], "long_description": "Immerse yourself in a thrilling VR experience with this Gorilla Tag-inspired multiplayer game, where agility, strategy, and fast-paced movement are the keys to victory. Chase and be chased in heart-pounding rounds of Tag across dynamic environments designed for climbing, jumping, and hiding. Choose from public rooms to join spontaneous matches with players from around the world, or create private rooms to play exclusively with friends.\n\nRefine your skills with customizable turning mechanics, whether you prefer smooth rotation or snap turning for comfort and precision. Explore cleverly designed maps with unique hiding spots that add a layer of stealth and creativity to each match.\n\nWhether you're an experienced VR player or new to the genre, this game captures the raw fun and community-driven energy of Gorilla Tag while introducing its own twist on gameplay and social interaction. Leap, duck, and outmaneuver your opponents in a vibrant world built for virtual freedom.", "short_description": "A Gorilla Tag inspired game with Tag, public rooms, private rooms, turning, and hiding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillian-vr/privacypollicy", "developer_terms_of_service_url": null, "publisher_name": "MdevGames", "support_website_url": "https://sites.google.com/view/gorillian-vr/support", "website_url": "https://sites.google.com/view/gorillian-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9751833214907466"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9796593277098126", "version": "1.1.9"}, "id": "588420927618823", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9735868936503894", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary
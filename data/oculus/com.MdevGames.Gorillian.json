7_653679230823239_6529135816054905452_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgIdQMsQKP0Q7kNvwGE7pHQ&_nc_oc=Adp2Yw8ZYoWUR5lemw8fF2GM-24SuMOuT9KLWtURGFPNVA5T5cfhqxmiZD51rT562DM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hZyKVOidVA7hr_0uiwdjoEzSuS_wMqScTuDAuKayStg&oe=6A106BE4"}]}, "id": "997620825918503", "locale": "en_US", "screenshots": [{"file_name": "gorillian_screenie_1.png", "id": "4091216821124669", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393158_4091216831124668_4369559626386733640_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ilb03BCho2MQ7kNvwHI2sWI&_nc_oc=AdqNQX4khCMNzuRo1ZVBemLy2pErburpiQOrlziT2RAE-7rLHUbPgeNuHfLc7fC3b6A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m10z_XgCDBrftVimQ5RBNu9-6yAX1uyPZ_hQJL1T-RA&oe=6A104FB5"}, {"file_name": "Gorillian_screenie_6.png", "id": "1248499970169836", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391785_1248499973503169_3144025418679357357_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDbQiczmamAQ7kNvwHr2pUr&_nc_oc=AdoWpieogX-7waj0HX_ADOMp3bq-VFQpF59rLHvcdbRdehKRSsouZjTrQ6CVooRcFLk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nelzYNV0-rTRcEtCxPt8ThDWTi4B7EYWLLOE1rExwRQ&oe=6A107BCB"}, {"file_name": "gorillian_screenie_2.png", "id": "693710219919230", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391811_693710223252563_5493005561316122418_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQCZUEgl1tYQ7kNvwGH8q69&_nc_oc=AdpzztL1jlyE2QDFpv0ufqUpWBdiTOnnpuMeSTt_9YYor4XuRupLO_eI9LUM4ssnB44&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78ugYhVWr9Hq5n1OjcbEfrV_uFk3XYyCA7pkOUcCD7kQ&oe=6A1056D9"}, {"file_name": "gorillian_screenie_7.png", "id": "1043597341070642", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491821115_1043597344403975_8072380761725418315_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zvmsjsc-cx4Q7kNvwHorCTm&_nc_oc=AdrguXCj0hMGBAnED441A2ob6WulVq-VAxduBlBIOQ_Fqs7Wo-9do84n3wHovw1YSuk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53HtgmIw_t9K7k42_DBZR4kti8TqejyWQb5D7ivW9pBg&oe=6A107080"}, {"file_name": "gorillian_screenie_3.png", "id": "1599985387330632", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473393145_1599985393997298_146030878042772857_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UqB9v9X-WwQ7kNvwFiBeCl&_nc_oc=AdoCncQCFBzad40deznGz0X1J5JZoX0yiryljEwhTBROmioteO3F1ME8BhEIZdMTqYg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7q4607y_Ngps4EpCqNTnNpOxuUsxsS0x5Q-KAh7nhcmA&oe=6A104C7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GorillianCoverShit.png", "id": "1002113325378892", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393545_1002113328712225_759630498357774454_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guvmdtBXrjMQ7kNvwFYuRgc&_nc_oc=AdqdCaLZEwTOwaK7sZj_n3qhbpiXpVWVUGksxAnsbnF8Md4opbvmO4DpOMHGdmpsRb4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O6I66ockNaxk-WS90yHIVw6tcejunASZigmCutLQGoA&oe=6A106C7F"}, "display_name": "Gorillian VR", "keywords": ["gorilla", "tag", "hide", "fun", "adventure"], "long_description": "Immerse yourself in a thrilling VR experience with this Gorilla Tag-inspired multiplayer game, where agility, strategy, and fast-paced movement are the keys to victory. Chase and be chased in heart-pounding rounds of Tag across dynamic environments designed for climbing, jumping, and hiding. Choose from public rooms to join spontaneous matches with players from around the world, or create private rooms to play exclusively with friends.\n\nRefine your skills with customizable turning mechanics, whether you prefer smooth rotation or snap turning for comfort and precision. Explore cleverly designed maps with unique hiding spots that add a layer of stealth and creativity to each match.\n\nWhether you're an experienced VR player or new to the genre, this game captures the raw fun and community-driven energy of Gorilla Tag while introducing its own twist on gameplay and social interaction. Leap, duck, and outmaneuver your opponents in a vibrant world built for virtual freedom.", "short_description": "A Gorilla Tag inspired game with Tag, public rooms, private rooms, turning, and hiding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillian-vr/privacypollicy", "developer_terms_of_service_url": null, "publisher_name": "MdevGames", "support_website_url": "https://sites.google.com/view/gorillian-vr/support", "website_url": "https://sites.google.com/view/gorillian-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9751833214907466"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "620444147750867"}]}, "baseline_offer": {"id": "620444147750867"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747077300, "status": "PUBLISHED", "id": "620444147750867"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9796593277098126", "version": "1.1.9"}, "id": "588420927618823", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_app
7_653679230823239_6529135816054905452_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2LLvGMRzZkQ7kNvwEwZpUR&_nc_oc=AdpSdYZatdDPsR7kjXr3Vn_3Bftc-57tpt4qNAcnL9K6wLibPXhPVYP_fru2IAvx1FI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaFHoozjmbIIwAk_zf7VugbYjo78Wdb6iR9MDjlBbO_A&oe=6A789264"}]}, "id": "997620825918503", "locale": "en_US", "screenshots": [{"file_name": "gorillian_screenie_1.png", "id": "4091216821124669", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393158_4091216831124668_4369559626386733640_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxQqFXLBW_QQ7kNvwHtfTeT&_nc_oc=AdpAi1Mx10HhGPft-_wNZcqV_dG8FRz02XXi7zesAwa1UY_L0liaYNr0mfK3skASLME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqDRcWdf8rhVaQnITDCZmd8Jpx_YK7tGqr1f7_V5sFgA&oe=6A787635"}, {"file_name": "Gorillian_screenie_6.png", "id": "1248499970169836", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391785_1248499973503169_3144025418679357357_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_0pH7SN7NsQ7kNvwFTGKQz&_nc_oc=Adqo_0DvQY7Q5RMUu4KA6YUYOIixfj1rkTZehMKflWcC33I-gp_jVUvrUt8WOQQv_hk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQBf4ClxkCGOJRJ4m3NFmlxGnpbdnxp_oJ9D9r0u4-EQ&oe=6A786A0B"}, {"file_name": "gorillian_screenie_2.png", "id": "693710219919230", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391811_693710223252563_5493005561316122418_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THH_Mg5uXxwQ7kNvwEWt2Vf&_nc_oc=Adq9SrAGEVuHLRTRZA3A5J8zxO6NeSwCwk6K6Wo2QyXnKPkDsvo81jwtXONqBNzJJbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ4HvZP3xX68YGi79hk99etLNQ1mgMRtsm-V4BoEL6gA&oe=6A787D59"}, {"file_name": "gorillian_screenie_7.png", "id": "1043597341070642", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821115_1043597344403975_8072380761725418315_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDzx3u8XQdcQ7kNvwGWT_jE&_nc_oc=Adozgix5eaM4cT3YKALPe1omM1kfew-2V7T1hLs9I3Q1YHSwe9WNif2eOovz4uAwWHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhSuYmR3SrDNauxfOMFIW2kMSQgzlJIZz5KPOJ7YErXA&oe=6A785EC0"}, {"file_name": "gorillian_screenie_3.png", "id": "1599985387330632", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393145_1599985393997298_146030878042772857_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0mOW3pSgN4Q7kNvwEKLcVr&_nc_oc=AdqXTiXZhAd4uP99uc1qErSXRihRAZh6Pnc5RM2N6WcX2qU93KNxkmySAPlFDJ9X0OU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhgi9AaWHjpcwwzZhNUkPXWKMocHEDdOAEJAXTgI8jCQ&oe=6A7872FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GorillianCoverShit.png", "id": "1002113325378892", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393545_1002113328712225_759630498357774454_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ToQQyIZm5MQ7kNvwGVZcDW&_nc_oc=AdrR2yeKNLW_u72V8sKcbH-oKtXInXwJhgyKDCq_Excgyi7x1ZFIo0ZwMOxFRdmT-Uw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4bOD_JAfaGUf2_G7EZv5YYVb9Sc1UV5QlYM3X-yC4cg&oe=6A7892FF"}, "display_name": "Gorillian VR", "keywords": ["gorilla", "tag", "hide", "fun", "adventure"], "long_description": "Immerse yourself in a thrilling VR experience with this Gorilla Tag-inspired multiplayer game, where agility, strategy, and fast-paced movement are the keys to victory. Chase and be chased in heart-pounding rounds of Tag across dynamic environments designed for climbing, jumping, and hiding. Choose from public rooms to join spontaneous matches with players from around the world, or create private rooms to play exclusively with friends.\n\nRefine your skills with customizable turning mechanics, whether you prefer smooth rotation or snap turning for comfort and precision. Explore cleverly designed maps with unique hiding spots that add a layer of stealth and creativity to each match.\n\nWhether you're an experienced VR player or new to the genre, this game captures the raw fun and community-driven energy of Gorilla Tag while introducing its own twist on gameplay and social interaction. Leap, duck, and outmaneuver your opponents in a vibrant world built for virtual freedom.", "short_description": "A Gorilla Tag inspired game with Tag, public rooms, private rooms, turning, and hiding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillian-vr/privacypollicy", "developer_terms_of_service_url": null, "publisher_name": "MdevGames", "support_website_url": "https://sites.google.com/view/gorillian-vr/support", "website_url": "https://sites.google.com/view/gorillian-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9751833214907466"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9796593277098126", "version": "1.1.9"}, "id": "588420927618823", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9735868936503894", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary
0skS10WAj5jkeXs2UWgeKkQAMRUm19OKP-p0xedsl6aIkbbW07EypC-jGBRc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96zmnrhItAsR1JggbpEduQ-M1QTo7S54Nuew6jRcqWNA&oe=6A467E00"}, {"file_name": "gorillian_screenie_3.png", "id": "1599985387330632", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393145_1599985393997298_146030878042772857_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-AghXz8ex8Q7kNvwHoJeUR&_nc_oc=AdquuicQWjeYU910KF74iqfQVJhLzLjBmy9NlL4VwP1puwvIIYZwYBRv7mNf-FPjp8o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vsIywRjaz4XLU-wuRWFGRzGjKumaWqNTcD_bblR2e4Q&oe=6A4659FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GorillianCoverShit.png", "id": "1002113325378892", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393545_1002113328712225_759630498357774454_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOZeZbywcZAQ7kNvwGV7Rxo&_nc_oc=AdpeUtkCv1PjnVBfJcH051uG1oI4U8YBkjLtzhrG9VzJa_K_wH0rKXfIqbKvz-I6J_w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9prJRG2GQhAlIj25wqiHOXMZPddQcUe9WUHooO6hKvw&oe=6A4679FF"}, "display_name": "Gorillian VR", "keywords": ["gorilla", "tag", "hide", "fun", "adventure"], "long_description": "Immerse yourself in a thrilling VR experience with this Gorilla Tag-inspired multiplayer game, where agility, strategy, and fast-paced movement are the keys to victory. Chase and be chased in heart-pounding rounds of Tag across dynamic environments designed for climbing, jumping, and hiding. Choose from public rooms to join spontaneous matches with players from around the world, or create private rooms to play exclusively with friends.\n\nRefine your skills with customizable turning mechanics, whether you prefer smooth rotation or snap turning for comfort and precision. Explore cleverly designed maps with unique hiding spots that add a layer of stealth and creativity to each match.\n\nWhether you're an experienced VR player or new to the genre, this game captures the raw fun and community-driven energy of Gorilla Tag while introducing its own twist on gameplay and social interaction. Leap, duck, and outmaneuver your opponents in a vibrant world built for virtual freedom.", "short_description": "A Gorilla Tag inspired game with Tag, public rooms, private rooms, turning, and hiding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillian-vr/privacypollicy", "developer_terms_of_service_url": null, "publisher_name": "MdevGames", "support_website_url": "https://sites.google.com/view/gorillian-vr/support", "website_url": "https://sites.google.com/view/gorillian-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9751833214907466"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9796593277098126", "version": "1.1.9"}, "id": "588420927618823", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9735868936503894", "is_concept": false, "latest_released_binary": {"__typename"
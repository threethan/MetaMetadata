7_653679230823239_6529135816054905452_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvKA-DGX4k8Q7kNvwF4cmz6&_nc_oc=Adp5kdiQs0OHECnpsOAoDVr1omZfWPDfMmwZhrvlaDH6KyX6apVDKmCzpsuaPvwgEys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWobweuYIzNsIDEHgAtVoDOPUrdlq4ckDGZl_qXjKCPQ&oe=6AF72264"}]}, "id": "997620825918503", "locale": "en_US", "screenshots": [{"file_name": "gorillian_screenie_1.png", "id": "4091216821124669", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393158_4091216831124668_4369559626386733640_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2Ugf9GhS8wQ7kNvwGZfZE9&_nc_oc=AdoLQ2VEQvPfoRhCNTw-kChpoH9STltqjtEupZ1HIDjJBiyd2J5LS9-9qAcAKV0ydFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWd6JI1_kR6p9PSDHZ7RgrI2gl2Qhaaiv4-aUfL_4Xpw&oe=6AF73E75"}, {"file_name": "Gorillian_screenie_6.png", "id": "1248499970169836", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391785_1248499973503169_3144025418679357357_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ4UWFprKg8Q7kNvwGW1VkQ&_nc_oc=AdonG0yYHFcRfjgMwObhVPpIA8ZHVhgmJjHcz34dB7Gmc77haGTEvKzPLzDdywc598E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBXuCYKAj-KXU-LKP-MIT7x5MXBVkJbv2OKhWW59nBCw&oe=6AF7324B"}, {"file_name": "gorillian_screenie_2.png", "id": "693710219919230", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391811_693710223252563_5493005561316122418_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bszFuOSm-R0Q7kNvwFtChO1&_nc_oc=Ado95t7WK7MWnuGuNfjhzD3NMFLyA3irKYSqpjl2-5r34RfKhgraSpv9jaMgjo-l4R4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPyoTE61WsTIcVy4OoEVghjSE24igN2sUyTDTkIL2foQ&oe=6AF74599"}, {"file_name": "gorillian_screenie_7.png", "id": "1043597341070642", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_1043597344403975_8072380761725418315_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMaUnA2VmnwQ7kNvwFgZTzB&_nc_oc=AdpPmvHf32b-fBLuKD7YTnRu15sjPFHvlHoQF7v6MHgYuSrfiro20iWo3jnfUoEzoGM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnCmFHfzMHWXxQZa30TbUBrgzGEwwf8EYi_fnmBaS6Qw&oe=6AF72700"}, {"file_name": "gorillian_screenie_3.png", "id": "1599985387330632", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393145_1599985393997298_146030878042772857_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yRLG0t1kM8Q7kNvwG0GqU5&_nc_oc=Adq2LJokBuG55Juowj9ZYWVUA4h7aobfOm6qDQjomZcNFnMHlIO4aYl6z6NQnUf9N60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCQ2mArbdW_KAArbusYJajhieCOW2JsSyWHSWji6W1yw&oe=6AF73B3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GorillianCoverShit.png", "id": "1002113325378892", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393545_1002113328712225_759630498357774454_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27ZzNgzMAXQQ7kNvwGkRvmX&_nc_oc=AdqGDJDvwcOKsEZ2YUkpcBKqfibU7FligbD_KZT0pVtTsOHubyrUt6EOodII_O5rg4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0Z88uCWPYuAsKFLHK2VO575aij_mJPeNtG2DW-Vg3jg&oe=6AF722FF"}, "display_name": "Gorillian VR", "keywords": ["gorilla", "tag", "hide", "fun", "adventure"], "long_description": "Immerse yourself in a thrilling VR experience with this Gorilla Tag-inspired multiplayer game, where agility, strategy, and fast-paced movement are the keys to victory. Chase and be chased in heart-pounding rounds of Tag across dynamic environments designed for climbing, jumping, and hiding. Choose from public rooms to join spontaneous matches with players from around the world, or create private rooms to play exclusively with friends.\n\nRefine your skills with customizable turning mechanics, whether you prefer smooth rotation or snap turning for comfort and precision. Explore cleverly designed maps with unique hiding spots that add a layer of stealth and creativity to each match.\n\nWhether you're an experienced VR player or new to the genre, this game captures the raw fun and community-driven energy of Gorilla Tag while introducing its own twist on gameplay and social interaction. Leap, duck, and outmaneuver your opponents in a vibrant world built for virtual freedom.", "short_description": "A Gorilla Tag inspired game with Tag, public rooms, private rooms, turning, and hiding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillian-vr/privacypollicy", "developer_terms_of_service_url": null, "publisher_name": "MdevGames", "support_website_url": "https://sites.google.com/view/gorillian-vr/support", "website_url": "https://sites.google.com/view/gorillian-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9751833214907466"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9796593277098126", "version": "1.1.9"}, "id": "588420927618823", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9735868936503894", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary
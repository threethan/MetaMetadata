7_653679230823239_6529135816054905452_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTxCX26n4boQ7kNvwGF6YCk&_nc_oc=Adpg1FCPRkmhLhM3n7TuhdOIxHEaQhIVb7UI60Wo43jv53ucpdMzjPf5s0Qt0dIPwd4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw81jo2DrEyR7YrElz9qytQUI6exBwVXUfxwzMneXzdNw&oe=69C697E4"}]}, "id": "997620825918503", "locale": "en_US", "screenshots": [{"file_name": "gorillian_screenie_1.png", "id": "4091216821124669", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393158_4091216831124668_4369559626386733640_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx8oEZMdHMkQ7kNvwHja3M4&_nc_oc=Adqj3mIsf3rjWR9zsEC2EMFqvy0h6RsfLmCJhIVMWwrfQRXUL1vEupLpgQF-EC6aGCo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZVYxhWjwGwtwgt-pI8IvNO8PG7KxLJ_mnbTpvbVFa6g&oe=69C67BB5"}, {"file_name": "Gorillian_screenie_6.png", "id": "1248499970169836", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391785_1248499973503169_3144025418679357357_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxBwsBJC1pgQ7kNvwExwAD_&_nc_oc=AdohgiiaMWAE0BuBuXHzqB1mLNlmBHa9Xm1JPAsLg85zYu-zUiRhjmFyLX9SmaUaEAU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQAna7piIvm79WumEceKofQqrny9Cwv1f_wxJ_N0_dbQ&oe=69C66F8B"}, {"file_name": "gorillian_screenie_2.png", "id": "693710219919230", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391811_693710223252563_5493005561316122418_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRS60rar_RsQ7kNvwG5cQyn&_nc_oc=Adpo84fMQwn9IoiStG-Nx_GgoMBKjEXRtJcaJFBcrOoyRYQCywcpW7_zYd3zjIvNWoM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyX8qubpyjPMeS4bRMrnXkff4CMDr8whXKE60DJf6UGoQ&oe=69C682D9"}, {"file_name": "gorillian_screenie_7.png", "id": "1043597341070642", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821115_1043597344403975_8072380761725418315_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uriW4UbR8RgQ7kNvwH86NP_&_nc_oc=AdpbJKlET82RxyCczifFUTjgpGY0UHlgXMnau-dXdXCSej646YrpAPK0KvCImRjo99I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKqCljl665-3641s8rfir6ufse_S7ZPGkguDA5SEdtrQ&oe=69C66440"}, {"file_name": "gorillian_screenie_3.png", "id": "1599985387330632", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393145_1599985393997298_146030878042772857_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_915nAuX5YQ7kNvwG-iNki&_nc_oc=AdrET5Zk0Axs8ooE1rk72vmL79eW0D8wF84RUAp5q94lHlcjBVWZu3cauSXb3DjCObg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzisadB8eQ-nCN7yBEZYuy5YjLth41wVPdVj9a6JAUqkw&oe=69C6787E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GorillianCoverShit.png", "id": "1002113325378892", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393545_1002113328712225_759630498357774454_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3GUQI-nWwMQ7kNvwGHgrzC&_nc_oc=AdoSgpsRScLdovwzNXWiUx0vQQZDJLBI6w0Fw7F2GRB3tgatWe15g2xTy7lH4w-V20M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3iS5cpQcNP-mtBudpYy2Is1dgGHJitkFixUMXc0D3eQ&oe=69C6987F"}, "display_name": "Gorillian VR", "keywords": ["gorilla", "tag", "hide", "fun", "adventure"], "long_description": "Immerse yourself in a thrilling VR experience with this Gorilla Tag-inspired multiplayer game, where agility, strategy, and fast-paced movement are the keys to victory. Chase and be chased in heart-pounding rounds of Tag across dynamic environments designed for climbing, jumping, and hiding. Choose from public rooms to join spontaneous matches with players from around the world, or create private rooms to play exclusively with friends.\n\nRefine your skills with customizable turning mechanics, whether you prefer smooth rotation or snap turning for comfort and precision. Explore cleverly designed maps with unique hiding spots that add a layer of stealth and creativity to each match.\n\nWhether you're an experienced VR player or new to the genre, this game captures the raw fun and community-driven energy of Gorilla Tag while introducing its own twist on gameplay and social interaction. Leap, duck, and outmaneuver your opponents in a vibrant world built for virtual freedom.", "short_description": "A Gorilla Tag inspired game with Tag, public rooms, private rooms, turning, and hiding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillian-vr/privacypollicy", "developer_terms_of_service_url": null, "publisher_name": "MdevGames", "support_website_url": "https://sites.google.com/view/gorillian-vr/support", "website_url": "https://sites.google.com/view/gorillian-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9751833214907466"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "620444147750867"}]}, "baseline_offer": {"id": "620444147750867"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747077300, "status": "PUBLISHED", "id": "620444147750867"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9796593277098126", "version": "1.1.9"}, "id": "588420927618823", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_app
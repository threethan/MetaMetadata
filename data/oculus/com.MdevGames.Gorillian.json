1D199"}, {"file_name": "gorillian_screenie_7.png", "id": "1043597341070642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_1043597344403975_8072380761725418315_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_no8BIHVhOkQ7kNvwElm0oz&_nc_oc=AdoXz9hcVrCjx66al0iLp5yOzGBT1ndVlE65rplUyD5z2tA1WJw7AHkMXSYdqCT9x1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPrZN9UkkX3EE1fBrBLANOIb6To4ux5xPKiDbOjzfbaw&oe=6B01EB40"}, {"file_name": "gorillian_screenie_3.png", "id": "1599985387330632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393145_1599985393997298_146030878042772857_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UEfAxGKh5UQ7kNvwHxm_Sg&_nc_oc=AdpnBUWUfS6wmfkWWZ7aVjdlZC-D8kpQQ3KLLkuQXlCpvg7ysR0PAlGZ_FPJyBT8L-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTftfJ24bFmWFyoXmAdJje_7e0UTa_1yUjUokcvOBa8sg&oe=6B01C73E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GorillianCoverShit.png", "id": "1002113325378892", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393545_1002113328712225_759630498357774454_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bU81vQS4eccQ7kNvwGTPmOK&_nc_oc=Adqx4ohcWJ-39fhRwU1Ewl_XuMThCYcbavMTzuPPBBifEcHN2Z5GZweh5YhAqtavGYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDj-ELu34CoESAL-iMG_qHPlAvgH-VC67OMgNHXukMhw&oe=6B01E73F"}, "display_name": "Gorillian VR", "keywords": ["gorilla", "tag", "hide", "fun", "adventure"], "long_description": "Immerse yourself in a thrilling VR experience with this Gorilla Tag-inspired multiplayer game, where agility, strategy, and fast-paced movement are the keys to victory. Chase and be chased in heart-pounding rounds of Tag across dynamic environments designed for climbing, jumping, and hiding. Choose from public rooms to join spontaneous matches with players from around the world, or create private rooms to play exclusively with friends.\n\nRefine your skills with customizable turning mechanics, whether you prefer smooth rotation or snap turning for comfort and precision. Explore cleverly designed maps with unique hiding spots that add a layer of stealth and creativity to each match.\n\nWhether you're an experienced VR player or new to the genre, this game captures the raw fun and community-driven energy of Gorilla Tag while introducing its own twist on gameplay and social interaction. Leap, duck, and outmaneuver your opponents in a vibrant world built for virtual freedom.", "short_description": "A Gorilla Tag inspired game with Tag, public rooms, private rooms, turning, and hiding."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillian-vr/privacypollicy", "developer_terms_of_service_url": null, "publisher_name": "MdevGames", "support_website_url": "https://sites.google.com/view/gorillian-vr/support", "website_url": "https://sites.google.com/view/gorillian-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9751833214907466"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9796593277098
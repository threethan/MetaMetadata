58_3299547534509325263_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKvPNkwpufsQ7kNvwFjzvhG&_nc_oc=Adn7E1psA2-_-Pv5zrdfqiRj3VNmL15D4qqx_m8KVMSBeU0Ifr_RPrYRmR9vNkhVTRE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftE85iVs__gWLmPqjXH2wRE04sgwDy5Mapo0KmFgX9tEQ&oe=699AF61E"}, {"file_name": "Screenshot3.png", "id": "683511393314653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036684_683511396647986_3047485570719539906_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZXLB-mTkFEQ7kNvwEqjkAL&_nc_oc=AdnZ-1fZzZH1nomTQe-F1Ff6Zm__GiqGHLXmsVYlMhcBnew3f2QriD2_0zfceOqNQc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuTxB7eiX2pkpyozk1LOCRyKNyS-ef1GhvbfGO3rPl1xw&oe=699B13C1"}, {"file_name": "HORIZONTAL_COMP_3 (0-00-33-54).png", "id": "1458793048299052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035383_1458793051632385_6201125288883864638_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bO-DQx6CWogQ7kNvwGllWRw&_nc_oc=AdnuTroc5rvl8pbLg-_hC1MEV3dwsOztxh33yoQJDWqm3_D34l1SCs79F6C0f6ANACc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afufx_bMz2xBmyaJV8SFS0YhPJoARSU2M3sblg9nWUHm8A&oe=699AF07E"}, {"file_name": "Screenshot4.png", "id": "827134765720718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_827134769054051_8012892633401113797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGxHs2a7bl4Q7kNvwHSzcs3&_nc_oc=AdkGTsu4mhvIQZP4iJUoM6nlScVOfOfie6lA6SIFNbNRi7PLVIwf14Z3CKgGAHpauEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftKV7RkOPjaSuyD2WDgcmG3JZ6rE7CttCD_d-2SP2tb-g&oe=699AF4A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaberCity_Trailer_Thumbnail_1.png", "id": "117461424774283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_117461428107616_4506053201965282111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTWlDBzi5DgQ7kNvwEYbcj0&_nc_oc=AdllWdFKyg8EB13MkBI0eP34FBj9o3FCd1Gb6qCoSjz6-t4_mluBKMejvYG-aCapTdc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv8SMZE9gLqgtCuJoCsa8Qvlqfg38vwE4bQAGx7_UJGVw&oe=699AFABB"}, "display_name": "Saber City", "keywords": [], "long_description": "Saber City is a 2-player co-located dueling game for Meta Quest. 2 players can link their headsets in the same physical space and battle with melee and ranged weapons. Saber City features mixed reality gameplay, so you and a friend can see each other in the real world ,via the Oculus Quest\u2019s cameras, and battle in AR.\n\n***NOTE:  Saber City is a multiplayer game and requires 2 Meta Quest headsets to play.\n\nIMPORTANT: Please maintain at least 3 feet distance between yourself and the other player. Be aware of your surroundings. Do not run with the headset on.\n\nYou can choose from 4 different character battle kits with unique weapons to wield in mixed reality. The current version of Saber City includes support for Meta Quest Pro and Quest 3.\n\nBattle Kits:\n\nCOWBORG - Cyber cowboy with cattle prod and shotgun\n\nSKYLORD - Hammer wielding warrior from beyond\n\nSKULL CZAR - Possessing dark energy sword and magic bow\n\nSABER SENTINAL - AR soldier with saber and pistol\n\nFor questions and feedback please join the Saber City Discord server: https://discord.gg/EhuQSbNeYV\n\nor contact via email: contact@yarwad.com\n\n", "short_description": "Saber City is a 2 player shared-space dueling game where players battle for supremacy in mixed-reality"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yarwad.com/sabercityprivacy", "developer_terms_of_service_url": null, "publisher_name": "Yarwad Publishing Empire", "support_website_url": null, "website_url": "https://www.yarwad.com/sabercity", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_ap
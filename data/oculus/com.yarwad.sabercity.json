ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974713_1055531602480958_3299547534509325263_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmB337ciHpMQ7kNvwG2z41X&_nc_oc=AdmivWHZXOo7mvSnxHBym4p0iZnrD8jaGQqQ9uY24jcIQcXA7Bn2Y4cqGgnNRRhZxvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHoXyqQcXiPZCBfJUOSTKQzh2K48FahrAuPtrhfD0OLg&oe=69BE8E9E"}, {"file_name": "Screenshot3.png", "id": "683511393314653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036684_683511396647986_3047485570719539906_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GipMqUSvS48Q7kNvwGxu9Id&_nc_oc=Adlf5jNL7XurJ-055RY-lsxk5lzzWP6bsLYibRWpV51Xzi3H7mSzIH35GuDaahSZ4r4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyP_nCnFJh79GROTNxkbNcBEg2cMDbdtmV-f_Tr5uMvQQ&oe=69BEAC41"}, {"file_name": "HORIZONTAL_COMP_3 (0-00-33-54).png", "id": "1458793048299052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035383_1458793051632385_6201125288883864638_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVNNJh5Z0SEQ7kNvwHlnS-7&_nc_oc=AdkzKFWVpFQAV7UqfLOUIg7uAWD2oPBPhESjiijGdfwRPtMHJPS4WZ5ZOaNj5NPMwnE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3yvIXb4PPwJ2-nQ1-F-ZvmxoJqoopx8c9amxLCSl9sg&oe=69BE88FE"}, {"file_name": "Screenshot4.png", "id": "827134765720718", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_827134769054051_8012892633401113797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEW6lPO4occQ7kNvwFELw3m&_nc_oc=AdkTpWeOB-gfdRGkP603SXFHSMf4C7-SYAUZdqGV6G5ADs3v74UrzSX8UbwdxBnj8Q8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgcXqy5wCIPWB6Uw3-ZV5KtlWFcR1VdHfhLtMBC8Om_w&oe=69BE8D23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaberCity_Trailer_Thumbnail_1.png", "id": "117461424774283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639796_117461428107616_4506053201965282111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l50LfaPEMIIQ7kNvwF1V9fn&_nc_oc=Adks9qZPmAoKjxkFC4hdm6ZJpJ7YWMNHyx-7IuzTm3F2li3t3Lyc08xu_IJQA8szQhA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwC6XvVKHlHupha74E7uasDbfOhXV_Ep5iyBG1riLCDA&oe=69BE933B"}, "display_name": "Saber City", "keywords": [], "long_description": "Saber City is a 2-player co-located dueling game for Meta Quest. 2 players can link their headsets in the same physical space and battle with melee and ranged weapons. Saber City features mixed reality gameplay, so you and a friend can see each other in the real world ,via the Oculus Quest\u2019s cameras, and battle in AR.\n\n***NOTE:  Saber City is a multiplayer game and requires 2 Meta Quest headsets to play.\n\nIMPORTANT: Please maintain at least 3 feet distance between yourself and the other player. Be aware of your surroundings. Do not run with the headset on.\n\nYou can choose from 4 different character battle kits with unique weapons to wield in mixed reality. The current version of Saber City includes support for Meta Quest Pro and Quest 3.\n\nBattle Kits:\n\nCOWBORG - Cyber cowboy with cattle prod and shotgun\n\nSKYLORD - Hammer wielding warrior from beyond\n\nSKULL CZAR - Possessing dark energy sword and magic bow\n\nSABER SENTINAL - AR soldier with saber and pistol\n\nFor questions and feedback please join the Saber City Discord server: https://discord.gg/EhuQSbNeYV\n\nor contact via email: contact@yarwad.com\n\n", "short_description": "Saber City is a 2 player shared-space dueling game where players battle for supremacy in mixed-reality"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yarwad.com/sabercityprivacy", "developer_terms_of_service_url": null, "publisher_name": "Yarwad Publishing Empire", "support_website_url": null, "website_url": "https://www.yarwad.com/sabercity", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "4
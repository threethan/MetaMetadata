7oSh8C7IfZhM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-YlOYMuX8cbeK6P6oDXpudlsR73RJVwL_i63J2NPNTQ&oe=69BBEB9E"}, {"file_name": "Screenshot3.png", "id": "683511393314653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036684_683511396647986_3047485570719539906_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GipMqUSvS48Q7kNvwF64xiQ&_nc_oc=AdmTrJ_iiPnMkSbhsNFtIGw_Hn-LPcQDviU8Bn9FcM_LtN1XsFwYI2NgvPbmrAmA7x4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxq02LtBZWAL0QP6Km9XCYLu5FEUT6RqrY82qI3Z9I_fg&oe=69BC0941"}, {"file_name": "HORIZONTAL_COMP_3 (0-00-33-54).png", "id": "1458793048299052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035383_1458793051632385_6201125288883864638_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVNNJh5Z0SEQ7kNvwHWjYpX&_nc_oc=Adn0yqx8A9kyeQKmFNVhOlWPduFZOkepZ-jLzXORPlcESel02xfxHZBsXNkYtt_cdMI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxX3DsMuKERdCU2JMvmHHJlGLBwnz6PrY8oN-Tpe6KZ5Q&oe=69BBE5FE"}, {"file_name": "Screenshot4.png", "id": "827134765720718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_827134769054051_8012892633401113797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ep98dkg6DYQ7kNvwHu6Ski&_nc_oc=AdkIlBLA3PpCE2KjT-ePCJ0Doux3ZvDM1V0SBsNV9HSUxZbUNYSizD85X1Fob8aZlwo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6RBZi1Knr3tsdVRT3CHKyF-j1hGAI0ITCTC7prVq60g&oe=69BBEA23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaberCity_Trailer_Thumbnail_1.png", "id": "117461424774283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_117461428107616_4506053201965282111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l50LfaPEMIIQ7kNvwFBmW2C&_nc_oc=Adlx9BqR4oCz0pF-vGjTo0ITGhJ53094JIeers6uS6flOSKy4EZ45S3TckwslWRBJ3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-ZdXeGc-8QRUO_ZMjIDg4MbCFjrM4gsK9aT_0392p5A&oe=69BBF03B"}, "display_name": "Saber City", "keywords": [], "long_description": "Saber City is a 2-player co-located dueling game for Meta Quest. 2 players can link their headsets in the same physical space and battle with melee and ranged weapons. Saber City features mixed reality gameplay, so you and a friend can see each other in the real world ,via the Oculus Quest\u2019s cameras, and battle in AR.\n\n***NOTE:  Saber City is a multiplayer game and requires 2 Meta Quest headsets to play.\n\nIMPORTANT: Please maintain at least 3 feet distance between yourself and the other player. Be aware of your surroundings. Do not run with the headset on.\n\nYou can choose from 4 different character battle kits with unique weapons to wield in mixed reality. The current version of Saber City includes support for Meta Quest Pro and Quest 3.\n\nBattle Kits:\n\nCOWBORG - Cyber cowboy with cattle prod and shotgun\n\nSKYLORD - Hammer wielding warrior from beyond\n\nSKULL CZAR - Possessing dark energy sword and magic bow\n\nSABER SENTINAL - AR soldier with saber and pistol\n\nFor questions and feedback please join the Saber City Discord server: https://discord.gg/EhuQSbNeYV\n\nor contact via email: contact@yarwad.com\n\n", "short_description": "Saber City is a 2 player shared-space dueling game where players battle for supremacy in mixed-reality"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yarwad.com/sabercityprivacy", "developer_terms_of_service_url": null, "publisher_name": "Yarwad Publishing Empire", "support_website_url": null, "website_url": "https://www.yarwad.com/sabercity", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "reco
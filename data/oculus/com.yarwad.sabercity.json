CHcUn7pnGYYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvyT7N9ZWvN467qfnNPqTMugosMNfcju38XyOYXFDWyzg&oe=69A9769E"}, {"file_name": "Screenshot3.png", "id": "683511393314653", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036684_683511396647986_3047485570719539906_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JxpwQpQsEEQ7kNvwHxs83D&_nc_oc=Adlr4OCS5H4TAxDMifDB4-TRPvkQo20RHXR69SfG-k87A9nK4DhYQn1Q5GNHhlRi5yE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aftrfq0QAR5rM_dn5lCCq3uEOqzm_tSMLKgvVQCFMWgihw&oe=69A99441"}, {"file_name": "HORIZONTAL_COMP_3 (0-00-33-54).png", "id": "1458793048299052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_1458793051632385_6201125288883864638_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksDBxMifxkYQ7kNvwHOUx9-&_nc_oc=AdnGMUcQP4t1ZzMBgLdZyrSFLobozEpwiP9kAQOsDvgxlXICxpMSV_ZCUuFL0vnN_ms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsAkbMDvvIXKdqZ-_qRFm31_vspekmS0GIW0ySkpeE_OQ&oe=69A970FE"}, {"file_name": "Screenshot4.png", "id": "827134765720718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_827134769054051_8012892633401113797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=001SpAw9TMoQ7kNvwHYkvX6&_nc_oc=Adk4HdCssbr2k8uPj03hZxkTRGU2t-zDlD6SMXGaOz_YGWcK9K-V8AsQMba1I1cRv4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aftp9GiG20kGr-sZUIf7MsKrWSh7FL7fBNsIoRYWiKIrTA&oe=69A97523"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaberCity_Trailer_Thumbnail_1.png", "id": "117461424774283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_117461428107616_4506053201965282111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFid_cdV_WQQ7kNvwHb9fA2&_nc_oc=Admg6-VLjNwBLzhb3F0v_oaqIXBN4eLmxX8FSLBvtjV-p0_E779d2pGVS5eyMMOPEwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuVBge_4nvuZf_yQTGzY0u0OMQA2SGbtMvegqFoZQf9kA&oe=69A97B3B"}, "display_name": "Saber City", "keywords": [], "long_description": "Saber City is a 2-player co-located dueling game for Meta Quest. 2 players can link their headsets in the same physical space and battle with melee and ranged weapons. Saber City features mixed reality gameplay, so you and a friend can see each other in the real world ,via the Oculus Quest\u2019s cameras, and battle in AR.\n\n***NOTE:  Saber City is a multiplayer game and requires 2 Meta Quest headsets to play.\n\nIMPORTANT: Please maintain at least 3 feet distance between yourself and the other player. Be aware of your surroundings. Do not run with the headset on.\n\nYou can choose from 4 different character battle kits with unique weapons to wield in mixed reality. The current version of Saber City includes support for Meta Quest Pro and Quest 3.\n\nBattle Kits:\n\nCOWBORG - Cyber cowboy with cattle prod and shotgun\n\nSKYLORD - Hammer wielding warrior from beyond\n\nSKULL CZAR - Possessing dark energy sword and magic bow\n\nSABER SENTINAL - AR soldier with saber and pistol\n\nFor questions and feedback please join the Saber City Discord server: https://discord.gg/EhuQSbNeYV\n\nor contact via email: contact@yarwad.com\n\n", "short_description": "Saber City is a 2 player shared-space dueling game where players battle for supremacy in mixed-reality"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yarwad.com/sabercityprivacy", "developer_terms_of_service_url": null, "publisher_name": "Yarwad Publishing Empire", "support_website_url": null, "website_url": "https://www.yarwad.com/sabercity", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "reco
58_3299547534509325263_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAgYDKPPxZcQ7kNvwFW2wO5&_nc_oc=AdnBqtz82Im-2-UVQY0VUgUYgkLtLQSV8Q3BceKCZE-cN9O3ZLzCwYUZ8plsiD1xWhw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu8D7EI1biLbAsudHjeoIz4foCmWO4LFR0yzT-AQm6yqg&oe=699C479E"}, {"file_name": "Screenshot3.png", "id": "683511393314653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036684_683511396647986_3047485570719539906_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKrDy9B__eYQ7kNvwHM3cVh&_nc_oc=Adk2YgsZSdT2NPb3SaSqkfNXactMiO0hLLUFEB_QLOsOtlsk1KnMcjTmyDIti0XN-Yo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuN6V8zDnT27Gh3Nz_JPehieHW9fJ9HhLOL5JVj_R5vAQ&oe=699C6541"}, {"file_name": "HORIZONTAL_COMP_3 (0-00-33-54).png", "id": "1458793048299052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035383_1458793051632385_6201125288883864638_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASpBMmUo7WgQ7kNvwFZ6QSd&_nc_oc=AdkbPYRJ_e5KHTy9Fxf04bYP9goGAUd7yblQuYjekzqXeX5LxPQkNT71U812Z2kUN54&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuCc1xPAzcBBMXvL0KvQ8beWKiaT_76fccmULU1R3iIkw&oe=699C41FE"}, {"file_name": "Screenshot4.png", "id": "827134765720718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_827134769054051_8012892633401113797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGxHs2a7bl4Q7kNvwGZOGxB&_nc_oc=AdnOg_1Grkys4uuBoTfi8TT-byL1J7J1g2yawsB8gmC_w7TvsNiGu8gzhy98pWFQU7U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afskq_3JdChrd3FI8uSbRxHG9Hie0sNC1cy3XrlUHL7Gqg&oe=699C4623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaberCity_Trailer_Thumbnail_1.png", "id": "117461424774283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_117461428107616_4506053201965282111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olQ-x9qwwvcQ7kNvwFpLcYm&_nc_oc=Adkf2FcF8U8Lb5VczEwlXgHVFus489Az40oZttq0lCVDY8fBlkhNqhvlod1qd1As4cQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsNy8814epSOoKPXKAK0e3KNl0wIDB6MwtrF_DM4OBI8Q&oe=699C4C3B"}, "display_name": "Saber City", "keywords": [], "long_description": "Saber City is a 2-player co-located dueling game for Meta Quest. 2 players can link their headsets in the same physical space and battle with melee and ranged weapons. Saber City features mixed reality gameplay, so you and a friend can see each other in the real world ,via the Oculus Quest\u2019s cameras, and battle in AR.\n\n***NOTE:  Saber City is a multiplayer game and requires 2 Meta Quest headsets to play.\n\nIMPORTANT: Please maintain at least 3 feet distance between yourself and the other player. Be aware of your surroundings. Do not run with the headset on.\n\nYou can choose from 4 different character battle kits with unique weapons to wield in mixed reality. The current version of Saber City includes support for Meta Quest Pro and Quest 3.\n\nBattle Kits:\n\nCOWBORG - Cyber cowboy with cattle prod and shotgun\n\nSKYLORD - Hammer wielding warrior from beyond\n\nSKULL CZAR - Possessing dark energy sword and magic bow\n\nSABER SENTINAL - AR soldier with saber and pistol\n\nFor questions and feedback please join the Saber City Discord server: https://discord.gg/EhuQSbNeYV\n\nor contact via email: contact@yarwad.com\n\n", "short_description": "Saber City is a 2 player shared-space dueling game where players battle for supremacy in mixed-reality"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yarwad.com/sabercityprivacy", "developer_terms_of_service_url": null, "publisher_name": "Yarwad Publishing Empire", "support_website_url": null, "website_url": "https://www.yarwad.com/sabercity", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_ap
D4PteBX2AbN0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwls5qv5hjWvdJXCfOz2ymRKvE9AawulXrzIHjGjGn6sg&oe=69B9489E"}, {"file_name": "Screenshot3.png", "id": "683511393314653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036684_683511396647986_3047485570719539906_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gORuOX-grA8Q7kNvwFi-wyB&_nc_oc=AdnNXQ8qrpfCgQKXtMx97aY6vupH8luHrGZ_78mkgWRmcBJg1tA3XuzWqU37Jy9Ogo4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIaAZQ9a7kEiWvhm0Lvl4ZYUYWZNcg5lTIhmpONRUZhA&oe=69B96641"}, {"file_name": "HORIZONTAL_COMP_3 (0-00-33-54).png", "id": "1458793048299052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035383_1458793051632385_6201125288883864638_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVGQowUY3_AQ7kNvwE5IV5B&_nc_oc=AdkjxUfunUil1kcK8GR7I8S17ek3zVowwIOIhJnauwOuj5bnTUDKKRohib0p2HurS1c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3zowsNzVizy8BCFACqqz4ODRloFO0kjQCy3yciBO9Tg&oe=69B942FE"}, {"file_name": "Screenshot4.png", "id": "827134765720718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_827134769054051_8012892633401113797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tCogtou0i0Q7kNvwEaHetE&_nc_oc=AdkE-w3GeXs-A7MuxbxsGbIqBF1dWh7jOSE0dCAIM_elj4a5LYE9tmKYOmbzB1JCuyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBfbaaKGfC8xW73R5mAXxRVCk_WVEroVHwhUm-lAnzJg&oe=69B94723"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaberCity_Trailer_Thumbnail_1.png", "id": "117461424774283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_117461428107616_4506053201965282111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGcEQZ7rAhcQ7kNvwEtcJM8&_nc_oc=AdnBp5RRotiG4yUxlLfZKCQNJIa1R3Ex59PW55YM-13KKdFAu4mrR6T3cCxOS2tjE1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxrizKeARkKy6gztxSzVuSilIsg-rjfxEQgx5ozYz1rzQ&oe=69B94D3B"}, "display_name": "Saber City", "keywords": [], "long_description": "Saber City is a 2-player co-located dueling game for Meta Quest. 2 players can link their headsets in the same physical space and battle with melee and ranged weapons. Saber City features mixed reality gameplay, so you and a friend can see each other in the real world ,via the Oculus Quest\u2019s cameras, and battle in AR.\n\n***NOTE:  Saber City is a multiplayer game and requires 2 Meta Quest headsets to play.\n\nIMPORTANT: Please maintain at least 3 feet distance between yourself and the other player. Be aware of your surroundings. Do not run with the headset on.\n\nYou can choose from 4 different character battle kits with unique weapons to wield in mixed reality. The current version of Saber City includes support for Meta Quest Pro and Quest 3.\n\nBattle Kits:\n\nCOWBORG - Cyber cowboy with cattle prod and shotgun\n\nSKYLORD - Hammer wielding warrior from beyond\n\nSKULL CZAR - Possessing dark energy sword and magic bow\n\nSABER SENTINAL - AR soldier with saber and pistol\n\nFor questions and feedback please join the Saber City Discord server: https://discord.gg/EhuQSbNeYV\n\nor contact via email: contact@yarwad.com\n\n", "short_description": "Saber City is a 2 player shared-space dueling game where players battle for supremacy in mixed-reality"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yarwad.com/sabercityprivacy", "developer_terms_of_service_url": null, "publisher_name": "Yarwad Publishing Empire", "support_website_url": null, "website_url": "https://www.yarwad.com/sabercity", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "reco
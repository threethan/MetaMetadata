ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974713_1055531602480958_3299547534509325263_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0ZWc1kQrwUQ7kNvwFZPrZ2&_nc_oc=AdltbbBgLAhbfxd9d52qXNpFnB0kDqgjeWdI3Uhthd7YfAZvS95TbKftnMjFNLPLEcE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0qrh8vl70Ou067QbWvXpjuYN0Gvod3zwbW3JYjx_WUw&oe=69B5541E"}, {"file_name": "Screenshot3.png", "id": "683511393314653", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036684_683511396647986_3047485570719539906_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaywSqW7qcsQ7kNvwH6lzdL&_nc_oc=AdkORGzV4ABpNV0BFLlrJWEWiqMTkNW7j5KhJlyIhu29lOvPlvliLk8ICy3IiXq8Wrk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw1UH5ateL90gVg6Htyp7I52C5L5SyY7LUj2KL0MuhODg&oe=69B571C1"}, {"file_name": "HORIZONTAL_COMP_3 (0-00-33-54).png", "id": "1458793048299052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035383_1458793051632385_6201125288883864638_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlTb_Ak0aZwQ7kNvwFXRgHE&_nc_oc=AdnHPhJgAnDhj8x17UnyJJyOohqHTlveQL_g0tVIHjoXUPa5ZERfPWHni-Fc-nddMGA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxp3SxSfsRc19fn5pFehcUcI444NiwvAsMjtfBVX-FmXw&oe=69B54E7E"}, {"file_name": "Screenshot4.png", "id": "827134765720718", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982592_827134769054051_8012892633401113797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMaBtPCTfdQQ7kNvwFB82UQ&_nc_oc=AdlvSdayEax66f4RJhmmu-TwI1zx76v7yJ1ex4lDFsehLq-QmtUjCvqwibEMuqXhvDg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGOaKEnOygYqQJ5NFGrifvYFzOW8NvIGTCNa6Sku8c7w&oe=69B552A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaberCity_Trailer_Thumbnail_1.png", "id": "117461424774283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639796_117461428107616_4506053201965282111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZPCbcdh2ygQ7kNvwFjK4Dw&_nc_oc=AdmonvDGJUpLgRlMmuxFc1OA-9k4EyQBsmt29iE7fVZkF4XSQ8CgGDq_gM4iRHIF72Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxkFAoqxlJlhmEvkNFD2PW3QHI4pbposF2eWCQEcpl8rQ&oe=69B558BB"}, "display_name": "Saber City", "keywords": [], "long_description": "Saber City is a 2-player co-located dueling game for Meta Quest. 2 players can link their headsets in the same physical space and battle with melee and ranged weapons. Saber City features mixed reality gameplay, so you and a friend can see each other in the real world ,via the Oculus Quest\u2019s cameras, and battle in AR.\n\n***NOTE:  Saber City is a multiplayer game and requires 2 Meta Quest headsets to play.\n\nIMPORTANT: Please maintain at least 3 feet distance between yourself and the other player. Be aware of your surroundings. Do not run with the headset on.\n\nYou can choose from 4 different character battle kits with unique weapons to wield in mixed reality. The current version of Saber City includes support for Meta Quest Pro and Quest 3.\n\nBattle Kits:\n\nCOWBORG - Cyber cowboy with cattle prod and shotgun\n\nSKYLORD - Hammer wielding warrior from beyond\n\nSKULL CZAR - Possessing dark energy sword and magic bow\n\nSABER SENTINAL - AR soldier with saber and pistol\n\nFor questions and feedback please join the Saber City Discord server: https://discord.gg/EhuQSbNeYV\n\nor contact via email: contact@yarwad.com\n\n", "short_description": "Saber City is a 2 player shared-space dueling game where players battle for supremacy in mixed-reality"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yarwad.com/sabercityprivacy", "developer_terms_of_service_url": null, "publisher_name": "Yarwad Publishing Empire", "support_website_url": null, "website_url": "https://www.yarwad.com/sabercity", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "4
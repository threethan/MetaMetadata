ps://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974713_1055531602480958_3299547534509325263_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZIHaEUtagEQ7kNvwG4izZw&_nc_oc=AdmSKObQ7oUrmszW1_akgkbzN8BzwwSATdCX6U494rdJ3R606WBrx4Mkcbvo5LZlDk8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRHgG0rzqanwHT6TM2khdFLBtQCVGiWnRUelzIREUQ1w&oe=69B7F71E"}, {"file_name": "Screenshot3.png", "id": "683511393314653", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036684_683511396647986_3047485570719539906_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gORuOX-grA8Q7kNvwGT1jrE&_nc_oc=AdkRf245ez0klEyrdsYlx-11MrtyxmFhTcEWjXBKbG3ZGtNp365D0_jnhhuHiS08uCk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbR8pvEakjDGshnFgYgt3ygfdNrZHXW7RNJeEHxSQptg&oe=69B814C1"}, {"file_name": "HORIZONTAL_COMP_3 (0-00-33-54).png", "id": "1458793048299052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035383_1458793051632385_6201125288883864638_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVGQowUY3_AQ7kNvwH8MGv7&_nc_oc=AdmHVce4yPE4779jcAW5ECDLCLfXYvBPGG_uOYa-5tzM4f5UTf3RNbJ66cymbx0MWog&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxNMlxYM7U9CTs3xDvM7795ZNO09O8knvn1qR6n0KzJeQ&oe=69B7F17E"}, {"file_name": "Screenshot4.png", "id": "827134765720718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_827134769054051_8012892633401113797_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tCogtou0i0Q7kNvwG3Ya5q&_nc_oc=AdmDCRnhDHWl3DNmLzsLkFbNH14-r7hZKxhQORyetKYZoAsCvy5KvZS2xzn6o-JgEVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXAl6TbkmLmjp2aUVs1K5OAaP7X4KBGxiN85XQIi38KA&oe=69B7F5A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SaberCity_Trailer_Thumbnail_1.png", "id": "117461424774283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639796_117461428107616_4506053201965282111_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGcEQZ7rAhcQ7kNvwGtlfvF&_nc_oc=AdmrlDmDip3BX2MogLIQDbQYDDHzx4i5tYHAQJ67FSA1VD2zYW65BT4ZzMrTbeVzL0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOv5X4k_HbM6J0Amy9F1MnAFSutSn_6lX48MVfcUzgTw&oe=69B7FBBB"}, "display_name": "Saber City", "keywords": [], "long_description": "Saber City is a 2-player co-located dueling game for Meta Quest. 2 players can link their headsets in the same physical space and battle with melee and ranged weapons. Saber City features mixed reality gameplay, so you and a friend can see each other in the real world ,via the Oculus Quest\u2019s cameras, and battle in AR.\n\n***NOTE:  Saber City is a multiplayer game and requires 2 Meta Quest headsets to play.\n\nIMPORTANT: Please maintain at least 3 feet distance between yourself and the other player. Be aware of your surroundings. Do not run with the headset on.\n\nYou can choose from 4 different character battle kits with unique weapons to wield in mixed reality. The current version of Saber City includes support for Meta Quest Pro and Quest 3.\n\nBattle Kits:\n\nCOWBORG - Cyber cowboy with cattle prod and shotgun\n\nSKYLORD - Hammer wielding warrior from beyond\n\nSKULL CZAR - Possessing dark energy sword and magic bow\n\nSABER SENTINAL - AR soldier with saber and pistol\n\nFor questions and feedback please join the Saber City Discord server: https://discord.gg/EhuQSbNeYV\n\nor contact via email: contact@yarwad.com\n\n", "short_description": "Saber City is a 2 player shared-space dueling game where players battle for supremacy in mixed-reality"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yarwad.com/sabercityprivacy", "developer_terms_of_service_url": null, "publisher_name": "Yarwad Publishing Empire", "support_website_url": null, "website_url": "https://www.yarwad.com/sabercity", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "4
25/39031639_410458242053219_5013812215682707154_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sa6K8cWwAwQ7kNvwEqA-qm&_nc_oc=AdrzWFs3m8FY9n6oGb4aTxqcVuZlUSQJ3C5j_-5QYgXvDipp7eYj0fKe9wMkR9sildw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrGEo1kU4RSYSHRUL94QhBLQdtEdYFbQ5zqNaNU6v-PQ&oe=6ACF90DD"}, {"file_name": "Untitled81_20240817162602.png", "id": "375075125430426", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75282158_375075128763759_8965455794479464072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REj9fZAzx2QQ7kNvwGouVsZ&_nc_oc=AdqSYK5oB2bmao5QlkopZuFOXPHC65p8gqN-yyJjjvHC7AZmxTwa6F7oYTnVdkoY0Es&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMnSv97DbgT-K1jX5qbrZJK7_DsqysqVUKtdBc6r9VBg&oe=6ACFB675"}, {"file_name": "Untitled81_20240817162614.png", "id": "919735316863699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75280977_919735320197032_4002963801247271361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDnJduR4rAUQ7kNvwEIh2u1&_nc_oc=AdrdaecmUP59JRbPVrzdn9poKFoL-Q_l85x02l5dL9_aSzszYC4jNYV9YhenKLgqwdM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLaTF9C0cT_g_QMc0u80XgWqWHb3NUR_4FV9HxIqNEKA&oe=6ACFB388"}, {"file_name": "Untitled81_20240817162624.png", "id": "471066962507859", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031545_471066965841192_8536542052622703616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzjJ-EhdjxQQ7kNvwEa5sua&_nc_oc=AdovpIFZX6T4kdoOMg_JeZ8O1YOhHVZgSbbRgDyb3Ym4POPix1sVPBus-IkWDiNvPe4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbU9A_MF2SpSbz2sYmzBxLEPK0GyeAz_4wwVoBMmRv8Q&oe=6ACFAB7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RyeVen 2", "keywords": [], "long_description": "RyeVen 2 is an incredibly entertaining and immersive game that offers players the exhilarating experience of swinging through vibrant, dynamic environments using only their arms. Whether you're soaring through the air, navigating challenging obstacles, or exploring breathtaking landscapes, the game provides endless excitement and thrill. Additionally, RyeVen 2 emphasizes social interaction, allowing you to hang out and collaborate with friends, creating unforgettable moments and fostering a sense of community. The combination of its unique gameplay mechanics and social features makes RyeVen 2 a must-play for anyone seeking adventure and camaraderie in a virtual world.", "short_description": "RyeVen 2 Is a very fun game where you can swing around with your arms and hang out with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyryeven2/home", "developer_terms_of_service_url": null, "publisher_name": "Venakry", "support_website_url": null, "website_url": "https://sites.google.com/view/ryeven2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8244049009021264"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035371_487740160817078_4581166938424330217_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GdRlD51JXMQ7kNvwGnqASg&_nc_oc=AdpwA2wFk7oNj-LIovHXkVU_Cqe6BPzhwaHbLwgIcdfc84Q1WGZdcNSKF4ZSJo4s0ig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzLBXTDdxQA-SWQ1wwCvpmL588URY1l2HJsYk388oQbA&oe=6ACFA977"}, "is
80Ku9QiW_s69Tn0_UNQsrjoBKWLVuhImj3PKZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJwUSfPbxzSJCVhTxlCb8ujDCsr3b9BA5xAQDfc-aD0A&oe=69AD86DD"}, {"file_name": "Untitled81_20240817162602.png", "id": "375075125430426", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75282158_375075128763759_8965455794479464072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiksJueGy1gQ7kNvwEwLSC4&_nc_oc=AdnIPc7b2YgSIXK7vytFUmVm9Qkj73WXPx0P1X__V832hK90w_2-Qe2dOtCV7UDHP4s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnM4QP7cXKN2AoCbqDwfb5tg6-RfrlR5VxPskQulvrmQ&oe=69AD7435"}, {"file_name": "Untitled81_20240817162614.png", "id": "919735316863699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75280977_919735320197032_4002963801247271361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLGlsusQDcYQ7kNvwEmG-x5&_nc_oc=AdndeFb8tQ8L7PHpmRIMv2UbVfPMTEomFTWbofYs3KxlivGOk9zV0gAV6JpNC1KekQ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJFm0e0VTYTHkcNt8UtxYcL1s9CORH6bIew-Da_0MB0g&oe=69AD7148"}, {"file_name": "Untitled81_20240817162624.png", "id": "471066962507859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031545_471066965841192_8536542052622703616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEHOiLR07AQQ7kNvwGRfq-Z&_nc_oc=AdnX0MaN4K8wDRXcCLu0C6yiW-buiF1UKECVnCRh-2t92o4O_g_xGZY52JJSZ3z5BdE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHPgGF61VlC-2ShJxVApRAPkrP1UThpEMjaiHuybVlMw&oe=69AD693E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RyeVen 2", "keywords": [], "long_description": "RyeVen 2 is an incredibly entertaining and immersive game that offers players the exhilarating experience of swinging through vibrant, dynamic environments using only their arms. Whether you're soaring through the air, navigating challenging obstacles, or exploring breathtaking landscapes, the game provides endless excitement and thrill. Additionally, RyeVen 2 emphasizes social interaction, allowing you to hang out and collaborate with friends, creating unforgettable moments and fostering a sense of community. The combination of its unique gameplay mechanics and social features makes RyeVen 2 a must-play for anyone seeking adventure and camaraderie in a virtual world.", "short_description": "RyeVen 2 Is a very fun game where you can swing around with your arms and hang out with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyryeven2/home", "developer_terms_of_service_url": null, "publisher_name": "Venakry", "support_website_url": null, "website_url": "https://sites.google.com/view/ryeven2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8244049009021264"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035371_487740160817078_4581166938424330217_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQASn3236cwQ7kNvwFd-PKy&_nc_oc=Adluaw7XA1INLetp7Jibpmw1PucnMJCmV3td3VLJoy9DJrnaQ1DHbpiwR7HQ0xXfk2w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6lPcEAZNhHhBuYh96Hqfy_cPVhLCqqq-4W3ES9FsI8Q&oe=69AD6737"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RyeVen 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
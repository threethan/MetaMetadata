YWoL5wF22tDmaZeazbhS31B9tNe9yEmZAfLinQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwNdgK3tyZEtQEWAGiKKG2IiEFWisTG0H8c7qr4FSaZdA&oe=69B9645D"}, {"file_name": "Untitled81_20240817162602.png", "id": "375075125430426", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282158_375075128763759_8965455794479464072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seXg-rdme_gQ7kNvwH7rmjB&_nc_oc=AdldH0EMxPQbJxuZMMO4mkVsujoqJn28G4u1qoheQnS3LziJk2yqrjGSioqisf4z6I4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzsWM_QdKJfFmL0U7NG1PCWSq6Ei78mDR8j9ZJBBX3iDQ&oe=69B951B5"}, {"file_name": "Untitled81_20240817162614.png", "id": "919735316863699", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75280977_919735320197032_4002963801247271361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUGhYcQ8AaYQ7kNvwEsTcQy&_nc_oc=AdmPsxhh2hx19bTJTd-rGQUbhrIr8pgJSJ2f7q0sZR2dMx-vrD4xTtjTHKmIL9wa160&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwrwTBRPof9TXS4K-arPWJ5QGH0R8OPdTab3iFvH_x1ZQ&oe=69B94EC8"}, {"file_name": "Untitled81_20240817162624.png", "id": "471066962507859", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031545_471066965841192_8536542052622703616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlqppOKXViwQ7kNvwFrylx2&_nc_oc=AdkQ_SaFYUkLkeOyaYMIt8qtsc9vcHUgGGOfm7gnjpWkDo-KTS3BTcTODnqTmWGWEzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7asBoU0k2NpgSZDwt9VA1ZoUKo7RXMv6gMaJJmMCCIw&oe=69B946BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RyeVen 2", "keywords": [], "long_description": "RyeVen 2 is an incredibly entertaining and immersive game that offers players the exhilarating experience of swinging through vibrant, dynamic environments using only their arms. Whether you're soaring through the air, navigating challenging obstacles, or exploring breathtaking landscapes, the game provides endless excitement and thrill. Additionally, RyeVen 2 emphasizes social interaction, allowing you to hang out and collaborate with friends, creating unforgettable moments and fostering a sense of community. The combination of its unique gameplay mechanics and social features makes RyeVen 2 a must-play for anyone seeking adventure and camaraderie in a virtual world.", "short_description": "RyeVen 2 Is a very fun game where you can swing around with your arms and hang out with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyryeven2/home", "developer_terms_of_service_url": null, "publisher_name": "Venakry", "support_website_url": null, "website_url": "https://sites.google.com/view/ryeven2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8244049009021264"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035371_487740160817078_4581166938424330217_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhzB1tSPmRIQ7kNvwE1dsBa&_nc_oc=AdkC6AhwIMSvXTJF4AGNvwpv4Srn5RNy6MGy179GIeEAaPO0mHUaJV_DlcpgckrRdk4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZx0XYdB71ANphItukNU-6RzBVrk6Go7JvPhZ-2lDglQ&oe=69B944B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RyeVen 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id"
25/39031639_410458242053219_5013812215682707154_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HJ-LCImglkQ7kNvwHKFOzl&_nc_oc=AdrPemActd2pIl_ABCJwkyFiE2cdl9XeNdABGlc1zSCr1FFA1LpShhDonTskkjPX26M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSycEORm8LLoC2aQzWcTOqj51sTvE1i1SIsrcfkgPkH-A&oe=6AEB405D"}, {"file_name": "Untitled81_20240817162602.png", "id": "375075125430426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75282158_375075128763759_8965455794479464072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIOYMZP_8s0Q7kNvwENYWqN&_nc_oc=AdqOim54-4OlB9v4VwVSATcdH2MgmnQofHwKVJrqmlQ55Uoy649T5S5FakS51j2aLyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSngG3LgG3C5OtG7Qug87FIYiF9u9A02OvK49xjdXABvA&oe=6AEB2DB5"}, {"file_name": "Untitled81_20240817162614.png", "id": "919735316863699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75280977_919735320197032_4002963801247271361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGQCMtvwOAoQ7kNvwHSVFOF&_nc_oc=Adr8bUUf8_SZ1U-UJsQmqEWq1cjcfw9fTc3NDV5FFFz2jm_-TTTkjQjiJ39sg5otpEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxK_lhTzRKu0AsNl812oKeSfQOAMWPOLUdyK8HnTx8eQ&oe=6AEB6308"}, {"file_name": "Untitled81_20240817162624.png", "id": "471066962507859", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031545_471066965841192_8536542052622703616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4tJJghu7VsQ7kNvwECOFn0&_nc_oc=Adq94cWSJNo8NoIQ3wSujpkATh8_iIvep9lfsEZW6mIjwVbbvjQ1Rz80eqh-CCDpDeo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdaLbhX1UJJppA5lkhBs8yk9hOJjVgz_Z2-iyEHIw0pw&oe=6AEB5AFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RyeVen 2", "keywords": [], "long_description": "RyeVen 2 is an incredibly entertaining and immersive game that offers players the exhilarating experience of swinging through vibrant, dynamic environments using only their arms. Whether you're soaring through the air, navigating challenging obstacles, or exploring breathtaking landscapes, the game provides endless excitement and thrill. Additionally, RyeVen 2 emphasizes social interaction, allowing you to hang out and collaborate with friends, creating unforgettable moments and fostering a sense of community. The combination of its unique gameplay mechanics and social features makes RyeVen 2 a must-play for anyone seeking adventure and camaraderie in a virtual world.", "short_description": "RyeVen 2 Is a very fun game where you can swing around with your arms and hang out with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyryeven2/home", "developer_terms_of_service_url": null, "publisher_name": "Venakry", "support_website_url": null, "website_url": "https://sites.google.com/view/ryeven2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8244049009021264"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035371_487740160817078_4581166938424330217_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuiM5aZYHe4Q7kNvwG6hGsl&_nc_oc=AdqO12NFB-dPjsG25Im18NfOKddscV-WNGsB2a0IEj_aWo9sykfZE1prLwkdH0ecvVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2b1HB9NuxsyXYC8k4OamzHTz1QM1n_OdcNUmW9TS22Q&oe=6AEB58F7"}, "is
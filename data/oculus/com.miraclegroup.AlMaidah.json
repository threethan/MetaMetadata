Al-Ma'idah", "keywords": [], "long_description": "Explore the recitation of Surah Al-Ma'idah, the fifth chapter of the Holy Quran, through a deeply immersive virtual reality experience created for Meta Quest.\n\nThis VR experience allows you to listen and reflect on the verses of Surah Al-Ma'idah in a calm and distraction-free environment. The thoughtfully designed virtual setting enhances concentration and provides a peaceful space for spiritual reflection while engaging with the Quran.\n\nSurah Al-Ma'idah highlights themes of faithfulness, justice, lawful and unlawful actions, and the importance of fulfilling commitments. It contains important guidance for believers regarding moral conduct, community responsibility, and obedience to Allah.", "short_description": "Surah Al-Ma'idah highlights themes of faithfulness, justice, lawful and unlawful actions, and the importance of fulfilling commitments. It contains important guidance for believers regarding moral conduct, community responsibility, and obedience to Allah."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3412
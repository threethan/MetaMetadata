5/499305448_695253276449064_5316910300881667411_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uotK89Hv4_AQ7kNvwEHddxq&_nc_oc=AdrrPDwbfiGiYlV1PKXLQoGpPvqGNJ_CPuuX0Uywh38lPcalhXMsndVhBLyE2f7X-X8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBS9rW83HfvUDPu6QLRH5IWf0EOPQ-Gfxksfz1SZb0bUA&oe=6A676279"}, {"file_name": "cavesss.png", "id": "1229799225457339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619608_1229799228790672_3030275293143708689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OG1AbaozqcQQ7kNvwGRNafk&_nc_oc=AdpaMcNcl4zdElip0eu-4DMO5LPFNT2nVXMfRzvBExSYm6EHZTlB58VE_dXbi5VxL44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIdZLeVq7EhZykJwgJ7JNkd2D1SEK-G326JdkzJ8zk7A&oe=6A674490"}, {"file_name": "swimmingpoolss.png", "id": "9656705541119167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824045_9656705551119166_5361459141121333778_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3jWqOBxDswQ7kNvwG-MMbP&_nc_oc=AdoWteXzcyynq5g000pYnncQpbuyPoG2u9zoZ2alWCW2r5Gefxy3-l6yEYDQY-FBiQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs1SzFiucguEFa6Q6o4jEe5IxZiDS75iDk7EdEKhfYxQ&oe=6A674E92"}, {"file_name": "monkeystandingss.png", "id": "740919798468254", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307344_740919801801587_7374549863553219978_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QD29jyCPsaAQ7kNvwHAhSel&_nc_oc=AdoSleFiPd2m__SILTXP6Fi5QMxzKudVzq-v64HUwqMhFgNrKpAfsKgonc2eBpv7xNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdTGm9rHuCPsthd7ZPKs-e1INCsXrGiJZorH9NB6sJaA&oe=6A674BC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DuoTaggers", "keywords": [], "long_description": "DuoTaggers is a multiplayer VR game where players use their hands to move, climb, swim, and explore different maps together. Whether you're diving through the calm waters of the Swimming Room, hanging out in the spooky scary Caves while the monster chases you or leaping through the trees in the Forest, DuoTaggers offers a variety of environments to match your mood and play style.\n\nWith realistic hand-based locomotion and built-in voice chat, DuoTaggers lets you freely explore, socialize, or goof off with friends in VR. You could also customize your look with unlockable cosmetics with the in-game currency and enjoy smooth movement.\n\nDesigned for teens and up, DuoTaggers offers a chill yet dynamic social VR experience where creativity and freedom come first.\n\n", "short_description": "DuoTaggers is a fast-paced multiplayer VR game where players run, climb, and explore three unique maps: the Forest, spookyy underground caves, and a relaxing Swimming Room. Use your hands to move around, chat with others using voice, and unlock fun cosmetics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://duotaggersprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Slothy", "support_website_url": null, "website_url": "https://duotaggersprivacypolicy.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9715774245218811"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308305_1349852942765770_5953077826807622015_n.p
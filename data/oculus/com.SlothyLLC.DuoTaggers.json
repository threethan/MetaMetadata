.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFalAYG1ypRkZlrXJU7mxHAEOIE38-dIyQFRSU_Ar0LQ&oe=6B0F1E9B"}, {"file_name": "stumpss.png", "id": "695253273115731", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305448_695253276449064_5316910300881667411_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYAuuj5K2zUQ7kNvwFLlFrj&_nc_oc=AdqCXOz8qTrytX-kCADzpYQ8OrqT3wPNheuRQZg1gmAH-UcjhIYE6u4wphN-nSoYDNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVhpaKUtyr3mYJ3iyp9_eC6Zlcl2YiwIai-LkzfyWFxyA&oe=6B0F0939"}, {"file_name": "cavesss.png", "id": "1229799225457339", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619608_1229799228790672_3030275293143708689_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzUC-uEFttgQ7kNvwFYdwkS&_nc_oc=AdpNCnYdCsDUdFZAZKjpvRkkpjP4Yst4A1CXykFs18dm34dwS4GmXE_IfG_uj1ia400&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXBkpx7KMGgnTomJZpqiC72OMpSbqvU9UJiQhf_aETnoA&oe=6B0EEB50"}, {"file_name": "swimmingpoolss.png", "id": "9656705541119167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824045_9656705551119166_5361459141121333778_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rMWScLpsMYQ7kNvwGA2vfL&_nc_oc=AdpDLdY1gZJngv4AUYK8oRBSG_Xb6TX9hfJAehUxVUTAsZ2ObPKn5CRY4zbJcSSa5FQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVF_cN9s7Ab0CBYZYxWVjA5EVl4scDy9DxFF2U8zA_tfg&oe=6B0EF552"}, {"file_name": "monkeystandingss.png", "id": "740919798468254", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307344_740919801801587_7374549863553219978_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_jJO3yS-IIQ7kNvwFlxmmC&_nc_oc=Adrx-cNZ_v4jIIQjz8iln1IIqgMHzoh5QZ4WO5wpDD1GfHGvImw4kpFdvrv-X0jdfBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWIKI6S67C2EigdyTYQCXDPdNgjiUYyissZjdfc-9LVWg&oe=6B0EF288"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DuoTaggers", "keywords": [], "long_description": "DuoTaggers is a multiplayer VR game where players use their hands to move, climb, swim, and explore different maps together. Whether you're diving through the calm waters of the Swimming Room, hanging out in the spooky scary Caves while the monster chases you or leaping through the trees in the Forest, DuoTaggers offers a variety of environments to match your mood and play style.\n\nWith realistic hand-based locomotion and built-in voice chat, DuoTaggers lets you freely explore, socialize, or goof off with friends in VR. You could also customize your look with unlockable cosmetics with the in-game currency and enjoy smooth movement.\n\nDesigned for teens and up, DuoTaggers offers a chill yet dynamic social VR experience where creativity and freedom come first.\n\n", "short_description": "DuoTaggers is a fast-paced multiplayer VR game where players run, climb, and explore three unique maps: the Forest, spookyy underground caves, and a relaxing Swimming Room. Use your hands to move around, chat with others using voice, and unlock fun cosmetics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://duotaggersprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Slothy", "support_website_url": null, "website_url": "https://duotaggersprivacypolicy.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "su
5/499305448_695253276449064_5316910300881667411_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uotK89Hv4_AQ7kNvwGxxpmY&_nc_oc=AdozIWe3E03Q67xLa_DO7u009148AnOD4XcB0MOvRcUQbBftmKv7a7AsfOHH89ZPqZw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq--3SCj1sBULgdxDYhRppYseoy-PRDdU-oPoAszAW_w&oe=6A6610F9"}, {"file_name": "cavesss.png", "id": "1229799225457339", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619608_1229799228790672_3030275293143708689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OG1AbaozqcQQ7kNvwGh50fA&_nc_oc=AdqwATf1mCpuR3ceh7SzFHS6jxv_vebNYVAqtr5QOT4cWapqEsnhcYaTywJxFezMkWg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc6ozEhAiJEMIr_U_HNfGuY0Rx7N06aZkS90WNnr8LuA&oe=6A65F310"}, {"file_name": "swimmingpoolss.png", "id": "9656705541119167", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824045_9656705551119166_5361459141121333778_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA3AmwrCMcUQ7kNvwGyTJUH&_nc_oc=AdofYxLtRJ5pNELUToqFxvRU5aCBmLEVRkE7DsCUupUe-p4ll1kF-z2uGhsfr4ytU8k&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6OWC7_Fr5r3Uya2G_M_WnqPIKk7gAUqs0BOdicLc5eA&oe=6A65FD12"}, {"file_name": "monkeystandingss.png", "id": "740919798468254", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307344_740919801801587_7374549863553219978_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QD29jyCPsaAQ7kNvwEdbL-d&_nc_oc=Adqi6reqrALyld_Op5OKvveWmduYq-d73sAgV_xDahNIMq-IDM3S_qZdT89Sy5W-xVM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAymhg76RpDR0PEyrTCd44T2RI5WaOelBkhed2VWEmgfw&oe=6A65FA48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DuoTaggers", "keywords": [], "long_description": "DuoTaggers is a multiplayer VR game where players use their hands to move, climb, swim, and explore different maps together. Whether you're diving through the calm waters of the Swimming Room, hanging out in the spooky scary Caves while the monster chases you or leaping through the trees in the Forest, DuoTaggers offers a variety of environments to match your mood and play style.\n\nWith realistic hand-based locomotion and built-in voice chat, DuoTaggers lets you freely explore, socialize, or goof off with friends in VR. You could also customize your look with unlockable cosmetics with the in-game currency and enjoy smooth movement.\n\nDesigned for teens and up, DuoTaggers offers a chill yet dynamic social VR experience where creativity and freedom come first.\n\n", "short_description": "DuoTaggers is a fast-paced multiplayer VR game where players run, climb, and explore three unique maps: the Forest, spookyy underground caves, and a relaxing Swimming Room. Use your hands to move around, chat with others using voice, and unlock fun cosmetics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://duotaggersprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Slothy", "support_website_url": null, "website_url": "https://duotaggersprivacypolicy.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9715774245218811"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499308305_1349852942765770_5953077826807622015_n.p
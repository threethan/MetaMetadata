m/v/t64.5771-25/499305448_695253276449064_5316910300881667411_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBRC3esMdIgQ7kNvwGY4i_z&_nc_oc=Adq0B-e-A-kyx-Ci9m7jv85rfWOjK_ljL4VHtHvy6fbuQGFpCbKWsCkop02ag1AUmoA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAq8sHAkN_MXGDEqongaRiOqIvJjanAJWHwasasB5-kg&oe=6A857CB9"}, {"file_name": "cavesss.png", "id": "1229799225457339", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619608_1229799228790672_3030275293143708689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1ZAoJr78wkQ7kNvwHi-BQx&_nc_oc=AdoQPGszmvSbymqUMrVy7-rGK2Kbv8sfCaMfBZW3UtSleOXcaIFj3EuPvKtGI4cJ4BY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnZoGQzRr0lcCACqP8kbvGiQEIX8GdvOQKO6q_vjfRqA&oe=6A859710"}, {"file_name": "swimmingpoolss.png", "id": "9656705541119167", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824045_9656705551119166_5361459141121333778_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRdYJ9XtnlIQ7kNvwGs7JZq&_nc_oc=AdqmIEBCHT5Hpmj6S3efLrO3xZI2fdtQILHrv77Cc6BDkgQSIBSYAsBJ2V8sVggl3YY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4aV_qS4_2hiaaNwj7uWItmobCL5oQTIsyYZK8Y4wHfg&oe=6A85A112"}, {"file_name": "monkeystandingss.png", "id": "740919798468254", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499307344_740919801801587_7374549863553219978_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pbf5PNOcJmsQ7kNvwGpUfXF&_nc_oc=AdqllOg2cjsq_oEUEXNBAAvvhoOBVi-ufpafHqTSxBtYZ9MstyMVeUI5rbjbbOjgn0E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXlkOaSoF8o4RrjY1Tgo3br-Rsu5hVPVCIG0gpH0zQUw&oe=6A859E48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DuoTaggers", "keywords": [], "long_description": "DuoTaggers is a multiplayer VR game where players use their hands to move, climb, swim, and explore different maps together. Whether you're diving through the calm waters of the Swimming Room, hanging out in the spooky scary Caves while the monster chases you or leaping through the trees in the Forest, DuoTaggers offers a variety of environments to match your mood and play style.\n\nWith realistic hand-based locomotion and built-in voice chat, DuoTaggers lets you freely explore, socialize, or goof off with friends in VR. You could also customize your look with unlockable cosmetics with the in-game currency and enjoy smooth movement.\n\nDesigned for teens and up, DuoTaggers offers a chill yet dynamic social VR experience where creativity and freedom come first.\n\n", "short_description": "DuoTaggers is a fast-paced multiplayer VR game where players run, climb, and explore three unique maps: the Forest, spookyy underground caves, and a relaxing Swimming Room. Use your hands to move around, chat with others using voice, and unlock fun cosmetics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://duotaggersprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Slothy", "support_website_url": null, "website_url": "https://duotaggersprivacypolicy.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9715774245218811"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499308305_1349852942765770_5953
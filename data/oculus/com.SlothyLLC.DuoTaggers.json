5/499305448_695253276449064_5316910300881667411_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skItvGweR0YQ7kNvwHv02nn&_nc_oc=AdossMxD45yZKYvRxztTFa_5rB5YeKxN7m7ocGgrCGtC2VxG58gD5KMqA97xYu_Juqw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvIxtrLX7Jq-eULOSrLWQvhC3lDOHblF45N8DReY6eTw&oe=6ABD13F9"}, {"file_name": "cavesss.png", "id": "1229799225457339", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619608_1229799228790672_3030275293143708689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-GtXPzCrBsQ7kNvwE4GG7Q&_nc_oc=AdoNqUh4woVLLv_lvE9G9Zj0rjL89YPCc0rCG5kknJr13g-hcI21FhhRPXM-I3d0udk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0qtJqgtB3IxI9EbYYml5Q4wH9p48eaWajjsH0AcCMaQ&oe=6ABD2E50"}, {"file_name": "swimmingpoolss.png", "id": "9656705541119167", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824045_9656705551119166_5361459141121333778_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXkqipbW2TYQ7kNvwFaZ774&_nc_oc=AdpGTyw-K2CMj3Wd5YY52nxHLZv5H7AbaH1Spp6Vz3VuMWwnHv3ciyXXqa28CYdkRpM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDtnsTXy77IBeN_f135-iIbABHCeEBppg4CXgIwBamWA&oe=6ABD0012"}, {"file_name": "monkeystandingss.png", "id": "740919798468254", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307344_740919801801587_7374549863553219978_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iL_2J_ukZqsQ7kNvwEITl24&_nc_oc=Adof4PPVm5_U0IQ25RTayzcFUJ4rBbYE6Ar2c2B6NJsjVSp6y26C_jJ6ULg96_3SLAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd7-uQGpU6n-1juTlf18Ny3n8cwuQ98qggzvgy2ZM3UA&oe=6ABD3588"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DuoTaggers", "keywords": [], "long_description": "DuoTaggers is a multiplayer VR game where players use their hands to move, climb, swim, and explore different maps together. Whether you're diving through the calm waters of the Swimming Room, hanging out in the spooky scary Caves while the monster chases you or leaping through the trees in the Forest, DuoTaggers offers a variety of environments to match your mood and play style.\n\nWith realistic hand-based locomotion and built-in voice chat, DuoTaggers lets you freely explore, socialize, or goof off with friends in VR. You could also customize your look with unlockable cosmetics with the in-game currency and enjoy smooth movement.\n\nDesigned for teens and up, DuoTaggers offers a chill yet dynamic social VR experience where creativity and freedom come first.\n\n", "short_description": "DuoTaggers is a fast-paced multiplayer VR game where players run, climb, and explore three unique maps: the Forest, spookyy underground caves, and a relaxing Swimming Room. Use your hands to move around, chat with others using voice, and unlock fun cosmetics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://duotaggersprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Slothy", "support_website_url": null, "website_url": "https://duotaggersprivacypolicy.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9715774245218811"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308305_1349852942765770_5953077826807622015_n.p
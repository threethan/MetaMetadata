5/499305448_695253276449064_5316910300881667411_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNN6d8N_LLcQ7kNvwHXiFOY&_nc_oc=AdpcJzvY4cIvqHjTWzxyRfLbIkTScOcB2TRhJrrMCwaimLFRDydWoBjKn4Tfe_lXQ6I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60Ofw0oUHdu0D-LuGOVShoEy77kVUYtGbaQI8IBWVfvg&oe=6A1C3CF9"}, {"file_name": "cavesss.png", "id": "1229799225457339", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619608_1229799228790672_3030275293143708689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4wBG23cBQQQ7kNvwGZHqBl&_nc_oc=AdpjngF7MUi90pgosMktAfFubpXz-cPMtksB6Yhbqn84H4Gc6SBgIbey7DMOkFvODiM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R3qLuVe0kWcl8X3G2xJ7gYsQxCFTd_JAocdwnTH_C5Q&oe=6A1C5750"}, {"file_name": "swimmingpoolss.png", "id": "9656705541119167", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824045_9656705551119166_5361459141121333778_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-zRjwRqvmAQ7kNvwGUlFgU&_nc_oc=AdrxS26Y3ahHN3K6Rd0E2VrJ2k37XdLzhDc_6_ZW6hLTK3X1rXNZVPqxB8TaKCWal0k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c9Sicj19o1xNVSiZYmTOFJId0-l5oJ1BlJRFOYBzX-w&oe=6A1C6152"}, {"file_name": "monkeystandingss.png", "id": "740919798468254", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499307344_740919801801587_7374549863553219978_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOltF_Mo2_cQ7kNvwGLrEr-&_nc_oc=AdqwvO4AVWyKtXMIgkk_WR-89B8ScTBJl3hSe3zJdm3zKLvbULMSVK5G-bQWpxHtMc0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af770X07h2J79jZsgBQWTnhiIaXyiT8xP6sT0jDot87snw&oe=6A1C5E88"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DuoTaggers", "keywords": [], "long_description": "DuoTaggers is a multiplayer VR game where players use their hands to move, climb, swim, and explore different maps together. Whether you're diving through the calm waters of the Swimming Room, hanging out in the spooky scary Caves while the monster chases you or leaping through the trees in the Forest, DuoTaggers offers a variety of environments to match your mood and play style.\n\nWith realistic hand-based locomotion and built-in voice chat, DuoTaggers lets you freely explore, socialize, or goof off with friends in VR. You could also customize your look with unlockable cosmetics with the in-game currency and enjoy smooth movement.\n\nDesigned for teens and up, DuoTaggers offers a chill yet dynamic social VR experience where creativity and freedom come first.\n\n", "short_description": "DuoTaggers is a fast-paced multiplayer VR game where players run, climb, and explore three unique maps: the Forest, spookyy underground caves, and a relaxing Swimming Room. Use your hands to move around, chat with others using voice, and unlock fun cosmetics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://duotaggersprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Slothy", "support_website_url": null, "website_url": "https://duotaggersprivacypolicy.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9715774245218811"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499308305_1349852942765770_5953077826807622015_n.p
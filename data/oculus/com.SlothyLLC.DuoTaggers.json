m3V8Q7kNvwGUzAys&_nc_oc=Adk66x3XojFKF_YxNJuzKKBFliQ8cz4g3bz9dRyI1BLLvIF6dFgIDLTAMpe2gG_1vn4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvvuddeWvTDy14P9iFrza144Jfst5Jva97I7_EVJ1HzlQ&oe=69A595F9"}, {"file_name": "cavesss.png", "id": "1229799225457339", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619608_1229799228790672_3030275293143708689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Y0OOVdoXpgQ7kNvwEXQE0t&_nc_oc=AdmpUqxPIXG_axYPIbbIVEW7tpqy020KCQbNfPnGRRQziHapGaV_TA-B4oJSEWmjUwM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftGX3549DHzL6tGyoyLedccBGbXjGnjw8IJcmAgJA6-vA&oe=69A57810"}, {"file_name": "swimmingpoolss.png", "id": "9656705541119167", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824045_9656705551119166_5361459141121333778_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdtkDy4GEKoQ7kNvwGouS0H&_nc_oc=AdnKj9kJBvcJP8HSgRMZMSohsYQo1Xy1IJdtxCudFFbWIWfNrjLFjXxoBe1VDe7WzS4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuvBh5WH25Ovztb8o1QJmj1qW8GAGfYOn18fo5la5k00w&oe=69A58212"}, {"file_name": "monkeystandingss.png", "id": "740919798468254", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307344_740919801801587_7374549863553219978_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JllReHk5ekkQ7kNvwH108dr&_nc_oc=Adl5lc7S5e99h7c0egIdAyfjl3z84041MclC0siLRNHqIM6iMMg89pdSf9DwxDI-Bzs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfszEEsRxGCnxXaAlkpYkjSy3xv3CQ8m8-l05Djky6PZ_w&oe=69A57F48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DuoTaggers", "keywords": [], "long_description": "DuoTaggers is a multiplayer VR game where players use their hands to move, climb, swim, and explore different maps together. Whether you're diving through the calm waters of the Swimming Room, hanging out in the spooky scary Caves while the monster chases you or leaping through the trees in the Forest, DuoTaggers offers a variety of environments to match your mood and play style.\n\nWith realistic hand-based locomotion and built-in voice chat, DuoTaggers lets you freely explore, socialize, or goof off with friends in VR. You could also customize your look with unlockable cosmetics with the in-game currency and enjoy smooth movement.\n\nDesigned for teens and up, DuoTaggers offers a chill yet dynamic social VR experience where creativity and freedom come first.\n\n", "short_description": "DuoTaggers is a fast-paced multiplayer VR game where players run, climb, and explore three unique maps: the Forest, spookyy underground caves, and a relaxing Swimming Room. Use your hands to move around, chat with others using voice, and unlock fun cosmetics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://duotaggersprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Slothy", "support_website_url": null, "website_url": "https://duotaggersprivacypolicy.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9715774245218811"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308305_1349852942765770_5953077826807622015_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xEiIrFe8-4Q7kNvwHutwcf&_nc_oc=Adk1R2QyBjZWCBodUQY6Rw6KF3GdpCDhOMxNiZlrbjP_r7mxZ_cmgnv0QH
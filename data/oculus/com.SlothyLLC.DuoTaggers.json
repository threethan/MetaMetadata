6QkcQ7kNvwGDn8OR&_nc_oc=Adn7c1q6dCL7SAIk8Ae0Z-novLpyjmxGWKA0vt8UJrQ9mGoy3CRtQRYhQxau8xUiHLc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsGR41zU3iATjZM6SLTJ3u7rZ-zPD4hAgdj-dIm9y_hNQ&oe=69A1A179"}, {"file_name": "cavesss.png", "id": "1229799225457339", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619608_1229799228790672_3030275293143708689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N03tZ_okoFMQ7kNvwGQ0tOR&_nc_oc=AdkA1Dedm_axfr-PtBQXaxEvlAZVdmft4E_-tmyqzccDQBosxioyvBM3XIpbkn6fOv0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afvwqg6pcQf1cbHbk4gU72GBowOn3t7Jfn3VJ2wTqljwAA&oe=69A18390"}, {"file_name": "swimmingpoolss.png", "id": "9656705541119167", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491824045_9656705551119166_5361459141121333778_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObLlayFRUuAQ7kNvwGPWt7D&_nc_oc=Admj6xTX9OrfNl0dkwIUe0jasPgEz3vHquAOima21k82vGXEyMljRpcRNwV4nwmueqY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs3cVs6B5jSTiMTIsfftnk4XSagMtTGXnhdvfpR6JSDYg&oe=69A18D92"}, {"file_name": "monkeystandingss.png", "id": "740919798468254", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499307344_740919801801587_7374549863553219978_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHz2mRvUYEkQ7kNvwFdnsyq&_nc_oc=AdkL9z0ebXK55nkaZoxNk5PnMqURDKp4GvRQ6aHz6q44QxwgV1FhQPY43dgmm0cQZkY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft_dODixtAGg1xXjoMbaj0eA9wOPigKmDHP4HncGxfFZg&oe=69A18AC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DuoTaggers", "keywords": [], "long_description": "DuoTaggers is a multiplayer VR game where players use their hands to move, climb, swim, and explore different maps together. Whether you're diving through the calm waters of the Swimming Room, hanging out in the spooky scary Caves while the monster chases you or leaping through the trees in the Forest, DuoTaggers offers a variety of environments to match your mood and play style.\n\nWith realistic hand-based locomotion and built-in voice chat, DuoTaggers lets you freely explore, socialize, or goof off with friends in VR. You could also customize your look with unlockable cosmetics with the in-game currency and enjoy smooth movement.\n\nDesigned for teens and up, DuoTaggers offers a chill yet dynamic social VR experience where creativity and freedom come first.\n\n", "short_description": "DuoTaggers is a fast-paced multiplayer VR game where players run, climb, and explore three unique maps: the Forest, spookyy underground caves, and a relaxing Swimming Room. Use your hands to move around, chat with others using voice, and unlock fun cosmetics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://duotaggersprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Slothy", "support_website_url": null, "website_url": "https://duotaggersprivacypolicy.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9715774245218811"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499308305_1349852942765770_5953077826807622015_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ddzRikInCYQ7kNvwHWbmmJ&_nc_oc=AdmxYDqec7vVTZITDsDHVAX--BSWV3_Z1wYTBmrEkBQUDGupc1z90p4fPT
5/499305448_695253276449064_5316910300881667411_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGaSmOxehPAQ7kNvwF2hqYd&_nc_oc=AdqTI1d8FUmJmwvKy-0Mg0Yr9S8_wzZGhC4Miv4DKhtRttQij3x7JTDPB_MMv1297wc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wxadbBiibNrnbUYO5MhuzB6coPqyJxeeML4xXglgRwQ&oe=6A2425F9"}, {"file_name": "cavesss.png", "id": "1229799225457339", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619608_1229799228790672_3030275293143708689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTazKrJfIxUQ7kNvwFvNZ9f&_nc_oc=Adq6EjaX5mOKQRLuqWRgFRToAOPUWTI7QRxGiV7QvcJA4E1vO7HE39lC5bEIjAd7qjs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_II2WAW3vF92zIcnjp9wSe32tWw8kPnDNV7jcn_gqG5w&oe=6A244050"}, {"file_name": "swimmingpoolss.png", "id": "9656705541119167", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824045_9656705551119166_5361459141121333778_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GWMsmWxAFkQ7kNvwGsD3nD&_nc_oc=AdrL6z9wZL5mz3phHSMtXHMN9saIL2KcUff5xCMqoWJ3zHPwdOjz4C6dnbjALXu6yBQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HfasW8CgbXa5VChM9qiRTZMHQ_L19zTty9GGPs6IuoA&oe=6A244A52"}, {"file_name": "monkeystandingss.png", "id": "740919798468254", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307344_740919801801587_7374549863553219978_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DK9GybB440Q7kNvwEqM9tx&_nc_oc=Adrbd93tSdE8Q8T33a2FgAniwHVh5_bTZEj1I4halRzMtk5x-26je7vHAXLl9qz_wS4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BXTaU6me4DHaBlw3RjDJ56WoWvnEzx9oZJQ0cs1FXLg&oe=6A244788"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DuoTaggers", "keywords": [], "long_description": "DuoTaggers is a multiplayer VR game where players use their hands to move, climb, swim, and explore different maps together. Whether you're diving through the calm waters of the Swimming Room, hanging out in the spooky scary Caves while the monster chases you or leaping through the trees in the Forest, DuoTaggers offers a variety of environments to match your mood and play style.\n\nWith realistic hand-based locomotion and built-in voice chat, DuoTaggers lets you freely explore, socialize, or goof off with friends in VR. You could also customize your look with unlockable cosmetics with the in-game currency and enjoy smooth movement.\n\nDesigned for teens and up, DuoTaggers offers a chill yet dynamic social VR experience where creativity and freedom come first.\n\n", "short_description": "DuoTaggers is a fast-paced multiplayer VR game where players run, climb, and explore three unique maps: the Forest, spookyy underground caves, and a relaxing Swimming Room. Use your hands to move around, chat with others using voice, and unlock fun cosmetics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://duotaggersprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Slothy", "support_website_url": null, "website_url": "https://duotaggersprivacypolicy.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9715774245218811"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308305_1349852942765770_5953077826807622015_n.p
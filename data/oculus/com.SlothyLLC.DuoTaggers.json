nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtWlK6oKT0EQ7kNvwGT8P_I&_nc_oc=AdphIxK_85sC0a-l_tlx_hWTWA1wjBGcAhOW681jRTOUdFMHrNDyQNkmJ4ewJ836z_M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3FvIpwsg02IK55m7_ZUkmDd9RBZlwClAwEdDu3cC0n8A&oe=69F1F912"}, {"file_name": "monkeystandingss.png", "id": "740919798468254", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307344_740919801801587_7374549863553219978_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93NiDxsql1kQ7kNvwEvi6Nv&_nc_oc=AdoulNJvdIDxmBYngzjNSJR5y4Bqy2MSkA9__gcvubipk6DHbXkv2cXu5iGX3UzgR1M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15BmHZi3TZDh-X49iH3KP0rFIdpiwh15-eftP9p3KO5Q&oe=69F1F648"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DuoTaggers", "keywords": [], "long_description": "DuoTaggers is a multiplayer VR game where players use their hands to move, climb, swim, and explore different maps together. Whether you're diving through the calm waters of the Swimming Room, hanging out in the spooky scary Caves while the monster chases you or leaping through the trees in the Forest, DuoTaggers offers a variety of environments to match your mood and play style.\n\nWith realistic hand-based locomotion and built-in voice chat, DuoTaggers lets you freely explore, socialize, or goof off with friends in VR. You could also customize your look with unlockable cosmetics with the in-game currency and enjoy smooth movement.\n\nDesigned for teens and up, DuoTaggers offers a chill yet dynamic social VR experience where creativity and freedom come first.\n\n", "short_description": "DuoTaggers is a fast-paced multiplayer VR game where players run, climb, and explore three unique maps: the Forest, spookyy underground caves, and a relaxing Swimming Room. Use your hands to move around, chat with others using voice, and unlock fun cosmetics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://duotaggersprivacypolicy.carrd.co/", "developer_t
5/499305448_695253276449064_5316910300881667411_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFMFvBW_BEQQ7kNvwEujFTv&_nc_oc=Adoxa2r6XjToIUq6F5FCiFkuO-CFT72aaius5lTBobvG3iMO2uKUfnEpRnUftD3XcnY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W8pFXFP9RHuroGnqD_LxU-qVLqnw60Ufu7Z90hfXnjg&oe=6A105F79"}, {"file_name": "cavesss.png", "id": "1229799225457339", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619608_1229799228790672_3030275293143708689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blK_7r3N8DUQ7kNvwFod4OH&_nc_oc=AdpU5N4p6lZP2BCNRp7RpdNIljtAAqVe0pbYaQH8P-w4sPNBwaX4AYoCt5IMW2y-0EM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67j2TQCVYgqE_Y1X0F4C0rQxJKXX2LEo5rhFOfNoXnsQ&oe=6A1079D0"}, {"file_name": "swimmingpoolss.png", "id": "9656705541119167", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491824045_9656705551119166_5361459141121333778_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7vZcFiTtoAQ7kNvwGguczC&_nc_oc=AdppuqKnd9IiFKecCDwHU8M-_bnOOpAt7SXUCh47-ayh5Uu_34bX2phDyLFRWsDO9YE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54wRPVrb1s345TorJkjISAlaxz_Mt1R2rAuwNSTGumjA&oe=6A104B92"}, {"file_name": "monkeystandingss.png", "id": "740919798468254", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499307344_740919801801587_7374549863553219978_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWj1p-vPA8YQ7kNvwGKHqiP&_nc_oc=Adrdo1tM8rpUbySQC10kXz8xhwbY-XzBtLfAfKSKyjfvP0F85NDm8QJTuIwxEt_lyjU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aB0Mhx5BIzPYg4_G4FZDQ39vfySOsPuxVyEHSCnU2Bg&oe=6A108108"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DuoTaggers", "keywords": [], "long_description": "DuoTaggers is a multiplayer VR game where players use their hands to move, climb, swim, and explore different maps together. Whether you're diving through the calm waters of the Swimming Room, hanging out in the spooky scary Caves while the monster chases you or leaping through the trees in the Forest, DuoTaggers offers a variety of environments to match your mood and play style.\n\nWith realistic hand-based locomotion and built-in voice chat, DuoTaggers lets you freely explore, socialize, or goof off with friends in VR. You could also customize your look with unlockable cosmetics with the in-game currency and enjoy smooth movement.\n\nDesigned for teens and up, DuoTaggers offers a chill yet dynamic social VR experience where creativity and freedom come first.\n\n", "short_description": "DuoTaggers is a fast-paced multiplayer VR game where players run, climb, and explore three unique maps: the Forest, spookyy underground caves, and a relaxing Swimming Room. Use your hands to move around, chat with others using voice, and unlock fun cosmetics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://duotaggersprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Slothy", "support_website_url": null, "website_url": "https://duotaggersprivacypolicy.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9715774245218811"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499308305_1349852942765770_5953077826807622015_n.p
5/499305448_695253276449064_5316910300881667411_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgP9ZxukkykQ7kNvwFt9JyI&_nc_oc=AdpD5_N0EVe9zpuvzOPPHwGPHUv0oN1TzD2TeKxU80tdyKWHevxRWwAdUr7rjoOg7lM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af100Bom_NVoefVGpsHkialxd6-YrKcVDvZgQrbCXLd5ug&oe=69F60179"}, {"file_name": "cavesss.png", "id": "1229799225457339", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619608_1229799228790672_3030275293143708689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NH_PELvqjNoQ7kNvwGQ1A3Q&_nc_oc=Adqfbb5WgnxvKB-HjPUCFOywTE8Uri50P4jeuYvRjbNvv2dPX7GObySIQYYPhZEaW2I&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2wRTUx550L8fQ8MCT7R6cJy-FIQ4GwzwwSyeJi7k7zeQ&oe=69F61BD0"}, {"file_name": "swimmingpoolss.png", "id": "9656705541119167", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824045_9656705551119166_5361459141121333778_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpHgY7B6I6sQ7kNvwG0cBFD&_nc_oc=Adp2Ik32sEY9LMkBHENUA8mi4brf6DrKkS3uZCBSYQ8-cdUGQpHxViomcEq7xGnFfwM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12CT-80AuEXmTXdbTVXF4U4mr_zhoL9Qrr2ur7ImmHtQ&oe=69F5ED92"}, {"file_name": "monkeystandingss.png", "id": "740919798468254", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499307344_740919801801587_7374549863553219978_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_M_j6MuEGC0Q7kNvwGPkSfl&_nc_oc=Ado7wg8wAyVo4AhAmNMO_NloWuou5jH7pWCJRPcLhfYCAJY953GDKIBvlrAOuCZS9qU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fgX7vjCwngwnsllV1iIbiplyy1r88R6mdTZxjBQxxSw&oe=69F5EAC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DuoTaggers", "keywords": [], "long_description": "DuoTaggers is a multiplayer VR game where players use their hands to move, climb, swim, and explore different maps together. Whether you're diving through the calm waters of the Swimming Room, hanging out in the spooky scary Caves while the monster chases you or leaping through the trees in the Forest, DuoTaggers offers a variety of environments to match your mood and play style.\n\nWith realistic hand-based locomotion and built-in voice chat, DuoTaggers lets you freely explore, socialize, or goof off with friends in VR. You could also customize your look with unlockable cosmetics with the in-game currency and enjoy smooth movement.\n\nDesigned for teens and up, DuoTaggers offers a chill yet dynamic social VR experience where creativity and freedom come first.\n\n", "short_description": "DuoTaggers is a fast-paced multiplayer VR game where players run, climb, and explore three unique maps: the Forest, spookyy underground caves, and a relaxing Swimming Room. Use your hands to move around, chat with others using voice, and unlock fun cosmetics!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://duotaggersprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Slothy", "support_website_url": null, "website_url": "https://duotaggersprivacypolicy.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9715774245218811"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499308305_1349852942765770_5953077826807622015_n.p
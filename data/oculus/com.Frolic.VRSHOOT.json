h9QQ7kNvwG3IZ_F&_nc_oc=AdqdakyDHR7FF8n3R6-R2mZOisIlsBSOxkq22XCRtCJSOcTzKXTSWSmDo3LjwLa2TTo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8O8QoOy5XHTgrNzYGD4kDE8pRCbcQ57yp3foj1WQdanA&oe=6A22E5DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BANNER_3rd_2560X1440_08B.png", "id": "516307843332143", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974579_516307846665476_4763367049594035223_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Okm00qli54YQ7kNvwHDkQra&_nc_oc=AdrRdOPltomFmH7SX5HhClk_bLXa0qwZIHk971MOLUMkHmhzxZZvbfKM-T4w_F4O_Aw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ONOeK-qMBfmRulcRRfxRtPZFcYehLuN9N9Km8ZJ_IeQ&oe=6A22FB1A"}, "display_name": "FROLIC", "keywords": [], "long_description": "*About the Game *\n\nIf you are bored of monotonous 2D or 3D games, then it is time to move on and hop on the train of VR gaming. At Frolic, we offer the best VR experience with real-time interaction, which allows players to take actions flawlessly. \nFrolic VR features an artistic inclination to help users completely immerse in the game environment. Moreover, users can feel slight variations in the gaming environment like direction, movement, and vibrations making it more engaging and interesting.\n\n*Features*\n\nThe joy of gaming is no longer limited to sitting on the couch with a controller in hand for hours; Frolic VR enables you to be physically active while enjoying your favorite games. You will have to flap your arms and walk around the room in order to complete assigned tasks and objectives, which enhances your gaming experience with Great Controls,  Hypnotic Sound Effects, Bewitching Graphics, Immersive, Highly Interactive.\n\n\n\n", "short_description": "Welcome to Frolic VR, created by Shopsense Retail Technologies Limited to offer a unique gaming experience. Featuring enthralling gaming categories, splendid graphics, and adaptive music, Frolic VR will give you the experience to remember. \n\n\nPlay your favorite games reimagined by the immersive power of VR. Frolic has created a highly accessible as well as a competitive gaming experience with an easy-to-navigate user interface, gratifying gaming experience, and light-hearted gameplay.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.frolic.live/pages/vr-privacy", "developer_terms_of_service_url": "https://www.frolic.live/pages/vr-terms", "publisher_name": "https://www.frolic.live/", "support_website_url": "https://www.frolic.live/help", "website_url": "https://www.frolic.live/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "771939567447963"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6350895764954911", "version": "0.1.11"}, "id": "443270100925022", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5400788853298945", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6350895764954911"}, "release_status": "RELEASED"}, "binary_release_
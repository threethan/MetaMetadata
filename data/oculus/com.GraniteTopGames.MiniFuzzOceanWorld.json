s": ["arcade", "shooter", "underwater", "cozy"], "long_description": "Help King Starf by locating the Starf Kids, and defending the castle from Mini-Subs, loose Sea Horses, and Goldfish! Mini Fuzz: Ocean World is a fast-paced, challenging arcade shooter for all ages.\n\nGumbo the Dumbo Octopus is the only one that can help King Starf. Using the powerful bubble burst, Gumbo will need wits, speed, and accuracy to defend the kingdom and win all 15 King's Medals.\n\nMini Fuzz: Ocean World is a cozy underwater arcade shooter with 15 challenging levels that have Gumbo collecting Starf Kids and bubble blasting Goldfish, Sea Horses, and Mini-Subs. ", "short_description": "Join Gumbo the Dumbo Octopus at the bottom of the ocean and defend the Starf Kingdom in this cozy, fast-paced, underwater arcade shooter! Help King Starf by locating the Starf Kids, and defending the castle from Mini-Subs, loose Sea Horses, and Goldfish! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.granitetopgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Granite Top Games", "support_website_url": null, "website_url": "https://www.granitetopgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36331149146483961"}, "review_messages": []}]}, "cover_square_image": 
7404", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499300897_1482499316790737_2077145415319790689_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUbHIJ2kBZUQ7kNvwFG2zRy&_nc_oc=Adou8e_03GL_-MP5CZQvkdyFvxwXf23QETGB3vOzxuZIUheOe47PjrIuQdxXaL_araw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH45oAvBJMJFyyQulOXMaiCtw64X_IIf1j0FhqkAVoTzA&oe=6A8D8393"}, {"file_name": "com.EvoReality.Dwarca-20260421-132137.png", "id": "847435821721517", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499617762_847435828388183_4342988030207279971_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWd3ocRbeeoQ7kNvwE0LYN4&_nc_oc=AdqCooU60Z28A6YVUR3O_JEKUxAnSSU_q_H5N6D0oOcpsyA-T00s7s4V9YiIeshPDGg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6oj5wUL85aF-uvgbLtUZPXzsRY8CjAn39IjAD5TxsmA&oe=6A8D8087"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Neuro Quest", "keywords": ["Cognitive", "braintraining", "neurovrgame", "adventure", "braingame"], "long_description": "**Neuro Quest** is a unique VR experience that blends engaging gameplay with cognitive performance insights through two exciting games.\n\nIn **Sky Land Quest**, players explore immersive environments by walking and flying, collecting coins, avoiding traps, and discovering hidden treasures. This game evaluates key cognitive abilities such as processing speed, attention & planning, navigation ability, and visuospatial skills.\n\nThe **Hand Eye Coordination** game challenges players with fast-paced interactions where colored cubes approach from different directions. Players must respond quickly by hitting each cube with the correct color hammer and in the correct direction. This game is designed to assess motor ability, attention, and focus.\n\nAt the end of each session, **Neuro Quest** provides detailed cognitive performance insights based on player activity. These results help track progress, identify strengths, and highlight areas for improvement.\n\nWith its combination of immersive gameplay and meaningful feedback, **Neuro Quest** transforms VR into a powerful tool for both entertainment and cognitive understanding.", "short_description": "Neuro Quest is an immersive VR experience combining navigation and hand-eye coordination games to measure and track cognitive skills such as attention, focus, navigation, and motor ability."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neuroquestvr/home", "developer_terms_of_service_url": null, "publisher_name": "EvoReality", "support_website_url": null, "website_url": "https://www.evoreality.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26281458641535149"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619096_1258957189299219_5184426411095710349_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAmbhFlBEkEQ7kNvwEm1qVt&_nc_oc=AdpOV_GQBRm4yaekgxBreis_vly342lnlZlZAQDFV0mk2jsOB4cc_g8iNAF0thn_LIA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhGawYL27anjJ1FpNOQqrvAkAa7PzFjDJz3uelX8aEcg&oe=6A8D6C48"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Neuro Quest", "platform": "ANDROID_6DOF", "context_catego
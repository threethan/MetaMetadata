d.\nFixed a bug where fired weapons weren't properly cleaned-up.", "created_date": 1778525103, "id": "26697958663201924", "version": "1.11", "version_code": 234, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
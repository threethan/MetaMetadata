c_ss=7f20f&oh=00_Af38WrmP58ae56o72tTAXh9Drsd_3nwrzr6k3eIyXz2COQ&oe=69F89F0C"}, {"file_name": "Screenshot MH-6 Fullscale.png", "id": "2756400481383674", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308050_2756400484717007_4759103439054001298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UClqk4QlFwwQ7kNvwGl8USE&_nc_oc=Ado9eFgAfvL2HvQ4NeQHYDU42I65HnAnNjjN_ecezBkUqiLdEX6n2qRM4cD4NzQaa4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mXihY0EDYNBuGhsqSgANNjDCpaeTTGCaWLaluwyURzw&oe=69F8B893"}, {"file_name": "Screenshot Heavy Lift.png", "id": "880908867886522", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831792_880908871219855_797686137531278475_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvRhnTgRPc4Q7kNvwFM961A&_nc_oc=AdoKhUqsyK60GnTIwzaJ8X22R1iJO7rCWWMd9ZWkeUpvXuUu-tsKH5eaqWCSzONfXko&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ov5XqTIe-QCd-oWGB3dtHc5GeAhf1fHIECtVaC69ROQ&oe=69F8A931"}, {"file_name": "Screenshot Bell 47.png", "id": "1969748576938511", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300738_1969748580271844_2180563465844473290_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLkBd4aRLMQQ7kNvwHAksEz&_nc_oc=Ado0fBPHOejVZfgtDGnRYrqBqDpBDd0wJSXDQFNuRYqpto-g3BzUVpYUOJZQq40JN4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3R1cKlIfiv96edsGLSDu-p_EFf3wjhfksavj1xlMu-JQ&oe=69F8A608"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot AH-1 Fullscale.png", "id": "859216517108808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307444_859216520442141_2291269221385765317_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0fBaE4v0wcQ7kNvwHC6-l3&_nc_oc=Adqyk_H3Lcw5IjNaFVBB05IXabml3dSgLUCAJdxq6MrC6UGq5jWLuflw1x6l5Ba4-MQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0nSnKBr08ELXUG4G76VZBFWRAEnhIwytLIKR0DrMJOug&oe=69F88CE3"}, "display_name": "AR Choppers", "keywords": ["helicopter", "chopper", "heli", "flying", "flightsim"], "long_description": "Fly 16 amazing helicopters around your room in mixed-reality or experience them at actual size!  \n\nAll models are finely detailed and scaled to 1/32.  Enjoy realistic flight physics tuned meticulously for mixed-reality play.\n\nChoppers included:\n\u2022 Bell 47\n\u2022 Robinson R44\n\u2022 Bell 206 JetRanger\n\u2022 Airbus AS350\n\u2022 UH-1 \"Huey\" Iroquois\n\u2022 UH-60 Black Hawk\n\u2022 SB-1 Defiant\n\u2022 CH-53 Sea Stallion\n\u2022 CH-47 Chinook\n\u2022 Mi-26 Halo\n\u2022 AH-1 Cobra\n\u2022 Mi-8 Hip\n\u2022 MH-6 Little Bird\n\u2022 Mi-24 Hind\n\u2022 Ka-52 Alligator\n\u2022 AH-64 Apache\n\nEach chopper type has a timed \"mission\" activity:\n\u2022 Crop spray: fly over crops to fertilize them!\n\u2022 Firefight: fill your bucket and douse wildfire!\n\u2022 Transport: deliver troops to the frontline!\n\u2022 Heavy lift: hook up a heavy load and drop it at its destination!\n\u2022 Attack: laser-designate targets to destroy them with guns and missiles!\n\nScan your room in Quest Environment setup and mission objects will be contained within it, otherwise a generic space is used.  Toggle wall-collisions via radial menu (off by default).\n\nDesigned for a single controller:\n\u2022 Thumbstick: (model-scale) cyclic pitch/roll, (full-scale) move player & snap-turn\n\u2022 (Optional) secondary thumbstick: yaw\n\u2022 Button A/X: next chopper (long-press for menu)\n\u2022 Button B/Y: toggle mission-activity (long-press to toggle scale)\n\u2022 Trigger: (model-scale) positive collective, (full-scale) move player\n\u2022 Thumbstick button: negative collective (descend)\n\u2022 Grip: grab/throw chopper\n\nCheck out \"AR Planes\" for more indoor flight!", "short_description": "Fly 16 amazing helicopters around your room in mixed-reality or experience them at actual size!  Fire guns and missiles to destroy targets!  Spray crops!  Fight fires!  Transport troops!  Heavy lift!\n\nCheck out \"AR Planes\" for more indoor flight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/archoppers/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25445273798470423"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1510915217232478"}, {"status": "PUBLISHED", "id": "1213084657291172"}, {"status": "PUBLISHED", "id": "1989898768260751"}, {"status": "PUBLISHED", "id": "1445034877327245"}, {"status": "PUBLISHED", "id": "2358940071236685"}]}, "baseline_offer": {"id": "2358940071236685"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1510915217232478"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26549243321406793", "version": "1.10"}, "id": "1404570234787007", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26549243321406793"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "Added an options-menu on the left controller's \"start\" button.\nMoved radial-menu options to the options-menu.\nAdded a control map diagram on the options-menu.\nAdded an option to swap controllers for \"lefties\".\nFixed Ka-52's missing gun-sound.", "created_date": 1777402805, "id": "26549243321406793", "version": "1.10", "version_code": 215, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26549243321406793"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "Reverted texture aniso levels that were reduced in last update.\nIncreased dynamic resolution in full-scale view.\nFixed a mesh problem in AH-1's rotor blades.\nFixed shadow flickering at certain distances.\nFull-scale planes now always default to ground-level when switched/selected.\nFull-scale view thumbstick now rotates/moves the chopper as if it were driving.\nFixed controllers becoming visible due to fast startup.", "created_date": 1777242611, "id": "26526853186979140", "version": "1.09", "version_code": 209, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26549243321406793"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "Ka-52's landing-gear now deploy/stow.\nKa-52's gun now rotates to shoot targets.\nAdjusted Ka-52's normal map.\nFixed bug introduced last update where landing-gear didn't stow after returning to model-scale.\nCorrected a small auto-leveling force still being applied when auto-level was disabled.\nRemoved a small upward-pitch force being applied incorrectly with speed.\nReduced wind-buffeting during hover by 25%.\nReduced glass reflectivity.\nLeft trigger now controls SB-1 pusher-fan throttle, without having to hold thumbstick button.", "created_date": 1776633970, "id": "26445323761798750", "version": "1.08", "version_code": 201, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26549243321406793"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": null, "created_date": 1776632983, "id": "26445225621808564", "version": "1.07", "version_code": 200, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26549243321406793"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "Made flight-physics buttery-smooth!\nImproved full-scale mode rendering performance.\nButtons X/Y now release water during FireFight and FieldSpray missions.\nFixed landing detection for choppers without wheels.\nTweaked CH-47 material and sound a little.", "created_date": 1776547952, "id": "26436096779388115", "version": "1.07", "version_code": 191, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
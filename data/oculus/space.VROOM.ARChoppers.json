wUourtjjzpCYdOrdXOr2Hw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7ot7RYppd_oTAwAhW9hFH3G7mMCuCq0GN2wgb-FXlwQ&oe=6AE60693"}, {"file_name": "Screenshot Heavy Lift.png", "id": "880908867886522", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831792_880908871219855_797686137531278475_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdEJDNjb6TEQ7kNvwHCnl28&_nc_oc=AdrH3-sfqEEsDcEpBzge4Ukt6ycQOxJOlmOt4AAzdQUT5por-LdsDa-_xe60yZV01Zc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW-y3Ajmuq2PNLf3l291qMq1hiHAe8jjxA1xE0ns37Bg&oe=6AE5F731"}, {"file_name": "Screenshot Bell 47.png", "id": "1969748576938511", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300738_1969748580271844_2180563465844473290_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gYn2sUnwEwQ7kNvwEqneyz&_nc_oc=AdqM520cdCArCORiZO38NHKpCFclNBEf1vtI9E9wN1R_BtuyW3wKXQE5tccw6eUcdJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLZp5GDlKxcMZGnCggXACvfSigVXBJcU56zF7GOzPrJQ&oe=6AE5F408"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot AH-1 Fullscale.png", "id": "859216517108808", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307444_859216520442141_2291269221385765317_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV0VdT97QuEQ7kNvwGyQ8Ad&_nc_oc=AdraeOn_KstmmizuFkB1eD39Z83XYJR-B6LdtYwzcA3umDrJScg5RF0Sw6zawSwMpPw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnGwco9JOkX_E7dN5DDrDUw6gTQl-QMsOKgOh1Z2PXsw&oe=6AE61323"}, "display_name": "AR Choppers", "keywords": ["helicopter", "chopper", "heli", "flying", "flightsim"], "long_description": "Fly 16 amazing helicopters around your room in mixed-reality or experience them at actual size!  \n\nAll models are finely detailed and scaled to 1/32.  Enjoy realistic flight physics tuned meticulously for mixed-reality play.\n\nChoppers included:\n\u2022 Bell 47\n\u2022 Robinson R44\n\u2022 Bell 206 JetRanger\n\u2022 Airbus AS350\n\u2022 UH-1 \"Huey\" Iroquois\n\u2022 UH-60 Black Hawk\n\u2022 SB-1 Defiant\n\u2022 CH-53 Sea Stallion\n\u2022 CH-47 Chinook\n\u2022 Mi-26 Halo\n\u2022 AH-1 Cobra\n\u2022 Mi-8 Hip\n\u2022 MH-6 Little Bird\n\u2022 Mi-24 Hind\n\u2022 Ka-52 Alligator\n\u2022 AH-64 Apache\n\nEach chopper type has a timed \"mission\" activity:\n\u2022 Crop spray: fly over crops to fertilize them!\n\u2022 Firefight: fill your bucket and douse wildfire!\n\u2022 Transport: deliver troops to the frontline!\n\u2022 Heavy lift: hook up a heavy load and drop it at its destination!\n\u2022 Attack: laser-designate targets to destroy them with guns and missiles!\n\nScan your room in Quest Environment setup and mission objects will be contained within it, otherwise a generic space is used.  Toggle wall-collisions via radial menu (off by default).\n\nDesigned for a single controller:\n\u2022 Thumbstick: (model-scale) cyclic pitch/roll, (full-scale) move player & snap-turn\n\u2022 (Optional) secondary thumbstick: yaw\n\u2022 Button A/X: next chopper (long-press for menu)\n\u2022 Button B/Y: toggle mission-activity (long-press to toggle scale)\n\u2022 Trigger: (model-scale) positive collective, (full-scale) move player\n\u2022 Thumbstick button: negative collective (descend)\n\u2022 Grip: grab/throw chopper\n\nCheck out \"AR Planes\" for more indoor flight!", "short_description": "Fly 16 amazing helicopters around your room in mixed-reality or experience them at actual size!  Fire guns and missiles to destroy targets!  Spray crops!  Fight fires!  Transport troops!  Heavy lift!\n\nCheck out \"AR Planes\" for more indoor flight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/archoppers/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25445273798470423"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1089916790259226"}, {"status": "PUBLISHED", "id": "2245422592925497"}, {"status": "PUBLISHED", "id": "1544397446760942"}, {"status": "PUBLISHED", "id": "2148775542632433"}, {"status": "PUBLISHED", "id": "1510915217232478"}, {"status": "PUBLISHED", "id": "1213084657291172"}, {"status": "PUBLISHED", "id": "1989898768260751"}, {"status": "PUBLISHED", "id": "1445034877327245"}, {"status": "PUBLISHED", "id": "2358940071236685"}]}, "baseline_offer": {"id": "1089916790259226"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789493700, "status": "PUBLISHED", "id": "1089916790259226"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28779613285036441", "version": "1.22"}, "id": "1404570234787007", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28779613285036441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "\u2022 Added realtime room-scanning for collisions, with whole-house support! Walls and furniture are added automatically as you look at them.\n\u2022 Made several peformance enhancements to offset realtime scanning's additional costs.\n\u2022 Operations now use your scanned space: landing pads, crates, and targets are placed within the room you're standing in.\n\u2022 Guns now fire at their real-world rates of fire and muzzle velocities.\n\u2022 Each chopper\u2019s guns have correct tracer colors.\n\u2022 Improved performance with high-rate guns like the Mi-8 with ~113 rounds per second!\n\u2022 Heavy Lift cables are more stable and recover if they get tangled.\n\u2022 Main rotors on the UH-60 and MH-6 now spin the correct way, and tail rotor sounds follow the pedal that fights torque.\n\u2022 Anti-collision strobes now blink like the real thing, and tail lights stay steady where they should.\n\u2022 Scales 1:64 and 1:128 are now 1:72 and 1:144, to match plastic model kit scales.\n\u2022 The chopper now starts at a comfortable distance in front of you at every scale.\n\u2022 The \"Space Setup\" button is now \"Clear\"; it deletes your saved room scans so you can start fresh.\n\u2022 Troop Transport landing pads now require you to be landed and won't load/unload if you're holding the chopper.\n\u2022 When room collision is enabled, changing chopper scale will preserve the chopper's position relative to the room.", "created_date": 1792964220, "id": "28779613285036441", "version": "1.22", "version_code": 290, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28779613285036441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "v1.21:\n\u2022 Set a 10m maximum for occlusion, so anything beyond that is not occluded.  (Quest3's sensor is unreliable at larger distances.)\n\u2022 Fixed an issue that caused detailed room scans to have missing collision data.\n\u2022 Added extra inertia to large-scale flight in outdoor spaces.", "created_date": 1792426534, "id": "28693970283600742", "version": "1.21", "version_code": 280, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28779613285036441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "\u2022 Choppers are now scalable from 1:1 to 1:128 in free-flight mode via the Options menu!\n\u2022 Increased chopper inertia, to slow flight inputs a little and make larger scale flight more realistic.  (It's still pretty low, so flight is more fun but less realistic.)\n\u2022 Added \"Flight Space\" to the Options menu, which sets air density, enabling choppers to fly faster/slower depending on play-area size.\n\u2022 Added a held clipboard with chopper specifications in full-scale mode.\n\u2022 Replaced \"Toggle Scale\" at the top of the menu with \"Ops\", with submenu: \"flight operation\", Options, and Inspect.\n\u2022 Chopper wheels now steer and rotate on the ground.\n\u2022 Wheeled choppers can now taxi around using the collective.\n\u2022 Improved radial menu.\n\u2022 Grabbed choppers jitter less.\n\u2022 Improved spatial audio.\n\u2022 Grabbing a chopper in inspection mode now moves it and/or rotates its vertical axis around the controller.\n\u2022 Troop Transport operations now place bases further apart.  Friendly attrition rate reduced by 20% to compensate.\n\u2022 Crates in Heavy Lift operations won't appear under furniture now.\n\u2022 Added a \"Space Setup\" button in the Options menu to make it easier to setup your Quest environment.\n\u2022 Tweaked Mi-8 materials.\n\u2022 Fixed some shader smoothness issues.\n\u2022 Fixed chopper positioning at start-up to be more reliable.\n\u2022 Fixed an issue with missile proximity fuses.", "created_date": 1791742936, "id": "28582409874756784", "version": "1.20", "version_code": 277, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28779613285036441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "\u2022 Created an input category for SB-1's \"Pusher Fan\" and set it to the left Grab button by default.\n\u2022 Fixed issue where control-remapping caused chopper in full-scale to yaw left/right with triggers rather than \"fly\" the player in the direction their controller is pointed.\n\u2022 Fixed double-shadow on ground in fullscale view.\n\u2022 Fixed a long pause when exiting fullscale view.", "created_date": 1788833212, "id": "28134326172898492", "version": "1.15", "version_code": 250, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28779613285036441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "Added passthrough reflection and lighting support!", "created_date": 1788763730, "id": "28123970013934108", "version": "1.14", "version_code": 244, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
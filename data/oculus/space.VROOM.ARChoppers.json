test_released_binary": {"__typename": "AndroidBinary", "id": "26549243321406793"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "Made flight-physics buttery-smooth!\nImproved full-scale mode rendering performance.\nButtons X/Y now release water during FireFight and FieldSpray missions.\nFixed landing detection for choppers without wheels.\nTweaked CH-47 material and sound a little.", "created_date": 1776547952, "id": "26436096779388115", "version": "1.07", "version_code": 191, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
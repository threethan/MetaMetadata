&_nc_ss=7a30f&oh=00_Afwh0jYXVWf12dIEIEDSj0HQKKSpuE2sR_4d4B3YXKPxaA&oe=69CA6C72"}, {"file_name": "Screenshot UH-60 Fullscsale.png", "id": "924435196819614", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618472_924435203486280_1009706824676138168_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzfu7YmlqM4Q7kNvwFcTgeT&_nc_oc=Adq3lzcQWxs7ez--k72r_-EpvVqh2K8nz4VeM3vqa4MVXjbZ50MgDVqGz4Mst8_rb3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxitDru6zlwjDOOsZ7ecGJMFG02TaR-Pl9L0rdmn54sUg&oe=69CA7A8C"}, {"file_name": "Screenshot MH-6 Fullscale.png", "id": "2756400481383674", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308050_2756400484717007_4759103439054001298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f631iG1GhZ8Q7kNvwHezqem&_nc_oc=AdrvGVYXn6CmR5RhUrT8DcReZhnWjFgr44vxvYX6bD99tkWuCkWJxRyhqQxZ0ZRHAhs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzc3OdwCyoqq14rV0VBmPlD2FWVV_BjrKh7EwTLQJa4OQ&oe=69CA5BD3"}, {"file_name": "Screenshot Heavy Lift.png", "id": "880908867886522", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831792_880908871219855_797686137531278475_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AZP0-oSR6IQ7kNvwHLWMRv&_nc_oc=AdqPEfRCv82NdaFeDOSo_yNs02k8P3JA8zzJU8nrJ-m_DlDu8f8Dp78eJCrYdqF9kgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwY0i8gsNvY_RbEAYklvsEWGTSuPeUMQwo6RfLt_KQyTA&oe=69CA84B1"}, {"file_name": "Screenshot Bell 47.png", "id": "1969748576938511", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300738_1969748580271844_2180563465844473290_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdM_EK-ZD_kQ7kNvwHXEj1C&_nc_oc=Adqd8-BtNSA12xs_aSHGdoERDe6C7etLdNfaRa6lhFCcc2l53DRcIffv651Slm3tUek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAQcvAqwEXfXMZenpoFB1_4N6iHB1VEd4VviFOH2RBgg&oe=69CA8188"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot AH-1 Fullscale.png", "id": "859216517108808", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307444_859216520442141_2291269221385765317_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6Q_JY0RUIcQ7kNvwFsWntU&_nc_oc=Ados4BwscJMkx8fSnto8FODPlYnsJIzwlQJqmO799C0Po4oePq-RmB74zqh5i5RAE2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypBGDoSjN6eN8cnAuUiX0KD3LinKmiUsknbkVxVYEZFg&oe=69CA6863"}, "display_name": "AR Choppers", "keywords": ["helicopter", "chopper", "heli", "flying", "flightsim"], "long_description": "Fly 16 amazing helicopters around your room in mixed-reality or experience them at actual size!  \n\nAll models are finely detailed and scaled to 1/32.  Enjoy realistic flight physics tuned meticulously for mixed-reality play.\n\nChoppers included:\n\u2022 Bell 47\n\u2022 Robinson R44\n\u2022 Bell 206 JetRanger\n\u2022 Airbus AS350\n\u2022 UH-1 \"Huey\" Iroquois\n\u2022 UH-60 Black Hawk\n\u2022 SB-1 Defiant\n\u2022 CH-53 Sea Stallion\n\u2022 CH-47 Chinook\n\u2022 Mi-26 Halo\n\u2022 AH-1 Cobra\n\u2022 Mi-8 Hip\n\u2022 MH-6 Little Bird\n\u2022 Mi-24 Hind\n\u2022 Ka-52 Alligator\n\u2022 AH-64 Apache\n\nEach chopper type has a timed \"mission\" activity:\n\u2022 Crop spray: fly over crops to fertilize them!\n\u2022 Firefight: fill your bucket and douse wildfire!\n\u2022 Transport: deliver troops to the frontline!\n\u2022 Heavy lift: hook up a heavy load and drop it at its destination!\n\u2022 Attack: laser-designate targets to destroy them with guns and missiles!\n\nScan your room in Quest Environment setup and mission objects will be contained within it, otherwise a generic space is used.  Toggle wall-collisions via radial menu (off by default).\n\nDesigned for a single controller:\n\u2022 Thumbstick: (model-scale) cyclic pitch/roll, (full-scale) move player & snap-turn\n\u2022 (Optional) secondary thumbstick: yaw\n\u2022 Button A/X: next chopper (long-press for menu)\n\u2022 Button B/Y: toggle mission-activity (long-press to toggle scale)\n\u2022 Trigger: (model-scale) positive collective, (full-scale) move player\n\u2022 Thumbstick button: negative collective (descend)\n\u2022 Grip: grab/throw chopper\n\nCheck out \"AR Planes\" for more indoor flight!", "short_description": "Fly 16 amazing helicopters around your room in mixed-reality or experience them at actual size!  Fire guns and missiles to destroy targets!  Spray crops!  Fight fires!  Transport troops!  Heavy lift!\n\nCheck out \"AR Planes\" for more indoor flight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/archoppers/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25445273798470423"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1989898768260751"}, {"status": "PUBLISHED", "id": "1445034877327245"}, {"status": "PUBLISHED", "id": "2358940071236685"}]}, "baseline_offer": {"id": "2358940071236685"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1989898768260751"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26151301061201023", "version": "1.05"}, "id": "1404570234787007", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26151301061201023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": null, "created_date": 1774225190, "id": "26151301061201023", "version": "1.05", "version_code": 162, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26151301061201023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "Another small update to improve flight-physics:\nIncreased cyclic authority while carrying heavy objects.\nReduced auto-collective climbLift, increased manual climbLift.\nFixed an issue where ETL was supplying too much lift when auto-collective was disabled as a result of reduced drag.\nTweaked vertical drag.", "created_date": 1772750524, "id": "25986849274312870", "version": "1.04", "version_code": 150, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26151301061201023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "- Reduced base drag a little more for all choppers.\n- Improved glass shading.\n- Grabbed chopper rotors now continue to spin.\n- Fixed issue where grabbing wasn't \"stopping\" near the chopper's edge.\n- Increased negative collective applied to landed choppers.\n- Reduced SB-1 engine sound.", "created_date": 1772667892, "id": "25978122941852170", "version": "1.03", "version_code": 139, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26151301061201023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "Fixed bambi-bucket mass and some spray logic.", "created_date": 1772394691, "id": "25948801371450994", "version": "1.02", "version_code": 131, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26151301061201023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "Added \"Auto Collective\" menu toggle, which helps maintain altitude during maneuvers when enabled.\n\tAdded \"Auto Tail Rotor\" menu toggle, which helps keep the nose pointed in the direction of travel.\n\tMade the \"Room Collision\" button a toggle and renamed it \"Wall Collision\".\n\tSignificantly reduced airframe drag, making for faster flight, courtesy of auto-collective's assistance with flying.\n\tTweaked mass, drag, and climb lift values for each helicopter.\n\tAdjusted laser-designated chopper-control for faster flight dynamics.\n\tRockets should be a little more accurate.  (Though still intentionally imperfect.)\n\tFixed bug where SB-1 would pitch down during \"pusher fan\" flight.\n\tSlightly increased heavy lift mission's hook-up range, and changed cargo and helicopter masses.\n\tImproved landing physics.\n\tChoppers with wheels can now \"taxi\" while landed.\n\tFixed fire occasionally reigniting at the edge of wet fields.\n\tImproved water-dump \"accuracy\" when firefighting.\n\tReduced start-up time by ~1 second.\n\tFixed occasional start-up crash due to transparent shaders; this involved changing all glass shaders.\n\tTweaked blurred rotors a little.\n\tFixed a bug where laser designator was disabled after hiding menu.\n\tFixed a notification typo.", "created_date": 1772237085, "id": "25932154049782393", "version": "1.01", "version_code": 130, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
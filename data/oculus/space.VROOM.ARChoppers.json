c_ss=7f20f&oh=00_Af7OEuQANYakP4lZuKPdMkeY0kBMWWgNRRQRp-pODd8Iuw&oe=6A18430C"}, {"file_name": "Screenshot MH-6 Fullscale.png", "id": "2756400481383674", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308050_2756400484717007_4759103439054001298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaCUFxqp2tkQ7kNvwG9IU4s&_nc_oc=AdpGT2xhxjuD_NE84UBtTcYSFoX5xM3yVbVB3Cbn6v_Rv6NGoCHvHIUcPN7x9Ot0TCg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OsxP3ohKL3z5eUa_fMEOD6vQktjLQHEJWlJOELNj30Q&oe=6A185C93"}, {"file_name": "Screenshot Heavy Lift.png", "id": "880908867886522", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831792_880908871219855_797686137531278475_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuZ4_-GCPm4Q7kNvwE0qgY8&_nc_oc=AdrNrKyj-05dBQ3_WxKP1A5nM3-L5ziF0wEp-3hcuM3dMUfPudNWEgWwr6arc840hrg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zx-9oeoGlEufAfbWTXZ7acABfQmwEOn3pdxRhCPZfow&oe=6A184D31"}, {"file_name": "Screenshot Bell 47.png", "id": "1969748576938511", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300738_1969748580271844_2180563465844473290_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfzS6D0SOEsQ7kNvwHooYpi&_nc_oc=AdrQBJBdHsK8lf6EP6KES-U-v4xTtT9th-wy1xx_ZwFtQOYt7J7TL5_LcwshZe9YAJc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59Gu6a3-Ngy8kH6IRfgXhJAqdhNd61Ql8SYZp2eVJGOA&oe=6A184A08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot AH-1 Fullscale.png", "id": "859216517108808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307444_859216520442141_2291269221385765317_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6q_-TJ1DIMQ7kNvwE8JtwQ&_nc_oc=Adq7-dqhy2YY4PWYY4KL2qQ8lR9stQChL7lVK0UkfnHuWPEi_2c9UsU7y7uQDPODaMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af462GZ5SaJJ23dxewo4tW5N-14WmTlE80t54TGE0KVBMA&oe=6A186923"}, "display_name": "AR Choppers", "keywords": ["helicopter", "chopper", "heli", "flying", "flightsim"], "long_description": "Fly 16 amazing helicopters around your room in mixed-reality or experience them at actual size!  \n\nAll models are finely detailed and scaled to 1/32.  Enjoy realistic flight physics tuned meticulously for mixed-reality play.\n\nChoppers included:\n\u2022 Bell 47\n\u2022 Robinson R44\n\u2022 Bell 206 JetRanger\n\u2022 Airbus AS350\n\u2022 UH-1 \"Huey\" Iroquois\n\u2022 UH-60 Black Hawk\n\u2022 SB-1 Defiant\n\u2022 CH-53 Sea Stallion\n\u2022 CH-47 Chinook\n\u2022 Mi-26 Halo\n\u2022 AH-1 Cobra\n\u2022 Mi-8 Hip\n\u2022 MH-6 Little Bird\n\u2022 Mi-24 Hind\n\u2022 Ka-52 Alligator\n\u2022 AH-64 Apache\n\nEach chopper type has a timed \"mission\" activity:\n\u2022 Crop spray: fly over crops to fertilize them!\n\u2022 Firefight: fill your bucket and douse wildfire!\n\u2022 Transport: deliver troops to the frontline!\n\u2022 Heavy lift: hook up a heavy load and drop it at its destination!\n\u2022 Attack: laser-designate targets to destroy them with guns and missiles!\n\nScan your room in Quest Environment setup and mission objects will be contained within it, otherwise a generic space is used.  Toggle wall-collisions via radial menu (off by default).\n\nDesigned for a single controller:\n\u2022 Thumbstick: (model-scale) cyclic pitch/roll, (full-scale) move player & snap-turn\n\u2022 (Optional) secondary thumbstick: yaw\n\u2022 Button A/X: next chopper (long-press for menu)\n\u2022 Button B/Y: toggle mission-activity (long-press to toggle scale)\n\u2022 Trigger: (model-scale) positive collective, (full-scale) move player\n\u2022 Thumbstick button: negative collective (descend)\n\u2022 Grip: grab/throw chopper\n\nCheck out \"AR Planes\" for more indoor flight!", "short_description": "Fly 16 amazing helicopters around your room in mixed-reality or experience them at actual size!  Fire guns and missiles to destroy targets!  Spray crops!  Fight fires!  Transport troops!  Heavy lift!\n\nCheck out \"AR Planes\" for more indoor flight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/archoppers/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25445273798470423"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1510915217232478"}, {"status": "PUBLISHED", "id": "1213084657291172"}, {"status": "PUBLISHED", "id": "1989898768260751"}, {"status": "PUBLISHED", "id": "1445034877327245"}, {"status": "PUBLISHED", "id": "2358940071236685"}]}, "baseline_offer": {"id": "2358940071236685"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1510915217232478"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26766682476329542", "version": "1.12b"}, "id": "1404570234787007", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename"
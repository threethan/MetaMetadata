release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26766682476329542"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "Added dynamic occlusion. (Enable in menu; off by default.)\nSwitched to Vulkan graphics API.\nSwitched to dynamic shadows in full-scale view.\nRotor blades now move in full-scale view.\nAdded turbine sounds to relevant choppers.\nRockets/missiles now fire continuosly when button Y is held.\nAir-to-air missiles now fire if no forward gun is present (MH-6) when button Y is pressed.\nFixed a bug where fired weapons weren't properly cleaned-up.", "created_date": 1778525103, "id": "26697958663201924", "version": "1.11", "version_code": 234, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26766682476329542"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "Added an options-menu on the left controller's \"start\" button.\nMoved radial-menu options to the options-menu.\nAdded a control map diagram on the options-menu.\nAdded an option to swap controllers for \"lefties\".\nFixed Ka-52's missing gun-sound.", "created_date": 1777402805, "id": "26549243321406793", "version": "1.10", "version_code": 215, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
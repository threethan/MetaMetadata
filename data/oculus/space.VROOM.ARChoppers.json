c_ss=7f20f&oh=00_Af2hG4ML2R-LaQxjQkIaOdRsZthaXPQWFcZOUgTqAVqYvA&oe=69F4AA8C"}, {"file_name": "Screenshot MH-6 Fullscale.png", "id": "2756400481383674", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308050_2756400484717007_4759103439054001298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6o8uIEqXCMQ7kNvwEab3RC&_nc_oc=AdqWmqGan1DJEcmhhG_ivWSvPSGnelkMwVusFN5rl9HHfsAnOiyPnrLiQ5XT6RQerxU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_fFQsj7ECSTTu5NQsN7DE9Nsu3_QCt2MWBwiOY2K2sw&oe=69F4C413"}, {"file_name": "Screenshot Heavy Lift.png", "id": "880908867886522", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831792_880908871219855_797686137531278475_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV6NtZtQ9RoQ7kNvwFDa0v_&_nc_oc=Adpg0vPbR6bY1aH92xEd5KLtG_xIvAG3s5odt--w2RWR_P0T9WEuajPq2e975ByUWpE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GI_M15CFauIvgdOX6D3zRIYffGV3k7Ee0DqiCW9berQ&oe=69F4B4B1"}, {"file_name": "Screenshot Bell 47.png", "id": "1969748576938511", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300738_1969748580271844_2180563465844473290_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzQw1kXKAy8Q7kNvwGohF6d&_nc_oc=Adr5kUyVUE-CmPUPOeb_f9cfUC6_SKTDBPXhVcg0Pm83LazNZZvwIvKFSv3TrFOsYG8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1DYIOCQM1KIjlcojnZ2421praZQCENoRcBUMDpJJhRYw&oe=69F4B188"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot AH-1 Fullscale.png", "id": "859216517108808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307444_859216520442141_2291269221385765317_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ml97PDLmRj8Q7kNvwEx5-4t&_nc_oc=Adr2vcw9Tq0umjNVTZTFthDZFUI7uDa4Ny0-Sl30z9Nae_PGEw34AKaI2IZGK7vfbNI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eFPRzD_5C3xdC6nsrEyJpy9DsvtdU1XOB-_qk0Kyleg&oe=69F49863"}, "display_name": "AR Choppers", "keywords": ["helicopter", "chopper", "heli", "flying", "flightsim"], "long_description": "Fly 16 amazing helicopters around your room in mixed-reality or experience them at actual size!  \n\nAll models are finely detailed and scaled to 1/32.  Enjoy realistic flight physics tuned meticulously for mixed-reality play.\n\nChoppers included:\n\u2022 Bell 47\n\u2022 Robinson R44\n\u2022 Bell 206 JetRanger\n\u2022 Airbus AS350\n\u2022 UH-1 \"Huey\" Iroquois\n\u2022 UH-60 Black Hawk\n\u2022 SB-1 Defiant\n\u2022 CH-53 Sea Stallion\n\u2022 CH-47 Chinook\n\u2022 Mi-26 Halo\n\u2022 AH-1 Cobra\n\u2022 Mi-8 Hip\n\u2022 MH-6 Little Bird\n\u2022 Mi-24 Hind\n\u2022 Ka-52 Alligator\n\u2022 AH-64 Apache\n\nEach chopper type has a timed \"mission\" activity:\n\u2022 Crop spray: fly over crops to fertilize them!\n\u2022 Firefight: fill your bucket and douse wildfire!\n\u2022 Transport: deliver troops to the frontline!\n\u2022 Heavy lift: hook up a heavy load and drop it at its destination!\n\u2022 Attack: laser-designate targets to destroy them with guns and missiles!\n\nScan your room in Quest Environment setup and mission objects will be contained within it, otherwise a generic space is used.  Toggle wall-collisions via radial menu (off by default).\n\nDesigned for a single controller:\n\u2022 Thumbstick: (model-scale) cyclic pitch/roll, (full-scale) move player & snap-turn\n\u2022 (Optional) secondary thumbstick: yaw\n\u2022 Button A/X: next chopper (long-press for menu)\n\u2022 Button B/Y: toggle mission-activity (long-press to toggle scale)\n\u2022 Trigger: (model-scale) positive collective, (full-scale) move player\n\u2022 Thumbstick button: negative collective (descend)\n\u2022 Grip: grab/throw chopper\n\nCheck out \"AR Planes\" for more indoor flight!", "short_description": "Fly 16 amazing helicopters around your room in mixed-reality or experience them at actual size!  Fire guns and missiles to destroy targets!  Spray crops!  Fight fires!  Transport troops!  Heavy lift!\n\nCheck out \"AR Planes\" for more indoor flight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/archoppers/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25445273798470423"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1213084657291172"}, {"status": "PUBLISHED", "id": "1989898768260751"}, {"status": "PUBLISHED", "id": "1445034877327245"}, {"status": "PUBLISHED", "id": "2358940071236685"}]}, "baseline_offer": {"id": "2358940071236685"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1213084657291172"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26526853186979140", "version": "1.09"}, "id": "1404570234787007", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26526853186979140"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "Reverted texture aniso levels that were reduced in last update.\nIncreased dynamic resolution in full-scale view.\nFixed a mesh problem in AH-1's rotor blades.\nFixed shadow flickering at certain distances.\nFull-scale planes now always default to ground-level when switched/selected.\nFull-scale view thumbstick now rotates/moves the chopper as if it were driving.\nFixed controllers becoming visible due to fast startup.", "created_date": 1777242611, "id": "26526853186979140", "version": "1.09", "version_code": 209, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25445273755137094", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26526853186979140"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1404570234787007"}]}, "change_log": "Ka-52's landing-gear now deploy/stow.\nKa-52's gun now rotates to shoot targets.\nAdjusted Ka-52's normal map.\nFixed bug introduced last update where landing-gear didn't stow after returning to model-scale.\nCorrected a small auto-leveling force still being applied when auto-level was disabled.\nRemoved a small upward-pitch force being applied incorrectly with speed.\nReduced wind-buffeting during hover by 25%.\nReduced glass reflectivity.\nLeft trigger now controls SB-1 pusher-fan throttle, without having to hold thumbstick button.", "created_date": 1776633970, "id": "26445323761798750", "version": "1.08", "version_code": 201, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary"
Zg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvFIzt7a5Ek0IBV5CIVG277CXLgMT0Xq8R5J5tMsJV6w&oe=6A845E0C"}, {"file_name": "Screenshot MH-6 Fullscale.png", "id": "2756400481383674", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308050_2756400484717007_4759103439054001298_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95cFiWwfcvsQ7kNvwGE7392&_nc_oc=AdpsdpCGsnt1XQJsPIueA9o34_GDagorN04RziaOp9ZFK89Hzv0k0tuRiVJUieR_E5M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5kwx5zs8LKUQZSQEk39GT05NG7NxyUeCpDPO_knmdqA&oe=6A843F53"}, {"file_name": "Screenshot Heavy Lift.png", "id": "880908867886522", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831792_880908871219855_797686137531278475_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pzud8leldnMQ7kNvwHUdKGY&_nc_oc=AdqAJMAS9AkFXM8R09tUQcCQHBnp5aELAKGpkaLiZkP5tpSUFITJ6aUCOkbNIUNqFdU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjQAnsqhJmT2c1jhmFGiCdhldZ2U0XXTqd56cR1yZUyg&oe=6A846831"}, {"file_name": "Screenshot Bell 47.png", "id": "1969748576938511", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300738_1969748580271844_2180563465844473290_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lqKKeOxw2oQ7kNvwFHLHxP&_nc_oc=AdoWedrhOgPOQoOzBTNetA8SLxFt2L4F8zfTaqiGxEScAMdXob6tTWSjjbWXJNdmu-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsSB8A8Pf_MZAXVw5eLTEb9clLt_BGjPX3-0CVbvm0pg&oe=6A846508"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot AH-1 Fullscale.png", "id": "859216517108808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307444_859216520442141_2291269221385765317_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw2Fq59sKsgQ7kNvwFIdsLy&_nc_oc=AdqHzbW17NwaRFkv7oieySF2qdtfM8G0pYiEJMvjdL7Z6vvqrCvy5KtF7e-YHYU27Qw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq-72frWpf4oDbxVsvjkKmM0AErP_i4IzFLX-Jeidjsw&oe=6A844BE3"}, "display_name": "AR Choppers", "keywords": ["helicopter", "chopper", "heli", "flying", "flightsim"], "long_description": "Fly 16 amazing helicopters in mixed-reality or experience them at actual size!  \n\nAll models are finely detailed and scaled to 1/32.  Enjoy realistic flight physics tuned meticulously for MR play!\n\nChoppers:\n\u2022 Bell 47\n\u2022 Robinson R44\n\u2022 Bell 206 JetRanger\n\u2022 Airbus AS350\n\u2022 UH-1 \"Huey\" Iroquois\n\u2022 UH-60 Black Hawk\n\u2022 SB-1 Defiant\n\u2022 CH-53 Sea Stallion\n\u2022 CH-47 Chinook\n\u2022 Mi-26 Halo\n\u2022 AH-1 Cobra\n\u2022 Mi-8 Hip\n\u2022 MH-6 Little Bird\n\u2022 Mi-24 Hind\n\u2022 Ka-52 Alligator\n\u2022 AH-64 Apache\n\nEach chopper type has a timed \"mission\" activity:\n\u2022 Crop spray: fly over crops to fertilize them!\n\u2022 Firefight: fill your bucket and douse wildfire!\n\u2022 Transport: deliver troops to the frontline!\n\u2022 Heavy lift: hook up a heavy load and drop it at its destination!\n\u2022 Attack: laser-designate targets to destroy them with guns and missiles!\n\nScan your room in Quest Environment setup and mission objects will be contained within it, otherwise a generic space is used.  Toggle wall-collision via radial menu (off by default).\n\nControls:\n\u2022 Right Thumbstick: cyclic pitch+roll\n\u2022 Left Thumbstick: collective & yaw\n\u2022 Button A: next chopper (hold for menu)\n\u2022 Button B: toggle mission (hold to toggle scale)\n\u2022 Button X: fire gun\n\u2022 Button Y: fire rocket/missile\n\u2022 Trigger: positive collective\n\u2022 Thumbstick button: negative collective\n\u2022 Thumbstick button + Trigger activate SB-1 pusher-fan.\n\u2022 Grip: grab/throw chopper\n\nCheck out \"AR Planes\" for more indoor flight!", "short_description": "Fly 16 amazing helicopters around your room in mixed-reality or experience them at actual size!  Fire guns and missiles to destroy targets!  Spray crops!  Fight fires!  Transport troops!  Heavy lift!\n\nCheck out \"AR Planes\" for more indoor flight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/archoppers/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26256475804016881"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819982_1430980838545302_4203348758379232468_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkKgb4xCxhYQ7kNvwGTV85_&_nc_oc=AdqYwSLcFx3FqyfaBUYMLNRE5h6Th9smwGhun5vXWhd3cOoXRSXFQNQ8HYrGH8SR9jk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxF0dV33lbjv_mO-GSGHZb8QU-olnewkhNm52JjgSHcQ&oe=6A844A12"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AR Choppers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1770406740, "lastRevision": {"nodes": [{"id": "25445273825137087", "rele
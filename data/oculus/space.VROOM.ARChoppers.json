rollers for \"lefties\".\nFixed Ka-52's missing gun-sound.", "created_date": 1777402805, "id": "26549243321406793", "version": "1.10", "version_code": 215, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
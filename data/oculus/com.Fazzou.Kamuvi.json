_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsOe4t4Dffrwu5z73eRXOV6TuP-N9r5MEmVEG6bG5MEg&oe=6B0872CD"}, "display_name": "Kamuvi", "keywords": ["kabyle", "Algeria", "music", "visualizer", "Berber"], "long_description": "Experience Kabyle music like never before in Virtual Reality.\n\nKaMuVi (Kabyle Music Visualizer) is an immersive VR experience designed to celebrate the rich Amazigh musical and cultural heritage. Immerse yourself in a breathtaking nightscape atop the snow-capped Djurdjura Mountains, illuminated by the moon and a starry sky.\n\nWhether listening to the legendary masterpieces of Idir, the committed poetry of Matoub Loun\u00e8s, the modern sounds of Ali Amrane, or playing your own tracks and voice, KaMuVi", "short_description": "Immerse yourself in the heart of Kabyle music in virtual reality! Let your voice and favorite songs bring interactive Berber symbols to life atop the Djurdjura mountains, beneath a starry sky."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/36447294-517d-4048-be83-f6fe4d2154ec", "developer_terms_of_service_url": null, "publisher_name": "Fazzou", "support_website_url": null, "website_url": "https://www.tiktok.com/@fatah.azzouguen", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1350914384768391"}, "review_messages": []}]}, "co
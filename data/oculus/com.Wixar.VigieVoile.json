Y5qzv0uabVCyyQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEBhiG3dYVowYbp7eqxdJeMOk_br35KC0US-nZx-KHBg&oe=6ABD275F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Le jeu de l'eco regatier (2560\u00a0\u00d7\u00a01440\u00a0px).png", "id": "3393558684303234", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031634_3393558690969900_4701480200019860247_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5DfuIs0pnkQ7kNvwH-6mKJ&_nc_oc=AdqydmbZrNt7eutMGULikMJ0u2OFi9HAdRZaX8zvL-YvNRwTnqFYRpmObkhM57rmPIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuVdraB0Mz-UVHZPLSZjOMdZJHJWzQ-J3QEJ_2HU7lkw&oe=6ABD1548"}, "display_name": "VigieVoile", "keywords": [], "long_description": "En tant qu\u2019usager de la mer, connaissez-vous les bons gestes de l\u2019\u00e9co-r\u00e9gatier ? \u00cates-vous incollables sur la faune et la flore de M\u00e9diterran\u00e9e ? Avec Vigie Voile, testez vos connaissances en vous amusant, \u00e0 travers une exp\u00e9rience immersive in\u00e9dite. Joignez-vous \u00e0 l\u2019\u00e9quipe de r\u00e9gatiers et tentez de r\u00e9aliser le meilleur score\u2026 Pour vous et pour votre club de voile. Qui seront les meilleurs ?", "short_description": "Le jeu immersif de l\u2019\u00e9co-r\u00e9gatier"}]}, "developer_name": null, "developer_privacy_policy_url": "https://s3.eu-west-3.amazonaws.com/storage.wixar.io/mention_app_vigie+voile.pdf", "developer_terms_of_service_url": null, "publisher_name": "Wixar", "support_website_url": null, "website_url": "https://www.voilesud.fr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "MEDIA_PLAYER", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recomm
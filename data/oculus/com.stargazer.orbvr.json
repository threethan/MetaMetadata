s .points.", "short_description": "Shoot Orbs, or use laser, 6 game types get a high enough score in one game to unlock the next. Easter egg modes and bonuses hidden in game. Score for your country!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://orbscores.github.io/.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "StargazerGames", "support_website_url": null, "website_url": "https://orbscores.github.io/.github.io", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1395020007031274"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624395_1424285475927420_7910775532450672747_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NiRdijnwxYQ7kNvwE7Nn3d&_nc_oc=Ado_bZTNPwT1eQwBd9Adcco4RVciVadw5woO2OOQEck4kC7-mQKWufnqeBMFs0oqpSo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM8JdXHku0QZsLjjLtJy_P8xuqkH3oWBg4kHFA2Bwx-Q&oe=6B05B608"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ORBSHOOT", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 179340504
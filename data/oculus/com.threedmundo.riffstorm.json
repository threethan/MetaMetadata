M_DD6cpJ34HA3HyLX7ol1Q&oe=6B007B35"}, {"file_name": "screenshot_04_stadium_star_power_2560x1440.png", "id": "1147175294636622", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303174_1147175297969955_6224977263274045525_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsylpGqyKhMQ7kNvwFaj3HU&_nc_oc=Ado_DSZ9ZK639HJI70rLr5iqJZBUzSGLGnP1EPoQ5X5oKdIuULRU9v0433ghl7ZrHRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtoWZVBiepxT1R08arnlFuGYy3ISqArzCpAKoy2ejsUg&oe=6B00579C"}, {"file_name": "screenshot_10_bar_2560x1440.png", "id": "3775831949221689", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299891_3775831959221688_9211909192967317124_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIvSEDrMSz0Q7kNvwF77cjl&_nc_oc=Adrk2o4ffudZ0wP_s_9ADs8CQUbSmzPIx-kY6UotlrdOZ_6Zkvjl3sB-CaASLN1x01w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw6YbTI57A6lJQFnlFariFIysGaCzVE-Yl4SC69WZN_w&oe=6B005DAE"}, {"file_name": "screenshot_07_festival_sunset_2560x1440.png", "id": "28324968210478887", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301236_28324968217145553_5972131665429066112_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0Xlv3kzU0oQ7kNvwHU2aOM&_nc_oc=Ado6tdpdT2fcAOJJW2TeFVDYXzLnDPUwiDSvJlIC8gZ-azdzdLhC0hNdRp3r-rq2gzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqafPt43i5Ai4TgZC0FnZ2VC55rYALtNqEGjRiYJhCoQ&oe=6B0065F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "29107199102205206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301196_29107199115538538_9044433494969853310_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EztfuWt0JuwQ7kNvwGbPfcg&_nc_oc=AdpfU5tWEGCtVQdMgc8eZLs0ehHQxxkIgTLpDzmqI1EBJZ9dyzN5q_QvP8rXMABE_6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7jmA6aN0o7Ck8_oEiaX0uYcBeF9vMTPVBrnxJ0T-98g&oe=6B008A25"}, "display_name": "RiffStorm", "keywords": ["rhythm", "guitar", "music", "rock", "concert"], "long_description": "Grab the guitar. Unleash the storm.\n\nRiffStorm is a rhythm-guitar game built for Meta Quest. Take the guitar off its stand with your own hand, rest the\nother over the strings and play: the five controls on your fret-hand controller (X, Y, thumbstick, trigger and grip)\nare the five strings, and your other hand really strums by moving up and down across them. Notes fly along the\nhighway toward the strum zone; press the right lanes and strum in time to chain combos.\n\nTwenty hand-designed levels take you from a garage to a stadium: pop rock, surf, funk, punk, glam, grunge, power\nmetal, speed metal and a final perfect storm. Every level has its own fictional band, tempo and venue, with a crowd\nthat reacts to how you play, a light show synced to the music, fireworks in the arenas and six guitar skins unlocked\nwith stars.\n", "short_description": "Grab the guitar, press the strings and unleash the storm across 20 VR concerts.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/8xBWQmRGcJMiZJ2qT9fXyg", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/8xBWQmRGcJMiZJ2qT9fXyg", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "
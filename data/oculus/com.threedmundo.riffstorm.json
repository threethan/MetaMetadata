rcLjBKwFVBO0v20bxyI3ExdaRlWbVNVc6w&oe=6B05D025"}, "display_name": "RiffStorm", "keywords": ["rhythm", "guitar", "music", "rock", "concert"], "long_description": "Grab the guitar. Unleash the storm.\n\nRiffStorm is a rhythm-guitar game built for Meta Quest. Take the guitar off its stand with your own hand, rest the\nother over the strings and play: the five controls on your fret-hand controller (X, Y, thumbstick, trigger and grip)\nare the five strings, and your other hand really strums by moving up and down across them. Notes fly along the\nhighway toward the strum zone; press the right lanes and strum in time to chain combos.\n\nTwenty hand-designed levels take you from a garage to a stadium: pop rock, surf, funk, punk, glam, grunge, power\nmetal, speed metal and a final perfect storm. Every level has its own fictional band, tempo and venue, with a crowd\nthat reacts to how you play, a light show synced to the music, fireworks in the arenas and six guitar skins unlocked\nwith stars.\n", "short_description": "Grab the guitar, press the strings and unleash the storm across 20 VR concerts.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/8xBWQmRGcJMiZJ2qT9fXyg", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/8xBWQmRGcJMiZJ2qT9fXyg", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "
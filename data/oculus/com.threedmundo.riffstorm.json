71-25/499303174_1147175297969955_6224977263274045525_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suVWD2yPC7YQ7kNvwHC_HBC&_nc_oc=AdqsN6BTu1EWoQnEn1vYilguJ6knxTkmqqCWNUgMSWRRQLckg4xKMsJjB8HwydqRauk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1pn-U52PdLdY_k135E9UQd1DfOMdvY-GmyrAvE5PK9Q&oe=6AF9C01C"}, {"file_name": "screenshot_10_bar_2560x1440.png", "id": "3775831949221689", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299891_3775831959221688_9211909192967317124_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guh3HD3HBMYQ7kNvwHqLs-_&_nc_oc=AdpsaVLEPoNLXVdyQ7NuUTshfeW-eF4esatPnEoiTwbc_5hxr2M5HrzQSUeT17NJYxE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbPQq7_gXpVanqM8r8xJmZgtpwoY0cgkj2ijoMBWMvXg&oe=6AF9C62E"}, {"file_name": "screenshot_07_festival_sunset_2560x1440.png", "id": "28324968210478887", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499301236_28324968217145553_5972131665429066112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XnV_txxW68Q7kNvwFmuJfz&_nc_oc=Adq65gmsAkAxAdHLaJgrC4aS4NO4MlpE7r1UTsmfmT1xbjYV2PM2WegloEOl7FsB7LQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSawc1DZP1FrjKAaNYCTnfIrsP-Ys3mSVHvx71Dm0FYw&oe=6AF9CE79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "29107199102205206", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499301196_29107199115538538_9044433494969853310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTidWSauTaYQ7kNvwG7hXA0&_nc_oc=AdrwtBzgZccMApWhsXpDMaNsuDGjehsuGAUYQsoN5HIEX7HWjVxxH6_FhgZgn_rV8Hw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwbRNTzlRmuvIUNa-m5ytgCkAVi5E2fjLvlFGwGoJKjw&oe=6AF9BA65"}, "display_name": "RiffStorm", "keywords": ["rhythm", "guitar", "music", "rock", "concert"], "long_description": "Grab the guitar. Unleash the storm.\n\nRiffStorm is a rhythm-guitar game built for Meta Quest. Take the guitar off its stand with your own hand, rest the\nother over the strings and play: the five controls on your fret-hand controller (X, Y, thumbstick, trigger and grip)\nare the five strings, and your other hand really strums by moving up and down across them. Notes fly along the\nhighway toward the strum zone; press the right lanes and strum in time to chain combos.\n\nTwenty hand-designed levels take you from a garage to a stadium: pop rock, surf, funk, punk, glam, grunge, power\nmetal, speed metal and a final perfect storm. Every level has its own fictional band, tempo and venue, with a crowd\nthat reacts to how you play, a light show synced to the music, fireworks in the arenas and six guitar skins unlocked\nwith stars.\n", "short_description": "Grab the guitar, press the strings and unleash the storm across 20 VR concerts.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/8xBWQmRGcJMiZJ2qT9fXyg", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/8xBWQmRGcJMiZJ2qT9fXyg", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1150855187380583"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499303174_1785233546080820_3525705897415564089_n.png?stp=dst-png_s360x360&_n
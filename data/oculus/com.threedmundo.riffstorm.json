VHcXvXYMeC7TGDOVDmXxQg&oe=6B0C58B5"}, {"file_name": "screenshot_04_stadium_star_power_2560x1440.png", "id": "1147175294636622", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303174_1147175297969955_6224977263274045525_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dI5mCfbrMPAQ7kNvwHAiQ-3&_nc_oc=AdqDsexB6Nkf0cOBdpMsLh-vLcsTKI090oFJVJlgZ8eBX6gL_8680z0tS4Q4AXcNO8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQvaMnaCRg99npQNyF1QttS4wE400HN3HBiqjrFlqBFgA&oe=6B0C6D5C"}, {"file_name": "screenshot_10_bar_2560x1440.png", "id": "3775831949221689", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299891_3775831959221688_9211909192967317124_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgJrELR-GZMQ7kNvwGa2eDH&_nc_oc=AdrZoF66Q6tDP4kJWmClLZC205ga91169CZ6iS46yvt1Cs_edSJSyP5Oh2FOLJmaChg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdFs4ZyiPSAmx7jUkbQf3mslm4T8WiVExWXoI13wBLyA&oe=6B0C736E"}, {"file_name": "screenshot_07_festival_sunset_2560x1440.png", "id": "28324968210478887", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301236_28324968217145553_5972131665429066112_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2rJhizTnJsQ7kNvwFr9ylF&_nc_oc=AdrFdjlO3Sk5j0SkrXEDZ6csRchFZDiFLY-6KayuBfgmt-bAvflG3OiMifB9NGOf3sc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEWaCuKTvmNy1Zua6poFagl5a7EfBDL3m-vf_wxKELAA&oe=6B0C7BB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "29107199102205206", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301196_29107199115538538_9044433494969853310_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsnB8PxNwOMQ7kNvwGeNdRV&_nc_oc=AdqjELXtJX2aPw7HuS_4j1Qk-leYwMHcNo4CwVGbEFnDUozdPT224S9xvR4CRYoeiwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJdVNpAncWEjvVa8KuG4nVf9cCDs3GlhLh9tFre9UiIg&oe=6B0C67A5"}, "display_name": "RiffStorm", "keywords": ["rhythm", "guitar", "music", "rock", "concert"], "long_description": "Grab the guitar. Unleash the storm.\n\nRiffStorm is a rhythm-guitar game built for Meta Quest. Take the guitar off its stand with your own hand, rest the\nother over the strings and play: the five controls on your fret-hand controller (X, Y, thumbstick, trigger and grip)\nare the five strings, and your other hand really strums by moving up and down across them. Notes fly along the\nhighway toward the strum zone; press the right lanes and strum in time to chain combos.\n\nTwenty hand-designed levels take you from a garage to a stadium: pop rock, surf, funk, punk, glam, grunge, power\nmetal, speed metal and a final perfect storm. Every level has its own fictional band, tempo and venue, with a crowd\nthat reacts to how you play, a light show synced to the music, fireworks in the arenas and six guitar skins unlocked\nwith stars.\n", "short_description": "Grab the guitar, press the strings and unleash the storm across 20 VR concerts.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/8xBWQmRGcJMiZJ2qT9fXyg", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/8xBWQmRGcJMiZJ2qT9fXyg", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "
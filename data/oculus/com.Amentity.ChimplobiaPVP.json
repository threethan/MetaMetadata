dn.com&oh=00_Af2LubhH8Lhuut_lj13Kct0Hr9tadoJNWyk_aD6nRuWepQ&oe=69F1F704"}, {"file_name": "weuifgwefgyweyif.png", "id": "1345348939943202", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392005_1345348943276535_9103278653741297692_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kh_8BkHzxHAQ7kNvwGENltz&_nc_oc=AdpbcDBg4jqSm0mwBBFeMo5Qv5LludM4YMMhLiqAO7ZtOawvTzxThHU0wFIfhFFepyA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2Lg4UxcbZr4thR09e5o28fxTRkODgf7rhS1Q_GFkDhIA&oe=69F20819"}, {"file_name": "weuifgwefgyweyif.png", "id": "1717975372458325", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392005_1717975375791658_9102377293415888747_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vf6K6NwDug0Q7kNvwHBfhrT&_nc_oc=Ado7qdQwCqjtYHG4b9ANFaVxVrVs5z30PbG5AFbSmVplCu_Q22y1QO2oc3lduoBgCqs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0VFEBUXnGBgoLYF73OgKqeZrkfNDgXzV4XTCMwO_YOUQ&oe=69F1F9CA"}, {"file_name": "weuifgwefgyweyif.png", "id": "1150696663461284", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_1150696666794617_6020951942484669123_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auw-o5auJrUQ7kNvwGr2dju&_nc_oc=AdrHLGYN2WGjBnHPLlJbVEWYPAMzjoUXVbtWNUsWL95CWh73RKtZB3xCbWm0Hkbou_E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af17HKlOCulds3AdSmer4sqCkm7QTPBE2w7Cc9bB-ltpzg&oe=69F2059E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Lab PVP", "keywords": ["Chimp", "Gorilla", "Chase", "Lab", "Horror"], "long_description": "Chimp Lab PVP is an intense VR multiplayer game that revolves around fast-paced player-versus-player combat using gorilla locomotion, inspired by Another Axiom\u2019s movement system. Players must master skillful climbing, jumping, and wall-running to outmaneuver opponents in dynamic arenas. With no buttons for movement, every action relies on physical arm motions, making battles feel immersive and skill-based. Whether dodging attacks or launching strategic ambushes, players must rely on agility and reflexes to dominate.", "short_description": "Chimp Lab PVP is a fast-paced VR multiplayer game focused on PvP combat using Another Axiom\u2019s gorilla locomotion. Players must climb, jump, and maneuver skillfully to outplay opponents in intense battles."}]}, "developer_name": "Nebula Forge Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1hXJ_DhZ3l-sa8h7vlkGD_xyDsg2eHFWFe9WXvkRpJ74/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nebula Forge Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/chimp-lab-pvp/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "1023770785722696"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28919865314325820"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28929419366703748", "version": "3.4.0"}, "id": "929673749242741", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28894955956816756", "is_concept": false, "latest_released_bina
n.com&_nc_ss=7a30f&oh=00_AfxC2nQBSupAkNyZEtFJtDDP_2WGcrgifcZV8lxe_EKdoA&oe=69CFB2CA"}, {"file_name": "weuifgwefgyweyif.png", "id": "1150696663461284", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392010_1150696666794617_6020951942484669123_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dl2sNcPEW2AQ7kNvwGya122&_nc_oc=AdpDIeXHI5S4A0Vz5B74cS5sp7-yJFsxdxtJPROowQwWcSWcrn7uAc7bH4vnsxmxgE4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_BhgAUMEcR7OvVF6arrOdZ5_Odi0bE4lCKpnnIgFutQ&oe=69CFBE9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Lab PVP", "keywords": ["Chimp", "Gorilla", "Chase", "Lab", "Horror"], "long_description": "Chimp Lab PVP is an intense VR multiplayer game that revolves around fast-paced player-versus-player combat using gorilla locomotion, inspired by Another Axiom\u2019s movement system. Players must master skillful climbing, jumping, and wall-running to outmaneuver opponents in dynamic arenas. With no buttons for movement, every action relies on physical arm motions, making battles feel immersive and skill-based. Whether dodging attacks or launching strategic ambushes, players must rely on agility and reflexes to dominate.", "short_description": "Chimp Lab PVP is a fast-paced VR multiplayer game focused on PvP combat using Another Axiom\u2019s gorilla locomotion. Players must climb, jump, and maneuver skillfully to outplay opponents in intense battles."}]}, "developer_name": "Nebula Forge Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1hXJ_DhZ3l-sa8h7vlkGD_xyDsg2eHFWFe9WXvkRpJ74/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Nebula Forge Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/chimp-lab-pvp/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"
AQ4pktHjlu-4Vkk2GM0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9BxPpnUe-TNBFWg6mHU8BXLWZ8EKZrRWhUH4D625N1A&oe=69AD6D7A"}, "display_name": "Cosmic Flow: A Relaxing VR Experience", "keywords": [], "long_description": "Cosmic Flow is a relaxing visual experience, an audio-visual massage for the mind, a kaleidoscopic meditation. \n\nCosmic Flow was developed by an artist as a first part of a series of VR experiences encouraging connection and personal expression. A relaxed mind is better able to understand and express itself. Cosmic Flow hopes to instill this feeling of relaxation so that, when the headset comes off, the feeling continues.", "short_description": "Cosmic Flow is a relaxing visual experience, an audio-visual massage for the mind, a kaleidoscopic meditation."}]}, "developer_name": "vedev", "developer_privacy_policy_url": "https://vedev.cc/cosmicflow-privacy/", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "http://vedev.cc/cosmicflow", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1139812733440607"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035469_189810079378511_9120131859718430587_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_
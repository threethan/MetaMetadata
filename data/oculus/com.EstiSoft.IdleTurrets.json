5-12-09 174246.png", "id": "1398703825237418", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825415_1398703828570751_7946905486613844162_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0k6LtRgbq4Q7kNvwFYKlzg&_nc_oc=AdrZmfOk5Pyk9c2Dx8bxL6PMLzkb7XnFSf1z5g4KO_jdxMqLSoCAdShwlAFIfE3ckEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNftk461DDVoDJMmmpUe_guSozfG3ybdhyL4DXDVtBbqg&oe=6AC11DC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-12-09 174340.png", "id": "2122202154986580", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_2122202161653246_2843629539346951805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NwOesYSqEAQ7kNvwEuc-Dc&_nc_oc=AdrS1D8z3qNDSIP3XrVC6d6inLEC0Zh85SFe0tofKn4nDCvPTubjS0NAFrrR_wQ5nO8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNABlCLyO92514_7wSmDZfEgF53m_Iej82U3uQhgrDOaw&oe=6AC118EA"}, "display_name": "Idle Turrets", "keywords": ["Defence", "Army", "Strategy", "Level", "Fun"], "long_description": "Enter a vibrant low-poly world where strategy meets hands-on VR action.\n\nIn this VR action strategy game, you don\u2019t just place defenses \u2014 you control the battlefield with your own hands. Use motion controllers to aim attacks, activate portals, and manage powerful turrets in real time while waves of enemies try to overwhelm your base.\n\nPortals allow enemies \u2014 and opportunities \u2014 to appear from unexpected directions, forcing you to think fast and reposition your strategy on the fly. Each encounter rewards precision, timing, and smart turret placement rather than passive watching.\n\nDesigned specifically for comfortable and intuitive VR gameplay, the game focuses on clear visuals, readable combat, and satisfying physics-based interactions. Easy to pick up, yet challenging to master.\n\nWhether you enjoy tower defense, action-strategy hybrids, or active VR experiences, this game delivers a dynamic and engaging VR battlefield you can literally reach into.", "short_description": "A fast-paced VR action strategy game where you place turrets, open portals, and manually aim attacks with motion controllers. Defend your base against waves of enemies using physics-based mechanics, precise hand control, and quick decision-making in a colorful low-poly world."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24049486871340929"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1986652401984512"}, {"status": "PUBLISHED", "id": "993992659644795"}, {"status": "PUBLISHED", "id": "1564327611507667"}, {"status": "PUBLISHED", "id": "1180272307405770"}]}, "baseline_offer": {"id": "1180272307405770"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787079600, "status": "PUBLISHED", "id": "1986652401984512"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25265450619744542", "version": "0.1"}, "id": "709373371918641", "channel_name": "LIVE"}]}, "is_for_o
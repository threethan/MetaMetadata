105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_EIMfUx3lsQ7kNvwE36GdM&_nc_oc=AdkQuYggSL8s1Nx8KwJU9_w3FuufrJD7xGUHp86zl7qPdX7_vXX4TT6NQPTkHEVQfwo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw0da-TOMvjSyLB3LfauNN-N_NgEnoausLT6uVpZkl6Zg&oe=69BA9B64"}, {"file_name": "2.png", "id": "2074831979711344", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499305050_2074831983044677_4714902437768622337_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Jxl2W65abEQ7kNvwGFWG7j&_nc_oc=AdmrOCeA0F_GTxSk1P3rYyA-X6soEK33GAswqTK3IwW3WOTyOfrCsfr1tfQoJdfiOzs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAnqaOaUsc551p5kZcVuWIjvo-lqiFKRLwNCvomDwMvQ&oe=69BAA7D2"}, {"file_name": "3.png", "id": "1149337720368864", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312236_1149337723702197_7873282700151587164_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29l1RackdasQ7kNvwEoxusn&_nc_oc=Adkygq7q771qk9FBK5lLqfHZAyJC2VdkQ2ZAcqkoFWn_3P2GS8sM6kYhGck6W6BTU70&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMlm2qpq3qJits7RYga8wsWrG1XwUXZgLLfx81wK9N3A&oe=69BAA06D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440_v2 (2).png", "id": "1436105017912754", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820001_1436105021246087_2641205699413939970_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo0gy_xvbckQ7kNvwG-0Q5v&_nc_oc=AdkQ0OSV1xm6s3DRL5-Dt_SkBpREDctCJVL_ByUFp-9sd2sqAd0ioRa28AGcT_gs3mE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfymCEc-_XPBLFa3MR9cyEvELaaF6maTtbnzg_j5n_vHtg&oe=69BAA816"}, "display_name": "Bowling Alley", "keywords": ["Bowling"], "long_description": "Step into the ultimate VR bowling experience designed for all skill levels. Whether you're a first-timer or a seasoned player, Bowling Alley delivers smooth, addictive gameplay with realistic physics and immersive environments.\n\n{1440384923952523}\n\n**What\u2019s New:**\n\nSupports Meta Avatars \u2013 your personal avatar is automatically used in the game\n\nExplore and switch between 3 exciting themes:\n- Golden Lanes \u2013 Elegant and classic\n- Cyber Lanes \u2013 Neon-filled and futuristic\n- Jungle Rollers \u2013 Play surrounded by nature\n\n**Key Features:**\n\n- Smooth VR controls for natural aiming and throwing\n- Uses your Meta Avatar to put you in the game (Internet connection required for loading avatars and leaderboard access)\n- Live scoreboard to track and compare your high scores\n- Single-player gameplay\n- Easy, Medium, and Hard difficulty levels\n- High-quality graphics for a lifelike bowling alley feel\n- Reset option to clear scores and start fresh\n- Includes a game manual for quick guidance\n\nHow many strikes can you score in a row? Dive in, challenge yourself, and bring the bowling alley to your VR headset.\n\n**Download now and start playing.**\n", "short_description": "The Bowling Alley game is a realistic platform to enjoy the bowling experience anytime. Feel the bowling adventure and get the thrill of achieving the perfect strike. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonapps.xyz/bowling-alley/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Moon Technolabs", "support_website_url": null, "website_url": "https://www.moonapps.io/meta-games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["
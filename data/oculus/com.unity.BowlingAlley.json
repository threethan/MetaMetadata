2-1.oculuscdn.com/v/t64.5771-25/75443246_2131032663933210_8463432866804183648_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gse9etcYJT8Q7kNvwGRjZS1&_nc_oc=Adm2aT6pLMBhXLuRcGwvjwHo_0ZgxHfZbbkWiXsbrp9X8w-ESuKu48JZm3R7qDT8mkw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNu7Nq0x3Ss9ouyLxItJN2I3FP3WJ7_cfT7a8I82n5XA&oe=69AD5BE7"}, {"file_name": "5.png", "id": "1181528099752712", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982479_1181528103086045_7790722138044798626_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujfhzzDkzssQ7kNvwHmUCsC&_nc_oc=AdlEcJjnR7hY3aMsZCKGpl1vWmOG1cumZ4Q5tS_wYNu8qM6c-VD1WTIxLoUHXKMd9rc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvODcC_J47uoCpH7dUt3asm7URI9bmyXh0azN8QNb9VQ&oe=69AD5457"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bowling Alley", "keywords": ["Bowling"], "long_description": "Set yourself up and experience the best bowling game on your device. \nThis additive virtual bowling game will compel you to spend your maximum time on the game for a long time. Whether you are a pro player or playing it for the first time, this game is for everyone. \nPick the ball and win the battle, check the LIVE score, and get your name on the list of top players.\nKey features \nOffline play support\nScoreboard to analyze the score \nSingle-user play mode\nGame user manual for better understanding\nVR remote control for taking the correct direction\nThere are three different playing levels: Easy, Medium, and Hard\nHigh-quality graphics to experience the realistic scenario\nReset option to reset all your scores\n\n\n\nLet's see how many strikes you can score consecutively.  Relax your mind in your leisure time. \nDownload it now!", "short_description": "The Bowling Game app is a realistic platform to enjoy the bowling experience anytime. Feel the bowling adventure and get the thrill of achieving the perfect strike. \n"}]}, "developer_name": null, "developer_privacy_po
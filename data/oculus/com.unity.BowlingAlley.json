w-ZfqcveAAzQ3SnEcyGXX-nN3QSXllKFiIbrOsoQDm4JqpG9Rt8Ko3krFLhuk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfubkjgS-PvQnL16H-e95K7t6qciW8Dt3xOvo7jA08qKgw&oe=69A58364"}, {"file_name": "2.png", "id": "2074831979711344", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499305050_2074831983044677_4714902437768622337_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXP2gOgiSV4Q7kNvwF-ieWZ&_nc_oc=Adm_4jc4AaQDOy10rVgBF9bwKiJolippsQP7NeD-M1nbG5KkbAkUiMgV7v8HVplI7Xo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfthlS9Q7dx4zODJEJZOsqCRfkszHkFgn7D-fNBYR1AktA&oe=69A58FD2"}, {"file_name": "3.png", "id": "1149337720368864", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312236_1149337723702197_7873282700151587164_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOHlHxM1wHcQ7kNvwEefIRR&_nc_oc=Adkylg54WGIAoz2BnfkDOsfZGOHfq8vJrhCGA5SqgTJmoetLGXcp2R-imQtggKrlNfE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvyyY1_lCRsacmGSALLZBYApLdzQNtOVdQHgWs0V9x2DA&oe=69A5886D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440_v2 (2).png", "id": "1436105017912754", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820001_1436105021246087_2641205699413939970_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajKqxvv5HxcQ7kNvwEyGKSS&_nc_oc=AdmAnIFO90c6DYCJNCLW43_GD7JoGeZvt1sUHhHczCtwT-Y-QZSRtlgsKaeWwSW_x0w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftzVoi0SyFlHw_RJg1Omp3dOepoDExg0GPUwmKDg38cHA&oe=69A59016"}, "display_name": "Bowling Alley", "keywords": ["Bowling"], "long_description": "Step into the ultimate VR bowling experience designed for all skill levels. Whether you're a first-timer or a seasoned player, Bowling Alley delivers smooth, addictive gameplay with realistic physics and immersive environments.\n\n{1440384923952523}\n\n**What\u2019s New:**\n\nSupports Meta Avatars \u2013 your personal avatar is automatically used in the game\n\nExplore and switch between 3 exciting themes:\n- Golden Lanes \u2013 Elegant and classic\n- Cyber Lanes \u2013 Neon-filled and futuristic\n- Jungle Rollers \u2013 Play surrounded by nature\n\n**Key Features:**\n\n- Smooth VR controls for natural aiming and throwing\n- Uses your Meta Avatar to put you in the game (Internet connection required for loading avatars and leaderboard access)\n- Live scoreboard to track and compare your high scores\n- Single-player gameplay\n- Easy, Medium, and Hard difficulty levels\n- High-quality graphics for a lifelike bowling alley feel\n- Reset option to clear scores and start fresh\n- Includes a game manual for quick guidance\n\nHow many strikes can you score in a row? Dive in, challenge yourself, and bring the bowling alley to your VR headset.\n\n**Download now and start playing.**\n", "short_description": "The Bowling Alley game is a realistic platform to enjoy the bowling experience anytime. Feel the bowling adventure and get the thrill of achieving the perfect strike. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonapps.xyz/bowling-alley/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Moon Technolabs", "support_website_url": null, "website_url": "https://www.moonapps.io/meta-games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26201157816148487"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://
6-1.oculuscdn.com/v/t64.5771-25/75443246_2131032663933210_8463432866804183648_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bsXshsUlsQQ7kNvwEpjHeX&_nc_oc=Adl0S2mH6seHwmcfAMnJhuu96Cbaq20Zua4RtrDLao0W3qobx3en1muZd_Hp41CbC90&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYf2vcftHAXqVYMUSMQCY67w8QF7bM-RGbw0DZ1B0hBg&oe=69BD2DE7"}, {"file_name": "5.png", "id": "1181528099752712", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982479_1181528103086045_7790722138044798626_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ8di01V8c8Q7kNvwFWwyvu&_nc_oc=AdkHj_1VGJfeFoSpafYNJK7IHJQ-q5LKrx9VgHpoV4J_O6kGHRIojWkM_suUNdZq1bk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyklA5KDRfiTCsPg22sCrarao_TIM78pzDgGbAg65aq0A&oe=69BD5E97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bowling Alley", "keywords": ["Bowling"], "long_description": "Set yourself up and experience the best bowling game on your device. \nThis additive virtual bowling game will compel you to spend your maximum time on the game for a long time. Whether you are a pro player or playing it for the first time, this game is for everyone. \nPick the ball and win the battle, check the LIVE score, and get your name on the list of top players.\nKey features \nOffline play support\nScoreboard to analyze the score \nSingle-user play mode\nGame user manual for better understanding\nVR remote control for taking the correct direction\nThere are three different playing levels: Easy, Medium, and Hard\nHigh-quality graphics to experience the realistic scenario\nReset option to reset all your scores\n\n\n\nLet's see how many strikes you can score consecutively.  Relax your mind in your leisure time. \nDownload it now!", "short_description": "The Bowling Game app is a realistic platform to enjoy the bowling experience anytime. Feel the bowling adventure and get the thrill of achieving the perfect strike. \n"}]}, "developer_name": null, "developer_privacy_po
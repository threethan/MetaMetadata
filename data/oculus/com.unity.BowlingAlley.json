83", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491819845_1240534404570949_131716155619224753_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZxcyUzNjwMQ7kNvwH6yOT2&_nc_oc=AdkL3cu-YHGcTNeGUy9DLllm5e0IpMLBRfTMSt1exDuyHG21ARqlP2mXL60dh0pmKyY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftlprGbe6yMt820sWTFrxQh6MhnsG0IfptpVZLKUvMD7g&oe=69A185F0"}, {"file_name": "v.png", "id": "933988225855694", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491820887_933988229189027_2588288299906173334_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QZjgevB74cQ7kNvwEgcId1&_nc_oc=AdkdHnwALkn3Ji1ktsxHZcEUyj2BFBgdT0yeJdC6rHHZhW1YtCwJmfnZ8euhHoj5CWQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvcDqkEv6psE6grpZ8HXYyiIIa_Aia4sbjinASaEcoxaQ&oe=69A195A9"}]}, "id": "916583830719961", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "919357459747019", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982672_919357463080352_3085464648652592985_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0N-oubyTnkQ7kNvwHN2PIa&_nc_oc=AdnSosicaeim9sE1zUl8yz0xOXB-DIU5X5q--op3Qv7_A5PpRktWRXXPEHvM1y_TdfY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft2XMNsvPvsb60Za-XG00LiRBc5S7paMhjgf4VIEuvG2Q&oe=69A182BD"}, {"file_name": "2.png", "id": "25248704541386370", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491820987_25248704554719702_2599056714298290717_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LyNn1-SlxwQ7kNvwFU73SY&_nc_oc=AdkKMAGPKwHjZG37uAv33AE_W0w8FgfEEm4t-HUcBEtFfeLVy7TeGzEBUd8dCvE3jG0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsgTeERNJ74eMBV6SBVgHAamjGvZY75EWKQLR_bdnm2PA&oe=69A18CA3"}, {"file_name": "4.png", "id": "1385856785811762", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499299808_1385856789145095_1878057072609267376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pol43epgViwQ7kNvwFlUDqm&_nc_oc=Adllr2AIdgeZ0KWvs7CL4_h2x_LFqa-8v9VIEC-Qzj-dfxfUngFhvzZHo_IfyQIzOBA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftxTeF6iGorph2eSkUryhpUPpwDXGma0Id6FKkII32GKA&oe=69A18EE4"}, {"file_name": "2.png", "id": "2074831979711344", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499305050_2074831983044677_4714902437768622337_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxvVv_Loff0Q7kNvwGGXsOW&_nc_oc=AdntuNx70BZnnN6ilUrQ5d-F-EL_9sKlIxANdnpq4w-56hvAW-3XFRiDBl5M13UO4Gk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuSj-Yf0PXHcZKqjb64G05OUtgkwjCzvVqeRqaldrBk6w&oe=69A19B52"}, {"file_name": "3.png", "id": "1149337720368864", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499312236_1149337723702197_7873282700151587164_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Zj5BtpquBcQ7kNvwGUIqKH&_nc_oc=AdnLtGGG0NG9FY78P3aB4ulMMUTEUqU5sMBfWUHvNXw9H0foDowg6DlARiGj_o7U9O8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvpNrZB4LWD0N-fZtvlfeFClHBUgC7j_1928sqHW5tq1w&oe=69A193ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440_v2 (2).png", "id": "1436105017912754", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491820001_1436105021246087_2641205699413939970_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENcgRhL-RGsQ7kNvwEpIL2z&_nc_oc=AdlU0WomuHxMdXJ79Z6Y0Rng1TRmNnnocKGwkOMdI0nypXHhnkaxQd9dbMJxaTZliis&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afvuu-zt0DLNHzJl-gj4bk8ouc7DFj94y8IXbomiFlLazQ&oe=69A19B96"}, "display_name": "Bowling Alley", "keywords": ["Bowling"], "long_description": "Step into the ultimate VR bowling experience designed for all skill levels. Whether you're a first-timer or a seasoned player, Bowling Alley delivers smooth, addictive gameplay with realistic physics and immersive environments.\n\n{1440384923952523}\n\n**What\u2019s New:**\n\nSupports Meta Avatars \u2013 your personal avatar is automatically used in the game\n\nExplore and switch between 3 exciting themes:\n- Golden Lanes \u2013 Elegant and classic\n- Cyber Lanes \u2013 Neon-filled and futuristic\n- Jungle Rollers \u2013 Play surrounded by nature\n\n**Key Features:**\n\n- Smooth VR controls for natural aiming and throwing\n- Uses your Meta Avatar to put you in the game (Internet connection required for loading avatars and leaderboard access)\n- Live scoreboard to track and compare your high scores\n- Single-player gameplay\n- Easy, Medium, and Hard difficulty levels\n- High-quality graphics for a lifelike bowling alley feel\n- Reset option to clear scores and start fresh\n- Includes a game manual for quick guidance\n\nHow many strikes can you score in a row? Dive in, challenge yourself, and bring the bowling alley to your VR headset.\n\n**Download now and start playing.**\n", "short_description": "The Bowling Alley game is a realistic platform to enjoy the bowling experience anytime. Feel the bowling adventure and get the thrill of achieving the perfect strike. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonapps.xyz/bowling-alley/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Moon Technolabs", "support_website_url": null, "website_url": "https://www.moonapps.io/meta-games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26201157816148487"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://
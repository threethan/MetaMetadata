83", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819845_1240534404570949_131716155619224753_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hivcQU4gx68Q7kNvwFJmp5G&_nc_oc=AdmQOGFnGT91SoGGCaCk4GD2UlCfojL0JCi-931qXhFvqT-MKKfjp9MawgDmrIf8MWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvE6fjA9p2WgDMJejAdi6z3wViQ7BNSG85fX32lYZZQfA&oe=69999CF0"}, {"file_name": "v.png", "id": "933988225855694", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_933988229189027_2588288299906173334_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHB2XwooRGEQ7kNvwHrp2GY&_nc_oc=AdlSmOWVKKftE5s3O3FKx1ielQE7xQYTfFNYzyC7j6O88crieJW7JKmCit1yz893NyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftc67arfcVtr4L0Oj21NOOT5loJxQY7_eD-VMNV37EWVA&oe=6999ACA9"}]}, "id": "916583830719961", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "919357459747019", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982672_919357463080352_3085464648652592985_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LoHMfn0zE8Q7kNvwGrp47r&_nc_oc=AdniWMqk7_YzZ-XUSEmFeo2A_bphAVxiS3ClL8Ib7mWqBWL5kKkjVGjmgq4Q-r_mITM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuhUgfEPCnIc6cS8lqMX3KGSdEiKwo6YmJT9jf6yQLjlQ&oe=699999BD"}, {"file_name": "2.png", "id": "25248704541386370", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820987_25248704554719702_2599056714298290717_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXM4UumlxNQQ7kNvwGc2CO9&_nc_oc=Admlk7jUAxqsz1E4syAEFNxyBRIsS7Phc5X4bHAY6jypJkRBZSlbPto-XoHGRv3ZeNk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu4ul_Cz3qgvLfZEndHxr6p69qQbqq7iX6PhEpoz0f8rA&oe=6999A3A3"}, {"file_name": "4.png", "id": "1385856785811762", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299808_1385856789145095_1878057072609267376_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFR5kQWwoxkQ7kNvwE00hoE&_nc_oc=Adm64nHzQhEWu4ccqMrEHuPG2UhkvWsZPkn7LL3gzRpQpfmwy-i_vf69Zz2qypmThKk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuXFA8N2ehPrsopAkzZoSJqI70O-AN1IZWBzCFUIuGokA&oe=6999A5E4"}, {"file_name": "2.png", "id": "2074831979711344", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305050_2074831983044677_4714902437768622337_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcQubNP-inUQ7kNvwFhAhgY&_nc_oc=AdmR3K2iV0QxfiUWSz01YqGvCArGSBSBfDuwkUIcZp3m-LerZhhoXKEtzRyNptBfiUI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvAHNppUUiBw65xQ241c79aQ1UaI_76ilTZOOo9oyUpDw&oe=6999B252"}, {"file_name": "3.png", "id": "1149337720368864", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_1149337723702197_7873282700151587164_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ3z6ASZTZ0Q7kNvwFN4jkq&_nc_oc=AdmxP0moDoYN69Rm4YHIOlQu0zTAbf5EcSbJaXdIsK-fv9TG4fbRF6-xc_nD8g2kpck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft79_iELtQIVBK0PLCmmeUBCmtsMi4Q_l0A3KZMJIcDcg&oe=6999AAED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440_v2 (2).png", "id": "1436105017912754", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820001_1436105021246087_2641205699413939970_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cc6RpkYYlkQ7kNvwEXHHCB&_nc_oc=Adno-MY9yOdsDmWoxh58NefJfNCw4GMAH4aMUJywKKO_gP4_IK5b33hiYHyKe3Vv1FQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsRA1W3U6tmLpPsEfgvuVb9orOiHUJhbEhifP1sS3XQ8A&oe=6999B296"}, "display_name": "Bowling Alley", "keywords": ["Bowling"], "long_description": "Step into the ultimate VR bowling experience designed for all skill levels. Whether you're a first-timer or a seasoned player, Bowling Alley delivers smooth, addictive gameplay with realistic physics and immersive environments.\n\n{1440384923952523}\n\n**What\u2019s New:**\n\nSupports Meta Avatars \u2013 your personal avatar is automatically used in the game\n\nExplore and switch between 3 exciting themes:\n- Golden Lanes \u2013 Elegant and classic\n- Cyber Lanes \u2013 Neon-filled and futuristic\n- Jungle Rollers \u2013 Play surrounded by nature\n\n**Key Features:**\n\n- Smooth VR controls for natural aiming and throwing\n- Uses your Meta Avatar to put you in the game (Internet connection required for loading avatars and leaderboard access)\n- Live scoreboard to track and compare your high scores\n- Single-player gameplay\n- Easy, Medium, and Hard difficulty levels\n- High-quality graphics for a lifelike bowling alley feel\n- Reset option to clear scores and start fresh\n- Includes a game manual for quick guidance\n\nHow many strikes can you score in a row? Dive in, challenge yourself, and bring the bowling alley to your VR headset.\n\n**Download now and start playing.**\n", "short_description": "The Bowling Alley game is a realistic platform to enjoy the bowling experience anytime. Feel the bowling adventure and get the thrill of achieving the perfect strike. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonapps.xyz/bowling-alley/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Moon Technolabs", "support_website_url": null, "website_url": "https://www.moonapps.io/meta-games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26201157816148487"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://
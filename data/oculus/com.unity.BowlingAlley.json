762", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499299808_1385856789145095_1878057072609267376_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_VxZdPvdBAQ7kNvwFZ-sJC&_nc_oc=AdoDBq0tO1B2ZWw3XR32JQMl9xZh3Qr0sWV40rhBzJaW3g-ThHxI6nFO1J4yNkjjsm0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwhkv0OzjgHNCl0kIyNt0wBxLCcaxErHs1S8ndb7RTyg&oe=6B085F24"}, {"file_name": "2.png", "id": "2074831979711344", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499305050_2074831983044677_4714902437768622337_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-e0CGjmul0Q7kNvwGcksO3&_nc_oc=AdranZ8ppu9Psout0-p5-ksAoSJxVqeZjCmjxsTKEcoDC3Li-N4kLoABENfkkRPFUIA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCbrRvWviB39mupZIDFsXsM-DAIMf1-mmyEfK5lT_gtw&oe=6B086B92"}, {"file_name": "3.png", "id": "1149337720368864", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312236_1149337723702197_7873282700151587164_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bs_IzZTVXqcQ7kNvwHNxhEl&_nc_oc=AdoAU1jiuIwSI0XFO3JyH-mDtd3vrlpH_XqMyMAu0NVEpcYInik0FzMZXYEwzGwuQng&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXC0FbWw7s4C4PH1YbuOlldXINoayysVKYjWXl5SScVg&oe=6B08642D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440_v2 (2).png", "id": "1436105017912754", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820001_1436105021246087_2641205699413939970_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b05OHJZfUt0Q7kNvwFLHj-5&_nc_oc=AdpJgISnPqjcTY4XLXh8ocUBu98xLKyRhKXgus8eYguoUpo4jQCBxK-v64ismfa2bbc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTYzBIpHgjvYSuKjOTV3eHYYrpCozTQUQBpJWw623Ikg&oe=6B086BD6"}, "display_name": "Bowling Alley", "keywords": ["Bowling"], "long_description": "Step into the ultimate VR bowling experience designed for all skill levels. Whether you're a first-timer or a seasoned player, Bowling Alley delivers smooth, addictive gameplay with realistic physics and immersive environments.\n\n{1440384923952523}\n\n**What\u2019s New:**\n\nSupports Meta Avatars \u2013 your personal avatar is automatically used in the game\n\nExplore and switch between 3 exciting themes:\n- Golden Lanes \u2013 Elegant and classic\n- Cyber Lanes \u2013 Neon-filled and futuristic\n- Jungle Rollers \u2013 Play surrounded by nature\n\n**Key Features:**\n\n- Smooth VR controls for natural aiming and throwing\n- Uses your Meta Avatar to put you in the game (Internet connection required for loading avatars and leaderboard access)\n- Live scoreboard to track and compare your high scores\n- Single-player gameplay\n- High-quality graphics for a lifelike bowling alley feel\n- Easy, Medium, and Hard difficulty levels\n- Reset option to clear scores and start fresh\n- Includes a game manual for quick guidance\n\nHow many strikes can you score in a row? Dive in, challenge yourself, and bring the bowling alley to your VR headset.\n\n**Download now and start playing.**\n", "short_description": "The Bowling Alley game is a realistic platform to enjoy the bowling experience anytime. Feel the bowling adventure and get the thrill of achieving the perfect strike. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonapps.io/bowling-alley/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Moon Technolabs", "support_website_url": null, "website_url": "https://www.moonapps.io/meta-games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null,
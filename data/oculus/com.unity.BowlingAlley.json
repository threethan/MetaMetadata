105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBAAIeZGdgIQ7kNvwE1XN6S&_nc_oc=AdkaUbiN5VXpTZzNjOimWB-R5K7VYXDdvPrip03yh5vb4hB0BxXFkAXpVLqynfvZ7uU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtowGz17yAteJwDRn_y6CtDVy0ykR2S3zxWW9MNcVGZA&oe=69BD3E64"}, {"file_name": "2.png", "id": "2074831979711344", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499305050_2074831983044677_4714902437768622337_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwUlVpgdhpwQ7kNvwHPeVMk&_nc_oc=AdmVXsaKTZQOYmS9gtPQl1TsOXyox0WOURAYRBMJipykKkZKKk64epErBEKyQOvJkmw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzH19lvV96k9WifDOEkFR4A8EbpNIoejn0qVGmQjvt8kA&oe=69BD4AD2"}, {"file_name": "3.png", "id": "1149337720368864", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499312236_1149337723702197_7873282700151587164_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yqx-F1jw1AQ7kNvwHrKzt1&_nc_oc=AdnXyWUudT6XnuOGkqZ0wzP4FLMVqW3KA83QTGCkirYQRLR6cmg_bkItDCrswV-9FAo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqhpHxzRbCJNacxeuXQuDzOGFBhqRoHaw4ERdwm32m4w&oe=69BD436D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440_v2 (2).png", "id": "1436105017912754", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820001_1436105021246087_2641205699413939970_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4ipXM_aDGQQ7kNvwHFm2t0&_nc_oc=AdnnSTqTlLavFLVake6DGlese-LcVaQtED3sTLcDBKcTCHwcfnRejug_TkHwafeuPbU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLWRC36D_gNeUWLS6U1UTFSGpHJGd1j4stMbYnNUM2QQ&oe=69BD4B16"}, "display_name": "Bowling Alley", "keywords": ["Bowling"], "long_description": "Step into the ultimate VR bowling experience designed for all skill levels. Whether you're a first-timer or a seasoned player, Bowling Alley delivers smooth, addictive gameplay with realistic physics and immersive environments.\n\n{1440384923952523}\n\n**What\u2019s New:**\n\nSupports Meta Avatars \u2013 your personal avatar is automatically used in the game\n\nExplore and switch between 3 exciting themes:\n- Golden Lanes \u2013 Elegant and classic\n- Cyber Lanes \u2013 Neon-filled and futuristic\n- Jungle Rollers \u2013 Play surrounded by nature\n\n**Key Features:**\n\n- Smooth VR controls for natural aiming and throwing\n- Uses your Meta Avatar to put you in the game (Internet connection required for loading avatars and leaderboard access)\n- Live scoreboard to track and compare your high scores\n- Single-player gameplay\n- Easy, Medium, and Hard difficulty levels\n- High-quality graphics for a lifelike bowling alley feel\n- Reset option to clear scores and start fresh\n- Includes a game manual for quick guidance\n\nHow many strikes can you score in a row? Dive in, challenge yourself, and bring the bowling alley to your VR headset.\n\n**Download now and start playing.**\n", "short_description": "The Bowling Alley game is a realistic platform to enjoy the bowling experience anytime. Feel the bowling adventure and get the thrill of achieving the perfect strike. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonapps.xyz/bowling-alley/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Moon Technolabs", "support_website_url": null, "website_url": "https://www.moonapps.io/meta-games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["
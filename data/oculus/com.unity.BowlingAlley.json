lzD2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuwOWXrOA0jswUl-Lqj-6PA2lSp7QBr-PcY-wrgBAqMA&oe=6A7079E7"}, {"file_name": "5.png", "id": "1181528099752712", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982479_1181528103086045_7790722138044798626_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmCjc6ySPtEQ7kNvwGEsXxB&_nc_oc=AdoVQxj4OG3PRIhPSUA4uSpnlsVf9faYearorVaAAPKlaLv8C5nvqt9-vEgA_jCWt6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_HbxIEIIk31L_xu9OkiKFA8Y2MCgHXggoU14cX1pPdw&oe=6A707257"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bowling Alley", "keywords": ["Bowling"], "long_description": "Set yourself up and experience the best bowling game on your device. \nThis additive virtual bowling game will compel you to spend your maximum time on the game for a long time. Whether you are a pro player or playing it for the first time, this game is for everyone. \nPick the ball and win the battle, check the LIVE score, and get your name on the list of top players.\nKey features \nOffline play support\nScoreboard to analyze the score \nSingle-user play mode\nGame user manual for better understanding\nVR remote control for taking the correct direction\nThere are three different playing levels: Easy, Medium, and Hard\nHigh-quality graphics to experience the realistic scenario\nReset option to reset all your scores\n\n\n\nLet's see how many strikes you can score consecutively.  Relax your mind in your leisure time. \nDownload it now!", "short_description": "The Bowling Game app is a realistic platform to enjoy the bowling experience anytime. Feel the bowling adventure and get the thrill of achieving the perfect strike. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonapps.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Moon Technolabs", "support_website_url": null, "website_url": "https://www.moonapps.xyz/", "catego
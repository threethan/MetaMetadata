762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299808_1385856789145095_1878057072609267376_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBCtNjLJybYQ7kNvwGu3Tds&_nc_oc=Adr2TSp2TEzvMesqhXwsQY_6AbdLFUJawDtR42PMICnVtTq3GcAySRrpqcEfjMDcKcY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTmKSlFR3MisfGrH8xw_sCoGaEKR0xy3QX7uwS9dWwLGQ&oe=6B0C53A4"}, {"file_name": "2.png", "id": "2074831979711344", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_2074831983044677_4714902437768622337_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkUglqVfXbsQ7kNvwH8vn-3&_nc_oc=Adr3D1S16Mo8_9FOCggK8HhWHzZi-w3xp6V1pVSoRqW4pYhM8R1RjhKSbntqAZ2qZQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR72OfBsNY9BRe8pBYIJo0iFykNivYXTcvU5wFn6oc9gg&oe=6B0C6012"}, {"file_name": "3.png", "id": "1149337720368864", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312236_1149337723702197_7873282700151587164_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iH37YPznz10Q7kNvwG0UYHR&_nc_oc=AdqARQrktdFaUvDYtqCNdk9AtwS0mHD1k6RT3WkXLA5GgjGuSpmf-zRYyzFlybGPnHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSNapFwDBt00m_vtktelt2Rk6oWMYk-AqReuYaElRa1w&oe=6B0C58AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440_v2 (2).png", "id": "1436105017912754", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820001_1436105021246087_2641205699413939970_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAj8hEuYpuUQ7kNvwGYfakj&_nc_oc=AdrQ1xgh9oMhPuP_HXjOaheDhUn85fr8dh0nsfMW4leGtJcMaHbGZ4K-ow7qsh8eE1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQixtXjJ-5YIbkUJqKmjI1-j4fXj_LQmYA0Zqbrizb6DQ&oe=6B0C6056"}, "display_name": "Bowling Alley", "keywords": ["Bowling"], "long_description": "Step into the ultimate VR bowling experience designed for all skill levels. Whether you're a first-timer or a seasoned player, Bowling Alley delivers smooth, addictive gameplay with realistic physics and immersive environments.\n\n{1440384923952523}\n\n**What\u2019s New:**\n\nSupports Meta Avatars \u2013 your personal avatar is automatically used in the game\n\nExplore and switch between 3 exciting themes:\n- Golden Lanes \u2013 Elegant and classic\n- Cyber Lanes \u2013 Neon-filled and futuristic\n- Jungle Rollers \u2013 Play surrounded by nature\n\n**Key Features:**\n\n- Smooth VR controls for natural aiming and throwing\n- Uses your Meta Avatar to put you in the game (Internet connection required for loading avatars and leaderboard access)\n- Live scoreboard to track and compare your high scores\n- Single-player gameplay\n- High-quality graphics for a lifelike bowling alley feel\n- Easy, Medium, and Hard difficulty levels\n- Reset option to clear scores and start fresh\n- Includes a game manual for quick guidance\n\nHow many strikes can you score in a row? Dive in, challenge yourself, and bring the bowling alley to your VR headset.\n\n**Download now and start playing.**\n", "short_description": "The Bowling Alley game is a realistic platform to enjoy the bowling experience anytime. Feel the bowling adventure and get the thrill of achieving the perfect strike. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonapps.io/bowling-alley/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Moon Technolabs", "support_website_url": null, "website_url": "https://www.moonapps.io/meta-games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null,
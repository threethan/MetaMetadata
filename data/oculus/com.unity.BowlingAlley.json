k0rMiMvYuoCzJKBMa_Ifnk979zVUJrqFdTaEXvJQ8ME1TeXuLgcwV_ABqTRHM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuBnyDPHRk43H_TMtPhBn6mAs4quxxxl-VSGr2wavBZSQ&oe=69985464"}, {"file_name": "2.png", "id": "2074831979711344", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305050_2074831983044677_4714902437768622337_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNb2hSqRkBUQ7kNvwE1C0X6&_nc_oc=AdkoWJd3W8Bsj85IeHi0QGIJ6zYrLfWHLZHtKiZztuVyGoGM_OqsO4vsRtqXpHt1TGo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftqjT7O7zDGTwUrgtaeRDL8VStp_7eD48LKXRrY4YCxhQ&oe=699860D2"}, {"file_name": "3.png", "id": "1149337720368864", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_1149337723702197_7873282700151587164_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugyNaf5iHhAQ7kNvwE_ZdQ3&_nc_oc=AdnO6VOujxJpy-wui7Tnea_btVOTfgFRR5Pz2zVHxL371juyfPrfVUpxGcCsIa2jfdg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsciIoN_42HiV3It9baVRw3LjKRUwtVrz0LroyVKNDZ9Q&oe=6998596D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440_v2 (2).png", "id": "1436105017912754", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820001_1436105021246087_2641205699413939970_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvqwDwcLA_kQ7kNvwHX-BG4&_nc_oc=Adl9osnbG5I7JU_oWxjWseYWSO7BZfNlNgXy_JPmxTuFufeqTclsU1ady5t3FjL9VDc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsr7mHD-gqXZQGOrzxMJv7NvLFmabi59aV7LL8-jOLpbQ&oe=69986116"}, "display_name": "Bowling Alley", "keywords": ["Bowling"], "long_description": "Step into the ultimate VR bowling experience designed for all skill levels. Whether you're a first-timer or a seasoned player, Bowling Alley delivers smooth, addictive gameplay with realistic physics and immersive environments.\n\n{1440384923952523}\n\n**What\u2019s New:**\n\nSupports Meta Avatars \u2013 your personal avatar is automatically used in the game\n\nExplore and switch between 3 exciting themes:\n- Golden Lanes \u2013 Elegant and classic\n- Cyber Lanes \u2013 Neon-filled and futuristic\n- Jungle Rollers \u2013 Play surrounded by nature\n\n**Key Features:**\n\n- Smooth VR controls for natural aiming and throwing\n- Uses your Meta Avatar to put you in the game (Internet connection required for loading avatars and leaderboard access)\n- Live scoreboard to track and compare your high scores\n- Single-player gameplay\n- Easy, Medium, and Hard difficulty levels\n- High-quality graphics for a lifelike bowling alley feel\n- Reset option to clear scores and start fresh\n- Includes a game manual for quick guidance\n\nHow many strikes can you score in a row? Dive in, challenge yourself, and bring the bowling alley to your VR headset.\n\n**Download now and start playing.**\n", "short_description": "The Bowling Alley game is a realistic platform to enjoy the bowling experience anytime. Feel the bowling adventure and get the thrill of achieving the perfect strike. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonapps.xyz/bowling-alley/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Moon Technolabs", "support_website_url": null, "website_url": "https://www.moonapps.io/meta-games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26201157816148487"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://
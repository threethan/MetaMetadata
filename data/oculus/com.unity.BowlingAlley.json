et the thrill of achieving the perfect strike. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonapps.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Moon Technolabs", "support_website_url": null, "website_url": "https://www.moonapps.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8606345966056277"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "674858308973337"}, {"status": "CANCELLED", "id": "2996007027277019"}, {"status": "CANCELLED", "id": "879005578442520"}, {"status": "PUBLISHED", "id": "2327273817695485"}, {"status": "PUBLISHED", "id": "1161848012596899"}, {"status": "PUBLISHED", "id": "1138857031206404"}, {"status": "PUBLISHED", "id": "2549601192081359"}, {"status": "PUBLISHED", "id": "1180948754070464"}, {"status": "PUBLISHED", "id": "738904655424173"}, {"status": "PUBLISHED", "id": "1414617396491950"}, {"status": "PUBLISHED", "id": "2752850914882770"}]}, "baseline_offer": {"id": "674858308973337"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770027360, "status": "PUBLISHED", "id": "674858308973337"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26201090272821908", "version": "4.0"}, "id": "410325635487603", "channel_name": "LIVE"}]}, 
1806610942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-3SQ_gViRkQ7kNvwFIvQr0&_nc_oc=AdqMRYlaiOxClypJHHWVvrZBihZ_yF7ABui-r_wWTLNmaoo4GZLj9azNKDzRQIu2W5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq5HLggTHMSz3Lk7RSPDnqEoxfKAOmdjf5VoFsmDACMg&oe=6AF5D548"}, {"file_name": "nursing_screenshot04.png", "id": "2040515913249064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623131_2040515916582397_9148340038550736746_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygvCqG5PiUsQ7kNvwFtjV3A&_nc_oc=Adpkmqzcf6hZg-bVGwNVBvnlQIHIbj3I-B7VH0h59mMcqqw7A-f5fu2Sj6IgWZDkg0A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcPjRC3PSVdLpjK2Vw6tIoZjyvY7iIuAKmUoSz5BJw6Q&oe=6AF5D106"}, {"file_name": "nursing_screenshot05.png", "id": "2015914662396558", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622186_2015914665729891_6375427673040916370_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OXRW7zc0iMQ7kNvwGuJcba&_nc_oc=AdqOrHerPGXGJZvrh-6OI_ILe1khpc12cM5YwzXFfnO_SxG3Mfzr-Ifq4pJvMJkShbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJiZeklWIRk1MInRjt7RIJ8NgOH4y-2MegDPUZhvhm_w&oe=6AF5C80E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "nursing_coverImage_2560x1440.png", "id": "751224293868148", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_751224297201481_7099546317802772565_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tML-ov7Mi9QQ7kNvwFBvjpB&_nc_oc=AdrCTHQr8XCajGVPA7ExafUOzPD-v-Q5yW1NYVssWU9VSRzTXvv6ZeGMGEuwGveWPfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDC48_pPv_SX9EC8v1t6shePU2sH_0ZCbHQh6uqTtqfg&oe=6AF5EEDB"}, "display_name": "AcroXeR NursingVR", "keywords": [], "long_description": "Training system for medication education\n\u2022   Controller system (order display, object picking, drug mixing, patient administration) \n\u2022   Order (medication order) system \n\u2022   Evaluation system (operation accuracy, time, sequence, drug mix accuracy) \n\u2022   Learning management and analysis system (training results, Excel log export, institutional statistics and reports) \n\u3147 Educational content\n\u2022   Tutorial: Basic VR operation and location-based tutorials \n\u2022   Dosage 1.1 General drug administration \n\u2022   Dosage 1.2 High-risk drug administration \n\u2022   Medication 1.3 Emergency medication administration \n\u2022   CJMM-based semi-emergency scenarios (patient assessment, judgment, intervention, evaluation) \n\u3147 System development\n\u2022   System advancement (UI/UX creation, medication order system, evaluation items) \n\u2022   Divided into two modes (training mode, challenge mode) \n\u2022   Pharmaceutical and medical device random placement system \n\u2022   Medical device (vial, syringe, IV, etc.) label replacement system (brand, capacity, language) \n\u2022   Multilingual system (Korean, Chinese, Japanese, English, Vietnamese, Malay, Spanish, Polish, Thai) \n\u2022   Remote monitoring and group training system (real-time VR monitoring, help request, screen sharing, recording, streaming quality control) \n\u2022   Debriefing system (training log review, instructor questions, LMS integration, learner reflection)", "short_description": "AcroXeR NursingVR education simulator optimized for the nursing medical environment that can enhance practical experience in various cases for hospitals lacking nursing staff dedicated to education."}]}, "developer_name": "Surgical Mind.Inc", "developer_privacy_policy_url": "https://nvr.acroxer.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "unity", "support_website_url": null, "website_url": "https://nursingvr.acroxer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "
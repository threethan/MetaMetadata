UzKNoO8591-Vx33CikHMtCciGYaQ&oe=6B0F1092"}, {"file_name": "nursing_screenshot03.png", "id": "1441318494476251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623512_1441318497809584_7015801641806610942_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Mu6AnVcTPsQ7kNvwErwLZI&_nc_oc=AdpxE0mZx_7PhsBFs0qDPNr3LMzbw0FAlVVHUpsu2TpzvspRgMs94bdOEmCygCMu9l0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXTvx4JUPJgMEqUgz7yTePFEyHuQek8ZbH1FuMO71i2Mw&oe=6B0F1A08"}, {"file_name": "nursing_screenshot04.png", "id": "2040515913249064", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623131_2040515916582397_9148340038550736746_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_GRCtoE43kQ7kNvwF-9XqZ&_nc_oc=AdrWQGjIQ45cU9BjuNHLWAztxDhjkNaNsCR-c1C917ES7XuBAdJ19QJvznMqY4l-UsE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWQ5RdPY-7dJE39mcYwyzS3q3hc1ndoyaryUMrBVCETiA&oe=6B0F15C6"}, {"file_name": "nursing_screenshot05.png", "id": "2015914662396558", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622186_2015914665729891_6375427673040916370_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1cpqFoDCeYQ7kNvwELGo7l&_nc_oc=Adq-20ToMxnEiacwHApjDx0KbK9UyTNbXuGBD9fc5s423HiDFTlS07lkOz3T1Tun_hg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWL_K-O4_mdvycTSCn41qAtmy8NDQuVsOOx4ygyF9UsxQ&oe=6B0F0CCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "nursing_coverImage_2560x1440.png", "id": "751224293868148", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_751224297201481_7099546317802772565_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHnJkk4XvPwQ7kNvwGnRAHl&_nc_oc=Adqhn_gvbl9L-kFVrSUCdsbLoy0BaeFdSQBnEJTNcJYVq7uhC07ezO3nPqof5lkHVKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_8_gSw2uIumxOkwL086k1GGgg7RLtxHqpuu92EJCN_A&oe=6B0EFB5B"}, "display_name": "AcroXeR NursingVR", "keywords": [], "long_description": "Training system for medication education\n\u2022   Controller system (order display, object picking, drug mixing, patient administration) \n\u2022   Order (medication order) system \n\u2022   Evaluation system (operation accuracy, time, sequence, drug mix accuracy) \n\u2022   Learning management and analysis system (training results, Excel log export, institutional statistics and reports) \n\u3147 Educational content\n\u2022   Tutorial: Basic VR operation and location-based tutorials \n\u2022   Dosage 1.1 General drug administration \n\u2022   Dosage 1.2 High-risk drug administration \n\u2022   Medication 1.3 Emergency medication administration \n\u2022   CJMM-based semi-emergency scenarios (patient assessment, judgment, intervention, evaluation) \n\u3147 System development\n\u2022   System advancement (UI/UX creation, medication order system, evaluation items) \n\u2022   Divided into two modes (training mode, challenge mode) \n\u2022   Pharmaceutical and medical device random placement system \n\u2022   Medical device (vial, syringe, IV, etc.) label replacement system (brand, capacity, language) \n\u2022   Multilingual system (Korean, Chinese, Japanese, English, Vietnamese, Malay, Spanish, Polish, Thai) \n\u2022   Remote monitoring and group training system (real-time VR monitoring, help request, screen sharing, recording, streaming quality control) \n\u2022   Debriefing system (training log review, instructor questions, LMS integration, learner reflection)", "short_description": "AcroXeR NursingVR education simulator optimized for the nursing medical environment that can enhance practical experience in various cases for hospitals lacking nursing staff dedicated to education."}]}, "developer_name": "Surgical Mind.Inc", "developer_privacy_policy_url": "https://nvr.acroxer.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "unity", "support_website_url": nul
1806610942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9UErce52icQ7kNvwFwyGzc&_nc_oc=AdqlINeB5KWuOzg9erfYByuxWecw2JVg3o4SZzQpt0cuibzZ5gC4AInhA48DkLIx8BQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMPzS_onTwER28jNbk7IkTq-rT5UNxr7mmxPCt2uBpHw&oe=6AE36048"}, {"file_name": "nursing_screenshot04.png", "id": "2040515913249064", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623131_2040515916582397_9148340038550736746_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6IDgUyCVh8Q7kNvwGBE0oZ&_nc_oc=Adp6-Y6uzFeULkoh7NruE_D-utIlNSA9P-ajQewnb6r44FwXb5b3N3p4Qz-Uex1Cp0E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeymJUVN83m2ybcy4iZzbF9oyVwayqi8HRba0Leny8ig&oe=6AE35C06"}, {"file_name": "nursing_screenshot05.png", "id": "2015914662396558", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622186_2015914665729891_6375427673040916370_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGKi4idvbmwQ7kNvwHhC12f&_nc_oc=Ado5lBENt6apMUiE2rgW7HjTRiZb8NyUvDNJ-Q75qEEeSG82QmMb2CDvvprUeeyOIZI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaSh9aCwf6kET1sNm9EqMS0ycAP-PCvPro4RAQ6-IqtQ&oe=6AE3530E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "nursing_coverImage_2560x1440.png", "id": "751224293868148", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974886_751224297201481_7099546317802772565_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joDQ6YBxO-AQ7kNvwE2AEhs&_nc_oc=Adq_p0kkikGwOSSWP228Tp1vwSNn4EaiVXco18SVjLXdvlBP3Znupfxrr7LEOKQUGdw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFHaiuz4-rUH_4RrITBDYxdZU-gxGPYGoZ6dM8I5rA8g&oe=6AE3419B"}, "display_name": "AcroXeR NursingVR", "keywords": [], "long_description": "Training system for medication education\n\u2022   Controller system (order display, object picking, drug mixing, patient administration) \n\u2022   Order (medication order) system \n\u2022   Evaluation system (operation accuracy, time, sequence, drug mix accuracy) \n\u2022   Learning management and analysis system (training results, Excel log export, institutional statistics and reports) \n\u3147 Educational content\n\u2022   Tutorial: Basic VR operation and location-based tutorials \n\u2022   Dosage 1.1 General drug administration \n\u2022   Dosage 1.2 High-risk drug administration \n\u2022   Medication 1.3 Emergency medication administration \n\u2022   CJMM-based semi-emergency scenarios (patient assessment, judgment, intervention, evaluation) \n\u3147 System development\n\u2022   System advancement (UI/UX creation, medication order system, evaluation items) \n\u2022   Divided into two modes (training mode, challenge mode) \n\u2022   Pharmaceutical and medical device random placement system \n\u2022   Medical device (vial, syringe, IV, etc.) label replacement system (brand, capacity, language) \n\u2022   Multilingual system (Korean, Chinese, Japanese, English, Vietnamese, Malay, Spanish, Polish, Thai) \n\u2022   Remote monitoring and group training system (real-time VR monitoring, help request, screen sharing, recording, streaming quality control) \n\u2022   Debriefing system (training log review, instructor questions, LMS integration, learner reflection)", "short_description": "AcroXeR NursingVR education simulator optimized for the nursing medical environment that can enhance practical experience in various cases for hospitals lacking nursing staff dedicated to education."}]}, "developer_name": "Surgical Mind.Inc", "developer_privacy_policy_url": "https://nvr.acroxer.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "unity", "support_website_url": null, "website_url": "https://nursingvr.acroxer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "
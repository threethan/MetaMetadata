sage 1.2 High-risk drug administration \n  - Medication 1.3 Emergency medication administration \n\u3147 System development\n   - System advancement (UI/UX creation, medication order system, evaluation items)\n   - Divided into two modes (training mode, challenge mode)\n   - Pharmaceutical and medical device random placement system\n   - Ranking system\n   - Medical device (vial, syringe, IV, etc.) sticker replacement system (brand, capacity, language)\n   - Multilingual system (Korean, English, Bednam)\n ", "short_description": "AcroXeR NursingVR education simulator optimized for the nursing medical environment that can enhance practical experience in various cases for hospitals lacking nursing staff dedicated to education."}]}, "developer_name": "Surgical Mind.Inc", "developer_privacy_policy_url": "https://acroxer.com/bbs/content.php?co_id=privacy", "developer_terms_of_service_url": "https://acroxer.com/bbs/content.php?co_id=provision", "publisher_name": "unity", "support_website_url": null, "website_url": "https://nursingvr.acroxer.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "vi", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7736743289691495"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "434886815729270"}]}, "baseline_offer": {"id": "434886815729270"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1720179133, "st
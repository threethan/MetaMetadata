1806610942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-3SQ_gViRkQ7kNvwHb_YLk&_nc_oc=AdqbzzBcoztTwgpMeTvlkKwXggWL2fKgNdYMFwraqdil9hI50atSj7CxcJx-lf6x1qI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLsOFDpOKl2ISwhXXErwFSYTSwZ7JJxJneerjaKJr-4A&oe=6AF87848"}, {"file_name": "nursing_screenshot04.png", "id": "2040515913249064", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623131_2040515916582397_9148340038550736746_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ajk6dGimPuAQ7kNvwGrIoN4&_nc_oc=AdqQqADIrhC7EuQ8QuhT6dgReicR2sm11_FQDv-2gYMrSBBfInRi9R1d2d_v7R0lF6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwfKrStN1eEHOBBoxM_aPirNsninMgDfs_KufKnD29mw&oe=6AF8AC46"}, {"file_name": "nursing_screenshot05.png", "id": "2015914662396558", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622186_2015914665729891_6375427673040916370_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goDfFLBZf0sQ7kNvwEEUBC6&_nc_oc=Adqskn7CGd-5pDiUz_G-TdJAaffSxU3F4fz6nLWZXYe2jPW30zMDjYV6Nh9tNhC3eP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUZ-I5_6cWQecEtdS8gkY95EtBq3Suah6UW0KdQNfH6Q&oe=6AF8A34E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "nursing_coverImage_2560x1440.png", "id": "751224293868148", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_751224297201481_7099546317802772565_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QPmXODq3OwQ7kNvwGLA2QU&_nc_oc=AdrDEHajbjv-3Mjqsr1kHVXLQrJnbUKDe8Xr3UV2hTBsn7Mpb2qs5EXN47PcCVvXJ7k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScBmYOf4kfRXdbEDVn7BR5Eodq9oIG_KSpVN4r5JeBNw&oe=6AF891DB"}, "display_name": "AcroXeR NursingVR", "keywords": [], "long_description": "Training system for medication education\n\u2022   Controller system (order display, object picking, drug mixing, patient administration) \n\u2022   Order (medication order) system \n\u2022   Evaluation system (operation accuracy, time, sequence, drug mix accuracy) \n\u2022   Learning management and analysis system (training results, Excel log export, institutional statistics and reports) \n\u3147 Educational content\n\u2022   Tutorial: Basic VR operation and location-based tutorials \n\u2022   Dosage 1.1 General drug administration \n\u2022   Dosage 1.2 High-risk drug administration \n\u2022   Medication 1.3 Emergency medication administration \n\u2022   CJMM-based semi-emergency scenarios (patient assessment, judgment, intervention, evaluation) \n\u3147 System development\n\u2022   System advancement (UI/UX creation, medication order system, evaluation items) \n\u2022   Divided into two modes (training mode, challenge mode) \n\u2022   Pharmaceutical and medical device random placement system \n\u2022   Medical device (vial, syringe, IV, etc.) label replacement system (brand, capacity, language) \n\u2022   Multilingual system (Korean, Chinese, Japanese, English, Vietnamese, Malay, Spanish, Polish, Thai) \n\u2022   Remote monitoring and group training system (real-time VR monitoring, help request, screen sharing, recording, streaming quality control) \n\u2022   Debriefing system (training log review, instructor questions, LMS integration, learner reflection)", "short_description": "AcroXeR NursingVR education simulator optimized for the nursing medical environment that can enhance practical experience in various cases for hospitals lacking nursing staff dedicated to education."}]}, "developer_name": "Surgical Mind.Inc", "developer_privacy_policy_url": "https://nvr.acroxer.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "unity", "support_website_url": null, "website_url": "https://nursingvr.acroxer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "
1806610942_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7QWs-6tDfwQ7kNvwH9O_Td&_nc_oc=AdqoF3VEIVkAU9cJ8Xuxzzde7lNQw2AaC27QOC1-0bbHmV6Hgt-AufuPxOBhvpeVhxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdiqVZUs7Vo_p4ojuL2DomXrp3R1F9z1-LE1P-yUiIVA&oe=6AD23CC8"}, {"file_name": "nursing_screenshot04.png", "id": "2040515913249064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623131_2040515916582397_9148340038550736746_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e60s_EgFlAsQ7kNvwHEq_zd&_nc_oc=Adr17HvWpsX3pRVXElsZ58Ha-VemU9dzJs52qMPAJEcg5eIBt3C1bpzrOP7bXY9yQNg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIuA3Q09hLrttiRtbdxrMtKTyZJ2l_4Ie4wlynRqPkpA&oe=6AD23886"}, {"file_name": "nursing_screenshot05.png", "id": "2015914662396558", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622186_2015914665729891_6375427673040916370_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZxPQMj-tgMQ7kNvwE11dsR&_nc_oc=AdouvbZA3SNmnSWfhfJdnDZA-B7Fc-wAQjeUDmVpTwWdM_zhuE17-2V-_ep5-X6XSN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL1IIzAtB1Y8ClV7x-1x6O-mqmhU_Ci8zS7UtQA_Pdtg&oe=6AD22F8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "nursing_coverImage_2560x1440.png", "id": "751224293868148", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_751224297201481_7099546317802772565_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69WW2wmAsUsQ7kNvwGyKe9C&_nc_oc=AdqK9gXXPK5xO4A8ltUf5yCcvHWC1DyobLMONpEVPN4hwMVbkl2lreAWUsv0NXuHgsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHqtra7Qt4zOXpgoGeNVIVTzY98JJTW39Q6acwKT95QA&oe=6AD2565B"}, "display_name": "AcroXeR NursingVR", "keywords": [], "long_description": "Training system for medication education\n\u2022   Controller system (order display, object picking, drug mixing, patient administration) \n\u2022   Order (medication order) system \n\u2022   Evaluation system (operation accuracy, time, sequence, drug mix accuracy) \n\u2022   Learning management and analysis system (training results, Excel log export, institutional statistics and reports) \n\u3147 Educational content\n\u2022   Tutorial: Basic VR operation and location-based tutorials \n\u2022   Dosage 1.1 General drug administration \n\u2022   Dosage 1.2 High-risk drug administration \n\u2022   Medication 1.3 Emergency medication administration \n\u2022   CJMM-based semi-emergency scenarios (patient assessment, judgment, intervention, evaluation) \n\u3147 System development\n\u2022   System advancement (UI/UX creation, medication order system, evaluation items) \n\u2022   Divided into two modes (training mode, challenge mode) \n\u2022   Pharmaceutical and medical device random placement system \n\u2022   Medical device (vial, syringe, IV, etc.) label replacement system (brand, capacity, language) \n\u2022   Multilingual system (Korean, Chinese, Japanese, English, Vietnamese, Malay, Spanish, Polish, Thai) \n\u2022   Remote monitoring and group training system (real-time VR monitoring, help request, screen sharing, recording, streaming quality control) \n\u2022   Debriefing system (training log review, instructor questions, LMS integration, learner reflection)", "short_description": "AcroXeR NursingVR education simulator optimized for the nursing medical environment that can enhance practical experience in various cases for hospitals lacking nursing staff dedicated to education."}]}, "developer_name": "Surgical Mind.Inc", "developer_privacy_policy_url": "https://nvr.acroxer.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "unity", "support_website_url": null, "website_url": "https://nursingvr.acroxer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "
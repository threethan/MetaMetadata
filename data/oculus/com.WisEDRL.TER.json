25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mC_HFzeBZMQ7kNvwHn2OZE&_nc_oc=AdqB65FNVW0XljcmkAGSsK9mGj4ObZNCj_m4LQMWJ0LqKdjwbajprWk2O5v5iuE3dQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWQASkJxR4WmSfKQE4uRGyTKLKUy9mb6eewWPG0O12gw&oe=6AAA9B3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpuntRE9n2IQ7kNvwGUfCgW&_nc_oc=AdrPd9hQIeBZVglRzsXeFIIJ4di2GS6iU-OXFwPeK_YRDkOKAKj2E6Wb9qEAJWKMKEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQ7NSNO6Cet11fLRunPDacYlJYWb463Y_3n2sEShAOmw&oe=6AAAB794"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9Wzh0FeYuEQ7kNvwEZqs01&_nc_oc=AdpOqw7Fxrdv7j7r6-lMd730Bcypp87aWOzxk0co2UezfeJhQvBn77cAU7rjE0hN9c8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXkrF00oJAjefJ99c9Dhx-NIEjB9QWRC8Hj5N4BKYOoQ&oe=6AAAADCC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qY2-rKcSX4QQ7kNvwHIWED2&_nc_oc=AdrXRJ8aY4WKk1ZKN4r-HBZ53l0Jkoyk7o0Zm0rYCb7A-WQXhWUI4Psyh69livdeb5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMK037fD7Q7QndS8XSbhJ0xpNBGVNNvGNkqqlmE5zKgg&oe=6AAA94E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sKOZ8CFLuoQ7kNvwFBES-R&_nc_oc=AdqPA3l6QdCjEhCON5-cMR5NocYYrsBfQodotOFKYjfUomL02OfP80LaVGtljV4VSfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXe_LljiXA2cglU3XzthUvk51JVMeaEvmxp-l8uc2o_g&oe=6AAAB81D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
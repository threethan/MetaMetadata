.5771-25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mC_HFzeBZMQ7kNvwFlQs-V&_nc_oc=Adqa8GLUzfFfMQkEofZ6VPX-CGHtSOA7l6tY0KV3yBAXHkLlq2IkgZIsRFXmEZUnT7o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-2KCWtbdFVUG0bhkJjt9ile4Dc53HV6ErTmWaxEIhqg&oe=6AA949BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpuntRE9n2IQ7kNvwErEQPS&_nc_oc=AdpBDwFbt0_TnJAw8FjDSwu5wCaiRXf6l2Wx46XHw7zM7N1W5ZxZHQS7ZY7_HdNNsAo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVuzQInk-L03IVya0SphSbGEXsSt1ordzvNfkv8nydRQ&oe=6AA96614"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9Wzh0FeYuEQ7kNvwFeGdnA&_nc_oc=AdrbEv7MfbiLvMnDCm9F9y72CpsyJZxtJfSnHP_hQnSV-qzSzacwccvPnRXWqEvIqfw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIRu-Woem3SxunAtIE7hggkwx4Ab0xMN6L0vfb7SJe_A&oe=6AA95C4C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qY2-rKcSX4QQ7kNvwE64jda&_nc_oc=AdoknC61Swu4NhbCOhgW0kv_kF-SroBG8FgknSGYsqczt6ppryJbq29zaddQbOL59sY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmfM_hX5fgoEy1PUglWQEQncCi0BEWm-aqnvi4OUvfWw&oe=6AA94360"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFWk1liUN-8Q7kNvwGKAa2w&_nc_oc=Adot9nS8VUd9OiCV7kRPESOoYlFRLw8fD4NfzhIFp92EO1pvji1ywpNs3HbLUT4LbW4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrB8PKPQ2Tv5l0jNtC3mq4X3XbAhkSbTaQSCA-myFXBA&oe=6AA9669D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "269189016
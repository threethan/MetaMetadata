25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxkr2L_u-4QQ7kNvwGW9bUQ&_nc_oc=AdrBpEKNd7Zvp0cWleCXjxYqpljR35tdQRpFxz3X9BwiivDphv3vC_umiHYv2vi0rjY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pyrf2ppyNIxpOwK4KEV0o7mCQX6fMTgv9fP71QjDJTw&oe=6A33F43E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA69JE39YDUQ7kNvwHty3Mg&_nc_oc=AdpiUq5lkf_JuneFjHfvzA6RUnZzHa5PRKyEumRbpsJFHoas9V6OutITpTgQoocd8nA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sQHEC9QCeoAK5yGeh8NM98W1W8dE26lTQitBHWJUnOw&oe=6A341094"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6L4ka7n4bW4Q7kNvwG0Z6XX&_nc_oc=AdrecYp8dlhlvER6hs6RRrVol6ukpRmHgKlTgY8UmkM6F4H9CGM09PMaWRmtYD8lZEI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80jUaehRNTs1uyMWIYdDq2g98hAP87f_P-eW4ZFvpHPw&oe=6A3406CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CtHyZ5WThcQ7kNvwGvQwki&_nc_oc=Ado4XffZSVEmNo-s2H69zRM-7J_ET7AaMVBUHv9PFpKd_iFrG7Tjq_wmgnXc3HldUkM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QCz9Iu4x_nrWmDwG6bAzRjE_Y6xk40_bpiMosUx5ijQ&oe=6A33EDE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFSDsjkqbZEQ7kNvwECtt9J&_nc_oc=AdoxHZmyJuYJ_XZjeW08-hnha3mJa9eiot5upW_tTz-5SQyebGXq2-qwBr81pMyh1PE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91UmDdRY6jPDSZWPtjvDoOIM6VV_Rq3REvMsmLidZyUg&oe=6A34111D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
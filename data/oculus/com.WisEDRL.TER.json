25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYBU6jH-3QQQ7kNvwEkPC2A&_nc_oc=AdpMjA0gTtfjcXFBTzZSW42HO5ee2R7wg-m0MDgaI-Qt8VCRzT-m9KJW0gzu1fzdaMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B98mbVYa3iIZQj4mH1MsYv7a1ae3Joi4o3khliW3Rsw&oe=6A032CBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfYT66M4h1EQ7kNvwHU6Lp-&_nc_oc=AdqtbdAmjJx74KGfwELS5UUbeQ45Ssq_NApU7Sx-rh8y5d-PC6j7ZH8ZWPtjlBanTKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-iPkY9i1nyPUtiYaXw_FN8HPkICtcoidW-peUoSQetQ&oe=6A034914"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXRkvdDJX6gQ7kNvwHbdMew&_nc_oc=AdpPM5-ehS5ihB09uU9nPr47Fyr5aBUmb02up_9mkfMQwJssV4o3zkWiyRXM6GUbsdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EbXKB-JNzowjVEapjPJNAm7U2iiPv-os2fT31-aZNEg&oe=6A033F4C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeKp8FxprZEQ7kNvwFjT7bz&_nc_oc=Ado_jLi6kwXYZKIROtyFk5KAhzVSXS86yUng-Xmw2guNIzbm5v-TVNqyxSfn7G-iHxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hGcVi2aaFQxNQZdndAxFTvUdrWOeLDrm7A_jZEvNYrQ&oe=6A032660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twwPns_c4pcQ7kNvwGcQXWQ&_nc_oc=AdpM3FC5BbC_pvZlaX8o4nnj2NvKPmWuiw6biY4zX3fQgav6Jb-gMXUtG4DZr0WBsH0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pc-bFMCQPTfGYW4-PxSArywjf6pJAKFegBnc1VcVv7g&oe=6A03499D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
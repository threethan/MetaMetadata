aG92r3e-qwkdquq7d8xqLjuys8iqc4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HjKzhUUH3vg5Yr_ORPbvB9aQoeLQJ2obxGDtPOOK_6Q&oe=69F35ABE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUSxEya4htcQ7kNvwElVj9O&_nc_oc=AdrsQj8e5CNvZ3-tZHjo3bJS7jeck8IIU1jNnCtlP1IEVGqkUZZq58qJ9eXg9XVhtpE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3D0poYN--A21Lt4CdlD8LJF46k-ykOp9Ue-YHYCHtgJw&oe=69F37714"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nppOIB5NzacQ7kNvwEUt4BT&_nc_oc=AdoIzFEnZaahFFkyorkdrJkqFQ-_ziLGddC5afoNgj9EixCQ1eNN06owbOUDyviqdJU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3v42KttACrEW9fVC-BmFYunQf0GBWiOktNac074TxBpw&oe=69F36D4C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq9f1Nh6IW0Q7kNvwGqioLd&_nc_oc=Adq4ylAlbAyE4TwOmWY-ylFd7_V4R4ZH5jgLDjvw3O-8BfVcroyFVGemRgbpVonQimw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19TFFq4cUGs0hojDOrzyq8ks9qZxlGMtOudytqSoeCHg&oe=69F35460"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_x_21bH_0EQ7kNvwGA1ul1&_nc_oc=AdoYbQ1mcZcQlShEyKtlblkKWcHfkODtRhI1mIHe5j-dnzC_atgttHR5PKJpd8tFNqw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3LfHiJO8Yu4NtMImox8h8i0Vf6YFfmfxIpHHMo6ai4cA&oe=69F3779D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
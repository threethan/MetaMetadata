fo1KoKcLI7ca_3YXvn8Xb-NKnf9As0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af22xvkh-AP0SHjok5w_4cJq0KYK4mAot1TkhXao8L5TGg&oe=69F4AC3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUSxEya4htcQ7kNvwGLMOK2&_nc_oc=AdqDirkVtTdikGNEexuNuMjBqbfFTR8_USjbI1tFUpdJDsezkGCl_0KlQTgU4piue9Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OFAZwPRoQh3-UbsWRY2c6uxAXOjUEM-695xdYymOZZg&oe=69F4C894"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nppOIB5NzacQ7kNvwFdlYYs&_nc_oc=AdpMZc7gEQvWU1PcLVqE7Q_oBhtyIhf0FCDUwgw9KQ8BEibc0eZ_12GdtCd39HT3AuI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Im2owAUSxAgz5onmAsZH_4gjsrBz27f4EU7tI6THd4w&oe=69F4BECC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq9f1Nh6IW0Q7kNvwHUmYc9&_nc_oc=AdoeKrp_6byZ_wpqa76z4Q-CU8LctbkGDfvLU3eLhP_icFl0KkRJxTIlfYFC5mEkcdo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05rJcNdOC_gANCmapQAPAeY3xni2rVkTJWKkzjI7yZgw&oe=69F4A5E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpypjXIyYPEQ7kNvwHKGNBu&_nc_oc=Adpr2N-yNnQ8T6q9hFWRlTbuDhg8-DPkm1wAr2cjY-CbWfXa9vAsHbySLOG2dDVal2Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1T7isgh06ouDJUy9TsyfCSK9zLfF67SZSM04kSIu-GVQ&oe=69F490DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
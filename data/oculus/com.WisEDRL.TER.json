25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UqHVzG-LYcQ7kNvwEU0Y2W&_nc_oc=Ado73IVtpIl0w1ZnEWbocyXJBffZpMGz0FTlXooVMfhd7s-wbcvBC5xChghmejHTsWk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqg37gZwPA9wDqq32lnuo6a6FKuyCzHuPrsVI_oaTzfQ&oe=6A7F19BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0y1dtVZ9lvEQ7kNvwEq-wow&_nc_oc=Adp0RucPtKyyCCj3td7XIaY2ki4n-aHyR3EB35-PpbivEMgvIoI4PkUMfkr5098ep2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8jo2U0cR7a1tBI3_afmsjUB23vidBsVR-ofEMOV9oOA&oe=6A7EFDD4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FceKRcS3oCQQ7kNvwH8YuUD&_nc_oc=Adp0DrRLKfbfdzrYSb_QpgBYQd62aLuGR1RoQ3eh-wgNfEthdrQupTb7FX01BF3WFG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErpJ05v5lk2FlNhvtK8vZWfeS5APoC2vT3JVaWebswsA&oe=6A7F2C4C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wp7BvpDQHcAQ7kNvwGJwOWa&_nc_oc=Adoz1Qlcy33uCqXpxrguhKMeYe2PTRH91f5-p1aeqQFdPozfxnBzpC8e_fhDPRzFVHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3WcwJAb9nYF5PVJ6vG9QZab3gCA1saEAeye4cfKvBTA&oe=6A7F1360"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_ja_kJtAHgQ7kNvwHmXPrf&_nc_oc=AdrIk47higIJ7dJ84OKN9vNn_N0yEvrD7tzXoOL6zOh1w4OvYyF-dV9UVJEKXE9RDi8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9EdD1beCqHfY1VxH4tYz4kwPcti0nY7R_26ME4eMV8Q&oe=6A7EFE5D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
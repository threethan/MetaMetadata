tqI8Q8EoznY_1gVd6GEBRGG7UH0_y8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIFzpgxzz61qEc4fJFfJHSvxfLKsU3n_Dn7N15nnU49g&oe=69C3E4BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pO7moXLQmL4Q7kNvwE68lVa&_nc_oc=AdoGttCPULFxPb5LxL_fj2rCrdxaZJxcDAAV5xai75iG8_4ll14NEf4IDh0gTkY1fZw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3hUaNek35YqrEj4mcWxn8nxE5qKb0C_HlkQHiPC5stg&oe=69C3C8D4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJnGD6Av34gQ7kNvwH2PCDM&_nc_oc=AdoKkOT_JgPPcYCoRWSgeWdSlCmpWgilqFeDducyr0lMPUJIPRO5eVCLYucxYH1KUew&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxkp8A9EKuPS3sqsXhAX0RqpytmXcV2PPx40h0nCINaGg&oe=69C3BF0C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ESINt-JeWUQ7kNvwEbtERy&_nc_oc=Adp0FMm7qQmhoK-KH3_GHs8jtgDTVimQxA36Ix8Y_7y8UGqrVHiLQnCtUsKx5NnxYwg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyrh5GLqBkwIOrMwi0EVu2OH9mMTXE-5tfj9A6vsXRU8Q&oe=69C3DE60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VdolwUYA9wQ7kNvwEgyJre&_nc_oc=AdqYDWQa_WvbDvVW2rIF2NS2mt_kiHkc2wjd5FE1sEim3ce864U8GcMRHMOPHu5UGrM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcOcRqioAqN4vx7TQKQ6NsdNU60XQB2JoW4efqyRZbIA&oe=69C3C95D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
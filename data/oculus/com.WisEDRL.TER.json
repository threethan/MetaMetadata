2T_x3xy7v3iyRdUtX4wIhdZBzJF1T8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzV2Tco6bx0TwHBojfaZdRpY65FTlAR-0oJQYNSVgsV1w&oe=69D113BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPbTJL9P9EoQ7kNvwEOcpn9&_nc_oc=AdrJQFLlJTpkgaFDpmR9IwGcx5_qzJGjyqpUSgpFjwOl-bJA6IbRkYghNIyPitLgM2c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWyKS20SRIUe4zHD7oo9f7AUguaORAeKES7L0UXSmdtQ&oe=69D0F7D4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzyrdytpU3EQ7kNvwF9_6Ef&_nc_oc=AdovkTjyHWHaVhhFXt8SlMfqsVjGrcQ7tjadWpNkMvLSVhEL-Y-aTvFE4b95K7Ul4JA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwV9ojHdt9nSaRpMrliKoeWKpEozQQheYEFNFhQxs44eQ&oe=69D0EE0C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmE5bOC3ii4Q7kNvwFsRBmf&_nc_oc=AdoBlW3lpzKhge5F73_KzgDebQKGouzi0wSegJrAfaS3RNfpcguVL8Qgx_LNsycwNRs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzChEnmB5DEvoT3VqDHAC-m1e5uX5z-AJRxlsfuNEgYyw&oe=69D10D60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOxNhPj_ZDAQ7kNvwGKN-Zy&_nc_oc=AdqWBmKWXllBYvZDYjff-kTs3UYAFvwIbydgEIOuS_13IHtuppxVsASSOHH_-VdMP04&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrVmba5LxiPisbOxzyp65z5IG-hyyTiilYXudstcugoQ&oe=69D0F85D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
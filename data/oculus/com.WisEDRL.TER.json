25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7D2y29bhe0Q7kNvwFcrahB&_nc_oc=AdqdTdOrHlyTqPVBg4ZF-0LL4nZVY4q-i7z2WrAN8_NBXT2yJtvmg-CVwyvzLqKUEms&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKazZZAIBOJbf9coHHt-TZls6EQHGhycKkfieTyL84dIQ&oe=6ABD103E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxERxdHdR4wQ7kNvwGzhCpx&_nc_oc=Adp-zJ6JFsjYe25pb9TUwE9SZ0h5iqtn2DNoiaziiwzA3lDjqQiPOil3KSRTOgwUvbE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQeen263aTi5q7LZeqL2YrsEcxonYTUDhwX2QvSrZp2w&oe=6ABD2C94"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE0dDdyIbt4Q7kNvwFt9pFL&_nc_oc=AdqYEYLdIrL2nI-AoIgHqjd5Q-UmDkmXK1xPJ105_YNzj_SnuTuTaXYsLS4yR6tLb5A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWxd5CD5qgiqK5f6rCEpJqFi25Dd5cLGx4I0jIY6Dfeg&oe=6ABD22CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_k1VIR06woQ7kNvwGyrhnx&_nc_oc=Adr_Zb9eaoSakG2aLa8R4RgBqO-lFAl3XX5m7skpaYbUaS1pnm2BQXrT6ZTSdSf5RCg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtQot-y8F--FHloc0vNt9cCygmx__aTiOGmFZcJIZ6zg&oe=6ABD09E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpaU60mQyCsQ7kNvwHGh4-H&_nc_oc=AdpFTdm5YXppPsIFWKGZbyEn3bc9jgHcf0nXrkl1GAZbW887AJQzIW-xNoxbiRTEAos&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISyLkC4IdrxbCdRY7SyBxuwFZTbULXd1udmu90JWUCBg&oe=6ABD2D1D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
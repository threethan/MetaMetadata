25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPxbJQLjjZ4Q7kNvwF4PF67&_nc_oc=AdrjbvXAAxh6WGH_MiZAxM6zDd9VBK3ZjiR5l77zMgW1C8VTCTVrOL4a5_HbqXCGKsU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCa3uHeXXVXLOiLg5z63XhWcZgb_yiFcLC5lWS9WMqBA&oe=6ADCB43E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMCmOX2llT8Q7kNvwFm9UJX&_nc_oc=Adp2hv1Ug7-EQ-IllA17sy54LaKjfHsCRWoSaqq6qq6DRQpwYIs79w5ok9KtuASVs1U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjyJcg_dKE2X9QDG2cisboNvdN_Icyg9IcMDoVIshdWw&oe=6ADCD094"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRZpAZS5YnQQ7kNvwEgTLki&_nc_oc=AdokgYEKaVhoS_1RVXQiq0b9vAY614vWtRBjngPBx2PhCbO_cpLUtk1OCz6vUOUQBF0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjbETlop1icpWoCUsq90OWQ9Df-EeKljkih2vwytRvmA&oe=6ADCC6CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnqRAhIb73QQ7kNvwGyXzOw&_nc_oc=Ado0xoiA1MMtGYDJKV00IydSeV7D1tVN9PeYiOtTjfr7GMIL_pmZZaL-J9QJiVffwaQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3n0vQ-PAMRX7-XL4yvGCeAZdzbsRvG1RGlOdBwTKu7A&oe=6ADCADE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk_TDwAtjdYQ7kNvwE8ENTM&_nc_oc=AdrRrtvYJeTfR8F1P8qQ0Ed8AV9CQR3XB-kf2179F8LTamJeDQFdNlbXGRpuGQZUe6w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoXG-BsO6-GQ6daTMaIZhf0zTEWHM0KJ5mj2j5ZRo9JQ&oe=6ADCD11D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
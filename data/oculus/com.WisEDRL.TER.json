_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlxFyOxDIJ0Q7kNvwFQjeCV&_nc_oc=AdmR4dvjuFeDNKdjhC3q182l0xvrM2v4yPwAdJFqvYJ3we4-yTEhI1iq08-GlRWqjqw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsEw5CZl7oFBvzGIWKao1aC6sYpGESEdj1Kz9uTRiJ03A&oe=69A424D4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zErDqeaW4mMQ7kNvwFfws9j&_nc_oc=Adn2K4QtQKVImU4NgmB5sBUlAS6rsbO-65zTCoW15rExWkULo-LSWGEWIDRQBogc5uM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvZnzwJxvlMTEBjG5hlwKBIe_0RvDb9Vt_Qpz0E4tO7yw&oe=69A41B0C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhrPJDQyKKkQ7kNvwG6DhTo&_nc_oc=AdlaGGHbA1bJNu0tZXnMHofELpY6mROkyDu0PaDwPfB5xDqUTQ_1c3NxfMTOZ8w8Jyg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftIHmFxzCS75kFZ_qCSiJXZdDCrGFDiuvzRr3XoeXwOpg&oe=69A43A60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_np_60hwTVkQ7kNvwG8RNLg&_nc_oc=AdkmkA2CUcZ3C8KLywMREXFSSZlov8zz-22N4TsPdYpaRtsFd11SBTb70vGoILAMM04&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsju7sxImIaq1lU4NBszvQWjH8rVABv8ZvPtoZrpDNqSQ&oe=69A4255D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "610525516915798"}}]}, 
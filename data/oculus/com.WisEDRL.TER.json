25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i08iJQv0m1kQ7kNvwGdPdWi&_nc_oc=AdpHskoPaOM5dKsNrNoeDJBqEGpZOo4HnJP4EmU2fRNVmPU7j-ZX2SZmsBygPLSAczU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79Re7M-_hkExTPiZFb3u4-bqx1tNC9x41jr8wRx46PUA&oe=6A1AE7BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFrqOT4ZcxoQ7kNvwHI67HU&_nc_oc=AdqatediH8HWdSG1YYCnUi8mts7TbWhwQtvax9D8NIanNaFf_Opz_AwjFo9BJlaCX7M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ogn2zz3r--TdwhG4BE8XWTY8MiYhV__psiLXT9l3UgQ&oe=6A1B0414"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKBUdHTZQIkQ7kNvwF9BY8-&_nc_oc=AdpgXTYOXs-XHDLXnnA-axkaQvAFoa-Pe_S5g573lCiKkp0oTZHb5kF6pXnJiIHh92I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-_E6AdYB0TCrfD1ixYPykiRgiSJGcdMCnmRu8o4zcbw&oe=6A1AFA4C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpb94dMU4tIQ7kNvwHs1U4p&_nc_oc=Adq-Fc-L-pN4ffahy5wHMxFZguJwBnGsGO26VE2mnT6U0dQ2wkLTrCdvUmgRxKUu5OM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aOo7rj61jyA7HMPyuzfT2rdxus_Ez-kfBZRLtjDkPqA&oe=6A1AE160"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9j7Ts6lK_gQ7kNvwFzT3I8&_nc_oc=AdoaajX60uyXLXoFGau0KEXSvM2thO7R7_vXu68pHqDht_2yhkBgf2wZ8vUTmQJhk2o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mUk0viTvwedyWhrysE6Xd-bu8Kx-Ml4O-tXZjhiRbVA&oe=6A1B049D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
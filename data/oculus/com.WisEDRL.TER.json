mbgzRT_Tl15IebqcZLCIlSqn2vfT0A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nzffQyM1x-qrekX7R-dFQnVNQiDgBdhoUmh4MlJB0gA&oe=6A1C393E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFrqOT4ZcxoQ7kNvwGfdK5y&_nc_oc=Adow5HkIavKllrMDg2yiXUKiFdUT53BYsP_rJ1EhpwKVeHa8_x4ZkRBQq6o2IIKHknA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_sk2qgcom3SHdAuB72BIATp0UvXgl1eFXifeZ8NcCGQ&oe=6A1C5594"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKBUdHTZQIkQ7kNvwEg_kGy&_nc_oc=AdrICEL2drQVn728FfU_ZpRL28M2fwYHoXWh_MNoRMk-6T-G6Q5CLeBts6m62VaSEmg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k3jmGlaHlTH-93L3MMKT8rmIR1e-TLo2WYLL2Hfnj0A&oe=6A1C4BCC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpb94dMU4tIQ7kNvwFG-Y-w&_nc_oc=Adqif2GgMrVl6v7AxSlCSZ3fZUGHxt7rh1w0T5QeQ--hpfQjlEWYHraFRci9xy4tXIY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cSrvpI3Hkb1FQWv1lDEireRrL7dTyxevkyihPjt6f_g&oe=6A1C32E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_iH7g02F4cQ7kNvwEvdSy-&_nc_oc=AdpSQx_DMDRYGMv-y7_Pwd-kzQRlO-XFDGFEC6Laic4-A8EuyCxPyQVLMGH5kU64MR0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wBMsZOBVYQYXB38C6j2Rx8RmZ045hScQnAnmo1cg5hQ&oe=6A1C561D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
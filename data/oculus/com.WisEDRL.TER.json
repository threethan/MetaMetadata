YWqo15K-D8bFG8Pf-JkPtjlc9VkU5t5D2uU2PXoqJpofaDbM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_Cf_wjEEzFrqmDucPTSZPcnUYhPkTj1f20trxOaKorg&oe=6A36973E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrCr4yRjFvsQ7kNvwE_guNj&_nc_oc=Adog3e1wX8Az6Ut1SSP9hINUSNnLPsHWi4lEzrC3K5J4sLZWDk8wDvscNfBbQtdcAU0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-76luDKZUP8kKSd7TMkOuYFHpwgtyJdB_aAo5Kl4iP0Q&oe=6A36B394"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CP_1kSWAO2MQ7kNvwGfDn94&_nc_oc=AdpDdO11jGCeCgt-IrZSPoBOs0hMHQLL23P-4XwguQIx7kW3SHA7Ollc4K4xq1ThMLI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gMJjOsAuMYlLuDXyOlYAjjBT3W0oDwafV_CWJ3_ktSQ&oe=6A36A9CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zR7bF_ZnLFkQ7kNvwH8Lq97&_nc_oc=AdqVepnIchKhwsWZ6WWJrie1dZqHBgLMUeuA--LpjW_wn-eMeED-Y10ll2fv_QOhVVA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DBTA0IMbl1ZuwcVGG8aVpAWYcNOrJE-D04zJ_6IYeYA&oe=6A3690E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFSDsjkqbZEQ7kNvwHh1uKu&_nc_oc=Ado-2Vxsoz42DVjPoLnim49NSlZsgaHBS0hCrPqrss0FqzsNhWZNJI1DtS489BQpSP8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EDYcWGZ9xflPwtKRNw7Wvan2iq9CSn07v-JS1Ny8vOg&oe=6A36B41D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRE
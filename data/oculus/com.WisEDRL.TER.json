25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4J3rTxFu_gQ7kNvwGQsGRM&_nc_oc=Adp0LxsN5xzYqTDN0BUuCB5Fez-vOviMaH2yH5oeBX0jV-BLylR6aEZBxDrSS_YOZ3Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WnEh-GDbVFdttFl53xFle6QINaHSzPXJhu4NNsx0hog&oe=69DA4E3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bk95QThe5tMQ7kNvwFJHOVh&_nc_oc=Adox3FT5Wel9SuVxH5kTyBohnNKB27mLZghBpGGJ-5pbi9StQC3QU3mVD__0RytAFhU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TDJK2nKM-ysewMyRHfrRqvM8BVUA2ILFBpUimjVk_cA&oe=69DA3254"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-I-Vxrm-4ikQ7kNvwGBiVZx&_nc_oc=AdrS6B-VqmiFFJCOD7hoK9rjPr7Hj_fvcQpQhwFaWINcrW7Kqim6YHPt1ectt0nquqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H8hRqyeLPHKZ3sPcqncXzWW9cijpUo4nsG9EfvW-XHw&oe=69DA288C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKEszbfdU-wQ7kNvwF8VxI8&_nc_oc=Adpw9f4BnkWlMdA1BwE9-xO0GFOuWp-riX57XRPAuG5j8VpoJ1Hm5vx9CNKhapYX8XU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XRw6VYvBzTI2dG3a20PXgHLj-mQDGWhKXQofP-wHGwA&oe=69DA47E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhdxSD3mRiUQ7kNvwHaj9Vy&_nc_oc=AdqIJY5GIoMjKzdXa3n18g7ZLaCDqL6IYFjOYxxu82cBGdG6bEltmBMB0P_tidSzooU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OLTYcakxQB815i5Ut_0TwrVUveNN4iwKXvZumPg-50Q&oe=69DA32DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
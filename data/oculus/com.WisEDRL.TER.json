25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzrBf3e9tnkQ7kNvwEdO6vq&_nc_oc=Adoy_T3f4p1kzYgDfygRwxzEpLjiizInlLGJJscUBEl9lNE-yXp43VJ22u42zqUew3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N6V5uFLnWuNG8AaQFUudBMMOgzH_Q7uOT9mTSSb62Bg&oe=6A07213E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUS9t67bQNEQ7kNvwEFbQ3Y&_nc_oc=Adq5rJ4nPi759qTxtdqEqSDq1h7Eqe4ldVAHDtZOEAy_8BGSUAY06YUKYMnhNrBHYb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B6CSxpvjXhhvFLHq79g6765P5XUientCbrYwPjtChiw&oe=6A073D94"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK_Dg2tkBnoQ7kNvwGq7c-_&_nc_oc=Adr7IsK0CZ-GiKg9En8BKqBca5o38W-oEo28606yJ8xqFG0IDhJdEf2ZkNWSb_5Pnjk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jgHiKe0KsEW_gCC_Lyuyn0j_go2kEwKqeMe2xtquz7g&oe=6A0733CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gi4BW02ud1EQ7kNvwGRWmT3&_nc_oc=AdrbdMWs77TDScWsA36A7xq3u1QF9eNuUpU5xZIYjDnqZMbvxFN1qUqhPVqBqRaDXTU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xJ6FSbwnNt8A3CD_5vgNocg3vmnNoY3A-zLeQqqeaMw&oe=6A071AE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX8KYF2tMVYQ7kNvwFcEShN&_nc_oc=AdpHtePtMjGbopSJ1pwUIQKkTk2v2Sr_NMXJg8fMAY9hgD7WkyGXOykvjl7rwEbCYW8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pGMAU-wfrOFH89b44UBCIsHwbWO0eAzGRE9KoAiHiPg&oe=6A073E1D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRoLXr7rD5EQ7kNvwHZhnFu&_nc_oc=Ado6tX2m_07j0w-r9TimOD-o7mb5xzIJDmu8YbLOdhRxN0AV_K6eMrNE5tt8vorl-zA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs4UKSuOWebONb1ODEhGo-8bG-oQbIZY2E268hkmY62Q&oe=6A95BB7E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wu4K1SHjWysQ7kNvwEVrHtO&_nc_oc=AdqIHB0jpXpDxMf3UlghVuoGn9BP7ciplxolM0RnargMV5zgqo6Z9F-G1mRlpFWNwlY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgvenyn34K01bJT-9xe_kJJsdHDYK_lUmM9s4577vL0g&oe=6A95D7D4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xim1JSgHRGEQ7kNvwEX3xLv&_nc_oc=Adrg4haDMs4JXgBqRqkSw5deZ5Q60bfq1ImEX8N4UI_tPoXcCNjB3gONCunF2fVJeL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNLQ-vE4Tm-G05J3ac-HDNoVybNVVVsXtL0ctxRHmTHg&oe=6A95CE0C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZcGJ7PcPnAQ7kNvwF7qn5m&_nc_oc=AdqZ4-NM9dcXb1b4lwQ-JwubJqH_4khdPCCJh2IMbj9LA5E0mAxaYQ9x6kpp3bNANdk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjnt5d8lm7yI6hG_TR7VvoMs-lS2wqQybQ49SOQxi85A&oe=6A95B520"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9X_m8g1Kvw8Q7kNvwF2voRV&_nc_oc=AdroVY882whkF2gCznI3jGkQK0MpD82l2DSLLinAuylmgRBZpUD4W3VWWgqLzSP_O6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH2WUAiYyCA8HUw8eYoOgRr1cvUt6gf3PxsTJ5-Sc-OA&oe=6A95D85D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
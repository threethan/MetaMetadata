9sXAyRRDpX-K3b5RyEabNPOpwuSpqU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaQzzpihzzWWoqissa_cww70WHVlaGTt7ZjUUASRFXrQ&oe=6AEC863E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-0HCAut7DcQ7kNvwFIKOdx&_nc_oc=AdrzWSYVvLjcifl7rBoX0ZIIpuMoJPvSVEzPZN_HXw-XOfSdKqani6Gvn-bAqk0GPp0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_sysbpSdt0UJe4pfBdL7M2O5VQtlYNuIAO8kDqDVBeA&oe=6AECA294"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RbA8zxjzAMQ7kNvwHx5wST&_nc_oc=AdqiT6xmTOKKEDS3yzjBcMLUonhQJrTpTge76ymfEwP0CsYVp4tEFxGoRYCglpGlEc0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWNgID6RODZbZ8n2R2prxjmUwmmA6jMHcI_CthKEmwxQ&oe=6AEC98CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSwWCpwhAc0Q7kNvwE_VcQt&_nc_oc=AdpGbS4n2wEmx0kV-kabHCQfFSr0OcH8ZPeVYwvzczCJnCfVTddafIGIJaQF3Po80Zo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbMNm1fpXhD7eXdoy5a8t-MDRxShSVf_QSiDwFV9-XEA&oe=6AECB820"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFQCepLEDMQQ7kNvwGZzZix&_nc_oc=AdoYrlcJuhCj2nWCAvHGXvU42mlqSfMmGSsLPMQcfTPuEGBUHrI5qimRV-wL39jioWg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkEsVCGg6LaGjomucPQpZGDjnT6p0xkiwK4zkwyds9yw&oe=6AECA31D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
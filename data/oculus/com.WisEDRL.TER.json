25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXgD2221EYwQ7kNvwGFLjhO&_nc_oc=AdoGwGKH-Hor6QhtKFkUDtKGQ_zpm0evO02SAqG0GM-H2O79CzE2UiDhhxYDSUW6S4U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37_wB8Hn7HKdd7EL7YUrifWi6vlTCYJUfloX8XVGLpyQ&oe=69E4DA3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITonnTQ-z9UQ7kNvwG-iGus&_nc_oc=AdoIwmYgP4a_0UGj1RXzFy7Jey4qdIeQbHblo-1h3ijRMA2LTEZ-HSCKKPNMy561ZA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PH6hG-Oc5oOP-Fcb-Q9K2c8EKiueT0L2j6d8sRssqZA&oe=69E4BE54"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-M6H3uyI1IQ7kNvwF_VhUv&_nc_oc=Ado1GHJO4ddH9Kvz91bdxfRIZcGnB-ebOWHHOsadu5o6yNMH2_3f2vqS0JRceuGpNGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uCACG0w9rcSvYz1p2epJKZuFcqqO0rk0dUcLHfeGbdQ&oe=69E4ECCC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFvhz_wrsKoQ7kNvwHLoblp&_nc_oc=AdoEblNYSMVQKtZBslxEDCGwPcIcnpFty-A7ITCBf2lmwsOMTMHnvIUS1Y16EFkV9Js&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UJsXHcYkJK3hpSiTV3J2lCJJmbOk62ALgqv7qru6CqA&oe=69E4D3E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4TSKuuIrKYQ7kNvwEGHKs1&_nc_oc=Adpls1Fc3WEpimBHkkZWUUXrzyyyYCA2rNsNq7K-eNyWqWA8-KzBPZI0a_e6dZc_XJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rsizJn5WHQ6ih5POKxqkaBoA7xxgUn42JsfLxxjfR1A&oe=69E4BEDD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
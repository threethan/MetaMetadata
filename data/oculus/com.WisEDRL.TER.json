jQqhiHanpIQDZ3_sO7I8wVx8JbDsiI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6d1R09eA0GDOYpQhfzCjWFwlhfiNmGEpMtJcaEExQ0cQ&oe=6A0872BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUS9t67bQNEQ7kNvwEg8KCQ&_nc_oc=AdralCRVUTS3k5WjoS_gdImhUz5QM_0XQRoN8T0frT4NlpWa9-62DedU4-dPvHZse_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kQn0nXOWldjHlrfk0Tf8s_h6bZa1-XHT8wf3h2f1Jbg&oe=6A088F14"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK_Dg2tkBnoQ7kNvwGO6yam&_nc_oc=AdqT7uI3CeJBnxc4YZOUMA-HG4raDI2vMMXzG91zsAcUSKlQaUFSHEwuL5SaNyir0Ic&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RGggk7PUjuj55SWnsbchhMqekbglOjFc8bREFoL20Lw&oe=6A08854C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gi4BW02ud1EQ7kNvwFpPsYI&_nc_oc=Adqh_4wH1GZfpT-mVIbnZeNoZHlVk028kEYzRrGZy4R8enfMeBP3ma3k5WcUbPuvlDY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VHVlja_ljdPw726cSb-E9vzwLuFfgcA5qAOaLfCq8bQ&oe=6A086C60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptmBWVNie5wQ7kNvwHfRLkL&_nc_oc=Adpwl0auA2fS_qS9-Bx7zrPJECNKKugXGujiUjy12OBAyYwV9zJzFQJXGbrldvXbgLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47jwJaU_b19SQkR7_s3FTUIRg6Yyr8Iss73cloaMUS-w&oe=6A088F9D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
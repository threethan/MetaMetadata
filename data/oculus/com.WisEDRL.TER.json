25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ-UgnTqqW8Q7kNvwEoDmCk&_nc_oc=Adob78q-jFDuD_i8zlXa4954qxhLrRkW3vJMSqoKUAYdja2XuRBviclt0xn6xwSG4V8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT45IZoJvGdWMP1RRo2OKVzSdkBlA2IMM8xFp56trwcpQ&oe=6AE7403E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21P8awdnCJcQ7kNvwEIqUTe&_nc_oc=Adql0Yh42hvbDRYdm0ZmCYmO3nGlG38XTAxE5aS72UiT4eQjAAcYgtpdq6VfSN7KvQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqyFNGZg9rhMyx8u4MX-togFrhDBzzWfwvSmCnUnwaJA&oe=6AE75C94"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7thAqrnqDEcQ7kNvwF7_nAm&_nc_oc=Adq6OOVyN0fSaW_p_djjS13IxeENZqCAUr5L4E-514jy49TyRjNhhqgeaZMTzKFaAKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZWOxGKoKqwQpK_DfRPvVV9A7uuyGGo2CEs4Ploeem1Q&oe=6AE752CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbRqJryPzpQQ7kNvwH0BUUu&_nc_oc=AdpYQsqLo2PxNSwgVcYdgA1AsOhrUmNQXC9ksjWWVyBIpfH2qpkA1YHKSRoFcY-u4wI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3U799VE60bVVFIldWcRoIGuh9zmDvUHugrzLBNnNZSw&oe=6AE77220"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6N4rUDggIH4Q7kNvwG9AFMC&_nc_oc=AdqeYKM9npCoHfRV6FlVsl70bnNeIqwRLrV5eXKNXUOZ_AVrHiqgbp-zmq6dcUcslFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR73C2PM9qPxXWSM5Tni6M_pvqhqn4BCHjrH9Ts_65iLQ&oe=6AE75D1D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
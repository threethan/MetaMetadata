234K3AQpIjDk6N9D3onhtMpCxTBxAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcDjQME2zA3P_7rjkxCfuU691sojAONslCqKAtlv-CNQ&oe=6AF5C0BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EFirKNUyeoQ7kNvwFrz9wT&_nc_oc=AdqTltz5xjaeZlo1GSF6_AQ8eDGn9Gpn_K6EsiGSUfauIbBQYZDwmw7Pa8EGQ5rhw_Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnH7DDLKeJGDIzqch4AB62iu_SESrkXyIMtoFv40ytoQ&oe=6AF5DD14"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7gfmkBUt0oQ7kNvwE9HJVk&_nc_oc=AdrVf-guv1srNbBN7xoxYiW-5U3t9B0x644XMd35e5VJsNrQFxfSDqH272WaYVjuzQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWzSkcwic3XwD9dGSjpIkpn73KKG4e2jqNWOqPHOjIaA&oe=6AF5D34C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWy1nF19X8MQ7kNvwFElWH4&_nc_oc=AdrK_O-6yBgTuEUKVRoRrTl3cBsAzbrEWdi7lIqgF-Huqx2aOwuAbGmi5BVRkE5c79E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4zAY-6ntevaYwI0xQbZVJYROABebtjge4Pgjwti_oDw&oe=6AF5F2A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TE6-4uuDTAQ7kNvwHDIT0J&_nc_oc=Adq9dapwL9ColSAoR74YG4Iwcq18XMYaUIh6ew4eLKCKuIf5bc_GslxabWHMvLB-0GE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1rRVUx1z-V8AkRTsHLBrZWhHaBjGQnhyl4LmqgsfVaw&oe=6AF5DD9D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
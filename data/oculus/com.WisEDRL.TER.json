771-25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxsVtNZK7roQ7kNvwGzDA1W&_nc_oc=AdqJKZH1mEbIo3ynmpXn3nuxsEXoY-jNVfEKStZTVF1T2S2t9HTaojPzpE9phOXF_Iw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwvdGMCCttc_XcfvTU7sPXq7FC8F16sbtfNw1z-z72Rw&oe=6A8EEBBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW11oI3q-bcQ7kNvwE-PHOr&_nc_oc=AdpIP8p_0q_0Ln82GEOyGM22oo46lYi-fp_I-o2Xyqkzjsl6d7yAYvJcOCemOzd7bAw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN7mk0dHho4Z_w-7knk8x3_-HVAc1mGfTemEAHvrnWbA&oe=6A8ECFD4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhFjVKV4grAQ7kNvwHDqVnl&_nc_oc=AdqgASrTIBnRDiyWp52RxbwFZkR144AKhHmzyxLMuK0MMoPcUOJ3kZ6WJTt1s_DhyRI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHESThgblh0wRgz1SNRBqX2pgrgfSOggYwt3DolHbVBRg&oe=6A8EC60C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CY4cK_npeIQ7kNvwG9YH2H&_nc_oc=AdoSmSFxC8vDa0Dq1_8hIUmR_WiilQqzbc2dDTyRDDL1Zn4juYBdCOmky_g85HJHmG8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBG6KnOSjC379FcDP1ZlT7cqpm_A-HmzeFVlu9dPN5Pg&oe=6A8EE560"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfz9TuhjbR4Q7kNvwH2cNow&_nc_oc=AdqFCGZ9bMnYsu3xC78_rSLXbuBNl-xeigkqxb883zfbglGLwHbC_kfn8RPYKKTx-M4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu-RcbQK2QFCD-0r-fHe0oxLH406bFjpCyUe58mdgGUw&oe=6A8ED05D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460
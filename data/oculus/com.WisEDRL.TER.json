25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EoxmomhlYYQ7kNvwE88b82&_nc_oc=AdpvHlZLEkmkyJpv6hutG2GhgPbJCIEPBpu1wITgbMw2C26nH8dgj-TO5stYtZfX_VU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCu2rL6b6Th0ziB9j2yqT7jBAsJZp84V4rn5lgXE-d8Aw&oe=6A660D3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulUCr-in2uYQ7kNvwGCHZM1&_nc_oc=AdoEDkc947Znv45glXqHwbso_fx6PWSr2-YfO-ddggBdwVJ6TbRYqaxiH-czwzcJsMs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo3r0OHiERb6dsfyui8NGcxNh1p7pr4fX2LeO8lxTo5A&oe=6A65F154"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWyUc8ya9-wQ7kNvwH5vAHP&_nc_oc=AdoYj25p6pRjRpDf7cVrpT-i1ndWAThgtu_qF354T23aERuMBjWz9hBiUQsyg4Voq7o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyrkaIf9GSZf0RFs_j1zZrqFYq8e99ktrUFvRadttmJQ&oe=6A661FCC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afVpP9QR_Z4Q7kNvwHDO7ag&_nc_oc=AdpBTBjXZcfCJNBgbr-wHt8xptEvoYWdHZbxdiNGiMawvU-WgQof3zs2rgta34k92sA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDG-_6WE73DUlC9KgJF2u_ifyz54WExIHfMNi2jggL3Mg&oe=6A6606E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVjZyhbaTfsQ7kNvwH4y7__&_nc_oc=Adr3RtOYmJ7g3AQZXFte5ipE5EpHHDeTRcTIPhBPGLl07yLnHOcJ2qoWrSvG-0vxLk4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_WcGeZRoz7QfB8Z4eEbDtBpSgrBWE1bgaiI4F8Ta0gA&oe=6A65F1DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
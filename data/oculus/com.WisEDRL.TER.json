79231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEO1CzWjYs0Q7kNvwFhEzHO&_nc_oc=Adllvu_RTSZmxuM5RfCAGknhbcL4xAgrtmPDRQpKIMM6JG0wdPeA5Xi_vIWNV555dqU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5KFTR5lt195GUfX6_oOgq55Ii7kqTQJne0fQyF7-2jA&oe=69BE9EBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XU17aYBqN9EQ7kNvwHnnfTj&_nc_oc=Admsb1AILnRBuOxko9y7ekT599o8hNsYjK3vHKMktS7F9WnVTjtT_2WaqdEnX9dcoO4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVlx4YhjXtCWXIAU2VBch_80G7x2w-Q3jB_7hfySBN4w&oe=69BE82D4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-o26lmyzR3YQ7kNvwEjweF-&_nc_oc=AdmSmChafZKVxkU7cXbfudN-P8YtbMOXuIJzsn2MGJIFk1cyaauhUDzOaO6xPAMDzMI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGo1-b5oNgHXQo1EtF39MZAV7EIqY1t3SVRgSxld6sDQ&oe=69BE790C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-qHuW76dtEQ7kNvwHm8MIx&_nc_oc=AdlHHNrrYRivSzPszBL1jzXGc-fcC-0mM6BJxGdqZM2ydTwQoJ8LqiCQWMuJOa59KaQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOZ21lTf2E5tN3hMEfAcfFXjoZ3QSxZT3VjqcW5eexQA&oe=69BE9860"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSwv9b16N0kQ7kNvwGeAWBn&_nc_oc=AdnWKoCN0lAqiy0ZTJj_nBXImzqsGZycFxb8sVk_afsptO7terFpthI3kamHCvae80s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMBo72MGtCxXaZWBsqKiVUPt6-2nCgk-bJJeqxfrxlNg&oe=69BE835D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "gen
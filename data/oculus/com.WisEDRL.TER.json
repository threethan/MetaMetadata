25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7YH8Pa_YMMQ7kNvwF_ZSaa&_nc_oc=AdqpPBk3zVDq6zeurZra11H_E3k9H1XDzJFgt-kBsW7mpGPd_tWhQa7KRyWi3WtYqXs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe2vluhyW-ZA6eNg7Hp2dlTFodWskU2tJ6cE1TtYo3SQ&oe=6A5B813E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNTXZc-mb_8Q7kNvwFLGMyj&_nc_oc=Adp6foQj2OdPaJrGd7sktQrqFISiHttrZ4sue1dNFoOdYgMYNKGjSA2fYTvbVu0mjpc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA7wOZFWvi0VUrHVOY4f9-hJyVV85iyG3SeWQfDWj_rw&oe=6A5B6554"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEoHsVVPgi0Q7kNvwFvWI_m&_nc_oc=AdpIBPdNbVa8OGUkuPxRmFKpHNxhdFJ9zARVs4OMtF5y9ApVD129ScvY9SueAh6FcB8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXdEikntvo7zGus0---CaGk3L2MgiOw7ua1WDeFvIZGA&oe=6A5B93CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0jGPKLadKwQ7kNvwGOjTmn&_nc_oc=AdoedtyB4ZMxsSYnbrl97vqkOF44hFmns9JKKPe27q-YRZaGQREasXvoXFr0CFH-FIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBt6vGVrJvo5eohADW3PlxH901M5sMYgUsFYI6pfmzydg&oe=6A5B7AE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTDhUQtmOIIQ7kNvwEQ51x3&_nc_oc=AdqO7d_yXZwGPTOQEB4Q3zinpi9bK7X6dbm5sc6_EFwS-1N4TmDWgtWOronvP1cL8yw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPnGV6JKrmtTsRJD3ZaJVvO5N0IFLDF9jDvc7xf_Symw&oe=6A5B65DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
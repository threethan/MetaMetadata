25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWlrjlbU5IgQ7kNvwFuUZCM&_nc_oc=AdqCb0CClzCfnb2OoGYoe3KaIfs9ROQ3k5A4SpXTlCrnN1UNCAvH5wnf2NJVyyrtCV4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2IfksP1U4t60Xtu6psGj9kfSufRcysZQ_4SygUY8xTA&oe=6A896D7E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXA3RveKjoEQ7kNvwEdaOv8&_nc_oc=AdrvkPeQksDO5mGx3UXmJSqeFm7Ho-p-PALZEzhESJBq5rdgl6gAjS02lGwerQ5UaLY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErK8u7K9JZGb4oYkWtxrdDhULNAbq1ATnhIX6HgK4uMQ&oe=6A8989D4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pa6M_YxfTAQ7kNvwFZs92W&_nc_oc=AdpFt2aARFn7ge0vy6PWu0m06MhxrdSV0PZwyBDZMDrN5WmWKq-mzsUgkqHUCWXckBw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG7vduR0kKVMlVN6MmEDY3T_fGjUssjE9lWv3MwZQOwg&oe=6A89800C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYCD2jAog0YQ7kNvwHDC0vh&_nc_oc=AdqXBBZbpulcQEctYR_SRXxKOZUK4T6XFP7_Fn5yRMGITcGKXani6BsI65QbnTSdqGo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqEvZbbJZDGRk_dvNMJ3F3zx9ngKK_-RnGhmZ6kNeKSA&oe=6A899F60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gznyeA1HfXUQ7kNvwH6FPHN&_nc_oc=AdpYrkDio9fyPh4PWRleWOZTs45yXezfF9qp2EfW1rUxsgKF_zTmRmr3O6R5sQpcPgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvfvBc6bTzv01DgfsKtK4Vc6W1xVmdc9-bKV57jdFRsg&oe=6A898A5D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
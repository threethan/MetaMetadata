vFaB85QdXHp1TqTQsoZJTd8epHeH-k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdCWwwxLGsRWUdGpU8upYONKFlw_2RUd-cGYM9gnTtwQ&oe=6A903D3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW11oI3q-bcQ7kNvwGhaYzQ&_nc_oc=AdoTySY6PumAgkBEhlvSZFM8tnZIC79rMojeIK2FG2LZEpuXWp8vTaHpo3Ofi5M2HU4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvC2QFetjCYObnqL-e-e0BO4_NyPFLhuZNCQfmc_hX6w&oe=6A902154"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPPwu-7ge-kQ7kNvwH7XI3H&_nc_oc=Adrnd8SY5xAKqJuMB0Iy4TvoTY4l8g5UWVgPLALMVeOBf2ISIrfatrTee8_T9dkShQA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjIOq_maatU5kW0uVqw5Uuz7DH399LYINcugeEejNlVQ&oe=6A90178C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tybwwDj0I18Q7kNvwG_NBfw&_nc_oc=AdpaiRjWc6he3Nt3Vx69LaUxJCSnW4AmMj77IK7EVj4X0-meb9Fzx3gkUW6fCaGMopI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEYSilFGQsjkrVYOpYu6R0lIQ_CZz-Ie1o-7-A2va4pA&oe=6A9036E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfz9TuhjbR4Q7kNvwFof5qp&_nc_oc=AdoKLBcMdATAkthv76Y-UCUmHQ9R3wFBk9Huiz6Wa-dCFpC_vndq6X_k3jMz_xlPqj8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA11DkzJNvPsabO3DclsJmSR_FQZ-RuTZr9D_zwrPDAA&oe=6A9021DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
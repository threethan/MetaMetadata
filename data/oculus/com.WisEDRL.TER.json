25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUfLzCcyR5YQ7kNvwEW2Oq-&_nc_oc=AdpB96Ea8CyEbUUbbZiIOlHNGyLxIZX-kP8pjlORONTRYVd2svkd-qUqyWttUUzM0CY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhc_j3t5HPuoSTc6bPKG-56sUVb8SnB6-fv1U0ERtwSA&oe=6A81BCBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGuEZkZXvSgQ7kNvwEqBnzn&_nc_oc=AdqaN3Vh_-R08-Qx05gh2IdurYxWgHsoYDl8YL4FEiNmEj4zxDZHxO6JCSEVd81IAUE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEunb3XDc5hyiCFSp9ZYCTaQCxAK928QIxman-mgPv9g&oe=6A81A0D4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k78_S1A4c8wQ7kNvwGGOeDh&_nc_oc=AdrnLPL2KrjGGPabL1CAIBpiYtszYAYTbIquvb2eUy_gX2Fl946DVOqMdfDqd34cjf0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTSRM1qTyV8yUXu_zWoeWTCnQQHzeZd5N-MqZH-4dmTw&oe=6A81970C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiChlt6nGKsQ7kNvwE3vj4k&_nc_oc=AdraiRRAVLB0aUO9XYOeOq4OipkLYjpwDbqYp2RiykaMxdF0DwFWt3-9BSKPs4bebag&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB-ZGZQcjpEszs_6fTYz17v2hgMvn8VT02hlbdwttJvA&oe=6A81B660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_ja_kJtAHgQ7kNvwGUM6je&_nc_oc=Adrc2edh59pb2SRZEQ2LHpTYKugP9ARaG6PoJrQfn4jhCTG3y59AG7IKYbiiNEtVqRk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU3EsUdAgArCFCYbLnNZ3wdBcZrPXvDsKDrmo19x-nrA&oe=6A81A15D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
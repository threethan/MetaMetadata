i_jh6m_9mvn7TseRrFwhEHbL3Y4QAc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDIJtk1FIsaYpW2kNosvRmUdM-JQRk4mkaZ7cfMk4GXg&oe=6A881BFE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iBfeE06TFMQ7kNvwF4tsLI&_nc_oc=Adr52IUBYea34JKQHU50qGxLueIyFxvK8kfTOFqiv9Cl_4klcjSIw1kxeqSBJanerV4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErdZy75hA2dlFdmXRgnYEqM2ThTvkRfntj-Bz3fV5BgQ&oe=6A883854"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pa6M_YxfTAQ7kNvwEW_5hQ&_nc_oc=AdqvJAlaDDy3Af_GaVhRPfFoOKqz_7TZWu3PhKk3CvUAxuOn-3sBm8VozqozUzYyHhI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHNQ0U5twavTOlDRmXdvh8Uim__21-GXYyI41vgkkfMw&oe=6A882E8C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYCD2jAog0YQ7kNvwH4X1Ge&_nc_oc=AdopcQBz2owlwkmzIJxcb-z8lZtS0u-nLaGbuWrbrGPxX4f95k7TcSeK1IxGDD72GOk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb20_Ulbp5PTxtt8u-O5uQfJczHczCuFOyK9KnMxTn8A&oe=6A884DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gznyeA1HfXUQ7kNvwHrAmsX&_nc_oc=AdqQTyUjdHwq0ZV9SS5FHr5h15kA5QVn81op7fcc8-Jaav8yqly-jB8W2CqYn7VEt0U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWkzt0ruUOa-HCFfahC70Xb0bRzIAOA8OWv2C72We8HQ&oe=6A8838DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
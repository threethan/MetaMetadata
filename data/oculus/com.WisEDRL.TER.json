25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLpERExWOWMQ7kNvwHJ7GU_&_nc_oc=AdqfWthLRi5rdcyhH465aiULSK49SclBSJBIvyV5XC_u7JIbsmuRMupgQt_y6yFuJvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5zTbyDJFAgaTp0b_tdxjoYqyr-E5gWVileGWeT2ivZw&oe=6A9EBDBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWR624TvCtkQ7kNvwHuovl-&_nc_oc=Adr49raiOnOIJIf0Y4bTh49XR7Pd1loRY6MlxJLmmx4kDFS43leVkO4T6MO1qu1R0R0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxlb37FEMtL43NfDyoZchqGcZWftnXDTsA1JUizQUWeQ&oe=6A9EDA14"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uRGImh6uKMQ7kNvwH4Mml4&_nc_oc=AdraVT515eOZKshvda52c2cH_MFixEeCMHqyhJsDktC_Sdxpq6ICV85MaaGo1PlpWDg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmUYRlmUO0TAadFs10bx9R5RsY8m1-cKCR2N79Djv4VQ&oe=6A9ED04C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q88pIrfxtnUQ7kNvwGlRZRE&_nc_oc=Adpz8AhW8QqZyr7-Hz0VARndV23GMm3yCqVQ7wOZA33IL4KgCVBRd0fS2GBeiRceUVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYPRiHsAF0Up1ZvBZBghyg2MPbsOaDwu11QUJahQln_w&oe=6A9EB760"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkedyJYaRWoQ7kNvwG774Uj&_nc_oc=Adp9pjH0IVBd-4vtCICUocj0UmlHYglNwkYJTuFvgNYpTReT4kZQlV3V0rIFtHHhyOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH76gVcF8gZBParrPp7yZa88Iad5p7whp6w03_-T34pA&oe=6A9EDA9D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
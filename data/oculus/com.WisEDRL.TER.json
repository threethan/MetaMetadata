79231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN_w51mC8EIQ7kNvwG8EwIi&_nc_oc=Admt7AcLmuKlpTB21ag_z1Uc9u9tGyRdtzLvd_MPj2jj45Wmr_fqG4Th-quMP5m6aCs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHQ8gQq2fLxc-bAvlU9kNN4J4AD0AbLow-9F_A_iQQQA&oe=69BD4D3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XU17aYBqN9EQ7kNvwGBKqDG&_nc_oc=AdkSiiF3MK61ebJLyqgp3RD4FoJ0KQCvumdMr484YfcXvxKPJb4-L2WQohCJeNd23WM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-1mqIcfLXR0kxDVoGDlDx-4YOPwtfhmoGm24mFnJsHg&oe=69BD3154"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cthlaRh48PQQ7kNvwHwzohV&_nc_oc=Adm2aHJvPNSVO50lu9qtwEhYuov4LVx9X6a-Eriodms1Q0urHHAlf-ONN9AUEapTLbM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_rE3WFnj6EeLmFiE1KoVVQuobOMZhJOyQ5OA31CR-dQ&oe=69BD5FCC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQFSMkJ0btsQ7kNvwHYip9D&_nc_oc=AdktGZvGDk4bSaZzI7rvXsWdrWkHS0S-FiwcHU2bUjC-Hrld7MLLRsNJvjuiirIPpZI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwi590MZ8qtL8b1qGiU7M0HC0Zh-RhsA_IUWWiJ5p4iwQ&oe=69BD46E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSwv9b16N0kQ7kNvwEQ-Kkm&_nc_oc=Adn7wbRCx68m3p7Bf3vqeK9D8PDOecUkpkfDOrjFzSP9iOi760vwxG2pJlqmr9KOulA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwE_5e-V3Nbomoiw6kJi-SOV9BjuoXwc6TBItrYt78vGQ&oe=69BD31DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "gen
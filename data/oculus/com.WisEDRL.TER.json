25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnIk5E1uYi8Q7kNvwFAmoms&_nc_oc=Adot2YX_eNpRu5PFIyOp0EZrFGhDsPeSgdF7FJvzlBRuCBr4Tzi1NJicVbp4QGOUb9c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBQqQP1h2fEvbVGroZ60BXWPFTE5TDhIFSbEjYUhrhXw&oe=6A92A7FE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpvSHfAjcU0Q7kNvwFgGSzn&_nc_oc=AdpDteOCJxIVog1BNxhLeaFCbtK9tbDFzyUi1XKilb0SMb_2I6in8JDwBn6OV3EwNV4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVav8Z7CJqWq4jsJnUT5yzoansuDHvtC5RlB_p3WwBag&oe=6A92C454"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPPwu-7ge-kQ7kNvwEAWOU9&_nc_oc=Adp_DGs19U9EdMrhiyVJkyEuCDFR6SdgEU_swriL02HATaft-XxgGrRjsI_NGPrDp34&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5OhHiCp5J_P8XyHclx02xnjKraUp0P8I3cxwcsTSEdw&oe=6A92BA8C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tybwwDj0I18Q7kNvwFcCpkB&_nc_oc=AdpN1pY1gVSwDJyPfy_Tk3a4O3A9Myz9CGPF8Hi3_X2vjmIwZKeC_i-D4cQWSZqfN-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4Srp3fZROz4lb-mxuNzSUdaplZBaSJ-pM_ffWWq4HEg&oe=6A92D9E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9X_m8g1Kvw8Q7kNvwEtnspp&_nc_oc=AdokuefJTG0g4kcPd-yq_FxmN8BNDKqZChYcQqTK3vHCXUgxUbL2xHrM-KIBQiUMJXs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY0IObD-vS1kIryqTx7fvigETJE1DFpqy-xo0sqHRN8Q&oe=6A92C4DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
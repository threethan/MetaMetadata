9_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zK6J-booBMoQ7kNvwGIlusk&_nc_oc=AdmQmXRee8_Qy3CKhjQScMa5gL4jVYYCZV-ujfwdXoJ5Du6ReceGAsqzB7ETHfCr9H8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfxsS74gkkZ6qWJwZ2fHXsSrJFzAW9llMULmKIyAQv3D8Q&oe=69AAD83E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pbfHG6Ok9YQ7kNvwH3kVdn&_nc_oc=AdmZBsiNaIcBgLdE2jsjRhprSw6sZYJ46OSfDoWVakLjOac034KSfPKkQQ8RKIopX64&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwuNPURMjnHEyJlDFveaZY4_rfqdnZA5axWEXDbZowEQ&oe=69AABC54"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B063s_yKimYQ7kNvwHTUeGP&_nc_oc=AdlU6YhjN2Q7Kebd59NHKsaZXCIc736R0DSbgbN5rPfClvFIsf9VyUCKHq1eQWDeAbM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSTFi8nWvZaia6x9rIV5-BlBofw4ZByO6C2si74g25fQ&oe=69AAB28C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vf_lHbMYCH0Q7kNvwHXHJQi&_nc_oc=AdmsfXpGnimCvAK7c4JS2Fkc_qjEnk5o5veiTCWbqQwe-TVx7_p6w5CfMG7j4v5PTEQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afy7ElZvAumiiVyVW7lIqI5xAFvZJgV1QJViCRdPmso-rA&oe=69AAD1E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oe5CC4CdrF4Q7kNvwFplqRv&_nc_oc=AdkxpwLo4eeQnV5xj1Vg7tbT68Fkk2r9xI_F2KGN3m-VYsYm2DsPnDDjS_3gmsIaROw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfzfLWuvb8WnGVkpY0UtdVOQu3cZENT3BaAXyLezsYqWSA&oe=69AABCDD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUI
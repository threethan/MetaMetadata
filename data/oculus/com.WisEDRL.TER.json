25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsPtFreq2K4Q7kNvwGLt2vy&_nc_oc=AdrlfFKZYfi9HIA1pPOGoMFK6xk_auLXfe0K7btwBQEvyQxnHRb5nlLHHNJlTf-0KRw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cNVl9jqmVJOYJJkz5_138Ci3x7dN3sQOFDM4HUjSyBw&oe=69D7AB3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bk95QThe5tMQ7kNvwE3a5HA&_nc_oc=AdqJt2knWyTeq7ouYg1DcFf1nxzyeRH_620CVlyNVgXEnFTKpm9UA1_CGOu86XMDUng&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VPs2IOXeDLWyCdM3YX3DZsvYGJS6QwmMbG7N_xcUpEw&oe=69D78F54"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEQq2D3lK-EQ7kNvwHqmPmr&_nc_oc=AdrM9KfUilpLiLdWH4Sch4hA6gmerxOmh3ZCWvg04kE2IyfxYYV2ndYTmf2lDyAkQMQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zBGOMbQ9hDBQ4DmUpSIdju2a5EePhMGTR7kjIPah6_Q&oe=69D7BDCC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6438EModqwQ7kNvwE0gkAr&_nc_oc=AdqPfnSQWKlaGtcHJGuq3VOhZf-cHEI4SL4Cm60Gd8S8tDkXRYy2kH5MhZc62xgB1Mc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZN-7kBgsuy0LFDpG2Q2UfypyjvToYuRpdEIufE9W8rw&oe=69D7A4E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jplFMzfm9-kQ7kNvwFF2BFl&_nc_oc=AdomBxv_N4VrOwHbtWEl0C3jNNjkRXluTTBJcdFr2X0Ns_eT-BNbiSXaYzbK6LfK_6o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qNV3D8OvGlyiR_eEsnadDpxwTM9bBkLCxS6tnHsAMJA&oe=69D78FDD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
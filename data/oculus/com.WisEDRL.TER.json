771-25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzJJ3QtiDBwQ7kNvwFb4lcW&_nc_oc=Adq96_8dkCuG9KpU7b7oDa7j-eZcbpM0BoPFm3D-nAVDYbu-ad1Q9VdH4KK1b5Y70Q8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoswL_xJ_HyYdg2vy1jMC6ZsOYhiLjSwm-I12KjlJ5Ig&oe=6A8578FE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iBfeE06TFMQ7kNvwG-5-B2&_nc_oc=AdpwcUSrqYxBrrKuDRnKCr162GNSw9unZRF_A9S7_lzfFgHrZGwDqyy6JALqzMhtwzE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLTjPXw1WQ_d97ZiaFifwkAYKLrLzv7W_9NMHgTbDgtA&oe=6A859554"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdAs4GnnipEQ7kNvwFwCUxp&_nc_oc=AdqFNlfFeVziNr9kz50rDluQsH81X8UWTv4tCMw4mCxhZJHAqXOyIPAhXY8D2wzp23E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTOeJX1TKGBH9689PfSqw2nkVrXBGRrl_iI0mvV5xTAw&oe=6A858B8C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pBGnd592nsQ7kNvwGQEIVf&_nc_oc=AdphhvAD9DFr141BlEhZ2SyVc52vQuPpomk7GowonnuQAo0t_OZ5vsC34ejfUPMddUI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN8EacGYPyGLOJbIJkWCKWkc1TgegZU5j7feqFvyct4g&oe=6A85AAE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ltr3g6MzPcQ7kNvwHG0wxg&_nc_oc=AdpDq5RsJZTQ65a89m7a2DfI3hlnLH8Pz4H8MtMLM9aSYeSjg6SPSKvPiXLX0hBaObs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFadA0Yibf_x1xPk-Z742t_hwC2lju5L32JBersP8aOFQ&oe=6A8595DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460
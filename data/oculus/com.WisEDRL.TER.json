25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6gS6OA5H34Q7kNvwEiQIaR&_nc_oc=AdqgWiol0ZRZlQb6iSnz1RdFdYdFDMxPMPDlXUlvT8iXGzAETJ3TaLia53zhwwFkFJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp_A1ccbQDaC31dyxM2B7nrhaH8mzxk2eXqaofLLLGQA&oe=6A7B253E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toCpOtu4bNwQ7kNvwHxtv_V&_nc_oc=Ado9oqV4hwzZpgQjQ6pCHkoL4gSm8avrScgDqLZf5icPwnRSVxesjQ-z5PcymsGiRvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFGJVbm0LGN7sQ0yVQW7pJxFldf3pK75luZcI1HMCGjg&oe=6A7B0954"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5c-bAmF6rwoQ7kNvwGFUAr8&_nc_oc=Adq9OidMpqIXa6NHcSih2s4SnaSEVmwlG3sVzf3t8N2PGsbuwiNJ-ireqmG8UlmhvmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFz_n5-mb832gBozoFpI7cCM6nfl8CVo1fkZe7XaiGH9Q&oe=6A7B37CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOwqhy9ectgQ7kNvwEZQ5Dy&_nc_oc=Adr6M80GFKMxFI5j_kdlWG1HCHAmE9rWSvAUWiY6wHGLVp3f_S3Uox8Aku1cr4V7wB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELUf57DOhSopVSSLVkR4DvCau25fRGb8PB8ZNlTsuoug&oe=6A7B1EE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh906ibMzxAQ7kNvwEgoFHm&_nc_oc=Adr06PA7p0sCvbrB20zizI-471reZkqFBcNL7eYJISBlMRth9_o2h8tojDWgLPRv3EM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh4BljuyZlWQwFeNjCuu6O6OPwy42AVIW_MODJKVSU2g&oe=6A7B09DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
G4UQ7kNvwFpsQwT&_nc_oc=AdqNLjyDT1WWIWRm0kgzWqcQVNZ7ihQjb3IS8Rd_-KVR_raSiQEIWZTJBVayXqspzpE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2vU8TCCApZzwLgsGU6GB-Pb3d4YPheaXkbYaORlmI-Jg&oe=69F0B7BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKy7tHHrrngQ7kNvwH39f97&_nc_oc=AdrLd8NOz4hnvp8E1cPt7WDFbmx4k8WwLTj6qg5qFortIjV7-aYSMAaZTSgWbDYO2ts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0L3M2IP872Xae8ou-ruVoWIV09FowXJoAQ8EG68HvF0g&oe=69F09BD4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yC6RdUYWVWYQ7kNvwE85Zm9&_nc_oc=AdocFAGgTc4bkMgd2wP5F0RaU611wfhfJCi2V_CxvWee0prp_YUcvgnjI_u6ZsRz-JM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1LgFsQqea5IbS4IcjlQTOm420JHHKZauIq9nKlRWZsMw&oe=69F0CA4C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI_Zaea4pngQ7kNvwEdT3nQ&_nc_oc=AdpRHidp_86vlGe3rfnpul2oQilQF3Q4JN1xqQ_RSMw7Glv_nH_dvHSYgnMBNtcrHpM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0zXYfTQy-5j976iT1LMtg5vxixuUBVXKgiabKvV3kIVQ&oe=69F0B160"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_x_21bH_0EQ7kNvwG6r15W&_nc_oc=Ado5xEau5854MzRrXscywSHg5c7vOgf1CHbusy3_5b6vL5qj-gOHIAsvtQkO45ykj1M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3CTClBY4hINhR3BtMRdgYKaVfZIgRL6ANoRb18G8vo0A&oe=69F09C5D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT"
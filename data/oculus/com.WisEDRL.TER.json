25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQwSuZo-6DoQ7kNvwFNrc9y&_nc_oc=AdqBkOv_RQUS_9JKgF-0ZQ7VGJFtyWdqAEJntfPgHle_hjPML7l4etCUgKqRHIvbbaE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H_zyADMhIlwE-RVFk7y5oOfPjjiVCP-C3kPyhx5Ya8Q&oe=69FB43BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2TB62FR6QIQ7kNvwGZ29RM&_nc_oc=AdqEVcdEoESuyRUrTZTy8Yp4ju93n5uxFB1OfZi-XA_uGVX6AI4QKwQ8jk3cHNdQW8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5htyNO15VEoMUN5VZsqePhlMAzYJQ_8TIHysHBcUdc1Q&oe=69FB27D4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQDHcJ21768Q7kNvwHfbzTR&_nc_oc=AdpeJG85jl0HJh9rY7HhfT62lHAuzOhD8HuQ3NQv4taR7T_YW0myhABy-gfRiA1qQAA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jK_jbzUytpDJiWdfFY_6VrmAgVNdhiYbtTrBbEduKjA&oe=69FB564C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G7Mdf6OhwYQ7kNvwFlGDY6&_nc_oc=AdowQmCKso3XATgd7jsGp0rtmVmTWop-L9Pjdl92JC-OInYeZTR9azaArxTKb_QPPkY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_OlBIXnHQBQmDROGtxJPM8ZzorC_QlSN3dP0BQOgOaQ&oe=69FB3D60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2AFxC6q1lsQ7kNvwFl7g3_&_nc_oc=AdqumJsFDLsVxbDeEnUj65rB6o7KpEhVDN1kHkrNzJIz3noMGr7au686dd5j72fnuDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P2eTBLr51A7kzTDX8j3uNbu-AAQcuFiyzUC-75MC_IA&oe=69FB285D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
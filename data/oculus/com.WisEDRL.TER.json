25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0jQMTSZLd4Q7kNvwFsG6Jw&_nc_oc=AdoNdu0TfOfYCYyiaSbWb4pA7mg8Cgx0CW8g7zCdKKOCVHtf3T1m7-3yLLdYgs6Ibok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWbPp_jhk6GoVbdRWwQ7LjtdbeNMcqKQCfkEXYWxVj9g&oe=6A5E243E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okKr2uIIy-sQ7kNvwGxzZPv&_nc_oc=AdqJOmeve_1DyqXnGqd_3ayu2O4jnXW9LbrEw5RC9e2XexUCvzFFIBmknSAKtUrsUEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7CM9dJ0GOxe8l2aRZcpAhFfMkvePZWaXWOUQJ5R_q5w&oe=6A5E0854"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYI5ZRr9KZkQ7kNvwFkbHPF&_nc_oc=AdoD_PKEWFa51clALYv_x6A6RNepKo-c56a1TfAuKX2Djh85dI-KO5Az-xFm3KagK3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4BsW1xwng920C-zC0c3jhMHoIm_gVehVof1E_2uJt7A&oe=6A5E36CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBeWXj5u-8UQ7kNvwG7ig7p&_nc_oc=Ado6xJdkzbmjBdMkKjnVG_xASir5j9rSByixemB9Helqj6Bq-JMHkWeTlIHd5t9UJoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF5EnAbMO4cWYYs1QyvWB-iMFeGlr7hPYYtY2lxvS6ig&oe=6A5E1DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTDhUQtmOIIQ7kNvwHK6AJq&_nc_oc=AdqaP0sbOBb8hmGzXbwfkAc2NqQdwLrxB5YnMz9mFxutjSeyOWxWazS5ePRyeH2SQAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWdSds3feMRUmtjk9zRUMceeogcpFDwKgP3fQKBAGevw&oe=6A5E08DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
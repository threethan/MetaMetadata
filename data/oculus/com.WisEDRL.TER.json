_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZmLx4iX9PcQ7kNvwGDfQcG&_nc_oc=AdmwmbwdAEiZaw0vrRugcsqgmKPTCBek8QhLZNpgj5NzomQVgU2Asd0JyVnOEsxaz10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftzyUJs61jgtvwZ-bp03L9iOFQwQD-V-eeGamfCZpsZ7g&oe=699AEA54"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeXVGA-hxokQ7kNvwGPo0XY&_nc_oc=AdkUQR4p9vBf0qIQ_UlNqxfD-GpMNo_73OHDQfh7WpT_Pe7p8o37KNJuHzHSfMHQwFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuz9gkFuRX-NRy5ZIOzq_yA8L-KmKsm96AtGdXVfytnhw&oe=699AE08C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih8Mo4GK7a0Q7kNvwEcyf9n&_nc_oc=AdkIxWpOZsd5_xWvzeplZpYPrng-JKdCStvkB6uoA3Y57ypA7hfBGw66LorMI8StxZ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afti-wdZ93BhCAoQ7hGxoC_v3vf291C_dXt3c_5R5xUJDw&oe=699AFFE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXwzweUgL-AQ7kNvwH1IF-v&_nc_oc=AdlmKe9mXyoNuI5Ffz5vnjFsVNEtJq5D2uPfsp9iqojbiCWcmMTciwAwabZkusS10ZU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvBjy0cw5Q9UGT0yPYY07FaNui5Umil2ogjDnZjqFtNXA&oe=699AEADD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "610525516915798"}}]}, 
mAu74XuFaLgXD4epSsQ_GsQgzPgS2w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af510x0zA9OyDYHkraMxxT0Vvjbk6GMlqt7MUhyfk8DwtQ&oe=6A15A1BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yEUdIplrnsQ7kNvwGIYqme&_nc_oc=AdpkEZNatkL1IIsaJOKdRaqzhOlB-slfxbqw2tBh_iVyPcqJZxbVsOHg9UtWswPvtvc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bxHwbbOxwiQ_1VFSbgbJoa760tFdYMHpFS8hb-k6evA&oe=6A15BE14"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRrbr01ep-4Q7kNvwGoHqjm&_nc_oc=AdrBe6qcMFWSmXo2a7JeK_2TrL_oHEZixjqpall9jT7yTpYwGFt4J5xpq6OvbmjX7Oc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TaUgqA7Wv3XWL7-xbgHloALHAnJ_g1pCRTcJiPc1Dtg&oe=6A15B44C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqFtmGRT_EQQ7kNvwGX81j1&_nc_oc=Ados9D0TIliqU2clVoOTVZj39iicV8jS5yj6DhCLBC0wXyk26LaIJnTM3T19FXa9plg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64tbMh86uwIUFNPUci1w-2SmoCAs4-CYFqYyit8XuZJQ&oe=6A159B60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G23-n-E26TgQ7kNvwFdqctA&_nc_oc=AdqTX6hO7Z_Buemzk4aNmowhnabCyktDCyUm41plsoFvfvhE-BPNeVOrfDBvbjqYYWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kFPrvvWBWY21mTYnWT3djAgpugvyPwco8sJzXRRHnbA&oe=6A15BE9D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
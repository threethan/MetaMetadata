25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7YH8Pa_YMMQ7kNvwESJame&_nc_oc=AdqHVFemyKzZioleY3BKTRot3uYazRR1kvtmgElkdUAq8_UIgg-CcgVUWdVfu_QbtIc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmn_joP2UWnKWRvx3bokEhwX7uq2DFdUsHQ5L53z7VQw&oe=6A58DE3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6C5sDl0sooQ7kNvwESp7xs&_nc_oc=AdqQK53Fd7WC_B7m8HH8RVbzYdUJfJEBWC1D9muU6jEMExkaFIbh5N6C60RxV8MmF9s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtBang5TQgujYNeUHxt8smPXsr6BF70OGr8c4BhVYr2Q&oe=6A58C254"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEoHsVVPgi0Q7kNvwH0-DyA&_nc_oc=Adqb3regtDqmy2vuEuiSfWNmIFtg8wrdVgcrfUZJcnCGVp31_jjkQPJWniuP7drSwEA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5smD89TivBsKhATl3ce2Y_z5ZxztUjap2LWAt5md96A&oe=6A58F0CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0jGPKLadKwQ7kNvwHr3bmn&_nc_oc=Adprc8Mxfu06t3TrLe8lZZh7EQGPVdcJYPUYubXIdRmiq-75nD08y4JwqsErtoikLHc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvSsndtOipv_jcHsRv13ns01YZEhL7ZGEh8BECb72gPA&oe=6A58D7E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukRph09sRNQQ7kNvwHpONVK&_nc_oc=AdoA5x3DzVE3uj4dnThqOBRxzVusaH6ox1lEToFB0oc2Gk5Gtc7juejKWAmuiOTUiCM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdu4lOzYGZzrqBVCT16o6HQeL7MGENHFmIRuMX4W0Ppg&oe=6A58C2DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
.5771-25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVC9ysemo0sQ7kNvwFKTWWd&_nc_oc=AdqE2hcmfhI8AAkiFBNJXtrqiEy8e6KMMJ8a3Tt4LVlvm9KJhkK0cC8ZUECYxz0yyAg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxlJ19xw1VcjUiScLSVEJ2o5a33qjic2_rLJqEbE373g&oe=6AA403BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psNZu_dnHC0Q7kNvwHkTism&_nc_oc=AdqySWouT1CIvYoZJe4m2ZsxOn0VUlauzMpTmZu_TmyLjp7s-pvOExOFnUpb50MDLtc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYBuuXKWaNXG68L7vTDuK24DLWdegNAyEahe1oT-bEFg&oe=6AA42014"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dg31QooO8EEQ7kNvwG4QvSa&_nc_oc=AdqMvJFVrsWc-of0uKyz2rph-AMGncEus-nBuQ1_GvPrbdwXOpY_ctDco5YwZBsGwgk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDcIkJ521xjZQsqJ9RIlGXr2B0VZrlUOCCXBNe4bVMrQ&oe=6AA4164C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoztvLSX5MMQ7kNvwEP1lCE&_nc_oc=AdpQuF6ua-fxj3eV6RdjOcZDl-fbBeOtoao_AkL_NbzpLCJDQhW2pBW6mm5JY5mF8Pw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg_co-jcuYuj_WXqnNDbiZxcc6X-iHj7Bdx14D0xzexw&oe=6AA3FD60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbvx_ZXmKeoQ7kNvwE7si6r&_nc_oc=Adrvmhm2PVjHT5kmk2I-6qTsI8ngKQAoJjUyl1VIoTDN2jBOAe46p9yTngTvqJW3mO4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkUwwdAtLqAAgJmLwsIBpAoe_LTRFg_kg7IfkSpt2EVA&oe=6AA4209D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "269189016
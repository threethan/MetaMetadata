pFvLwaiWv7m9f_7lVUaEhJAZCCIo4U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVnVcu6-xhuPd84Y4DW9aoB87V8cewShVAnhwLRPyJ1w&oe=6A918EBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpvSHfAjcU0Q7kNvwFfq00A&_nc_oc=Adr7fl1KM-secFbw1E9cy-Xcs44AVOewh87iSWZT5Bs8nSh3HTvLIvYh3_Rk0NKolcg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2bCnNsK-3QO_kBauFiIHwMod40tiIaJowTUCrZ1nXyg&oe=6A9172D4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPPwu-7ge-kQ7kNvwGvS717&_nc_oc=AdrQnegwl5TTE-Po_shFkzuor0fXx8mB7oOP2tjBHL2EzKGtBk3-ulbLi92_UGzhaHA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsCcv04RHp0IxI2O-QZKWOcT8w9W5Q57pIG0u9_W7LzQ&oe=6A91690C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tybwwDj0I18Q7kNvwGuXVJ8&_nc_oc=AdrtC1WwwemSC1X26xMdJsboEBp8BDsFAL9DXOH3oKG7kFKJgu9TrVdVMorznOA4Neo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHredBTInVf1cQiyrktWHyce_mXpEhZtE0mcqvJuiHcBw&oe=6A918860"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfz9TuhjbR4Q7kNvwFXJ8kv&_nc_oc=AdoUetBwMtNQSdCD-NmV3Y1gFxT6hLgeYTJ3zj8qcRxhdnx_GAAaWPdtuFWa5RybNA0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0kAt-exLNjDTTz-v4NLcC7KM2blvdHGpG6HSHuBp4kA&oe=6A91735D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
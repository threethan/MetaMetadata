25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns_MBBotzOYQ7kNvwHb9Dx_&_nc_oc=AdqNv2MciTDyxr93T7o6wavdndmvKd4TYF73gV2pGbdz4IB2paH5IT1_B0tWbv03who&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxrc9WLs_jx7rqN0A-IZDBCtygwDIyLiNm_4dZdtJDfdg&oe=69C687BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pO7moXLQmL4Q7kNvwEtK1TM&_nc_oc=Adp9D_0tSAhlAoS4_9nUWQzBMfIKrZEvYEVedqgT989PQR9yt6OH4FJ9PySB-MNlNFw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxrhgngctc5SthnFN-xDwPH7xAVf20yVc3_ph8i6yFR_g&oe=69C66BD4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGfHVSrIsd8Q7kNvwGh97yN&_nc_oc=Ado7epkNVk3GrR3TDlpFSVkKCaP-YBwfLfmc-Ij5qxVAh5nfHv1Dkan1mPY1_15U3hM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzWlzOrPTP2ipodcdeM9ZYQMYolaQ1SmW0JSiIAHYTnw&oe=69C6620C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsNdqwe06IUQ7kNvwGBqm_N&_nc_oc=AdruoZKFSC21txlAoutVmYItpaaOOQ8YaIhHKiK1rUijmb6RExhE5XmDzcC-YnNuORk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8y9l7L72MD4nkDa0v1CvFKgfwsvlw6Xw9PsztWmdZIQ&oe=69C68160"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asKsbFDsltAQ7kNvwHXI4IR&_nc_oc=AdptmYi4j165BTs3iuBr-N6KN0tsIv4mJG9ZjOHxeVx-55kBmjBl6BtuLXcyOF36alg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOAD9NJVPQZuAwg0wtt28cBx-lyx3Az8HyzRHV85JL8g&oe=69C66C5D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mC_HFzeBZMQ7kNvwG0sAOt&_nc_oc=AdpymCrH9NB2UAaQ8o2N0xFMHncmjxUE-Z9MWklNNYDAUEYue2eOOxt9T5N4OifT8v4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0YrTJBnoc2d_Ox6crz7N6r8yD89WcCdLEi7H17Zgr2g&oe=6AA7F83E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGvB4It7wJ4Q7kNvwHPmcN9&_nc_oc=AdqZLLnPpu5aB9bGV2QmqaNSoZxTXtH_IAqv0l29QzLQ08_nIPanYZ0Pa7iXjB_7i2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJmz-dn0lW-mWrvMpKgSW-TGkgFHyMIf0fJhT8-B2QYA&oe=6AA81494"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9Wzh0FeYuEQ7kNvwEOGLcF&_nc_oc=AdoKQQivkwfPInbMGK-z3YR694dqpH8tawf45n5z4olhsujyQPRyzm5nUlFAfLv5I6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-ZoMh64GQDyJTzzfZzBco7PHWiqBjOPwetMBl4p2Hgg&oe=6AA80ACC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qY2-rKcSX4QQ7kNvwGnlvhx&_nc_oc=AdrnLfSYLsC2I4Rms-diCNpJgZVeyGheWnuhIF13elDwoTzEQhcj2PctKdY0bj0MX-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWMFQ41_K0emKBEtvDfz84mIu_N4-pXYsaM3rFIqulqQ&oe=6AA7F1E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFWk1liUN-8Q7kNvwF74jNn&_nc_oc=AdqQgx6AjcF5c22qQhP_o6Ked0UjuXXIjeV16HjQEA64fTZ_gWx3SRNSZdxaWF5h6eE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIcBp6jn_u-rH6tQDLoRrvaC7jHyRjGTPnDF2arJ4Pzw&oe=6AA8151D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
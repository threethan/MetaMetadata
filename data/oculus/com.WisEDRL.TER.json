9XIufI2kTg4iEkno0l0n5A285TywHg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FNZ7sRhIoO-_0n-lBWuDe1E3_AX0XJEAixfja51ZhlA&oe=6A105BBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-piY2y32X0Q7kNvwG2XDyu&_nc_oc=AdoUvdz1ta3yWomqT6u0W_UwplmAlxLAVnvNEib4JVvqJaSIRv1ErEfmBnrFL8v2Seo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jU2BHDpOSBV35hQmXk0p70WZfQ1DkcJfYpyUK5-5kRg&oe=6A107814"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Brnw_471xsQ7kNvwFZ3zIf&_nc_oc=AdqIP6bEZsTSPJsGQAJimk6LPbayF_v0Ab_qn0lkbpX90H1TS6Ap3FR8Men_YBp8B70&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o8gHi1BeY5_vyCCMF_LkZpVhrIwYp_NRIKjbywFoBEg&oe=6A106E4C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6D_-YNll58Q7kNvwEFw8sT&_nc_oc=Adqv8R95wHNuuUmBwowNFyckdMCb1hA-793e10KsLzKS8kIDWBxVngJlh7CJTi6SLTY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Li2UEj-Q4I5nooib_Zw-00NdLBkxcRYFDB6eIXRYTng&oe=6A105560"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZp8TpO22bIQ7kNvwGhiM0u&_nc_oc=AdoFECezGyS0MjAK5GNjHfgK3IKe8yOPALVyVSN8ayMKU6pEE2bgVGR9f8YXueOWaj4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uMCn-i6TUzPjGPkRUtx19AGIdNypv5kCm509DlJDr7A&oe=6A10789D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
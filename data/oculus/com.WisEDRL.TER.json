gT5Bt8wr6Spfhu1TJT8_gMCR9WjFSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwNSRAAbEngPVOjjSMf2wW0bFklJgW4uAhOJ294HAowg&oe=6ACB90BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9D34mVuOZ78Q7kNvwGG-MJf&_nc_oc=AdraSL8EpoY2BjKfrrqs71IE0umWB5nqZ9hO1qWWFdwtpXl1-bNvaCDWJiJlQ_LPBMY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGjIfVciq9WBEpX4Sxdm2_LGgeKMaaSk8_0uhx2GxfYw&oe=6ACBAD14"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wccpM8-EbOcQ7kNvwEE9YpV&_nc_oc=AdqrxI4YgSKamN8JTfQ1ej_ZOc_DEsXOSklOI91KdrBG416kTIVjgGYCzI9rLkbPvzw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX7DtMl-AmqXQl8zmSwCVbDgA-0e9PG57TbP9xiJlIdg&oe=6ACBA34C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwrv69Zf6KgQ7kNvwEjehGn&_nc_oc=Adp2j3qijEEmYF6_JVBxwLbZqRhkbIqu9Ih9A7P1B2FYyVqOaN52cdxBWc9ymnmsu00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-E8fZVfmuOxWEKYdqkNZKnaSKdEk5Y0V1FwGPKCuC4w&oe=6ACBC2A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JwcAW8YQcEQ7kNvwE54oOf&_nc_oc=AdpeZq-RDxSlQsSeHIBtBezdrAobJP9EUvSVbR2q93UE7AccffT3HyweJZvhVS3nKh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9-TGaWPm0VMnk82IO113FXPjWJbheadZ1m5csgVE3uQ&oe=6ACBAD9D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
79231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6qXR6Q_k5EQ7kNvwGNAXHb&_nc_oc=AdmLbfi25x95prEpNT7iNlm99CEHAEMh5BGMQDhBMKNUMie3PNtwab8dW7r9SeKztAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy32ImcM1DMimm0Avq3IM48n1hnznoQ5tRZoXDrmNmlDA&oe=69B8073E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_l_vY49bnIQ7kNvwEFNvAt&_nc_oc=Adk-mtq71Q8KNx_2prDnRppwlOGlo8hm5Un75GsJ9yKDaLV90dfkOdq5LPgSqYvpAHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwgNgWf-CsRgIIzbG-qb_kgdz9Mu-kZ7R1u0xwpnH_qZw&oe=69B7EB54"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0VWXyFbx0sQ7kNvwHi_m__&_nc_oc=AdlSx7VjWo0GzggkroenB_-2BkFJ4tVOIToq8Ofxit_3WbmgfWDzT1DgA4f9IdJtCwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxxQG_L2RC-YgHS8XZniFJ6gbHWuk1xlCuU79qnb_owFg&oe=69B7E18C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMkYdsI3QS4Q7kNvwGMVu6V&_nc_oc=Adk6crc5ad6-wKYcxl7nH6ZUWN1U6M2sCk4ur_PJSY2YwEm7o_LwBsn76zoSQSt1NW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzIaNOaH1wUMfCuzUFgm7OViBhLUITaLpDYJiWatpeFyg&oe=69B800E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riZQX6t7nJ4Q7kNvwEPQsuD&_nc_oc=AdmH0VFQTbYJwwOXB5oHmKDnpOOGH9ol_oQgZnMxe4mYTxeX-ZV0lhB3_pNihKk-5ks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzekdw7Gl4ct8j76WYFtnS9IW0uvB3rcM49jzoga7_jZA&oe=69B7EBDD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "gen
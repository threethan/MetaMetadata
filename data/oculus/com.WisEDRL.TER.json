25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUfLzCcyR5YQ7kNvwG_h6JU&_nc_oc=AdrCXpKH1YI7JSMzUbSwTN6jC9fDLA-J8_4PC-RaTgdbJWUJn7W5jgR8g1tpuggspTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG54f2N5A5t2cVMzQfLsNlELhZ8Bn88_KH_XwRm53BcHA&oe=6A830E3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGuEZkZXvSgQ7kNvwHgwS2R&_nc_oc=Adp2gg_EcO4NweVHcxlPg9RBVg9-WMPGvPyqHo1Ad1BOO83VhId5bWbHcYqQaRjM2XE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsbk7G1_e6T9HTgoM-8ORPb8CEguMmTavqktMJW1wItw&oe=6A82F254"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k78_S1A4c8wQ7kNvwEwxxWQ&_nc_oc=Adoz2njh_KCOyZLYIg42PX8JfUC4Z8pIbi4rVCsJjh92TEfTuuB2cHCbzqeQwvvCDPc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWaSCBdNTZlBSE5c329SrEA3R__fPQNufPoOVoLuFMmQ&oe=6A82E88C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiChlt6nGKsQ7kNvwGGaoO9&_nc_oc=AdrHn9yFeRzYqr6pjeyQiycNPgwRpDzrxDaWNtG4BaTndPY1KyM4ZGRpn37H2r_dTlo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTWk79U-y3Aek5FVwdRJ20Fk4RpDFoLb37jkjIU4N5qQ&oe=6A8307E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ltr3g6MzPcQ7kNvwEHMjcX&_nc_oc=AdqGjA3BNGXVoEKREgv9wVanQgDlyjuIogBIfSW7zlFHsvThCBFhB76G3a3F6n5-Tnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-G9OpQXmqbcmGyHwWRYAb-OX65OopRgTAZukukg45wQ&oe=6A82F2DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
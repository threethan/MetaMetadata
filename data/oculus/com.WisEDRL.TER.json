25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYBU6jH-3QQQ7kNvwHUwKj2&_nc_oc=AdrpgpbS2Ig98e7HWWxghfU8BedZTv8g8X7S-pPaJBz2w-JAA6smJxg_dn75ERs39u0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Xv4ftz-ZSdTXQi53XlVrr-oR6hqO0Bg4rX6Hbg1YfAA&oe=6A047E3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfYT66M4h1EQ7kNvwHtcgk-&_nc_oc=Adq8QDELOcmOvC83DPIj7HQ1yuH6GyFK9pTqvXRCvNSYCosr5CgFz2oq1D9eqfaqjao&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ztgSk13IpxGjqJHpWvk6F2sTqj2m9wGj3rHl5Hz8ItA&oe=6A049A94"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXRkvdDJX6gQ7kNvwHhUfLN&_nc_oc=Adqk46vp0U2W1XdJSwURGJBEpooLPnxI0cABTYTZpROnbdcqgN9-feB9Fx6Pnc9dbis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yvPBMZtCe-Re2Gk95kd1V05eWhBZXaIwzEm1rHkIvWg&oe=6A0490CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeKp8FxprZEQ7kNvwF7_2C3&_nc_oc=Adru9lt5qDaF8JlZgnwqUMdehXgJOVV5m041TPbCwBbewwEkNZHaQxAKRdZ2zJm-vCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e86K9MDyS7bjxxUInIDvtV8GA3pIZ2zWrns9sh99QbQ&oe=6A0477E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX8KYF2tMVYQ7kNvwF17D4V&_nc_oc=AdpG4kyFKiNdChm8MdPbs_c4Q46byAwwxgSRlrZA6OsKCgrhNv5Nu_lJocPHblHamMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vUB6PcfHvNVcgr4X81GR5j8JhhddjcqVyAzKXsAp6yw&oe=6A0462DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
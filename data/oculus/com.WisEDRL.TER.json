25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAxVY3L04L4Q7kNvwFhornC&_nc_oc=AdqCAykSaJd7Fq400bfwbJl_iDVy-m1PJ1OXLrBODcJXoLPsQrVbULUrtrTv-Y7hfMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJr0OSFrWqVi_3CxC9qBbE3JBP334j3yv9-RCDpi9AvA&oe=6A70993E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sfxs0T5ZOZ0Q7kNvwFia2M4&_nc_oc=Adoje8cdkjhF8DBnBn6xp6LImECajmlG23AYvIOPJZXvDzecJaNHSVr0sNY-1y3o9KM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjDjeYXTNY--ZKxLSUWkDs53z5oObtjhKB1IMoPoyJQw&oe=6A707D54"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkO88nqMqUQQ7kNvwFy4wo7&_nc_oc=AdoCMUf6OBMT5vaHgL-LKJZIBJO6wOUF0SD_6AZUFKz2uvQ0j2V4W0BvvtOi17ivmbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFjWVivJgafXuVzJ5YvkvXHRorpg_hN-yJNMlmdRsnvA&oe=6A70738C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZB9vjlEBb4Q7kNvwEKK8zX&_nc_oc=AdqwZoGV6e7K56yf3VcJhLxpgrD2_1ESK_YzRiv7PuL51fyiHcrTA1U2VG6Wl7V9dL4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5FR0u_aaBlX1-fcjK15lkwgi_abIPUx8PcJHiLqduSQ&oe=6A7092E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp1UiYEwhSIQ7kNvwH5L4Lp&_nc_oc=AdogTtGlbL3neH6KPjtQn5v4I6bHkTGUwyX6jVLfb743YcLxbiAO0TUv-fQp2vr17x4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyq11pEUQIjMFZzRV8a9vva9fSCUCdH-1o0JlHEqPt8g&oe=6A707DDD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
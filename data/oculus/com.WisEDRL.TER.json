25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsFC1dL7DaIQ7kNvwHbk0Nw&_nc_oc=Adp0T5isCTmoUyz-KOKHSAgTZf1KHR_t3KFnLSm5qJ0NEWlo_gd7AyKrcVl5wDa6CsI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTK2nCqnj1hA-aiATUAauwH9VwhBdpSxcVbSGUfg2gnQ&oe=6ABA6D3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDuYeVb0IH8Q7kNvwFQGymP&_nc_oc=AdrhRiBz1zupixs9ap49fZt9Z_OPLTq_dXxF_360ZaWLjoneBrkm_-HU-0nXiem-DNs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT_MEeeWWWJn3vyTf8OXybrBWprbdzl3FN-xn34LGL_A&oe=6ABA8994"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaQ6jSvbX2oQ7kNvwFx-WtZ&_nc_oc=AdqwNFxmyebUDGVsPbG6iOzsBNkX1H385JGmMBOouGdjUZqMNGQFj2OZjMsCcx8MlcY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL43DQqtBkT_x2T9XUt7vzI1i5_7oBvu6UnoyHZ5NG6Zw&oe=6ABA7FCC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZpFCy-oU9gQ7kNvwHH51nX&_nc_oc=Adpey12FrDrPKBNvteENxaf6KW1EDjIXmRKB3bpBhnsQ8ViTplecTY5ei20Kfa6kx9w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLF-dNFEae9JLw5FvEMIxAwXpJITbmq8Y6dDAVaS4gW_A&oe=6ABA66E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpaU60mQyCsQ7kNvwEdDTW-&_nc_oc=AdqlNQEpeWcNZPKcMRefH9yOUUVml2NX71lH01im7-bLyeuIsFEalmS7dDwCXVfjLBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwEmRWsPqptTlzB5c7QwehF3iZxWjt6cG81fnThP020A&oe=6ABA8A1D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
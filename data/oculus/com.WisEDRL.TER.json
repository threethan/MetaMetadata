jRa0AzXmYka_NRxPMA8-mjThij-2cw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGot4mVH_bmHgxp6KhEWCut2-fw3lIL4a-QpF2pw7ryQ&oe=6AA5553E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGvB4It7wJ4Q7kNvwFrXbf0&_nc_oc=AdoIynLJc5BFFNxnWU20rabann4TEdfnRDO-8UorHTcfkcQR6EhUrstKcJGngyPeAL4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7WZIfkhuxjt2tz4NnnvXNDuvRkUnhC8IPnBXxlUJIZg&oe=6AA57194"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dg31QooO8EEQ7kNvwF60ydo&_nc_oc=AdqZHYHEw2IH6yYAaTFEJZRWkiwCFMIXd7PD-w6FARqHH3ookbHJDDwRnCGiAhf6OnA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0XTnkxiIDjBet9xPLlmpQRTeiMkk-CO_BM_RbJhi9Gw&oe=6AA567CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoztvLSX5MMQ7kNvwGk34Xj&_nc_oc=AdpRQIbTkMw2inD9xbZe68nmJJ4y4xdB8AoFCbKdEYVBjZVejAB1ewpT__1P05DX_s4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-_7rVn8Z5ph8q9tx8bpSYQ6LMxfLBvtSrDVpGpx1lCw&oe=6AA54EE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbvx_ZXmKeoQ7kNvwG2nHmB&_nc_oc=AdrHTyMcZRSBIaP8gLPyC3y4BC8IDxZGsBfURNS43owUeBxzzx_fD7qoBvUuz8gk4rg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL60g-Ouze0cj-w7Ulet8fy9HbJpmiwWAC1FKxIebg_yw&oe=6AA5721D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
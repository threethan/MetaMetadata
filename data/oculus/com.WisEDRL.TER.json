25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwdiW_Y_ltEQ7kNvwHP9iNH&_nc_oc=Adrj4537mo0DWup1MO_FHVQh-rc2r7GiVOEbJOdPgqT2F5d0J7uQMyya5CVOKQafbG4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr4vSXNiBcTDc9q1TEMt2yPqcsPfy9pvQcEiA86uNe_g&oe=6AABECBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpuntRE9n2IQ7kNvwF3izWv&_nc_oc=AdrvKy_4MdjIZXB-FYgYBY2ER_0Axrml5_6TWvgHv8NkLWUujdAxNH7QohWbH5r5rs8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0O8UoK1csBuAtMzmdZETyWd0L0qkm5bbLuUaDOIALnA&oe=6AAC0914"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfD93lk5PHcQ7kNvwGvrTTI&_nc_oc=AdrUzs1Frqtkbr5hKRmFJ-H29lyMTS2kfY53MlbG0FeYGFllMbtQgzIm2tI4F708Pk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsyS3EP57ewQY__rITQCV2KBEmt8FHsZchjnlLRDQuQw&oe=6AABFF4C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggFJAdSLYy4Q7kNvwEiL10c&_nc_oc=AdqMXfhPvsOAYAVMkR0IbY07XFZ-MUjf_It2H6foZlwAnLkK_AspPh291_E3wCMBwK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpHZWLWx0jpIFrDkHWYrXzVV6PF-xguvpzSmzv0Ls1Ww&oe=6AABE660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sKOZ8CFLuoQ7kNvwF6dS9A&_nc_oc=AdqaqxuNHlutKcWT1b3FSJaotVw2vBQJ3F77YRjc4Go_Y2c72C7IwvJ7rZmD2AcbCh8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1Vz76wiJc0A03qk32tSoBFowEg3TaxvpJhvh8jN4C1g&oe=6AAC099D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNE79d0BTZMQ7kNvwFmT6VI&_nc_oc=Adrkza5ESnxHstqRW2EL1i2Sc5N_PKJCe7XwCl0DLs01zzqcndV4gJ2FSxESeED8uaE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50ffvql6rFaX75xMuGmmOOmlRy9hkF7uDtVGerLA7SXA&oe=6A0B15BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mkatN04eyUQ7kNvwHopAl_&_nc_oc=AdpSkFyZ5K6-fYhyFm6IzdYNEsDjTcqiYuZi0XDLPlPQLUVxvm3tmFEMcRCWHTNizg8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BdwMlNYEO3XPb5EXWbzV2nKi2vb4AeMSwTIQG8OfY9w&oe=6A0B3214"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNgW-tFKsGQQ7kNvwHa4PLm&_nc_oc=Adqst123W5mxkKBWneFYkuvCMvbbzwfYoxFDuWhNa4ac2-g0zPglapTysiaiQC3m-dY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sRoe6-wvKvFKrE5wmfh1VuSLawTjdhh2x2Yc1WAcd5A&oe=6A0B284C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwoDmT3EGXAQ7kNvwFZ9dKI&_nc_oc=AdomCi76ykN6pceBBCpJIwi1nTmTyH_vIribiuVPq_6RRsTIgsThipjpIfk7yeCD7sE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ARc4F8VRYYb_QrVkrRYJX9VVUh805s87EOABhPV7QNg&oe=6A0B0F60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptmBWVNie5wQ7kNvwE5L296&_nc_oc=AdqyCjlKKr-9iBotgR8kJHyBEG_Lm_svxthldJOwyeuzxLJ8aNtGEP3fW2fkwEt_TS8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TEcLY6rRXQ1-6cAQm4gww3qa8uk0gMurWmqSVGZIOhw&oe=6A0B329D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
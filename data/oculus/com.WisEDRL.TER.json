25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cc4qj7I8aoQ7kNvwGbK57b&_nc_oc=Adoz6nlLjRLGHpzXCb3b0jEPEnbTkLfxyGlGI1TFdWU9iOkt3gG0DzYakVJRYAAHhQA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-AnTGDeL-OnfQrNX8fLXS1FQdljPyAD1xOcmsCZ3Xng&oe=6A26C53E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vPmnXYyzVQQ7kNvwGgoI0V&_nc_oc=AdpESytui85nSocc2I-5ChoIFAIDTtqwZ3cc6ds-0OIX05u0AGrzxKwZTIqDUhGpmI0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bpelyKuZj0oWl2lv8JijSyrV-JzL62dOIY5EwjKeYwQ&oe=6A26E194"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOevHoyNMGEQ7kNvwG1U4zT&_nc_oc=AdppWiUGMymvXAx2RD75xQNZRvAD-Fcngq7-cQtKNbuMr3SOp4eiT-7i4gW8V3V8Idk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DU1dEJVuOzVRUMbo9CNamuslweZ-VXwD0C8CBrzH5rA&oe=6A26D7CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r74psucV9zQQ7kNvwFSCE3A&_nc_oc=AdpjrODb0cMfFdlwQYX5RgAz88Ke3FvHstloj1Tq_wRE67QY2FC2Jkzqof-i-BkJueM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9juKOC0dX4q9P7r9ViROJbq5WygVhM_uMi5G2HtIATuQ&oe=6A26BEE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIuIhT3tPasQ7kNvwFuQ8Ag&_nc_oc=AdqAj90yCm5aQCi2X9Q8vdN5WAwWDSooIOGlRqT3uEw1FyVdUx293P3dpm9OeckoehQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98QL0ZT66rfPkpHeRBxutdo5FjdOAm41NOXVBQPp4azw&oe=6A26E21D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
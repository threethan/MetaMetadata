qyTN8c1XTZDUORkEMZ4uVb8bmRmFXE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO2SRbyEARJDDt6v2FlwzvLUaUZBqJB4AvRcJn-CjECA&oe=6A563B3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6C5sDl0sooQ7kNvwHkHBWR&_nc_oc=AdrDJABNSkbQ9nzbjEaqWXBNnozGxjjSEMu8VTnXLk9o4Wo9-Amk9DcsaFbGY2CR6Hk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmPrDz7EQGh6HLBOB0UmceygdIF5EKL7WhwYXB9FpuUw&oe=6A565794"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYY5KrWhIVwQ7kNvwG4SDBO&_nc_oc=Adq25P86eRSs8kemRrrpvdGsWTDqZkJWdUffUD_t30Lm29nvJjBh6JzqnA4VIl6CWsk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARtVwJ_QXXtBRlVWZDOQpOVROxKXvk1k1qnj4Uv4A8XQ&oe=6A564DCC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKhoDgZjWqoQ7kNvwFnXxIA&_nc_oc=AdoebhTwhAXwSJSz0obFrzZ890Aw1XWGLvZw2BlhjoDgHFVUfuDaWtFnJbxnYY1IIOk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCo3UdpfZOULjqIch7Q4ZA3tBPt65w-LCGFeKlohjKfg&oe=6A5634E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwYLFUXFop0Q7kNvwHBrd99&_nc_oc=Adpbz-JcgVBlO7tn56lBmKtw1ryoTTv48kImOGYj1-Dg1JA6SbzqgwcXp5mbVqQ3oFU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_8k55hHfrxoT5vPEq69-zGRi-ugPNNUgZG1qTy8FEsw&oe=6A56581D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
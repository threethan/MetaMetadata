Ptywo8KmlLWoK0OmjYKXuVW45LOzGs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-QnfmR3JmqPEWvaCxFE27MU5ABbt2pqUn3p3ysXbA8Q&oe=6A71EABE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9D-TvNPhV5EQ7kNvwFGj5Ef&_nc_oc=AdobASec-4DD6dq7G9Uvz51opMlVE3-3iaIIvNO26ZgOsIeYPzaUn5zGjv2kMBVi7nU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiiKLAdk2bZhVO8MxBmfWEXDJmkTBSQx2wdceYElheSg&oe=6A71CED4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkO88nqMqUQQ7kNvwExTrH5&_nc_oc=Ado4p35ZAXjsU5sWJy6gzYeh2nayabBQUQa_VK0pquHOX8Ta098OI3qfOHDLjBTRd7A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd4hwa99tLzrRJaYEbareqqRLx7rkBdtwCE1fslWXD4w&oe=6A71FD4C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZB9vjlEBb4Q7kNvwHBS3lB&_nc_oc=Adq_ZZU8TgjgeQX6MSeuCOUs8uPfWTqUHmMl5H2QRgjXCgM3bMRC4CWDWyFDasU4kbU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQSZFeT1JxybGv2ko9vT6TpFd83-ZU0LElm8oADZsaVQ&oe=6A71E460"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp1UiYEwhSIQ7kNvwEtL-Xv&_nc_oc=AdqrAq1kLDt9nClJpsnu9zJgJRatCA5hCT02_g1twOafdeVrS9fALD5bukbM0PJ4emM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbVHE_tE8mSlp3OzSRqf6IwYZ2fULJPWlD-YyGP2pNWQ&oe=6A71CF5D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
79231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnTQk1KyQyUQ7kNvwF00ozj&_nc_oc=Adk9zM-5ugOuHaOi-d5ONOrMIf1CTJAW94IIq8w7ZCzRThB7Ao5eoH6fVSfGXVuJ7io&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyS5KfC0INutHPGWKKnDjL2OzVmf7feLq4K9TK2JNshdQ&oe=69AECCBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYQMBuVwx9EQ7kNvwEU6K_K&_nc_oc=AdlicV4MYwr_9P_VXQYer_uva-kGlXTT1IyE8RoyhwQgBKjc4jugl_UcSkeeaTXNoWY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9iHDF_zXp58Ysq5gADZnyje8DLi8NDCoFl0Y04w_40A&oe=69AEB0D4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8Nup8YLLCAQ7kNvwEFr5PM&_nc_oc=Adm-MdOsh1HLPqj4KAZSRTXjctB5BDj4Dsi9Sq1nkLckcMZ1Eq4E3hwmfp5-90Ij_Pw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-pKKNiZnzy6NjiVaOZdy-fCM6ZGjOLVxBvcv0PP14Mg&oe=69AEA70C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCak0P2K3MYQ7kNvwEPSvUt&_nc_oc=AdlTovTO_mP65D25ctF55ZPYFWvuLfD_8lQRPS6xl7RDpNZHodb4-KawJJ9uru57owA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJ5n3aDuKGlofw0kdLokzSn_1k6O0ds1vXtV3nvpx9zw&oe=69AEC660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw66kZUH35oQ7kNvwFNSrvz&_nc_oc=Adm9WEGJ8k4aancDfs5Mlxvr32rP00JV8EFtJ4104vt8HMtKKmGPbWSkFv-Ub9suzPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxfq9lDpyP8kjsXiLBmayQQblsglUaA0Y3xi96IjsiHeg&oe=69AEB15D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "gen
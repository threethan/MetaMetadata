25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzJJ3QtiDBwQ7kNvwG608Yp&_nc_oc=AdpMI3hWp4FTXEDNAcLN8rAlmaxBUevqk3SAG2cNtAoJuME4mKMlLng5GrsBhnUiHVo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQHlWXQsoaqYJSLaDMqZ1lhZO8conXuiJbm63pjarG4Q&oe=6A845FBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGuEZkZXvSgQ7kNvwFfq6C3&_nc_oc=AdpVZ6NH8x5yR5Ky8ZkM2fPvBnI29FDhppcYvo5H2nrRFq3d0HtiGUG7uGbDjMnpjkY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk-ItsXEcozYtMs_LPcqtSwfzHKzf-zNUiRV5l_kEtQg&oe=6A8443D4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdAs4GnnipEQ7kNvwGTsGT5&_nc_oc=Adr8GrO9pIvGNtZCaIk7rb0Zbh_ghf-3R36lo8B45SCni7NuzU-P6lGCVTZn3EcPl7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2yONyjbj7GRhOi7xW6LH9KnKud3AEk_c9D1Ow-D107w&oe=6A843A0C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pBGnd592nsQ7kNvwFBTWSj&_nc_oc=Adr7nNpyLwZCKwx72xi-nK2g5tSbe-cdyX-NCmhD7q8h33Rw_FRer3xmlnsDWB1gJ2U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb5vLHrzlZfm6qEaGh-lXTfRCa22aKVMdh7MHhou5zBA&oe=6A845960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ltr3g6MzPcQ7kNvwGPJZjn&_nc_oc=AdqRzxk6W4W1ulJl7qFMS0w82pGjFmDqg9i4s8n2qkEjIN4JhpOD15w4Kk5Bliaxlp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt7gUQpzcziHRCnJeNj_TvGiMHCHV-FR2qRsLQkyey_Q&oe=6A84445D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
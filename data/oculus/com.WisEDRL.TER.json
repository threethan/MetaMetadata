25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFEsE8oCyEYQ7kNvwFyIc_T&_nc_oc=Adqhd_ehPb3OM9Dw55PvMN5gnj0MT0CkIuvKRDVssJlv_RLbp1OHiRIxISkleCo8Zv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1z478cnjldoDpxppmeGRaZTJye0r7DDQn0gNtoBP0tmQ&oe=69DF943E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQRBWjAWZjQQ7kNvwG7zEac&_nc_oc=AdpB9ltRDkjnfq5gv53idcqX0SVi9a6eqFGvJM3GTxJUdz4clPyTMHnVwxb5orFujSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HUcHR-pll4ANhwCxMlMAcnOd0KpjipJr-xJpoEp35OQ&oe=69DF7854"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnjp05QmWjEQ7kNvwEQzJCO&_nc_oc=Adr6aAMDNeKLmvRIybMaZMOR1aviqIL3rnZk3vNrefrI74XfbnjEDioWxUxdEZqlA8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af239c31uqZzxO-L6ZMEbtqJZgXCGlEAPDyegf0nMXC83Q&oe=69DF6E8C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paFhutYkf0wQ7kNvwFDy-bK&_nc_oc=AdrIurklHrz-WK5PNBcdRWT8eMvZZtMuySixSwgVsnf6IZ7PmVt_JuTazjWk85pdVLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20JaOVEUSWyQkOZdCxPkARqhMItdj8KH3oa7W9LtdQ1w&oe=69DF8DE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QE_9PDm9zUAQ7kNvwEX6F8K&_nc_oc=AdoI8ltvEDhCj3nJhTbaShd0yLdSEkigS7gPwYZkJA1129bs1CcPsvwwfJ2ZXCjUlXY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FTKTCDKVPFJJMkc6PuGeQvz8gKgj9W_X6KdhEGLdmag&oe=69DF78DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
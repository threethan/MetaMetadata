25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RC2mQVI1fLAQ7kNvwHOmLWv&_nc_oc=AdrD1G1mbvsIQ6PYGDbxfetcO7aKXVCF2yEkFDPhObXLsUwBUFrfNnP5yrF_LvmeB24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqSL2KE_0L8l_UY77_YNVEEq0YnEHlqXYPcUM2-lzEag&oe=6A60C73E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okKr2uIIy-sQ7kNvwEZEkZ9&_nc_oc=AdrLExuOzhwFI0-SEiVSaFL0ItFy59I1oi518BMagcGN-HBrzvhAbgJ4QFabPBV_f7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqopBuAco63wgKyrIPY89saJ53PSpMCbw2hWBuMO9w6A&oe=6A60AB54"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtIKJzjNIXwQ7kNvwF4WN5o&_nc_oc=AdrrBERJWU2FoE-8qt6pAZn5jy0QjtiIuADN5W5EimdQ-FWdmrugMBDVqkZyVZlXZoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7Foi1vSM_Nf_4nw0SY2qY7kCBphE-dFwGJRnbxrAbCg&oe=6A60A18C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwJGU64t4KEQ7kNvwFgr_2Y&_nc_oc=AdpUlWXGh-nwPf9kCv5S0WmWWPerD4Ah2vwBaD3n35WJeeklf2CRPGoToyRPmRHU7Z4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJhwmipqapuG6kHlJ48g6avNCj_5txoODEQsHYIc5cEQ&oe=6A60C0E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxuO1vlEW9cQ7kNvwHn-wH2&_nc_oc=Ado7oxrltpkD87j0Hj_QfiMTrRW36JWCqgdCegTBk0V73gCKNajce-Xtj2E4GIWYG7o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlM9x882ZDP_fLA9wwMbGF4C9fGOAu5xOWIoOAUlK3Rg&oe=6A60ABDD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
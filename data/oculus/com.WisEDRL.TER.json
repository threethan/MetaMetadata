=00_AfzwkTOGzKtRo1YkkC0WdX5LqSfezPbhb6sOIqshliKRng&oe=69B01E3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQHqm0xgQC4Q7kNvwE9RMX_&_nc_oc=Adn0l_ZfmJX-AF9k_B7kDLtATYkSGLH88Wo2qRvhLKBt1_6ikeBXM01pCyTc7D3PfKk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyi-ZFAWm53g1wfsw7PCeodgOU7g4Ohk68UKZJk_1Azcw&oe=69B00254"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8Nup8YLLCAQ7kNvwHL5J99&_nc_oc=AdlwLT2zRlaoEQkI6uA2E924DX52fs-G4193NvffiU6-S1MBKn3bwsfmHQCvB_ae9Gg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzhn_qLEHHwTKsbaIDdxT0dz1YTjHZLitsjnAGsnh30gw&oe=69AFF88C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCak0P2K3MYQ7kNvwEP5tIP&_nc_oc=AdkvWQbtBqCjKtdFfi0STiNdtTV1p8FLQ70yAWG6GriP_T5bR-nAmNJ0K5cYRNA9CAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdjjM0CWs6ORlmsXBauC2gCLeyDb5zx__my7b7866iBA&oe=69B017E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw66kZUH35oQ7kNvwHMnj4S&_nc_oc=AdkoCPAreFGA0zk4lzlz78gjIxsrbSgnSVsT_I8lXNnwmX2i_QGDmnYj6iX_QyP7uXc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEoIXW9S5dz_Uw60cJN7M9AO2r58fyX0o8MHMH09nwSw&oe=69B002DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
79231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEO1CzWjYs0Q7kNvwFDqDOr&_nc_oc=Adn_DApd7LKT2ILwvL0RzTl1ENVcOHvmrZAxbLUdG8Efw65PBEys9NYRKq4_aZBtErI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzmrp12QCpR7Byy9yUSDV1HPS4Z_mo_u12b73EvjJg4eg&oe=69BFF03E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGd9dM1BHDIQ7kNvwHROJJJ&_nc_oc=AdkalzgGYvJUPtv7T99FFdS8C4a3hX0N3e_PeT8r2Vf_JA1JtRpsBpGs_5QnR-gKsTM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwjFSA4dEGihLj9UPMalOMowd8TjaL8hO_YsgkBk5RkbA&oe=69BFD454"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-o26lmyzR3YQ7kNvwH6n4Jh&_nc_oc=AdlGnPC9fDhDLmozfvjaijZO90EXojUwpQbgf9YQGKHL1r4TLjTh-wMxMJLnL4dbl8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxtQvWTdxhtBUZvRuXrTdwEgs9xXfFqvocgqfl7Xi7DfA&oe=69C002CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-qHuW76dtEQ7kNvwFueLdh&_nc_oc=AdnnHFaal4LWSUjqiIlK_f0Yt06l_zuSYPLmixtTK9-HfKSZ78HSB9BIB6wRgwYe4nU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyF5xkyii9p_ynHZZ14h-RezcnSzgI50nRi-Ct19jp6pA&oe=69BFE9E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSwv9b16N0kQ7kNvwFXUGRP&_nc_oc=AdmYn8fw45P5Yj7ZMAF8Wr8nfzOwgkN1bJTTsHmkEdMGudhJ_acsaVjg_5WphXSzICc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0nH_dYoNa2DZQ5xLDsdbgysr8nfX4Tx5gXBZbCxp2wg&oe=69BFD4DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "gen
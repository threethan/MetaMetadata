qWtSYy4GDsAUfANUoVeEv6oJ1_fBY0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2noSvaJQACTPC3gw4GdUNu9AB3oDom8wHTLDcJqd4rzA&oe=69EF663E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKy7tHHrrngQ7kNvwHIPyQZ&_nc_oc=AdpKE5ziRSpD8llnIHpQYGmFqWzPqo59wi2ZA8yRgXnvKUmvgw2WHxpiuuT_Zzyh68c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0w6jeRgx9gSVyM3BdVYzsOkY64poAICncE5tOGHCc-fQ&oe=69EF4A54"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yC6RdUYWVWYQ7kNvwFfEEBH&_nc_oc=AdrWS-FqjO-aybx5Q7G7J1tVlhmxpxrZzkf_GdXkImm7jlbA7HZxBjQhwmHX4o71K2E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DCJkQIUU3seGjmO8mCBSFPAHzyHYDXpO2jt5Ei-vlyQ&oe=69EF78CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI_Zaea4pngQ7kNvwHgSnw3&_nc_oc=AdqCmQ-p9lzfui31Ew8lWFpIdwA3DijWZDw5EbG5iQrSwGSFrUHYWvAbayE-4xA_QNQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30YEJFTIT7akYLvLjcxavX68F9HcaCao6oEfXTtdxJoA&oe=69EF5FE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eENrI46taIQ7kNvwGJ81mr&_nc_oc=Adq5hIdpX8zkpZQWNcTjcuMtBdYPxR7wTLh0K65vge_sP6c-AmS65ApD8bqwec2Dof4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0U_5cIlJtPBoQ0fKMLU5PsPN7e1nc7mMaUIEuDlGgr1g&oe=69EF4ADD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
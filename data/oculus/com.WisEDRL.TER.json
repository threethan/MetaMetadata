.5771-25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwdiW_Y_ltEQ7kNvwEnD9c4&_nc_oc=Ado908EJaVA2nDLEoO7fb_vpNmjD_B8IL2vYUSq8XRzl7VJmq_AgzR-jRmOqWDn3fFs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6vn9cvNzVNEwjT7czPSf2HwyiISSjPKa47tPimbjyJA&oe=6AAE8FBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp0oatLRF3oQ7kNvwE1B23P&_nc_oc=Adry5M8-4H-xOZmVGMKbEw0qmBkR9iMo3QerXzRImBZh_mZuURi6HIoYmrZvCYp4Mm4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4cF4BXwPoStVrp6kABGILMlsrKW6CiQs1928D0q036A&oe=6AAEAC14"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfD93lk5PHcQ7kNvwGAhShz&_nc_oc=Ado3L2wQKfQEvyg5B3w06edl7XSklm0VNoljoYoWqd_ZN5sQk2jP1UYWhmSHJ3BRQ3o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvyIH4Etjp3zArknQEMoTw4xhXaOHGjloKWXFnwEFnMg&oe=6AAEA24C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggFJAdSLYy4Q7kNvwE80bfa&_nc_oc=Ado1hiil7iIOOVPLZIpx4s3lqdnd_1x_sO9u_Rg_tU_CCs5vy4vBurdimqbI0ZFubsg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxnNgvR-3_AjoOoDdwQQYyfh-w78hG4f_oSiCodI9MCA&oe=6AAE8960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TwVP9fX_gsQ7kNvwFqLoaj&_nc_oc=Adqf7q1R7Md4824Cou_mXbSjoF9p36mRlEnMBhw_8I1RRhTMWrFNZPz10mh989AZKCI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRFn7MRMCT_OLByc9n5pV11hrCtqiZ1aPVMrBdsdK9wA&oe=6AAEAC9D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "269189016
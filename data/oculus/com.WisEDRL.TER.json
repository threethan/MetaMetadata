25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZ-UgnTqqW8Q7kNvwGHrmAz&_nc_oc=AdoiNfdQYvouylR6IAeNcsno2UaCwTTNWaU5cChtcPUt6weOBQg0nUQlIPih_OJtlxw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGW67wwcuSIOJoooX56WbGqzjCMJHl1k3Na6TXyg11lw&oe=6AE891BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPefDKxAezgQ7kNvwHya6yt&_nc_oc=AdpfO_q1pbEaaDQGl4luHIiEQLrfnYy9lNUcTT4EvmWHNZjxcKKEKdxpAS_FWRA9IiI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5OauDKMXOutm0-mFGztFFOQY7wItyCU_3PgA63zi6Rw&oe=6AE8AE14"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7thAqrnqDEcQ7kNvwGxU6Y3&_nc_oc=AdoImp3M2w8QcytIkDwHhE-n8XIw4o2P8ZLwwXMQZ_KUWuFapIgVwb4g_U_iswQQ5TI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSctJluAV6MSdcJHJG9OCsiuYygbZIGf4ugW7yWh_1RxA&oe=6AE8A44C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbRqJryPzpQQ7kNvwGFwJQA&_nc_oc=AdrqfriLuQmcRdJpGM9bGqrNlq2sIZydkXAcuuMbrA_nWCj1mf0gbbioIWT2IASajB4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfF5lHlShsgsTXC1JpKyrzMi7KD3HwAxDrEFZWbcLUgA&oe=6AE8C3A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6N4rUDggIH4Q7kNvwHOdotx&_nc_oc=Adqbg0XmTjYFHw5qW17Ac9ivqGEBaVUxiTL9WQVOxk-QPmOvtXgNKfuz9juNevqUK9E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-5CjNcaRlpxHmR--4pC-7h87F_kTkZOtDl1Q2qsbDxQ&oe=6AE8AE9D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
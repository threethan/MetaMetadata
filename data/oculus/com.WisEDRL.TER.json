25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qFkEeRtohoQ7kNvwEWwXI_&_nc_oc=Adrh1D2TjC2YPQ29Z8H4HgNhOoWGdktHBH--H_GF3-Mock5JCbOKnFJlJEZlwmS2QNg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c1U9R4ufRjw0kbFbn9sRGuUvhTIjWyc3YUQEGxJ-8KQ&oe=69FF383E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JtF_gvBpSsQ7kNvwFzxZOe&_nc_oc=Adon-uJBq-exCQNNdhg28blqRhnz0Tcq4AOAJ4NTHYDszS_zyfLkyqJpotbRQJnQgO4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qtivpppnhkDxyyioBKj3_iXLi2r0O1Wxg5pW6iCEXDQ&oe=69FF5494"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inaFD6LQp4kQ7kNvwGfSFG4&_nc_oc=AdrYcdzvtnk3_jhk-PhKaIohF_1Gy7xQPuf7OgQOQgmFrSHFyzfxpEagl0ElOjju2ZA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kziRaSo_XnRCKLuT4P0PFat0kDg-UvZWj94-f-YxD-g&oe=69FF4ACC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDx3gRNLNKoQ7kNvwHtXO7l&_nc_oc=Adpn_JC9xdT-lbzUFkC9W4HTC7zvZ97_ay_WRJAdZkLeCtMPiYQHxYjoD1aGkRjW_N4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u4xKo0vl6aXWwiS0BgkGC7Bq8fyA2y7Hf8VVBdHEUwg&oe=69FF31E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8gKTh74VJMQ7kNvwE1Qp0T&_nc_oc=AdpCjYtz1fVycCLKU_sh8wLX-mluLFv7CRcLjT_cZnY9gg0GlyU13603osIAPvLlIyQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AaCwUOBQf70QF2VLOvLFykPC2NIxVOQ7MJi9sJwq9eQ&oe=69FF1CDD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
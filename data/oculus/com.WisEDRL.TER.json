25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7YH8Pa_YMMQ7kNvwE2EKGm&_nc_oc=AdpSvGJrvTt0nXP7KWsoBvAt08Ln98AcEI5iyoP3_OGSwUM6SzZNZrO6Dy4wJuYNRpM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-H4mibgzNKHsiYRBnhNSAKu6hZQfqHLqFD0tAS1uCLQ&oe=6A5A2FBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNTXZc-mb_8Q7kNvwGMgjQz&_nc_oc=Adpp0Q4Pk40ctH8fTYijAVtZ5fgkf1rIK61VPbb3P2JFy6hxFQVE9Pp5eDbgNlwPYok&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEL3X4YJfpj2RV3yyc5RZq3wYKk8HQ3G3K9zONEV9cug&oe=6A5A13D4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEoHsVVPgi0Q7kNvwF-n_Pk&_nc_oc=Adq3jSGc3UlZd7R5YLkbSQXvwYlFJHG1rcpDyrxlkizOXFprhpbKvJ7cKstZAZeUvcg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB7GHLMpYOlZ5B0559v-avSUqFHw-sxmeW_QxVFrUyWA&oe=6A5A424C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0jGPKLadKwQ7kNvwFx7Jb6&_nc_oc=AdqzAaiaaDEi7qouYArIbf7ASVx1whWu-ElxuSXRl1tVaX-YCobZa2mLrqXxsPbS9f8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbbkU1cPCgy-BtMI_hT5vFc4xSMBHSPdNKNXZSNLFbzg&oe=6A5A2960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukRph09sRNQQ7kNvwEx1EWD&_nc_oc=AdreDfHV5rtVGGeAgyxh44PgGzqDO63EYNFsFExSJ_8NOQPquc_r8CDoK3VVtSn2K8o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOUWEPfk6ial1y4Ic2JYuFzXlWROhixGEH-iqiSpnIpA&oe=6A5A145D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
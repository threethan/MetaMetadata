jLsQ7kNvwGWsV5T&_nc_oc=AdlQ3SevtE_9Y2hPXMUbJqM2TkDHFUmJAV1T3Bfwnc2099ZbCLPBhTU--ygtYjIo2wA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftNxiwaq_ZwICLXQ4BxACJLQ2swOUpDGZAW-ojZ0mC99A&oe=699DA93E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHWtTEL-2skQ7kNvwHTU3iz&_nc_oc=Adnm6S43rDEyCtkul6GWURZMwQStwMkZKolzjLC_FSvdpndD2jyXumefv9SmT5l7KSE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsImI0-l1RZSS8DA5-i-4ITsLI7ZU6QbUCT8VQjeTaC5w&oe=699D8D54"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeXVGA-hxokQ7kNvwF_Kf_j&_nc_oc=AdmbW_21kMOMW_uu3i4m6CjZO08Vb0kEeFk40czELTuhuGe3BuikdDs6gGgWZeYJyNU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs4Oe4_c2Flv6gWgF_RoknLj1sj9AQLKYElqxwmziVFEw&oe=699D838C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih8Mo4GK7a0Q7kNvwFrZv00&_nc_oc=AdkTHpP4FphkBMAsdpUmIOs44m4c6IWXGACAd0bpM3w9zZqTgiPtwOfknb73mPoZ3Tw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfujxvzeX9dXN3c79a6EUvCoYzL-iyWd_Vt0cGoH0NXp9A&oe=699DA2E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BoaSqk2zQ8Q7kNvwEeJLoL&_nc_oc=AdmGFC2BbAtIh2CIlraRXHgwp8v5cozM-Tjy8X07XlNUZaSL12hntWoDHM7AJy5Wflc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvPe-2_LHVDdW7LK3oV-0E1dmnA85G90jYnGcNCz5ucfw&oe=699D8DDD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT"
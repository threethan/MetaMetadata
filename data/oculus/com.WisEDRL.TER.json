25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eQEKMrc24UQ7kNvwG4QFuw&_nc_oc=Adp2oJEbQeavBj_FqM_DogoOMHJvhz3p5L2idW2CUAXQM6aE2B8oso0bonIpLYjeYRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnR19LiGsFNUS9k5-Tnem_nEXEjPZLQVM4tryjT_u6LA&oe=6ACE33BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoqI7r-NNqIQ7kNvwFvyxHZ&_nc_oc=Adof1kFhQuYANpYlj2jv4uQja3dstjKuBqimuRbL7vi9qq7PH-GTqq7sSCsJ_p423jU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj1-AGafO7I5kQs6rXUZYJVUa14WD9TMYD6uGxD3SdkA&oe=6ACE5014"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wccpM8-EbOcQ7kNvwH-WtH6&_nc_oc=AdqlRdZu3lqdV0NQuC9F63uwMSty-GnydEP9iESlZ6PUOWWl4u6VhhadK9ngFGlSvKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzZU7LXpSBfeZYKFNdxUcuGRk91neATR-8xMic29rLGw&oe=6ACE464C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwrv69Zf6KgQ7kNvwGiCRhf&_nc_oc=AdrjnkfzCWOAFW921L13E7uQduoDgdGJI1pKL3BUguc72ffidp46wewfgOAKApXOlmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9hkXNbfyxOSYRNd9pdzjADnb4NitlshjbbtZ2-2Nn1g&oe=6ACE65A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4-Tn4XXcYsQ7kNvwEmwAHN&_nc_oc=Ado4DH_iX6u8BYq0q69pBk7vggYsXmVXjzWdwsDBeAEkWjMOYr0s219jZQSOMXmJrI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzMfwZgYcfafiUQzkkOZffZ05uLiYp4FNQkNhUj_RqoQ&oe=6ACE509D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
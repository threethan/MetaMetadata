H0EPM2TkZVom0vZz8bI1ogoWGWZxwE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfiXWPsiqxtxh9fiHx3VDf7gX0qu7Iu62FEBU8DxjMKA&oe=6A4E523E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFXNwPaFtmYQ7kNvwG8Ev48&_nc_oc=AdpyMldcaCWTHfBGRA0npKeX89gjiFG5qyvKlMdYIeQkDt_I4TbFC1iKsPhiysZDES4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbd-Himsuez7IZW9ZHNDsVgdXjdUcOtNF42oGJX19p7A&oe=6A4E6E94"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1Cl4UupGIkQ7kNvwH8W3np&_nc_oc=Adp5gw_myqi2aZLp9RUMp4DTf3cgoyblp1e7jOTRTq_JTQN86Intm69Q0o2i8ESIs48&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgu6eplKFLsj1_Y1JGIbO152o0e3qylT9HeBZpY1FX5Q&oe=6A4E64CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOVZu6_nkBQQ7kNvwH7gNdr&_nc_oc=AdrPbhBtDEBFeip2jU1x140R4PR-bjNQbEs1otV6HtZ6mC2WsiXjCPklkcl_SHEB-uc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy3QwL3k7sCL9XBPC-yc0pfvG6KZp12L5TEZBUP1VyOQ&oe=6A4E4BE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxSzfFwlUlMQ7kNvwHbt9hK&_nc_oc=AdptBdx5nGgulRym8FzrU84KkGL5zcT0iGZuhw5RI4XJXJlfhA9K2x3yxOVBVvvmR1c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR-hVrM4Z4YE7IMwQEOKHGHeXdj5bNjzP8_N2E5zaF6Q&oe=6A4E6F1D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
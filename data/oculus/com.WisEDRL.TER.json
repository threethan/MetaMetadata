79231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8rT7JHj-PkQ7kNvwGrlKgl&_nc_oc=AdnGHsrwK4VLnFDwnvyuWN0BFxFzHeMeoSWWauwa3t-hUD5b-VAqHrIQf0NfpCPSWgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxNlCkmqEQrVSLIETxsNLnRPUvvnUocPEJfPYvKfuKD3A&oe=69B2C13E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQHqm0xgQC4Q7kNvwEtKVah&_nc_oc=AdkI_pKTH2sptaey2RQalHzvZIurFxc_n4plrSFggNUBdVUrq-s4JA59ZBzwZ0kZQ40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzFN_Wi4gTRD26FXpytN-9G_384Bb2scexHIS5at0BJiA&oe=69B2A554"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbGcXZOW87oQ7kNvwGm5TEI&_nc_oc=AdlM4y979_Vg7U89qFNzg-FNCghLxvebhEKSYPnmzyvETTc_GYg17rV9SGq-HAX-gLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwsXDJwKNmexePlm_n_BFzES-QMbvoUCnTTK71degXq1w&oe=69B29B8C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vOQ0pnmf6cQ7kNvwEnj_NR&_nc_oc=AdmlA44rOEirr3hVaUpMFxhgW5hVAHHtq7Uy39UBU7qrHM7sDZgaQE-R7_FPiTPvYYs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwis4gZUsQDuzQwmajkdgy61O6AUwTOluqUwfptHGoCQQ&oe=69B2BAE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c19ucpnB8vEQ7kNvwHJylkS&_nc_oc=Adn3qpA7b24vhjWL3zTSskAPeHu1iJKG3V6OZsDrQUquOTBFn5jiv8Jmdru_jKh42mI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9hl0iHoGWL2x5z7Vre1xUcE79IimCxHFxIfkkRL124w&oe=69B2A5DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "gen
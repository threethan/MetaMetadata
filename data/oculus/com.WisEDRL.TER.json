25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQwSuZo-6DoQ7kNvwHbChS_&_nc_oc=AdoEibPvC-Bloj338UyxLmhfQw8aegYQ1A0R2jvhyBwRICT_Dbwp9DaPQm5Kv4qXYyc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66IJHVWV7UXNXp3mxyNAkZBF3rSRA7cABUxOe7JtUXzw&oe=69FC953E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2TB62FR6QIQ7kNvwEuqMw0&_nc_oc=AdrJt5FCg9i9KlV60dq2Sag0tpaWIRZSGKEtVYGXDUdnPLRl2Ujr0VPnOpjIsQ0crL0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5J2w8ieLNdc_kmDvMbgv-WGIVVFADTBE_-V-W03_T7kg&oe=69FCB194"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQDHcJ21768Q7kNvwE0-1d7&_nc_oc=Adr9cjxWoL2ruD0hL7cXAn4i5Icq0Vj8KQzWNE6B7wrOHwMyNQjhTFq-pq1fdJ8sZZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZCMOXVqUhzPmoV1d_qJ21U2pNiMASI_YKIlijRjVf0g&oe=69FCA7CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G7Mdf6OhwYQ7kNvwFxaZuE&_nc_oc=AdqHVpO7rjkYwz9uaHOTzfJNKHEfwo-9W3AvaFpJJDZpiQO7xKLCwlaHSY2fa411I3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TyWitB9x0bENbbLTdNmxTj-KU_SdgXqUGayFI6hF6Jg&oe=69FC8EE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8gKTh74VJMQ7kNvwHNlmXH&_nc_oc=AdrXF8WwBgvDbqBPqLBQ2EzCNyZwYIWqHBYCDM3LtMcSsKdRaIdQLvZxephs06rdblk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62-IIt5Mn7ffpmdnf03UgLyrjsyn0tXk0jnSzcyjQYvA&oe=69FCB21D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
Sf1vbcjUKL8tPCbwBzV40WipMIIOjU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt8-ailseyhBHqABQagVRIF-OcMxN7EruOTuOeqCZJ0A&oe=6AC8EDBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9D34mVuOZ78Q7kNvwHH3Ok4&_nc_oc=AdoHZ-U-0N78Vfg5zFiK18Ew94XqL6fp4k1zdKtAHkXn-X9BJvj_kEPzPP5cFg0CurA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeE7hSFpMVGB9dHMLrFRkslN7e7YUBQZsHAwQMlGPwlQ&oe=6AC90A14"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LU4mqAcFoKoQ7kNvwF-298k&_nc_oc=Ado2vt6asfYYGudhgjlmbUakM5tiy_5ZnQH-Eje3D3F29cMhPIGla-nBpR38vdTUp9g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdXpGubJyvv4x5xwmTKA2pWoTub5XJ-VJ6nLF28NtZlw&oe=6AC9004C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kw4gxyFGS0QQ7kNvwHScEf2&_nc_oc=AdpwafWkL2GEo9eyiRwUs6lQ8blwzDBjTXpbvfzIRbVPcl7KjY0nKsATulUbq_e2pXo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMInopWzoqNmGRP7Hy0suxIBXMj_bwL5AS1gxuuX12HVA&oe=6AC8E760"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffM8eZrWbnEQ7kNvwGnGCmV&_nc_oc=Adq_IMVZ9rtU3MnLuMkHkg6vCRzXTfy8M0kuM009t4XPr2ExN_AWQ3Ru2ejpZWwdV4k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9YNoM0AacXQLNVd6kHVB_RIVCkshFo99hTCLqbhwvyg&oe=6AC90A9D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pln_FxXcDUIQ7kNvwEkeUxf&_nc_oc=Adpu3JiCS6G5Zl3tgqsZjAGZaooRWPD4IJbRW760YkAeVGgO6rf7GTlOzgadXg4kG3M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnA59M8PCJvP9VyG5d1XUvFoTRMDrV_Nm3MEdaULzSWw&oe=6AB678BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk-lUuB9zVkQ7kNvwG_7Jub&_nc_oc=AdpIjyG8XAXBgYfs1j58CjzNEpBIdhjG1U78Uc-4L5ulmKlgx6el0kiL5ED_I-7pxzQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2NaYxIhIqJSP0cfQDvu4q-HK-urPF104EtjfEFRnPUg&oe=6AB69514"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gFnQv_zMQUQ7kNvwGGRtxR&_nc_oc=AdppPSVznJ49Ft2EdCktjFoIxQm-6XGT2mi4kzZY4ZZ6iaAuT7Pdb7n1b9HYLhxiiv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrqMEcDBkMreS-zt_x8pj8ko1t1NFYC8tqT0xkORnq-Q&oe=6AB68B4C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGk1rKwAjkEQ7kNvwEQXaK0&_nc_oc=AdpDR3NZLNUhd6E4W-ChVzOIHjFC1XeFLZDxH9fYtz79s08ayHAuJueBJv1e_quFo54&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfUBD_wGF6x3QDicoJbmzItgSx4qau_JceXuC_fG82ng&oe=6AB67260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnvbQF7JHQwQ7kNvwEwKdew&_nc_oc=Adr_Bnyiluus8206dCLkq7T54L9wIvT7_EVHbeMff8d4rG9n8N39IO2c2SDJ4ITF_Ak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8uwphBw7NFap2w-17FzcCqLOX5fYyZLhrPmv0fWbwDA&oe=6AB6959D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
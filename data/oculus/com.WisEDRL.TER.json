xBa1eRVY0rY6U-4tNn5Hzn84rk-C48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DEd17ZQY2qXPNIsDw8N9IJrVt35qzw1Tor5_MwgXpZw&oe=6A01DB3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JtF_gvBpSsQ7kNvwHYOdAw&_nc_oc=AdpHbgvEocJJk3OTUcEdWGB6KLsAl9P0XGN9K9XMsCKLSuPWSLHWJXbCl6KHmIajk1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79_lwGz5gf4hk2BVBOImcYty5zbyoD3SjE83lnbPinrQ&oe=6A01F794"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXRkvdDJX6gQ7kNvwHQD57D&_nc_oc=AdraMWehlUml-UcWd2JkUIgW75m8R-bZHQFuq4nozVl95A2NVLdMD6LG-hweSyrDHe0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gptKyHKpLaJixf22DxZGK5V6x3cuTcSy81rtM7WVzRg&oe=6A01EDCC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeKp8FxprZEQ7kNvwEYhG5e&_nc_oc=AdoOIeNdv-O4Cc-MFXBLBfuAROS1dXxabDTIv8axRNvCm4C0C81SatjzlHYTczNzJYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K6zGfVWeEMsaUqjREoBg5R5Uxw8Kf_WiIO1Ozo2l-kA&oe=6A01D4E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twwPns_c4pcQ7kNvwG13mxM&_nc_oc=AdrlfVBrd6ya5ZVVRA8mu71Nzu-01cQQ0ph821iQzi8pP6WShmGWTRaJ8s9QunxZcZU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DtkTis9gcmZwSZTrZeMQa7HPZj_A1GnSTUktxTwHG9g&oe=6A01F81D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
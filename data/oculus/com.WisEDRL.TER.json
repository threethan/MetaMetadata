HGJ9a7uLTrqLuV7Z4G7z2PdFPYHvVM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AZJkm4GAHpHhjlMK0G0h6qeLLKFdysLFVGU6xMxTpFA&oe=69E2373E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQRBWjAWZjQQ7kNvwGgNDwp&_nc_oc=Ado2ExGu_8le66BOEvVAZ5EJMBEEwl19XteqaOAg4yOo5xJ4p7LDF88sS66KpAvWmsk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2B-a0Fqf_VxQh0tlBd6Px2v65cpan11-V4D1hHT_cAMQ&oe=69E21B54"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-M6H3uyI1IQ7kNvwHQSfy6&_nc_oc=AdrZMOaISyxhTORMr4QqaaERsf9ekEoVMaDWkp13PP7vNjA6TjEY0RwA-euQgtLYpM0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T0mcj-ilcntD5gp2ZiZpp6P_MtTgTAQgqT9A8BfJPJw&oe=69E249CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFvhz_wrsKoQ7kNvwH9NSkR&_nc_oc=AdrqwbeBwzQPYxQbnohPVDKahxZmcb0POKwXpenBfGUEJYH_sqSmHYbFVCO640BTpt0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ps7GBIPyEGzdT8XU6nArqKbXzQfw2T_H-RFxsTqakXg&oe=69E230E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBEXEAohEIIQ7kNvwFm2kta&_nc_oc=AdrHzlN-LZ5sby1Ztteq9pV7T1FemXJS1pittuRLwNTpI3EhBySskBCqc_v0ZGzkEbk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KNWtGFT8f96uZx7ibsYjj_anHify3W8XQ6_kHKAMnnQ&oe=69E21BDD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
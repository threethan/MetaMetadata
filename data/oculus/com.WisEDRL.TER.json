79231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zK6J-booBMoQ7kNvwG4QuMK&_nc_oc=AdmYyylH5_tvX04lJuGzakX0FSczQ9uyExP3BYbl2PUhaWnnd4-8XMo4biG5fAoHYUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmSpxckuNnFRrKemSIu6CBNZsMMFJHbnOHxAi50w6Nhg&oe=69AD7B3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYQMBuVwx9EQ7kNvwH0-D7X&_nc_oc=AdnvvbVSK1DZ3FmQQM60uXtE5U430gvVPhUHm9DyQuxR8V3BhrQeCy9t4T3SSaKAtr8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKgrf4woSVBH-ZfVn_rTCdURU4XjIr8uGfLAdjdpXRKw&oe=69AD5F54"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B063s_yKimYQ7kNvwFwuQgH&_nc_oc=Adm1eTz5GkoMOCs3vabvDmfgB2wsVYgtSGsXUJT1YUoan_UBIVxqgP_ejjHsHw58890&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIkn-Ou9QmW-DA77GsyEUP7ZQG2HkdqRY31hB5a5HdMg&oe=69AD558C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vf_lHbMYCH0Q7kNvwEfaxBI&_nc_oc=Adk0yHeF7r6EJz-Fy7JX5qCi7VVVn032itafcdu5MLA1BYCv_VybfxcVU9Q7zcZBZHM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzR9uB95BMtbk1NNoNbHiD7hlzV4hXor5uKSw_dfvdygg&oe=69AD74E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw66kZUH35oQ7kNvwEGR5uY&_nc_oc=AdmY6LtEmAanMsDt6g4lGvlRM72t2PuGdg-e8MgzXMlLiv4-Cywmffkn6ZquP3xRMbo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHIHa7-C8bKYEsyx9zrYst1BLEcUfIe4lqN7qdM7_rwA&oe=69AD5FDD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "gen
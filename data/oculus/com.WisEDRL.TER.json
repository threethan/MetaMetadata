fsnkjlUj7R986WEZ1Cf-6qmpUaG2H4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwv22Djdg0hDaL_h6-WNzAlDBuqydiaCVUK4BP6UnBKcg&oe=69C92ABE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFhd2zBqH2AQ7kNvwEWyhoK&_nc_oc=AdorFo01peCngBBlz5cBAXBHyGdtm-ceOObyxhjdYIfeVQOrk7cnXPZNqt88vrhDD5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJkl0iyFsDZEE95wzAq0_o3lbkknbcXKXDCSypuU8Dcw&oe=69C90ED4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGfHVSrIsd8Q7kNvwF5btT_&_nc_oc=AdrBo4MY8Z6KLF29uYoSwRm-ElTA3vGtF_5_o7RliBXBwNHGwtBDfwWjAPFR36tkzzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzsL0YFSOwPDmBqiiAPX2qMeqsopLjI5PUqZG4FVEn5Kg&oe=69C9050C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsNdqwe06IUQ7kNvwEGUpNc&_nc_oc=AdpppDOu6cU-OofefaplSfw69Jd0kcw2jvMby-nStz773roGULbdO_M4Z_7u97e9H4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwq82C2YOw_mMsR9WE6no03bBCFDTvNrBKqGXS92ARcyQ&oe=69C92460"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIFOULHLuV0Q7kNvwG-ZC6g&_nc_oc=AdrRBH-l1qxIffvGwyqU1Ekj4OnWHCLGptrhvPOXcfkteFhuQUFuLtFmTLvg1NB62as&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhYsHbcXV1ga7koPakH6YE_zR45fKXnXsOZe7E9SUYug&oe=69C90F5D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
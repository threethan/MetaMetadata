25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0jQMTSZLd4Q7kNvwH29G3y&_nc_oc=AdqvEXn_L0gH1S0f9JV0UM2lE9nDpx0_zdIpayDwkEnGt1xssrxjdAvIIxOKgzwdCPc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBufTQm2v4ycBgPfiVNjKoE95LKEctN2TBdg8_tYWByxg&oe=6A5CD2BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNTXZc-mb_8Q7kNvwGtFfDD&_nc_oc=AdrrURt3kF6aeyc5zSijGGMEqB4F0U0ghto7QZbs_0ibhqXfkdSqydoGrg_n3DS7vig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdwqTWCOaAMDNaZJ-YERvzQypHy257OYP29-cZAfHemQ&oe=6A5CB6D4"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYI5ZRr9KZkQ7kNvwGNy-35&_nc_oc=AdpEBYfbUaZP9meXEv-J2XCWKILzShQuJE9Tgi7NeuvbhVZuMgxMHi7Ky9k087f-GxA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBG8rm72a-n2ZxSgQ8RgKT8bgdEYgjelVhjuo8mW_7uBg&oe=6A5CE54C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBeWXj5u-8UQ7kNvwGBEnQi&_nc_oc=AdqZODWGQti9B4T5Q-YkToVTJLhDHUmFWTlpZKt2sYePgEVlooqXaEY05RYF6IYzaAw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu_C_GAtuz2xGdfqxzIXIo83ipVsBbAMkOnb7saygZ2w&oe=6A5CCC60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTDhUQtmOIIQ7kNvwGcTA8m&_nc_oc=AdoImvX1_LaaKUjSX-n5adCUIPM1BJKbk_lxWakNT7AzPULEZDYs9we0QDB5OS-AvTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWVGI7cfOHf6j5gLagqmHB5Jn3sfVL87ET5PbxzKWm9Q&oe=6A5CB75D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
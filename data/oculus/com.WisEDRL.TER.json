OUwkrbMiN6lRNbGevEcnITQXNNy3Rw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLTMnSKQkD7w04PYo9TGdv1usORIicrqFe6PNgPsAzgw&oe=6A6CA4BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2uDaOY_Kj4Q7kNvwHv8pIr&_nc_oc=AdqhsXPfWFrNZjPUS2Q6kXahibaJ5dPpRyn_WLSXOT3hz0FrfaL06koWSTQ1a52bQqg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhLQISYiBEmGe7FKdbrWkxZsjyt4Yeg_sMnhEJfmX09A&oe=6A6CC114"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryfJt4uYtXAQ7kNvwHgFBHL&_nc_oc=AdrKtBwqMP2__C5yFrkq46P4TLTTE1agUk6f76ruyk6sjGsekVOBjdenOqv6BaT_ZdI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFOObX_eIcGly-ZPkY5eG6Ymb5Kee0ovJgj5I7oIWhvA&oe=6A6CB74C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uxi25fJzjzoQ7kNvwFXvCZM&_nc_oc=AdqcXm-85aF9YWtVVwpRPGnGs1Mn9ET1zWu0Oqk6hA3zCRY6qZt0N9nZSLCwisq6uU4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgqUIQJa_myZQcnk079seXzR6CtfuDKiLQrZNWAYumRw&oe=6A6C9E60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOHHZ2RaXAAQ7kNvwGfW0Y8&_nc_oc=Adq2RVap8_YTcwUGb9rkgRiWxSx06yzEwFwZ4SVpfSzuauvpQAsEckqy-nrh0m49FXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8w0mrwA_QJ9einCB7LwGnOC4ScIt0ixQRJaYUB4rOTA&oe=6A6CC19D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
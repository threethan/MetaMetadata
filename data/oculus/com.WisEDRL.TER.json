25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3P4VHtWWOkQ7kNvwFWI46N&_nc_oc=Ado4UnuAcwr3R9CZK30C2I34VijT05vCEDKzPq46pzQU8bLf1jASarqgSsUbIIaBBNs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbo1Lv2-2yoWNvM7mWcjLxibw_OZsoCvxzeBcGTCCsug&oe=6AA160BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psNZu_dnHC0Q7kNvwF8c1Cy&_nc_oc=Ado3AR7QD-IGb5gcHwuFIwRL7AxdXGRMK9fxmnVDTuV0NZgRvmX7QM25kIcTOyHN7dA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeSWQJu8AHgRU3pIA0SxNFvdvVmjhzmcAodqlJMEE_xA&oe=6AA17D14"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx3mqSQnm3cQ7kNvwEegne4&_nc_oc=AdqerP_bZIyo7OlhEano1HWOEqnvcOSefjLu19mVDMqMOw7fcMocl9gPt-yRVlORpKE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrw7ZuXQmtktoUo7o-dumjJy1byM5g1YdE8pRq4PZwIQ&oe=6AA1734C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BofnQJxsOs4Q7kNvwHTOwI3&_nc_oc=AdpB8QTg49r9KCbv7ncnSEe2GFlg5fJCMhYcWtKwWGXyeqDCIFfGev3UvdtlBtbaNaY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqev5dhdw83iBag2B4pjPuim0lRpme7SrpKIGr3VDoTw&oe=6AA15A60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkedyJYaRWoQ7kNvwFk3hgQ&_nc_oc=AdpyPu2eCfTswvY5R2tMKfTFMQRILJUzF6TUZcj-QXju1pvlwnqGvARENvr7OAbQX4s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBEmibBi46icDtcu-CZHfIt7BGt2PWWwjX3t6mrax12w&oe=6AA17D9D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
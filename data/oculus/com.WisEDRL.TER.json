25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKK5TpLEv3YQ7kNvwFzQZFQ&_nc_oc=Adpwa3A6h2ZtrfEnMkY2919eJ59B2b0lAC29LJdtee4Pk0-dDeMQngfje6qiGyV5_gU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zV3BVNfX0_60_jm_Cp_c4dimfRFAgZerx50xWDZPgMw&oe=6A2C0B3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNkQqZTR6B0Q7kNvwFCS3P4&_nc_oc=AdrObi2ODdRFqQWT9BQxBluaZLJwSAgrINNo4maBGorncW2tgP_ffXYaFxW9BUIBpCo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-29yyEOl-MfipqKiDZbR5L-MYa9Te06AnNdazCnchHNw&oe=6A2C2794"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQBZ3Tu9oowQ7kNvwEpr2FH&_nc_oc=AdqGzaP40ZYvmrpuseqQm69MBwIUaKk76oRVeI7E0QA_mFg0Pt2E3XZb4WDAeOoPB2w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZVw-6rnHlze2fyBrnmeExEH4rZbmLcAc8TZ0Wu1o1bQ&oe=6A2C1DCC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhBWozpbb2kQ7kNvwHu1DMg&_nc_oc=AdodyQki0PtRCOUwUKEwozMbiatVU2NX6v2HQKdIp7mtM8wZhTXIN79uFMFa-Qsdu5g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bvmOPsJ0MSdQ-vN1o9XUEooRxGnvxHZX5SV-jmxmLZA&oe=6A2C04E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqK1Jm2SSUAQ7kNvwG2Zxth&_nc_oc=Adq8HLxUTcAr5LgUG-taz2CGnCW9vcdgd1QFj56KhFaNUTwzU5k9AVaSzb9HryJf-ao&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nSYbkBz4qZk3SVqyzH9qUBNRAuuqUSI_Y4COYyGR5Og&oe=6A2C281D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
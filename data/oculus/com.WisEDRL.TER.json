25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdISZXcyl5wQ7kNvwF6KJ4W&_nc_oc=AdpOzFyhy0yvXyy8uRhN8hJCGNonH2t468ICfi7kuIOj70R3683k9Ma5yhueLQpIf7E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5c4-Ty8dq9QJzVzovVOqTfVPf0BiXRiXlEvysSAmOmQ&oe=6A2FFFBE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyyIr4bg5I0Q7kNvwE-daYr&_nc_oc=Adpgs4p3VWj7mFy6TWR1oUcUBCJ-lu97BlOEjyOww65oLmBY8bE2uZSMCS1PJJIHgL4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sNObkD8ZJrTYjGIlSr3DDNTRSETdCzZ8kRR_eOIeqpA&oe=6A301C14"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6Hie0judPUQ7kNvwGVrlCt&_nc_oc=AdpSLYfvYjFfHOwMWA6yGkm6IO0UMFrBSHlg5sfInNX6NatrPzocqML_zkaPU3beBD0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5tOoUsMGZCF9pHhJck7zgG9UmgEWswhJOl3EyWj7hgw&oe=6A30124C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3jO2hr33SAQ7kNvwEO6_Vh&_nc_oc=AdpaEGe0LNJLNCSUqY3zH3KYPsbgwChgIPWjv2Mhi_vDGlgo6_64q9CZRZa-SYeeMvk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99O_AGKhb7IcPe0grfTrs4DcEnljbhmJ50FH7qZ0STXg&oe=6A2FF960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFsXHnGzpikQ7kNvwGlv_Dg&_nc_oc=Adpj8UQTkHDx1DjTxRfP8ufb5xeKkUXATXgSXZy3DiiGu0XN7OYlRakaWRxTAejqFgw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C-HUf02sYRgAFDJHEyTSATdg_nyitJmhX1ZxquiixqA&oe=6A301C9D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
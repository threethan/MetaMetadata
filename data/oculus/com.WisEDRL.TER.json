25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAxVY3L04L4Q7kNvwHEOLBk&_nc_oc=AdrW0FCSqpWrD9_0OStfI36-q42-AT2Y9FLjAJO4XMizURZqo9387rkWBiXqypMc3YU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLzmH-5v4cO9LqLfdq-qDz_3ujau3grPYjat-mtKQvFA&oe=6A733C3E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9D-TvNPhV5EQ7kNvwG1L0DN&_nc_oc=AdpzyU2oFcvt7i3vhI6Ss-GKPG6gK-Xo__P4BBL68VYF8uZFob8N3Ur08me37FS0sKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgPRIGLVQ7tExB_56dWTpVvhr_HNpgrO8IljxgQhCYvw&oe=6A732054"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkO88nqMqUQQ7kNvwFoaWo0&_nc_oc=Adp6LHkt6FdodSOFbSYrr8s0BOZZ2Y9mhLKjhPIb5KvS9Di0BG2sMl6Eamr7dLRJOmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3FHocG5EF95NKT9RtvuD-ndpav04YvMPaZsjycP2Tng&oe=6A734ECC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZB9vjlEBb4Q7kNvwHOnW29&_nc_oc=Adqvx8PNnDKuCHYWtBo3CR6_7XVm1qwpt0bk9opQ8X4vZzfUqtkli0Io1gUW8erjRK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_7b6RT-5tl0Pn8O3pPZXIWN3Qc-5Mx_lZ9Xixc-Qx2Q&oe=6A7335E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NivVCh542icQ7kNvwGFvnsA&_nc_oc=AdqAogpAR_QE9wzsP9vq8a7eK1-M1EFp78-I9yzLMkKQwyUkqsj_vIBnIvV5QPCV_M4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAMZUGTp1_OUlAqtevxh_wyXGjnVsBrI1lo2XCmrHPag&oe=6A7320DD"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
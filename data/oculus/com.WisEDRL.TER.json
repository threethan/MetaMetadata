25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLpERExWOWMQ7kNvwEmfxXc&_nc_oc=AdqxPhAQev31yAlS-eV01c3hpbSQSPZ1CcjzqsOLkgDZFOM6MpQOs6XAxrS-JX9aEBo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4Hjvv2UceHUoHD_mVKbWqbocyNM9YDh0izNIo9oe1jA&oe=6A9C1ABE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UNUpXmj_OYQ7kNvwHrtuL3&_nc_oc=Adr9JLpl8eIrJc4U30DoWki8MlSSn7SISi_DmrHdE9kK9siqklmq_VdAHVTnu0i96Ys&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQMcR0O2Ql8a18-Xoz4zJ0c0o4YcNhq7gBJqJuXkzLgA&oe=6A9C3714"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uRGImh6uKMQ7kNvwHDZS5c&_nc_oc=AdoNOwZ-YHR7B8wS5uko_ukAr6CyIxU4EtYqoI8Ifd281WXu-knVx-_bG58QIdrirao&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-_OJ5qArC7dTTQVzR3iSVetJQvvLebqJSg5NQK-DhRQ&oe=6A9C2D4C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q88pIrfxtnUQ7kNvwFvnBgh&_nc_oc=AdoKUHD9wXwyn3uditCxyY0f1tv_ALzpQky3rPRO6eUX21_PoXu2GzetrkgDcQyi-WY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWcvzOcP97ci-Z8shbenkFBTqCCP-RVojDHjR0H2L5Qg&oe=6A9C1460"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0_47XDLDkAQ7kNvwH57YOL&_nc_oc=AdqixWy1a074pvf7KZ47xUIu3jCSWepk-JEdf1qM_B38d0ERtuQ6oa_pQU3tvdm7dZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-qamvw-c4C_xihSdEES9wmCE12DibtGFNMQJA_RCBbQ&oe=6A9C379D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
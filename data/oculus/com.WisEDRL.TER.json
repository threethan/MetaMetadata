25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xb9IrD2wnX0Q7kNvwFHYdLC&_nc_oc=Adr72uCHd7rp1xhIpTWHa_lRzKfJuxMHu3wVlcUviiBwAgkRJ1pM4EMGdclAO4l3a-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bCcWlevQbyC0KGuBuvBP616FmUzJ5T44hSYVDZ01XcQ&oe=6A43C63E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMsEwTrtme8Q7kNvwExVan2&_nc_oc=AdoMW2y4xTDeHMblYHXVpmXn_2CAv09cpvv0ZvRuAwUk4_DYU9trPBLU2Vs0r3syhss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lllch4uxHOnFtOA-sHa6CTt2Yv2YzyGLPTfV_wvVwTA&oe=6A43E294"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJnNsJcPVfgQ7kNvwGyExUj&_nc_oc=AdrmdSXUOC84RBAX2uNDXGSGPhGVuKzans9MdG8AQCAligKUsBdMYUtNd-Brfyd2sKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FVDJiyS-Zopp8BOMHBGD6C7bVZyeyB4anB-e_onMm8g&oe=6A43D8CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7yHsGSgxXAQ7kNvwG1QyXA&_nc_oc=AdqAD3iiSwP6HWZMz-JB0DtCN2BUaI5hUAftxnj5SKTihXpfW7h4m9CDSIZ_IEj6XeA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dbN8WoKcR0HOhDd7UflWu5luTIhWTpTWL1BFG-3yWNA&oe=6A43BFE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd4Ntk05Y3IQ7kNvwHo9MwL&_nc_oc=AdrYeHcd_jnMjv-Bl4rOBryl99kTPUFiAXjWnC_FpQNwB6iRA95Wj0z8WVV-VwCAgmY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AMtCvTZF6rz-Ct5WTW3MrmIdsfIu_E3PsElI6nt337A&oe=6A43E31D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
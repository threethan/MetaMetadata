25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiwzKauTHq8Q7kNvwGFEQc-&_nc_oc=Ado1ZbaqakSjz6othM1hSxuoSbYtLdwaxa1iUFJfSPQfZR2TUcsUVGM6jdFKw86xsVQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_Y6TqF60V2ZjyY1aYKe8WzSECqgDqxBLzwJ0K0VlK6w&oe=6A24223E"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNX6ONjc-yoQ7kNvwGonoNj&_nc_oc=Adowy_6GI-DpI320IhDoYkCu2qzKYpub-L45I9prz1FOgCnWOK3L2_MYzQ6s7URNBp0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TaiQXw4NJ0nWgvs5ErewHG8joBz7qzDkmgM62Nj8vrQ&oe=6A243E94"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0b2o3XZeaQQ7kNvwGm5UwF&_nc_oc=Adpqq2apQpFPqW7wbwGWTRpyMFUtjLWQCXAzm-VUF7INNmgmsxiPFmJciS8tJ5GyD-g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cq0_Gqspn_ZbxOqUQfpJ0YYLu1vBtKno0ejMBmA70qQ&oe=6A2434CC"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i4d5JCjc6sQ7kNvwErRWfd&_nc_oc=Adp9Gwhj2kgfvZGkVGMZSCKiW2lO23iNC4C2Mcr_AiBnEKd6XkAp1RHIBU3W38lY8LM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aOt6yD0isJnbdOx8455gMEu5MqV5mcoYuiSrjmQrryg&oe=6A241BE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIuIhT3tPasQ7kNvwFZH9bM&_nc_oc=AdrLD-7y__vBhrLxqHXBYWDsfAi3n3jlEbhORHC6EZ7eI4AOpddl9CclHSzM0bdIjO0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j_CcIN3rCOFUEAQtghAu-Zh8BxTT-bD7ZynDk2EeMPA&oe=6A243F1D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
25/38974877_553835055705659_140279231473355809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TS8MXL1WV5gQ7kNvwFlq4W8&_nc_oc=AdrtxL3YxTzWb44bRue1t6VE3z-I1V0LBL3Hwtze05j8JKLOkKTX8QcUSudJcESwqdc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YYsrG0pou1IIi77IGFt5Kq5d3IDaY2YGCNaH6hP8AYA&oe=69EB71BE"}, {"file_name": "Nefertiti3.png", "id": "244872607579072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974794_244872610912405_8870294164653358943_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdG3eyE0CR8Q7kNvwHrmQGC&_nc_oc=Adooq1HzIX42t8yyZXmrBAy6Rnr0-AFYh3Nq_SdhW8cxU17WqXiMYTXBbE0IOVTvDXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sEPMqufdbCMthqHMIdpkBKUhNwqvzhaWVQY32M8O3gw&oe=69EB8E14"}, {"file_name": "Nefertiti5.png", "id": "545628826526516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_545628829859849_3377550233847649093_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAPDqUHd8vwQ7kNvwFiT0SX&_nc_oc=Ado8zt1L44Y6nwzRC9LWpDBPpJVI3deBn30pAYDiLuYUm3zcQKhSQ1kuzq2l86q9mz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jrG-yY3YjLHmkN5VrLJ6p3vaWVMurmHX31WWK2-BOWQ&oe=69EB844C"}, {"file_name": "Nefertiti4.png", "id": "1190505684770924", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974869_1190505688104257_8627156678085780526_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVjkeVfLUYcQ7kNvwGIFkDX&_nc_oc=AdriCTiR2F7flfb5dVkESPosHfoL10scmxopZa-QOZdv-ElVGzbAcwE8Tk3QVIBHpZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wM-_xYUD7dBVYxvmW3LQBUyjTO9aZ6KpZWZ0v_fsVNQ&oe=69EB6B60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "919971005276841", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_919971008610174_626687011779471710_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkPwRLx1AnQQ7kNvwGGGDYf&_nc_oc=AdqyC8u-LCoQNcmNe7vt0SkTXYDhn8_eT_BogSMjt42ZKKtRtW3h0b9ac6oLKc7i6Sw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Gx5h88bnwNYZY1OK66J-lJqBzlbyINBpg9esf9dty-Q&oe=69EB565D"}, "display_name": "Escape from Nefertiti's Tomb", "keywords": [], "long_description": "Escape from Nefertiti's Tomb is a single player VR puzzle and adventure game that is fun and challenging for the whole family. You\u2019ve fallen into the ancient tomb of the greatest Queen of Egypt. You\u2019re trapped! It\u2019s up to you as an explorer and archaeologist to uncover Nefertiti's secrets and escape your doom. With nothing but your brass lantern, your backpack, and your wits, you must solve the mysteries of the hidden temple.  Explore her tomb, find the exit and escape with your life to tell your tale of adventure, history, and fabulous jeweled riches.\n\nFeatures:\n- Experience a colorful, stylized re-imagining of an ancient Egyptian-themed tomb.\n- Explore and make your way through several distinct puzzle rooms.\n- Discover the solutions to puzzles specifically designed with the virtual reality experience in mind.\n- Seek out Queen Nefertiti\u2019s treasures by unlocking secret rooms and increasing your score.\n- Avoid traps left behind to stop unwanted guests from stealing her treasures.", "short_description": "Trapped in an ancient tomb, you must uncover Nefertiti's secrets to escape your doom. With nothing but your trusty brass lantern, backpack and wits, do you have what it will take to survive!"}]}, "developer_name": "WisEngineering's Digital Reality Lab", "developer_privacy_policy_url": "https://www.wisengineering.com/tombescape/nefertiti_privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WisEngineering LLC.", "support_website_url": null, "website_url": "https://www.wisengineering.com/tombescape", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}]
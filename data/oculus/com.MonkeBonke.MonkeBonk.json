nke temple deep in the jungle? It\u2019s calling your name. Are you just playing the game\u2014or is the game playing you?\n\n", "short_description": "play it its fun and you can a MONKE"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monke-bonke/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "offsale", "support_website_url": null, "website_url": "https://sites.google.com/view/monke-bonke/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9879396372148384"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820648_1415578836282032_7152939137888333382_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnx1S_MEk9sQ7kNvwGKwq7W&_nc_oc=Adn03Pv8a6G0D3xau6Lh2SRD2_nNt86yrM-1rLIUmrq5-H240_QWvPdaXJMzDNwL5zA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvY8TvGyiG7w_ZIM2avjpPKwcwg0VFzHqPXxK3SrWuOKg&oe=699B09B4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monk Bonk", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Hangout", "
udFRV6qxwKqSXL90w8M6MA7uDVUPzQwo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFDEy5korU9gVWZgafDpOoAoFJWSDXW3NUSVROhdkIOA&oe=6AC103FD"}, {"file_name": "image_010_0001.png", "id": "2927961667557759", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299051_2927961674224425_6637270177269710552_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAWldG1ezbMQ7kNvwHxcUf0&_nc_oc=AdppGIgaSmfh8dpVR2kxWk4pjOSieTN-CVZM1uDeQDnPku5eie57-2APfmIqHJH-3Oo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa7xGMgh302IjoDF5Y9eMaktAmGVpBUz_-brqM34tEww&oe=6AC132D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke's Territory", "keywords": ["Tag", "Fun", "Gorilla", "MonkesTerritory", "Fangame"], "long_description": "Grab your controllers and jump straight into Monke\u2019s Territory, a VR gorilla-locomotion playground packed with huge maps, custom game modes, and active multiplayer lobbies.\n\nMaps to Explore\nForest: Scale giant trees and swing through the canopy.\nMountains: High-elevation terrain made for huge leaps.\nPool: The go-to spot to hang out and cool off.\nHorror: Dark hallways, eerie vibes, and scary encounters.\nShop: Meet up with others and prepare for the next round.\nGame Modes & Mechanics\nGlass Bridge: Pick the right tile or take a long fall down.\nMonke Up: A vertical parkour test to see who can reach the top first.\nLazer Maze: Work your way through a grid of deadly lasers.\nPvP & Zero Gravity: Fight other players or mess around with zero-G physics.\nMultiplayer & Voice Chat\nBuilt-in proximity voice chat lets you talk with everyone in your lobby, team up for game modes, or just hang out.\n\nWhat\u2019s Next\nClassic Tag game modes are actively being built and will drop in a future update. The game looks great, though you might spot a few frame drops in certain dense areas while performance optimization is finished up.\n\nMonke's Territory will be updated a LOT over time and will get better and better!", "short_description": "Master the monke movement in Monke\u2019s Territory. Swing through the Forest, scale the Mountains, brave the Horror map, or chill by the Pool. Battle it out in PvP, dodge traps in Lazer Maze, survive Glass Bridge, or go airborne in Zero Gravity. Hang with friends using full voice chat and gear up in the Shop. Classic Tag mode is coming soon\u2014jump in now, give feedback, and help shape the game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monkesterritory/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "hxmpter", "support_website_url": null, "website_url": "https://sites.google.com/view/monkesterritory/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1318133038044980"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296236_1084171677629477_7737848683278881938_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSFILdTkL2sQ7kNvwExYVKN&_nc_oc=AdpnBuVCbfJs_ZDyD6yU3o3q6LcNIYEoLTtAjjP7im746PUbhMlm5LIIBgpQKeFElZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_rbLnmOpGZ7JHpxzziWhiCeP45A6xEBl9oK7Hcfb-ZA&oe=6AC10BBE"}, "is_concept": false, "is_
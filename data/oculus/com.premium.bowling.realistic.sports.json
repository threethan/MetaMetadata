ent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmVoKzlzwFImCSzfH36kjKQZXzbbwNDcqpXS06W17h4g&oe=6AFC6CAE"}, {"file_name": "screen_2560x1440_2026-09-13_14-25-40.png", "id": "1064350223091028", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673558985_1064350229757694_1442756806000062037_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mz7cWgUxeQsQ7kNvwE6aVQh&_nc_oc=AdpXdYYsxzOQHEhtf7yMIitalTs9KA6h6HgOGKU0geiEvT9uPx9kkmBeo6gRQ_2Jmmc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpamwgX8OxfkoofnlKu10_mABeYpiVk_OHoUuNwiQmxg&oe=6AFC834F"}, {"file_name": "screen_2560x1440_2026-09-13_14-26-33.png", "id": "1346301064245195", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_1346301067578528_3802021174638696089_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7maTHxSOKnAQ7kNvwH-X3Ed&_nc_oc=Adrtwa7b18KGoOjpzxlk_JEKfiHE3OoQRGQMt56z3UqBsSyqCpPhxF7AXUnStMw8yBk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO9nSYWvm2Jgyr6zXABJ5b39GGK3hmUHzshMc6dKnRIg&oe=6AFC6813"}, {"file_name": "screen_2560x1440_2026-09-13_14-43-12.png", "id": "1031735773023032", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604360590_1031735776356365_5823606933477867800_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTY7M6zNjU8Q7kNvwFP0LsE&_nc_oc=Adq2yhuF9b4ZMlCPMkV8C8et2DXhbImdiR-l6OAuMGWDu4gF-yP35KKyOs7vvwQ6_wc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpSOyW9T-00CJLs8KJcqU_a-RyM9ph7ehYba601WXLfw&oe=6AFC77E5"}, {"file_name": "screen_2560x1440_2026-09-13_14-27-43.png", "id": "1996608714328075", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831569_1996608720994741_49680806054466742_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt8xgH_vi10Q7kNvwEgK-v6&_nc_oc=Ado8ZHyCLdeqoUUCYecoHu4j8jq-ED5PrtIhZ7kt1ftmJI6lb3ykz8fCtzG4tHWQTnc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOnDGA3rIwQiJsBvsS9pYv-ebJF8oJcHyj3qpdxrvpxg&oe=6AFC7D7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Premium Bowling : Realistic Sports", "keywords": ["BowlingSimulator", "RealisticBowling", "TenPinBowling", "BowlingGame", "SportsSimulator"], "long_description": "Experience the excitement of realistic bowling in an immersive ten-pin sports simulator.\n\nPremium Bowling: Realistic Sports puts you directly on the lane for satisfying, skill-based bowling gameplay. Pick up the ball, line up your approach, control your release, and send it down the lane toward the pins. Every throw is an opportunity to improve your accuracy, score a strike, recover a spare, and work toward the perfect game.\n\nBuilt for players who enjoy bowling games, sports simulators, realistic physics, arcade sports, and classic ten-pin bowling, the experience is easy to understand but rewarding to master. Learn the lane, improve your timing, refine your aim, and become more consistent with every frame.\n\nFeel the satisfaction of clean strikes, tricky spare conversions, pin collisions, and high-score chasing in an immersive bowling alley made for Meta Quest. Whether you want a quick bowling session or want to keep improving your best score, the focus stays on the most important part: throwing the ball and knocking down pins.\n\nEnter the lane, find your line, and go for 300.\n", "short_description": "Step into realistic ten-pin bowling built for immersive sports gameplay. Line up your shot, roll the ball with natural VR motion, chase strikes, convert difficult spares, and push for a perfect score. Enjoy satisfying bowling physics, responsive controls, and the classic bowling alley experience in virtual reality.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1
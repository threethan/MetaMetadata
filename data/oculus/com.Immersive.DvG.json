0a&_nc_ohc=zVjUOsIQWzMQ7kNvwHUDzZr&_nc_oc=Adp3DqtAO-TdThYMNPXAbebhCM3p8Mro_BIGx5AIRfvfQR6-UOiCJ8-VhQm_M0y0us0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_R4RzlvkpbCvzE0VLV2JDsn76K2difP78-pPvTBev4g&oe=6B08671F"}, {"file_name": "ss_12.png", "id": "479040319752702", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974444_479040323086035_2768371168661997922_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwFbrnuMvYoQ7kNvwERj2j_&_nc_oc=Adpl3sH3rpWRv8F9zIyTXSJZYAPZuGJD7VHItuS6B-lMygIo1XizcUK2nmxfuxhnF7A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIxPQiR2WcuunRmAeaYmju6JNYKa05151CC5lT2e9r-A&oe=6B083E8B"}, {"file_name": "ss_9.png", "id": "2868145170098103", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974874_2868145176764769_7900599127612471879_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccXwwGhOQDsQ7kNvwE6-11s&_nc_oc=AdqnuT_8ywqlUop2sRnvZMS2RWvxQT5Rt_QMf6rGE-fr3Vi-3SmUms9l6-MDeiCqHK0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtC1ELmApM9ZZvGESmJJnfb7bvuPcZa-z8vk_7n9PBHQ&oe=6B086B98"}, {"file_name": "ss_5.png", "id": "1316414025380874", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974442_1316414028714207_6456012932754463444_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZVzLjvDURoQ7kNvwEpANEN&_nc_oc=Adqjx1VCvZQMHzrn_2eNAIBXKD9o2p3jLeJ9EaDadYFP4x5frWv2KkERHqJ-QEJxyMo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4QuI6Bhb22hkRVPginpS3XcD7FMq0mjitoi9YZMbtuw&oe=6B083C6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DvG : Conquering Giants Demo", "keywords": [], "long_description": "Prepare for the ultimate battle against the most notorious giant Goliath! DvG is an imaginative twist on the classic story of David versus Goliath. In this epic virtual reality game, YOU are the young shepherd boy on a journey to protect your sheep from the dangers of the outside world. You better be quick on your feet because there are lions and wolves and bears nearby! Armed with a simple yet powerful sling, you\u2019ll face challenges around every corner. They are sneaking through green pastures, lurking in the woods, and prowling in caves. If you defeat these foes, then you just might find yourself on the battlefield in the Valley of Ellah. There Goliath has threatened to destroy your family, lands, and nation. IF you can beat him in one-on-one combat, you will save them all. Can you sling your way to victory? Are you a \"mere\" shepherd boy, or are you a GIANT SLAYER? DvG is brought to you by Virtuous VR Gaming and Immersive History.", "short_description": "DvG is an imaginative twist on the classic story of David vs Goliath where you are the shepherd boy, armed with a simple, yet powerful sling, facing off versus the giant Goliath and all his minions."}]}, "developer_name": "ImmersiveHistory.com", "developer_privacy_policy_url": "https://dvgthegame.com/privacy", "developer_terms_of_service_url": "https://dvgthegame.com/termsofuse", "publisher_name": "Virtuous VR Gaming", "support_website_url": "https://dvgthegame.com/support", "website_url": "https://dvgthegame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3195287567411054"}}]}, "schedul
03440565252", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974689_277803443898585_7917104502155659337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDQGyCOciWYQ7kNvwHRpVo3&_nc_oc=Adr2P-ilfOMITJBfGUFd06iNQTUNlmBbfdEW60w7zQM-vHNwvKdn2w1moCrKYIA_H_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8nh-T7e1RVU3KqJtp9RHjTQ3CnSinP2dMnm91QCD9Sg&oe=6ACE651F"}, {"file_name": "ss_12.png", "id": "479040319752702", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_479040323086035_2768371168661997922_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkerEktRCcMQ7kNvwFH_PeH&_nc_oc=Adov1BzhaxF45F4XYgvqax6DSaqTSLngOqxlxz9M70v5HYt3BX_N5ObLHh9kUgg-Ils&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMb1JIyD9SIB63zDaG4fPuzHqPfXXxD0eCLsqnzRop98A&oe=6ACE3C8B"}, {"file_name": "ss_9.png", "id": "2868145170098103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974874_2868145176764769_7900599127612471879_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKuSLSbNJKQQ7kNvwFfekOo&_nc_oc=AdqUzfIZXglXI-0tZVx1tuDY5JcppYu655FhOvdzhYfliEJ884TzRRldBav4MoJIbI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD4a6IRJQpk1p9E8KaqyAIRXW1dB29js5ICHQHNJuqsA&oe=6ACE6998"}, {"file_name": "ss_5.png", "id": "1316414025380874", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974442_1316414028714207_6456012932754463444_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDi4DeY52YMQ7kNvwEGWR_7&_nc_oc=AdoDTbhCesJCO-ADbJ2S74g2TnMfdl80d0ifgTXVWkXlEfnaxOYUAA5oypDwWQjhtns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOp5kkKIqFLoD9yLJmck5wheZGS8iXI3FKwDA9gFEwLNQ&oe=6ACE3A6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DvG : Conquering Giants Demo", "keywords": [], "long_description": "Prepare for the ultimate battle against the most notorious giant Goliath! DvG is an imaginative twist on the classic story of David versus Goliath. In this epic virtual reality game, YOU are the young shepherd boy on a journey to protect your sheep from the dangers of the outside world. You better be quick on your feet because there are lions and wolves and bears nearby! Armed with a simple yet powerful sling, you\u2019ll face challenges around every corner. They are sneaking through green pastures, lurking in the woods, and prowling in caves. If you defeat these foes, then you just might find yourself on the battlefield in the Valley of Ellah. There Goliath has threatened to destroy your family, lands, and nation. IF you can beat him in one-on-one combat, you will save them all. Can you sling your way to victory? Are you a \"mere\" shepherd boy, or are you a GIANT SLAYER? DvG is brought to you by Virtuous VR Gaming and Immersive History.", "short_description": "DvG is an imaginative twist on the classic story of David vs Goliath where you are the shepherd boy, armed with a simple, yet powerful sling, facing off versus the giant Goliath and all his minions."}]}, "developer_name": "ImmersiveHistory.com", "developer_privacy_policy_url": "https://dvgthegame.com/privacy", "developer_terms_of_service_url": "https://dvgthegame.com/termsofuse", "publisher_name": "Virtuous VR Gaming", "support_website_url": "https://dvgthegame.com/support", "website_url": "https://dvgthegame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "u
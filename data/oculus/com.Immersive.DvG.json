03440565252", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974689_277803443898585_7917104502155659337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilio3nmho7AQ7kNvwF5IIOf&_nc_oc=AdqROrXQy2o4-LyODSnGBQZM0FHJ2lvsrf0z4per2_ClDkUnU0dy-Gx6cktVgDaexxE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ihcTEeqCQExloilKjSDkuYB1l8tZSlkwVegGiRA7-wA&oe=6A26BE5F"}, {"file_name": "ss_12.png", "id": "479040319752702", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974444_479040323086035_2768371168661997922_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_RkwQtGmH8Q7kNvwG_6kxg&_nc_oc=AdrXL_gEhpoQ0OkpsRsmHgE-w3sNyccyirAkUEqE4YMnel8ZRZimA6Gq-tX91rZTDxo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i78qVKMBsGGXooxEKi56MYB95e0KQJ6SyM4rQ2MNE9Q&oe=6A26CE0B"}, {"file_name": "ss_9.png", "id": "2868145170098103", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974874_2868145176764769_7900599127612471879_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oj3q-tFxHRAQ7kNvwEMgbiH&_nc_oc=Adopa1GmDglvuWXrasBFh6L53jXZhVbPjwW2Hj9VPqSt_7tTabW0KIhpjyD2acakF6I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QobjwHCex8OasdvHitKvkgd6eqXaMIn2vfJgCy4UXqQ&oe=6A26C2D8"}, {"file_name": "ss_5.png", "id": "1316414025380874", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974442_1316414028714207_6456012932754463444_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYEsRQJFqQMQ7kNvwEA-YLc&_nc_oc=AdoWdirpGfCf0j4mAUvGn-HXTnLt6OtfE_8Jq03N5TY5-YDFH6habfHFga-psq81_Nk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c4vCdeiT4CI-AFWqZuT1XLNG_LASwP7ITm_PlIiWEwQ&oe=6A26CBEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DvG : Conquering Giants Demo", "keywords": [], "long_description": "Prepare for the ultimate battle against the most notorious giant Goliath! DvG is an imaginative twist on the classic story of David versus Goliath. In this epic virtual reality game, YOU are the young shepherd boy on a journey to protect your sheep from the dangers of the outside world. You better be quick on your feet because there are lions and wolves and bears nearby! Armed with a simple yet powerful sling, you\u2019ll face challenges around every corner. They are sneaking through green pastures, lurking in the woods, and prowling in caves. If you defeat these foes, then you just might find yourself on the battlefield in the Valley of Ellah. There Goliath has threatened to destroy your family, lands, and nation. IF you can beat him in one-on-one combat, you will save them all. Can you sling your way to victory? Are you a \"mere\" shepherd boy, or are you a GIANT SLAYER? DvG is brought to you by Virtuous VR Gaming and Immersive History.", "short_description": "DvG is an imaginative twist on the classic story of David vs Goliath where you are the shepherd boy, armed with a simple, yet powerful sling, facing off versus the giant Goliath and all his minions."}]}, "developer_name": "ImmersiveHistory.com", "developer_privacy_policy_url": "https://dvgthegame.com/privacy", "developer_terms_of_service_url": "https://dvgthegame.com/termsofuse", "publisher_name": "Virtuous VR Gaming", "support_website_url": "https://dvgthegame.com/support", "website_url": "https://dvgthegame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "u
03440565252", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974689_277803443898585_7917104502155659337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhRVq_VCs_YQ7kNvwFXeV43&_nc_oc=AdrepLFM4f6jpGIvaS_NALZxphDzIF0dE50Au0CgY2vg3WD_j1FUxFpVeCv8zWWkXVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZTJ-zVr5AyNz4nEkKLUtoh69d9AoYLKbvVhoqhDBxrQ&oe=6AF4A09F"}, {"file_name": "ss_12.png", "id": "479040319752702", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_479040323086035_2768371168661997922_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmbMbfwqHikQ7kNvwHV6KQ3&_nc_oc=AdrSunWND4CvI-zAfeAkzXUUqlMtGo73tTRoIhgO6-NO-PYf7Jk2lQTI9UUFp8k2Ewo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw3VzRilokviKiHav7VM22Nr7k2rWp_Mhe3QItEC1o1A&oe=6AF4780B"}, {"file_name": "ss_9.png", "id": "2868145170098103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974874_2868145176764769_7900599127612471879_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWcHhEIq3iIQ7kNvwF9CSfR&_nc_oc=AdrIuwRuhusJO-OcTx3LFAHWHTi-_BBVCmYVNCuODdnLch8sd3dYRH45py9nnV7W5XI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUeQqcoxfnjzwb9njAvvdFBNdUO330raSCZJP9VzyWRg&oe=6AF4A518"}, {"file_name": "ss_5.png", "id": "1316414025380874", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974442_1316414028714207_6456012932754463444_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qk1eQzOogSsQ7kNvwGLF2LB&_nc_oc=AdoVCBeb5kyImU2fsnac69lKUFzLkPLQOW27SiS-UUmo_Efc8WHu85sUtBiX57Ax87Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6bPVzP7q22dQ-WyRM0F_mO9A6uxcwin10VAFYG-uewg&oe=6AF475EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DvG : Conquering Giants Demo", "keywords": [], "long_description": "Prepare for the ultimate battle against the most notorious giant Goliath! DvG is an imaginative twist on the classic story of David versus Goliath. In this epic virtual reality game, YOU are the young shepherd boy on a journey to protect your sheep from the dangers of the outside world. You better be quick on your feet because there are lions and wolves and bears nearby! Armed with a simple yet powerful sling, you\u2019ll face challenges around every corner. They are sneaking through green pastures, lurking in the woods, and prowling in caves. If you defeat these foes, then you just might find yourself on the battlefield in the Valley of Ellah. There Goliath has threatened to destroy your family, lands, and nation. IF you can beat him in one-on-one combat, you will save them all. Can you sling your way to victory? Are you a \"mere\" shepherd boy, or are you a GIANT SLAYER? DvG is brought to you by Virtuous VR Gaming and Immersive History.", "short_description": "DvG is an imaginative twist on the classic story of David vs Goliath where you are the shepherd boy, armed with a simple, yet powerful sling, facing off versus the giant Goliath and all his minions."}]}, "developer_name": "ImmersiveHistory.com", "developer_privacy_policy_url": "https://dvgthegame.com/privacy", "developer_terms_of_service_url": "https://dvgthegame.com/termsofuse", "publisher_name": "Virtuous VR Gaming", "support_website_url": "https://dvgthegame.com/support", "website_url": "https://dvgthegame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "u
03440565252", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974689_277803443898585_7917104502155659337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HI_gy_KJfiYQ7kNvwF1Psp6&_nc_oc=AdomfSW_UDX58uuX4DBJw3gZX2eABzZN4gODphOLtQq3rNGtzYruwiM225gAqGlHE5M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKLRJIN4CSypqaR-oqTjVXIPkdyvRupYaXUJ94Z6L0qQ&oe=6AF0AC1F"}, {"file_name": "ss_12.png", "id": "479040319752702", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974444_479040323086035_2768371168661997922_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3w5sWgWrpEQQ7kNvwGejd76&_nc_oc=AdoLY784DjPYwiY0sINztkiwPLF8OMtbMZ0y7w_piO-gM4fxdf4T46yRWZaKYXU1RCk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1eI50O2sRXJSVaEaJrH_E7exWvg5SlcCPPOETxDoxGA&oe=6AF0838B"}, {"file_name": "ss_9.png", "id": "2868145170098103", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974874_2868145176764769_7900599127612471879_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cx7_tmurS_AQ7kNvwFjggs5&_nc_oc=AdqqG9WhRZhubpDVPZK6Z-bUJJghZ9S9Zm8OGjQOa9hXh_bzQFhWsgxCLyPHXQzHW8Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO9naBkbr-j5Ggi8CogbHUNZLbiGsrGmtaUUzRA0ZzFg&oe=6AF0B098"}, {"file_name": "ss_5.png", "id": "1316414025380874", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974442_1316414028714207_6456012932754463444_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saws9JEDkE0Q7kNvwHYAZvM&_nc_oc=Adqk1bMC0taF_n-668hyW9QOXFVehYYJ7RuayV69eX9eAbldTBKJNc9a9B6pfuMeR6k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8yY79k0nNQPIdB12BIt_nBj4kpEtAO28K-X5vufmopA&oe=6AF0816F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DvG : Conquering Giants Demo", "keywords": [], "long_description": "Prepare for the ultimate battle against the most notorious giant Goliath! DvG is an imaginative twist on the classic story of David versus Goliath. In this epic virtual reality game, YOU are the young shepherd boy on a journey to protect your sheep from the dangers of the outside world. You better be quick on your feet because there are lions and wolves and bears nearby! Armed with a simple yet powerful sling, you\u2019ll face challenges around every corner. They are sneaking through green pastures, lurking in the woods, and prowling in caves. If you defeat these foes, then you just might find yourself on the battlefield in the Valley of Ellah. There Goliath has threatened to destroy your family, lands, and nation. IF you can beat him in one-on-one combat, you will save them all. Can you sling your way to victory? Are you a \"mere\" shepherd boy, or are you a GIANT SLAYER? DvG is brought to you by Virtuous VR Gaming and Immersive History.", "short_description": "DvG is an imaginative twist on the classic story of David vs Goliath where you are the shepherd boy, armed with a simple, yet powerful sling, facing off versus the giant Goliath and all his minions."}]}, "developer_name": "ImmersiveHistory.com", "developer_privacy_policy_url": "https://dvgthegame.com/privacy", "developer_terms_of_service_url": "https://dvgthegame.com/termsofuse", "publisher_name": "Virtuous VR Gaming", "support_website_url": "https://dvgthegame.com/support", "website_url": "https://dvgthegame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "u
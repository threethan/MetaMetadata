1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfbLnFWZmYnrQaV-fdQcNfLL0Lb25J2AiAayXn9B0aiw&oe=6A5B8A0B"}, {"file_name": "ss_9.png", "id": "2868145170098103", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974874_2868145176764769_7900599127612471879_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkvnP-mzxe4Q7kNvwEU2BQO&_nc_oc=AdoKIzaEye43fXfrf1wFKDaqfpMwDbQzzpSaiMOWZDTPSMnlhjiQoZ8mnuvqpkw-yn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8dvTvjnj8xeJHGJzNCYUcVhJP0qDcGQ0wmLgV_Hi6Qw&oe=6A5B7ED8"}, {"file_name": "ss_5.png", "id": "1316414025380874", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974442_1316414028714207_6456012932754463444_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYnFpTb3UukQ7kNvwGRcw9V&_nc_oc=AdplTWixJpcTMkDdJYS11tlvoJNoe_LbnJuFgsdH3PkyeWz457WQZGN4nyd05MPhfOk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGVoD2KfjakWyZH-bUXfNhfM7yec0uUnPBwGGZrb_s7Q&oe=6A5B87EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DvG : Conquering Giants Demo", "keywords": [], "long_description": "Prepare for the ultimate battle against the most notorious giant Goliath! DvG is an imaginative twist on the classic story of David versus Goliath. In this epic virtual reality game, YOU are the young shepherd boy on a journey to protect your sheep from the dangers of the outside world. You better be quick on your feet because there are lions and wolves and bears nearby! Armed with a simple yet powerful sling, you\u2019ll face challenges around every corner. They are sneaking through green pastures, lurking in the woods, and prowling in caves. If you defeat these foes, then you just might find yourself on the battlefield in the Valley of Ellah. There Goliath has threatened to destroy your family, lands, and nation. IF you can beat him in one-on-one combat, you will save them all. Can you sling your way to victory? Are you a \"mere\" shepherd boy, or are you a GIANT SLAYER? DvG is brought to you by Virtuous VR Gaming and Immersive History.", "short_description": "DvG is an imaginative twist on the classic story of David vs Goliath where you are the shepherd boy, armed with a simple, yet powerful sling, facing off versus the giant Goliath and all his minions."}]}, "developer_name": "ImmersiveHistory.com", "developer_privacy_policy_url": "https://dvgthegame.com/privacy", "developer_terms_of_service_url": "https://dvgthegame.com/termsofuse", "publisher_name": "Virtuous VR Gaming", "support_website_url": "https://dvgthegame.com/support", "website_url": "https://dvgthegame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3195287567411054"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "721206447186288"}, {"status": "PUBLISHED", "id": "166899605275526"}]}, "baseline_offer": {"id": "166899605275526"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "721206447186288"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4027306673996217", "version": "1.2.10"}, "id": "223677646100142", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "b
03440565252", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974689_277803443898585_7917104502155659337_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDQGyCOciWYQ7kNvwEQC7ab&_nc_oc=AdrQtDucvfoKQyAQsI9S7qt9Jf9hApm0W5dvWvZTEsLPyvkgx9ilIOXCD9UvUM8-YQE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0go8VIqvDoKzzopzFP6uGbelo6jpo2XOyMK9wTenk_w&oe=6ACD139F"}, {"file_name": "ss_12.png", "id": "479040319752702", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_479040323086035_2768371168661997922_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FD1MjIWWoYQ7kNvwGX7cUF&_nc_oc=AdrPhalemY6z6DSHYPtWdIPU-6bxT0CxhBCID1B5dJkk5CM431Z9h7RVrq-Vpcg5hZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwLkdNMX6Ch3YX9KdcjdruPeWOD5iUJQsPcpZfevB0eA&oe=6ACCEB0B"}, {"file_name": "ss_9.png", "id": "2868145170098103", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974874_2868145176764769_7900599127612471879_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKuSLSbNJKQQ7kNvwFSYCGU&_nc_oc=AdraQDZdd4Hh6hu5yYWR-4rJN7ClWjdtj10oynHL7e7pnmJHtyV4jkxbgyDj4tNTYSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3pB5AEXZD1swlu_P0YMIK7xTcavqmG9vzSSNSxSpk1A&oe=6ACD1818"}, {"file_name": "ss_5.png", "id": "1316414025380874", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974442_1316414028714207_6456012932754463444_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDi4DeY52YMQ7kNvwHBNwd7&_nc_oc=AdrG1FsXFFp1L4ZKKfKC6vyGlvXRrQQsWM5gWCvi_6nVztkqqvctu-OFpa7azTaGcLA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBIB23P1T20RAxnFqp4e1_THHC30FBzWSAJlomArPA0Q&oe=6ACCE8EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DvG : Conquering Giants Demo", "keywords": [], "long_description": "Prepare for the ultimate battle against the most notorious giant Goliath! DvG is an imaginative twist on the classic story of David versus Goliath. In this epic virtual reality game, YOU are the young shepherd boy on a journey to protect your sheep from the dangers of the outside world. You better be quick on your feet because there are lions and wolves and bears nearby! Armed with a simple yet powerful sling, you\u2019ll face challenges around every corner. They are sneaking through green pastures, lurking in the woods, and prowling in caves. If you defeat these foes, then you just might find yourself on the battlefield in the Valley of Ellah. There Goliath has threatened to destroy your family, lands, and nation. IF you can beat him in one-on-one combat, you will save them all. Can you sling your way to victory? Are you a \"mere\" shepherd boy, or are you a GIANT SLAYER? DvG is brought to you by Virtuous VR Gaming and Immersive History.", "short_description": "DvG is an imaginative twist on the classic story of David vs Goliath where you are the shepherd boy, armed with a simple, yet powerful sling, facing off versus the giant Goliath and all his minions."}]}, "developer_name": "ImmersiveHistory.com", "developer_privacy_policy_url": "https://dvgthegame.com/privacy", "developer_terms_of_service_url": "https://dvgthegame.com/termsofuse", "publisher_name": "Virtuous VR Gaming", "support_website_url": "https://dvgthegame.com/support", "website_url": "https://dvgthegame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "u
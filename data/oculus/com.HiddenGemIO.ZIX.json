_11030521955594714_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrDk1wysrCAQ7kNvwGCYWUB&_nc_oc=AdoluuiGmdQJikj4XX8d2FFlMKoHgGTwX1tPK-JVjf6iTrQbBDYS5ePXDkym3YIyJy4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnNBjD4pHqwHvS5lqL41H-5kvPvuySLQUP58nNsIsDLw&oe=6AFB41E1"}, {"file_name": "image_006_0006_upscayl_2560px_realesrgan-x4plus-anime.png", "id": "1676165326283289", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974827_1676165329616622_7449486730581109252_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrgBax-T46AQ7kNvwGXkWsd&_nc_oc=AdoPpj7hvZc9kGIiuzT-xCjF-LUrsaaDlnyNp6t77q5ZWZUO98HBSGuzX3ludgpsCkE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVFrmoheWkIHX2Rf3CAZww76u7iHbBXdzRXKIEQoqG6w&oe=6AFB3AA3"}, {"file_name": "2024-11-12 20-40-05 - frame at 0m28s.png", "id": "607887138338570", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569440_607887141671903_7110552881332325886_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT3CFRFEeCIQ7kNvwHPU4J3&_nc_oc=AdpEajmZUYyffaJMs6EFSc5Np9q0n5NSj1opluF4IJcdJHThCDTCuIiCUNZERRkLxu0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL4h_o5ErHvu7uYyjt_bsrw6fL55O152wxj5NjUzrx-g&oe=6AFB29F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ZIX", "keywords": ["Roguelike", "Cooperative", "Roguelite", "Action", "Adventure"], "long_description": "# BECOME AN ACOLYTE OF ZIX AND SPREAD THE FLAME\n\nZIX is a VR action roguelike with a deep combat system and a player-driven procedural world generation system. Team up with friends across platforms as you remix runs and alter reality to uncover the mysteries of ZIX.\n\n{3917457575153114}\n\n# FEATURES\n\n- Play alone or with up to 2 friends \n- Allow PC players to join you as spectator Imps to cause mayhem\n- Engage in roguelike gameplay with endless combinations and replayability\n- Mix worlds together using The Cauldron and uncover their secrets\n- Express yourself with a deep, varied combat system using natural-feeling controls \n- Fight 20+ different enemies across 3 worlds\n- Find 30+ stacking upgrades that change your playstyle\n- Unlock 10+ totally new abilities to change your kit dramatically\n\n\n", "short_description": "ZIX is a VR action roguelike with a deep combat system and a player-driven procedural world generation system. Team up with friends across platforms as you remix runs and alter reality to uncover the mysteries of ZIX.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hiddengem.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hidden IO Inc.", "support_website_url": null, "website_url": "https://www.hiddengem.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "1142980466364442"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "4041374392792010"}, {"status": "PUBLISHED", "id": "1267073211496761"}, {"status": "PUBLISHED", "id": "2114670942485925"}, {"status": "PUBLISHED", "id": "1381695376843112"}, {"status": "PUBLISHED", "id": "1711976979857612"}, {"status": "PUBLISHED", "id": "1368807688460791"}, {"status": "PUBLISHED", "id": "27332915369682581"}, {"status": "PUBLISHED", "id": 
f20f&oh=00_Af_IT-PbXSIp_G_gCx3NcobUzsYUhCP_d0nytD3csx3K4Q&oe=6A244A4D"}, {"file_name": "Screenshot 2-jumping.png", "id": "1015068893898476", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825083_1015068897231809_784367635513385804_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-Qtp8bII4IQ7kNvwGjGnX7&_nc_oc=AdpZnZ57pORWXzHNn5XgBTMYfDZ3gRBe7Lc3SR6ss6oo_Kb0r5IoMslLrIDegTaaHCI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hveuzbQFguG_8gS0ES4v8xDTg3jtMJ0BEL23g4DpMcw&oe=6A24282D"}, {"file_name": "grove-3rd-person-AND-cool-jump-shot-at-end - frame at 0m26s.png", "id": "654938370395337", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393469_654938373728670_5946595003432763971_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Hl_Y2EK8LUQ7kNvwG_u-uM&_nc_oc=AdpZWnzu1FsZp4MUTuYjR_J69Rx7Wc9aC1JVa8ZOEtVocnqnpr008GSa_kiKFd39ink&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RiRe28_kKAXRk21okrFiroA266Hl1avfJ_2eHuwsMLQ&oe=6A24239F"}, {"file_name": "praise-zix.png", "id": "1945559006281305", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822779_1945559009614638_3705891368739998820_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIHNNhI3VvQQ7kNvwGcWImA&_nc_oc=AdrQT2-FmnZ7KKhCmqHpWoAYrxxRd9NIaEfCcKYazCh9r7J8QBp1gs6nsQpDTSvi5-Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BmYFhxllgoDB8ecagLldgTgHrKXX9OFk7Vp06YIfzMg&oe=6A242DEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZIX_YT-COVER-launch-trailer-2560.png", "id": "1575255143655361", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618102_1575255146988694_725363410658856442_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHsDzgJVr1gQ7kNvwGkTZxE&_nc_oc=AdpTWV00otCroV37UxQRxLTorjTOR7eSkxYgNjrZ6G18ynw8yjCSlHFgNA00oNjXGoY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xtB6sICXTJFky-4WLXtQ5IiHY5Ngcv0UoNgAUJTujJg&oe=6A242281"}, "display_name": "ZIX", "keywords": ["Rogue", "Gun", "Sword", "Multiplayer", "surreal"], "long_description": "# WELCOME TO ZIX - EARLY ACCESS\n\n**ZIX is a VR action roguelike** with a **deep combat system** and a **player-driven procedural world generation system**. **Team up with friends across platforms** as you remix runs and alter reality to uncover the mysteries of ZIX.\n\n# \ud83e\uddea MIX THE WORLD\n{1442570757154462}\nHarvest blessings from three strange worlds and fuse them together, creating your next trial. The ingredients don't just tweak numbers, they warp the fabric of reality. \n\nWith **millions of possible combinations**, no two runs play the same.\n\n# \u270b THE FIRST INSTINCT SYSTEM\n{1806054060315435}\n**First Instinct** is ZIX\u2019s custom-built movement & combat system. You\u2019ll dash, wall-run, block, and hurl weapons using just two triggers and gestures that echo your intentions.\nNo face buttons. No menus. Nothing to distract you and break the trance.\n\n# \ud83d\udee0\ufe0f REMIX YOURSELF\n{2806752383047848}\nEach run grants divine augments that rewire how you fight.\nTeleport to thrown blades, shatter reality with explosive dashes, or rain precision arrows from above. Customize your look with arcane attachments and ritual markings.\n\n# \ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1 BRING FRIENDS (OR DON\u2019T)\n{572617005408142}\n**Play solo or in seamless 3-player co-op.**\nCoordinate wild builds and face the chaos together\u2014or apart. ZIX bends to your party\u2019s will.\n\n# \ud83e\udde9 UNRAVEL WHAT\u2019S HIDDEN\n{1187321869857225}\nSymbols. Glitches. Secret paths.\n\n**ZIX isn\u2019t just a roguelike, it\u2019s a mystery waiting to be stirred.**\n\n\n\n\n\n\n", "short_description": "ZIX is a VR action roguelike with a deep combat system and a player-driven procedural world generation system. Team up with friends across platforms as you remix runs and alter reality to uncover the mysteries of ZIX.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "
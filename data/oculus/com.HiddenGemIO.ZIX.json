_11030521955594714_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HASazodpLwIQ7kNvwFv9fOU&_nc_oc=AdpFXiHOEj-XJK1MsJg5sDZcVojaZkF5a9VuJEiNePGDJlW2h0aX81w8IjM9eSMc_1o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUNQUUTq53T35nMaiz_iWXcxITXMmqdOHkhwVezKbwZw&oe=6B032AE1"}, {"file_name": "image_006_0006_upscayl_2560px_realesrgan-x4plus-anime.png", "id": "1676165326283289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974827_1676165329616622_7449486730581109252_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1eNN9l3jsoQ7kNvwHtY4JB&_nc_oc=AdrWG6BDkUq_vNyohVZgLbf14O-dWiu6c_DCwX40c4q6Sjo0PEuW019MzPsQkSZQKfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyOVgG7YsagGc4BaRmHeuQ0ybZBGngkeXYLuN2XyFThA&oe=6B0323A3"}, {"file_name": "2024-11-12 20-40-05 - frame at 0m28s.png", "id": "607887138338570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569440_607887141671903_7110552881332325886_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1jK0HvKpuYQ7kNvwHWPAOa&_nc_oc=AdpnxG9iQ1oGfG0nv4iSnTAMAJ8fv7ntYxFAsUfDxCgc9xMavM17DnjDD8npNkGET2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMI5u-Pw9L_gdF3Qq1qWjHKYm9GMTIfbqboD-b8i0bVA&oe=6B0312F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ZIX", "keywords": ["Roguelike", "Cooperative", "Roguelite", "Action", "Adventure"], "long_description": "# BECOME AN ACOLYTE OF ZIX AND SPREAD THE FLAME\n\nZIX is a VR action roguelike with a deep combat system and a player-driven procedural world generation system. Team up with friends across platforms as you remix runs and alter reality to uncover the mysteries of ZIX.\n\n{3917457575153114}\n\n# FEATURES\n\n- Play alone or with up to 2 friends \n- Allow PC players to join you as spectator Imps to cause mayhem\n- Engage in roguelike gameplay with endless combinations and replayability\n- Mix worlds together using The Cauldron and uncover their secrets\n- Express yourself with a deep, varied combat system using natural-feeling controls \n- Fight 20+ different enemies across 3 worlds\n- Find 30+ stacking upgrades that change your playstyle\n- Unlock 10+ totally new abilities to change your kit dramatically\n\n\n", "short_description": "ZIX is a VR action roguelike with a deep combat system and a player-driven procedural world generation system. Team up with friends across platforms as you remix runs and alter reality to uncover the mysteries of ZIX.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hiddengem.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hidden IO Inc.", "support_website_url": null, "website_url": "https://www.hiddengem.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "1142980466364442"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "2114670942485925"}, {"status": "PUBLISHED", "id": "1381695376843112"}, {"status": "PUBLISHED", "id": "1711976979857612"}, {"status": "PUBLISHED", "id": "1368807688460791"}, {"status": "PUBLISHED", "id": "27332915369682581"}, {"status": "PUBLISHED", "id": "1541363627664395"}, {"status": "PUBLISHED", "id": "1503119988089242"}, {"status": "PUBLISHED", "id": 
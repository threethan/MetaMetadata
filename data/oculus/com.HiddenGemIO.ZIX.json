f20f&oh=00_Af7uFF59N__oiy0BwKVouWHaYjzjTfBCAkPpKyLL9a0K_w&oe=6A09B40D"}, {"file_name": "Screenshot 2-jumping.png", "id": "1015068893898476", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491825083_1015068897231809_784367635513385804_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd_t5Pr7Z6MQ7kNvwGf23IS&_nc_oc=Adr5Ehu9iK8GOzdUhhblaVMwAFKRLiLsxlk2s4CGlrrPB7w7gRcrU6YOph31ZjgjSl0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MEfxioW2KF4-Rwbc8hcrwaNsACaAkHMrDvrrrh62UZg&oe=6A09CA2D"}, {"file_name": "grove-3rd-person-AND-cool-jump-shot-at-end - frame at 0m26s.png", "id": "654938370395337", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393469_654938373728670_5946595003432763971_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSCTvXiEouUQ7kNvwEOpQ-D&_nc_oc=AdpesJAHWuJ8yt0kN5pvuJan2eyJflHVnl1qhmi_IAdqVZJhVI2wWz3e-WylQYQ8SdU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KK3ERc_Tuc96gv28XWZxQPh29_KQNR5WV7c_rBD61aw&oe=6A09C59F"}, {"file_name": "praise-zix.png", "id": "1945559006281305", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822779_1945559009614638_3705891368739998820_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FG3ha39TIMQQ7kNvwGhUAcJ&_nc_oc=Ado9IX21pHgJxeQgDLsW1U8-sptwtGXpljq3xgjGG_RptF-NYG4Sf2uYA8rR6eFnQhA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PC4jJy4WY4WvcFsOsOMkkJBkSBr-1rtkvVQ33KjMMXg&oe=6A09CFEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZIX_YT-COVER-launch-trailer-2560.png", "id": "1575255143655361", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618102_1575255146988694_725363410658856442_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vh3r5X-lQk8Q7kNvwESkHzo&_nc_oc=AdqrQDUy8HNJt6sNQSBjbFmbwUxaSjT5peI5WRALCOdKMooDbrclBCqsuVgFn2moabk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JOUnI5YoKQnr6c2hVWKIZdH-RV2Dk1ey6eL5ucHBXIw&oe=6A09C481"}, "display_name": "ZIX", "keywords": ["Rogue", "Gun", "Sword", "Multiplayer", "surreal"], "long_description": "# WELCOME TO ZIX - EARLY ACCESS\n\n**ZIX is a VR action roguelike** with a **deep combat system** and a **player-driven procedural world generation system**. **Team up with friends across platforms** as you remix runs and alter reality to uncover the mysteries of ZIX.\n\n# \ud83e\uddea MIX THE WORLD\n{1442570757154462}\nHarvest blessings from three strange worlds and fuse them together, creating your next trial. The ingredients don't just tweak numbers, they warp the fabric of reality. \n\nWith **millions of possible combinations**, no two runs play the same.\n\n# \u270b THE FIRST INSTINCT SYSTEM\n{1806054060315435}\n**First Instinct** is ZIX\u2019s custom-built movement & combat system. You\u2019ll dash, wall-run, block, and hurl weapons using just two triggers and gestures that echo your intentions.\nNo face buttons. No menus. Nothing to distract you and break the trance.\n\n# \ud83d\udee0\ufe0f REMIX YOURSELF\n{2806752383047848}\nEach run grants divine augments that rewire how you fight.\nTeleport to thrown blades, shatter reality with explosive dashes, or rain precision arrows from above. Customize your look with arcane attachments and ritual markings.\n\n# \ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1 BRING FRIENDS (OR DON\u2019T)\n{572617005408142}\n**Play solo or in seamless 3-player co-op.**\nCoordinate wild builds and face the chaos together\u2014or apart. ZIX bends to your party\u2019s will.\n\n# \ud83e\udde9 UNRAVEL WHAT\u2019S HIDDEN\n{1187321869857225}\nSymbols. Glitches. Secret paths.\n\n**ZIX isn\u2019t just a roguelike, it\u2019s a mystery waiting to be stirred.**\n\n\n\n\n\n\n", "short_description": "ZIX is a VR action roguelike with a deep combat system and a player-driven procedural world generation system. Team up with friends across platforms as you remix runs and alter reality to uncover the mysteries of ZIX.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "
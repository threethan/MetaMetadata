f20f&oh=00_Af6-WYr1Xiqx1WSEI-cR-QuagAVEYSSvxPgiCvA56niNUA&oe=6A0DA88D"}, {"file_name": "Screenshot 2-jumping.png", "id": "1015068893898476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825083_1015068897231809_784367635513385804_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnYHR-MDIcYQ7kNvwH5jhLU&_nc_oc=Adqa1EV8k51nFdhxWF0kVmiZEtxWOLtWgcC3Zt5ZgVxSDrly4LaarE2olui9bMWsH3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76fbK4NAMxQa799yrsBe1mczdkrw0QL58Z2SsAHWvGdw&oe=6A0DBEAD"}, {"file_name": "grove-3rd-person-AND-cool-jump-shot-at-end - frame at 0m26s.png", "id": "654938370395337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393469_654938373728670_5946595003432763971_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPLmV8nosv0Q7kNvwEOSON4&_nc_oc=AdqeKITh3s2xjg5etP6zh7ltOwhIqCiCYoKsHqSFLlG5E3QUPJZtK28IDinl8aOACI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U3RrAUkAFVxePFAcc_7R2GUMqPjmwOelRIu8fy1iGCg&oe=6A0DBA1F"}, {"file_name": "praise-zix.png", "id": "1945559006281305", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822779_1945559009614638_3705891368739998820_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Xx5Giwp05AQ7kNvwHLeMEi&_nc_oc=AdogV0um1Bf95a_lohiamXm69-ggX3sE4z288elMh_W_s2epaYKS7jxHfa2kr3_37F4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e2NNsiUeU5B5HqSl5UGchNixC5TIs49E6d3hYaEIicQ&oe=6A0DC46F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZIX_YT-COVER-launch-trailer-2560.png", "id": "1575255143655361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_1575255146988694_725363410658856442_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szmsyLE3IoIQ7kNvwEt4Itw&_nc_oc=Adp_k1wTYv4Aiw4dIyc7dds4gl7PMfLCVKsJ30S89sMTX50rZCJV1EqzaIot5Nad9oc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yLOIKhr7X5e7RNodhSf93vJJJyHTCv2seQLNOg_lgCg&oe=6A0DB901"}, "display_name": "ZIX", "keywords": ["Rogue", "Gun", "Sword", "Multiplayer", "surreal"], "long_description": "# WELCOME TO ZIX - EARLY ACCESS\n\n**ZIX is a VR action roguelike** with a **deep combat system** and a **player-driven procedural world generation system**. **Team up with friends across platforms** as you remix runs and alter reality to uncover the mysteries of ZIX.\n\n# \ud83e\uddea MIX THE WORLD\n{1442570757154462}\nHarvest blessings from three strange worlds and fuse them together, creating your next trial. The ingredients don't just tweak numbers, they warp the fabric of reality. \n\nWith **millions of possible combinations**, no two runs play the same.\n\n# \u270b THE FIRST INSTINCT SYSTEM\n{1806054060315435}\n**First Instinct** is ZIX\u2019s custom-built movement & combat system. You\u2019ll dash, wall-run, block, and hurl weapons using just two triggers and gestures that echo your intentions.\nNo face buttons. No menus. Nothing to distract you and break the trance.\n\n# \ud83d\udee0\ufe0f REMIX YOURSELF\n{2806752383047848}\nEach run grants divine augments that rewire how you fight.\nTeleport to thrown blades, shatter reality with explosive dashes, or rain precision arrows from above. Customize your look with arcane attachments and ritual markings.\n\n# \ud83e\uddd1\u200d\ud83e\udd1d\u200d\ud83e\uddd1 BRING FRIENDS (OR DON\u2019T)\n{572617005408142}\n**Play solo or in seamless 3-player co-op.**\nCoordinate wild builds and face the chaos together\u2014or apart. ZIX bends to your party\u2019s will.\n\n# \ud83e\udde9 UNRAVEL WHAT\u2019S HIDDEN\n{1187321869857225}\nSymbols. Glitches. Secret paths.\n\n**ZIX isn\u2019t just a roguelike, it\u2019s a mystery waiting to be stirred.**\n\n\n\n\n\n\n", "short_description": "ZIX is a VR action roguelike with a deep combat system and a player-driven procedural world generation system. Team up with friends across platforms as you remix runs and alter reality to uncover the mysteries of ZIX.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "
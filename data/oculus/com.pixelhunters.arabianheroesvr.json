 released his corrupted crows to invade the planet. Hopefully, the Arabian Heroes family is there to protect and have an unlimited supply of jelly to shoot the crows. But they are coming from everywhere and are harder to defeat!"}]}, "developer_name": "Pixelhunters", "developer_privacy_policy_url": "https://www.pixelhunters.com/arabian-heroes-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "E.N.D. Entertainment", "support_website_url": "https://www.arabianheroes.com/", "website_url": "https://www.pixelhunters.com/arabian-heroes-vr-game", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "317804100471889"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_498941708328069_791031045871435918_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxHtMrzP57gQ7kNvwGcherD&_nc_oc=Adn8-w5poDfvbNkjMAJU36S0oFTlf8ybjenPb6e8abQFGKxAbzOtJapvQqwva7yGHcw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afws_Ds670oB6gUKe49GuMMCMF5KoZEeDIy5Pw_mRMjVUA&oe=69B40176"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Arabian Heroes", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "S
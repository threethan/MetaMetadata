.com/v/t64.5771-25/791586454_2166767753879022_4391083053812366437_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmrFsrbdi54Q7kNvwEE9yTM&_nc_oc=AdoyV_TKOc3Muz-BURgc7JpKRWzJPFZCU-imLve-hQ4z6H5IDd9PiKxb-xE-wS1E43w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnxMm0zsGTF6OtVAXVeuMWX9593rK9QeVIf0bv_YLBGw&oe=6AFB2B43"}, {"file_name": "3q.png", "id": "1106482755359946", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595129854_1106482758693279_2710567250162741111_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o0-2ks2Nv8Q7kNvwEhgtVk&_nc_oc=Adr464EBGqUimIFSSMCLiXoTswvPGP3eykMbtujQ8e19WTUG6IextNR-0Ql6m9QxRgc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVBl9enIcA5oPCWBYJrK8RzCsEuNDdBExEa22hCwWGxw&oe=6AFB28A9"}, {"file_name": "1q.png", "id": "2137309930220248", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830576_2137309933553581_8138039294207092197_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XL6RsXZMs4gQ7kNvwGiM0uD&_nc_oc=Adpk8-6LT4mMLLGG6Cwt9xh-1btiv4EM9iV1Vm7XaoyTDf-OKoAAjTuPhk6s2s_PzOg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaihlM3zOoHxv9kDUZ_CpUe_Rc-qGZhOwc6zeVg3yD2A&oe=6AFB1CB6"}, {"file_name": "6q.png", "id": "1159400109984397", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595112037_1159400113317730_2122543152907261483_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AT0WQEOLrd4Q7kNvwEM5DNq&_nc_oc=AdrFkqEXfV4kUyf3AYrCJienigEiqkusnyxVHQOgLwmTTpWZwfblZyvyfU67OTDP6vQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTavye_gO7m5lahQEHg_IAm3aKTiBItCZuX5z6XmE1YYA&oe=6AFB3ABF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grow Garden Farming Simulator VR", "keywords": ["FarmingSimulator", "GrowGarden", "GrowGardenFarmingSimulator", "GardenFarmingSimulatorVR"], "long_description": "Welcome to Grow Garden Farming Simulator VR, a simple and enjoyable virtual farming experience where you can perform different farming activities across multiple levels.\n\nIn Grow Garden Farming Simulator VR, start by preparing the land and plowing the soil. Use the farming tools to make the ground ready for planting and complete each task step by step.\n\nGrow Garden Farming Simulator VR lets you work with the land, use the harrow, plant wheat, and provide water to your growing crops.\n\nComplete different farming tasks and progress through multiple levels. Every level gives you a new farming objective to complete.\n\nWith Grow Garden Farming Simulator VR, you can experience the basic steps of growing crops in an interactive VR environment.\n\nPrepare the soil, plow the field, use the harrow, plant wheat, water the crops, and complete your farming missions.\n\nGrow Garden Farming Simulator VR is designed with simple gameplay and easy-to-understand farming tasks.\n\nTake control of your farming activities and complete each level at your own pace.\n\nStart your farming journey with Grow Garden Farming Simulator VR and enjoy an immersive virtual farming experience", "short_description": "Experience realistic farming in Grow Garden Farming Simulator VR. Plow the land, use the harrow, plant wheat, water your crops, and complete different farming levels in an immersive VR environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lightspeedstudio/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Light Speed Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/lightspeedstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection"
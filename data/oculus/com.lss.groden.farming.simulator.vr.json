61559867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823259_1633121364893200_3267224556868743975_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPifGzm3G9YQ7kNvwEo3-Ac&_nc_oc=Adr5kD4T5IhWaCDVAFMMg9GVHrlaIduVoIuocacQL4zOvdudMQ6xWI7gyxULTA5JJPc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxwdADsU3GN9ECmduCDDOct82m-fBYEq3jMk8vjFVvAg&oe=6AFB4769"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grow Garden Farming Simulator VR", "keywords": ["FarmingSimulator", "GrowGarden", "GrowGardenFarmingSimulator", "GardenFarmingSimulatorVR"], "long_description": "Welcome to Grow Garden Farming Simulator VR, a simple and enjoyable virtual farming experience where you can perform different farming activities across multiple levels.\n\nIn Grow Garden Farming Simulator VR, start by preparing the land and plowing the soil. Use the farming tools to make the ground ready for planting and complete each task step by step.\n\nGrow Garden Farming Simulator VR lets you work with the land, use the harrow, plant wheat, and provide water to your growing crops.\n\nComplete different farming tasks and progress through multiple levels. Every level gives you a new farming objective to complete.\n\nWith Grow Garden Farming Simulator VR, you can experience the basic steps of growing crops in an interactive VR environment.\n\nPrepare the soil, plow the field, use the harrow, plant wheat, water the crops, and complete your farming missions.\n\nGrow Garden Farming Simulator VR is designed with simple gameplay and easy-to-understand farming tasks.\n\nTake control of your farming activities and complete each level at your own pace.\n\nStart your farming journey with Grow Garden Farming Simulator VR and enjoy an immersive virtual farming experience", "short_description": "Experience realistic farming in Grow Garden Farming Simulator VR. Plow the land, use the harrow, plant wheat, water your crops, and complete different farming levels in an immersive VR environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lightspeedstudio/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Light Speed Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/lightspeedstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1287111027829531"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3246594045529072"}, {"status": "PUBLISHED", "id": "2342903609865268"}]}, "baseline_offer": {"id": "3246594045529072"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792425480, "status": "PUBLISHED", "id": "3246594045529072"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1278946018646032", "version": "1.0"}, "id": "1746958576531533", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1278769345330366", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1278946018646032"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1
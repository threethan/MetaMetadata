64_6863346927496502501_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncmS50NvlacQ7kNvwEj4zlX&_nc_oc=AdqDCFjCUdu1OuBSITRUKfNp7dFulMeiH7GcbnT_Z5I7orF7k88Q_AWuFiSUCQxNA24&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VVGOdryRGc4gIEnxgTumfkB66J_lAJyjwDxcp8-5nIg&oe=6A22F31D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerVideoCover.png", "id": "941827177156014", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974706_941827180489347_7915571754918677983_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORTXdIS7t1gQ7kNvwGkx407&_nc_oc=AdrbUJBalr0yaLMASDZ57b25ppsLu32bRI_umpdvrOwQI7Z3RnF8DZNBNii1fBqGywk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eHB2Er7D1tDLf4ZroiY6c2TjN6Q2p_ZOB9V5mULkoXA&oe=6A22D946"}, "display_name": "Bus Rush VR", "keywords": [], "long_description": "Run along the craziest scenarios in the Bus Rush City. Avoid hitting trucks, buses and subway trains. Run around the Bus Rush city, subway, forest and beach and gather all the coins you can.\n\nSurf the Bus Rush city with Roy, Zoey, Darryl, Katie, or any of your favorite characters! Also, you can customize your virtual surfer of choice by purchasing thematic runner skins!\n\nBus Rush is a very fun runner game. Download it now and start running!", "short_description": "Bus Rush is an amazing running game for VR! Start running now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://play365.io/bus-rush-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Boxitsoft", "support_website_url": null, "website_url": "http://www.boxitsoft.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graph
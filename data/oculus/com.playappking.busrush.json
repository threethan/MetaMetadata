 coins you can.\n\nSurf the Subway Bus Rush Runner city with Roy, Zoey, Darryl, Katie, or any of your favorite characters! Also, you can customize your virtual surfer of choice by purchasing thematic runner skins!\n\nGorilla Bus Rush is a very fun runner game. Download it now and start running!", "short_description": "Gorilla Bus Rush is an amazing running game for VR! Start running now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://play365.io/bus-rush-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Boxitsoft", "support_website_url": null, "website_url": "http://www.boxitsoft.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_VE", "es", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "en_GB", "en_ZA", "en_CA", "en_AU", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9669939736375373"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393771_1031495375622844_8242273823833881966_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50W10xjU-R0Q7kNvwHgGIon&_nc_oc=AdmFfG6pbEU1HpiT-wsCZmyvui_9kNpQxIl1y2VTmkSHgyAixhzXoTFu-8o2-s7Xq3I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzVkRCUn6J2UT8tyLGeUOh0SXV9woQ3AxtmNvVOz6cexg&oe=69BD329F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Subway Bus Rush Runner", "platform": "AN
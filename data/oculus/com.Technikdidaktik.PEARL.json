i": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75356793_451670054172341_539387047738498499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruLp0UAWoL0Q7kNvwHiL_RX&_nc_oc=AdojfwS_5GpcBVRaK-MFPMXqEogjqftWwgrmpg6xx6x4ZaojBxX2jsCHM-QDENksLkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWfiL7ySdLG36elc8eZk12LX7j1tQpf6wDKQg8_RSC5g&oe=69C90BCB"}, {"file_name": "Screenshot_2.png", "id": "357659350360137", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_357659353693470_5033813498719057813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjyKdTIjEi8Q7kNvwG3V1Bc&_nc_oc=AdpBr3_zRKmDFDGTQHw5X476R7hg3TE7AKY_InS-3nazfiWXNzpqUbE_F2LZNmkZ3Zk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxJN8w4ZkESRnhmPvX7I37oU99uJ2E74ua4_6DDU_9cQ&oe=69C933FB"}, {"file_name": "ScreenShot_3.png", "id": "1195887421423051", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974485_1195887424756384_7691338960880075664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwwdLaFnhn0Q7kNvwGXlt14&_nc_oc=Adq1r1i3Hh8aiOTSRsPSIeRunWFR2e9zWARCq2Nokc6ijO1kntVcrEI-KoVHzekQJCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-fvvkZpsd1l1VCDMRNdtqHoI-VdKEg2jTO-MSxX96og&oe=69C939AF"}, {"file_name": "ScreenShot_4.png", "id": "1667562597331130", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86641450_1667562600664463_5233581075505598414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzheg-8OC5cQ7kNvwFTTW8k&_nc_oc=AdpiSefja71BZDJxIhc5fsx0bDAS_tUQXg3NQmFRqG5LW_DEWSyPqrlPQYMwjBOGwI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBSwgTBkEzV-c-GZTKe0U54YLFUOgcvc_ZTY0k9Qd1pA&oe=69C916D1"}, {"file_name": "ScreenShot_5.png", "id": "3673525292963473", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982721_3673525296296806_227081706015447344_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNY9tukDC4AQ7kNvwHBl0fZ&_nc_oc=AdoFWiZjj2huUC7gBYqbxs3nMdRV5vqafKp7tH12xKhTToKidsnjQulwyp3VJ6d6uEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5tw44AM6iaSWcI2yjGHnfXtZpEHSI117R0I1c0VYdCg&oe=69C92280"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Thumbnail.png", "id": "447343158183798", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269597_447343161517131_3047975167741845148_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6zSkirSpYEQ7kNvwHpD7ka&_nc_oc=Ado6Q9xh5ZMlOyJzZPpc4NPjWRb2moCsDMEbYAm2e2JQ3bTraK2qYu7Kf7xGDGw1_GM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfziEJBv0Xfz5tz9lYc3_YYxwJEthko5A0LmOpsoYeY2qQ&oe=69C922E2"}, "display_name": "PEARL - Paderborner Elektrotechnik AR Labor", "keywords": [], "long_description": "PEARL wird mit Unterst\u00fctzung der Stiftung Innovation in der Hochschullehre entwickelt und in enger Zusammenarbeit mit Laboringenieuren, Softwareentwicklern und Didaktikexperten umgesetzt. Sie wurde bereits in mehreren Studien sorgf\u00e4ltig evaluiert und hat zu einem nachhaltigen Wissenszuwachs in Bezug auf die Laborger\u00e4te gef\u00fchrt. PEARL bietet eine realistische und immersive Erfahrung, die es dir erm\u00f6glicht, die Bedienung und die wichtigsten Funktionen von Ger\u00e4ten wie dem Oszilloskop, Funktionsgenerator, Vielfachmessger\u00e4t und dem Steckbrett mit verschiedenen elektrotechnischen Bauteilen spielerisch zu erlernen. Tauche ein in interaktive Tutorials, die dir Schritt f\u00fcr Schritt zeigen, wie du die Ger\u00e4te richtig bedienst und welche Funktionen sie bieten. Neben umfassender Erkl\u00e4rung der Laborger\u00e4te, kannst du dein Wissen und deine F\u00e4higkeiten auch interaktive durch verschiedene Tests \u00fcberpr\u00fcfen. Mit PEARL kannst du die Laborger\u00e4te ganz einfach in deiner eigenen und bevorzugten Umgebung verwenden. Keine teure Laborausr\u00fcstung oder komplizierte Einrichtungen mehr erforderlich - alles, was du brauchst, ist deine Meta Quest 3 und schon kannst du loslegen.", "short_description": "Entdecke die faszinierende Welt der Elektrotechnik mit PEARL - dem Paderborner Elektrotechnik AR Laborpraktikum!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e79a1fdd-66a9-42fc-8e79-6a10efea2428", "developer_terms_of_service_url": null, "publisher_name": "Universit\u00e4t Paderborn - Technikdidaktik", "support_website_url": null, "website_url": "https://ei.uni-paderborn.de/td", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8029123443802627"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "921217330270671"}, {"status": "PUBLISHED", "id": "1635486267212202"}]}, "baseline_offer": {"id": "921217330270671"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772482020, "status": "PUBLISHED", "id": "921217330270671"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8959653064082989", "version": "1.3.0"}, "id": "1485261109008890", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8029123423802629", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8959653064082989"}, "release_status": "RELEA
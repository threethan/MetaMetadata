i": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75356793_451670054172341_539387047738498499_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruLp0UAWoL0Q7kNvwFhkocK&_nc_oc=Adp324TLfW_CQEarcU5KK7kcba3wgMEjnMBM-2Xf5vo8qothaX1Mqz6y-LpMPARhhxQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_DV_txyM2uhZLxiF9E8sXmPHuQ-nj8pHTCcGgwHbKkA&oe=69C7BA4B"}, {"file_name": "Screenshot_2.png", "id": "357659350360137", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035416_357659353693470_5033813498719057813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjyKdTIjEi8Q7kNvwHT9Aaf&_nc_oc=AdpJ-ZgWc0ND-rgY8PhYE0jpGYLlC0vSmgBxpiVZjc0tpF5Ch1zcJOD0qAYAgTxM04w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwlp4ib419UZkytZDnciUNrtk8PBSA8pOe1nyJ_Oq80Ow&oe=69C7E27B"}, {"file_name": "ScreenShot_3.png", "id": "1195887421423051", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974485_1195887424756384_7691338960880075664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwwdLaFnhn0Q7kNvwGhWlii&_nc_oc=AdrTkvq7e-aykwDlPp1v1UOv3Wvh0foMX91QZro9Zba4rw7_f2lxKQ5xPUkqPNgjnl0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwotyYwQUYdhHm3YcB8tfOofxvnymb_wq5RDgWBJgt7aw&oe=69C7E82F"}, {"file_name": "ScreenShot_4.png", "id": "1667562597331130", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86641450_1667562600664463_5233581075505598414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzheg-8OC5cQ7kNvwG0bwdY&_nc_oc=Adr15iS2WdhyB0-we1PcG67vlvg9vyikkdsrVVF3xolPFZP_7jOkGw-o6ELoiP-cLjY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCU_yri__k2cKc_KB3uvvd2Y_5iZbV-UX3_SPWI92KCQ&oe=69C7C551"}, {"file_name": "ScreenShot_5.png", "id": "3673525292963473", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982721_3673525296296806_227081706015447344_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNY9tukDC4AQ7kNvwHRzNa5&_nc_oc=Ado59K-HEFNKFZWjnDMku-KBxFoOg9eFZhfhhQnU4WynMAXTYmCdujULyYHVqAy0Nuk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyw8qQ2CEozz09aQnbKwRIKROYw7udk-UHHTrujGeUhmA&oe=69C7D100"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Thumbnail.png", "id": "447343158183798", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75269597_447343161517131_3047975167741845148_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6zSkirSpYEQ7kNvwE26F0N&_nc_oc=AdpkPh7E2qACbcaM4M_d7N5lSaMWfoIkRK8-uOOk3gBhI06LGgnkU74Ge6h-YdHotYg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5G-R1gRKJS1g6SkPHvirhcMJT3Ta0gA9RPjtwxRJAFQ&oe=69C7D162"}, "display_name": "PEARL - Paderborner Elektrotechnik AR Labor", "keywords": [], "long_description": "PEARL wird mit Unterst\u00fctzung der Stiftung Innovation in der Hochschullehre entwickelt und in enger Zusammenarbeit mit Laboringenieuren, Softwareentwicklern und Didaktikexperten umgesetzt. Sie wurde bereits in mehreren Studien sorgf\u00e4ltig evaluiert und hat zu einem nachhaltigen Wissenszuwachs in Bezug auf die Laborger\u00e4te gef\u00fchrt. PEARL bietet eine realistische und immersive Erfahrung, die es dir erm\u00f6glicht, die Bedienung und die wichtigsten Funktionen von Ger\u00e4ten wie dem Oszilloskop, Funktionsgenerator, Vielfachmessger\u00e4t und dem Steckbrett mit verschiedenen elektrotechnischen Bauteilen spielerisch zu erlernen. Tauche ein in interaktive Tutorials, die dir Schritt f\u00fcr Schritt zeigen, wie du die Ger\u00e4te richtig bedienst und welche Funktionen sie bieten. Neben umfassender Erkl\u00e4rung der Laborger\u00e4te, kannst du dein Wissen und deine F\u00e4higkeiten auch interaktive durch verschiedene Tests \u00fcberpr\u00fcfen. Mit PEARL kannst du die Laborger\u00e4te ganz einfach in deiner eigenen und bevorzugten Umgebung verwenden. Keine teure Laborausr\u00fcstung oder komplizierte Einrichtungen mehr erforderlich - alles, was du brauchst, ist deine Meta Quest 3 und schon kannst du loslegen.", "short_description": "Entdecke die faszinierende Welt der Elektrotechnik mit PEARL - dem Paderborner Elektrotechnik AR Laborpraktikum!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e79a1fdd-66a9-42fc-8e79-6a10efea2428", "developer_terms_of_service_url": null, "publisher_name": "Universit\u00e4t Paderborn - Technikdidaktik", "support_website_url": null, "website_url": "https://ei.uni-paderborn.de/td", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8029123443802627"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "921217330270671"}, {"status": "PUBLISHED", "id": "1635486267212202"}]}, "baseline_offer": {"id": "921217330270671"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772482020, "status": "PUBLISHED", "id": "921217330270671"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8959653064082989", "version": "1.3.0"}, "id": "1485261109008890", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8029123423802629", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8959653064082989"}, "release_status": "RELEA
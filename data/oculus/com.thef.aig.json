bPDZrMR4WXrcRp7JOreerbgzYLyaeIzO6mf80eYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UKJN34pYOgFUkHpAeEAjHSgv6oUfc2I37YNSCWXgUfQ&oe=6A0734F4"}, "display_name": "An Impossible Guest", "keywords": [], "long_description": "\u201cIf you could have dinner with anyone living or dead, who would it be?\u201d Until now, this has been nothing more than a fun hypothetical to spark conversation. But through mixed reality and artificial intelligence, An Impossible Guest makes the impossible possible. You can now invite a guest from history into your physical space for a one of a kind dinner conversation. So, now that anything is possible, the only question is . . . what will you ask your guest?", "short_description": "\u201cIf you could have dinner with anyone living or dead, who would it be?\u201d Until now, this has been nothing more than a fun hypothetical to spark conversation. But through mixed reality and artificial intelligence, An Impossible Guest makes the impossible possible. You can now invite a guest from history into your physical space for a one of a kind dinner conversation. So, now that anything is possible, the only question is . . . what will you ask your guest?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://theelectricfactory.com/animpossibleguest/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "The Electric Factory", "support_website_url": null, "website_url": "https://theelectricfactory.com/animpossibleguest", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
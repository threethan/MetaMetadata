.com&_nc_ss=7f20f&oh=00_AQHWjOr_RWXZ9T8RPxxWVDKyq01R-vkoKX7WVc1LbsaNNQ&oe=6A8ECB59"}, {"file_name": "boss.png", "id": "2740805429581819", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982545_2740805432915152_6076322470190024035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHrMXyrRZXwQ7kNvwHOPegp&_nc_oc=Ado1Ps8js89xDGPWVBnlr7k69pwYI4m3sIrpLuZoJYQwQPG0uioL0WbYU6dsSzMBUt8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK6ciXia9KM7m5gGrcspp8iN2F5CQ-ozcXt1g06qXSow&oe=6A8EDD8A"}, {"file_name": "flyingskull.png", "id": "277205357411577", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974901_277205360744910_1639449321890515552_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Igy07J_3EhgQ7kNvwHWHz4Q&_nc_oc=AdobE__Pc3P3d6zUL_rJY4ZR098KC352Au_K7GLdNV2hli3-qcdToqSqJ-rJnluyVuQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSwe3i2DZsIMym0GTbgO0Yefurgu16oG4WTrAfUaBL7A&oe=6A8EC2F6"}, {"file_name": "homebase.png", "id": "242737410566009", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982528_242737413899342_5609633577083105504_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JWkqC6Xe1kQ7kNvwExaECT&_nc_oc=Adq2Kd4QxP7R-FRZbL0i2E7LQG3hRoJW6N8bbH_rYB-0pmfKZgfAPUJ6FDkOe5hn19A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBdj9-T81ScjTtYD2N8EpSFufib2ujDjcQzIBL16-e0A&oe=6A8ECBB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "advr_splash_2560x1440.png", "id": "742365666718584", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982545_742365670051917_4570731962930008271_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE09b_7EgtcQ7kNvwHEaqzW&_nc_oc=AdrZMFV1pLgLVHeKFmSVIAk9T_aBPMmU6LEFoYbfjMdV1zmJwOPocXvExPeCr7kaIzM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdWxlK4vKQkJRPENopYzK7QEsmO9vre9he57uUW4VHdA&oe=6A8ED37C"}, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!\n", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "http://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "253860676894450"}}]}, "sche
20f&oh=00_AQIjkHhiFphhEtY2R5nMhf9ENNlaeOK5rODFAjmnLrxioA&oe=6AAEA799"}, {"file_name": "boss.png", "id": "2740805429581819", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982545_2740805432915152_6076322470190024035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSudOzMx2RkQ7kNvwGFP_gt&_nc_oc=Adp6dJQd3qth0cLqLb47xJYD5RM_huqGEI3s1YBEFVw8OIdZyEFhcUZCyLeaqwE_PZE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2noWjYUAWnVtxC-b1dMRBc7aRq_aIW1nOouFk3S73Mg&oe=6AAE818A"}, {"file_name": "flyingskull.png", "id": "277205357411577", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974901_277205360744910_1639449321890515552_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgOK9mqUmikQ7kNvwEqvwnm&_nc_oc=Ado9FOZhJ9P0nNp4T4SrJc0PXn7VTl_7a1ktTHuz3_LxaxxE31QI825joAdeERZ0n2w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVMVKIfildeBmyaih-efVEAOkkSmVKvKrqaoHerhNyqQ&oe=6AAE9F36"}, {"file_name": "homebase.png", "id": "242737410566009", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982528_242737413899342_5609633577083105504_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcbCNbg70t8Q7kNvwGknCRl&_nc_oc=Adp7LhDnYgCMBbZjIyPnS2pDy-y9Lm_AT5yMVRHq6mUGRztiptW3tdFZ5vyGAUKxleM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOtZb6MmRwQF5JJqsjHcfjsMfcba33UKSHJaBPcm-jAQ&oe=6AAEA7F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "advr_splash_2560x1440.png", "id": "742365666718584", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982545_742365670051917_4570731962930008271_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-UM5F29eeEQ7kNvwF2vatN&_nc_oc=AdrJ1muWfBGuHEfXLZJ_CMf8wHcW0J0VyMYT6en1Hec0DCxZWeRIjHfWFXhSgo6MTUU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQxtm66IdiIM1s4sQN7ZkbdqbmXxsny061ituqXZ_fVw&oe=6AAEAFBC"}, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!\n", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "http://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "253860676894450"}}]}, "scheduled_offers": {"cou
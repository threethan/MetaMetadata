20f&oh=00_Af4dnjBkuSY27_GZpSKfnhbjA0QMxLid2Ev_kbh7YaEdGw&oe=6A11C519"}, {"file_name": "boss.png", "id": "2740805429581819", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982545_2740805432915152_6076322470190024035_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KEsWgz0qFIQ7kNvwEYl7_d&_nc_oc=AdoMHyhRkjsau54SCVqOelKAwvFKALw5hIbwDPASk3sTOZHtcSwdeZmML2NMjuZUeiM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xOlwFnAUB99dne08lfL0lslTB-8JmO0_AoFLZ-kfIuw&oe=6A119F0A"}, {"file_name": "flyingskull.png", "id": "277205357411577", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974901_277205360744910_1639449321890515552_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8s0UQr7oiTYQ7kNvwHKlHte&_nc_oc=Ado8r-fOyyOUI_Cc4z1PrQIJ3WU0xYGvV1tjzUfDLem1916heQm2xft1kd-qH73C5fc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PYAHbgOF5lh0QuqwBmVleKIXnaOyVzMNUdiEDbNy_AA&oe=6A11BCB6"}, {"file_name": "homebase.png", "id": "242737410566009", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982528_242737413899342_5609633577083105504_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60ULLb_aIMsQ7kNvwFOxv6B&_nc_oc=Adp8e00kxENrrQMgIcSWoMZSVntFp2ovuJtOVlmT0gy5jyX7Y7JjVymG5VMDAi8r9VE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Fk6n05_CCq2ZqjcTyOoklP-6C_ivHWbwDYmlXFx4dJA&oe=6A11C570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "advr_splash_2560x1440.png", "id": "742365666718584", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982545_742365670051917_4570731962930008271_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSzrhtxvRfMQ7kNvwHZ7r5n&_nc_oc=Ado7dFjEFpqhurrZIDABYzi6JcLYkrweZU-h4wmj07RK7wRgQuBkpmfE8iNlQCz2flo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PlkWi3w2Fof47ZtheVNpjFm8yTRbj0tWLQ43-B09ugw&oe=6A11CD3C"}, "display_name": "Ancient Dungeon", "keywords": [], "long_description": "Grab your gear and delve into this rogue-lite dungeon crawler!\n\nThe Ancient Dungeon is known throughout the land; a place of malice and danger to all but a few brave souls. These men and women - adventurers, explorers, even scholars - enter the dungeon in pursuit of legendary fortunes and objects of immense power, all believing themselves more capable than those who have gone before...but few return.\n\nYou would follow them? So be it, but take care: the dungeon will twist and shift behind as you pass, confounding any escape. To survive, you must find a way through, for there is no way back.\n\nExplore a vast dungeon of ever-changing paths!\nSwing swords, throw knives, and shoot arrows as if you held the weapons yourself!\nUncover the lost history of the dungeon!\nClimb over deep pits, dodge lethal traps, and search for hidden treasures!\nSmash pots. Break crates. It\u2019s just good fun.!\n", "short_description": "Ancient Dungeon is a rogue-lite dungeon crawler with randomly generated dungeons. Uncover its secrets and challenge powerful bosses!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://erthu.de/pp_advr.html", "developer_terms_of_service_url": null, "publisher_name": "ErThu", "support_website_url": null, "website_url": "http://erthu.de/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "253860676894450"}}]}, "scheduled_offers": {"cou
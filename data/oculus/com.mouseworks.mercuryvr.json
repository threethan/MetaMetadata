_name": "Screenshot 2026-02-04 213221.png", "id": "1576729443442025", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491825503_1576729450108691_6908586427427011829_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGy6R4OluRAQ7kNvwEkBs_X&_nc_oc=AdqjugLSze7eaP1OTtM3jwNTKKXLrIJhCwm85KGaS4z_VYyZGmYzHBiV_BOe2ctOx3s&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_ArvcSACeEV_NG9jv_DiKD-0bPjxR6egf_qwEZzB7tA&oe=6A940D1F"}, {"file_name": "Screenshot 2026-02-04 212811.png", "id": "883887034627703", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491818849_883887041294369_9171275076647147034_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdgnS5di_3MQ7kNvwEXhmRd&_nc_oc=AdrfUB17NK2DNaXV9U5PkBmwobeHU8fkaP5BGC-LvK-MHVSVG0gqM3tBHovFTBjOBZI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc9nItYsW36mgvUrPA0ZBGJ_EI69GZR46t6hPCiTq04Q&oe=6A942067"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Querformat.png", "id": "782101714962809", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499307339_782101718296142_1064427445544386851_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9aZNQcjMLYQ7kNvwETf7Sq&_nc_oc=AdoK6Bq8nf5Q-5pHN2HvGbL_lvawuQ9E9ija64TiDVnMUznOVwvZ_9DROHO2cXfqjig&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBonIjKZ9HXVg6_7nGHdiS7LdcpZEQ1ONsXp5LgXxlvA&oe=6A940671"}, "display_name": "MERCURY - TECH SHOWCASE", "keywords": ["handtracking", "mercury", "brawler", "mechs", "fighting"], "long_description": "# The world\u2019s first fast-paced hand-tracking mecha brawler!\n\n**Note: This is a free tech showcase built to explore experimental hand-tracking. Play in a well-lit room and check the gesture controls below before starting:**\n\n\n\ud83d\udd90\ufe0f Move & climb with gorilla locomotion\n\n\ud83d\udc4a Fist to punch\n\n\ud83d\udc49 Finger gun to shoot\n\n\ud83d\udc4a\ud83d\udee1\ufe0fBlock by holding both fists in front of your face\n\n\ud83d\udc4f Clap to scan\n\n{920402967527823}\n\n# The Conflict\n\nOn a barren outer-system planet, the Tyris Corporation exploits the valuable resource Mercury, pushing the local population, the Heskar, into rebellion. With improvised mechs and sabotage tactics, the Heskar fight back.\n\nIn response, Tyris deploys its elite unit: RIS_TEC.\n\nPlayers can experience both sides of the conflict:\n\nRIS_TEC Mission: Hunt down and eliminate illegal Heskar mechs to restore corporate control.\n\nHeskar Mission: Sabotage RIS_TEC cities at all costs and disrupt the occupying force.\n\n{846268121816722}\n\n# Feel the game\n\nTo deepen immersion even further, Mercury fully supports native bHaptics vest integration.\n\n{1515420930147912}\n\n# The Team & the Project\n\nMercury is the world\u2019s first fast-paced VR mecha brawler controlled entirely through hand gestures, developed as a technical showcase for Meta Quest 3 and 3S.\n\nMercury was developed in just two months by a team of six students as part of the Meta Horizon Start Developer Competition 2025 and as a fourth semester project.\n\n\n", "short_description": "The world\u2019s first fast-paced hand-tracking mecha brawler.\n\nOn a barren outer-system planet, Tyris Corporation exploits the resource Mercury, driving the Heskar into rebellion. Choose your side: hunt illegal mechs as RIS_TEC or sabotage corporate cities as the Heskar. Move with gorilla locomotion and fight using full hand tracking in intense VR mech combat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicymercury/startseite", "developer_terms_of_service_url": null, "publisher_name": "Mouseworks", "support_website_url": null, "website_url": "https://sites.google.com/view/mercury-landing-page/startseite", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26112223765060919"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491818890_1270402288359281_8446141656042226967_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-pSVdWK_YwQ7kNvwGd8NiN&_nc_oc=AdqLjmEMgGYfIdhGLD_p75bnMNn0fohqCSrlc4I22jSHj5gEMhW_rXYeyoRVwCKxGNg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT5_Zkb7TmBQOto1EmdZrIKMbNW6MB1IQERpzfApBPvg&oe=6A941741"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MERCURY - TECH SHOWCASE", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1773658800, "lastRevision": {"nodes": [{"id": "26112223821727580", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26112223728394256", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1494992582245960"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Card.png", "id": "1540228377038813", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823940_1540228380372146_4097739781896488511_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwSb
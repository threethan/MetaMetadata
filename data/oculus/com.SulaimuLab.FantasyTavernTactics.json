=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGLy3l7q2mmsk5FaEZcU7PGLrJdYxqklc53EsDTtdI2A&oe=69BD2E63"}, {"file_name": "\u30b5\u30e0\u30cd5_3.png", "id": "345996608021749", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035367_345996614688415_6091305747581745182_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCzBOcI1oJEQ7kNvwEJZkR4&_nc_oc=AdlFZp2fDIApDkZrT61__XPZjGtTF0KYhZWbqPX38OsGmeLJh3LbwqMFbuGI-BfX7l0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd5So3qE0ZLj5a5o1if2mS4cOYgULUxO6SNbtb5uYmLA&oe=69BD3AD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Title4.png", "id": "3684407775164294", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031383_3684407778497627_3309220346244564187_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgVGG7-e_0cQ7kNvwH-QNIc&_nc_oc=AdngpqhU9wMKhuLCuYGDU7RXvB5gQbbYrZ6OHTydsivwne5Wxee_wcBci7rgGHZ-lGU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzaQ-kzI0Jn4-IKZqIJBUXffFKCQtIuGDCBSyWJ33911A&oe=69BD548B"}, "display_name": "FantasyTavernTactics", "keywords": [], "long_description": "At times, outsmart your opponents with clever piece placements, and at other times, defeat enemies directly with weapons in hand. This is the emergence of an entirely new board game experience, unique to VR.\n\nIn the strategic phase, manipulate the board considering the attributes and roles of the pieces, while the combat phase tests the player's skill. Success in both phases brings victory closer. Various elements are incorporated, including events where all pieces are forcibly moved, or buffs/debuffs are applied, as well as a diverse array of characters, stages, and combat styles!\n\nNote: In-app purchases are optional, and more than half of the game can be enjoyed for free.", "short_description": "Master the art of manipulating pieces strategically to dominate the board, and confront enemies in battles led by the player."}]}, "developer_name": null, "developer_pri
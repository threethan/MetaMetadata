=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKD-quKGmr0o1aV86F7x1TsnUfHyOcs5XM_yOO6agLWQ&oe=69B7E863"}, {"file_name": "\u30b5\u30e0\u30cd5_3.png", "id": "345996608021749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035367_345996614688415_6091305747581745182_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRaZHLHI5pYQ7kNvwFc08Oe&_nc_oc=Adl0ldk7MyFYm65Iw6bDXSNkn7Ja3SCV8IWLzYd3vBdu8sxiQD0OtK6OfWGpJZfURak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxpl6EJ5KAbNu9jFcUJXWPZAYsaiUbNKZrg2zSMGIy8XA&oe=69B7F4D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Title4.png", "id": "3684407775164294", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_3684407778497627_3309220346244564187_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CidJfnc5YEQ7kNvwFtaYXy&_nc_oc=Adk397VKiSq1vRdFXMMfrCOzxeV6vVjSrOO2OoN6qu2cQHEGLtO66ba4Q27UdGrQEkI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDq7d2Hn7RdtyoAm9HibYpM5RxhFQzXIyNyrdcQ2BPTw&oe=69B80E8B"}, "display_name": "FantasyTavernTactics", "keywords": [], "long_description": "At times, outsmart your opponents with clever piece placements, and at other times, defeat enemies directly with weapons in hand. This is the emergence of an entirely new board game experience, unique to VR.\n\nIn the strategic phase, manipulate the board considering the attributes and roles of the pieces, while the combat phase tests the player's skill. Success in both phases brings victory closer. Various elements are incorporated, including events where all pieces are forcibly moved, or buffs/debuffs are applied, as well as a diverse array of characters, stages, and combat styles!\n\nNote: In-app purchases are optional, and more than half of the game can be enjoyed for free.", "short_description": "Master the art of manipulating pieces strategically to dominate the board, and confront enemies in battles led by the player."}]}, "developer_name": null, "developer_pri
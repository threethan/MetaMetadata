ontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569468_1456127308568360_1666516047687486292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8EOq1X2_y8Q7kNvwGmLffo&_nc_oc=AdpVGPs20RtqiPLABFU79l6-L6FeX_HTbfHXe7CnyazM33uuotYyn-m1rrpO8P6QSkc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2iaYJoXaV25s436RdY-SN1_-aWe9MMtUeL6HwtTfWiA&oe=6A8D7B63"}, {"file_name": "\u30b5\u30e0\u30cd5_3.png", "id": "345996608021749", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035367_345996614688415_6091305747581745182_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-cfXEiZ3WUQ7kNvwFnOnsR&_nc_oc=Adq87izIPa0PoHmisiEwFzrcJEKcNDPm-VCka_p9wer1-pjWeqax_t7QfVaWuly6PW4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1pp6787BvgISbJubvieoLYWSGes-TP12-YDEl34S5lQ&oe=6A8D87D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Title4.png", "id": "3684407775164294", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031383_3684407778497627_3309220346244564187_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxfvJoHUjgUQ7kNvwGGTim1&_nc_oc=AdrmnvCb1TA5pl0CM1qNkXkQjBnZwKq06-sWM9c-W8Hl40NNAUYTqpXL4WrnaIOV3U0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUtrKiXDL9XIosJS1j3gphq5teXSR662-zCaIBCDPkUQ&oe=6A8D694B"}, "display_name": "FantasyTavernTactics", "keywords": [], "long_description": "At times, outsmart your opponents with clever piece placements, and at other times, defeat enemies directly with weapons in hand. This is the emergence of an entirely new board game experience, unique to VR.\n\nIn the strategic phase, manipulate the board considering the attributes and roles of the pieces, while the combat phase tests the player's skill. Success in both phases brings victory closer. Various elements are incorporated, including events where all pieces are forcibly moved, or buffs/debuffs are applied, as well as a diverse array of characters, stages, and combat styles!\n\nNote: In-app purchases are optional, and more than half of the game can be enjoyed for free.", "short_description": "Master the art of manipulating pieces strategically to dominate the board, and confront enemies in battles led by the player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://general-germanium-276.notion.site/Privacy-Policy-for-FantasyTavernTactics-65a2a1f0ef4b48f48e29cec53719137e?pvs=4", "developer_terms_of_service_url": null, "publisher_name": "Yuki Yamada", "support_website_url": null, "website_url": "https://www.notion.so/FantasyTavernTactics-db0953c16312421e8414e212a3b87e2c", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6980684448636646"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "866933225100826"}]}, "baseline_offer": {"id": "866933225100826"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1700673980, "status": "PUBLISHED", "id": "866933225100826"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6985533024818455", "version": "0.1"}, "id": "1005981267255679", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6545366252168470", "is_concept": fa
57569468_1456127308568360_1666516047687486292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6VsUw4pau8Q7kNvwH-hOyy&_nc_oc=AdrUv20NgQbxBnYB7xavG-yOZV2kgeZag8WdrIM15dRqifzwWo170txSmS2nmVvTTPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaE8jwHkjcth8KCSTP2zV8hfAzA0YVenxIzNn1gQpJlQ&oe=6A707A63"}, {"file_name": "\u30b5\u30e0\u30cd5_3.png", "id": "345996608021749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035367_345996614688415_6091305747581745182_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUkPCBHxIe0Q7kNvwE4hfxZ&_nc_oc=AdrdRcvA_TOVAW7UysqLvO0lrhMs2xkDrIQQu1SC-y6EXpBpatjOCN_2arn2YgUsxks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBPVft1fuFfYTw3zS66peMAH_TVlTzVRxdwS7183Pb5Q&oe=6A7086D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Title4.png", "id": "3684407775164294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031383_3684407778497627_3309220346244564187_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYiJq2ZVTv0Q7kNvwHvejmB&_nc_oc=Adrhm5Koqm9XNaHnBQd5zBWwva9vyGqNi6eVSzeCkrxUI-C9ms8FKocDqET1J0z6JMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuQOMIpfdlzS9ZyvWk2d10PHCn4LwyR45J5ywRY55mSw&oe=6A70A08B"}, "display_name": "FantasyTavernTactics", "keywords": [], "long_description": "At times, outsmart your opponents with clever piece placements, and at other times, defeat enemies directly with weapons in hand. This is the emergence of an entirely new board game experience, unique to VR.\n\nIn the strategic phase, manipulate the board considering the attributes and roles of the pieces, while the combat phase tests the player's skill. Success in both phases brings victory closer. Various elements are incorporated, including events where all pieces are forcibly moved, or buffs/debuffs are applied, as well as a diverse array of characters, stages, and combat styles!\n\nNote: In-app purchases are optional, and more than half of the game can be enjoyed for free.", "short_description": "Master the art of manipulating pieces strategically to dominate the board, and confront enemies in battles led by the player."}]}, "developer_name": null, "developer_privacy_policy_url": "https://general-germanium-276.notion.site/Privacy-Policy-for-FantasyTavernTactics-65a2a1f0ef4b48f48e29cec53719137e?pvs=4", "developer_terms_of_service_url": null, "publisher_name": "Yuki Yamada", "support_website_url": null, "website_url": "https://www.notion.so/FantasyTavernTactics-db0953c16312421e8414e212a3b87e2c", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6980684448636646"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "866933225100826"}]}, "baseline_offer": {"id": "866933225100826"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1700673980, "status": "PUBLISHED", "id": "866933225100826"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6985533024818455", "version": "0.1"}, "id": "1005981267255679", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6545366252168470", "is_concept": false, "latest_released_binary": {"__typename"
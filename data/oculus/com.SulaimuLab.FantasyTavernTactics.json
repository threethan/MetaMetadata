=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfymbR0EpNwkNkG3CCkrZCTs70qAQFtXbIcoXy5cp8pgvA&oe=69BE7FE3"}, {"file_name": "\u30b5\u30e0\u30cd5_3.png", "id": "345996608021749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035367_345996614688415_6091305747581745182_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSqF95yCBtEQ7kNvwHN8JHn&_nc_oc=Admf00URU0n8ad-PkiV4WbRu32EI09IaaENRw6_gUxHDhE1CnDzl7pa3xTDy0Zdj14c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_pa-YEcu1_ibZzPFP3IKvsWip22JMGHYQUKkXbblS6g&oe=69BE8C56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Title4.png", "id": "3684407775164294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031383_3684407778497627_3309220346244564187_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgVGG7-e_0cQ7kNvwF7kEPR&_nc_oc=Adm_hR9u6vfOGlTcqKlJaRt1NVl07-KEhCuye6OMhrMIA83KjLzukPp-rYrqJ4jh_5A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiaIEtdj1vFcGk7Iy4NO4a4epdM_iNmS4h3YtYMK0wUQ&oe=69BEA60B"}, "display_name": "FantasyTavernTactics", "keywords": [], "long_description": "At times, outsmart your opponents with clever piece placements, and at other times, defeat enemies directly with weapons in hand. This is the emergence of an entirely new board game experience, unique to VR.\n\nIn the strategic phase, manipulate the board considering the attributes and roles of the pieces, while the combat phase tests the player's skill. Success in both phases brings victory closer. Various elements are incorporated, including events where all pieces are forcibly moved, or buffs/debuffs are applied, as well as a diverse array of characters, stages, and combat styles!\n\nNote: In-app purchases are optional, and more than half of the game can be enjoyed for free.", "short_description": "Master the art of manipulating pieces strategically to dominate the board, and confront enemies in battles led by the player."}]}, "developer_name": null, "developer_pri
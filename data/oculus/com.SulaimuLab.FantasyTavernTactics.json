=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcaAl3qv6NHFVUEP4Fc-azc9DmuwQ20kqhCvcHnS0W3A&oe=69AFFF63"}, {"file_name": "\u30b5\u30e0\u30cd5_3.png", "id": "345996608021749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035367_345996614688415_6091305747581745182_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3qYZLLQrYYQ7kNvwEAk8vv&_nc_oc=AdnxmYt7OX9FE9pAZFJl22-Dxt11UvT8FH-MTPYuWbu7GOS6urY_9z3hyc2hMXx8rRQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJP9I87JOnj4UIkiWCfdgUuUbPrOeonMmL4bMSuw0bAw&oe=69B00BD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Title4.png", "id": "3684407775164294", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031383_3684407778497627_3309220346244564187_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WjxiQK4ERMQ7kNvwG0e7kT&_nc_oc=Adl1usCpXQIxov9nVOppuIbzIDKMfC0ko0nOhESzQyqRNuxVz9xYyCMGFG4DXp1pCNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxXM0HZc0V9N7CpZtbmRi7Awo3Kx7BTY-iPweqVvdRDA&oe=69B0258B"}, "display_name": "FantasyTavernTactics", "keywords": [], "long_description": "At times, outsmart your opponents with clever piece placements, and at other times, defeat enemies directly with weapons in hand. This is the emergence of an entirely new board game experience, unique to VR.\n\nIn the strategic phase, manipulate the board considering the attributes and roles of the pieces, while the combat phase tests the player's skill. Success in both phases brings victory closer. Various elements are incorporated, including events where all pieces are forcibly moved, or buffs/debuffs are applied, as well as a diverse array of characters, stages, and combat styles!\n\nNote: In-app purchases are optional, and more than half of the game can be enjoyed for free.", "short_description": "Master the art of manipulating pieces strategically to dominate the board, and confront enemies in battles led by the player."}]}, "developer_name": null, "developer_pri
3", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982602_790784483060066_5496536825445788789_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGvdgATX_XUQ7kNvwG0EDG0&_nc_oc=AdllGR6MOVz4CtfMu4DCZxN8Fmf_IlUwBtuOWwV6eBWJrdR1fsJM4sqgSmZHmlVAyOo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlWRB59QFduQS1C5ggBakKWfz--RjrghfU5rl0nSicKw&oe=69AAB603"}, {"file_name": "\u30b5\u30e0\u30cd4_3.png", "id": "1456127301901694", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57569468_1456127308568360_1666516047687486292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5FO5lYMLiAQ7kNvwGfF-Fj&_nc_oc=Adm3raX-M0iIVs62p2CqZ8Fy6V4hqhuXPRDJLadSbVqDiRrQUrby14HSckoD44d4ORI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxI3L_-VS9KcMJ_5igJuXEHuvbJQ29GjY8lcWKjpc7__w&oe=69AAB963"}, {"file_name": "\u30b5\u30e0\u30cd5_3.png", "id": "345996608021749", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39035367_345996614688415_6091305747581745182_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2S6KGd3w9TEQ7kNvwEdMTO3&_nc_oc=Adl3FIVe9lP02xctS5se8jXcmsf4SW0rf5KtC10yq23ZuftbV1D8bkUE7pVRmiN39j8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afy3yc-oM2e8dBGe9OvHtVRRCOzKp9quPElqHxju6P1G5Q&oe=69AAC5D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Title4.png", "id": "3684407775164294", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031383_3684407778497627_3309220346244564187_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rLyFOEZEDQQ7kNvwGkQexF&_nc_oc=AdkliXBLwWe_UiuNTSrFUvqRcAXKKZhc-YQHdp3uNTwYTESKcpYom1yRSrNNTfu4rBw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfycH5Syj7Dfiv00G4BdpGZ6-F8otJWOyyMdsSX44qMWkg&oe=69AADF8B"}, "display_name": "FantasyTavernTactics", "keywords": [], "long_description": "At times, outsmart your opponents with clever piece placements, and at other times, defeat enemies directly with weapons in hand. This is the emergence of an entirely new board game experience, unique to VR.\n\nIn the strategic phase, manipulate the board considering the attributes and roles of the pieces, while the combat phase tests the player's skill. Success in both phases brings victory closer. Various elements are incorporated, including events where all pieces are forcibly moved, or buffs/debuffs are applied, as well as a diverse array of characters, stages, and combat styles!\n\nNote: In-app purchases are optional, and more than half of the game can be enjoyed for free.", "short_description": "Master the art of manipulating pieces strategically to dominate the board, and confront enemies in battles led by the player."}, {"images": {"nodes": [{"file_name": "Title_size2.png", "id": "1735025513640858", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982481_1735025516974191_2634919696788977522_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VP6ndRO_rV0Q7kNvwFc2ip4&_nc_oc=Adn6rmYp1AosTh6zZQ-b64L_vH4-aMGCIWNT8_qTptf21-CmXznwkbKi27Y5TVYVoew&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXs9U-NDNIFqPdjSIErOS4tNIJ67o6YLHvnS-2HHEzaw&oe=69AABFDD"}, {"file_name": "Title5.png", "id": "1033221544490560", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75568726_1033221547823893_96027802119197303_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_MXZT9tzzQQ7kNvwHi5kbc&_nc_oc=AdmP9n5zQ0gtJGPitHiYYY35VeBvrY5KLb3-m_W-oR-CVW4Y9glFGaB7qzVHAliv4Pw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwkyWS-a5APKGIldyG3n-dw7gUY8XYg1TJ1p6y1jYchcw&oe=69AAD0EE"}, {"file_name": "Title5.png", "id": "999312937813562", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75534972_999312941146895_1930062699911245859_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dP0zKNdkyxMQ7kNvwHuk6ty&_nc_oc=Adn2cXhY6sobRbaFHknONaB0W1bnXpGupKTLUdGaiG6v_CGxXK87ZbxO4cJiFFbE1Wo&_nc_zt=3&
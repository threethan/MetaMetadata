=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDmIXiDXkSdVdXVW31dHkG8P_PMfK_m78t_oIPHdNaBQ&oe=69B3F3E3"}, {"file_name": "\u30b5\u30e0\u30cd5_3.png", "id": "345996608021749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035367_345996614688415_6091305747581745182_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62M4oMBFLSUQ7kNvwFB3cTO&_nc_oc=AdmpuluqXxfJvy56t5yiCbLn3uuksWyFamw0VOminv4M-HN8yFmBu-tdOmIBC7IzHCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfysmDSSaROXjgH6Tniojne9muFgY82mAej5kW_q-BSgNg&oe=69B40056"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Title4.png", "id": "3684407775164294", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031383_3684407778497627_3309220346244564187_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxKbTnr6X5UQ7kNvwE266Ud&_nc_oc=AdksLVjsBHp69bP7T_47uNsyVU_IKnI-MV70u9cDMxUv3jlSPx3L08t4HoyUUTQdf2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaYJO3nmWnu_aXfuWGe-Y1GIAxztb3-CDyyvyAXY6ueA&oe=69B41A0B"}, "display_name": "FantasyTavernTactics", "keywords": [], "long_description": "At times, outsmart your opponents with clever piece placements, and at other times, defeat enemies directly with weapons in hand. This is the emergence of an entirely new board game experience, unique to VR.\n\nIn the strategic phase, manipulate the board considering the attributes and roles of the pieces, while the combat phase tests the player's skill. Success in both phases brings victory closer. Various elements are incorporated, including events where all pieces are forcibly moved, or buffs/debuffs are applied, as well as a diverse array of characters, stages, and combat styles!\n\nNote: In-app purchases are optional, and more than half of the game can be enjoyed for free.", "short_description": "Master the art of manipulating pieces strategically to dominate the board, and confront enemies in battles led by the player."}]}, "developer_name": null, "developer_pri
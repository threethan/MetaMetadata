ents.png", "id": "1007760565668006", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823757_1007760569001339_3341721042825691790_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lhM-5TCElgQ7kNvwFATP3b&_nc_oc=AdqSoBqwOxNdNyBPzLo8i5v-iPixVYkVw3lpITwSrskbSIWfjfbR3s7k_ErearaUhHs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNfz3y4LioisfAN4yDWwGPPE6ILAH09GqK7HPopRbJBQ&oe=6B0B4423"}, {"file_name": "04-editor.png", "id": "1070437339327529", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491829165_1070437345994195_6242735225508196825_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7vT-mIJku0Q7kNvwGX-QIX&_nc_oc=AdqU2Kj_8pS8pLBm6NhAdKihoU3cs-4BbXvh4Yz_XqHfyrumfxsPBdhQ7M6o2C9PGH0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpyk08Ucf5KReaw0g3akF-3x_469RFL2-Ef3rT-ivkJQ&oe=6B0B2E8F"}, {"file_name": "03-hand-controls.png", "id": "2118005035503157", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828583_2118005038836490_4703373107234967124_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsGbEcu12MAQ7kNvwH3m-2g&_nc_oc=AdqDpQ4OoJcio-Z0J9uvYH4FDFrNL3U9S2P9Nho7_N8lvHcJPVet0CizSOrU3NRnCL8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5clieyMRxK_wJRHHnpQJzS-zxLZ2w8pPM6qrZYcakuw&oe=6B0B0C61"}, {"file_name": "01-browser.png", "id": "2432952877510539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825415_2432952887510538_6430410702380026795_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8h_gOMDKLZwQ7kNvwHGCvZQ&_nc_oc=AdrJUE8ZclLXFKcOg4FKx1IeKioAMdnw81LPNdu5Vp5hf9X9e8EW9CNDfbv3fiTKtgY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAbkGjPnkY6jIgT5-ZxrtiAD6vZqB_aF3ZuP6Lk0H3eg&oe=6B0B0C80"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VibeAR", "keywords": ["code", "vibe", "ai", "cockpit", "productivity"], "long_description": "**Your terminal, your editor and your agents \u2014 in the room with you.**\n\nVibeAR turns your Quest into a mixed-reality cockpit for your computer. Windows float in passthrough around your real desk: as many terminals as you need, browsers, notes, code and PDF viewers, 3D models, and a live mirror of your Mac screen. Move them with a pinch, keep your keyboard visible, and get back to work.\n\n**Built for coding with AI agents**\n- Run Claude Code, Codex or any CLI in floating terminals, each with its own voice and dictation\n- Agents open files, diffs, web pages and control panels as windows next to you\n- Talk to your workspace: dictate into any window, ask for a file, a page or a new terminal\n\n**Your whole computer, without the monitor**\n- Live screen mirror of your Mac, with keyboard and mouse passthrough\n- Multiple workspaces you switch from the palm menu, each remembering its windows\n- Everything stays on your local network \u2014 your screen and terminals never leave the LAN\n\n**Hands only**\nNo controllers. Look at your palm for the menu, pinch to click, pinch-and-drag to move. A short tutorial gets you there in two minutes.\n\n**Requires the free VibeAR companion app on a Mac (Apple silicon, macOS 13+) on the same Wi-Fi.** Windows support is coming. Subscription or one-time purchase \u2014 buy once, every future release included.", "short_description": "You vibe coding cockpit, in AR"}]}, "developer_name": "TRMZ Studios", "developer_privacy_policy_url": "https://vibear.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TRMZ Studios", "support_website_url": null, "website_url": "https://vibear.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "int
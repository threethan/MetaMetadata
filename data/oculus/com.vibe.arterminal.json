ents.png", "id": "1007760565668006", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1007760569001339_3341721042825691790_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aMgQ5lsstcQ7kNvwGj7gRA&_nc_oc=AdojNeREpOHnz1JgbG97J57gmPa2tLiB6H4sHXQg8wkJAsIfHrbIzrspchl-TvtPi0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8gVNZqwjVRdm906KuqqFtrs0qgev0Cl3e5dRglmOS0Q&oe=6B047463"}, {"file_name": "04-editor.png", "id": "1070437339327529", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491829165_1070437345994195_6242735225508196825_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzCTeJbM4goQ7kNvwFqy_Ru&_nc_oc=AdqLMP9NMxtxEN-n7s8dLPaK_s0pIjkt678WdGi9qzAvkdMaYElq62_pEhHfNk1-mIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRABq_YC7z7c7nqbxIQXRFj5pAITuKBtndlQkJnBeCOAA&oe=6B045ECF"}, {"file_name": "03-hand-controls.png", "id": "2118005035503157", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828583_2118005038836490_4703373107234967124_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk3HIPA-V_4Q7kNvwHd1--u&_nc_oc=AdodsfBRwlzvikQXCfNqFhsSSM2Qj0wxdiklSNk_WQuXnCuDVET-iNo6tz3DIfjeagw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREwPghtlzke91NmV3l9EeSCYf3PO8H1poO-uI0rY5xfA&oe=6B0474E1"}, {"file_name": "01-browser.png", "id": "2432952877510539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_2432952887510538_6430410702380026795_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvSooDGeQFoQ7kNvwEv9wbZ&_nc_oc=AdpO9LXmzaEm3iR_VcjagXqgxDkx2dzkkZ_AQSy0rnPFJUTaLbI0H569cLm_0hipzhI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXr3EAkVBAEuHvfVnaLiCOreiSGzmVA4drycb9_Obizw&oe=6B047500"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VibeAR", "keywords": ["code", "vibe", "ai", "cockpit", "productivity"], "long_description": "**Your terminal, your editor and your agents \u2014 in the room with you.**\n\nVibeAR turns your Quest into a mixed-reality cockpit for your computer. Windows float in passthrough around your real desk: as many terminals as you need, browsers, notes, code and PDF viewers, 3D models, and a live mirror of your Mac screen. Move them with a pinch, keep your keyboard visible, and get back to work.\n\n**Built for coding with AI agents**\n- Run Claude Code, Codex or any CLI in floating terminals, each with its own voice and dictation\n- Agents open files, diffs, web pages and control panels as windows next to you\n- Talk to your workspace: dictate into any window, ask for a file, a page or a new terminal\n\n**Your whole computer, without the monitor**\n- Live screen mirror of your Mac, with keyboard and mouse passthrough\n- Multiple workspaces you switch from the palm menu, each remembering its windows\n- Everything stays on your local network \u2014 your screen and terminals never leave the LAN\n\n**Hands only**\nNo controllers. Look at your palm for the menu, pinch to click, pinch-and-drag to move. A short tutorial gets you there in two minutes.\n\n**Requires the free VibeAR companion app on a Mac (Apple silicon, macOS 13+) on the same Wi-Fi.** Windows support is coming. Subscription or one-time purchase \u2014 buy once, every future release included.", "short_description": "You vibe coding cockpit, in AR"}]}, "developer_name": "TRMZ Studios", "developer_privacy_policy_url": "https://vibear.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TRMZ Studios", "support_website_url": null, "website_url": "https://vibear.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "int
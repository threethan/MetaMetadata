ents.png", "id": "1007760565668006", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_1007760569001339_3341721042825691790_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aMgQ5lsstcQ7kNvwFmOuan&_nc_oc=AdpDEgs0-ZczFsB0F1NU2VlSNXit9oFDQDbtOdivUiirKt051deSqHNIOb_JCfWXO_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqelqDPb7N_K3iQot4ToHfSHqHd9SuCUyoSC0g89xiCA&oe=6B0322E3"}, {"file_name": "04-editor.png", "id": "1070437339327529", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491829165_1070437345994195_6242735225508196825_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6PCM1ATzogQ7kNvwGyc6Ee&_nc_oc=AdposYoEKtfirRpkmPGe1dMqu-MOLX1i5lhQW7jU6yThiwhi34IFyQyLbeRSDAkvv0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgeRsacXla6XvbhF5RTWrv5DwlavsmrMpFYam3q5BeMQ&oe=6B030D4F"}, {"file_name": "03-hand-controls.png", "id": "2118005035503157", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828583_2118005038836490_4703373107234967124_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk3HIPA-V_4Q7kNvwErQgGT&_nc_oc=AdoGvz_r2Wn2APYp549TpNrhgXpnIlzH9P_FPlqulB3My59uUzvTT5V7Id7iVFwtn-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc6o9kQ6xF0pO3ZUxE7QZzWcIJ1_o3oSKqPPrH7ppGtg&oe=6B032361"}, {"file_name": "01-browser.png", "id": "2432952877510539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825415_2432952887510538_6430410702380026795_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvSooDGeQFoQ7kNvwEg8Mzm&_nc_oc=AdpuJrJRJtm2QBgbRJLYX5qXH3k0sgb0idew0yWDFR3Ln8OzA6F7Oavz6GCi7_fOtAs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3zDu0v_SqcgPGt-ijW3zMWqXg2tpsIGSRFx9t7Sjabg&oe=6B032380"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VibeAR", "keywords": ["code", "vibe", "ai", "cockpit", "productivity"], "long_description": "**Your terminal, your editor and your agents \u2014 in the room with you.**\n\nVibeAR turns your Quest into a mixed-reality cockpit for your computer. Windows float in passthrough around your real desk: as many terminals as you need, browsers, notes, code and PDF viewers, 3D models, and a live mirror of your Mac screen. Move them with a pinch, keep your keyboard visible, and get back to work.\n\n**Built for coding with AI agents**\n- Run Claude Code, Codex or any CLI in floating terminals, each with its own voice and dictation\n- Agents open files, diffs, web pages and control panels as windows next to you\n- Talk to your workspace: dictate into any window, ask for a file, a page or a new terminal\n\n**Your whole computer, without the monitor**\n- Live screen mirror of your Mac, with keyboard and mouse passthrough\n- Multiple workspaces you switch from the palm menu, each remembering its windows\n- Everything stays on your local network \u2014 your screen and terminals never leave the LAN\n\n**Hands only**\nNo controllers. Look at your palm for the menu, pinch to click, pinch-and-drag to move. A short tutorial gets you there in two minutes.\n\n**Requires the free VibeAR companion app on a Mac (Apple silicon, macOS 13+) on the same Wi-Fi.** Windows support is coming. Subscription or one-time purchase \u2014 buy once, every future release included.", "short_description": "You vibe coding cockpit, in AR"}]}, "developer_name": "TRMZ Studios", "developer_privacy_policy_url": "https://vibear.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TRMZ Studios", "support_website_url": null, "website_url": "https://vibear.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "int
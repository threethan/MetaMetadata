ents.png", "id": "1007760565668006", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823757_1007760569001339_3341721042825691790_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4JAgnntWY4Q7kNvwGmPEih&_nc_oc=Adr74CtVDcSsNCisxhlwRUYqbxOfCDPwJxbTbbSurtzGKniA6dEQw3kTM_QDJumvHWA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWtxF6PDYgY1FDJeHNhKazLL2Q9EnDvEbORbrb_BC24w&oe=6AFB39E3"}, {"file_name": "04-editor.png", "id": "1070437339327529", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491829165_1070437345994195_6242735225508196825_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEfkbEOHBzcQ7kNvwE83FIa&_nc_oc=AdrBsctLVTTUkDejlITunoGTN-qZd5LI11_5Ke6W2p5aRQG-dl1uBLJQ4kUx9Nl1_T8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMt1_8tDcjzDZLkMkCmKuhd1WH9fYycMlLClmcqgZ6Tg&oe=6AFB244F"}, {"file_name": "03-hand-controls.png", "id": "2118005035503157", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828583_2118005038836490_4703373107234967124_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IobHqAcLUIoQ7kNvwEvKwZg&_nc_oc=AdrYTUUGKpUQ1DDyywhSY2M11gXGz8s-wenKEDEb_ZfzNQY4mAZEk7xc_1yfmav0JMk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwehTRxSao30ZFoqyu5OgMWtOqGPc6gsPQju9H9ayvlA&oe=6AFB3A61"}, {"file_name": "01-browser.png", "id": "2432952877510539", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825415_2432952887510538_6430410702380026795_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9uLOsxZKNsQ7kNvwEqp7uo&_nc_oc=AdrzyYwhAurFCOoqIX2n8SlZrngw39VmqElM-WVELiV3JImh5BZCsoL6YtBoMdnVD5k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIOz9bIvK0e07iUsGEh5x63P6clULbDYzXwEm5jodhmg&oe=6AFB3A80"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VibeAR", "keywords": ["code", "vibe", "ai", "cockpit", "productivity"], "long_description": "**Your terminal, your editor and your agents \u2014 in the room with you.**\n\nVibeAR turns your Quest into a mixed-reality cockpit for your computer. Windows float in passthrough around your real desk: as many terminals as you need, browsers, notes, code and PDF viewers, 3D models, and a live mirror of your Mac screen. Move them with a pinch, keep your keyboard visible, and get back to work.\n\n**Built for coding with AI agents**\n- Run Claude Code, Codex or any CLI in floating terminals, each with its own voice and dictation\n- Agents open files, diffs, web pages and control panels as windows next to you\n- Talk to your workspace: dictate into any window, ask for a file, a page or a new terminal\n\n**Your whole computer, without the monitor**\n- Live screen mirror of your Mac, with keyboard and mouse passthrough\n- Multiple workspaces you switch from the palm menu, each remembering its windows\n- Everything stays on your local network \u2014 your screen and terminals never leave the LAN\n\n**Hands only**\nNo controllers. Look at your palm for the menu, pinch to click, pinch-and-drag to move. A short tutorial gets you there in two minutes.\n\n**Requires the free VibeAR companion app on a Mac (Apple silicon, macOS 13+) on the same Wi-Fi.** Windows support is coming. Subscription or one-time purchase \u2014 buy once, every future release included.", "short_description": "You vibe coding cockpit, in AR"}]}, "developer_name": "TRMZ Studios", "developer_privacy_policy_url": "https://vibear.dev/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TRMZ Studios", "support_website_url": null, "website_url": "https://vibear.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "int
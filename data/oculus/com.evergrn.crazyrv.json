0a&_nc_ohc=TK_d6vUQYgMQ7kNvwFOVmdo&_nc_oc=AdrH0KGa2mwkiq-xd8It7IB6d9wKPvPEtW_uk2v_gGbuTJuD0IckUCamOjf0uG8SY-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRcP4vmOxVdDm9_9iLMyGISYbtv8rf3z2JrCu84XV7FA&oe=6B0C53BF"}, {"file_name": "screenshot-5-drive-2560x1440.png", "id": "2697551697674102", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596061819_2697551701007435_6657039847387478467_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyL4s54n5cUQ7kNvwEU07ob&_nc_oc=AdounZ0v8tzf7XXn6mW2t5_sur5XUpNM1zwsAbIkgy_R9gdWa38vTK8oK8ZuPqbYNMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTa6F5w8kclgailClpf5vroP2GlhOxK1cJUUaXGCpOPUg&oe=6B0C4F51"}, {"file_name": "screenshot-7-wildlife-2560x1440.png", "id": "1014587384267445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596157734_1014587387600778_4708961886336869209_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INQk9bYOpwwQ7kNvwHQwaSG&_nc_oc=Adp6-SxUT_7ZMAhOnt4VzZ-HqNSD29al_B6dDbPFYJ5eSDZAwrsYcWL9K2uc9S9rplY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_6dnT9dJdZnx3emfnRSrLFG5W8Zs1fsMJrHk1plgedg&oe=6B0C6349"}, {"file_name": "screenshot-8-party-2560x1440.png", "id": "29995005216768968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/814574569_29995005233435633_7604875667630303474_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0-GoTx53QQQ7kNvwG7i6yT&_nc_oc=AdoVrCqOCWiwy64VRITp8SRz9DovLOt_CPmHLQM5LVPVcpX_TI6jP--oNeFNE1DyKF8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0yuZQefa1fv36Dgn3f6QnWwJWF7XcJHpoO35Ecow9Ng&oe=6B0C63DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crazy RV", "keywords": ["camping", "RV", "multiplayer", "social", "driving"], "long_description": "Crazy RV is a goofy, hands-on camping trip for grown-ups. No plot, no pressure. Just you, your friends and a campground that deserves better.\n\nBack it in. Drive your clapped-out RV around Crazy Island, find your spot and reverse in with the rear camera. The dings are on you.\n\nSet up camp with your hands. Crank the jacks, plug in power, hook up water and sewer, roll out the awning and build a fire log by log. Rush it and find out: sewer hoses blow, awnings fly away, and you can always drive off still plugged in.\n\nParty. Beer pong, chug races, cornhole and horseshoes, with bets and dares. Fishing, fireworks, two radio stations, a helium tank and a megaphone.\n\nAnnoy the neighbors. Ten voiced campers put up with a lot. Push them too far and Ranger Rick turns up with fines, a taser and an eviction notice.\n\nFall over a lot. Knock your friends flat, carry them off, throw them in the lake or strap rockets to a camp chair.\n\nMind the wildlife. Raccoons steal your beer, the bear drinks it, and nobody wants to meet the skunk.\n\nCamp with friends. Host a campground online for up to 8 players, with proximity voice chat.\n\nTake it home. Polaroids, silly hats, bumper stickers and 34 achievements, plus cash toward a bigger rig, from the Rusty Pop-Up to Big Bertha.\n\nCrazy RV is for players 18+. It includes alcohol, tobacco and cannabis use, crude humor, cartoon violence and online voice chat with other players.", "short_description": "Pull into the campground, back your rig in (badly) and set up camp with your own two hands. Then bring up to 7 friends online and wreck the peace: beer pong, fireworks, raccoons in the cooler, a bear in the beer, and a park ranger with a taser who has had enough of you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://games.evergrn.co/crazy-rv-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Evergrn Games", "support_website_url": null, "website_url": "https://games.evergrn.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": 
D"}, {"file_name": "ss4.png", "id": "747918070964272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_747918074297605_8767638241208440650_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SeQVtZvbngQ7kNvwFoSihh&_nc_oc=AdrgIcoejkZlxDNGOL6eWfKuS5h3DgqCq5P2krGKQacx5Mdcqusl7DdGEJGWyVs7te4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp_WIpaLoSokmLv9n9t5hXklN51obBm8EKy5OGS7DGZw&oe=6A998E9B"}, {"file_name": "ss5.png", "id": "1432524134552070", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1432524137885403_4234822735098576945_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edCR5lRzfqAQ7kNvwGMNDrU&_nc_oc=AdqNaSLGScBkChYT2i5z5zoRbT_XAMIeRZueO879OESqZ5lfE05lCsWjEFQKzvuzGFI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZKblcRzQ5-5O_tKzarfGVAkl50U85t6I0LzujIww9SQ&oe=6A999744"}, {"file_name": "ss2.png", "id": "3034073453433142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_3034073456766475_3892762046522375561_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiJbYC9p7gUQ7kNvwEdLclj&_nc_oc=Adrwksm9pcb8Dd9X1Z7HFXWjC3HYmm2bWO7WB3sJcRqnMpTNtUTPSkSdPUJkEhr-4LI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTjsxLT4It54lsyeDxyhkS8_FB82ticN1XNX-AftAmuQ&oe=6A996CEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkathon", "keywords": ["Monke", "Monkey", "Gorilla", "PvP", "Free"], "long_description": "In Monkathon, the battlefield isn\u2019t just a playground\u2014it's a warzone of wits, reflexes, and raw monkey mischief (W reference). Two factions collide in a relentless Capture the Flag battle: the rebellious Miner Monkes, rising from the caves to reclaim their stolen flag, and the ruthless Monarch Monkes, defending their castle with fury and force.\n\nMiners must run, branch, and scheme their way from the mines to the castle\u2014dodging opps, outsmarting monkes, and risking it all to return their flag to sacred ground.\n\nBut failure has a price.\n\nOne touch from a Monarch, and it\u2019s over. You drop the flag. You\u2019re sent back in shame. And worst of all\u2026\nyou lose your monkeyness.\n\nThis isn\u2019t just a game. It\u2019s Monkathon\u2014where aura, bananas, and munyuns are all on the line.", "short_description": "In Monkathon, the battlefield isn\u2019t just a playground\u2014it's a warzone of wits, reflexes, and raw monkey mischief (W reference). \n\nMiners must run, branch, and scheme their way from the mines to the castle\u2014dodging opps, outsmarting monkes, and risking it all to return their flag to the mines once and for all.\n\nThis is the most unique monkey game you've seen, dont lie. Download it now: Monkathon."}]}, "developer_name": "Edivence", "developer_privacy_policy_url": "https://www.termsfeed.com/live/fa2ba6f5-69fa-42bb-9521-689661206b0d", "developer_terms_of_service_url": null, "publisher_name": "Edivence", "support_website_url": null, "website_url": "https://getagamesbusiness.wixsite.com/chimp-chase-pvp/copy-of-jmans-nigtmare", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "10066136803406391"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828806_1275289040965619_7902653288651951229_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRlRa
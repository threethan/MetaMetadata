D"}, {"file_name": "ss4.png", "id": "747918070964272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827063_747918074297605_8767638241208440650_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ih6E3M8_EekQ7kNvwFewYC7&_nc_oc=Adpgf3_aRNhHmtt4-AkE7V4XOQW2StHCR8woZODZbsIZg23hqKk0KvsoUk1lDLHAjkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_wQF-DAQTBLC_Up8EwQO7D15U0Wvt8kFozcGTW8MkpA&oe=6AC6619B"}, {"file_name": "ss5.png", "id": "1432524134552070", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1432524137885403_4234822735098576945_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1ufzg1H4R0Q7kNvwGzYVSo&_nc_oc=AdrwFMWi-dx576qFGPcg7oIl-o6ftB8DnhKpNXGkXjtfVz0-r-dx73En2mR_i2YFXv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSy-WhUDPgTxBZPajmG1awXq_nsxdRNzpdxjK8wTwqhQ&oe=6AC66A44"}, {"file_name": "ss2.png", "id": "3034073453433142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_3034073456766475_3892762046522375561_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SW7Fc7fkpRUQ7kNvwFj5Gj8&_nc_oc=AdoQ8W0bdHzRS9wUM4dijFRq-MNGiy8rK1FcAsAolLs1VsUCj5xgiPuH4sNOwwRBmZo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJURFnicT5yW7x6oR6lMFxanBRVC9Phyhj1l1nYEpKGA&oe=6AC63FEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkathon", "keywords": ["Monke", "Monkey", "Gorilla", "PvP", "Free"], "long_description": "In Monkathon, the battlefield isn\u2019t just a playground\u2014it's a warzone of wits, reflexes, and raw monkey mischief (W reference). Two factions collide in a relentless Capture the Flag battle: the rebellious Miner Monkes, rising from the caves to reclaim their stolen flag, and the ruthless Monarch Monkes, defending their castle with fury and force.\n\nMiners must run, branch, and scheme their way from the mines to the castle\u2014dodging opps, outsmarting monkes, and risking it all to return their flag to sacred ground.\n\nBut failure has a price.\n\nOne touch from a Monarch, and it\u2019s over. You drop the flag. You\u2019re sent back in shame. And worst of all\u2026\nyou lose your monkeyness.\n\nThis isn\u2019t just a game. It\u2019s Monkathon\u2014where aura, bananas, and munyuns are all on the line.", "short_description": "In Monkathon, the battlefield isn\u2019t just a playground\u2014it's a warzone of wits, reflexes, and raw monkey mischief (W reference). \n\nMiners must run, branch, and scheme their way from the mines to the castle\u2014dodging opps, outsmarting monkes, and risking it all to return their flag to the mines once and for all.\n\nThis is the most unique monkey game you've seen, dont lie. Download it now: Monkathon."}]}, "developer_name": "Edivence", "developer_privacy_policy_url": "https://www.termsfeed.com/live/fa2ba6f5-69fa-42bb-9521-689661206b0d", "developer_terms_of_service_url": null, "publisher_name": "Edivence", "support_website_url": null, "website_url": "https://getagamesbusiness.wixsite.com/chimp-chase-pvp/copy-of-jmans-nigtmare", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "10066136803406391"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828806_1275289040965619_7902653288651951229_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1du5v
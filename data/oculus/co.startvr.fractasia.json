lJEHcjILAkjYsgV5AgZLw&oe=69CE7B8E"}, {"file_name": "migrated_image.png", "id": "648748142359295", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12602331_100727620377167_701717126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtpg34bS1dcQ7kNvwHYBoTI&_nc_oc=AdpOAU1GVIRAIsMaPAvI0sIoUmE7jTH07W8eZCpnwE4bsuyPUJBXFKkfNDjRhF4-X-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZ_ZYgtbQ-NBE2r9Il9z0qXxIBCO-JxyWjVMPKmKNA0g&oe=69CE71B8"}, {"file_name": "migrated_image.png", "id": "494063714831732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410317_1681022235551324_324542408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC5sbcbp-CsQ7kNvwGNbCvn&_nc_oc=Adr9YAHyS35vruFikBTmfQu3U5XmzekhZYPJBUURRniUlhDUsgGDTz53-QA8lqTkBns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyffhrks6dW_0Zy5Sa3spMawmhVBzfBVfQ0MHRn27aXIw&oe=69CE813C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fractasia", "keywords": ["Julius", "Horsthuis", "Fractal", "Fractasia"], "long_description": "Explore the virtual reality worlds of Julius Horsthuis through an incredible journey of sight and sound. Explore surreal caverns of fractally generated crystals, glide through alien megastructures and relax as mountains of rock glide slowly by, all set to the amazing music of some of the world's best digital composers.\n\n\"With its expansive resolution, lighting and shadow, various textural qualities, and color depth, the complex beauty of the Mandelbulb becomes a thing to behold.\" - THE CREATORS PROJECT\n\nFractasia consists of several VR experiences including:\n - The Cryogenian\n - Machine VR\n - Crystal Habit\n - Foreign Nature\n\nFractasia is a stand alone app that can be viewed with a standard smartphone, or can be used with a Google Cardboard device.", "short_description": "Explore the virtual reality worlds of Julius Horsthuis through an incredible journey of sight and sound."}]}, "developer_name": null, "dev
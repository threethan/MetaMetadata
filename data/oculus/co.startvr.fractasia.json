": "migrated_image.png", "id": "144833066850991", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410245_1012605482192413_171249428_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-bJtGCImXEQ7kNvwEu68vS&_nc_oc=AdqmaKII3z6HiphykSbeYCmPq97ZNMP2uYu0QfJv1syhsKp9YJ0bJtzcUhdNLcX_Mh4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVTBz74ec63i5GeJXTU0MOY3o5TL0NF1ARxXEGcsl__Q&oe=6A71E711"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fractasia", "keywords": ["Julius", "Horsthuis", "Fractal", "Fractasia"], "long_description": "Explore the virtual reality worlds of Julius Horsthuis through an incredible journey of sight and sound. Explore surreal caverns of fractally generated crystals, glide through alien megastructures and relax as mountains of rock glide slowly by, all set to the amazing music of some of the world's best digital composers.\n\n\"With its expansive resolution, lighting and shadow, various textural qualities, and color depth, the complex beauty of the Mandelbulb becomes a thing to behold.\" - THE CREATORS PROJECT\n\nFractasia consists of several VR experiences including:\n - The Cryogenian\n - Machine VR\n - Crystal Habit\n - Foreign Nature\n\nFractasia is a stand alone app that can be viewed with a standard smartphone, or can be used with a Google Cardboard device.", "short_description": "Explore the virtual reality worlds of Julius Horsthuis through an incredible journey of sight and sound."}]}, "developer_name": null, "developer_privacy_policy_url": "http://startvr.co/privacy", "developer_terms_of_service_url": "http://startvr.co/terms", "publisher_name": "Start VR", "support_website_url": null, "website_url": "http://startvr.co/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC_VIDEO", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_
t=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqH4ucUwaLM8izNf2r9i8fCdgi_eqnn_6w-5D4ajC1Jw&oe=6AEF3446"}, {"file_name": "Untitled 3.png", "id": "1298349808393686", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831056_1298349811727019_7336871377865944106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdNU_ZRBYOAQ7kNvwFIUT7o&_nc_oc=AdoVkpjXp3MDzc_x1yxz_gDWLu2YIxqU0y2Q3D_TOs3R4Ltw7IB57FkET0A8jmEC5cI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHBFxYuvqVfqPDpQd5eee59dZeFX0ylkruYTa0NITE9g&oe=6AEF5ACD"}, {"file_name": "Untitled 2.png", "id": "3170393619776424", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830776_3170393626443090_3410520378249740414_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkeuiytEFzgQ7kNvwFMcBK7&_nc_oc=Adogb8N8-pGzdfHNqPxb2K9iwmjA6HTtHa-41BKI2UHHfmc4lOeDTg7KZW3EAxFLNN8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPIbPI7zDVEfD_0OR7qbwjVGIMual-sWBKL3Aaz0X2ug&oe=6AEF3471"}, {"file_name": "Untitled 1.png", "id": "736602182506697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820980_736602185840030_4966898967793529888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnC_lxv_zAcQ7kNvwFde1ZW&_nc_oc=Adp0IIVPebiLsn8QQ6kzIfDENloYi5iCmCQ99VaTDBdvpJxU9vgy8mXlQRlbKtlNEic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK4EpG4PrGvWaxI-v_xI7w5xvGUn-jaYHvdpKKr0bb7w&oe=6AEF5E5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Monke", "keywords": ["Multiplayer", "VR", "Scary", "Horror", "Funny"], "long_description": "Nightmare Monke is a free multiplayer VR social survival game where chaos, exploration, and monsters collide.\n\n\ud83c\udf0d Explore with friends\n\nTeam up with your friends or join public lobbies and jump into strange, unpredictable worlds.\nEvery session is different, every run can go wrong\u2026 fast.\n\n\ud83d\udc41\ufe0f Survive the unknown\nExplore eerie environments\nDiscover hidden areas\nSurvive encounters with mysterious creatures\n\nThe maps are full of danger, secrets, and stuff you really shouldn\u2019t touch\u2026 but you will anyway.\n\n\ud83c\udfae Mess around & interact\n\nGrab simple interactive objects like radios, fun props, and random items.\nUse them to:\n\ntroll your friends \ud83d\ude08\nsurvive longer\nor just create pure chaos\n\ud83d\udc35 Customize your monkey\n\nCreate your own character with unique skins and styles to stand out in every lobby.\n\n\u26a1 Every game is a story\n\nRun, explore, scream, laugh, repeat.\nNo two sessions are the same \u2014 it always turns into chaos somehow.\n{1354914899870353}", "short_description": "Nightmare Monke is a multiplayer VR survival game where you and your friends explore strange worlds, survive monsters, and mess around with fun objects while customizing your own character."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nightmaremonke.gamer.gd/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "MATTRAX Studio", "support_website_url": null, "website_url": "https://nightmaremonke.gamer.gd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "36046686001613977"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819315_7152970
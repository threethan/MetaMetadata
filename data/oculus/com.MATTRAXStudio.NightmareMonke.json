1727019_7336871377865944106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLd2cLERHFQQ7kNvwE-19Vj&_nc_oc=Adpn3MM0Aybce8ef2tYYjJMF_fSrk-mWxO8z-6nRuDf4ya_0HPSa-fNNJgHr_v998rY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMk22lwybmuKbgQguup5rw88NqfyHvuVeG-QDxC_zAdug&oe=6AC4F28D"}, {"file_name": "Untitled 2.png", "id": "3170393619776424", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830776_3170393626443090_3410520378249740414_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLa3d4ixOYoQ7kNvwEqB4Mp&_nc_oc=AdqcJ5Q3hxMmlkTAzO4xXhrObuntK2Ct-dUO352vb99qjX1bCiaW1P-w-2OmSkjY5DA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1Mn6FXoK06YCtRq5EV217J7CwcAmuUfEhtqzEj3nv1Q&oe=6AC50471"}, {"file_name": "Untitled 1.png", "id": "736602182506697", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820980_736602185840030_4966898967793529888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyLj3SMHM7cQ7kNvwH8ASya&_nc_oc=AdrUPS8wci7zalODCadXmwGuVQbc1kwJXNlttvWdH4ey05FU8qgpkjZ-uWXFnRrp6Dk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYOyV2ODS19I1DbnyuTcCSyaIjb0ReXmkRWCnuJFiP2Q&oe=6AC4F61B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Monke", "keywords": ["Multiplayer", "VR", "Scary", "Horror", "Funny"], "long_description": "Nightmare Monke is a free multiplayer VR social survival game where chaos, exploration, and monsters collide.\n\n\ud83c\udf0d Explore with friends\n\nTeam up with your friends or join public lobbies and jump into strange, unpredictable worlds.\nEvery session is different, every run can go wrong\u2026 fast.\n\n\ud83d\udc41\ufe0f Survive the unknown\nExplore eerie environments\nDiscover hidden areas\nSurvive encounters with mysterious creatures\n\nThe maps are full of danger, secrets, and stuff you really shouldn\u2019t touch\u2026 but you will anyway.\n\n\ud83c\udfae Mess around & interact\n\nGrab simple interactive objects like radios, fun props, and random items.\nUse them to:\n\ntroll your friends \ud83d\ude08\nsurvive longer\nor just create pure chaos\n\ud83d\udc35 Customize your monkey\n\nCreate your own character with unique skins and styles to stand out in every lobby.\n\n\u26a1 Every game is a story\n\nRun, explore, scream, laugh, repeat.\nNo two sessions are the same \u2014 it always turns into chaos somehow.\n{1354914899870353}", "short_description": "Nightmare Monke is a multiplayer VR survival game where you and your friends explore strange worlds, survive monsters, and mess around with fun objects while customizing your own character."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nightmaremonke.gamer.gd/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "MATTRAX Studio", "support_website_url": null, "website_url": "https://nightmaremonke.gamer.gd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "36046686001613977"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819315_715297001487697_3803110416010367550_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDuw5K4pCx8Q7kNvwHDre2g&_nc_oc=AdqNXMpYy48Qy5UohPAGR4XdxLAO2HwtMpUCOolBGJ-1o1YV9S-GK0CC0KIQ4-OiwcM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss
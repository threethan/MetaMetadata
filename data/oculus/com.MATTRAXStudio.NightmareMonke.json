91831382_1454861429164036_7571103226974814869_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlwC8xJM7ywQ7kNvwFvChT9&_nc_oc=AdoaCbtAslEtou4PfbX2n2oa_bhgERATsDXv-C1NohAGSkGFZbENdA4Anz-cFD2orAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVRafp-BG9kS4XeWwEjwj0UhXtoc7N2NYxbmFycwN38A&oe=6B0057C6"}, {"file_name": "Untitled 3.png", "id": "1298349808393686", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831056_1298349811727019_7336871377865944106_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdN79xgqMhkQ7kNvwFvTG5d&_nc_oc=Adq9u3VVeLuVTxNWhozUtNb1bvUFp-xV9NgDKdUffZfK1rEUdhPxBSa8KB386y9ioVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa976T7sJ-SU4QUrHlqnN-F0c_iN5A4I1_sihRzxiihQ&oe=6B007E4D"}, {"file_name": "Untitled 2.png", "id": "3170393619776424", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830776_3170393626443090_3410520378249740414_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCOhXHyLsW4Q7kNvwF4S57D&_nc_oc=Adr-quHdTP3AM64ZQTqIUPWbb-INvhexOXhcksycbh697n7MBc1fWGmk79gg7W1qtzA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfHAR2mT2roUB4PKk1Mm47cuMsTSohHe-MJrVU5tT3Eg&oe=6B0057F1"}, {"file_name": "Untitled 1.png", "id": "736602182506697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820980_736602185840030_4966898967793529888_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBYhHgsJdA8Q7kNvwEq_YvT&_nc_oc=AdoRabCbUFI5fT-ZTTp-KgBuSwDcTrNyyLpbSa_yUM95mI-SQz7B8uNiWNH1qVDF3GU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqqBevaUi4DdPr00pemGXHVi_dM8uz-7h7Q4ipAWReJQ&oe=6B0081DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Monke", "keywords": ["Multiplayer", "VR", "Scary", "Horror", "Funny"], "long_description": "Nightmare Monke is a free multiplayer VR social survival game where chaos, exploration, and monsters collide.\n\n\ud83c\udf0d Explore with friends\n\nTeam up with your friends or join public lobbies and jump into strange, unpredictable worlds.\nEvery session is different, every run can go wrong\u2026 fast.\n\n\ud83d\udc41\ufe0f Survive the unknown\nExplore eerie environments\nDiscover hidden areas\nSurvive encounters with mysterious creatures\n\nThe maps are full of danger, secrets, and stuff you really shouldn\u2019t touch\u2026 but you will anyway.\n\n\ud83c\udfae Mess around & interact\n\nGrab simple interactive objects like radios, fun props, and random items.\nUse them to:\n\ntroll your friends \ud83d\ude08\nsurvive longer\nor just create pure chaos\n\ud83d\udc35 Customize your monkey\n\nCreate your own character with unique skins and styles to stand out in every lobby.\n\n\u26a1 Every game is a story\n\nRun, explore, scream, laugh, repeat.\nNo two sessions are the same \u2014 it always turns into chaos somehow.\n{1354914899870353}", "short_description": "Nightmare Monke is a multiplayer VR survival game where you and your friends explore strange worlds, survive monsters, and mess around with fun objects while customizing your own character."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nightmaremonke.gamer.gd/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "MATTRAX Studio", "support_website_url": null, "website_url": "https://nightmaremonke.gamer.gd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
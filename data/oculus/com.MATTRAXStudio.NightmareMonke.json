1727019_7336871377865944106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_F2f4rzrEhUQ7kNvwGU09_U&_nc_oc=Adq52ZFHeqoZMAz1Jgu3I76uK28RVb2LL4dEpJ2AgsU7Hqt_OmTrZ1ELIVNjLl78jEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCswk85fsK4I-RwVh2DG3jJodKEeFncK6jBupSYkLBtKA&oe=6A53918D"}, {"file_name": "Untitled 2.png", "id": "3170393619776424", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830776_3170393626443090_3410520378249740414_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rZTRNzKwYkQ7kNvwF31erb&_nc_oc=Adpl_Zfu-4loDsZMr_tBkvDAXCIC_UTUMOEf_4i-xiV1StFv563NWngZy-_lvLx7ZQ8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfttNZXof_1Ti16k5s5fx4HQYO0sPEKBd9qVxfxew8uA&oe=6A53A371"}, {"file_name": "Untitled 1.png", "id": "736602182506697", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820980_736602185840030_4966898967793529888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uboBtriRUwMQ7kNvwGuI5tY&_nc_oc=Ado_RNfLPf3liKevTrusiGmcu7kwQG7d4SKXiubcOhL8eKl_3rkzJSmuWTwtXrjcP_8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwI647ImxDymjnLrzzN1QZXXj7O_syG9H11yPj5txLLw&oe=6A53951B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Monke", "keywords": ["Multiplayer", "VR", "Scary", "Horror", "Funny"], "long_description": "Nightmare Monke is a free multiplayer VR social survival game where chaos, exploration, and monsters collide.\n\n\ud83c\udf0d Explore with friends\n\nTeam up with your friends or join public lobbies and jump into strange, unpredictable worlds.\nEvery session is different, every run can go wrong\u2026 fast.\n\n\ud83d\udc41\ufe0f Survive the unknown\nExplore eerie environments\nDiscover hidden areas\nSurvive encounters with mysterious creatures\n\nThe maps are full of danger, secrets, and stuff you really shouldn\u2019t touch\u2026 but you will anyway.\n\n\ud83c\udfae Mess around & interact\n\nGrab simple interactive objects like radios, fun props, and random items.\nUse them to:\n\ntroll your friends \ud83d\ude08\nsurvive longer\nor just create pure chaos\n\ud83d\udc35 Customize your monkey\n\nCreate your own character with unique skins and styles to stand out in every lobby.\n\n\u26a1 Every game is a story\n\nRun, explore, scream, laugh, repeat.\nNo two sessions are the same \u2014 it always turns into chaos somehow.\n{1354914899870353}", "short_description": "Nightmare Monke is a multiplayer VR survival game where you and your friends explore strange worlds, survive monsters, and mess around with fun objects while customizing your own character."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nightmaremonke.gamer.gd/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "MATTRAX Studio", "support_website_url": null, "website_url": "https://nightmaremonke.gamer.gd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "36046686001613977"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819315_715297001487697_3803110416010367550_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYAeYGsDl-4Q7kNvwHcoJNI&_nc_oc=Ado4gpO7Y8QwAPQDR3fVU0zXEBSWRD2tvj9k73FzeIeKjBhNuuvksuEifac4wZe5RM0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss
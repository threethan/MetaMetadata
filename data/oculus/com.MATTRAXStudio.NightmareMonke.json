t=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuvB9IeB4KRYGmdCFnKOoFx8fYD9uOpu-tZlU4CuMIFA&oe=6AE74B46"}, {"file_name": "Untitled 3.png", "id": "1298349808393686", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831056_1298349811727019_7336871377865944106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKZymzyI2WEQ7kNvwHqjDwX&_nc_oc=AdrT7SXanRf1oqO-eyhTDJ_yWqvdpwa4w9-ju_dcgLqud9vGZy9vmhVb5R5-KDLZaV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVTuyQpwxVqF1oXqCW1I00jLWXO6XucLfuK7TzLxXt4A&oe=6AE7398D"}, {"file_name": "Untitled 2.png", "id": "3170393619776424", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830776_3170393626443090_3410520378249740414_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9q7d-m29s4Q7kNvwECAJNE&_nc_oc=AdpJppBGf8wMdcIH3XVXFg43P30ivYIUqesbPd4BCd4BRUo5slu8yQqDKGNldszvk4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFEIqU2IvPdSho_8OxFzez4sK8yfG45S-2wQXszerG3g&oe=6AE74B71"}, {"file_name": "Untitled 1.png", "id": "736602182506697", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820980_736602185840030_4966898967793529888_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdYkUARH5pUQ7kNvwH5oQ56&_nc_oc=AdqmD5l7m7_yH-QoQAwL5tJh-om-9XxWCVWd7UKWdxgdjJJ5USFp6YBxrujdQaNffts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-65cgveuDdeJE5JxXkMIHTnV5RAbzuKdHUein7GoNCA&oe=6AE73D1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Monke", "keywords": ["Multiplayer", "VR", "Scary", "Horror", "Funny"], "long_description": "Nightmare Monke is a free multiplayer VR social survival game where chaos, exploration, and monsters collide.\n\n\ud83c\udf0d Explore with friends\n\nTeam up with your friends or join public lobbies and jump into strange, unpredictable worlds.\nEvery session is different, every run can go wrong\u2026 fast.\n\n\ud83d\udc41\ufe0f Survive the unknown\nExplore eerie environments\nDiscover hidden areas\nSurvive encounters with mysterious creatures\n\nThe maps are full of danger, secrets, and stuff you really shouldn\u2019t touch\u2026 but you will anyway.\n\n\ud83c\udfae Mess around & interact\n\nGrab simple interactive objects like radios, fun props, and random items.\nUse them to:\n\ntroll your friends \ud83d\ude08\nsurvive longer\nor just create pure chaos\n\ud83d\udc35 Customize your monkey\n\nCreate your own character with unique skins and styles to stand out in every lobby.\n\n\u26a1 Every game is a story\n\nRun, explore, scream, laugh, repeat.\nNo two sessions are the same \u2014 it always turns into chaos somehow.\n{1354914899870353}", "short_description": "Nightmare Monke is a multiplayer VR survival game where you and your friends explore strange worlds, survive monsters, and mess around with fun objects while customizing your own character."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nightmaremonke.gamer.gd/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "MATTRAX Studio", "support_website_url": null, "website_url": "https://nightmaremonke.gamer.gd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "36046686001613977"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819315_7152970
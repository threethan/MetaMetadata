3GU84d58BFgcX6-MZLg&oe=6B05B8EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta&TAFE_EPT_LS2560x1440.png", "id": "1506806839837954", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982601_1506806843171287_1321051168979977825_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol7ZHukgAXQQ7kNvwF1cOLP&_nc_oc=Adp2pBJ-6_a8m0K5X5lu5BBnic_CVYif9EwOTi74ZlVa_0JlQ0qgr4G6okKhD6n0jZw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShVQ-KCpQNE07vFlGTi5DVcKYGiS7cpBlL1cDX7ELnAA&oe=6B05D101"}, "display_name": "Explosive Power Tools Safety", "keywords": [], "long_description": "Explosive Power Tools Safety teaches players how to safely operate an Explosive Power Tool (EPT). Players are guided through the procedures required to correctly use an EPT to fix a wooden beam to a concrete wall. This includes the selection of an appropriate driver (nail), charge strength and EPT power setting, as well as the signage, exclusion zones and vocal warnings required when operating an EPT. Once the guided section is complete, the player\u2019s knowledge is tested by completing the same process with no guidance. Players are given real-time feedback automatically as they progress through the assessment.  ", "short_description": "Explosive Power Tools Safety teaches players how to safely operate an Explosive Power Tool (EPT). Players are guided through the procedures required to correctly use an EPT to fix a wooden beam to a concrete wall."}]}, "developer_name": "TAFE NSW", "developer_privacy_policy_url": "https://www.tafensw.edu.au/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAFE NSW", "support_website_url": null, "website_url": "https://www.tafensw.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "extern
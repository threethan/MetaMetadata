c=bnG_c7LlSRkQ7kNvwG0GhXG&_nc_oc=AdoCrDMtClSL0yc4niB5_92zQxvBBlyYSehTsyAvi0yFYO672na5B9QDfaN_qTHGKLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq9RGbhwVZCGtvP8ktDcLcDLBcpBQyRs9Ex1gpcH-2Bw&oe=6ACCE841"}, "display_name": "Explosive Power Tools Safety", "keywords": [], "long_description": "Explosive Power Tools Safety teaches players how to safely operate an Explosive Power Tool (EPT). Players are guided through the procedures required to correctly use an EPT to fix a wooden beam to a concrete wall. This includes the selection of an appropriate driver (nail), charge strength and EPT power setting, as well as the signage, exclusion zones and vocal warnings required when operating an EPT. Once the guided section is complete, the player\u2019s knowledge is tested by completing the same process with no guidance. Players are given real-time feedback automatically as they progress through the assessment.  ", "short_description": "Explosive Power Tools Safety teaches players how to safely operate an Explosive Power Tool (EPT). Players are guided through the procedures required to correctly use an EPT to fix a wooden beam to a concrete wall."}]}, "developer_name": "TAFE NSW", "developer_privacy_policy_url": "https://www.tafensw.edu.au/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAFE NSW", "support_website_url": null, "website_url": "https://www.tafensw.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
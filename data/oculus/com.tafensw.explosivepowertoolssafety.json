i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974549_625563795881551_8252552775742797012_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vsD-bnoi78Q7kNvwG9s6oV&_nc_oc=Adklg9dmI3wYXuKxWDB091H3Gt196KYs2qzpPuQdWcEC0HiPQgjiR9ocvgD8PW4cKVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuDbDPsMQjilXBeLvkhMHiIU5WLHrorypCVy6T72rxl5A&oe=699C611A"}, {"file_name": "EPT_Screenshot_01.png", "id": "685983652961287", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974760_685983656294620_3526062809161421026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0m8Y79Tp8T0Q7kNvwEJGwN2&_nc_oc=AdmxWPlIdfGQ7pZCG_l6gDz6fhONaSFsWkJLSjY7NU34k-f6RlAINOYdntOrueXsFSs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfstJpjfRDjIM66I7OMvLE9Wx1G8FuRbz3Vbbxc4_NKTTQ&oe=699C45AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Explosive Power Tools Safety", "keywords": [], "long_description": "Explosive Power Tools Safety teaches players how to safely operate an Explosive Power Tool (EPT). Players are guided through the procedures required to correctly use an EPT to fix a wooden beam to a concrete wall. This includes the selection of an appropriate driver (nail), charge strength and EPT power setting, as well as the signage, exclusion zones and vocal warnings required when operating an EPT. Once the guided section is complete, the player\u2019s knowledge is tested by completing the same process with no guidance. Players are given real-time feedback automatically as they progress through the assessment.  ", "short_description": "Explosive Power Tools Safety teaches players how to safely operate an Explosive Power Tool (EPT). Players are guided through the procedures required to correctly use an EPT to fix a wooden beam to a concrete wall."}]}, "developer_name": "TAFE NSW", "developer_privacy_policy_url": "https://www.tafensw.edu.au/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAFE NSW", "support_website_
i": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974549_625563795881551_8252552775742797012_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGbFnTNoMA0Q7kNvwF4VHNp&_nc_oc=Adn51EBmtc--3lfQqohpv2cA39X9TchNWX2IE4Xkt7JDweRyILc7J1QIYl68I2jRABQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfueBIxH_mp19G7W8bY12P01Ykn-kQliS7OdsqZNNcmI_g&oe=69A0559A"}, {"file_name": "EPT_Screenshot_01.png", "id": "685983652961287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974760_685983656294620_3526062809161421026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHO3QLXp1KEQ7kNvwExD7Hp&_nc_oc=AdkXXwrBXE6w-52vg_8kPSo3tzEMeTyxwnODMF5SBBz5aFoD5uWCsPqkK2JRIz8lslo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsuKu4lj3QsspE1ONxjB6c9NYh-jC4TS3Ikfvahwy1P0w&oe=69A03A2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Explosive Power Tools Safety", "keywords": [], "long_description": "Explosive Power Tools Safety teaches players how to safely operate an Explosive Power Tool (EPT). Players are guided through the procedures required to correctly use an EPT to fix a wooden beam to a concrete wall. This includes the selection of an appropriate driver (nail), charge strength and EPT power setting, as well as the signage, exclusion zones and vocal warnings required when operating an EPT. Once the guided section is complete, the player\u2019s knowledge is tested by completing the same process with no guidance. Players are given real-time feedback automatically as they progress through the assessment.  ", "short_description": "Explosive Power Tools Safety teaches players how to safely operate an Explosive Power Tool (EPT). Players are guided through the procedures required to correctly use an EPT to fix a wooden beam to a concrete wall."}]}, "developer_name": "TAFE NSW", "developer_privacy_policy_url": "https://www.tafensw.edu.au/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAFE NSW", "support_website_
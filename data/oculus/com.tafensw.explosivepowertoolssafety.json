i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974549_625563795881551_8252552775742797012_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vsD-bnoi78Q7kNvwF2QlY2&_nc_oc=AdmmU-3U_I-PjczEsSw0RaXZOomWs3PC9ohBkUp5SLH4sOW4I22v5NX8jf90rEw550g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft04L1FrgkQnNSjvLlGVhrq1x2XaXDHZaJm8SGeqh8mHw&oe=699F041A"}, {"file_name": "EPT_Screenshot_01.png", "id": "685983652961287", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974760_685983656294620_3526062809161421026_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHO3QLXp1KEQ7kNvwFa2T7c&_nc_oc=AdkFtMhFXzKlnLdlwpPacb4lCatpwFTQc8RdiQpNBP6FEafkqAEvBpx0CLbkRxzVx6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfviaA9hvJV4yXIFCUBw3AaMZFiqngW10kQiV2GOfh_vLw&oe=699EE8AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Explosive Power Tools Safety", "keywords": [], "long_description": "Explosive Power Tools Safety teaches players how to safely operate an Explosive Power Tool (EPT). Players are guided through the procedures required to correctly use an EPT to fix a wooden beam to a concrete wall. This includes the selection of an appropriate driver (nail), charge strength and EPT power setting, as well as the signage, exclusion zones and vocal warnings required when operating an EPT. Once the guided section is complete, the player\u2019s knowledge is tested by completing the same process with no guidance. Players are given real-time feedback automatically as they progress through the assessment.  ", "short_description": "Explosive Power Tools Safety teaches players how to safely operate an Explosive Power Tool (EPT). Players are guided through the procedures required to correctly use an EPT to fix a wooden beam to a concrete wall."}]}, "developer_name": "TAFE NSW", "developer_privacy_policy_url": "https://www.tafensw.edu.au/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAFE NSW", "support_website_
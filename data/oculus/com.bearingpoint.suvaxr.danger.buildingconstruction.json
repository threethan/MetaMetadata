E-Ox8Qy324rksr4X1pI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUdBP3GiTzkUwNAVNe-DP2ljipXCyoMQi2jJhiNrW-nA&oe=6B0DA50A"}, {"file_name": "Scenario01.png", "id": "1362005388580591", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393095_1362005398580590_1726123387811544538_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmCKZtqXlw4Q7kNvwF-Z-UD&_nc_oc=AdqaEIjpTTZsQEAykk9eXzV1A9prqq1Bpjq7tSaVaKL0uK_QlILz6JRtlWe9Vf1V2RM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHzO4pZrn8oL9uAEaU-5DxhV1snSCvksJ-GEIRlsPDVA&oe=6B0DCD2D"}, {"file_name": "Scenario02.png", "id": "1181069160095139", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391749_1181069163428472_1647202234934614309_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HNYJkrSd1oQ7kNvwEcpbV8&_nc_oc=AdqrBtKcxLcbjdw1eZYErRTdPTNOwfEYvG8AcGFEs6HGR9SJC8iTJvq6m8Rn_fp8kKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTcDS68NtlN2P2ovgFPpQLOpCxk16zMI4fI4WctKxTdRw&oe=6B0DC2C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swiss Safety VR: Construction", "keywords": ["Construction", "Accident", "Safety", "Worksafety", "Worker"], "long_description": "Immerse yourself in a new dimension of work safety on construction sites with this advanced, highly immersive VR experience! Venture into the complex world of construction work, encounter various challenging work situations and learn about common accident situations from the perspective of a construction worker. \n\nWith a realistic, detailed setting, this VR experience lets you experience the downsides of faulty and unsafe behavior up close. Sharpen your skills and recognize the importance of safe behavior on construction sites without risking injury.\n\nOur VR experience not only provides a safe experience, but also an engaging way to raise awareness of workplace hazards. Embark on your personal safety mission - because safety in the workplace shouldn't be wishful thinking. The revolution in safety-oriented training starts here.", "short_description": "Take on the role of a construction worker and experience typical accident situations on the construction site. Identify risks and learn from incorrect actions. The detailed VR environment allows you to experience accident hazards without the risk of injury. The revolution in safety-oriented training starts here."}, {"images": {"nodes": [{"file_name": "Hero.png", "id": "3712420122234937", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393188_3712420125568270_8947156417060786192_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gCNNQl5yN4Q7kNvwFrf63u&_nc_oc=AdoeA6ZhRaxTJzz05LANOgjrBbIyKktJ011TlNAxT5I6z_5ZyKdnWtHLXM3_ocb_qXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQV-J1lx2WJ1tUHNM8JFksoaTK_K_B4NWT2y-2PJtjneA&oe=6B0DA04B"}, {"file_name": "CoverArt_square.png", "id": "3579494148847900", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391821_3579494155514566_2840737809727433639_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZR8mWDI8QEQ7kNvwHJBbIR&_nc_oc=AdoxLQxZcwofvt4g7W41U8_o9fPBSKrNroNp11jibouDSHQRY8EFvPmi1e5T3pUCOTY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSG2FDGv0xFhV8MVRlOxCtEqBX4is5exk4owFWVozPuiA&oe=6B0DCEEC"}, {"file_name": "CoverArt.png", "id": "1835478343658685", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391843_1835478350325351_8089125838768573636_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjSt9PGVOk8Q7kNvwHEe54z&_nc_oc=AdovRhC5ClWWU81Pr2R7Hy3Ld20ncjOuvO5kygrp284csfy1H0brONO6YBbys_bKNoc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTuqFwiPb12eE_KujmdJkiUdh9v7otmagdwhvlbOHwHIQ&oe=6B0DBAF9"}, {"file_n
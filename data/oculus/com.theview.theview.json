2xoQ7kNvwGyY0gb&_nc_oc=AdkP3v9cf8OJee2oJ3Rx3Sbsa2kN1NwodEYSYR1clPMNRV56ctoU23OSp4JWxgCkPVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft1VtffuzyB91bl8cJQp7wp4TGW3eBGxBacJ8_V_jZ0hA&oe=69A050A7"}, {"file_name": "1.png", "id": "978237866506843", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75556802_978237869840176_9006998471809465241_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfgNz7NC1coQ7kNvwHVZPKa&_nc_oc=Adls1mJxAZOkN_Ue5yQ3c69gZEGJQyRk0Tad_wAcpp1HButjTL_HFOPvBAnQdDJMlhI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft3QPQj-qbfEoYM_z4l0f5bSTw1g3mDOwkBPGn_B8j_uA&oe=69A0509B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover landscape 4.png", "id": "6103641789717421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367595_6103641793050754_2053282393011989025_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjBoEXC0OkMQ7kNvwGS8gGh&_nc_oc=Adnpsj65M0KjPUrBf2s7jB1SumVrZgcm6uAugP1LBaUR6YRMxThcW_dz7UpA9e4BVxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afus4ULJEAK-tMaPANUS-1jdNtDikcwzhrs-q1YSQNibBg&oe=69A03145"}, "display_name": "The View", "keywords": [], "long_description": "Step into our VR world for an immersive and exciting way to connect, collaborate, and explore with friends. Create a custom avatar and you\u2019ll be ready to make our giant treehouse in the forest your new virtual home! It\u2019s a cozy place to unwind and meet new people, as well as build your own experiences.\n\nAre you ready to perform? Transport to our Entertainment Hub. You and your friends can show off your singing and comedy skills at our open mic.\n\nNeed a place to innovate? Bring in-house and remote teams together in our futuristic Business Hub. Host meetings, grow ideas, set goals and celebrate your successes in a private, digital environment.", "short_description": "Step into our VR world for an immersive and exciting way to connect, collaborate, and explore with friends. Create a custom avatar and you\u2019ll be ready to make our giant treehouse in the forest your new virtual home!\nAre you ready to perform? Transport to our Entertainment Hub. You and your friends can show off your singing and comedy skills at our open mic.\nNeed a place to innovate? Bring in-house and remote teams together in our futuristic Business Hub."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jointheview.com/privacy-policy-app", "developer_terms_of_service_url": null, "publisher_name": "The View B.V.", "support_website_url": null, "website_url": "https://www.jointheview.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "163569296649586"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6628849970504124", "version": "1.2.0"}, "id": "922143092126830", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5755799267809203", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6628849970504124"}, "release_status": "RELEASED"}, "binary_release_channels": {"node
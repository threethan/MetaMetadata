PECDlbc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i-U4VDZJynEqTk_gBQfK3SPBlFS_R3zFhl4QhtbFEPA&oe=6A340B8B"}, {"file_name": "BG Cargo Screenshots-14.png", "id": "1746798959846662", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499310734_1746798963179995_6453460177405545472_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUOL5fseM1IQ7kNvwFHVJku&_nc_oc=AdprtlG3mmnDobVeF525E0M64hw545PDhbJuCdMp_ekDGUcEott4GDdFbvAQy-OJVnk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PCpwVS9I1OY4oTgUpLA8aL0LCDep-xSpDknKWqggLMg&oe=6A33EAB3"}, {"file_name": "BG Confrontation RAW Wide 2560x1440.png", "id": "801855859466535", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619680_801855862799868_8134251572011909613_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7QWlMflCOsQ7kNvwEPhH7o&_nc_oc=AdoWwMJkgCZSRfa_Gp8Nna0mBpavdnhfvavifTVh9Ktgm_wjbcVtjVZa0H9nmsvmTos&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IWXZIPnO6zKGrpURFj3gfsVdO1hVuEVvut0iyLZdFiQ&oe=6A33F0D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BG KeyArt Cargo Tagline 2560x1440 (1).png", "id": "799980859712169", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310817_799980863045502_3822986585774264373_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQl1fkHaKNYQ7kNvwEZEgs7&_nc_oc=Adq7FPBgF1crodAfYIJYfoDCbKls5wAcCxiMd07ox9YhToTMOKQfne6zx5PH2Tbf_q4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TV5-Mxg5DfFT8snhtsGPlFVXk01zTIFR3rZmkahJDng&oe=6A3402B7"}, "display_name": "BlackGate", "keywords": ["horror", "alien", "scifi", "multiplayer", "free"], "long_description": "# Prepare to Enter Blackgate Station\n\nApril Update: **New** Alien unlock at lvl 20 for Premium players. \n\nFree to start. Engineer role is free!  A zero-gravity asymmetric horror game inspired by Dead by Daylight and Echo Arena. One player plays an evolving Alien pit against Engineer Players. An Alien player is required to start a match.\n\nGet the Discord Suit FREE and join for WEEKLY GIVEAWAYS OF THE PREMIUM GAME \u27a1\ufe0f discord.gg/6fdjPEYBEZ\n\n{878035581710247}\nAs an engineer, you and your team are sent to repair **BlackGate** station. Your mission is clear: restore **crucial systems**, unlock the **Armory**, and most importantly\u2014stay alive. Each engineer plays a crucial role in their team's survival. \n{2078505882972242}\nNavigating the station isn\u2019t easy. Using your thrusters and environment, you\u2019ll need to push and pull your way through zero gravity. Watch your back!\n{802639298772235}\nThe Alien begins inside the nest deep within the ship, working its way towards its prey. As the specimen, your goal is simple but deadly. You start in a weak, larval form\u2014but quickly will gain the ability to evolve and flip the script.\n{1235492495220759}\nOnce you **evolve**, you unlock new abilities\u2014becoming a lethal monster capable of taking on the engineers head-to-head, or luring them into debilitating traps. \n{1620044352745251}\nIf the Engineers arm themselves, the tables could turn. In **BlackGate**, the clock is always ticking. Will the engineers work together to repair the station and take down the alien, or will the specimen evolve into an unstoppable force and claim victory? \n\n**\u00a9 2026 Megaverse LLC, a Fun Train\u00ae company.**", "short_description": "A zero gravity multiplayer game focused on intense space combat and teamwork in 4v1 missions. Free for Engineer role. In this multiplayer horror game, a team of 4 Engineers must work together to restore function to their space station while repelling a hostile alien played by a 5th player.\n\nGet the Discord Suit FREE and join for WEEKLY GIVEAWAYS OF THE PREMIUM GAME \u27a1\ufe0f discord.gg/6fdjPEYBEZ"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.funtrainvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fun Train Inc.", "support_
om&_nc_ss=7f20f&oh=00_Af97FtOXToeM0yrkDHEZn0m1J_8C82jyzIptMAFIYtnaoQ&oe=6A33F09D"}, {"file_name": "RedEngineers_Meta_2560x1440.png", "id": "2701924036645662", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982446_2701924039978995_6998264774158266385_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd6X-9IcwHwQ7kNvwGR7906&_nc_oc=AdreF190lo5XwMDXJKAhbxD0R_N_ve-QuL8zKfx3Z63rDEcVLufWIFor2BzmmkDd828&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r8nZHH3LEtM01tlMq3Ek52F2lcV-SQ3VcZ0d4XHtxRw&oe=6A341D9D"}, {"file_name": "TwoAstronauts_Meta_2560x1440.png", "id": "1018392676666570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982612_1018392679999903_2158008212385498918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efiN5H7q6FEQ7kNvwEfzJyr&_nc_oc=AdrHCHsmPPtEjrbrkj85aGZxzEIQGZz6DgUwISdJI78PG1A0EqNmVde16FEmWAzjQA0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RwDNtnmdiFkMr_jAZX_TmJ474oz938oNsxrcUQBmj2g&oe=6A3417D2"}, {"file_name": "AlienandGun_Meta_2560x1440.png", "id": "1315856402689256", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/468721194_1315856409355922_2661479644253729206_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abdK77lbafIQ7kNvwGWjLDs&_nc_oc=AdqTneLbF_Z9ad6KfFH3EQkFoeaiuKE_PE8zOScrkWAiTD4CDyn3z-ZGbnS6B9_ap5U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MLCW_hQiqGO63k_4iddeYNareNuylpAI7B4tMTJOP2w&oe=6A33F599"}, {"file_name": "Healing_Meta_2560x1440.png", "id": "2981666218799307", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035372_2981666222132640_5377214957752244739_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKyVesG4FfgQ7kNvwGdshS0&_nc_oc=Adoh7PoZV0zxs4Ona-NpUsPkMGALBMWGfZxHjAaVC48MaNES86xpRAWDb5dVql0BzFY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EFWulEa2OvJtvRqgxOm6qj_8_M1jMSO_p_H0_H7dLBQ&oe=6A341A06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BlackgateAstros_2560x1440.png", "id": "1610692936207537", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982688_1610692939540870_3764766995775426536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHyIb4l9LDIQ7kNvwEuLgzS&_nc_oc=Adp7s8SO3IHPlkaN7V1DVO3gItiEtHPlthba0JOp2e4OmCzTUUDlOKGmdAk1HHj0kMM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B3hEzy5gyKLY3JWYqXxTuFqi3YAmYNk6uAI2QYQDsYg&oe=6A33F6DC"}, "display_name": "BlackGate", "keywords": [], "long_description": "# Welcome to BlackGate. \n\nIn this asymmetrical multiplayer experience, every player has a unique role to play, with one ultimate goal: survival.  Up to 4 Engineers are pit against an alien specimen controlled by a 5th player. \n{2964488347035663}\nAs an engineer, you and your team are sent to repair BlackGate station. Your mission is clear: restore power to the station, unlock crucial systems, and most importantly\u2014stay alive. Navigating the station isn\u2019t easy. Using your thrusters and environment, you\u2019ll need to push and pull your way through zero gravity, watching your back at every turn.\n{1543893626491392}\nThe Alien begins inside the nest deep within the ship, working its way towards its prey. As the specimen, your goal is simple but deadly. You start in a weak, larval form\u2014but every engineer you harm makes you stronger. \n\nOnce you evolve, you unlock new abilities\u2014like heightened senses to detect your prey, or faster movement, and deadly attacks. In your final form, you become an unstoppable force, capable of taking on the engineers head-to-head. If the Engineers arm themselves with special weapons, the tables could turn. In BlackGate, the clock is always ticking. Will the engineers work together to repair the station and take down the alien, or will the creature evolve into an evil force and claim victory? \n\n\n**BlackGate\u2122 and all characters, names, and elements are trademarks of and \u00a9 2024 Megaverse LLC, a Fun Train\u00ae company.**", "short_description": "A zero gravity, 4v1 asymmetrical multiplayer game focused on communication and teamwork. In this action packed horror title, a team of four engineers must work together to restore function to their space station while repelling a hostile alien threat aboard the BLACKGATE Research Facility.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.funtrainvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fun Train Inc.", "support_website_url": null, "website_url": "https://www.funtrainvr.com/blackgate", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8585640778225737"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2036781500415255"}, {"status": "CANCELLED", "id": "1362153425428821"}, {"status": "PUBLISHED", "id": "4108990839371015"}, {"status": "PUBLISHED", "id": "4100182986930902"}, {"status": "PUBLISHED", "id": "1268727128302237"}, {"status": "PUBLISHED", "id": "1820995772091323"}, {"status": "PUBLISHED", "id": "1610787362922805"}, {"status": "PENDING", "id": "1376874560196753"}]}, "baseline_offer": {"id": "2036781500415255"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765465260, "status": "PUBLISHED", "id": "2036781500415255"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename":
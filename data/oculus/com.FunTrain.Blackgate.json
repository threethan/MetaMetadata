t=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqvxpzl-jhFng3BMFnqR47ws24FI8Ml9HSVZdqmE53qw&oe=6ACE4B0B"}, {"file_name": "BG Confrontation RAW Wide 2560x1440.png", "id": "801855859466535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619680_801855862799868_8134251572011909613_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVJkemWYPdkQ7kNvwGOLC8X&_nc_oc=AdraWMEwFMDwIqfZmrKDN0fRnN923OLxj9RMKVGfC-RsO4Efr-833UOriyjsiIpaSzw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfzzgyMWcbRwZ2qmx_rGaBmoHTLf0KGq_6cw8TYHL4_g&oe=6ACE6894"}, {"file_name": "SaberLights2560.png", "id": "1476298657143748", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604298355_1476298663810414_1346463895235742033_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loRJd3yjK5kQ7kNvwE0phtc&_nc_oc=Adpql8Yr5k6mIF9_AnhWwYhlin0LlPVz7L-uO007D58QFu_CqZi9vp6r8zeBCuA35oQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHmcZb1YK_CTf4HKvVCJ7GJJCeksoa0-06MTFyoury0g&oe=6ACE4467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BG New Weapon Saber Keyart 2560x1440.png", "id": "2844452552554469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619078_2844452555887802_8242037083228773945_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTcAsJEK7rMQ7kNvwFpt5iY&_nc_oc=AdriC9wUmZuhiJjowGvKQoBAYRoVOnBRqoUqoj0C_IJZ8wkQwzuGiORrXbrx6D1NAT8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYPeyHV1KspZlniS7Z01tGY00dGoAdfgugUXRMF-XuZQ&oe=6ACE5DA3"}, "display_name": "BlackGate", "keywords": ["horror", "alien", "scifi", "multiplayer", "competitive"], "long_description": "# UP TO 4v1 COMPETITIVE ASYMMETRIC HORROR\n\n**Level 20 Players can unlock the devastating, highly classified: NEW ALIEN SPECIMEN (TITAN)**\n\nMultiple deep-space research sectors have gone dark, including our frontline installation, **BlackGate Station.** Vital systems are failing, life support is bleeding out, and corporate assets across the sector are under immediate threat. We must secure our most important alien asset. **Celestia Dynamics** needs all hands on deck. We need problem solvers. We need Engineers.\nDo you have what it takes to answer the call?\n\n# CHOOSE YOUR ROLE: ENGINEER OR ALIEN\nStep into the zero-gravity vacuum of our stations and secure your place in history in teams of four astronauts versus one powerful alien.\n- **Your Mission:** Deploy across high-stakes maps, push and pull through the void using state-of-the-art thrusters, and restore systems before the alien evolves. Unlock the Armory, and purge the xeno threat.\n- **Corporate Benefit:** The Engineer Role is **FREE to start.** Immediate deployment.\n\n# CLASSIFIED REPORT: THE SPECIMEN\nDeep within the dark corners of BlackGate, something stirs. Reports indicate a **lethal, evolving biocontaminant.** It starts small, but the specimen is **hungry**. \n\n# ENLIST TODAY & CLAIM YOUR GEAR\n- **Free-to-Start:** Standard enlistment costs nothing.\n- **The Discord Suit:** Join discord.gg/6fdjPEYBEZ for 30 days to claim your skin!\n\n**[JOIN THE RANKS OF CELESTIA DYNAMICS NOW]**\n\u00a9 2026 Megaverse LLC, a Fun Train\u00ae company.", "short_description": "With BlackGate Station dark and systems failing, Celestia Dynamics needs Engineers to deploy in 4-player teams, use thrusters in zero-gravity, repair the grid, and unlock weapons to fight back. The Engineer role is free to start. Beware the evolving specimen's catastrophic abilities. Join Discord at discord.gg/6fdjPEYBEZ for a free suit, and enter weekly raffles for full premium access. Enlist today to save the fleet! AND Level 20 unlocks Titan FREE?!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.funtrainvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fun Train Inc.", "support_website_url": "https://www.funtrainvr.com/support", "website_url": "https://www.funtrainvr.com/blackgate", "category": "GAMES", "com
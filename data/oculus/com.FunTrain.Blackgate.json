culuscdn.com&_nc_ss=7f20f&oh=00_AQFFFhfOzQrJ-tyOlAX2NYaLNbY8zrGAFfBTZTOMmHypUQ&oe=6A8EED19"}, {"file_name": "Healing_Meta_2560x1440.png", "id": "2981666218799307", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035372_2981666222132640_5377214957752244739_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aug4K2I7WQoQ7kNvwH5JNTd&_nc_oc=AdqqeCDaFXf3brCN8_aN-yzatv7RH6vLoJwX9pCI7LMMiS-5NhpbboOqqUtcT5WmekY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlVXFlJCI1vaJqjFJtjpPdunsrPugIXU5ecm0DkbLwRQ&oe=6A8ED946"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BlackgateAstros_2560x1440.png", "id": "1610692936207537", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982688_1610692939540870_3764766995775426536_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGeOoXlPtPkQ7kNvwEpKyoJ&_nc_oc=AdqPSRm7s-MDdXSjA3w69Hpxj-gQIVVrJD8X46yQhMQpCnTPz_JbHtoQNVUkzoqpBvw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN-jhYXTxHQmsvPzx-aMz5yXe3Etqf5yZ1CNmRIrro5Q&oe=6A8EEE5C"}, "display_name": "BlackGate", "keywords": [], "long_description": "# Welcome to BlackGate. \n\nIn this asymmetrical multiplayer experience, every player has a unique role to play, with one ultimate goal: survival.  Up to 4 Engineers are pit against an alien specimen controlled by a 5th player. \n{2964488347035663}\nAs an engineer, you and your team are sent to repair BlackGate station. Your mission is clear: restore power to the station, unlock crucial systems, and most importantly\u2014stay alive. Navigating the station isn\u2019t easy. Using your thrusters and environment, you\u2019ll need to push and pull your way through zero gravity, watching your back at every turn.\n{1543893626491392}\nThe Alien begins inside the nest deep within the ship, working its way towards its prey. As the specimen, your goal is simple but deadly. You start in a weak, larval form\u2014but every engineer you harm makes you stronger. \n\nOnce you evolve, you unlock new abilities\u2014like heightened senses to detect your prey, or faster movement, and deadly attacks. In your final form, you become an unstoppable force, capable of taking on the engineers head-to-head. If the Engineers arm themselves with special weapons, the tables could turn. In BlackGate, the clock is always ticking. Will the engineers work together to repair the station and take down the alien, or will the creature evolve into an evil force and claim victory? \n\n\n**BlackGate\u2122 and all characters, names, and elements are trademarks of and \u00a9 2024 Megaverse LLC, a Fun Train\u00ae company.**", "short_description": "A zero gravity, 4v1 asymmetrical multiplayer game focused on communication and teamwork. In this action packed horror title, a team of four engineers must work together to restore function to their space station while repelling a hostile alien threat aboard the BLACKGATE Research Facility.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.funtrainvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Fun Train Inc.", "support_website_url": null, "website_url": "https://www.funtrainvr.com/blackgate", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8585640778225737"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"
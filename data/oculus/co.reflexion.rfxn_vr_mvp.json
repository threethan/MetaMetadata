"}, {"file_name": "PHoton-PDP.png", "id": "1051511396709651", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340702_1051511400042984_2901871758228123391_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0WpSicssWwQ7kNvwGVzdD6&_nc_oc=AdrNiElSQgvvFD9hA0ITfWv4J-I8kgP0inPYl4PArwHN_oiqdlByeMTx3v93-ufnQss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMMNXf0-sr6X2FWuf0kCAWHpFtqmu-Y8U0HWaxPVOWig&oe=6ACA74D8"}, {"file_name": "Portals-PDP.png", "id": "1677277812849858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57574727_1677277819516524_5807967696402209619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYm9_pkJ6o8Q7kNvwEIgCfZ&_nc_oc=AdqH_RO4mpVKH9C8IwSld0D6HT-JaVETN4oi_bSVxw16bjVgERkaDNj_3OIb_tOFo0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRDSsd9CfPwOMCXJYpFQj1bhWlBKfriCIW9f0VVeGmBQ&oe=6ACA46B9"}, {"file_name": "firefly-PDP.png", "id": "522376480426626", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575352_522376487093292_2677964384157825581_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Rf08xrn38MQ7kNvwEolhPZ&_nc_oc=Adqeu-VYOLsdxyZ6mM-R51hB3axQz-d3yZwljpsmMMCE7vPx1ukRmOlK509RGlgqvN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSH1Ofy4ig0EdM5N2encCQ-k7x-vg8n77mNzncLoZTxg&oe=6ACA6AFA"}, {"file_name": "Go-PDP-gym.png", "id": "847389930926740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974746_847389934260073_8226376819367467967_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGonMnaIrloQ7kNvwHNV44q&_nc_oc=AdoOMs7Mic8Q8dQiuA3VYmqqWYYv_nm4NT3pOMh5TYzEhxh85PfuDCl7UKUmyTRrggs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM27f8DIshHTcKOrqWHAcbKWrPw47p1zdaXjTUJ5lm4jg&oe=6ACA5158"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Go-Video-Thumbnail.png", "id": "572851888640255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75416836_572851891973588_1491244541525795573_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjaDquxJqlsQ7kNvwFoCyXO&_nc_oc=AdoPoMdeG2C0KUN1dDCUXAhIaRuZzmvKIHxnAgYpBuVmqXQOnS4rftoDkhfSzbUvYsY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgXPU490G9bT7wG-q2W00qoyTpGxul2vUOeTTZlPqY1A&oe=6ACA5CE8"}, "display_name": "Reflexion Go: Personalized Neuro Training & Fitness", "keywords": ["brain", "cognitive", "neuro", "athletics", "workout"], "long_description": "REFLEXION GO is the ultimate personalized MR training tool for athletes and other high performers looking to take their game to the next level. Train your neuro skills like never before, including reaction time, inhibition, mental flexibility, eye-hand coordination, and anticipation. Immerse yourself in the future of training and elevate your performance with Reflexion.\n\nTRAIN WITH INTENSE IMMERSIVE DRILLS \ud83e\udde0\n\nAccess a growing library of specialized drills that train a broad range of cognitive skills.\n\nPERSONALIZED FOR YOU \ud83c\udfc6\n\nReflexion's Virtual Coach sets goals for you that fit within your training routine. Tell us about your game and experience optimized training that adapts to your abilities and focuses on the skills that matter most for your life.\n\nKEEP TRACK WITH PERFORMANCE RANKINGS \ud83d\udcc8\n\nYou can't improve what you can't measure. Reflexion regularly benchmarks your performance to identify your strengths and focuses your training where it's needed.\n\nBACKED BY SCIENCE \ud83e\uddea\n\nNeuro training works by bridging the gap between what you see with your eyes and what you do on the field, the ice, the court, or the track. Years of data from thousands of users have shown that Reflexion drills increase cognitive performance over the long term.\n\nTRUSTED BY THE BEST \ud83e\udd1d\n\nReflexion was founded in 2015 and is trusted by the likes of the Denver Nuggets, US Air Force, Under Armour, Michigan Football, and Arrow McLaren SP.\n\nLevel up your training now with Reflexion GO. \u26a1\ufe0f\n", "short_description": 
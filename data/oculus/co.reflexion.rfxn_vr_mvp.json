ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75340710_1464976844252833_4806793097589655555_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSYYpt5NZn8Q7kNvwFQQntN&_nc_oc=AdrisukPAy3CmhYOywKYm-F10y4iS6r8ABNqt0q6R5YZBZXcJGIe9mIRJHLVgUJMskc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLbO1dPWPIQjtR1wiHOS62qyTvaZa7iMwAP9RDqnfY0A&oe=6ACA581D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PDP-Final.png", "id": "682066110023515", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974878_682066113356848_3195126464253355770_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja6pzuxdktsQ7kNvwFDbeN2&_nc_oc=AdpvAda7goLqTz6C6syFDuV_N1ywZCxNID5nbqfr44AmlSFX3ZQo_tf-TsjWvErZWa0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-ED3-Slpql7ALDtBumSBOxTsdNY_3b_P0M-UPQNrj3A&oe=6ACA5068"}, "display_name": "Reflexion Go: Personalized Neuro Training & Fitness", "keywords": [], "long_description": "REFLEXION GO is the ultimate personalized VR training tool for athletes and other high performers looking to take their game to the next level. Train your neuro skills like never before, including reaction time, inhibition, mental flexibility, eye-hand coordination, and anticipation. Immerse yourself in the future of training and elevate your performance with Reflexion.\n\nTRAIN WITH INTENSE IMMERSIVE DRILLS \ud83e\udde0\n\nAccess a growing library of specialized drills that train a broad range of cognitive skills.\n\nPERSONALIZED FOR YOU \ud83c\udfc6\n\nReflexion's Virtual Coach sets goals for you that fit within your training routine. Tell us about your game and experience optimized training that adapts to your abilities and focuses on the skills that matter most for your life.\n\nKEEP TRACK WITH PERFORMANCE RANKINGS \ud83d\udcc8\n\nYou can't improve what you can't measure. Reflexion regularly benchmarks your performance to identify your strengths and focuses your training where it's needed.\n\nBACKED BY SCIENCE \ud83e\uddea\n\nNeuro training works by bridging the gap between what you see with your eyes and what you do on the field, the ice, the court, or the track. Years of data from thousands of users have shown that Reflexion drills increase cognitive performance over the long term.\n\nTRUSTED BY THE BEST \ud83e\udd1d\n\nReflexion was founded in 2015 and is trusted by the likes of the Denver Nuggets, US Air Force, Under Armour, Michigan Football, and Arrow McLaren SP.\n\nLevel up your training now with Reflexion GO. \u26a1\ufe0f\n", "short_description": "REFLEXION GO is the ultimate personalized VR training tool for athletes and other high performers looking to take their game to the next level. Train your neuro skills like never before, including reaction time, inhibition, mental flexibility, eye-hand coordination, and anticipation. Immerse yourself in the future of training and elevate your performance with Reflexion.\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://reflexion.co/privacy-policy", "developer_terms_of_service_url": "https://reflexion-staticfiles.s3.amazonaws.com/reflexion/assets/end-user-license-agreement-standard-9-18-2019.pdf", "publisher_name": "Reflexion Interactive Technologies Inc", "support_website_url": "https://reflexion.co/help/", "website_url": "https://reflexion.co/go", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
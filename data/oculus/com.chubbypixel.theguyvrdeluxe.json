iQb_GoN4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqPgePcX8LcBa0E0iWgkl0XkBlKOg1e3knUvAgU34VLw&oe=6AA4069B"}, {"file_name": "Screen2.png", "id": "1426823731840518", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491825052_1426823735173851_6100106664193238392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sOtinw8q8UQ7kNvwE3vlua&_nc_oc=AdoI1qxWbzq_QpobN8XWl7ZWCTTVfM8VaXmSN_er7HNjnOhXAIlY2wE8EA8rEQpFyEQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuqX4lXr5ecRlrKeShy9Owo2oF3KrTFkD5EHsXifvBSw&oe=6AA4005D"}, {"file_name": "Screen6.png", "id": "1233533615062663", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491822883_1233533618395996_7352670562995574372_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5Yy1SVO670Q7kNvwFEf3Si&_nc_oc=AdrPWQVgEd-D1DQYwifyLOjzXSDk-hBL4fOoAQOXVVbnHwH2qpirhCBqFRGnWAffNpw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUEDKAtaYSQmU-7Zlwzs4LB4Vtnacl_1e3vCgt6Tp00A&oe=6AA41DAD"}, {"file_name": "Screen5.png", "id": "1205231824345740", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491830578_1205231827679073_7726067650777338924_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOlWKb2WIbAQ7kNvwGpZkKS&_nc_oc=AdqmmUQF4EZ7YkaHKUhtfVFuY_uOG-TWX2zqDGFPs2Z1QVKd35DOuBsxnvSW54L0MGQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFWD4Fdlt1TqMyYWF1ALvZkZsai_m0uvOq5mqrtew9cQ&oe=6AA40D9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape1.2.png", "id": "2394176090978516", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393673_2394176097645182_1993968208262437645_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hctXdy5zWZEQ7kNvwEHpYWa&_nc_oc=AdqYbVK2swyxEPGvpqyLROsVt6Xvh3h9ngftvefltQiOcIo_Qt_DlMB5VLvw61urAnk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsJabEtmg79m7BVkX9_JNZt1a4E8FS8Syjq9CQczjHEQ&oe=6AA3F6FE"}, "display_name": "The Guy VR Deluxe", "keywords": ["guy", "vr", "puzzle"], "long_description": "The Guy is back in VR!\nExperience it and find out the new custom levels that take full advantage of Virtual Reality.\nWill your heart be able to take all these deaths at once?\n\nA first person puzzle game like no other where you'll have to find the way out of your own dreams using objects and tools that you'll obtain during the nap.\n\nPlay this super immersive experience with your Meta Quest device.\n\n\nFeatures:\n\n- New awesome levels that take full advantage of VR devices\n\n- Full body locomotion in Virtual Reality\n\n- Total physics control of all items\n\n- New incredible moves: be able to pick up items, throw them, activate mechanisms and even burp.\n\n- Driving System redesigned for VR\n\n- Teleport movement style extra option (if your stomach can't take it)\n\n- An important mission to accomplish (again)\n\n\nWhat Does the new Deluxe edition includes?\n\n- Graphics and performance improvements\n\n- Fully adapted for Meta Quest devices 2, 3 and 3S\n\n- Improved comfort for VR", "short_description": "Experience The Guy now in Virtual Reality for the most immersive snooze!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://chubbypixel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Chubby Pixel", "support_website_url": "https://chubbypixel.com/contacts/", "website_url": "https://chubbypixel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "zh_CN", "da", "nl", "de", "ja", "pl", "ru
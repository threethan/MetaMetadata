1_PvvVe-1YK0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGS_LH4BySUuCVyIX-0_4UGLodtLRSo6fgXPWKXjKjzHA&oe=6A857BDB"}, {"file_name": "Screen2.png", "id": "1426823731840518", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825052_1426823735173851_6100106664193238392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoZagf9_lpkQ7kNvwGFoS-q&_nc_oc=Ado6vUMJomEx1hXtKuZ9WqT6w2TiDmJKTgVBrWvaWTQsHYLFHTQchyugnJ8X_O3rt8Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUbf2ec3Mr9u3_ZIJGtbRV8NFMo9s47BDPAXGhRWwGig&oe=6A85ADDD"}, {"file_name": "Screen6.png", "id": "1233533615062663", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822883_1233533618395996_7352670562995574372_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCNM6ZKfgVMQ7kNvwFVg8ka&_nc_oc=AdpXtat2MN5hNJfNskxIpQDxj6GYW8MP4hnBxr0yE6P9UWToGa6cbC8PaqgJgw-YLxg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx7f-eKjTutmv3y6EeWznw-MZpBdrHoYQ7cu_gql0J2Q&oe=6A8592ED"}, {"file_name": "Screen5.png", "id": "1205231824345740", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491830578_1205231827679073_7726067650777338924_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfOxYPXdTccQ7kNvwFOQyv6&_nc_oc=Adrp3-yOTDm0xAzALZAohs3dSChf_7PAKC_fvtHHB13bvvJEKaw-owzayEmwFnwUkbI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtpZ4hqYmD5MRQKoNkRuiUX4UIA9TkyMfEZPhGU4PDFw&oe=6A8582DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape1.2.png", "id": "2394176090978516", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393673_2394176097645182_1993968208262437645_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVGrnfKqtK4Q7kNvwGbPoCZ&_nc_oc=Ado3JEQJZ-04ZXOwJc_zlws7_brA3_V-O87ntLRVrsJGx_n-kOm6IISkymnkFxA8PbM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ-E2Pv6nD9wgn0afCNoHDgHQC72HO5iieOinYfZ4Xcw&oe=6A85A47E"}, "display_name": "The Guy VR Deluxe", "keywords": ["guy", "vr", "puzzle"], "long_description": "The Guy is back in VR!\nExperience it and find out the new custom levels that take full advantage of Virtual Reality.\nWill your heart be able to take all these deaths at once?\n\nA first person puzzle game like no other where you'll have to find the way out of your own dreams using objects and tools that you'll obtain during the nap.\n\nPlay this super immersive experience with your Meta Quest device.\n\n\nFeatures:\n\n- New awesome levels that take full advantage of VR devices\n\n- Full body locomotion in Virtual Reality\n\n- Total physics control of all items\n\n- New incredible moves: be able to pick up items, throw them, activate mechanisms and even burp.\n\n- Driving System redesigned for VR\n\n- Teleport movement style extra option (if your stomach can't take it)\n\n- An important mission to accomplish (again)\n\n\nWhat Does the new Deluxe edition includes?\n\n- Graphics and performance improvements\n\n- Fully adapted for Meta Quest devices 2, 3 and 3S\n\n- Improved comfort for VR", "short_description": "Experience The Guy now in Virtual Reality for the most immersive snooze!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://chubbypixel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Chubby Pixel", "support_website_url": "https://chubbypixel.com/contacts/", "website_url": "https://chubbypixel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "zh_CN", "da", "nl", "de", "ja", "pl
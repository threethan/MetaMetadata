uscdn.com/v/t64.5771-25/491825052_1426823735173851_6100106664193238392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYZIZnRkhBgQ7kNvwEplckS&_nc_oc=AdpObNjLOB2Awdf73f6OWiCHHk9TW2epozcO-PyduPhv1Csz51wENOIvJla0Fta15H8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2w5shkyR3KAGl_Q9Idr8f8IVSv4SX7IdQk0ybzs4EvSA&oe=69F205DD"}, {"file_name": "Screen6.png", "id": "1233533615062663", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_1233533618395996_7352670562995574372_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvZP5WiIAU0Q7kNvwHL67nK&_nc_oc=Adpcdpkz_-g9SJajtlpF476J5B_rSP1ua3UuT7tGVXPV6q38um0niG5jytiiJYzMwLM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1LvLRc_AyjWRWkGr8WRjghDLOnswsLhJ4d0ZBVPNz5gw&oe=69F1EAED"}, {"file_name": "Screen5.png", "id": "1205231824345740", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830578_1205231827679073_7726067650777338924_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnTI3sm0BToQ7kNvwEvqcEE&_nc_oc=AdpxPJqZhq6BureSkKndifw4xj18YjwyY7Z5rOcioobGZ0N4G_WXmc2oN2b46b6FZbA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2z260BMMhMr4-ZGxBK2xX0x2U5O2hqqtFSexjxf4Q17A&oe=69F2131B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape1.2.png", "id": "2394176090978516", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393673_2394176097645182_1993968208262437645_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eooDfYJsHkoQ7kNvwFF9UWw&_nc_oc=AdrDu_p7IRMWWw3jrusffut_-HQo4jEYYfa6VyARWXYd2IDpZyi50USDJ_J-hXgo2J8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YEuYO-y4G_h_TCYsl86G6vQXgEIDTTnVxpBQAUCqiEw&oe=69F1FC7E"}, "display_name": "The Guy VR Deluxe", "keywords": ["guy", "vr", "puzzle"], "long_description": "The Guy is back in VR!\nExperience it and find out the new custom levels that take full advantage of Virtual Reality.\nWill your heart be able to take all these deaths at once?\n\nA first person puzzle game like no other where you'll have to find the way out of your own dreams using objects and tools that you'll obtain during the nap.\n\nPlay this super immersive experience with your Meta Quest device.\n\n\nFeatures:\n\n- New awesome levels that take full advantage of VR devices\n\n- Full body locomotion in Virtual Reality\n\n- Total physics control of all items\n\n- New incredible moves: be able to pick up items, throw them, activate mechanisms and even burp.\n\n- Driving System redesigned for VR\n\n- Teleport movement style extra option (if your stomach can't take it)\n\n- An important mission to accomplish (again)\n\n\nWhat Does the new Deluxe edition includes?\n\n- Graphics and performance improvements\n\n- Fully adapted for Meta Quest devices 2, 3 and 3S\n\n- Improved comfort for VR", "short_description": "Experience The Guy now in Virtual Reality for the most immersive snooze!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://chubbypixel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Chubby Pixel", "support_website_url": "https://chubbypixel.com/contacts/", "website_url": "https://chubbypixel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "zh_CN", "da", "nl", "de", "ja", "pl", "ru", "es", "sv", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24008613235414437"}}]}, "scheduled_offers": {"count": 9
ile_name": "Screen_3.png", "id": "1489964654781728", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57572948_1489964658115061_7997837273463202082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6QFBuqxfaMQ7kNvwFwqBlU&_nc_oc=Adqb0aZ3-vk16jRGIPksYqq2sMV76kHlWTTuD-d2XwdkpE1YerNpaqmTrqc-TaSEVTU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fT0v2M1rmHAb9RefXzGLn7LpETcFEnapdVd4FFrshwA&oe=6A22F37F"}, {"file_name": "Screen_5.png", "id": "1105857520006431", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75295751_1105857523339764_7696271091736843758_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-hs7yjzpGAQ7kNvwEFnab2&_nc_oc=AdpAlLK5vf-hRb196-77Z_2CtZ0yOHOwLLarg9VmIqU-EK8vM8eNcUFqWV48hEOrdeU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5VkRy5Cw1Yq6RGfyGOlw9yHy5zij1cIGt0qwAYcgl1Q&oe=6A22E49D"}, {"file_name": "Screen_2.png", "id": "5122082357884939", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375085_5122082361218272_7219690635091605093_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vaek8EI6_YkQ7kNvwFyY8CW&_nc_oc=Adraq2RFD7qTIQiSDqhRk-wsoZLdIsug2-ORqmO1960sE4PZVoC8qOJjcGee67G-TIc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LT9HNTV7GAFn6-rvvZS5fzX7urDTonJX-hH_dKv-BUw&oe=6A22D015"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PortadaHorizonal.png", "id": "575154470701658", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75230048_575154474034991_1906260858405282920_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KyB12-bFBMQ7kNvwE_tGqf&_nc_oc=AdqLLKZ9x5dNerVFo7v13Hh-uZfgJ0s8P-HR0TTk3WrWxdUwAtJiP7_DBgNZOolKmMc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1TmBBmQgB9YFDPiW9dV612WEans9toZIgb7iVVAHHjA&oe=6A22EFF9"}, "display_name": "The Creature: Escape Room", "keywords": [], "long_description": "You are a detective sent to investigate the mistreatment of a mysterious creature. In this escape room there are not only puzzles, but also characters and history.\n\nThe creature: Escape Room is the first chapter of this exciting story.\n\nGo through three completely different levels with incredible challenges.\n\n- Apartment.\n- Laboratory.\n- Hangar.\n\nEach level has its own puzzles integrated with the environment.\n\nThe creature: Escape Room is not just a puzzle game, it is a story of intrigue, sadness and hope.", "short_description": "You are a detective sent to investigate the mistreatment of a mysterious creature. In this escape room there are not only puzzles, but also characters and history."}, {"images": {"nodes": []}, "id": "721775232356470", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Creature: Escape Room", "keywords": [], "long_description": "Sie sind ein Detektiv, der geschickt wird, um die Misshandlung einer mysteri\u00f6sen Kreatur zu untersuchen. In diesem \u201eEscape Room\u201c gibt es nicht nur R\u00e4tsel, sondern auch Charaktere und Geschichte.\n\nThe Creature: Escape Room ist das erste Kapitel dieser spannenden Geschichte.\n\nGehen Sie durch drei v\u00f6llig unterschiedliche Levels mit unglaublichen Herausforderungen.\n\n- Wohnung.\n- Labor.\n- Halle.\n\nJedes Level hat seine eigenen R\u00e4tsel, die in die Umgebung integriert sind.\n\nDie Kreatur: Escape Room ist nicht nur ein Puzzlespiel, es ist eine Geschichte voller Intrigen, Traurigkeit und Hoffnung.", "short_description": "Sie sind ein Detektiv, der geschickt wird, um die Misshandlung einer mysteri\u00f6sen Kreatur zu untersuchen. In diesem \u201eEscape Room\u201c gibt es nicht nur R\u00e4tsel, sondern auch Charaktere und Geschichte."}, {"images": {"nodes": []}, "id": "530681915264945", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Creature: Escape Room", "keywords": [], "long_description": "Eres un detective enviado a investigar el maltrato de una misteriosa criatura. En este escape room no solo hay puzles, sino tambi\u00e9n personajes e historia.\n\nThe Creature: Escape Room es el primer cap\u00edtulo de esta apasionante historia.\n\nPasa por tres niveles completamente diferentes con desaf\u00edos incre\u00edbles.\n\n- Departamento.\n- Laboratorio.\n- Hangar.\n\nCada nivel tiene sus propios rompecabezas integrados con el entorno.\n\nLa criatura: Escape Room no es solo un juego de rompecabezas, es una historia de intriga, tristeza y esperanza.", "short_description": "Eres un detective enviado a investigar el maltrato de una misteriosa criatura. En este escape room no solo hay puzles, sino tambi\u00e9n personajes e historia."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pages.flycricket.io/the-creature-escape/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "K148GS", "support_website_url": null, "website_url": "https://twitter.com/K148_GS", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "820625748910259"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "539468244306698"}, {"status": "PENDING", "id": "768665825080694"}, {"status": "PUBLISHED", "id": "851568282488738"}]}, "baseline_offer": {"id": "851568282488738"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1655
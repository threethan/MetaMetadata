ile_name": "Screen_3.png", "id": "1489964654781728", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57572948_1489964658115061_7997837273463202082_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Q3auRdAclIQ7kNvwE6DOzL&_nc_oc=AdrkiVBujNoqp8O7G6cRqE2K1qSp7RYrGPFHvOu765EDFd_1DRPSi2zt6TdQ4rRX35Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKT-aKv2TxiQo6nN0i_kjqsqo2O8AYw0Jpgyny4fvPzkg&oe=6AA9343F"}, {"file_name": "Screen_5.png", "id": "1105857520006431", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75295751_1105857523339764_7696271091736843758_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ELZ4Y4mJKwQ7kNvwGo0cY7&_nc_oc=AdoBNF3E2L2NYNipPunyEQPIKVRrVf1JCsU4i98jrESBt4TToRA_V8_rGdqSu-KOLxM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7uO0GWd15euKzWM5KSky-eSxo7US3erzwmuvmyrFqDQ&oe=6AA95D9D"}, {"file_name": "Screen_2.png", "id": "5122082357884939", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75375085_5122082361218272_7219690635091605093_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIcRbT3wbk0Q7kNvwHDbAgv&_nc_oc=AdpEW0lJkrffUNdIppofXpFLXf64hcgQ9_na85zkmXpk-zLcgz3JKGdAzvMeIu02cUY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv-AV51KaUA5ISnnBw4sv89CMpjqJkciYJmfoy-9nAQg&oe=6AA94915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PortadaHorizonal.png", "id": "575154470701658", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75230048_575154474034991_1906260858405282920_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQGLgiuMMSkQ7kNvwGk3P2G&_nc_oc=AdrXvs_k8EZOk0MaOWMb88eL5it3ogGmIm3H-oaaevn_IJ1KU3vzZOjO3bCJt__MkCY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6Gwf6cozvmSsyq2-oBPKFP4cIz-50mcOO6aKUVmkgMA&oe=6AA968F9"}, "display_name": "The Creature: Escape Room", "keywords": [], "long_description": "You are a detective sent to investigate the mistreatment of a mysterious creature. In this escape room there are not only puzzles, but also characters and history.\n\nThe creature: Escape Room is the first chapter of this exciting story.\n\nGo through three completely different levels with incredible challenges.\n\n- Apartment.\n- Laboratory.\n- Hangar.\n\nEach level has its own puzzles integrated with the environment.\n\nThe creature: Escape Room is not just a puzzle game, it is a story of intrigue, sadness and hope.", "short_description": "You are a detective sent to investigate the mistreatment of a mysterious creature. In this escape room there are not only puzzles, but also characters and history."}, {"images": {"nodes": []}, "id": "721775232356470", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Creature: Escape Room", "keywords": [], "long_description": "Sie sind ein Detektiv, der geschickt wird, um die Misshandlung einer mysteri\u00f6sen Kreatur zu untersuchen. In diesem \u201eEscape Room\u201c gibt es nicht nur R\u00e4tsel, sondern auch Charaktere und Geschichte.\n\nThe Creature: Escape Room ist das erste Kapitel dieser spannenden Geschichte.\n\nGehen Sie durch drei v\u00f6llig unterschiedliche Levels mit unglaublichen Herausforderungen.\n\n- Wohnung.\n- Labor.\n- Halle.\n\nJedes Level hat seine eigenen R\u00e4tsel, die in die Umgebung integriert sind.\n\nDie Kreatur: Escape Room ist nicht nur ein Puzzlespiel, es ist eine Geschichte voller Intrigen, Traurigkeit und Hoffnung.", "short_description": "Sie sind ein Detektiv, der geschickt wird, um die Misshandlung einer mysteri\u00f6sen Kreatur zu untersuchen. In diesem \u201eEscape Room\u201c gibt es nicht nur R\u00e4tsel, sondern auch Charaktere und Geschichte."}, {"images": {"nodes": []}, "id": "530681915264945", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Creature: Escape Room", "keywords": [], "long_description": "Eres un detective enviado a investigar el maltrato de una misteriosa criatura. En este escape room no solo hay puzles, sino tambi\u00e9n personajes e historia.\n\nThe Creature: Escape Room es el primer cap\u00edtulo de esta apasionante historia.\n\nPasa por tres niveles completamente diferentes con desaf\u00edos incre\u00edbles.\n\n- Departamento.\n- Laboratorio.\n- Hangar.\n\nCada nivel tiene sus propios rompecabezas integrados con el entorno.\n\nLa criatura: Escape Room no es solo un juego de rompecabezas, es una historia de intriga, tristeza y esperanza.", "short_description": "Eres un detective enviado a investigar el maltrato de una misteriosa criatura. En este escape room no solo hay puzles, sino tambi\u00e9n personajes e historia."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pages.flycricket.io/the-creature-escape/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "K148GS", "support_website_url": null, "website_url": "https://twitter.com/K148_GS", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "820625748910259"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "539468244306698"}, {"status": "PENDING", "id": "768665825080694"}, {"status": "PUBLISHED", "id": "851568282488738"}]}, "baseline_offer": {"id": "851568282488738"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1655
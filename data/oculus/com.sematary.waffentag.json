a9elWZkVWw4gMmA&oe=6AD22AFE"}, {"file_name": "Untitled77_20260821095158.png", "id": "28595884433337582", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596068480_28595884450004247_3262822341528372848_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_svpINxFFDgQ7kNvwEfAL5c&_nc_oc=AdprsVcnq4rfwor9PxBZJjdG5UvewL3Hj5G9Mxpllz6yjYC2JIq7mAi0aOTKDdA2Obg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObb1Y6Er19W0aa93Np7o6J2fNhSaDaRr_NJI4hQqIzDw&oe=6AD2415F"}, {"file_name": "Untitled77_20260821095141.png", "id": "2216327939158199", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604366035_2216327942491532_1672288685054725990_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP2MpSn-2IkQ7kNvwHhveI5&_nc_oc=Adom5HM5mBaE05VEvvy3XWD-1dAJJOYl_2w09h9ZiUAwHxCl2thrsTY0iv-h2nU-XGo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUP0zabgvqVUPN89bo1pr73zqHihWn2uSodgrUYoSlOA&oe=6AD25666"}, {"file_name": "Untitled77_20260821095223.png", "id": "1360647129549170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604310912_1360647132882503_1420224670360316535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00rLvuB4Sh8Q7kNvwH7Fd1X&_nc_oc=AdpZOidskCa25riP6AcZFx966p0yoJcCwI0b0hMEOEBzEFk0npeou4t0MMIbDLXk-yI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyjA0m2rG8QBHLv9DLPTKXTWJ4-zubzmlJ4sGXaegcaA&oe=6AD24C3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Waffen Tag", "keywords": ["Gorilla", "Tag"], "long_description": "Jump into an exciting VR world where movement, exploration, and multiplayer fun come together! This Gorilla Tag-inspired fan game lets you run, jump, climb, and move around using your arms as you explore different environments and interact with other players.\n\nPractice your movement skills, discover new areas, challenge your friends, or simply hang out and have fun with the community. Whether you\u2019re learning the basics or mastering fast and creative movement, there\u2019s always something to do.\n\nExplore unique locations, meet other players, and create memorable moments with friends. The game is designed around social VR gameplay, giving players a place to move around, communicate, explore, and enjoy themselves together.\n\nFeatures include:\n\n* Arm-based VR locomotion\n* Online multiplayer\n* Social areas for hanging out with friends\n* Different environments to explore\n* Fast-paced movement and climbing\n* Voice communication\n* Regular opportunities for new content and improvements\n\nGrab your headset, jump in, and start exploring!\n\nDisclaimer: This is an unofficial, fan-made game inspired by Gorilla Tag. It is not affiliated with, sponsored by, or endorsed by Another Axiom or the official Gorilla Tag developers.", "short_description": "Jump, climb, run, and explore in this Gorilla Tag-inspired VR fan game! Use your arms to move through fun environments, hang out with other players, and enjoy fast-paced multiplayer gameplay. Discover different areas, practice your movement skills, and have fun with friends.\n\nThis is an unofficial fan-made game and is not affiliated with or endorsed by Another Axiom or Gorilla Tag."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gorillawaffen.vercel.app/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "GWStudios", "support_website_url": null, "website_url": "https://gorillawaffen.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_
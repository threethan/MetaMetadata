s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJe52eJVhVxikd5TbLt5o1_mG1VtyORtZPp95nDts7PA&oe=6A5CB0A5"}, {"file_name": "store screenshots2024_5.png", "id": "968968718483712", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974920_968968721817045_3224163795010507487_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJIjE79hu3oQ7kNvwGPSrbf&_nc_oc=Adqu3bZtX73_3v6rFKCufjRvecQ_JZag79bCqLU3yAz5i5q9GxUfM3GTqVJuVlpiGiw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5neprwVeMW5pmZOSO6Zw8BxRG9YqIDBj5iUD46UItNQ&oe=6A5CCA6D"}, {"file_name": "SkydiveSimRPM under canopy_3.png", "id": "2174244683373913", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622211_2174244686707246_3375373502256488970_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOZHDkslrnQQ7kNvwHkzYts&_nc_oc=AdqmpoLWsgYZ0cP-Go539ur63SZ02JPIoVTag2rqCaWAkIEgxVirDn3B9_GnusKNAwE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtiCgiNwZJAgsZ3QsMlan8FSYcB0beODPluWcTQaMH4Q&oe=6A5CD94F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SkydiveSim Cover2026.png", "id": "1564940227930201", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823893_1564940234596867_2579778877986473386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yei_6ndb6qcQ7kNvwGIzt-W&_nc_oc=Adoyy-e2deKccpdhk80xZjmnpuukKrxKCTyDkHLpLiWO_3AcvNO268QKArsLWeaOen4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPnf6M_m37jjoxJy2oE-n2l_FU9QNW35kwH4X9fXFoXQ&oe=6A5CE282"}, "display_name": "Skydive Sim - Skydiving Simulator", "keywords": ["Skydiving", "Flying", "GoogleEarth", "FlightSimulator", "Exploration"], "long_description": "**Skydive Sim \u2014 Soar over the real world with Google Earth integration\n(Google Earth Included! No subscription required!)**\n\n**The most exciting way to explore the globe. The World Is Yours!**\n\nStep out of the aircraft and into the planet\u2019s most authentic skydiving playground. Skydive Sim combines cutting-edge VR physics with live Google Earth terrain, so every aircraft jump, cliff dive, beach swoop, or skyscraper fly-by happens above photo-real locations you already know and love.\n\n**Freefall, track, BASE jump, swoop, or launch with a jet pack \u2014 all without restarting \u2014 for endless exploration and canopy-landing practice.**\n\nUltra-realistic canopy physics\nDial in your canopy settings, toggle presets, pull front risers, or go full competition-style swooping.\n\n**Visit new places and drop zones virtually before you arrive in person**\n\nExperience line twists, cutaways, and reserve deployments.\n\n**Exit from an airplane, helicopter, hot-air balloon,  or jump into our vertical wind tunnel for fast skills drills.**\n\nGlobal multiplayer\nMeet friends or teammates anywhere on the planet, organize formation jumps, and share the view in real time.\n\n**Jet Packs\nHover, climb, or pause mid-air to perfect maneuvers and instantly re-attempt canopy landings.**\n\nMaster Skydive Sim controls through an in-depth tutorial level, plus a growing library of video guides. Learn more & support: SkydiveSim.com\n\nHand tracking is supported for core interactions.\n\nSkydive Sim is designed for entertainment and not intended for skydiving training.", "short_description": "Skydive Sim \u2014 Soar over the real world with Google Earth integration\nExplore the planet from above with ultra-realistic skydiving, canopy flight, and jet-pack freedom.\nGoogle Earth included. No subscription required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/privacy/view/130ff4c1b0687c52ebc5095cc923e4f6", "developer_terms_of_service_url": "https://www.privacypolicies.com/terms/view/37b5278e52fb6c7b0e5aee1fbc17d2b2", "publisher_name": "AV1 Productions", "support_website_url": "https://skydivesim.com/", "website_url": "https://www.skydivesim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [
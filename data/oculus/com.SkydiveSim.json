E_kbEaXVqHn1llMEP-175uKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFYraJDXsp8b2GP8Z3sj4_qIjBKnv6naygFBQAPzd3Hw&oe=6AF1D9A0"}, "display_name": "SkydiveSim", "keywords": [], "long_description": "SkydiveSim brings the thrill of skydiving and BASE jumping to your Oculus Quest headset. No more waiting on weather on bad weather days. Put on your headset and choose from our gorgeous levels. Jump from a plane 10,000 feet above ground. Challenge yourself to go through the free fall rings. Then pull your ripcord and fly under the canopy and finally work on your accuracy and  land on the target. You don't need a plane ride back up, just repeat in the same scene or choose another one of our exotics environments to jump into.\nWant even more  excitement? BASE jump from top of the buildings, windmills and light towers, pull the ripcord and navigate to the ground!", "short_description": "SkydiveSim brings the thrill of skydiving and BASE jumping to your Oculus Quest headset.\nThis is the full version of the game and it includes extra environments and well as the ability to jump from a helicopter,  balloon as well as BASE jumping from windmills and light towers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/privacy/view/130ff4c1b0687c52ebc5095cc923e4f6", "developer_terms_of_service_url": "https://www.privacypolicies.com/terms/view/37b5278e52fb6c7b0e5aee1fbc17d2b2", "publisher_name": "AV1 Productions", "support_website_url": null, "website_url": "https://www.skydivesim.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
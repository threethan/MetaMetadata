": "AndroidBinary", "id": "27401237939574534"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "337947788184196"}]}, "change_log": "**What's New**\n\n\u2022 Your custom character can now fly wingsuits\n\n\u2022 Added two new customizable skydiving suit styles with adjustable colors.\n\n\u2022 Added helmets with multiple color options.\n\n\u2022 Improved wingsuit, harness, and clothing fit for all characters.\n\n\u2022 Rotate your character with your controller or mouse to inspect your gear.", "created_date": 1793807766, "id": "27401237939574534", "version": "5.1.6", "version_code": 256, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27401160366248958"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3711951435596517", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27401237939574534"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "337947788184196"}]}, "change_log": "Dock with Kira in freefall during the guided tutorial, then follow her through a canopy landing.\n\nRepeat the tutorial landing with the new Try Again button.\n\nImproved wingsuit training with clearer instructions, updated rings, and more natural flight.\n\nLearn to recognize wingsuit stalls and spins with on-screen warnings and controller vibrations.\n\nAdded wingsuit intensity warnings and fixed tutorial progression and retry issues.", "created_date": 1793588432, "id": "27365828279782167", "version": "5.1.5", "version_code": 255, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27365820409782954"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3711951435596517", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27401237939574534"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "337947788184196"}]}, "change_log": "Smoother multiplayer skydiving with less drifting and more natural movement.\n\nImproved formation flying with easier docking and releasing.\n\nSmoother tandem skydives with better positioning and separation.\n\nBetter multiplayer performance, even on slower connections.\n\nImproved character movements and fixed minor animation issues.", "created_date": 1793372767, "id": "27332938986404430", "version": "5.1.4", "version_code": 254, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27332897153075280"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3711951435596517", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27401237939574534"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "337947788184196"}]}, "change_log": "Updated canopy presets with realistic wing loading and improved default settings for beginners.\n\nCustom flight settings now apply instantly.\n\nImproved playback of recorded challenges from Instructor app.\n\nAdded group docking, allowing players and AI skydivers to form connected formations.\n\nAI skydivers now automatically make room for others to join formations.\n\nImproved synchronized formation flying, including sit-fly, back-fly, and head-down positions.\n\nImproved AI skydiver behavior, docking, and automatic group breakoff before canopy deployment.", "created_date": 1793225507, "id": "27309039708794358", "version": "5.1.3", "version_code": 253, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27308992572132405"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3711951435596517", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27401237939574534"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "337947788184196"}]}, "change_log": "What's New in Skydive Sim\n\nMeet Kira, Your New Skydiving Instructor! Learn the fundamentals of freefall with a brand-new guided tutorial, then practice your canopy skills with an assisted landing in San Diego.\n\nNew Freefall Docking! Fly alongside AI skydivers, approach them in freefall, and practice docking together.\n\nPlus, enjoy performance improvements and refinements throughout the game.", "created_date": 1792535722, "id": "27203311352700528", "version": "5.1.2", "version_code": 252, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27203303196034677"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
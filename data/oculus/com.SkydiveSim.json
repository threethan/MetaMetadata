w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEb8t3UMHMLke8FBKslAmoYPaNk7WCoyDeGIcEIQtBvA&oe=6AF1E265"}, {"file_name": "store screenshots2024_5.png", "id": "968968718483712", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974920_968968721817045_3224163795010507487_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC4sofhQD2kQ7kNvwEzQqYW&_nc_oc=AdpaA6Qm4XaiRvxE0fQPk0bFHZpKf4dA6Y0QN4-5evylJs0gpTDvdgRMK_pVtT6ZdBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIEyD1O4o4552qKunxTSeD70OskJIJD5w9HxmEHI_gUQ&oe=6AF1FC2D"}, {"file_name": "SkydiveSimRPM under canopy_3.png", "id": "2174244683373913", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622211_2174244686707246_3375373502256488970_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HibiR0fJ4NUQ7kNvwG1EQF8&_nc_oc=Ado_dMtjvIEpruYEDWkOuIY_YRddVuhm-uUibw7wA0p-vsMjX4zU8PysMgG2gFRi640&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQctH1VLDfEhpeTqmDGHWzkllR2IAGSLMnrE320Sxk_ow&oe=6AF1D2CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SkydiveSim Cover2026.png", "id": "1564940227930201", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823893_1564940234596867_2579778877986473386_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1mIMchzCb8Q7kNvwGaJaCB&_nc_oc=AdrCP4cXJXfk6NwaWTNbjG9fJYxVaQxTWmIdT6Y5ku_6k0ft6feHMVLa1X6B9HZFYBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC0e0gtbOHZ9LCiaJkgbu9jP_ROmgqsEVDzPN7EJuQLQ&oe=6AF1DC02"}, "display_name": "Skydive Sim - Skydiving Simulator", "keywords": ["Skydiving", "Flying", "GoogleEarth", "FlightSimulator", "Exploration"], "long_description": "**Skydive Sim \u2014 Soar over the real world with Google Earth integration\n(Google Earth Included! No subscription required!)**\n\n**The most exciting way to explore the globe. The World Is Yours!**\n\nStep out of the aircraft and into the planet\u2019s most authentic skydiving playground. Skydive Sim combines cutting-edge VR physics with live Google Earth terrain, so every aircraft jump, cliff dive, beach swoop, or skyscraper fly-by happens above photo-real locations you already know and love.\n\n**Freefall, track, BASE jump, swoop, or launch with a jet pack \u2014 all without restarting \u2014 for endless exploration and canopy-landing practice.**\n\nUltra-realistic canopy physics\nDial in your canopy settings, toggle presets, pull front risers, or go full competition-style swooping.\n\n**Visit new places and drop zones virtually before you arrive in person**\n\nExperience line twists, cutaways, and reserve deployments.\n\n**Exit from an airplane, helicopter, hot-air balloon,  or jump into our vertical wind tunnel for fast skills drills.**\n\nGlobal multiplayer\nMeet friends or teammates anywhere on the planet, organize formation jumps, and share the view in real time.\n\n**Jet Packs\nHover, climb, or pause mid-air to perfect maneuvers and instantly re-attempt canopy landings.**\n\nMaster Skydive Sim controls through an in-depth tutorial level, plus a growing library of video guides. Learn more & support: SkydiveSim.com\n\nHand tracking is supported for core interactions.\n\nSkydive Sim is designed for entertainment and not intended for skydiving training.", "short_description": "Skydive Sim \u2014 Soar over the real world with Google Earth integration\nExplore the planet from above with ultra-realistic skydiving, canopy flight, and jet-pack freedom.\nGoogle Earth included. No subscription required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/privacy/view/130ff4c1b0687c52ebc5095cc923e4f6", "developer_terms_of_service_url": "https://www.privacypolicies.com/terms/view/37b5278e52fb6c7b0e5aee1fbc17d2b2", "publisher_name": "AV1 Productions", "support_website_url": "https://skydivesim.com/", "website_url": "https://www.skydivesim.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25004998629198489"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619704_951850597234611_6579757818991555302_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWRcTJ2FsiMQ7kNvwGgt_BE&_nc_oc=AdpizW8qvxasIoOSYpPaw94sC_0lZhr4vgcY9l9z-UsiiJzAIllbXxy0KpKcOYesVDs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZoi5XU-4RKm7JQYQhaGffEJp95ZIET12DaZIXe_rFAw&oe=6AF1F30F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Skydive Sim - Skydiving Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1648789200, "lastRevision": {"nodes": [{"id": "620758685703346", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3711951435596517", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "586786429312799"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "SkydiveSim1440x1440.png", "i
8432428_2213927470787436401_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuSIfgGwxeAQ7kNvwGXrkR2&_nc_oc=AdqDind57vKLZ539wnmyPXZIGOiuDh4hyx0IEAf4GVFaPyjqZ6n6rr3xCPJEnBxrKqc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt-3h-HkdSBC9qyizHAKqZL5LgoS-OpDqvyPdlq5fLKw&oe=6AB6793A"}, {"file_name": "SkydiveSimScreenshot03.png", "id": "361369322068754", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974820_361369325402087_6657239464690309087_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2m9_guX6icEQ7kNvwFcfl9P&_nc_oc=Adp65KXEfGqCZdLpLCtaA8RD18SCi6tlEb8TrSuZWrGm5PzipqdUajtJhglokU4MsuA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYzeq7tfWen9NkLfUatI64gOsH_M458G6cu_k-ELrWYQ&oe=6AB6680E"}, {"file_name": "SkydiveSimScreenshot05.png", "id": "335291705128917", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031343_335291708462250_6985390002442207565_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooZCTub0AdwQ7kNvwHobbNJ&_nc_oc=Ado__liRW3w9dD1xfb2GIwtVuLjsbixgfAdiJyuNkg7NszDkIexSzATH-_uw1yeh78o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrwjGJVNmtKUkqWuImkuHtLMyynNDMdNnFFUEF0m11lg&oe=6AB69A7D"}, {"file_name": "SkydiveSimScreenshot01.png", "id": "473403584397283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982581_473403587730616_3457719944370599987_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBePvbTzbfoQ7kNvwH_jeyE&_nc_oc=AdoIxYPOZy5tQX-gF8NV47UeMfpMQvg8PMW1lpNQSKbqb4qFMZcCk_OgAj3-uSpNMuk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqqgujGyma2E5FO877lPOt4F11kMmE1_U3BESztU_r1Q&oe=6AB675EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SkydiveSim Video cover.png", "id": "1204356376969774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031479_1204356380303107_7854076978195590218_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t-uNFnAkY4Q7kNvwF8rU7p&_nc_oc=Adqa48PEDSC83wqsjC1ey9-GrD_3Kfh7kvzSFIjjGRfppQWJvsJ1MwABfEgClqeMeCE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF8yvnVls_2rrkgoJzLNhwGTAVnSD9YgBtukGhUmR0Ag&oe=6AB68620"}, "display_name": "SkydiveSim", "keywords": [], "long_description": "SkydiveSim brings the thrill of skydiving and BASE jumping to your Oculus Quest headset. No more waiting on weather on bad weather days. Put on your headset and choose from our gorgeous levels. Jump from a plane 10,000 feet above ground. Challenge yourself to go through the free fall rings. Then pull your ripcord and fly under the canopy and finally work on your accuracy and  land on the target. You don't need a plane ride back up, just repeat in the same scene or choose another one of our exotics environments to jump into.\nWant even more  excitement? BASE jump from top of the buildings, windmills and light towers, pull the ripcord and navigate to the ground!", "short_description": "SkydiveSim brings the thrill of skydiving and BASE jumping to your Oculus Quest headset.\nThis is the full version of the game and it includes extra environments and well as the ability to jump from a helicopter,  balloon as well as BASE jumping from windmills and light towers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/privacy/view/130ff4c1b0687c52ebc5095cc923e4f6", "developer_terms_of_service_url": "https://www.privacypolicies.com/terms/view/37b5278e52fb6c7b0e5aee1fbc17d2b2", "publisher_name": "AV1 Productions", "support_website_url": null, "website_url": "https://www.skydivesim.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "452790896554314"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "1055103313795513"}, {"status": "PUBLISHED", "id": "1367317508695363"}, {"status": "PUBLISHED", "id": "1897940734236381"}, {"status": "PUBLISHED", "id": "1335957508440501"}, {"status": "PUBLISHED", "id": "1454593749484301"}, {"status": "PUBLISHED", "id": "911946071676503"}, {"status": "PUBLISHED", "id": "4386253488365143"}, {"status": "PUBLISHED", "id": "850044404609302"}, {"status": "PUBLISHED", "id": "1171582327990692"}, {"status": "PUBLISHED", "id": "705789479199257"}, {"status": "PUBLISHED", "id": "758359823361270"}, {"status": "PUBLISHED", "id": "1407005983906431"}, {"status": "PUBLISHED", "id": "1167867321804748"}, {"status": "PUBLISHED", "id": "1797117851064646"}, {"status": "PUBLISHED", "id": "558672247163105"}, {"status": "PUBLISHED", "id": "1561625437787896"}, {"status": "PUBLISHED", "id": "661102699417392"}, {"status": "PUBLISHED", "id": "1213129326298038"}, {"status": "PUBLISHED", "id": "367175005230199"}]}, "baseline_offer": {"id": "1407005983906431"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1055103313795513"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26759171790447822", "version": "5.0.5"}, "id": "337947788184196", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3711951435596517", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26759171790447822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "337947788184196"}]}, "change_log": "**Introducing Wingsuit Flying:** Take flight with the new wingsuit character and controls. Bank, dive, flare, recover from stalls, and experience a whole new way to explore the world. Plus an all-new Wingsuit Tutorial!\n\n**Two New Challenges:** Fly a wingsuit route through Aiguille du Midi or take on a new helicopter jump challenge, with guided routes to help you along the way.\n\n**New Difficulty Options:** Choose Easy, Medium, or Hard in supported Challenge scenes, making it easier for first-time players to jump in while still giving experienced players a challenge.\n\n**New Freefall Control Options:** Choose between Arcade and Realistic controls to match the experience to your skill level and flying style.\n\n**Introducing Event Mode:** A new mode designed for demos, events, drop zones, and group play. Event Mode makes it easy to guide new players through the experience, select difficulty levels, and connect with the free Skydive Sim Remote app for external session control.\n\n**PC Improvements:** Improved menus and flight options, along with updates to desktop camera controls and Instructor app video support.\n\nPlus additional fixes and improvements throughout Skydive Sim.", "created_date": 1789574851, "id": "26759171790447822", "version": "5.0.5", "version_code": 245, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26759103647121303"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3711951435596517", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26759171790447822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "337947788184196"}]}, "change_log": "**Introducing Wingsuit Flying:** Take flight with the new wingsuit character and controls. Bank, dive, flare, recover from stalls, and experience a whole new way to explore the world.\n\n**Two New Challenges:** Fly a wingsuit route through Aiguille du Midi or take on a new helicopter jump challenge, with guided routes to help you along the way.\n\n**New Difficulty Options:** Choose Easy, Medium, or Hard in supported Challenge scenes, making it easier for first-time players to jump in while still giving experienced players a challenge.\n\n**New Freefall Control Options:** Choose between Arcade and Realistic controls to match the experience to your skill level and flying style.\n\n**Introducing Event Mode:** A new mode designed for demos, events, drop zones, and group play. Event Mode makes it easy to guide new players through the experience, select difficulty levels, and connect with the free Skydive Sim Remote app for external session control.\n\n**PC Improvements:** Improved menus and flight options, along with updates to desktop camera controls and Instructor app video support.\n\nPlus additional fixes and improvements throughout Skydive Sim.", "created_date": 1789166535, "id": "26694862630212072", "version": "5.0.4", "version_code": 244, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26694830003548668"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3711951435596517", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26759171790447822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789138317, "id": "26690395380658797", "version": "5.0.3", "version_code": 243, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26690339213997747"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3711951435596517", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26759171790447822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "337947788184196"}]}, "change_log": "Added Skydive Sim Instructor connectivity, enabling instructors to remotely configure sessions, assist students, and view a live video feed from a compatible phone or tablet. This update also improves device discovery, connection reliability, video casting, controls, menu synchronization, and general stability.\nBug fixes and enhancements", "created_date": 1787784806, "id": "26489719444059726", "version": "5.0.2", "version_code": 242, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26489705474061123"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3711951435596517", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26759171790447822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "337947788184196"}]}, "change_log": "Added Skydive Sim Instructor connectivity, enabling instructors to remotely configure sessions, assist students, and view a live video feed from a compatible phone or tablet. This update also improves device discovery, connection reliability, video casting, controls, menu synchronization, and general stability.\nBug fixes and enhancements", "created_date": 1787418053, "id": "26438527632512241", "version": "5.0.1", "version_code": 241, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26438481125850225"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
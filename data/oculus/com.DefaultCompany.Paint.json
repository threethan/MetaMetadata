GHBOH8qUh-ALnyiWfqh09391gXfz_1ykzvg&oe=6AF08252"}, {"file_name": "SPRAY_04_Rooftop_Water_Tower.png", "id": "967446286417109", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604360590_967446289750442_1281696013442571877_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmfW1yRGVdEQ7kNvwH-SxhW&_nc_oc=AdodecrooUGNQg6cpCKL-Ey4ppfLLHz3uWx6-kB3Yaz2Nvrfi3C76sGftijEIg61Olo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQILxzhvShMCmRoRp-29HWv_IyfYpiXH70aPmX71By_gA&oe=6AF09FDE"}, {"file_name": "SPRAY_05_Billboard_City_View.png", "id": "1547944417021503", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/753032404_1547944420354836_7994485732152181170_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84R3GpGUaaQQ7kNvwH5_--5&_nc_oc=AdprVrcrEusaTVq0N0XXdaHlEuvjWMdmntsV1h5SqJN6m-MZHv4PwSejuFTuDdEB7bQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHv1PG3h6PlmaInipopYF23GxUfXNia-oxhDXJMqZtQQ&oe=6AF0A948"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot2.png", "id": "643629198835139", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618284_643629202168472_8302365622059487867_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_O6qpHM_oeoQ7kNvwGP6MCJ&_nc_oc=AdoKAqaK59rIIc69Hs7O0TEZLhekrHBwc0xT6QHQ8zElJ_Yh9P9mAuBLAMZUTvKVTaM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPDcIFaJ6RD3z-Zj18Pb9O7E3CfWmRiD2LYTwyF0_t_w&oe=6AF080F7"}, "display_name": "SPRAY", "keywords": ["spray", "paint", "painting", "spraypaint", "graffiti"], "long_description": "PAID VERSION INCLUDES\n\n- PASSTHROUGH MODE\n- MORE SPRAYS COLOURS & STYLES\n- FULL ONLINE ACCESS\n- MORE CANVASES \n- DIFFERENT MAP ENVIRONMENTS\n- MORE MUSIC SOUNDTRACKS\n& MORE!\n\nStep into a small city alley and make it your canvas. SRAY is a simple, relaxed tagging sandbox built for anyone who wants to mess around with graffiti, practice letters, or just unwind and paint whatever comes to mind.\n\nUse different spray colors, experiment with drips and soft edges, and fill the walls with your own style. Whether you\u2019re sketching quick throw-ups, outlining big block letters, or scribbling something dumb to make your friends laugh, the space is yours to cover.\n\nThere are no missions and no story yet\u2014just pure painting, free movement, and a gritty atmosphere inspired by real street alleys. It\u2019s a small environment, easy to load and easy to jump into when you want to vibe, practice, or try new ideas.\n\nPerfect for:\n\u2022 Quick creative sessions\n\u2022 Practicing tags or lettering\n\u2022 Chilling out in VR\n\u2022 Showing friends a simple first-time VR art experience\n\nMore tools, surfaces, and areas will be added over time. For now, grab a can and make a mess.", "short_description": "A simple spray-painting sandbox set in a worn  Toronto style alley. Pick a can, hit the walls, practice tags, experiment with drips and caps, and make the space your own. No pressure, no missions\u2014just raw street art energy in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/privacy-and-terms/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesInc", "support_website_url": null, "website_url": "http://MDRNgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28459898960347885"}, "review_messages": []}]}, "
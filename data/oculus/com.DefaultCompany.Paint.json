nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbmM8dLjYlcQ7kNvwFc1ZsW&_nc_oc=AdpTlnEYABCU3qBsA3_5kucVQqHpRXDS1RJLOggarGIjD_eK2-OYhWd7CznYD1fTIh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf9Fgd1OfX8OweuEpeYCwjpAPYTj2jSWRbFlQOWkvJ4A&oe=6AB91092"}, {"file_name": "SPRAY_Landscape.png", "id": "785240747871355", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_785240751204688_1103844547666582085_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SCs9Zfic5MQ7kNvwHPz7Ba&_nc_oc=AdreFqlLUEYz-1Iu4upZ8l4nm12LyR3QXV4hwTOpJvXQK77tkgt1iaXhTQH6r9FL51A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc2gb_tlxuc47mLMozZnTYxwZBLV4NGrjLCWId5M7nyw&oe=6AB90967"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot2.png", "id": "643629198835139", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618284_643629202168472_8302365622059487867_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Du6GNvwRthYQ7kNvwFub-p0&_nc_oc=Adrn0CJ6SoC5qUfVLNm2EouLDYe4DHTdFE-sQldSX3y93UAXAaUUrYYEPG8HJ-9Ta9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlkzk_skQM7uh1aPzGjXE8vzEphVIUAldqcbw54P2x9Q&oe=6AB921F7"}, "display_name": "SPRAY", "keywords": ["spray", "paint", "painting", "spraypaint", "graffiti"], "long_description": "PAID VERSION INCLUDES\n\n- PASSTHROUGH MODE\n- MORE SPRAYS COLOURS & STYLES\n- FULL ONLINE ACCESS\n- MORE CANVASES \n- DIFFERENT MAP ENVIRONMENTS\n- MORE MUSIC SOUNDTRACKS\n& MORE!\n\nStep into a small city alley and make it your canvas. SRAY is a simple, relaxed tagging sandbox built for anyone who wants to mess around with graffiti, practice letters, or just unwind and paint whatever comes to mind.\n\nUse different spray colors, experiment with drips and soft edges, and fill the walls with your own style. Whether you\u2019re sketching quick throw-ups, outlining big block letters, or scribbling something dumb to make your friends laugh, the space is yours to cover.\n\nThere are no missions and no story yet\u2014just pure painting, free movement, and a gritty atmosphere inspired by real street alleys. It\u2019s a small environment, easy to load and easy to jump into when you want to vibe, practice, or try new ideas.\n\nPerfect for:\n\u2022 Quick creative sessions\n\u2022 Practicing tags or lettering\n\u2022 Chilling out in VR\n\u2022 Showing friends a simple first-time VR art experience\n\nMore tools, surfaces, and areas will be added over time. For now, grab a can and make a mess.", "short_description": "A simple spray-painting sandbox set in a worn  Toronto style alley. Pick a can, hit the walls, practice tags, experiment with drips and caps, and make the space your own. No pressure, no missions\u2014just raw street art energy in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesInc", "support_website_url": null, "website_url": "http://MDRNgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24962032490134567"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1304042301829913"}, {"status": "PUBLISHED", "id": "26428627566824406"}, {"status": "PUBLISHED", "id": "1301045875123125"}, {"status": "PUBLISHED", "id": "703243815742314"}]}, "baseline_offer": {"id": "26428627566824406"}, 
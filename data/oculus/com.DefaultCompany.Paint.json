HhufXAkkQRHY8-eyjuqZbqqx7hs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ync8vhFdQU1XZHC0TOGzA0ZqR5cO3lRnghGDeF8Uw6w&oe=6A22FDD2"}, {"file_name": "SPRAY_Landscape.png", "id": "785240747871355", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819980_785240751204688_1103844547666582085_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGNjNP5m1ZIQ7kNvwHtD-hF&_nc_oc=AdoUy8_Ja9tfRJSwkJ3Y5-nOIEjNWXtm-g41ylytoIdPnhMkHyCRGCfd-MVG3KOlh0g&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g9XE1CzCMCOk1RN0D6cCwqF9M1txc9GS-_NMHHDpoaw&oe=6A22F6A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ScreenShot2.png", "id": "643629198835139", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618284_643629202168472_8302365622059487867_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BrcFfRY3YIQ7kNvwGEiq9c&_nc_oc=Adq6qOuLe2KIdYvme6SYLoKHchIJyxieme6UNjFjN78QjOGkvF7tkUvcu5XEWPH-yEY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PrlokJ4bl3DpPH1Lb02-j70xIvEq5Go6M7hPL0ojqaw&oe=6A22D6F7"}, "display_name": "SPRAY", "keywords": ["spray", "paint", "painting", "spraypaint", "graffiti"], "long_description": "PAID VERSION INCLUDES\n\n- PASSTHROUGH MODE\n- MORE SPRAYS COLOURS & STYLES\n- FULL ONLINE ACCESS\n- MORE CANVASES \n- DIFFERENT MAP ENVIRONMENTS\n- MORE MUSIC SOUNDTRACKS\n& MORE!\n\nStep into a small city alley and make it your canvas. SRAY is a simple, relaxed tagging sandbox built for anyone who wants to mess around with graffiti, practice letters, or just unwind and paint whatever comes to mind.\n\nUse different spray colors, experiment with drips and soft edges, and fill the walls with your own style. Whether you\u2019re sketching quick throw-ups, outlining big block letters, or scribbling something dumb to make your friends laugh, the space is yours to cover.\n\nThere are no missions and no story yet\u2014just pure painting, free movement, and a gritty atmosphere inspired by real street alleys. It\u2019s a small environment, easy to load and easy to jump into when you want to vibe, practice, or try new ideas.\n\nPerfect for:\n\u2022 Quick creative sessions\n\u2022 Practicing tags or lettering\n\u2022 Chilling out in VR\n\u2022 Showing friends a simple first-time VR art experience\n\nMore tools, surfaces, and areas will be added over time. For now, grab a can and make a mess.", "short_description": "A simple spray-painting sandbox set in a worn  Toronto style alley. Pick a can, hit the walls, practice tags, experiment with drips and caps, and make the space your own. No pressure, no missions\u2014just raw street art energy in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesInc", "support_website_url": null, "website_url": "http://MDRNgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24962032490134567"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1304042301829913"}, {"status": "PUBLISHED", "id": "26428627566824406"}, {"status": "PUBLISHED", "id": "1301045875123125"}, {"status": "PUBLISHED", "id": "703243815742314"}]}, "baseline_offer": {"id": "26428627566824406"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "13040423
00_AfxhkMMni62-CXN9ew7KBpx2mJwYOsjBpDAIP1MiUEOo4Q&oe=69BFEC0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAhuPs_73aAQ7kNvwEG9AdE&_nc_oc=Adl6Wmni8NRlE5LF7emW1EAD9PMYTuE-ueCIUVPcB7uXBhB1NEQkBtwURPqBYR_BdLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeK90M5n5S2NJQSN2LscOpGBl55KW8-TkyjO5dmiJzMw&oe=69BFFE5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0oLy8kvAzsQ7kNvwHGMVwY&_nc_oc=AdkgtiCVrvd3hmIEipcPMeTQTZhj5C_1W3tMjRY3Ga0nGp0dPJicdnAZh_8K2RisY3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxlaE55GEUbRKKSOEy0GJBd8m6BwCw93_0io6V3lV-gUw&oe=69BFC910"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KbGYPk-YywQ7kNvwFcQOD9&_nc_oc=AdnX3QM-H8PGh4cTZLxbxlJ_Gdm1ZnfYz7aKnVGxC0H6Ajjtn4jDd1nCbBqYhsQWXZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwqpL2MN3M5eh2mWibhk5ITkDDbwHNkZpbFjP2OVGu0TA&oe=69BFEE3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Mana
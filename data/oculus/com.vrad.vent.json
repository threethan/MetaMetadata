t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN-8LHPSL3seuVEIPtYGAbZg8TPsU2NPh_H7SIwCyZBw&oe=6A985A4A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxk5XgTgubAQ7kNvwE9_ynF&_nc_oc=Adq7dktjpebFmmOYAP8mraGecIedZgyN0eCmqLke6HUYysNEqyUsrID2h5A6D4f09DE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpeisftksoOZSD5jGBwjl57muqyO-a8TD09jQb8jc2Mg&oe=6A98345B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpC8GrBdBlsQ7kNvwGWM35s&_nc_oc=AdoyWIOHVv_Z5DynVud5lkB93Lm63BDEnmy0Q-67VJ3yPTlhgLB-7LN2E7rmi1JyeFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIce8k28Zm_8c9WzB6vJELCiWYXGo5sR7q0KdI9sU-WFw&oe=6A983750"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dx6J70bCQ2QQ7kNvwEBKVhh&_nc_oc=Adrp1AABeLCXB2BxfRBgEAnToZroco4UvP6DTuWfHWXqJfYjNYHeW-S3YB3Ih9fmKG0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9HX1J18VyjyJwco7o-hUeFq_GadN38ABuxoQ7IpqtSQ&oe=6A985C7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmQakM88Y68Q7kNvwGXpvle&_nc_oc=AdostrgDXT0KXlOM8iIQvqPAfl34t_Wk7_qQCsQLsI_b_g1rZj79cHGwOtdrL_haeRM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7tgmlDdeqP9o4r3T771dJHKa8-3ZWXZLvtXwGL0h-OQ&oe=6A985D79"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYXhf1_FxVoQ7kNvwFZI_Ta&_nc_oc=Adq_I1B8zc38mHt36ONfLLK3YKJJV0W3vkPxTVRW7RvkAyKYDmix17EqXe7IpPY_2_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8n42QDOE8XhjpRZ2CpUFoTYJeByaO5yJjWphsh5OI7Q&oe=6A984BCF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCC2dce8gmYQ7kNvwHMC8ET&_nc_oc=AdrGodv2ROuegLhbSOEKavxkUbX0ZV-qyI8LN96MWxxCfBnQqpWfrlNGl5wKir2u85Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEMonmiWfVwT_7u4R0uZdX2mVUTIAchpmG1OPNwT4onA&oe=6A9859AE"}, {"file_name": "005.VS_M_Squar
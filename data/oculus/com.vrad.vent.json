t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTnKTPuEns46zio2kVS9r32HW-DnHjhNal2Fl4GpScqA&oe=6A7B210A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fUwYajL7rYQ7kNvwHtAXkE&_nc_oc=Adq1cfGA-vWp_1HsoB9TU0-kHUUihrKar95UQUY5nUvWc9QH53NdpXBJiTA2EaSBa0g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFqz4tZdzZiPXFjIojYbdBiP2mSnG2DNsU9GITYl3uwg&oe=6A7B335B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UxxRkJNZKQQ7kNvwH1tyzN&_nc_oc=AdqxFV9wWELjN4G5s24d9Q_YsaQso2dIG-ZvnAMWbYK972fVGNjQC0Mi3H9POveyrTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbQYAh6C-MuNixFbF653KG8lN32hZPdrPqv-6DLo30OQ&oe=6A7B3650"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvnfyUA7bKEQ7kNvwF2ev4K&_nc_oc=AdrF7O-kvOcphFVp5_uZ4LKx_opZ7p4KUx6p6atRWebPpJmBr_JZ7Ircxc9e7ZVY0jU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPAi2khmWa0J6Tx_05ULSuuNTS0YUWjhaXMK3FWaOV9A&oe=6A7B233C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-BkDUZ_w-wQ7kNvwErIOIO&_nc_oc=AdoHUeyHpBasUqikPJKP7-ZdwB7-5Uk9TkEnp_UU0KYuyNEtl-D1xZI1Aiav3rXY_fY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbdUdHhqevh89l6NlJJV2NwXQ0dqE63OVQD_SE-7HpAg&oe=6A7B2439"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jzy8l1szfx8Q7kNvwFqcqFI&_nc_oc=AdouKLiScRrlW5EqiA9j5BRjcH1fZl4tJmlHpf3Hm_W_R3pV1IGl9vi2k7gGeEl6tyM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHmBBi8TXyeNOrUWaH-ideXwjRbBJFtJvvPgBFp3laeA&oe=6A7B128F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xT3yIHZFPggQ7kNvwGLWI_M&_nc_oc=Adp7PJt8vgpWiAByauptBqOV7HMdrl8ffCgiZ9ef0sUt89iQMOBIBz35cQswZXsznWU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpEP2mMHnj9d6nRNMCQZ9t1nqsxETWxLBG1fywHmMWUA&oe=6A7B206E"}, {"file_name": "005.VS_M_Squar
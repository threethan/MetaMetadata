t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeJFX-CuONa1pL6S6AGXbRvv-Sbhz_fuD2RuidZMBOKQ&oe=6A4BAB0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaL2_qhr8DMQ7kNvwHwYabR&_nc_oc=AdpPV7Nc9pDNysfVj7TGoN1Y4tjHgaSBmrVz9MzqvNf6xivapM23igCz7GoG8QorK2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY3SXO6O66mi8Dqh8SYhlA9-e0oJVRgEzopQL2z4r_FA&oe=6A4BBD5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WylhfJmwmNQQ7kNvwFKJHts&_nc_oc=Adrsfbpkxfxw4QgsQTEcVWhbyy8mkJDL260NQ7_CRzNGZl6qxGIaMcEGEbxU294Yprw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBUr1yxnhGJxwfbDLdz-fR2TYYCLigW9GJXEAstohRZg&oe=6A4BC050"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-y3SbA8tZwQ7kNvwG_VMrY&_nc_oc=AdqW4Kwnj58lqxQJZKXj6Ne4N4E8jPIlsBIb3HGN-lYG-ObWH8oT2_l2LP9QRox6iE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd8ykntSCcR-dzoM5T6yts_HUF47NEG_ECjPOPYtVr-w&oe=6A4BAD3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpgtBZ3TNTIQ7kNvwE-dKjm&_nc_oc=AdrZSZd06uQYIQGr4VRmABpHrZEC1DnjmVemkjVf4J0Xpi-sTBy6fCxW4ADCtGygFcY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAYOd0hqR1CnRw_WQ_I_UzV34LZIXqrvpMcKTA4BEn6g&oe=6A4BAE39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lXOA97hjjUQ7kNvwECo1Lq&_nc_oc=Adp0h1ol1iKKXc0tkccOazSwA2voD8WQWtEg74YVntDVDUmuBInBu35KWPFaEdguntQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnds_rT5pIrg6WlPQMjPK0XB5S0au5Ch9kt3m7HGfssA&oe=6A4B9C8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSt3WpX8VmcQ7kNvwELPqZ9&_nc_oc=Adq24uGvO6o8xEs7vd5wpDGl3kcrLgsWY35qNK1K4A34ahFMQJyJWRGJoDvUM4p_Iqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDboUSwJTfs4OKg2t7LEUuLu3VDuX2pxmmBTXurvgyiw&oe=6A4BAA6E"}, {"file_name": "005.VS_M_Squar
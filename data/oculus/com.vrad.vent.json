t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO0pZMIM_IwikfXSwpZThpc_ViidCo7JGOedsq3YTGdA&oe=6AB2800A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq87_O50ZpwQ7kNvwF8Zl_a&_nc_oc=AdrYTblEQ-hkNksHXSPxSQji8qzytvzZgd6y7dZ0xPx-BdtEDNxFrNkbMzqlqRH9rCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLff4xn14HKcZ-Tb6xxOFDwLDctIxFQV4PnUGd6AXbXng&oe=6AB2925B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQ_dLjzVmwAQ7kNvwE9aLi-&_nc_oc=AdpYLSL9AJrnB3e2HOLua4yIEnp7sRmFGsvwWSLUx2QqSNUlMus3LaMt08hLJLK-7-g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII73zyIHUHMPuuUX4QGyH0Esvp9M71os985TMxe8qmew&oe=6AB29550"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ua94kJe0iJYQ7kNvwHfqCZi&_nc_oc=AdqOgozXmx1WYlDdrPCUFIhv21vvqQ9naHVvtFv5nKjZ-NbsbTM0Y2PLt0Mg4PeQ8RI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmAlNJbYDEl6GMNYiTXU21wudQJadFHVTFHj5UqcuuWQ&oe=6AB2823C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ET7YrU-SO50Q7kNvwGYJ2KN&_nc_oc=AdpIfRWyTfui56P2dM4F7S2N8wU4Q0kG3SNG8mFMyQNr0UDFSzzps5ALJJTDXnj3Ebc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgWVtY_7cvQlJZ_FJLSbbfRJ_3ettdpV6tb8pZFuX28g&oe=6AB28339"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_2meYlC7kMQ7kNvwGjO2K2&_nc_oc=AdqDPCuklu6ZaN1Z-Njxv6sfkJH1pcjmDpRZvN7zTQHkpqN2HHJ-MLg_W_RMZws_2W4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_As7em9YzTXuaNwSIpnfZ0gP8XoEx4D6WAuP1szUEKA&oe=6AB2718F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3TDGSOQ1U0Q7kNvwGygzD9&_nc_oc=AdqfDdTuNx32HOob0wl-Zb6m8VLEyr9OWU95w9kBfgUYP94hABYbcJEDMxhAd5rzQlc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkTmNzlex0-0cgft47HU_BwHBgmm40L9IQnxFNyk2Oog&oe=6AB27F6E"}, {"file_name": "005.VS_M_Squar
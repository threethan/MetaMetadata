nt-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NNjd-jwIG60ybYGArUXLkXmd6YbkYUm1oQXlFjbl58Q&oe=69D2610A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeFI3rleD9QQ7kNvwEQ_BKp&_nc_oc=AdqGnRKaeV1UM1g0ahVG7zkrTIVYvND5mmcmEHAUNvm-ge8q0FBsCHmc27RMsRmGQfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1s3rdu1WDSPYsLPLAonx16XZTZO51fgq6nB0ppk88Ztg&oe=69D2735B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovUG43q0O9QQ7kNvwGba9Df&_nc_oc=AdpWZXfXbht8vBpbgEOA0tJIGx1YufTLhHqOKcRKYGVfThifXGcfblrYpBMQ4TXt9uQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_ACmQNfzp4zsRBstiH1k55Fcnzer4kDn3Ew9QQcYCrw&oe=69D27650"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JrpYA7vTv8Q7kNvwEtXzBQ&_nc_oc=AdoyqN6Or_A8mKSNG82N2SqlrroAiEjYLEwzovFYdXHJAL_XPNL-0pnN7Rq5chTgPfU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fdxmyGiHNyxH1v_DEPBFQ42sOKFMvHaGff9ZXKmLaYg&oe=69D2633C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM-dDHHdHNQQ7kNvwHYHwJD&_nc_oc=AdrlCaWI3StrFgJQY7zq6pC8hWhnGRhnxUrqJVEh7Bz4toWk92-7BwaOwCWlmJqFMZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nQEzjJR3UECsQ_jP0yN8xHwbW8jQF4YyxOzbg2WH1_Q&oe=69D26439"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uHJeYn3b28Q7kNvwHZOmDJ&_nc_oc=AdozZLumQyCicALIEjxEsOq3ac1wuXdDG_GrhAfzAHBhRE-5a1f2-3DV0YZxpfCecDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aVnlSv7mHsqCMh3Rp3rHc4JMykBtEytTCeM1SBo82_Q&oe=69D2528F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhSor7R-L2YQ7kNvwFpIZpq&_nc_oc=AdoMvefpG35CcRPVJIg7srpQbqlMfFjc38QpeW41sFwaWLjPGz53jfJ9FEFmKfHQ3AI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2reM6rlCsX8I1rD6E_sHbuVHAgFOSCU1JcTnZRpQwTwQ&oe=69D2606E"}, {"file_name": "005.VS_M_Squa
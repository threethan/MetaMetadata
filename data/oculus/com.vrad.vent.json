t-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM_JVBhNLYY2FjyW6sWfiqaUSKbcHr1kJ12fzHl2p0Jw&oe=6A4E4E0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miWkTLP2qe4Q7kNvwFqFYqk&_nc_oc=AdoKyM9TsxQZY7uoZRgJagGWHyxyEY-ez_T_XAwkupxkiQMSrOGmkTEcbxXkyQY5fnc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxbG_zvs0pHHqGe5ZsaTy6sh9oGPsIDbl-6cRCeuWthg&oe=6A4E605B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddHwBmb9Z44Q7kNvwHizBkG&_nc_oc=AdpVVXtEjWdqo9v7lDQOarnoyUTAESeB-tVP1EKhEGcnUs3HMyYa0xF4uVdHGoGrWZw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTVT7KRPNyhrhxBtJZQwxYK2JCzKUJis8d5SXjSDVidg&oe=6A4E6350"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-OQ9qHv2_cQ7kNvwEyeirW&_nc_oc=AdpKw3bTk_WygWsGqGUZ19yoRYKrUTXLvcR4mlZz-ClaWIfPu3xQTNuBwB5m_61jKtY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCypAcS3fNqLjiYnwABU5oDSyAPvyZzYEJcWYLqrvry_A&oe=6A4E503C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WT8VVxHH5scQ7kNvwHkGZEO&_nc_oc=Adq8OeiTlFNeKD6VI4OHQpwO2AhE9uReiJ2RQVbboDeKZz6WFK-EZsiHmiSrCxMxmV0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7D_YF-xTRTfoMwNvOCQFl-qLbXnm_1dJ-GngWXYEL0Q&oe=6A4E5139"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCScZ3F4IbAQ7kNvwGlOPcE&_nc_oc=AdoUpzPTCBQz32O6PkL-_KV7qsoFR_Xpfvj30WChWqfpHLHKiiCEsovapgRmCfc4cv8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHJXi-JTKlDJ-RecHAkTFgIbCZyR4koHYdt4oiJSjFOA&oe=6A4E3F8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3z7ehChKikQ7kNvwGR_MUG&_nc_oc=AdrlBYN0z5PuQlZrrjCVRNVpLff7iH88BqsWd5MBiWIYaM_tGn-C1GGQ_EKynHDHH8k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaHyvo987wRQ1ZYSf6ul949ZwumALgP3BeJZfx2BC7RQ&oe=6A4E4D6E"}, {"file_name": "005.VS_M_Squar
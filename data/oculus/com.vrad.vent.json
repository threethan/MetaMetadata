nt-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oB_ADRAiT4whXwMTug8QMsqHhfx2-Q0n_RU0Bf9BMLw&oe=6A18408A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zUmP8AEiBoQ7kNvwE8SRb9&_nc_oc=AdqqJ_LYTw6z2yvw5fs1ZUkUPdVaBbJHQXa8fSuZwskvxfL7uFdGU4dt-L6t7omnJOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sXGuoTtkjYJC2OVsQA234VeTejwPlDpv3w5KcfXU7Gg&oe=6A1852DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxYo_TUzSWgQ7kNvwG9WDG8&_nc_oc=AdrocAYQ0TO2q2h5PCW8jpfboxT0ZlL4UoE7BLPNAMrNFvXQA5fIYLWVfyZob76MVpk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rQxte6A3xjfAhIcC9knCKmA8Y5izXK5ciz2xpm1RHwA&oe=6A1855D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcFJEABs9osQ7kNvwHlsUam&_nc_oc=AdrWkvEXW86yo67H-ZOBRtE3Aoumotc7g9X2FpDOWGkEppxyLUDCcrqRcGxB4Ar-mVc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XRglCAgfbxhSLOmw4x3nHPozYUqSz-2zFxzxexKQajA&oe=6A1842BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tszw6TIc1HcQ7kNvwHk_36R&_nc_oc=AdpZdOAUjpAnCQ0-Svz41NVgkvENGuw7l80Ca-WK0Ri05Jl1in85fpCA5WN-z6Y2kro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZTI3Y5JyOjG6P2XoO40MKWgfRxdPoMvbz9qx3IGYYjw&oe=6A1843B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1lcFZ4Jb_QQ7kNvwH_f7Mg&_nc_oc=Adq57UyqDCYuQnet2OpFggmoVB9T3gk1C6j5iI-ofXw3ICi5apYZV1u87Lzk_ihv3_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CdbGWvoWN0Po95-Ld5p_1IMvXRpZOQFYRNY_8jM0uIQ&oe=6A186A4F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDBlczSeDdAQ7kNvwGAVBAT&_nc_oc=AdqolvLobIzspsniv6abIod49pSrPbyJH9GNsO3ueR98bmpc9Axipcs95Aursu49zvM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TdBlYbDmmEHcA7H0J_imuNmDUzi9K2BGfNIijytb5Ug&oe=6A183FEE"}, {"file_name": "005.VS_M_Squa
nt-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7imb2tXVJXxXyubgFKjY-_7ku26SrY1U8lr52lq6SN3w&oe=69FB3F8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-LuOfmp0GsQ7kNvwFTM83I&_nc_oc=Ado_tZ1_RSsjEh99nR2h0-3DFoIsbywSLhtyYZjdWOhdOAdLRnmnx1ejpRPDIFUByVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kV5TtiUb0V7WxwXc6q4OL-Smuo768Iho-1nJGDEIgXA&oe=69FB51DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifsoLf2kPjgQ7kNvwGBMN4x&_nc_oc=AdoRT3WZYeQY5Zdf4dvyf1rs7NyJK-ZtMAbNnsJpG-mMxlK4RwD7iMy5UfAX0gnq3E0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J3U03iF3o10PpcMRHtfnihi7oxzICrPSap9i5O7kgEA&oe=69FB54D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXkgRs0zJOUQ7kNvwGaOhSw&_nc_oc=AdrxvXctdraxONt5pdYpAQIe8L8962M0QPkKH-RNGCrfgq8RSgWtfib54XLL2EP9kpw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qBsJ0fwB5L4SHBYHHsX2RoypvKsSiMS8DAvgx8YYt-w&oe=69FB41BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMEWBcOCjXgQ7kNvwEYi2z-&_nc_oc=Adr5miMte2FPmY8XeAFr2PdTCxTbiUj8gwvYaZEoKOuPUXu_gDZ7lzY1eosO5uk_iIA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4enNX6XDW_MR92SeCP7YnzABo0efbMySN6N1gZsYVtXA&oe=69FB42B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1DJLMbEpFgQ7kNvwGEfvk9&_nc_oc=AdriweH79zlcc1sOdDwiLagRA-MaDEc2b2AesqRYos_Fn0f6FAqPspXs3rgkk4AzInc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h5JhG02M5RlK1Wv_Bol-6dFJPWc-hkqEQ6uzF4GZBTw&oe=69FB310F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyqpF4X2Xg0Q7kNvwH5oGUU&_nc_oc=AdrEuAR17UmKzVwPSY92SdGD0wFc7x2hjlvzhzrZQvBSk5osZXfgJYDbZiwh6Sus4v0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uhjtAjb0rWZNO0JPe1GXOInBPUWmJs3UOu7mVpj9vOw&oe=69FB3EEE"}, {"file_name": "005.VS_M_Squa
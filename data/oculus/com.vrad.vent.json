t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORzAmDsK0PCkB_gP_G56BM-21_L5Y1b5D0CCpS_pC8ng&oe=6AC6468A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctSveL3DP80Q7kNvwE3bvWe&_nc_oc=AdqkrUQnY35BCBJkYjeL3gy8LLuF9vq_16gYkC2VSqWob9uym5XW90XGCu6FHau8oe0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCAkLsciAvN4z7H-uXraamVHudqN2Dfaf9Gd5Gj299Xg&oe=6AC658DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLzZlSp_v3YQ7kNvwGNTjS0&_nc_oc=AdrGShXB1BrC0X7I7mune9QuU3P_fNsSOv0DlsElp2RWStFATc0eBQfpfq_y401cVgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAYu2hQRJqjXEWF-wWyH7JIUuCC1RcDLJgjCANVXSw6Q&oe=6AC65BD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPEw5REIYaMQ7kNvwGiepFy&_nc_oc=AdqFSwy4HPLOvkxivQV8Sh0wiE4T49aJamxNpccWDGr5ZMVXGfbWs7MlyMt0844UWpE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtjOvos4tDCcbOQ6GRaGnBVAj05WpSVQ31Ztos6syH0w&oe=6AC648BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckoabrt_X74Q7kNvwHeA3Tc&_nc_oc=AdqgdU34E96aXQn8E-H-KSqMwEfIChgFUBcW6njELbsyFgv8MJcvgfS1_csfajfZVIQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsH4jRmP6tA9RF1OzhZ5MkvChEEc-13Ceo7DeyaXKOWg&oe=6AC649B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om6y7hhjsToQ7kNvwFnuQKh&_nc_oc=AdrWPY01uID_BzcasF5oLZ_jGpeS_lWIPd5TFt-ZHpM02LpmB_t-9Egemf-ABaMEUr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzUb0UPNM8zKD-nKOJeW6CJnizbhHDKE_KWKOFQZFrYQ&oe=6AC6704F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1qYVvesUMUQ7kNvwGE1VLH&_nc_oc=Adqq1jY9eeR0EXNwZ0IML1LLx-8vJuDGe3dTljjPj6NU7jodfLEVzr4XmV5bcPxXIaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSuTCM9-3_0vbq7icYs6tzQU5MQmESDi8oVV3dA0pgDQ&oe=6AC645EE"}, {"file_name": "005.VS_M_Squar
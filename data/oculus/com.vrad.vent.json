t-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6OE3G1AA4cxB3mBi1dX2e-DQSSjmvpPssq7qGKQSwIQ&oe=6A92DC0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl580H2ugcwQ7kNvwHk8MMA&_nc_oc=AdoPaFFnAEx5WznVp4Fx3X9S13Urlo3arTKVwDNt1r7g2Q8X_ZCcZp1A9tbryzk_NXE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElBYND06eF3dvnoRouRUqsESF1Qyg0a2DUsNH9ndDrTg&oe=6A92B61B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxErFZT7CdMQ7kNvwHAvu-V&_nc_oc=AdryIdLzIGCxF211hG_s19eKdx53nz0J3Be9efmWMomqdDaaSkHCD5cbhBq8mmSEWtk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBoAXFXgG-qlLWUe-xjYmH6sozoz8EgCb6-iCQPUBc0A&oe=6A92B910"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nfv13Aj5h5oQ7kNvwGqN13R&_nc_oc=AdoYoFaNknkn4P1uA8FKWvls84Z1tJaFYi0_zTpdGpPV1_ma3FfTMLfXPK0Oln1rQcM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG12niTGhhCseKRaZKYxcCwUzpTz1ldR-n5DHUpc1l10w&oe=6A92DE3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRmY5lMNce8Q7kNvwE3jWIl&_nc_oc=AdqDBZ3p5vor3kDhQlDtPXJ7sSByQ3sWL6LqZzjAoEFEkzwTf0WYSh7hIbSlcLy6x_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA2ZAv3TF-WuT8A_gYtyFaiOcCFn_TJNhUTisUwe2sGQ&oe=6A92DF39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJjt3VfF93YQ7kNvwEJG61a&_nc_oc=Adqp9rjMrQn-jeKpSfbhRrGvQW2oDkbWgdx_y61IFXk655N4fRWmGzUZOZ_Sa7tkcgc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZVmY-0B1YDefWlN3j9sIoxSH2dlN6ZdkkQTfwjkvE7w&oe=6A92CD8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnWcGRpN9CMQ7kNvwEpulN0&_nc_oc=AdqO-LgZxuMYGUTIPN2fCUzh43rqmP_raZ_6N_TWo8ZQyeQa1j0P41uA4FR__d8zAJQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHlr-Qviw0AdR_GZKcKRpnHzYN4mLArxe3h0WtLgQN1A&oe=6A92DB6E"}, {"file_name": "005.VS_M_Squar
t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZliL-sTyx0zDswh3hvDmaSTSxLX0WSQvmlsKZy-EffQ&oe=6AAFDD0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOOyePddgZQQ7kNvwFFtUZT&_nc_oc=AdpKFIz3qDdmfWDuss4LABsmHeCgIcE3AAUe1kKpfL2B9r5RXhSB4X0j9uBxgXEE4Oo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPJ6qRWrIDKfu6S6rdRTxJWYOlYSHWkTaFGRBIjHqRHw&oe=6AAFEF5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQ_dLjzVmwAQ7kNvwG9MAzI&_nc_oc=AdpEIsFLxaq_18E4D4_TYCVvgH3Br4n-bw4OQEegfoWIW2SW-kU-et2NPjR-AsLhJ9E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPO_1sh0ifVbFIZJk6d1i26Ifz0lHV5aoaU-7SCdSHpQ&oe=6AAFF250"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ua94kJe0iJYQ7kNvwGfecIo&_nc_oc=AdqH5RSV5KbyW7_Sczf80m8NGT9HoHzHk_OcKePT1HRZ0xwJAHjeYX3RG2faAMvKZLY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBKT4q2KT_lPZ7uel62Ijof3HxXESj0Jsl7QA8CRopbA&oe=6AAFDF3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx1FZYt1kQIQ7kNvwG2Wkor&_nc_oc=AdoXB7chsF1Zzv1EufS7OjszuZQR_nkrKAzBKcH32pDMYcZzAmVS8RdFUzOAQSBrBoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjqz_ZBMRVCJKoLjYeS25yGMBAXxgRlKNmpyg-08Tl_g&oe=6AAFE039"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6kC2HsyesMQ7kNvwHAPNYe&_nc_oc=Adp93sbdFK7SmkWcIhUeYqiSblFMXlueQRQ3Ve1OXzJQ91FQHSOJqgGaypG6CQJOdu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdQeDzRnblvup-EsTKme4bH2AWg7PjMxP4oUCDzZQzXQ&oe=6AB006CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3TDGSOQ1U0Q7kNvwHQVS9Q&_nc_oc=Adp-E-GNrr40Sm4h63LIScZCcxhhoat5LhV7Bbq8H7SDHmIS3AiGIl1HhajjA3RLaK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyr-AegpGvCj548FZFOjCabWWoG6jAfRjZHLUo1cbWrA&oe=6AAFDC6E"}, {"file_name": "005.VS_M_Squar
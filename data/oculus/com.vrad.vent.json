nt-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afywd16thYb71Xny6rrbkLZwc47HEzzTCDKzdxIkpjL1FA&oe=69C5320A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEtW3ZrzrRkQ7kNvwHH0wEz&_nc_oc=AdqGeCsbFR90DRVxki93-d2LvpuUtq1opRpMaHNUqN954DOFjK-uTLmLXdqfRoJ4sYA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCHfZE9daYoki36jJDFI0Cjwd7UPg0rIUD1AGGgg0qMA&oe=69C5445B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWDxOKaFgosQ7kNvwFdpsSB&_nc_oc=Adps3SMLfn-6P1usX30eDY8Za0QZeeAphDZbQyCOrjHCD1Ii6AtcmD5gNNZr--mU1BY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOopi6DWNtprriRth8vqVqJTCeikTIX5gnfkyGZ0qZ7w&oe=69C54750"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL00T4jZlWQQ7kNvwG6c3bO&_nc_oc=AdoJtW5tJzzayIug0wjLmweQJBa7HFBUOpwwyOt7muFvwSx4tMFg3W8sbKZ2nKxsjtE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBnNPir9_FAAhp9EYWiWlklfx6Bb4MiUwvf527-WW1Fw&oe=69C5343C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jgw2i505vIQ7kNvwGyeJVL&_nc_oc=Adq4zxTDA7mpq9gUCTvFNOb-V5utkkWPiwXjE1odFaKuUgnmlHx_IAhN9JE81JF5Bps&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw12cAxBL7JY3x8Yo38qLZcw5veQp450JH0_PG_dm2Ktw&oe=69C53539"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=magy4Afld44Q7kNvwGaRcTy&_nc_oc=Adp7Weg4gChNC9JVs0-zxA8aBwqIjMIJsRJuJOix28qjVPBeS5WalFpgnqsMqDWXTIk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEXQmrVF6DIZMPBP2cey3qSMSW4CqAL4M9AZOxkPGQQw&oe=69C5238F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4l75dgA_IkQ7kNvwE6z31m&_nc_oc=Adqk0QxS0q56nCiko5IXTaQ785thC2P_0LKZA8F0O10n6DSZoCLQSX6UBw-BXOj9CIE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1jiRSlFTn0MuzOl-cp8hfulJ5ckUGK__UljsCkF5ScA&oe=69C5316E"}, {"file_name": "005.VS_M_Squa
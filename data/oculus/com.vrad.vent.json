t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPSCpBnI7nej34lDFRB5mBB9c8KRjE9NURfJ3NpATiIw&oe=6AB7C60A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3wslHyqwBIQ7kNvwEbJwTs&_nc_oc=AdqSXgCrjf5xzOMMVY3NFO30zm-EA0i2zPuGWBOPd0zmGMj6mEZM05OKSR3yHruJCzc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMoTkpFr9_dBN82S1L-twxh1wF-jEPWNZHuq9j5j-3oA&oe=6AB7D85B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyKCoggzQ4AQ7kNvwEf7_MA&_nc_oc=Adrd3CA27yRrM1nYm5rOX7JNWrEECnkFZQKD1yiQgdo97Nug4arHbsPOau_LBtNT9pE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXLzEuS7PdO75tJ-iH71oRdySHxEScr_qBlhuqjAPvcg&oe=6AB7DB50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rnj2EjDbDyoQ7kNvwHJU8AX&_nc_oc=AdqwZFDv_p7gdbO1Ttie-JXlBFzC6TvPI0w7oiFfjL_zxH5FfyI6axad2FurTDrcUR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKodQGymLZ0qrDGeWOyia1DXFWWniyfXdX8pzPcIhvG5Q&oe=6AB7C83C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hSr71QnElYQ7kNvwH9Ar92&_nc_oc=AdoSHtsDaEn3qXeWOVzixXi9KiLpiW7y2qe0CS0jrALFrQpooLYmzyKh_5wQLxhkftI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW_dKgSgeqhojnhfVLHoaO9Uh7c1bd9oK9x-nuP6d0dA&oe=6AB7C939"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JglgrTkEtEgQ7kNvwHJFkrC&_nc_oc=Adq3ajOBKN5ek5VY1CSRZilR1j3Jl_pCcBbpidN2buIvye33n7OjSgEQP4bw8KgFMLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITD24rJH53R5--pheMzov5Yj2ZxJTzF1ndC80sYztyNg&oe=6AB7EFCF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZznQoo2BxIQ7kNvwFsmPpN&_nc_oc=Ado6QuQAkYpURGNw3Dno2INNwToUA6I6NR_J-kbTbTjPWDi6PpUb2gP9ECMnzkMLT-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUTQ3yqHpP3zaJE80vEvjGlGUOmTcbeHWcPL9TIMOAOQ&oe=6AB7C56E"}, {"file_name": "005.VS_M_Squar
nt-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QJmmv3ZLS9SwTWIhhWbgqzthk7aC9cil0X_05rEIMFw&oe=69F74B0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6IEIGKczaEQ7kNvwGBdRIQ&_nc_oc=Adr9zWepHwxrtwR9bhAvazEOO7133eO-n7jTm2p8U5DYBmvkxV1x_u6JONX8uKZUmw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3mkyNlmRIpvk54T_Ay1V5Y790J23UQ96qial6hezCpGA&oe=69F75D5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4a0cV8YVa8Q7kNvwHkeQt5&_nc_oc=AdpNJQQPad-k_42WZxcb3_X0eOYwpn9QdEUn20UjgrqxgnhtYTSHyIVxGyraBgBsqeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3kUtlCXk5ESCHdnDj8a2iW2kZ9EeCsLCpQ391Wz65-YA&oe=69F76050"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWAS--R4a8wQ7kNvwEC6NiF&_nc_oc=AdrIShEGYt0f7P7zZECtikT9V3Y6WvDTaFwySepaC9iTAWcuei6XIZdfbfZiO7qq9sQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0faFvDaTfmbTqdiLtBzivwaF1Efwk5wiV2u-I5npGLSw&oe=69F74D3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQSL-7IOrH0Q7kNvwEq7H2l&_nc_oc=Adp_Jvz-NTvEDSixbA16fI4VEzNlFxhJQkcxY6zz4DQ4osmpgCGVQ2IuFj6c4USY2nU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bT3PHEqc19g9f-p6Vbl7igigiz-pkcpddJe-yZUSNQw&oe=69F74E39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzrOs8ahqrQQ7kNvwEbbNVX&_nc_oc=AdroRm1yFZQXsFS4y6rz4Js-i1OTjfV1Z9OpKsvtpxhnUlT6gaNeI8kT6jvFUnRrzqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1e8yqM8srJ-ZyNGNPdp7EsFFjTcwG1j5gWlZULsBPaqw&oe=69F73C8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEyA_khlvpcQ7kNvwE4RpKS&_nc_oc=Adop9idKqMwFxoBUSvCSbn9BOYiD8peDmiPsJl1j8PjYkSoCvNYyrBK_rCWcIJQkCyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13Ffm3ikJXH3moB9xmJkSk4aoNEQkVV4QkLOfQQIO82Q&oe=69F74A6E"}, {"file_name": "005.VS_M_Squa
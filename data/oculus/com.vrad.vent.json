t-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrQyDoEWb6KlJfNFb_970CqwrYcPW4hJkzT0xCAPB4Vw&oe=6A81B88A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sth5dgMQG40Q7kNvwE77GfT&_nc_oc=AdqG07_98PQWtB1OELhjtkoskAFBbRUSRsBfW9p6F6GvHjO8pN2k2bkoChfWqtBLBfo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpvFnRu_OzlL6LG1uaKFL6jUlkClz6gC5p8q4El3Zx2w&oe=6A81929B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNCB5X-g88kQ7kNvwEaRqzo&_nc_oc=AdoAJQeTSMqPyr-CDttJnTdsha6xBo37cm5FUg1ybQW1YG_tR4yYMqmwtCc0eCRnlc4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs1Ukq0j0yP_wkj9veJv6iUaI-ORepDhZSyzbIDJzVuA&oe=6A819590"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77-OD15_1u8Q7kNvwEfJ8vD&_nc_oc=AdoHy0WVPnGF6GkyGglsgszi_4KPxj3L2slLFKydpqYhD4OZ1Wp60WUKbrElxJ2_NXc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0mLKzh6vIXVOao91Uota01-J5A4Xy8LgiulVDoAtcVg&oe=6A81BABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxqkRbEpgDQQ7kNvwFn6YKh&_nc_oc=AdrT32zr_4DijHtHJIqLj1vjGTx-9CigDvkjRtxjjxiGalTw0f44b1cKkqo7Q8gLgJ0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUQvoymlvP2ycD8T5IeD_kxeKpw3Dow1YHGHTLkdXo-Q&oe=6A81BBB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WHi_N__ns0Q7kNvwFCJbzJ&_nc_oc=AdoZaosKpJwCp4zCJytvdSFmHBtNqkrrXaiOedvoM4b2GKEaRDBl5VBf0LDHY7wx-C0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGILlkO1iGQtA2hpapZw2JdpjI4PKrOfp-4GCSrSPjk-w&oe=6A81AA0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge5isaunREgQ7kNvwE7tPr2&_nc_oc=AdpnfNfubP1181diYjLLxVotXlipMpibsQX1UhzKQlaw5wtKf5KF6RvOjiXvba5FrFY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoPAtNKCIU9G38b7AQyI_xdpydoVqv6hVguL8CaWOP6A&oe=6A81B7EE"}, {"file_name": "005.VS_M_Squar
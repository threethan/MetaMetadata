nt-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CSYsgqpZEJPuAXlPrNTVjRq6YI742oGSrPvbJBxkyNw&oe=69DCED0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_1NeqDDbwYQ7kNvwE77cRv&_nc_oc=Adr8sVekwTmfKQTuvkM-WK9JWwKjyGjKNoeb9ZBa_tp0uwM__8PuRiOfhe1DYC1BbG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Vi2RBFzkGaCznZGVeKb8myQ6hKWq4dDWfa4MNMA3P7g&oe=69DCFF5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bf4RkpJ0mA8Q7kNvwFdqCBc&_nc_oc=AdpbSt3KJ04pqyADOPtDzw7jtfGeEii1BNdZjloHsyusBRaZGbaSQ3X3KP1o46gP55A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W9N-qJGjgKiwrxlWxtYwWf681agcRyXniY44q8V0mIA&oe=69DD0250"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuverg75jvoQ7kNvwG0Krdq&_nc_oc=Adq4dUNfueBuqpfbeY-IAC1vq-pvDFyLfP7xwd_iILTJRR1kIgJGz7Eicgy6SHB-G_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s_y1cIZIkr4CKKntRWqQiFdAMaL0TvtHHzxG0M2jfxg&oe=69DCEF3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GD3qVZqEmWEQ7kNvwGY7JTA&_nc_oc=AdpsbostYWuuabJiHt-MvzEl4jb3VV-I-Dye8D4h_WNTNa6qRqxZQDlX1PWEyXy2i8s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hMjqtsxhtfVErJUpOYofiSFHZ5ZCJsEtUekOfVmVItg&oe=69DCF039"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xr0-uhpitGIQ7kNvwHVI3cQ&_nc_oc=AdoGUoXwlp1gzTVE6OFNi2yPHhqnDOlUGeSrEQ3SrSS-nMwW6Tk_f6-Fy0B4W19Mb9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PxbcA_r92dwhAuSTOwu3Zb9JgqMdr-YAlwzp9lgv1ng&oe=69DCDE8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EMGB-uXtWIQ7kNvwHv1WjZ&_nc_oc=AdrU5GGqgjLqOHZEebIFRxd42I9k-GWVlBaAMlyKCEg80kNSz8IhCMrBF9bgE2p3Hao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ta0Nwty890qrFRHflhpMHzqCT1eaj-1pHy6rkIjvmbQ&oe=69DCEC6E"}, {"file_name": "005.VS_M_Squa
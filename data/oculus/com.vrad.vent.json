t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZPQfMsSmlbGYtGHvlYtSZozysEArSpa-lWKfvrfGyJQ&oe=6A74898A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqUOxALKHiIQ7kNvwEjREpw&_nc_oc=AdqMFj6VhB90HczeWY8c42wg6UruY9JIhEhXNaC9OFwgUqXOqkq5uNzperL0jJByuq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5JKfBxmQn_3IiGexB80Dzcz7ZwgRglCXTswWWvjNyaw&oe=6A749BDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0buC1h362UQ7kNvwHxmcja&_nc_oc=AdovSHTvEIaUqGz4rCCTPdkNaW6Neqj0xXZRHJkJGcjWn0KgQxN-3kT11YLPUuxOo0Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2N0h8G9jag6UOhmZTZhUvl0_RXnh08yctd44MBPs6qQ&oe=6A749ED0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1i7refv-ygQ7kNvwGMA7me&_nc_oc=AdqmcvXDp8cJgQrkU3DSuIA3JaPTxfXWIJLEc8Zh5WT9w4mIvhZVtMbC9X4clfgiz_k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaYttSUE402F9HovNg-Peix83jylTm-vyDMb9gXMZYOA&oe=6A748BBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxXGLQWr8PMQ7kNvwHuQPlT&_nc_oc=AdosILoslmoL7q-cfhW3WUwwbx2z72KCizWauLDFqmIOW6pR4DnvIUkMHF9ecJrvKHg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF6SKo2jWxPTa_S4OrZBGZhcYP3wGQinu0sHHUK00Iyg&oe=6A748CB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AltwcZA6rZYQ7kNvwHzrB0h&_nc_oc=AdoFSih8UxUmzdCMSnvytN2nFPdssS55mI5rP8E8G-ZRQB8UZ4HEBBJZrfZb8YAVNqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0kDOM8YX-yfLDsyE4pBqmT-Qx-YpqXrZq3sd8ocvNCQ&oe=6A747B0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GPC5lCpSUoQ7kNvwG-usYc&_nc_oc=AdqXKlUZWEuuGr_AKuuuverWiUsuXtvKnwO6BShq1ZMsEOSu6jiogXLEj8TlW1nE7qA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBXOlkeCBzQ2o7pIv6b3niRB9JIDHoUTTTI9wtGN5-PQ&oe=6A7488EE"}, {"file_name": "005.VS_M_Squar
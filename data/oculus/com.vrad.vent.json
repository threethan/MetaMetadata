nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uu4f402iUz4VGAzjhv6QryMiJMLZgzZkzTd73L1pRYg&oe=6A071D0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA6ubC4q_7QQ7kNvwHsfN6U&_nc_oc=AdrtNwOoTvHWhjxPCNUXfeDjG5NUAmLtYULUmCdvKLfocQOc4vUYNOxSQTiJeSS7KxY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Seyazb9N0pEwTLEcxXgfyFKf0tDce84aFej29sBky1Q&oe=6A072F5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRs16yCmIwwQ7kNvwEj-gF6&_nc_oc=AdqsMZNxFfw4xAS6xhTJyLvshs2HCmOLxz5DJ9nnwE7mfrqO_2EXai1AAAcQ8HVKOW0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OhmTxNazAsonEWq7EYUd93qdN3qhTXwSsFBWmF8ERug&oe=6A073250"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB9ERbYsdH0Q7kNvwHphBGj&_nc_oc=Adp8Nc7zQyAvfeIVHHGMjJwJdUiF84PTBIWVp4fIuv5PHVWbFeBujsHzCVC3hWXaxew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qCtG3gAVg07Yqj4xtu7gLUHsCe36h1Yj-Wzqz-lhgmQ&oe=6A071F3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUwjR54x6XYQ7kNvwFxfDko&_nc_oc=AdoggEAodRWe-Re-CoLrVGFsX3MIejre61DFF1GOmX-2klo4PhXjYV8RuN1LANljIMs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NtTYe8D6dmKI9OiPz0FID7E3rIqR1aFzeGRzueb9zqA&oe=6A072039"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MX7tO6CTiFwQ7kNvwHp-kxp&_nc_oc=AdoyW-E_T-eU-Vq7dGlnWpTsoWC4WbfNRJjpNAlY8AEvxr_DtMTuzPI1dEb-ecEgDAE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52CtGk_V8hsaI3PIodK5s8qdw4K8NG7yV0fhoIq7sYlQ&oe=6A070E8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xWMaA7dJMAQ7kNvwEK7MQV&_nc_oc=AdrfssWX_UP1d9UkxrccZyTTXwqZYF3egPOxL13296tovO-UDpnRbYvq4lVpVGL3uTI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QBQeFREBC622Dtts-CWJru8UMlP5S4IJf9gizmpbkkA&oe=6A071C6E"}, {"file_name": "005.VS_M_Squa
nt-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_8Xc2JcTO6itjLOeX9fASF426-hTascFznNLZPv1J3Q&oe=69ECBF0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKIe-pBwqG8Q7kNvwEp99F6&_nc_oc=AdpbUEhXdbYRiTLx4omJTzCs42Quxz7umehi9pWD3rINf0iQG9fjYtE3u3mRpSYOV1M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mUK_T9GW8RZlHyQsOf5elFNDjP4WIxYuO42orx0QvEA&oe=69ECD15B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey66BJy1YJ4Q7kNvwE7F04g&_nc_oc=Adqh6uWGF9NQVQXCZ_g1JFQOALpFBCEx0PmbR_hl4tQkz2P4aC6lsFveQHoz-AuvwL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Xxewa2EdgFqfy73za2-vk5Ckaz1SumfN7tog4JId2Jg&oe=69ECD450"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxYAxqKA0JkQ7kNvwFmsYN1&_nc_oc=AdoFQ7sRsCZdnlhjiKxcDp_trICX4s4lxDYRy-EYt3zfxUVup_n03WLKvtaivBw6RdE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mX79OaIlq3t68DInWJfvWp8008RjowiTt00jqfC91HQ&oe=69ECC13C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_wv9jdW_HsQ7kNvwE9GNsO&_nc_oc=Ado1nIQ2HONgGzMSRVcuSpON3WZ_MbMbGzQzNw9xdh_1I7OLZAwR-5ebfS5OXc7xOgM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3v2ZJRp5NK85otQZL3lGtRjHPlvMnhRELb4d9GaWVLSA&oe=69ECC239"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kMJ7D3OsJMQ7kNvwFHNJgT&_nc_oc=Adp43Ol5e6qF791Ez_w8JSxDx4E2F8drxTOkM9hmAgIkIcSsxePJPylERBejtxbQOYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Rt0_aDHf91UXxkPeUlD6ZF7vCnxm-YSJn1lwMMDbL3A&oe=69ECB08F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8D8H4_ncFcQ7kNvwFcOFb2&_nc_oc=AdruXuhXAOL8CnTQKiSkHNHKgijG7RYWZWiqgNptsmyB60jmCnGEum2kgoiJajCVvX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17xySK4aeu8lrRg2r2CRnZJNZro4c8Bb5P4zjsmdrXEg&oe=69ECBE6E"}, {"file_name": "005.VS_M_Squa
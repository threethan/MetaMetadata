nt-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TpV80S8fxyxx13zRj4CZ5BEBmu2wPNqEPec4_GOfu4Q&oe=69EB6D8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKIe-pBwqG8Q7kNvwHYY9rD&_nc_oc=AdoZNnYRAP1GsWCyQFYWNhXphboTi00-aSP7Rs3wAFyHDWqInEyf28LOx6HfDPHBb2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0L2f_nhQaS2KKY8bS2MqYCnsDj5VnIjLuM-Q-ramo3wA&oe=69EB7FDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey66BJy1YJ4Q7kNvwHSssmj&_nc_oc=Adq2yj69d5apkX5DE8MkvUsGCIIoC1XnB0LsQ9p9OSIKvYMcGSRWg5VeJFb4KFd5vQI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hSE_KRYV8TZy2b1QZagbyaJLE3vmTHWb2SH89ryAzFA&oe=69EB82D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxYAxqKA0JkQ7kNvwGNjCen&_nc_oc=AdrGMtIeDkhVH0P8JP09F9rFK0PpYKKm5-cf3FMifmdQ5ne-F4YXbPqYjiC23LZBxwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oIpkDijKZL82mCtwytYkDI0qWuDNDj0STYyWt5h98Ag&oe=69EB6FBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_wv9jdW_HsQ7kNvwHeAcNX&_nc_oc=AdqjTgfbBF1Smy562HmS6c_WY3XuRsPYzJ-xJD4I0hClRb1zQqCdfJB0WGmlmE6CdI8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g9ukQJz9adtBBM7CqiX3eZCt3RNI6fXlFNkQpjCd-dA&oe=69EB70B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kMJ7D3OsJMQ7kNvwFpJQQq&_nc_oc=AdpdNPztsYI4E7RevIgiMKCaS7Qvs8wa-mWfU11cV8E8rqNICqfGUEjNa19FRRHVsGg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sdQDcZEyC5uP7kIigA6DcUnD0kUwapelSg-hYyl2lkQ&oe=69EB5F0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8D8H4_ncFcQ7kNvwHveO_n&_nc_oc=AdqaSF7A4haf6sOihAL6E7tZJldff_cuOPATYxxJdFx3-oNylaufhhXUCCTBqvTpU90&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21Igye90Kssa-N1uywDEOEWrQVleO5D3g4pE3kvNoQNw&oe=69EB6CEE"}, {"file_name": "005.VS_M_Squa
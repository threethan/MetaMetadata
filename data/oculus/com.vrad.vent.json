t=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80_QtLkJ_ZZdEy8eY5hPtaPEBjrjtK328V2ybqkX54Qg&oe=6A36930A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEKG8NPclEAQ7kNvwHH3kA6&_nc_oc=AdovDC5lwYgSas78TnghpmLd_LkfoSBM9DCwGSwJaYT2w4f0eq9JA6prYBGRmASjqyo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vD8T0aE0Th0fu5ooIqS_7dAc_DZLsYR-qzfsu4lbSVQ&oe=6A36A55B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g6KVVB4P-UQ7kNvwFsYdTn&_nc_oc=AdpegmAZwOuPQMu_DAFkFtiVsqOvOajs6Txcp0SXS6Ggx6NlL4Dhqcr8JManaeMh1A8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qCZrEG7fgaEV2J7N5lABGxBFoXz-6kPtdpn7FI6Qz6A&oe=6A36A850"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fb64Qt8aHV8Q7kNvwGCgOjK&_nc_oc=AdrhjTA_bdT1fKaA-WU9aTHzY9n41aLkn0iR175Ah8Mv5pyXB6VprpJr0esBld5BE3k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9atZ5kA7K2n8zxKcrwlqHWiUeA2tvmfKdzkBKpI2KHiA&oe=6A36953C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5uvuewv1OkQ7kNvwH0V4zR&_nc_oc=AdrFjqY-MhUW-VPHZsDF2gZxG0KZkECQLkr5QLg-vNgaucNV2DAD3xRQsDjjyEhxVCw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GOj-p6tWlAzjwrrnEI4DgAc2CmSCuR1rjbwEJeoatXQ&oe=6A369639"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHUTwpzpPakQ7kNvwE3y1vr&_nc_oc=Adqwn15NZl6CVuxZS9903QbaFOLGhXBNhsJQjgbYsTu5neKhAQEbYVvPCQpuEoCRtvc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QZOGL8-spfTSfyoGY4NyY9tNd2F1Zol9a_QngEOoyKA&oe=6A36BCCF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-01BEV2VQUQ7kNvwEMDHni&_nc_oc=Adqyst7VJ6Z7LD-PFRLB7GxKR6Yt0-SrzU0uijrg8B86vOZa0RbkMCZVkTsLgf5PgFc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YKkV-SVcxU_mZVlpmhbHE34QS5hoo9vONT2Uo90Bteg&oe=6A36926E"}, {"file_name": "
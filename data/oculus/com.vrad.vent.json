nt-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy03xGYhXES9oqkH0u4C1YPcDXAwW8UVScDUbX_SSxihA&oe=69C3E08A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEtW3ZrzrRkQ7kNvwGTjBXm&_nc_oc=AdrHzIXUNxblkktnHqQM_F9NhSXheCV0K9LlJ6A1_TCTBmtyzOUCrVNQnKi5_gavNbg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxivkm5xMeJLfoZJbYn37AZlTf-O4Lh07J7RoOjZ6CmWQ&oe=69C3BA9B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWDxOKaFgosQ7kNvwGhxBk_&_nc_oc=AdpT0tcF6pAX858etZS0oSDk5qLRgwvA226GsRe_mTczXmIRYU9Ui6PppkP1h8GocVI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwjl5PTwXXGvf6-qqZvyzU930x9QSnBKlKCKXb1rw97RQ&oe=69C3BD90"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL00T4jZlWQQ7kNvwEtSl-W&_nc_oc=Adr82pbqt_8aB9Sdn46cz5nfDkpCxRU6j-v7q3rQzu4HqbHAj_rD4AhCnrV0ODUfjig&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQIij67_qDy5aUA1_g_GI8utENs2-RDYn5zqc8Xd06fA&oe=69C3E2BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jgw2i505vIQ7kNvwFcWHob&_nc_oc=AdoWF_dCjief7wesBOVCte5DvvJAoNWr5MQ1QGQ5fFmHBoJYLz9BaKQXa3FYeMMeyoA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBP3c6XLD9gXbZ93WQa9Hxq4cBCSS576Nr0KjAa8B50w&oe=69C3E3B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=magy4Afld44Q7kNvwGfBwXo&_nc_oc=Adr9GMgvzZE6_GcVKmeLz332rucowM-iMKRxOjdn5MYIF0ucL794Zl3mIXfbUJGjt7Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNr2OI4oNybludTDhM6DkZsNOaKTsmGjIOh7gTixEoJg&oe=69C3D20F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4l75dgA_IkQ7kNvwFN49fs&_nc_oc=Adp2OSxUpFuBmlV1_Cv2DV_olmiiBgri84qgJ8imUdVyvfZqOqpljhT9PJbiABXs4X8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDrPSF_5peDlU5gmXlteN_IpDeM1_R27MKZwaJHU6j5w&oe=69C3DFEE"}, {"file_name": "005.VS_M_Squa
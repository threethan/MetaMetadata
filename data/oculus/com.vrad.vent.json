t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3v8rtijx5zoSISodcWZQgvIYd_dUDN_jvjSEaM9XbXw&oe=6A60C30A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HruYWZn_AegQ7kNvwG4otFa&_nc_oc=AdrVcLLH1JDx5fwp6lfO6-WbSmvEzTMpJO5oZAMGrrFt2MJGVKX4dsMrMaIomwOlIwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkh5EAPU_rLotXYsTuOa0X-dAKU_S0H0iWWxQ53Uhr2g&oe=6A60D55B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKVWi-HEE1QQ7kNvwEaj0yS&_nc_oc=AdrptRZYoLCPJBySNWc6fS1vha6Xp08cMFmVxgdSpdbpMMJbBDjRLhi0X8vO7VmhxfI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCq9BZUFnQq71gOC9eDqbKbeec8YEiEttQj1HUgNipRCw&oe=6A60D850"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YizzIvN1j_0Q7kNvwG2fLlY&_nc_oc=AdprV5bZUfpMmuX3pvYtpY4VVBN2yK9wU94KNZ7Yw542m55k3pQtwIksCnfiW1ePCAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2UqwKS9rUCUSFfwrQLRihVILcEUxdM5Ro_FxrRjJo2g&oe=6A60C53C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zTYqtCSkOkQ7kNvwF2HtiI&_nc_oc=AdrClVnVN2T5j7d1tupdrsJmGWwqEr-EtyQ-PKfw56KuzfjIG9NR7_9DOa9-IA5Mjew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRGWSG5jFxVJDSycPTILbNL3krfp1BwvYiiuYWOLbMAA&oe=6A60C639"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hLKCUmqHXYQ7kNvwH2lOE5&_nc_oc=AdpjbrqZkr5AQaIFlWochzOq2LoN-zO21W34tWjGkcbXvNpPgYKbsML-jQcTUZ-7AAE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYQ4hEmhS4j78lLeMdDGYPPx-hl1bKz0Yflo-mGpp6tw&oe=6A60B48F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zeGhyRsEBkQ7kNvwHsWFtB&_nc_oc=Adr9PqxF2fnNzlkPfDNd1T0EILR4TEl7-eEu_HtVH8pGDfIxEc1F6Inv_NfhqxTyuVY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ1v2NA7EKH5kPs0gWMvtFH7PzrOuEwgGcepkWOsPAew&oe=6A60C26E"}, {"file_name": "005.VS_M_Squar
om/v/t64.5771-25/473398297_978657034226177_6887405616059201056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRtSfBpo2TcQ7kNvwFR-jYR&_nc_oc=AdqWGFbpJ1JWfl2-pRCcqdrpPi64yuTOwej_Ht_NsivvMj8nD8mo3CerZsYs_Enwx50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUFqN56SfMqa_VDiZ-6oGwsOkwEAJGmSLzw4TZO-hUOZg&oe=6B1052CA"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7IiUTjksE0Q7kNvwGNuZQe&_nc_oc=AdrANAj9H5b0Zhnz-uSJpvoafbec2YwenVnuQCraLXrpV_s7JlNKF0icZ7GPQj-fSRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXqbal07JbEK5Zsk7xa8tHZA1VBn2OzIchHc1H17kCcug&oe=6B10651B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_d6AiHY3fAQ7kNvwHEym66&_nc_oc=AdpUXyq79Komd3ioUhv6wxeitldwIv22ci0n7ddalI0k9Rd8CyLVlPD4kZ0VsPr4kWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUyRse0JseqZ0nbEdNdi09hpZ_SjX6LeeUY5flwKGzG0w&oe=6B106810"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-r0foaDExp0Q7kNvwG8dUgm&_nc_oc=AdoEFE6Cb5X2J7xPabcXNTGxlFJ3v5DUcGthyFn0CtnymWevqRkTF8qyLqQ1OZy0PRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdoZq0VUnj7A6EkxZwiO3mjypxQL3EKXDyT8ftTLFN0g&oe=6B1054FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEHBlxQPbKwQ7kNvwHY3oaO&_nc_oc=AdoJk6hMv8pHjvwBOwSeP1qHzwCTZcpxTA-wWf0eC3ECD2FysOZU2ycp6hEGVRlwvfg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVsQK6RBM9CBiDHIcmmI6WWoNaOPnQ4zuRYwjYGihLjlQ&oe=6B1055F9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3KexfinWfAQ7kNvwEt_hlv&_nc_oc=Adqv9PqN30_Eem8oVNGQrlTSsFyjgTqc_eOJXPseptjKsaavhZwz7dRBaHmknSYJ6xU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZ4ydufenA74jjJw3RkeRsEO9DSPdDSBys6RdlK7AGcQ&oe=6B10444F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scont
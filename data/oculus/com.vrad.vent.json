nt-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3B4IeT3gAuVBbsJ462s_icu5VfKe5_PRMvMqyPv3Ie0Q&oe=69D8F88A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnzWL-xWQrIQ7kNvwEubvon&_nc_oc=AdpVaFJTnkwSoH8t_fZSalHyRnva7ko7UGOkedDIiKLV5KoHbxXayZfxJUbTXDLCZ2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14p8UxHYZuSOL1na4-OMg060412NprshWAIg-AAX1ufA&oe=69D90ADB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEZfw3-ihSkQ7kNvwE1jdyb&_nc_oc=Adr1idTJssZKQDbMB1yOCPUYRwoWW9Hoj_B7pw9oqZScD7ni1gnws4viPwwVwq5wgoQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ebbiRhBvNXPURWybwwnanPSv0ngdo--b2U1faNiwRUg&oe=69D90DD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GeFJ43zm_gQ7kNvwFZUxHu&_nc_oc=AdoOE1N5gMMdC3QpSlmH71-JaGYTO4fgm6bIzjrZV_bBVywTHj3PnrBKPHs_byJ2tM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EPuitsvJ19HXhSWaBQuoVmrIGBEHFXQdE5WQiWJUV-g&oe=69D8FABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ofkddorg1O8Q7kNvwFX3D6R&_nc_oc=Adr5QZxRaQG6ZJxjbfj9xd03APvRJPNM-pjPYLGafWRdCbJcMmG4u5hhoVoONOjD2JM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uPDLyypsiJj2lO7QjF3YWnohQ3ns9Q3OZeEvDBd_wIg&oe=69D8FBB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKwPrefWOtsQ7kNvwFQ_Z9l&_nc_oc=AdqTv_BagJ1JvIJljPLsEeXbxLCGwVBow_KG1XABaYhwIeyX-Dx4I1H9ZI81UvCKVq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jw2_pn3C3Fli5RUgwFRDuWgmbZj1eRVvYWDMMLyKZyA&oe=69D8EA0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwlGWzeIDlAQ7kNvwH0P75J&_nc_oc=AdoxFwsTfEPrWluCOG-Q_BVYa8dIVIezSIEgXm0HN4ANqRIPHROOTqHhrbxMlmHhVMg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OgW1KG8hLLMUzVw3KNpLMxpgj3Huur3JZ6Tyh23NhlA&oe=69D8F7EE"}, {"file_name": "005.VS_M_Squa
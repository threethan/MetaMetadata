t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnML4-Imkrj_fT9M4gnsOm-cjakfSVpnepDEzemp5vpQ&oe=6A70950A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wi7zRb3ll8Q7kNvwFZuJnl&_nc_oc=AdrsF16pefvP6KekVDjurOrFbbwVoV8010wMqXfqVoOEVttRUabutN5VrXsigwxE84c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSFHrY2TdXQU95Iyu3clEcwewFsPBkbXMjqys5DEvQLQ&oe=6A70A75B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDIJResSdjAQ7kNvwHan7qP&_nc_oc=AdphFmFGo1zgXFw1ZJz2yxGQmiMmw_j0c7z_SoM5mEDtG9mfp7gqBGue4fjK6zFsmCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFH4WcCH5G2rwh9j8FjPQKEm6PeEZ0bujWT_sG4JwIhWg&oe=6A70AA50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnwkLRMC2dcQ7kNvwFJ3PDC&_nc_oc=Adr9AuT-NdLJHXU8X9aYRvcRXL8E6YVi6nTjTGw6pufH9m8x0oVyo2JuaFkzazdXSjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk3-gCqf2Fbv7QxudDyPRse9Ru3oN56Xj1L9mQ8QS9OQ&oe=6A70973C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bgr1UT6hgWUQ7kNvwHAuysM&_nc_oc=AdruQh2pARofhy7PyCEKPqgJh4FPAFZhUyVIYpa8qJnKhEojY-irCjZFvLvu7KgMfEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfwVc4vHGTeUhzWM6T7Qzjf6gnCjGvkbv7GaTPhdfLww&oe=6A709839"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJH6E-hgwhYQ7kNvwFBV3Be&_nc_oc=AdrR5X9D8Fd7w3UEpeSng3lDJApzrQnAJlrLI9BRIWZMmkuP9Z7l-h89ZzfGRF1HfM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlF94mVIw1yYsSz2fUByu7RH9NZ8VgAhocQgpu9EVsew&oe=6A70868F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvS6VoIoyHUQ7kNvwGBZUqE&_nc_oc=AdrShECR1L3uJqedhBRus3DmUEINtuUDd-YC7pIQEc1W-X666vaRXq3JOhrw4P4v0qE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcEV7rPYX0hqXr65LNh9qGnXZYQw4iv3qHIK7jYzJeEw&oe=6A70946E"}, {"file_name": "005.VS_M_Squar
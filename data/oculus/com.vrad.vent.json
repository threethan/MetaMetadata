nt-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkWc7NZ2J_MAMeC_YLHfsiBOtaJW7aIU2zltNHYPRFdA&oe=69CD1B0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkFsmKbrK88Q7kNvwHgAnFh&_nc_oc=AdpJ9gvfFokv-8IQ0FGZ3QtlUv7qr3dxO7r8GyHiHQ5SQxBHttZqpsEgH2ZzZggI2_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyO_cS-GUxKxrhMgklzhBBoWpMjpmGCI3ssLIC8BuXIqg&oe=69CD2D5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90UpE6QjEMYQ7kNvwEgKZpY&_nc_oc=Adocsv3v_gWWdOnj2nCJs5Vv6a0vgQSyrSsZgbR7Wt8WqqDSO0oOdPaVpijTA1wIJS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5tX4EHOKEbRQP-Am7_Hj6-pmr6fEBbMvftEWmc_3Wlw&oe=69CCF810"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n48HfboXMRsQ7kNvwGV2A5s&_nc_oc=AdpxMAaX4wOQx7riwmIq5wsGMoOX2MBIEyBYvwU3WveG3XUXc3cqmWACslnmENuvhb8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzeCpzBrH2eUKWsjvGFWiWgJD5IFIHDnd60QZ_NXfjSWA&oe=69CD1D3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9NyX6NbhUoQ7kNvwHtGqbg&_nc_oc=AdqdLAxAeEwRAyeeCfzsI9eqq1T-16atWVOsxH6tecDwO7s1JHypuLxZDu1HmwpWsF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyq55TdC4eFUVfiSjhtREasWkZKqKqAbbEIOVUknd5KZA&oe=69CD1E39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zWA0cJdpU8Q7kNvwF1blEz&_nc_oc=Adp2GZGWtNETLS58c8eH4eyvEnICkBwqj5E-qH4fhN_iTLbLQdl8lhhTdZgUzrMxURM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZdUY0GEB3_iXr0tjwRantFoXaHmAhS92j7Nk4W9UymA&oe=69CD0C8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVGwYRmwkb4Q7kNvwEBBQes&_nc_oc=AdryTdP-rCdP3eqW3LzDqtWhagrxWuPQP5xXyfuWNmWtW0G-eZpyrpO7VHZKyE4XksM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpMK531RPsj25w2HHgKVUJBLo3aHDrJOfHzDxRsglaFQ&oe=69CD1A6E"}, {"file_name": "005.VS_M_Squa
nt-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2gcToiNLPzBxdiVoaKpDUQLA-lUwfygOsZJHCPf4JGg&oe=69CFBE0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeFI3rleD9QQ7kNvwFHXIcv&_nc_oc=AdqMeDxPFLd5AgRsiRp5vC0qjkRwe5RtcvBYq08rKwGPlD__GDfDDe_03FfAD76cjgQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUWDa9Qi3UKv1-qi5zFmxT-B_-6VBSUxM_E0AeoLBVlQ&oe=69CFD05B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AGsrgJGFZ4Q7kNvwHwBe6X&_nc_oc=AdqHrMqtSpzBkq6Twwn0qRNdgZNukdjiSdfkaearQW7Q0h9UVyUGPv1wrZ65cNOWjIo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpzlLgjq0BAlCyx7eYe4KinDmSmsPKWxRAsJVtH3Vk1Q&oe=69CFD350"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxkM1js7jAkQ7kNvwF9hUMp&_nc_oc=AdpiRpo-byYD75p7bNARxiwcmVs-HxiVGNcRxESfO5uT7i5JaRvBUsC6uD-Be_Nvcn8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxaxo0CTtMvHg6dkiIvo0nXVlHCj2CWMYgMAl1_lA5wIA&oe=69CFC03C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM-dDHHdHNQQ7kNvwGqsBf0&_nc_oc=Ado0Ab3qvb2FqfLq0UpgeaZXU1jL4RjljcFJ2jdhGfw0avvbSWaTtDnlenje3DApYfU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCJCIRc6nD55eozcdPhfl15ahul_qCd1JvQxsmsQ4UEA&oe=69CFC139"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uHJeYn3b28Q7kNvwF7FQ08&_nc_oc=AdoTEGKq_JpfvEbmW8vRzYx3cl52txhG90BQOADYCLiYHYu6VdDnaw-j-uPTjk12P24&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9we7M7uzr_qBSCPbpsFzgBcZg7_oDsMYLREzM6uZWmw&oe=69CFAF8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_3e4xfRFFEQ7kNvwGE0RcX&_nc_oc=AdpfyU7bHoAm2djXGE333qKfvVj5ATafxWLshbGZQydPlbQAFtYKOe0zzODboGVh8Ks&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPA77_J45b2qN_WOsSbIYu3LYtF-2MsAJUrcOdV01NEw&oe=69CFBD6E"}, {"file_name": "005.VS_M_Squa
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2JX4W3ezvsc6EWaBbx7VE_w9r1pmUwXxAWXmHgBrC3w&oe=6AD25C4A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGW-eKffZFwQ7kNvwFPOf2w&_nc_oc=AdpCI2a5WbRkTIaXLP2ZyfD44EaVqJy1eV4GfWVbGblmPtWxu4015a_RwGVPxBg4Fz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjwTaeTt1EbdqOaFSHIQUMtfgDKCNeg5AHMgtqytx1ZA&oe=6AD2365B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf36w7j0W48Q7kNvwH1iwq4&_nc_oc=Adp9obFatxNvWGClEQeX7AnX5tJgKHBLLoPc3h1yceQNdhGsNedUl2dgu3XBPmx20Kg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYdMJr4eIhsUXe6iCUwza-YF_RxIPvsiU4yWX6Og_wtg&oe=6AD23950"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8uu8eIEqaIQ7kNvwFHLo0S&_nc_oc=Adrl2kWWWXD_Ga3FVLFvxf4lB-AdUXNL6Nj5zxU9YH5zABkHItNMW8Z-diO-qG7FFHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZD05JWV6Q2a2_VNnnVuRyVv1cQuEIM-256GB9pGwIwQ&oe=6AD2263C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1d1CkycmY0Q7kNvwGZJETi&_nc_oc=Adow_Vg413qgZVbP8VBlNDIWc0nMdqvYJrYFdcoTP7oDV40EOMwmOL1pWDZesv8H4tc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaLsUYA5jJ0JTSFGxKW6vjIL_25bjwMHZnPMZ8A2TgxA&oe=6AD22739"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh-mvoI2KVkQ7kNvwE_tn2j&_nc_oc=AdpZCfeeBGYvYDvglQq6FWhH9VKS9VP2HCxi3m7nBp4iuV1Vhuigx9JsVp0Fz77YyTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGpRtmMx05Ml10KuEmAC_HYDXGj7LPzHrK_KKRxS7USg&oe=6AD24DCF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwDnktBHoxYQ7kNvwHU_-F3&_nc_oc=Adr1Iz0RsjaGIFyFhxC7n6-LANH2ccUOFvQZNKs8Y9lED0bM7lfEJoEuGz6jzW-PznM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmZtwhjj-Ygp2EDIC9aIomJ2PPVTRmnAkykEbXMn-ZsA&oe=6AD25BAE"}, {"file_name": "005.VS_M_Squar
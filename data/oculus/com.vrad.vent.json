t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtHd6V4APl_0nYiMSHhk_DTaVsf7ICHCKVVTCD_whk0Q&oe=6A79CF8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fUwYajL7rYQ7kNvwEvqmtG&_nc_oc=AdqCt7S8liEyX5jNqxA8OKxIVewGEc2yxO63KY7hyf3V_8Z76NNY-oCOg611gw8HbC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4xlXGAcqeS9iKFRzDsNMhmGvM1C8h13YRzckGTifN-A&oe=6A79E1DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UxxRkJNZKQQ7kNvwHQCCs0&_nc_oc=AdofCr8sWaNhon7EMRCxX-7cjjYQySoGo3jqBrBp9XSP9xxsQIf9qhdX4jGRaRGU6eE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUniGns1Xsc2SbfALe79GC3oVCgpWbZnlCHJMkeLSnfw&oe=6A79E4D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvnfyUA7bKEQ7kNvwEG2fdm&_nc_oc=AdokGF1m1EAXgWAyl8MPrOmIFdcfOXmGJZtcPmv_MZc_ic6OYN0QZEcWWhNPVnSro_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIFkpoAgvNWJUxYIFLfjgceaIg8YbcB3TE35BzFahLOg&oe=6A79D1BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-BkDUZ_w-wQ7kNvwHfSBCU&_nc_oc=AdoGqYw6Ts_DgKGaRr3BgYFiwPsuqFgAvSAUPKyO2ej9Vlnx9X8XdL-6v85X4UqJcJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX7t1T-CiC1GjWmdGa4PSoq3YRCQetJGjyk7gJcqNOWQ&oe=6A79D2B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jzy8l1szfx8Q7kNvwF1dTND&_nc_oc=AdqOo0yZKvzD5jbT92gR_ufvSvaqkUBRuyzoKyy_ExsN7PXeZB8mucBcQpO8zbrOuEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVjPTK5i8OJ6aAmRZ_dWmZPOvI3iDjQkiF554F3n7W_Q&oe=6A79C10F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xT3yIHZFPggQ7kNvwFYoZpa&_nc_oc=AdqzkLmxrRqeiX23CvVsPFGuy6hwYBPT4CS3MXGjbVOW4uv6ASMPQEjOz154p5119SE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXkYISHdb0FK7cF_eT0VGgcdOp3s9-SRoBBSLoCLfGEw&oe=6A79CEEE"}, {"file_name": "005.VS_M_Squar
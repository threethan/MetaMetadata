nt-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GrV7mZDOTEz87dFHV2xJrkrDp3sfLmurui1tNGFBM9A&oe=6A16EF0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zUmP8AEiBoQ7kNvwFOOg7p&_nc_oc=AdrhKqPibyg5fSKmaL6MmPK2oS0Miuc9lZawnBOipP4eQFeCgyYdZqnJ4d2mcrYMzs8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wpLYE4CslXVzSb67vzTiXuIw5c1pMcjGDAK0O_1YsTg&oe=6A17015B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxYo_TUzSWgQ7kNvwG_AeIG&_nc_oc=AdrVbvCvJ9n7A_-4M9vxfaiVi_N0ubMSzRvLn7jxF3HWdnQBrbp3gvnZL70XAT2vUG0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dM2SYtFeiAevuCheVrhUevZM54Vey7ySxmS8Li8T1Cg&oe=6A170450"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcFJEABs9osQ7kNvwFUWAXY&_nc_oc=Adrjm9MYmqiLMFNCE3LMkhQzxKzcxX1CeGuigTyM3DcfQD7Y0YEfRgQQXbkE2AyYFZw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47R_Ih7wPK_ScLupIcyGAHYMjYRdJ1YZFwv1nwFXTYLg&oe=6A16F13C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tszw6TIc1HcQ7kNvwFGcrNm&_nc_oc=AdpYBMIWC_u0XapCA5QVd7tJFzQqzqb30ZRnGXLnH3OpRPhA1Oae1ksWhOW7oFkxmss&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63SKw8Eld0n-9hPS2dlSz5dVZwTbFZeSzpHRitwBZfkA&oe=6A16F239"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1lcFZ4Jb_QQ7kNvwH6Vtvb&_nc_oc=Adr6v3U9Eso_vMC1CltZHqO8eLxhxrdj8LyPHYaAkAkVg2QGWM5xRI6exr0o1aIo4iI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52DpFpOdlRXXGu1MHPZR7xIy2aThoZIzCHzPKOeOT4SQ&oe=6A16E08F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDBlczSeDdAQ7kNvwFPg8qJ&_nc_oc=AdpEbjOx-XN3nSwUcL00SrE8fEAnNiDmzttPammbjOsA7UBugcSuNT2AII_qQAQmgKA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SVhpMVIQxaC1QA6jZen7L54FbpKHmi-OL2gx_r8uObw&oe=6A16EE6E"}, {"file_name": "005.VS_M_Squa
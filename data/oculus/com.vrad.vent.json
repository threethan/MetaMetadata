om/v/t64.5771-25/473398297_978657034226177_6887405616059201056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj0AnCbCsFoQ7kNvwEnA2Lv&_nc_oc=AdpUaXueY5Wp2evAd30jHWvlUzBUSKJgodKqyJtvxyNJQP3EAGN1dHx74GCZos_3jL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgrDqk8a2epzS330eCjcZl2Z4VRG3LRMtzumfl1dhZWw&oe=6B07184A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rghXaO4Ob7EQ7kNvwE2rGFT&_nc_oc=AdpHp1ZP7nUdYP1qm_Q-pC8C5rxH7qoP43YQtIR2klZNY3gXoa8D_Xb_acS3WxeCL_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR08oV01KXZpm4GsB3kKnOqapiarxqlYs9ymJb0VjM4kg&oe=6B06F25B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWI_GIGm0nAQ7kNvwFgZrwi&_nc_oc=Ado6W0BGGLojy7mSzLnRMn-yGhWtFHeMTNMEmmMyuEVrfE53HyUsXCVHOASaruUIFsM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO2bbzL8BvDdpvVL8w0jsGifIW5-hmgI4KHAIpTkVudg&oe=6B06F550"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBiqBvxtGuEQ7kNvwEUDZth&_nc_oc=Adp8bKFDLnvWMQ2Jm0lxrWh2A4vPz6Klj6nmyLjq7XMDaNBYQylGbYjaFtSCk55d7ZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnzl2Ba-x11X7KPVUpLDENtcnT8ng_whsJ1V98XvrN2w&oe=6B071A7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qn_2E7DKA18Q7kNvwG0XzCj&_nc_oc=Adp5yilGmF6xnCUN1FKSzF6lLmZRDy0je9Z8NnZalihv8LraDOafz5xweg0038DokWQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzrzqpzpjMNHKXYzSi6p7ZphcPF3P76FxIkV09J4f7pw&oe=6B071B79"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kinVjBfeubcQ7kNvwG84V6T&_nc_oc=Adpnz9P6Bhjw8Cj6K0xUuySQGy43tN9KM5wc_g3A2QLlZn-qKsMG2iWtuAJNkpEGXcI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4QyZnYfALSZCbCpwQ81skBmDbMwAEWRF7p_PGo-1K_g&oe=6B0709CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scont
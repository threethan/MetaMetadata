nt-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jGzb9bnfZ1D73ANgOGJO7tPXo85eWO9Odo1jV9T4u5g&oe=69DE3E8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_1NeqDDbwYQ7kNvwEZSOU8&_nc_oc=Adoka4Zw0G1inTw0n1qh_ToVVImNuMcCfu4V_dbPQPZ8PEuLTjLm3jblC4hZUcpVgBc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qHdwidlNfPpL4hHA_gYuyXYALykhbZehEQaxGnThi_A&oe=69DE50DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rDOFV0lk48Q7kNvwHHzyJg&_nc_oc=AdryL9BDy_HSu9MANY2D8YeVkm1uqgH0Wy7CiEMe_vA5hV59fdYQ21XcE9rWiL6E58g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DhmpxVq-E87GG_SadwYT7Pib4ZTet5qqQSVB7q5qFFQ&oe=69DE53D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImtNKjTRcp8Q7kNvwHlNyqt&_nc_oc=AdqCA4Kc5AfBAGPy_JFz1tJuBofMtP6UbIAzY0CiP9tvVJJX9agwpypEG7nNNO3ksIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rcSRZ_mNzzMmK4-sgu-aOtuY7fV5fuAChiyYqH2Rarg&oe=69DE40BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GD3qVZqEmWEQ7kNvwFw7fqL&_nc_oc=AdqEtJ4rjyEweNzO05e1vbhLEl0xCifwwNqFPrJoRpoiqKswtTlAklZddSdiWBVdpgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x7a-LTsSa5uRqSpHzXuFATl9_Wnw8mD0R11WHGx8f2g&oe=69DE41B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xr0-uhpitGIQ7kNvwGPOzXA&_nc_oc=AdocqjrAE9F2FcIdIw9vVQUWCLS_A6Yi4C7dW_tQX9xos40FCPCYhPIef9Xxy88zM2I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DD1LeMJ59SQm7pi6L65fRkd55wkc80Z4lKqdY7zTFkg&oe=69DE300F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFCV0tcNGScQ7kNvwHP0xHU&_nc_oc=AdoANs5jOI-x6iQ0XuToeNXExcnktQ0oF1j2G-gskLSiga6srEyVLjAoV2_5pTHBOYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a3x_4MdvxU93nHBqoCYaut1KAN-mkSW5-F86dEDPOtQ&oe=69DE3DEE"}, {"file_name": "005.VS_M_Squa
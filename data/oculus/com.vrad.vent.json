t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VfhQOAgCBAiXJG39fR6o6M6IBSbLgDe-Z7oveQR8nkA&oe=6A29640A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgobWiUJPv0Q7kNvwGrVxU7&_nc_oc=AdqoFWZxpwE3pfPaxQLAGVeycieSsfMTZyO9EkhPZRNGaQPVI3KdyJlZESKL0lm1ATY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1pvZr2QjCo9IJfkEoyEcMg0AOXNoiJBsht2ah0DAqDg&oe=6A29765B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUCSweKdAowQ7kNvwF-qru2&_nc_oc=AdoCbrvjHl4ZDfJ8K6wK0lyyd-x_sStSeFwXJ8cktFGRNun5SUwfdWkNAfnC-1_w5bI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jfVOAzaNr0kZSPZ2Tbu40gmQsGzCeV2rLOWTkyVg2lQ&oe=6A297950"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s662OJ-K-pIQ7kNvwGbwUxb&_nc_oc=Adrt8ybmjG8trQFXqZPXpmDMXTTt7vFSM1WwSmuB0P8uvbxmpScrFaBds3Fb2zVMTD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uRIz2UaHdnIrzlyAz1U2RUDnu5zRMrWUFp-yverzCgQ&oe=6A29663C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZXTmgOJH2oQ7kNvwG7TOFd&_nc_oc=AdovKgw_SDipCxAcimaNqWyL6Qz4bbjsN74VxdEERGpA5Ggf1Rbx0CvywQnbSnd2gWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BXic8DdGgWiw-lWJcB9gCGswMZHTYsbIWOrJSVRIADA&oe=6A296739"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rImEXzd_bi0Q7kNvwG2ojQ5&_nc_oc=AdoKC2mIzZOHKhiD5wMUoxNAQBkpQFa1rhR2HkRFuAQnBM1ogbgZ74qE4Sl0dEGfIeM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K108rOKgoDwcQH6hc9rYTM1UZpsGpZGeAfj8h3kThqg&oe=6A29558F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7ODwEpWZNYQ7kNvwEfi4m2&_nc_oc=Adpx21j-MeozTx8VQAfmySxT6Froq6RxbwXzMhDrFRqNGIV-nZfdZK536H2wKUGYvX4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UmkUm6NY3Gk4tTEJvcfhlDcCvOt0i8hsL-dK0eAC11g&oe=6A29636E"}, {"file_name": "005.VS_M_Squar
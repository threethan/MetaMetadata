00_AfwyHnatHIxBS6-sPNIcxwyNu223r53GQyRhbcNExSxEjQ&oe=69BD490A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxiwveaV1FwQ7kNvwGeMRz2&_nc_oc=Adk9JJdl1Z30Xu8wlRjgrTWkfRdttvj1p2TAvlzBetO0B22FI0IX5540r7_AL5v1wbk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvFZbhWK6NmdvRMJkraW9r2lMdCA532QpSGmabyEqydw&oe=69BD5B5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3vQC9FEuq8Q7kNvwHOCoaf&_nc_oc=AdlP6E-YLE_6_sZbVL6RffIaAal68j2nXajeCyqVYJrs-1gRAudANU92w6aQeIbujHw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJTM1gEbDv8EcpX5ZeyzzwzOc8xiRZJecVxxgF39C_Xw&oe=69BD5E50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsCH58M0HJ8Q7kNvwFtuGaG&_nc_oc=Adlw6OoiIs46N9Eiy4-dQbZuNpscCiQs3yFIX2C5R_Fl0VEEUosffdMwPOb2TIzRQIo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9Z2NM9omI17A3nV7Coe4BZ9lvu3wdlQ8pQ_y8Be1qtQ&oe=69BD4B3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Mana
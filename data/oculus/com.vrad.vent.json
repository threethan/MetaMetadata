t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqKSo32girItsKwaO5jm8XXIMcDSc9Ivk0vmwY11OJWQ&oe=6AC1008A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmlWlHMTEVYQ7kNvwHGW9mM&_nc_oc=AdpB5liCS4OoyWCjb5z_x9mzpOwgpUids08t9oEYBG8hLq4wTq53vF2wsTpXdevz53I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_exB1g_xaNKOh-A2AA4hPvfRHhZu91fymlGt-J1FZvQ&oe=6AC112DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oObuJPp3WDEQ7kNvwGHgv7L&_nc_oc=Adr7eam2Ytk_rrHfc0OIVRjrXSvNmrOuoavWnmqegF0uSUdTrXX8pWfs979IdE58u6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPalzp6hbbOeDiNzHOs0R2YOr_Czdm8lg37ozqOFQKQYA&oe=6AC115D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTBILssMoSAQ7kNvwFZ5TQD&_nc_oc=Adr2zzaKG68YWT9rrApbL6dX_BH-RcktM6kfAio9DPNLQNRfkfdg5XoW1isvuGI2p1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiSUUh9kZfabkXq_haanTEgAOTTNPr5dnNZhosdrPQEQ&oe=6AC102BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLxfd_ocncoQ7kNvwFE8TBg&_nc_oc=Adq_pgHyedz-sTHtHFUQxTD9qpsOIaJRRbHHXVF-QxkbIoEo728C_gSW3DF7AnlDTA4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUOGFkUv-O0GFHYmYzUVWtk33RpnMOhbIwEpDU8D7eQA&oe=6AC103B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VO4U_5slwwQ7kNvwGb0jHX&_nc_oc=AdrfeumUqrSfXCO_ufDpNzfM7fiMOxhC4P66NXKnv6OqqUP4BtONXkQTF0GKKahR4hQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW_xmkd2L5rO-LNfMgwFph5ooslHaEcQWvfUwU_t7UKw&oe=6AC12A4F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yd1O_FJ71YcQ7kNvwE_dcyw&_nc_oc=AdqG4jj41xSQmn8FEAIgR-TR3t5QGFzWQzqmz6rgxEluvNmviHJ5DOKm9UlXXF8iu0o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZNgGzqadwed_iOVCiLe3cLYzSOZ3deE7Oe_ZleX4Dmw&oe=6AC1382E"}, {"file_name": "005.VS_M_Squar
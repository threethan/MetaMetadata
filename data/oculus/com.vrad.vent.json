om/v/t64.5771-25/473398297_978657034226177_6887405616059201056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5loy5HvVXUYQ7kNvwESU2ww&_nc_oc=AdpsiEVKsIcuDaPauuTh3BSePG6gm16NZ268YViJGv4kMvafjKU3HzQdTPGASstkKJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmhi3lkqDxoOE_HIj204XarzunQUSwLbK7t8u_M4KSTw&oe=6B0080CA"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9opuea2f24Q7kNvwGVo5xs&_nc_oc=AdqtkMmRbEjl0Ch2DPcqW73sqLADjmpoc8cTfCfhg3NaWPSfCc1F0M0w-du_32D3-_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqalAFglC9QN_XY7PcpBlmwPmXzEx4xCsb1HvpLAB8vQ&oe=6B005ADB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7czlspqb03kQ7kNvwHr38t6&_nc_oc=Ado3Dj72s2rdFJZeClTMvsSPHmxiqDREAsIpcBP25zEMtQKT1goht3W8QVryt-zBcnA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzkYQ43DnzckfVLfzG22UQSSot9i9e0p7Mbu_Muea4iw&oe=6B005DD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv352duMedYQ7kNvwFBxoon&_nc_oc=AdpZvSWEI3DEPGfUTkj2pmUHmNioqT5OcpiT605dJvJrvlJQH9kJmOo74A71HcC30qo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStDMomv0bwYr6ELHd403zdZhFJjW-o8leatFlL5sjIfw&oe=6B0082FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2Az2bxZGw4Q7kNvwFnkdZk&_nc_oc=AdrSvjE0UVmGPb1n3q31Mf_g0InJ2zAe20krJ8vokkzRUquAhw_2IwPUHkaeflNLL4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcJcY0D1SsIdkW3MBVZ50RmyKF9SpFsCdUhy2MTtnkvg&oe=6B0083F9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMeByokXahwQ7kNvwH_953-&_nc_oc=AdoQPkzJwTwSdW0dZrtEw8-VcpbJmT_Eg_5jgKM4n349y-u2-MiQ6eBGQJDVCpP6scU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdo4steyiUd1mJv2H6wcjnDSJcEpmkJPojhXdJM5yjwg&oe=6B00724F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scont
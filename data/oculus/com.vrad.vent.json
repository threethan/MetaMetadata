t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6PXSy4vFFWsB3ypYNYAihLOELKc9hRLOx6Pc5XQF7Pw&oe=6A5E200A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HruYWZn_AegQ7kNvwF6ifTs&_nc_oc=AdongRDgiF-JW7GBkJFN04VXmMO8TAR6YvDgYgYFuq6D7rmcrtMk_Zuhj-AmAJDJxp0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR0ikU0vLdkc7C2YkLy_ei9hOHPmj76nCSlZZEmXlDIw&oe=6A5E325B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aqeCbUBumgQ7kNvwEZac_c&_nc_oc=AdrQZ880Yjv5VhcM5hWEVM8UqxhuwSiBF-aBJqbkocu7u32c-o8V156l6kgnHoxOv_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpowoRpSXqSyHUJfNNyhYiXBdE0EYI2McBg0tEwHUnrg&oe=6A5E3550"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnYV42nn0DgQ7kNvwGFEsCz&_nc_oc=Adoy8PCFuq1Cla5Iv9o89bQ79S2SufDXon1xBnPzASB2rYfbESLoP1FVPe7kfnpfPFU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgnxfh8Pzc_luIZUYKtRRpcEKwl0izPsnNuTjI-b6lgA&oe=6A5E223C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zTYqtCSkOkQ7kNvwHQCIML&_nc_oc=Adpmz3ZInT2_zKm5-vk0g28EACawV_WGHiWNcJAWXE1w-wogm1qAto_ppBhfE9rkByE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvzXWB7Y33QvkA4QsUEyo69RJ7iXCR1BVe3PHUfB8lXw&oe=6A5E2339"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hLKCUmqHXYQ7kNvwFosDbE&_nc_oc=Adro28zkkl0s-UV6utMlK8hLmRrcU9RrhD2d3nRpyJKsja0ECpFXffSzWmQ1nJBT_tA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALKmxaU2sqqyGLhPpkE0s84Q6l494G1qoPG3efrfDpsA&oe=6A5E118F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySu51gg3a0UQ7kNvwEHCuqj&_nc_oc=Adp7fHFGoW6rISmVZSKcnDFVjxxAo-T_jJvoC1GKQ_L08qvmQDsdS86n-Cy20e2ciDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgy4V-E9JnmBekrVA4sdqMLW769w2eUX7QkrGLuuJqkA&oe=6A5E1F6E"}, {"file_name": "005.VS_M_Squar
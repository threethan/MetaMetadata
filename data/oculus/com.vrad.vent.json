00_AfvlCAu6C1lLt1q4MqvSW9ym362YcvdewkZl-3qEaf3GQg&oe=69A8310A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcTSex9JUMMQ7kNvwHxAS_x&_nc_oc=AdmcIEpbmIUSH5IarwqD6QuypTg77dGPnqNsp72l0mn9beve16VzNmorl_7DYRQfJyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs0rNRh0cFktPFnj2WPApsVByAJrCQutFeaOxDlzfkHKQ&oe=69A80B1B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAKD9ghMBfIQ7kNvwH3_omo&_nc_oc=AdnaOq_2zJEjzUP5rx_2IQ19VrAcijjphtKAMM3M3PBbW6A9Q7ORXM2YaDRm2ZvSrZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvFxUX6QawGPmlW_KyDbeuPoDhmw-3cSy_7pfXXdueH2A&oe=69A80E10"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PpYnIBKKD8Q7kNvwF-Zx5E&_nc_oc=Adm7AgPx6SRfbdH2k0IN6gUA7zTnsaXuxXFPkUeaLSRAhgA2looGq-BT3BANrO6jQ9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvokbOGnnbsiEPn7IJZOSLoyOFUiW0LI340QzZhHNs3qg&oe=69A8333C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Mana
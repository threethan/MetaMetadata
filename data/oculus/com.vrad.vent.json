nt-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18lEO8C1gj75Ruolrbtw4dLicsSyjZc23UJxjgbNGE7g&oe=69DB9B8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_1NeqDDbwYQ7kNvwFjUR1s&_nc_oc=Adq9402s_10mwUcZ9P_coybLMyQqVJt1N-KXvspqwkpzdsJLDvPLHZDc-ztuvcA5duU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lg8swW4LziH-279tHbA5B4Y04-aH2Ux9mVrs71zTAzA&oe=69DBADDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bf4RkpJ0mA8Q7kNvwHd4ifO&_nc_oc=AdpJqqhT8YKpTAveF7_Jm5dDq0qTl9HS7_8De_VbGilmHCnjzZ5n6eWGv-vB0fcyCNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10m2ZeQmgoFrAqjNHcmQ5wRlexVoGl3LRk7sHoBL3EWw&oe=69DBB0D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuverg75jvoQ7kNvwED-KSL&_nc_oc=Ado1FBWX5CRZcxFsOW8JsnUMtQcmWJQoPkBAdoxFZWymNdES87xSPb81R98AWjuGAEg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1v3vfca-Oq9r-m7slhj6nf00fCKz38fIAQMpPEtqursw&oe=69DB9DBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GD3qVZqEmWEQ7kNvwH2X66D&_nc_oc=AdrzINinSbtmFS0HeNhPioFAzh6kRBujXO5Kf6leuncmc_bxJD-H4M3MdyGxr2WhP70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35CdvaUtzVS-WeBYOgyKkH2d_nb2Uy-Cp03EOVFWDxiQ&oe=69DB9EB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xr0-uhpitGIQ7kNvwGaGBM_&_nc_oc=AdrCUPFgXY_3NbMaAb_g69AB7I-POjW9GCCkV883h-N5EU_B3ag6p7VWZTFQkm0_VHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3591RV1iVvKgZN32hsDGjOAWxyLlawEdiCNH5uemGzVQ&oe=69DB8D0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EMGB-uXtWIQ7kNvwGAvJ5w&_nc_oc=AdrSy0WeIvMeK_ZKiEiDngKQp2lZLFByxEHz27gy5y0a-zLn8ddiaseZCMZPVBv3adk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pjQK2zcFvGMJwnBqHLT_2g2qJd-xbFpE-DExD9c71bQ&oe=69DB9AEE"}, {"file_name": "005.VS_M_Squa
t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3FY0_-8WrHVVXHFivCQWDkVAzfGKBqAZpmD6AV8M-zg&oe=6A772C8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jcJ0OC9E1cQ7kNvwEThMrD&_nc_oc=AdqhDu8TDvK5LG6lpj8hFe7G0h2XIoYsfLGXHH2HAjxbsbI11rNtJfN2NqRvsD5dfDM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKD3ANYdpw8SPCGThjtyFeaIjGcsJu_SxJzKxS-ZvzJA&oe=6A773EDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0buC1h362UQ7kNvwH9duLA&_nc_oc=Adr-X7JQZcvmTgVWQ0O-y5fUXiRRyu09cLTR5Jd7rsxUt45XjBrtRf4faRkk_Ci2S38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL046_3ws7ugb9TpYj3TA8D-3bDdkOJHhhhhUMWsED6g&oe=6A7741D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1i7refv-ygQ7kNvwFAzS0f&_nc_oc=AdpUVMJOn-yPB6Sbt2bWWZ_j2CHvihE73jgvzBp1ihAmN9ZMbOb2zm-rh8v8Ym3heQE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDMR5ZYI-PJZarmCQsMhK_P97_LD9RilVj1OeJ3bDamw&oe=6A772EBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZVIr58UdsQQ7kNvwG8pjib&_nc_oc=Adrv9RvzKIqb1Uk9WztQ_H7QbsXxTjcdVriFGj-gFwXFL8cALGVnbHkvQcpDpYSYDhA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6a15vt_39G3HHn_-hqYjASAa8Djm4bGkxhnEENZeC4w&oe=6A772FB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Rnd50TVPxEQ7kNvwHYeX6B&_nc_oc=AdqY-gi8UQNOvsWB_WtuPQQ9KWN_m2PpI70gFXPcNi4qV7yc_DPZ3eMCpIShbohKlKU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF20S75jDlr-HVrWYxn-FZb6tTYIthyxuCcu0HJFhvnww&oe=6A771E0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GPC5lCpSUoQ7kNvwENLU4O&_nc_oc=Adrx0dZtcAmXXtFvsclDYoMNbxQbzcli2aVU8wquVennQp50eWN7m87r5OrCg_a-gYU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHN8HhTNLnvP2M0JvVIoug1EFDHxHE6YoeekamIV94CA&oe=6A772BEE"}, {"file_name": "005.VS_M_Squar
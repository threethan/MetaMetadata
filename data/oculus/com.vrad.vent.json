t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXtlTwKmJaUL6Rp1Y5j14qbbrPK_CMVV8okFq9fyeErA&oe=6AF5F4CA"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xct93eGgHzEQ7kNvwFfwX1W&_nc_oc=Adq1OC6dviAcPnuRFw9SwGOqpzbBHnATP1qSW7G4UNFy779Gk0k0l8U7LMtPEvZll3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQptf6R78u40j7EhB9e827q0O69T60kFDr_iIg1K48Xow&oe=6AF5CEDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_c8yPxC4l0Q7kNvwFVF7IN&_nc_oc=AdoWk7oCPbbnRquWXU-F2CHhHDhd4G0cL3UfFVgsZm7Td5sx6GnhUsYsSv7cgTZ2sYw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQurjdwpW4XpXYbOkOERknnynCPLRL94gajfUq83-JxYA&oe=6AF5D1D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJoypQfnl_sQ7kNvwE_USOX&_nc_oc=AdoglF5Dx3cQZapNhNrIxUw7qo4Pojm1EYGYuQP4TV2ixQrvVhubqyRU5POU_MOMFCo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQka8IHX2nuuOWTF9_nekYrmFLnumsp53RQ8HJ9CmHKfg&oe=6AF5BEBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mGOn7fj-fcQ7kNvwG_bGlH&_nc_oc=AdprnTYUcDLKGoCtT0pmbPRRZvrP3-PqDg0wy1UAMl7OAt7-fMkClwfFlxWZoBkj4ok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcqeRBY9nNM3E6dw4XvOJqm_PB1sFMMFPPqjZfMaOQ5w&oe=6AF5BFB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNXNQ9uOoUgQ7kNvwEJbNKE&_nc_oc=AdpHMtkQQc7aXI-EfQ23X4G_2UYWj2z366Ypk1FaEAwkqMc9PBAxlwb2qQxW1CNZEx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxHpL_8FV0fHKWymOOx9PFA1oRoFpjifisk8q7wlSU6Q&oe=6AF5E64F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4Jf2Y4Kr1kQ7kNvwGNfNff&_nc_oc=Adq3_z-F0mOYrKjLi5lZuL6JCMwjGjUMoysUk36o8CbvVLz-LCcYFrZJi1dXZM8me2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXu5dEnrZlyWiki9RKfGavoqPQJboNF1CwDSIDNdIVLA&oe=6AF5F42E"}, {"file_name": "005.VS_M_Squar
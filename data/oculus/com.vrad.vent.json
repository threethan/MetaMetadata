t-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRbs17Mmg78_I2yjmBA_xbOS54Uw6sWo0wlps_pnP-vg&oe=6AE5EA8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX-dE_F0-XMQ7kNvwF5AZy5&_nc_oc=AdquveBHw1Vsw1meSjCC_a66SccuonVs77VsytIUaQS9OR8bxzoSVWX26nCGlU8uvHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvmV5gydqywGifM2EIhGCxANGKuxJl5AeRi_60KWOu5Q&oe=6AE5FCDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxnfeDl3zfwQ7kNvwG8eTz8&_nc_oc=Adq3ca-pMKm-uaYvYCbrl_KeHzvDB8e96DVikD2uq0y_PsdmbUNySEG3jlZPg4JhQmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVu8_oJHCUEDTt4N4zV2jR0Y_UKiTyXbI1NxOU77QMcw&oe=6AE5FFD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dFdzMcLp5wQ7kNvwHugAUr&_nc_oc=AdrMRsvPfUNDkvcoNgqhKQZ5EnGCBbReYtaG7GR-FRxGAHO9HVeW3p-4wczptVA2GVs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRhyVT80kql_kP_tRTtiZwwozb_az4STQI8zEO4OMTzg&oe=6AE5ECBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTd_Gzd_IT4Q7kNvwFxeJV7&_nc_oc=Adp3k-cxLfC02rZFT389yCXsGeMR922WpsoHjFE4p-jdLUGbSXthRgwqZLyEs3Wzu_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORvLCvTeI7ckoeqNJbZAnj-EMASl67oWk5zK1RHWwF5A&oe=6AE5EDB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDaV9YaqgdwQ7kNvwF5S1A1&_nc_oc=AdpmzoiBraz94NagFSB6GqIiv1sIkjRwCrKYamOI_d3vUUHk25M1oqSUturZtchEwns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDm0FnNsv9CZ66-54KZSOfVh_FX5KoIEhMLxcwgDu-cg&oe=6AE6144F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gialftfKjJUQ7kNvwGKNgMY&_nc_oc=AdpxOux7jujUS7OakHIOm_MVwGT_qKH1D5eC0AYa_51DrQ9twljULMATG3J8MHz8ntI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsklpzRIUpVgtmHUCznJWuw4nHpRNnePfk4ZpuxxNKpA&oe=6AE5E9EE"}, {"file_name": "005.VS_M_Squar
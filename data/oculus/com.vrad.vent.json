t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8igpQzYAtEhEsaAshXUte9pAmAm0dk0ezcsrodfVCgYA&oe=6A411F0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MyC_uzA0QoQ7kNvwHMrvRx&_nc_oc=AdqPl0VI6_-ro-CQG1rP7qPdXGyU4vifjdfRK2abkrLNYdQKYHs3zf8l_R4LnlOR_tE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94VlnLTa0XlnPD6LvDEmE-9i2mqezECM40HT2VCKL8fw&oe=6A41315B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH4wThQb0WsQ7kNvwF7B5Fo&_nc_oc=AdqwBt3wJfBgMWs1zCbq5QSD3GA0ffGYHKvMMSvPLvMRFVdc15Cono_pWGbSsukRn8w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xogi7okqjjPKuU6_JCig45PBpNpIQ9smj2hsShB1YJw&oe=6A413450"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVYyrOgAsWUQ7kNvwH0bPp4&_nc_oc=AdoB6GhFe8bte7_FRO2LzBSW2QkdInpXeEx0jo5ylhZWJd3zDgEaaqiRhj-ucV4_73I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k3o9MXHpI_tSV5Zh8IDhziYuxT0ydOtZsHEcEZrgiKA&oe=6A41213C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQ55lg3rOqUQ7kNvwG4NH8u&_nc_oc=AdrHcMyEk7z4sLzHxFiSke-DM-v8IRyn_juUItgOGnskldQON4PARLj9ADyKvjZhZvU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sua3MV-I6tmkpWYDYK7-82VNLWdPpjhrbgIMiXr5_Ug&oe=6A412239"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxnlGFJglEsQ7kNvwHDnZhL&_nc_oc=AdqExs86MwX2SWMJE_q43Ua0cRwGPBqNpZudn8CL7Xxl62vVhXoNzjzxY4WQo7t1jnY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vBMyPMI7hqALtmEJtqZddwWUcJXJ8zAkdB6XpDr5Olg&oe=6A41108F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQbFzTWniPQQ7kNvwG_WfaZ&_nc_oc=AdoQO3fBISb-2ldLc2idQXo7EQ1h2aYlHYCcRumnAAcbPiFXtPRiDF1Dy6yyM9DLNhc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fkdfS62OhQBAsABFq94f8yjAkhZ97x-EOMyCXyyBe7Q&oe=6A411E6E"}, {"file_name": "005.VS_M_Squar
t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ2g87bRmwOdjNMHnmHeA9X1rlSR-s__0iInuoA3l6zw&oe=6A99738A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2Z4Pw-N9UwQ7kNvwGLVdCi&_nc_oc=AdrA6gPSbpPhzwp2Bdj5sKxHkyHJFW0sNSShlh5ESpnNN2IQc714fTLsysfHJ3pHCcQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkzqZ8POEJYJqWFM9Yoaeqz60Qb8W2bk0vxzb8E2hSAg&oe=6A9985DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpC8GrBdBlsQ7kNvwGb7vCJ&_nc_oc=Adqo93StmcnyR42sGJbislVHxotjOIQfdgKVudBtyyLUyRsZAS8_hdAnRu-OVe_DTe4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgbS6WHcS2vHTJTeZB6_buHz5eDMjRlwit8lJUYoaZNA&oe=6A9988D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dx6J70bCQ2QQ7kNvwEg0fQD&_nc_oc=Adpb4rXHj9KUgTEBH1WamL6pXmvXpNcesmrGzlg7GqN41eRRf1jg5w7oUr2jbYaWGko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp6ir1m0_M57LiZ8LzWRnaPix6rAVbApX4zz0Z7CLZIA&oe=6A9975BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmQakM88Y68Q7kNvwHLR5eF&_nc_oc=AdoKoYiMZrfSB7VBDiJqbRl8Gzy0AHXyu6kPZE9BcGd0GTor_HoiSFVo-dK7tK0yNSo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdTqtqgZ9CNYKnBDGhIPzY-vjMGJImHOtnHW6s6ykQWA&oe=6A9976B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9wmP2ag1okQ7kNvwFFtr43&_nc_oc=Adpr0xv_tJprHIUT0SuPi3T5haaNUd0kh4LXRnAhfWMC-vb1EmqqFNaR3510NB90B7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI77xNXG7FKvNHOeQ3B5ZAraC8dLYCLRmkPN_NPdfzipg&oe=6A999D4F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCC2dce8gmYQ7kNvwEt0zzd&_nc_oc=AdrnSqy0M-rQ7oC8dV8x0wHzbYWbqhgIurQODo9rCMtxR_D3Xu88tqzF8QG5JrZYBAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfOHF6v9aHDKkOdHFCPMoLI7E4sv_AKwCQjmEVAuIpBQ&oe=6A9972EE"}, {"file_name": "005.VS_M_Squar
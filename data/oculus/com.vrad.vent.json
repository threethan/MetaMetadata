t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BU6wFZuV-hWfEckmek_qpfrymMMerH_IggpVPqNYyzA&oe=6A256F8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9EBqszv2pcQ7kNvwE8Fv-H&_nc_oc=AdqI9-ZWRFwZAHGQ7ul4HxsB-dhqgldl698vQoIK794TbxH3wsK68RzpKI4pKfZVfZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1TGCXVIidnGdlYn5laDx40Qw1Uy2ETN43LHCkEgxuOg&oe=6A2581DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8eZZEwhqpQQ7kNvwGskk2x&_nc_oc=AdqDp9w3-bKS5h00LrWXYf7CIFCWGvd2X7mZjhX-II5ugsYLx-33CQMTphQ-46ebkNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jqs43cHLBcWVUSx3prle6EAL-i9U_Uy_ThNw3p-R2xg&oe=6A2584D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AoVzTP5HRgQ7kNvwE2crvl&_nc_oc=AdoCe4OuloPZgjP90b8h-UC3D_rGq4Nc88xSy-XHIWADGNoe_Y3YbK3RhqdSFaLDxJA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8agiBij9P5lSB4cNImJewVgnlyEic3FQscO44QZUdixw&oe=6A2571BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaWrUZl3HrMQ7kNvwEOZOO-&_nc_oc=AdoV_KKteg9vxDjndv4GaUw6cR8wMb4i1991jCvc9j7RqiSaYCiVsMjQxPRi-XPG6-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9REXNjvQu5OjizRF_Bj48NtevMJ2rg3eY4h3AZ4Sou_A&oe=6A2572B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYLHi8WO8DAQ7kNvwFHvjAn&_nc_oc=AdpSl_aWvy9wjeUB6hmRIzegATLfnNCsDRdpUcpt07CzZ-fBIrg2S4Iomu-zui1BC4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_irh1JLPx3xFOLpRh_skHCPu1ZavMdFI8cHdIDtHYT0A&oe=6A25994F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMEt263LEXMQ7kNvwHqg3q1&_nc_oc=Ado2ukl0aYr4vixjrxgzPsBaSyfQXpIexr4xFFjxeLl2zwj605-eQh80vTq-vtvBttA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qm_XScHej8msfMp8ReNiHxxu5gLDtMKVXIDIlkHBNQw&oe=6A256EEE"}, {"file_name": "005.VS_M_Squar
nt-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qISKEvHaJW_wEOqUZZTZWQEW6OQgEKEV8fYPlzhqPWA&oe=6A159D8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiraojGoNLoQ7kNvwFiON1g&_nc_oc=Ado-lq8B4KBBUfqtWYeXWqm5T6VaRJn-5n05whhFlYzG-SglG1FpZecbeG2HdhB1Dhc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KyjciLxk9RdIoeKoyL1JQkd246eaVZMYQ51pN5aPLkw&oe=6A15AFDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxYo_TUzSWgQ7kNvwGFzOe0&_nc_oc=AdrBh1poWBD75_UApVJcRIGJFvLdA0IUU7T9y5XypJgGogMz5BeQImkHBhsbwAdmLXs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63fE_2vavO7J5pTOji2SAVpjaR7OZpRKroPhVqI0Jn5w&oe=6A15B2D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcFJEABs9osQ7kNvwHmjTZ7&_nc_oc=AdrnHbWvlscNpbBnnnvmtnNOmVBGKFv7aaqjM7BwX3V7tYn0A_jbSMIWMkt2icfTEDc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BZ1Z_gCP6nYmP-f8T62nLGtiNtMQI-QR5TUJBg7uzUw&oe=6A159FBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9reHFhCtOoQ7kNvwHW-Zia&_nc_oc=Adp0JQwlJgD4Xh5YQPm-eDZAV_DEF_fgcl84oBxq8zMdmF1FXNO2N1uibRCzZUARhg8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-L9KvatSOL59nqUCUfd3Agt0vvFol_cTS6QJsGbXPKw&oe=6A15A0B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozi3G7XlvR0Q7kNvwH_NQkK&_nc_oc=AdpmuKChTxVe0P_Zo_l0zeNYkMbMESfKxAiLXqMatRsu-O9nhGuGvyClWNGKor5-jYU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72FPnWvDZqRDz1Csx_IQ4makS5yZ2tdQBpNx6DaLtexA&oe=6A15C74F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDBlczSeDdAQ7kNvwHSljCN&_nc_oc=AdrVFqopmqswb0i_o47kKZQozUQMMaKIQv3fhVVB_w48_0yv3IC5b8O-UwIap9NfHVw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WbRyULfybaoetaw-BJ6x9NKZZQnIAJmXwloppieDawA&oe=6A159CEE"}, {"file_name": "005.VS_M_Squa
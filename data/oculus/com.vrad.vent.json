t-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuQozBaLl74dbzg5bFyL5yO-pfRQWdB0thk_X3-v5VMQ&oe=6AA15C8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-QkTCh6KssQ7kNvwFz2GtI&_nc_oc=AdrsK7nx3ngrta9wDKd9DDgupzPSeyurYyQwiQ2joSRGknJjjERAL239oPpSWZ5pUnA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0uLSOimQ20RO3CGKB1YjsVAwzr4oz0__96gS6dK11zQ&oe=6AA16EDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i_M8qZAPqIQ7kNvwH-eY6s&_nc_oc=AdrNN_PJ06whkZZpezGVv03DoUl1QnKI_6dRj1k0cOhg3uzILmp1bQ0b57t-QLyNTMc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN6TRe0clbjTKF8TP_N4DL2bcBpEO1C3We7ekntkyoyQ&oe=6AA171D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIabu81vcJAQ7kNvwEhftKe&_nc_oc=AdrqJsR14ZEMtfuPMQTbQqoPcA4bm6nzKXHXY2KKQs_nXnsihMzkf6FoLPp0Ezkam1g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmAJMKr6AVEpuUO0cVDA5_LcDmp7dcONNiWREF9usVtA&oe=6AA15EBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbDMBZ5BwSQQ7kNvwGRlZKS&_nc_oc=Adp77gwbykH0UhEQwabiSLtaN-kHH5VBHM1Bd4jNCUces4NJE-pKSOvnLDCBCvPMc2Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtk6vINbQMIGuirJGEltBDRJC7PrVzM1Kq13eFB4RdXQ&oe=6AA15FB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLfciw535G8Q7kNvwH-a3-5&_nc_oc=AdrK8-eUCf-7dU0GHd2Vl4HtAUFiOXjDzS9Sx1vJCI9yEmM68NUy8LZppQ25lVpyK3E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6IWvwMR_DQsRzGlPJy42W9aZqdZWmMHPrxAtj1I7ehQ&oe=6AA14E0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3cCxl5RNo0Q7kNvwFENo15&_nc_oc=AdoVKOVyRdsMQOpIysZcbCcS-Qs6RtFZXDyZWo2BwkjiQwC4oNDV4iCvjJGQR74xE2w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLladL8ZGltjhjAvnFUWZmdhZI9FzUP47q_QbD2m8u_jg&oe=6AA15BEE"}, {"file_name": "005.VS_M_Squar
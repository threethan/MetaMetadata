t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0WhcSbDYTKHioRxHjtKcKq0M5-b5ldvBob0mzj9_gDQ&oe=6A5CCE8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=johQc3uPVRIQ7kNvwHaFJ04&_nc_oc=AdooCYA9XAcUd8Bnz7N1P71OskeqFa2PGJycgqHQIctSJlbsdQCDBILpgSXomuK4TbI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNso2LYr9NWEGEDOkyNirP7FOw5gQ2W_W9_E9jhxnwTA&oe=6A5CE0DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aqeCbUBumgQ7kNvwGrMADW&_nc_oc=Adp7c9XqFValyUeCVfnttZYFJnTEANA5lCKMHZjl40k8aHSuSe2zFETDasyMKZmnNjU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_S2FPHPXAdoQbjTBuKOOTGXafyNC81SVKvOBbu84nVw&oe=6A5CE3D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnYV42nn0DgQ7kNvwEoBiCY&_nc_oc=AdqHi1-kXVgpfqw9E5IGPnLkuX7D7E81aOOp4LaIwSD2_SstnWCdUjCwSaFZ9L2pdII&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDs4bG75T28Ie_CiLE6P8x2J8UEG8NmG2-1ugZ_n_MhhA&oe=6A5CD0BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNGkkgQ0STkQ7kNvwHglD4J&_nc_oc=AdoA1qI1Z-GR0SbDkJxnzpbwtOAdOaAvcuX8WvjNCYXXuG2IZQCiUo-XDIoC7OIYgCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX7LJ84-vWKy5YEqmwICj0RcPQeJr1ssrkmViU9L2kSw&oe=6A5CD1B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sIVIUZrcCAQ7kNvwH0SJkH&_nc_oc=Adpmg2mi3WnfUp5Q9Hf7EWAEHMZoFMGXr4JHe_5WnCc7AJTgzQ4e_6NXtjZTC6T7GlM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP0rOZAy1Fu7JZ2CW1kPaYtVGa-uA-93xSqjzKUbP16g&oe=6A5CC00F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySu51gg3a0UQ7kNvwF1pWss&_nc_oc=AdqTtXInagcRwKT9DYEVBjOd4T-IP_QB7Ra9imewafQTMGh8NBGjzPnJWtfdzlEF3MY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbnecXXMo0LX7L8YRiFHaBkozHDrkz4tqqUbV5p23x6A&oe=6A5CCDEE"}, {"file_name": "005.VS_M_Squar
nt-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UbAPBdhzNgelZheJ0GXame2vrGZGXe9gjuvznStslew&oe=6A0F060A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvLdIlx1qq0Q7kNvwF8gAhI&_nc_oc=AdrQXvsnS4elNuBn4w2ZNH7ycjSWTbMO8mTtS6eIGp1gQYWc1mvo9deseMY0TOUmAAM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LeLkhpmU9sSUfJ6RHfL5Fm6Z5DDG-MjfHP8FqzbGJUg&oe=6A0F185B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMkUucsqJoQQ7kNvwFHDFER&_nc_oc=AdrZOYIon6X099d-7_tlK_3EA6O5QUz5K8Qso7qoUihDqkFLtNkgDN4iOlr_UZyWNas&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oZ1I81nxdMF9eTmuHLdW49Gc7Lknj_CKy5FajaAamJQ&oe=6A0F1B50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vo6K2cFtGUQ7kNvwEZOSi-&_nc_oc=Adqtu_VDPZLNTJWuCZfx9LMaHUZ7nVOe9Evqp8JAy7Up6rGax_9y2x4IjMJ8XCU6iK0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O1_Qa_epzBWuSIKys1SLFTYXHDTAMHINImVm0FO0F6g&oe=6A0F083C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4u6hTBgi_4Q7kNvwFh_2rf&_nc_oc=Ado4cc46O7kkv6lBEzsUz0p0KJAMGbbATBLSLFccC8OupCquNa2ipmlU0miLj106_tE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48d0QLPmCpj_W4GLNrdyVdOjZU7JcEzmuWhxJzXb0o5w&oe=6A0F0939"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joIvHxAAVkAQ7kNvwENRzx1&_nc_oc=AdpgjITrKdkZAEtYl172S7MUMNOPHOaqOJboiz-ChAKT85ZVhDJON6LToKeZw_SDmq0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jpvPeJRTSOFhhT4svLEp307KgaT0hWnMhfGLZPwX06A&oe=6A0EF78F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XknOsz80US4Q7kNvwEPk_Xw&_nc_oc=AdoalsjVs4fvGVOXvdyU0JGk8x1bp6k1fuFHYTPBT3M1JPJCxHecxKkE_271vdQNYVY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45JMMuEdmZRmLzpesjOpT3XvHiLDO7zPk1YTulQe9eHg&oe=6A0F056E"}, {"file_name": "005.VS_M_Squa
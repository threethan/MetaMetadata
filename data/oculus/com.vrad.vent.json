t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz31qSDJLBkPdf28wawkdOXcqROzxSBNR5-cnFk0LZTA&oe=6ACB8C8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olHu1WqrkmsQ7kNvwFJ6wK0&_nc_oc=AdpAd5EQFw0XnMjP59kirMuq1udsvApnditbHTFzXbSLVyOgbBvU6P7QftsibGZBKhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6QGE5aPo9H9Ac3mPW4qIZH0ve98cpeac2Mwl05ygsHQ&oe=6ACB9EDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkHzWq3cHbAQ7kNvwGXgcBL&_nc_oc=AdpMKLJjfCQ9mb_JpHqgkkt_a6xL29Q5ay5wRM2PpqaKQvNPzZe3Nwg14RjtLN5VxtY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8SYpgoPT8F8JTgKO75vG_jQozqmFSkiJgqUiozAYVzQ&oe=6ACBA1D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQYghEBciwQQ7kNvwFcH0dc&_nc_oc=Adpz2-kZ8BqbbOG2MG4xhIR9jkr7autKOLzFmMY1oWVD51c9cxUojFNpMkUy9BhauI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9-bwEV-Kc0Z8uv-aXHGGYvlDqQCDizr5P_JNZxxx0mQ&oe=6ACB8EBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oeosq7RaUVMQ7kNvwF_6mdL&_nc_oc=AdptMVZ4mzZ88n8ilNj0BWxCeiY_QXkzkWNgc7frr_RxlW9EeMKyCbpNE2lRukfCCP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpH1yYG1zy7scawv-CLLl7yfpladEs_ZUz6q3Zgr8FMA&oe=6ACB8FB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1rBI311l0sQ7kNvwGiHaPc&_nc_oc=AdqYa2bPeu18ciLhq3cQ-xhV9sBb9KsEtHUJLA-WHwcgnLn4NMtNHwxbWV2lzvSxW0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCjjWp7kGJ-g8lf1MoH3A9_gVmB8MUIQ5pJq15Ox-32A&oe=6ACBB64F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSFTtsTbrhAQ7kNvwHRx0yz&_nc_oc=Adr6SrndVd433eqzrGo39QkN-BMONKcIG3SgYWJlvIgqxsjeYMtsWyfkbO1gN8-a-Jg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeqO_IThzQSKBMmrRdCemItR1LOG1H4OSX9dKsVWyFwQ&oe=6ACB8BEE"}, {"file_name": "005.VS_M_Squar
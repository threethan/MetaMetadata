om/v/t64.5771-25/473398297_978657034226177_6887405616059201056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj0AnCbCsFoQ7kNvwHFsBrX&_nc_oc=Adpnp9nLZkF3MXctk2hc8LRSdscyl_yv5dWW1DzwuY-SC54jq_NLlC3owV7TND8Yhsk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbjlHpodxvO6dg7EUKf2wRTs1IFowInrhEWE0ugFCISA&oe=6B04754A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rghXaO4Ob7EQ7kNvwFX_wvW&_nc_oc=Adojo6ZvjTZkqZQbQowFP0FQTatUMdmKun2hDsmzuycTrXu5gximmnrZZyC-hToEBMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNO6e6yhiw9AU3PL2SZzHzRSoX4viE_mhuosm6P8gqqg&oe=6B04879B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXF2SWdfNcoQ7kNvwG9iinz&_nc_oc=AdoXTO4CJ2AY_5vMEGBE86tppQjMTa707ysHZqWDPSjdgCqQ4W2c8y1X6EIEpugBZI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt4HfJxusUgluQ5QPHT4U11xj-vdcSckbTI9IDmuEF5A&oe=6B048A90"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RV5ng3MX_YQ7kNvwE2HEBX&_nc_oc=AdogQi65Y84ulJB9oIX1LB8rGjs3Zh_4s2pSLUCAKjav7cd51Xov0u2npvodfXp8e5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ82xIrBkHXJc1-hNyFjbPymTebqtXzUW42pewMgL4iyA&oe=6B04777C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsaurltTN5UQ7kNvwEuDJEn&_nc_oc=AdrVhBoIW4s-HlWwZnTTDNtCDSnES99Bdml5b1YvXbVKQUf8jO0uiUXUY50BRNAUE2Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYu4WLHfDgPRQNB-eJ-MjyWSXARL8rNNaiFd7nMMHWag&oe=6B047879"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kinVjBfeubcQ7kNvwH5mJia&_nc_oc=Adp8j4LoQ4lFDlTZf1HYYem2Bn_JWOxV4wNyJB18JCR89oSqim2yC0N-w4VTWMw9erw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdRNsqkjmEG-U_bGVP8CBGq21baEUcOX4f7oVUCWPWtg&oe=6B0466CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scont
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3cplpmo22Epx3ODQeYtXeaES-It_I9F2lmZmX0_YHtg&oe=6AB5230A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3wslHyqwBIQ7kNvwED1fR2&_nc_oc=AdpdcvRpK3DmMHi3KU3XUI-6AauEL1NCTQd0UsQu7Bmwh2M69ZO1mpyPFpltphBUeB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv56w5tZgENR8b2ZClikWfNOVzAbtq-r3-vmSc21jt5Q&oe=6AB5355B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4suU-tLKqkQ7kNvwHjpzuF&_nc_oc=AdoGQKwMRJ_lKcuOD1Yf0ejvlZUxLFUPIvtM5ewVROf81enCRAKfnYPlYTyalaoD_pM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRBgILq4wrpqEEmFm2xIXUbmesAzD4OhPRRI4WJXctNg&oe=6AB53850"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksh43zRtcMgQ7kNvwEKdJsi&_nc_oc=AdqsW1Q-0TUocJkST7TeOxm6buOSreKl4HW1ao_I3pgUsFm7p24p1xygha-j5JujL8Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu1-yfE6MyY-A3nbykAcwsD985w15aXAHN_K-stjQERw&oe=6AB5253C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hSr71QnElYQ7kNvwGqUOOv&_nc_oc=AdrnKE8WHbSptupMWz5afbzBWENBC08lZpHBfBjUc3evwEf_3UiaHzwk7WZeAjZt5EM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1RuxvD62GDbg21aoudj5VH5JE61GBSMIgNeU-yiNbeA&oe=6AB52639"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JglgrTkEtEgQ7kNvwGkuA32&_nc_oc=AdoD_VmV7iwtNTN8GwJK-URNozqrbDKAm-dnnC98HtDRv0N7-SeqaiYsSOpxC8gTVxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZili3CaXjJoTgtNcyNAhtVMDP0lpfKzWJa6CRVHxeFA&oe=6AB54CCF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FPrLB6mCFkQ7kNvwFLb6pA&_nc_oc=Adr_f7p3RYduBTKcRB0UpZOWxIMEUg-ugtyzckYkNC3A_bRctVmKtNhgsCxKpG2akbU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMAHtNCUQfAc6UQz5Ew12mXOcNLdzVfhD3WFnyTW0NDQ&oe=6AB5226E"}, {"file_name": "005.VS_M_Squar
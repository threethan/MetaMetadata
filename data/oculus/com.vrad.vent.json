t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe6fGmvjvBcMBrpIA9Si8AxqrXWujQ8pwc1Lx_aC41IQ&oe=6A49080A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQ1cHUuw9JsQ7kNvwGlt_7a&_nc_oc=AdoCO1ngKQ9InzlZEXvMZSvmfRHG-npjRtFMyCRN6g_PupYINm0Kg_Y_ThnMhHNLY8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjt2JV1BCMjYnZiMRMXyv4DuaVHxFJ-scSvUcG5R3WwA&oe=6A491A5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WylhfJmwmNQQ7kNvwF5X6Kk&_nc_oc=AdoyOlXVavpNIfx1tIZqUOpqyzOAkk14Ml_zaWPN4N20Pux4vOhmxFuc2NXhP8GKzHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjFyfL40Q3VnZDxAmepeMTqm5Q1GoXJPmyqe_-vwbeSw&oe=6A491D50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-y3SbA8tZwQ7kNvwGfBtaL&_nc_oc=Adq8qkwVhUCn3lK50N9Tp_jaI2x6EqoAvoNWWywM9yVLgE1D5wJq8wE3Kvo_RCMi6fI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr0thspd3QsTlDPuBNEm6r-EecalKFlsFH22yJq0T84w&oe=6A490A3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZLPyHTZQQEQ7kNvwHFMgfg&_nc_oc=AdqC7uu73Lk-xN2NLxq0enhr24X8yJEuQPCTgQecd1rWNNrgfBtuFaNvndpqdN5CTOo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPtQynuH92uJzQ7m701-zqMb_-rrsBX1kyz2lLbvYxpw&oe=6A490B39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KN2DuSzXjmwQ7kNvwFuh69Y&_nc_oc=AdqoCELnr83OYQ-jXudmBA-R-uNZLxROVhXl4EHWly2W5MmtGYHo70oAykvWHdXsAWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbrZBD1N9Kcxfi7jUtj5Wf6p_xwyD2nCuCTNzhkBV26g&oe=6A4931CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSt3WpX8VmcQ7kNvwEFNJCe&_nc_oc=AdofOoJXs1JBX5vjT7WhD3ypny_Yj9U8Yd4hYpYrHrc1tLeYTWD1phrMMZDLILIY-5U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhIcdIfTtPuRRjfdPQWqTtBX-IxOoOVeCxyugTii58oQ&oe=6A49076E"}, {"file_name": "005.VS_M_Squar
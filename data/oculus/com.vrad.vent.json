om/v/t64.5771-25/473398297_978657034226177_6887405616059201056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6VrRP3TzOQQ7kNvwEbUm7y&_nc_oc=Adof1duK3o5lfGP5AcR6yHP0JQQ1SdhfycnWwBz8U3U8Mqba18LKuZ2jXmR27iN467c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-i1dybjHeJu_HZT-M0bjDrysV9Wn9I6JZHsxgXqJyKQ&oe=6AFF2F4A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPKYuv_dOhQQ7kNvwET_GEW&_nc_oc=AdrrmSm2SafjBfj_MKhlWhE9z5zRYLSrj8plkjCwIhleqBvrk6aMWAL5FnFXT_RGBC4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS58w6ui9CePZc9L_Xqst_DB5kzHL5T4ojB69ur6pZ0w&oe=6AFF095B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7czlspqb03kQ7kNvwHpE_dR&_nc_oc=AdodDabY-3_5leR2Wq353UoPjzFSmNZHZeaVtmTWsQUhGepcYH1_Cnzw89MHNapqYVA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJnbqN7Yr2-5KUVRXCdpT_OwrYxyxO61ZKoAKp9UmE5Q&oe=6AFF0C50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv352duMedYQ7kNvwEL5xu3&_nc_oc=Adqq6NaTUGsAzhbKfYJcv6_aRJ1GUu97OGt5dNcr01HYvzRGwJ2w0lwExTrhEZRFAf8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ11WPnxhJefAchBDCocLsfUakbUiBEIQ-NL1hXEGX29Q&oe=6AFF317C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2Az2bxZGw4Q7kNvwHNuQ2B&_nc_oc=Adpn2g_BSPerbK7E-IphywnmOEEqL79eLrj6addtN_qbccIy1fx1B8iN2L_Fy1N6rt8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ38jj3-P16nUZwtHRgs3buVUq4cRirQF880dzYSCxY1A&oe=6AFF3279"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxdJnAcPjZQQ7kNvwEnw18x&_nc_oc=AdpC8PRFY6y99A6SJhwM99XGIa95bHMpCbvalbSy_K9oXh1pbFbBFBwHjngkM_QmtQM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOH55nGABL-JUdRSR0s0xIMKmHyA_Nr0sLRwzCXdgU_Q&oe=6AFF20CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scont
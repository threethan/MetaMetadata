00_AfzWs2bX_RUx5fw565VNroKW1UDJuDXO9eunOmWdFCH_rw&oe=69B01A0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PFvivnz-6kQ7kNvwFBfQOi&_nc_oc=Adm7ZVgLg1cdUKtyoL0TODSjPDGxlX6ckqlzhzuAqE4ERqC9PQxFHV1TV0NiZya8TGE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyY4w6MNQrEIaQZBppzbw87C0Rcmbzsy_CCKOdMRDayMw&oe=69B02C5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDbPl3D6UgQQ7kNvwERHzWP&_nc_oc=AdmJQvdxJnCAIPG11LbBspZ7CHOmh82snpkyB5fBqaWI_dBXqfjL9OA17LVY7qq8SgY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkejMBHKCxPzFhIEieGXx63SAy0aL7AaSi9Zo04FFxMA&oe=69AFF710"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eS95haHL-AcQ7kNvwF_VOMy&_nc_oc=AdmgZnOSqXOy1wzZPVl2Qqf1DRdR9DrPA99lkPdcCt0P9SET7ldvjrWc13FDTEau5x0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQSvthsp6LurZqsI_-tKai0Iq3sm9eZoWKesZO98ga-g&oe=69B01C3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Mana
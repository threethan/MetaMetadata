t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5DHzHYPCR434O-pZcfsJq8F6Fj5ZiBfOlyKXDjmbtvA&oe=6AB9178A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX5iH9MiN94Q7kNvwEtoing&_nc_oc=AdqEkgUMyynwRqqgvt-6AKvBTCMJg7W9popKxwvcQr5yXqxOh-dqtCj4ISokF0MIIVM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiPpt7xTamvM98isuRA0UHbmnQ2pUZy1-JY-UFpcO02Q&oe=6AB929DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyKCoggzQ4AQ7kNvwFONot2&_nc_oc=AdriAX44xHO0yFpKwpd8XrH8gPYSLmc7AQpzwm-6R_qMpMuLhyCGM01DtYxfUs8WEYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv77Vy8Oo-au6kVmHu1nXEJ5oLRUtxmqBhLv_bJPLLGA&oe=6AB92CD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rnj2EjDbDyoQ7kNvwHMQej5&_nc_oc=AdrbHyGUnCr_dKgRFG-ZLwLXIB0CXerjEu8W3fXw_qC48Jcu2PKhTqldL5uz_t_S9eM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTwO6hb67Lpp1e28P43Kl2uHfq6xCAygJ4zR5ePo0oeQ&oe=6AB919BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28jBEDNvY0AQ7kNvwFkRghT&_nc_oc=AdrTFhzI6KVM0yyftorehRL_Mm0tPVCs7SvVjpjWaGfHbPTwbkrpZC3a5ffqEx-t7HU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSaDAkfmi3QUIuhJeaYiqSnPSknzZK9gy5w1cSwldCyg&oe=6AB91AB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2kXGhSLyywQ7kNvwFiVSzM&_nc_oc=Adp8GJAQ2IBlFSQ2Mz8Wx_kvcsUbu7anJmdQsvx0wKlxeOASakVuBA5UujFULTy7aso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKudMNy9jA8CfG-DuwMMQ6GwqshKZjgxwOWon8F8dHV7g&oe=6AB9090F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZznQoo2BxIQ7kNvwEWbDyj&_nc_oc=AdqO12AwNM4KLBoT9HkmMGbWVa-gH8eG8UyX0revCA-3TcFMFMpoEb--vPLLHyhN1vA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyCbdAXk6xHsV1fYG0M3JipQcp7708RQGp9Vksc3UkFw&oe=6AB916EE"}, {"file_name": "005.VS_M_Squar
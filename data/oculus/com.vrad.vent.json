nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55pTSeWekwio0PUqW4cRWPdRs8EmItLrXDHWNllyh92Q&oe=6A19920A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zUmP8AEiBoQ7kNvwEv9uaV&_nc_oc=Adp2gvaz5NsDvgM7fC1zGzCjy-a3SFZV1e-1zo6rXUpwgSZvFtxpfYIqyya1geIQN5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mJMFdkaHikHobbn5yNdsfif8mwF5SQLaUBVhKFYx3Dg&oe=6A19A45B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epSHC5mrwO4Q7kNvwH-rvRq&_nc_oc=Adr5vgo1GSNhAvyfUyaFz1661HXsozCs356r0c0CaURS73npErzYhrfe4wrPnHSLwlQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g36uUmBAs56Y5F0FHk-1ktnFM1BOnygon4CmynhvkjQ&oe=6A19A750"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDO9bNGTRL4Q7kNvwGxPP_w&_nc_oc=AdrhLBi4RZDuzspv4iD6gBPwKjljc43VVn1Svh6AHVl8mkhGhUjUMzuddCO6EhJvcU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k72n30IUK98erlxOrgVmpOCFcp6VeOMlnuIS5V3rSjw&oe=6A19943C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tszw6TIc1HcQ7kNvwGkHzZA&_nc_oc=Adrs-5YpjIkZgG5iyvgJTsSquR-BVOV9egfehu_KVL5ad2uy2CwMPEQ3KhdQ_Q0djZo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50dnmR-KbPxt0mV5w42doIN9nbQc4KnTQ-5Vc4Z0snvA&oe=6A199539"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1lcFZ4Jb_QQ7kNvwGqbB-y&_nc_oc=AdqZ-Xh5R7fhUVQdMp_qQQwJaiZZgZJq8B5Y-G9nJff4q3l4xPwWW5mmbrsYGf4zTyM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vb4D_ecrAfOvnrtUsLLwmO_YOUKQ-vOlAZsm7T4UhNw&oe=6A19838F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7AifoUfNWAQ7kNvwGMjPzx&_nc_oc=AdoHZ0GFdk4UFUuvoVzPppsJ1VGkVVysL8RQKwintKzsZVPprCabzyo5CT_2K4rTaBE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FtGanGoGQj6SFnGT_zoRJ5_5QKlEe_1dttCzqTRaW8g&oe=6A19916E"}, {"file_name": "005.VS_M_Squa
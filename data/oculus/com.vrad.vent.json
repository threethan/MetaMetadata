t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAVdAh-ZQo0Pj2eHy9NNLOlzQmvtqg3tyLH3YMMdaG1g&oe=6A6B4F0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2iPuJxBX5QQ7kNvwHSsnyC&_nc_oc=AdpcKh8G5_LQEnc4mgY2c7kJVYt8Jgj3M15Iullrm1ambjc3EHu-kNPBmO8atXsIics&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2_-se29AkdBsmKIC8HrCtBSMuUl2joRbRO6lRaupriQ&oe=6A6B615B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEcn-AgabqkQ7kNvwEAkmcR&_nc_oc=AdrxXovvpVXmUQI0bsg3AABIppP9Nutq_nFCb3xmN-6rV7AzGtQuGHi_err0KY9jW2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDeWPmLqkj9zgNma51laQm-qljPM90uRboRnSLLrusQQ&oe=6A6B6450"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5exsTduAFyUQ7kNvwEIUBUz&_nc_oc=Ado0PjXOgWLbgTH7nSO5NOoBDVX43LVMOdLn6JywTwHf_KIpNO0kFtEw8PXSbPXb_d4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYB0qeb3WZjiwYAnpUwQm1CPv_rFsuN2nTtnbjaFaCdA&oe=6A6B513C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dipxCrjN_cQ7kNvwEdF1-O&_nc_oc=AdoqWZNWoTVfDE0fzIewPRIycBgfMfZ27sHsAjmcI_eQMV2vjvAnFiTVIhapss4ycP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgvLwcZJTVywTQWQ913p_a1jQpWy7cnqfp88quBxSjMg&oe=6A6B5239"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwzBjVhkQmoQ7kNvwFlcmz2&_nc_oc=AdqmD69Q1EdBoYlEjgFLttbpuSOXZxtLME0G05wnaIXjpgBBMR7MiyjAav1EKYyGyls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw1yhL374webTZo1L8POdRDf4WN3E_sxsx7pwaS99Y3w&oe=6A6B408F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ31m3W2_2QQ7kNvwFb3mWI&_nc_oc=AdrNshxt7aO24xoJxYIxo5NqKVtunc2TfFCV8naVzGvxIpeH-9lBHnb5k22Tyb6rADw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWS8PJxj326mpv9BYSrMazoCSY9ztnHzJahCOwWjHSaA&oe=6A6B4E6E"}, {"file_name": "005.VS_M_Squar
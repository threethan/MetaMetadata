t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_0QtyTQYjX2rIDIVid-3fLFyaEhBz5jRTKUmdb6u6pw&oe=6ABA690A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX5iH9MiN94Q7kNvwFST9_A&_nc_oc=AdoT_c91feYIfU2LH-BBCpBiJIzCFUP_LNDSG2LrlRt5jhzj3b9kwEQ2oK9QHJoevVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMpWT2seokHCfVhAnp23H-9danbIyFixbdVkeYlTVJxA&oe=6ABA7B5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyKCoggzQ4AQ7kNvwGxu9ZW&_nc_oc=AdoPtiP903R9dIl0Kq14z9cOAe3cHMqv4QDU86rs-NiYU74mPQkFG4mPE04BQW5uhGI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj4XpdouuNYl2vGz2LHLOilk27awkVQEyXEXe6YWXSrw&oe=6ABA7E50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rnj2EjDbDyoQ7kNvwEonxPQ&_nc_oc=AdpTvg-7i6irBSR4pomtN4DLgFeU_quoQDUvxZlQns00GgzSzdN4Ii9wpF_ubv8CCWg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWFrHel92fbOa97L-1keatpr0RErGGOL0R1tDNUNvFwg&oe=6ABA6B3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28jBEDNvY0AQ7kNvwGgq_5o&_nc_oc=AdqfSxWzelPZFJLtqXbhUZD4_1x-wkKh9u1m5WJClVxl-S19Lg4W0nKvy1iqDaGjdaY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1vo1GTnTmlIAXLsMfY5MomHA1hRKx8RZjz0qIT5wKXQ&oe=6ABA6C39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2kXGhSLyywQ7kNvwEVk2vF&_nc_oc=AdqcR9WSu7rqee_qP4i5YBsebkfh_Dpc86t3k5t7cmYmHUuKtqvMaOoTCoz7u_IHso4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTmtZoUse2sFYBcKRw48fZYxNLUpfwa7PfM_af9eUWxQ&oe=6ABA5A8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZznQoo2BxIQ7kNvwEoz43d&_nc_oc=AdotwrTm9lJEZEMlZ5cB5V_j4TRi1CaQ9Bn1f-jCc4DLUwY7NX1eEjidiLKixiIRLqQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6Vzxej_258_HiDLhbNZjZHb0hnyNvr199HtILXsL7nQ&oe=6ABA686E"}, {"file_name": "005.VS_M_Squar
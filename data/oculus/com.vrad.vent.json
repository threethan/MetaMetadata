t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u8R0izhkK14l6de2ITMtrnQ95aRsn3Vvya2qdhyV5QQ&oe=6A2FFB8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pL38g3zFHvMQ7kNvwFefhnq&_nc_oc=AdoXbzj8AgAcd3nDT8PMVKarvpOsnNfpIe4QCTacSOwQxF-qzkE_lA_SGpw6kYC8ZyA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FEAxE9IX8Lp7I7n4GfBagB3EwUjKbuw0KzFz2sgx73w&oe=6A300DDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUtayMO5TJ8Q7kNvwHKgqi_&_nc_oc=AdqA2eTk4fHpWW1UFCfTg9SiPG_I1T0rsdAD68Vq2iRRntfshC1QuHHC5FVbQkerDmE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MSo47AWVYKHfIs9g1mKWjBF8Jc6hp_PiHPE5ERxvW4Q&oe=6A3010D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zy2fdWTBFYQ7kNvwGTbqGe&_nc_oc=AdqYZY3URQzVMdTkykAxR8JP1D1OrTSerQN7TpR6sp9-y05Dwyd83gR9EK4EqD5V5RY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qsPhJWwAD-HCdg9Yx_L1JjjxkGgVTDXbdgtrh44oFOw&oe=6A2FFDBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYRqWsiZkiEQ7kNvwHvxgJS&_nc_oc=Adr0Z8hOk0vSFDPs8c4Rk2R63FBs65uKypjQ5CSIQjkSUzzl5o8UsLk3Iw_i6R9CIEY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zGK4zts6plndlQ50yO-8ZFTyqsptb8GA3ZwC91gUX1A&oe=6A2FFEB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRyiLNWTzIAQ7kNvwHuT4OE&_nc_oc=AdoZrGccJQ_jmt4hAt1KdhA0cV8VkwzfSu1rE4wXHPlSsFxs5Riz9zz3EQGWtfjyjow&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cJB7TwWDc2F808aPTqh2xbCwxIb4gPz6tTTMBGmIBmA&oe=6A30254F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hJ1cbrh1SkQ7kNvwHJbBz-&_nc_oc=AdptJLvkzCON8W-a-Mha4GnFkr3ghl9ARgyb6tzLhlwRoW5uk_W9Uh0W5ZmhRIqTXjw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af831PYIWStRb_bqhXdA2moIZCA69s_FMN8I2Ne6dQjDGg&oe=6A2FFAEE"}, {"file_name": "005.VS_M_Squar
t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9obHHfRwnOWu_uGH441pWcN8SGE7siQcFk6VNbV0EA-w&oe=6A42708A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J21TwIQ3AVoQ7kNvwECxJzE&_nc_oc=AdrBGf6AHNQD6ea5g846H3zh8hnhdGt-PvqGRhrNDhkOg-RcVjx6t-7CWNs-dF4RIJk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OD-CDhp2cmnL9_X2zOclk9FbC7lIpv7IChIWBE4B9PQ&oe=6A4282DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH4wThQb0WsQ7kNvwHvUCao&_nc_oc=AdokdAGX7urhuYFawXoAyc-pLADcJqenf8p8nh6-Xaj5K1aoFlVPy4yniXw3W21Nifw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ppjdhgrSbdS0j5k60uer7Y9Qd9fT8BoC5X_MNHoY2lQ&oe=6A4285D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVYyrOgAsWUQ7kNvwFf5DNe&_nc_oc=AdqhBasfSHV3mSJlpE2PO2Bf8PHujWpEp8Vho50gzGK9iUcP6lB7qH2y_ZPt04Ihijs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iX1OWqaloHiFk3u7K0wb9QDhffPBX8A9LT3jEUzYDIA&oe=6A4272BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKj3lQHdwDoQ7kNvwFyMmbP&_nc_oc=AdpaDFo3u3G1BrarBzt4ZPrAKuRhhsKqCBBTqiSUcec58emva1qd2XJcJh-dOJ6B-V8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9is9VP77zawrbi3quRl0cpOaAN8iw74dXX486gGAFzUw&oe=6A4273B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGS1bCK3oHIQ7kNvwHcxFED&_nc_oc=AdoXpp1R_5TlmQByQNL_XbGg-zpTLPEDKzKeya6LBTsvxaZj5LCIvMdmRAPbiWoy8jU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S7n9ASAcxarvnQ-99a-dYGUzMZ4LR6emsQduwwyHMDA&oe=6A42620F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQbFzTWniPQQ7kNvwGm_c80&_nc_oc=Adp0hQE6vg2O1FEIqn4EyRKFyXqIGaVITnntTklanneYN7vMp0CyaV3HIkExffahAys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kes9KTAoxJJJ0cda4XZRzWXcSTmifWKeYvtjMSvE5Sg&oe=6A426FEE"}, {"file_name": "005.VS_M_Squar
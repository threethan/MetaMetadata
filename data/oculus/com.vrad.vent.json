t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKroYZ08V4pOVgdpBFaQCRBiATntNu5nd3eWtApALnFhQ&oe=6ABD0C0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhkdPXTQTjAQ7kNvwEFa_gq&_nc_oc=AdqbD2n4wbJ8lX9Oytlyks_DrMqnZuqTASqJ6EGqdYRFFqcY9aZzF92GgfjViFnC-Yc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFXAsOOnKiRW9J8KutXG73jxIx51WE-zEhgeh4rT3ceA&oe=6ABD1E5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZcAV9v2-vYQ7kNvwHwSVMC&_nc_oc=AdqHOWb0tmTpc9g8J78RUpFM5UjyZly8lLlA-rxwcCFDkScP_r5qTutO7IpQcWqiLXA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeRqDh5fY3b2bMkQ2sMO_KGHPFbmdb3JClPYsAgNgNDA&oe=6ABD2150"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwW8LOkh6AEQ7kNvwHoHEhe&_nc_oc=AdqnaCzLBlamH3gUjR3mTjTevmg0vg7NrozW-dLjRX7MZuAMAqD7MYYkK27HcU6Thyw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVJp-eMGyNLHTuHOAJW4oXRVfC9DdunX44gMYuABDV6A&oe=6ABD0E3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlmaJ6NC6_4Q7kNvwH-p10K&_nc_oc=AdqzRlJyyGHAsUjYxwV50zG5lcOhP5rXQW7-m6pi5Oyz6wBTpWDy0qJSa24ld8Q2Nig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi9cpFD2IQeNmEPMa_KA1JCuLEvLnsyBIQog1n2RsP0A&oe=6ABD0F39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojK3WYm6evoQ7kNvwHoE-SP&_nc_oc=AdqIGLtlGMbRy2YxuEid0jA-Va8_VeTAAKZjkRz60ifArG4IBB1Sxx7rc2lK-a_z0jg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrUo_tSlWdGGIwPnQBs9fuCUDiZ1eubg3TQpSj2MPRrQ&oe=6ABD35CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-Qt3MSvHDwQ7kNvwHEhoHm&_nc_oc=Adqcrtb9mVc3gEC9TIKONfvNNZhOCMhuHXONJk41P5cBNW3t2mnbY8xVHKQ40_kBLz8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCegYy0j-XUSWVKYjVrUUDxV_LjAhJntX031axgLbnbg&oe=6ABD0B6E"}, {"file_name": "005.VS_M_Squar
t-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByZ4Ku0LavA_t_178lwuf5reI8aG3z2Ec9uKkmpklVOg&oe=6A58DA0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8Noxq1D6EsQ7kNvwEIUNrr&_nc_oc=AdqTwrNb0Yb_rYQ8V3HyhRylA4qtU7CHg6_4ppJEt18kRaLA8b4PANIyNP-rE6akbJ8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOtFBIUBpPDcFMeghJx3MdFDNK3_EYS7pY66Lr_ED-QA&oe=6A58EC5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8frrxRr9SjgQ7kNvwHiuEe4&_nc_oc=AdpOdnNwI2LMbnit_gY8i0nbEig6XLsmmsZ8fUsc7iJHeck2wd7KPZwSOMsoeypWMds&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5wD6_95TH0YqDtvNs0Qs5_tAbP-rTGiWDcWs6h2xyWg&oe=6A58EF50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7iSRTLehp8Q7kNvwHJHO5u&_nc_oc=AdqVi5yFo4j8NLfwgVoklel1eyyj9cxMR7wVdWtvf9ewzPT74Z46_sPx0gcjPV-7bkQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrPNd0MwQ5Fill1bbhQn4ZnIgIv4D2wBAh6nBBykocxA&oe=6A58DC3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgwOjYp9kQQQ7kNvwFRFnQO&_nc_oc=AdqzjDNzZxPSOaJL5J27ujWyWlxV0r-J9OlGh-PJsLM0QetY4cSXNt-BM_aMRRWxGFc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9SEWNoZ2YbhyEAcOdBnS7aLgTO2A8piG3pdVU3E4eJQ&oe=6A58DD39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dInBEXhThBgQ7kNvwHlXnd3&_nc_oc=AdqTqbn_JY_lNqVBVUcj4dJc14ZmAWBL9cqv4Idt9_pHo3NBjB2p6b8PGU-4_sIuke0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQButyQ33dVD7IzuR91Pka4soXARZ_mlB1e0gjW2C0ax4g&oe=6A58CB8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79drDCGLzTMQ7kNvwFCcHdx&_nc_oc=AdpjkbMFMzGRnKHl3RzFY1w5iyfTBtOE7uQvln5hv7BG6ULfQRveFCN7EwxspbbBEoY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwaQZ_V15audYhzjNdjjCiEM47V5oxIUgbMskTUpKZAg&oe=6A58D96E"}, {"file_name": "005.VS_M_Squar
t-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgMHHDR5ln5NWnqdV3bJuuOaQN2rg3AStUkgbafyfjNA&oe=6AB6748A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3wslHyqwBIQ7kNvwH0xLU2&_nc_oc=AdpqbmgPTZKtAT1CuZKfhdoFsOqXt02E6NAf7sSHK-7VjzkV24ty0e_WBhbxQjGQma4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIV1r4dmZtu-KfLgkPDJVV4UCnLft7g5SpkjVGuDEmqvA&oe=6AB686DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4suU-tLKqkQ7kNvwEUM1mW&_nc_oc=AdoENRDrLTNaei0FafhBYJqVachulcKf6o4xMH_UI2WhVTwHIF78LzprC73qmIvRXM4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-bkOeYAMVkKMHOaFr2Und0zXgGcWCfKolpf7XmJOL2Q&oe=6AB689D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksh43zRtcMgQ7kNvwHRgs3D&_nc_oc=Adp9Sx1Dh8VY52V2sGRbZGqmLdQPjiXJGjS6yJcMaDzea4_qDoeLDWZAlzKZV5a0s0s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0cr36qhud5parlmJn6YJTPBlTi2vChzBSVF1vmQCoIw&oe=6AB676BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hSr71QnElYQ7kNvwHXkF7_&_nc_oc=AdrZ-m_dkiPtL3mffPEDavPowzieMz1MMcio3L32GoK_PbP8DZ5K88CavKD5Ny_kUZ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgewz16exVghOO1ulocJHmiQ_E5UnkuSER5NFyhnI91A&oe=6AB677B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JglgrTkEtEgQ7kNvwEw_oo1&_nc_oc=Adqm9VwPdI6W7XWlWz2x1egGIa08JomxqM5EEYxOWLX7qAvh8pL60Yd0gaPBQQeb_IA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLujqGoBeV-46hStr37ND5fEMcyP3iDkKDKYqH1VsRm2A&oe=6AB69E4F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FPrLB6mCFkQ7kNvwE-kqCW&_nc_oc=AdrH_lWVDzujdJo1IR7Gc_713_LJ40r7N2RbLO0B9yn6KYFPVhvoUY2QqKwpFGbE64Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqeQSFUcdmuHFPxMlDZBWtZR5JnnxcOwewgO4Knp71Ow&oe=6AB673EE"}, {"file_name": "005.VS_M_Squar
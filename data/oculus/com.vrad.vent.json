00_Afx7a9rhvxzYQImsM44PPS2HAqhQW-pgtZDsVLURFT-Xww&oe=69BBF78A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxiwveaV1FwQ7kNvwFQKcoS&_nc_oc=Adm02Qoju803jsDFWnWIbEHJazvq9a6rLiQQq2tvY8q-DT3Sii_izvLKLWyKtnYmwO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyjSKx1y8SNjlzpzzAbJhIe2zDSBloYyIOgJk_bthlsRg&oe=69BC09DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3vQC9FEuq8Q7kNvwGEGGhe&_nc_oc=Adm0xjHEl1l77_McJafbNjlJoP7-vYMyPNVnmoR8qrs8PCiL1bxMKz4_wX_OF8NlDI0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_9eZB7r8wDjrqG026voUjGkWkVgaXb3_aNoLYBWQo4g&oe=69BC0CD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsCH58M0HJ8Q7kNvwFEOQab&_nc_oc=AdlkU1S7OR0gzP4T5KyCl_4qbIXX3tfaQmXHDtBMwAp7eaXNQJRlqfXWsNGrm5PnkUU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDiSIQ2Ih0qrvIQBGW8IbNrf33CEgJ4O-VuITIgMlLnw&oe=69BBF9BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Mana
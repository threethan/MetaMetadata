t-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNPQgJZbh1-a0Ryy4Sj4Uf-jBg5TIo4xJbbm-UnMwE6g&oe=6A918A8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl580H2ugcwQ7kNvwFkWP9E&_nc_oc=AdoMNEnvHDl_5WK2UsCdsF7P3RwAdMTcNukmf9lLQD94rq_CxthCPJwbajkeFNaSZyY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdl9cfbYeVc6vK1K3hQsbhgsQtC-wL5LzdwJD_ovHnqQ&oe=6A91649B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxErFZT7CdMQ7kNvwF3GDE_&_nc_oc=AdoinTrb_gHzCMMezu02Qp87hT2_8OJ_XJ5D_FyD8CY7ph_67HE_TWXoRaRUKrj6QJ8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUVE5JAszf3EQG5qloxwyiCb7WvMc44l0FJ-CIoi0b3Q&oe=6A916790"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nfv13Aj5h5oQ7kNvwFCFX24&_nc_oc=AdrQ6CTkefDIPrHD4HxtwmOMRxSa7Ies07eGslZum4YxoUi-tFZS2ZobfYCd_OKRpeo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyR31FMKt1dNhLx0bdogqtrUKFi3plyUgdqnNGY2bcKw&oe=6A918CBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRmY5lMNce8Q7kNvwHKxOSY&_nc_oc=AdppiXmppY3ReVuj0FCClXaXq3f7kLj2cTLulC5-lqfnnIO79Ma_i8woYUqBI08bCZg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGsfSvwStuBzCMo71jcvF_x1NEB13-S0fsCgUWP__Dnw&oe=6A918DB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJjt3VfF93YQ7kNvwETlFPA&_nc_oc=AdoNbdEb6oaoZ4y9r7ftk-7hvBC04o5hqqCw0ABhC4IO4nWznJcmE5oXgaBlKPqNaeI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSdZmCz38bHst4_mleKp3otFGR1tH_SbAKtlMg2iIf9g&oe=6A917C0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnWcGRpN9CMQ7kNvwFF71BV&_nc_oc=AdrViWJzbb-ZCZNUmqi--KPxXag3my2jQImgcE3tPIrMST2KPg08cq6ilgHOXToLAGo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-r-Mr6ifjO9npxBx74FMetPtOmrKGkzGVL6jOQvkMNw&oe=6A9189EE"}, {"file_name": "005.VS_M_Squar
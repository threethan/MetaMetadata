nt-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHK9ni_6yCfRfFi-O113JMq46BuWd4u_HgKggb9JgZ5A&oe=69CE6C8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkFsmKbrK88Q7kNvwH3lymi&_nc_oc=AdpXRdrqCTG3Gj73ffKgjrdPr5YhZkofYZENy4q9e3sM5LzpFqXrtZ6KWIfb0zEqhsI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwh4ZKDkBBxGqnDA0QlPEs-lnqaXH4ULKersq83HXm9cQ&oe=69CE7EDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AGsrgJGFZ4Q7kNvwGckUrQ&_nc_oc=AdpMM3D2N1N6bLlYb-1oI6awAAWikYpk6s-ifd4e7cBNLa4CiyyeUeN9EAwiz6h-2bA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8gKR5MhKjchKr1_vyTXbxGmk89T9ub2K1DTLQf7XDbA&oe=69CE81D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxkM1js7jAkQ7kNvwG-Ds5Y&_nc_oc=AdqxGL4L00RmT6gN3bLeGI_dMH8CdRcHc8EriBhNBOVKxLBIZu3ebd-iMcOOgrfDG9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRte_FrAzn9paz_lLsmkOt-KRHHg1IDOwkxsyLcFpJ5A&oe=69CE6EBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9NyX6NbhUoQ7kNvwGswkU2&_nc_oc=AdoNkOECFUs5OZuCuYqeBxWKQEIt93w7-P2_qnifo7BibVcjdhEMjO0oJ27rLMctfaQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrNRwTWE-eBk7O7KdVpVHA1YncsnISDPoTwrVydmwCiA&oe=69CE6FB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zWA0cJdpU8Q7kNvwFwg-Fr&_nc_oc=Adq-z5vm91E0-REZMHc-hDTs1iKdyzOH5xRmJ4nIRklBmYaegEoW7G_lYPbjFW1Eysw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfE_iviMgwv4nVEm3_LR4s2XK56aNpKoiGEAJkU08owA&oe=69CE5E0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_3e4xfRFFEQ7kNvwF5JNrH&_nc_oc=Adrg0m2urZMs-9G5mlm3EgHuMXVby1G8ZSly4FMTLpcRRPKITzIXgJa8Sgz13WySJLo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqQTx8daBY1yYYi-ZhnNC04uvOeGJkCAvRGn8JslNZyg&oe=69CE6BEE"}, {"file_name": "005.VS_M_Squa
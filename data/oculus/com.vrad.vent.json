nt-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxltnANYuezP1o3Jf1hHouCIF5-bb3FVyabEnVCqNstPA&oe=69CA780A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1kTGrUqHd0Q7kNvwEPkf2j&_nc_oc=AdpJ_1X665YQ296DLa9T-wy7fkXBgl32f-JS7_SnG4vFuJBsS-XEzG-oa8Kg2sVgEkc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoJF2iMMS6HxuntNRgjOcSg53FrLR_J7d01qZPH3nJlQ&oe=69CA8A5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90UpE6QjEMYQ7kNvwEarmfE&_nc_oc=AdpWcgD3PQVzEaKcen9wPRSKps12A9tfBrdiuAcvztZgIFkRdBaPNCTqXV2pZHXSMlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZ4a-0XGIzk8K-8y9sQjBmFWtyfLoIGkPN3vgauw59Rg&oe=69CA8D50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n48HfboXMRsQ7kNvwHM8vBV&_nc_oc=Adp2kJXEBenyAkIYjym1JsJb4kRh0BBx9VElusRWyGdgfoB7EIVNv6ezLA4J_nbyaHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxe2ll9KLsLuKF5wKKr9SLhK9jmb_eGCkrkb-Hbydr8jA&oe=69CA7A3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSyMEoSPv1sQ7kNvwHjEYH-&_nc_oc=Adrp63ftiaidvqVQMzt-5MZYf2AO7xupLM_ExTFeHgDfYMPf1bv7wXF4S7x5tLvQJSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWaYOPi6Vlb5WUeXVKTYwJMJRmEba3p1HsgOTmGDM0Og&oe=69CA7B39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCihCAGVyTcQ7kNvwHdN2ce&_nc_oc=AdpPDfGIMQeewKvYOH4p2IGG1DPboSFrleQqLCKMo5prHu6N_V8kh-z3KXF6jOyWLvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxblRNPT5rFQ3scmvTqmmGbd3FwZk6CJcbaKta7IREZTQ&oe=69CA698F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVGwYRmwkb4Q7kNvwEipwaN&_nc_oc=Adr8Iz0-GWzZ0NTW_ZJWt6RU4QO11gAvIHAtNdSQn5Kcb5z0vBdyLZ77cPIrYhZC-Us&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHnpfQ4njfHEV1z2W0JZSnY3wb1dILLTKddtGENLUbnA&oe=69CA776E"}, {"file_name": "005.VS_M_Squa
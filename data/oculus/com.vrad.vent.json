00_AfzfOqvsOCYGbUm_HN4-_NwQR65PztIguCVG7BnDtR_GRw&oe=69B8030A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBiF08zHsuUQ7kNvwF-Z-E5&_nc_oc=Adll2Hgqgi3wZJ3kJF-Jvp244VkwQ1FGjCo2MZEF0R3vOhBApzOcSIY2CVX_ddHPmk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzmWjnDAoP0uLbudJwf3a7tI7rYevdY5tFl1NAUJLl6rw&oe=69B8155B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=red2Wz2n1lsQ7kNvwHpT3Xx&_nc_oc=Adn9agJIFOWzGlQy-B1vj-Io8WSvKICO9wxRWHLgFGBPGlxTxC2ujX170wya6DIy3kU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwygyQqdf7e9tQLI5ZSnG3rMJjVJSc8w85E6pEEAUqcAg&oe=69B7E010"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw20SYnDC68Q7kNvwF6vBnb&_nc_oc=AdmnpK_PpWfhjsA9_8Zt89Brm9bp1_ECcSEjm8uoF4Eo0t2IKihVgtOUthPYIug_kAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6d7hW5XTP5OrXiVrBA6q_dIm6zq8CHx5tvrOZtuOSPw&oe=69B8053C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Mana
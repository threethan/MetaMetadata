nt-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WE6fLrFUgcU4ZuSeeYG-oNIVc6QxRCDMxOjHczvFmFg&oe=69EF620A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sz6PRrUm3TwQ7kNvwEmQEe6&_nc_oc=AdrkPnzq_j2_tdF5DtfXxhMQNNUI3Jk-X7F-6P74wDTNBoGyxykeLg8p0rWlyXPeKoc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RLrfVnoWTQfg74X07PJ_cWT76NMR0GYQ4PKhXSBiE_Q&oe=69EF745B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_oaL1F1jrsQ7kNvwEhn9bm&_nc_oc=Ado6AEtxtPht0B5kIMGg6V_1kavWcQmVhyswT_joHrjCpJIpHxpnQ7Mwj51Ccgcu-_I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1c4fLFl77ST9cL4g0lpAlKo1W8PePAtYTQbcKN0fGQJA&oe=69EF7750"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsQHF9UMeW4Q7kNvwGZWK5s&_nc_oc=Adq0YtGwKGdA0ys5WNvQ3SXF69ijMkNwR7_0l_weaxGhaxQpUd3vtxN23kMyCYh8OeA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3YyNncNig7sRF0f8KszZVuCY1uVMkyzKtG4rlT4jmAYg&oe=69EF643C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phflibVKalYQ7kNvwFxIMUI&_nc_oc=AdobAxxD88SGD6xSDF51QcWNzg5KOKKXA9V3bCNCKKR3mjUvEbkYoBvZqCYWs6czB-E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3YnAgzoNKT_MEZG7nL7K4YxLDZOKanPAqeM3HuKW_KXQ&oe=69EF6539"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtYsI47FTY8Q7kNvwE_NK6p&_nc_oc=Adobdw4gxjKULzi6uHRAH1qH4_FoCLMKAk0-MWjC7qHpRF0wItbJ-GLt9tASURZXdlQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00guuud-UwFd10QWtRGPNsiarJK4xozExO9C25p0JtQQ&oe=69EF538F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Bq-LdqmXiYQ7kNvwHfvTTq&_nc_oc=Adr0w6qPchMvdHXcqsMPorxvzHh1-0C33WNilgN6Tkn74HWEI2BF9Nzie_WPXVN0Sb0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0W-bEJiNPzGGbVpE_OY9RtyXepw3t7DF1PXMpTx5uVsA&oe=69EF616E"}, {"file_name": "005.VS_M_Squa
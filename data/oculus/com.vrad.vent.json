00_AfxorkGZ6LvhtVdisFAsLK_UaR1WYtZxztHtzWUY6K5mRw&oe=69B40E8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA2QBiR_C_AQ7kNvwFL6Kbk&_nc_oc=Adl8CopUDhMmLwonNpMYQ53fgspmLwjbL7Soa3K2iUCwPgwuQ5HRKgX_GQEpVfNMTJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8Xlb21g3ouQXQ8lCzNRt91NX2_JfJOPnOfBrZUTk_8g&oe=69B420DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HL51a78lJmMQ7kNvwEOLTHV&_nc_oc=AdnhS0k0r4NWI8CSqHljEZwfutaPCrVbfs9GGUmWEb-5JiqCjk2LBNdbdFNT8IYAP1c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwuLIKUt3rwfoNpsp0va1CUK5pE0StUy2iGQNErTj9jGQ&oe=69B3EB90"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJiCnbzV1DkQ7kNvwFEJTEB&_nc_oc=AdnOR0hEL53ZKNMu6kbXVd-VqWxyrF9Kbrwpo1wDjYVLoilV2VVpw0M9e1FxOS0QTFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw39f_0GeKjuGAUKnQO96VHGYs-Bc9jg32PvKgO_OWU3A&oe=69B410BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Mana
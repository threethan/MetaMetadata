t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-f3wKDFLtXdXe4yOhMRMKdzvmnjCCb-iPFq-jWhJUuA&oe=6ADE018A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBZLJmCqgvgQ7kNvwELNYdo&_nc_oc=AdqTl9woBStduJaoIk7pU1uyAJr0uCs454hox9EOH2-FMAmLAmiVz2EjX6POMZ6GGGs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgt94oE2xYc6Zde_b1Tz3d8-4Hg3pNvgrqOLR7n7CTdw&oe=6ADE13DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wkb7ApE9VP4Q7kNvwH2Q7ku&_nc_oc=Ado4kUHZc7wt6MYhDL5czbGqBxOtX71e8m2RdVwmai45cIoKk_I9yOSOUnXCbG8XraQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVqvSBN8C7UlfrLQORHyP-CtDJWwH8Mh4Xh01CKwY7pQ&oe=6ADE16D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgnB7dbjWiEQ7kNvwGGC4uG&_nc_oc=AdpHBsnh79dq9TItg1YcljstBCZ_3Qdni0_woCGUy-KIzwo4y3fkdw4WFtWHOCIR0fs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOATKbMKEab5KKanrZqGOYbea5LvOAplb1U6PXHhpkhUQ&oe=6ADE03BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Zo8JSch4_oQ7kNvwE4HiXy&_nc_oc=AdqUTh-cDxe4WWyzDEiJTcMQkNDXDwDpxv2jvEKaYKtfobZH-e9WU9Onjzuc99aYx-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZdIf4LDGS6f7C3MHuDFINMTrR5_cbt_b8-YGeeiKikg&oe=6ADE04B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GjrNW12ymAQ7kNvwFWp8BQ&_nc_oc=AdqnYiTd1_DPiCSJr8p7wzeyxA5NZJ6bPFNStR11cEF94whm5JiVUqAvLeN4DNjp9Nw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOP3gJHK_vvD-edZfF0wqXFvIi21UCvgW3UPoSt-6GajA&oe=6ADDF30F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHeAbuXY0iAQ7kNvwE1jg2G&_nc_oc=AdqVZy7mjBJYn4VTWo2XRVYHgElS6_eaotFHLIKe745WopE815ZECGIFJUJRoKBsaVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBI_GLY_XrU-qXHTLB2k3tzuNN9KemkQI8vsOcOPJ2Mw&oe=6ADE00EE"}, {"file_name": "005.VS_M_Squar
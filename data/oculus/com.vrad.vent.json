00_Aft25OD_Q5VtdgeXV7qbhV7wJRx-6D4FGWU4VkJxXLyqRw&oe=69A9828A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcTSex9JUMMQ7kNvwF2RGQA&_nc_oc=Adkfem0GaDUqPBNW8E6HgAp02eqZ5gHdaxEOu7s3WQ_zAqc6dy4Yu8w02mGxDB-Zs6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfveTtfWZG94hISo0Y3UUv0WDvqfW2KJT0WwJRZHB8BV9w&oe=69A994DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAKD9ghMBfIQ7kNvwGPMt_D&_nc_oc=AdmRAPoJRouWh6qJuqOXFAFQH7dKDXhdRoOcCY3MBJIW37M9uA4ee-Vo8tcSDsRZxoE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvLh8Njyc2zMXp05QfmqMz0t_e6EXRWJG_fcvy2ghF4YQ&oe=69A997D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PpYnIBKKD8Q7kNvwE9RQ_8&_nc_oc=Admhty8UNCkfypM9VRHtg5VkfkPEJhYLXl-geXE9g1cswPAI5gbV8sAf2CHtoAWZvoY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afvb1f8_9oQVduSg06xRCxfP2OKBoLimW0tCQiKbX7s8hg&oe=69A984BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0EJePwvW6AQ7kNvwE54h9J&_nc_oc=Adn9PTiio2sT-LfmAbzVl1caITyeNij-wWqIpmwdf0bQ2PnAFNChIaQbp7-qwr9E2To&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsGaxQQxtUT6rgLfPKAlbTEdhrVFwBv0qGR1-V5MuXfCQ&oe=69A985B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXMeXmZpT9AQ7kNvwHEe1qT&_nc_oc=AdnafBxMWVaguO3WP9JN_pnJhP20JL2dKrPITkltbIF8nmJVbJ0Tl9xWLd8GyrCfz-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfssNX7Vj5l7bIT3FBozhppAPc_OPYJmdjlOhH__PIgiBg&oe=69A9740F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L9LOZYh-9MQ7kNvwH9i1zq&_nc_oc=AdlV3M4hVfSaEdRRdgkAILhoY8mREDGRA4YQa30Usu8yUmJorRf66gLNAMPc73RWCH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvYlnYA4EUAPB-bEmA606qktHc5Iz43HxfMV84GJ8ADHQ&oe=69A981EE"}, {"file_name": "005.VS_M_Square.png", "id": "1158833709586565", "image_type": "APP_IMG_COVER_
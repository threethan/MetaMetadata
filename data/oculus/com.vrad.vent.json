t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hQIoIN_L7Wh7oSsncCPsZ6p8AZ3Kd8PxW_xJ5PmiQDw&oe=6A3BD90A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTfmLGeR82QQ7kNvwH3P9WR&_nc_oc=AdrQjhLPJ5-rAPgNP8jPddWSH-kefUK5zk2AkE4gA8oEKfko0PVu7VnpdlMZ4GoJDrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cmPKUJLFTRbMS9w8YwjtiAL2wAuWmBilbB3X3puo6aQ&oe=6A3BEB5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6U7mnzY9iMEQ7kNvwEp_Fih&_nc_oc=AdqDnM5t87rMTCnkgfTmqi60iDSXzxGiIbYtq5E6CrAlxlG5YvO1OrPBBJipvvIpCtI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZzQdDvE3tb8nV8Cw-MwksCbWD5Kc7E0xYaLaL-epyDw&oe=6A3BEE50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRy0iIwWsKYQ7kNvwGUKNxS&_nc_oc=AdoSO35WC8kNT7ImicM9nYeneHHHGBPJkYha34tQAGDssxSFjnsWmB2fNpMD7D8r6lI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80PExVaJBFWtXJ-yaLe9k7GAFJjKE3OPQGMs2Wi9ySIQ&oe=6A3BDB3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1S4oJQbJyUQ7kNvwEtbnxp&_nc_oc=Adq04eOCXKmkuWMbvxfru_zJdK0dq370H6M2QKLM5nnkcRDx5eQDjh6sV0HOqtSXR3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2KDuyjzzEr_y6VRXHFFFGwkT3zMCUNZInCP92qdX3Mw&oe=6A3BDC39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hFLtvexsd0Q7kNvwFzITLi&_nc_oc=AdpvnfJd-UwKNm23vFMUMWXJCaHsZrKh9XkjXxS05STJIr11yzjMjgcQTqo407bH9yE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OvuhZuMETam8RiWTiwuZbPFmnYehUEBwKQSKbUDj5oQ&oe=6A3C02CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDgfr1NAbQcQ7kNvwGO6dn-&_nc_oc=AdqDG9LLdiHPvEG3pe4OhL-RbJDV70xGxQOBpW7lX7GgEGnhYOQ-EBQHTCrbpMr__RU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Haip66P3CFVebDfaRE5sGQp6yQ9I_wXsGQQly7-CmpQ&oe=6A3BD86E"}, {"file_name": "005.VS_M_Squar
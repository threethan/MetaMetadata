nt-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VNwNOOMzrrenrdKZR9kR1boq2A9_JKuHrgF3BYvTcQQ&oe=69D7A70A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnzWL-xWQrIQ7kNvwGJ3Lw3&_nc_oc=Adp8kBf8wvPVb-Bv0x9LjdIWxh34yh_JMAbQ29G6fFibPEm7u0hGP1A5CQ6dHELP8MY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3g2uPyPsO8rICEkM-ZBctbNUeuXs_g2GEfraGAOdWDzw&oe=69D7B95B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEZfw3-ihSkQ7kNvwGiy8u1&_nc_oc=AdpYndEwqox3Y52j0svkEuLvyFPXUOWQTegmsQnRogxOYDmhv_m9NIQmR_fS6KtAR1g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xHaUTCQ4PcqE-zAdSrlbJDbXSgB8VumrUUPm8-R5Nmw&oe=69D7BC50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GeFJ43zm_gQ7kNvwGzChIp&_nc_oc=AdpMxegCWWcY9rGevaEQ6MZT1cJQRqs0CHbLGokRcZMF6A3bpSDXX6FMQi-Qb02nULM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qy0or3UaU4GHKXjHq2WOxpwqF2h-RcZC2yCsDf3Za1A&oe=69D7A93C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ofkddorg1O8Q7kNvwHzdZ4S&_nc_oc=AdrT6PApRYjIiSTIUuhnPylrlYHJ9UD41x43g29mJsvpM935tYsvIHAsAEraFgv0Lds&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00zv6yW6a_cS8B0GJLwgBofPNa_zlvGxRjud9T5Yg8Ug&oe=69D7AA39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKwPrefWOtsQ7kNvwEN8MdU&_nc_oc=AdoAUjibG4T6Gq7y9YapG6vp4z-8KHPteLKMrXnL_maUo9Zo5F9NRCChThEmviVUXYw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dtxHb0CW83RrMHMEtoPnNmwrlVEGfkwYe_6HIyidpTA&oe=69D7988F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwlGWzeIDlAQ7kNvwFMk8Mr&_nc_oc=Adrzv4RHwVvZIkAdtrotYdSxXVh54SgeDPK_lF8Ntdy_W8_o_N3A1Jd8zL1VEV0jp-Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Gk68yKaqQ9U50vM3MeUzTTAZybePmhHUL37Hg3RyLbA&oe=69D7A66E"}, {"file_name": "005.VS_M_Squa
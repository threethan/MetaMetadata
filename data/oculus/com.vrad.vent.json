t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtz1oZ8qAbteCk9e04MDqKGBYUefvKabvDkKMuTDSv3g&oe=6A64B78A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKKF7Ew41SYQ7kNvwFr-njd&_nc_oc=AdorHyRGGahxh74rc2U6lXWgglsO8WpsQD2LTrAAK6LEKIlrWEz5cEanLio305Hiq7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwgepiR24mKu6TCasZMD0HAr7tMoxlmjBSJxw65RyXvg&oe=6A64C9DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoYubHXU-dUQ7kNvwEwxeFU&_nc_oc=AdrvbjiS2ls2xDGBJ-xS2Aw6zroirZ74W4siH8WSkml3KFw7I18UBqeA7BVMA8UVv3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJ-moYv5uDFysNkgfmoOd7LghpFbtU9AN7Ti4Mn1Frhw&oe=6A64CCD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYdJEYx51EcQ7kNvwHFp8un&_nc_oc=AdpQFdXFgTBKWsQc2_6dJI1C1EaxxT4WymkVN8QZjzkEwI_GSFsqoI-R8lgurE9P42M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOMrgOBWRSv8rWfEplGelZSJQjgShfJnlLtGQgshTnpA&oe=6A64B9BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi7I7b0iyKYQ7kNvwHUg-qg&_nc_oc=AdqC5raoxp1r1i6TZ_Nc6UAO9OtO9bDFSmygwdr0HDLzWPISGtyjP1d3K25nNeqC-bw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1bHlEuGBOmPi_QVMKQpKAp3INf7nJhm39c1B-q4DOIw&oe=6A64BAB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajS-6fp3p7UQ7kNvwEWEM1G&_nc_oc=AdpysMq0MGjyNqDeaiiABzuOk3EO94WJcp9MQHBuNxJjqVZkLLmlWn1bE00UIpse4ik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9ZdBtmJpm3Jk9lY0sKGWLxLyMiDBrYvewc4qBpQEP_g&oe=6A64A90F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA_uDSUK5HwQ7kNvwGDCH1i&_nc_oc=Adpv0ZmRkouhG_GRYNpkV0jxK1BzAN2yynNIFxMVIGcVHTYeUCWOVwoD__8YVhJKFUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpzs6qtkc1RfhVoqZXhq7ZO44Iaq7g7mTMm80b4Qgxew&oe=6A64B6EE"}, {"file_name": "005.VS_M_Squar
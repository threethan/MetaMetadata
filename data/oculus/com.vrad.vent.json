c_ss=8&oh=00_AfymGyO-FmmZ0NpmeV3itKXn88R0zBJ85gfAnGX_jQpimg&oe=69AAD40A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcTSex9JUMMQ7kNvwHFSxiP&_nc_oc=AdmwxpCha6pBKcRPuutBtawHKcO1yPcyQNPUD6GS3QnWvYYgP3bpA_5pZ2ajdEeIfZ8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQZy4D_TT9i2w1mD_nipctUXamPWzniXtBdrgf3EY4ww&oe=69AAE65B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJKgtBHkFrIQ7kNvwGH0_i5&_nc_oc=AdmzrfYw6l8JpBKH3-rxJ4KoZ0D0PPCrRfvkTXwyNSOZir_LmGMwr42vi-G6HtsDMa4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyIkPpQr568WLhrMhX3wXUrHRHoxDLIu0UO1ZFXJ-OWjw&oe=69AAB110"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F4980xzt60Q7kNvwGyDF8_&_nc_oc=Admw5Sgw5aoORENO8jWItvWiJZ2zV8MQhKFq2HwJIQMqyesfNHhJVKaWhnGDVlvoQTw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3F6oPaN8tDkT8T4yqcDHAkjN0HYiy7-ba0MGlZF0mtw&oe=69AAD63C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0EJePwvW6AQ7kNvwFmxHBZ&_nc_oc=Adn_ofdQsHkFjSRynmIsOpj39VIqM3c5B0945g-T82QlznPtiAIq5Exi3QEC9uZXizo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afx49MgxihvnHRwb3GLnf7rPPZs2oERkz4zMj3yxyriILw&oe=69AAD739"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXMeXmZpT9AQ7kNvwHyebS-&_nc_oc=AdnC6xIJQeg3oVrSqBcF9weq5OEvL9smrTp3JDVme01YXwl9YsrZmmb29IjzqyAsfP4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyK_N1OWE05wCZpA8cFYfZPKEx8eLRE6CqimTQMcsCQZg&oe=69AAC58F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfCDVmGv73UQ7kNvwGJqKXg&_nc_oc=AdlCQxYcsvPR8aDasOCQtmk124lwiiYl92KpOula3c1LG0DM7SkP0qFAOXe-ghjoVCw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfynniAq960o6k7yrNyjMQ3AMpzFn-s5MJ5hNhwOxgtNEw&oe=69AAD36E"}, {"file_name": "005.VS_M_Square.png", "id": "1158833709586565", "image_type": "
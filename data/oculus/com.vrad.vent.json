t-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCz1HE7LolJSjcsMEAPKR027S5sn9eOgiAHkYzsYEIyqw&oe=6A53940A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2TcUWpgFfoQ7kNvwGmgRex&_nc_oc=Ado_JdkU-zHTohDZ5e4854N3b2AIsrmhqD3ZrrLD07pK_hCmgcG6hAdFysrHKK5ERPg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACWDzu-5MJMh55Tz9t6aey5092XT7g5kjZNhDnj-RN5w&oe=6A53A65B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVw7ZTxZA1UQ7kNvwEA7gM-&_nc_oc=Adq2U08tiZ-rLyt9v5OLA6_rwTJMG5EaC8RsPQHtNJY_J4dUueYu4uf3tehNexxCtrs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqQKcvnCb8j8ddULsNbU_FkWpL48oY8HK3Cz8GQ9vHHw&oe=6A53A950"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C84_FBpQsuUQ7kNvwETcxnj&_nc_oc=AdqKxm1lEXt2JBpmKYYNFst18vdoNDZ3GUTo787zAVVyPDX1rt4LygQdOrlCpfB5zoQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNWqXTDMzp36NvZUnbu4mL3p0ZFzSQH-qyxHZvqmmfRA&oe=6A53963C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fI811W360-MQ7kNvwHgHJaM&_nc_oc=AdrbTrle0TNIPKFJLAzWU7l-WAjV9kCblXKPiD6pzlqq7Un9AaVYHIyTlwFtgQDx9Jw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAE081bzhPIX0bIEI6w_1w5BQmuVcYr15TbFS8D-mBdBA&oe=6A539739"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJv0K-9RsXUQ7kNvwHXht3f&_nc_oc=AdrhP3X77D2rf5xyFyk9aHmm7lDhBCEFV3zNXLtxezyTakVlhEJdCl8JuY2rifv-ThQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5P4VNbLJRZ1N5QYp0SCP9GG0n_Z1qWnUvVIrd5O2IbQ&oe=6A53858F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7p3GUYJqm80Q7kNvwGci1e0&_nc_oc=Adrj_dUz-3Rq15-tyPTST3zPavh3Q5-AXs5V7k1hVQElTLLm_hL93hQ-qMMzLdZgNBs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsGJ3qaPSM7YYZJ0XUu_Y9u8layl41p2Gvg1GoJwcdig&oe=6A53936E"}, {"file_name": "005.VS_M_Squar
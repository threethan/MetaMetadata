00_AfzmmhIjifsfN_nZpxaKoyTT5-BrejgOi-jfcFJCq4pIHg&oe=69C13D8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAhuPs_73aAQ7kNvwG7pYG7&_nc_oc=Adp75NGQm1A-y_4v2m7QORUAH8u5DpUBf_09sCwbj6PecjDiiPMF_g6dj7c0brSGoKA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2KfnMlgE-R5GPUB6W6vAf2WFLH1FxrykRxZcPMJsagA&oe=69C14FDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0oLy8kvAzsQ7kNvwGOScv5&_nc_oc=Adp76L4NwIVEQtIHRi4_Jg3IEmNJoN7X8K84ioiObyVAGqjpK6ZbN3sWs4YdvvJ9vno&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlvXY6w5KEjzFirMHGSwlmQSMwQ0a_SgOEck8epJIdDg&oe=69C11A90"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KbGYPk-YywQ7kNvwEdpQLT&_nc_oc=AdrTbMFRtawomX-mZRorajzrXjpylquuxEMKGiABqWGd5Vm0NwpKOH-LHLjGnkzqhX8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwb6jZ5O0U6FvVb_8Ni4JBLlxuCsFnc5qIcwsvsFo2sgg&oe=69C13FBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Mana
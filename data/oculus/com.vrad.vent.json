nt-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sJvZM83v2-KEBrM6mWNn0EMgF3Y2m05GFT45WDtfz-g&oe=6A217B0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LFImWEommwQ7kNvwG4ZzCw&_nc_oc=Adpee3rNDggVZhDygwFVscd8OfjysKk_9LSFixdPBz5ieaVNXVgIaoslAKOo_Ba1vMs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RbZaKx-JbjbPnauG0_ULNOjRi0hsctZ3gBCsuaoGkbw&oe=6A218D5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5NDuGV9dRAQ7kNvwFqVWGs&_nc_oc=AdrDZyEaWt3MF4hj7eB0_u-fc7XUrbCL-fDtP44XG24cLUhCDxfbraXcrj4YQ9bFhZU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G9UXcR8FlHWjF3PadvugotWeV2T7z_r1hW4XYkoJnsA&oe=6A219050"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdluGscOkB4Q7kNvwEOpTSm&_nc_oc=AdqEsddbKQEZx4PCMpCFyfQNVgS3tTLr1FMrEy8SsLbBKSe2bD6FrBt97nKkzGMXaP4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UcZg40ZGsqLbu5dsvnDQYvRVyZR83CJ-L5vAOTolZjQ&oe=6A217D3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frhknThy8D4Q7kNvwE-AWck&_nc_oc=AdrYMP4nt8kPtcIy9l48SblqCvkwMz0S9OvrUaYDA3rgtzuFc8e3qAvrKRj7g0mdk8A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xtn0Merz0lWpVh4_QRD2ZJi3DtOcYdq4ul0NcV1r62A&oe=6A217E39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMJ26Bm1EZkQ7kNvwFl7ASv&_nc_oc=AdoKXa-Da4cSht0glCrMUSU28262sntDV0Sf3nCcNbN6GjJpsqP_SHbDQIhD-20FFmM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n7GaaARmX8v79hBraNn3JLPmnTCo_x6PQuiuPj4bwkQ&oe=6A21A4CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm2fZGHpICMQ7kNvwEUOTiy&_nc_oc=AdqXJICZO-jJ_j2j5tyZJdxX5jEhMpm6ojP_uilHmkufnOPEhsdhIULifm_iSAh02kg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af916tNqmJZXVgl3Hp0FXHMzKpBgzFAA7UsVfKuqEh4X_w&oe=6A217A6E"}, {"file_name": "005.VS_M_Squa
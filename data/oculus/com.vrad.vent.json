t-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDEDXABvw30iM7OsZyYNSD4s29mUiwHvva9rgrKNleTQ&oe=6AECBA4A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PQxhxOFELMQ7kNvwEeG4YA&_nc_oc=Adpco4vIF3i4lr_9TfMvNh5pqIBfmQbgPNF4k7O_Rj1tT-fPYa6-vhsxAC7lOc5sm-8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUorxfvYYq-l8_uMnrwyq_bL4fEcG5sfUyUp_SPTCauQ&oe=6AEC945B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhR3Wt3n4iMQ7kNvwH74W3R&_nc_oc=AdpI9TrzN1Ij7iVNjH1sWAMsAb3Un-qWAin-9CuWX5DDVTNcHx4FPVL2ENfhgx6REOQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXz4mvb13cU1nxZJn2nD6CzFrk3bScJ8AlyIUThW5L1A&oe=6AEC9750"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEufbe3-owAQ7kNvwFLwIrA&_nc_oc=Adri7diD-B_SI1jj7YcqF-sDW6doYneeq1TZ9xNqLxfvekFmxMoN5xSsYUyXyUzEep4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZGdyoVLoFnlySwVE7CRy9rNjXQZqNQDRb8qWavD0dqw&oe=6AEC843C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlZLC0uAhg4Q7kNvwFImUOQ&_nc_oc=AdrgL1bXOrn6x4wLRdqYiZACCMIn_M1fDxPWohRbBujYeqSWjTPqbDxhL3ASYi6ZTNU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVRydBbogMYlViGyTwA-xFQIMhLOvtRJQCHIEDtT09mQ&oe=6AEC8539"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xy7AgcAPIBMQ7kNvwFlKqwB&_nc_oc=Adrxzw8ZinU8K4lYQOj-MEq-ZlmwzjEnrTKEJZVUiU_Qzo68WVWgggpngX_G4CnrN4U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLAxv15ob3NNiFkiKYaBsd10yfy3eWUzVc_CshzSJ_fA&oe=6AECABCF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuQoIXLrhLAQ7kNvwGxZ4xI&_nc_oc=Adp1Q-Unvutx-kO8jSruPpPWcVMeDIwTtDgbPNlmt-md8zY1HjKtLJH0GXvzXW5450w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9ymsW_ndvRI7kIOZtvQ8VlOqHxnmMnq5y3LKYLXPfew&oe=6AECB9AE"}, {"file_name": "005.VS_M_Squar
t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQISQED8_KVNdjZh9CxrzNvFcS-GiAvXyyG5Qu7FkLEGg&oe=6AF351CA"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b13oq7Z8gZoQ7kNvwGyGv2U&_nc_oc=Ado7OaTpPK23pPFLbZeeau8a7B1EHZZfrMAGPO9PE-iCkp_94oNxZmnbTAOdCVa8oLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeAw8BxmbQ5GsFHoXSd4lnhuItZqsiRKdWu5jPRvGBrA&oe=6AF32BDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_c8yPxC4l0Q7kNvwEEuXbM&_nc_oc=Adp-a_1ILe3YNZEcGzHP66rd5bvrVGEJa7TnIhBHLQtRAOtB5lVuEPEcq9yWpTdCC7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9MOu9PwSwDSmaoBbh3ZJXVBFZ7e5Q5_AEtLhs2xgoYw&oe=6AF32ED0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJoypQfnl_sQ7kNvwE1PnTe&_nc_oc=AdrXKb_rx1sxrFuzOYA7UhhC1UeqgyrJqo7hTcYkEVUpmjJcs4DBMfDXgFz3HzF-kMU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuC3ZMcgWw5j3a3P0xgZGb3s82b5M7m7hDyN8vkObkVg&oe=6AF353FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mGOn7fj-fcQ7kNvwEPxboE&_nc_oc=AdqMwIMTjcKkblqllljfXwdq-ZF34PUQmK0eEP7O_vIN10l770s_ds8jefwLRvIhf-o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIthI3uVHGuwTPId_69rpT9RKp-S_AVNP8GIUKcbg0CQ&oe=6AF354F9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YiydOX8JMwQ7kNvwGawz0X&_nc_oc=AdrOOiQOjN6R3s0UHtKh8m_h8RfxxGLyFv9MjokKm_V4Rt1oDsUHvyAsXA4Vg9eSAi8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrWA7ByRVwq8Mq-B9Cq_1okTl9k6JVrjh0hb4t7u1hYQ&oe=6AF3434F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4Jf2Y4Kr1kQ7kNvwHaqehP&_nc_oc=AdpsxFDOswA17ZHD18DqaHy7Kh9CMiv7eeXXLVWybjkQKk-uUpl9nsqU7ltrmrpT1NE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfuKLQtWsdwAkiGA36d0O3s8y8wlDWUl2Zzj6HUTx0XQ&oe=6AF3512E"}, {"file_name": "005.VS_M_Squar
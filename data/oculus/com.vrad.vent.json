nt-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XbhBDX5sWjEBPr1c5feM9W7ETUBHQioDrw2BLqWFCiw&oe=69E3848A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyQ7UeXA06YQ7kNvwEwBsz1&_nc_oc=Adoke0uECWTlPvaxefpPH6I-IhDT-AIyK9MFue4NLanNS0hFsu1AHccJs3wSrxtq0lE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rQ3q_vxoGzcdv4EqFq15dbyVw3R9GNfIt6E13ieZaqw&oe=69E396DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMq7DIsh8N0Q7kNvwEQUixs&_nc_oc=Adr_t0WXYC1pK-TqYjcsljNo9lstCDPVVZNM4vGHerqxIR73r8-ar_SChkti4XjB5EE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38-74vi3GiwOYlsj9s3IJW4wezl05JG0obiBDKUjJwdw&oe=69E399D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZ1imzlVcmYQ7kNvwHyv--0&_nc_oc=AdpGdHoio9mPIKx1EnadmCY3ldtARLfx6hJkKvNAXotEzNxcQdmjjEb5I0ZKIaC2oc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lMQKWdKUcWRyticffcpO7aFKkxcPBsty2k6mtxZZfYw&oe=69E386BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FprlVn5UqWoQ7kNvwHlsyMg&_nc_oc=Adq0VJxqc_EJYW6obsgyKzTYOO8e4ROb39mZgRBnmsD3h4DLmr9HETroLZlIW6hM5Yw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12wiKcywbmQEoHncTvOThmPvRcUXNDOgrf5ghJxGWrfA&oe=69E387B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAY6pY5Z4_oQ7kNvwEoay9c&_nc_oc=AdqY9cQdAPmg5V7ofj6Wr8k9WvN0k6LKyUrhI6y0r_2qvjnwGHlXu0XD4we2WRlY4Hc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27yXTCgI6_TvRMV0zDvHnfltLkbQWDN5D7Dm1JKFUuZg&oe=69E3760F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L--e6Gz8x58Q7kNvwG0G0e1&_nc_oc=AdrX35NQxCbof-KoNy5TWIRkf4xpWtPvf3TofBg4RwhsufUGPShEDFoazJY9hBA9XcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hRNVCg0xlKX-LHHHJH1Ao4A_mL0h1fhN4KgrY60DVAQ&oe=69E383EE"}, {"file_name": "005.VS_M_Squa
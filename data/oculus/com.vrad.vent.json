t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OLwMduR21bLvaO0FNdgAmq4jDNDGzs7o6Mn-x77FkhQ&oe=6A28128A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgobWiUJPv0Q7kNvwF3fQy6&_nc_oc=AdrbCjiSGED_lVUrIkJwkDUYbXyX74ZM9Z_wa2j88uWdJ_mXFWVVA8mUmVFq0PHUlP8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87a21X0Z-585ZEcou_Lsm3AZT65bzz5-oAyHhKRaG81w&oe=6A2824DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8eZZEwhqpQQ7kNvwFxJfxv&_nc_oc=AdqE-ZwqdVJXy4HVMCZ1lmTOq4-s4n8fRk_EJlc_BAAXk9UDHX156pD6AdN1CIGB9g4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87-I8Q0vvEGD8akB5mkNSX9TmF-K9HK-DSr96bgPkdLQ&oe=6A2827D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AoVzTP5HRgQ7kNvwG9njxn&_nc_oc=Adrfeni-T8pBhrKp_3btJhvEs9IdROvrcOrd2A2R7F5Wtr1dukwtWjzA8JSTHLEIwE8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iI7N_tKOLOfSAJizQpPZ7FXxjkbxrdkk6GMng3dZSpA&oe=6A2814BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZXTmgOJH2oQ7kNvwFigiMD&_nc_oc=AdrGaIaRaSJ37FMhzCMe9bPV5IuGVYFkgdo5Cih_On9JBOl-NzsTFzFfOd3FIsPXyZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5w_mKX59HTqEbOQSaB4eQj72gfLNuDndMB4Exl5KCtg&oe=6A2815B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rImEXzd_bi0Q7kNvwGGi2KF&_nc_oc=AdoLwG0cm2ct2oof5DLJaSaM1g9SWZd0IJTKN9li6Tb-X_ymS02_eftDjqa0pj1eLK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M_Dfw-SD-R6y1T4wADTigCVQGHjd-O0EG6vSY-FVkPQ&oe=6A283C4F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMEt263LEXMQ7kNvwHAx1cn&_nc_oc=AdqWjO8auxJdUVEzyqTSR8WE3T1DueWrFaygKiJ1njEtj1YWUnrA44iwOfiXLUA2tNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_X_POyqYJvz2n071yfN6qTOcDTOEvsiHko6ofqn9uJA&oe=6A2811EE"}, {"file_name": "005.VS_M_Squar
t-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhVTfQJbm3PGK7MsQRQKzWK7IqlG8hwmMzBTf51gjp1Q&oe=6AF9E94A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyG6sJF8oZAQ7kNvwGX4GDi&_nc_oc=AdpZjYGdUFw7LW_FlVKZyRXg1a-es0OstkS-cTrqwI6dS_eyjNWUxwg7zD5RSfAlCwI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqv3XhIrOyvfdc-QC-7DxYACIKgKQnW6Tb8sXQYWnKdw&oe=6AF9C35B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KmqAlta25IQ7kNvwEJWgCX&_nc_oc=Adrnztyxrr-EsjDLPc405tN3S8R7k0D4NqnBVHZ3VOmlkngwF9_tNTFEXyXOe8biyz4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGWpyGHR5SDs6g-81Sj9Y1bcb9K-HDycc3WBWuEhJbZw&oe=6AF9C650"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ru471bu1feUQ7kNvwGF_dEW&_nc_oc=AdpXpNSqAXEC5v9-sR4DddDAqlwwJ0dbVrdQpyMZiqV0lEcKvlXm46bPYhSj9kz3cAo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7Mne6TFqkydzc5CtOAJAdYnGn-jvvHMV_lAbd0h5DWw&oe=6AF9EB7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoHdzRI98BAQ7kNvwEnnY92&_nc_oc=Adpr1dHfxwVlXfPOYVDjiOU2DO_xmHlfHl9UAlqXGLcXvY_AWriYNBQcY2A1JHg3kkY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc9_E85X-JeDVRcIPv2wK4lgId3NyowDdmXcWqV-obiw&oe=6AF9B439"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crty7i6feo4Q7kNvwFxIqNw&_nc_oc=AdpKcnQKUGIuhqt2IdRAYm8jJOz2xl2Xx4jm8wO-h_FIlprn8iiNWS7fKbCZ_87xXXQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC8uCeBEOlRUXtuPVkt9-upLnOhMPQmHSdVhT_324GSQ&oe=6AF9DACF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w21QYPGyziIQ7kNvwFA7zci&_nc_oc=AdoTnGmkPQ4byexeuEMGNO6lqn1zuA9eDWI0jytyhNmv3SRWAPvpfD0AyxjTeINFoiQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSc9_XjB0tWgSwTTtjLyDhAnE7NSa-uC1_liCxVl7vog&oe=6AF9E8AE"}, {"file_name": "005.VS_M_Squar
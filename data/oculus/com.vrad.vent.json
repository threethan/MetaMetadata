creenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EInuNSdeM90Q7kNvwGMv60K&_nc_oc=AdmWWrJCcOyz4BSZUcyhNbTNZl2D57UzvPIIdyWYCmcNugHGdtX9R2_jvTI3M8g3fy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7IGcp3nPBqifSELiEtUONu_FshEWkPbOXKeSCci0PlA&oe=6999C2DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlBuXUdY6HYQ7kNvwErLOEU&_nc_oc=Adn7Ao2cQ_dwlcDpdUH_Z49ivn5uUhxOGj3yavUNfGHE7YRa5OR7XFOlLgtjZ0HoRSQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsrNcXoQGos6W4nOMpQNtUiGA2fQiVQg0L1ZNAc6rgFEQ&oe=69998D90"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQaWKG0vL2oQ7kNvwEZPkZQ&_nc_oc=Adk_lL_jsGa55VGlTKPuTnRCpJKOztNH4js91LvuRl48iFeyCWR3HkC7knaLuTsCZ1c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftZ0aVA-9VoDwGDJK2FtXmL8uVDAvKL6BeMuKZpUho2Pg&oe=6999B2BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, 
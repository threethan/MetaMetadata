t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPIHk1z6ra9N5-XbeALM-yO32nj6w5ko1nnPqE683HpQ&oe=6ACA734A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olHu1WqrkmsQ7kNvwFbfWoW&_nc_oc=AdqyBBuPhR5DNJGPSFKd5dgaTe6p2x4gRukU0xaWQiqUQoOPMayPpEu68-pPi_icAeY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTaAne96xd0wNw9W-FsXexwcXETR7GqtoMIi6AWkgc1w&oe=6ACA4D5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ca0bM40oOisQ7kNvwFuwCUR&_nc_oc=Ado8my7Q95rZFT7C-Q6VtMXfVL-r6NMyVX6Ss6rGiiqLilyMvhEvar_II769LyjJH80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm3Y86d0ICcSgh1Athf57daXfUAQw64hnwtQfQE4nuhA&oe=6ACA5050"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gG0WS-1Du8Q7kNvwHx6YD5&_nc_oc=Adqe7K0qyb9mLvGFFIGuwF1VBSRbrmC0hIAevQC9-RARQ-Kt2M5w65p5h5Iilm1LxNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAgxrjYpvYxsspvbVTg4aRvNuwJ2sMvxTNoKSI5-1GkQ&oe=6ACA757C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oeosq7RaUVMQ7kNvwG22TIL&_nc_oc=AdovtlSwPCi_9hvUZ4p-knL2dPtAQaGji7n0mbHcQLpHxgz5vwBCYesLbF0Tj-hT7YM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAbjemxgiJShalD1RsiS_ZzChqdOYMcwylSWyCWi4bJQ&oe=6ACA7679"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1rBI311l0sQ7kNvwH_gOaB&_nc_oc=AdrLfTHKA8RfJpnLaj3Br9h_6PvUXEPJaZzgga6vz1zR9nCsZibYrNix5uoOvvhz1c4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQp6ZNoIjnktjmmlo0uP5RVuVZPuqYEyoI17IHvmCJjg&oe=6ACA64CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0AgXIaqKDIQ7kNvwFkIoiO&_nc_oc=AdpWobSzARe_T58Svwm6pDFfI-iYnKT4QMa_2fETbQmc9RkpE_It3rxnNG5Tii9a-6k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKGDnFNQZzjTZV_rUeYULAyqt2IP_v2cKniuN84WoPdg&oe=6ACA72AE"}, {"file_name": "005.VS_M_Squar
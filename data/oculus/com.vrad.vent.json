t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSEkz8xvzpOyBHw8gbpeb7P7vZ9_GdF9Yv42lBYwmm5Q&oe=6AAD3A0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOOyePddgZQQ7kNvwFrVPLa&_nc_oc=Adqx95hk4HO-i-n-wdwlr7I2eq1mtz7K5hn8HGAluo2hXmP87Db5qrMaFnVY_thQIkI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKqDRMNOOwHrEaHB1s8rXWN-zKQbeehF2TwTDLTNmQ8w&oe=6AAD4C5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CeRh6ls8UwQ7kNvwFY4SxF&_nc_oc=AdpQxjn_O3uLd7YGUT8Bbr6J6yPE-gSLv1WTVMyoTHtYaoskAJroTkMqyZIstXYmvls&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINVH_c8l5smlUHs4q_UUaHCWqKqIzcoss1LrUBvUVLTw&oe=6AAD4F50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eTZn-3hli4Q7kNvwFwV9Eo&_nc_oc=Adp9omZ8sTHfb96t3BC92sF6qu5mby9aUOzTxDVSXClyC90EC5BaiytA_zbfOhTtTRQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpLEpdr8Jh9NnzxdVvVxl-tvWL5SlC2LN8NUQhbqih2w&oe=6AAD3C3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx1FZYt1kQIQ7kNvwHwvrdE&_nc_oc=AdopTSyzlUcgtT-nyTBOx8uWiwKrD74cRUhlU9yDRLTcfloBXZCSLsOkuZUFwDnwu4o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL55Qy4NowQQZS7z-TYahRvtajtnVezWGFZL0fcZp5Gmg&oe=6AAD3D39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6kC2HsyesMQ7kNvwFlSk8I&_nc_oc=AdqmGJp8Twtsvs9uRkAFfSlNhjTKSxd_vCBj-5Z8j0aGorzR2NlxbGT489BWhVgi8FM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdk2K9aAGZh99_J4BmyWnpQZQGps57aQL_2rVyo1jbvg&oe=6AAD2B8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Zojd4-iB5IQ7kNvwEKcVh7&_nc_oc=AdoIXOMMhcDvF92n_osuf7u5RBnMS_tt1C_KtLmzYcYZDL6kXbU_ubJCQAUmJO9-8zk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYujRYBdYE-g0xppziB2Cyst5Qr6oJgwLN8bamQvQjew&oe=6AAD396E"}, {"file_name": "005.VS_M_Squar
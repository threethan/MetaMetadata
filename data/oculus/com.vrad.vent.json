t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3bXfR9iOydCGgbSObbz0MPF5uJuEVFXhR03Z_HTjoLQ&oe=6A37E48A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEKG8NPclEAQ7kNvwE4P_1B&_nc_oc=AdrHas87RJWJCE5V4gsClDziXby6pQIqXhM6ObDgoK6A7lsPxry5EDayzHBkSyCnqhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DVeElXtvaZO4033U-554Dp4j0zmJvtwTlbWaLFxGKHQ&oe=6A37F6DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g6KVVB4P-UQ7kNvwEUL4Zu&_nc_oc=AdopZrc8OkC5PYcxJcVxr1i4i1uT3zbY5Lzf59CRHvhiw7hc10olh--ly8plzioMJZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2S0dw7Eh33PEnln23io50MMY552gz70Ab2yji3PzChw&oe=6A37F9D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fb64Qt8aHV8Q7kNvwE1-x8f&_nc_oc=AdqrQ51jyg26jYzwbUGLWsjbY5BNmwWU8qlWV6EqZMN8Uv7WWhMXu0ls7vVF52rpQf8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cvF0jnZi8GKFhU7wenJD1juRRxJ5yFw_U8gq7GJT3Xw&oe=6A37E6BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5uvuewv1OkQ7kNvwHLoL9u&_nc_oc=AdpPR5hOsvvclfpKZJeqZPHZA1KpLwCSxa1ET3MIQRRNktNUnPMHT9E4uXNkJum-O3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F29k1QNll4OWsWbFMCh0zVxpTj_CmC_muYCloEYzEHQ&oe=6A37E7B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHUTwpzpPakQ7kNvwF1XcZ9&_nc_oc=AdpS9Pq6hKUxLdqNy2on3a4pOxsKG9Za5yFhEASLdiKbyw3tQUp6BQXQL6yX7YBcCns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MOgNx4WgW4KVH5MfZgNvg5W61VIB6IJwiuSNq2hWd9A&oe=6A380E4F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-01BEV2VQUQ7kNvwEcJ8CO&_nc_oc=AdpYVBs2JOx50WRHPdiMsCp3_hOd0aRBREJ2ZHFuBAGJLmHuo9emcWoRiT62z3cVMzM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vuoTM4A5hf0XNs7DlZc7LB159cG8Ei_he9o1U4kFTrA&oe=6A37E3EE"}, {"file_name": "005.VS_M_Squar
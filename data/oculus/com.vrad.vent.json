t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU84oKYoDMTMniHQ8rxX3Sf9uDXFoFtiFzxvUfnrqwJQ&oe=6A830A0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sth5dgMQG40Q7kNvwFkTG5w&_nc_oc=Adpig_HoUqUg4DuUKRIn_kJv-v02uuKuhxSF1-GrS30O8HhksyLL8LQ-iWv-CRyUjzU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuqAtRY6nJUJ4HhA65yKhU4W4SZ6bvOtGhIx-ZD0V_OA&oe=6A82E41B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNCB5X-g88kQ7kNvwG1O3we&_nc_oc=Adped84agilm2pP9e4dVX56uBDwUl1-Ycg-oNF9dCeBb7W4kCDCUdztTAPlUxEH8U7I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7aicTa09zCYwMcYOCEXAlMyKZ-o_a4yKE-v-6GdN_RQ&oe=6A82E710"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77-OD15_1u8Q7kNvwHmp9VM&_nc_oc=Adp8voFccWswgkMUGNe3K4yYxogWEeDFpFbokWtH52kk53AlhSxVWcR_7LTZQhv3HHk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1aQMqQ-Z7apv4VDcZyH0gWCLHZmKCeiO1Bih4MHY2zQ&oe=6A830C3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxqkRbEpgDQQ7kNvwF1AdHO&_nc_oc=AdokyuWkzKBr7o0jGGQEqKs3UxzSLbUOTJCxvwkHmSrblhTCEyLPrUX3sRvNIVkdt54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm4omHoX_7FbWn863IvbBkq7p0nlT7bj7IPk0immyJKw&oe=6A830D39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WHi_N__ns0Q7kNvwHirt8B&_nc_oc=AdpgTXF0Ur6pM9vRfkqH9P3mxWqA40-oKGXh6E2Ujih0tUDT0b9Bq332ivXIuHnOK1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhYZeYpypaqVzNuLg6gK2KQZaGuTHxwRiy_ZgR5aBgLg&oe=6A82FB8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge5isaunREgQ7kNvwE2De-R&_nc_oc=AdpttB_lB2T8Id7p2KZCWN7-1C0IscsvJ_dbf6lAfDCYuxTBN5bTOlE59yztKnzhYZs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyTH3AqjJzeEfYrim6jklXyMJb8PxmDnDlj6e-GPJ-nQ&oe=6A83096E"}, {"file_name": "005.VS_M_Squar
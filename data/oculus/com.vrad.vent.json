t-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP6OGYbdW5mzwHb76zIBMeCtQEuYaRf7WtQ0zgUZmKUw&oe=6A942D8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl580H2ugcwQ7kNvwE8vJ_B&_nc_oc=AdrTlMtDY0dcQC_FsZqWAk7xK4BYEdr_vpTu92K8E8JY2hcj_ylkd8je059hVorWX7U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQlG8TBAHFq9FeZgY-nzOkabAwyZ3gwa00yzwKdv9P0A&oe=6A94079B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqIl7kJUsLIQ7kNvwGcL-iW&_nc_oc=AdqvWSQatdEQ69UxvEVzUE2y28-GGPKfkuEgtVJq-R-viUcm-S8DxolDN_bTPNa1bjI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ4a3Mh7Ar3g4HEqZUSA3bTajtaZY1lZNme4Fiu1MyDA&oe=6A940A90"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgtvhONDiSkQ7kNvwF1C5XK&_nc_oc=AdpKL5_skKfxOLC9h1QsYyaf9CZ-gPEVTXkBViwrPTgiDpUYEp8RlB3awA58s02QUMI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq_Il4DGZFhT48IDVBkj2BqRJTsE9SoDHaxH6S1P_XNA&oe=6A942FBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRmY5lMNce8Q7kNvwG-hIUp&_nc_oc=Ado9jXHCWxwjA-QK_7-jA9Tr2TafIRIgCTmwNw6g1NAs-67JHgFHHHnJsITVOWLRSh4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0h-fS570xXXYwNJsV22bsgbuy0zHQVObFl_XahcuzjA&oe=6A9430B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJjt3VfF93YQ7kNvwH5TQcx&_nc_oc=Adp8MJ2x7LJicjnixcrMeZQy2FqbW0h13N4HwPQBWhYr0LIfmbzNaXQDZwuN_M5q2Zs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-Bicx2PKmyAapPB8XK7AEbQ9SaDE5kKUiIJxZK0u40g&oe=6A941F0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcOZCVUPFhEQ7kNvwF31NYl&_nc_oc=Adpoh12O8L6cq8zjHftVnjU5M4VvtI4Y3KXWwGr7lCapDDrYNLKNuFjpQsUTiWGah2E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfh4DAQH9uFUv4rjnWI7OECy9jKQdwP5FMEdcSg-O5rQ&oe=6A942CEE"}, {"file_name": "005.VS_M_Squar
creenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EInuNSdeM90Q7kNvwF6ZJzj&_nc_oc=AdmSFO0c2g0LnMlHUdtBhpkBoXVEKwXWR1y1ECLi3Q605NHM4WDv0kTeG--CrdUW0L8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsrpIVIChPuwcCq22es35Qf27F72ecw8iUxTUhY3msi3g&oe=699B145B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bm3zjcOYcTQQ7kNvwHH_beQ&_nc_oc=AdkTjZhQJvoxL3B2Js5I-llPYcYZtf4yKHnnY9664enPSxHovH3cQ4KodAPXpaztQVU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuEt5GIvyW2pomUmDi1djdEZHZBICkS7lfls7SKRig9TA&oe=699B1750"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0mkFNruIq4Q7kNvwE1Ak1c&_nc_oc=Adn1_oBSlaDuQlYbnBZnTwFFr7R6bcMaHql-PNqgaPOmtVe8PUS8PFNY-_ogWNjWzxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvOOKorOKxdRHHkZilrRHNya4wGkI79URkb_OLWlZCMng&oe=699B043C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, 
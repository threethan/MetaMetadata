t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MKQU7TM58v2mgFnEoP3OpnY4tlBi91Gr3QGm7T9oFMQ&oe=6A33F00A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8X6lf-Db-kQ7kNvwEk3aYI&_nc_oc=AdrUdQkzh4SmTJjxmULL1h1aJ885Xx6Rrpi6LgaVW91ITj-3IiGu9Q_AYJkN-X24YIA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bcrUZ5poDZAdw6SJhGrybYaVBHT0pVfys-mvmT6-RHA&oe=6A34025B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kFFq-wjYQQQ7kNvwHXLKrn&_nc_oc=AdpLVhWX1-ScD5HPTCbfBjJXGySy5ATJBHROEtqi7OdzJwQZqmuzLht2qw-FO6nBM_w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a8T9V1Lk9WXtXOJ84ZSiqYLF5W_Io5dGj_FukJ4Je6w&oe=6A340550"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV11VP5EC0oQ7kNvwG4rd4F&_nc_oc=AdpGuDX9vTQccdC2QJavyAqiGCEtyEw9z6C_xhRkQqUf30uvOyaEdbMpzOCiISj14tE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LM98uemYwNFVZK-xViyjRUIGtMwUmGafSmzNB5nSk_w&oe=6A33F23C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j2YtzgWCsgQ7kNvwGDwn_H&_nc_oc=AdqN3murVxpFBllcJyWqjk_c1cgXqAJ6rppI-Mjvn8w_uDux8Uut_j0CHzes39Bfci0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9842h3Mcg5RLT_Y2NVzk7y6i34w_9vyBWtsXzBV2D0bg&oe=6A33F339"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVXTxn8hHK4Q7kNvwF7xaUT&_nc_oc=Adprz4QnfbWI5K_fWvwqgqyMs26aBdB8ckEjiqS-LjcrA3QNPqJU6IrFbr6lTf1wDmI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mxI2KGkQRxdIIzFJBsATER6ycaOJ9HuTHwfz8nVc7Aw&oe=6A3419CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pc4znCaEkMoQ7kNvwECxuGd&_nc_oc=AdrHhKBOEP5-k8ykid9LtnNkQIdCN6_5Hv9pFrjsNJ0EUl_-fy1orPq7H8E1cxZ_k6w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PEfbtM0NmRh5VoaxpziiCyfMB7e_2Lh9dL4OuxO5utQ&oe=6A33EF6E"}, {"file_name": "005.VS_M_Squar
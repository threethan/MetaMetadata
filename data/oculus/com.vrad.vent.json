t-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMsAXqOws0vbAgRJ5Tfgju01iEoc1jUn34JMKOS4GD3w&oe=6AA00B0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKjSRrDAV34Q7kNvwHI8Pnt&_nc_oc=AdpCdVj7MNpomWDuNw8b_p1as-PoXeZ2fRERgwWYSsZ1BCrovKuGlQuZW_w6gjPVbd8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEznt_6YG9eehCIo4SWhnEQ9k-CR-KvOdMwt9YbFK5sQ&oe=6AA01D5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i_M8qZAPqIQ7kNvwGKr28D&_nc_oc=AdqpGnxk6wjbRQdn2KH_9qCZgyuUDQ0OE7MOmPLGSeuYv2g9cuvt0xGPfYHH21RNr6s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1jTNfjmaZtJmk8mcHJpcfGeKeeuTwHK8MnagDGRQxxQ&oe=6AA02050"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIabu81vcJAQ7kNvwE6i_4D&_nc_oc=Adqa2tAZFLn8rankVoKWAx-osDtzkteHV5wwTtrwwcQUO9c6IRCm6hUjok7zrY4BWm4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_9sIq0fRg1-tpkUxXezU6VBhvIFBE14ANhY8gwMJPIA&oe=6AA00D3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpOhNWyaiIMQ7kNvwHLYsuP&_nc_oc=Adotrnwx-Lne5qxMNKSGbssLKGXddkZZdgYhIOTtj687aZmKhQAkc5rIYVwAEEm_YLI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGdRo9CisbGjSXOswyzYBaQOy2AlFWZveZJ_1sjRDgUg&oe=6AA00E39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5b4Aw4YmF4EQ7kNvwHPHUmX&_nc_oc=AdrKhBmIoYVSV77hBN-xyzyEvEr9LZc83WiFgjqb9EmOmOYlvqRGQfMfm1dX_9XHO7Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUmgAMLiQtCTwW1BJKsBBGYlGrXpeUCcIFFWcl9ME4iQ&oe=6A9FFC8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3cCxl5RNo0Q7kNvwEiJ1dG&_nc_oc=AdoDc_-fVxN475PkYCBqDLx45Ff5oASGBY7QxQhen85Huz3fRZpLZD49BObOXnNAfn4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId5bSf7f5mfs2CVIIT_LT8RkOdWc3ipZwwOVPseZaPKQ&oe=6AA00A6E"}, {"file_name": "005.VS_M_Squar
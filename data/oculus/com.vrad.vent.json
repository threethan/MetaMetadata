t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I8kEbpuyC8jMgsWrCk6yDmuWTSTcKAVd1r9SDN3NoHg&oe=6A3A878A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTfmLGeR82QQ7kNvwEmaZvq&_nc_oc=Adrotqyn1ThpsgR2baSJjO1wAFbVgPzZz9DKm_MrUNwxrbyYJeXtqZwi8W58AXB22nk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n0dPb8b1d1z-DDtgK-GnPzQdghluNElxslR97xPhMtQ&oe=6A3A99DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6U7mnzY9iMEQ7kNvwGvO95e&_nc_oc=AdrCeyL2NbzjHC_CW3MjZt7lEx1CcGXemmCB_lw5_GGljAsFfbqjF30N0DvKNVnDDS0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s7YpT8JJGP4lmHpUXDdPSIlP_wsK1Ctm5pdQqvQfH1Q&oe=6A3A9CD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRy0iIwWsKYQ7kNvwHBFowc&_nc_oc=AdrwKG7XpXW9d7XxcwPb8WWmDdRdsm58UlXRU3pupVjAN0gtUdLb4IQqHUJvuTbuCGY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JtD1fEQoT1YaG57sn1fRSA9hdsuI8aP4AMZGU7olBCg&oe=6A3A89BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1S4oJQbJyUQ7kNvwHcVz5p&_nc_oc=Adrs10RQY_4i3_bgMQER70DYaprBL3j56qmv6QWUBliV1Z3SSNVvmGjVBtuytl1-5d8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EwOVeLOtf4mNRvHJ79S9PVzA24J2JoLEdR0cU6s15ZQ&oe=6A3A8AB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hFLtvexsd0Q7kNvwH6SY6W&_nc_oc=AdqbMCGRxcm7a54rBePSXcsI859Is_MWEbovBOFakfqqRPVY7TEkeckNaDYuhYuk24g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-bInAOF8giN-TJFxMHmrmU0lYZfCJ2rvq9AyOo1_9qA&oe=6A3AB14F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDgfr1NAbQcQ7kNvwENdOme&_nc_oc=AdrGWeISwOhmaSWhb_fK3hVI5jymBVoGGYeqOPieZnyizQNwYdV6EJxUI_TyAFl0l8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hVHFHg6zhmTQ_p85TT-dTzUh5Pmhj1FZyRvuLVfdJEA&oe=6A3A86EE"}, {"file_name": "005.VS_M_Squar
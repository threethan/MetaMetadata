00_Afyx8EcNL5B6DKYyXGqjNrqZRrP8cfrpvJh4GiqiJBMxRQ&oe=69AD770A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmOsfntCbsYQ7kNvwGdcx_H&_nc_oc=AdlcqGtGN5CZPqPh-PNRwWZT-NzKNmIIiDxNrxBu7_PqzI-Y2b9GjZ7cfiaqGp-dd90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsSFqOpTvJBiFlNytHq1p6LYVUfjatkvYJcEr3r1T3GQ&oe=69AD511B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJKgtBHkFrIQ7kNvwH24P4j&_nc_oc=Adlzu82x4GjxYO8WLdadz2J3ZZWoWUxl1k9R3gEl28DcO9K5KswBQbA-eAoq_iTudVI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKgEeH6ww3OWQA1cmOxjP89F3UUpJQ80u5wau2PmrPwg&oe=69AD5410"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F4980xzt60Q7kNvwEbP3da&_nc_oc=AdmFZrncgKkMyULzoYvTYRFwiMOa1Ag5XEejbK3WKE4RTa73_XGLCpz_mJLYV80d8gc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzK1jvqP2QmyIpi2mGQGdwAh4n-aiph9ln2_Wyr6MkLRw&oe=69AD793C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBXC47UN13MQ7kNvwELNlfO&_nc_oc=AdlFG7TT0JrYCPKBRpHkOqB_7oe2XEJF3DjLHqAHeKHvfEJbiB3SxTq2yey-AgH1N6g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyx1J_ZMAA4xKLp2zN79c77e9vSYR538zhlHWgKhEPtWQ&oe=69AD7A39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T93rbjsaSPIQ7kNvwHDVpT2&_nc_oc=Adn5IiSoxJ20qw4eFtQmSiogYDCLGGXBZ_fgXEhhKflvp-Yva-Uex09vMYcFUNih-1E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_mfXC98yNxw8XA-UUMkZtwAvVYy8cFAvuYt18UJpeEA&oe=69AD688F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfCDVmGv73UQ7kNvwFDt9lO&_nc_oc=Adk8y6iPL0f8ltkXpfD8_EFawmsTk5YoD9nqp_1AdnbOCHULRjO4403xG6HDEuyph2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPmrunfahqy14XL9XyUis-8qL0u9Cpd2Vz3EkAbfYtDg&oe=69AD766E"}, {"file_name": "005.VS_M_Square.png", "id": "1158833709586565", "image_type": "APP_IMG_COVER_
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nreUKZ1IgS_IYsaSix8SXZcm5TZw_nXn8QKE8m-5WZQ&oe=6A2D588A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xySUUNY5UwQ7kNvwGrY_FB&_nc_oc=Adrx_H3rY3XgGoh8L3syuVIGqhCTV9ukBvmfvnLjHijvQkIoQsnCMbRCtdRRc62Co58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z8hnRsNII1GEIGQBR6biCSbAaxfY9iZTv7hj_M-hULw&oe=6A2D6ADB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUtayMO5TJ8Q7kNvwHeYS4s&_nc_oc=Adpt3qJ1fziXfjE6YbJkQXCjS34zG0w_lUq8dx6GAzxR4ymvCIR36UJXiZp06zI0Nb4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y3ddjy3wng5c6jiQzz0ehxrzP9FkSwyylBccd5-WH-g&oe=6A2D6DD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zy2fdWTBFYQ7kNvwHa_OmF&_nc_oc=AdrU1qjI2YmTF0hAUdEffsmxJsCiF0vE7P9jJlBp65FGXk2uTSeH_fnC8snmomomT_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tTpKIsPuWEHskXfzU9lfDF0iP32affuCBuuKFYH1cqg&oe=6A2D5ABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrzG7ETVKk4Q7kNvwEcJgUe&_nc_oc=Adr2QsTDLmJbbUujujIu58BSO36rfjHUWidujZpaW-wBb8gzuhwn7iqUU_X3xHkIK5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JRxnZ6CBYo7y-dIWeVdd-xolFIUjncKXKsHdz4EUk7w&oe=6A2D5BB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Chb5ZBT5DfQQ7kNvwGSSyL2&_nc_oc=Adooa5smALTBsSzFbDRXxo1Y60iJxT1XS7B9SeCV2q-6vlPYif9iBOcDV-HgnpHM2mY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ERBKsc2CThfZndvrzaqx-HYV6TYVw3fVZVFqMxIH_Mw&oe=6A2D4A0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hJ1cbrh1SkQ7kNvwFH5r69&_nc_oc=AdoWPn-Pr6rF7AV4ENLs3JK5oZRGiRduVitmD7_fb0jVrr9Jm8BBRanId70s1Dbu-Ms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6fMlJutC6LitaMm4acpSgO-ya2ajHfBhYakctBTdDbQ&oe=6A2D57EE"}, {"file_name": "005.VS_M_Squar
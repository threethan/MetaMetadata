t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPxqr72uK890feiQgXVCHm3eAy70XDyvWSBYzi-bWqew&oe=6AF7464A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xct93eGgHzEQ7kNvwGCEHHR&_nc_oc=Adpr1Nb-ODaNFtC21fmuuSugGs0B6zuYPAPjDprXYD85dPJH2ktwaFKzcr-u5IAODrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYGCA-smzE_hv41jUmiM6s5UZEUo-58mb6FMzPt5St0g&oe=6AF7205B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KmqAlta25IQ7kNvwEanqhj&_nc_oc=AdoDOxUzw0b9_gYOeC2zENFR31hLZLxmPIpdPDUsZN8cv8Exn-1wdVD1VtdO2grmRHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgtyAirB_BcRSyYvcB7BL_SEUr0Gu83s8WlVqMw5Zqyw&oe=6AF72350"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ru471bu1feUQ7kNvwGxUjn2&_nc_oc=AdoJ_vymn1-8xCk9wrgF8t03NufIrzJRslmZBSf5Dok34Kcim2Vhime0L7Dl9nHTOQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRlm6u5tm3sZnlYGGNoTVlnL7M5FQ11erUi10ANeedkw&oe=6AF7487C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoHdzRI98BAQ7kNvwHeYgY-&_nc_oc=Adr1hIpwrNTGVMhIWqQixmkNj6WMNmNqlowgQvrbY63kAPovY2oFMsjUPiO1uDobwz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4pmEZJnvMmEnHrJg7CofwyPFNFwKGQlPVSWMsB8-AXw&oe=6AF74979"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNXNQ9uOoUgQ7kNvwF_8dkg&_nc_oc=AdqjZc8KmPUy0u_t01VZcM94GsvqbvkvaWDtDjOuf2L-ygfh7ErykKKkJYdxXXi7vj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr2cDhlrB5uPudHc0r7tr_bwwEyslahWsb08zOHMD5bA&oe=6AF737CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w21QYPGyziIQ7kNvwHfDn4u&_nc_oc=AdoQ4fUXgCP5mjlQ9wEgf2mGf6cf7oOHSHihmMlrKElaco8yjkpiogXCOCwhSKC9mUg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMAi9ch81PFtjXd9awtb06UlIPYws_Rpo30ehO8SWCFQ&oe=6AF745AE"}, {"file_name": "005.VS_M_Squar
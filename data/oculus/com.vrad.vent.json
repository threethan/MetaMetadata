t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGVZNKqmQKG0-FGOoCPB3iZPoZRvKKUAeRhJ425Ex58g&oe=6AEE0BCA"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PQxhxOFELMQ7kNvwGAOJST&_nc_oc=AdouTRRyZ9315ptBaPQuG4kRIzoSExf69oBsttI35e7sgm1-pkDtPz-FvyaHfr7OlQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuH6iULM7W-EM6gscZKYfj_67vmjV8pxNu4nRwAm92Nw&oe=6AEDE5DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhR3Wt3n4iMQ7kNvwEVaUSX&_nc_oc=Adp3AaEXoP8XcqJPI-nGwr9JkpZzN2aB3sPl7B6NlFhrxMRDNqSfD5I__H-divASTNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDVBaNqtHtTW2eZLMIBP3xOvjTtFpKFtaVtiUyScKxJQ&oe=6AEDE8D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEufbe3-owAQ7kNvwEfbZZT&_nc_oc=Adq0hRd-gB9GvcHSaYYLHhJrwmBwODi1n2wtwNoDdqyKM3FKSpInBPVM5TW8tP_QrrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTBdLv8nIL0o2a3x9MLJqLT7WGwWOYUX0LcPMnqMzRTw&oe=6AEDD5BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlZLC0uAhg4Q7kNvwGCXqI8&_nc_oc=Adp9-JGCuBcPDR4MfY8dDRQK2XMiQ81d8vAbODFquWkigUAcMFHOZ8HJ-_x4KrtT_b4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe-lkvj8a6zh6XFIPjp222CPDQ21ly099keIAObjoWJA&oe=6AEDD6B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xy7AgcAPIBMQ7kNvwFAde4D&_nc_oc=AdqIpp0h2PALj7WWr2p-LGxQdIHkcXJNndR19HUL1yMuQaxAxvPFGwYwEWoWqJ9Sf50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvfhdc8DJFUNYTrZCBwTYJb-IQeY3V2Je7HoOTCQFDqw&oe=6AEDFD4F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuQoIXLrhLAQ7kNvwGOasHv&_nc_oc=AdqwVR2F8-c1gy2g7zdjSBwDHKGAYSGnftI8PbIvX-WFC4NwXhpczbgm0XLB0TdZbkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROUJeJqYteVjGKcC2--5HwxagstZ_va46ow062c-0XTQ&oe=6AEE0B2E"}, {"file_name": "005.VS_M_Squar
nt-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1N93h_7cyrapbJtqw1zu_r8fgaQGmcKlswPkduIawlGw&oe=69EA1C0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jB1_97BLXiQQ7kNvwEhlxdQ&_nc_oc=AdrfIv5FA__iEcNwnikn43A_fF7rH--Ta7P8V_SIOvSnWaOD1PxKMGpfIUFnrXtYHM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WSbcazsbPyJRRKP6b5lLjBXYEWY8Mnsowmg4kbRtuBQ&oe=69EA2E5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey66BJy1YJ4Q7kNvwFa0lBF&_nc_oc=Adrbn1LPmH4jHuKg56c52oe9D3Ed83596AfKxPHwxCJO6FdwsuCKOZJK--ALPp1LC5o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Nctp-Yt8o-ZvtE0xv9el__5l4J7dJcarNX6mr92bt3g&oe=69EA3150"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxYAxqKA0JkQ7kNvwFhOd9w&_nc_oc=AdoAJAVWIqDCmnTH05JBK97WGigAx1tvtkydyrFlAyLvesdlqYRLOv-SiM8gbPVH4mo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tNdY31Mx4WBzaGV_bhwsAS_m2_YLQL9ElOAER4xt2Kg&oe=69EA1E3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCh5LJ2qs5oQ7kNvwGiDeIw&_nc_oc=AdohgqTWfcnjJgx7ype8Qs254y12URE-7__Rtj3pw8JS5SK59Xg8SQ6sHnAFa5LiqfM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06MaVzt8thA8aOURzVrP76ND88EpBkMf_6aJ0-k169MQ&oe=69EA1F39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt7jpJUt-7gQ7kNvwFBVCht&_nc_oc=Adou3beLaGtgyuRo5zGP3LD6RFv0yHwEIBYDl11vl6HLt7aztYGe7RJz0G6vfe5VcQM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JWO-b_cQJgjFEe9PeaS4aj7v32ttq_o5bc5TbR0lu3A&oe=69EA0D8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8D8H4_ncFcQ7kNvwH7MGis&_nc_oc=AdpcDH8ZyYFcqfKk8DJU-Q7VKAYnS1xywRM90zhrxvyrqpwVc2GGQHhfMH8stoDLO9k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OdUtpcbMf-mwqyVNsppNQ-9bEe9UZBkeJ09JMr9Z0yw&oe=69EA1B6E"}, {"file_name": "005.VS_M_Squa
00_AfzAoyxk554yKIoGbbZUGtaM41oVgD-E4unW2GYITKNT5Q&oe=69AEC88A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmOsfntCbsYQ7kNvwE5EeD6&_nc_oc=Admn5Ph6q4IpLWPrtcvkrVZagKXTPMNJiQgLSSlWU_9hLjv2Un2XPm6Vgr2m-szQ3Ps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTWir4VJchrS32iCYX2D_xMa2TuE6ZArsDG8ZM2e0DOA&oe=69AEA29B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDbPl3D6UgQQ7kNvwEhdp_B&_nc_oc=AdlCcdvAp4bvAbK9MUo7BCf7CK7ScmQZGvi5f9oY9IcRw43UhEBuHP3J7kvA8zstBvg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJsf2mst-i5l5l9EogXm6lSW00cjmvudRIR8l_MCX9QQ&oe=69AEA590"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eS95haHL-AcQ7kNvwH2mOUT&_nc_oc=AdnHqQkVy6NA61MsRlBWSomRb9o_TFxU4VnL3Y6K7xKYubdI_u5y0dImKzwd4IyJWaM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCwMNZgRsbq0ZMaEqfM5AM-NzeVZ6daMGgLhFT4hV9wQ&oe=69AECABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Mana
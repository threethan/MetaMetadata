nt-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xyCTS3pFm5ED5IYJrVG9cZ5Y0qBeSNTMB2vtBEKTw7Q&oe=69EE108A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKIe-pBwqG8Q7kNvwH4u_E-&_nc_oc=Ado-15S87zY2jwFaeQ-nuAvY70naVcOAeYXznIbdff_XIOqk2HYhADxSc43XobWORpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vCXcFzyuE0yoKNr49I9W0IMHs9OEyTzgboCKOwaxorg&oe=69EE22DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_oaL1F1jrsQ7kNvwHCyCRW&_nc_oc=AdqY-dW93pjBnSmYZJaFAGqIHf12ts3tjLNJQ7KJHDo9O0inaa45rTgvHsIVWzlJgp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2t5n38wpCSZA_R_krt8melG0RJ3855Ypu2HVzmj0k3zA&oe=69EE25D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsQHF9UMeW4Q7kNvwH2ZqTx&_nc_oc=AdpcuAQR2jPNLK5e3dHZoda7Wz6_gWPUCjOnSfW30rWwQoV1T6u_a4pJOTs0W282Phs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0f-QHG-oU1vU3fUdYrqeWg1tVfXr07taeqIgKRL0WjOA&oe=69EE12BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_wv9jdW_HsQ7kNvwGcsbit&_nc_oc=AdpZo3ZP2mPHNe6aRkcqMdX3birIP-FruAPoy5f2-m4qD5AWRT49ugDIxjw4Zwl4ctM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hPlgNjOW6qFdsX0mrnA--CDRgS_a6caYU4yjSx4ubcw&oe=69EE13B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kMJ7D3OsJMQ7kNvwGKOyA6&_nc_oc=AdrJG0oGEQ82uZc_ZvQ5_wrTbjB_yyYkso-fLcUosuHqlMR1SFE4mf5eSew2ViCJw4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V1o6garK0dlv1YhfZBsFIrVqOlpm5gSi_oboeF16aGg&oe=69EE020F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Bq-LdqmXiYQ7kNvwG3qSZ_&_nc_oc=Adpj4lUWYMNH7lEFTDeJZDD8QUcjd7o9lfOsMJxD3AfAn2ZSE9ibQy4-gPh9KUSMUmY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Vwg34YR8C1mumDbLXNQG2uYqn2I4KtDx5wd6_scZzGg&oe=69EE0FEE"}, {"file_name": "005.VS_M_Squa
creenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55EkPrO9FAEQ7kNvwEYNp5A&_nc_oc=AdkElbNFVNlm2UCliQWQ7ejQKG5tI8x01mVF2rES4flcTZjl-C1hBJ5c61GR3IenGxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsJjHUxhtOp-p86ynwicEpV8P6UnUacxg5QCSlEjF7Xsg&oe=699D7F1B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bm3zjcOYcTQQ7kNvwEnZM6V&_nc_oc=Adm7zogZkDb2mER_aCxI-_7VBHRUP0utuODfzx000zKBe06-kIgQLgn6zvDuaG36z8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfswQeRw4HEIubRjsltKYKwfgi-_3n-7n06lJX-Qb9RwRQ&oe=699D8210"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0mkFNruIq4Q7kNvwGQmwh-&_nc_oc=AdlxPkysDWtBLtbCE4fNhP3yZ1JEM8eZsbeCwse7Uf7iM2wDu4LbJsbh21kZeps4zas&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuQycvP5q3Y5W2ta3cn7xlUTGIB5B94GznTLmsMkOd9cw&oe=699DA73C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, 
nt-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u8re-B_W_tWfvq9LKzUoxjoCRRPtOjgXxsdM0KfwG6A&oe=69FC910A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-LuOfmp0GsQ7kNvwE1-afY&_nc_oc=AdoWNwkS45RnKkGqLYFQkSLWwRFZOQPYBmbfHQ3Aol1tDc5esOvkn7ZpImwLaZOiDY8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42BuX5JgPYOrPlTm6XTh8Actnac8LZFZewqeYTBdd5Tg&oe=69FCA35B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifsoLf2kPjgQ7kNvwGK-Ex9&_nc_oc=AdpXsWFqLwa6E9N0JX8JdP0Dk03-oX5_VB0GNgpQAFlfM-Xk_rETFCCOoG5bkUiPqek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74dmWB5e0mZHAW6W5PSnZO_w4J6DblWs9Npm3G_R9AyA&oe=69FCA650"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXkgRs0zJOUQ7kNvwH3Cpqg&_nc_oc=AdrIOj098JAzhTjIM0UEhYSzPPH7QmMoTc6A3gYMrNvmRuBXibwcmH35MzZ-qhG3SGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oT-AqawoOr9tUtEJF5g2qbGTSsWRYc4kT8kuA1XfjXw&oe=69FC933C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMEWBcOCjXgQ7kNvwGgWw44&_nc_oc=AdpF46TwqUgYDtidJypSP4ZHTh_UudrqQ0KXjXKFORMSvc4mHVkKf2N7dxQmGMZvPm4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ti4G6BZ07mRfFHr04kHRy90_M_3gUK3U3vvhU-YBjXA&oe=69FC9439"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1DJLMbEpFgQ7kNvwHvvOaX&_nc_oc=AdqfLcqarkPYSItc2vp1Zz7uJ2rWL150ZA72Uzxyi5sNaFrcTiVtSXjW63vV_rKdgIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-uTSkhjL6M5U8-KVEmwrlpfP5KpAZxMNZQeF8Hl_F_A&oe=69FC828F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyqpF4X2Xg0Q7kNvwGy6vcM&_nc_oc=Adq0yi32yP1ONs6NJUQtYdFd6QfsJglsagthoi-_gyNzGheJt13UxCVFb1EtS60AnIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cnDpmuWHbF54YVtM_JwFea4iNv4QMZghxVglZvE0Uig&oe=69FC906E"}, {"file_name": "005.VS_M_Squa
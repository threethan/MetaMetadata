t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBx0Dvpm8RNBjkXVtZ0LZ24HKB-AWTqZWd2BGF5Y1Wlg&oe=6A63660A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKKF7Ew41SYQ7kNvwHeYjNp&_nc_oc=AdrZ0zt_aiREIusdMnYUkVKKMrGJuYqzpehw3oQYxquEGxbMrKSZELsEdjVFpx8NBj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzu23aqcwIOEmNp63xIErNosl2Y-4wINqHAmgTowdjcQ&oe=6A63785B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKVWi-HEE1QQ7kNvwG90Gtv&_nc_oc=AdpJ_K4iWMuzPnHYRNLtyYlkhWulN1pwKAAAq_Z0CcYysOxTK0ENynAFUwKH7FzgyAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_4qIalh7Ah5maZw_WaZ5NHtj4t8yfvVJHHoPbSzzzrg&oe=6A637B50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YizzIvN1j_0Q7kNvwGmybwr&_nc_oc=Adr34CNKgQSy9R6o2TIASdVYHcTalRdHib1gGg00jHJGYG0ZC749dJ08S74eP6ACjj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFUycYZzyPSllYJEt2QQ4KwOpeH9em9kDTAh0WgSr_eQ&oe=6A63683C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi7I7b0iyKYQ7kNvwHNoSAc&_nc_oc=AdqRjw2ygq6HUrbr8ZllsJsbWV4Xu5nC81ezK7ERJ-XKJ2RAh2NDpLU0cpAMCcdcoPc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0t-SgnMCxsHIU4yGaW2dtdO1sHGmzjjiYUk457akXKQ&oe=6A636939"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajS-6fp3p7UQ7kNvwGwpj2j&_nc_oc=AdoUQ_OEAau-m-6R1PkmWYQdnxbnFH2q2Eb92WG4VA3OvTK0HKqmhIPzIyQKCm_YdOs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsp7HvLN4xH6kTvgy_RJ1ppxgPyVBielwwJSOIXn_Spg&oe=6A63578F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zeGhyRsEBkQ7kNvwHuAUt2&_nc_oc=AdqfQ8nLaAZaaDqGQsBcGI9cZQPci1oynLEkge7oXYhQu92HKSH00LFCfT37yJjIMq0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc2BpThpjvtVZQ4e8vfvCJ6jKcJPI4YS-VvkgsEHLMNA&oe=6A63656E"}, {"file_name": "005.VS_M_Squar
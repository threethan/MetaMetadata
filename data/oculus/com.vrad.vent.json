t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af976twZZqbXU22L_3zs2Q59ABDDwjMrwYwiK_TcrjdRjg&oe=6A3FCD8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MyC_uzA0QoQ7kNvwGxfuXt&_nc_oc=AdptgwhhUOujvPHQDK-OK5S36JbCIBMbR8SecxLEm_dy3GUMb6hIp8Yc0VI5Hfulwao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BUx-hzBoERUyXakI7lAr6vRJW7oWHlqqYqXo-QqdwfA&oe=6A3FDFDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7_FZSTW2HwQ7kNvwHLkoqp&_nc_oc=AdrjZOWqHSdWtX6z3cmnWmKEA5dlnd4-QqyOUuEQte4G5FUB9QU4kgSquzrB-uo4rZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PvTN0tcJj8l9XptyDNQCw4hmXMBZYOurXlqkizibnDA&oe=6A3FE2D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCj9eGR_6_EQ7kNvwGbJBYG&_nc_oc=AdrUTooiLOsoB-NHe5LtwJ8QKqgJpu3_VWtOXBiarQtlkjwpi2MlfPEDxDDmiwGOiUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Iz8-P6RZFqs5xePaI38sQ9IRAEADDwJAje2HCQEx-Ig&oe=6A3FCFBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQ55lg3rOqUQ7kNvwEpNrPq&_nc_oc=Adojjvtw716CnTG_eA0RWPQ7ritM8ZS_fwAKBVXSCtPYVLRHkEuUjxYLwr8cZ6L3dAQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ijo6jhsucrD5v3-es8tPv4BnhwCTNRkeRCahUfLiD9w&oe=6A3FD0B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxnlGFJglEsQ7kNvwGH8CkZ&_nc_oc=Adr4bjMQCAH6HZBMuz230Vb7H2wXMR0m7CdeUo3GEttSinKHxC8O1J2ZhJ69Ih7fu5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82j2KSC8QaCgLBDzeEGcZuzo5mKYwsCfVJg3eVr5IVNQ&oe=6A3FBF0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xq8-1ClNziAQ7kNvwHzywmM&_nc_oc=Adox6XMbKo1FmOnmaWthxRLorLlR54vaOg56fMVZFCsAU2y3IOwVxvYtN7tS-wv0UI8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PiXgN38fJEQ9-EfVCPcxQ8LBiPpGNA7nHsM-_swULdQ&oe=6A3FCCEE"}, {"file_name": "005.VS_M_Squar
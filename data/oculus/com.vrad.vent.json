t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jSssS03q-G-GYK3nlu04mhNcXHETau42Jrea_X7jy2g&oe=6A2EAA0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pL38g3zFHvMQ7kNvwFRIgWo&_nc_oc=AdopFsIx3G-osyW8Jz8uKdND-CH3P_NI8o6hOEEl4oSkzjdSq0oTz4A7A1s3CloPQUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hvn3TMpzxuXighFAm5prEsORMqj9dQAxZbFK_At8LqQ&oe=6A2EBC5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUtayMO5TJ8Q7kNvwFaee2F&_nc_oc=AdoaYsIs9ocoIpFEOh_sF2wo6yO3AqHL1iZ5-ju5hut3U9h56vf2AQ8zay5MN4wr-ZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94ZwjHTDy9bff-xn9DiaNgfMTnwMj620xBWalpKHe-sw&oe=6A2EBF50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zy2fdWTBFYQ7kNvwECFzk8&_nc_oc=AdrgLuTZoaZXj6sn3lomEd_HHsdi8v_cS0x6ZxHRUiedPmpVz860-Y9XcPDYaha9mag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ARcPqr1I5ZVeNZQ6KpBSsv2KQTSDjzKZOb0KMVfzEKw&oe=6A2EAC3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYRqWsiZkiEQ7kNvwFu5yl2&_nc_oc=AdpD9bxlXozzJNo0l1-U2xCNNjGGmj57wGA3qyUwBYBSquhEY1L8EZTOTXA8vMKs2K4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VikEv4q5GIhlNVbhjpupGDLT-6nHmtxBLwK03SkI9iw&oe=6A2EAD39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRyiLNWTzIAQ7kNvwGWPO_A&_nc_oc=AdrB40QOVGoGOfp2M8eQRPaRTI0AG5EVM3kAOPz5phUikYfjUxgwmPQ2vK1OZtiPIWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GumNbfESCgMz9MAy1n2aSXxc9maqKdmEWT6P7ebXMaQ&oe=6A2ED3CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hJ1cbrh1SkQ7kNvwHecuio&_nc_oc=AdpGSyNRNV0zZrtUxc8Bqd41u-bMrDMU7pST1AdPrrhkwfHLufcUzDkUpCEWc2POl-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VarJFMwyY4rWjdlLVSRnCXWQNehJpinhMvk_AaI8kqg&oe=6A2EA96E"}, {"file_name": "005.VS_M_Squar
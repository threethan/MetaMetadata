t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkz-rXC-MiEGQfgT_VMDoKpVJceVjz78qmD5Y3rLZpmg&oe=6A7F158A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOA9fchcDkwQ7kNvwFjXoJH&_nc_oc=AdqnnJd2Jrwc6kOKDV99UBgY3pfLGqq-q0V0HKHbT2EWdYKbmDhzshwp3OGSd0CtCqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPrhcam2CAFxR31Eu5guvM7C3UO9Xy_8Zeu3HvtfURbQ&oe=6A7F27DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FY05wXWim-gQ7kNvwGKK8iQ&_nc_oc=Adq9LEIXpMynXtatw5epAN9GBaRp1Q4AscFoogvNoNH8P2LeZqXER1IsMEYiaaP2UJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCmdrXLYE1slbQTgbXdT-YqI8frFeBMUXzVt_YG4fPjA&oe=6A7F2AD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVjY9lkKOSoQ7kNvwFh9p_q&_nc_oc=AdqDMfBiKiivCR_JLP1rnaJGar75vFweGVhnZ3Oe7dbRtMQNLics5j2jr7l4LXtnMlU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1QuF7AepKIK2rRSP1d7XfyWLd-g4D4sJrIv0VoyFTUw&oe=6A7F17BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNzQJ7CRQjwQ7kNvwFND0Ec&_nc_oc=AdqQYVu-3UwBQn8zjeU7dcBI3J-MeE57T4Y643lSsAq-rTzLd-oN5j83f66otphR_7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcIsSXhFxtQ79Go5wpaEQbMCEmlkGvKX03OWirMNZuhA&oe=6A7F18B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcRN47lXuz4Q7kNvwGhKnjw&_nc_oc=Adonq7T_aibe1WyJFVXCA3_P55xFWsY93CyOagrPHA5BsCdZB47Jp0yPvzcNVhXHEts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRDs_nDahwgzBllt0UvzRcxzOiw1IQlwvcm5jhdih4gQ&oe=6A7F070F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvXn65RlDRAQ7kNvwGruTKS&_nc_oc=Adqsv8P-sLhDBfzsRz5qSqCkzQ3DMuX7SrJ4TtlcJwcxJpow1vi4y5sR_q5rokbVQuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKRrADiKEEYs2KSwrDICKqxP77IQXk_3TdrVPoTLWg_g&oe=6A7F14EE"}, {"file_name": "005.VS_M_Squar
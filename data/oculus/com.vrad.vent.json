t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsT5aJsfakIVUHbq-ojHjeQHnEDd-_rk5y4dXjomznbA&oe=6A73380A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqUOxALKHiIQ7kNvwEVEe-m&_nc_oc=AdrUezK177sTpCLcUJTQTmnKHRjL25CytTta5LdHFswhTnZGRstPjAjNCdiJUXSgYEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE48pu11uFaVKXPbX70ujGBuIIayw8ddrzzX1ImVZmLcQ&oe=6A734A5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDIJResSdjAQ7kNvwEcIJDB&_nc_oc=AdptMo9kQnMRyzN3Q3KqOR_TqGioF9eRVg_ZjmEVVJFBsoxqqEPHMxnqhH7_OzDovaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk6LB7KFIJ_p_3zTBSxzXEHsSnDevDc0aGckqc39QRaA&oe=6A734D50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnwkLRMC2dcQ7kNvwG6yzcd&_nc_oc=AdpX8BGEjrcOYdOgQx6tAkYdIC3rM4NkAE4IaAHyeErS1nLQh_BtwCNV_EOVIfnZcnY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFIT99g0FaNCs1j3RANUuNe1g7f9DpF4xmKt5vziMHGg&oe=6A733A3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxXGLQWr8PMQ7kNvwFOUvNK&_nc_oc=AdpKtH0j-8Zzqk-5Lv0sZNo6KJOUEimyBKwmoJYzbTySU80QToOLU2lKHSBvWH5RZ9U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzAD-fBUsCURxoEuEI7W0f17naaovJppcQJwrvINOYFA&oe=6A733B39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AltwcZA6rZYQ7kNvwE09MOm&_nc_oc=AdpticSJ_L8JJRaHYv7BQBKTXH0YIcrLLiES5RiTzZ5QwxXxM1Pe4pEJZTM3BUTr2Pg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYOAUP7jyrnvtSMxBStc-sFUkTEHicydTrnKEtz8kBAQ&oe=6A73298F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvS6VoIoyHUQ7kNvwEG-3yF&_nc_oc=AdqsJhGlqMEjNGrWaMMJqQk1B4k_MxwcNhZ4jLwL97laDcIWLnvzHZ6Lv-ssZiSqNTw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3rYMxnro3Wc0O2DzteoIPm6V2FRFXlEA8ZknHEhJdow&oe=6A73376E"}, {"file_name": "005.VS_M_Squar
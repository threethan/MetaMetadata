t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAzgmaCwcOodVTa8Pj4cDiZfqruKZ-q_HPQkImuOQpyw&oe=6ABBBA8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX5iH9MiN94Q7kNvwHFZOxR&_nc_oc=AdrI_6tzFtqrSrwWsVhvFEy2_9Xq1ps1Y2_8U-_sZt3GW1dETfr9eBgx06VDkbgaDIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9FbpoH8LeL_6Jp3sjW_Bx_5G0OZKVXRTD9z55lgOPHA&oe=6ABBCCDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZcAV9v2-vYQ7kNvwEEatTT&_nc_oc=AdqSf3aSAPlCIzJkhjE1L7UMPeAOd5f-vqMudWO3AiPsd44gEyvlVxl1ua2mO77Yn-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnRXSUv39lcU5u6h5JLV-jaVl2A_GeogI9OLtYYfFZ4w&oe=6ABBCFD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwW8LOkh6AEQ7kNvwERIuru&_nc_oc=Adrj28b7hEWD6XFdx39xQnDyEWeeAPR1cfpMc3_k6cG6hmNaGvOnzfQhuRcl1FSZ218&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7kYe3v0CCvLSlH8FGNN2MNVTap80ld_deEYNY2c_Qvg&oe=6ABBBCBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28jBEDNvY0AQ7kNvwES_ykZ&_nc_oc=Adp6fqpESdC9QgqdC6Fg3tXn0xYGM7uqAK3PqC5dOaBt2WDuWpGGVYP7Wps3G--MOn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ74dqojIgHKYT_HL61k4-Gl6TnyKaDoOVvMMlKinz3SQ&oe=6ABBBDB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2kXGhSLyywQ7kNvwECwbOt&_nc_oc=Ado-8ur1RKblleufWqrE5GmqyGFZF6Pcq2cbSGAddw7hWZUVyNlU1UrH9K9Qc9wo1W8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS3515FqdFOt1F64YFYFeyoBRbys6fDN3Tj2FfDmzlRg&oe=6ABBE44F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-Qt3MSvHDwQ7kNvwE-2MdR&_nc_oc=Adq4CCpUtes2HIrd3QeYnCtoDIZicLTBMlhYAPeG1qQT7t77r7ITzspSHSk2qLEJfSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7VtyeM-6r1CXlZYZVtRyn378gBv927itATZoZhf8Wvw&oe=6ABBB9EE"}, {"file_name": "005.VS_M_Squar
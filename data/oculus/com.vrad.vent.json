om/v/t64.5771-25/473398297_978657034226177_6887405616059201056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5loy5HvVXUYQ7kNvwGl0owa&_nc_oc=AdopbmqMS0kACUE1GJDbO-5_mpKA30Lfg_MGQ01LgYKi76jhpdmlrX7gFT-njSQ53Ko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4H4_FgUPEpS9X5nOqTMGnqvqqVqV0rELFO2_Ugz7Yrw&oe=6B01D24A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9opuea2f24Q7kNvwHrNSxy&_nc_oc=AdrSbYpGN7bUtXxh57CV_2LGiyQp_oQKILg0m3LBI8_2hnSG2lyaL-jvs8qTjGTytdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScVuqz0bddBWWsQawlEHZZdquWyN4mSOfplfOCB8LnAw&oe=6B01E49B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7czlspqb03kQ7kNvwHES9Ax&_nc_oc=Adrjgp8Cj1LMtnCGByXJJBhc_IIrUIRse2hnsMSq4Qd0utZe3z5xocDD4h0QZatolso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzZ2Icxb18SsoQtzsVfyC-orLHjaYTRNIuZS_UaXZP6A&oe=6B01E790"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv352duMedYQ7kNvwGhxt4w&_nc_oc=Adqvb8l0efqaKloW5IfTDcsUfaS1Q7YA0lTACY6BG_DByMj_wFbWbp7x9pDNC309GTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEdP0c8LeWd0YNpkHPQQVfXtZnC8tIgVRA0H9-3TKKjg&oe=6B01D47C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2Az2bxZGw4Q7kNvwE1YHJ2&_nc_oc=AdppsPFOWdprVbPpi4810AwP4gHt7HJPuDgg1qxCEd0QVwk2kqD4nOh07bdwBBEZ3qU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_2R_LC2DgYClkJCWD9yzHuxgjqltMAyGW_MMUgebHVw&oe=6B01D579"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMeByokXahwQ7kNvwHlFVQ7&_nc_oc=AdrSAiN5wAqVqZr-5ynmvTOa02rmQXjvfbjo1AtPvaXdHPGTkxlxnvFvNk-RSFMofcA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXO-dTMArkn2A8E_Y5PNmENh0QRnuivgmlkqrIlXE8wg&oe=6B01C3CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scont
nt-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JWFx52gMxuJzX5mvlK54dTM-Acl0bjLuI-Bc6_SZryg&oe=6A00858A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wgr8UpvVP0Q7kNvwEQY0I6&_nc_oc=Adp3ECHYKYfT0uc_ZNRoZ3ocGgOCu2QNuMRFXgOEAxxiTb_bBEPNtWHCCrrvjRi_MZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48KUJTmphRfLk6B2pwU_K2VH_Q0--js9plTGiJD23fhg&oe=6A0097DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkQRlsGVOcEQ7kNvwEwnI4p&_nc_oc=AdppR-qbHqaWBiw1uGEUsowHqZyBn5s-asQhCSh7b_8eQdW5dHbpSKIYKXfbsWU0epo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ry-xtlNurIinPdSmi9U76Phc-n63ao2Td7fjznccYyA&oe=6A009AD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4z58jk9l1DQQ7kNvwH14Jvl&_nc_oc=Ado4qSNyuHoJppBwnM8iYYHQGHNCBHABuamRpKC8tvxouMM_cQuobrwwJT1bCKhJnMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fdQ2zFcyu8sn1UXXQlGAvkskEijPIdpYdLtNE-Pgibw&oe=6A0087BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OBtZteGnqkQ7kNvwHeJcpa&_nc_oc=AdqnA5FyJkSCLHOWF7NaoohceJ7e0zs2l2umGpCSbSL_Heb2x6V45p3SInOqgh0oiQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P_CHmtEDTs_HFcOOZ-7Jq3EjONZtFT2qIrdGMGatxPw&oe=6A0088B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJgk_v8QaEQQ7kNvwEA_9ER&_nc_oc=AdqvSFV9wkMjoVjvc1ISU1uj5TxSkMUs06CD7R83Py-HfbR9FUsTMKcAqEOOqllDFlk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4viWRbQq3UmJTabOKjIz4h2WBWoicN33uXFvSXRyanWg&oe=6A00770F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXaX_Utze3kQ7kNvwFjxQLp&_nc_oc=Adq95qn6uyaVkVV5sGIJnQW_koizPXI7-qsoiG0igTmHYfzOMqGPAVrzbQIEalTtX-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BFyiM0I9ICZ3zzzFQyJy1WAaiITPsVDXjregwa2rETw&oe=6A0084EE"}, {"file_name": "005.VS_M_Squa
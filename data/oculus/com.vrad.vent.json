t-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkDMduMR2IkMFbzhFA_ElSM8zBpFkWxkRZ9d9-nRhwGw&oe=6A68AC0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRsIH2p8mVQQ7kNvwHDKfRY&_nc_oc=AdqCA1vzCKK3p8uE9N1WmWCvnDtJtd07VDXbJuECeC6yQMvVGwRJX9EIIA2abbfWbcc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuE8nhujhDXHwc02uBMmSpVyFJyFo0idvf_TkwMrWjuw&oe=6A68BE5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEcn-AgabqkQ7kNvwEqcnlz&_nc_oc=AdoUGg9i8fOXentu0gTFvdwTkez-4TsgcltSgIJZMDpw1vWkg7JNNE-Yx41FAGvVo50&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm23RTbGT5j-SY_hdnMWGNu0rINFRXn1Tq5o2qum53qA&oe=6A68C150"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5exsTduAFyUQ7kNvwEJthV8&_nc_oc=AdrNj067P4gTZ9wNhN1EAq3L2BPsvs5qT9RoYtoy3yMENs9nc2UeFJt9mfCQ21oBYEk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhLWDfYvjXRH_j3YMRU8TfqdnSOyYgBZVxHK_vk_Id7A&oe=6A68AE3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujfa-PFB5BgQ7kNvwHJveEU&_nc_oc=AdpNx9BFgdf4WZupHQ9GPR56MO46K7Yf_00lTvmVVGIvBz7536GrdA1kjc6tpNIzXfc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6Wt0w29VLv5__Ur2D8LN_24Oe6iTpXWD8-o3VB1wY3w&oe=6A68AF39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=regRsPvok2YQ7kNvwGPESIW&_nc_oc=Adp18Mctv8rN5A0hIE4f5e6qbT4NV8Dwk814OjpdW9yM-E0KYoiFxooZse7xH6R8Dck&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR8lGPwJEW9UKVD5X3ZDjDgVxBTxRRWG7_61AUhkvAnw&oe=6A689D8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ31m3W2_2QQ7kNvwEANVs3&_nc_oc=Adp_F56T47tT37jUf3KCZuPdsRDfzXujQ1lvQgcyWHrGioY2nGJinRCSvGw3nKVbkss&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsoStlMaoKLr8XdgbxV_7ee9olB1lUter9c0sOKb6JSA&oe=6A68AB6E"}, {"file_name": "005.VS_M_Squar
om/v/t64.5771-25/473398297_978657034226177_6887405616059201056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj0AnCbCsFoQ7kNvwF6mGpX&_nc_oc=AdqQVbwyLAJ7kdrYLjmzUBj0ZNq1_UA6dNvEBoHV_OrIQEpW__9d1Mau4MN-F30mIrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBrwsPTp_h_XO8erz4epJngydrYfj7_QqK_p0LA_RUFQ&oe=6B05C6CA"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rghXaO4Ob7EQ7kNvwEMM-KU&_nc_oc=AdoI0S1IW8LGt314-R7Rw7AB13BWuqUe_cOdvyDo2seo9GouZi_JHuA7fFYtoo8yg0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt1G-CjixszlxiS6yxOI9C-cvIU3svi2ZtLfkTuegtxA&oe=6B05D91B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXF2SWdfNcoQ7kNvwFaesJk&_nc_oc=AdoQmS2xkk6TdDrPZqQGfLJDWor7yj-sA2-mctsq4HSmSrkQNmIgZrbs5t1NNUxvBz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAJ-Mel2IPnjLDVo3vBi_LHMIFchLOIx9SORHqy4OELA&oe=6B05A3D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RV5ng3MX_YQ7kNvwHwYiRc&_nc_oc=AdqojjrYJX9kUM7LzvsA8YqRO6tAvWX7sYqagEy1jNMq6bsW_A2f5eSIFNjkMqa0oMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmKf7g9SFKXT44ELrooMQJsdV8OEJYrTJrjoKLZzz8wA&oe=6B05C8FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsaurltTN5UQ7kNvwG2Ztsa&_nc_oc=AdrYzEnu7NqhrauafK7ETAFbKlS8u_ozmJX5VZOsD8MipQ-w5W0nF83lSlDSlCJlfE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShkfrKySwflGP6GHutGSvoxThTm9VDNcBGdcEj2qM53Q&oe=6B05C9F9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kinVjBfeubcQ7kNvwEGp35b&_nc_oc=Adr8TSfwIyhm5O3lf8AGx7jcat5p8S1BqXObFEKAXdzImykJXP8pCeNEU91cvzgATqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-zRjSvOGtJ0yDB_BLwwoLG_t2eJGTlkTbK6pNMwx_HA&oe=6B05B84F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scont
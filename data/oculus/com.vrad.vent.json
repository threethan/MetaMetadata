t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BYhIqZgtwkAwpMQdQZ7AulsUPVdaN_fAewbJ8UC8lUw&oe=6A35418A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8X6lf-Db-kQ7kNvwENeQhZ&_nc_oc=AdrXlrjIuM1K9jPeNfIavydgYaoBZTX-PWeiBitN1w6eAzZdipOSSVbWc30oofs89g0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MTiSuJShwD4Bn9YfLvsB6PBy5-4UrxTdhyMzMagZDHg&oe=6A3553DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g6KVVB4P-UQ7kNvwFJyvCL&_nc_oc=AdpV87Yx8x7ctgVs0tUcOcjYQX41JHTFoneqN903NUBenFUU2qccVm5lDaZJotR_0po&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fbTM0cVJLHypTQXXXiK8mzbz_1fPFEwiPVs_-uNLQRg&oe=6A3556D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fb64Qt8aHV8Q7kNvwGyZvjz&_nc_oc=AdqQ0zCkHxp6Skl6rYdTC9RvEbRB4fh2au05eYakigMmgNDicxNxX58qnzYeCiCCckE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LLKjkJ7yOEkjOksuKibYX7PfXlYEGhGfsejvgMbYkBg&oe=6A3543BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j2YtzgWCsgQ7kNvwHqFGva&_nc_oc=AdqqIW0q7BR3y4r9sAERcjgj2Yi9_teya7phe8h95-rPNB3cffH5Jr-ux1falJhQZZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zh-wyVOmRSaX44CY0lYr6ZyKHCJsasipCwdyfkX0UEg&oe=6A3544B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVXTxn8hHK4Q7kNvwFuXQSP&_nc_oc=Adoj9_3gEoBk4oi5YM6S2trOneBEqRVPMjdIQFlxzixFIWjyod_ojxK8ng3r_RfSkhE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DVxfJP04jC1MrKd4F_iTKxKOp26rsZzP8ITKzKiPUiQ&oe=6A356B4F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-01BEV2VQUQ7kNvwEG_zwi&_nc_oc=AdpRYJfJdJp-DCFuZ-xEHfUn8sKlgwFwySWZ2asXCI-6j0-TfFH9VP-wR8b_uqhvi-U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_DFgs6iLDXarLBJy5sn805qK-OBPnN6Nfz3Dw6LJZ7g&oe=6A3540EE"}, {"file_name": "005.VS_M_Squar
creenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0P8-Bn3odMQ7kNvwFFG9fZ&_nc_oc=AdkcVlWFfiFaLKZm1Oq7BRmqaNyoBJ5Ga8GPVMFMgeFQQWdcIH6UwCA-ZhrE04j0Fmg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft6znkb8d9FOFZhpxx4_82Q66805xvf5hW3dBwvCuWJKQ&oe=69A1ABDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6STa-ISb8IQ7kNvwEfe-MV&_nc_oc=AdnnczbruE4Nj01tKmswJh0romwfN5LZXB7BSfV8Kt_glwIPspLODRmecNHOx5E4BRI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuXkiv2xwzCynh71INV2YR2NxIMbPuJe-_MeGXEltl7Xg&oe=69A17690"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrMaR8-yeXMQ7kNvwGlCIK6&_nc_oc=AdlQAtLQr2m-ZT_jQkhBJj0ERuSCN0wDwkarWX9SKI_x50CMzWy4oKWMclzLH8MxDSE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuUOjI6dMmusdbO70cy3O9v3vtUH6_H8KTvNxbcglhOWA&oe=69A19BBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, 
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuclzWjOILlnTkDvqJyTok0WvgZVLW8HG5p72rKa6hOw&oe=6A57888A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8Noxq1D6EsQ7kNvwHoDXEg&_nc_oc=AdpsHhnV4fkGWwFs02ViK675z7QudsHvf6U_UyoT0gLqhhWVBfX5XqqJ0J0GPCkgt1c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCrBxAVkKANABxoHKAaY3sMe7zvdJom9F5Z-GmLoBBMw&oe=6A579ADB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jCAgoo-alwQ7kNvwGVZdQX&_nc_oc=AdoXFlMb0vh_lRkJKoaV2HBbkAJ3y74j9Q7wGrCXntrAW-HKq9ruoMxE2ekvu3zKByk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE8qw53imhdAYPDxtMGxwb7jvyvj8nXBCBZ15Mkj3KJw&oe=6A579DD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JoPEE3mwN4Q7kNvwEQPOTJ&_nc_oc=AdrLOFDa75nciNryyY4NUqn2zG3YHjvn_Gid_tpxDxmwOcdQRK2SwW-NBKj-xg-L_sY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFNnIF_NVhHP02uFRQVPrboHCOlaf9scqL6zFzCNeYkw&oe=6A578ABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgwOjYp9kQQQ7kNvwF8FngW&_nc_oc=AdrvXPEJahKEnwR_MoknOTJApfewaTzWTKYrOkdb35qwtzp2wTsZ_ZegI4xEQ4ayQa0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1PuHyQdNdZqwHG7DWHQRBREqhFbBlqAwCXQQHcEEjgQ&oe=6A578BB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dInBEXhThBgQ7kNvwFfnIJU&_nc_oc=AdoEmHs6NaQzWN5nyBItvb2BT29WY-zsFGRi56xw_lX3N_s53Bid5Y21QP3odyfwHd0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEtfkLJMsQpyS51sdIge1AOLavlLTm9FpgHyumMUj2mA&oe=6A577A0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeoJU4Gm4owQ7kNvwHz-RIR&_nc_oc=Adqn98vUQ3HycPRfrHLUkm4cC6b8PNDZtjYNlaG6IOMuAl_IVIDHCcY6cuXdLeygyho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwyGKC_iWIIq62PSvT63RHxxZ3AeqmOAEN9iH_W_jo3A&oe=6A5787EE"}, {"file_name": "005.VS_M_Squar
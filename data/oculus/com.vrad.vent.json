t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP72MfWS7d9qj-XRQOVZ3PTPLmMbgpe5Tldftn8--ofvw&oe=6ACD164A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMSMo_DmWngQ7kNvwG7um6O&_nc_oc=AdohxHNV3d1E2KzafEnMhcD3dfPoUy5cZn-9V7LmwlZvRIorUXAHbQiAhz18pCG4Hsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1DNK6VJ73-oijDvzCarYfTarYszDuOpL0mm2Lrc5n_g&oe=6ACCF05B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkHzWq3cHbAQ7kNvwEjwrGa&_nc_oc=AdoKxHOIslM79YGD9brjKHcs9QBRlxKqXQaZ4MBj3HItzJoGibvfUqu3rS_y99xfUJw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmEiAO92KvVR0Pmr9z9S9ym708E-JzRDE9Dg-6GvgQvg&oe=6ACCF350"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQYghEBciwQQ7kNvwEwtoCE&_nc_oc=AdrK5FG9C8-qAg4Giy5vQfEoRgf9UlPiHOhKvzjoaQ3fVG1nIdM3Z4HJ3YFE6-6Z5TA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVqIfzNFhs9hSCCVglrKiEIuylgAjSlqKA0WWufEX-zw&oe=6ACD187C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u6JfbWysn0Q7kNvwFDUxBP&_nc_oc=AdrOiHD7JN-BDvfXsQ1p42vNgEYoJ1k1czoKZmYJY7nx7VbEuuUPRZTq-VxroQFsrmc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdjOZYXqMIO8mwxNobglWgwDJVHzyePW1k3GNNzxMcNQ&oe=6ACCE139"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-puUJPUOrtoQ7kNvwHU3Yn7&_nc_oc=Adol6l3uFw0QOOpNfdSS1v-C-n7yMUp7OAtAIiIzU8TxI_N3pveYKtS8PYDOea9mmUI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJseZL8wwC9zEW1w88I2hztVZOfLQtfBrhmp35TM24Zw&oe=6ACD07CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSFTtsTbrhAQ7kNvwHrErmN&_nc_oc=Adr_OVXqHBtajCp98OpR_nxMIKFV6UwfF-JjcP8BkymMTRfQeLcgtQockPKijGuXAIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYUuhFZe9tzS91sBAy-uidh7P0PNOrFtQf9LHitCIpXA&oe=6ACD15AE"}, {"file_name": "005.VS_M_Squar
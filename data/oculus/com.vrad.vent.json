t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gfZZ62lLpbCsuPBd_fOZJszru8ca_MteDs2RdNPJwNA&oe=6A3D2A8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTfmLGeR82QQ7kNvwGBGHc2&_nc_oc=AdqQ_9ggtMVmhwxyF7cxl7QMLMafSvB54ImAAx3YzdvjoPmy-PdTUKiwSuDl7qOKXug&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IImgRINEBeDcga4WuzqgxBioCmHAHBtuDVkC1iMcbNw&oe=6A3D3CDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7_FZSTW2HwQ7kNvwG5f0JK&_nc_oc=AdoYZDl92YfybTEqfN4D1OVOOmVAVWTvaLCiMYDWKu8kxblVd_5X0NiRXCDBT19507A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yl_5Jw46e5zXtK2ocz2dWVEn_N26N-ZAM_B0D9YgAow&oe=6A3D3FD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCj9eGR_6_EQ7kNvwG98cME&_nc_oc=AdphBgVvX_HKI3nIkZ9dGH-JYTHB9pmRCyv75zQnzZxvUjE5_UfBqXRCDygMrPIC6V4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xrUXhvuvoNsEE-k9O0G21jBmjwaNoK8QThWBntPdsJw&oe=6A3D2CBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1S4oJQbJyUQ7kNvwEPdhNZ&_nc_oc=AdqgOiifHkYXZhd0cbOMarwtG4n1Op_VFqgmXBiS2GEk52_Wu0V2Witaa7ETCbc_BKM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bU1m6NQyOduwSVF8mFDHiAx2SZCkPCySeA7xBw1PDTQ&oe=6A3D2DB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hFLtvexsd0Q7kNvwGqdqcM&_nc_oc=AdpTVP1c1PPwBPZXPmbdf5i77my0Bi5A-q2SE6j0XPD7b8dkQQIgXmYZjgk5GDYwjTc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93Zt0J8rSZwLsWq266h1vZoxUiQ4LVsf4eHhI8RoPHPA&oe=6A3D544F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xq8-1ClNziAQ7kNvwF9IG59&_nc_oc=AdoW2KGFCAQ5h7oX1ZCPwtt96PJomlTgZhgW0T9rEZXHt3SWUfn20k_fTxkYn-u9Uvg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_f1iock0WpQoXZxCtAKAN0WaxTjfkDYNQL6J9Wy2l2Gg&oe=6A3D29EE"}, {"file_name": "005.VS_M_Squar
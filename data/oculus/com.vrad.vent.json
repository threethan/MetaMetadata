nt-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lcCXkMPAd2qZMlgssjcB5kpta_BUMVlddL22J6S0qOQ&oe=6A10578A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvLdIlx1qq0Q7kNvwHWtj6T&_nc_oc=Adp8-xjzCw51oGqqf-lU9pAQNuhYZzNmVmGThOah0oyx-39yhBZGaT8rOalNEcxsEjo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kKuK4_woTIk8xMikT_EQt0dkw3s8CrJEtP3T16lU5hA&oe=6A1069DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMkUucsqJoQQ7kNvwEOr8T1&_nc_oc=AdrbJ4EUeVXfm3SlS02PX6EzMvpz6BZ3p08Ra_nUwzlCn9oH9-Rg1UP90EadYIG7eag&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hPtIAjqeN8LRPhrOYP0yucFgq9uaQJ_MMXMvbJELPMQ&oe=6A106CD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vo6K2cFtGUQ7kNvwERlyjk&_nc_oc=AdpkI7ERtyQD4GnKF3sQNokan_13sqQwtdTuvWM8vQuuvN1DM6SoYDvbRMXlgLCvQnA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SNmsoR3pal7Rkz4_Qr_HBKIOdlXCKbeB4RuXs5b_kcg&oe=6A1059BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4u6hTBgi_4Q7kNvwELHIBg&_nc_oc=AdpjgPJxCLf4DSsVl4DaHqBXMVgPPlQAyl0btIhAmwg9DtdUUtgHqVeYXi1CMKAMOdI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58MQwqTgmDnymp3hMB8x0oytHW-twPJKn5w0ynFvU9mA&oe=6A105AB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joIvHxAAVkAQ7kNvwHLVDET&_nc_oc=AdqLh7xiLcWeadHf2SOp3LAmUoqPPyJyt7Wh6xnAfuYoBQFr45z4KQor_s66U4OxxTY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mRmY9NCVv0Jmeq8ydBNI-y8jCXFwe33u03OPzuXF7rQ&oe=6A10490F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XknOsz80US4Q7kNvwEXqUw1&_nc_oc=AdqGOe5iv106pU52B6SZaONUpijeYTlZXolE4OkIl9vG9374cSs9YBp6EK1AVF1FO8c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P4UH194UwolIPPTmG1r5KBTbDa0MVQV-X66O-S9tbbw&oe=6A1056EE"}, {"file_name": "005.VS_M_Squa
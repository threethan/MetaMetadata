t=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmdGu1uzIu8q4nZ3Q1YJlUxb_0V486obWKkOQtPFi38A&oe=6AAE8B8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOOyePddgZQQ7kNvwHffnaa&_nc_oc=Adowpz9CdGbMEALDt9LMob9avXqWHfbTkfjKaaQ3Lp1etqs5Uwb09oAXAYP1_Q90N44&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPiQ0ye9Vj6GZKmaYHFxeQKaDYScI_dK9rHE_D94pNcA&oe=6AAE9DDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CeRh6ls8UwQ7kNvwEvINaE&_nc_oc=AdpN03uDAlhBSlEJ6ff0xzzhm_fE_s4fQ3SjPMU9tB7Q2RJI59dMGjo8LWpnUVEZF8s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlQ16JyIa4zMiY6AZ-Pnsc9PFh5geDDebLOAix-ppVeA&oe=6AAEA0D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eTZn-3hli4Q7kNvwHDBrs5&_nc_oc=AdoS40SGD2GtAeP7elQ1Iq8SjaA_ai4yKwcc_FVGmusX5dMmP6GnQE1D4SlUVfRz6iY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsaRxSshMxm4C4XcWqi7vOEbvk8r266SlK9RMyQ3xWCQ&oe=6AAE8DBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx1FZYt1kQIQ7kNvwH8y5pL&_nc_oc=AdqZCI6MqkQq9_o1WxCHc1l1h5zrTK18WF59I_zJ-qpIwCahw8kiRCUwKGR-XBt09pA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd7XifshdWmB9tik1ioeQZWlr2YSRRcN5WObJFtK3qMw&oe=6AAE8EB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6kC2HsyesMQ7kNvwFJGVtN&_nc_oc=Adru9C6TsoZ25j5xpV0MiMeWODAU1Ono9R0IbBsxrk-JUCdC5Yy_JBymbj6Pxxd7pU8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINTtuPpnHQmCBtWpRkBffTNQ08Hq_ccwhVhBJOtRTa0Q&oe=6AAEB54F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Zojd4-iB5IQ7kNvwHLnEmD&_nc_oc=Adpivzw3jef-DOFO1WmaRfgljqenbvUN_XpWR1sRHNmsBDRrs3YJuaKzrG1cd2r-pdI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw_skcCMjcmlr-OpPizM6tEDgoRedc6sfgbKQk9MBogQ&oe=6AAE8AEE"}, {"file_name": "
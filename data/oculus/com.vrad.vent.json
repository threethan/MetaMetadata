nt-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqSHVO_jphdDobWy-CzNafvqPmzstu7oTVzJUQWXjWoQ&oe=69D10F8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeFI3rleD9QQ7kNvwHhJ45X&_nc_oc=AdpJ4HrLecK8aFtN6PN079zJ9f6CIfw5enPVXttXDvQ7rL3bA6nVGa4VBsLE6UousU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZo7l-E5ZHGdcdJ1CASzbH2vEQVk7jnzlSDgOvi0An7A&oe=69D121DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AGsrgJGFZ4Q7kNvwHLJiPW&_nc_oc=Ado80LHjRicxLc4VSABZEUSMDHbJY1nW7AaM6wcQz6NMmXAMrEz9VjFY5z1OzLxuD0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHHcIAO-6uYJktzYqajjZ9ij2jzij0-1K3POUo5wlk0A&oe=69D124D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxkM1js7jAkQ7kNvwFqwMlp&_nc_oc=Adq3uiBXFA6ZrZx6T4x_gOKPNPdN7Z8pfG5kLxFwKoj1BIb_BQ5rXl1U602wFl8Ijzw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgCA7C-LbudUZWRgiXeV9N94bVEAHiJSKQukna62rVqg&oe=69D111BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM-dDHHdHNQQ7kNvwEUhC8j&_nc_oc=AdphY-o5MV_XNLTJ5ITRfqajt4Zw11a-Lhi7cJDreqm1o5ZS5ClXZWoyilfVqJ5zeFk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWc5IDv_Jzx1IuAPAo8vQIN31W1VnyLvM4JXblU5JCAQ&oe=69D112B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uHJeYn3b28Q7kNvwFDF80N&_nc_oc=AdrKTw2REl4SHohU0NMlA_7XvTq_6yDIHJNhTu9tOPSS-CCmqnD72waoM2UBV0601QQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqDOE5tY1QGvZNgvz-OGwZr_VJaQawYXyUKaDMZ6LrHg&oe=69D1010F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_3e4xfRFFEQ7kNvwHGxSuv&_nc_oc=Adq45AxpUItMFqprrTH7FE5eMPrOXWUwy-ANssQOtKQUtKoZmogJ7gVpfE3iXonVHK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGgaibLuJIkzvJaCQVsIxDfYZEEV4frDhFGhLmkNulzg&oe=69D10EEE"}, {"file_name": "005.VS_M_Squa
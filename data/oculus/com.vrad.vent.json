nt-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7is8Hy6vruJKDQgcdxmMQcobeFuMfHN_Dz7JjsDWMeWg&oe=6A12FA8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiraojGoNLoQ7kNvwFMOeql&_nc_oc=Ado87NTEyGUw5Y98G2GtY3Yx8RvAr2pod9oNKJhm8S2Se4eNN54hBmD5mqGQVJSeRSE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hTUeSsz9ypKvempJXk6DF93ZlWOelmBrBJEQnuD0PYA&oe=6A130CDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MArag-4PYI0Q7kNvwFkoWXV&_nc_oc=Adqp52OebN7di3LE0dVtUzO0veG8Tb2ThHkMlL4giSqOzcnUJ_8gDhjRTxkKGi8C2lc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kqF2OnkuHXRzC81k5DaNwuheP0muLqGpHBsnF0gaq3w&oe=6A130FD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sq8vPplZbwYQ7kNvwHwZMeW&_nc_oc=AdrAGW2ZVbSoHl_GizUW5gLT95uHAMszy6nwM-3Uk4k2EpomQKbr__2gIc84T3E0naA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7luCzJidTHVkDc5VorpH7YARLLpi-eSll5OM7BQzX7AA&oe=6A12FCBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9reHFhCtOoQ7kNvwHeJOWB&_nc_oc=Adq28Yy-s2sXMKKKEgLh9iiLsaKkXqusxPK-E7P9nhEMjqYS2DptfUFfMVB7ishMWOI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6unO5dL0Qms_rl3BG0QodaygQtnMqfEm_gk8EAXDyYTw&oe=6A12FDB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozi3G7XlvR0Q7kNvwEFKUE4&_nc_oc=AdqXBpHa-xxTbvwxajPBdIMB-q9LRuf0L1hbGs5agsMlFLDdJQC_-WJokgxZlr31hK4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71AO6yMg4heoL9wrPhcYy8wVoJCyWSdyOJDXn4i_DyFQ&oe=6A13244F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKnaW-IAwfYQ7kNvwEdBVdB&_nc_oc=AdoA_h6HkDZNqjxpJVEx7PGES2Ovv4z4P2Pbew9ACIakKhLGXvdzwOxi3z2tNj56b1M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W-qzFFHs1wI1TNrHff1Z4K5FgDuJ_AMxLGtBrbDmDFw&oe=6A12F9EE"}, {"file_name": "005.VS_M_Squa
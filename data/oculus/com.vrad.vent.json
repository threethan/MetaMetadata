om/v/t64.5771-25/473398297_978657034226177_6887405616059201056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nJ-eWbisaYQ7kNvwFjI5Vz&_nc_oc=AdpfSUxYm13yiProPzpnytaqxmk0vswm42K5y4hkYSBuKmV5X8LxIkwIKmbU5lCGeHc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTIDumFyUh4Hm0e3wTwvXpGhPeSxxoe19ucZrE6Y7icFg&oe=6B0DAFCA"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAEMuxbnQ8QQ7kNvwHP1e8-&_nc_oc=AdoPGaEnsgHzj1m5CGoJT6BAfnfyUnrnWWZylF03tztrY5JkGpqixfQ2oSNpjp2kYj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSBplGGH9OymJdq-sgv_YuKBFTs7n8d-UrK4b6P9Q79tQ&oe=6B0DC21B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5rxj0uYS44Q7kNvwFV2c4b&_nc_oc=Adr_x9nxEKUYy32hfR6WfsKClRbJuPzUQRta7_8A0cyGdTjGCFhS8OCShia5hQ552Bw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRR7c2gz33C2VqvMbP3kD0CSEm19wKz8V2Rg6aZSmVeAA&oe=6B0DC510"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj_j_PC4sZMQ7kNvwEvEL6E&_nc_oc=AdovjCJuGibs7CeOxYaGvkDGr3nlU0VED-vvOlonq2hfEo8hT0HYnD7nFYzSa6r2d3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSnt2jUxO5jLYCajyVbuE7da4pTgiwwC6-WlNtTLC10Xw&oe=6B0DB1FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6y9buAXvAIQ7kNvwHV2OLz&_nc_oc=AdrCWOqz3tfrsTvgC0L9911HgklJC3o8M9VTSSSO2N2Eph0Qgq4TDNI-eRLeoZz6sNk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAKaKhclGtv2zoEgjiYZk7vb6cRrLLJJqC266o13MspA&oe=6B0DB2F9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lgqy398K4UQ7kNvwGpPj8B&_nc_oc=AdpNEwznq-zvHZkW_S_cMEzFoD-XCm1YW5RBCkLBhBszPnQsoL5jG07odssjT_VvEvI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFcG9Le17y13TWhpRA0VO9lvFB1Ym48XjbEODQLjTA7w&oe=6B0DA14F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scont
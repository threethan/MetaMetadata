om/v/t64.5771-25/473398297_978657034226177_6887405616059201056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmCo1okr05IQ7kNvwGctCP3&_nc_oc=AdqJG74LHyqufE4R7sbW1T0UE6lm6nyAmrXIa49Ix3KVRqkQfkTHeYa_aj9ROAqzHp8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdrQrt4WIBTNvegJ2ppsYkHUqqZOKqtFgQten47QKkuQ&oe=6B09BB4A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSGJCBJzz0AQ7kNvwGaatIl&_nc_oc=AdoE1W6IlyMCpDM88oE_4TJo6-B-IyhRudLYZW5gLyAyny5iF7480zzRPyGsCu2v9PY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHnJXUAce60mrJRjQg4fdG_bhcfd-f--yHhQzEIx-Y6A&oe=6B09CD9B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWI_GIGm0nAQ7kNvwFtPoXu&_nc_oc=Adqc5_Y9E1HH8qgScVKMzT6aLRd8cjcoQXBE8NNb_yyXircOw3ZnsItrC50JJpPKZJ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWoeaBTc9lE3j2E42Est4i1ngOYrz1JwhQDTeDBCQERQ&oe=6B099850"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBiqBvxtGuEQ7kNvwE6BUqN&_nc_oc=AdqFg7CtIWnGqKgPZCmmhD5owIxaHcl5XDYmWWrS157HXk0WLS6wTriO1FQCtL2zk-8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa_iKPQ6BHWyJpBapWZ1rKrRunAzo8gfq1_dpdIBtzaQ&oe=6B09BD7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qn_2E7DKA18Q7kNvwFzDz9s&_nc_oc=AdruAEu9qIZBVWjCxzCJERuq0gO2hnMLLuTobZecTSEbOfQoFP2o0KnW0Krgh0A-4is&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqVEMSGZK4IF1YTH5PE_lnq-V43RS6KAnIdT0W-jHL9A&oe=6B09BE79"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnIgVfBYZTUQ7kNvwFZWM19&_nc_oc=AdqH8iaB5kjL8u7vHbtuPKTUd48uQcDtctqV8-W6qrE4c2ypFk_MPe_orN2T5tRIIUU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6ehgVNJNf7OzCPteSmVftjWKHmddI_M-siV-pWZpLIw&oe=6B09ACCF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scont
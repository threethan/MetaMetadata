om/v/t64.5771-25/473398297_978657034226177_6887405616059201056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6VrRP3TzOQQ7kNvwFXqXrs&_nc_oc=AdoL5hNZ-sQS_1-gMDhCOALsdg1AstWc0aDrFXk3i2cN9C2XHnnc8Q1cM_jKL9C3Aeo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfewGN0dx_EpOJ5J8WsofEVafHczBBtqo4QyJWSMz2Rw&oe=6AFC8C4A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPKYuv_dOhQQ7kNvwHE_iax&_nc_oc=Adrqhcv35DFKtWa64Rl8wSZZ-GUfrwyezgGRVOJg-bTxWxojc2fyVs1PBw4hr8JgvFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3pQQMFmLvP6iFVtFS6WKF-MgoPTuWoiI7lzBngEw9ag&oe=6AFC665B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oq-gk92f6doQ7kNvwHkG8MA&_nc_oc=AdoJl0J61t-TPGhpopCxw6TlFgZhowCY5Ky5CkF2ZWIrdSz084XxNDnUzZXnbeuFLLw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcSFtftYptjdlkf1dHq55zQa6BhZlG3E2ULb6FY8IM7w&oe=6AFC6950"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDXn5icI1xoQ7kNvwFiVnPg&_nc_oc=Ado1XjHP1cN6ctU7QgtkbAqa_b9VaW3pYS-aEbjIJiaaeoDDbbayDfPmeItm0rNpzo4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_JkxMT0vPs2nZqzuU4wNXP2puo3KW0YnKPBGmylJvXw&oe=6AFC8E7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjz2qwRd028Q7kNvwEVdOUh&_nc_oc=AdoRORPypQvNX8BJHOE7MRo_bFFitI-lFk9MzzOt6enG-tEta619qT8FoslOKZeF_Sc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuWIfk3k6STElb92A20wCX-qvsQW1Ercf2r4MkC9amvg&oe=6AFC8F79"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxdJnAcPjZQQ7kNvwEmW2z1&_nc_oc=Ado5LT_NI-6HJu5XvN0l6xA0ydDKhzMNd1PpvqZMIHyj-EcZWRRrpYv484xEA_4LA0s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyQZo8wtPQwLKyaahn8fAdB8QYbS1-CywVrddK1mAZDg&oe=6AFC7DCF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scont
t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsff_1fkexZoeHaOhkBRmevzBiQqj7WCEo0FNmCTB7Sg&oe=6A5F718A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HruYWZn_AegQ7kNvwHLaZX1&_nc_oc=Adpego5gIk_rt-v71_fIzsn5W_LHF2ge_kUZYIJBWZiT-kTkFOQCir9kJ5Uldl_TJFg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC568jjtHPOyOMcmIIGavaqLdWnQUu6pcj2dDxL7D6OQ&oe=6A5F83DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aqeCbUBumgQ7kNvwHoCAam&_nc_oc=AdrxykwGd_4ag5YZQ7b6UO0eDczWpsAG7iBtKAFSjHqolIHolFTdurXUMG4oFLgXO2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoCW_lJy2Pgh1u1iilBaafc4UHd2f81YJEfiPdmgvdzg&oe=6A5F86D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnYV42nn0DgQ7kNvwF7RTAa&_nc_oc=AdrdYdnIC-pXgoQrPxCFY9Epob8gRyW1-_eBYF_cRfe2SD1DhWQDp2OlL3GfFJqR0d0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLsRFXR35zNiHHzIkn0U3KPpBchV-0fktiPbDPg_RtvQ&oe=6A5F73BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zTYqtCSkOkQ7kNvwHpiZ4l&_nc_oc=AdphKtFSg1UZ2aEzBmvsweOA96Chv-LJrO6riHhqjGorslV1v8uSjpShLacaeNuD4VM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQ7Qc-IyVz8RIG8pRwmmlR_6b-x4ghHhHHPW9FK03_4g&oe=6A5F74B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hLKCUmqHXYQ7kNvwGcvI13&_nc_oc=AdptE5Z7EKSMq5WrHpjR5S9WAQdz_DWkwd8LfM8O2k6LRzZTv2JOQPdIHf3y6vnt6lM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArUy47uHD4GdRuZNvnja_ZfsOtjDylSwe1k2VR2zxcIA&oe=6A5F630F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySu51gg3a0UQ7kNvwHIkQHD&_nc_oc=AdpMB-U5C6lSy4A6wvSNlAZBkKhjqvim60CS08qD1oDeCfFEoHzQPMzJxNeqwbzecIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy4sLP4RToRubzwzFKGyi10iLIjtvIlVWfzAW5VqN8Vg&oe=6A5F70EE"}, {"file_name": "005.VS_M_Squar
t-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yggBrhR5vrBjU8LXb867pR-2tNVqUvrndKCsHq1VBsA&oe=6A45138A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J21TwIQ3AVoQ7kNvwHehKur&_nc_oc=Ado5YHohmtHfAeDBoAhRgrhphwiWXLd299E58IcHShepKorglA-hFPa0vlup7JDNsmw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oJruEesBp9vl7CZlzrvfEV1HdGCKepqhD5Y_fCxBfWg&oe=6A4525DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix5Gu85CGEoQ7kNvwGW8Ged&_nc_oc=AdqpEWSxI8tVBhNOGw15-QFQkbh_qTLXaKIV1PoqN_oxB8ad30WFFusRABLQkst0Jxs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HtA-KQZDz306scwYwRTp2Co7D4QaeUcpp8-U3oplgKg&oe=6A4528D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KGElZ6C92IQ7kNvwGco-TG&_nc_oc=Adp35fwX50xgqnLJoneUeMU_c7dQ52QJgICkPweMrq3YxY5dH0OQZ0ushElMs4-RDOs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q0FPH7xGkoPExtBSjpSreO3eua9rPVh1yxqzr3k5jrg&oe=6A4515BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKj3lQHdwDoQ7kNvwGMwNSP&_nc_oc=Adq-Y4ZmOzM8Ta_3oB-8c_htREssIJC8IhjnYCfVieF_uiwPanunkQZWa9a_S1xpVOg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hvcgeh0xisHTl0ud1YaQfsQa9N5RCxIcD834U9xjErg&oe=6A4516B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGS1bCK3oHIQ7kNvwFTZpeU&_nc_oc=AdqIGPxZH6av7Le25GJ56h74GHY2Bo-s2VNx5QJL5FvZBoNKKPPbANSdz4URmOl-j40&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-bhz0FCEQVjhV3nAzlcibzSdIt1Mf4RKsot2W32LEng&oe=6A45050F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGCLg7kePQAQ7kNvwEzK9qn&_nc_oc=AdptrkGNLFKzCwY79ngEb5gxrGvo_f83iL6gDvHWPmolz1p3nEkNfEIo7AnafNn1wUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bqq72b-Mj6cil4VCx3OhN-j2S2WgwI8IG2z45Xw1tgA&oe=6A4512EE"}, {"file_name": "005.VS_M_Squar
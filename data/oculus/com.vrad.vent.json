t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB4eB7QTgqUxLXzbVvmbwGeT_8xPylTl-RnxyKPm-Fmw&oe=6A5B7D0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=johQc3uPVRIQ7kNvwFzolLa&_nc_oc=AdoqFM58rgUTLiObA1Z6thJn4-04zY9GiGtIE9UBuLzoEtYkIK-pbIp5gednkzIhYek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqgDutjdvieJASGBgOFhcETmuzSoPdzq0hevKCP5N1Lg&oe=6A5B8F5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8frrxRr9SjgQ7kNvwEaDT2D&_nc_oc=Adqjrv0YEgfJUJXIzZSv4Me6J-DHemiyWigGKepPdjJbMK37jzHscB8umCUDvYTYg4Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5G2mHKA6E8rW9X2niGv-LzE7wpGqjT-_vwkjRcF1QUQ&oe=6A5B9250"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7iSRTLehp8Q7kNvwEkOEP6&_nc_oc=AdqA_XBRJYJjoe5vOTukKKslMihIqDcSL3MvegJXv3K6iw_yFGblrMYAsO0Or1JMEYo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAErF8FnCM4imrrOOvPyu9Smy28u8kwUBUCT_DBd64fQw&oe=6A5B7F3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNGkkgQ0STkQ7kNvwGEMv9j&_nc_oc=AdrcFzzvxYOfhbtZiZjk3lV4wM3LzOe-Ko07gUifrKFYFgqphFylfjPA5znWxj0E6rc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAogmUEZMURdjlC69et1Ny5T-0QkIUxHCHsqCPYqJegxA&oe=6A5B8039"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sIVIUZrcCAQ7kNvwG71VRF&_nc_oc=AdpsF3Cf8yw1egOyaOkDqLJElg7U4mFyajix8l47k2vSop_eozcO9lrZqIkcA8Dk2m4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVgeSj2WRdTztb-ml46RLqSrFmVEYkNXAA04ccTKCV_Q&oe=6A5B6E8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79drDCGLzTMQ7kNvwGXCHnD&_nc_oc=AdqLUXurEMBvu45UcG4OwsPcKWLQj3YcODtmATlYQVD_mYzNJpYKy0oycV5SN9LLV6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfKZwIcRnOUUFsqKe5XHRqhRXprGqIr6KJYWgK9UlU7g&oe=6A5B7C6E"}, {"file_name": "005.VS_M_Squar
nt-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxc18AUT1xqNHosGfpWDGn4xtHGdbzH_VAO8p9TjafBbg&oe=69C7D50A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1kTGrUqHd0Q7kNvwHDGOYQ&_nc_oc=Ado1CpsdWPF6UFxOqpUiyKwySZQNCMB6C4E5kJjqSuU41k5mWZPKt7n-zs7DXOWgQuo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxX-BoeCsWQYH9DzMng4Wq52EAuqDc0aNA9alzeO7h_lg&oe=69C7E75B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhQWVMyy7l4Q7kNvwHLldSP&_nc_oc=AdqdwNy3vqnGguVkaP4Vmw_lWHqLNp7vZ-yW_S17ZDXoGG_DsNGUvMWJMRWs556ATzg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIm8NjHu9ozY7MRk5SxOltQt_wG5BVlx_v9cFQqrOD1A&oe=69C7B210"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fs_W-3t_hQUQ7kNvwHBY3cZ&_nc_oc=Adoah_ijbmbkbCSB0pgw1rb4CUM5yL7bh07TETwp5aTgAsr3GfeayyHJZOXwiE3DS5k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRoEeycRsiIgW11rc6LEzAlHF5h2TqIDD5GiE_WtpO2w&oe=69C7D73C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSyMEoSPv1sQ7kNvwHq0FHn&_nc_oc=Adpw6tSuC2_IeFeWnT-Tc_3jJp4Sw3S_P7-qh6QWoRe3rPDesViTJzj7PGaY1QKZGco&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afziv60S0qSjQTtaBPnh3WLxz7FaqjdwWDzJFzsWhVK9Hw&oe=69C7D839"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCihCAGVyTcQ7kNvwEB8gXE&_nc_oc=AdqGSJLjZhlASdnKdFNE4ijpPtFY8DJhspMpzIgjuS-U-CpNPLaHeqXdcAQzEdqFIzg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8DrX94orTOMvuZQAKhB3XJrDDC7Z6GVJqYqqj5r2XHA&oe=69C7C68F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3PGPD0j_64Q7kNvwF8KTZS&_nc_oc=AdpLVCwQGwdf4Fnztk2aHxyK8Sd7TGUxEaSwupXNzU9TZPQfJ5QyEyxuxlXtloLKTB8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtDb-DED6e-oY1d13_JnOopAr6aUa1Vj7iDVS0YSQwOg&oe=69C7D46E"}, {"file_name": "005.VS_M_Squa
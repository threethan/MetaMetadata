nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mAvA4aMe-90QOAZkCL-OQmLcdFQKvmNZT4aOO2QSEMw&oe=6A144C0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiraojGoNLoQ7kNvwHMh1ho&_nc_oc=AdqgSwh3joOefeyU-JWDx7Q4dwco7pjKvkY4cwr1MaplLct5CkS6MHln4_ZuqGZPxGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53i5JwKx0j7ZTtL86SrWSb6mHFWRLohPG_yu0c9kIe0w&oe=6A145E5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MArag-4PYI0Q7kNvwGtflAM&_nc_oc=AdocntZwSrycMU1ocG2HWJ3qmNftu-hAzZPDHwgG68_lkplr5o5kPtFM2hg2qmWU4jA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7erICkeENsq41yLFDaBbMzQa-VfIegsPdyUEjQ42J-ug&oe=6A146150"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sq8vPplZbwYQ7kNvwFNoBj4&_nc_oc=AdpaXKI27-4KF3Zu2DQzSb4BSwob0vDFyz0g2yUMS_9G5hQw5J3marVaiNwOrdiAGUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69MBJFffM0jR17PvIn0vy4OvyNXOwpegRA4kuwOQ32KQ&oe=6A144E3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9reHFhCtOoQ7kNvwHlot_n&_nc_oc=Adp3Mgnrtr_Yc_G4WN6Tn7SF1qJe70IY7-XPg1o9BtOPiX02H6aAsnRYjTNbLEiRQaI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LN2iwpFKU3i_oPjl1XUbE1sdjb6CbMGluoCQOLZlUGg&oe=6A144F39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozi3G7XlvR0Q7kNvwFFaDXY&_nc_oc=AdoPtrBvrwJLd7lqsBQD1_PAq3ekuelErq8h4GaayYiwggZw_QsDX0nmMscRI9a52mA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Rd5ZrhIpAURoWoNGi1T10WzCBKPIQrlDV8t347NWesA&oe=6A1475CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKnaW-IAwfYQ7kNvwG-eKV6&_nc_oc=AdrMCbgcnbYTtA_hOvBvCoTxe_MKb-W4U_5n1YDs6tQ1pNeE_11-9EIz-8Vim3QN93s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Xi6HsnKPtUGcVEk7vW8EGvYho4xVy63qOStTDUaOhlg&oe=6A144B6E"}, {"file_name": "005.VS_M_Squa
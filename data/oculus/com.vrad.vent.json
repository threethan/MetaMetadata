t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjArtdq6KFlECxp3FRYwjDSjG9oS8UPmlT2EcMef9gNQ&oe=6AB3D18A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq87_O50ZpwQ7kNvwHCImPf&_nc_oc=AdpQk6nKKUGYfchQ4Y4988Wa66PyBqLRqAcuoSBoub4uoCP0qHjrLAU90SlfXe7Iimc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCUwotnGQHiP1tL18Gv6yfXivdzobjKsOxFq-6Zd73VA&oe=6AB3E3DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4suU-tLKqkQ7kNvwFB8Tup&_nc_oc=AdooihePeoui7rGFaNZ2sKBA6qp_NzbHKb01xlt50Gt-cJqSRRaWtQPxKN5VvJlJJuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrzvUzRy8cdTd7Oeku0BhZ1iF8xc_BkFzqXfK4lMLQNA&oe=6AB3E6D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksh43zRtcMgQ7kNvwHXaRYd&_nc_oc=AdoBdyH98u9LmZ9LwlidaSR3d21DsANkbSaOSoQHOneDfaJKMUCxLYvDwknf1kPOhKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN1RADUcGEAjx4m2s6rHRshh4e0ufgYZf2rIgkRpYDIQ&oe=6AB3D3BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ET7YrU-SO50Q7kNvwFl72Eo&_nc_oc=Adrg8Lwj8T6Wd68X4fkbPajCvK6yd-jEcBj3QaTTW-H9J9mhvUrA3Z-s0O3fVhbBB0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMylu5VevTLjPxXkd6fPjZUQW22MrzbAEbJTv5x8RwIg&oe=6AB3D4B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_2meYlC7kMQ7kNvwHht-Fi&_nc_oc=Adr53dl9hMAp1rn3oULrB1CeDwcFer4K_uOyT7oTG34zmVvxP0tJXH0hW0i53k-7TIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL09zLPwtQCAo-OOZiX7ZlwXadHiqX1q8cWc8PDdUOzRg&oe=6AB3C30F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FPrLB6mCFkQ7kNvwFf-wru&_nc_oc=Ado4TPQtLheU5_zsir1yeeL6MdLt6kC-UH1WKdqjdVl-BPGdfQKuMIwFtpDXCJSrY_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW0VviZgu8EgrPi31UVcisiw2WzZFGqeeJLL9RkprxeQ&oe=6AB3D0EE"}, {"file_name": "005.VS_M_Squar
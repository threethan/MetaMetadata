t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJExUgn4lWDX1-M8qMz10Tejs8TYhbJ9nsouLFycK1cuA&oe=6AA2AE0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-QkTCh6KssQ7kNvwEVmeud&_nc_oc=AdpcZYy9f5d1QRw8zGKtbz21sQ7FxII6BziMuKzkaP2kF_tBPi5-T5025EoA63qTUQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLF-5kdJ7HCuTXR3N48gnBvsZsZwAwdDDAZ5681S4rCKw&oe=6AA2C05B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i_M8qZAPqIQ7kNvwHAXXqI&_nc_oc=Adpddfoh1rjfnd1ac7EuY8aqzQtokI6dJ2fQ4pmvAgdBxrrKmdYEYa7eOare55BXevo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJix96XaiMVjAVuSzXNdMsgpfMVSC1279G8BbYvZKrC2g&oe=6AA2C350"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIabu81vcJAQ7kNvwEH7eWj&_nc_oc=Adpi9CPUEvAUwuzE-1a4muTY8DfWkNa2xTXEVVkmU4DtJ_bSCRqqPHE2QOm5q0sIf4A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIk3jbdsWsmU588Q5B7SYHCJT41eQRyo7WyKRKzCstzQ&oe=6AA2B03C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbDMBZ5BwSQQ7kNvwGdi6qW&_nc_oc=AdpMl9MfCKVgFw3E-TWtWrzKriIRHqK8F3qfDEIBLURNadAWy9f85MhrzOusOGLFI3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3f2MZ4Diy8om80npkyRI1FZVALpycEWqPHCk-0cMPIw&oe=6AA2B139"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLfciw535G8Q7kNvwGknZsa&_nc_oc=AdrJ4IeNZg8Ib-iP-5GcDR_iud_MIeHLB_THuIqvuWGdlu_f13ZcZq4yVJ9VD62dSo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfX9Jq9YgsPoOtCldqcGwvbXQcKiqEs-hxtX-OuQoeOQ&oe=6AA29F8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3cCxl5RNo0Q7kNvwFzPQWD&_nc_oc=AdqzA_ZI493bOeyHxhO9hmS4eMi9dAT25EzLg7rourbBM9uJ5wxkUbmvZ18vk-H4gNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjxZGc_1FgKsh9a3MbMhRynqsUlIRa8m85vDP-a8LsuQ&oe=6AA2AD6E"}, {"file_name": "005.VS_M_Squar
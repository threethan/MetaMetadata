nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y5f6zzggLJVEM1FgTs0jgzgg7mvmUNCwf2ClPbnYFMQ&oe=6A01D70A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wgr8UpvVP0Q7kNvwFAc8VL&_nc_oc=AdqEKTikYjfhdIAjKj8oNoFj-9xyxQeGsTWYSOuPiCI00OiLVFFFoyS7gLnT97fCCYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XZ2b___yu4K2aizL54dYigTHfkhHbrDz8-3qO1_Kqbw&oe=6A01E95B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sIKJN7QkxEQ7kNvwGVPY--&_nc_oc=Adrs38knquqywaP7kcDz2pSb8rJw6o8CbXMnC8sct6GGWUU7ElZxNP6hads5AlJhnGs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jipuS4r4AE-OQDeinkswrxbDzSSsGPz9Ic0gl3iAbPA&oe=6A01EC50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSSPaQHMTf4Q7kNvwHRgowr&_nc_oc=Adq_gmvau3RwkxzQN3feTJUOqH1qSSGgAA247EPUDUXVRb9C9r4enes5jxXylETCYQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Czb3DNAg34X_PkNi34nvh0eZnaHLk6xOYP5H4jRTKEA&oe=6A01D93C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OBtZteGnqkQ7kNvwFBTJvh&_nc_oc=AdqklgSWPlROECTnrYuJ44QqBfAa-kG3wzlK09vFw3Gb_CR7d0Y9icZMgIARvwmS1nk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K2mNNZp9yWrj2PPxUecZbCLgheK0aD5RgyOhXMhGpyw&oe=6A01DA39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJgk_v8QaEQQ7kNvwGv5OdC&_nc_oc=AdrjS98CcfsJVrS6cYRCj3ipDIMcku8tg082uxipOJ2diCCZPFY9VHEALCkwJZwRfGA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vut-3g9voMBi-flZ1RG-BEQ9xZmOUHhwZfdSu3Weq4A&oe=6A01C88F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmT5_62faOUQ7kNvwHVhNrQ&_nc_oc=AdpoQt6Y7POdVxjIk5uP2T8abu0fF7m99iT9qt4pNJqxS0W0T168W9FiE_nkDhzgup8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sOeCdHFnPOBoQ-h_jkFWhpMgE7tpH1t6WGFCd2Ci-qw&oe=6A01D66E"}, {"file_name": "005.VS_M_Squa
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeWf3CUSRZpTAAPzcX0W7gi1A9-h4d2OC07B77GlP1eg&oe=6AA7F40A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg88VMLd3g4Q7kNvwGAudOm&_nc_oc=Adpp3PvuhaA_8B8s86cHY_1lpIGHF54qo1IocB5yFYjo2VDI7_C0Sn0W5kPoGdjct4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjjh0GsTSUN66Km87AM4Wp84Lzllgrq7URxX_X65Q6ww&oe=6AA8065B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltFCCJqQ9hUQ7kNvwHcpXVn&_nc_oc=AdogO-GfyO88fWG3UG_a0Rg6ApkIWEtqzPlUxKdKrTVyZwDwfomLsoX_8j6H3_FhG6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG14RFgOdKcgzJdPaufmGW4qHbiPHnP9voFrSu5gskaQ&oe=6AA80950"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9b4U41lPH0Q7kNvwFdXFcf&_nc_oc=AdpjPLMhMz3F_FmaNt6eOWTY7-FJB-vayF8oJ5n3cOyh_z3Fb7Sr9TDWemdegodiduc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ7QZME2Xk2dU2u7HZbUcFwV-hYk5KC70lh1wPJfq1GA&oe=6AA7F63C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFeHrkoPV7YQ7kNvwGFUGWI&_nc_oc=AdqLI_tMusK903ss4e1RIFpd_iMZqqKXsXGRXN6uroy072fzvRxAQH_CzWEM_399C1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9sRZAMM8uyUtgI0mCQQ3EfG_EiErTNV9afkHlQvbtlA&oe=6AA7F739"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKgbVdPfaPwQ7kNvwHDKXud&_nc_oc=AdqwEmuUFVlpDGnpnjmzXXihZcfAwcowczeq4wzDj-2CjscgxnApRC4yK3pHlkNjH_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1NlV1DasSwYVz_jy6K4ib-MW5VF1c2gtbGS1wr6Uf4A&oe=6AA7E58F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqNkVCJcaeoQ7kNvwGqmd_r&_nc_oc=AdoVkkBXRdo5TUSjQ-jd-Ipqd7F1zPsgbAKHs9YrKkmUnunJHFqJTvEiZOSOjJrEJ94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIkfXtADgvs6Sb2dwbXUqjPpsJfDTEZSAayT_s0GANXg&oe=6AA7F36E"}, {"file_name": "005.VS_M_Squar
t-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N2iJkG4FEDZBREfatkBI0i7QMp_KlQXMzwV3V3elfUA&oe=6A2C070A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xySUUNY5UwQ7kNvwGQL_8R&_nc_oc=Adpdc8VAs4AAC6Aq-dRIfsVSAhl_14yx2M6WAywyYa0UgyLgzxo7nWVqQg_jCzLwK8w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LN0mRxw_cPLozvpZn0QjI8FpykBmVSFnelEChirso6Q&oe=6A2C195B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUCSweKdAowQ7kNvwGIxfWq&_nc_oc=AdpZqALFCgR865KojhBDLhTUBF16JwL0-jTkDL2q64NnxRTl9fsSGf3WwA4QMZAjDqk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X2bn2pA7sztzXBrTVfv0idy3yokCxA5svZxpnDl5mbQ&oe=6A2C1C50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s662OJ-K-pIQ7kNvwFqEpBP&_nc_oc=AdqfaWYUm672_arFnZl5XpEe0fOrfo7TDeOQD_8R4n8Z6bhkB15rmhjWrw8-2Q-avxE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2Z6a8YDLfV_QiOCZmV8VuvDOwRWYLuMGowM7cJh1ZTA&oe=6A2C093C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrzG7ETVKk4Q7kNvwFIiEqb&_nc_oc=AdoONtuGW9cr_ZQAWq3aBg5HVDy55s78iAW1AQ2tObCG4bjOzcywkknAq9DRzKdKBlA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LIUs3wdZdRDPNpKqqaCx_A1PA2cQ_K8HKR6p1xrxHag&oe=6A2C0A39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Chb5ZBT5DfQQ7kNvwF8Cy0p&_nc_oc=AdqRWqkqM5Obyay8lM9tO3NnvS2b0e-qT9KYeRCm4PV9nDYvmYgbLV8CxWKctkEhW5Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y0zWRZhH2248FSjml3tHQ9Q9ifIH7jjTenhftHd62vA&oe=6A2C30CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7ODwEpWZNYQ7kNvwGpcKoO&_nc_oc=Adq2m2oTC22w7ORjRjhIPozjoeTt169rRl7eLk2XaMB9IdQ9iw1BgOeUSTZ71AQuHog&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VH63E8Q2WWgJV_kiguAm1bL5v2nY1xUcN8HZ3WsCgSQ&oe=6A2C066E"}, {"file_name": "005.VS_M_Squar
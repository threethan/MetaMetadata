t-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVkI1xTkyuiEUvbfTcs4QEpflo3H-bMlrEntKaPFrqZg&oe=6A54E58A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2TcUWpgFfoQ7kNvwH-uhQG&_nc_oc=Ador3OsU3K_lRfsUpA6wcS3L1m3ikfhDLm0ZjOeB3mE487RJgNbv-pzBstA6aVBfX68&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOpXFG16GO2vYqzorBBeZBtVJ3UiQCskq4pOU0uDC8bw&oe=6A54F7DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jCAgoo-alwQ7kNvwEn_8OJ&_nc_oc=AdogznbqkJt_cJzBEoTdvg1I6O3XeMWmzQQvDbY_qTXgnEupwqBxmMcChBna3bpuvuw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8VD5MzfJwyZsFdnh8IFyUOFoFPGRqryXEDcOU4GeVvw&oe=6A54FAD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JoPEE3mwN4Q7kNvwHne04B&_nc_oc=AdorMOk09vYFUxNs11CsGMD1xNojDZfbhh2n6UicGDA6SnjvG5TSlf3ho4wzte0KJ8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnzczTit4pwy6wWM5EyKIaoZIHeXn2iIadCzxTw7zpOw&oe=6A54E7BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fI811W360-MQ7kNvwEnf1J-&_nc_oc=AdoekyzUqo-nl441GmNiUvIHdA1g-fZMZsjZXCFNrwwDo8mMMldOO-n_ttanLXPyKSo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASPXwmJEDGi7zbUhdEmSWYlYjaZ4Xf4IUM3C8moWhOpA&oe=6A54E8B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJv0K-9RsXUQ7kNvwGh-_E8&_nc_oc=Adou50MImzQow0wBp_US2IwPmJXy-EOzEpiy6fwxQIyOnLRFRNSnufx-Wy-Zz7rE6SE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyXIHBkXSTtd89tbPMsScKETGOU14V4yie4Wwm5-Fcew&oe=6A54D70F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeoJU4Gm4owQ7kNvwGbbufP&_nc_oc=Adqqs0XpcJyaLe7UAUIW5oZ-EXp7pmrecxlKLPHzjIfDVGv6aHICfQpvhaSFg-BsSK0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmDj8ixqNE2A95bd3OGO8BrEMvhs7-UM2Kow_nB19dhw&oe=6A54E4EE"}, {"file_name": "005.VS_M_Squar
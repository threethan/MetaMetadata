t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6KWnsxdP-e2n0ekWV_AitXXEscp2Spx5eG8_LwTwbTg&oe=6ABFAF0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhkdPXTQTjAQ7kNvwFlV9Cc&_nc_oc=Adqp9qaJrz8D5J1kAVYDZa-tLnS2RIqye6YBGhKA_0o4bVAjE5J2vT1KMgYWgNR0woo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP12XVt2pI33KuSkREliS8R4DMDGUtB8xijGquSQqvv3w&oe=6ABFC15B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oObuJPp3WDEQ7kNvwGwOXm3&_nc_oc=AdrCoRRg3GYwFMl6UaJ3CmSkU9QFIwWPdejEvzpQ0u0Ot-7po43GcRIkmi9fGthCPMs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPD80TyYQyYrvCdDNcvMTQLvJziQXe7SBKgt2XxhJMvw&oe=6ABFC450"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTBILssMoSAQ7kNvwGWt6p4&_nc_oc=AdoAtraIfA_AIfz4dfuGbU8UT7wpc_p8y5BmV1-H5CvtAdQ6j44RVXVNfHkj6nT7upU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTz932hEzd77V1h-F7q2yHGyD6bIvjATqR8XmEIUuKXg&oe=6ABFB13C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlmaJ6NC6_4Q7kNvwEptXTQ&_nc_oc=AdqWc5SnNcKH7kNLb6i_nmWiFCPYFio6XJmUE-4gV2mG_HOGnHQa5wTrx7FY3MQELTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORdHfL9XcYCe7l26GJ1n9YgD7_cBZM9vwntUUo9svuZw&oe=6ABFB239"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojK3WYm6evoQ7kNvwFQgm6u&_nc_oc=AdrTkOqJt-_WYdwhuVhEWVJQcmdHgLLy5KHeA9A97QWD7n5qXzOchgSZ6iEA5v2yeVI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsCerwCgis42HztJ99Uh9tuu1fEl-xtWvKRTFoEgQASQ&oe=6ABFD8CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yd1O_FJ71YcQ7kNvwHmAVK-&_nc_oc=AdpUjptqQoTqZq7cqYpyNAZ8REfmH_KEl0v7m95zLJwAn-L_Bdoiez0-d6VmRHfgMN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHSJiGYrKlD82LUStZNLxo1vgmaloiGXTZhYjKiY5JFQ&oe=6ABFAE6E"}, {"file_name": "005.VS_M_Squar
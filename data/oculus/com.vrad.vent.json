t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnsT9zKQMyjLRRMWC_EzGH6yaf4s4yU2bbjrTuY8H1aQ&oe=6A95B74A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxk5XgTgubAQ7kNvwHHN7ec&_nc_oc=Adrgo6whW9klch179HfaEGJNspOtx990ywinlq3TPm7dNYuGrPRtsxF8M9babWsiajI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqPLfxjvYXG2fxCrBnDq_8rk7AxzX1DW99oy4PBz38gQ&oe=6A95C99B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqIl7kJUsLIQ7kNvwFWX0gH&_nc_oc=Adr715wgt-jovfQIBW4rguZCiWA5hTjAmauuFOxBpKo1f5BDsWgMyAZNWmZV8god0lA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3Fotpq661eElm08xEyBFs_8ZuITYh2wxMEGB7rlh7YQ&oe=6A95CC90"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgtvhONDiSkQ7kNvwGM_nPY&_nc_oc=AdpZTJJUle4Lr8Twjd7EkUTD8R7Y-lt2Db3UsD5fk9NYCQqqS8-sPEaINM1UkWW29AU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7mVh2XXTQxsXOnzhCb6-oddGbK8JSKU35XKnon2GQ9g&oe=6A95B97C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwELv8FCmVIQ7kNvwHdR_v8&_nc_oc=Adq3P0IAtRKjCJs_Cd_43sKOrKlFVx3dHwKL7TVf6T6HhDn5O9s-mPZ9J3_Tg6e9buk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyt30pIvotHXfo1PbkMOVcikj4GP9WxJXxmLa32uCMHA&oe=6A95BA79"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYXhf1_FxVoQ7kNvwF36bYf&_nc_oc=AdpHPiRgLn5iNfEnylLyMCv_qMuh3npuhyVcv0sITF0jxTs7IfEWeTlT1br2345MHoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYT2_YoH7ouBLSd4qwdap0ScDTK74T19snDBLeGuShlw&oe=6A95E10F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcOZCVUPFhEQ7kNvwE5gkAq&_nc_oc=AdqODo9DgB3jI-QDuTUBwTH4R_fyLK-nG40x5Su7Aa2v-zOcqMHXPIsGWWeO53jarT0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz7aL8Kb5U01w41DjzXqZBhKEmujnGhkqTotnWvx5waQ&oe=6A95B6AE"}, {"file_name": "005.VS_M_Squar
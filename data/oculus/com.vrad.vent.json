t-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hVzJXkVH2ROnP9Em0oJevVM9UJgbA1rILAPDBp80MqA&oe=6A241E0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9EBqszv2pcQ7kNvwFqELE4&_nc_oc=Ado_NMTYDPHetabcgZnh66hZGZCM9ePPWUf83MmtuJhZEBCEJg1fCIXV2ZXW9VDv7Xk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5Ff7BhqbbAD3cuHBtE2AI0_bAKmrQhO6hVYLuw-YCyA&oe=6A24305B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5NDuGV9dRAQ7kNvwEIIavp&_nc_oc=AdrmKhJh21fmW-YERuu8jKFBq_hnRoH4cfTk8P4TGo8rcufKAWOwkrxEHUBAfvZ_NDk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7aDcQVUk_wP5VLt0uw2JMY-B8X3lNIB_qkTt5HWHDoA&oe=6A243350"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdluGscOkB4Q7kNvwFg5wID&_nc_oc=Adqxr2YFLHIqKf4wGhQymAx6o4wEWt0mn6Y1Z9bO1Z5KdIZWVC8A_9cDRnswHUHdZ1o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nHX0ePGq_HUP73HnrbTr3JmY7ozTaod4h39aPpuk-Pw&oe=6A24203C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaWrUZl3HrMQ7kNvwEj5wtm&_nc_oc=Adrz31nPMOc6wm1EPY9iQs8haDNT5TdhxFEESxm_FkTove_xpMgIJzAet_GR-AbaF6k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B06qdRC1gYQ6Md_FJj5SyFJdWRCxXGG9fEHTfLs6g_g&oe=6A242139"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYLHi8WO8DAQ7kNvwHeqV9m&_nc_oc=Adr8OXk-8oX36GR-rxMi5DSyboD9YHDvlVldIbYzbxczKqW3vAVxrVDKKXId3IhNpiw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h_GTfA-QFj-mi5H9Ug6Oy2PttsmLlDJnG2L1K3xTeMw&oe=6A2447CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm2fZGHpICMQ7kNvwEFStWZ&_nc_oc=AdruupE04kEN0oEXs8rBTCkCa_Z41gHSVr4Ally2Dv0fYw8q03LDyrZLpqZJ_2XLQuY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SNhQfIKiypPBrbzNajb0s56I6s45vwBEhCWoq1c9D3g&oe=6A241D6E"}, {"file_name": "005.VS_M_Squar
t=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KAezC7sY-QP8QiD2-T1O8B0yZJQhNE1NynYRbIx4Q4w&oe=6A2304CA"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9EBqszv2pcQ7kNvwGo0Usk&_nc_oc=Adpss8MBR6XqKZ3Sn8RBJc5hCqCnENeHR_zuwClF69tiY1EiRX3kVUszSM7PibKtXyQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4x0XOJ7Ze-YpYXKDtY7xMkr-DxPj_lxhckeZPplV4TA&oe=6A22DEDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5NDuGV9dRAQ7kNvwFg-DLU&_nc_oc=Adrc0gfCaKi82tZwmn8hxN419ItpqecAPcaJVD73tcABEtJZ75YlVDx1JRQF3G9S7gg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZEHWD08z7AkXwkcMyy4H_Wh4jjDxKkk65TXBCACTT2w&oe=6A22E1D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdluGscOkB4Q7kNvwFIGL6a&_nc_oc=Adqgklbd2HJ-TaebALFF1IoTaFc8BwN4QCAjMhDtqNPR6wUtclYWWvhh0RWSY7m7E-w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JQFGQ9naOAZ_GVBNGqYbfsTxJLpTPVvM-_CeexfugUA&oe=6A22CEBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaWrUZl3HrMQ7kNvwEc7pCQ&_nc_oc=AdrEizJuqklfd-K0108t3O-G-9Mw64kKNL4Q1ONgzvNqRAsWNv9fZ4lZyWBBftnF2uo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TJrPt8fuQQ1jb-QxkxVLTOcBaqH288BBe2cTUqNuAPQ&oe=6A22CFB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYLHi8WO8DAQ7kNvwFC583X&_nc_oc=Adq5vjn85zhdBkAcznqsb7-GXPN8bVi2mFZdvkDUL6uj-NU7YQCDmvz546j9BzEqizA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xa7kUUDjPGQt6Vh0PUKwcsV6WVJkcQ7g1kJAZ4owgSQ&oe=6A22F64F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm2fZGHpICMQ7kNvwGSH1K6&_nc_oc=AdoYxMuD6Zs3AU_T7CyQHVD2bwzJ99xkhpwsmFeSkb6BI5olrjCk2FPQwm5WQkfooAU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GeK5rRYV1638huU4R_PnuJS8cEMlOL0v1nvj9-XYTFA&oe=6A23042E"}, {"file_name": "
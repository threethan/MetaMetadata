t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3nz_-lQZRgzX5nc6e0FohbZR_VGkHhto5KK_Bzb7pRg&oe=6AA6A28A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg88VMLd3g4Q7kNvwFA2-e7&_nc_oc=Adoy1q0DDL9QfOzfsKopT-kkiGMi9_NCluNAvU64jBQPUmzPmgdiIPAkIx9uhzm5tKE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz1f1ugJ3zgOO__miYVFDYiikIOsU3xvYOPz3wW0o5uQ&oe=6AA6B4DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP1bhCSRq0oQ7kNvwF7_d1X&_nc_oc=AdoWMCLqdGfpMS-59EMD5n3hrm0edCvrwV2w94PuoX6A6g7TvnK2Z3eBUnbcsW3tSu8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKljYjmY0GXn1eSV7nVHvo2mVzzAtdpIvKzWfXfvA0WVQ&oe=6AA6B7D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zh5FTzT6k6cQ7kNvwF44MHS&_nc_oc=AdqIYvxUxEbgCrrblipTwtWpPnVplbcDf7WmL0P1uxsD4BMUMXm3aYshwzSWv6o9dqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9vq2foJRvukd757UgV2BVASAfinU7tOgJeGmd31xePg&oe=6AA6A4BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFeHrkoPV7YQ7kNvwEzrksz&_nc_oc=AdoJl8ERLWeLS8ecuX18ZPpFKRuv7mWym_xF9L9k5yr9JDPAtmNqkNBAHsLqYgj59n8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIozSIfi2WY_DUHTCv5onLM_LrlvHEdHYqoC6lMw4j8Q&oe=6AA6A5B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKgbVdPfaPwQ7kNvwEb1xyf&_nc_oc=AdrttLWRg9mh_d9SGDBGwIhW9kW4a08LdJ9WuDjFez8cLlvs5QOeICdpe50SCoQ12YE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4uraFj-jx9DqrAv6diA0vaTYiZ-0gA4o8kqhzP8re1g&oe=6AA6940F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxxPZEamsosQ7kNvwHbSUR9&_nc_oc=AdrrX8WcNCq5A-N_V8T5MxA7a4qSpCDs7m8N5HSLuwX0QKZX8I-VYjA9fPyypaRjtlY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUTgLIFInmKJSzVmYh6XaXV4SKqzzx0Mrm74vtol6S2Q&oe=6AA6A1EE"}, {"file_name": "005.VS_M_Squar
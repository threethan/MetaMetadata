-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2o0WHT7mkISdkrYt_cWI-_PruhJe04PwcSML0d38ENHQ&oe=69DA4A0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnzWL-xWQrIQ7kNvwEdyheY&_nc_oc=Adpk9QttSY5xnCJ0dnqu_i_Cv4P_4xdRI1uP-3d0R3cSpsZzXB2d_x22netLA9Xv5aU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yjSo9E50X90TG2oN0ac9jWqcB9m4PA-o1eyzgM1sa9w&oe=69DA5C5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bf4RkpJ0mA8Q7kNvwHlLMl-&_nc_oc=AdplkHSxcqcgcjHbOg8i5-v5IiON27HkFIGI6e_ZkTWGJrdAZ7_Mg3JkVnNivre8x9w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BCUUVbhaMRC520akZUC84JgRMdCsEU7OoYXvEoZr_Hw&oe=69DA5F50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuverg75jvoQ7kNvwEyW2F4&_nc_oc=Adr8zROuLRq6qdzfr3ECj0nAfsUFJ21A1g6G8dRIBP4L40bfOt2DbwILovg9YGfigzI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03cRyhXb7IwPLRQvzkyglJyLGvt0GxdGw_9UoDmkmJqw&oe=69DA4C3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ofkddorg1O8Q7kNvwEAUGUG&_nc_oc=AdpnUwICK0G6qAYGt4jPuw7TFtuKxabW28XKWPpLq43kEHgDadRPYxl-X0aqybTjhAo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rl0xbm_krJAqelf9rwAA5eKiPUbd6NH2Ax5X15NutXw&oe=69DA4D39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKwPrefWOtsQ7kNvwE6XTOn&_nc_oc=AdpP0mmeRKq87Jdaul8v7SEz44_N261PmnuvXaCJo-e6MsrFZO1T3XaNMsGu023XaiY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KqwX9ffh4yRWRspNUjL1ZiIpLFEBRELnOL-BzT3sZKQ&oe=69DA3B8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EMGB-uXtWIQ7kNvwErkBTI&_nc_oc=AdpWWJtpcVD66W78zO69eCc7YXItAymC83L8Cy9_q4klWyy-rdBYPcfkto4KwW8jNJU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ARPh3Lzw7mHqoBIPnhhlXupkg_QwhfLMnln6NhTsI7w&oe=69DA496E"}, {"file_name": "005.VS_M_Square
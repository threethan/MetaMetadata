nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Dm-BuQk-RW80s_15ug-XerwPHvYTAfyaq4gWJqc1joA&oe=6A03288A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE-QpOro1xAQ7kNvwEdiNdV&_nc_oc=AdqsKF7iLyPY5mKoJzILF_vHGIyiGaRyvV9OnCsPsOKStzai8nGMGU-We2gunaQa2co&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75ljUo2D8tTRtpkcx9_EFw2NXLR8-uWC34p9mGlNsQCQ&oe=6A033ADB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sIKJN7QkxEQ7kNvwF2b3r1&_nc_oc=Adpnu_VPW4ZI7ZX-aS-tjb3xFYN9W2Sh2HrMxmoWMraI9Nw254aKKVZYYTDZFBGZBEo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61RNAm5r6bbG8QGcTHRFiKtulzP3J0EBwDRUWT2mxa-A&oe=6A033DD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSSPaQHMTf4Q7kNvwHRnOxr&_nc_oc=AdoHXvQaS4tmQPHhiLNcJ4ovhVHx5ofEZHvtQmBEbUIZ-vgxD6KjTmKXmoXVQJbNkfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K9VrmxC5EAPejlimsjuTZDRBgk-bQNcRZWk4efkBiuw&oe=6A032ABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ON_VmBZy1IQ7kNvwHb3S5Q&_nc_oc=AdrRQvSZzmuCwBn7_he3Km4HLyukWIMnZksYzUn9ijmil0YerC6JDFdiY-OXYOKBT4k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55P0LWOpQT0kazRCXpzm_Q1DHgCP0CwL1KMKLU5k6KkQ&oe=6A032BB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZJDcCDoV1YQ7kNvwHcO24n&_nc_oc=Adqaltmslu3-IapEuDHPc30y_dZz2VXzbhCghqRdZ-gA2nggHRkYYRmt8iVnxm1ol8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HmxaxDYfJQoCOYJ5BCIGOrfVT6bF2ZyKC8YgwrcA-zA&oe=6A031A0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmT5_62faOUQ7kNvwG9YojX&_nc_oc=Adrj6vUz24fxJqOsw-PBEDDRu4rR_t5DBalLwxwLH9r3xhGqa6_b81dEBU-O7Ri51Ic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hPe8Nwh7YwQRv_EdTthlzPVhuXC-2GLfHLadxZvRsjg&oe=6A0327EE"}, {"file_name": "005.VS_M_Squa
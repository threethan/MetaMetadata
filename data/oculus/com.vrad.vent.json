t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZmiDiysR_IFghwosuciyjr7HquhHZNi0o0ABUzVuckw&oe=6A6F438A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wi7zRb3ll8Q7kNvwGNcbhV&_nc_oc=AdoxzxJD0zAvSfMMz5lurORQng2nqXBQHKqkKsIyMmURqT97v1nGsQb2X0_xPXUrnKg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASmzLKVx3xXZSSMbqB8z_-tXBIWVml6H6i09VX_XFlzQ&oe=6A6F55DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_0F80VQYDAQ7kNvwGE-Wk6&_nc_oc=AdokUSF_BZXxhQYzCOYwWj2Jk_a8MQgscxmQeuZIwQTCwUGeJNPECp6Kl-UcaQ7AyTk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmX0RqoII5weE9_tg0gbLyTvJFHgq5IMO0oOQnHvttnw&oe=6A6F58D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIZej8XOzDIQ7kNvwHhXqQu&_nc_oc=AdoJrBN1v-idtIVO86nFGt_OnVYgWIKLgA39w6vVCGKFliyN_vJcf3mYOYMGlLsJqcM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVaPuVcA_N4TFozu4NlReZyfRJmJAWciwVNrE9-2ZYVA&oe=6A6F45BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bgr1UT6hgWUQ7kNvwFJ0b3E&_nc_oc=AdpWvepad3HCpD7_fabyPTB4qjgAzYYkaIiP5gC9dvKLjRVNbuMw_-QiUjSGQtukYI8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUHN2ENdpPan1ZthYKDcKu3Y6hiORsARP_ECL1VNo08A&oe=6A6F46B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJH6E-hgwhYQ7kNvwEiyXKL&_nc_oc=AdqBguKfcBkvliA8DXzZuwIXIJXKcN0IvASnmx3lVf5JG-OehaHAcsBzs6m0RwUZvOo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtop12ds0UFcLT76OgrwSdTQdSBPwWWrUyu1p1ZRbviQ&oe=6A6F350F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9D-5jL-aMMQ7kNvwFzpQ-_&_nc_oc=AdqYtS07pukj_z4PwgM_ad85oQSUhq__HnSDBWHlZDuIYaBUPqxmbhVKhH2VlDvwxk8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiC59CFGUVAoVRmFQ109xhNpHlxDrdyrkE3eiHWapr3Q&oe=6A6F42EE"}, {"file_name": "005.VS_M_Squar
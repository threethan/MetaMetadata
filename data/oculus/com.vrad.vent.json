om/v/t64.5771-25/473398297_978657034226177_6887405616059201056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nJ-eWbisaYQ7kNvwGDV7KP&_nc_oc=Adqgw9pYSk4weMsG0uNc5WYN4zPreP1CkuCrjMKLls-rnov2Zz7FDs_m2UnHtYr64j4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVExbzGY7JIAbZlg_SUlLNHlIANVK64jCn5g7PzyBe4ng&oe=6B0F014A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAEMuxbnQ8QQ7kNvwFEdDej&_nc_oc=AdrTfj_loZYwFigluKaB45uBg_U9hBt9aofuZM_OsYGurKFVGiRiL1tOkyuP0wwSYOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX-jS2MTQdhkvaP9q1cIZTGjllk6-PMgR9HcDovdDAHeg&oe=6B0F139B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_d6AiHY3fAQ7kNvwEad0qO&_nc_oc=AdprCGTdIrrmOBYPpYUPoj7Sj2JaM0N6DbzWzRbiLgMhvDOAA-Qfo6qUECNvRk3h0pM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUMtK7W1yse07GIZ5cWKbA0B-5QGpfQDDQVETROdtkXNQ&oe=6B0F1690"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-r0foaDExp0Q7kNvwGl6ZdQ&_nc_oc=Adrbz2rAHG0_2Aw1kcTIx2VgUI2TCUkj8sDAM05GqimwisTUPWs_5NoaMM3WiTLY9KI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX94IGU7qY0pHRISkHKA4Xic4FirY807BOfG80Usz1FZQ&oe=6B0F037C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEHBlxQPbKwQ7kNvwEpZUy4&_nc_oc=AdqH0N302FCtmh0z5kDglodKNS6O5XioH8MK1-fR-f3K0UcJZRVSsG65O9naJ-ZzmYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUD45CpdKTATgSyZPUuP4fGB0K3WbNA5xnhpqJczif6Sw&oe=6B0F0479"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lgqy398K4UQ7kNvwGjX3_8&_nc_oc=AdrzLTPcUv2XN3tsVQZT9cUAHCIRKD1Qjz5AygxxzCLBA67oAAXTazeh9Nd590ZXwss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1vRVRAGDXricBxnFI6T1lZP-L-vkD6TQbXyZjfbxsvQ&oe=6B0EF2CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scont
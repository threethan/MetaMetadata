t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVM0p4GzYXnPDXJiOBcm_yHNpSSy9PpGYic7IC7eJnGA&oe=6AF897CA"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyG6sJF8oZAQ7kNvwGDZ5TR&_nc_oc=Adq7vJcCfYGhdbgatkjxGW_2a1aH0GMBe6xajU1cuje7D64ZkQ_QrUHCelTDtl8uv3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReHTTMX59XjIsK0N2-FPDrqF91zgo7VX8lCpX8iuw6Ag&oe=6AF8AA1B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KmqAlta25IQ7kNvwHvXoj_&_nc_oc=AdqZl-_joDHra2qDBUrZYUubsiIscnaI5ka5fpchJy1ceExESXmdHR0aC0UCu1EpCVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYfDas2kv7Ywuvc-E0OxiFkAwzvVUCM43e_MyClGKujw&oe=6AF874D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ru471bu1feUQ7kNvwHQlXKq&_nc_oc=AdotKmNkdyPGhHWRHrUE7zShHCj-Dg1qJPyt2skjLnHcPfcobyBGty-kxleYVnnMM-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4x7dknzSiycNl0K3hhXV5d5OpptGYoG9RAv2twtuefw&oe=6AF899FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoHdzRI98BAQ7kNvwGwhLtM&_nc_oc=AdrOZG1v216t9CSOcBmxbkVuQuxdmasLp3T5jXTfaqWgGwbp6Zabqguny9REKLUcVHw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRZNMiZWLJYnxCYPDfXRfssQqY5ZZgL-j1L_BaPmNb8g&oe=6AF89AF9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crty7i6feo4Q7kNvwE72GMU&_nc_oc=AdoZMEFv8IhU0B9gDaCNtB_0oMH_rDQEB2rvC9MQqnQDtDT1LjfpNQ8wzXsP7gMLbgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUVmvQNr9QTTlaOG3jpTt0nON5810zETbhcppCOGK53w&oe=6AF8894F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w21QYPGyziIQ7kNvwEzSqM-&_nc_oc=AdqAkmj-r7jL1KPlj4ffHbhmpG055S6HPiq_m4mNEj8eKkm4TxNT4fbPAQBVYuLWxWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSco1qNrfdQbUAMugozahLJa0jFYqV8kt6fbSMtVrTdQg&oe=6AF8972E"}, {"file_name": "005.VS_M_Squar
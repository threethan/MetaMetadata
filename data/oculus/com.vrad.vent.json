t-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXFObZorYkGnfHwR-O9KjilfO5bIf0IAFtbpY73PRgXA&oe=6A71E68A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqUOxALKHiIQ7kNvwFrBdOc&_nc_oc=Adpys8xAwP4GsR8-Gdm6JtM_Q0tjEyeJLi-LujizsDp5Sn2iCC8tXifaeUqtWfClGkE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpuNM7YPSRVn316id0d0b63jpAArxbY7uzeh5NkKFT2A&oe=6A71F8DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDIJResSdjAQ7kNvwGiJTgM&_nc_oc=Ado_pySG5Hu3-qcXTEZy8aKBxkl1QYhhuqP-0guxCfeSKRi2f6vZTFZL38sjqrL0XyM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEB66n35D5NCEIxCGlxSOJDhtD4b9YywEIXGw9izPK3w&oe=6A71FBD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnwkLRMC2dcQ7kNvwG10FLA&_nc_oc=AdrTpVeRTXDr_lKsrxXazGd2n9t0HYkaC8CQW9ws6UI5AJhumQIh5mcBRbZ8j66RYuo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcni-SRGPtSbF1FtxmurzlD3tGsNCx7HH0WpzHj1uySQ&oe=6A71E8BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxXGLQWr8PMQ7kNvwFmXFb-&_nc_oc=AdqtzvkacWAeOAfzeAHp9jP_t9bHUHAHp5C-In_trqFFBdDsQO7xpANAnv8bO6_BLL0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUwyvvkymQ9iwS3VmTyPpMYYLxhZWkC15MaGbgyoVIhQ&oe=6A71E9B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AltwcZA6rZYQ7kNvwHJjQVW&_nc_oc=AdqmBQnGI5XlDXdyrxtCcdxcPKYrjkikQfkyhRs0UFc-Swy-iI2ErAu8X1QC8Zi_OK0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl87hfJ0Ol18rGXfj2PVpu8sc7v9NOb0ag7WIMM1SnHA&oe=6A71D80F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvS6VoIoyHUQ7kNvwEsNG-3&_nc_oc=AdqF38RV2ivmw4iZ2wnNQFo-rJRTSHy0ONEUH1FwqHpgogB0gpMOaNbQOr1NanqiR0s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrhr_5SSSFgObI134JSfnGnvrwJXZGydHPqk9RaGz3zA&oe=6A71E5EE"}, {"file_name": "005.VS_M_Squar
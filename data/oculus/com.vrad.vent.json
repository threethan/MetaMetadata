nt-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2rBbKATN_pC0mQp8hQ23pAGfG6pB3SDA90nrJHVeZ3Sw&oe=69F3568A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VI_yx_cOUqEQ7kNvwFvD6bh&_nc_oc=AdqeLWF15odTjemzQL4SC4-ygqaqcGe2xByecwgHJx2suwGiL0SmAfq74YZi-yLm-iA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3EYpCxS0mO0-eTDXvRSS_aWGrMzfAmAYIEvHUxQ4EGhg&oe=69F368DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVew2t-pKcoQ7kNvwHi7FnT&_nc_oc=AdoEAUc7Xo4ds2RmsR_6ag9N2NgNm08lxYsERUy-yHZxRarppRi6pOu3tbMcMVS5OBQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_sPsn8WsTISDSxlJs1GvyTVC6We-14lW03O9QR9HnmQ&oe=69F36BD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sl2jMWHDSsUQ7kNvwHM_2QH&_nc_oc=AdpihOOigOHFLAVV_eGr522L19WrxlnbImtzxJwpV7Dn9b2rCUmPwAI6v8MrX29ApmM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2X4UqPJkYzMAkFq9icbHPeJzZvmvxFMqzAPyKCU0c-aQ&oe=69F358BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AS9XC_D9NscQ7kNvwHQitIy&_nc_oc=AdryS8A0wNAMFIdcAnQeshk2UafL-u2YQmQmn7K5_fOQkc99s57Q0J6JSeVBOR5RWb0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jpMur42AXj8dxsTZY8M4PL62QSVvbJwl5kZUK6YbkCw&oe=69F359B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z53Z4p1z49oQ7kNvwEpzSJv&_nc_oc=AdqfwofaJ9AUc5Nu1SZ_Z4OVEMLBl2SPyrNLOCTD8sO5IMmLg2py_ek2TKiM27KL8ic&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0T7JkRzD2CEVKdD7wGRMx_OjGyr9ViKzVDE5XKWzk7DA&oe=69F3480F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HJifS2fjDQQ7kNvwEqpdU_&_nc_oc=AdresrJsz-TYigiggsCiO79pvNVtDJuzeO1sMdOiLSdIX90abdsnLEXIcA6gHBI4VjQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35lznD1GhRgUHYst84v5uibg2qsWTULJfdQB-z8fpkIg&oe=69F355EE"}, {"file_name": "005.VS_M_Squa
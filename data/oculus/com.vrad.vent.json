nt-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0urLBMeKsaqD3u_TeuS0oeN57PepZSjg5F2bhrv-yLdg&oe=69D5040A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6b1vUG2gQwQ7kNvwGeCoqz&_nc_oc=AdrfUHnIG688qodJmHMTyC6eNV3Usv44Zti4RNf5R0M3t_QwapU-ttB2Ih9uIKLx7qE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1raCwPG8wDn6lsYPJjYXtbZdtbdwxhwnSqBfnyTXFI9g&oe=69D5165B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovUG43q0O9QQ7kNvwFQhY6V&_nc_oc=AdpzfJbg5XWR2d2-6_DLIRLjfhfJhSC0TuPKqr4ujWjSzxRjoGpgGQ2BhgV_Vu5paLk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tiEDzUdZt3hvQ4GzEsh8DXFII-fetEcEEG27evxZTZA&oe=69D4E110"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JrpYA7vTv8Q7kNvwGGnGPQ&_nc_oc=AdpwrWzvvuhWzzAoI98HpPF4OkP3yzwd3mZFcTClBW8KVO26ZrAqk4ve5yTZ4xfHK_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pourxmYIW804k6JA1SzM9IulY21g82-nyCr6iPqL8NQ&oe=69D5063C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCYglTLH9PEQ7kNvwFJUlhI&_nc_oc=AdrjRrQUVQEnAQ9YsGpQN2d4sVMQTSa7oOa_tirz4ds2dy5AgaZHF9zrzsMXzGl8nyc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0t3Z-7B4TQJlUQXJeTu-cr7dKGN3NiTae5bbhV64nb6w&oe=69D50739"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tu2zowZ6NngQ7kNvwGSyIOX&_nc_oc=AdrUqqyOMvmbqbPisZPqLz9kIeEw3lL2DhNkUCtVrlwXBGMWnC5WV5f_ohvHqhLNXi4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YODU5ovXPqHaptNGQsb_b9eiZL_aX4fNTPK8vpV6Yag&oe=69D4F58F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhSor7R-L2YQ7kNvwHeKbYq&_nc_oc=AdpvtQBvTGbtPquxJSoQHmqp4Brrh-fmXs619bLiNjnv8creiWSyoHc7CydU-wK4CSE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d5HYGICXA7H5XmCh0JiSbSEFIo0Q8LLzlY4ik99apjQ&oe=69D5036E"}, {"file_name": "005.VS_M_Squa
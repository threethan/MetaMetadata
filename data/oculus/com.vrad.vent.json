t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ikcp2MRs2F-ZrYtRYzknqPJADBcG8bT6JK3TB65dMWw&oe=6A43C20A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J21TwIQ3AVoQ7kNvwGrj-XL&_nc_oc=AdptOXw9_1wl8kL92ieG9-CXISPfU4_LU9M0yBxyEk7MtDnex1W0l-bA4nKeLo_EfcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FYoVeLHMqhazS6VQ-nz0_0rVm8SfV5Gn1QL_22TBD7A&oe=6A43D45B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH4wThQb0WsQ7kNvwG2g1kI&_nc_oc=AdqfshFu8j-bNOISnkMwUyKCpytE-h8Qiy86fmeiDkWpWdxt_MiKWfcYBELYck5Hd6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D0Xy9QMQFDkAd08xAqeaSw50-4A75qMkEiFiDFt24YA&oe=6A43D750"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVYyrOgAsWUQ7kNvwHgTAUw&_nc_oc=AdqCEX-IEwCcVJ7BP2FoSf7TLXl0wm2_33viiCf8kvlci9k0MHOjs8tOBpw-7S4nZZU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RdDiBXdkkE3pE8PdJAHsTyPD27nfCsV5cnKNG6x1z7A&oe=6A43C43C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKj3lQHdwDoQ7kNvwG1j8br&_nc_oc=Adq_1_24JePMi9ngEk6pcwWfuz_9L8MI8Fwl7kXWe9AFYsSVxYUHZmqq4F21ijqRf18&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RWX3my11M8qfClmdM0YW6ABVknmLAU0WQ2Toui-YoMg&oe=6A43C539"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGS1bCK3oHIQ7kNvwE-4PJd&_nc_oc=AdpZl-QLvk5MBRJ7zXmcLD6v9knu9vnoYwWwu6p6Rp7eYSzUEVcKhOIk_o4RclkNrl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yv-BTc6Tj_lWmXNnzFv15wbRNoeqIuSgo5Vv3uzUmIg&oe=6A43EBCF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQbFzTWniPQQ7kNvwHwrOCh&_nc_oc=Adrh3PHKliGu8KkeQj89hR-ZfE-4VfP1E82I0MjbY2hJPTxMP_m1cKyl8I3kVSAHO1g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M4mBATdKbjCeqsYIS0z8wGOiew575qT_YKmltNgRPiA&oe=6A43C16E"}, {"file_name": "005.VS_M_Squar
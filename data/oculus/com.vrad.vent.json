t-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF8gGgmNEbTcZTIqIjh2i7ktAqGDlHCreS2-JJ8udodw&oe=6AE3478A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVCfqbPw1ZUQ7kNvwFs3MZP&_nc_oc=AdrXfWZkr3IGTOL2i8h_bVcxGodIICYS2NalLP3_E36HjA00rnQEXKvN-u-JVlqrzps&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUe4mrvt1wb4-amW6BcKGUIqwQRB8GUvuLZoYgCt2yRg&oe=6AE359DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxnfeDl3zfwQ7kNvwGFPr-3&_nc_oc=AdptFfHwGdD_I4NuWv0459E8C1AD8outuqN4diNklOfZwyHx0dQIDbYEDigmhBWzFOE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMocv04KP2w9m-7wxN4IEaBnPw4TXQKgavejB3f91u1_Q&oe=6AE35CD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dFdzMcLp5wQ7kNvwE9CB-k&_nc_oc=AdrrkL7Xe3LdGaRNO9d5-kyTjn5xZ6td3YT3wZISLLMy3D4yUvFnQFbNGjo2r1iqmK4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfUaEBY16GGoqoTYfF7G8XHbhmvba8-SMcgUuBWPnboA&oe=6AE349BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmO7efvdzK8Q7kNvwE__LfT&_nc_oc=AdrCszdCK_cUH68Wb7noEz_dhjUWP7i0Plz6M0HwsVcviHWeCA6OPiAiQwXSYHV3PzQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXODawWYQubPbOwZFajL1QGr00u4O_-p1YH9DsFfAwvw&oe=6AE34AB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7ZouPdjJUsQ7kNvwF6LSZg&_nc_oc=Adr5Iyu0Vjy9JAU-97WCTnclKFSBNa8PHYIaVClHP8WdpbyjQb99fmMlEP-ANwJOxhY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQt7EQRC5EtM_KwoEYGZhCkwL5ngLnKzQNivrSTF9uWA&oe=6AE3390F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gialftfKjJUQ7kNvwHB-CR3&_nc_oc=AdrmrCu7JE22E2883_eDReRwnQGepu-v_Vht2ohEAnA04a54qe9TGMllmHdZmlvS-Sk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSrOqqv-dcTDncLqywIJGHjEY_uy8gwQihAhefMEz5kw&oe=6AE346EE"}, {"file_name": "005.VS_M_Squar
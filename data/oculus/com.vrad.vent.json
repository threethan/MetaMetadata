t-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo4Z0u0zt719GQgeEMg1qiDU9uWwXueY2UTZgvxOM3BQ&oe=6AE73C0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jX-dE_F0-XMQ7kNvwG2HuIk&_nc_oc=Adpp4KbIXX7seEoZGQ1mcb2f3iavUZRdSOs_QXm_2pAJee5-MqFX5M34ZZzvXAoa90E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-glQZnnoo_eyHIWIwlHiMklrdZzjRw3_lTZ-kMSjfQw&oe=6AE74E5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4AdxO6jbu4Q7kNvwFo6GND&_nc_oc=Ado1m7FJB4EEW93qAwYwxcAxFvbR1omK76J22y1UrfcFkDun41RGSZYfe4fOEQq9mMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwrN72C9IQBko0mAnMnMdbD3Vby_h_R5ThMwZFNzc0QA&oe=6AE75150"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STN27QGVVQQQ7kNvwFIeb2U&_nc_oc=AdofZLvDHB0MjvXwme_zBLMk198JEfpKFtlBeVUTuNjIcemHVnqrUd1OrKv7zqrisf4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1R8YiaC3xIlCoDEdKoUj6nE_si-cRefqKIEW_1EJ-UA&oe=6AE73E3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTd_Gzd_IT4Q7kNvwFhqh8P&_nc_oc=AdqdlzELInoCfNzuiRTJaZQr818HQZwg42vCvffgaNduGdRtDngAuJzV5yHkPCez1-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlKndg3FrninvvQz40NfAqMev0luQRMneWgaIT3BR9MA&oe=6AE73F39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDaV9YaqgdwQ7kNvwG0AYrR&_nc_oc=AdqL3k0DsXGse-5mBZxvAEqELvfcMSR_GL1oOds6-6k34k-5lNd--kdQpRbsG7uRgiI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTvyYFh8D8qtMYTz-shJRugnYDysLh8Qvey8CMO-LVWw&oe=6AE765CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w--AxnII9coQ7kNvwFyWK_g&_nc_oc=AdrxOcsiD71KzingBs8dUZkMIPmqDt2WJzVj7nBVZR8xLDHUmapjW30Sbqvx6nsOF7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLWSN8F9PFB4bRExx6WP5um3NQYAH6HAwPT7JFyd2ZpQ&oe=6AE73B6E"}, {"file_name": "005.VS_M_Squar
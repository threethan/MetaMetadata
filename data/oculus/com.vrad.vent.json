t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5-mSFM41rAD7dPDzeFQwjYY7529sctuTpku_ZzwwDOQ&oe=6ADF530A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBZLJmCqgvgQ7kNvwEbHuG4&_nc_oc=AdriQOhvNf_IAQ4sCPpSd3LNqZGQoQUHGyDBadEmN7xpl_iBMAvxOVrZJv6qLE7-0EM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqzzJHnaK2p2-RYPnX1lYdsAHsDYbNww8ccFYZD7ndCg&oe=6ADF655B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9py8BAhRZAQ7kNvwETH0wy&_nc_oc=Adoi1mmFML7n-hpvSbrz_nDw2QfjN-MhiJBW0lXgbbRtCqVy4mk9LzKNxjTZete4YxA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0n_f43BQAvpthyvEVRL4_IdFU0wESy23oM3vv8R08dA&oe=6ADF6850"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wG5ozajjmsQ7kNvwF5UrCY&_nc_oc=AdopmjFhhwjhAxgPolWGCJ1ztSIuwvX5XouPkiccgRa6fEXPrxQV-nKd1wZnWgXXzxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXBDl5z0LWWyTl7qzWgVE-EUJ5rSDRKClGaky7o3LC4g&oe=6ADF553C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Zo8JSch4_oQ7kNvwF_wPEo&_nc_oc=AdrUPOG3zkZIkduJVY-eDdnUUB9-BgaQ8otpBfzQXRO2WgL2YkIcPAaTqvCgGVDx0uI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOwh-da34M4TgemeXwF_bOV1VdN-pyTJTx6dKhAgDZfQ&oe=6ADF5639"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GjrNW12ymAQ7kNvwF2QIAE&_nc_oc=Adrkab7cRlWy4vZZTiicFi5-IFh-YP3j8h_JLChTSBUuDH_WD2qCQ3E9BeD4guZ2upY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBgv1Xc22n4Psc2LKCSthkpGqNeX4u8qVs2EMBMUJoNw&oe=6ADF448F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RhGHeleE1cQ7kNvwGQ4gr4&_nc_oc=AdpGGOaPFdSGWDJuBhCKs_kLfm5NHkFsFHJfabKZnKJHZIyaCsC-Tp300OH5dK3sgBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuAzPZ1xDb4uiCJZaVKFwBDfcXQYS94Avk0tV7Mebz-w&oe=6ADF526E"}, {"file_name": "005.VS_M_Squar
t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZp_lCd0hI3-6KXGg83hLx_56LyAoubpny5RPhTBHV_A&oe=6A7C728A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fUwYajL7rYQ7kNvwH-_33e&_nc_oc=Ado9BFxVPuHP7GQGTh0icSA3MAVxwyadstGznieyfQf_wrwfBCfeMmneh2AcPLBmLw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTxHEjvGpg3BIPcySAS5UgRU1RGMCAAw2D2JG3CkPchA&oe=6A7C4C9B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FY05wXWim-gQ7kNvwFv8yay&_nc_oc=AdoECEypDLrlDiubLXUe53sceDwS6B9dL3pbPHu781C3ShMzJcWOzIoBEnRKkFlLGHM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwC9Xra4erjnhc6sR-TEB5qNwZiL76euMijRSqycy1rQ&oe=6A7C4F90"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVjY9lkKOSoQ7kNvwF7cdH5&_nc_oc=Adrxvjf0-uoogN8aDJNblSN7MKxrw3JYfz8H1HuANDUhCE2vgBuouGcbBcUpQsNXZiU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyt3ypz_nKtuJQqDDqdhi23ddopi4VJeCDBkDphmhIwQ&oe=6A7C74BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-BkDUZ_w-wQ7kNvwG89VjU&_nc_oc=AdrvbXOmyM6dsOiy3cem0-phyTDkao7GJi0ts4Mnqfl2fFD4WO1bO1Ym37Ga0adfukc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOns8Aw1yvy1FCbvpAYnJQBPAx2Jq0Bpezl_f71DAALQ&oe=6A7C75B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jzy8l1szfx8Q7kNvwH1TcB2&_nc_oc=AdqilYZnSsuQhvGA01tcFjRwyQSrsTiQ2TcTrvKExYvQnOGwjdNS6gkyVQX3Et26sJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaGMnxslSuXTu7HHw7JRWEnw4SQXIlfPCmq5HxhA4f8Q&oe=6A7C640F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvXn65RlDRAQ7kNvwGWGQ2o&_nc_oc=Adp0QyuZgfy0513HGBYzagReTGcTT6QEvzoKFm0rpECpzVqpwQJIhzzJr5YPwZdflHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTgyWf3HQPMoxYcc9Rvm1BubTmDKurNF9b1jddcrKs1A&oe=6A7C71EE"}, {"file_name": "005.VS_M_Squar
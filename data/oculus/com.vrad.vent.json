t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpgmmPTC1PhqhjgPkvauIWB8XaIk6aeiYsFOITiROfcg&oe=6ACF810A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMSMo_DmWngQ7kNvwGmjZNJ&_nc_oc=AdpV175sfCSNxs699WgcIMDPQ6wjO58RzS3w2xsCjQ4aGR27olcn3oQzhiach6ddFwg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjk3f3ZLN8w8HMiIAAynWcLsO1N_u9LnqwuRc-5PWa1g&oe=6ACF935B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf36w7j0W48Q7kNvwF5U0MM&_nc_oc=AdqVAHY6qmfO3zIRys5J2aDYq2kYC3F4qwaQK54w2d6KpeQIL24-A8a-FZAisWRj-NY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6hvuEY1yrfMJwNlFHKVn72n16KWz5XI7BMVNJLFV7vA&oe=6ACF9650"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8uu8eIEqaIQ7kNvwGZ76mp&_nc_oc=AdpDDIbOUd141sTWjqUHqOuZ0c1fcYUFKwBa-NwKiruxqDY3KucMYHaak9j-zWW4cb0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrAhJMmWxsjb1kxRs16uGCK3j7d2n0l7fgffcylbYXvg&oe=6ACF833C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u6JfbWysn0Q7kNvwEa0g3H&_nc_oc=Ado5XiDsNKGxfs19tXYlq5Jcxi1h8YtJASzcn-14xD_NiRx0Buyr5FGB55gOvNiZHFA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP01gh8meJC2Rfs49p1DVmvCyGpnY8GmQ6nhjDzG9tKng&oe=6ACF8439"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-puUJPUOrtoQ7kNvwHyU_Xt&_nc_oc=AdrQ55p1wBn_x1RjOefG4MQgbxARnQgA3-JCdmRrbvvIN2rlRK9TNZpY0-LMRtboJSM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUplkNg5o0jh9XrFU-FqDgmPegFiyBeZX9Kmn9wJno8g&oe=6ACFAACF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwDnktBHoxYQ7kNvwH00xGh&_nc_oc=AdpQ1ZAZkmD7I8Ex85YTh1IpxQF7CFceCEvIRkhaVt5hKzfDxfPPnjNWWaql6boitic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXSduJmeZ6hNusoyrIWWYsrfTNnx6L1TMVhmQAh9g_9Q&oe=6ACF806E"}, {"file_name": "005.VS_M_Squar
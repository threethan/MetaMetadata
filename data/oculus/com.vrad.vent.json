t-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0Hw-Z-6ZWX6cy1Q7FaSLczLN_rp6UX9kokwk51qKS7A&oe=6A66090A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRsIH2p8mVQQ7kNvwE3ATNO&_nc_oc=AdoEdhrw8yBoFaTkE9zASQQdaH9ja5RBOUfMzc6Hxlpgehluhy_cbVWyevcKUiP088A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALxirfY2s9HLxnbwInbC9ZQal3K8KedXsbINIlntRwGw&oe=6A661B5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoYubHXU-dUQ7kNvwHLdxtM&_nc_oc=Adri0B5zxzLLm11Zwr6MZK4x9-DBN_41i_JiaF0T40jQrLnxjHQ-a9e6e3LtcQ4nd7I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb36aHfSj4aVg2anJmPxoJaZnNIjW6YZZFct-vx-iEkA&oe=6A661E50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYdJEYx51EcQ7kNvwFz14Lg&_nc_oc=AdpJeMuUoSoPpeJaWOu1CwUoHxSDE4nRvFt769fRMBMweJgXNfNVY4Ix7CVcJP2vydQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt4jzpZyeBH4NjKccZrd3DTvhQv4MsHn84z3pR01JK1g&oe=6A660B3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujfa-PFB5BgQ7kNvwHHwy5o&_nc_oc=Adpmd7LAXNyTy09g_B7MS_BhOIt9neebRxX9yJjbSsQ16yvqv-P8ecZH0pLc3VwiixQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWRf6v_2UOv3CLsuZWu32-wmSWhvFizaJLOsQ45D70Hw&oe=6A660C39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=regRsPvok2YQ7kNvwGnU4b6&_nc_oc=AdrKXl7dMlR1VY71Bwr9uqIj2A_J1XyYsBwkkWgy-KR5bTSf5WsyVa82H3fB0l9HEy8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp_VVuip_KZl_YHTQdVXzgK6ImF0phJCIGyQS55Ikf8A&oe=6A65FA8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA_uDSUK5HwQ7kNvwGSD1-q&_nc_oc=AdpwnXl39qQvow8nV6q1LvuwgaC6J5JVIiVXHB_mQeF8688agnrwFkXxQBWDlKXPZuQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClpYyHfSP9iMpQoEWD7l4f2NWZp98uIXJwyfP_WLEOvw&oe=6A66086E"}, {"file_name": "005.VS_M_Squar
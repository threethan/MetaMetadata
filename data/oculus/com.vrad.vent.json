t-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASc-Fgg81FKIzTmIft-ldOJMeN2BY2TCQ_TxxHEf-3Iw&oe=6A56370A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8Noxq1D6EsQ7kNvwFf4kgh&_nc_oc=AdoeHAdK-w13TlPPjveYAhrWcU47CGCc32meJTHp6O3iFh10JR6v7G5Jh8F4_8CZI40&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkmGpDUCc8i1PSuDZMAbFAILWMRXcg-ZmlaLGgHntjxg&oe=6A56495B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jCAgoo-alwQ7kNvwF8tV3W&_nc_oc=AdrOVQb02Bs3Hbz0N9JH4_ISUWZy_y-k6P9c4ldxPse_OocJbiK9pB8y0rRxYYZkFpU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHE8z3pvivb6lAD0zOZLmS5n5cc8Zmo7EzJXpPFBqkow&oe=6A564C50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JoPEE3mwN4Q7kNvwE2Jca4&_nc_oc=AdqNclBbv9j41_exovDFDC-RnaJOXu28dzEO0nFKXF8O2pnL6TDzaGhOFKdA2pUPsg0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8yhxuOG2W465XgQaDCUKJemZf0fMjfesPFWNuDWe16g&oe=6A56393C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgwOjYp9kQQQ7kNvwEUri_x&_nc_oc=AdqME3fBN808s32UfIX0kaQ1-uhtkrw2Syba3gKWp2Ys9ucFYpAe9hT9ONlUa-w8Io4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3rOOnidDtsEXCOdrlB4_HdTmRvswwveIsriX0fllEMQ&oe=6A563A39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dInBEXhThBgQ7kNvwEnxe5s&_nc_oc=AdrFqGV00Utsk_ViXfAxEThB5iLEZVtnLmgXDcsGtstpJoMGajhs49_ezUpeoWjr_jY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGPKkkPCrVFozYKC6dXwpInlSKIyPwqI5jH3DTFFmOJA&oe=6A56288F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeoJU4Gm4owQ7kNvwGI4CGy&_nc_oc=Ado4n1cB4pcuNUIedbN-JGG07Z30la3GW5_0vFPCsBnKh-y0MuWg6LOC8cURQXY5rFo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIKGCW-Vw6yssrlfLQpKUwrjVpg_ASkQQB670GThdEZA&oe=6A56366E"}, {"file_name": "005.VS_M_Squar
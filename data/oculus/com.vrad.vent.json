t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvd6Uo6uCMxkT7DwyBDvj4lpTOiNgRGWqVj-AdcIqylA&oe=6AC2520A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmlWlHMTEVYQ7kNvwFuv5cC&_nc_oc=AdplHL3hAuX1lhgdQOPWsv_jzOGDFMGULJKHcy7llXeobVDDLafvh4XtFM8xertzx9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQ4EozdeZLt1TJa5u38OCaKjksfK27TORjAPZsOTPgZA&oe=6AC2645B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oObuJPp3WDEQ7kNvwGRXezJ&_nc_oc=AdqmDTat-9bru3PNbO1GQk1Bbik1OXXE8NJLroNPqTWkpfCd44wUEJ7fIMt-K4d2JP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORjUxqe8xN7saCvjZmK5KFwBMoYR_f2pfd1hgTIqKoBg&oe=6AC26750"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTBILssMoSAQ7kNvwFaBNL0&_nc_oc=AdpA67TKLGQfqXJTatd0XhwMcFDbWy21FM8ZLRJFicXTwiPEQfKct6AyYhuZiVt_Fnw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqhMUOPfLl2or6Oz5XXXYgged9FZAuG0wAjpwIGmO7jQ&oe=6AC2543C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLxfd_ocncoQ7kNvwFHUIXu&_nc_oc=AdqpWOFmMkD3uwpW0VZPKTA_si92BUvDBLKj3NzGydekCcvO8DHCL4gwMqmGOYy5UTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOo1trWrGPKTuXCT6Ev1EnQgUCQm7CVNPSHg5QPaiZtA&oe=6AC25539"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VO4U_5slwwQ7kNvwGg2pPD&_nc_oc=Adph4ji3-qfp6huCx8z8rznLjJ8QiF3DiovW-VDxtv0snEnvG_6PiXvyN-4kbbV3L8U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBdxtFgJKDNxbt9D4hvdw7rc88CqLtMRbKMX4Su-o--g&oe=6AC27BCF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yd1O_FJ71YcQ7kNvwFbsN_l&_nc_oc=AdoFSuvHcZNYSs7Gm2IAdWaKBdOmhT6aS7It0EDo801EzmbU-J1CPYtstydIwocJGMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM46tdzjE2m-6gNRkPJL36zat68cc4xnxLbRMsqHAwLRA&oe=6AC2516E"}, {"file_name": "005.VS_M_Squar
t-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnBNwYusHBqx83V9ijcIn2096fpujeBniDqOv_lC89Lw&oe=6AC4F50A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctSveL3DP80Q7kNvwGb7X38&_nc_oc=AdruPniS3Y_dBpsgBUARhRpPe-4U78RuS95nYlXgUPdbfmdsLFKhjI-RLySTApkS2Ik&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs3b7_m03gP0nCbVh-782KPLUOO4BqSlED8-kWm7mQpw&oe=6AC5075B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLzZlSp_v3YQ7kNvwFgE7LZ&_nc_oc=Adp9MK6UYd-rgH51A5L8B1pOxbdO8mzhoPk_86KxK5UefESgDcBVoAX3-mV0dSjHYeU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOccryc3dC-fS_azUhJ4v6ZoMvGmmuiYL6drYCVIlelIA&oe=6AC50A50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPEw5REIYaMQ7kNvwHY7zMe&_nc_oc=Adq0ivYd350qd8xSBGEqWBRP5LZaUmXLoymIUQUWcAMtkZFqI_uqWys-iGIuxM-IX-E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhE33S3qxSBlX5_Vq1nJaSLr3lmMXqeAhQadIRXaSOmg&oe=6AC4F73C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckoabrt_X74Q7kNvwFrTD0_&_nc_oc=AdoBfatMJ9gK28L_Ne0MaIJekzE2G7On92x6f6Xaa-Gf4Pkf6kF3tkbXocNFpYY5gw8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSj4pVr2SkkHnP3r2bhqEo6DDOY-iw_gVfhjmEdoGoGg&oe=6AC4F839"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om6y7hhjsToQ7kNvwHD6JwC&_nc_oc=Adob90TCbMtdqyXZeD51tKRDB-KZmII_8HVKZhSouWQbxpHWb8E-KrrXC2-UCVrLL_o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN38w0wjBhJk3qLtCBAaBdiFMfWg1JMLOK_xHaCE3HKGw&oe=6AC51ECF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1qYVvesUMUQ7kNvwHpdl_P&_nc_oc=AdoONmwkSjMMPJf0e_LqMvX9STyubVTEPm1-zW-ab4thEnHf0eTZzSm8By9lfWqp30c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP54Z0Z1H9zUcT2VAUpfdOQMdiRCj6Auzxglrpmw41_Ww&oe=6AC4F46E"}, {"file_name": "005.VS_M_Squar
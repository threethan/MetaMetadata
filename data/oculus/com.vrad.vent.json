t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m10UqcadDPel7-AK3nGWADcV3M3dJzOkDE7ZPLP-yGw&oe=6A47B68A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQ1cHUuw9JsQ7kNvwH2GgXz&_nc_oc=AdpJ4SeKnjIZKNT8SceowA8jHwGvKWulOVz7JwOj-LCoZdm1q2C2kJ93E7z5YerjMoY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Tguh4_cU7qzzi91n9Hbis6plFPN3qJKp-i8RsmApRWA&oe=6A47C8DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix5Gu85CGEoQ7kNvwHsevS9&_nc_oc=AdoSkDWPJWxcUhdFVyLW4UszIXClt9VHclDQ_zgurJPBTNodtTm5keBy5j__9E7yCuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94Scxv8DjPIwHTtddLGdff8TAI_w4Gd-h-luDLdnukJQ&oe=6A47CBD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KGElZ6C92IQ7kNvwFqdNrX&_nc_oc=AdpoAAj15qBJXVq-3NkOJHjmINM8OY76cr1twzl725r33872tlZmOGNSz00NN-I4Y4Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hSwJYXXhCZ5-BUZAk8Pmb_UHN5l3QHU1CXBidOMiBsQ&oe=6A47B8BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZLPyHTZQQEQ7kNvwECZi-i&_nc_oc=Adrlw_AzOjIka5A-fAYeAo2ffklCyJLYuQZ3c11z0sOPVlzeINthaFQr-oUVQvkowAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GpWh0SB3eNjs7nymJYxaosbC89lLNw8hLwmqrfobf5w&oe=6A47B9B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KN2DuSzXjmwQ7kNvwF9J9lA&_nc_oc=AdoEwX2PiSENVf516rcjR-w3GYFCi8YkAQmLfILq0jxn18o7b06iKj0rR4zn2Fb0Yt8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ri9BQ14C1dvzMkFyI-AMAKBSRzWJGc6_JNGl3sLC3RQ&oe=6A47E04F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGCLg7kePQAQ7kNvwHCfhL9&_nc_oc=Adq4vp1SiqK0rVBs_v5As2dRM0uGUd6ZVARkglk2s5zjsfm80RKVBPEXbYorvqYV5rM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xNwtVZkvd_K5c6hHYcMOXiQ3InP6dp2PfqMhyFal5ZQ&oe=6A47B5EE"}, {"file_name": "005.VS_M_Squar
t-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ffSTdwEFh7GkkI-H9P6Wg5xf78BvNAS4tiQBvBrZAjQ&oe=6A26C10A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgobWiUJPv0Q7kNvwH2BQ6I&_nc_oc=AdpZWvLsE4YSCj7M1RxWZ6Md8R_xr7bhzNDlqAQDzv8xQFEAqqP--ZAfAxeFy3dVpSg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BOzgXgtPqxDYdSd7vgCLhkhOrVFkkIm6JB4lE72GQBw&oe=6A26D35B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8eZZEwhqpQQ7kNvwF9NtK-&_nc_oc=AdpBKKrVCLFJroQdF0JVqxF1sy4dfq63yCQOnUQ39fROtscvtCrM6mT56_rFEHBx4ZA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9do2XvmWLglaTq-lzqLXkQz2kNfVSsRQzUXr1_dfw_Og&oe=6A26D650"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AoVzTP5HRgQ7kNvwFvyRaJ&_nc_oc=AdrbETPdUcDFJcI5FUMR7Or5BtprBSzaZCSflQTBL_zAs5--KKX8E8edZh4uijnl3d0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9z1zY9YWTi7uVVjR1hZSPSaSUByQEW8_jLMGfa8cpUw&oe=6A26C33C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZXTmgOJH2oQ7kNvwEecBY0&_nc_oc=Adpb3pI7CjFh1oBqgGyGxbg1okz4Fbt2bHJO8_vz1TrQDWZGlZvosnnXgxd6Z5E-kA0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KGFJnNHW6eU3jS6QRX0_rCZz33_pfQA72oqAT6wyjgA&oe=6A26C439"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rImEXzd_bi0Q7kNvwHU8fhL&_nc_oc=AdrQqul291p42YQRZzxn_FxTZ1LOs0t2-URNq9bgts_DH7BQGleHyDaC1EVVFXojOww&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nnQjMEKXW557nX1_wmnKRREL-0KmJUuydEEQ6LYpaBQ&oe=6A26EACF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMEt263LEXMQ7kNvwHznuUf&_nc_oc=AdrziIIAigUBPKVEF3uduyJ2p-zmFf8r6bpt938YFGMPMrK1VhQVFXpgFRvj89Y4KcE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BJ8gEoc6Sho-LWesGqH-wweYzy67Tc3w0Jp6dmve0bA&oe=6A26C06E"}, {"file_name": "005.VS_M_Squar
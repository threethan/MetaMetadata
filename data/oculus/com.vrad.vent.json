00_AfyajEfXkFMDDc3y5I6yID15vLNBbLvj319VCzukOMecqg&oe=69B6B18A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aA2QBiR_C_AQ7kNvwH0EPXO&_nc_oc=Adn12xAAmmz8qRdV-lkQ66ld8oi2Nc4JGLIvqTwHEqHwoLsO6qSeJ8ry91su-aTyZpI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAuaa8Xb0HBu8m1w-uhBinwXJNYK0990k3z31RErQZ0w&oe=69B68B9B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=red2Wz2n1lsQ7kNvwHlXK3Y&_nc_oc=Adns6jLkvyIE39b6kRC_sLWX-0GoMgtkfLVArGybBkuds5sBkJKVGK5ftoR2FzoexRs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbvYsZROC5XVYtZIZ_jEEtGrdFAiDSmHrfUWj6icDp2A&oe=69B68E90"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw20SYnDC68Q7kNvwHQYAJT&_nc_oc=Admp8mf1MYKur3edzJT09FW2_d1H344J-WKJ3UOgs6btWiINzgInAEwuyZMPakjej-Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4Rpxi7OoIus-HHb0WqRXQ0gSIkkMaUHemFeUOWSg2rg&oe=69B6B3BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7vTTzs2VIMQ7kNvwEU3DRE&_nc_oc=AdlCxBVL0ilYt5L-sUwzidEwKGHQzuMzDjaeydPh08-Nq_kg0e4RNMe1oOZu6HAAeao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-o8xFU1fztZNxUoQqJdpqCiNqh5j8KEVbUszqPkL0_A&oe=69B6B4B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e60lXCOePMQQ7kNvwHWMZAQ&_nc_oc=AdnC5tMmsfDqD5ElMdkW0YFrFAn7dnkYygJoAtWORJGnAkovTBkdAlreMoLZ5bb1W-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIgeMqJ40YvbWqxJhE6xJi_f33OiMvA46TVo22ciB42Q&oe=69B6A30F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGBGxRG94CgQ7kNvwFTFC6Y&_nc_oc=AdnoKAqNul4sIfVqF3mJsqu6MrxLcPEK5PFHkIRV1ZT5z7aC18HxbNzh1Zv8y4PW-H8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKRvsPeT_CEB6JI7fCf8R8rYtYEBgL_dFzCZE4hYbQqQ&oe=69B6B0EE"}, {"file_name": "005.VS_M_Square.png", "id": "1158833709586565", "image_type": "APP_IMG_COVER_
00_AfzWfdEFY8vVSenNtqhb0_4Xgk6r_1-7NHqpxJRsTJe_rg&oe=69B9548A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBiF08zHsuUQ7kNvwHccyjP&_nc_oc=AdlFaAGW2J2orHcgJa85QaDEF59Jn-UR6KuQqzd5W9MVGFZA6QfOdssSz0sPpi5T01s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhRFhGQhQ0hgQYRryOKdxPWgUVLHhUlhjNrEHwZNMOQQ&oe=69B92E9B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=red2Wz2n1lsQ7kNvwFb1M4p&_nc_oc=AdmMLQ3KOfRTUjArRXv83HPHhsrWAOIMXJYCzTN3ej1RT8PaXotZKUenWXi-ezE2ETA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzaZUvVbVo04tcgqIcztwFkOcqYAggBitB7n7-QXPHIjg&oe=69B93190"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw20SYnDC68Q7kNvwG0dVT6&_nc_oc=AdkP15ydVXOBBLMv_cCa7LUABqn8v1DFesYr27UTp9F5Awn68Nfrghyfzsk_dML4z2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfydwagZXd21LklAHoPa633OAXynmBnC4YCSaKO2p0DDIA&oe=69B956BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Mana
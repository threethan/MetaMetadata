nt-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwCW-o5WJh8Kooe2N_n-RE2Dp6r_nJYqjy92zKKVbtUw&oe=69C9268A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1kTGrUqHd0Q7kNvwETrubd&_nc_oc=AdoMhe9DXdq4AtYXIEEAJVMjvUJILdYsmIPPc8uMZnqKGq-me3W7NhlXxfoxnFjqmUk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybWAWo2nYFcNZPd-8vudsAshEddGvqKjzassCPWIgw7A&oe=69C938DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhQWVMyy7l4Q7kNvwGA27Cg&_nc_oc=AdoGt6_ChbZVlAFNNENl29NqivjsK-s31OgTHF0R-P_geol09mT6PNgfk-HhN5WoH-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfCmkTZ1LZp8Enl3BHJHHHNFZgxtF4gO8_ps_IpZit_A&oe=69C90390"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fs_W-3t_hQUQ7kNvwEpdA47&_nc_oc=Adr8IeDvEUwVKYEaymCVXLKwIDEjM40coXRYHPdPVyhotsg9xKbDgrpXneuFqWDFRUY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRNh6j1UgycEFpfk5TISxPkwgEsxOjDTnfe7lae7kauQ&oe=69C928BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSyMEoSPv1sQ7kNvwEIfNT2&_nc_oc=AdoKXJuBVowzk6ppo7CTaE6HpdryLnp5gB3v7KTZmmUZpOIObvwRbH_8Vt4qf1Ftj2U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyee6zOroftmSQcyrHArDV8ZLn9_b6Xlwsx9ZZIdmo2SA&oe=69C929B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCihCAGVyTcQ7kNvwH5askE&_nc_oc=Adp5HL-_TJ4cw9aw6nR_1ni8d6fPkoOCfwdr84vTvMGtGPzcSVF2rgKNYn-u4zlrMKw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMSwAqpCAZcBgAJL6grUbXQ0Jo1XMy__NjYR9VgMs7LA&oe=69C9180F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3PGPD0j_64Q7kNvwF0jGrG&_nc_oc=Adpeg6iNJGiWsbg1q6imhStAa9w0yTExEJT5RQczoFeotU3vsqNhtEQ_u0Z-ANnbRZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRaIjMWPCWBdvlHisrkOafZx3pMdAaUrRG06DSDSo-dA&oe=69C925EE"}, {"file_name": "005.VS_M_Squa
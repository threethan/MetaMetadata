nt-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uE1gsl05b8CJliqRUrE-bOPrV448fZ8CMvp0LBy_GVA&oe=69E0E18A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qYAyMnEYDEQ7kNvwHLvcW_&_nc_oc=AdraGyhuvCoSFNZW8FWu7RyeywTsNh42cvbI1d_BfB70qXhYGjpxwRhsPjaD4xO4LVE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jAEqrXXgyqav6pYQe1w_psYqKmJXnTFP8Dj632mVFmg&oe=69E0F3DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rDOFV0lk48Q7kNvwERzP5I&_nc_oc=AdrGCc0quNpDT85F-3qpCODHrDKZKxDZotqhrwknXE6_Qmu3CG1ojjauHFJ2PTJ8Tcg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06cLCDqVPcAarQyijZWqvIpCz7eyxt0UWb5m_n-ewEfQ&oe=69E0F6D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImtNKjTRcp8Q7kNvwHCglIV&_nc_oc=Adqf0MzzCVRY6zpOwkg-MqGj90Z4ce26I-GYYRm5I47YNs9jPeoei8DrRofpijOakDg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oEbd0d1G1i7AVjKd9Vxy_YpwRGURuDAl-IZUXCOZPOA&oe=69E0E3BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlQwOmaJSaQQ7kNvwFaufnA&_nc_oc=AdpSU5KQnCOnjVF8gBmsP2j4XpWUGm_HIprq-fs17UuvoEgd_KLkqymUAUPHQAtIkyU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2K4nCcEjfxwqO6kKk4mUj9DR4-nK6WP2bZwAd6jojT5w&oe=69E0E4B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLR2ET8gE9IQ7kNvwH7ToFW&_nc_oc=Adp9TLJaBHHci_b9pD95BgkFC3qvKLgaNvt7vLIzON3Q7bsDcIt0L3aMjB6cnOuKqLY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yAUx32986qA8LMnjsgd8XZksrNUG_StuwV8BlP6AE9A&oe=69E0D30F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFCV0tcNGScQ7kNvwHvX7CC&_nc_oc=AdqR3hIduO2YIKhZAqSfXl-QScctrlC0ojlSSpVR6E91Qt3fWwqzeqdXerSJwgxigTg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CLmkIE8Lv4MEoV6yF95kE1N_erx3a_jY1zgF4LwK29g&oe=69E0E0EE"}, {"file_name": "005.VS_M_Squa
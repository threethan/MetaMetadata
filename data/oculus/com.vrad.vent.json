t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJkYdcCktjL_O4dyamzvo8T5R2hZYxEiZ7w2SzWJYy4A&oe=6AC3A38A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmlWlHMTEVYQ7kNvwEe9Dxw&_nc_oc=AdqO33VE_CK_iwnyhJ7Rel1k8MaQKvDjj3JjjpD3QuC6NXm1MU4JOIi_68divTHBBZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCv2eJLgBL6tas8EdT40a4LUDE2TzZKLa6kuaaN-7GjA&oe=6AC3B5DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLzZlSp_v3YQ7kNvwGBI3Qi&_nc_oc=Adrucn8dZDUJNQlI3vuppbPF9WpCNyVilJwJxhkrPv2upcCmBZJ_8tDrKuketk5agDk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd9XalQ1SvBoLZhg57mueOyr_jWWbzLbXwVTArmPvu2Q&oe=6AC3B8D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPEw5REIYaMQ7kNvwHREVBB&_nc_oc=AdoZB98xSbt3Ir3JBRhKopG0t2gOGs1H95Faot1SqmSLYdu72IgAfZLQ9Cyq5stDSiU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoZjG2AzB4aDEConAk8IuFU2JBOmPF1yOGISBRXUv9hA&oe=6AC3A5BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLxfd_ocncoQ7kNvwEj1xVN&_nc_oc=Adq5WGbvewqgh2cjVgN9a4XCR0uamDl0Jof3jVigCFJJy2A0xn5pgSwwmdL7-rsEf-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo5OuYW0IZ4d0QuE3VrqLgKl-uInBS2PU0V3rEsx21QA&oe=6AC3A6B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VO4U_5slwwQ7kNvwFVMCh3&_nc_oc=Adpw9IZYeAhrGLdXCamx-T_rEj90RgaGZqh7N_5av9W76CIWvsUGYgG8ZHHi8HqzNoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUrZutY_iM8jUw15D0W6FxIe0eIZbkCeKulosbs_9x2Q&oe=6AC3CD4F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1qYVvesUMUQ7kNvwEpAR6W&_nc_oc=AdoggbMyheVTByEVnT0kxpOXMCp5enCFS31VhGAgIR6WYyjpe0PM_mBfIXoFxQZWqJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOo1s00leCValAcSq1S3NNryS4yWx_AmVeEtTyBUeNCg&oe=6AC3DB2E"}, {"file_name": "005.VS_M_Squar
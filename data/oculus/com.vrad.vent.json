nt-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fNNCfgBdt9lkBx7QlbRkWHGpxzSXLoHvbYW5M0euC8Q&oe=6A05CB8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE-QpOro1xAQ7kNvwFhdZzn&_nc_oc=AdokbQPOsWgq1qd4KSYzq8BfmcxRpfL6w5iiBLkGrzLKrT6sCsnXaT4zu2-IqWA634w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MbxvbcU_0VaIs-i62d1vmDj9Y8bsLFl4e1KWFpIb8Lw&oe=6A05DDDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRs16yCmIwwQ7kNvwHGn2QL&_nc_oc=AdqZ4lTwZz_bVv0ie_zZ6VIxis8_qjpwJaOMju4BQ_MPxOhnA9MRFTQX1eIpo_Qdb8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EAyFhR3wFDa3meXuTDKthoh1OTx_cWrTbj0Bv8cgfRQ&oe=6A05E0D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB9ERbYsdH0Q7kNvwFqhz03&_nc_oc=AdqVX2jqQjtSt1-nbNX0nvFEFvkitS0SJCtHBx-L55yD6a_ym2jz3CukJZMRELNIulY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OrNqsLc0KoWQWouaZH0KMd8ih4nUqlxXMRLKME5jDQg&oe=6A05CDBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ON_VmBZy1IQ7kNvwHYRM6C&_nc_oc=AdqPXYWg0EFamLGZkPpVFzTGuLUjEeg_W7_sSLUX7VG6VxyOnDpHWJqzGFqvHgH-mJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78af6uZICupRP01Tjcg7EzLV2uZtQGORkVFpQXPrH-JA&oe=6A05CEB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZJDcCDoV1YQ7kNvwG98Hk9&_nc_oc=AdofDP8D61U0NVH30C95xXJy8fnNHkOA_6eY_3qWO9EQsxyRIuiu9pFg0_FB4n0b2vs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cTzzJx4MXAn93oFuEJbGYrkjt2GOgV-GLFtZ2MEepVA&oe=6A05BD0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xWMaA7dJMAQ7kNvwG2alHb&_nc_oc=AdrOQqkjg6M2zgbvYVKTHBBtL0E9S-xe3Si2oUGgnFySFDJ_lWkfziCLInI3X7qgDUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Og3jm9MfKFnihSmQLuxgdfFiod7-fwVtJt9VZM99K9g&oe=6A05CAEE"}, {"file_name": "005.VS_M_Squa
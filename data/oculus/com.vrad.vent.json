nt-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Y-AbP_QH1nLNrCOXuzrf2HX2j7R8HCa7gDFcbyeKpYg&oe=69DF900A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qYAyMnEYDEQ7kNvwGC9lLG&_nc_oc=AdpTQ0LxBQHhy4yCZbj7iTvAwOldyfqsfW1Ph7qEGDqVrEES8rawArb5qYxZ_lTZdeU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WsV2Zy7maazdiVNdiqcBh06i0mE6ZOeVvbnS7du-DvA&oe=69DFA25B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rDOFV0lk48Q7kNvwHQBchh&_nc_oc=Adp1zwFc260clIWAED3udIImcjc9Pb3hjHQQEpnpXc-Ql1wEjVuU9sRMBpsl5-wON1E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xh9rw9xqFQTc-q02KEBbo3N2gJ19Uj-ZnMWw9_5sTvA&oe=69DF6D10"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImtNKjTRcp8Q7kNvwHFd2Qw&_nc_oc=AdpdVhHR-umdJAi1TMh-hwB7gjnklapjni2wt6OMH5KsyhFjyLNqAqvSL1UWs_u2Xck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0m9D-g9h_1NfW2BvL14ZeVNeJVXUuIxiHj2etmSaUd_Q&oe=69DF923C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlQwOmaJSaQQ7kNvwErIT-Y&_nc_oc=AdpJy9FQeUlTwrY8OPtdRCl7cBjJTeHnZKoGfefw6rJLwZZgyUHakX7e_PjouCL9KgM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Twr7pLg1Y2oGG87UHHeaBsAVpmYV0G9CVfPv1XjCTJg&oe=69DF9339"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLR2ET8gE9IQ7kNvwEzr2sc&_nc_oc=AdoT6RHsgL_6xxEvaBohE-hKbsUZ0RzFJQ099Cq3PKHO27OCf3O9rPlDgf_H0YCBTAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LZgTCM40horqhoItNP2MGQZx7T4sDGcmgNfbZSYszbA&oe=69DF818F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFCV0tcNGScQ7kNvwFySnlh&_nc_oc=AdpPpndYvKZgsEpIRe-rlMDpJrhocfNBZx5cApHVQD56ptte-iKiAcB6e3zLt02Hz2c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JLBq8lO46ln45gXHYWjZXxYSNKX1iU7cBOXYrrcvwuA&oe=69DF8F6E"}, {"file_name": "005.VS_M_Squa
t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVaIjvB_unmljmNUKgzO-glDa9Y7otO41MTolnZGFcRQ&oe=6A6DF20A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wi7zRb3ll8Q7kNvwGY7m9P&_nc_oc=AdreDZqX8oCkp0bza0a4w4SnEqKhaol0lUWKWz7Wy3nN5sgrAGUT5SoF1700_qK4Oyc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAw72V4rrxfd4Da8GrcH6Wer0AF169Hr6_-MPCNWrykA&oe=6A6E045B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_0F80VQYDAQ7kNvwEmENGc&_nc_oc=Adq5b4sqHtimavsGt0w_CZKSTzcdfrPZ0WJB6hpbkJRP9IOQ89Ox4EP2cLxK34mWBPI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoFeydeiitVeTLvu-UtUD0j9mBCtz21D6-MXjd4PpZqw&oe=6A6E0750"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIZej8XOzDIQ7kNvwHvayuH&_nc_oc=AdrKLLC1BVbxIJhoscgTtX5XcNPxscbZyZ2JbdUEqrnJO4I6tCmmR7MWWA03cjurSfE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_NXgr9EaDp1BJHI269zsaujhjzyQ62Sser1ATn9OesA&oe=6A6DF43C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bgr1UT6hgWUQ7kNvwEzlttS&_nc_oc=AdoS46GsWNGOW5fV8hTBy7kGKxvcDcguEYXowKyY1F8e5SmV_IuTDMcdbBvOuSoI-NI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB6nutCPOG_GcNMDSCzoYJyR7uTAcEVa0B5q99Od0DHQ&oe=6A6DF539"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJH6E-hgwhYQ7kNvwFqeQST&_nc_oc=AdqZnRGFSi6d9S5GVujEIQPFbQ9KI2AjSoFSddMSdPMawLDxZyjo-BQw6rTL_Q4pP24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0sOpDIdjyUzMau76fcf8BVlHFdsEe_kr0sIuxcncWiQ&oe=6A6DE38F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9D-5jL-aMMQ7kNvwE98d0F&_nc_oc=AdrcDn63c7ufZJAJsouzPdJ8nV6ZMM2CKsRUNw2HN5_nOwmjdJWRvNBxCj7cC19LLE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPqb7t8psStg3J8MJYlk-stm1I2ZEHS1U-mbzCfI_TAw&oe=6A6DF16E"}, {"file_name": "005.VS_M_Squar
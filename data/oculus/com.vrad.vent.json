t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_dXcVBsD69v8lr3UvhEe3jQ_DzVofKvOGhsasDVvOKA&oe=6A9D680A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKjSRrDAV34Q7kNvwHwIG3o&_nc_oc=AdrdJHoOBItKVYgVGJrOXzDpQ-XYzxoYlAY9dpRcoSNQuPbl4_71FtY-NYfRlwfXvnI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNLkemQBmF2-2ML_K3_LyyDyNQcx_Lq_DmxFfF92N9oQ&oe=6A9D7A5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4dNzpKp6YQQ7kNvwFg1wrV&_nc_oc=AdqfbFuz_CoUV2wwAKNWfqgp9Np-8bnOe5pjk4lrxEAwKeapWTZm4DiCD4lrH4iqa4E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8zH8kjMbI-NYMhhDTB6V_TLC9cpWcKGLelJT9a_p7_g&oe=6A9D7D50"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdR8y1BhbsUQ7kNvwE1oEct&_nc_oc=AdrWPraOTmofOblytCe6poHoUIG6XzOmyI3xKIKGCO7owZckwBCqi43dxCtz4NzW2MQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJplgVXoCINOG_Ub7sgdr5SBBFz1ZEeo6dJKQqqI9HcxA&oe=6A9D6A3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpOhNWyaiIMQ7kNvwE8m7wG&_nc_oc=AdoqLjqXpCJRw0Q11mf9TLzJbUYleWyhMzsG2H3K3DXGt0ntTpePNB6lyOE6QspKSU4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB0gHH_o4luJ7XEtumD09gekMUqbAJZ48-NgTJMm_HJw&oe=6A9D6B39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5b4Aw4YmF4EQ7kNvwFT7S6x&_nc_oc=AdpRMln4gCaFpTdaO8-6ccShq-deyC1YuJNdFjYCgCluoan_M8Mq_frGTaCrK9q3rK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPHDyIvxLsyzd2jvzf2OYToP0byf32FIWbnlikEdThBQ&oe=6A9D598F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3zT2MQfQZYQ7kNvwG6p-gp&_nc_oc=AdpF-jITyhebDJoGi-BxNQk8Rw6baO54kRM7PykPVSEUyq6FZ15CkmEQr753CwEsqg0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs5lezqansp64Nc8Bo5yPkcVxgIZk7Va9d2gsH_vX-nQ&oe=6A9D676E"}, {"file_name": "005.VS_M_Squar
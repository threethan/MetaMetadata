om/v/t64.5771-25/473398297_978657034226177_6887405616059201056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6VrRP3TzOQQ7kNvwHPKNo_&_nc_oc=AdqSTvnhbkqoJlswHCtJuTBIapKs7ynh63hv03maiepPWXJwpLgOnGAJR0R8MF1VMhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfJSOxQIK4Hc9VXuwJmCscJeIDwyeCBi4hXDeIScnUXg&oe=6AFDDDCA"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPKYuv_dOhQQ7kNvwGmWkL6&_nc_oc=AdotnO1zLcWOnV0DuavwOQDUobSz9GtjRN7bcyD0MIyvvUruuG29WTnMFHcjsv8KPjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLV8fx-cDxV_n1GM_WQxjMhUMH407u6cujuj3v5BNS4g&oe=6AFDB7DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oq-gk92f6doQ7kNvwEpPkT3&_nc_oc=AdrR6K495h5HYQNJYy3s889ZpTn5_-wSOKqZWFwlFoCJ6MTyxOEvJiFTKM5WSiPAhvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9CDVWcRdHfIRWp-C-JAaMnEQAH7nJYfYYXG50Xt0Krg&oe=6AFDBAD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDXn5icI1xoQ7kNvwF-IxOK&_nc_oc=AdroiRzMLCgrAK0ESgi8LZwL-TSNVN4o4x3qnW6yQhYPKwKdFc3ZtFju96WKzfdpR4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYiwc5ZagXVtqxsOnfsQon1wgeDljYwD6O_6HPPhtaIg&oe=6AFDDFFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjz2qwRd028Q7kNvwH0scQC&_nc_oc=Adqd9jVviNdIL_XlywZwmCSTFGhiLpCDJFiDJNixY6Jlg81gx3EJP2Rm9B0kM-EijT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLZMnjtdXAnnGeos8VktGGEZibUmd3uSvDMMFTbq35gg&oe=6AFDE0F9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxdJnAcPjZQQ7kNvwGTsisB&_nc_oc=Adqew2TPWm7rLLcWWD05UU8xfya6pcpM7VBj6s7OMs8bzFBoORGRsLveuxvK0K0jUrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkMiThAWK1G2q56fX-n3lpwAKv9pA7x0VjCp-9qoaxRA&oe=6AFDCF4F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scont
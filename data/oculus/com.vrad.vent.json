t=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzbS2KKBnAP-oGz2RF2cDcsWwFtFAW-SuOLRU8TclKSg&oe=6AA9458A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWT1SQ0Wq28Q7kNvwHNayjG&_nc_oc=AdrkhYjhsy4-YlACMUxnqMho-RYJqFJ89zE6cf8JcTKqSSlVwTYd2GyebMeFSxuaV7k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtc11fq-nVlGUdW05NY9IddprA_HbN_m43ojuLK9zCbA&oe=6AA957DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltFCCJqQ9hUQ7kNvwFaBiZj&_nc_oc=AdoU0C6gIbCnRpVGdFshBSGZqCfnujhb_zNp2CP9u1wIK2ZqS6bCA2_oDb0F-Ezf15k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7m8OhYjhvgTAPBwNkYOCEk2dqioysv-5vjAmQ9FSdkg&oe=6AA95AD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9b4U41lPH0Q7kNvwGkJ8dE&_nc_oc=AdqbIF0yEA6Wr27l_f4fJ_MOTe461HPPRZOFmCevCek7VyYpiMk3TPtB72Ym_cBkDAQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3LY2HTMP9fYXemfgtUDKNTMxgP9xSbr4AXIFFpudvaw&oe=6AA947BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXgp48cNpdEQ7kNvwFC2vfN&_nc_oc=Adp7TVZ2XA6pMBaFvqVfZ_XyF-8C5BPBXW0lVftkwegv0af5tIXrH_wG_oLSHY_-5Dk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ98FftJh62SKTkYAEjQiK3Smp_SeXMIKYHUYR__TWV1w&oe=6AA948B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XZbQMaY5X4Q7kNvwEeBu9Q&_nc_oc=AdpL6Ksy_stg8kAbWi7mqFP7ghZPIadTWHCk8CVWIncsiXUhnFgNWalqp122V1gH7sA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa92SAB8EDWLgC5D33FANbfsIVdV_DkJ97DaQrKAO57Q&oe=6AA9370F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqNkVCJcaeoQ7kNvwEjSyck&_nc_oc=AdosswuAxxOaIlEz0Kg_w5Kn_BLyzTYS59lVdZ5jhKhRahVByv-mVRsYHbSkBjLh0JE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBRpcAAqRO6NINm2fwnzSEtk6jbkoTqHibhoFeEq8dLA&oe=6AA944EE"}, {"file_name": "
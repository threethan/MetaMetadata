t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmvwcF21_vmIFf9k1ut59BnpjDoga_iLIEgR0BCUa7Iw&oe=6A4CFC8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaL2_qhr8DMQ7kNvwH6RM4G&_nc_oc=Adp0lUgEvvXbBYH5k-X_zj3sgnwtPH7UYQNW4MeQffgT4CuNaZdtUOhEd5uzuJyxMoE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLwSMmFKzYitimFcCO-hk4tstHp7SEayaDXN1u2RKzDg&oe=6A4D0EDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddHwBmb9Z44Q7kNvwG62VHe&_nc_oc=Adpt3kSWjogHSajAD_JvzTB7z2CHryCVtn7rt4XPE7Sw_a-Xp90nUFLu5KhThWCTLJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4CqIxItP1GhS7BWTNt2HgBWmCogW_Kajaxi9TVjoEbA&oe=6A4D11D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-OQ9qHv2_cQ7kNvwHhQfBI&_nc_oc=AdpVsyFjrtPZMDOsvU45vOdEBIc3wtAiaj_BCXERMell_SV01Ckzb_WrUjXJ8bkdj_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3IWoiMrhHSbCBAuKwgl_BMRGj4w9UFMQRIoNQlGPtzQ&oe=6A4CFEBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpgtBZ3TNTIQ7kNvwG_0QGH&_nc_oc=AdqXg6BdxiBo5jSK5_4RMgmgnyw7F8jgYeoDMnCjBe349vt2J5DtM6C3GgxtGiX3v7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-lzjBMTs8Hz3MrCn8rMUv8hypTlK-psy5Xe6nweAq4A&oe=6A4CFFB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lXOA97hjjUQ7kNvwHDrcQ0&_nc_oc=Adr7iv8XPKTELXsaUlUzAlMfYLP3zQkA2L91ARdf1u14qUaTD_5Kk__IohXTF7PVXAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNC1wmdLrXboEIw3juVXKL3MHGC4zt4_k05VzKMNlSEg&oe=6A4CEE0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3z7ehChKikQ7kNvwFEEbma&_nc_oc=Adoafp5zEth6S_-zhe6IOno9N1VL4fuf7PJspOMQEBXcs4pn6xZnTEYlT3UydtQgVJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6lYkm2VRmWEy4q-d_DbH4Ut91IfMv6Jf1hOkCNP6DPg&oe=6A4CFBEE"}, {"file_name": "005.VS_M_Squar
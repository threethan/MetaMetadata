t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBxb_9BFgzPQgkovF3wtuShdKN3Nv6SANAWUPbT3ntgQ&oe=6AF4A34A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xct93eGgHzEQ7kNvwEaKYEg&_nc_oc=AdqDy28muZMlBYtfgQwkcK-3ZMCsHH8QPoVr-HRcR85T4iHyyP0yTlJ_CCcwEuUpb3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8OTpcgxc1KYofBXMY4iZHso_h_Db23f7Qk_MPGyIRDQ&oe=6AF47D5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_c8yPxC4l0Q7kNvwHbXEdU&_nc_oc=AdqXrCKtzYdvVJ3sCHxWn9c5F2V22OT4YvuWdDMsmEXjbxSTqD0p5Q8jbbpLZ0pVZbM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXKqUkZHn3WCCznVCVWVcV4EuY8y2KDwDMDynP3X3KpA&oe=6AF48050"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJoypQfnl_sQ7kNvwFZatN0&_nc_oc=AdqIR1__Xhhz91Nm5Ue2SBN2Dhl9x2i0x8DyZYWqku2hNGzEsytQiX-DjreDYJUdo1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMFcJPYtEzp2wq8JoysBebrVfj2qPWfV-Z8RdmAfXHkA&oe=6AF46D3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mGOn7fj-fcQ7kNvwH8w1kh&_nc_oc=AdqhC21P-Wi3Fa4Gu-xxCjCXXrZfHz_3U9wvYRIUrThH4lJr3nO07Pnh5UIQEpPtf-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSydl_ZXKc1npPzKMfM4dqv4mnMty16vo74LkbHL6KoQQ&oe=6AF46E39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNXNQ9uOoUgQ7kNvwGuKTZb&_nc_oc=Adp9PHQRYqiGokIuVUum0dvxVOlR-ynYo2d1A_d9bJAvTZLyD1nPq0Jo9nexM7TmtW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUUgLfpQ0gEx61rk7Pm44Ox3RP0EmrMTnAbpYvZ9ydyg&oe=6AF494CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4Jf2Y4Kr1kQ7kNvwEohCcg&_nc_oc=Adqd_JBR4NOp-Kvv5O75vsaXwLD-q2_os1PEO9G9vt6OTW6GfvzzHlXBcNhpTeGakyQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWbCElxCpuj7t5IHWGQ2-8CzNh56dVrcfO2lXXogZSiA&oe=6AF4A2AE"}, {"file_name": "005.VS_M_Squar
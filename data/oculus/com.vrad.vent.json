t-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVRTfCzx1v68yKNR4CkkXVe9ICBFy4WAlihiNdau6mMg&oe=6A5A2B8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=johQc3uPVRIQ7kNvwE0glQ9&_nc_oc=Adq8fyKHRUg48H71BCsq9VLFjsjwLO_rhkd68QlrX8kN4JlLrXUxd4BU7232QSjeyF8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEtt4OSeD7yTp-xQb4sLXKmkBdMDN_brw8NHB0edPeag&oe=6A5A3DDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8frrxRr9SjgQ7kNvwFZeOE0&_nc_oc=AdoV6N_LkOJpNWWNq3JBWJ8UHeik9jjtvdKK8O2VHtR4pLsimNXbI_2f6tDzALrE5Sw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUM08BxVVu8Swl1nQlb7FEGdqe6SqcfzMjQzceWBy4Og&oe=6A5A40D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7iSRTLehp8Q7kNvwF-ReO_&_nc_oc=Adq4GBVN6NSNUig3521zAjYxPj9z7nw3qW2K9LHqEEjWBwoUDPg7WJavkWGCZWicyik&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXZuZcwP4wJHBmOkSQp7r3Q27sFRfQu6_dDu_zDR88VA&oe=6A5A2DBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNGkkgQ0STkQ7kNvwEPdg-t&_nc_oc=AdrnuGPTXXJD8YSKB5EYuCun8tz-ZaQoNShRWjvoRKjTM35xK2dTGfZzymDVrh-rmxM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTB4NjqsNPycJz1m3mwc_fzWZCNVs2XhpgsuoKQ0ZHGQ&oe=6A5A2EB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sIVIUZrcCAQ7kNvwHsSewL&_nc_oc=AdpHcN5mbYQxhRzi2Of0i5oQoZCVE3OZYe7DHTc6UJbZC_uTOY1ECDjvpeRchXGmN2E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWrYTE7HQi9TT1YAwXIL55xIHbXCMGfPxybk9UnOtQOQ&oe=6A5A1D0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79drDCGLzTMQ7kNvwGF9nbH&_nc_oc=Adqb7vXzM3oftdqJljhzmYqqrqbHop7RpGptflxthcAxkFSMRRBZgP0n7t-gidMk-Z8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACjKaqbCUDLsFYTqDPiX3ZFkq4mfR-KATzJPkZJ1MSHg&oe=6A5A2AEE"}, {"file_name": "005.VS_M_Squar
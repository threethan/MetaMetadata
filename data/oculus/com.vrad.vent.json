t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WxMHZ0FTMhEmRx4ptH3yL5TwMrnVyLhsAnk0zY-28UA&oe=6A314D0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pL38g3zFHvMQ7kNvwFAxZBZ&_nc_oc=Adpf1HfEQ_FfkwJrsrw3PIbWe3S4WroLinU8zqOHI47bmmUIpqvXaNyDS_j_F_BzZhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YnDkkwxvLCYOS5RyTZfY2qt2C7bD-uI8ajB8QHodlBg&oe=6A315F5B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kFFq-wjYQQQ7kNvwGfKVSn&_nc_oc=AdpmQ09ZQazLabJc-ezQYOeXyANxMUjDYDKydM6eQ9i6m2cWflBm2V66-vG2e_1A7pQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cJcdm2QFq9K_EikBMqY3f6D9EPgU7IlUfgb9nXKxsAQ&oe=6A316250"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV11VP5EC0oQ7kNvwH3tIF5&_nc_oc=AdqsbffX3Yj_JRLtTpa8alVg6uXMqFVqjdmL3iwkpRqd5A9w16uJh6ezqpCjSjPc_DY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YHQ_mMQb5eqU2AxhDvwm0AvuVmdMB-pHFASV_3klg2A&oe=6A314F3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYRqWsiZkiEQ7kNvwGdVqed&_nc_oc=AdoxQc90Ee01gCu8sKD7aiCx2py4nCuX6kEBBna4rdDWceCjvVF8JYwt2MTJpZqd-cY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ik9vy52gPoCc24ipX3EkKYHNor615ENp-CZ6NSI6XTg&oe=6A315039"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRyiLNWTzIAQ7kNvwFdp41V&_nc_oc=AdrsSxIiG6fxu6V8wYmcLo14sMzv9WUQDCK_6FCiiNMZmgXJsANrwts9gQM_CyXdrNw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zWqK9U47cYhgRqYbGIxtF8CcA4YM1sX_tSqJdZ_-jBw&oe=6A3176CF"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pc4znCaEkMoQ7kNvwEGFyG1&_nc_oc=Adpsn9_fv4MDO5xLTTaecoI25gLG0jO38n-e42xcFrkmVMlhIcUB5YodHW5PD81yDJc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wx2V1aapZrqF0wwaiB8T8y47amfTlDcum8AfqY2KuEg&oe=6A314C6E"}, {"file_name": "005.VS_M_Squar
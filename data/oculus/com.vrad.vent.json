t-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGlaokuhxTkNlieKYALd9mhKnvcIuZucDdB8KW2gJdbg&oe=6AABE88A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWT1SQ0Wq28Q7kNvwEScbst&_nc_oc=AdriPbP9BxTnyLTHX60M8t4IbViWWRAT-5t2A5GfYZAS2P3Dy_RrN2m32Kv8Gixwj-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgFg-1n9nCF_tue6lEpZXEvqdNGZbpYo8W6qbFuusWUA&oe=6AABFADB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CeRh6ls8UwQ7kNvwEE_EtL&_nc_oc=Adrca9ednnAPdQ2slTWCQm7YVbhsOkz_wRWFBkOc_fcLRhElzIWxmNu_g21IMEMzVyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKnGBqdt7zLQh2z2hOlXk7nPUcJ_KeLgLauOwahWn-MQ&oe=6AABFDD0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eTZn-3hli4Q7kNvwHFQpgZ&_nc_oc=AdquIXFnH-ChQTOL784lpDRU5w70p2nuJxFlpbU3HiJDVpvPQzbmxy0PfQtp2QXZ9Jo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBzv5uTlwB_8cKEHIjzoS0YePAPV45H04t2wx4kJdSWA&oe=6AABEABC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXgp48cNpdEQ7kNvwG0G2eD&_nc_oc=AdqdCIakRzXXMd83UPb85phKYX51bscGlGcX9zDl24mhhHHjb5B8rKd9QnzYSOlYdBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvMd5Pn3JMa8GrkBQQ1MgzhUnklXQmysOfh7JvaFh-_w&oe=6AABEBB9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XZbQMaY5X4Q7kNvwH4xJ5c&_nc_oc=Adoxktktl4mSjKEETlb01OmfPZZ5ptVvq9ghkkMGGVkPiaX1yKGgyF_dx2GzyS_2Tmw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEoK_JJt2BPeXb9UXoba6jbVDgOL-hmeWeu5waQCna6Q&oe=6AABDA0F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Zojd4-iB5IQ7kNvwGbrxhV&_nc_oc=AdoW_WHFLPGqM6e7uunyw28i-Rl5LFsm-qtl1b2q_SKnQ4cormuA7KJMOeirTIln338&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrejDoCTsMj4-nKJNWYc9_haVQkyz5rvkuiFU1rT6TTQ&oe=6AABE7EE"}, {"file_name": "005.VS_M_Squar
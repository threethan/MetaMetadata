00_AfxitByxmPAs4h3aGweOuQ0Um7l3Idq3M-q_CXlyYy89Nw&oe=69BAA60A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBiF08zHsuUQ7kNvwHElEO_&_nc_oc=AdmWsSIirxU3qBITrzcIi6791hchhmJBFXmvjAcCzJkPoLb-ragMY_-LDuxuTYa_ZbM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzy3-NcMniDCkMktsZeEeoaXmUJILSBRq3riGhgNctRJA&oe=69BA801B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3vQC9FEuq8Q7kNvwH45xbT&_nc_oc=Adl1AS4AZReJWo2Ejh5n-zsooSPsUuzvgz-3cp-g31l5eUiVDKjCbwJHhp2w-5Qx6a4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxx_sz4lHCda7DRjUf8-DPVWoUstziHj4ptiV6fYXrkVA&oe=69BA8310"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsCH58M0HJ8Q7kNvwHkudB8&_nc_oc=Adl_C7ojExfv6wz5tFmYzQB-1zLgxbqmH5pNd4qCbRfSF0f7xUHikfIzFP6hp2GW-0Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhEoCu-82WRE2IESjGWgz4Pct-zFauD1UfatzTgYS7Yg&oe=69BAA83C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Mana
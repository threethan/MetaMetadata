t=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzOZY9K4uyLxFKKGFOxD3phEyA3TBl9-EvUk-QZ5DtHw&oe=6A7DC40A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOA9fchcDkwQ7kNvwF26Wup&_nc_oc=AdoWw-krFDuR7h1bMzg-uRu61puRFO-BzMR4jJ63Ov-jIlTcXT1VAEotEndlygT6O2g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTc55XOHvS2S5sHrajCeimbaIX37BsdIUT0xYhfkEOhA&oe=6A7D9E1B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FY05wXWim-gQ7kNvwFrSxLi&_nc_oc=AdqgqRQ9gqJvwAERKEjMfsh0OJ_AkoBhqA4Ys8_xh-aeZ7fI0F-BlwowNoVzGByB5eU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3qs-S6bTdiM0hmU1stNJHbfxhp7kgmxahYxe8XxCuPA&oe=6A7DA110"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVjY9lkKOSoQ7kNvwEWUrIP&_nc_oc=AdpHi0ojgJH0VIPY8gZQvNSxlzMdY3cA-0eB_4ufMjbp_g_BUDx-zkj9Nv6EmN4eRhU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEUfG31q4vM5K80hyEJd-eV52VAcMPDMUW3cjvBnKYGw&oe=6A7DC63C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNzQJ7CRQjwQ7kNvwH5CKSt&_nc_oc=AdpaZby87ujMmhbSqPIhmBO83n4kJht-XMkLFXK82fGPswi-CbEzkm45BgNWmCB-alY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwgioZROb9dy6L-G1ooKOQ3X-4U-FtR_nbS1Up9apUnw&oe=6A7DC739"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcRN47lXuz4Q7kNvwG75F2o&_nc_oc=AdpBEKZghAEdHYl1_wqXe5TXsl3wwOY98j2LjqRCSGDk_WQHpJydoa-6yVmz9VKprew&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH05Izh70ncOoKdD5rjxlF0wdk0oP2J_DrYxP10I8GHdg&oe=6A7DB58F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvXn65RlDRAQ7kNvwFqDO1c&_nc_oc=AdpcWmlssMGREfFP9FVNjOHu3h4l22ik5g1apYNc1IynorWCYsAqXvktvjHf4NEM6O0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtsCtcZDjQ8bnufghzmhxkC6I_UuvskTvd2vW8LhJlsw&oe=6A7DC36E"}, {"file_name": "
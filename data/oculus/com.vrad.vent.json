t-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFQQLMGlvA51ssK7zZLaSGSkrMeHpBuvbjb5_YE6KD3w&oe=6A90390A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qe3J_b1uPGgQ7kNvwHlrayS&_nc_oc=Adr6JxhIdPSw-UFe6DGW3SXtSI0zunU9Df6NduAJnrHaiIdPZWpnwqljZmkjIJ3EH9c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuxaggnvrpdP0TeCWXgQUTZ3YSW4MM9gM1kgrPLmo8lA&oe=6A90131B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxErFZT7CdMQ7kNvwEF5ScG&_nc_oc=AdonDT4wUkWoiv7g1EfNb1yjkKMFC6FjM4kOOQUk_Q_KTKZRfpJeMrH7E5dOXd4SB2I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTXULqGNXnXVzQgbjinzIfAegZe7aa25IpCW6UHbr4YQ&oe=6A901610"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nfv13Aj5h5oQ7kNvwEHnKdZ&_nc_oc=AdpZJx2fSpU_p7Ijozp9K1ISrztS3m_hCHHvVpN7MKY5GX2woM1QzX2RBHt0rfaiIzA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOhp1Jeq2rsiggW2gfDiuvQsFi0T1-ROlwlZa9eMfreg&oe=6A903B3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx5x5zuLhW8Q7kNvwG0CrM4&_nc_oc=Adozy-tJRFByXwQ_IUb5nbyeqL4IOWY2tYM6fiTc34KkeNksuZb4caljXdjgN-OsFFY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBPrb2TJhknnkOjvWiJNkm9yQGl6X1Z4xeGWeU_4nx3g&oe=6A903C39"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f62aFoHYg78Q7kNvwHvlvKf&_nc_oc=Adrybz5WuERI3opAjkpm3NVtCJrXN5OA4cFaHFSm2SZWmLe7keLHXzVhUgutdsH7aZI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkDQcYghCgr8mOmgRkRZnsJ-Mb2Lq79Ck2xL5_G2Sn6g&oe=6A902A8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnWcGRpN9CMQ7kNvwEGPMXX&_nc_oc=AdrTrj6YpXOyJURCweJ1WktqDY3UU28C91DSFQ2X1MGgcXqXmPM4XM-c2h2rlU_JmVw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpy3kuQrOfbtTocPqM7XKjDrUjHg12X3XrJYZzIXMOWA&oe=6A90386E"}, {"file_name": "005.VS_M_Squar
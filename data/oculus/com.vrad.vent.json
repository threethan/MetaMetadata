t=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn7rm2LgAC772uv13dAOFIcx9y1X81YYkskhQBMGzhGA&oe=6AA3FF8A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-QkTCh6KssQ7kNvwGv9KKE&_nc_oc=AdqTuvt2rxs7Vn2hRkvuDY7LiG6qI3CeGiRcO18Pkx0xUYSS-HfXJufCJwAOc_4tC5g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY_wyfeKd5jxYyW_xdPUuTU2IRXJNqh1j0z3XV3vAXLw&oe=6AA411DB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP1bhCSRq0oQ7kNvwGzHT6R&_nc_oc=Adoq2mYIigBC9Xt7uU3uFwKjvCRs7ihaKIRtVP1Z1jFDSyabH99cofUSK--MXDivXzQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlROm5Ye-HSHXDb3Pv6yMaaWZjaeR-7tD65yxDV42DPA&oe=6AA414D0"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zh5FTzT6k6cQ7kNvwEN6wxS&_nc_oc=Adpu_2-5KN2W6vL-XNVa0TObaY7hR9am3AaYAHluwtFCJ3BTC7cVXaApjqAYj5874W4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDJEVHGb3Ie3w5bV1WboPZV_DCJWZVOynlVAon_EwSVQ&oe=6AA401BC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbDMBZ5BwSQQ7kNvwFAJcik&_nc_oc=AdpNDVeX3BacRGKHlv0P57awHZ0gYe1uFQJErIyp9T_5n7ZgeRL3ttmh-XKW-uEJncs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk_Nd1j3w3Rte-MomN9pZX8ELZVK0SIUaNAb6qigi0Pw&oe=6AA402B9"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLfciw535G8Q7kNvwHMGriy&_nc_oc=AdpnAjHzR2sduhrQEnDXM_20AM6LpMTOjKeuB_uY9e0lwsOZ0prte_EmIU1O5W78jic&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvrQE-7VgYUuFhdF4q40W53pB27LhA_0wWBrSzn494NQ&oe=6AA3F10F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxxPZEamsosQ7kNvwFTeGWq&_nc_oc=AdrbnscYRbtioQ5NfKWSQ33KUs1aXb_FSdRx1lznDTCfGc-ZVSLIQcSlMsHrHU_9TEU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI36jg46yIfO7tQSky6LRgeJtmUlyI6bMKcRBCYVdFdlw&oe=6AA3FEEE"}, {"file_name": "
nt-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wbn4It8vYpPcvajYRcu9ab9cOgfP6jUYgHS_r6AEZjw&oe=6A09C00A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA6ubC4q_7QQ7kNvwFgdAiy&_nc_oc=Adp5t3-XzVe1W7B6DBVDih_lKBKiTRoRYV2Fq_CNuKY5JZgI_4gUVsoug3D8GEenDgQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xTFg0Iy04tZhIKVr2Yj7YS7k2e3A3kd7QOFNPlAXE9Q&oe=6A09D25B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqqKeyYdTtYQ7kNvwGRWbVX&_nc_oc=Adp2nAyD-cFxDzZfqmrbFAHYy5gLNy5BhKGWm_ZFas6V_UhgtJr1rx-ovrwWH9XJYFI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X5b9DujDKRcvMcnrly1VlZW4rGWJKiEWP5_mo0tPSsA&oe=6A09D550"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLJeSME2okoQ7kNvwFyX1GZ&_nc_oc=AdoTp91t9kYpqGn2DOsztofSKzk1AutS1lI3N-pgAVQXLHk3A6Pn_-yvdBvuA38mvic&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kq95D0wj9xgrl1f9Fmy32msxicm7Fwam40wo6OIc56A&oe=6A09C23C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUwjR54x6XYQ7kNvwGfhFIh&_nc_oc=AdolRc4E48q6qowOaOGYkfvyMAifdMKbMQ1VmT1320CEjFXDFzzOl-yWA3RhSWRt0SY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-KsnuLykEVMuP8qrCzLjadOgzxBiGi4QkmhJcfWUraQ&oe=6A09C339"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MX7tO6CTiFwQ7kNvwFaOhMu&_nc_oc=AdrBIYGvNxnGGNS7dJKo7ydrmTi0GWr6bfvvJ5qAH5lC7iE7YZViDKNqqrC0D6fSAIU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BHjSt8UDrzBMiTWRXgexW-Vcj22CxIs-0nhzSB1S1Kw&oe=6A09B18F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grXmUroRHIIQ7kNvwFpG97M&_nc_oc=AdoxkLGa0j9buN1LFnY1JlBCXUXQq2wLxCypuG8UnOKNN2enRMi6e_qKodkmxheIzvU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54Qk_5OjaNihH_zxqmdIJiuGWXI7HNldaYtOT8SvplOg&oe=6A09BF6E"}, {"file_name": "005.VS_M_Squa
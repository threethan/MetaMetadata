scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyKOI0GvfvzSHoPrJGe_F--KJydb-MkZ0V9sr0NXXa9w&oe=6A85AD0A"}, {"file_name": "011.VS_M_Screenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odQjEQpn9PwQ7kNvwGblco6&_nc_oc=AdpyPQjLIVqcYM3su8pkNDVxQS1gWQ0whxafSOGOkGF5C_P4kE-yZuJY6uS5Ag7hSgc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzGhxbcImOBwQ7Y-ofGfNqj2jap9InbJ3joAhvbCI3ng&oe=6A85871B"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzoBnx5U0O8Q7kNvwG-nJn9&_nc_oc=Adoyh5bmfFEn8lHyQlUBk1Wtm9y8Az_344cxBDTZSLOguFHKoyUmZMWGz02mY6vc3ws&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQqsetznWko3d15p-MufTxE9TOvw9tIRr-xs1hmI2Thg&oe=6A858A10"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWVulhC99VwQ7kNvwEc8p2f&_nc_oc=Adqdo3cR50kwmyTc8rD3WmLfCtR4jCygj8YF54K13fE1Uz5RT_38c_ANrYtpOscBOJk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0P5_vGtVZ67ohakmnIE4dY78Mh2JKfwGaM1NBfb5L5g&oe=6A85AF3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, ensuring a reliable and effective learning environment. \n\nThis VR simulator offers an immersive experience for mastering ventilator procedures and alarm management.", "short_description": "VS-Management is a VR-based ventilator simulator designed for users to train ventilator operation and learn three key alarm management procedures."}, {"images": {"nodes": [{"file_name": "015.VS_M_Back.png", "id": "1690717328178195", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473394271_1690717331511528_6387639417886293840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWKHe-bGWu8Q7kNvwHBKg1P&_nc_oc=Adq-MYnLzwOdlCGnB5Nw8MIM3qNcngAOfzZcossGBadzCSBFYqsnpg_hUkOUStdGZWw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqQ5voT1iKU5GadOKFVIrNNnTwEzVTnV-U6B16mMKN4w&oe=6A85B039"}, {"file_name": "014.VS_M.png", "id": "1624805861475462", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473394167_1624805864808795_4742067852837435819_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvXk0HbusysQ7kNvwGR9cNz&_nc_oc=AdqtBL0za2w0EFruwmLn2qpkPExgp05r_SbEAc1XI51y-qc7PaPT-vGPBLPkUr9CN88&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgsUEPeGmKA6qDRWjD6qHOj5g8Ec-KehCmnmoD-nBlMQ&oe=6A859E8F"}, {"file_name": "006.VS_M_Portrait.png", "id": "1192361138888724", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473400716_1192361142222057_7581507312873433284_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLFsxpHLj3wQ7kNvwGC-PBb&_nc_oc=AdqIFpgm2q4VlhnArs7pBW00Kbi2wLGxfE0_PNjx--iPioIPAk9UVL1WtvJciVdmcmQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFduYM9W13v5aTAq5mv2ofbNwD7zzeDZFQpujQxzG5rqA&oe=6A85AC6E"}, {"file_name": "00
creenshot_C.png", "id": "1134016061558350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393621_1134016064891683_2667326289239026706_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_A_G3HS7i8Q7kNvwHM00EO&_nc_oc=AdkoKL11ISjTS_s1CDWURwZDDz0rs0JplUBf_0KP9eeMNhwosvxzdBlpFJDWUzhZFZ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs1sipXFdcT5QyC1fiudfZa3dulWahfdaTjcSMPbNquWw&oe=69A44EDB"}, {"file_name": "013.VS_M_Screenshot_E.png", "id": "2018901491956266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396587_2018901495289599_2119721929138014159_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVTgibjD2gMQ7kNvwG0muj3&_nc_oc=AdkY8qvXj8SynddwnE4WJIds_5Ly6fRFpxyoCEVZ35s31gNv6baInYeD4D4f2DvUkRs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuf_bee9Us35PRYKRxDv9EPj2g70KQSMuSBX-VEFbiwUA&oe=69A41990"}, {"file_name": "012.VS_M_Screenshot_D.png", "id": "1684243098821365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392145_1684243102154698_3432553206258939649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOAvYXv8POwQ7kNvwGPzX4K&_nc_oc=AdltEfPxoUdYf37vMoD8rY_LHy3F9ofIu_GNxpz9GPSfMl3gvI_vlvTZ-NKP7RtmvCM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsM1h7Wq1yje9f63qQSNZz0MnbxhQm58bjnotfz2LYE-w&oe=69A43EBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VS-Management", "keywords": ["VS"], "long_description": "Important: Full access to all content is available upon institution registration.\n\nDeveloped to reduce the challenges of ventilator training and enhance intuitive learning in medical education, VS-Management provides a structured approach to ventilator operation and alarm response management. Through guided simulations, students can systematically acquire essential ventilator skills, improving their competency and confidence in clinical settings.\n\nVS-Management has been reviewed by medical experts and developed in accordance with the latest medical education standards, 
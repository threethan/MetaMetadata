_oc=AdoK2Y4wP8KLfPoqf27D4mVYhm7mTAoR8yo0Dau2ilby4uZyiN2dc-o0WGFpXHg5c2s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbUNaK6f1FG_kWziyd0VOPmwxRKqGPmKHgN4uBvUoDvg&oe=6AA16933"}, {"file_name": "12_INTOtheART_Screenshot04_Monet_2560x1440.png", "id": "1417010667159875", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827646_1417010670493208_6362154174142238538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2a8hLWa7XdUQ7kNvwFIt4V3&_nc_oc=Adry9kq-u3pyO2d9vWNcGMFWPttcWtPtrpi_VBblJkBfnOHySQFBdrqAr-3F_VaGBxA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSS_tLSx434r3TOVmnBd1DnJn_BxUpjiwosV9YKT33Fw&oe=6AA16538"}, {"file_name": "13_INTOtheART_Screenshot05_Mondrian_2560x1440.png", "id": "1097924309560605", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823901_1097924312893938_512612430190283114_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Df46lGJ0PkQ7kNvwG2CRu5&_nc_oc=Adp8xektg_Q832CjV-KfnrAmU4QTKP2_t3BHB_jRWNt_jvonMW6bUjPzBqtQWE25HdE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzSTUol6oH72R9Z6lsPRI9DCDIfr-G5dL2S3SpgLs8OA&oe=6AA15F0F"}, {"file_name": "screen.png", "id": "1077764548076942", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604366035_1077764551410275_604406560606812327_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_0osJpcurQQ7kNvwHG92Fh&_nc_oc=Adrc-NUtxoZObHgVLLfK8oaVJDRNUe8XjUxFDtMjgaQpv5z1OBMJz7bsyv7HbYjDP64&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIG3q2YjLrv_9bhOk63nlXnN2CIYTMbmQGGggim7JCIg&oe=6AA17586"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_INTOtheART_CoverLandscape_2560x1440.png", "id": "1419034533450792", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/754914855_1419034536784125_6897011309977236415_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GenPIddLf5MQ7kNvwEBH-bn&_nc_oc=Adoz9jjyqu9gGOkb80owUozUSC8znT1VS1GYLLTN5eAbIzwa5AXsbM2X4Z1N_Y7JVS4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtVBQ2Cs7Q67HBPge6o1j7umcMxXt9vIjzRsczXvDX7A&oe=6AA163C8"}, "display_name": "INTO the ART", "keywords": [], "long_description": "INTO the ART transforms the museum visit into an immersive journey. Begin inside a virtual gallery where selected artworks act as gateways to entirely different artistic worlds.\n\nStep into environments dedicated to Giorgio de Chirico, Vincent van Gogh, Claude Monet and Piet Mondrian. Move through their spaces, interact with objects and surroundings, discover visual details from new perspectives, and return to the museum whenever you choose.\n\nAs you explore, your progress is saved locally. Visit new worlds, unlock content, earn achievements and build your own journey through the experience.\n\nINTO the ART is designed for exploration, interaction and contemplation: a VR experience where art is no longer only something to look at, but a space you can enter.", "short_description": "Enter a museum where artworks become gateways. Explore immersive worlds dedicated to Giorgio de Chirico, Vincent van Gogh, Claude Monet and Piet Mondrian, interact with their environments, unlock new experiences and discover a different way to encounter art in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.galleriabarattolo.it/into-the-art-privacy", "developer_terms_of_service_url": null, "publisher_name": "Vincenzo Bordoni", "support_website_url": null, "website_url": "https://www.galleriabarattolo.it/intotheart", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"
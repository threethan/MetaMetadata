/scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823901_1097924312893938_512612430190283114_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Df46lGJ0PkQ7kNvwG2CRu5&_nc_oc=Adp8xektg_Q832CjV-KfnrAmU4QTKP2_t3BHB_jRWNt_jvonMW6bUjPzBqtQWE25HdE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzSTUol6oH72R9Z6lsPRI9DCDIfr-G5dL2S3SpgLs8OA&oe=6AA15F0F"}, {"file_name": "screen.png", "id": "1077764548076942", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604366035_1077764551410275_604406560606812327_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_0osJpcurQQ7kNvwHG92Fh&_nc_oc=Adrc-NUtxoZObHgVLLfK8oaVJDRNUe8XjUxFDtMjgaQpv5z1OBMJz7bsyv7HbYjDP64&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIG3q2YjLrv_9bhOk63nlXnN2CIYTMbmQGGggim7JCIg&oe=6AA17586"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "02_INTOtheART_CoverLandscape_2560x1440.png", "id": "1419034533450792", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/754914855_1419034536784125_6897011309977236415_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GenPIddLf5MQ7kNvwEBH-bn&_nc_oc=Adoz9jjyqu9gGOkb80owUozUSC8znT1VS1GYLLTN5eAbIzwa5AXsbM2X4Z1N_Y7JVS4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtVBQ2Cs7Q67HBPge6o1j7umcMxXt9vIjzRsczXvDX7A&oe=6AA163C8"}, "display_name": "INTO the ART", "keywords": [], "long_description": "INTO the ART transforms the museum visit into an immersive journey. Begin inside a virtual gallery where selected artworks act as gateways to entirely different artistic worlds.\n\nStep into environments dedicated to Giorgio de Chirico, Vincent van Gogh, Claude Monet and Piet Mondrian. Move through their spaces, interact with objects and surroundings, discover visual details from new perspectives, and return to the museum whenever you choose.\n\nAs you explore, your progress is saved locally. Visit new worlds, unlock content, earn achievements and build your own journey through the experience.\n\nINTO the ART is designed for exploration, interaction and contemplation: a VR experience where art is no longer only something to look at, but a space you can enter.", "short_description": "Enter a museum where artworks become gateways. Explore immersive worlds dedicated to Giorgio de Chirico, Vincent van Gogh, Claude Monet and Piet Mondrian, interact with their environments, unlock new experiences and discover a different way to encounter art in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.galleriabarattolo.it/into-the-art-privacy", "developer_terms_of_service_url": null, "publisher_name": "Vincenzo Bordoni", "support_website_url": null, "website_url": "https://www.galleriabarattolo.it/intotheart", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "fr_BE", "fr_CA", "it", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1281443938388724"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673531334_2090572281564954_3481988423568917235_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8RVoXoUSkEQ7kNvwGHwKmq&_nc_oc=AdqfZ1ilPmA-icxQ6TV8r5MyHCZTagltkIYzhO7IliRCi6iqy-PDnebScAe3E4larMA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzRWQrV_u9EavGVnzgXS-i7T8kCh8_MNA9_eawQ3BLeg&oe=6AA1716A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "INTO the ART", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1788451200, "lastRevision": {"nodes": [{"id": "1272583212608130", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1272583192608132", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1546425653344005"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2084263352459935", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INTO the ART", "keywords": [], "long_description": "INTO the ART trasforma la visita al museo in un viaggio immersivo. Inizia all\u2019interno di una galleria virtuale, dove alcune opere selezionate diventano portali verso mondi artistici completamente diversi.\n\nEntra negli ambienti dedicati a Giorgio de Chirico, Vincent van Gogh, Claude Monet e Piet Mondrian. Muoviti nei loro spazi, interagisci con oggetti e ambienti, scopri dettagli visivi da nuove prospettive e torna al museo quando vuoi.\n\nDurante l\u2019esplorazione, i tuoi progressi vengono salvati localmente. Visita nuovi mondi, sblocca contenuti, ottieni achievement e costruisci il tuo percorso personale attraverso l\u2019esperienza.\n\nINTO the ART \u00e8 pensato per esplorazione, interazione e contemplazione: un\u2019esperienza VR in cui l\u2019arte non \u00e8 pi\u00f9 soltanto qualcosa da guardare, ma uno spazio in cui entrare.", "short_description": "Entra in un museo dove le opere diventano portali. Esplora mondi immersivi dedicati a Giorgio de Chirico, Vincent van Gogh, Claude Monet e Piet Mondrian, interagisci con gli ambienti, sblocca nuove esperienze e scopri un nuovo modo di incontrare l\u2019arte in VR."}, {"images": {"nodes": []}, "id": "1680873906792914", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INTO the ART", "keywords": [], "long_description": "INTO the ART transforma la visita al museo en un viaje inmersivo. Comienza dentro de una galer\u00eda virtual, donde algunas obras seleccionadas funcionan como portales hacia mundos art\u00edsticos completamente diferentes.\n\nAd\u00e9ntrate en entornos dedicados a Giorgio de Chirico, Vincent van Gogh, Claude Monet y Piet Mondrian. Recorre sus espacios, interact\u00faa con objetos y escenarios, descubre detalles visuales desde nuevas perspectivas y regresa al museo cuando quieras.\n\nA medida que exploras, tu progreso se guarda localmente. Visita nuevos mundos, desbloquea contenido, consigue logros y construye tu propio recorrido dentro de la experiencia.\n\nINTO the ART est\u00e1 dise\u00f1ado para la exploraci\u00f3n, la interacci\u00f3n y la contemplaci\u00f3n: una experiencia de realidad virtual en la que el arte deja de ser \u00fanicamente algo que observar para convertirse en un espacio al que puedes entrar.", "short_description": "Entra en un museo donde las obras se convierten en portales. Explora mundos inmersivos dedicados a Giorgio de Chirico, Vincent van Gogh, Claude Monet y Piet Mondrian, interact\u00faa con sus entornos, desbloquea nuevas experiencias y descubre una forma diferente de acercarte al arte en VR."}, {"images": {"nodes": []}, "id": "1586092339558701", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "INTO the ART", "keywords": [], "long_description": "INTO the ART transforme la visite au mus\u00e9e en un voyage immersif. Commencez dans une galerie virtuelle o\u00f9 certaines \u0153uvres s\u00e9lectionn\u00e9es deviennent des portails vers des univers artistiques enti\u00e8rement diff\u00e9rents.\n\nEntrez dans des environnements consacr\u00e9s \u00e0 Giorgio de Chirico, Vincent van Gogh, Claude Monet et Piet Mondrian. Parcourez leurs espaces, interagissez avec les objets et les d\u00e9cors, d\u00e9couvrez des d\u00e9tails visuels sous de nouvelles perspectives et revenez au mus\u00e9e quand vous le souhaitez.\n\nAu fil de votre exploration, votre progression est enregistr\u00e9e localement. Visitez de nouveaux mondes, d\u00e9bloquez du contenu, obtenez des succ\u00e8s et construisez votre propre parcours \u00e0 travers l\u2019exp\u00e9rience.\n\nINTO the ART est con\u00e7u pour l\u2019exploration, l\u2019interaction et la contemplation : une exp\u00e9rience VR o\u00f9 l\u2019art n\u2019est plus seulement quelque chose que l\u2019on regarde, mais un espace dans lequel on peut entrer.", "short_description": "Entrez dans un mus\u00e9e o\u00f9 les \u0153uvres deviennent des portails. Explorez des mondes immersifs consacr\u00e9s \u00e0 Giorgio de Chirico, Vincent van Gogh, Claude Monet et Piet Mondrian, interagissez avec leurs environnements, d\u00e9bloquez de nouvelles exp\u00e9riences et d\u00e9couvrez une autre mani\u00e8re de rencontrer l\u2019art en VR."}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "28691964313826340", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604370996_28691964320493006_8109314524638986604_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjHUkBNWjSsQ7kNvwHCEHMu&_nc_oc=Adrc-AGWksBCAkF6FmspwwiEl7XDmiHAWHaMV-OooPy3rV7jnrwgHsdHZn9148BA8TI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGFaYFZkBbkJZNvpNvdepp5j5PEKddsZTF2FZ7KnF3tQ&oe=6AA171E6"}, {"file_name": "ChatGPT Image 1 set 2026, 09_46_19 (3).png", "id": "2179644079654089", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673536876_2179644086320755_391628969770676347_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWJKVzftCm8Q7kNvwEHLOrQ&_nc_oc=Adrl_UAlCu2uwLTj8
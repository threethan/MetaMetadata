cdn.com/v/t64.5771-25/38974804_421406310474235_1381695160635557774_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2IHdPsZDCkQ7kNvwGyVSGg&_nc_oc=AdoT9cFq1iDWpvCTh-FuTD2DyEtax1MI5BkYXXtDxt1EtBfm46qW19YK3x9g6MS--90&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0yJ5Yp8KdFLXr_3yUzjX9mTohja5yZn3hfGemo2xVMg&oe=6A86F682"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 6.png", "id": "851657576973695", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75330716_851657580307028_764677618217052868_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZASGO_XschAQ7kNvwHHZeBd&_nc_oc=AdrHsyy0pC08hxMaszgYXLWFPRaTwAwFrm2jcdxofYgFNJwVsbDiquZcjHO7Gsh9IF8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_ObF7LM89azIKxcBUngZy-_h2gUS8Xm9Qh7aeIYUNJQ&oe=6A86E0A3"}, "display_name": "PatPat", "keywords": [], "long_description": "This music rhythm game takes you on a fantastic journey through vibrant and dynamic beats. In the game, you'll find yourself immersed in a captivating musical environment, creating wonderful musical echoes by tapping drums on your desktop. Each beat is accompanied by the melody of the music, as if engaging in an intimate conversation with it.\nWhether you're seeking a moment of tranquility amidst busy work schedules or simply unwinding during leisure time, this game offers endless joy and relaxation. Come and explore this new musical world, where your soul dances to the rhythm of the music, and indulge in a journey of pure and delightful melodies!", "short_description": "This is a music rhythm game where you can tap beautiful drums on your desktop, follow the rhythm of the music, and create energetic beats. Come and experience it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yx10wesce3.feishu.cn/docx/TisGdeT21olHDax4FBWcgtuTn3e?from=from_copylink", "developer_terms_of_service_url": null, "publisher_name": "D-Fissure", "support_website_url": null, "website_url": "https:/
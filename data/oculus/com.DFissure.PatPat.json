cdn.com/v/t64.5771-25/38974804_421406310474235_1381695160635557774_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK2gY7ms5PMQ7kNvwFjiaSt&_nc_oc=Adoptx7I5QKMMQq8cZZL4GlKB2Pem_oaEzhQWB7fyws7oxNNQnWi7iyhaMS8ntWCb4o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO64sFZZ-2vTEtF17hrVUWwLX2PPV2KN1SEQtGjbEY6Nw&oe=6ADCA802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 6.png", "id": "851657576973695", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75330716_851657580307028_764677618217052868_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4V7uoHcpg4Q7kNvwGigU-K&_nc_oc=AdoS_4Th9oSipxmqoQfmJSWnXbiOHHO6YQy6Pn7OBFLWgE46W-XVCJM8FR7cBpDbc8w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLdpNKQSSAHMSkT7lUkbQn6fD8MRc48UwktJAWHq9_Pw&oe=6ADCCA63"}, "display_name": "PatPat", "keywords": [], "long_description": "This music rhythm game takes you on a fantastic journey through vibrant and dynamic beats. In the game, you'll find yourself immersed in a captivating musical environment, creating wonderful musical echoes by tapping drums on your desktop. Each beat is accompanied by the melody of the music, as if engaging in an intimate conversation with it.\nWhether you're seeking a moment of tranquility amidst busy work schedules or simply unwinding during leisure time, this game offers endless joy and relaxation. Come and explore this new musical world, where your soul dances to the rhythm of the music, and indulge in a journey of pure and delightful melodies!", "short_description": "This is a music rhythm game where you can tap beautiful drums on your desktop, follow the rhythm of the music, and create energetic beats. Come and experience it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yx10wesce3.feishu.cn/docx/TisGdeT21olHDax4FBWcgtuTn3e?from=from_copylink", "developer_terms_of_service_url": null, "publisher_name": "D-Fissure", "support_website_url": null, "website_url": "https:/
gbg7zeQSkkJU_3ybKYRnPKAaNozGPvdL_Lnt4Y2PttxMMBqPZ5DS512puc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuehkqn_3AV6ujdBfxiEKK9_rxIpJkSP9uOR2lHN6j4kw&oe=699AFA02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 6.png", "id": "851657576973695", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75330716_851657580307028_764677618217052868_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aD4Fbry634Q7kNvwH3Ks78&_nc_oc=Adn4YcB5QuUg-w5K8ig6q28H59hS2-72VPWLCLc7GCPlOUZB0fSUn2wblBpKARrNfN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuey9e9G7U1Z_2IEcvghT5KnVPGm2-nMlv2VaDvSM7pPQ&oe=699AE423"}, "display_name": "PatPat", "keywords": [], "long_description": "This music rhythm game takes you on a fantastic journey through vibrant and dynamic beats. In the game, you'll find yourself immersed in a captivating musical environment, creating wonderful musical echoes by tapping drums on your desktop. Each beat is accompanied by the melody of the music, as if engaging in an intimate conversation with it.\nWhether you're seeking a moment of tranquility amidst busy work schedules or simply unwinding during leisure time, this game offers endless joy and relaxation. Come and explore this new musical world, where your soul dances to the rhythm of the music, and indulge in a journey of pure and delightful melodies!", "short_description": "This is a music rhythm game where you can tap beautiful drums on your desktop, follow the rhythm of the music, and create energetic beats. Come and experience it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yx10wesce3.feishu.cn/docx/TisGdeT21olHDax4FBWcgtuTn3e?from=from_copylink", "developer_terms_of_service_url": null, "publisher_name": "D-Fissure", "support_website_url": null, "website_url": "https://d-fissure.com/patpat/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
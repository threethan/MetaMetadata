cdn.com/v/t64.5771-25/38974804_421406310474235_1381695160635557774_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLjGiQi-sxgQ7kNvwHlx2tw&_nc_oc=AdqUGmNFaQueieUQLddfN3opav24XzONaRZcN8eW2DovSq88s1j5l7JiQLJetwpw66c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS-sWYvN4-u2XMjFrrqxB2lnL4LQgLHrgWo8skPKfe2A&oe=6AF349C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 6.png", "id": "851657576973695", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75330716_851657580307028_764677618217052868_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LmSlhT8HSQQ7kNvwEOAQ4H&_nc_oc=AdqpSCRXUJ934GU0k3JmEFmM6ameYhopB7Yi1grJCFDLu97Ac1zJSzx60SY9gDTAKY4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmgsM8KcDnV4DoFGl9ArLultVPFFePTvmYKG3VXBfZUQ&oe=6AF333E3"}, "display_name": "PatPat", "keywords": [], "long_description": "This music rhythm game takes you on a fantastic journey through vibrant and dynamic beats. In the game, you'll find yourself immersed in a captivating musical environment, creating wonderful musical echoes by tapping drums on your desktop. Each beat is accompanied by the melody of the music, as if engaging in an intimate conversation with it.\nWhether you're seeking a moment of tranquility amidst busy work schedules or simply unwinding during leisure time, this game offers endless joy and relaxation. Come and explore this new musical world, where your soul dances to the rhythm of the music, and indulge in a journey of pure and delightful melodies!", "short_description": "This is a music rhythm game where you can tap beautiful drums on your desktop, follow the rhythm of the music, and create energetic beats. Come and experience it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yx10wesce3.feishu.cn/docx/TisGdeT21olHDax4FBWcgtuTn3e?from=from_copylink", "developer_terms_of_service_url": null, "publisher_name": "D-Fissure", "support_website_url": null, "website_url": "https:/
381695160635557774_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1kci_9szyMQ7kNvwEmVtNN&_nc_oc=AdkOpFda4IZultTpxSx82Sr2XShqgOs0mXS9yBYIKEZhSWwr2l7SbbYoKoWJ-9-pSPg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxWcDm1oPa24Ij49-Ui9_ZxDGxKiEgNeZZOMCKFVF5Yuw&oe=69BBEF82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 6.png", "id": "851657576973695", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75330716_851657580307028_764677618217052868_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsU9N4OjS1sQ7kNvwHG4td_&_nc_oc=AdkmpiEPX3zBguQXBrAJFfoOmZIvbCBoM-6L9P-I51A5mALngvwZVaoSVO_cDVgnV5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzDOabvfO_IMCTU1jU7hcNZTWdhyKrjucL47ZHLHJxYXg&oe=69BBD9A3"}, "display_name": "PatPat", "keywords": [], "long_description": "This music rhythm game takes you on a fantastic journey through vibrant and dynamic beats. In the game, you'll find yourself immersed in a captivating musical environment, creating wonderful musical echoes by tapping drums on your desktop. Each beat is accompanied by the melody of the music, as if engaging in an intimate conversation with it.\nWhether you're seeking a moment of tranquility amidst busy work schedules or simply unwinding during leisure time, this game offers endless joy and relaxation. Come and explore this new musical world, where your soul dances to the rhythm of the music, and indulge in a journey of pure and delightful melodies!", "short_description": "This is a music rhythm game where you can tap beautiful drums on your desktop, follow the rhythm of the music, and create energetic beats. Come and experience it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yx10wesce3.feishu.cn/docx/TisGdeT21olHDax4FBWcgtuTn3e?from=from_copylink", "developer_terms_of_service_url": null, "publisher_name": "D-Fissure", "support_website_url": null, "website_url": "https://d-fissure.com/patpat/", "category": null, "comfort_rati
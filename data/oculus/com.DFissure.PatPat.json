EmffxjBYA7zwd5D8Gdy4z_0JRxpWKcj4wkBxFsoSWT0KoJUQJLvfAPTlKHS4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFbkdZ5Iq6j8_RPHBXneeFQXf3LIAwatmE6cQSKQunhQ&oe=6AFB1D5D"}, {"file_name": "\u5fae\u4fe1\u56fe\u7247_20240402114008.png", "id": "421406307140902", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974804_421406310474235_1381695160635557774_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIgH1oBjsc4Q7kNvwHZ6sSo&_nc_oc=Adr-7K4Qd8wfp8MNUJ8D6t1GhKBe04Xbr7KorIhbhLXWKvyYZEXRwdBtUGdv9VXrM1g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIZnhWadRmDdvM2hMw0BXoNqYqfCF_04jOC74PSKYdCQ&oe=6AFB32C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 6.png", "id": "851657576973695", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75330716_851657580307028_764677618217052868_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCRuzFcv4lMQ7kNvwEUSk1r&_nc_oc=Adp1c6gVkuXP_U-OVDg-JY-IY3Ts9J60bP4_V8ZNzefqzXwSaVgMl7gDY8kF_8e61ko&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeJozd5dJmWMVwbTHzIsgjzioV7Fq_Rv3wSPk94z2jFA&oe=6AFB1CE3"}, "display_name": "PatPat", "keywords": [], "long_description": "This music rhythm game takes you on a fantastic journey through vibrant and dynamic beats. In the game, you'll find yourself immersed in a captivating musical environment, creating wonderful musical echoes by tapping drums on your desktop. Each beat is accompanied by the melody of the music, as if engaging in an intimate conversation with it.\nWhether you're seeking a moment of tranquility amidst busy work schedules or simply unwinding during leisure time, this game offers endless joy and relaxation. Come and explore this new musical world, where your soul dances to the rhythm of the music, and indulge in a journey of pure and delightful melodies!", "short_description": "This is a music rhythm game where you can tap beautiful drums on your desktop, follow the rhythm of the music, and create energetic beats. Come and experience it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yx10wesce3.feishu.cn/docx/TisGdeT21olHDax4FBWcgtuTn3e?from=from_copylink", "developer_terms_of_service_url": null, "publisher_name": "D-Fissure", "support_website_url": null, "website_url": "https://d-fissure.com/patpat/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6781327755232736"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3601862623407935"}]}, "baseline_offer": {"id": "3601862623407935"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1715186880, "status": "PUBLISHED", "id": "3601862623407935"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7265457050153135", "version": "1.1"}, "id": "1087034529081634", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6559828730715974", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7265457050153135"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1087034529081634"}]}, "change
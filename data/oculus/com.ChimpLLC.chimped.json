IoOQvpgeCOg&oe=69BD28A4"}, {"file_name": "horror_Custom..._24.03.2025_16-24-29.png", "id": "1199071058903658", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392192_1199071062236991_7549248574831439176_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reUhfXTCPkoQ7kNvwGubACE&_nc_oc=AdmjLLwVX7nreEiukdyFeisoht4jhTdmoFmc49Lel-1--rhaVdker1K7P3Eosyq8jXA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxQsBOUSMN51PP_bvgo1dX_I8pFIyyzbEqfgKWW9Y1uOQ&oe=69BD4EB0"}, {"file_name": "horror_Custom..._24.03.2025_16-23-48.png", "id": "652600324381826", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391921_652600327715159_1099213590302098983_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMRRwQvivYIQ7kNvwEL4iPX&_nc_oc=Admb3k1_fCZsJEM9aPpfuiOABb0JLgKFa8V8BKm4yRflFCReBFizulQRZmYA99VGnik&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxh0HpecbnroDlphAVAeyfBbiraXsJjPkfW9izk_o7WIg&oe=69BD4B4D"}, {"file_name": "horror_Custom..._24.03.2025_16-24-38.png", "id": "1013837843961559", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391860_1013837847294892_377692000312085620_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SfIA6Wy9HQQ7kNvwGh_c0p&_nc_oc=AdkTmuahbTdjgHoP-pYHDderXCSPC9qv83TVi811CkfBTttoB9YvyRBZhlUL-K8NNjo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfynVJGbJ-BAdaRdwAwiBiTdS57LTcWCzKI8z49UtZ9ryw&oe=69BD5320"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2025-01-11 190911.png", "id": "3065496726923956", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391990_3065496730257289_8257665964988251023_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdKtRva3h-wQ7kNvwGofdJz&_nc_oc=AdlwdylPQyD_e3W__fRVxvgohf3N-NCIKp2uVE7tXAjBJ7jMij9bHpSaKP6rxupwIpw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxQ2zTrYCgdpsdVtQ--QV0OtBhMrvQyUsd1LYzpl1kgjQ&oe=69BD507C"}, "display_name": "UnSeen", "keywords": ["Horror", "Fun", "Multiplayer"], "long_description": "Prepare for a spine-chilling journey in Five Nights at Chimp's, a VR horror game that thrusts you into a terrifying battle for survival. Set in a mysterious facility filled with animatronic chimps, you must use all your wits and cunning to stay alive through the night. Each night brings new challenges, as the animatronics become more aggressive and unpredictable. With immersive visuals, tense atmosphere, and heart-pounding gameplay, FNAC delivers a deeply unsettling VR experience. Can you endure five nights and uncover the dark secrets that lie within? Your survival depends on it.", "short_description": "Step into the eerie world of Five Nights at Chimp's, an immersive VR horror experience where you must survive the night against menacing animatronics. Navigate the dark and twisted environment, stay alert, and outwit the nightmarish creatures lurking in the shadows."}]}, "developer_name": "ChimpX", "developer_privacy_policy_url": "https://sites.google.com/view/unseen-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Tapor", "support_website_url": null, "website_url": "https://sites.google.com/view/unseen-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "8818627508243362"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473
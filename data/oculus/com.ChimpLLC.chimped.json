le courses, and other fun challenges. With realistic graphics, you'll feel like you're really in the game. So grab your friends and join the adventure in Chimp Chambers PvP!.", "short_description": "this is a unity made game with lots of fun modes like pvp, horror, freeze tag and more. this game has an amazing community."}]}, "developer_name": "T&M Studios", "developer_privacy_policy_url": "https://sites.google.com/view/chimp-chambers-pp/home", "developer_terms_of_service_url": null, "publisher_name": "Tapor", "support_website_url": null, "website_url": "https://sites.google.com/view/chimp-chambers-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "7764470403659083"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8863443383761774", "version": "4.0.8"}, "id": "1185962156010384", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7575405072565618", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8863443383761774"}, "release_status": "
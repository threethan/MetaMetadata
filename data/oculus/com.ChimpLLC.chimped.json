023_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ziJ6uX9gLgQ7kNvwE8ynvg&_nc_oc=Adp6s5h4pJIZsCIqmGxtqdyXNRPYNyrGhThFJcMBRU0Iqv09mnay3bmThAl07YfCmbs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw0Rs-MyG_WeYv9TTirGJG-j2HGrmw5cRerWqRsPrNmQ&oe=6B09C2BC"}, "display_name": "UnSeen", "keywords": ["Horror", "Fun", "Multiplayer"], "long_description": "Prepare for a spine-chilling journey in Five Nights at Chimp's, a VR horror game that thrusts you into a terrifying battle for survival. Set in a mysterious facility filled with animatronic chimps, you must use all your wits and cunning to stay alive through the night. Each night brings new challenges, as the animatronics become more aggressive and unpredictable. With immersive visuals, tense atmosphere, and heart-pounding gameplay, FNAC delivers a deeply unsettling VR experience. Can you endure five nights and uncover the dark secrets that lie within? Your survival depends on it.", "short_description": "Step into the eerie world of Five Nights at Chimp's, an immersive VR horror experience where you must survive the night against menacing animatronics. Navigate the dark and twisted environment, stay alert, and outwit the nightmarish creatures lurking in the shadows."}]}, "developer_name": "ChimpX", "developer_privacy_policy_url": "https://sites.google.com/view/unseen-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Tapor", "support_website_url": null, "website_url": "https://sites.google.com/view/unseen-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
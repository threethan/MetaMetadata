25921424766892_7151353209815335886_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSRFnjf2_3AQ7kNvwGOUsVw&_nc_oc=Adr4oea0tcIWqF07g6dlDHnyj6V-gyQ3bMi8RPjMT_tK6tStnfJdpodzdfut1WuzsjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTksstHA87PTjo9GdxmCOandUUKS8rOtZORqX0Z_a0R1g&oe=6B070618"}, "display_name": "Pieceful Moments", "keywords": ["Puzzle", "Jigsaw", "Cozy", "relaxing", "meditation"], "long_description": "\u2728 Pieceful Moments is a cozy VR jigsaw puzzle game that lets you escape into hand-crafted worlds\u2014one puzzle at a time. Each level transports you to a unique, atmospheric realm with its own vibe, soundscape, and skybox. With support for multiple aspect ratios, smooth performance even on puzzles with 400+, every moment feels magical. Designed with love for peace-seekers, puzzle lovers, and dreamers alike. \ud83e\udde9\ud83d\udcab", "short_description": "\u2728 Pieceful Moments is a cozy VR jigsaw puzzle game that lets you escape into hand-crafted worlds\u2014one puzzle at a time. Each level transports you to a unique, atmospheric realm with its own vibe, soundscape, and skybox. With support for multiple aspect ratios, smooth performance even on puzzles with 400+, every moment feels magical. Designed with love for peace-seekers, puzzle lovers, and dreamers alike. \ud83e\udde9\ud83d\udcab"}]}, "developer_name": "Youkii", "developer_privacy_policy_url": "https://www.livingmedia.ai/piecefulmoments-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LivingMedia", "support_website_url": null, "website_url": "https://livingmedia.ai/piecefulmoments-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_a
i9RMHrP1SwtkkyLDKLTUK6XaCWVSu0NJqpzK_o0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RLXmpvAwDI6G61B_9t-ZeTQqtp_Wk9yEdGjuL5IfGwg&oe=69E766D8"}, "display_name": "Pieceful Moments", "keywords": ["Puzzle", "Jigsaw", "Cozy", "relaxing", "meditation"], "long_description": "\u2728 Pieceful Moments is a cozy VR jigsaw puzzle game that lets you escape into hand-crafted worlds\u2014one puzzle at a time. Each level transports you to a unique, atmospheric realm with its own vibe, soundscape, and skybox. With support for multiple aspect ratios, smooth performance even on puzzles with 400+, every moment feels magical. Designed with love for peace-seekers, puzzle lovers, and dreamers alike. \ud83e\udde9\ud83d\udcab", "short_description": "\u2728 Pieceful Moments is a cozy VR jigsaw puzzle game that lets you escape into hand-crafted worlds\u2014one puzzle at a time. Each level transports you to a unique, atmospheric realm with its own vibe, soundscape, and skybox. With support for multiple aspect ratios, smooth performance even on puzzles with 400+, every moment feels magical. Designed with love for peace-seekers, puzzle lovers, and dreamers alike. \ud83e\udde9\ud83d\udcab"}]}, "developer_name": "Youkii", "developer_privacy_policy_url": "https://www.livingmedia.ai/piecefulmoments-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LivingMedia", "support_website_url": null, "website_url": "https://livingmedia.ai/piecefulmoments-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
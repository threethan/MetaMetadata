humbnail": {"file_name": "text-Landscape  Pieceful Moments final.png", "id": "1625921421433559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312255_1625921424766892_7151353209815335886_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_hJXV1XleEQ7kNvwHF5Gf9&_nc_oc=Adp-E4QQUu1JOzkDgMN4WHffVLGdI-7aC18zEV9YEykLF-kFbJI2O6IN4CCNWQ1jOFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdwRJpdKroWuzK-6zIhxAYbcr87Y2U5KE-F4FTa2OlAg&oe=6B09A918"}, "display_name": "Pieceful Moments", "keywords": ["Puzzle", "Jigsaw", "Cozy", "relaxing", "meditation"], "long_description": "\u2728 Pieceful Moments is a cozy VR jigsaw puzzle game that lets you escape into hand-crafted worlds\u2014one puzzle at a time. Each level transports you to a unique, atmospheric realm with its own vibe, soundscape, and skybox. With support for multiple aspect ratios, smooth performance even on puzzles with 400+, every moment feels magical. Designed with love for peace-seekers, puzzle lovers, and dreamers alike. \ud83e\udde9\ud83d\udcab", "short_description": "\u2728 Pieceful Moments is a cozy VR jigsaw puzzle game that lets you escape into hand-crafted worlds\u2014one puzzle at a time. Each level transports you to a unique, atmospheric realm with its own vibe, soundscape, and skybox. With support for multiple aspect ratios, smooth performance even on puzzles with 400+, every moment feels magical. Designed with love for peace-seekers, puzzle lovers, and dreamers alike. \ud83e\udde9\ud83d\udcab"}]}, "developer_name": "Youkii", "developer_privacy_policy_url": "https://www.livingmedia.ai/piecefulmoments-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LivingMedia", "support_website_url": null, "website_url": "https://livingmedia.ai/piecefulmoments-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics":
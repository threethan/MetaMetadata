png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1qF4TWQBjMQ7kNvwFBAyFK&_nc_oc=AdqMKD6XnZMBeSR9as6gNSyFlj0--lgujGEDvPTdQsB8AICdb4C7SIojgc6bH_94sMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZWOxqtDN8tilIPP63z32z5QWBkdy95O-OBku15Cs9hg&oe=6AE4B247"}, {"file_name": "Fast Hands (2560x1440).png", "id": "1523193252647025", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_1523193255980358_930744770077527062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOKyhJy28ogQ7kNvwFEKL2O&_nc_oc=Adq73ZKT_rlXP1FFLxE1sfO2DQwik8lta-kQhxYWwdGRDfusC6DpDNcvCDTGJhDpnH8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOVyolZ1lkA4DqtLmFxUQ6GP9zdg7sAzfl1cppv_Mxgg&oe=6AE4946F"}, {"file_name": "Career Mode v2 (2560x1440).png", "id": "1543687557183359", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_1543687560516692_6189288837633979348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBHxGc20iVUQ7kNvwHY1QAi&_nc_oc=AdpUA3bD050gw71pmK83j2D4uMVpr5InGML0MCA0UwKV36MQ6bZz5F07QNHuFQmH6oY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcEXaleB9aEUMAMdWHjUs0HZQl4__4CM4O7BU0vq1Kfg&oe=6AE4AF51"}, {"file_name": "coaches (2560x1440).png", "id": "1723654818789955", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_1723654822123288_1193560076643327772_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-WOlINUehgQ7kNvwE5nSvh&_nc_oc=Ado8mll7UFSx3cArUWRTCvn2RosR3Mdgh9ryWQ1Vk3ZAPHVW17B6FFHgkOciz_LBuFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpu8U3AOTGtKKF274vYX-cKMNtl7GrButjUh7FO8PaaQ&oe=6AE4B123"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1530292158586761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1530292161920094_205598817156897047_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1e0zCJB2rGYQ7kNvwG7MgNX&_nc_oc=AdpsEE2cHw7L9Ujk_SzsZnyB_T9WHdh10AS8KpXyBPUOfMCt78QVV7hv2o9q2rLZdNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3bC-4JIxcige55B55s6ztEcPoDBktlmc9PbTcmGYRlg&oe=6AE4AABE"}, "display_name": "Cleansheet Soccer 2", "keywords": ["football", "goalkeeper", "soccer", "goalie", "sport"], "long_description": "From the creators of CleanSheet Football, **CleanSheet Soccer 2** delivers the definitive goalkeeping experience on Meta Quest. Step between the posts with faster gameplay, advanced training systems, and authentic match situations designed to test your reactions, positioning, and composure under pressure.\n\n# MATCH PLAY\nFace realistic, motion-captured match situations inspired by professional football \u2014 from in-swinging corners and curling free kicks to dangerous 2-on-1 breakaways and high-pressure penalties. \n\n{1618858302542097}\n\n# DRILLS\nSharpen your reflexes, handling, and decision-making across a variety of high-intensity goalkeeper drills and training modes. Stop rapid-fire deflections in Matrix Reflex, improve hand speed in Fast Hands, and push your reactions to the limit with challenges designed to develop real goalkeeping skills.\n\n{2074085966509817}\n\n# JOIN A CLUB\nChoose your path and represent one of three clubs \u2014 Stanton United, Forgehill Rovers, or Waveport City \u2014 each with its own identity, stadium, and journey to the top. \n\n{1528564395460439}\n\n# BUILD YOUR CAREER\nRise through competitive challenges, unlock new goalkeeper gear and stadium upgrades, earn trophies, and build your reputation as you progress from promising prospect to world-class shot stopper.\n\n{1524702629312669}", "short_description": "From the creators of CleanSheet Football, CleanSheet 2 delivers the definitive goalkeeping experience on Meta Quest. Step between the posts with faster gameplay, advanced training systems, and authentic match situations designed to test your reactions, positioning, and composure under pressure."}]}, "developer_name": null, "developer_privacy_policy_url": "ht
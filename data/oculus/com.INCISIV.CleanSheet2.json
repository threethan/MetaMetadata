g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sU-HY9bgDJIQ7kNvwFi3Qlg&_nc_oc=AdrehO1AhV14YWy0inETSIFXdXEDBTaD8pnnShsmPUQgCn4QNVDaDfIFPvdowkris0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeX4cNI7bP59QZ7z8rjtU-OMqGYgi_7sJWrP8a-itKow&oe=6AE20F47"}, {"file_name": "Fast Hands (2560x1440).png", "id": "1523193252647025", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1523193255980358_930744770077527062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWuhLMRJbT4Q7kNvwG-bhi0&_nc_oc=AdpFxeLbdYydvYZy9pSs90Am1_w5tlyvvsPBRY9nYTBW03uRpCvXJMFesK1XjTAk8rk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7mKd4bVTWaQjfgNuowlIZ2Opbusg6fi2P07g3OlsmYg&oe=6AE1F16F"}, {"file_name": "Career Mode v2 (2560x1440).png", "id": "1543687557183359", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_1543687560516692_6189288837633979348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rm1-ohEyvhoQ7kNvwHF4Sea&_nc_oc=AdprXGT9oAh5TWGmZ1_J80BGgqQM_lNS2zuKiSIBA3DOtNsNFFnII-39bIsnlGwUX-M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPPy_NH1i4L2y2tj-F_aHdpDS2Pw8CLJo-7SrkhBLfdA&oe=6AE20C51"}, {"file_name": "coaches (2560x1440).png", "id": "1723654818789955", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824307_1723654822123288_1193560076643327772_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eali4rNtIXoQ7kNvwGCqYex&_nc_oc=AdpLw-80XuujZaWUQ0R2lh6TqerRjViTavgI2MHCCUHPN237xXuWReEiD6EQH9i_Og4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV7kq0DSYLLv4JpUQUFvlcimD8z__jPjnDyCLPA2TNPg&oe=6AE20E23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1530292158586761", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1530292161920094_205598817156897047_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1e0zCJB2rGYQ7kNvwFGnd0G&_nc_oc=AdpZCg-UcqoGbHQP3-QTEm6WNlx9Ns2AYZCV0Vf1qZEGKT7tcULRCYWKo-dJsTovH6I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_sJG6xOBnRgV8tcB-jhHtuVl6Pu_G5hi5vXaXePiKmw&oe=6AE207BE"}, "display_name": "Cleansheet Soccer 2", "keywords": ["football", "goalkeeper", "soccer", "goalie", "sport"], "long_description": "From the creators of CleanSheet Football, **CleanSheet Soccer 2** delivers the definitive goalkeeping experience on Meta Quest. Step between the posts with faster gameplay, advanced training systems, and authentic match situations designed to test your reactions, positioning, and composure under pressure.\n\n# MATCH PLAY\nFace realistic, motion-captured match situations inspired by professional football \u2014 from in-swinging corners and curling free kicks to dangerous 2-on-1 breakaways and high-pressure penalties. \n\n{1618858302542097}\n\n# DRILLS\nSharpen your reflexes, handling, and decision-making across a variety of high-intensity goalkeeper drills and training modes. Stop rapid-fire deflections in Matrix Reflex, improve hand speed in Fast Hands, and push your reactions to the limit with challenges designed to develop real goalkeeping skills.\n\n{2074085966509817}\n\n# JOIN A CLUB\nChoose your path and represent one of three clubs \u2014 Stanton United, Forgehill Rovers, or Waveport City \u2014 each with its own identity, stadium, and journey to the top. \n\n{1528564395460439}\n\n# BUILD YOUR CAREER\nRise through competitive challenges, unlock new goalkeeper gear and stadium upgrades, earn trophies, and build your reputation as you progress from promising prospect to world-class shot stopper.\n\n{1524702629312669}", "short_description": "From the creators of CleanSheet Football, CleanSheet 2 delivers the definitive goalkeeping experience on Meta Quest. Step between the posts with faster gameplay, advanced training systems, and authentic match situations designed to test your reactions, positioning, and composure under pressure."}]}, "developer_name": null, "developer_privacy_policy_url": "http
png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sU-HY9bgDJIQ7kNvwHiIIve&_nc_oc=AdoQ_-3d62zFngV7gD7hfsS28H5eCOzmRdpzJ4KkQ2SEdEd9UE6hZ5Eabf88RYFrgWE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNMUaor4JVC6NwODjbtwFSo-hmWb0lpq-B6Vqr143tVg&oe=6AE360C7"}, {"file_name": "Fast Hands (2560x1440).png", "id": "1523193252647025", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824322_1523193255980358_930744770077527062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWuhLMRJbT4Q7kNvwF-0Jqt&_nc_oc=Adpm3A4uywb2IVaflm8kJFthZwBczEVnUs6lJ-WqMlIR8wU25cXNjeWPM9zTMolB-ws&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOz6cm5qr_YvmeKJkZ1GDk7pK2qU8AH1lIVWjvbSZZ6Cg&oe=6AE342EF"}, {"file_name": "Career Mode v2 (2560x1440).png", "id": "1543687557183359", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823837_1543687560516692_6189288837633979348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rm1-ohEyvhoQ7kNvwH6g6VU&_nc_oc=AdrGDj_AZFHf6yqxQppVZj4vS8aSEd44OceQx76nqQh3C2q8Wkfzb4PbsBu75QxjAtg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONdOx6-E-LoQ4oktGmgjUFIojJ4CuBViPXjRuzvRP6FA&oe=6AE35DD1"}, {"file_name": "coaches (2560x1440).png", "id": "1723654818789955", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824307_1723654822123288_1193560076643327772_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-WOlINUehgQ7kNvwHgoRMm&_nc_oc=AdqemXQsueoC21dfz6LkgBjmQbIBH-rwzezhmxZrlpJ-6DvyuUYXOpY0GzNxTOILpcA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXrHsu76e-LK4s7xeIq9wLNaF-XWqdnMWKKzk8gLVoew&oe=6AE35FA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1530292158586761", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821704_1530292161920094_205598817156897047_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1e0zCJB2rGYQ7kNvwGmFsBe&_nc_oc=AdqdrSWCYaKZg7F9N8eJ5PpAjjh353DOpNn_LMXEjhwpsx9PWYwfL0xRSPnXcjh0Dug&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzKjnQrH-bTse9JdhtJruE_uoAzH4XUoJazSzSDIV23g&oe=6AE3593E"}, "display_name": "Cleansheet Soccer 2", "keywords": ["football", "goalkeeper", "soccer", "goalie", "sport"], "long_description": "From the creators of CleanSheet Football, **CleanSheet Soccer 2** delivers the definitive goalkeeping experience on Meta Quest. Step between the posts with faster gameplay, advanced training systems, and authentic match situations designed to test your reactions, positioning, and composure under pressure.\n\n# MATCH PLAY\nFace realistic, motion-captured match situations inspired by professional football \u2014 from in-swinging corners and curling free kicks to dangerous 2-on-1 breakaways and high-pressure penalties. \n\n{1618858302542097}\n\n# DRILLS\nSharpen your reflexes, handling, and decision-making across a variety of high-intensity goalkeeper drills and training modes. Stop rapid-fire deflections in Matrix Reflex, improve hand speed in Fast Hands, and push your reactions to the limit with challenges designed to develop real goalkeeping skills.\n\n{2074085966509817}\n\n# JOIN A CLUB\nChoose your path and represent one of three clubs \u2014 Stanton United, Forgehill Rovers, or Waveport City \u2014 each with its own identity, stadium, and journey to the top. \n\n{1528564395460439}\n\n# BUILD YOUR CAREER\nRise through competitive challenges, unlock new goalkeeper gear and stadium upgrades, earn trophies, and build your reputation as you progress from promising prospect to world-class shot stopper.\n\n{1524702629312669}", "short_description": "From the creators of CleanSheet Football, CleanSheet 2 delivers the definitive goalkeeping experience on Meta Quest. Step between the posts with faster gameplay, advanced training systems, and authentic match situations designed to test your reactions, positioning, and composure under pressure."}]}, "developer_name": null, "developer_privacy_policy_url": "ht
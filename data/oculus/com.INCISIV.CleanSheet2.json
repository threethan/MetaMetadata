aTemplateLandscape.png", "id": "1530292158586761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1530292161920094_205598817156897047_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GakZXv3ouxQQ7kNvwHm6Jf5&_nc_oc=AdoBML5QkEir8qgFueTQf_KSw8suXgauSwxIjrhtuTJhVR4UmTUU-Obiq1nWgQkFQco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVOUgxw24hpO16TP4oimBg7sJzO2p79cuhsFGfqdzUqKA&oe=6B10647E"}, "display_name": "Cleansheet Soccer 2", "keywords": ["football", "goalkeeper", "soccer", "goalie", "sport"], "long_description": "From the creators of CleanSheet Football, **CleanSheet Soccer 2** delivers the definitive goalkeeping experience on Meta Quest. Step between the posts with faster gameplay, advanced training systems, and authentic match situations designed to test your reactions, positioning, and composure under pressure.\n\n# MATCH PLAY\nFace realistic, motion-captured match situations inspired by professional football \u2014 from in-swinging corners and curling free kicks to dangerous 2-on-1 breakaways and high-pressure penalties. \n\n{1618858302542097}\n\n# DRILLS\nSharpen your reflexes, handling, and decision-making across a variety of high-intensity goalkeeper drills and training modes. Stop rapid-fire deflections in Matrix Reflex, improve hand speed in Fast Hands, and push your reactions to the limit with challenges designed to develop real goalkeeping skills.\n\n{2074085966509817}\n\n# JOIN A CLUB\nChoose your path and represent one of three clubs \u2014 Stanton United, Forgehill Rovers, or Waveport City \u2014 each with its own identity, stadium, and journey to the top. \n\n{1528564395460439}\n\n# BUILD YOUR CAREER\nRise through competitive challenges, unlock new goalkeeper gear and stadium upgrades, earn trophies, and build your reputation as you progress from promising prospect to world-class shot stopper.\n\n{1524702629312669}", "short_description": "From the creators of CleanSheet Football, CleanSheet 2 delivers the definitive goalkeeping experience on Meta Quest. Step between the posts with faster gameplay, advanced training systems, and authentic match situations designed to test your reactions, positioning, and composure under pressure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.incisiv.tech/privacy", "developer_terms_of_service_url": null, "publisher_name": "INCISIV", "support_website_url": null, "website_url": "https://www.incisiv.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1430734138822270"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "886849037442085"}, {"status": "PUBLISHED", "id": "1341294648030448"}]}, "baseline_offer": {"id": "886849037442085"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789635600, "status": "PUBLISHED", "id": "886849037442085"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1554305739798442", "version": "2026.2.0"}, "id": "3092117267649273", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1430734128822271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary"
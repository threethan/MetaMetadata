5343543962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unF6ITJyIr4Q7kNvwFtPsvi&_nc_oc=AdpjSRYHcVPUXFeWLnC5i3cQwy3dtzpLM28y_0my1W_6Gu3i32CQPklsMwkUzM0j8xw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMib3S2vxmk7bVGClhfHHX1WW0BkyXGN-vyyADcuCLcvA&oe=6AE367EC"}, {"file_name": "Screenshot4.png", "id": "666396052710162", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391883_666396059376828_2049053731412018874_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j49H-0oiMO0Q7kNvwHQEllH&_nc_oc=AdrE36Bmbc3eTzNx54kcgSt1GhG2gQw2thdUGVfiVQs7_-uI4AWBX04f1oRZGnEbNZE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND-qogUIyKuWU6u1uZObi63r2nbHmo605QQeDNmePgJQ&oe=6AE33CC8"}, {"file_name": "Screenshot5.png", "id": "544405848091717", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391934_544405851425050_1790934913481956976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnCKyLpMK8wQ7kNvwHqqThL&_nc_oc=AdqOAR9byPPyK_3x7RTYKExWoZ7gqtUSKv8EnJiUROpytQR1ChhLOjQ_DL5H_U2MFas&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhwizsEugbCdIrj4oYcRjfHHexOnBB5_H8a8lkmm2s1Q&oe=6AE341F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1271590903939116", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392000_1271590907272449_8747337094271220006_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIYnb2I8HzcQ7kNvwHqyOoI&_nc_oc=Adp-fmUhG73cVmOLTtH3WdKAaPiChTUtfSFR1tR3Gr1QTp4fvMfVKHdS0N-QRUe9spo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrac4XV8ITj-taHn9dMI7pPIF0l1NPbhB_esnMhe2s4Q&oe=6AE364B7"}, "display_name": "RDVR - Control your PC remotely", "keywords": ["RDP", "RemoteDesktop", "RemoteConnection"], "long_description": "**RDVR** (Remote Desktop Virtual Reality) RDP client for the Meta Horizon platform.\n\nControl your PC remotely with Touch Plus, Bluetooth keyboard and mouse.\n\nExperience Windows in VR like never before with RDVR, the dedicated Remote Desktop Virtual Reality (RDP) client for the Meta Horizon platform. Seamlessly stream and interact with your PC directly from your Meta Quest headset\u2014whether you\u2019re working remotely or simply enjoying a more immersive computing experience.\n\n# Key Features:\n\n- **Intuitive Multi-Input Support:** Use your Touch Plus controllers or advanced hand tracking for natural, touchscreen-like interactions in your Windows session.\n- **Flexible Navigation:** Enjoy complete mouse support via Bluetooth, and choose from an on-screen keyboard or connect your physical Bluetooth keyboard for effortless text input.\n- **Dynamic Session Management:** Resize your Windows session on the fly for the perfect view, ensuring optimal productivity and comfort.\n- **Integrated Audio & File Handling:** Redirect your headset\u2019s microphone to your PC and access your headset storage directly for streamlined file transfers.\n\nRDVR transforms your Meta Quest into a powerful, portable workstation\u2014combining cutting-edge VR technology with the familiar interface of your PC. Discover a new realm of remote desktop computing with RDVR.", "short_description": "Remote Desktop client for the Meta Horizon platform"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rdvr.pp.ua/privacy/", "developer_terms_of_service_url": null, "publisher_name": "mefazm", "support_website_url": null, "website_url": "https://rdvr.pp.ua/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ru", "es", "en_US", "en_GB", "cs", "da", "en", "de", "el", "fi", "fr", "it
5343543962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHR0RnGVa7sQ7kNvwFkxITd&_nc_oc=Adrln6gREEccoZzrcYO-_DNzJTfwD1UK4zPrYinCVvFNzJyG1vm-nS6T4ibk46ge53A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM12vZsGtYazaZ_LyarWxq_-65hVLRGYKa9CgZgAYaHJA&oe=6ACFA16C"}, {"file_name": "Screenshot4.png", "id": "666396052710162", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391883_666396059376828_2049053731412018874_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syJAMzgUfqgQ7kNvwFRtf6p&_nc_oc=AdqxU_jHoj1HifmbaLYOWaPKiJxNXGU8Vq4LZ0LHQcPfpt7S_sJHVMwJyFubgGkOPEk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWG7M9FeRRCnWB7QEMqhiiib7CFLcWxRiduTVLGlYDtA&oe=6ACFAE88"}, {"file_name": "Screenshot5.png", "id": "544405848091717", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391934_544405851425050_1790934913481956976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5-5uODPJFMQ7kNvwEMM7uI&_nc_oc=Adpd1l28ei0RhrPSLTaMWVkx7AZH8yEpG9jfj2KPtRCkddowM_KlqJWn8EIThlZVb6M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4YltRQZMc14SbLG1zk2jNAf2q3kJpP3pnLVkmyLfvPA&oe=6ACFB3B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1271590903939116", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392000_1271590907272449_8747337094271220006_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEsVO91M6QMQ7kNvwHDCRwp&_nc_oc=AdqDp1pDULPpFyPcApqUOw0jAYpSFTOArM97amfY9der2e4wLwGVSYyTwCAGrLQGT5U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9T36khj26WypVf-LKapvlj1LT-29AsW8fmQZ3ZVxwmA&oe=6ACF9E37"}, "display_name": "RDVR - Control your PC remotely", "keywords": ["RDP", "RemoteDesktop", "RemoteConnection"], "long_description": "**RDVR** (Remote Desktop Virtual Reality) RDP client for the Meta Horizon platform.\n\nControl your PC remotely with Touch Plus, Bluetooth keyboard and mouse.\n\nExperience Windows in VR like never before with RDVR, the dedicated Remote Desktop Virtual Reality (RDP) client for the Meta Horizon platform. Seamlessly stream and interact with your PC directly from your Meta Quest headset\u2014whether you\u2019re working remotely or simply enjoying a more immersive computing experience.\n\n# Key Features:\n\n- **Intuitive Multi-Input Support:** Use your Touch Plus controllers or advanced hand tracking for natural, touchscreen-like interactions in your Windows session.\n- **Flexible Navigation:** Enjoy complete mouse support via Bluetooth, and choose from an on-screen keyboard or connect your physical Bluetooth keyboard for effortless text input.\n- **Dynamic Session Management:** Resize your Windows session on the fly for the perfect view, ensuring optimal productivity and comfort.\n- **Integrated Audio & File Handling:** Redirect your headset\u2019s microphone to your PC and access your headset storage directly for streamlined file transfers.\n\nRDVR transforms your Meta Quest into a powerful, portable workstation\u2014combining cutting-edge VR technology with the familiar interface of your PC. Discover a new realm of remote desktop computing with RDVR.", "short_description": "Remote Desktop client for the Meta Horizon platform"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rdvr.pp.ua/privacy/", "developer_terms_of_service_url": null, "publisher_name": "mefazm", "support_website_url": null, "website_url": "https://rdvr.pp.ua/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ru", "es", "en_US", "en_GB", "cs", "da", "en", "de", "el", "fi", "fr", "it
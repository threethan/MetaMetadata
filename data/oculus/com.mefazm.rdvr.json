5343543962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4lLDy8H5DEQ7kNvwHvlRVs&_nc_oc=AdrG6oz7SUfSF7aZYrnQypPDC1RkKQrboI0Z0f9TyoVbaccP300G0fzLom_9MKGBIXI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZb3qcdsiJ4SBPXtCkMvtWvXd9vqlB1y6yTr-Pj2DuEQ&oe=6AD395EC"}, {"file_name": "Screenshot4.png", "id": "666396052710162", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391883_666396059376828_2049053731412018874_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IftioEwy9s0Q7kNvwGFNpJn&_nc_oc=Adp7rvJDZ5utGGElj_czjaP9XdoJFvNyC0_NFoZ1shH_Ub6ARE1tnX3HAFZeELaqAWA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2HN5SUiCdJfgdfJv5TGOH6bbMgkOyqVyskB4lC008sw&oe=6AD3A308"}, {"file_name": "Screenshot5.png", "id": "544405848091717", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391934_544405851425050_1790934913481956976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbbYod-FwX0Q7kNvwEIMRkY&_nc_oc=AdpvuOrrCwB7erGTzSWTQhS1KHxAN5TVa2KqM2Z0n8O_CXBAtghtKxhSiSaJ65kQjiY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBUX__-vBoi04OVRLAM01icqjKQMQCJFMZDOTc93XrMA&oe=6AD3A836"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1271590903939116", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392000_1271590907272449_8747337094271220006_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6EyA0sa9RcQ7kNvwHdEpAn&_nc_oc=AdrJfXqWSdqWlUv63EP00S99JSWpqJJGjhOIsGUUKAOAlUx6Cuk0e0mIqJoWN1B2tEQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKBbODonxPCcP_nozHTMiYU0pFx8xRsJXchAI7sxXt2A&oe=6AD392B7"}, "display_name": "RDVR - Control your PC remotely", "keywords": ["RDP", "RemoteDesktop", "RemoteConnection"], "long_description": "**RDVR** (Remote Desktop Virtual Reality) RDP client for the Meta Horizon platform.\n\nControl your PC remotely with Touch Plus, Bluetooth keyboard and mouse.\n\nExperience Windows in VR like never before with RDVR, the dedicated Remote Desktop Virtual Reality (RDP) client for the Meta Horizon platform. Seamlessly stream and interact with your PC directly from your Meta Quest headset\u2014whether you\u2019re working remotely or simply enjoying a more immersive computing experience.\n\n# Key Features:\n\n- **Intuitive Multi-Input Support:** Use your Touch Plus controllers or advanced hand tracking for natural, touchscreen-like interactions in your Windows session.\n- **Flexible Navigation:** Enjoy complete mouse support via Bluetooth, and choose from an on-screen keyboard or connect your physical Bluetooth keyboard for effortless text input.\n- **Dynamic Session Management:** Resize your Windows session on the fly for the perfect view, ensuring optimal productivity and comfort.\n- **Integrated Audio & File Handling:** Redirect your headset\u2019s microphone to your PC and access your headset storage directly for streamlined file transfers.\n\nRDVR transforms your Meta Quest into a powerful, portable workstation\u2014combining cutting-edge VR technology with the familiar interface of your PC. Discover a new realm of remote desktop computing with RDVR.", "short_description": "Remote Desktop client for the Meta Horizon platform"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rdvr.pp.ua/privacy/", "developer_terms_of_service_url": null, "publisher_name": "mefazm", "support_website_url": null, "website_url": "https://rdvr.pp.ua/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ru", "es", "en_US", "en_GB", "cs", "da", "en", "de", "el", "fi", "fr", "it
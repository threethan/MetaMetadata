5343543962_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4lLDy8H5DEQ7kNvwGSJgdk&_nc_oc=AdrlRRIyE_TfOvBfbtpJPVni1-SV_ayHtDwwt1irY3A0OxjZTyKd-6Qc3WeyTO6fYPo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJZZfyknFSXp9iNjptkOA1VXPCnQ9L9QIPqbaEYlrnJg&oe=6AD2446C"}, {"file_name": "Screenshot4.png", "id": "666396052710162", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_666396059376828_2049053731412018874_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syJAMzgUfqgQ7kNvwENaWkK&_nc_oc=AdoZnj6cKG2Zfy3G6V82kTC5CTPDM290SmUMVwmdQ3QmJAnC0k_kck6MhJqFEnW7kUo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdAznGRXcaneM6Ob3AA_HTAsgrMlC0MJS8BVbIgo-Qbg&oe=6AD25188"}, {"file_name": "Screenshot5.png", "id": "544405848091717", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391934_544405851425050_1790934913481956976_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbbYod-FwX0Q7kNvwFQzRD9&_nc_oc=AdrPQEby9J3vt9kaaC6Gdjm8FS9Ny9bTGLEEUbnyiKPV9PChXMuI_oqhGr-GIjHfce4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFNoUCgdIXw-7kiZ48SILv8OuXr5nEkBUXF2eevOuLUg&oe=6AD256B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1271590903939116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392000_1271590907272449_8747337094271220006_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6EyA0sa9RcQ7kNvwFp6lSU&_nc_oc=AdoW8AlrmnfeomMdfcWFwwyU1hY4yW4lrFtc70Lp4aFSAEBE0AefMxVHLyearhQ8CVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-PUok-2sfgcHlAu2vR8aTgRJjVbBTTusfoYUISfbHjQ&oe=6AD24137"}, "display_name": "RDVR - Control your PC remotely", "keywords": ["RDP", "RemoteDesktop", "RemoteConnection"], "long_description": "**RDVR** (Remote Desktop Virtual Reality) RDP client for the Meta Horizon platform.\n\nControl your PC remotely with Touch Plus, Bluetooth keyboard and mouse.\n\nExperience Windows in VR like never before with RDVR, the dedicated Remote Desktop Virtual Reality (RDP) client for the Meta Horizon platform. Seamlessly stream and interact with your PC directly from your Meta Quest headset\u2014whether you\u2019re working remotely or simply enjoying a more immersive computing experience.\n\n# Key Features:\n\n- **Intuitive Multi-Input Support:** Use your Touch Plus controllers or advanced hand tracking for natural, touchscreen-like interactions in your Windows session.\n- **Flexible Navigation:** Enjoy complete mouse support via Bluetooth, and choose from an on-screen keyboard or connect your physical Bluetooth keyboard for effortless text input.\n- **Dynamic Session Management:** Resize your Windows session on the fly for the perfect view, ensuring optimal productivity and comfort.\n- **Integrated Audio & File Handling:** Redirect your headset\u2019s microphone to your PC and access your headset storage directly for streamlined file transfers.\n\nRDVR transforms your Meta Quest into a powerful, portable workstation\u2014combining cutting-edge VR technology with the familiar interface of your PC. Discover a new realm of remote desktop computing with RDVR.", "short_description": "Remote Desktop client for the Meta Horizon platform"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rdvr.pp.ua/privacy/", "developer_terms_of_service_url": null, "publisher_name": "mefazm", "support_website_url": null, "website_url": "https://rdvr.pp.ua/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ru", "es", "en_US", "en_GB", "cs", "da", "en", "de", "el", "fi", "fr", "it
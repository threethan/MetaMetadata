ng", "id": "707910524910582", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392082_707910528243915_6432936576796666603_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-MIt-RP0IwQ7kNvwFoBZ_N&_nc_oc=Adr36c9b9ciTB4kQ5TAJEsAT9fcvaYw04anY2QQxZ8-O9oQmBYFhtrpaDsyJumzlc48&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20azzQy7F5IyEJbbv7DaEh72xC74Fx1xpHHRbvKlSlvQ&oe=69E77F79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_04.png", "id": "718621240735513", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393486_718621244068846_6459860000068773089_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mj69zA-oYjAQ7kNvwHN0aFz&_nc_oc=AdoOjeGaVOH9OyDnU1LU1zypct2KW2xURnmW1hsiNY4J4s7dnxmm_EoZlZ_RXranokg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WY-qbDmuk45Y2YF1lIQqFXSFLbqc5bn2bbnGy6YNg5A&oe=69E770F5"}, "display_name": "Nebulizer Administration Simulator", "keywords": ["CNA", "nurse", "nursing", "training", "simulator"], "long_description": "The Nebulizer Administration Simulator from XR Guru immerses medical assistants in a VR environment to practice administering nebulizer treatments using a face mask. Step-by-step guidance and interactive features ensure users learn proper techniques, prioritize patient safety, and build confidence in real-world respiratory care scenarios. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.   \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning. \n \n # Key Features:  \n - Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners.  \n - AI Companion: An interactive assistant that responds to user queries and provides clarifications to meet learning needs. (NOTE: Generative AI is still experimental) \n\n# Learning Objectives: \n- Understand the procedure for assembling and using a nebulizer. \n- Apply correct techniques to administer respiratory treatments. \n- Communicate effectively with patients to ensure cooperation and comfort. \n- Demonstrate proficiency in maintaining hygiene and cleaning equipment. \n\nThis VR training ensures medical assistants are well-prepared to perform nebulizer treatments confidently and competently. ", "short_description": "Master nebulizer administration using a face mask in a virtual hospital setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9370849536358831"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "9626906957435522"}, {"status": "PUBLISHED", "id": "756703873347630"}]}, "baseline_offer": {"id": "9626906957435522"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749743940, "status": "PUBLISHED", "id": "9626906957435522"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "10039778622799249", "version": "1.0"
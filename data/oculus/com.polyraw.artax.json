y4AbUs0uL2I9yA&oe=69AAD904"}, {"file_name": "migrated_image.png", "id": "1553874538123909", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031324_452904628662926_8498733418190733312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCpMPU6ti5EQ7kNvwESSPiV&_nc_oc=AdlnUtutsNtrMdYqxNK0kkn0ETXf9YSEe7cnZdFwObM3EjUxCx-ATKGw6N1mq7iiHis&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzYiS04hRJxIO20SSsxYpBEIPb-VhVfI5eo7mK2LMqZ-g&oe=69AAE329"}, {"file_name": "migrated_image.png", "id": "648291299078857", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001723_446967872873280_8590773888739180544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYoCDkn-slUQ7kNvwExZGb5&_nc_oc=AdnEjJYm7cy9D6tlpyZnThbNdhlLRWdWOTDvGD39HcBwjtTPW0hqM2sIoctd72iidYg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxzwBpYMY_hrNqvPwde_Fs0cOnvPlqid1YrqoifHQzGvQ&oe=69AAC21E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/QVA8Vd", "id": "684981518698427", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974692_684981522031760_6464060358985252864_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOU8el5mO6wQ7kNvwEvXpK8&_nc_oc=Adm_mXpPjPIWggWGMkwVQ3UJ94hV-p391QzMJdp21xrijZNt7kC5ueySAUwkBmGATqw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfyiCuRbsUkTId8FDmNf5KMo7m1-Npj2FE-C-DIIXwKXoQ&oe=69AAD0C1"}, "display_name": "Artax", "keywords": ["magic", "fantasy", "rpg", "adventure", "toy"], "long_description": "Artax is a toy knight, you will have to guide him in a dreamlike fantasy world in search of Bulf, another warrior toy, who wanted to get out of his box to take his kingdom. Help him to face pitfalls and enemies in a strange, magical world. You are like a chessmaster playing chess, with your VR device you have the perpective from the top, like in a chess play, all your characters will follow your moves and the game respond with his moves.. but you are not locked into a chessboard, the characters will go around the castle, and there will be traps and enemy ready to attack you! So choose your right move to keep exploring the scenario and reach the end of the journey.", "short_description": "Artax is a toy knight, you will have to guide him in a dreamlike fantasy world in search of Bulf, another warrior toy, who wanted to get out of his box to take his kingdom. Help him to face pitfalls and enemies in a strange, magical world."}]}, "developer_name": "Polyraw Development", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "website_url": "http://polyrawdevelopment.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4398464386921328"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "2544077925781822"}, {"status": "PUBLISHED", "id": "795654770912857"}]}, "baseline_offer": {"id": "795654770912857"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "2544077925781822"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2884218818305854", "version": "1.6"}, "id": "1230489827154288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typ
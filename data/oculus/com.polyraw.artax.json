/scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031324_452904628662926_8498733418190733312_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lNIbYv3fs8Q7kNvwGa4wNy&_nc_oc=AdlrgeXDAZsvD0OuK3vpVutMJOCxG_X1v3wUkw6HnAK8j4l6Me0mB3MFseqi9-DAdPs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuWBHodWXsFFOJJJoOmNeZdshDKg7Gz4isBobgc_T5BCg&oe=69A1A8A9"}, {"file_name": "migrated_image.png", "id": "648291299078857", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001723_446967872873280_8590773888739180544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWZTLuMj-rsQ7kNvwExIdmT&_nc_oc=Adl46uwR4pHcue46yugUKP0PcSsPqAklCNSClQEqf-ZRZSlKdvfWZBHX0mcLaLzHJKI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftFlyFP0rUOndpdrTBr_9R0t8lOommZA-s4OrrZ6tfM0A&oe=69A1879E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/QVA8Vd", "id": "684981518698427", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974692_684981522031760_6464060358985252864_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pm8W4GgrycUQ7kNvwH0PKHx&_nc_oc=AdkcLcyO3sIpXzgVM-sHZvo8XymURYpi4etDLz1iUxkYGdDyHc9CJTbomSftbR2QEgI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfviFDvcaImcCBD7QKS0rvaD98XlNr67szeMpdcCAafpNw&oe=69A19641"}, "display_name": "Artax", "keywords": ["magic", "fantasy", "rpg", "adventure", "toy"], "long_description": "Artax is a toy knight, you will have to guide him in a dreamlike fantasy world in search of Bulf, another warrior toy, who wanted to get out of his box to take his kingdom. Help him to face pitfalls and enemies in a strange, magical world. You are like a chessmaster playing chess, with your VR device you have the perpective from the top, like in a chess play, all your characters will follow your moves and the game respond with his moves.. but you are not locked into a chessboard, the characters will go around the castle, and there will be traps and enemy ready to attack you! So choose your right move to keep exploring the scenario and reach the end of the journey.", "short_description": "Artax is a toy knight, you will have to guide him in a dreamlike fantasy world in search of Bulf, another warrior toy, who wanted to get out of his box to take his kingdom. Help him to face pitfalls and enemies in a strange, magical world."}]}, "developer_name": "Polyraw Development", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Polyraw Development", "support_website_url": null, "website_url": "http://polyrawdevelopment.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RPG", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4398464386921328"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "2544077925781822"}, {"status": "PUBLISHED", "id": "795654770912857"}]}, "baseline_offer": {"id": "795654770912857"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "2544077925781822"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2884218818305854", "version": "1.6"}, "id": "1230489827154288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2761567630570974", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": 
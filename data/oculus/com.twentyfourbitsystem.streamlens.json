d3QeE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw6YBk2us99j-7qRCIlXqyoAOxVEq2GEEi18s6inEXSg&oe=6AFF28AA"}, {"file_name": "screenshot-4-settings.png", "id": "1629771962179606", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619602_1629771965512939_7224635323082453409_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHl3kL3rL90Q7kNvwFdEDUl&_nc_oc=Adrd0OompGkE6jiFOOy_OuITTUT8XDmJnKE-FfMHKTvLRogybdad21rKVK95e6XVO9A&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsaCIwNIO8RkvCnxtjpbD7Pvs9Lo4uoelTvbdEcHwWeQ&oe=6AFF224F"}, {"file_name": "screenshot-5-alert.png", "id": "2426634034809669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623585_2426634038143002_2300879333251713012_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAdfI-dh4cEQ7kNvwGKlNXi&_nc_oc=AdpIA-HlBV0WccwPc5UmY3wsFePCpsooA1VtLUl963R0maD9menIvoUX0ucUblwZWTY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj1SB3yu6lHtDOCNCW9FPRU_J-k4oCdSYEG7MYm6ZWrw&oe=6AFF07FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "StreamLens HUD \u2014 VR Streamer Chat Alerts", "keywords": ["Streaming", "twitch", "chat", "streamer"], "long_description": "StreamLens VR is the premier spatial streamer heads-up display engineered for Meta Horizon OS creators. Monitor your live chat, celebrate subs and donations, trigger stream sound effects, and engage with your community\u2014without ever leaving your immersive VR games or creative worlds.\n\nEngineered by 24Bit System with zero-latency client-side architecture and zero hardware requirements.\n\nKey Features:\n\u2022 Spatial Multi-Window HUD: Floating glassmorphic VisionOS/Horizon OS window with quick grab-bars and multi-theme glass (Studio, Cyber, Stealth, OLED).\n\u2022 Real-Time Twitch IRC Integration: Seamlessly connects to any live Twitch channel with automatic keep-alive and reconnection.\n\u2022 Native Text-to-Speech (TTS): Local Web Speech voice synthesis reads incoming chat messages hands-free while gaming.\n\u2022 Web Audio Soundboard: Synthesized chimes and audio effects for instant viewer interaction.\n\u2022 Interactive Alert System: Visual confetti celebrations for Cheers, Bits, Raids, Subscriptions, and Follows.\n\u2022 Offline Event Simulator: Test and rehearse your streams offline anytime with realistic simulated chat crowds.\n\u2022 Privacy-First Architecture: 100% client-side. No user accounts required, no chat logging, zero telemetry.\n{1092459790228587}", "short_description": "Spatial floating chat HUD & soundboard for live streamers on Meta Quest. Twitch IRC & TTS alerts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://streamlens.24bitsystem.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "24Bit System", "support_website_url": null, "website_url": "https://www.24bitsystem.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1415713151622810"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_2809900722800337_7830873774345176186_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O440FfTwYwoQ7kNvwGqIVdk&_nc_oc=AdpsVEdhlcqlJ_s-IYyweLYYqZU-IS6bPsw1r17ox-TsWA9D2TD
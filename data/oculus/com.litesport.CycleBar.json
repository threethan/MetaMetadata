E", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShyHhaTo5ZMQ7kNvwEcww-o&_nc_oc=AdqJQDpoxvfu4AvabYT0YoXlR-MJIk_uVY3G6uu-RYjLQB_ndr61NYBAI7KXl43j6zg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlfxW3eZQ26o1EuyG73t2oBLwmT9BbGnW3H7_x2Elngg&oe=69D117E3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnCWVpDJouYQ7kNvwFNNwIO&_nc_oc=AdroxFq84q5iWTLY_I25xj1hzePwnzkhAJx0vliDQqVv5kl0pMBUG6Y6buyfKFh50A8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymTEodCAG3kJ0MnNW3dWzTG7ZmsE0xVyjwnIGLhCFfFA&oe=69D106C9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gB9kt8jKeEsQ7kNvwFrcbqX&_nc_oc=AdoJ2TAny0cNGn4lKdLBUbxMOoEjendyU5Z0DaC5kn8Uf42hmtqyCzi4iMYWNgDNafw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZWCLAVYQ3ejuyH3EEAVDhD2YlFMOzi4wT8vJMR8Bkvw&oe=69D1073B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPH7xT0vOH4Q7kNvwHWHDkw&_nc_oc=AdpOQLKUVT41_bpQ2iOCF18P4GBKiIFyLKA36df_8K77YhMZrK-_Z1L8eD-81srV6sk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfUIFTJEFqnEV_XBDzKu6H9arrBKynzJrAQ29Qw4j-cQ&oe=69D12357"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gzFgLrfe7oQ7kNvwGMzrWv&_nc_oc=AdqOIFxCkGCI1G_-zOm7T3LSQvEEVXe65Qn_w6AiUOObyGbRVJia7-sxm8XCwkm7DoA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXw59RSUnAlYv1CWFeT6XozmM40mf2n0X5yaH6z7q99g&oe=69D0F98D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIEMeUM6blMQ7kNvwGVn0-Q&_nc_oc=AdoekVPd0oj7NIs5XmQ-xZAoqQSYCzYjOGnI9zD5-VdvvDkNE7xRKeB8v0-wn1UKB6U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydqyzQMZO581TyLcz3FyLJSPeJsxg5r5MKUCEaxhYdqw&oe=69D1039C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2H5CR5eJ54Q7kNvwGH30dh&_nc_oc=Ado8_qaE9ghIHxibPTcCNsgo38MgpNm-NqQedID5mYSLczNLCyRCVYIAb407a8YHbvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyudAU0z72DyY3mz2A3hL4UDeh5DLwI5re-tYPIgGFfWA&oe=69D11903"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
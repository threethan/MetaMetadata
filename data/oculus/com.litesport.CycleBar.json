E", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUPJV6vT-QgQ7kNvwG4MjVF&_nc_oc=AdqycBqlD9CeGmhi_DjqidnTAA8aMWq8-MRUlZ96c2hzUb9fSZLPt2zuMKCaqnm0t1c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ds4wrOGN7dZS1nERd7BaFqWGcRsdYqvdKbMrsUDyfWA&oe=69E8D2E3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjeYaVYGdYQQ7kNvwE_2nK4&_nc_oc=AdrgP1P2sFM6JCDSo567qw0T5vvarY-gSDvY3lIFk4zmGqJKsqK3vbII6o3ADM_1QZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0y821XQQvMmGGhuBOdGajrNKYoOCn6D16PQV9IWpke5A&oe=69E8C1C9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWTl1eOciuIQ7kNvwG63QOZ&_nc_oc=Adp_FFDGRMLIytSPoTEC-whg_ZmP9rfGrOhwyKoHgFKZXD1AWYx48pimPjOsUqNxdfc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mgF0197P0RMOZ7orsVLyajZb4Hteu9n_xNnDRzsfATw&oe=69E8C23B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ot57b8jjH0gQ7kNvwFR-iMM&_nc_oc=AdrklfUcwNqSnk0uxuVQ3jjZfoSZVC8FGtu9rwHLa7xkpDJL5bwMxW2Xq3GATtjxK3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jK5otArcBv5MZoJssyYFlmCcrYbmjM3GsEtUzf6jHRw&oe=69E8DE57"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aqsLE5tHrsQ7kNvwHE2Ik5&_nc_oc=Adrkkm1PNhp0I_Q1LlUuRwAjZfkQD5GZ0lLckAa86ZE55fTDUsGwgRc9eiRlo0TXsDI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0M1eHymZQOlY5f-2D4eZF7uzATe78MCpf7yu7Ij_TGSQ&oe=69E8B48D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtn_xwjpO74Q7kNvwHtHgwh&_nc_oc=AdpsOHYcEBh6wNOSc7vM-jUZLEKxNVSkHCdoWzno_zs6LQTJY3hp_EK32qOtsOvaR6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UzpGGHhWLVOJJPvI7GlwSdeIVWZrF2JZPyA-dZhSAaw&oe=69E8BE9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcYSTCLyCioQ7kNvwHunsfv&_nc_oc=AdqHeRnGax80oWhZvKLvd8NSrFpp_sdKAxopCJ2zfmLP1uAGGwN2cgOHvUp_f3zFgvU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q4GaEK_uzKDSQwl-o4RN0QQ_esoyuKC2ULG3v2LIxxg&oe=69E8D403"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
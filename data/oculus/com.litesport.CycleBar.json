E", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_oMlptT-1AQ7kNvwHNIHB_&_nc_oc=AdoBJkUW78mAV9b-yceIjR8ESQwzxV4r1O5NGgaY9Fcoa0oBE5Bl69EHYTlLBZh45KI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rpjy2ZRwQnf-kozB7-B-2tU5-qk4U98UszaSX-pOY1w&oe=6A451BE3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7X8w-UbdsyAQ7kNvwHPfOsA&_nc_oc=Ado3mmCUhzUb8cXf80uMNzE_gD5GfioCf22idAjYOnHYGOGP5lry7oeVbnXOPpIpVyg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jck3QC5Sn2N5ZOXYNbPK2lvlL0NdwqMdvrtJ7FQeGwQ&oe=6A450AC9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlsX3WcQ2eIQ7kNvwGb7HSl&_nc_oc=AdrHYP6nfCIbAd55uOsx_YW1L1tUtPWO78SiHkfEhgzwHdhrjHyuNvOY5fCOqTHcPhE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WQRdNU8vFOvXDF7uRwHdeCg-u1_-sNrKpiCuuJBwGKQ&oe=6A450B3B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PA54xMcBF1AQ7kNvwFb0ffO&_nc_oc=AdpeeIhQtoT2VlUzE62s4jpVgh730SwQM3H4GK22lJZ4ArjiFcnASdEaJ3rEG-T_MHk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AkSyU7Vsea0zzpkiAt4ukSkHt7TtMlkeKH-szOV1kLA&oe=6A452757"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PLXMcrlZPoQ7kNvwH9CA00&_nc_oc=AdrTmFMK3pBbFsrwYtqt_3sjjStcmT1_rQsd9uSMrlSwegC7AFyaz6LGjdSU75-wg1I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lsTuaugDppiSLMPnUvHgKWP9-n6S26GYjA1phNanKeQ&oe=6A4535CD"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yDTmsbW-JsQ7kNvwFmLzqK&_nc_oc=AdoS8dZ0bchcSZyVYtb6dol929Ewpx8Q4DovAV3kktqtU_npmZ4sOHydSMs2UNmyAv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3PULKKy3VKo4s_ceaT2Ah3ups5VvY4ozJzPr5s7KDbA&oe=6A45079C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-91CtOPPVAQ7kNvwEMFP82&_nc_oc=AdqkBMEr4Ab8sp0q83L23AdYSkm2x2vd5B5QhroRw4mNPERhwRFK6I7gDguk4CixY-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kQEKw61hz5ll7JgYi-FRq25JCzRZ39unQXtrgkg9GkQ&oe=6A451D03"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
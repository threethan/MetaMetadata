E", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doBIir3D-4IQ7kNvwE3EkCw&_nc_oc=AdqkYF9UNUZUI6x6WBT96-AwhkgyD-AHxb2vU8P33UEWRzkGqE0hYXfr7AsHpzvrrXo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeRrZhGNiiJcqMBi5tyFXHUZb0dPc78Nn5Q3iPHdEp8Q&oe=6AEC8A63"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x06m52qG3ysQ7kNvwEtmI79&_nc_oc=Ado4VZeUhkWSaYqIo28iqJNJ-4C81-nJIEU6JGe41hO4-cgSL4CA3DT8N_kfw7EoTYk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRChiqjvuqe14Aw_PuWIv5KmkDxZOe0mhkW7YjmxjNxPg&oe=6AECB189"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GA7n7cLuckQ7kNvwFxSNiu&_nc_oc=Adrr6R44rvfaah8_MibO9jQ_aO3G9oxTyrchAa5CrFJ9caBPLUEz7mhztbmrNEgl2p8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiJ84xhe2qUlG_qTpushhqVAJ-crri1gYdcEt2kMzn8g&oe=6AECB1FB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfjmI-55qo4Q7kNvwGEE76c&_nc_oc=AdrGLLuDddC7SkoqqcyOSj2SQ0TzlwFk8OVAutpH-LDyiHDmSBTaIm1TKooaw7rJ-Uw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQa3OR4yeBSQl209z7T9CUE37O348e9lQXV69zNOXwKA&oe=6AEC95D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6ugqg5OMp0Q7kNvwGd6VOS&_nc_oc=AdpJOggjNMVw-VY0mzFS4keT5aeMB_1u3riw4nnK8_FdG-mBJzVf3ligXxrA4OQkb4U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGzXbzPDYwAOEXaYUf-lQu8hs-ueO3BnYYlZCFC8Sa6Q&oe=6AECA44D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdelTnFyYscQ7kNvwHU5Ssk&_nc_oc=AdoFYReBDpYkW4tDlHKOkTZjCeCrFpdfDk99No0v5ZqvTyuM6cu4_N4GTTt6b18XcLc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2iSqcL1RxUxFWpFtxO3LJue6MdIBPB70h9V1kki0IyA&oe=6AECAE5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zkkeD8ZnBAQ7kNvwGVqKhO&_nc_oc=AdrIhBsdgcwGacoOK1t58BTJAQwrAojSwtYqig0KgRV6Y2D9fl5G9FPdJ80UjKCcvGA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSpFvl6ahwC772ZTG9Muhd_PVVWaOLm6oy1s1A0TjVwQ&oe=6AEC8B83"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
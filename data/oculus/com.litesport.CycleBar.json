E", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuMnYAlEYHcQ7kNvwEIeO8a&_nc_oc=Adq-iuQWXPjUX8V3LNhIxFSmSFWfFk9NcPsj_PR0-mNMJIxk5iYCrdQQHlOXwjQhNJI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42WBRw8B0VAIEZ7KYNRLyi_ckv4KF9tv28deRzrQ--CA&oe=6A15A5E3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BX7mzWNmYB0Q7kNvwFfyMPZ&_nc_oc=Adp7PAU87xgoLjlCsKifkac8QltfTlknE_PrWvaggj_u2iBYUUQSg-aEvu7aWLfFl7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pZIVrIaHHwx6THhAL3HrAww6bGx1zH3tv4B5U-icx2w&oe=6A1594C9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tU5wXdsQVvMQ7kNvwFVLqvT&_nc_oc=AdoEFw_9z89Lejf60uLkHlhfA67EatYsU-ws0GmE7v9NddbrF5JBlyOWUdJyhnnrTm8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qMeEk1O9pXsoL23R1qyf8N8S0vonZf0LWCpFCxxnhWw&oe=6A15953B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK5zW3hxeVoQ7kNvwEzTx1-&_nc_oc=AdrDM2I14FhsWEd5-WLJQ52fP6B9idtD-Gu4ldEUsrPuTmMEKyCrcLiZr8xIlD0SZg8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41l-4dUV2HciyftK0iA8qErfz1B2pL6wh6zVfbJXpaHw&oe=6A15B157"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYz2nrHt9xUQ7kNvwHf_Ccg&_nc_oc=Adp1QRcrMNDKHYPJ9NZ8UVKFglwXcXmbj7w_lpTkrJ_WLhf7GUPMim_6zuoES7tAUwk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-1iCK0btLr6TYaQ75doRub5WPWEYiE307qfgur5cgZw&oe=6A15BFCD"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLoTQOiDs24Q7kNvwE_gC3B&_nc_oc=AdpJfiiD6M-AWC31eZgLjP2ZwRNVPm7CmvgOqst62SLaRXzloB3nmjibpvxPA0J0weA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46hHzviVqORCjockajh2iMiiJPyZYCqm6zK3gHPdRljA&oe=6A15919C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7E8UyVMHvAQ7kNvwHHlVHE&_nc_oc=AdpIvaKatokdCvvUA0zF2fB1gdkgVGNDJthjWHu_pVaGKGGAkTXosG_FPgfQOT9q824&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UaSddG85zN1o2hN2aGjG2dooiJye_lFLZUcAquaSKFw&oe=6A15A703"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
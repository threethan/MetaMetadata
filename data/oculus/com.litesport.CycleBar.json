E", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk69D-A6--EQ7kNvwEhZcyB&_nc_oc=AdocJcNrDuumxErg23hsRMyT6NzUTParXgCgsXX-OtvsK72T1Vd9A_L1JByP2ZomYXc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GIZFrPDbJYZTDRzMOkQ8Qsz7kuHde7cQ3epSE8y320A&oe=69EF6A63"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UCJsMKNs70Q7kNvwHu-k33&_nc_oc=Adrk9bn2jndtQRDynrXKsy6QNjeL__a-6sIjxktuOdL8s9BP7T7qHhhPPxcEijk8P1k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3EGW9K_Dky4F2llZg2Y1bA73LfsdWLT-xDPudCByE5qQ&oe=69EF5949"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkiNmaURneUQ7kNvwG3sl_B&_nc_oc=AdroWcdQ1piBfDO5UlLA4hi6ad9jxqHTi99uGw-mzY_R7rFJgQPA-PV6DLGSlzT2xQg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04xu8hOOga5JGsNsw-KU3PEAwQHZpqpvd8yLuuHjmRCQ&oe=69EF59BB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BR13qV3WA_4Q7kNvwG-zv99&_nc_oc=AdrKtW0f_GN65JFq5r4XmefEvhgR4U1Zqhq58QCn50IKpgQtQoDtP0HU72-kBo7b8RE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2CwGGgQnBM6SX4l7aJT-jul9C7gYDRSGoOKqe1mhbChQ&oe=69EF75D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08KGIkvJQ3sQ7kNvwG1p-xF&_nc_oc=AdoTlCLQAZ_ySajQOOA3n4eSYPkUAnZdzJQiciHglO3w4W0crofC-jOyN5avD6MNuck&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af16Q5vR0K05ITAqAdcd9Yu9GYM9Fr5uHuI8sIMJ3haw6g&oe=69EF844D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxtM9m7vytcQ7kNvwEg6Z63&_nc_oc=Adqi9eiZE4xT-LM4Ec_TJFKUXExKaZrLBUinZd7PtE7bjgH9e1zsWN1gOPrFotQKRuA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08616nhHTqDDYb9NvO-T3y2bZu6X97bfhf4t-59OIXsw&oe=69EF561C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRWbcZWn0NgQ7kNvwEmau5-&_nc_oc=AdqwSBnsMLo4p4ypTB00eVWS9nA863PdRKbnBEqW5vwk2JkkCMBWaNdEM--II01098E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3n6xj4Rsmamsl78Y8L8OxqYobjzf0X5tMNmwmRFF7GxA&oe=69EF6B83"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
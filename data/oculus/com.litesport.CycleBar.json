E", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CdF65WdDDIQ7kNvwGYTCt8&_nc_oc=Adqz_z9W31BPSfzm9KeAuXAEG_I7N5qzxdkkduSLsQXYVUQoMu2K55WtIy1nwS4tKE4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFpsjoghbEXRxhnWzZTB41Q4hRs-iNzE-slz6MbeOcXQ&oe=6AF07EE3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXMmdGV2hk0Q7kNvwHMaLCO&_nc_oc=AdoO8mncEIUv1buK4VkysOwk8UnaxIGMm-PZW2pNjhma-mNvnTsfjhaVHnDDiAw2x40&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5XECO0J6uxaf8oerCIT8Z3p0qa7QQyQx2lDN7NDBwgA&oe=6AF0A609"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAGQC-itpHcQ7kNvwE4DW6j&_nc_oc=AdqZQFXgzALOXmETBpKXqtUeUmNYu__DNQV0j2zFPm-Yj8hUbWundHpGhYCu7tFQSls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUgtP92qjO7BTPUj9q7uaj_EHUEFvbyBMCTezUG94Kwg&oe=6AF0A67B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZolklrmOXqsQ7kNvwFDQKc4&_nc_oc=AdqEgf6rUv5Cj0rzqoxlALI5nszd18HxMpC0RC0exvZSld4GInFUfvSM6Ldk0n5TJWw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAz5bK880mfOtAbqZdQOR4QbjgYNmrNYKNTxv4o38d5g&oe=6AF08A57"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiCf5qXN82oQ7kNvwFMjep_&_nc_oc=AdqWYUhQ_l1rHyiSOfXWCrIONmy7Id2EfBpG3htofLQZN7g5LSxk_BQli8BULxKSvv4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMHysWQAlnBblelsa5J7N8VFA4dCSuZf5TRWWLKEWMDQ&oe=6AF098CD"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEtim43WWOoQ7kNvwGs3yEl&_nc_oc=AdrbVGqqDot-AiXTvS3frQw9h4hZRWrOg-rYhM5YuOOmu9VT1vSS_kZuSWIsqudzaW0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6CaW21FU5D7gPlfz_-HJdWcZa1my1DScrArtvW8WS7w&oe=6AF0A2DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx6awmd3tOwQ7kNvwHfVJvw&_nc_oc=Adoo7A28YErQ5Ml388hSObPQHReh0O0kEWP3Z_MrUJ37MI2mRFfDNSnmLLGvZvJ95YM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-lgd_Hb8agWq3n84-QQ6oB8RWHQsWnRwIBce_oVH8hg&oe=6AF08003"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
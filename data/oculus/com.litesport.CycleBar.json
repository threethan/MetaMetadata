E", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JN3P35qwj7IQ7kNvwH9YHyY&_nc_oc=AdqZRbqpNT8YGO3Vj6M0M_zxnvpL-J-FQ4rWMzNjp_dDOog5nBiJSKYo6rs8pLqHoVg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZa_MLrlPdJfA8ZY64ZpcC2zi-CRkHN0OHMsFyapMIpg&oe=6A58E263"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0D3wZTSLKCcQ7kNvwHVE9sA&_nc_oc=AdqgzZYbpoCJnxnyhoFZjPAWODqMq3UYrE6hzNjRiSd-8rilhVlwSv7vUIh-t1wWS7w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6XLS0aeOsd4UG6BE-vVALvTiEPiiEUQmNCMa_lyACRg&oe=6A58D149"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JBYI0-w1WYQ7kNvwFPwC4x&_nc_oc=Adp0YNJUkEXPNw_NdpEhoGL-3Gg8JbblZ1cWpzd0btWCHfaOAsr1exc32K3aIQekwx4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5qrK3V9uPBFnhZotNKsxjs4wGe1fuFUkToWpY6C675w&oe=6A58D1BB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqWt69xVsjQQ7kNvwGanuGX&_nc_oc=AdrrDr7xrxdhVYQj4X1byLw3cGTLxto4lFCjREQnAZ8rb0rdgywa1hqhKJ0lvdpWG-U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOVqv2VW0ZogerSEsXuSz7qvRqujtQZBAF6BdqObBO_Q&oe=6A58EDD7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOnCk_k6jc8Q7kNvwH0kHFL&_nc_oc=AdpC19XZZ5Tnn9yotsI8nwzBo65tAzMB3YO5XeRd223OjbmLJ-iSKeTKAidK6ls8q3w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCubLiqIxmw5hId9E3PDfXBVv0zcyLcX0NM3pM_SWpDOA&oe=6A58C40D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WowhGlukXFsQ7kNvwH4XjQk&_nc_oc=Adrqy0z7m9nZvnWS8puqHrxlL2o620IVtaK_oTny9HyLY_8iIoANvdLefKcJUualxf4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBt8NeQha3YfKWFtdDCaBKoIzvMOqeiX5aDfQEEAJyQQ&oe=6A58CE1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw772foECDgQ7kNvwHWKV9l&_nc_oc=AdpiyL_SkDgcZ8wlI4jEFNQ4LUmoIqg63Z1_fywuH6Xb5y89rGT7azWFYoLkXU5OhZg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUIUitt8MziMaj3ZoqIHv8PPOaWkJ7ILLWolZxqVV1IQ&oe=6A58E383"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
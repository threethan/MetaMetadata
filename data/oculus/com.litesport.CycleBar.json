E", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAzZlN0IJx4Q7kNvwFHr0Kd&_nc_oc=Adp1FVKAKbP6kZwXkweIuFyhb5Sfmoho32qOjkysnsAP6giu6uysy4xnJfgWrTReotQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y1OLW9Dsw3tqgKQNomH20LgsM0ZwPMCInRV8Biqq4-w&oe=6A242663"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGHdXJB_y1gQ7kNvwG-XB9G&_nc_oc=Ado7c91sTTNxNBTTzA02GKERAh6V7fCObCsEv5Z6UR_g9v0H62oPNQS3DkAlvKPDOtU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9--IytfgzEG-E6tGgXAzDKJTq6MuALeU6afegkfb8C_A&oe=6A244D89"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgxg7K0U2HEQ7kNvwGLMjvd&_nc_oc=Adrzq8DxmfX4RYcEcYJE_4xY3NLs3LCp2EhN9xXmB0vMIdm3_WZTVP21Uq5Rmz9zk10&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ij2ST5QqYqRsXDESXq5blPZyqOp3GtNTPkIBqn1Q--A&oe=6A244DFB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9By1nUtJDoQ7kNvwFALaoL&_nc_oc=AdrqelHJX_WceHP9my-8OJlY8A_RpOtY4ygPqT47hamAWuvOIk41X3LuvVHOgFAAv8M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tQ21G0C5V4EnFG3PRbcTnXcPOLPPkMxvu6ilXumGs0g&oe=6A2431D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdhxGPGJlEAQ7kNvwH5CcKG&_nc_oc=Adp_05s4oDEjN-V61llYoyQbWw6xYNizdzCDneuIGqoUDgEs5Vz7EYcsE6WED0vCo2Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Gnq6paPB9k3QpiBDQPLphVW2tFhFRS0jtgR479mmqkw&oe=6A24404D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzdWM2RkYsMQ7kNvwFdvMgp&_nc_oc=AdptRdNAV_3TTTTrLMvoBTd6rvmYS2__yl6gjKjP27-boWJruSa-VbKLRp5Iiiyqtpw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SfypTXTJIq-9eHjOpxb0yqyjrlDY335MXIfXT1eVRXA&oe=6A244A5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gdvft0KXWHMQ7kNvwFWf_Kw&_nc_oc=AdpRyhrH4qQwISW8K3oSp4tzhdc1wqhZpvAonOljxo1JNzQAz9tfhUNdwFt8FsBKBsU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5I6qCdq9mkBiS9uFRSlmXxCMXzWoRTYfe_W_roL-bpQ&oe=6A242783"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
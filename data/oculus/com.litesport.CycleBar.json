E", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mii3Su6A1d4Q7kNvwH4dBIa&_nc_oc=AdocOS_QjirIj-3zUSVCMWsH1FpqzrAmbb1Z8gEOWBS9AcLMFMSU54nfWOvRZ7AoN_Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwImwGCmIuMs9QJRTv7fTUtW8puBgafHZ_NyBJC89k_A&oe=6A6DFA63"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofq8YgaBs10Q7kNvwHvE9gF&_nc_oc=AdqfMnmmX8VNl2HBqdY4Y5NuKXIusKSxFLDqCSh-qah34EVg15nZ8lvTWzxuvCQJ2jM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6_9wQRD-EniHzN7qnO76ruXTNwBEqRwKCGbTAXoCS-A&oe=6A6DE949"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5zEvs0CImgQ7kNvwFt4eBM&_nc_oc=AdrIV-YnVwqxlcF_bZmqSKU9q2pmanv0-B_b1mx-xwrGhTiG_L9MKolCEtDKUejy2co&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL0dKJ3vcNNov3tVOPeUMO2P1yIKl4O8pqSedQuCZRPA&oe=6A6DE9BB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfpuLaTW_3gQ7kNvwHWpMsB&_nc_oc=AdoBoEw4iHIciwh3xZ_-6nKMBPXFlCx0ErNxQGgJiqiAN-xu-f5FZ6P-CmbtsPEXNic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAu4wKUphUZeP5qdgZ9MMVnRQJ8Z2kp49pJb9IQNQDe4w&oe=6A6E05D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpT3wj0UCj8Q7kNvwFOeyE0&_nc_oc=Adr6quYXih3LCMJjLHvhuvlSOKNOgmRYfbiYPf1EyO54t9FtQo9WnEYQn0OqMB2e-XE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKFEF7A0Yr0lAjR_VZbaFUGV3XWx3yYzEveTrGpuJBuA&oe=6A6DDC0D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfAtTseVma8Q7kNvwGWewuv&_nc_oc=AdrlfhquAFHMzegagctNLZDeDjxvmHQB6XVgn8CYAh0G8eCnDOL3KfbzSmNYTsj_BZo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoVYkBNjJ4jdrpE7vA21X8NcWhbf7MshVXVA704JpK0Q&oe=6A6DE61C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oshyHRse1q4Q7kNvwEFxBu8&_nc_oc=AdowGM4olv0GlDThhRa3ulALfQs7q3Oas0eowkvPPp19a4x_Cfg0UIPZLYcZFzNZk98&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqCV7oQeQlI0ojctugpVd-tLd5mF1EHF-8JVB7e_nNPQ&oe=6A6DFB83"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
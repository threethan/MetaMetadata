E", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baWIgfGesYQQ7kNvwFxHGUm&_nc_oc=AdrfYWXCFiR8n4HsxjHOrRdfNs_Pl2Pu2GdTjzb2H1-ujJSaLBucwbmwbrhU2x5Bx0c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yWf2siOvfoeHUtnlo66sFubp5VtuE5qaHAmO3880Lkw&oe=6A05D3E3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1VpcxdxdLEQ7kNvwEEpfWB&_nc_oc=Adr4Nrry1X_O1UxzoYrYWphvrncbEqyrTcEkSETOGW3rLyIY0-LBB1MLm0F27YjRiac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hhL6g-c1weQy-kJMA8UqFi4X8FEQcapwCnOKTcxmk4A&oe=6A05C2C9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDOel9iBN7sQ7kNvwGtZps-&_nc_oc=Adpz7mt3IICLYqNz-v8hcTB0lnaSX_rYa0IeWc-hUS60vnHj9sZLEzmmUOkIPjsPGFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OoOY7wDVZOQa_UVd-7rDS0ptL0AeeSymae6WnCvMwpA&oe=6A05C33B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLFKKZF2dtQQ7kNvwGSyyKK&_nc_oc=AdqwtIrVGpSCKcWiOCIJ1AWPglU8kTDcZsTXQoUtGMGb_aGn55IaLyyNJF1xw5D3RCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jtk7D2DIoxr5wN5QnYpnS960lX_O4am_LI6O7gVatJA&oe=6A05DF57"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w69ZWhNUbIoQ7kNvwExRBIj&_nc_oc=AdpCNNgFTYNuU6Jcjnmp4rXjIPjhxhhxu27t8azW7rU3tDWnhezJY_CcWIfygq1H7Uw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fUf2WSfFeCBt8VdH4XOwhywO-ZM2p3Pyz5C-avPFSGg&oe=6A05EDCD"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jn28PrxfmEQ7kNvwE6Ysy8&_nc_oc=AdpQilP5Cf9Rg_BmRX1Hn8w6LL5o4I8PpyADLEDV3FwavzAphWllSZA81_1V6CXGwg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZAEbBxK4A7GTCV9r4jEMJ0BJi19p3IuvXffBOiXHK3g&oe=6A05BF9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43-5Fy-QRpgQ7kNvwG04sLx&_nc_oc=AdprQK26o6cigGzZRzDqO6U5CGI6FhOVtKrEocSyiLpJyz22uuXB9_IWYQ3bw7u9_Uk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DKHbVrgQdd2ufT9kMRP3FaHpffAYz8Yf2BJmkcTv0kw&oe=6A05D503"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
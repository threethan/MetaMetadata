E", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VujlRG96L3QQ7kNvwEpSf7B&_nc_oc=Adoby3_kO7xqSh9BqXs1Yk00AHKBr6OScNY4aWCESF49oGry6LS5300VlEhkrRHiDHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTAaLuH_Cyfhkc9UVgIpS2X2zAtHsYS7BAuHuA6afJ-A&oe=6AF8A023"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyvTj9SkxcUQ7kNvwH6MdK1&_nc_oc=Adq5U7Oo2YUkNq4tDZZfO6rmiZ-kBQJy3A03RrTzTOus9jWDFNfALIRIlsK08q19RPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxpE5q7AfYearTxGaV98gcC6NeQD7ZD-GltkyJ3-arZg&oe=6AF88F09"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtLutCOLEcMQ7kNvwHwpucK&_nc_oc=Adqs1JXjhAUKSw3AwthjBXqOn710AskNjNUdygwOKW1quor3_VxRAkWNcjPaunO-1JI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX_m-c4Ht9vY2R8HEKANT6oTZLH6nRZOdVOrCW8WexEw&oe=6AF88F7B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQMirQ0mlioQ7kNvwESfKQV&_nc_oc=AdrmsyfoK8QrYeJcHQvtvhTuXYBf46bI41Xz6WAZnmJgNPTmKrIcreJkct20WB8EXo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaY-OsdefBzt4v_TKWvD6VKmuX5EzCyXJAlvQn0LWlMw&oe=6AF8AB97"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3STmxB1b1IwQ7kNvwF0po_V&_nc_oc=AdrSrPIbMMcFPxKKiwZz0L2Pn2iWU3YIpobbeWFu7miGwKSCqh0njF2o8si8fE0Xw20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAkZMrUJdoWU42h1xl_yEW_eohbbFqkSexVaNjHCLfNA&oe=6AF881CD"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbBpUHSlfigQ7kNvwGjjt0d&_nc_oc=AdoQvoikAA7B5qOtZfh4eajOLMK-MQINNU-RBM-KMBgq49y7NsaUmy_5ksm1-UfywIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMOh3Dd8Vg0pxtWNGjYC3K0jiNk_GpYPZHAvtt0yYQVQ&oe=6AF88BDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-QMUiCvTUUQ7kNvwHUwXBr&_nc_oc=AdozEmqSw5TDA_RkLNyQTCttRXU16OuGzzeSOvRbCyAw_C4g6wvnRVRqhVbfYkKHFz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfzUQeoMZ0wVC7CurKCliK2Rxj44ykv230m0E_32z0eQ&oe=6AF8A143"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
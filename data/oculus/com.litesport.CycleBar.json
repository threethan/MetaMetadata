E", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY-K9Ul-IbwQ7kNvwGYCEjN&_nc_oc=Ado6zE6nK7fmPbG-pxn8roBhq2dA52dOc55RvVmNBerLt8vFAgCuLBb3QqubknJT3-c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qfbmEyHitr4N3KMlhuqYjyAV3KgxSuZWJ-Af5sZ6usw&oe=69E0E9E3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkMvJgXKs08Q7kNvwE3CI2M&_nc_oc=AdrAEQ-VVT9SPQkCOUd5Bmxm3xbn0seHjZ5c4JB_Rvhrc4SZbbD9_7sSLrY_zugQ__g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vHvg_a7zjzmMj4SkihGQwntOhOyX563LC7uNHjcg58w&oe=69E0D8C9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjbYLAYB-3wQ7kNvwFvryJh&_nc_oc=Adp55vJJn0EHbyP3rOYx2SnyZTk2xj8VXgXqBfxGk_UL-eUOzZViFBD6ApwGtkB-Cv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QCewnt986EHY35gpKMWDNA-2CO97S0JsdEXaD3mMorw&oe=69E0D93B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imbd5Gacxd4Q7kNvwFo1LxO&_nc_oc=AdqrQZlvfMTxesHui1cVbLqd6KhGDY8T9-m04HtYIOItDX91q1NHucvF44C3-XD4IXk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WM3Y6aF44KtBibxujLdDU-bmO23o8DlEBWHtF4sZ90Q&oe=69E0F557"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhT3J6jQg1oQ7kNvwEpGD0K&_nc_oc=AdorGxchQdmyFDt-nYL8h2_li61qPYwpKVac4qhLijyoQsobqMoiHYd-3y76WBnHp_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vG3STyrplgh4SSpPj462MMqycr2OXMQ7as857tSCOIg&oe=69E0CB8D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a066WahYgQgQ7kNvwFxRzGZ&_nc_oc=AdqbouinyQl5OODQ7xqlpDTyThxVjJCyyuD3bUd2sr36d7CXdJk0EGFKp6cqagPuvcE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GrtrTbpwH0vmXSIafRLrT44EWyKQTlq2QDNlN0gtybA&oe=69E0D59C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwhsbI6Uy2cQ7kNvwEMIsqV&_nc_oc=AdrWo3hNLoO2jvWPW1Q3Y1aLAjazb6duynKtBdSFEVMLPkZ9XP3xs8EmqZzj8DMas5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29bzjtKccl1Xs9WKhVSaqSbpuKK_EL-QRgbYeC9WFeDw&oe=69E0EB03"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
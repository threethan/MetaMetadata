E", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vttiNsC4gMQ7kNvwF-J0Rs&_nc_oc=Ado1n41jbPgpsjH2NmZYM8v1qQUcDAtjxtrSNbDR2KD39BHw5dmiss-imG3YCLUM1a4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAR8fu4uxpxGxZW4X1USATOuNUjpj4sshmp0GrTEEfSA&oe=6A636E63"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V99NbfGS63kQ7kNvwFztSz4&_nc_oc=AdqoJk-KPwA6f3zk01oyyr5j5wDPxHr2NoFdgH_SQkcBwQfqAZ_DKqLIk5VimHomCaI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOaIUcoCY6K54P2rCCfgLU9L6X3CAXii8qtwWeOKNFxg&oe=6A635D49"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJsNnR9oogAQ7kNvwF1drMP&_nc_oc=AdqYBCSPjODpUiXdfAigq4qJ60a65LF9IfqQwsmbmgxCL5IpnB5uMQ-QDGZGU5AM9t8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDK_CrsWd-iIvx2Kw1gVS70WbqqFpOhZyqonwg-RwQMAQ&oe=6A635DBB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKfD4XpHksEQ7kNvwEuVLku&_nc_oc=Adr-d5OLPnTKRCPlN11dkOF3rqFwyaMVMMNYOZQei06DtVrQqh6GelFHBO_Um0T7nd0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrVosJAtctcXX8m7Ie94dB0ZgzYupWMNwZTRHn-e1Z3A&oe=6A6379D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLQPF1cQ9ZMQ7kNvwH8x_mH&_nc_oc=Adp5LTV8w5f1-SQZ9kGez9edCipti5GmQRnZ7q6XZupg6_IXiQJ4ZIaPw8BBt_kJrfo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdhUnNeogDyRnDpPMpZHQutBux1icK82nNbdMm65cMGg&oe=6A63500D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdxWjskvHOMQ7kNvwHW_wqx&_nc_oc=AdoUx_6YeOvKj3UeIs9YsFUBvROBLcUNSSVNbffxlgqUCocr7SbUr7ZTa0MoRGvcN9c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-fbQfvtuxXmhsqw8gH3zRp3h-xJlJ020n1VPZ9dmG8A&oe=6A635A1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mStRMo-aD5cQ7kNvwG5jwVE&_nc_oc=AdqFNi2Gj-CTl1LeMBuwuaJXDBdBF6GG8-jSfzrjpefquTgWUaxEAxE1SMYM3dNdWKQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBhzkHo0AsaTd7utyZ30B94bdM1VBfjBX2OZeaaQ8Ktg&oe=6A636F83"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
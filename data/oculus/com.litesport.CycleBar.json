E", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUPJV6vT-QgQ7kNvwHw9QSG&_nc_oc=AdrF-Kr0IEEHhsj731SDb7jcejZ_MLifHRZ-nS5V5OBVMt9bnolyQaoKJe4fXgFMcBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zYlF-3G-BXjcRv0G-nIW_yko7iCyzzxzfQO_No5PP-g&oe=69EA2463"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPEzNTyU1yYQ7kNvwEMhKe4&_nc_oc=AdoDNPY0LxJP9g6ViCkhlY4Un0tZmc5Ebk95yPsovg-fW3BXlE6txbXOtQrE4tvQn7A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g2afjLCYh0Y9pQKFyhxKmcGLa-Eg4klgg4hHoE_wQMw&oe=69EA1349"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTyJ9py3RdQQ7kNvwEaa0D8&_nc_oc=AdphVT5vSTPUi5fYWtYmAqRFdsscBfjR1-F86SfKjSK3wX2kNvuNIlg27qiR7alNd48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DovS_wJA8qS_WCCf4TycQ184JQYFMCpDPkvT3npB2_w&oe=69EA13BB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpRlvjdENGQQ7kNvwE1Eqq2&_nc_oc=Adp2TQvQGvfBXQmxH30NEutErrpdRo5e_vh3Tedv0LUuge4pwVUynkxCUWBFL3KdxNo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fUQXNuT4V1LVdDqpVMx-5T0ZAyf2lSTsPzTkU7nEhBA&oe=69EA2FD7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aqsLE5tHrsQ7kNvwHH-zgH&_nc_oc=AdrR0ZAqdhhHphqWVZtJx1cn_Cxk3lT8XRjYI1VIjJ_dhrPTFW2tueZrR21HPNOKYrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZXVIsE-QjqlBmSYZRLjrIaCTdknw14mlmC1TeHCcnpA&oe=69EA060D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVY5QEi9zsEQ7kNvwGV60vq&_nc_oc=Adp0V_KY_fH31J776tnZO6UelW0_WJVEYx4yTKQ2el1yqi52EWXqFqJ_SlACyappT8U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CUD0YtRiF3TM3Cy8PfgLrYHS-L2Y9_a4p_hqCjySP4Q&oe=69EA101C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcYSTCLyCioQ7kNvwHh8SQe&_nc_oc=AdoMbV3UY0Q6YrXuh8EDEOEShsN-vj-NFoMK792JSh7itM6bHOTcd47bXHHyUJ2kv6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UncmdykUpDevrAJq6JuLagkzoTSOMa-r0XgmcywJRHQ&oe=69EA2583"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
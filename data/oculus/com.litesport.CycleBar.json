E", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMFunWgzkVkQ7kNvwElMp44&_nc_oc=AdqstCj2DejZ8WAUI2tv2dWndFL7YCS6RDBAjDPaSmZs7Wr-w-o5Jp0hFdk9SwY0a60&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4WEnzWpQRICkgjd1-ku-NbaiMN5S0NMnTkOHOidbPnQ&oe=6A806F63"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaGT0b-SSKoQ7kNvwHtQWp8&_nc_oc=AdoT1So7SBPJEZk1aE4tNvSFMj8ivCf_oGyj9Qaeb87e-S02RA34zSSreNDzS7YnP_g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhLTEGEuJ_TXPP2EsWfUwC9V8LU7DJIKpcgj12EGxlpg&oe=6A805E49"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N31la29cOgQ7kNvwFrJMdh&_nc_oc=AdoE8ukX0e91iG1e890-wcdjWTWvjbLL48WyiXiK1LXkWq3hgc2VjJars1P8OGNYdxs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4_2yD5DUAvatWl3GSO8_FzCpeAqw5sp65wUHPrSHGZw&oe=6A805EBB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvqWW-0-E78Q7kNvwE_nvCc&_nc_oc=Adq9x_VbTqf95-cOXtWbJ8pZmNcpmZa-81O4jpQbZlo5hZsAeWBQT8a8vFFONJ7gTOM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa5cUjCxNmq5eHy2o6_Nl1feP3oAU3sORwOWw0Tkb0KA&oe=6A804297"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZ6YpZ4bgKwQ7kNvwHV7nFa&_nc_oc=Ado2zjNyvKW6lDN43rmYlwYLc4rYBRtl-fijVL7ZhgQip4j7tvWBnecV_EnmwguQnDw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrn0YXgx0Oln33V9i2RNFhfRabS3GAMyWyax8pysDXyg&oe=6A80510D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ud7G3AW1uQQ7kNvwF-hHRm&_nc_oc=AdpqtYpXhNEfAvtHrXQt56EfA2CAJ-fHMxgYyGlqLZ4MJbG7P1ucEmCIjrB_KIH8yUk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaRJlOrkiUr5usTdfLpO-q1cMy6fEgIEXpqwxFQ1W2fw&oe=6A805B1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQlfJ3iuLlkQ7kNvwF_w4H7&_nc_oc=AdpgJAsVeRFsGvt3-FIluI2-iDnVBRGrPCKcpFaWqPn7R6SxHyWqDC-K20nq_IAFL-0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6vE9XAijh4ClHaqYxC32LDuGZadJQdB8O9Dow2sYRJQ&oe=6A807083"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
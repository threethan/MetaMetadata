E", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qo1_AjN-YEEQ7kNvwF9eeG1&_nc_oc=Adoafbp35dB8U7V-uFgo8gTzgUfjunRh1dkFnarhpkq59ngwCl7W1z2MHVn7nhQKS34&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uXvsAoYuHpjnBFYbjwxpHJW2j2v3lrc9wk4WYa86msg&oe=69E78163"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjeYaVYGdYQQ7kNvwHlXbC0&_nc_oc=AdqCLVqAajuJntf6MWE6sNkIR2jNoLOj5mpqCKyo-3MhQ1MRI8eJW--IMuw1-sF2uw0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mMhIgTEjYyz18lELe7rzqaZ8PT2vH-egxV_sHLnWyKg&oe=69E77049"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWTl1eOciuIQ7kNvwEEnPfM&_nc_oc=AdqNd02k2Rc7V5VcY3vZBQ_NrthM95-10SzOR8aOCbbg7yH6XanxkWweHa-C0UWE0Dk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1M-owuu8Ms9rRmFhYowxm7sSrrzt7eGVSki9UUYQSJmA&oe=69E770BB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ot57b8jjH0gQ7kNvwHJchBt&_nc_oc=Adr7sWqOnV3BV5_ApdQ0V5W0Bk0leG0sBZR0cRtek3xRT1yQsEzyDX7Ug48yAPZGgR0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qPB8hUCifaW62YwGBeS54rJ1HTmpzX-4Uj-MxAGRhxg&oe=69E78CD7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYSyENTnwfQQ7kNvwEfwD4r&_nc_oc=Adr_mVnb_UwRTMJUMBPgupySZkA646-Dig00l79Z_ZicMYpGx7UECwffCglWKsAWOPo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RD7ZiMhtGvC-wWknjkjL96rNEiUBZYnxHGqPFirIjgA&oe=69E7630D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtn_xwjpO74Q7kNvwGyjlFS&_nc_oc=AdoWXyFwVzGXwuWpHgYkfLH-93k9RwHjg5iAKuXjeYx7mXuX-FqwID8jn6Ua_CKZy38&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15Gn3VJQIE0FDe3pjR1vCTvsUcaBJADoEA9i1HaSoEjA&oe=69E76D1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcYSTCLyCioQ7kNvwHOjb7f&_nc_oc=AdqsXxnKnn1b6J_iZHp__-4i4zmjN_qzGFlgsWhATbM8dHMEZ4xw5ME_sKm9JhcdeiQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08eiqbr4KlZ8ypBBqyGGeynxMfEcNo9dxwjPfP43Gfvg&oe=69E78283"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
E", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K66-XWAmOuIQ7kNvwH4iq03&_nc_oc=AdpSK0yZmDTXEYV1JPXJDc_LUFiXB50_LgwlI583f0MeXCNC4qZcySJ2385wKl-NdjQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUzko6viR2N4_1ZO-AHx_0UmL9wAx-xhBzqB7O9w2jgw&oe=6AE1FE63"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzUrFVvlafkQ7kNvwHX3V8P&_nc_oc=AdoMJ6Fr2Zr7LYJCjd0lCQX3TnbaLHwtyqcnHc6aaZZnh1VQn3NP46ClGJRekgwsCe4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPURSEbdbovGr9kQMrlcF3ke6_tOtLADxdurZJQj1yUtQ&oe=6AE1ED49"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2gyjJJ3CKsQ7kNvwGjz-Gy&_nc_oc=Adohks502jAf0Un0Dm_jDKVmA0qt0Z9XZU_mnxOvwsXk5gpzSgk6lR5WVz1GNy89kBc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_KCUdgaBnBnav1vOTXwR9oTmgGer4Zcd3D2TIbRBkmw&oe=6AE1EDBB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyOM4uPbjI4Q7kNvwG7KMfw&_nc_oc=AdqofUGbMs28AFzsaVw3v0IFt7wVY2_HvC1nk_GX49IN4XaJNk8brH0QFokEnM6PlLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1SlUTFJmBetuCtYES5ieE8jgA_opkdNW69PE0YvFAUw&oe=6AE209D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9k5d6wINaMQ7kNvwG51mwt&_nc_oc=Adon5Q1PKaC44vuAY8GLWYYW5vTR0KuPaCps_6qzU5DU0OVRcsNjM69CWLDHpdZ4GDw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0AZ_-_n_EM71S7d6EGrSx23PUUOvLb_QbUDDDNHoI2Q&oe=6AE2184D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjdZ-_p0jEQQ7kNvwF21BaU&_nc_oc=AdqhlXlr2jybHLqrgstB5jPhZJIDMki2WRA8slAGNXtLqX11xVn2oF1MxCmwGPxR5kU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0ANap4nL0HO6_GNTjt0U-01ghxeOvYAX8auIdjcCm4w&oe=6AE1EA1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDBWpP-vnVMQ7kNvwGLQjbu&_nc_oc=AdpHQ4__hETSiTizYziuOOJdwdWU3oo9Du8x8Kwx0rENiVhmT8uuQvvFw5u6RL_SpBI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH6Y4mHM_UXqq_p6suSUNwqBSSchsb4uHXf8tAjXci8Q&oe=6AE1FF83"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
E", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAvq55V6Pm4Q7kNvwHRbSeG&_nc_oc=AdrcXSJ-hyFW10_XMZkwI-2IIYpJDeDlaZF9yefkXe55tflI0uotTjWi6GZE_-MTp-s&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCDNeSPdeibYxZNltANhcoqQ_u1uywkmqpJ_GeQSc6Cw&oe=6A974963"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nas2OfPnBWYQ7kNvwF7Gv6T&_nc_oc=AdpR-8HDoFkQZShpbN4wk9xsQooPpd2ABJcg4UL58y92wzoi_-EhvDB-W7rEs8mXTuk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyv_X_zaYBsoe_l7JgU284vOleQTb3QYOidPykZ5-6DQ&oe=6A973849"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhmjB0QSIUAQ7kNvwE8SWrs&_nc_oc=AdoJKBiWtfK1AnDxnNVhk20vPF7p2_GFPL-ycSv6UbW4HCYc-IhY1qq0cA7tg-UYgLY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPyP9WwdMIP8Z7n9HQH7UwPsXge74tY58Nm2hKQ1u5dw&oe=6A9738BB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pkFF4uPVgkQ7kNvwEOPCa2&_nc_oc=AdpGscsE_Qz6aVVwAT4RE6xNLbMBvmFaZ1JPdya9myo3rudfrN00_daIgwtApeDDI3o&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH5FKDP59aJiR1N2so7QWdJsOvqtf3d3RpNdM7H4H9WQ&oe=6A971C97"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTcw8JcPOX0Q7kNvwGoFxpz&_nc_oc=AdppATOYRPMXP9vzNWnPf3amEzavDAZCGAmTsawe4RKNJ2bb7t0Nydd8WlibNhr-Sd8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGto9wP0F3PPaarqXdMCgzeUIEGExVUtynqcoiP4AwA3g&oe=6A972B0D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r1Sa98BEQEQ7kNvwG2tAqw&_nc_oc=AdrzJ3LVVRAxbZe1qFqLidvKh9MxGgnVa6qKO1wpGrfXWiBtVd3zNmBlg0hRe7C4VpE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESZoUHfPxCEEfe7sirx6PeIESg_EVtcZQiZ-13c8VIGg&oe=6A97351C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyqzHxncJZgQ7kNvwG94cCE&_nc_oc=Adpht_l7uXyQA8yDy3Lv0g-Ykgk93QGQqQJp_WUutIzx1Es1TqpnfOvn2PiuTGYGz44&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvG2iePWt0V8iCSQyhOgeFhss6ZHyhS1dw7J_8r5c3DQ&oe=6A974A83"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
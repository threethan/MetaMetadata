E", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSlM5zKW0acQ7kNvwGrzIVf&_nc_oc=AdqZn080WwcbluPDppKfWoUexgaluMXuGI_GZYOZFjfRn1ZTxLwc_8fgtft-_Xh5-a4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr4kE8RqdAsqGd6OPBvgfCYKh4y7ctYn-NOJCh0MLIRg&oe=6A882023"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_8eBo3si2gQ7kNvwH7yaHL&_nc_oc=Ado97_zeJ1WlmuZGEGN6WkH_CeIVhWZp-QHMHuZSOoqw_Z5s6g0fHX7nqdLu-qYUJHk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4ZQfAGHUp7tMXJas8OxO1u1YeeI1m571aluiXhR33Eg&oe=6A884749"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krpI8mcOZb4Q7kNvwFGaH2j&_nc_oc=Adr_G5gkKeK38uVCoykEl6L2xl5y9mm7TryVXiIBJjCLJ9NW7e8WX_UIz-zQKxgtkhg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtp7KF59LvheP8CjdUmiNbX57rpZKAjK4Mexd_MrxFQA&oe=6A8847BB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqBYsmm8mzIQ7kNvwH7bzcB&_nc_oc=AdqBDUrcqtoAx1geddC_nZUPFxOc7LiV6ySqtUa8N1A80Q5XzI5QGoNTmsKGAm99jsw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT-uM8q5_q-MAeNm9vlQvT4bzisB35N5xy3Vr6nz_PFQ&oe=6A882B97"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fffpPNXPYKAQ7kNvwEQSniV&_nc_oc=Adpu0u3MEU-tjEO1s3syiamrw2xSaelyZ2Qv-ej6j88GG6HA-PZVD4_ExasU_fjbmiU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN9oBD9IFL6DlepZoAE0Yxp-cNVF0jpIMdinBEMhW3kQ&oe=6A883A0D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QI_XNs7TWzEQ7kNvwGhcz-0&_nc_oc=Adrhy2NvTf0ZN-bpLbjPwl8QdePKooptxuE49LVpOED0PtzfK_w9DLMlobP82jJ59V0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL0rfLhP3dX1afx-RYZj0-OiHKU16nXCSmBI80xhTrSw&oe=6A88441C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95v2kntTxIMQ7kNvwHrbF2S&_nc_oc=Ado84yeU5ZxihSjcOefkaBITZ0aaT_DWnNEOS-YItKFADuh9YWJGezyzNT1H-MbUzZE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBRav0V-bKnry1-VbBDdqZ7lROAv-8lFhA919PxFgSLQ&oe=6A882143"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
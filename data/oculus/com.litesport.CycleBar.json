E", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCozx1CWFrMQ7kNvwHSvrHR&_nc_oc=AdpGgGz1_YrmVudmz6ZQ3Zm1mmLsUyvADI9xQ_UpcJnzZTuw9-aKzogCu8jc69nrSlY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWiuacSsd1uWJAtXprIXHypAmp-imNYF3rr3vr87qi0g&oe=6A563F63"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfl97yLnXocQ7kNvwG6Cjtx&_nc_oc=AdqOrISzyhhHyONJNMTtvRiY609aeH2F3jNzAIfg6S6EgSuI0J1U6HGfTIaDU7Zxzt0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkOI-ga-6g3ssfiQqt_DGD76v5hiYYqG6GLQXQSTXH5g&oe=6A562E49"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJTITtURYowQ7kNvwGqMgKG&_nc_oc=AdoDGTsOcfeknJ9_yoy8TMQOfW1gODKBY5X-DtfMWQJ0lJExoPcO8X0OE8B0fC1UIgI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzoRFS7S7PBUMTngb7NbF7m1UPWZDa-4Oi2K-aVGhpQg&oe=6A562EBB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iqb4MJz8ReoQ7kNvwGfqF5i&_nc_oc=AdrH2q3xF1yW5x8rElb9hls5YYrOHyZP-EVgbtFo92lnqXQb8YFVAEr8UFfVGi7KgO8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1ldXsaBdZ8coqCECnZn8W1dZ7V-N4IWFarZvyCCKF6Q&oe=6A564AD7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkDp8T4brGMQ7kNvwHA4usZ&_nc_oc=Adp4rCG6Nxh4PQCZ5o0WxMhyV4yMoXcrj--wRvw0IujrOGvwAOtiTiWI30inRl0VEOI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALAqSHIf3WCOFHZ8TOItulgWArHixKfbwRnZ28cuyp4A&oe=6A56594D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOHnOwN5AP4Q7kNvwHSHtzP&_nc_oc=Adqs9LBelJ4Krcfe9ReK_q3WoR-Fvwga5Zb5rYbTOEZ2QJQJQCjPBAqZFfBZRzGr_L8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP8pDq_D4z7kqANwNtsekOrHaMEvDhJyDioPFVsDGdkw&oe=6A562B1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw772foECDgQ7kNvwGXUXV4&_nc_oc=AdpCXk6x648YB4_pXoXNqZGvd1Xn6okarGU32wu48Cm6OMmCo_-FO_veQZV5fcnDWrE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1h0L7UtYCMB4nNtoFP8xxVFwi7CbBlrH5LWZ2J4bsuw&oe=6A564083"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
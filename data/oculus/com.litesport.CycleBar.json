E", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awU4fOBt5EgQ7kNvwFE9Mhe&_nc_oc=AdpNlhJdlBnCEcImZymVZ-tcbRm0ohtc3-qSlpYWzqlA5UkMa2vVS1t83_Bm1yGSpJE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55Jr2EyOSTbJglEoduaobJENAv-iLyWVAerpbMdqqE1Q&oe=6A0876E3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eLm4G7YpWEQ7kNvwG8TqnH&_nc_oc=Adq0Y7zaAUFA38tW-bHtJbm4SN-oEC6s9bs4B5B7fErb_XgPRIv-ry-NIpZwXkLlwwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ys9hdABDv_aWyo79cVhH-yPNQ3lL7zoNVwCsV3g6v5g&oe=6A0865C9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDOel9iBN7sQ7kNvwFjNhs7&_nc_oc=Adq0XDDVTohyiErP50zDCLEsRN_4ShDhx5CvotZhFlQf5nn8yANY1sZJPcRIjZIAgZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jnVJzZtJobqQuH66QsKvaGz_RyKbQ7VuaSyZZH9DKtQ&oe=6A08663B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BH3pJBUT6WEQ7kNvwGxRT8v&_nc_oc=Ado6Uyo35SB_uqxjBbVABhfAJWInaqOT3O9e5xaxaL6s3WM8FC5mPj-pfI2NgNXvNTc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DriE7SfBRzYjqbOCfQnrtXXdILejAnUVS0MAqxkJO-A&oe=6A088257"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJQtrVLkBUYQ7kNvwHMYJzz&_nc_oc=Ado6bKwKNn6QZMl_KZLYERLXucM7al7CZm8O_j7ddZi5G6TCXbjmXDnGcOZXLryQNvg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UUNPaDZLxunzJVk5pyoWWm5-2GoFH_MmT7pw_mziB-g&oe=6A0890CD"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jn28PrxfmEQ7kNvwH5wxO1&_nc_oc=AdrmH7rPZ74HBWi-jClWPItWlloJv-rANl6KTu3bPsJAmzNZmnZcEDWksl7la4Kn3s8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67w5M_AuPKp9RS-PPDsX2FpXqdGt5yo7aEPH67ZccpnQ&oe=6A08629C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQd6msrGlVUQ7kNvwEPI7va&_nc_oc=Adrq9QzAEj5nJ4T5SVj7huYQ6dOVlz2QRaDH2HV9BiBGJbM0GjXA6e4Pcfkr52fJDBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hhhkoGz3hgU_cyY-cXFtekYCl-oFCbsluSCDMoJPPKw&oe=6A087803"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
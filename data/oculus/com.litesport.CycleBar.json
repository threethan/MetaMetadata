E", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSR_ZHC2FisQ7kNvwG20sSs&_nc_oc=AdotfnCvfaUE2DWXzJcNiuptcllKyy2EPUbZLjOaEfomR8dxxoQk_3t1nDjZTJN4aI0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhYA8En-lo2aRijCMb0joooGbl97xDXqsyqOY4orSbXw&oe=6AF9B963"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuinpPjmkjwQ7kNvwGfZdIX&_nc_oc=AdqYC_dBReliDQ8JAgTP5rAk4dmqijCsbl_RYbWwk2cC6nxusppJeRqP9yBRY1wsk-0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPXCZ6WjWiNES_3yawR1y5Dz20rBW3ps3IU8nUYeLzhA&oe=6AF9E089"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtLutCOLEcMQ7kNvwFj_VCp&_nc_oc=AdqheFDXCxhdRC7tC6GixjJFdCGT-vCVIlUGRPwA3gaVLfjlCvbGir7H0s0K7gZFFBg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWGj1hSRzBLjSuZ4iCSzaxWMSs12uCTwrKXuopH6aWHQ&oe=6AF9E0FB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7PELx8661EQ7kNvwHMp5fi&_nc_oc=AdoqI_NW9kfr1HYdHxYR7bqq-bdyuJu7GBl8fCN1F5pCpRsAgNdKsgxGu-1nLW6Q1D8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0nXioZTxR4aE5Uco0iV6nUat3ZWqMQI7IwrMSAC1YuA&oe=6AF9C4D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CptQPRE_QUgQ7kNvwGIHd-v&_nc_oc=AdqhswXaA-ZDr2jYUWLaG6c20iWGBrwNHvDVAai-7ytkrnED6fINuSgZJeAGUwDBwi8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8sLdzdgPzz9k_a1EceN403sIapiRhuMw9qtuwK1CZ4g&oe=6AF9D34D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oXqsicKiB0Q7kNvwHMRs2h&_nc_oc=AdqnnURdsrRBDYe0_tJlm9_4BvkgACpErg7qi2YhnDxEGgbfoi9L45DvwyJo_ITgAO8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmGuf801qJ2lMpbw57Rn1Wnifx8SnJg4Ati8TQaCThPw&oe=6AF9DD5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-QMUiCvTUUQ7kNvwFFvf5i&_nc_oc=AdpY67g_EL-BQ2rRhWmvBgEx0Ihnryyr4ij26Cazch7gAXn-MdRsykktQ9MJOeqPPWo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6q4rDIEp2ZcPngRlJQ3CGv77XIPcxpzsi_XfUanykcw&oe=6AF9BA83"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
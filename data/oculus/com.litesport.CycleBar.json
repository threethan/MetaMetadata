E", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0oiR2LPwKkQ7kNvwHD3RJL&_nc_oc=AdoiiMuznCc3fzhtHps5rARbYIeq76iB-vZhVxOhy1uuc8A0VMVo35jR9pA1hekldx8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PKvlMdm962JQI2-7gTrqKycMJIV6Siarc8UZfqOjbng&oe=69F35EE3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0_FimiOEu4Q7kNvwFWEG4v&_nc_oc=AdoVSwSl6gBdGIJAty3podLJWaRAaeFPQGl-on8y8CWosK7XR7sUofdOnREY0JQV7ow&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2luomhw_KEqito42AUGkP79zyHEBxs-Ne6TLJkuJJKXg&oe=69F34DC9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruGfr1zVdhIQ7kNvwFawdcj&_nc_oc=Adr4dNcda2G76QRd4pDOtqrSI-0hiPWz6QNYBg8MScsyWdgqaKNx_gFyxoMBjSK79kY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af117etWs6xc_RCuaBooqKdrv_VSeDqfYozOod7t8aUhtw&oe=69F34E3B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Fd3ACxIsTAQ7kNvwGMit6D&_nc_oc=AdoB2mH40oPzhZFGBBAT52tZWPTYV6vLNj7B4p6tdFJXIjGr7w2rGe9vQLSPlEwqgAk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bjLnHV0CbtUjhLpG6KF4CLc3hjdjxmcIp7EBOKOQC0Q&oe=69F36A57"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buRc5X8UJ1IQ7kNvwEnes1e&_nc_oc=AdqBmLuMw6QFYTH_epF2Qv57ZC442Cwrx4xK0aX-EoAlNRtCoOsmQawn00YOCJFpIK0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1cGRcmtUs4F_bu5uzwz5-bEmpQXUjUd9oHyNunmkCOqw&oe=69F3408D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCwZuOHBF04Q7kNvwECbFNS&_nc_oc=AdrwPrwg-ldpXfu2-ztUMLczTCVvSfYP6WpiBrs9Sw6S2qsdjhQPdxpUiv_9r-meHvk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3peqW5XhLS3hzHBgr94dYimm0T-F92xNJ2A4xhNYAWgw&oe=69F34A9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dd4U3SHO8UgQ7kNvwHH5S5D&_nc_oc=AdrW7aPmwYiH1HP5_CFwzyMlMiKeNjwtCa4srSCqjOHedghGbjncXMLS1kTOzCMoG6M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1c3IL5x63UckOTCZtLSWzBhZQiWPCbi9I5MBzgzU9nqw&oe=69F36003"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
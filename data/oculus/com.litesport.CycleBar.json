E", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doBIir3D-4IQ7kNvwEYFUlA&_nc_oc=Ado5LNs94X6tx7H0NFpQ3CAuHaFFSsWeB3zpO7il7TjTVjUcz8FgwwoUKcy5hhIgl8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDMP2PGZFjTWtgqxgN4LwL7zDo3l2_iwo63Vc3Qgx8fg&oe=6AE9E763"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x06m52qG3ysQ7kNvwFQojFm&_nc_oc=AdrkvosOXUS1dAMeaFoZf37LDbRLTw9566JBGdDtIWK5xdHnABKQez92OG6kHiyVwxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7SKPaSU1RF8AKr1_IDPxsZoV92sEMNxR3YQdz0jIF7A&oe=6AEA0E89"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DQu93D_Wv0Q7kNvwF22MGl&_nc_oc=AdqXLKrPoMEHSauCmQ46hr4uerUlZ0-Hbj05yMWQ-_NB8NdG90jZsATlpLaXlGOV8jE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6XQSqVcjowy4SoNTioH40toNyueF9zhWmjwAJ8T2AYQ&oe=6AEA0EFB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfjmI-55qo4Q7kNvwEwqWRs&_nc_oc=AdqC_MS6ANGDXEq_qdl86Myz4kjq0K1AIvPYSTiYic2cV5Fs_XPBecarhiR1Ba1sz94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7Jpi504TfEDbn9gvDI9lk0LJXJyk-bbr0jY86Pq93PA&oe=6AE9F2D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6ugqg5OMp0Q7kNvwGEI2bA&_nc_oc=Adqjywe8L3lqgXKyQgm4artOJJx5YOondFIs9HEYgEeOBuFLA_xcfJJVMgCMycQRvWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhqME8OFby4zqhpAr5b7oaXuIu2XhuyKoGcbFHtpaqIg&oe=6AEA014D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdelTnFyYscQ7kNvwFo0sKU&_nc_oc=Adqdvlmzd4Y4lMw1r2lpHs4a_jNX5X44GxFZqE3izr4Bzi5mv7wSgFfl9UUfAe_Jd9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROTdm5bLhjnF1BGUtk2goSwHLn8hSWUM__bBIFPfhxXg&oe=6AEA0B5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IBYYAtYaP8Q7kNvwFZ43z9&_nc_oc=AdrKjybZmI5jnY_TQo0o3W0vHkd_oJ1MBRHFwuLczB1yKMCVIHYchVqBtR2gS0rGDn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSplMBceOjHIWLFzLMAUY8NFVCqLMYpv1Ub3kaPRToB4g&oe=6AE9E883"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
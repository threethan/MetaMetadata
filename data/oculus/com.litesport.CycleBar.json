E", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT5JN3XSbOIQ7kNvwFRujqC&_nc_oc=AdosKDdclhTqo4U2Iox_jxyP_ri2HbKldQiomP9LM6-zlb68Y4l_XzuQQYUCJQCJz2M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0NJGLWsF0vYV2x_xh6rmBECXD-f1UB5Kp0REwJMYhDg&oe=6AF35A23"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGBoQ8pZUYIQ7kNvwEPUH_O&_nc_oc=AdqO9AZDlgldtKq52AjbiVN8Gjv0ICfNJ5DUYxwC6yFJmfx0r3m-1lbmUcLNlbXz6Tg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT79NkZ-h__Zr7ylL4oaxhHa8TdAN_cvJZ-zJy3hgqO4Q&oe=6AF34909"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1D-I0YpDlr4Q7kNvwGlsp1K&_nc_oc=AdolOTd_I2ODNq1WUjwG-UFU40qC3u8hg-qfFzMovKfaDc5CaKKEGUBO8KiCRnKAO_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmlQVa09cW6RbTF1JapcoD_HatCC7dfw6K0Y_zIgyZAA&oe=6AF3497B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WW8Tx1ENq-sQ7kNvwF3AN00&_nc_oc=AdrCsLHy9PDd1BXFdcfJqT8uAd34nyWVEftxUxuakV4VK4Jdjq6mPJJ2cxpXHbh9zUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDW0P121lM-7uQuQgnAYfMHdQB_mxDeAYQrChIifwbfA&oe=6AF32D57"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVPEygO732sQ7kNvwFteIjM&_nc_oc=AdrsXaQHsm_hbd21L434W_nJfDPXbJn9YLGqM6Vwjjs3yoySV-fIfyYvW73bcCEiDlg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYKxExxhHS96Ek_gH1bhGWgNhKsCalQ-Yumtf1kGw0pg&oe=6AF33BCD"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG3BgidWEpgQ7kNvwGD1XhL&_nc_oc=Adp4n2yWnoXfDP-RJlJec59FPYeHdR80ZVjFsFsO93cvS7o0StoD3H2I1f0CwNxYWTs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUc_Yz2ftoHSxCdWTDIHhgJhiDEZtCnJiuUbBtGjaNcQ&oe=6AF345DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx6awmd3tOwQ7kNvwHxIHsf&_nc_oc=AdqlhAEKncyWApxBZz7Kuu2iiyWhN4UPbKdvhWB8ADAafkFADSyHOWN6BOMw4sCy10A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd8MUeSPHYpL23Ii22wUxJ-engjY86lKAGI8fm6iOT7Q&oe=6AF35B43"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
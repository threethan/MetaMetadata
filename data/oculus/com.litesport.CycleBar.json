E", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V34CzC9R5-cQ7kNvwE3bCc7&_nc_oc=Adp7OpDEOvoaUQrzbLQl9L0inPINU7W13DNzbpiOBftqNvbNGOC3TmNZpbbm5wmCJUA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9acEtwKiZFQ1dwJskN2lmBwOHovqbxcn_1jnbo9-Hk8w&oe=6A32A6E3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkccBhQgJ7wQ7kNvwGEcwjR&_nc_oc=Ado0HpWpeQHgBUqVT_V3Q0PXYC9A4JuwnFZVHwawAXzSPURvZvS2NdxA-qo3nO-dg48&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BuwFh5G_ACBWAflfykAC7Hb54ImpRnrznmGjxn3p4RQ&oe=6A3295C9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVIxK_kyEw0Q7kNvwF177nv&_nc_oc=AdrmvZaDrhn7H_s56jU5KZHKysUWR9x8nORf1DAAjqhUCOXhetjFsKfZqAGKBZxAacs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1ZffwgKu8mV3r_D4k99fIch45Qp7UEK9UpderrBeOOA&oe=6A32963B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEmSbQ2aC5oQ7kNvwH2xUSc&_nc_oc=Adoe_TaWkACq5vFDAb2x6yyuoad5St3P0PpETotf4uZA1PhA2PMIqge30mwDR1dDvgc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Za8G4CYBlDJoJliyq75YVZ33zvC6G8Ei36vfutPiyNQ&oe=6A32B257"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AC_Mr7eSPM4Q7kNvwGOTPXG&_nc_oc=AdpNWQoXASvd-RJDOmcR3eQ0cJp59Q9HVU5QYeYFeTZ3YJgw9FwCdZYDvNX96GUc32I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RFSMj1H_injzyGKqS-5XW4neNL2sWLM2mA_zCJVMLMA&oe=6A32C0CD"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVAViTopaIcQ7kNvwEjtrtQ&_nc_oc=AdpaqRaFtlbSE6PXa6aVK8mRo6TGc7w4N0GUnmGtjhKSzv0j37fLuOY7z0AXhMcu0tA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nDTxfENlErzy7n9E-OgDefg9KVhafU-IVdZSO_GSxOA&oe=6A32929C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0Aw7nGjKl8Q7kNvwHYO7Yh&_nc_oc=Adpi0ZZzR2yl5PHIZY0oVaKbwPBsG6VXJANr-M02VyinjrRhDQRVxbJF4HdC4NpCCHI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i2W7j9b7OXK1W5fAq4jXgqcBss0LinL0VUKlVndag0A&oe=6A32A803"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
E", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQ4GyXxYxCAQ7kNvwH2L4Ol&_nc_oc=Adqjm7b0SQJHS4GC3nN15tWy3S-ArWL18GrKsJ005SO5W1Q5fJiX6N0KRZp1YXvaqpw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsEDBhjwo2ySw0IY4CD9ooy-8Dt7132bPIE1hIk-cbqQ&oe=6AC4FD63"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sP7xhL3BlTEQ7kNvwGZYMrq&_nc_oc=AdpTYAHlOWsJkytp8eCc83pKNXqRIbx7sCgt1PfG0-GvX0ijgaEf5SlzYXcParadLCk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOItNI3Ux89g_IfyWHtD00iXNQDwKq9w_Kw1n85dilsaw&oe=6AC52489"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obS26tEUt1gQ7kNvwE4G6RJ&_nc_oc=AdrRbn5hNVdeXfEkhlHKAV02bSmYJgzA32qvY8l4FuPhi76dgdJhQwr1-2G6Si2pZyM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMd5hgsyBKBeFTMHytSjQmuFHchmShZLu-0oUdygJ7aw&oe=6AC524FB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYpZ28vHQGAQ7kNvwG-bYaN&_nc_oc=AdoXItD18uW1_4t980tB1XReAenuteE0EQMMgR2gC8Zpkv1JP6tMf6mJ_oUEUyo1K-s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgSLmKvVyQwNkUZfxtIsApKdMsBNREtOHi1cgEcgh6cg&oe=6AC508D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxKncpM4_egQ7kNvwFmnKuG&_nc_oc=AdrBqupzzfZUMfa_aPPPxr2ufKAj3NkrSC370prwJOFKSXZvIbsoZg9vhz956yTXPOw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFMkRMlRQWAspmimi-7TkNPZhRaWXoZcH4h8p44vA2Bw&oe=6AC5174D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByX_KKyLkk8Q7kNvwEmkeIQ&_nc_oc=Adp5HlBNnm62Z0VyP3N43U_boD9qugUdBxxxpvOB2Dqol-fHNKSRowhYxbqBXspTo84&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtUdxmxjyrUseqym0EtuAowrU8SYJKh9_FP_Kj-67gUw&oe=6AC5215C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tC0nee6ZwIQ7kNvwFCoa59&_nc_oc=Adr4mYCqkkPlXHMC7ygh4MAdJP3LP_4FwaTRI8DzxZKzAry0KlzZ9rypPNyWRdLZ93s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLnWf5EvtaXO6dIM6QN9ywTt441aOMlwpfP8QCyt8b-A&oe=6AC4FE83"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
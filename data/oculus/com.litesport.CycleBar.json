E", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uS-jluq5vCQQ7kNvwGDAXHM&_nc_oc=AdpwiBLuMNUs_AZVQRpTj1T-bEARTOSoOqWkJkARGmuFyCrptoutDQ99DpDcrnR313E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94yQD5_zfkkc2nFBhsyzKJRCLhc1Ne5__qTX55ULjPug&oe=6A33F863"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePhW3gXM1eIQ7kNvwEn4nvS&_nc_oc=AdrYn2cdmRL6ihhfGY4WQoj02XYSQQgyVC01nvdjJ8fyKE3ZyH5m9dUwFiiaccwHMgA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g0QYWgvGQFvHQruW2NeMU3YiE0uFmB3LrxEc1TD7amQ&oe=6A341F89"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVIxK_kyEw0Q7kNvwEU1XRx&_nc_oc=AdpG5-3yOxmXMCEFLoaqhBY11aJGQT8KdcP3zzKvyMuDGkRCmJId8punymf8mRqqjvQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86k3YAJKhH1kIqbc4_47df0HIt85lCkfnOLbjUFcydGg&oe=6A341FFB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5gWSfTXe60Q7kNvwHroDbB&_nc_oc=Adp2MvSEBRymxFgubxWYn1UXIMQtRrUrrQ_sh9iOQ6typ-MgfHsabkwH1-bc7AsKDFs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YVh81LksV4wAe_69F-48rKa0Qs-3vBU02nTptEPsHBQ&oe=6A3403D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BClVLZQPKHwQ7kNvwGye4oJ&_nc_oc=AdoZVyn2jRD4nBv8xslsgkqr0J6Her-fQAGTzX6X9bAoB93uGcmZOGz5B0QCj6vBnYk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a0bxyoG4tnDHySb9C-gX-USN2VOWUS46RXDRN_mcrfg&oe=6A34124D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVAViTopaIcQ7kNvwEXQLq6&_nc_oc=Adojp1GnyzZYwJlmuSE1tqhxSRGrjtGJoDRX2BsrfbXVE8hc4K8bW8OtYpSSMQde36Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tWnRzWzotHqA68pbMuhOwbUvkL37mPn1NDDrl1spxaA&oe=6A341C5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0Aw7nGjKl8Q7kNvwEUj17F&_nc_oc=Adrw42yeySVQwqP1yU5kFZ3DjAYMEn4v16mzJKjUo-hpmQ6mCJ3Q7AA5zBaKNYCBxoQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4n_zM-pesoLa2wcohDV0VH_dnpW7JSkOJIJmL7xp5Bg&oe=6A33F983"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
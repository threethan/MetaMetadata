E", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fh_rXGXSiWoQ7kNvwEu7YrQ&_nc_oc=Adrv4hN3bGNlgSdTnXGc7DkpJcR7_-PbZPuf_O_xLbINRsqjsOCMpRd8yVK3PJXqJfU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ehQ1NqNRmNMQtqwVanINslt8xXQGrYp8hy5pUUi3k_Q&oe=6A218363"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJKkZSZCgu4Q7kNvwHfCvfg&_nc_oc=AdqEuwQoFUyja785UQBWIeoHLauFk0p55gZ1cJMP03PpzG04vw3k4PsIEKx0YU8GnFI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94mMUTBLjz0BoD2x-ONx5BIOQ95YcMUqtNlKnTWzBIcQ&oe=6A217249"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgxg7K0U2HEQ7kNvwGc7DSs&_nc_oc=AdohForcq7QzgCOKpZW5xCjuCgzmywFbSFndqlTyg9ZjW6SiR0CkozxzeidetPvgeQc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PjwkFSlW2d--2j-yH5tbnM8FVUlEQS0YLfy7bzbhv6Q&oe=6A2172BB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Izo031VEyOAQ7kNvwF_g50s&_nc_oc=Adr7SLgVHCqk6UtJD99amlhXggGOri7hUnQqAzoIsTOMHtslhl_fj6jNCjh1_9TETKU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gnrWOIjjwGMoCQC5fTCNm0-byzd-Z7yXPWjH9VzILCQ&oe=6A218ED7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgBdFr207yMQ7kNvwGkxFdd&_nc_oc=AdoMppUUYLLOotpsNDIP-Oh14SMIArZdVUHQGHlTeSavlZunOz_WqSWeF1XBkdnHTvc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-dEwesPD22fjFq5jIphgUGROtnyHByj-mjNOk5Qaoew&oe=6A219D4D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzdWM2RkYsMQ7kNvwH7Ri1w&_nc_oc=AdoZGBTgCYavnUxnhYUG-2lsbIx9wtGjmsFBiWdr8K2eytZ_Fcc6TU7K-mR-1y7015Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fNbJxpyCewIDZTpjSinPI53J0gyzZ-CqWQGjx1rddpQ&oe=6A21A75C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WH-D2LldVakQ7kNvwFTWYZO&_nc_oc=AdplD5gQu7J6XodhqBK8VQGqXl3akIP8b2dm8kquTGGMsI8XMaWtOUUImjzv2TjLfH4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mwvA6QUUxJyucClP7iNAw2DqMvcdpDeGzt64N-9Ub_w&oe=6A218483"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
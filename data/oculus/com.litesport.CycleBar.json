E", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DnFFGdEBqMQ7kNvwFlrHPC&_nc_oc=AdpA_CNnvh6ib3zLblgWxcMKZyYB92q0SrI5sa9UBktBAz3QZxULV9273b3Bvd9M1Yw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_dUXnyoFH6lTugEEcEHHVmoupVrqdKqVJfuSXy6f5aQ&oe=6A5B8563"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0D3wZTSLKCcQ7kNvwE6dLHY&_nc_oc=AdrZi1MbigY6XLUuYAas50AbtUeTT5lwa5ZhvCK8xqWV72olxaod97LQhPbnwemDcMk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9l15olRW4Tzvd0yscUfjEzDHJ6-0awtVG9UGmTRlMaA&oe=6A5B7449"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JBYI0-w1WYQ7kNvwFWpMkQ&_nc_oc=Adr9n1L2teAzOQGYNuox6jGjTbgttNvmUdBP6cpBdqeAAAcuFY-3LRRPkJaRtT3JMKs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9D-EemaYB5qNmtNzRvGef_IoejqVjScjIg7BlXLC_Ug&oe=6A5B74BB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqWt69xVsjQQ7kNvwHE0aEv&_nc_oc=AdojMUobZaPFoftY6ZFrKb5uU-bMbbZMDnBPxEHfTqBWXBw60fN-4nSwRz7r9Pf3MZY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1rvjUj7UI4o6L71n5sUvlSfEfhfDc0LVQvOdRFQPluA&oe=6A5B90D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjiaOui5ZUcQ7kNvwHP9j5n&_nc_oc=AdpVMdk_M4HjRC_FCndFUTNEnHka1soUWTey4IIO03DhT62S6ljDHX-kr1e3ua2KYig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyUmzYWtsaLmaig8XS3j9yLnw4Wwi2gME3IQLQkoNx9A&oe=6A5B670D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WowhGlukXFsQ7kNvwHWdkMr&_nc_oc=AdoFf-n2uIqrjQuT5EiZrhhv6zsKsYSdeyqTj0CU5rqm3a80Xaik6xH6LAUeO5XL3yM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAk0z3ooFJ8cKBYySd8RmkL-k2d6huPMSfiNcPupfc9lg&oe=6A5B711C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwvT2NqLjSwQ7kNvwEVw-ox&_nc_oc=AdoCrr-e136XMHckqMYs5jRwSqt2qFM_SCd-hJyXn8dWhIsT_Ko-w_kSnbkc-rIat6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0RG5FRgmxaH1gj4ty8hxnNEAl465D68qcWwdHfVZ7nw&oe=6A5B8683"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
E", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2AVnLpxsmMQ7kNvwFwDg-V&_nc_oc=AdoqWGcZ1PuenxQ3yczaeYv-Okg5UdK19IEW4V0PH8QprfD72U1m4BZ3buvC3RTpZKI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKiOyny4T5ewfxW-hCYQzyz5DlkAh1qr0XxAr0Pc___A&oe=6A71EEE3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTwZO2ej8vMQ7kNvwF_M1Wv&_nc_oc=Adqeor3M4_jyqKhpzmas5nwFcsTijYWvZIQ7F0UNdGokIKetU1lzo48DkjXhWRRrZJs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcHsnCOLIvt_YP-yLvL1f2fiOuK1osyhysP9iuhHKipg&oe=6A71DDC9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLZqVacLBbIQ7kNvwGfWCBz&_nc_oc=AdpObncViTNMxNTEwnpO2g8zGF61a6qXQzREPYA40pupJjf-LAx8d0Yyq08ykcAAFA8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdfUfqB7hEXL-5OD-vfP1Ht-RQeJQ95Kb9zme5vzp6QQ&oe=6A71DE3B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSXcHV2Nr4wQ7kNvwFYJGrG&_nc_oc=Adr2fWYomiE2XgpEd6CJggyUGxsnN3Zm9qI3UuSm3k1MzJLT2biLxMU9cl02T3L8T1E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQObVK30D8XYAMJPZ3FsNBtWE81HigJQLGR14foC_ggw&oe=6A71FA57"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4eRnhUFsNsQ7kNvwFM00lN&_nc_oc=AdqRSc8wGuooPP8PidZYVgpgQJ-8DKKppmBI-it1_uML63NCU2IqffHGzsH_GvVYIkU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqaLhYktRdXfx7Ei9ZtfKPJ7JBfcHEfm2jOvDGj6NiYw&oe=6A71D08D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIyW5ZC14HgQ7kNvwHQA4Vc&_nc_oc=AdriGG6KmdjaKVup5lpTFr0qdqcqx9UfesgfEGp9olj6X63Pxc37cslsQAtfjzgccMQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSHNOb1ezLbmxYSKv_8ogT6rTLjcLabSZjJtS_YseiQA&oe=6A71DA9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqZfa5OEf3EQ7kNvwGCzai8&_nc_oc=Adox7lum_aPjMKNa12EzbUEKqs9e6K6qHHN99EdR_IIoA2Cd66B5Y37bIRiVR4bt8nA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGFLq5SEbgwdAH3Uas07Peero8JgJ5VFkpSCnRv1x3QQ&oe=6A71F003"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
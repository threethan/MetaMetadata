E", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9-FlNX0occQ7kNvwG_D6i4&_nc_oc=AdrKIg7Oo8ztaPSB3Cf7sCjCsdFfuTuYpheg5PwbDBu5cY_YgzTb6z4PipafhFTbv1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31BfXmn85TqqVYCSpJ6EEHw4m-9OQkNWhV8QQMZM8ZIg&oe=69D900E3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO6hxNx5z8UQ7kNvwFFZmpj&_nc_oc=AdpaMw0JQU5Afw-2oMo6im7bQF3EQoJ4MtIXecBKSqDQhKGdEAPBCpNSyDzDo2zXbFM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E6DO0GWEI9oTiXmwjjtuGEotRApVmBEYZXggMv2H1vQ&oe=69D8EFC9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exPE0M6hSi4Q7kNvwGINo_W&_nc_oc=AdqOGSczppmmDJkhn5Smhv7ep7-dM09R0D0RtsCzPjnjbfow_59kSsKVNuWtTIygH5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Qj015dweoIlNUnlTdvdO7x-5xfF8nnzAr9ysZGLufCQ&oe=69D8F03B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cU7hexbMgU4Q7kNvwErnB2U&_nc_oc=AdprrpGR2KlL65qZG2LMwp6fyxP0x3-IN5qO4EtNnML9_2Iw6caOV23zvKReuql1J1g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3U7L6NzFrvyvYZdd1_GcxhX6cBmuwToH_el7Zzv2yilA&oe=69D90C57"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8c50zAHOTkQ7kNvwEE9Idk&_nc_oc=AdqOkclVJ0QxeBWjHj6GkIUB1Lb01GlLJqionmfpgskKj5hPTGbJsSXXzKyhxk5IUFM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LOmpfMZjfLsWjUqjeK-WR4UgAaSqN0oB9wcjXWuLqJg&oe=69D8E28D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SJCuUGxfNIQ7kNvwFMMOWr&_nc_oc=AdpX6jAxtmWOTkShMnwrGocqmbg90HBq0E6QZ-UunzYNFdwvbhfCmXxZMPkFuWbz2aY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nkMSDNpZNt6E4GJT8HT37FOZpgTtku4lN9w1hDsa7CA&oe=69D8EC9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfWI_0uCeWQQ7kNvwHgY4W3&_nc_oc=AdruX1AOfaYjxmENW8NVdzKlSlk6c9l4t5S0rjp8GKzrLg4qvv0rBCprdR_1dFiy1FM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-3Me47K8fvrAq09JKMKj-itJ2FzWBpFJvIqWUflPuwQ&oe=69D90203"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
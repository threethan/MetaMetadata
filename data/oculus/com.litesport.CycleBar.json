E", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UiQ0z2WEMMQ7kNvwFXe9T2&_nc_oc=Adpq1pfVOLkqzZfeifWAv595DyAMIu3y0B3L6GYpxU1MkKfhPuppzn32X4YFGhHftes&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfA4N5qCtzanSs5cAAugK5wnaErGGAB_mvqJ7gIq_tog&oe=6A915AA3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1U2ji_ZkZXMQ7kNvwEDYk43&_nc_oc=AdqRSEEhdGIkGq5B2EiLWq5mYVW6OIlTcUcqMjKc5B_0Rs2d2h8ksUm-V7gCFPJncVs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjvM5vpBgcF_rQiKhf165ihB3MJPztfjd664NId29mOQ&oe=6A9181C9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEX_x5X4xmYQ7kNvwHOV3S0&_nc_oc=AdqGjsRuZuLJ0wrXhKwXCtiPFqVCjnRem9xSZyVEHH6wklVlOYl4rNcLRMe0THKgFyQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKylvSkr7HHWzG0b0zsWyTAIg3fdKLtkSKT9RZo1prHw&oe=6A91823B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNsNwo7Am5kQ7kNvwFMn2kq&_nc_oc=AdrTZ7Cv_T3ZTjedXRJ5Ppd7PWeQZ1lslna6X1a0snVXItuw47gZJQ053Kr_A5nc4Cw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7x0eAU4bfjxLFUOrfRRnnogGIDuwhOIbNFMu59qiXBw&oe=6A916617"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEJ1BdwujSgQ7kNvwFhHOLV&_nc_oc=Adqx6FLTQbPn4QS3Kmap6np1VlEPq9FA4JhSvaSqJfwZ5acGHnytNQr6gYmvl4ozDGQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5CltJ-ons0MN1Lf65S4d1BhHNzXdb7as9UqZJEVj6qQ&oe=6A91748D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka4Z4utOLBUQ7kNvwH6kfdf&_nc_oc=Ado90GmgfxLWvKDSZMGnwZJpo_qpzUsCb6MlETAMrOcAuKObDxL5YbM1UPJ7CMYZ_7A&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSJSL7-NUJKN2cyoBIxtClqEEXORkU4_GsSwPVJJ3nzw&oe=6A917E9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHgXXSNaUYgQ7kNvwGcbzxN&_nc_oc=AdqX7PWtkZtwm22PhdQ8MP5zf2DcXoF-0dVB9kE62vxzxgscOldI1a2YhkUAn87VaJ4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuQDSO4WXEQsyrzjO-Tn_sOh7WHHoob3_VFFgfNskE4Q&oe=6A915BC3"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
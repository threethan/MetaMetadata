E", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGBudimv5ToQ7kNvwGvnwxW&_nc_oc=Adp1OUTaPpz-2x8X1yL039vwlHiZ4UE6F2hlQX0NjPNuOW6Lzkt5WRXD70wKJLVQvxU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKz8NFIdvxw4xqTQ3YESO3JMsTxdYFptzdS2v9LxNkyg&oe=6A9ACD63"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL7t4SswlmoQ7kNvwEYRUzL&_nc_oc=AdpRfgqPNJqe0gwCpox39iSHO3ow4gU_FG_Rq4zTb3dEBqFRYgCgbJ95jBo5Ca4vBcQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWvBvCRM7qc4CLrsRJWy5-2OtHGrZ_PYoZ-SEXbU4xwQ&oe=6A9AF489"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaiNiG1RY28Q7kNvwHVJGQ8&_nc_oc=AdrHCvKOIMe_4hFSnFv4Df-xg1Vt_TVft1aFwX08Q6gwmF6JkrNy34uVMKtT40eotFw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHCLw6TdsCQNvyTjv9kH7o-TMqbNw-F4azM1C2KNtPHA&oe=6A9AF4FB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5tm_PsOrxsQ7kNvwEiDYac&_nc_oc=AdqUEF6UG93LsxbQGeTHwSTsd60c5nURHMTmwEUlXgmPobHp5kFa71NbU8HuZdMirWk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUSr5Mh2BZj3SiZJxags8pVUDw2NKJspq3stAbvfAEKA&oe=6A9AD8D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YWF1E7b-9EQ7kNvwEQIfkL&_nc_oc=AdoJNEbvLxYYojuLtWo54SZ3YcfxDWZei-IJmnz71N-3V0-XqXsOC8H0G-YVbpB5eLQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ0CD76bV4YBaROZzOqyHBNwaTtS2NY0No94Hj7JG2_Q&oe=6A9AE74D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r1Sa98BEQEQ7kNvwGkqINL&_nc_oc=AdpHR6kDamxYXr7M0oI8U9FRZdfvMVAW5qtQNth3qHA6i_G7nBbaLaoEMKn4X7xC_K8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY0cFHjfqlQCbBstkIEQtBwiS5djnwzAg4wB5F7OfI1w&oe=6A9AF15C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UytGRT-DS9gQ7kNvwEK5Z4M&_nc_oc=Adr4dNfRlfCsQuFWUhkxhCjOEj4ILxGL7b4AhbmAgpFZLR_CYC5I56zHqa1aADLaqrI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdOxG8hbfd2Z0oTw9DJ4NxGbEDoL1p8OAvxb5mLKWfjQ&oe=6A9ACE83"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
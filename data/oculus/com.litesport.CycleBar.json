E", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9nXoxeoEisQ7kNvwEiZnll&_nc_oc=Adp0Jth_sX-x3Eb9QLU5EnZfAa9t-ePZ7Z81CsrMH_wpUs5DQJdFXpfoTDT0ZV96DnI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqlpoyDR9hx-KeLVK80or8lcvgPtsxCn-vFo-OxXHMXQ&oe=6AB52B63"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2O_pbl_e-sQ7kNvwGphxnM&_nc_oc=AdpDveg4zEyy0isBugHV1DO91i2EepsxWGpk91RjVcMzmoUhOSILgkDtUPU52kCmfRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5m44jlIIJhuzfQ-DqDSiRdszwAVvB7B7TwotAd1PBjw&oe=6AB51A49"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9ng8f48gUYQ7kNvwERlfHW&_nc_oc=AdqfyUZmkSl-CEYToseHiJgLHknMj5IypXGibgGUIgXTNBEbsPezpvQhVWYEH3zu_qA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj4Pyau8PrqT-Lj7EH33msZYSBvsUS3-bIa2Hvah90yw&oe=6AB51ABB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6kW5yr1XFIQ7kNvwEVmT7q&_nc_oc=Adq76RhIgIL5I7J8dMp2kZriCsLKrBY2yBCzhem3x7-mf7vkOMV46fFfBE7PivgJA98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-JupnzXe7omZoRNzgGuzXV2WzKXdk1xV4tEIb6gojiw&oe=6AB536D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZssjeaWu24Q7kNvwHxVEWE&_nc_oc=Adre0_WcnP7nZdaUyGW4niXbP0eIbMpud2ev3X2KWBDChuMaWKEa4yUzXp9UvFaQUEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLXJb_YJ9aDcZQWU8wBC6YVn_u3J2qOL8XZEejbKynFQ&oe=6AB5454D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOcwdXguCzoQ7kNvwGgZ5vm&_nc_oc=AdpGioobTh2Znnh8UBA61PWg6utKVgfOA4wv_hRYlXNjG2rwWba0jyBjf7wzHYRe8Lk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCOCnH38KZXhNHlXE6w9FZup5W9iW-1AYU2yOvQvEpmg&oe=6AB5171C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RocVfGk3PN8Q7kNvwGgWXLK&_nc_oc=AdreRun-qvL-4KXbcy0r1epvhVKgXKlSshJ3vFulTbFtS-fH-iXDbF-o4C_ksp-vdT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-hNjzJ9NTOozS7Jpbwag3h0Re0i5DuPgDG0zDl5jhvA&oe=6AB52C83"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
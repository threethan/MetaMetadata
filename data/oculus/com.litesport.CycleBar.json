E", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baWIgfGesYQQ7kNvwFnYp3E&_nc_oc=AdpzpxB3UECgvvU3nA_Ec3Zwcxtk-r5GNvoqMcEEKF5imL8YSlGvvutZmL38hwPGTjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af780Tp_7dhlFHl-XbL2mfHD1xyMgm6Vssx8YiRqNrhlWA&oe=6A048263"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnCb47EqB3YQ7kNvwH9_feJ&_nc_oc=Adpu0WfXnC2Wbq4Vg1SU76yHqB5Lv7PtNF7SSQs6ma7Yv-aYkrBCy_jjWp99gi9G9YM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53JCVuI1N4wLBP7acL_nuMXt52h-_rbXC6nKzMU_UiLg&oe=6A047149"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tJ_sk0Tg4cQ7kNvwH0YC1l&_nc_oc=AdodD96uZIOI1Ht3MAZV5fTCW5UOW-gWHjTo5DIRx3bRFRxSFOnHB_BRtvBzRUXWh0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s5bWBBXPiEkGTUH0Klot1x0q1KMjL5bO8VwgybkHJbg&oe=6A0471BB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYKlHfLHhCkQ7kNvwH_NwHl&_nc_oc=AdptLksMmhDAasKxCvTofxDzNeT26qkv6f82PPf_VglVikUUVsSalcPtCE2J8C-2hGw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7znz3wwp9oGzshxA-ZB2mze_V6b9MkWTfaLmH1tWt5Ag&oe=6A048DD7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w69ZWhNUbIoQ7kNvwEpur1v&_nc_oc=AdpMDKmdOjENh68z8tRUDibYAa3tDF5UqwE9HSchCG-O09T840T-HCh_LYo0Wop6Fxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rU_uCS442xZT6DPjGN3oECLk5uKR86DYF4Zvz1oZe3w&oe=6A04640D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8VzXOhfDpIQ7kNvwFaj_Iq&_nc_oc=AdqX_9DkZLFzLu30f-c6wDlrxRf1oHipelfaGYGycIZzf_KETKW3K79BOy4hq_4QXOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q162ShbmdTIfDJu0AfI-bua-TPCoI-lGQdiXJ1QprGA&oe=6A046E1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43-5Fy-QRpgQ7kNvwEF7UcI&_nc_oc=Ado7m_BEo8ufNaqAavAr_JjU7pQLZOcBfHb5b5zK5Wg5O95OGx5hhVTbcatfBwYzM0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GoHmkf2MmG8Rp98Frulji_afmJNcetKZWJDY9dwJqOg&oe=6A048383"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
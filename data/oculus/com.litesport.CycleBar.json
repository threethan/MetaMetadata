E", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN-yEFr7Fk8Q7kNvwEN_ua2&_nc_oc=AdqRkGUG-B8bZQ3Y6MrDWLl5boI8Mu_Pn_1ZmMur78rtsPC9AYDcewTsg5B75H7grMU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcMMFA6wOKOnjFipDip0hsYjgOOvAxgU5Qbab6Iw1OEA&oe=6AE895E3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSKtrQJaX10Q7kNvwGB8mek&_nc_oc=AdoS-FKWb02tjplJ3a-SmyPmgDieHJ575edL0jIhnlShVtqeWRsojsGGqWrq-GtrYb4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi_EEd4Mo1mG0141PwYu4peSTNyjTpHHAh5P37pA9GGA&oe=6AE8BD09"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DQu93D_Wv0Q7kNvwEQKBPc&_nc_oc=AdrXz74aF6KSwetKNO_6Q9vVczAYFkkPJL2bc9EgNxbBFkpYPZp-vK_t7itQgGr3GAs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBLJ6jC07knUqr30FiKbvexnnfjorXJC2aQehx19f-OA&oe=6AE8BD7B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=980lvVJTR0MQ7kNvwHGhPSI&_nc_oc=AdraA9fI_UBzB_I4-zQFYvS8tTL2Z5e-Xha0NyvHG4fRKajxVnOtgQqOx_eEXUkOE6w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_LVnlM5ISsly2oGLQkBXTT927rCDF6pJn0IY1VqnIOw&oe=6AE8A157"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61kupm-xG8cQ7kNvwF-iw6A&_nc_oc=AdrnenV7on-DUNvN_sgF0U8_G9q6nhmndk_73Lry_-Z1zuBWbcngPBe_U-Ds48L0vWE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwTIie3RanQUfFDRikDr0e1qSDDvuO1IXp_tNyb50zBw&oe=6AE8AFCD"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSNiuqnK6q8Q7kNvwGQEehV&_nc_oc=AdrSFi8WFnIT-mA1cvPUjPMXQp0UAG1UpKBiHt95J8bnBlptypb7OzgUBa5YNqGTOn8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2M92-pZon9wgKEctGoNYB5R6iTxwOrhDbzdsUYmedsw&oe=6AE8B9DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IBYYAtYaP8Q7kNvwHiYtkY&_nc_oc=Adq4BHKkKIrqZJkwCerbHsu1-bf8j4ve08wRcr5UfAExEoVX9qZXrJjhMMko-uWMomI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDCTfyyYz6P31Neg5163l6VQKPZRX2ug00ljfQMQlDng&oe=6AE89703"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
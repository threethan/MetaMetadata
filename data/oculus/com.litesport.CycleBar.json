E", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V34CzC9R5-cQ7kNvwFixYrU&_nc_oc=AdrYv18T18uz5qONmQ7p6XZAXP_mEWn1Ly8_NwLYGAQE7ybirYMgCXmQYroRcVJN0Rg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84iatjKVFSt5MxVgGdHw_d8WLl1wBU6FHzNTeZ4D1dWg&oe=6A3003E3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkccBhQgJ7wQ7kNvwHc1knN&_nc_oc=Ado4rZK9CRwvnvx_SpnQWYHhaqKU_6ggxoP0Qj7mDmZri2w1kfl78QXOb8Xrj236bxU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fW4_eZlONZ_yloNbc8HBr8ZkVAJliGr-Z244VpORGWw&oe=6A2FF2C9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAq8B2MlMEAQ7kNvwFH8jmj&_nc_oc=AdqffZVWRueEPx2Z6_qRKzWhbgUjbPm2qeg9D95sxlnx3-M2pqovRWgAekM6_2c1abU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KeowRRcfDKJ3sge-3I-bJo1OLjqtoQLq9hPcsbfNjlg&oe=6A2FF33B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEmSbQ2aC5oQ7kNvwHxiK8N&_nc_oc=Adpj0kJBiK8t9u4iYB8TMsiYZAzuLuyRJKuzIjMEnIfKlHEmUKG2Th5weyZI4WsSyFw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9InTpEWrJacDXcgrT_gKWx4NjXII-lDUIBHADP_Ll5hw&oe=6A300F57"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AC_Mr7eSPM4Q7kNvwFRAOd3&_nc_oc=AdrLT-Mi0748V5kt03Re7oGPuV0UBKNXprpwlksKfVrQqVJpp6K4iCfPz1U5g2MM6tM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vsorgwaltlo6K5ElDq2AquD2SpFJFade19r_mjOBU2g&oe=6A301DCD"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4wp6f62SBUQ7kNvwFhagRx&_nc_oc=Ado0K78AXa39h1VCP6eNBNBlVzMeLUzCIVbdsWU39GAaUfOlEYIEfC577cyZsu9bd6w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IFIHxD8N2YR5bQ10hMPtUNlfkxe8KNasgQksGcr_0GA&oe=6A3027DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjAnZiFPHYAQ7kNvwGRxDEU&_nc_oc=Adpp1ttgA9q2RIAMzyaOLYBUGwJ4sON6VFrw42TUYe_3GIaeolWRTTqOFfshUOD4e_o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dKvYW0NZz10h4NKmXOM7MdJfLorJZps1yS0aD4KjPfg&oe=6A300503"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
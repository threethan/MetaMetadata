E", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGBudimv5ToQ7kNvwHWQC-z&_nc_oc=Adq81CZGI14NvY5re5y3HEhoJPJCmLav1rY-eYgBfR-uvhZMuGRq7TxijSR5JaSRDwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyqPAz_is7SK_2vL0koVONCm220Vb48wVWtVZ6kG2fIQ&oe=6A9C1EE3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL7t4SswlmoQ7kNvwHHzKin&_nc_oc=Adq99lXor0UgPLKv7t8KQ1QkWX2CDSGXKqcHpURo9t_-bj2AnYFLU4jIGhyIDjOOdOg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIE6RA8cfW9mmULxonZCHLepKwBrdrL4jqJbGDfeZAFzA&oe=6A9C0DC9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiZVMqvA8y8Q7kNvwH313I5&_nc_oc=Adrk3w_xBSLhoVKUWlynzdsR9yqg6TfnfIhxzcsyEz5Tex627W9JIfHXLU4bxxMjGkY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFqKqutW6C9fxVJHOTjqMItdKTqdsXU9uqXDBE9hRsaA&oe=6A9C0E3B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5tm_PsOrxsQ7kNvwHNX_Ij&_nc_oc=Adq2GC9BbmeYnEFTlktLnpeIC-AYx900T2zZUW1Go914huRwe8mTtYV2eJR7fg8wDiM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4L1B0xYZXJB961h-ysMNm7rqiB6eHDdTqXWh-cCDgWQ&oe=6A9C2A57"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YWF1E7b-9EQ7kNvwFMysd8&_nc_oc=AdrDWo9WoNJqZDNPEnu0Y2LQGqBavErMCVJExu_rV9FV09blZkxjLHwly-EJhWttqmo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIm894kkvEiE4s554AKs3AcTSmtESOjBPKDynaC92QCQ&oe=6A9C38CD"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gfoxM7J5KcQ7kNvwFeeROR&_nc_oc=AdotoMI9wbADrACqoqJb4izF7SHQBfoqmoTff4cknOCUHHohcSqbHrxGfoWvL2Yp5FI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2q5K3PnJtTZMGhQ5XBb3-9vYQNB7QhDqzZuhRMqTdyA&oe=6A9C42DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UytGRT-DS9gQ7kNvwERdPla&_nc_oc=AdrOUU1Y-10v930gV0GXHqz7Gs1ZDyT-raozhxj8uCzxIA4m9Pd10qjOzLXrAQd4zvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-NOY3roWC26AD9yxGuNmdzRZoClbjIMAZ3CpBt_43AQ&oe=6A9C2003"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
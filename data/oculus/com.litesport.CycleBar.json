E", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UiQ0z2WEMMQ7kNvwGdBXia&_nc_oc=AdqxKHhT1q3j7YDa_oP8_lZnzXM2iY31Knv4iE7ltFxylQ1CA1SaOAydEh6bI1FVmKE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8RX4tYLY8GoQSt0ktH89wt6r4jINsJAdzUbpDLpyopA&oe=6A900923"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1U2ji_ZkZXMQ7kNvwGGxxoE&_nc_oc=AdrzwDjHe79-Y9pEL9yHvx6yMZ5mBcyuCHxKAwi1Gq9dqXgqGGYXgKgkocgIyy3Xekw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo-I24VjQyhrQncSZPSLPk8CAnYaDxRlhyqeMxfaHTFA&oe=6A903049"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEX_x5X4xmYQ7kNvwE4EyFx&_nc_oc=Adoy6nz_rFp_8sUGofEQ8qn7JM_QO6GJcRUMO6nU7TQSNX4DbWvRBjwQCcN3UChjHF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOc6m_oTJJKhD1vxPdIEMSM0eSaPvjl7KIeXq9fBafOA&oe=6A9030BB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNsNwo7Am5kQ7kNvwFX_ZLb&_nc_oc=Adpsep2FZMy_dDc_sKeYzCSVeg6LJio9p4Cg9nKZLPu45L3g23bI3jF0r9aXUb1obo8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQOrBS-x5GTmSKKqbF218MA1eutxP0iXCuyckITIgEaA&oe=6A901497"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEJ1BdwujSgQ7kNvwFch3BQ&_nc_oc=AdpWDZAOb7VpdL6_No-BQ_XkoHhY1AmfzqB7h5dkP3bbGJXp3MYybPAvudPdL30LB8M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAyJVrGCRy5XN4BVDp1ojqyyVmFFyA4lgafa3ZNMSwLQ&oe=6A90230D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka4Z4utOLBUQ7kNvwE_-dQw&_nc_oc=AdpHimSBN9YPzSgCnkScc29rgyfmYvAJ6kflxSVxzesgZyes-rUZjhxVizNBJ50xwcM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmrr5VoHJUj5oIE4bsk0S_Om-6NM6hZIdhMNdk2ulkxg&oe=6A902D1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxv1YOnZ0EAQ7kNvwGaazqR&_nc_oc=AdoL2JXSwCUweKua3I-orkB9CoTHAkZF_wtHutzfR76tcu0JTcKC4zYtVPIie1--Jg0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkqIQAfjNepS6sz0QOBAdQdYIPhiKmKCHjgj29x9hNxQ&oe=6A900A43"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
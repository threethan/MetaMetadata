E", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShyHhaTo5ZMQ7kNvwGops0L&_nc_oc=Adql5piAjQTfBqecfvFbmT5aK7qBp7phJXHoo5AbORszKAxTSjn8P7wNJSfN9lVSTck&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MSZs8KdXebYuf819iMdMAvU4ULuPE0bH0ULNNWQX2Lg&oe=69D26963"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeqKVA-GsUcQ7kNvwGsHeNi&_nc_oc=AdpWF86jS5-8yaZCCSQLkSORrKwaHSsr4zf8QBMT5uLY9qS6ajMtPzqiswGltx_CYZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VwbReQulT-cXds9dGQxZ1dYXfiAr4G0H7yvS2CemWnA&oe=69D25849"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gD6tjx7y_cQ7kNvwHGGOHQ&_nc_oc=AdpNqHBC05dRq9gI83qEMtTtYHJkhekOmf0BGNl1LFDeUK5qqZYwjrCPvkOpgWpqO-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3D91dyNGMIaaL8wdDaxoKu7FrYqGokM93wsaTdkX93Ag&oe=69D258BB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2fvMf0rWRwQ7kNvwEqDprO&_nc_oc=AdoHB4WZhYd27ls1NmHz5PbHkbmzG4WYh6YfyOKUvPcDe3zxImbLo6e2iUiB2kHkXvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35TVoL2e3VGMZpWJQ-hggYdJlpGDJCgjWHJZnljldrrA&oe=69D274D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gzFgLrfe7oQ7kNvwHS3TY5&_nc_oc=AdqBNPCJ48l6EpX7R11cNJn8fADrw3GEC4qR9o79Z37vnBBQqtmm0DUFLTrTBTyFn5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18YvFBQR3f-uYc7Kk1GcLoDVJ_QdCysg_dk6uW_D4irg&oe=69D24B0D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuIvVXpGsjMQ7kNvwE6ZHcN&_nc_oc=AdrhRiPC0wEkxwWyY31cmrMQWj3Ebz9Mi1iTSLxidVggksBwb-8BkSnnJAnUbTQy1Ok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00g4BNvG433xvOBJsetlX-mINhiaPu3SyE7mVaUvT6zg&oe=69D2551C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2H5CR5eJ54Q7kNvwF78zPC&_nc_oc=AdoNsl6hWD4QBkBM1dMSizo798NI5SkN8kRzVI2Wq292nvG5gaBjIbzHS6rRpL_3-DU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X7aRDLm23CazhRiFXpjWcGQP8N_U13FWpUzEbDZsnzA&oe=69D26A83"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
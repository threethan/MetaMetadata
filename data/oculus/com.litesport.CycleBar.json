E", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLldTtJJ0PMQ7kNvwEX91mv&_nc_oc=AdpKX4mIFoMy3G4UhETKq8JuwDNw1II6y-go7S7ejr-FZMxhrH-u0zFG7YcdDj8xoc4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xwQnuUEtDsWRHmQyJI7GEqqqXUyrzKJjvqo0eBLYj2w&oe=6A296C63"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z90tL8K4hdMQ7kNvwFuG4wC&_nc_oc=Adom74eGYHBZJXz_upXHdVplTXi-AGVmXn4_0Ol9ZCeunKwx-Uq_69p9uIFwVJf9Tho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OvrecYQfxMRL70l9j43WDUDb9qQ-UD3JJjkLfVIReJg&oe=6A295B49"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WcyOmcNEWEQ7kNvwFnhO_W&_nc_oc=AdrJo91mdvuAibjacvgShAB1igEwuhmLqENIH17UggcMseJYH7Bm0A8ZWBJZ6_SXFdE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wWFY2ib0lXI828FbMVC-OEGq2ZEmH6s7MSROSXSfFYw&oe=6A295BBB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pNq4s29wugQ7kNvwH3kDEE&_nc_oc=Adp-rJhDIAmtV8IoBLbTqHysXe_x1ACoV-NZQhal7v48i7V7cKosh6Aw8iUo8TkPGfI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88om-pr86kgByXVyqOC96YsnfqM0AtgcRjW_e7RJQEIw&oe=6A2977D7"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6cG3W9YKA0Q7kNvwH_WK2c&_nc_oc=AdrkZ78s35_GodpfluMeMDmlMaADDnBtTm_llIjr9cTTARAK2k-vO0ZvXK_vi5ZNZ7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vruyr2NLV5z7sszdD8eWlJ3E7k0QXNVE1qaGWM-AJ-Q&oe=6A29864D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmgJZ9YfhLoQ7kNvwE3kkdW&_nc_oc=AdrQq_SfbM9D4aQzaAOVQKhsNHBnWoaOEzlnF7XYH3TtieE5vMRlYLTZvh_dMeRy-wM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WJsJc-A04q956dmZWTNTYhDAwvq16aRQbep58_vFI9w&oe=6A29581C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPEC3rEymnwQ7kNvwGHN6xi&_nc_oc=AdqsIm9Lj-o237f6ZaO0Jrlvac0ckJGZY-OIOlVzL62qu9ccHYX-msutvTkBLofjd74&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZDZaec64yLlH0EcYsygxChbF7npkzt0-YKgYvFN5bIg&oe=6A296D83"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
E", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUfglSQxd18Q7kNvwHolK_d&_nc_oc=AdqpdIyKWcDw0ShbKpP3KHtWk0qCQxTDRjEzki2nx9W4QIB8S9wsggL2cDREbySOxu4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz3Wgm8-M69qgY-dejm8KedFQjsLeYf0gL2p51S-1-sg&oe=6A7734E3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pHE-5_4wJIQ7kNvwHSecN3&_nc_oc=AdomrWf1uO2qDZmI-Svqf1jscc8CW8d3UIsGC0QVYz-P-L7rmPxdI_SzhRG_2KtiNBU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYTKpV1jP2uK30lHx7JS0QDRhGSUxzzYtvRTMbAgeuEw&oe=6A7723C9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZZ3fe9b-YwQ7kNvwEnlb19&_nc_oc=Adottgkx0QLRjGdaDJx2hKfj8Mj4RHfcElDo5Q8RB-MkPu1idN9wbm9yFnbCJBcnD5s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdKmu93a46PR2ndA3sHjD-SGSoHdLtmtgJN2eaSEGGEw&oe=6A77243B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nNS4B9Yk7QQ7kNvwEtfVuJ&_nc_oc=AdptilDTAUODTPMRnYp4aeNUKzdY-0uKvVPQyKWVnYjEzVKqEFynCDbvYSXk09gePO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRyexUXKeYIri2WDhh8G6qz8j6oMtCkSTRjYfRT7LThQ&oe=6A774057"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGIf1iBEXT8Q7kNvwGepMR4&_nc_oc=Adoq_IDvJTJN_2lGYB7YgEkbxajqI88fUrb5LWAwgG1Suce9fzocd1NlM-PFlXCaeQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjeGqRxa9icdV-iFtNbROPxc98wmEeMhmSlBtgsMjmqg&oe=6A77168D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdLhbTFNJHAQ7kNvwFuyW71&_nc_oc=Ado5UvubVJiMJtMsti6fRJ5KpNG74kd_D99xLCHLN7Bb6akbUhBGgQrF72ULL7E7Ts0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPxesdjLVWqLHQqLQWbJJnBMdqOWpmrLXI28kUrHHJNA&oe=6A77209C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3ECjD6iNfwQ7kNvwGgJJLm&_nc_oc=AdqQqejbFHGj3WPfc9RaGm28WDgHrKZjso-96cgnafM7RPNrNqnfmJhMG4UBd_ABHSo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd66dcOm51gNjFo65qiyhpq8Rn4Px24Fiq4kw1U4bM8A&oe=6A773603"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
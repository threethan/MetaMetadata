E", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGOapJ27hoEQ7kNvwEmOHTt&_nc_oc=AdrfJPrHyR1Z_PZtdGuCdZ13VnGoDVdmHjB9inOh5JvjarRnjDsKiYtGAtMam6kEnls&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDdcRkoJwbyLYmM58x9ff20CLlF_20eJgs7oAaKaAakA&oe=6AB136E3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ei9NlXInuwQ7kNvwFbr6Ce&_nc_oc=Adp4JEjskn-_cHDu4RzBHBFXVyejaCExU7RBfJR4bYZMc7Qy07OS__Iji0-fuKyCVuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGSiM2AS1T-OY1a9a4NQHDBLACYlh26x-ZLZoWM83iGg&oe=6AB125C9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh5nmQwn71YQ7kNvwGK7qeP&_nc_oc=AdoSB3rbYCTcA6EP7zkHdtpZxa1WckYiiojJDRCi6dCqIoORgpNV0PGcUKKnWPU1lc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhvmgfkF9nw5Oom7fQOEa0_Ck2XBowCgXZ4hoUVWwrSQ&oe=6AB1263B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_iPuuV7yMUQ7kNvwERoK2W&_nc_oc=AdrGj5bknMpFW7z543Wu57_n3hC2Mfm2dLxZfE7Y8jtX0kq7F4YAT4zuz32mZMmpVwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRCulgNa2tXxesVuUUX9pSaSOwzULqdJU20QdaDfr9Xw&oe=6AB14257"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJnX_lpdlPoQ7kNvwEAk6Jl&_nc_oc=AdoVWMb3_gcCD7HkMgfpND1ocuckD-nfYxusRxKH7JsvRWpNNhmMnGGgvgFt3yO-szM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3l5syBw9GxtCB3mVeqlBFCb1toGI1oAZIpBvKlOivQQ&oe=6AB150CD"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIKMBB9kczQQ7kNvwHUlOmQ&_nc_oc=Adrr75CrdV3C8na4_dtWEgkmQ7lUNY9MviKT67l9-P3RBmYC4PdkglseEDrFHgW6hWQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe0U8F9KIyMNogoK2DxeMW-uJiaXx2gESrkcs0VbTN4w&oe=6AB1229C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nECZc0b_COUQ7kNvwGkAevh&_nc_oc=AdpQDcyDJ4-yV2eDPIDeXESIiViViQEJmDS-Sm6KteBGN8gBYGpgXUp8VwQLOdyt83E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDSX8q5onLyrITDuBdO32VukcZiZgipiYm_1Lrm2JCeg&oe=6AB13803"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
E", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ho4K_K-HnU8Q7kNvwFkRGbh&_nc_oc=AdpGdIr75WkyHTOS6zOLI-U68bXZPRuAwDrFU-nBt53gsBU85lwZKxw5Sr6_yhGZVI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfNUXmlgOOVr11LL4qRBB2LuAcphzASRon8chP0ubMIA&oe=6A8C14A3"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRevUaHrhfUQ7kNvwF--q-j&_nc_oc=AdoJ_WPx70l0kGXWADIqPjf6syw4mZy6c0lRP_AIxxEAaVyVqKbHCE43P4DjXLMf_HM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAF0TZC6PmkGGcKq77BNqcA3K9TRvoaqPiKdvuj2D_DQ&oe=6A8C3BC9"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEF5Ji9oRiAQ7kNvwHB5tz2&_nc_oc=AdrJz3QDyRZYas0Xvqk-7RqUB41Bm-7Rats6cn19il2ZNnJWW0P0wpyXDErGNVdVSe0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2UDBSjgnpMDAQ5lt656Vq8b1AoDR7g7dvgnoDyMHeKQ&oe=6A8C3C3B"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhYe_9HbpeIQ7kNvwFU9iJ_&_nc_oc=AdohPFnMN_gN5MAWnqVUoMyAUDXJWBg6Mv6Y8N_ySBYz0QE09y7xorxR7hFFCFWEq-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfnRmhNd-zn3DD0B_cTMf7CqjgQfc6wKbjqzctZ9HASA&oe=6A8C2017"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=955j6UmfwycQ7kNvwFKNeBf&_nc_oc=Adpp6eqamkz5GTuvTi_mevpoO3XmuaS1E5TLMreQglMvMLt3q4Mam7xAIAn5sZdUADE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTulqRVh28799ir12oIScml_PcDpVEBexnRr3SyX2sSQ&oe=6A8C2E8D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tU1vVeiOC9kQ7kNvwH27Adq&_nc_oc=AdrBKBKPxI9TSecI9VQLgHjo8pTvtAkkWC2In0Ccrs5uz7mT1FvF7oc68Yn-tmlsMjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_QpH29Z81enpppv9K34M3sWh2kle2guC-K1L6ofE_sw&oe=6A8C389C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1G4DsXNSnt4Q7kNvwEc4ffC&_nc_oc=AdpvZTJaPasRQqdwKNFlpJ4huh5qYSzHmEfpc8nfzMEGCM2tXp33UT9DWNB-DFW4yIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpF6IJUUkvOD3XSsp1IRPlSlfwnABKz09eOtiPbk0F4w&oe=6A8C15C3"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
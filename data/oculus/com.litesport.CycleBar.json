E", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982521_314645448342857_5411307760435559072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Qsntq-tk0oQ7kNvwHJNd9E&_nc_oc=Adr2V6m7pTkML38_AKIAv7kCxer4AFj2Wkszj50iqPZHFqIXPKwYwYQ8DhwQFfnNTtw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEthmpGFjPho5GATDcmUmqY6yBJ32Gkm9IbfdM2xAsg3w&oe=6A92AC23"}]}, "id": "1193790525376943", "locale": "en_US", "screenshots": [{"file_name": "CB Screenshot 3.png", "id": "1051108943396517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974864_1051108946729850_8365581634536211184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1U2ji_ZkZXMQ7kNvwFgPA9P&_nc_oc=AdqFXQRZFb6U5CFQ30joS7cytru1Ocf4sLEWKgQpeAqlvS1AFMXCKpuM3vZnbBqfDQ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ9kNryk7sSXYz1rxZZBqvWrf7YOhl6NdFnnhjqCKQ8Q&oe=6A92D349"}, {"file_name": "CycleBar- Home.png", "id": "522956006795209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_522956013461875_8093803523125335619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEX_x5X4xmYQ7kNvwHNGANW&_nc_oc=AdpeDazbsDyyEezaOs_F3sghAsDYAEQ8f7PwPkYYNc472HkP_6e_bS7a0pXCFp7FumQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf9zpNzXNizKD5L_9qHmWXpW4yYsv_MtYopwGfaPNeUw&oe=6A92D3BB"}, {"file_name": "PB-Callibration.png", "id": "1936493886796191", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982629_1936493890129524_3100247740643681336_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNsNwo7Am5kQ7kNvwG3HiLX&_nc_oc=AdoszKyPNzpBou-eGjrKxBspD2ysLcoE8ubMGSQ9691Y1wF9d64lw2Cp2RX5Tvtk6QA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEelv7feKFVGA4R596cF989URfMZ8alosJff98qEg9j7A&oe=6A92B797"}, {"file_name": "CB Screenshot 02.png", "id": "7985742398145636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974859_7985742404812302_4671278461729422000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BY26QfVgYHMQ7kNvwH84ykh&_nc_oc=AdpOZo9XqIhlqiB8Zw5kT9EMDWVsQD9dQXaM8fd87Dlrz6o6S49sjNPuJAsuxZzjG6Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcg12IW21eajxEUW_NQFWc_0S-c3DT16mUBTWhbn2yxA&oe=6A92C60D"}, {"file_name": "CycleBar- Classes.png", "id": "485640274332590", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269591_485640277665923_6852489760100270909_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka4Z4utOLBUQ7kNvwHGbrCt&_nc_oc=Adr-sefeQDjJwFAzsjkLJbGnofZODSvoV4nC-vjwOnCNsdRFqJ6w0uZKXk8IiWQ8M1g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLOWmRVAaZaNZz-lilYYSQxYeVHmd0NohpsCFewCuQVQ&oe=6A92D01C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CB - Cover - Landscape.png", "id": "479642521355102", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974834_479642524688435_7065933209497930161_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHgXXSNaUYgQ7kNvwFG0_DS&_nc_oc=AdrFRDH-tN5AdAO-kJ5JpuxM3P6WhL66Bkf_ZpgNTSSMKf9w7SSSpiI-VHo4ZDT9rwE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2JXwF27ftgCo3k2SWTSc-L_dT4mWUYJuX_JaSXt41Cg&oe=6A92AD43"}, "display_name": "CycleBar", "keywords": ["fitness", "health", "cycling", "spin", "cardio"], "long_description": "Revitalize your fitness routine with CycleBar on Meta Quest! As the largest spin brand in the U.S., CycleBar delivers an unparalleled indoor cycling experience that combines the thrill of high-energy workouts with the innovation of virtual reality. Whether you're a seasoned cyclist or new to the world of spinning, our app offers a captivating and personalized journey designed to elevate your performance and keep you inspired.\n\n**Key Features:**\n\n- **Immersive VR Rides:** Clip into the first indoor cycling VR app on the Quest and feel the rush of riding with top instructors and fellow cyclists from around the world.\n\n- **Expert Instructors:** Ride alongside professional trainers who motivate and guide you through every pedal stroke, ensuring an engaging and effective workout.\n\n- **Variety of Classes:** Choose from a wide range of rides, including high-intensity interval training (HIIT), endurance rides, themed sessions, and more.\n\n- **Personalized Experience:** Customize your workouts to match your fitness goals, with options to adjust intensity and duration for a tailored ride.\n\nEmbark on an exciting journey to fitness with CycleBar on Meta Quest. Discover the power of movement, connect with a supportive community, and transform your ride into an unforgettable experience. Your adventure starts here\u2014get ready to ride!\n{381239874674871}", "short_description": "CycleBar is the first indoor cycling app on Meta Quest! Rock Your Ride with the largest indoor cycling brand in the U.S. Whether you're a VR enthusiast or a cycling lover, our app offers exhilarating rides led by top instructors, designed to boost your endurance, strength, and motivation. Join a vibrant community, track your progress, and transform your fitness journey with CycleBar's cutting-edge virtual reality experience. Get ready to ride like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xponential.com/privacy-policy", "developer_terms_of_service_url": "https://www.xponential.com/terms-of-use-xplus", "publisher_name": "Litesport", "support_website_url": "https://xpoplus.app.link/e/help", "website_url": "https://xponential.plus/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "s
 Processing Technician", "keywords": ["VR", "Immerselearn", "Training", "CSPT"], "long_description": "Certified Sterile Processing Technician is an immersive VR training application designed to prepare users for critical responsibilities in sterile processing. Through realistic, hands-on simulation, learners practice key tasks such as instrument decontamination, sterilization techniques, equipment handling, and infection control. The app provides a safe, controlled environment to build competence and confidence\u2014perfect for healthcare students, vocational programs, or professionals preparing for certification or on-the-job training.", "short_description": "Certified Sterile Processing Technician is a VR training simulation that offers hands-on practice in essential sterilization and decontamination procedures. Learn and apply industry-standard techniques in a realistic, immersive environment\u2014ideal for students, trainees, and healthcare professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9782030001885650"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED
-151143.png", "id": "714731990592634", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75429290_714731993925967_583255900706383564_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtmUiQBCZz4Q7kNvwFjIdcH&_nc_oc=AdkWMIooK_yTjhUnc1UGeFH3xBJgVFeXblVs-on_1SgZqJUIsrmB7IXO-y0xfoes2ao&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsuerL-G4OxjcZqoP0ILabv78hgfUbdP8C7D1qhfS4hLA&oe=6999B79E"}, {"file_name": "screenshot4.png", "id": "1280410406001611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031377_1280410409334944_720206966305757270_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJAqwi1RzDAQ7kNvwFzrm3y&_nc_oc=AdktgX_f1BI-bZAIZQQZItQJo44t_wrlgLlpLLFQ46Li3lDBpS-9UYLvDENf9az6hkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsUWIkjz_t0ng9ZkTUG_RdWuJ8EKZC_laKJI9uoYgh0Ug&oe=69999298"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "655470516699941", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569423_655470520033274_8008094132084939180_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csOUjrNzcUcQ7kNvwGEhww6&_nc_oc=AdkHYvKfpPohSaPCtgHUQMd0tWc4RjsSrzkIaSR9d6V7w02tOOzEmUb51yLmm2bvJIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvm-VVAjee2nCw4dXgRlqSgpVLdqkbubRXmIVuuqYdr6A&oe=6999BA41"}, "display_name": "Series and Parallel Circuits - ContentsDa Science Experiments", "keywords": [], "long_description": "\"Dive into the realm of realistic chemistry experiments through Virtual Reality (VR). Experience the excitement of conducting actual chemical reactions in a risk-free digital laboratory. Mix substances, observe genuine chemical changes, and engage with lifelike molecular structures\u2014all in an immersive 3D environment. Enhance your learning by interacting with accurate representations of laboratory equipment and substances, all while honing your scientific skills. Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": " Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other. This package includes collection of 1 chemistry experiment.  This application supports two languages, Korean and English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6923701244417856"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "816195883751620"}, {"status": "PUBLISHED", "id": "7971536722859646"}, {"status": "PUBLISHED", "id": "1119998145797452"}, {"status": "PUBLISHED", "id": "950158350108034"}, {"status": "PUBLISHED", "id": "750692457155227"}, {"status": "PUBLISHED", "id": "707180254241632"}, {"status": "PUBLISHED", "id": "419280967634791"}]}, "baseline_offer": {"id": "816195883751620"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1727851200, "status": "PUBLISHED", "id": "816195883751620"}]}, "liveChannel": {"nodes": [{"latest_su
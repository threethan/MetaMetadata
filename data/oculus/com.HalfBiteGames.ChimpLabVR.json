wC--7t28Q7kNvwE8RhFT&_nc_oc=AdoBJwUEyf9x0NLdQMLfZstl8_njQ8kP7_l4HX9ZPP7ChTDgO4z5VhFbw_tGDPG7uWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdskt9vXWTp05rtKikc4giCOGXWafhil1fIUOh_cc4HA&oe=6B01C94F"}, {"file_name": "Screenshot_2023-10-29_174205.png", "id": "718982056284807", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_718982059618140_8468178087823519860_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MH1AG_VNB0Q7kNvwH8gJLT&_nc_oc=AdoetgFmX2ZAVpTUuYPgD5TkHFzVnViMEYvoexSzHHaAIIxpRUzze3PejjTaHSl8Yes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS4e68qKz2dzNC_V7UvXSet7hA_-s1FY8zGheyHKXJlg&oe=6B01D3A5"}, {"file_name": "Screenshot_2023-10-29_174217.png", "id": "346421244575935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982705_346421247909268_2388611141235679750_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFYFqFp-a0kQ7kNvwFeETlL&_nc_oc=Adp8TCfxGfXfXrJCE40-2W9b01q1HQrPU3D4Hvotb6TxInlyPZlpef1U5N8GGFYCuXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY8C5lxuxHUCjNN_Ex99n9zs5s2u6N4HZO5u_5id2L6g&oe=6B01CEB5"}, {"file_name": "Screenshot_2023-10-29_174225.png", "id": "6655247577890656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974499_6655247581223989_60171651874699647_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPUAASM_JHoQ7kNvwFKe8WJ&_nc_oc=Adq95SEwhhtuQWVOZUZw-BfmwTmsyP6SkdGsEhyWPtfeQfqx84Sl_t7GHhnWwZOtXmg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9CzV3AMWNyJ2-ABuTpi5-Rb4rzNo3gf9RV60qUF304A&oe=6B01C195"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimplab VR", "keywords": [], "long_description": "Welcome to 'Chimplab,' a bone-chilling virtual reality experience that plunges you into the depths of terror like never before. In this sinister laboratory, the line between the known and the unknown blurs, as you assume the role of a lovably goofy chimp with an extraordinary twist. You were once a simple chimp, but a clandestine experiment has granted you heightened intelligence and, at the same time, unleashed the horrors lurking within this forsaken facility.\n\nAs you navigate the eerie corridors of the lab, your heart will race, and your instincts will kick in as you face grotesque and malevolent chimp mutants that now roam freely. The darkness is your only ally, concealing the secrets hidden behind abandoned equipment and flickering lights. In 'Chimplab,' every footstep echoes ominously, and every door you open may reveal a new nightmare.\n\nYour mission is simple: survive, escape, and uncover the sinister truth behind the experiments that transformed you. You'll need to employ your newfound chimp-like dexterity, solve perplexing puzzles, and muster every ounce of courage to make it out alive. But be warned, the chimp mutants have evolved, becoming more cunning and relentless with every step you take.", "short_description": "Welcome to 'Chimplab,' a bone-chilling virtual reality experience that plunges you into the depths of terror like never before. In this sinister laboratory, the line between the known and the unknown blurs, as you assume the role of a lovably goofy chimp with an extraordinary twist. You were once a simple chimp, but a clandestine experiment has granted you heightened intelligence and, at the same time, unleashed the horrors lurking within this forsaken facility."}]}, "developer_name": "Shiva", "developer_privacy_policy_url": "https://sites.google.com/view/halfbite-games/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Shiva", "support_website_url": null, "website_url": "https://sites.google.com/view/halfbite-games/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"
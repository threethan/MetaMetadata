Q-Twmpy8Q7kNvwHUFiKh&_nc_oc=AdrIMeeefKv17A43tBEsdRGL156ys-olQCD6U71bbLaPd3RWkguseXTvwl98UdHos9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXUIiX8LPoDZqEtZ8Tztj4KLcxAv41dcKh6m-ET2tPVw&oe=6B05BDCF"}, {"file_name": "Screenshot_2023-10-29_174205.png", "id": "718982056284807", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974513_718982059618140_8468178087823519860_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3Jsbj8XXdQQ7kNvwFgT7F7&_nc_oc=AdpavbtFuTVbj7wPG7oYnIq87x8N_2WUKqfKX4XrABIG2W6oeWZ_N1wroHZaFOF4lP0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6VvkjNNvnCJa12wjBZCrptQPNpZC76sKZ-xCKdVaTOg&oe=6B05C825"}, {"file_name": "Screenshot_2023-10-29_174217.png", "id": "346421244575935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982705_346421247909268_2388611141235679750_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch_AXRRomdEQ7kNvwG3vQBJ&_nc_oc=Adqm-ENL8CHhcaIIbqnzpBDCO9z8h7zpRRa3M_aG9LlMFJazOuWQu0EtkvfZJ_b0VRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTis3NloSBhWou3IiLMgIGBoAbcSGYJxxPYKHY54HCQxA&oe=6B05C335"}, {"file_name": "Screenshot_2023-10-29_174225.png", "id": "6655247577890656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974499_6655247581223989_60171651874699647_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAc_kjpzCrUQ7kNvwE6c8Rt&_nc_oc=AdqzS6bza51hn-6JvVC9LFkTqBj9jNG9tiXzOZbu_oiz-VJhytaWykQg1uzgowZH0_Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTssZp6YlwpQTaoURtUI9mEgIDx5AnPV15NpVI6qv_ozw&oe=6B05B615"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimplab VR", "keywords": [], "long_description": "Welcome to 'Chimplab,' a bone-chilling virtual reality experience that plunges you into the depths of terror like never before. In this sinister laboratory, the line between the known and the unknown blurs, as you assume the role of a lovably goofy chimp with an extraordinary twist. You were once a simple chimp, but a clandestine experiment has granted you heightened intelligence and, at the same time, unleashed the horrors lurking within this forsaken facility.\n\nAs you navigate the eerie corridors of the lab, your heart will race, and your instincts will kick in as you face grotesque and malevolent chimp mutants that now roam freely. The darkness is your only ally, concealing the secrets hidden behind abandoned equipment and flickering lights. In 'Chimplab,' every footstep echoes ominously, and every door you open may reveal a new nightmare.\n\nYour mission is simple: survive, escape, and uncover the sinister truth behind the experiments that transformed you. You'll need to employ your newfound chimp-like dexterity, solve perplexing puzzles, and muster every ounce of courage to make it out alive. But be warned, the chimp mutants have evolved, becoming more cunning and relentless with every step you take.", "short_description": "Welcome to 'Chimplab,' a bone-chilling virtual reality experience that plunges you into the depths of terror like never before. In this sinister laboratory, the line between the known and the unknown blurs, as you assume the role of a lovably goofy chimp with an extraordinary twist. You were once a simple chimp, but a clandestine experiment has granted you heightened intelligence and, at the same time, unleashed the horrors lurking within this forsaken facility."}]}, "developer_name": "Shiva", "developer_privacy_policy_url": "https://sites.google.com/view/halfbite-games/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Shiva", "support_website_url": null, "website_url": "https://sites.google.com/view/halfbite-games/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"
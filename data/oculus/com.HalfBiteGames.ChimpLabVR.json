LvQe0FcQQ7kNvwHyC-Lb&_nc_oc=AdrJT_XKMERM0je2mpbMXCr1KjyAMpe5EVlcykysNeu1hlvUXYSq7EtMceNqlQuEjiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGWF_77HjBTpOi9TmGIaPtMAN5BHtDYAb6PvfKUaoTbA&oe=6AFDD4CF"}, {"file_name": "Screenshot_2023-10-29_174205.png", "id": "718982056284807", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974513_718982059618140_8468178087823519860_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haYs7Rkvs2UQ7kNvwEM4stB&_nc_oc=Adr4YBz-Ux8Lb-DUYvBDe3CFn401XmZiHcfaOcBs5oWZVbhb91LwBV1pqo94XTN0qpk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbFl6DD0wsMCJnrJ4y1z0IM6U_FScoyLDEyj3D6UGArg&oe=6AFDDF25"}, {"file_name": "Screenshot_2023-10-29_174217.png", "id": "346421244575935", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982705_346421247909268_2388611141235679750_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VwNNxiLkucQ7kNvwHSyGH9&_nc_oc=AdrwsPJ5g34Mz7aAb6zE8oLE6puU4PR8gb86mCzQ2vcxbpNwnVKyNttbfKELsRWm60A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0_tcFJ92JMVZYK2rAMYVBfq0VUf3QA-g978c5FCN8Sw&oe=6AFDDA35"}, {"file_name": "Screenshot_2023-10-29_174225.png", "id": "6655247577890656", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974499_6655247581223989_60171651874699647_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUwTnC0yijAQ7kNvwG5v6Lo&_nc_oc=Adr24Pr__1CX-n5Y9ri36qobuwYHP73Rig7KfWwCbR4eg71pIzQg1sIfXMZ-TOzxmu8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY_C15cgQetDiGmWyGtT2095tO_R4j_zfpCOAcdqOlxg&oe=6AFDCD15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimplab VR", "keywords": [], "long_description": "Welcome to 'Chimplab,' a bone-chilling virtual reality experience that plunges you into the depths of terror like never before. In this sinister laboratory, the line between the known and the unknown blurs, as you assume the role of a lovably goofy chimp with an extraordinary twist. You were once a simple chimp, but a clandestine experiment has granted you heightened intelligence and, at the same time, unleashed the horrors lurking within this forsaken facility.\n\nAs you navigate the eerie corridors of the lab, your heart will race, and your instincts will kick in as you face grotesque and malevolent chimp mutants that now roam freely. The darkness is your only ally, concealing the secrets hidden behind abandoned equipment and flickering lights. In 'Chimplab,' every footstep echoes ominously, and every door you open may reveal a new nightmare.\n\nYour mission is simple: survive, escape, and uncover the sinister truth behind the experiments that transformed you. You'll need to employ your newfound chimp-like dexterity, solve perplexing puzzles, and muster every ounce of courage to make it out alive. But be warned, the chimp mutants have evolved, becoming more cunning and relentless with every step you take.", "short_description": "Welcome to 'Chimplab,' a bone-chilling virtual reality experience that plunges you into the depths of terror like never before. In this sinister laboratory, the line between the known and the unknown blurs, as you assume the role of a lovably goofy chimp with an extraordinary twist. You were once a simple chimp, but a clandestine experiment has granted you heightened intelligence and, at the same time, unleashed the horrors lurking within this forsaken facility."}]}, "developer_name": "Shiva", "developer_privacy_policy_url": "https://sites.google.com/view/halfbite-games/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Shiva", "support_website_url": null, "website_url": "https://sites.google.com/view/halfbite-games/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"
n.com/v/t64.5771-25/473392138_552511394478455_2232411496073076784_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNToo5JZP2YQ7kNvwECtBH-&_nc_oc=AdoG6eorjUvO8F_c7zfHcpNdaEk8bD_xlo1mMAN3TN759xkc4O1tVzz1RQEq6elrg1o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AvCKjK9_MdXTEKk2eh00hcF2C6o07wGR6PCBd2iKBtg&oe=69D65DD4"}, {"file_name": "ss1.png", "id": "497880493079740", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392030_497880496413073_6685533152652071397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12Nd28Rg4WQQ7kNvwFMHyz5&_nc_oc=AdqGkoWzfMZU4I6_qAi36ohN9ld60jQJWjLFhqp1o_Ob_vxpR5ZbSBTIoO7ukKX7fb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sGHaJHDv2m-qpj3vAE8I3pifNLiBSBAR3DFJtAOCdeA&oe=69D6674E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spiderarttestTitle.png", "id": "1277705199969122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473397684_1277705203302455_7259243560357786598_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTz_JCVlT_MQ7kNvwELEzGD&_nc_oc=AdoQDNNqUbPcpcytdrUQa5Zhxtwl5FcRfgPDZqZ4eZG50VJIpFNmmHFQrYMbrhM27Bg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yT_986UER3DmjcexcyGKrzNrP6qSxDjS9_s7blstkHw&oe=69D64458"}, "display_name": "Spiders", "keywords": ["Spiders", "hangout", "social", "multiplayer", "climbing"], "long_description": "Spiders is a social VR experience where you inhabit a colorful arachnid and climb around finding cocoons to deliver to a nest. \n\nYou can steal cocoons from other spiders to score points, and the first spider to 10 points wins the crown! It's a deceptively simple game that's easy to pick up and hard to master. \n\nIn Spiders you can : \n\n- be a Spider!\n- choose your color\n- deck out your Arachnid in special cosmetic gear\n- make new friends (and enemies!)\n\nWith social features and addictive gameplay, Spiders is a casual, fun hangout experience that can be taken seriously as you desire, or as chill as you want. ", "short_description": "Arachnid activities for your bug buddies. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2776542286000603"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9614314105259439"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392157_1306908547263714_5376233536884851654_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxVXBjPu3NgQ7kNvwHOKolJ&_nc_oc=AdqsYXHTgzR7RhxtrLqkciG7vs00TerSglfUmAxc6D-uXAUgzYrIMjv7SHqVnRCjj3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0buR_KdG7_iwZpIYXRvA1taiRdz9lpFQYtj6_lx_3low&oe=69D64FCB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spiders", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1740678480, "lastRevision": {"nodes": [{"id": "9593318330692350",
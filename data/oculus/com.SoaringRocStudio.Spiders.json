vwGNnCNw&_nc_oc=Admg9_8DHYZ-YtUaq9vVUkOHUjl-K-3GsONHcN48wgvPhmE2B-dg-jj2LcT0LAIgN1c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afshd_aS94Wc01pi0asEXgxheqzI5Z8KzvNNxaBPTA6DeA&oe=69A59654"}, {"file_name": "ss1.png", "id": "497880493079740", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392030_497880496413073_6685533152652071397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lr3SKPRZ7IcQ7kNvwGkwi3r&_nc_oc=AdniwdtraMB0f3kqcza0Yo84gR7lNxmEABVkxkl2J5y8e4GxaKmpkUsgyGw6SbZ7BdA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuVgoNIQ1m_0BVoJUWQZnOgtJftYDJpTNwBz-QSPeDeYw&oe=69A59FCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spiderarttestTitle.png", "id": "1277705199969122", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473397684_1277705203302455_7259243560357786598_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeGrDMvTx-gQ7kNvwFFb6Q8&_nc_oc=Adls4mDm5UvFnShzus6vBgQih0w3gtEqYNGyrDvoZbiJMK7Cb1v435OqfC5KJrarVmU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvf384MnJbQpVFpZC-hUt3FyAN260NV53sXYxPajBWNXg&oe=69A57CD8"}, "display_name": "Spiders", "keywords": ["Spiders", "hangout", "social", "multiplayer", "climbing"], "long_description": "Spiders is a social VR experience where you inhabit a colorful arachnid and climb around finding cocoons to deliver to a nest. \n\nYou can steal cocoons from other spiders to score points, and the first spider to 10 points wins the crown! It's a deceptively simple game that's easy to pick up and hard to master. \n\nIn Spiders you can : \n\n- be a Spider!\n- choose your color\n- deck out your Arachnid in special cosmetic gear\n- make new friends (and enemies!)\n\nWith social features and addictive gameplay, Spiders is a casual, fun hangout experience that can be taken seriously as you desire, or as chill as you want. ", "short_description": "Arachnid activities for your bug buddies. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudi
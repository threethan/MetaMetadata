yoxffIo3-8AmWz-A&oe=6A1D9700"}, {"file_name": "SS2.png", "id": "4042985175980837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822746_4042985179314170_3609418247718437292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiIjstAKjt8Q7kNvwEYZ0yN&_nc_oc=AdofkgXal--zTYfjBO_O20-9t9A4WaKvHFqrXLxvynIyk7q0OE-i92I4alW2BEWroJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vvOROHxY44x5WF8aPtSjdkfi4azy9rLvvSp9szXTkmQ&oe=6A1D9C67"}, {"file_name": "SS3.png", "id": "1023830782608028", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393608_1023830785941361_2428011335291602686_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBjO5QRzpDwQ7kNvwGt-wZr&_nc_oc=AdpxnpyNf9w_i10FzAj631SvcoKO3Cu2UelJOtFnAKsQTbrxYg2FPV_zBw_vVXjYL8Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45BZ_v66i3dMuMYacBTSLTNLyY1G8_0IIKPjAeyWJNKw&oe=6A1DA5A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover - 2560x1440.png", "id": "1214795610318625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392282_1214795613651958_6831477187171344276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbZ6T4VsXLoQ7kNvwGaxcrK&_nc_oc=AdopwPvEyl78USTP8JJF1Kutk0czSESgq1IjmuxO7ZzOxRkpwfGDsmssi8rVHiA-zLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tcOwu98jcnmU2MXO-XjcHOk0H6yb5n7SoeDuodyMIFA&oe=6A1D7AA1"}, "display_name": "Spiders", "keywords": ["Spiders", "hangout", "social", "multiplayer", "climbing"], "long_description": "**Swing, crawl and dunk in Spiders, a free multiplayer VR game!**\n\nSpiders is a casual multiplayer game where you hop and crawl around using your hands, web across giant maps and dunk your way to the top of the leaderboard.\n\n{1325358005212368}\n\n- **Up to 10 players become eight-legged spiders** and use their hands to leap through the air, scale surfaces and shoot webs to swing around on. \n- **Steal cocoons and then dunk them** into goal zones to score points. First player to 10 points wins!\n- **Play with friends** in private lobbies or join public games to show off your skills.\n\n{1681145515836822}\n\n- **Grab power-ups** to spray your foes as the Xterminator, wield lethal bee stingers and even fly like a butterfly. \n- **Customize your spider** & buy new accessories or skins in the store.", "short_description": "Swing, crawl & dunk your way to the top in Spiders, a free-to-play Tag-like."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10069048323119346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392157_1306908547263714_5376233536884851654_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMyolzTK6fIQ7kNvwEYbs82&_nc_oc=AdrI7cWtVybaFqJGKneWaO1iYr4qaTTlUSjHES0_v517M4epN9UqXrO-13aPnBKpGbU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73gC8Hm7lbQ_seI6CT94xvSqxP61sq3QOekOj7XZYqEQ&oe=6A1D80CB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spiders", "platform": 
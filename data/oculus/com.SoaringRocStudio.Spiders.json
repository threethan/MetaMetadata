/473392030_497880496413073_6685533152652071397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P--o33AC_AoQ7kNvwGddYzX&_nc_oc=AdoWnS1zB9HxJLfE4PUhKjyN5Oj4ylGL_rC2Cg0e_9I2vygQhdpKZ6vw2Cz4JjvcLMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZhg9qT8fMrsiQ8YyYmafg9rLeEJgEWoiTnbA7C5s_PA&oe=6A5CE04E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spiderarttestTitle.png", "id": "1277705199969122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473397684_1277705203302455_7259243560357786598_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UBjxZlFFpcQ7kNvwHDuDCA&_nc_oc=AdpuanZIsSY3UidgjXD6NCxzpkghom_pqOvbm0t0YIgqTVt5JBcAG31QTkpvRVYtmBA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJRkuAWsFxFpzOQkLaljewvQLYUOcB075eajIy2FPHhQ&oe=6A5CBD58"}, "display_name": "Spiders", "keywords": ["Spiders", "hangout", "social", "multiplayer", "climbing"], "long_description": "Spiders is a social VR experience where you inhabit a colorful arachnid and climb around finding cocoons to deliver to a nest. \n\nYou can steal cocoons from other spiders to score points, and the first spider to 10 points wins the crown! It's a deceptively simple game that's easy to pick up and hard to master. \n\nIn Spiders you can : \n\n- be a Spider!\n- choose your color\n- deck out your Arachnid in special cosmetic gear\n- make new friends (and enemies!)\n\nWith social features and addictive gameplay, Spiders is a casual, fun hangout experience that can be taken seriously as you desire, or as chill as you want. ", "short_description": "Arachnid activities for your bug buddies. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2
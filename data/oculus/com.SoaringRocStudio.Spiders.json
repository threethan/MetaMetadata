3857662", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491819959_586043977190995_8084025272905808813_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-3sJe1vxkEQ7kNvwGPvpYD&_nc_oc=AdqMYudJ24ACSUig0wrrQMdljkPkJTWfVWmaW87j_8arxvY2mANKKMoBYDFL-f70wPY&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-V-UK9gcTvWtiKyJaPPLmM7AXSjbCeSBprpWtv8SO9g&oe=6B084200"}, {"file_name": "SS2.png", "id": "4042985175980837", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491822746_4042985179314170_3609418247718437292_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5ba1LCAKa8Q7kNvwHZUqUm&_nc_oc=Adr9638pBuYALJtWr1wWYEcynOdfKTh_FnRaoWb3h-BWdPMJJUBKMMju8W46Vr6q9J8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCR5sR8E4YZJeD_Qj1NuAtUsDP1N2keOI9dU5TDx2KHw&oe=6B084767"}, {"file_name": "SS3.png", "id": "1023830782608028", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393608_1023830785941361_2428011335291602686_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISwBsCQFk1cQ7kNvwEF3ZAm&_nc_oc=AdqhYtYGxH7c_mguXmA1kwM8zpm7w-Il1N16IRm-4MA-nV25slOVwGzr-BzuwFe93lo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqp_g_XehSBb671QqlfhaSftIAhxGda5rIZYvMwYq10A&oe=6B0850A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover - 2560x1440.png", "id": "1214795610318625", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392282_1214795613651958_6831477187171344276_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2hpJFTQx9YQ7kNvwGbtg67&_nc_oc=AdryYs-u4roCTPnwuYYiNukvNV55GBbxZD8P9GaPxq1SQK6VD7WDzIln0LF-LSzmq3I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUpNACVqzUTUEQq_XAmevMRzbFnsXb7vTy0IF7mOEHhg&oe=6B085DE1"}, "display_name": "Spiders", "keywords": ["Spiders", "hangout", "social", "multiplayer", "climbing"], "long_description": "**Swing, crawl and dunk in Spiders, a free multiplayer VR game!**\n\nSpiders is a casual multiplayer game where you hop and crawl around using your hands, web across giant maps and dunk your way to the top of the leaderboard.\n\n{1325358005212368}\n\n- **Up to 10 players become eight-legged spiders** and use their hands to leap through the air, scale surfaces and shoot webs to swing around on. \n- **Steal cocoons and then dunk them** into goal zones to score points. First player to 10 points wins!\n- **Play with friends** in private lobbies or join public games to show off your skills.\n\n{1681145515836822}\n\n- **Grab power-ups** to spray your foes as the Xterminator, wield lethal bee stingers and even fly like a butterfly. \n- **Customize your spider** & buy new accessories or skins in the store.", "short_description": "Swing, crawl & dunk your way to the top in Spiders, a free-to-play Tag-like."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10069048323119346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t
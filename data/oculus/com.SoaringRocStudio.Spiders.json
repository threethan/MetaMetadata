com&oh=00_AfvHE4o35n1txHBx-LdxfiowuxSjc1j8b_GQUgfdnJTiXA&oe=6999B8D4"}, {"file_name": "ss1.png", "id": "497880493079740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392030_497880496413073_6685533152652071397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYmBVRX6LjwQ7kNvwFIucnD&_nc_oc=AdlHWkJOXvPnpi3_7N4O_IhAakKEuw89uqauD4W9SqEfM2EkkQ82aH0d9RyU7fzHd-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfusFKmCGLCnKUvU5M_sMk4L6Zqde9zKxzgNt_2TvR_tTQ&oe=6999C24E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spiderarttestTitle.png", "id": "1277705199969122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473397684_1277705203302455_7259243560357786598_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-iawE0cBmoQ7kNvwGBbwAk&_nc_oc=AdlU8Mc4uv90gGzZZa5zt7wwFt1GodtPKms2pcSYPghgokOBhtWgbWACjgMw5nHJmIY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvAXV_VqVT8oMmpXjZJCzQR9lf_SwcnP77T_4aA6h8u3A&oe=69999F58"}, "display_name": "Spiders", "keywords": ["Spiders", "hangout", "social", "multiplayer", "climbing"], "long_description": "Spiders is a social VR experience where you inhabit a colorful arachnid and climb around finding cocoons to deliver to a nest. \n\nYou can steal cocoons from other spiders to score points, and the first spider to 10 points wins the crown! It's a deceptively simple game that's easy to pick up and hard to master. \n\nIn Spiders you can : \n\n- be a Spider!\n- choose your color\n- deck out your Arachnid in special cosmetic gear\n- make new friends (and enemies!)\n\nWith social features and addictive gameplay, Spiders is a casual, fun hangout experience that can be taken seriously as you desire, or as chill as you want. ", "short_description": "Arachnid activities for your bug buddies. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "w
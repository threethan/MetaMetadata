VzjyTOXyp7ofzhntV08I4WquVQXI7A&oe=6A8D6614"}, {"file_name": "ss1.png", "id": "497880493079740", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392030_497880496413073_6685533152652071397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtPKDeJy9GIQ7kNvwFt1lZe&_nc_oc=AdpPVbcwpb8D1SJz7U66X200IK92uLi7r1-0ZzmzCfWiUl1o1bvQKod9afD8pWcoyiM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVRhqIGK64FimsBWc6nT6Ah0iOxoiw4n51R-7cYbtlHA&oe=6A8D6F8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spiderarttestTitle.png", "id": "1277705199969122", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473397684_1277705203302455_7259243560357786598_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vM86eoROawIQ7kNvwGlNv5Z&_nc_oc=Adrq4q45ljEMC9dzOzqI_kUh0KDBkclUg1WUsnl8hHkFBs_oP2G5jArIAjC9OAdyX5g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN9pl8xBOKh_n3Gsw-M8ASUletvXGrMUdiI9NIVCRRKw&oe=6A8D84D8"}, "display_name": "Spiders", "keywords": ["Spiders", "hangout", "social", "multiplayer", "climbing"], "long_description": "Spiders is a social VR experience where you inhabit a colorful arachnid and climb around finding cocoons to deliver to a nest. \n\nYou can steal cocoons from other spiders to score points, and the first spider to 10 points wins the crown! It's a deceptively simple game that's easy to pick up and hard to master. \n\nIn Spiders you can : \n\n- be a Spider!\n- choose your color\n- deck out your Arachnid in special cosmetic gear\n- make new friends (and enemies!)\n\nWith social features and addictive gameplay, Spiders is a casual, fun hangout experience that can be taken seriously as you desire, or as chill as you want. ", "short_description": "Arachnid activities for your bug buddies. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, 
vwGHwkOk&_nc_oc=AdnFCTGv0t2caKjc-IwSxPXuOTKYm8yunCKvQJCWS0JX_40FJBK0LE6rg71Huj6X-RM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu9WczL1f4Xld3jZwftD4pSQtNNOovLolijZLA0weVJjQ&oe=699DAD54"}, {"file_name": "ss1.png", "id": "497880493079740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392030_497880496413073_6685533152652071397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulZeT_SwaW0Q7kNvwFxxqRk&_nc_oc=Adna5Rh482CO-yB7YxnXnmlPzC488jS5yWAWlGwk97_Yh_kZvpel-WLWv_G-PpJO69Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsVpisUuhb9Vs2DaCxmu92wSWFwlCFg6jVJI496r3rQaQ&oe=699DB6CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spiderarttestTitle.png", "id": "1277705199969122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473397684_1277705203302455_7259243560357786598_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8uWLRPEOHgQ7kNvwGg5_tT&_nc_oc=AdnRm1K_ixFquV9vxNDbT9EiR8leerBamrLXeiO33yPmxNB0PrfdjiDZL7STkE_kzmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsWu2z81nHME5aeko8pQGklIZ0G9VlEW-IODrDHGe1C8Q&oe=699D93D8"}, "display_name": "Spiders", "keywords": ["Spiders", "hangout", "social", "multiplayer", "climbing"], "long_description": "Spiders is a social VR experience where you inhabit a colorful arachnid and climb around finding cocoons to deliver to a nest. \n\nYou can steal cocoons from other spiders to score points, and the first spider to 10 points wins the crown! It's a deceptively simple game that's easy to pick up and hard to master. \n\nIn Spiders you can : \n\n- be a Spider!\n- choose your color\n- deck out your Arachnid in special cosmetic gear\n- make new friends (and enemies!)\n\nWith social features and addictive gameplay, Spiders is a casual, fun hangout experience that can be taken seriously as you desire, or as chill as you want. ", "short_description": "Arachnid activities for your bug buddies. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudi
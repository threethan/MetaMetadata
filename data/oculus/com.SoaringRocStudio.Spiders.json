T0yS6jsCFwOv-UWnZg&oe=6AA94DD4"}, {"file_name": "ss1.png", "id": "497880493079740", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392030_497880496413073_6685533152652071397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMLL2TNwTzkQ7kNvwGox6-3&_nc_oc=AdpdaBP9hhYHxYQRrd6NsitM0Ih5IQDKSccudyARQYiVqbGOTQ6hYxmXL-HG0gfBPBU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCovJ1xrYHdtqGEd1FptaIoDrXa1D7BnB-q5PGlcLhCg&oe=6AA9574E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spiderarttestTitle.png", "id": "1277705199969122", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473397684_1277705203302455_7259243560357786598_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAau_bVWbrsQ7kNvwGoSykF&_nc_oc=AdrCR6pCm7au43101jMETpqEZntdt0zjy6BJjRC_Nn_VVSjXo1IuQYaH49GpHmIb2MA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMeRL2-ndMbTtHSLfopTzBRLUIJiTj8l-vG-qm5It0vQ&oe=6AA93458"}, "display_name": "Spiders", "keywords": ["Spiders", "hangout", "social", "multiplayer", "climbing"], "long_description": "Spiders is a social VR experience where you inhabit a colorful arachnid and climb around finding cocoons to deliver to a nest. \n\nYou can steal cocoons from other spiders to score points, and the first spider to 10 points wins the crown! It's a deceptively simple game that's easy to pick up and hard to master. \n\nIn Spiders you can : \n\n- be a Spider!\n- choose your color\n- deck out your Arachnid in special cosmetic gear\n- make new friends (and enemies!)\n\nWith social features and addictive gameplay, Spiders is a casual, fun hangout experience that can be taken seriously as you desire, or as chill as you want. ", "short_description": "Arachnid activities for your bug buddies. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url
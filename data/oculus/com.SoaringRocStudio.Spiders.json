=AdrIuveQFPhpT7Kp_icdX-8i8Gsl2vPYF7_khtvgUF7ErCyi7TychwcmSwFy3vKAXFY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17Hz7XOvOE8u2x3U-Wtwpjay6O0H8sVM_Vv-Q3Dvu4FA&oe=69F3684E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spiderarttestTitle.png", "id": "1277705199969122", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473397684_1277705203302455_7259243560357786598_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGwvtZONtZIQ7kNvwFmwOK1&_nc_oc=Adq6J5iyll3gkAjt0FEfWXeW1yClMEMaeDZvMB4FxgmIRTVyec_EQqnfduQmiC2oW4w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01KbKKqOTq84yWC0tCqqUvoFL773FIfN3ZwDmBNQKCMA&oe=69F34558"}, "display_name": "Spiders", "keywords": ["Spiders", "hangout", "social", "multiplayer", "climbing"], "long_description": "Spiders is a social VR experience where you inhabit a colorful arachnid and climb around finding cocoons to deliver to a nest. \n\nYou can steal cocoons from other spiders to score points, and the first spider to 10 points wins the crown! It's a deceptively simple game that's easy to pick up and hard to master. \n\nIn Spiders you can : \n\n- be a Spider!\n- choose your color\n- deck out your Arachnid in special cosmetic gear\n- make new friends (and enemies!)\n\nWith social features and addictive gameplay, Spiders is a casual, fun hangout experience that can be taken seriously as you desire, or as chill as you want. ", "short_description": "Arachnid activities for your bug buddies. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2776542286000603"}, {"i
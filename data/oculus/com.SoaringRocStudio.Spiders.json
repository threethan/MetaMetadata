78455_2232411496073076784_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLmMTjQuJc0Q7kNvwFqlHbt&_nc_oc=AdoZNOkNeCs1zSOtnsYmtukKNWHKG0kLZpYk2P_zm1ypomYjzYHQUHNtyJ4vh80ZEA4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYLasyEVn_9BfZVzYV0trXIRQqt_0k4LRasUNZCuMDmA&oe=69C145D4"}, {"file_name": "ss1.png", "id": "497880493079740", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392030_497880496413073_6685533152652071397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqjvhqxOGtgQ7kNvwFXpC3H&_nc_oc=AdoUSnc9scz8Nb8pz7iaeRxnZ4AHHrMQbOVFveGuofWvcv_Qk04oay94kle6nFq7_9c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzUsNjZwnwRcIm8Vx_n3EaWAty5L_BxiRJVvi-xvWZMGw&oe=69C14F4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spiderarttestTitle.png", "id": "1277705199969122", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473397684_1277705203302455_7259243560357786598_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1l8KK3eF7kQ7kNvwHALSRK&_nc_oc=Adow5K1iFWl-sIe4zPL3fiDUBLycPTo2-tsIVXyb0Osd-EgW44p4pzbDcMyZSSGNgSg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyNMiuZv9VRF-4bvBAni3iuoBiZbAdYBYN1UCbTGsmBmQ&oe=69C12C58"}, "display_name": "Spiders", "keywords": ["Spiders", "hangout", "social", "multiplayer", "climbing"], "long_description": "Spiders is a social VR experience where you inhabit a colorful arachnid and climb around finding cocoons to deliver to a nest. \n\nYou can steal cocoons from other spiders to score points, and the first spider to 10 points wins the crown! It's a deceptively simple game that's easy to pick up and hard to master. \n\nIn Spiders you can : \n\n- be a Spider!\n- choose your color\n- deck out your Arachnid in special cosmetic gear\n- make new friends (and enemies!)\n\nWith social features and addictive gameplay, Spiders is a casual, fun hangout experience that can be taken seriously as you desire, or as chill as you want. ", "short_description": "Arachnid activities for your bug buddies. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2776542286000603"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9614314105259439"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392157_1306908547263714_5376233536884851654_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hT0HaBWt7bYQ7kNvwGfqc-l&_nc_oc=Adpi2tOs0M--NcccLhcbtIRyOhgO2kYQr-TJknYq2K_54kmDSJGCz8sSSlk6n4FGE7Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxsnv1ZNnW4HAfAk1iOYn_fdhYwCkwALdS53gpJKIPOSg&oe=69C137CB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spiders", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1740678480, "lastRevision": {"nodes": [{"id": "9593318330692350", "release_type": "SCHEDULED", "administration_status": "
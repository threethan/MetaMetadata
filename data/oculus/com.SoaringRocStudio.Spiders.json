47718437292_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzJB4DUMvhIQ7kNvwGr3sjV&_nc_oc=AdrIJOHCaxii438oaUxHs-mV3OU-RB8vJA-7PNBW7vYKIybRpKC6YQYFOrNG7zv3ssg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Ugo-MCqcujkywpC9iAeH-9vKmnKU_KwB4vgXPcGSlDw&oe=69F21AE7"}, {"file_name": "SS3.png", "id": "1023830782608028", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393608_1023830785941361_2428011335291602686_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZvTsyKflrAQ7kNvwGE1QME&_nc_oc=AdqjKZlHA0Rksft3H2dXxxDQO8dM8PIz-yoJBbjFUHrEa837KxD4zc6VIz8ssgI0wzo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af20lgbKMJG6WIphz6ZlURTz5jqmlhFOvbbBX2e8rx4_iA&oe=69F1EBE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover - 2560x1440.png", "id": "1214795610318625", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392282_1214795613651958_6831477187171344276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gp9-fRsoW4AQ7kNvwFmDAKk&_nc_oc=AdpAFDqP6sgmNbntT_Z-3XuCADtB10WxJhyFJBmrKMuDYFIlcfUXYHrHxDnFkDjpH7Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0DoAgBl3w-1mIg-6K_Nti-WiTdvOT_dmpnnTc475jSQQ&oe=69F1F921"}, "display_name": "Spiders", "keywords": ["Spiders", "hangout", "social", "multiplayer", "climbing"], "long_description": "**Swing, crawl and dunk in Spiders, a free multiplayer VR game!**\n\nSpiders is a casual multiplayer game where you hop and crawl around using your hands, web across giant maps and dunk your way to the top of the leaderboard.\n\n{1325358005212368}\n\n- **Up to 10 players become eight-legged spiders** and use their hands to leap through the air, scale surfaces and shoot webs to swing around on. \n- **Steal cocoons and then dunk them** into goal zones to score points. First player to 10 points wins!\n- **Play with friends** in private lobbies or join public games to show off your skills.\n\n{1681145515836822}\n\n- **Grab power-ups** to spray your foes as the Xterminator, wield lethal bee stingers and even fly like a butterfly. \n- **Customize your spider** & buy new accessories or skins in the store.", "short_description": "Swing, crawl & dunk your way to the top in Spiders, a free-to-play Tag-like."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10069048323119346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392157_1306908547263714_5376233536884851654_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fE5wSMn3N6sQ7kNvwF-IH_R&_nc_oc=Adr2dsO23HgdmVQURPQ39pPZkUM7ivgzAwqq7PfAg6UHDKKqid5_nvOjpKSk8gID35o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1J_y_6rLOAFXN1rBnq6TV_5KKovy8Xz1s4qIJRhCzfGA&oe=69F1FF4B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spiders", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"
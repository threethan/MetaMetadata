YQI0g&oe=6A4CE9AA"}, {"file_name": "ScreenShots-Oculus.png", "id": "586954080949358", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300998_586954084282691_5915317232262222336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Vju38d3g9AQ7kNvwHCAb2t&_nc_oc=AdrZvZrBpkifuxKHt4hmre08CAANSbB4iHSh_aS2M7trhPInhNvqqAAx3Sh2RZFtymY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmQ6hRHTOwr4445TcIy1ps4IPY7-EaKs7yipmAknLU3A&oe=6A4D05E8"}, {"file_name": "ScreenShots-Oculus_05_2560x1440.png", "id": "721637487343617", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303666_721637490676950_560727177409300794_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDa9wbvdgbMQ7kNvwHFSZrO&_nc_oc=Adqoh8QzPcva3b6RmFZUfb5QDBXZENd-RF_LeS5VqrQI5qcniAOW5x3hFp-s4iIqZ3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCg3qgAw_SaIgBhg7hYEeOER3tv68duQ9oc1sA0_hGLAw&oe=6A4CFA53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImageIAIRoulette.png", "id": "742679311697699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626133_742679315031032_2747559378173517706_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUebhzH5nxgQ7kNvwFpzy2b&_nc_oc=Adqy8TM2s3lbQUXSYmqyWeaeH_H1kUcUc3kSUyYdOmpjez4inXstlWhEUHukk8Ln86Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNGL5uCJIFSxtbKvwczdkQQaOEZ5_d46xJ_Wyx8do9Yg&oe=6A4CFB18"}, "display_name": "IAI - FreeEdition", "keywords": [], "long_description": "Experience the beginning of I AI, a VR-only multiplayer puzzle game for two players. This version includes early game sections, introducing core mechanics, story, and cooperative gameplay\u2014plus the fully playable and replayable I AI Roulette mini-game.\n\nTo continue the story and access the full experience, purchase the full version. For the full version, please follow this link: https://www.meta.com/experiences/iai/24036573459287812/\n \n# IAI - ROULETTE\nEnjoy the different game modes! Take on the challenge against other players.\n\nTrailer: https://www.youtube.com/watch?v=zBUWUlrnlPg\n{1098247502503809}\n\n\n# MULTIPLAYER ONLY\nA cooperative experience built around two players\u2014where communication isn\u2019t optional, it\u2019s essential.\n{723622620299839}\n \n  \n# COOP PUZZLE DESIGN\nEach player experiences the world differently. No single perspective is enough to solve the game\u2019s challenges.\n{30752864537661937}\n \n \n# CROSS PLATFORM\nPlay together across PC VR and Meta Quest headsets.\n{1074700744256507}\n \n \n# NARRATIVE DRIVEN\nDiscover the story of the Dreamers through fragments of dialogue, environmental storytelling, and shared decisions.\n{1302372631527111}\n   \n  \n# FULL BODY EXPERIENCE\nSee your entire body\u2014not just your hands\u2014in VR, deepening the sense of presence and expression.\n{1810818042838837}\n", "short_description": "This version of I AI includes the first few sections of the full game, offering a complete introduction to the core mechanics, story, and cooperative gameplay.\nIt also contains the fully playable I AI Roulette mini game, designed for replayability and fun with your partner.\nTo continue the story, access later stages, and unlock the full experience, please purchase the full version of I AI. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://iai.sola-air.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Sola K.K.", "support_website_url": null, "website_url": "https://iai.sola-air.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
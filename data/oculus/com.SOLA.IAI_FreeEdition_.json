-jqteo4a4wQFS-wsHmDnuPBBB_hAVy7buS3JNSWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNBcFc-T7CFbVx0DcvSWq335jBo-nvBzM1lckaRH2ZAQ&oe=6A69EAAA"}, {"file_name": "ScreenShots-Oculus.png", "id": "586954080949358", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300998_586954084282691_5915317232262222336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TcLo0kLG-wQ7kNvwEmndJD&_nc_oc=AdqyRWj7C8aD_bwOxp6lZSWa9OprI58areSI0xGDweoWt-weP1y4jDPoSd2M5S21QgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC78K04fV0ZxVWaky6EoGmFK8nHZ4MFPlF-FpK-IFoJoA&oe=6A6A06E8"}, {"file_name": "ScreenShots-Oculus_05_2560x1440.png", "id": "721637487343617", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303666_721637490676950_560727177409300794_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3brL2hWEV4Q7kNvwGVnoCl&_nc_oc=AdoFCnhw_O-L1v8AUUZBHaHaRL85Hqe7sDO8zims4tj_u-x9Ugiwky_hDRcP04Yffns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJSQtoDjH6oqJeDUi1Rh37EXi24hbN51f_bi1ZlcF-nQ&oe=6A69FB53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImageIAIRoulette.png", "id": "742679311697699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626133_742679315031032_2747559378173517706_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSXryb_hIyYQ7kNvwEjb822&_nc_oc=AdqbvOJQ2epzsCMknNqK21t9aXApi2u8wBAT9rNfWYCp6F8YfdGZ9ytUnaAwTQK_JZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1iX0vMnNDy-nneNm95LRzjf_GP1fTbjjvKei5ZNj4cg&oe=6A69FC18"}, "display_name": "IAI - FreeEdition", "keywords": [], "long_description": "Experience the beginning of I AI, a VR-only multiplayer puzzle game for two players. This version includes early game sections, introducing core mechanics, story, and cooperative gameplay\u2014plus the fully playable and replayable I AI Roulette mini-game.\n\nTo continue the story and access the full experience, purchase the full version. For the full version, please follow this link: https://www.meta.com/experiences/iai/24036573459287812/\n \n# IAI - ROULETTE\nEnjoy the different game modes! Take on the challenge against other players.\n\nTrailer: https://www.youtube.com/watch?v=zBUWUlrnlPg\n{1098247502503809}\n\n\n# MULTIPLAYER ONLY\nA cooperative experience built around two players\u2014where communication isn\u2019t optional, it\u2019s essential.\n{723622620299839}\n \n  \n# COOP PUZZLE DESIGN\nEach player experiences the world differently. No single perspective is enough to solve the game\u2019s challenges.\n{30752864537661937}\n \n \n# CROSS PLATFORM\nPlay together across PC VR and Meta Quest headsets.\n{1074700744256507}\n \n \n# NARRATIVE DRIVEN\nDiscover the story of the Dreamers through fragments of dialogue, environmental storytelling, and shared decisions.\n{1302372631527111}\n   \n  \n# FULL BODY EXPERIENCE\nSee your entire body\u2014not just your hands\u2014in VR, deepening the sense of presence and expression.\n{1810818042838837}\n", "short_description": "This version of I AI includes the first few sections of the full game, offering a complete introduction to the core mechanics, story, and cooperative gameplay.\nIt also contains the fully playable I AI Roulette mini game, designed for replayability and fun with your partner.\nTo continue the story, access later stages, and unlock the full experience, please purchase the full version of I AI. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://iai.sola-air.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sola K.K.", "support_website_url": null, "website_url": "https://iai.sola-air.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": n
MlHHw&oe=6A9FF82A"}, {"file_name": "ScreenShots-Oculus.png", "id": "586954080949358", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300998_586954084282691_5915317232262222336_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMnJxoWc1A0Q7kNvwH8ncU5&_nc_oc=AdqZj1cm-OlkG4HDkAy17W_s8jaPJmjIp3yqMCBBsU04E2U0eGTtg6R8z6tsUAe-EsU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPIvbE3CdLh8kjrt0q-lCFKhiclM92fulQNq6o6EOQpw&oe=6AA01468"}, {"file_name": "ScreenShots-Oculus_05_2560x1440.png", "id": "721637487343617", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303666_721637490676950_560727177409300794_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFZ3wxaMLYcQ7kNvwFOp8Vg&_nc_oc=AdoSKfE1sCib--ElbqhHwjAKIvdBkMb8SDy0VcTJ-vLm6_tjITfwSlzDYLyMmHlRMnI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd7ylEB8ZIu-mF7Yq1ZZMf6LDtbOOsBT_N2SdRmEeVEg&oe=6AA008D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCoverImageIAIRoulette.png", "id": "742679311697699", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499626133_742679315031032_2747559378173517706_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LX36kd7PAEcQ7kNvwHTCOHg&_nc_oc=AdpkLFM0bjPZT-YRuAO0qwffAFFC-Kp0xrl40Q5XOdFqF3Z2D-SDsXQeF09TG2Y-cY4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHtHQ9F7DXzEWY0NDgDEbDSowL9XlZVaJMs6jVkr9dZQ&oe=6AA00998"}, "display_name": "IAI - FreeEdition", "keywords": [], "long_description": "Experience the beginning of I AI, a VR-only multiplayer puzzle game for two players. This version includes early game sections, introducing core mechanics, story, and cooperative gameplay\u2014plus the fully playable and replayable I AI Roulette mini-game.\n\nTo continue the story and access the full experience, purchase the full version. For the full version, please follow this link: https://www.meta.com/experiences/iai/24036573459287812/\n \n# IAI - ROULETTE\nEnjoy the different game modes! Take on the challenge against other players.\n\nTrailer: https://www.youtube.com/watch?v=zBUWUlrnlPg\n{1098247502503809}\n\n\n# MULTIPLAYER ONLY\nA cooperative experience built around two players\u2014where communication isn\u2019t optional, it\u2019s essential.\n{723622620299839}\n \n  \n# COOP PUZZLE DESIGN\nEach player experiences the world differently. No single perspective is enough to solve the game\u2019s challenges.\n{30752864537661937}\n \n \n# CROSS PLATFORM\nPlay together across PC VR and Meta Quest headsets.\n{1074700744256507}\n \n \n# NARRATIVE DRIVEN\nDiscover the story of the Dreamers through fragments of dialogue, environmental storytelling, and shared decisions.\n{1302372631527111}\n   \n  \n# FULL BODY EXPERIENCE\nSee your entire body\u2014not just your hands\u2014in VR, deepening the sense of presence and expression.\n{1810818042838837}\n", "short_description": "This version of I AI includes the first few sections of the full game, offering a complete introduction to the core mechanics, story, and cooperative gameplay.\nIt also contains the fully playable I AI Roulette mini game, designed for replayability and fun with your partner.\nTo continue the story, access later stages, and unlock the full experience, please purchase the full version of I AI. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://iai.sola-air.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Sola K.K.", "support_website_url": null, "website_url": "https://iai.sola-air.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
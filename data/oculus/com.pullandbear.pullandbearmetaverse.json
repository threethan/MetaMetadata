i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031486_1029111891310966_4252490865094883202_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FZAsCD4srYQ7kNvwGiPsK8&_nc_oc=AdneaPXE3D0tElaG1POhENM_rqWHvLSOkFnfQxpFCml2Q9_xyG6sqvQOTJ8IECaoSUU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwamVIMU_Fd-rmxn3sleaYU4LJ-2H6mP2xsDqIvhjLm5w&oe=69B6A543"}, {"file_name": "P_B AL Screenshot 2.png", "id": "374124338097663", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75540505_374124341430996_1348120629434438949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dL77G3bHCcQQ7kNvwG2Q2YN&_nc_oc=AdngzxyFePrtlj2Ji_1aokPdTT6EESnLIZNUzlam9WVKZIuVbt2LHAgoOZK3pR15bp0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbjJcQakKlxmoon8ezmDfd-OVWcsFldodV0s9q9apwSQ&oe=69B6B5E2"}, {"file_name": "P_B AL Screenshot 4.png", "id": "518739209904368", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031379_518739216571034_1284219877153266314_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOnXkLfsFgMQ7kNvwHuyXjq&_nc_oc=AdmzIKZ0GK7PqplSlvdgyh8O1ZjzLH1zuayY44aBxlobbRKurLoyOz2rHUL2L1SSniM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2z1M5KNR1l54absdgOgG2Vcm_9_gE47FvN-QJp0nX4A&oe=69B6AC90"}, {"file_name": "P_B AL Screenshot 1.png", "id": "708670357002595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269157_708670360335928_193755403889150652_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFGbTIDjXQUQ7kNvwEzSxWg&_nc_oc=AdnVmrRJvxIImIoAEUMv_3RJMjqYqqm-DIauLTFOfv4urn_EfSponNsbh77fBLBt3kQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVwfQqx4_xSB8UmkJ2ejaowy5eun8O9Ku_Mv4_imKdVQ&oe=69B6C393"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P_B AL Trailer Cover Image.png", "id": "529657845443234", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75435283_529657848776567_8797300247194641549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JS_t_l0lzvkQ7kNvwEL3SuB&_nc_oc=AdmGeXHbKKSfsCJyGdT0_DUPHRPqZNWqRe9KKWDTk06aPYVgf_wyF6YdDNPieCFMLQs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpZfllE3mnzyRXdBkmsBPS2c3WnvsDC_NpEqPBd_6kQw&oe=69B6A998"}, "display_name": "Pull&Bear", "keywords": [], "long_description": "Pull&Bear, the Inditex group's youth fashion brand, is consolidating its commitment to digital innovation by presenting its own virtual reality in the metaverse project, which comprises a virtual showroom, a fitting room to try on the brand\u2019s outfits and a surfing game. Customers can also be transported to part of this world through a web adaptation that users can access to navigate the virtual world, try out the Ready Player Me avatar creator to make their own 3D avatar with a selfie and wear Pull&Bear outfits. \n\nFor this project, Pull&Bear has digitalised six looks from its collections designed for Generation Z. The garments will be compatible with apps and games on the Ready Player Me platform, including VRChat, Sommium Space, LIV, and Animaze.", "short_description": "Explore the virtual world and try on the virtual clothing collection for your Ready Player Me avatar. And get the full gaming experience at home using Meta Quest virtual reality glasses soon. Are you in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.pullandbear.net/2/static2/policies/privacy_policy/pullandbear_privacy_policy_GB_en.pdf?20220429020501", "developer_terms_of_service_url": null, "publisher_name": "Pull&Bear", "support_website_url": "https://www.pullandbear.com/es/contact.html", "website_url": "https://www.pullandbear.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphi
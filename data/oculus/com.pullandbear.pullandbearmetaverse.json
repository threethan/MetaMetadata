ot 3.png", "id": "1029111887977633", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031486_1029111891310966_4252490865094883202_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euveimG2QSAQ7kNvwETl8eP&_nc_oc=AdoY4406DOAmUx56m5buqZCg85V3-WMtNh0vbc1-PO2J8kl7I5BQUcuHrjT968AlO9A&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrZ450gCVsY-rfQcL_e4pLz8dXJ74sfcLKpf8T5OsQaQ&oe=6AA3F343"}, {"file_name": "P_B AL Screenshot 2.png", "id": "374124338097663", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75540505_374124341430996_1348120629434438949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loOcSgnjVxcQ7kNvwHvYrKV&_nc_oc=Adrh1VRUsaZkqxF8Be90sVnSsVgbpqC73fGZXwXSWvgKM8F57tSi_n0D3D9Ccw3M6kg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9SqmFtH-nP-Ti3KePOS1JwGAUhKX2huJ6StHAdH3P3g&oe=6AA403E2"}, {"file_name": "P_B AL Screenshot 4.png", "id": "518739209904368", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031379_518739216571034_1284219877153266314_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vURBU4VU8IEQ7kNvwFFJpHU&_nc_oc=AdqHGAPHWwWi5sLrWXVMEnaf1oCr9Wq47gMFYLX5GVSIuK8DOlB9kgu-iTlNhsPlNgU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMI7bHlvIrzRVwTz4shMAT9faPLJPRN47PIrVsKvYZqA&oe=6AA3FA90"}, {"file_name": "P_B AL Screenshot 1.png", "id": "708670357002595", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75269157_708670360335928_193755403889150652_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZpVpXDwX8IQ7kNvwFIc6oP&_nc_oc=AdrMYlFkwrD_yY8WxmTx9e19ZSszZv9obIefdz-Tv2u-mX0lWLzXqijc26Lkm6dEpwA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL54Y4Lh2lM0CIZVhBZC-UMBTRzOVK7vzesPnq0pcE_7w&oe=6AA41193"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P_B AL Trailer Cover Image.png", "id": "529657845443234", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75435283_529657848776567_8797300247194641549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF_rwdyNkGkQ7kNvwH7ggdu&_nc_oc=Adr2J5wA0-duAUXqElbLDKj1oZl4_AI4FPUW0CFM1zlkVtSryIZJsiQgV0XFhvT9Noc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5FKYS0i-PoA_AVFPyJ0dnUbkpK2uqZu21fQx2sNQlsQ&oe=6AA3F798"}, "display_name": "Pull&Bear", "keywords": [], "long_description": "Pull&Bear, the Inditex group's youth fashion brand, is consolidating its commitment to digital innovation by presenting its own virtual reality in the metaverse project, which comprises a virtual showroom, a fitting room to try on the brand\u2019s outfits and a surfing game. Customers can also be transported to part of this world through a web adaptation that users can access to navigate the virtual world, try out the Ready Player Me avatar creator to make their own 3D avatar with a selfie and wear Pull&Bear outfits. \n\nFor this project, Pull&Bear has digitalised six looks from its collections designed for Generation Z. The garments will be compatible with apps and games on the Ready Player Me platform, including VRChat, Sommium Space, LIV, and Animaze.", "short_description": "Explore the virtual world and try on the virtual clothing collection for your Ready Player Me avatar. And get the full gaming experience at home using Meta Quest virtual reality glasses soon. Are you in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.pullandbear.net/2/static2/policies/privacy_policy/pullandbear_privacy_policy_GB_en.pdf?20220429020501", "developer_terms_of_service_url": null, "publisher_name": "Pull&Bear", "support_website_url": "https://www.pullandbear.com/es/contact.html", "website_url": "https://www.pullandbear.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NO
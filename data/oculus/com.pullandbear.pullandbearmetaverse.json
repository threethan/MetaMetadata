i": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031486_1029111891310966_4252490865094883202_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgBTY4HnmwgQ7kNvwGORwPV&_nc_oc=AdmeGUcj8v-F-aa9kZxtVZtQ7zC0eC6_2PBCdwOhYVKeXMB5KGG3InpzYU8uZkir2t4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9kQR9AFRo0PHVmYs2fYPbWvJLsgVJN4pt5CqaI1s8Dw&oe=69BFDFC3"}, {"file_name": "P_B AL Screenshot 2.png", "id": "374124338097663", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75540505_374124341430996_1348120629434438949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRxePldVp1IQ7kNvwHKpTJi&_nc_oc=AdlVc795Rc2flr4kWxXObvaGRU8N9G8WJ9wAfKgqfE85xTKm02CduQ53vZhAuLFw-As&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZZ6ScvEOKDpaKtx2IAoRWGeskzM74tZNZdTw2BlnC5A&oe=69BFF062"}, {"file_name": "P_B AL Screenshot 4.png", "id": "518739209904368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_518739216571034_1284219877153266314_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKNAfarnSogQ7kNvwGzyA_7&_nc_oc=AdkXN7q8iroLePyaCNEHIii-8Zqq83L2bNDikyd9MtfTn0RBfHHB6FP3yPbmaG-jaI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQtQof9fC7WXQZDWRIZSpTGra-nngD2L_SHK1TS-ZhRQ&oe=69BFE710"}, {"file_name": "P_B AL Screenshot 1.png", "id": "708670357002595", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269157_708670360335928_193755403889150652_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qy__A1WW7fUQ7kNvwHFFkPM&_nc_oc=AdmUDdbjjxHkXjJEgENh3RFH2iOFMQqUGOkXks44mTlQ_bzR7x77jCiHTak1b8TvUtw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1bew24nJe1zU4CgsbfxWXovL4mXtXk71scLcvDYxH7g&oe=69BFFE13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P_B AL Trailer Cover Image.png", "id": "529657845443234", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75435283_529657848776567_8797300247194641549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jBmj8-LLfkQ7kNvwGiGGe5&_nc_oc=AdlER4iXVQO6pBT959aDUxlxYkTnQxe_GcaMaGNXBc1kZ-XXaLG5MSU1gDWdy5uYAjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyl7zelazJn3x0OuqIOsIIuv_Ks0Y_zaf1TF2mfD9Rllw&oe=69BFE418"}, "display_name": "Pull&Bear", "keywords": [], "long_description": "Pull&Bear, the Inditex group's youth fashion brand, is consolidating its commitment to digital innovation by presenting its own virtual reality in the metaverse project, which comprises a virtual showroom, a fitting room to try on the brand\u2019s outfits and a surfing game. Customers can also be transported to part of this world through a web adaptation that users can access to navigate the virtual world, try out the Ready Player Me avatar creator to make their own 3D avatar with a selfie and wear Pull&Bear outfits. \n\nFor this project, Pull&Bear has digitalised six looks from its collections designed for Generation Z. The garments will be compatible with apps and games on the Ready Player Me platform, including VRChat, Sommium Space, LIV, and Animaze.", "short_description": "Explore the virtual world and try on the virtual clothing collection for your Ready Player Me avatar. And get the full gaming experience at home using Meta Quest virtual reality glasses soon. Are you in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.pullandbear.net/2/static2/policies/privacy_policy/pullandbear_privacy_policy_GB_en.pdf?20220429020501", "developer_terms_of_service_url": null, "publisher_name": "Pull&Bear", "support_website_url": "https://www.pullandbear.com/es/contact.html", "website_url": "https://www.pullandbear.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphi
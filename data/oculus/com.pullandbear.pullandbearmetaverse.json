i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031486_1029111891310966_4252490865094883202_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMLXNFNY1hkQ7kNvwF6gm5b&_nc_oc=AdkoMnkDnyPbJqnoLOHtVYrOsjOa-qw3bVxq2Rs-1Y5sQs_fkDs6XqpybjqAtk8s0dQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEI1AJ_WzrWtYP-cuZdhnbovrpMMx5mghLT1xnxUX02Q&oe=69AD6AC3"}, {"file_name": "P_B AL Screenshot 2.png", "id": "374124338097663", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75540505_374124341430996_1348120629434438949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6kpCMIExV4Q7kNvwEGknRh&_nc_oc=AdkasZQ2bDuNX-IjkhRZ8l-OHIpIIRPxDrS1O-cUnLeEX0tgf1FY9GgsYyru4mTrJDk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9pfDn2OTk-CwtAW4sLvnaJTsR-OybeaVZ-uJ_XTgqsg&oe=69AD7B62"}, {"file_name": "P_B AL Screenshot 4.png", "id": "518739209904368", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031379_518739216571034_1284219877153266314_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNFnFPCOC84Q7kNvwHFWufM&_nc_oc=AdmGfo-MyA7_uWHBOMr5iPcRrHAb9_Kpkk81PRdnjWLHwY2na1CxOHYhXIHiZ0yM5Dc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQJsUstp92REC6KuAMORYD_SlL-QkGTwpIXWLm_XF7pQ&oe=69AD7210"}, {"file_name": "P_B AL Screenshot 1.png", "id": "708670357002595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269157_708670360335928_193755403889150652_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UT8Iqs2A8HgQ7kNvwE8m67G&_nc_oc=AdlsDEDzOHpl_4ZI7UY5TnX5l-tli5CtL2sCs_uRBwvfug4v-VTlF_gtCu1PRGfcSGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXBdGidTjl_BkHreO-zd5t5MuHeNmZGY4K1PXPo14Lpg&oe=69AD8913"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P_B AL Trailer Cover Image.png", "id": "529657845443234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75435283_529657848776567_8797300247194641549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bft99Qz2N_MQ7kNvwHR4gby&_nc_oc=AdmpGy_JFRON_JDVWnF2WABZ6rUoSto_IZMYw7b84GuqkuFX2uWLYadgY8LYX-dmcHA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz85FlylnaAuSYutW-ghFCUrAQViAG-UvEElpB1yUcxUw&oe=69AD6F18"}, "display_name": "Pull&Bear", "keywords": [], "long_description": "Pull&Bear, the Inditex group's youth fashion brand, is consolidating its commitment to digital innovation by presenting its own virtual reality in the metaverse project, which comprises a virtual showroom, a fitting room to try on the brand\u2019s outfits and a surfing game. Customers can also be transported to part of this world through a web adaptation that users can access to navigate the virtual world, try out the Ready Player Me avatar creator to make their own 3D avatar with a selfie and wear Pull&Bear outfits. \n\nFor this project, Pull&Bear has digitalised six looks from its collections designed for Generation Z. The garments will be compatible with apps and games on the Ready Player Me platform, including VRChat, Sommium Space, LIV, and Animaze.", "short_description": "Explore the virtual world and try on the virtual clothing collection for your Ready Player Me avatar. And get the full gaming experience at home using Meta Quest virtual reality glasses soon. Are you in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.pullandbear.net/2/static2/policies/privacy_policy/pullandbear_privacy_policy_GB_en.pdf?20220429020501", "developer_terms_of_service_url": null, "publisher_name": "Pull&Bear", "support_website_url": "https://www.pullandbear.com/es/contact.html", "website_url": "https://www.pullandbear.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphi
", "id": "1029111887977633", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031486_1029111891310966_4252490865094883202_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR0X7H6-DcMQ7kNvwEul0yQ&_nc_oc=Adrhn3XF3J7k-E5jRbej-LyOagX-EIb-Ij68KD4BsiBZcZqvKPe5De2SEuZA_HqPp1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fqtxI86UJX8ojCqBjdNJhA6hifmtb0amgd4W5MyaoHg&oe=6A43EE03"}, {"file_name": "P_B AL Screenshot 2.png", "id": "374124338097663", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75540505_374124341430996_1348120629434438949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioB6PCQ_D0MQ7kNvwG_sMX6&_nc_oc=AdrNny-5HmgUj9OHSB9j3R5gPtNRZT4_8cAf4JkGZ494MjtFK7XieCgoSuyQUG5Zs2g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kM2fZqsdU05EX9dU4iev9GJTPmja_T_Zfv6s_QcD31w&oe=6A43C662"}, {"file_name": "P_B AL Screenshot 4.png", "id": "518739209904368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031379_518739216571034_1284219877153266314_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGGOlS6sgMAQ7kNvwFOAK1s&_nc_oc=AdoU6IzZC8fMDJs-T0ROiLZLdxqLghc6DjzGBnk0rQMAV2Nwx-PFerHMhyI9Uh2vXJQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-4CEM7W7tg9Uod-QVcQAJcSflXzrIVyHuKabDHqMhZg&oe=6A43BD10"}, {"file_name": "P_B AL Screenshot 1.png", "id": "708670357002595", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269157_708670360335928_193755403889150652_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC0sKOJtALcQ7kNvwG2WyZT&_nc_oc=AdqeoaXjnTcPiXPJGV1hg5F-FVpz3PQfK0p-gpfMqpMBjH7FQ5Fa5CKo71DF9VXHFF0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AYZ-Uih4Y5ydJMTbqL1x0q2EiD2dC6n8BQOlUTf8u9A&oe=6A43D413"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P_B AL Trailer Cover Image.png", "id": "529657845443234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75435283_529657848776567_8797300247194641549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXB-kDihe_cQ7kNvwG2T22x&_nc_oc=AdrARgm5W1wzZms0DKJcvaN0Bn_-rX-Nh2kRUInF5Uur5942dSlIg7RIluuXpPROMCA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cHZhkvDD4rIN8IzAwxJVbXeizA9ssPEV5n0oBRfgnng&oe=6A43BA18"}, "display_name": "Pull&Bear", "keywords": [], "long_description": "Pull&Bear, the Inditex group's youth fashion brand, is consolidating its commitment to digital innovation by presenting its own virtual reality in the metaverse project, which comprises a virtual showroom, a fitting room to try on the brand\u2019s outfits and a surfing game. Customers can also be transported to part of this world through a web adaptation that users can access to navigate the virtual world, try out the Ready Player Me avatar creator to make their own 3D avatar with a selfie and wear Pull&Bear outfits. \n\nFor this project, Pull&Bear has digitalised six looks from its collections designed for Generation Z. The garments will be compatible with apps and games on the Ready Player Me platform, including VRChat, Sommium Space, LIV, and Animaze.", "short_description": "Explore the virtual world and try on the virtual clothing collection for your Ready Player Me avatar. And get the full gaming experience at home using Meta Quest virtual reality glasses soon. Are you in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.pullandbear.net/2/static2/policies/privacy_policy/pullandbear_privacy_policy_GB_en.pdf?20220429020501", "developer_terms_of_service_url": null, "publisher_name": "Pull&Bear", "support_website_url": "https://www.pullandbear.com/es/contact.html", "website_url": "https://www.pullandbear.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIR
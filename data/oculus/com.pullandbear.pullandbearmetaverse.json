ot 3.png", "id": "1029111887977633", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031486_1029111891310966_4252490865094883202_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USIbgIAHt_kQ7kNvwGdH9mY&_nc_oc=Adr_nSWiD1WxCfjB0BeqYtmBdHvf-fn26UaeBTGo-3fggbP_vv_d7M_78tE8nyBz5i8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFie-6WUABnHxukav_Z1-yXZdtRZl3Lo69fRh4k9FSUQ&oe=6AA93943"}, {"file_name": "P_B AL Screenshot 2.png", "id": "374124338097663", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75540505_374124341430996_1348120629434438949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjeqG_8rSIgQ7kNvwHMfeSU&_nc_oc=Adpek2R2PmiRQFT4XTzUVmolkPFQxZQRqlJeh4G4zlv38CtKqoCg-YGlL6iT7Ux-U8I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJkUU12bE1u4eTQ9v0JcPaeDl5-rHzq67QGv6OG5EOEQ&oe=6AA949E2"}, {"file_name": "P_B AL Screenshot 4.png", "id": "518739209904368", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031379_518739216571034_1284219877153266314_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fQTXnVef24Q7kNvwEsWLr7&_nc_oc=Adocs4VvoNRDOpFxQ1FsEl8ZSdV-1sT61e3tanTv9qNoVKeSMbIWRXQRQf1Y1Fn1EQY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiJZ_sfGpaCftKdt4-fSSvKQHuUyQhWxzl2zMUFSKd1g&oe=6AA94090"}, {"file_name": "P_B AL Screenshot 1.png", "id": "708670357002595", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75269157_708670360335928_193755403889150652_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhst8q_p-EAQ7kNvwELq15J&_nc_oc=AdqIy83Lmh0GKgiKNEI_U-iH4QOI1H8hwhDaRmzOUkea19uew8wLH4ywcNDBviIR_Lg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF_u65a-XezRSrluTaclxnu5Uj7QA9ZrrDYZgI1NXHMw&oe=6AA95793"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P_B AL Trailer Cover Image.png", "id": "529657845443234", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75435283_529657848776567_8797300247194641549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGocyDuRHmUQ7kNvwFDmDdF&_nc_oc=AdrgsnqrreS0W-3FASJBDByf2Z3Y5GArs-_q5XaF_1ieHnXTXOpOI_JZLzas_jfrRLk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdXjRUB6GQGDhljAi7oc-LsiLVqJcMuhSGqFnoBG1EjQ&oe=6AA93D98"}, "display_name": "Pull&Bear", "keywords": [], "long_description": "Pull&Bear, the Inditex group's youth fashion brand, is consolidating its commitment to digital innovation by presenting its own virtual reality in the metaverse project, which comprises a virtual showroom, a fitting room to try on the brand\u2019s outfits and a surfing game. Customers can also be transported to part of this world through a web adaptation that users can access to navigate the virtual world, try out the Ready Player Me avatar creator to make their own 3D avatar with a selfie and wear Pull&Bear outfits. \n\nFor this project, Pull&Bear has digitalised six looks from its collections designed for Generation Z. The garments will be compatible with apps and games on the Ready Player Me platform, including VRChat, Sommium Space, LIV, and Animaze.", "short_description": "Explore the virtual world and try on the virtual clothing collection for your Ready Player Me avatar. And get the full gaming experience at home using Meta Quest virtual reality glasses soon. Are you in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.pullandbear.net/2/static2/policies/privacy_policy/pullandbear_privacy_policy_GB_en.pdf?20220429020501", "developer_terms_of_service_url": null, "publisher_name": "Pull&Bear", "support_website_url": "https://www.pullandbear.com/es/contact.html", "website_url": "https://www.pullandbear.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NO
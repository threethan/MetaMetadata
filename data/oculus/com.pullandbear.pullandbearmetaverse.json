i": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031486_1029111891310966_4252490865094883202_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FZAsCD4srYQ7kNvwHM5Syg&_nc_oc=AdmFIYlGFTfK94d-V--bLc4xmS71XuJx3a1Pf-CG3WoIAclZ5C7w00R0oiRVLz3S-WY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxK-IoBmyUgpUftb1SmCfM_UJevO6-AWvfftObSqQvoPA&oe=69B7F6C3"}, {"file_name": "P_B AL Screenshot 2.png", "id": "374124338097663", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75540505_374124341430996_1348120629434438949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2p7mFVc2Ic4Q7kNvwE1axBf&_nc_oc=Adl-1nKqUyw_ES7vDE2bD3pveEal8GuSTdBShug3lTWee3_0_7wTsO-lcBqE1KpakiA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzh7Vmw3Gsdib8ZAWIxKRDcG_maYakmjiAuVI9FWNRwog&oe=69B80762"}, {"file_name": "P_B AL Screenshot 4.png", "id": "518739209904368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031379_518739216571034_1284219877153266314_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVmfF0NHL3MQ7kNvwGAprv1&_nc_oc=AdkECN0Or8tu4LN2avgz7wXzBoFHUFvLGuB20GmPq5SRF2_v8tvZqAvTfn5PHjIuFps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzYfrec6dz0s9U8v9NVhWy98tzsKfEnkf1jWx1r1xO_tg&oe=69B7FE10"}, {"file_name": "P_B AL Screenshot 1.png", "id": "708670357002595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269157_708670360335928_193755403889150652_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFGbTIDjXQUQ7kNvwGMkd9M&_nc_oc=AdnAZmy5Blr4WnYvAYF937EIux5-a8SBCgTjPXlJo7i8DkRJcYRnO9FhX5-yquoFZsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxdeZZWleWz_So92LqBIbEfnv147ath0RsUtXTi1eTjEg&oe=69B81513"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P_B AL Trailer Cover Image.png", "id": "529657845443234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75435283_529657848776567_8797300247194641549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65WnnwY96x4Q7kNvwGnR6ch&_nc_oc=AdnxOSoRAt3pN79d1uKkB_8z3VeGAH5mleybVEFe9E73NN3-uhJgzlgG0rF_bMkW5wM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw5sT1i1mDz3IEklJyRbfqrn-EGAGdRByOpBH3RSzKZOQ&oe=69B7FB18"}, "display_name": "Pull&Bear", "keywords": [], "long_description": "Pull&Bear, the Inditex group's youth fashion brand, is consolidating its commitment to digital innovation by presenting its own virtual reality in the metaverse project, which comprises a virtual showroom, a fitting room to try on the brand\u2019s outfits and a surfing game. Customers can also be transported to part of this world through a web adaptation that users can access to navigate the virtual world, try out the Ready Player Me avatar creator to make their own 3D avatar with a selfie and wear Pull&Bear outfits. \n\nFor this project, Pull&Bear has digitalised six looks from its collections designed for Generation Z. The garments will be compatible with apps and games on the Ready Player Me platform, including VRChat, Sommium Space, LIV, and Animaze.", "short_description": "Explore the virtual world and try on the virtual clothing collection for your Ready Player Me avatar. And get the full gaming experience at home using Meta Quest virtual reality glasses soon. Are you in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.pullandbear.net/2/static2/policies/privacy_policy/pullandbear_privacy_policy_GB_en.pdf?20220429020501", "developer_terms_of_service_url": null, "publisher_name": "Pull&Bear", "support_website_url": "https://www.pullandbear.com/es/contact.html", "website_url": "https://www.pullandbear.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphi
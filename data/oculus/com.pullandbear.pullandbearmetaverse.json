i": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031486_1029111891310966_4252490865094883202_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7Cgti6xSOMQ7kNvwHpoc2d&_nc_oc=AdntT1IvYAtZiu1IZtMEkIIqQVAPsPVjeuEB3zSsj1sqHOpI2rjw7n9pyZWkt3cI5uA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfziRchypnSfwkIKnLs8lJ_A6nEU5NjZI2aCpR015LDzTQ&oe=69B2B0C3"}, {"file_name": "P_B AL Screenshot 2.png", "id": "374124338097663", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75540505_374124341430996_1348120629434438949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOauHeOLYvsQ7kNvwEZlxmX&_nc_oc=AdmJovADruqX0GiJbWf2K8a6gD6kTmRmYHWmCS3LrDOtUxq9NwuLAtolGEELG6BYjCA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxm5ujqcCAWPlLCRM0kp9sO4ymD22toMNt73D_3UxqPvw&oe=69B2C162"}, {"file_name": "P_B AL Screenshot 4.png", "id": "518739209904368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031379_518739216571034_1284219877153266314_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeANuBH9RwAQ7kNvwEjs4FV&_nc_oc=AdnKBIZi4D3NI3XzeL44jl8Ibj0FIQ_YlrSolyUyGuKpTC5YHBYBEq5_UsTtHDNjMIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyhXH111r4dNsSjOCXYk7MikExJFpmObQ6u8YKWiUOb3Q&oe=69B2B810"}, {"file_name": "P_B AL Screenshot 1.png", "id": "708670357002595", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75269157_708670360335928_193755403889150652_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7pDm9tTYGsQ7kNvwH_rM7L&_nc_oc=AdnpUxamS1v2j0of3mbR8w12o5pn8suKEeesF3noNwcFknq3b7Om8ZIRDqpO7jIN3eI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzwQ6hH2UYqogOET2jQcLvOOW5ZPoMg4j9QMGnkAuuOBQ&oe=69B2CF13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P_B AL Trailer Cover Image.png", "id": "529657845443234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75435283_529657848776567_8797300247194641549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BRlt4b-MwYQ7kNvwETfn0N&_nc_oc=AdmCDdB-GaN-gy5WlIPCTxPovEtfKh_OlKoSzSbgKTBBQ7gYxBks7sp8EhsQgOGrOq4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwq2kpkDtj2lEVIYgvXDce5ROoJYL-6ABVmgckq6WirKw&oe=69B2B518"}, "display_name": "Pull&Bear", "keywords": [], "long_description": "Pull&Bear, the Inditex group's youth fashion brand, is consolidating its commitment to digital innovation by presenting its own virtual reality in the metaverse project, which comprises a virtual showroom, a fitting room to try on the brand\u2019s outfits and a surfing game. Customers can also be transported to part of this world through a web adaptation that users can access to navigate the virtual world, try out the Ready Player Me avatar creator to make their own 3D avatar with a selfie and wear Pull&Bear outfits. \n\nFor this project, Pull&Bear has digitalised six looks from its collections designed for Generation Z. The garments will be compatible with apps and games on the Ready Player Me platform, including VRChat, Sommium Space, LIV, and Animaze.", "short_description": "Explore the virtual world and try on the virtual clothing collection for your Ready Player Me avatar. And get the full gaming experience at home using Meta Quest virtual reality glasses soon. Are you in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.pullandbear.net/2/static2/policies/privacy_policy/pullandbear_privacy_policy_GB_en.pdf?20220429020501", "developer_terms_of_service_url": null, "publisher_name": "Pull&Bear", "support_website_url": "https://www.pullandbear.com/es/contact.html", "website_url": "https://www.pullandbear.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphi
ot 3.png", "id": "1029111887977633", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031486_1029111891310966_4252490865094883202_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qwykk-syKlUQ7kNvwH-qs67&_nc_oc=Ado4Yq4C3ydOVJ_pmPnwvdiBRRzbQZrhHCIGy-Oio7GZXzCqs9unpzF8Y6AWdqe5SZI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwzcqoj2sGF34xdO56cFVwIpnPD3lcXZfpNcA7fAYe9w&oe=6A7DB7C3"}, {"file_name": "P_B AL Screenshot 2.png", "id": "374124338097663", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75540505_374124341430996_1348120629434438949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ojyytjshxAQ7kNvwEUtRwx&_nc_oc=Adrqh6W03JSRbveKVSX-0bo4kQ_X68wpso87OVucOr0nKS5NmmRMZSNV7RPnCt6UY1w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgsTDM0p-ct-RYxTdxNAOvN3afkee6r_Pe_n9RKeNN2w&oe=6A7DC862"}, {"file_name": "P_B AL Screenshot 4.png", "id": "518739209904368", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031379_518739216571034_1284219877153266314_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9Lgtl63UdcQ7kNvwEJs-BC&_nc_oc=AdqzS6VbGs0mS-mRINpKxyk43Yra7arbJEfHTz9xIwB5rKIDatTolZHi-ANSHB6CK-Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfUhc_9dMu4kI5oHbZeLnFsbMBFYg6HILRIRMUQFm4Bw&oe=6A7DBF10"}, {"file_name": "P_B AL Screenshot 1.png", "id": "708670357002595", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75269157_708670360335928_193755403889150652_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITMW5MJ1DdMQ7kNvwFgrrMu&_nc_oc=AdoQ4jtn8aO04myM6SJrXyfjgkXcY_gb1z58uJrKfzuEu_TDiNiDZxmyBsD-cGJrrLk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYcHkitDM46VTj2n0iG0Fgz_kJn8cPIeBPrxo__WjfYQ&oe=6A7D9DD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P_B AL Trailer Cover Image.png", "id": "529657845443234", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75435283_529657848776567_8797300247194641549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FA653vxrCIQQ7kNvwGdXdb8&_nc_oc=AdoX9_UZ0AyyPMB__NnSu9oLqpSLXyvng0yqX4ygRDISI7RR6EvSEVkcIfg9uXpVbYI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMjAyjNKS5Jb9svRHBMcUTMqcgzvsWrLI8kUibtvkgMg&oe=6A7DBC18"}, "display_name": "Pull&Bear", "keywords": [], "long_description": "Pull&Bear, the Inditex group's youth fashion brand, is consolidating its commitment to digital innovation by presenting its own virtual reality in the metaverse project, which comprises a virtual showroom, a fitting room to try on the brand\u2019s outfits and a surfing game. Customers can also be transported to part of this world through a web adaptation that users can access to navigate the virtual world, try out the Ready Player Me avatar creator to make their own 3D avatar with a selfie and wear Pull&Bear outfits. \n\nFor this project, Pull&Bear has digitalised six looks from its collections designed for Generation Z. The garments will be compatible with apps and games on the Ready Player Me platform, including VRChat, Sommium Space, LIV, and Animaze.", "short_description": "Explore the virtual world and try on the virtual clothing collection for your Ready Player Me avatar. And get the full gaming experience at home using Meta Quest virtual reality glasses soon. Are you in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.pullandbear.net/2/static2/policies/privacy_policy/pullandbear_privacy_policy_GB_en.pdf?20220429020501", "developer_terms_of_service_url": null, "publisher_name": "Pull&Bear", "support_website_url": "https://www.pullandbear.com/es/contact.html", "website_url": "https://www.pullandbear.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NO
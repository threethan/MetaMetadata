7&_nc_sid=6e7a0a&_nc_ohc=lf4pB9KR8m8Q7kNvwHjXpEY&_nc_oc=AdplpZK1EXgxB9FJJTfN36n1DITugmREUwLG2V_FjB9b5wKGQ1jZzcKvE1KM7SskUEw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtIZMBl25aHcp7lQgcAKDxnXKpwLdtVSqITMP14N6E7g&oe=6AF349D8"}, "display_name": "Pull&Bear", "keywords": [], "long_description": "Pull&Bear, the Inditex group's youth fashion brand, is consolidating its commitment to digital innovation by presenting its own virtual reality in the metaverse project, which comprises a virtual showroom, a fitting room to try on the brand\u2019s outfits and a surfing game. Customers can also be transported to part of this world through a web adaptation that users can access to navigate the virtual world, try out the Ready Player Me avatar creator to make their own 3D avatar with a selfie and wear Pull&Bear outfits. \n\nFor this project, Pull&Bear has digitalised six looks from its collections designed for Generation Z. The garments will be compatible with apps and games on the Ready Player Me platform, including VRChat, Sommium Space, LIV, and Animaze.", "short_description": "Explore the virtual world and try on the virtual clothing collection for your Ready Player Me avatar. And get the full gaming experience at home using Meta Quest virtual reality glasses soon. Are you in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.pullandbear.net/2/static2/policies/privacy_policy/pullandbear_privacy_policy_GB_en.pdf?20220429020501", "developer_terms_of_service_url": null, "publisher_name": "Pull&Bear", "support_website_url": "https://www.pullandbear.com/es/contact.html", "website_url": "https://www.pullandbear.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIR
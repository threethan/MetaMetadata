", "id": "1029111887977633", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031486_1029111891310966_4252490865094883202_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYA6THmMASUQ7kNvwEhWBVB&_nc_oc=Adpd9T-hqRwJXLMcdg5mEliKQQKXJZTuuG2Jn3bLSRMQdbVMd9g56lFA5BnAQtGuFDw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eEKbFHZE75HYvmNFmTCSnyeehvPBrYLqfEyiSv2Z7dA&oe=6A0C56C3"}, {"file_name": "P_B AL Screenshot 2.png", "id": "374124338097663", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75540505_374124341430996_1348120629434438949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9y0sXDY4wYQ7kNvwHb1Pcc&_nc_oc=Adr3VcPxdFBPtiTC4K8GL6fOzTu1tteh1G-R3WiWzUjk3xfh2DwkvQ9hYFjr9dZiono&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OZS8sxR06o8cBqnseeinyIUEK2vSTOyz1mti4l-Tl-A&oe=6A0C6762"}, {"file_name": "P_B AL Screenshot 4.png", "id": "518739209904368", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031379_518739216571034_1284219877153266314_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBocORnPUF0Q7kNvwFBcJzR&_nc_oc=AdqNjpoX1T5VrrMDkCt9EcmTmi9_hp0G9dPWtDiMv_hbVupyEbDXMQKZn6XYIGg7960&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ILjRHzLsaie63z46vtKq6JjDpUN_fZi1bwN8DBP3w8w&oe=6A0C5E10"}, {"file_name": "P_B AL Screenshot 1.png", "id": "708670357002595", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75269157_708670360335928_193755403889150652_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxdp_XbXFkoQ7kNvwESVikR&_nc_oc=Adphu31ZTocDuS3X2Htt8sYqqEwHba8ZdnV2enDA5ZdFrZ-t1eb7O-4UgeQNF3Y3F0E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KphDTCAlDm4GMBWI9ki1Rfgj7v8YrBnZZcYtokTh9SQ&oe=6A0C7513"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P_B AL Trailer Cover Image.png", "id": "529657845443234", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75435283_529657848776567_8797300247194641549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoYHA4bAggQQ7kNvwFyd4QK&_nc_oc=Ado5Y_RNfP8hFCHJAubvR5X_iTZGFcNtSeND6glDW3t6ctTLKArJxis09sJ5IGivpa0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Og0RvtRew6tEvQZwAURvu2PMvIsYZzCaSX-n8RMO-fA&oe=6A0C5B18"}, "display_name": "Pull&Bear", "keywords": [], "long_description": "Pull&Bear, the Inditex group's youth fashion brand, is consolidating its commitment to digital innovation by presenting its own virtual reality in the metaverse project, which comprises a virtual showroom, a fitting room to try on the brand\u2019s outfits and a surfing game. Customers can also be transported to part of this world through a web adaptation that users can access to navigate the virtual world, try out the Ready Player Me avatar creator to make their own 3D avatar with a selfie and wear Pull&Bear outfits. \n\nFor this project, Pull&Bear has digitalised six looks from its collections designed for Generation Z. The garments will be compatible with apps and games on the Ready Player Me platform, including VRChat, Sommium Space, LIV, and Animaze.", "short_description": "Explore the virtual world and try on the virtual clothing collection for your Ready Player Me avatar. And get the full gaming experience at home using Meta Quest virtual reality glasses soon. Are you in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.pullandbear.net/2/static2/policies/privacy_policy/pullandbear_privacy_policy_GB_en.pdf?20220429020501", "developer_terms_of_service_url": null, "publisher_name": "Pull&Bear", "support_website_url": "https://www.pullandbear.com/es/contact.html", "website_url": "https://www.pullandbear.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIR
i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031486_1029111891310966_4252490865094883202_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMLXNFNY1hkQ7kNvwEcQ3rj&_nc_oc=Adk_-YITKOeGSmhKKZ6aIZYNm1lNX5BqKMz1ftcfsTk6t3Tr5pEp5i50kVVlwbtUgU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmxQ0w6QCOpVO-cn0JKip0OK8ih4H5AqKzdukG0yVYuA&oe=69AEBC43"}, {"file_name": "P_B AL Screenshot 2.png", "id": "374124338097663", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75540505_374124341430996_1348120629434438949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6kpCMIExV4Q7kNvwHqzHrX&_nc_oc=AdlEo8jyo6p3_Mw0FKEdOoTIHvhQZ2mcJtmucXhzox64r7M1uqMXtpALbiiord8aN5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCPTQulcfxwlBplrKPxpqh7AkWOc14gC1YOwTDMRJ3Vw&oe=69AECCE2"}, {"file_name": "P_B AL Screenshot 4.png", "id": "518739209904368", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031379_518739216571034_1284219877153266314_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNFnFPCOC84Q7kNvwFVLG3z&_nc_oc=AdmYuZLJX4Ny2dFWhucdfYxboBFx4gYpddk1teuJODKJMdG1R2ZUPSUYvEPJP4HM76Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaXy6bYhWJbQs3BwF7APFAuNEY_GizAXrHL82thqIsXw&oe=69AEC390"}, {"file_name": "P_B AL Screenshot 1.png", "id": "708670357002595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269157_708670360335928_193755403889150652_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHOjxDnrhKgQ7kNvwEldzwB&_nc_oc=Adn8jauHcx1LD7jnP82uP4j0D6OLEWD1AUEFNFx3Kvgn4d0m-Zk_CPFYj4y3ss3kN5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvqZECjltVpfkdVhbv51q5rTotJOZZ4H1yJWzqlvu4Xg&oe=69AEDA93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P_B AL Trailer Cover Image.png", "id": "529657845443234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75435283_529657848776567_8797300247194641549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bft99Qz2N_MQ7kNvwGyufc7&_nc_oc=AdlzH7vcwgkCja_yfQfRVWsHJGQeG5z428NcDhpX5lZkLQblYEpkyjYLlTmFsYRbMFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfymfTQDCTGgn8J_k_fBZAd0OPHK2Fxm7YUVuwurRlvivA&oe=69AEC098"}, "display_name": "Pull&Bear", "keywords": [], "long_description": "Pull&Bear, the Inditex group's youth fashion brand, is consolidating its commitment to digital innovation by presenting its own virtual reality in the metaverse project, which comprises a virtual showroom, a fitting room to try on the brand\u2019s outfits and a surfing game. Customers can also be transported to part of this world through a web adaptation that users can access to navigate the virtual world, try out the Ready Player Me avatar creator to make their own 3D avatar with a selfie and wear Pull&Bear outfits. \n\nFor this project, Pull&Bear has digitalised six looks from its collections designed for Generation Z. The garments will be compatible with apps and games on the Ready Player Me platform, including VRChat, Sommium Space, LIV, and Animaze.", "short_description": "Explore the virtual world and try on the virtual clothing collection for your Ready Player Me avatar. And get the full gaming experience at home using Meta Quest virtual reality glasses soon. Are you in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.pullandbear.net/2/static2/policies/privacy_policy/pullandbear_privacy_policy_GB_en.pdf?20220429020501", "developer_terms_of_service_url": null, "publisher_name": "Pull&Bear", "support_website_url": "https://www.pullandbear.com/es/contact.html", "website_url": "https://www.pullandbear.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphi
dn.com/v/t64.5771-25/75540505_374124341430996_1348120629434438949_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg0lo-_xrEkQ7kNvwFtc1f2&_nc_oc=Adq0FLg8Iu2menLaRCWD-LA2rN2fnWbXLhBHFyZuPJFlbdH4x6bEvqmI4BNTA_yO0-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOh9qMrfpI3gmBf2TjqhYEdveDyscmRwzlwgVbQg-t4g&oe=6ACA77A2"}, {"file_name": "P_B AL Screenshot 4.png", "id": "518739209904368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031379_518739216571034_1284219877153266314_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unZ8Oc_vv7wQ7kNvwFUx4lz&_nc_oc=AdoI0KgfVLeymZrQ2CmLMVTas92ZH9Af53b3q5qhsbVBSOIYUQHeMOmaFaD-UiF1QH0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrE9Eta6TElP_C5DCCQAy8H71T-38b6EKZInY_1ToV4g&oe=6ACA6E50"}, {"file_name": "P_B AL Screenshot 1.png", "id": "708670357002595", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269157_708670360335928_193755403889150652_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMwfrD4IhLEQ7kNvwGecTjA&_nc_oc=AdpQ8SwsAkbJjuxngqih4aLCc04J7d6dYPsHxBL4cSLulE63ts63CSbcY_jNplKy87M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjL52ZNswKgMnE5gqRayWOfADlUj96QIBblxA5hMcJfg&oe=6ACA4D13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P_B AL Trailer Cover Image.png", "id": "529657845443234", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75435283_529657848776567_8797300247194641549_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Y64-GPKCaAQ7kNvwGl25CS&_nc_oc=Adr3znqNzNNh9ds2VA07Z-sorZA_IWUHUZjBgd6mZ1S5dazOt5UQZzhm2O-SNVZVENI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrp6hj2tpsVb24RP79tY2uM6B7HJvY_nEzPjbzOzZHlg&oe=6ACA6B58"}, "display_name": "Pull&Bear", "keywords": [], "long_description": "Pull&Bear, the Inditex group's youth fashion brand, is consolidating its commitment to digital innovation by presenting its own virtual reality in the metaverse project, which comprises a virtual showroom, a fitting room to try on the brand\u2019s outfits and a surfing game. Customers can also be transported to part of this world through a web adaptation that users can access to navigate the virtual world, try out the Ready Player Me avatar creator to make their own 3D avatar with a selfie and wear Pull&Bear outfits. \n\nFor this project, Pull&Bear has digitalised six looks from its collections designed for Generation Z. The garments will be compatible with apps and games on the Ready Player Me platform, including VRChat, Sommium Space, LIV, and Animaze.", "short_description": "Explore the virtual world and try on the virtual clothing collection for your Ready Player Me avatar. And get the full gaming experience at home using Meta Quest virtual reality glasses soon. Are you in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://static.pullandbear.net/2/static2/policies/privacy_policy/pullandbear_privacy_policy_GB_en.pdf?20220429020501", "developer_terms_of_service_url": null, "publisher_name": "Pull&Bear", "support_website_url": "https://www.pullandbear.com/es/contact.html", "website_url": "https://www.pullandbear.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1397612214079703"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3299574206983987"}]}, "baseline_offer": {"id": "3299574206983987"}, "is_approved": true,
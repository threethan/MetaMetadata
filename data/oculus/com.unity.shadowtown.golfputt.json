c-Yl93pXPGyuK0t7hJpxK9T1tAVewPxLfeobntFhWB23ajYgkRwk7-sZJjkj9_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2W6E1C6_KQ08TcBh6-UjimuUNRxruHi6t4wEWk4wuMqg&oe=69DA4F11"}, {"file_name": "2.png", "id": "912089574690226", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823905_912089578023559_6085521381280545104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PonkmvoNI6IQ7kNvwFvdo7h&_nc_oc=AdpL-GqMPR4UOvTyWHXQykOjCxCf9_Wxbq_HRFhdv5R-8LiM_mcQX2O76P7YTsjygrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SeKIqUjPi8ffo-DazDiCMZakRWTn9bAViOhNzt4TFDg&oe=69DA3032"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "2294461364290706", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619518_2294461367624039_7763283229910055400_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0rB2SsFvD8Q7kNvwEclSVv&_nc_oc=AdrvLRsjf0dJZ0BGiVATPpR7g3xP8H9DGIVtXLdK2t6wh5NPwSU0GJQYtdUGzw1LA2Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tI0JHbBVDpRoRfIdo7n1Sj3UpKGAuYe0v9mZ4ERinhQ&oe=69DA4F2F"}, "display_name": "House Golf", "keywords": ["minigolf", "vrgolf", "casualgame", "metagames", "physicsgame"], "long_description": "Play mini-golf from a hamster\u2019s perspective! \ud83d\udc39 Swing through a giant living room where chairs are mountains and cables are hazards. Realistic physics meets a \"shrunk-down\" world in this immersive 10-hole VR adventure!\n{792865119842385}\n\u26f310 Creative, Hand-Crafted Holes: From navigating around a high-end PC setup to banking shots off the kitchen island, every hole offers a unique challenge.\n{890163957099328}\n\ud83c\udfcc\ufe0fNatural physics and swing mechanics make it feel like you\u2019re holding a real putter.\n{1452647773184749}", "short_description": "A physics-based VR mini golf experience set inside a cozy living room. Line up your shots, master realistic putting, and complete creative holes designed for quick, fun VR sessions."}]}, "developer_name": "ShadowTwon", "developer_privacy_policy_url": "https://sites.google.com/view/shadowtowndev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ShadowTown", "support_website_url": null, "website_url": "https://sites.google.com/view/shadowtowndev/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26176804785338237"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619518_976340934966904_6479432109150767529_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTG_aH5ruiQQ7kNvwEN8AGc&_nc_oc=AdqrwXC_goqvT3Y8CJyfCuvwGb9WbXi6jvjIiu41x4Wi7VvaoVE-hcGvs0QTbsdf9Us&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31e-cYRz5sraBqOVtCkxYrZncqUdRp-oMvtcAse3A7uA&oe=69DA2F2F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "House Golf", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1770844080, "lastRevision": {"nodes": [{"id": "25591823637169691", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25591823543836367", "is_first_party": false, "enables_in_app_ads": false, 
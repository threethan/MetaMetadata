 sessions."}]}, "developer_name": "ShadowTwon", "developer_privacy_policy_url": "https://sites.google.com/view/shadowtowndev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ShadowTown", "support_website_url": null, "website_url": "https://sites.google.com/view/shadowtowndev/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26641408475544530"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821099_920201307688841_8498390502765851925_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvMQtAhov6AQ7kNvwFwYv0z&_nc_oc=AdpkG4A2sL6vXuID9OiRkS666QUSDtVT5T9JXxZeUm5LRR8yp-CUhi54P5SriAJhwnw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cnulKmAoaQlMzRV56kpj2M8KpqcJgIoX_pi0Y_W_Qww&oe=6A11CD84"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I am Golfer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1770844080, "lastRevision": {"nodes": [{"id": "25591823637169691", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25591823543836367", "is_first_party": false, "enables_in_app_ads": fals
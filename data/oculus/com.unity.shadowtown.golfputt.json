Af1WI8Pdi6K-QRfR2HfildR19EvI2c2bl-fJLI2P-egmpQ&oe=69F0B891"}, {"file_name": "2.png", "id": "912089574690226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_912089578023559_6085521381280545104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jv-kffCC3wQ7kNvwF7YkJ7&_nc_oc=AdppR-w3-YJM4hGm4NMOt6vxbhyIgnqrA2LI0sFS-zT1Ysiyy-Kp51Iircor2nnq44k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3VudKX7M7gCbhDu4bvhAQD0KINL6d8TATr_BwLwlSv8A&oe=69F0D1F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "4454626281524071", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619668_4454626284857404_3649373871460290048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUkyM7D2GhoQ7kNvwGOWRN0&_nc_oc=Adro3lQ5Cqmhc01-V29nyXF1aOCe-IHr4J1eo0VwaSLgROU7-scmhKZWg3CYRnj1Bjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0omRQ7pFgIZzOI43cTdWtNpZJ4w14yNrNRC7ZiZQg4xg&oe=69F0A64F"}, "display_name": "House Golf", "keywords": ["minigolf", "vrgolf", "casualgame", "metagames", "physicsgame"], "long_description": "Play mini-golf from a hamster\u2019s perspective! \ud83d\udc39 Swing through a giant living room where chairs are mountains and cables are hazards. Realistic physics meets a \"shrunk-down\" world in this immersive 10-hole VR adventure!\n{792865119842385}\n\u26f310 Creative, Hand-Crafted Holes: From navigating around a high-end PC setup to banking shots off the kitchen island, every hole offers a unique challenge.\n{890163957099328}\n\ud83c\udfcc\ufe0fNatural physics and swing mechanics make it feel like you\u2019re holding a real putter.\n{1452647773184749}", "short_description": "A physics-based VR mini golf experience set inside a cozy living room. Line up your shots, master realistic putting, and complete creative holes designed for quick, fun VR sessions."}]}, "developer_name": "ShadowTwon", "developer_privacy_policy_url": "https://sites.google.com/view/shadowtowndev/privacy-policy", "developer_term
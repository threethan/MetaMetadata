tl3-3.oculuscdn.com&oh=00_Af30DX4uRjdh8J-som94pI8E5XeknFRVY4cPARHVlROcBQ&oe=69F20A11"}, {"file_name": "2.png", "id": "912089574690226", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823905_912089578023559_6085521381280545104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jv-kffCC3wQ7kNvwEA0a9A&_nc_oc=AdpifNqkJNEuXyD1qn5ZU7uAzgq9adzjZclwqCQTPqtGl7XvDuYh9ySxi4rYvy1NHV0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af05DspRunFrQ7t7lNEWa-bl6vVhFUbzd0V_DQ-0-9g7xQ&oe=69F1EB32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "4454626281524071", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619668_4454626284857404_3649373871460290048_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUkyM7D2GhoQ7kNvwHE1FeH&_nc_oc=AdoyItCJCBexjEO09guOWlBgGB6ildNuyelWALKQjbCnKnU5f57LUnUI7dJyVnLpMQg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0SqiRQls6u8PP47xUOzMQKXHjOsrncx2_NW_35yd13eg&oe=69F1F7CF"}, "display_name": "House Golf", "keywords": ["minigolf", "vrgolf", "casualgame", "metagames", "physicsgame"], "long_description": "Play mini-golf from a hamster\u2019s perspective! \ud83d\udc39 Swing through a giant living room where chairs are mountains and cables are hazards. Realistic physics meets a \"shrunk-down\" world in this immersive 10-hole VR adventure!\n{792865119842385}\n\u26f310 Creative, Hand-Crafted Holes: From navigating around a high-end PC setup to banking shots off the kitchen island, every hole offers a unique challenge.\n{890163957099328}\n\ud83c\udfcc\ufe0fNatural physics and swing mechanics make it feel like you\u2019re holding a real putter.\n{1452647773184749}", "short_description": "A physics-based VR mini golf experience set inside a cozy living room. Line up your shots, master realistic putting, and complete creative holes designed for quick, fun VR sessions."}]}, "developer_name": "ShadowTwon", "developer_privacy_policy_url": "https://sites.google.com/view/shadowt
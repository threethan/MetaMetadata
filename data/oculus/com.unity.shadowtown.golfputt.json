ZxTioxr4aE2B0A5jtNx1znX-QTU6bFcQ6EtefChjMApWTXw1Jfk2U-fvvZN8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y69VsCvDp4AJNpiMdlXBBTk9QT752Ut98RG7AwSsorg&oe=6A105C91"}, {"file_name": "2.png", "id": "912089574690226", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823905_912089578023559_6085521381280545104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fUB0mAsRBQQ7kNvwEtq7yH&_nc_oc=Ado2vqNhYurbVZImhQNT7yQm-vJ_iKDPJz2aSRBp7fQKukMjdcUyJjtk30ZGeyosJCs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68TdvGZ5uni3Nke5vQWFgiEqKuGsR3NTrGThKg04lkSg&oe=6A1075F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "3068938553312746", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491818849_3068938556646079_6674053457891076288_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2Me_QMAIWYQ7kNvwECk4Z_&_nc_oc=AdqNyS5jfXfbcILT4dILmlXuLqtWXybmLjHI07TsMPCuZdHAd5KkuUx-c9B5d6fhEYw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OmW3bQVICY1Vbg9ryQFgKpLKDGdDrX7Wl6bhFrn8Klw&oe=6A1069F5"}, "display_name": "I am Golfer", "keywords": ["minigolf", "vrgolf", "casualgame", "metagames", "physicsgame"], "long_description": "Play mini-golf from a hamster\u2019s perspective! \ud83d\udc39 Swing through a giant living room where chairs are mountains and cables are hazards. Realistic physics meets a \"shrunk-down\" world in this immersive 10-hole VR adventure!\n{792865119842385}\n\u26f310 Creative, Hand-Crafted Holes: From navigating around a high-end PC setup to banking shots off the kitchen island, every hole offers a unique challenge.\n{890163957099328}\n\ud83c\udfcc\ufe0fNatural physics and swing mechanics make it feel like you\u2019re holding a real putter.\n{1452647773184749}", "short_description": "A physics-based VR mini golf experience set inside a cozy living room. Line up your shots, master realistic putting, and complete creative holes designed for quick, fun VR sessions."}]}, "developer_name": "ShadowTwon", "developer_privacy_policy_url": "https://sites.google.com/view/shadowtowndev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ShadowTown", "support_website_url": null, "website_url": "https://sites.google.com/view/shadowtowndev/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26641408475544530"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491821099_920201307688841_8498390502765851925_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufSCuxGQTkQQ7kNvwHOkBUO&_nc_oc=AdqWe9CEiuboDbBvZbtLT-NNCZp9uLHSC1a3eZ4or1MATKzwa_zEAWHUHofKVaXjCx8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TisRogFc7Kmhg7e-0tY15ep8byyhN5s9TT6BwHDiwbg&oe=6A107C04"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I am Golfer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1770844080, "lastRevision": {"nodes": [{"id": "25591823637169691", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25591823543836367", "is_first_party": false, "enables_in_app_ads": false, "
_4906616680859738815_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qPxXppkHykQ7kNvwHsvVfs&_nc_oc=Adph0HZpPwPnqyk-dKB3n_-y5lJAFqWqisjkGi9U1MrkuEyXXiOH-XIe5Qkw1sl8SuM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZSubdDSt9lCoiwbdR0a-vvHlvWqSkW2MXjB0Wy_Exvw&oe=6AFF0F31"}, {"file_name": "Screenshot_2026-09-18_145151_2560x1440.png", "id": "4320472771504907", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499294603_4320472774838240_3210213186252699456_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0qdnTPmyMkQ7kNvwE2U6ct&_nc_oc=AdrXbUxJSrU25G783EM1dkt8YaC2hi-cLePjcK2BgpphJoHY7zF-V2AksxGjor62UfI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfpgbqjN-gU1GrJsXNcKhPKjQspGzJBFIy8OnmgRLHJA&oe=6AFF22AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tubbers", "keywords": [], "long_description": "Tubbers is a horror game developed by Zenzening and Vixen. Featuring a variety of exciting maps, unique game modes, and plenty of engaging content, Tubbers offers a thrilling experience for both new and returning players.\n\nTeam up with friends, explore terrifying environments, and grind for exclusive cosmetics as you progress through the game. Your mission is to collect Virus Samples by gathering Tubber Custard scattered throughout each map. Once all Custard has been collected, report back and complete your objective while surviving the horrors that await.\n\nWith regular challenges, rewarding progression, and a strong focus on cooperative gameplay, Tubbers delivers a fun and suspenseful adventure for ages 13 and up.\n", "short_description": "Tubbers is a virtual reality horror game inspired by Sean Toman's Slendytubbies (2012\u20132025). Players must explore eerie environments and complete their mission by collecting Custard scattered throughout each map. As you progress, you'll encounter terrifying threats, navigate dangerous locations, and work to survive while gathering all required Custard. Combining immersive VR gameplay with suspenseful horror elements, Tubbers delivers a thrilling and unforgettable experience.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/slendytubbers-vr-privacy-polic/home?pli=1&authuser=0", "developer_terms_of_service_url": null, "publisher_name": "PhantomWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/phantomworks", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28632692456356919"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1879233503253517"}]}, "baseline_offer": {"id": "1879233503253517"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790009280, "status": "PUBLISHED", "id": "1879233503253517"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28894560856836743", "version": "0.2"}, "id": "1620126645990615", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26606110335681818", "is_concept": false, "latest_released_bina
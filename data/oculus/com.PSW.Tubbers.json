fvEA&oe=6B031917"}, {"file_name": "screenshot_one_2560x1440.png", "id": "1386808016393343", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296209_1386808019726676_1148986645980226437_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTEc3tjOSzkQ7kNvwGJRcrj&_nc_oc=AdqdnyrpihBWGJodK57LMdl-PVo6xB5FMBew94vd71Y9_glr-haUJXe5CMRs0sXV_dg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU1WSmr_Bp6PPc1ouIkCTwNoncL0IZIauRSPFUMYYGdQ&oe=6B032E91"}, {"file_name": "Screenshot_Two__2560x1440.png", "id": "1409910504540908", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313063_1409910507874241_4906616680859738815_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkDmD8fXNH4Q7kNvwHQE4Y5&_nc_oc=AdrQ723vX3d2--UGxeEvgP_0A8einUZ2s_EBWAZcN7GJPspO5J7SPtCop3z7JpLFo1c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaaOwEBTz0rSEfEaKCCJPI6dYcLdSCa8Mo7H21xPHB2g&oe=6B0303B1"}, {"file_name": "Screenshot_2026-09-18_145151_2560x1440.png", "id": "4320472771504907", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499294603_4320472774838240_3210213186252699456_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdT9Z6Lpv7MQ7kNvwG5rOjV&_nc_oc=Ado3XX8_pOxs9xnHbjKkdXr7icT39qh4mvj6Cs-yP0Ap8UNprRUcGDNiqK-GWXOr1PU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIC1BTmvh6HcKBwtYWUDizzkMp4aAHhJhzTcxFs6ZIsw&oe=6B03172C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tubbers", "keywords": [], "long_description": "Tubbers is a horror game developed by Zenzening and Vixen. Featuring a variety of exciting maps, unique game modes, and plenty of engaging content, Tubbers offers a thrilling experience for both new and returning players.\n\nTeam up with friends, explore terrifying environments, and grind for exclusive cosmetics as you progress through the game. Your mission is to collect Virus Samples by gathering Tubber Custard scattered throughout each map. Once all Custard has been collected, report back and complete your objective while surviving the horrors that await.\n\nWith regular challenges, rewarding progression, and a strong focus on cooperative gameplay, Tubbers delivers a fun and suspenseful adventure for ages 13 and up.\n", "short_description": "Tubbers is a virtual reality horror game inspired by Sean Toman's Slendytubbies (2012\u20132025). Players must explore eerie environments and complete their mission by collecting Custard scattered throughout each map. As you progress, you'll encounter terrifying threats, navigate dangerous locations, and work to survive while gathering all required Custard. Combining immersive VR gameplay with suspenseful horror elements, Tubbers delivers a thrilling and unforgettable experience.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/slendytubbers-vr-privacy-polic/home?pli=1&authuser=0", "developer_terms_of_service_url": null, "publisher_name": "PhantomWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/phantomworks", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28632692456356919"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculu
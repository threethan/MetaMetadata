ntent-iad3-1.oculuscdn.com/v/t64.5771-25/673751957_1097378606411278_8009056317871889003_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bet9v-gHtNIQ7kNvwExxiSv&_nc_oc=AdqhDB80-f1d8xY1vnmiFPxM53HaUwXYaYalxtQMGl_fT0M9fX5JbwR7On3kClLgjEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4NdUrAkVJ1a-CKzLqXMQz8XOlvzyptZD7Is7vrrEYfQ&oe=6B00852A"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1666715294872875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831299_1666715298206208_5947666857036530629_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZzXMv2KdUkQ7kNvwFfJqwS&_nc_oc=AdpGo6Cx-GSkxIt_JTadD_IQbzqyXSQ7CbA7oNs9Xle_XwYeCZoKnTmNfH_3ICfL3wE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzKXIrJC3G2np3wMI-9w7_nRddilCl8WxDtBwEMYdmug&oe=6B0079A8"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1715222196211027", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831569_1715222199544360_6479431434231653590_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lv7Y86Irst0Q7kNvwHURs9H&_nc_oc=AdqHIR1K5zGMYDLVnjPGHD0b7E5ucdsQWQs92oDCRiMnG7YoC78pW5vDQdGBkndG1ZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtZ34LjJa5ctqkpIE0f1RPtaRT_ReUXDy_bj1jw7bPLA&oe=6B0058F1"}, {"file_name": "screenshot_3_2560x1440.png", "id": "2194152928111556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/585799753_2194152931444889_3112672306407764802_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEU1ySQVeMYQ7kNvwGsYcO5&_nc_oc=AdpfDyloic9GCRsrk2wZwwEUzVe4oFR9yaG4KPrcyS3kpkx6EVbT58eUy-EYgsWsaLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXortmHBOQuf1K982Os8QBLfZP4f_5szu58vu0bFHdGQ&oe=6B0057C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "28626503733706625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604310912_28626503747039957_5259379756745960016_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8zgvR7dCR4Q7kNvwEERb6X&_nc_oc=Adq8qIk2iAcyL_Q7b4IlB05iR5j0bL0ZaWjJVK9YfFCqAg3Q4x5yG7DwCGkaar1tcQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRGfLDyrd0vcdwKciXrcsGNQJLmTr_2NXSX72qGU9EZg&oe=6B007ED0"}, "display_name": "Toon Shooter", "keywords": ["shooter", "cartoon", "arcade", "guns", "army"], "long_description": "Toon Shooter is a bright, fast arcade shooter built for VR. You hold the fort - a sandbag bunker overlooking a colourful container yard - while waves of toon troopers push in from cover to cover.\n\nDUCK, DODGE, SHOOT BACK\nEnemies pop up from behind sandbags, crates and dumpsters and fire slow glowing rounds you can actually see coming. Duck behind your wall for real, lean out of the way, or shoot their rounds right out of the air for bonus points.\n\n8 GUNS ON ONE WHEEL\nPistol, revolver, SMG, assault rifle, shotgun, sniper, grenade launcher and rocket launcher - swap any time from the weapon wheel. Throw real grenades with your other hand.\n\nBOOM\nExploding barrels and gas tanks sit beside every cover. Hit one and everyone crouched behind it goes up in a burst of toon confetti. Chain them for big combos.\n\nBOSS TANK\nWave 5 and wave 10 roll a toon tank through the back gate. Rockets and grenades hurt it most.\n\n8 MAPS\nThe Yard, Sunset Yard, Snow Base, Desert Outpost, Junkyard, Toxic Zone, Candy Yard and Neon Dusk - each with its own sky, colours and weather.\n\nSCORE CHASE\nKill fast to build a combo up to x5, clear a wave without getting hit for a Perfect bonus, and beat your best score on every map. No blood - troopers pop into confetti.\n\nDeveloped and published by Citiview Studios.", "short_description": "Defend your sandbag fort in a bright toon arcade shooter! Pick from 8 guns, duck incoming rounds or shoot them out of the air, throw grenades, blow up barrels and take down the boss tank across 10 waves and 8 colourful maps."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-toonshooter.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-toonshooter.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1244774998728473"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_28241924695448953_8434390205614395860_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EF5vSi--TuoQ7kNvwE9rsb2&_nc_oc=Adr_B2XjVb6IlESrzFPN3FRuhobefno8ubwHtg8L-RE_iEzmvSIyddYscszycfYUoE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNt5DSbylMlvasy6mOQRihqbqlSpaxunTZCBbZCZDD_g&oe=6B00772D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Toon Shooter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1789994580, "lastRevision": {"nodes": [{"id": "1244775
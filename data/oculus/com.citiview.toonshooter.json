scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxQFsmEae90bSN1zOKSochnIwNHQyKcXV0v2M0GK3hTA&oe=6AF086F1"}, {"file_name": "screenshot_3_2560x1440.png", "id": "2194152928111556", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/585799753_2194152931444889_3112672306407764802_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FyI9Lvq0XsQ7kNvwH8rPDj&_nc_oc=AdoX8qxLOMNOOwd93F0nXpa5d95I326EIXrxUo8xjKNASbRTrHlaJT4ibFbKuY-fXYs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRefwUcYS6pm4OgPmDsl7h90InaTR54aj24CMTtHfBASg&oe=6AF085C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "28626503733706625", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604310912_28626503747039957_5259379756745960016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x78b70k0AsEQ7kNvwGG9hKI&_nc_oc=AdpWEsReyZoPYfbCnlolbtOwjYwwV95C9vSu0O1HcYnEzvZCBFWEBCzDZz2z24vAgTU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA1yBB2sAPCSKSsQa3ssaTzgOhDC2be0MZ6puWA2aQEA&oe=6AF0ACD0"}, "display_name": "Toon Shooter", "keywords": ["shooter", "cartoon", "arcade", "guns", "army"], "long_description": "Toon Shooter is a bright, fast arcade shooter built for VR. You hold the fort - a sandbag bunker overlooking a colourful container yard - while waves of toon troopers push in from cover to cover.\n\nDUCK, DODGE, SHOOT BACK\nEnemies pop up from behind sandbags, crates and dumpsters and fire slow glowing rounds you can actually see coming. Duck behind your wall for real, lean out of the way, or shoot their rounds right out of the air for bonus points.\n\n8 GUNS ON ONE WHEEL\nPistol, revolver, SMG, assault rifle, shotgun, sniper, grenade launcher and rocket launcher - swap any time from the weapon wheel. Throw real grenades with your other hand.\n\nBOOM\nExploding barrels and gas tanks sit beside every cover. Hit one and everyone crouched behind it goes up in a burst of toon confetti. Chain them for big combos.\n\nBOSS TANK\nWave 5 and wave 10 roll a toon tank through the back gate. Rockets and grenades hurt it most.\n\n8 MAPS\nThe Yard, Sunset Yard, Snow Base, Desert Outpost, Junkyard, Toxic Zone, Candy Yard and Neon Dusk - each with its own sky, colours and weather.\n\nSCORE CHASE\nKill fast to build a combo up to x5, clear a wave without getting hit for a Perfect bonus, and beat your best score on every map. No blood - troopers pop into confetti.\n\nDeveloped and published by Citiview Studios.", "short_description": "Defend your sandbag fort in a bright toon arcade shooter! Pick from 8 guns, duck incoming rounds or shoot them out of the air, throw grenades, blow up barrels and take down the boss tank across 10 waves and 8 colourful maps."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-toonshooter.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-toonshooter.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1244774998728473"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830441_28241924695448953_8434390205614395860_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a
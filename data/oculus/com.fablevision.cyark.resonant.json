EA33E8"}, {"file_name": "resonant_5.png", "id": "1112795890655378", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827813_1112795893988711_4661050632831638492_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3S-Bs8oNcIQ7kNvwHGBp5O&_nc_oc=AdppacHxrdknYsDExUq0ck7dl4sLUakyHRXVspgKA7VGg7_sYmPO0CVtbNH0gNrg6bE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3I0xot66ECsCa4WSQziNkAMY1MfynUA-5EGeWU210Q7Q&oe=69EA1BFD"}, {"file_name": "resonant_3.png", "id": "617095271493505", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830023_617095274826838_6818078209241520935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVy0VWLbdEwQ7kNvwG8OnGa&_nc_oc=Adpx9_0P4kr6QFLKyYGwEUTjgHA6FBj-zOANJ1w3L0K0VSphnhREaG0HxVeG5B1C6iA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e2XRaWdR0n30zjBfzqa7zsnHNM3pXdstgapekD6eyJA&oe=69EA1B67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "resonant-trailer-cover-image.png", "id": "695162009793174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391901_695162016459840_856984543919892014_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENDD8gcpxMoQ7kNvwF0kXns&_nc_oc=AdqLN5fAfZC5LbeXcAQk4RK4pibT_7JOT7j30ZT1b31vZUrEvAOGghhUSF1Er7OcrcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qHK_Jab2KyLheIYxfEuxJX83nd1_AkNZN114tFNbZpA&oe=69EA37ED"}, "display_name": "Resonant", "keywords": ["heritage", "history", "resonant", "national", "park"], "long_description": "Resonant is an immersive VR experience that brings Hopi history, heritage, and culture to life. Explore two ancestral sites\u2014Wupatki National Monument and Mesa Verde National Park\u2014through interactive storytelling, sensory landscapes, and hands-on abilities like pottery making, constellation drawing, and soundscape creation. Written and narrated by members of Hopi communities, Resonant highlights Indigenous knowledge and the ongoing connection of Hopi people to ancestral landscapes. ", "short_description": "Resonant is an immersive VR experience that brings Hopi history, heritage, and culture to life. Explore two ancestral sites\u2014Wupatki National Monument and Mesa Verde National Park\u2014through interactive storytelling, sensory landscapes, and hands-on abilities like pottery making, constellation drawing, and soundscape creation. "}]}, "developer_name": "FableVision", "developer_privacy_policy_url": "https://www.cyark.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "CyArk", "support_website_url": null, "website_url": "https://www.cyark.org/projects/resonant-vr/overview", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9467369179965905"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1360120148637814"}]}, "baseline_offer": {"id": "1360120148637814"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750165200, "status": "PUBLISHED", "id": "1360120148637814"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9780379988664821", "version": "1.01"}, "id": "2102673880244727", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typ
lo&_nc_oc=Adm6qLE2s4xLkv_AsSrS5A1Kp7aX1HTpbZFWTrHyV-rlOgOYkajhEySmXgbbcdx9zgA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVNVPn4AuX8jWDMFrqyheHxzDG-4cgm4urb6qGvIFnlQ&oe=69BE91C9"}, {"file_name": "resonant_4.png", "id": "2234211080309389", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827789_2234211083642722_2396750371718904992_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-e8xhkvGMcQ7kNvwGPFSNN&_nc_oc=AdnoAGNssdCbXMVtsq-d8JGyKkPw_95p9weHAs0Lo933L5NqPTLUc1D1VQPKGnC7eoQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_71AJ2L_69c7ZA0Kg9ggs8zGVRSAWqRBsHuwag3aEqw&oe=69BE7A28"}, {"file_name": "resonant_5.png", "id": "1112795890655378", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827813_1112795893988711_4661050632831638492_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXyLc8Tc3JYQ7kNvwGJ8I4Y&_nc_oc=Adm5HSlLaDYtC8AR8avqeVEpIVGrIc_xfOM6Fx_U0VcAFPB6YowtlNDdQyvfIvY0RZ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8kYfgoq3xu-B5nz-aWPBPzxXlA7I8R7G8YwR3HjzmNQ&oe=69BE9A7D"}, {"file_name": "resonant_3.png", "id": "617095271493505", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830023_617095274826838_6818078209241520935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr8aGU9BwgwQ7kNvwHCAsyk&_nc_oc=Adn0VgeoIi6zPAcPTL7Wtixj2IXis4Ue-KHMZLdiGY1DJY5PwBCJkcZBqBHBborBm7s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxagYk4lZsQuKtjC1bCQZhqAMPo0xTDOa07851uYjm57A&oe=69BE99E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "resonant-trailer-cover-image.png", "id": "695162009793174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_695162016459840_856984543919892014_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNS2BFIMtzMQ7kNvwGPWfIB&_nc_oc=AdlRcRkUILO3EXcsPJ3q6ljADBwD6fTvJ5EbplPeaSEcfVhBvrbztUkcTeA037FsRvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwd_NkNXacsFiY0SNncPbQl5XzoZt6xqKFrErpd1OQDbA&oe=69BE7E2D"}, "display_name": "Resonant", "keywords": ["heritage", "history", "resonant", "national", "park"], "long_description": "Resonant is an immersive VR experience that brings Hopi history, heritage, and culture to life. Explore two ancestral sites\u2014Wupatki National Monument and Mesa Verde National Park\u2014through interactive storytelling, sensory landscapes, and hands-on abilities like pottery making, constellation drawing, and soundscape creation. Written and narrated by members of Hopi communities, Resonant highlights Indigenous knowledge and the ongoing connection of Hopi people to ancestral landscapes. ", "short_description": "Resonant is an immersive VR experience that brings Hopi history, heritage, and culture to life. Explore two ancestral sites\u2014Wupatki National Monument and Mesa Verde National Park\u2014through interactive storytelling, sensory landscapes, and hands-on abilities like pottery making, constellation drawing, and soundscape creation. "}]}, "developer_name": "FableVision", "developer_privacy_policy_url": "https://www.cyark.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "CyArk", "support_website_url": null, "website_url": "https://www.cyark.org/projects/resonant-vr/overview", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9467369179965905"}, "review_messages": []}]}, "cover_squar
fJ&_nc_oc=AdkOxTkt-3XWilhMC9phyin2BVCFtYO71wBstZX-MeW1JoYkFJltK8XeGRhxM495oFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwxnLVLnng0G5WPbgoVQ0y6RqKa2xqw0rahyX0HJ8mWGg&oe=69BFE349"}, {"file_name": "resonant_4.png", "id": "2234211080309389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827789_2234211083642722_2396750371718904992_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMUOE9HJ7xYQ7kNvwH5scL9&_nc_oc=AdlH1OTPOV3PsuQ5j4fTlV-CiB6-IWrpm4dZYRnPHZhJbmobceYkljunMm2QKucsJyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOBJ2jlBWrJHc7NZEJtfbhehZmrxqk6N0FeH0p4G2Lrw&oe=69BFCBA8"}, {"file_name": "resonant_5.png", "id": "1112795890655378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827813_1112795893988711_4661050632831638492_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N7nNTygTw0Q7kNvwEk155i&_nc_oc=AdmhlyM5ZKf1sPMq4YIK3vpGcEGy9u6LoQm3Do2ANsJwD_QqI33gKpCAsVqpglDjcbg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxnvkBoHuWZ3jSsgXao4-3tStc-8Ja3tyNztwUQK5KdAg&oe=69BFEBFD"}, {"file_name": "resonant_3.png", "id": "617095271493505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830023_617095274826838_6818078209241520935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr8aGU9BwgwQ7kNvwHLbXXK&_nc_oc=AdnT_ylfUnUXX576pO6066KjuR2QHHuvRVM4X2L5RL0G_vwL2_91OWvGKiuRp7R65Xk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJvEIRU7AwR-vnY8q0IeK3QrHZ5pn33pGHJnfB8no3Ng&oe=69BFEB67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "resonant-trailer-cover-image.png", "id": "695162009793174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391901_695162016459840_856984543919892014_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tVbOyFT1gYQ7kNvwFf1FbF&_nc_oc=AdmLyQsGn78JsiTXnuAaNSrx2UEoN-zSN7spfZc_MoeRMA30ViO1zCXwikPVlbH3v9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMssvkdohcFzAvFSsOk8_LfarBIs7lprbzoleE9J7yYQ&oe=69BFCFAD"}, "display_name": "Resonant", "keywords": ["heritage", "history", "resonant", "national", "park"], "long_description": "Resonant is an immersive VR experience that brings Hopi history, heritage, and culture to life. Explore two ancestral sites\u2014Wupatki National Monument and Mesa Verde National Park\u2014through interactive storytelling, sensory landscapes, and hands-on abilities like pottery making, constellation drawing, and soundscape creation. Written and narrated by members of Hopi communities, Resonant highlights Indigenous knowledge and the ongoing connection of Hopi people to ancestral landscapes. ", "short_description": "Resonant is an immersive VR experience that brings Hopi history, heritage, and culture to life. Explore two ancestral sites\u2014Wupatki National Monument and Mesa Verde National Park\u2014through interactive storytelling, sensory landscapes, and hands-on abilities like pottery making, constellation drawing, and soundscape creation. "}]}, "developer_name": "FableVision", "developer_privacy_policy_url": "https://www.cyark.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "CyArk", "support_website_url": null, "website_url": "https://www.cyark.org/projects/resonant-vr/overview", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9467369179965905"}, "review_messages": []}]}, "cover_squar
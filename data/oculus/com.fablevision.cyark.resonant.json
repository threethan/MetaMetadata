"https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391901_695162016459840_856984543919892014_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qrDKBL5YSkQ7kNvwE-HzZ7&_nc_oc=AdoWHJNpYddUJCwd2WGK2ZAyn0S-nPQcK1MECQNcOKD4DRVufNoZZh-MSwCYpOY_iRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqHp_UexyHV1K9KIlbZdqTU7Onn46Qslf9opGTyM6GzQ&oe=6AFF12ED"}, "display_name": "Resonant", "keywords": ["heritage", "history", "resonant", "national", "park"], "long_description": "Resonant is an immersive VR experience that brings Hopi history, heritage, and culture to life. Explore two ancestral sites\u2014Wupatki National Monument and Mesa Verde National Park\u2014through interactive storytelling, sensory landscapes, and hands-on abilities like pottery making, constellation drawing, and soundscape creation. Written and narrated by members of Hopi communities, Resonant highlights Indigenous knowledge and the ongoing connection of Hopi people to ancestral landscapes. ", "short_description": "Resonant is an immersive VR experience that brings Hopi history, heritage, and culture to life. Explore two ancestral sites\u2014Wupatki National Monument and Mesa Verde National Park\u2014through interactive storytelling, sensory landscapes, and hands-on abilities like pottery making, constellation drawing, and soundscape creation. "}]}, "developer_name": "FableVision", "developer_privacy_policy_url": "https://www.cyark.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "CyArk", "support_website_url": null, "website_url": "https://www.cyark.org/projects/resonant-vr/overview", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pla
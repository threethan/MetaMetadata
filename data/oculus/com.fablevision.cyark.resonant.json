C269E8"}, {"file_name": "resonant_5.png", "id": "1112795890655378", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827813_1112795893988711_4661050632831638492_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkwmP3sNcGEQ7kNvwGgSKGh&_nc_oc=AdqEol-6GKA0AsSNP1g7gfNMgyUT_MhcQG405uCf3l4zdkyyllMeczdIB46U6rFDb8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN36v9Zpa5UzDwW9F0ZksM8EunAuIIBB_2SpHXvJOsaGQ&oe=6AC251FD"}, {"file_name": "resonant_3.png", "id": "617095271493505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830023_617095274826838_6818078209241520935_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-NzEXzKp7AQ7kNvwHeYPw8&_nc_oc=AdokwDKpfH5eHri8kW6b_ncQhzl_7aIZSoqxJpRcUEH_9iS4vJ2V4AzdgNVTtk1XQuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBAWhWl97FVH_EFz4Qxjq_jR1MlnD44fPgb-CWI9ekQA&oe=6AC25167"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "resonant-trailer-cover-image.png", "id": "695162009793174", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391901_695162016459840_856984543919892014_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3fwgjeQ3VYQ7kNvwGYiSzi&_nc_oc=AdoY_zak-56ItARR1VXDLf0QRmyBbZd_Wikagne1YkeOAMW72mVzNodloOaAkiQesEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyfoiZdD3vATmMrDBM7BcOJVecC_rYFSqhCuG3PBSntQ&oe=6AC26DED"}, "display_name": "Resonant", "keywords": ["heritage", "history", "resonant", "national", "park"], "long_description": "Resonant is an immersive VR experience that brings Hopi history, heritage, and culture to life. Explore two ancestral sites\u2014Wupatki National Monument and Mesa Verde National Park\u2014through interactive storytelling, sensory landscapes, and hands-on abilities like pottery making, constellation drawing, and soundscape creation. Written and narrated by members of Hopi communities, Resonant highlights Indigenous knowledge and the ongoing connection of Hopi people to ancestral landscapes. ", "short_description": "Resonant is an immersive VR experience that brings Hopi history, heritage, and culture to life. Explore two ancestral sites\u2014Wupatki National Monument and Mesa Verde National Park\u2014through interactive storytelling, sensory landscapes, and hands-on abilities like pottery making, constellation drawing, and soundscape creation. "}]}, "developer_name": "FableVision", "developer_privacy_policy_url": "https://www.cyark.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "CyArk", "support_website_url": null, "website_url": "https://www.cyark.org/projects/resonant-vr/overview", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9467369179965905"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1360120148637814"}]}, "baseline_offer": {"id": "1360120148637814"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750165200, "status": "PUBLISHED", "id": "1360120148637814"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9780379988664821", "version": "1.01"}, "id": "2102673880244727", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typ
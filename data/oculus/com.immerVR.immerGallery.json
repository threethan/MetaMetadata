pOrO0cymo5z6ufCNtjriSC1aRfqfN3raoQ&oe=6A88472C"}, {"file_name": "rewards2024-06.png", "id": "389476637493239", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031491_389476640826572_8573722676932680922_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8_YRZMaFgEQ7kNvwGwan3i&_nc_oc=AdpwtWQdbpZByf7HXr7lU4v39i6SUvyjN9fYS2f3DLpVqDbiYw-fVY2aSzxdi-VFgcI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJE_Cs0vApX9LAlNuFlwNOQpZXfBW-b6IObop-CkbS0w&oe=6A88492E"}, {"file_name": "05-Underwater.png", "id": "5819674844806839", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75485579_5819674848140172_6485850132484110214_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gdb4l3b1AeUQ7kNvwFAUtXj&_nc_oc=Adq6Jcjuw0D68GnJD380QPM823lsZDTVwwTKAZz8Xo3kKgGpl4tYuJQTioUMO7cgfko&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLGTndVPsWq2p_WGuM1WJzL9ZD29Z3XeoHYhuIgcOfzQ&oe=6A885052"}, {"file_name": "rain.png", "id": "1145982939825755", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982531_1145982946492421_1724000860266377055_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tP3Pl6A5goUQ7kNvwEese4N&_nc_oc=Ado945L0SUQP8zXZIIq32ycTzBN55xWSIf4rH4BFDDiMcBUAirUC7Iti0DL8j5kaBIY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6hyiYTCLLGIjkYDZLR1gxd-PkP4iOCrZkfuxxsjjLvA&oe=6A884164"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Trailer_2560x1440.png", "id": "235625282564704", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031594_235625289231370_6738929985784963404_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbIynqjLZS8Q7kNvwGyz3V8&_nc_oc=AdoN5r6D-cHbKBS-Z4sc6Vok3Hhx6sylox6bGt313nuFNHJPcBZKi7r8SlC5Iir7cgw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGea2gqEBRuUi5Txaab29cQS768Ej2cVs3077tPsFtIw&oe=6A88217A"}, "display_name": "immerGallery", "keywords": ["video", "photo", "360", "180", "3d"], "long_description": "Welcome to immerGallery, the ultimate **VR image and video viewer**! \n\n\nImmerse in your **VR180, VR360 (2D & 3D), panoramas, and regular 2D & 3D content**! Enjoy VR slideshows with your family and friends in **Multiplayer**.\n\n\n**No more manual image format selection!** Automatic format recognition displays your media correctly and makes exploring your collection quick and seamless.\n\n\nElevate your images with **special effects**. Experience snowfall and rain, butterfly-filled meadows, and falling leaves. Explore environments such as Halloween, St. Patrick's Day, Xmas, and even a hot air balloon, designed for optimal enjoyment of drone-captured images\u2014right from the comfort of your home.\n\n\nDiscover more than **300 included immersive photos** from around the world, featuring Oktoberfest, castles, beaches, and many other destinations. Regular updates provide new content to explore.\n\n\nCreate **VR slideshows with background music and voice-overs** to revisit your favorite memories in an immersive, photorealistic presentation.\n\n\nExperience **high image quality** developed by industry veterans with extensive expertise in computer graphics and VR.\n\n\nBrowse local media and network libraries through **UPnP and SMB**, and easily download custom ZIP collections from the web.\n\n\nimmerGallery supports media from many cameras and systems, including **Acer SpatialLabs Eyes, Kandao QooCam EGO, Insta360 X5, Insta360 Luna Ultra,** and the **Canon RF 5.2mm VR180 lens**.\n\n\nFeedback? support@immerVR.com", "short_description": "Welcome to immerGallery, the ultimate VR image and video viewer! \n\nImmerse in your VR180, VR360 (2D & 3D), panoramas, and regular 2D & 3D content! Enjoy VR slideshows with your friends in Multiplayer.\n\nNo more manual image format selection! Automatic format recognition displays your media correctly and makes exploring your collection quick and seamless.\n\nElevate your images with special effects. Experience snowfall and rain, butterfly-filled meadows, and falling leaves."}]}, "developer_name": null, "developer_privacy_policy_url": "https://imrvr.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "immerVR GmbH", "support_website_url": "https://www.immervr.com/Contact-us.html", "website_url": "https://www.immervr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "TRAVEL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27477108091942592"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75549077_1281119356008242_4487960690866487242_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEyX8exj8MMQ7kNvwGNqOx9&_nc_oc=AdoGZ-vv26wWGs0NdnN3LcPgHlqGn-ZKWyT6-tnOltef_yFmm7ETlmfSEnAHwXxsIvg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmHeTk4FwZhJSMt6kvxdrmomgPWk_g5G2l6mp1KD7Nhw&oe=6A882DE0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "immerGallery", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1645658192, "lastRevision": {"nodes": [{"id": "306880244720291", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id
5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe-Xt1BswwvhMk2X61XM3QG6hMcsJ17LVicZI_v4IuzQ&oe=6AF0AE8D"}, {"file_name": "4 (2).png", "id": "2709607739498430", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823351_2709607749498429_175789069625003792_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K8QAi5zbR8Q7kNvwE4kB3a&_nc_oc=AdoFdM4nHMRfRgMTsf3QPzC-Rb2TkAX1h1js4-R_JB3pCxeAsVk1sCjuJEWeIcq2dsE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh5j5qXVDvRQm68ToV42UbPQPCKbjC2Sx-OXFCrLWnqg&oe=6AF09D14"}, {"file_name": "5 (1).png", "id": "1623692595784342", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491829120_1623692605784341_5774525992202883118_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR5xv0qxM9sQ7kNvwFILlfX&_nc_oc=AdrY9YCCqQzzuQuLsOcU2k3vwZayFsh07Y2Kj1lkC7BOvOu6g8vPQTSwqsnG4NWqMoI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5e4QCnZgag_NI_AXyC3tvRa_A77sgWRC1FiHUbwRrnQ&oe=6AF084CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Character Banner (Landscape).png", "id": "2594821957632543", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_2594821960965876_4998857043036854295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lY7-WKJjw0Q7kNvwEej2eu&_nc_oc=AdrfUIfCCCDzgqVCClJW8jdFYFU1acnHG3M-S_XdMulitNBcE8MgKmmIveo8nsZIBlE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb2aGqP-P4nUQucB7KB8wh0U4o6auYufECa6a92nELMA&oe=6AF09124"}, "display_name": "GolfNova", "keywords": ["golf"], "long_description": "Step into the exciting world of Golf Arena VR, where your swing, accuracy, and timing decide your score. Grab your golf club, aim at challenging targets, and experience an immersive virtual golf arena like never before.\n\nGolf Arena VR brings a fun and competitive golf challenge where players can test their skills by hitting targets across the arena and earning points with every shot. Improve your swing, sharpen your accuracy, and challenge yourself to achieve the highest score.\n\nFeatures:\n\nImmersive VR Golf Experience\nExperience realistic golf swings with intuitive VR controls. Pick up your club, take your shot, and enjoy a natural golf experience.\n\nTarget-Based Challenges\nAim for different targets, improve your precision, and score higher with accurate shots.\n\nImprove Your Skills\nPractice your timing, control, and swing accuracy while trying to beat your best score.\n\nEasy VR Gameplay\nSimple controls make Golf Arena VR enjoyable for both beginners and experienced VR players.\n\nFun & Competitive Experience\nChallenge yourself, master your swing, and enjoy an exciting VR sports adventure.\n\nPick up your club, step into the arena, and take your best shot. Are you ready to become the ultimate VR golf champion?\n", "short_description": "Play exciting VR golf with realistic swings, target challenges, and score-based gameplay.\n\nA fun and immersive VR golf game where you hit targets, earn points, and master your swing.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonapps.io/golfnova/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Moon Technolabs", "support_website_url": null, "website_url": "https://www.moonapps.io/meta-games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1971270863570405"
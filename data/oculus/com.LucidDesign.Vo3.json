-7&_nc_sid=6e7a0a&_nc_ohc=8Q1jXdC3aCMQ7kNvwFg-g-h&_nc_oc=AdpJnu4RPO-EgctpPki6ydjVNpWe600b_G1_o82lT71Qntr721SvAxMMpLGM069TebI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNBEwYlwgJTfS6Y0VcwRntiUpc8_z_llq0Fna1TGK4MA&oe=6A4BAAAF"}, "display_name": "Vo3", "keywords": [], "long_description": "Vision Of Victory Of Violence (Vo3). At the end of a 300 solar cycle conflict, the planet Taia has been colonized by a religion who calls themselves The Blind Faith, led by The Starborn Prophet. You are a prisoner of this conflict and you begin your journey in Prison Pit III, one of the many islands on the mostly-water planet. Use running in place, swinging swords, and meditating to exit the prison in this very physical VR experience", "short_description": "Vision Of Victory Of Violence is a sci-fi dark fantasy game that takes place on a distant planet. This game is a workout, so be prepared to run and slash your way to victory"}]}, "developer_name": "Lucid Interactive", "developer_privacy_policy_url": "https://lucidinteractive.wixsite.com/lucidinteractive/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lucid Interactive", "support_website_url": "https://lucidinteractive.wixsite.com/lucidinteractive", "website_url": "https://lucidinteractive.wixsite.com/lucidinteractive", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "80616898405884
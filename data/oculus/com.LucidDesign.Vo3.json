L0rAielsH8RIyEMiPXPjDInWMb0ZEgA&oe=6B01DDF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Vo3_MetaQuestStore_Trailer_VideoCover.png", "id": "1187872522427704", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210888_1187872525761037_3062032284089444259_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nqYulR4GpcQ7kNvwGv5tPe&_nc_oc=Adrq32AX5w55SJP6aQ9zJeJ61juK5-kcE1yi3Q-1-NMTq4-6u4jlfdZgWdMK5iuqbM4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqkYEeOD5OESo4yUkZz5Zu589Ehlo3g_Jiu13-ehO-eg&oe=6B01D1EF"}, "display_name": "Vo3", "keywords": [], "long_description": "Vision Of Victory Of Violence (Vo3). At the end of a 300 solar cycle conflict, the planet Taia has been colonized by a religion who calls themselves The Blind Faith, led by The Starborn Prophet. You are a prisoner of this conflict and you begin your journey in Prison Pit III, one of the many islands on the mostly-water planet. Use running in place, swinging swords, and meditating to exit the prison in this very physical VR experience", "short_description": "Vision Of Victory Of Violence is a sci-fi dark fantasy game that takes place on a distant planet. This game is a workout, so be prepared to run and slash your way to victory"}]}, "developer_name": "Lucid Interactive", "developer_privacy_policy_url": "https://lucidinteractive.wixsite.com/lucidinteractive/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lucid Interactive", "support_website_url": "https://lucidinteractive.wixsite.com/lucidinteractive", "website_url": "https://lucidinteractive.wixsite.com/lucidinteractive", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED"
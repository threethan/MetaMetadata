.png", "id": "956970690656863", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617719_956970693990196_47857746065808507_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7asnjv4aZEQ7kNvwFouaUr&_nc_oc=Ado21eFUXSlD84OFN62ETXuNmHtYWyHaU0BYjt-hfVGsrQoHTQNJy2Kov2fs8LuKSfo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaeXPtfv4pFlomGJ5jb0Ec0PdfxEjzGA0q3oRZeHiFSg&oe=6AF085D4"}]}, "id": "1415873140662028", "locale": "en_US", "screenshots": [{"file_name": "screenshots8.png", "id": "1446956070061251", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624983_1446956073394584_4704076419519867488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-O3VqWG_0Q8Q7kNvwHjpwfr&_nc_oc=Adr0ytMWWf_j9Qf1Px3FbUVnoqqwFZfDjOSmCjp82TCvHLxK9uHQEwCR_SmDX-brCPQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN-AAPIUzGMcDb1RRu1a03lzQWB7cjHYYKXd4Pwnda3Q&oe=6AF09D91"}, {"file_name": "screenshots7.png", "id": "1811235983170311", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827067_1811235986503644_8326159895068878359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA_KdQG1JVAQ7kNvwELyXa8&_nc_oc=Adr5I2xXQCRq2h4gwtQbbJNALtUAlI1AMgAXWJ_agYjlawZwqJP5vGBWSl4MvZC-SEQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiixcHXABXILxZV8iprpm151nMk_w6A_OFg5vVzqKxpA&oe=6AF0AFB3"}, {"file_name": "screenshots6.png", "id": "27149189664677469", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618064_27149189671344135_902662876833686434_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_0KSP62TaAQ7kNvwFRSzfq&_nc_oc=AdpzAgdjgXZhHCFmlSs45531NuaNcrU5aTBdSKNazQOX6E6rI2iP9C_O1kzFYMAERhI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb5usblTjE0QR-XROjOTAeafTGCoi7eRHNVOZ19xR9iw&oe=6AF087C0"}, {"file_name": "screenshots9.png", "id": "959703436791776", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618887_959703440125109_3178594479974263102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeHicXDLtjoQ7kNvwGkSmw9&_nc_oc=Adq1Yf2DJxSzSq6hohLnUTiofii48UHC7ZUhu26MWpey1w1hz4Y1nVdqFiX7euAI2xg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRimaMyFRji3W-iJ4iKIyXXA5B40abZb92wlZFnrw1tUA&oe=6AF09778"}, {"file_name": "screenshots2.png", "id": "1723845045451876", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aaKngmOwdUQ7kNvwE7BMtY&_nc_oc=AdoXUGhMvwbEIPkciqI84myw2-A_otpwsMDzg5fbanLGoAu8YgnTCUVplWSmiuv4Yf4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSplqT0BD5nclDQhmFqQNEKfzpfDBqB1RL_vWFEKpZuWw&oe=6AF08B3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJpbGzQ2egEQ7kNvwHn7cE_&_nc_oc=AdrYIBAsIcDMr8Ojz-VB2s6On4AlGeA3julkzNeNq3XAD0G3Ck5gPQpQBse9QEzLqhg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAIOYCiKsf_Wk-ywnlYclwl4_Oq4k3s4cT_cu_6G-swg&oe=6AF09828"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in early access open-beta; we are aiming for a full release in December 2026. We plan to use early access to gather feedback, improve gameplay, and identify bugs before the full release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.\n\n# More About Us\n* Boundary Interactive: https://boundaryinteractive.com\n* Discord: https://discord.gg/9hhGvvrBD2", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boundaryinteractive.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Boundary Interactive LLC", "support_website_url": "https://discord.gg/9hhGvvrBD2", "website_url": "https://boundaryinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28805257719106742"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622919_2193202178186023_878171098810592239_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXTTb_U-xxkQ7kNvwE9c9tn&_nc_oc=Adr4zzxQHg8C-zzUbkWoSO4YxmeW5gehC1083uLiShdgZBoMn8OIO-dfw-swGSkT4-o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrAxddLCuEznjUENeGnwrPg5aAlTS2cw5haW-8wTXl3w&oe=6AF08F31"}, "is_concept": false, "is_test": false, "is_tria
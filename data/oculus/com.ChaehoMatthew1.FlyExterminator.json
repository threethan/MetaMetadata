nc_sid=6e7a0a&_nc_ohc=DgZcKGkJcioQ7kNvwG1ZSbw&_nc_oc=Adq-1--OulGPyDJwFR4FcZfYCazhkewu23BQH_cBBiVHAcFS0s5rlRLGQqFHwy_vPlg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXgdXTm1U7KitVpuzoME5chQqgdbu5H-fB-nJ6HJux5w&oe=6A9D89A8"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in alpha and is set to release in June 2026. We plan to run an early playtesting phase to gather feedback, improve gameplay, and identify bugs before wider release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/SypherXN/3af4dc6d51d7478a47843d00c29ba7b7", "developer_terms_of_service_url": null, "publisher_name": "FlyExterminator", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1NJoQ3Kw9rW6rvEgnv6dgrImcZyAKBz5ySz9_VPlgZvE/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED"
7.png", "id": "1811235983170311", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827067_1811235986503644_8326159895068878359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQKV4EtuZ58Q7kNvwEVJoDQ&_nc_oc=Adr5GQzm1prYF9wJ8J6eOB0w1mW8-aNDzgad-1RpJqYZwMNLnOkLZXkjp9XqEjgKX88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrY29XFLHlwuWN9VfwtxKtMld48ZmbDwZwhRh01y2u3Q&oe=6AB7C6F3"}, {"file_name": "screenshots6.png", "id": "27149189664677469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_27149189671344135_902662876833686434_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJk4CKFxTDMQ7kNvwHn0tbu&_nc_oc=AdrVFz5WWCnh1R0LuRQ9uwrl4EqWbc4hdzhJwo_Dk_l2FRbO5PS_YHxuN-FcH4lr9QU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEzlPbjopJpr-KT9MNXtxpDBPBoJMjYfNufXuBq6fMNQ&oe=6AB7D740"}, {"file_name": "screenshots9.png", "id": "959703436791776", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618887_959703440125109_3178594479974263102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaFGRTK_mKcQ7kNvwEPQ-0u&_nc_oc=Adq38uQFlz0EDzuNlnEsCFp7gb2Sgku396EqtkwSnvkvK4RoDCEOpdklq9fmE1hSKkU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2xZ4GRW5RB35CP_lNcYU8ZtDL0y_W_FpQkXK0urnwjA&oe=6AB7E6F8"}, {"file_name": "screenshots2.png", "id": "1723845045451876", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbzUz0WAcNEQ7kNvwGec6Q5&_nc_oc=Adrg9YuEdmYlNWiu7oFzfu3h6b620LbWTT9L7Oht2P5VYLOsum76DpKiR0jEyIZaSx0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJi8yvMnTZrB8p95271IBaRm44dAChdXcHpQRYC40S6A&oe=6AB7DABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVa23hM52DoQ7kNvwFroEWZ&_nc_oc=AdrN6M9_0E7aFKoegWYHqkXACKzNDd9ngD38KJ9ViUEZL52qqKjcGor_huAxDs9nKks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiG6W85YDTnrqH8o7rtvCd93-0D879FOcXazO6K46izg&oe=6AB7E7A8"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in alpha and is set to release in June 2026. We plan to run an early playtesting phase to gather feedback, improve gameplay, and identify bugs before wider release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/SypherXN/3af4dc6d51d7478a47843d00c29ba7b7", "developer_terms_of_service_url": null, "publisher_name": "FlyExterminator", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1NJoQ3Kw9rW6rvEgnv6dgrImcZyAKBz5ySz9_VPlgZvE/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED"
a0a&_nc_ohc=x43DrdY7iZUQ7kNvwFaQVrv&_nc_oc=AdqlvTn65zygea9z-PtnmOrLe9jSV1NX2GrbtWxh4e5KZG1_ymMmM4i2ni5TwggJUs4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERDu9rAZ5lZysmlavU2sQX8MkONDiPzE4m4CL2EUnarg&oe=6A901200"}, {"file_name": "screenshots9.png", "id": "959703436791776", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618887_959703440125109_3178594479974263102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6DsOBnj8IQQ7kNvwEmocI1&_nc_oc=AdpgXA95fws7lq-Z0ulXPY1aPC5_mKbooJgPVHDm3Dp8_Fr4tLnOwfMy166QpOU2tGA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsyhckyDf9CXNpZ0_f9VPV9GdrxS6IT0_BdI_3SzURPA&oe=6A9021B8"}, {"file_name": "screenshots2.png", "id": "1723845045451876", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pH6655Qoq0Q7kNvwGJWMYP&_nc_oc=Ado4QpFNtZGvgwEhtABSjHrpUX-1VBZHziHzLsNEXVh9EIVWvVx9i06E8m15ioQdzs4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxEpHrTABJuJHksv1ytF1OwRFyNjPD7_Zd40mNb8lYZA&oe=6A90157B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akkzeaQqPZ8Q7kNvwGrN3eJ&_nc_oc=AdpKdBpIZut5uNO9Y33OSzsCpa9l4gC_W8h9tOXLmYyodOTBThEXM0OlTyosUXyft94&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlVMWYGYhTEHr1Ba3gqKbEi6RSyumjno4w9U-TuBm1kg&oe=6A902268"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in alpha and is set to release in July 2026. We plan to run an early playtesting phase to gather feedback, improve gameplay, and identify bugs before wider release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.\n\n# More About Us\n* Boundary Interactive: https://boundaryinteractive.com\n* Discord: https://discord.gg/9hhGvvrBD2", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boundaryinteractive.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Boundary Interactive LLC", "support_website_url": "https://discord.gg/9hhGvvrBD2", "website_url": "https://boundaryinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27650998421199350"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622919_21932
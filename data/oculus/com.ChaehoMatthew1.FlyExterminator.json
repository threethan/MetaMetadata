.png", "id": "956970690656863", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617719_956970693990196_47857746065808507_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Xtnta_jjBMQ7kNvwEO075v&_nc_oc=AdqPIe_w3ITdSt66aPRqPhHzPmU12pkd019PfDAatgxQSBYq99NaNxqgpfm_zYxCq-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTRS8ANbXdIylXgf5_7ZfScwbSh_JRIH6EbDeYaoRGrg&oe=6AE9EE54"}]}, "id": "1415873140662028", "locale": "en_US", "screenshots": [{"file_name": "screenshots8.png", "id": "1446956070061251", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624983_1446956073394584_4704076419519867488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQVTyewfVokQ7kNvwEqQxKC&_nc_oc=AdoHK7Delzpe2bDhaxewTuzuh9gx5MRwGlydCDG2HNBiIZWAR3jKItlUGXmpFODR0hA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF1a8S_AWQl9OgMTWanBaoAF5ccsNBc0yHi3L498bjeg&oe=6AEA0611"}, {"file_name": "screenshots7.png", "id": "1811235983170311", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827067_1811235986503644_8326159895068878359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5alg26QIJ8Q7kNvwEtiaw4&_nc_oc=AdqKudl-0gOw3oD4dj4qsYJkLD4WTvUsvaBgYwWkUX3jJCogi32WxmBhHYyUr0ut818&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC6QGgZOugiTuyyzpGT1ZigSkZCHqYhHhczzwSIWuGnQ&oe=6AE9DFF3"}, {"file_name": "screenshots6.png", "id": "27149189664677469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_27149189671344135_902662876833686434_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0gTZG1-0acQ7kNvwFxfLgA&_nc_oc=Adr2Bwr3u3HhaUEL3LTRLcq1JNV2uDpUf98y0vB_nQNZo4Ksph034Bf7Tfonm-rL_fY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNilR4rOlz4gXRWQO9OBL7lLc1TpGuhdwOgTovKn4Lig&oe=6AE9F040"}, {"file_name": "screenshots9.png", "id": "959703436791776", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618887_959703440125109_3178594479974263102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRk-xy5kf9IQ7kNvwH27J8u&_nc_oc=Adocdsv17L9CkpTZK-8Ji9ptB6FPx-SMlVIkZFqvNAezFJ_no4u27rf_pvpNpKJsPqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLZKtsa-11Q7k1jmZuCCdihEC30g6RnmE22G4Acfhagw&oe=6AE9FFF8"}, {"file_name": "screenshots2.png", "id": "1723845045451876", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OspHynk0IOoQ7kNvwEs14Xk&_nc_oc=AdqQwvBcTBRddBbqUUDnATqEjb_X-pkf56C-SGZD_xG9YpT0tb468ICR5wILbh9W0J4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE-5wBtNDiJKsFrdIm047bRuOXxGDPu2sQ01PWFF4iQA&oe=6AE9F3BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LSyrRvUGBIQ7kNvwGv-b_e&_nc_oc=Adrf9Tb27ystKc-QQDzghsIme1T8T20MYrafYnF20bcCa5QfPJEmVX4vUniK_G3VZ2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxLUOkgUAEHtrXlTA7bkSoDCVPCE87XqLSrXDN5loX5A&oe=6AEA00A8"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in early access open-beta; we are aiming for a full release in December 2026. We plan to use early access to gather feedback, improve gameplay, and identify bugs before the full release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.\n\n# More About Us\n* Boundary Interactive: https://boundaryinteractive.com\n* Discord: https://discord.gg/9hhGvvrBD2", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boundaryinteractive.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Boundary Interactive LLC", "support_website_url": "https://discord.gg/9hhGvvrBD2", "website_url": "https://boundaryinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28805257719106742"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622919_2193202178186023_878171098810592239_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lZJIL4uTtoQ7kNvwEiYH1q&_nc_oc=Adobillzwa2lW5KVwa5g3h7EAR4unPQR8QY_jXBGkKj2NjBhH5j3g7A_7a46_BL8dkc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-CKbzS0kbqbl7o1Knc7-umP_BCgc4KaejNettxzjJjQ&oe=6AE9F7B1"}, "is_concept": false, "is_test": false, "is_tria
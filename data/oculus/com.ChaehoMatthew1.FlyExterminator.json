263102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ws1aa5baFnMQ7kNvwGxuzv-&_nc_oc=Ado0Uk8FbACSpyyQ7vMcTBxHG2vg0qk-liH1mi1ISnvPGn-c5tQnih34ZXFKsg15TDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9yiiwqYke8cHJLhsx2AIo9J_FZCTatfcvlLGXtR-E2A&oe=6AF72EF8"}, {"file_name": "screenshots2.png", "id": "1723845045451876", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ5btXHSolEQ7kNvwGRG-Zq&_nc_oc=Adquk1McqcYkJ8FPHWmEzkVkHrQ19XYXcy6q1rA3mr8u9Q4763qkgACaXpEPd3CBRKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCSbUf1txW_ZIPvBVdcJ6ZXUXP-DxwP6EJX6Q0kfJW9g&oe=6AF722BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhEClf8dzEYQ7kNvwHZro7S&_nc_oc=AdrIiBrNiM2C6YbdJUlRGe50taxbipu039Oly8K-_SG9EZgs33xlOzX3YANCEOxrI-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZYyhu_UUgdtIH3r5xwejzxO7yEv46cW4YyghFmNZ1ZA&oe=6AF72FA8"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in early access open-beta; we are aiming for a full release in December 2026. We plan to use early access to gather feedback, improve gameplay, and identify bugs before the full release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.\n\n# More About Us\n* Boundary Interactive: https://boundaryinteractive.com\n* Discord: https://discord.gg/9hhGvvrBD2", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boundaryinteractive.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Boundary Interactive LLC", "support_website_url": "https://discord.gg/9hhGvvrBD2", "website_url": "https://boundaryinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28805257719106742"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622919_2193202178186023_878171098810592239_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyxDRI_09qkQ7kNvwFX8EEc&_nc_oc=AdqzKbfcQXhGKkEFqUcQOlVF7DVOaEkNTer8SZcmXGet3_3AzTqsBMulRWEUSUhwoqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ6GE0OGQHgGT0Rnsjsgm1MuYrWnEXWdytuapwAM6oww&oe=6AF726B1"}, "is_concept": false, "is_test": false, "is_tria
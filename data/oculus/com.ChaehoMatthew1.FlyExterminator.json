qro1-1.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuwjztY46isQ7kNvwFGgXwe&_nc_oc=AdoA4IizHclmYjomcMcmHtCf6l_wdxPFPfq0vtcFNd8RitKNiAmfc-q05ujLVXFLfJQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdpITD20fGvJwPubTwU-OdBEmJmWPnDzThsIJYBt_xzA&oe=6A9409FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1K7y6JnoegQ7kNvwF_Lx4E&_nc_oc=AdoQHA5hg72IdR3RLzPPdL24P98iRLRHJUV9taODt23zfRV5QN0Xnp2kFMO36KwydLs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrRdGu6OtYO2uJZyzGR8ZABbJ8daKtWdpUyN54UyOUcQ&oe=6A9416E8"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in alpha and is set to release in June 2026. We plan to run an early playtesting phase to gather feedback, improve gameplay, and identify bugs before wider release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "develope
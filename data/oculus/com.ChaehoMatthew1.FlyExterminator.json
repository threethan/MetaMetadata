7.png", "id": "1811235983170311", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827067_1811235986503644_8326159895068878359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgctoQgVBLIQ7kNvwEue3-J&_nc_oc=AdqenGZ0KNuRdR8o899F4OL8aHoUu22WkpM2RFjQLoZDKTZRKUQ8TT_Jce8gYLTsjIk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI-3dYozgO_aVbxIVxxMR7O-uTipfIoBtZVrIJ6YRG0Q&oe=6AB3D273"}, {"file_name": "screenshots6.png", "id": "27149189664677469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_27149189671344135_902662876833686434_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwNeCNNibWYQ7kNvwGzkUgq&_nc_oc=Adr3G8AipTaJjiWNkOp3tRJgTiyd8oQgYyOAlR65_CDC9iDRsPwUJ_J4gX9iGqn8sTw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJFaRgSKiZfXQ7SU9O2YfjKWOZQjh5SJ4PM-HpDSrYxQ&oe=6AB3E2C0"}, {"file_name": "screenshots9.png", "id": "959703436791776", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618887_959703440125109_3178594479974263102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXmofuUgx2IQ7kNvwEPIzNT&_nc_oc=Adq9ktwtkm4y5n8NgPskX-XPTo-oVsS6evL-zeIwdVkp6LlMFjNukBwpdesELh-9Dvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQojdBuSjGo_p1pMC-PF4xwvcC1OtlUX_KmBN9rUUvHw&oe=6AB3F278"}, {"file_name": "screenshots2.png", "id": "1723845045451876", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17qRJnMaVhIQ7kNvwFdDPZh&_nc_oc=AdqnrSQDI-17mYMYec21xFjD-ZJxcFV1YRRLlL00Uc0FWki4taGQWtaiUblOF9vwZBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-6WbIdSNoUyjBPVUGZgLIcqDWWCkd1HLvEotL1d0HVQ&oe=6AB3E63B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxOl7dH1sxoQ7kNvwF3AvGO&_nc_oc=AdoWxnwOd3a3mCyB4cfCRAp_FB5OkPg6jWzaRdnfsqU2PQVixmo757Uj7VbpRyUO2fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpEhrQEqBBJyLJX6ASE_BdKZqm4Np58FsPEOajX8G94g&oe=6AB3F328"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in alpha and is set to release in June 2026. We plan to run an early playtesting phase to gather feedback, improve gameplay, and identify bugs before wider release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/SypherXN/3af4dc6d51d7478a47843d00c29ba7b7", "developer_terms_of_service_url": null, "publisher_name": "FlyExterminator", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1NJoQ3Kw9rW6rvEgnv6dgrImcZyAKBz5ySz9_VPlgZvE/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED"
.png", "id": "956970690656863", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617719_956970693990196_47857746065808507_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d30rrzyh8ccQ7kNvwHMJ21f&_nc_oc=AdrSUPX9cefWg0Dpe0bsB5h5DYVW4-yomlndgqwKUin9DMtQgxhghZqV3sa-UgAXZMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTuQtKmkH76qhUKgQsbV1xHb7HbBPEXLH7K56ziFW2WA&oe=6AF47A54"}]}, "id": "1415873140662028", "locale": "en_US", "screenshots": [{"file_name": "screenshots8.png", "id": "1446956070061251", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624983_1446956073394584_4704076419519867488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7aubMklFFEQ7kNvwFw0HcB&_nc_oc=Ado1S2nS1V_yMRaK8i71J4DE-ZoITT-hI9NmVEgmjsDKYfDdNLNyH6sD75wm8lWHJLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnAvMu6dz6E0gDxDQvuhmYyniHrSyFFuomtp7OBJEouw&oe=6AF49211"}, {"file_name": "screenshots7.png", "id": "1811235983170311", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827067_1811235986503644_8326159895068878359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y80BazyqM34Q7kNvwFlRcan&_nc_oc=Adqqsg6PtMWal3b9c5Waeb8zKeMpfQC0kMElt_ZQC-l-3Li1Xir4UwHtttVhsigP-UQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOBEpCm49OFqRMX5yuD1SDyUZYvud603WR2DFUtjNxvw&oe=6AF4A433"}, {"file_name": "screenshots6.png", "id": "27149189664677469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_27149189671344135_902662876833686434_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDe-NTuwZmcQ7kNvwF0Gc7v&_nc_oc=AdoZn6EHfi0pM33mxeHZYSWSCJLqatK1GPaoLD2FaitLPveiQ2kCc7Mds7jOqJnRAiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBKRxoSonFaRs3UFBEujNsBe3k9VQsHiyCdnQWE9IM_w&oe=6AF47C40"}, {"file_name": "screenshots9.png", "id": "959703436791776", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618887_959703440125109_3178594479974263102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHQGfATFf_cQ7kNvwEUzcQ3&_nc_oc=AdrCEbcjqPmTvgkgbCvBXPcAXNuOnB_TFjFf3_ZioopB9JhEemxqi7XQtj7BFtokh68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCuIAawX_5AvtDAZP_kUC_KYqEoOd9JBqP_wVH7DVzEA&oe=6AF48BF8"}, {"file_name": "screenshots2.png", "id": "1723845045451876", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VP_gqyEhYaUQ7kNvwFU3Ilr&_nc_oc=AdpL8O3sdN_N5OpaTEcTE--JuR1d9IeEh9_RjkdRZL9e-N7Kh4MRx4k1dqFblwR0Rws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpfahFkayQj7PWcTWEhoQcZ9wZEFz06jEQ4PfubWpo2A&oe=6AF47FBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhEClf8dzEYQ7kNvwFnA1-c&_nc_oc=AdqMePW3em6yobGUEpWOD8ipi-HpAaixCpE8f4dmLEQsOQqe8a3plX46ES8gVyfZVbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd7ALNy9bwZG_RvgURn6OtR8oZea8g9As6gL6GjPiKWg&oe=6AF48CA8"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in early access open-beta; we are aiming for a full release in December 2026. We plan to use early access to gather feedback, improve gameplay, and identify bugs before the full release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.\n\n# More About Us\n* Boundary Interactive: https://boundaryinteractive.com\n* Discord: https://discord.gg/9hhGvvrBD2", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boundaryinteractive.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Boundary Interactive LLC", "support_website_url": "https://discord.gg/9hhGvvrBD2", "website_url": "https://boundaryinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28805257719106742"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622919_2193202178186023_878171098810592239_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3Ce_MjyiCcQ7kNvwGdfgfz&_nc_oc=AdpgZKNLca37mPIplfHKSRLt2v8yFj2OcBGxjAWB5ABqeccoqbpECYUR8Srwx4Gg_Dk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyNLOiukR-d36jMp1Uhf_SulGop5pYp8aP1Ppw-8Yeww&oe=6AF483B1"}, "is_concept": false, "is_test": false, "is_tria
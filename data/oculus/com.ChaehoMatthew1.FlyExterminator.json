.png", "id": "956970690656863", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617719_956970693990196_47857746065808507_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PO8GbbYSmH8Q7kNvwEfOX7y&_nc_oc=AdqlQPRXD3vHk6m6jUf9LAvXjbHsRw3_hK-XBHFx5dPCuxLL291bUmy7E2gFF_ELX2w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7HPSQe9MZGuOq6ZCyjJzOX3m3trB9MqaYSZ8z5uFjoA&oe=6AE356D4"}]}, "id": "1415873140662028", "locale": "en_US", "screenshots": [{"file_name": "screenshots8.png", "id": "1446956070061251", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499624983_1446956073394584_4704076419519867488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulQBHxlpZV0Q7kNvwFgX0kb&_nc_oc=AdoFXPBNdvBkqkS-yZ__mPuvo889Kj5zm_PPpCTp4MFAMfm7f7BIV_ay_Ggm8MM9Uno&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFOCV0ZPovJ_QEGWc9-tOzRKeYlqzyH6YfT-yufJDCzw&oe=6AE33651"}, {"file_name": "screenshots7.png", "id": "1811235983170311", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827067_1811235986503644_8326159895068878359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgmS8pLE_MoQ7kNvwGdAsus&_nc_oc=AdpsL8Z6GfVh2Zew7MCrCVq00zTgY3Ux2OUP97HIAi6LtWihqpL99agy0F8QeM4bWvc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmwZ9hM3cFK5pyCqvZOgA7G8TK7e-M5lpknYsMXRZTqw&oe=6AE34873"}, {"file_name": "screenshots6.png", "id": "27149189664677469", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618064_27149189671344135_902662876833686434_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwuK1qP2ptAQ7kNvwG68yX4&_nc_oc=Adrwdlcms4jLgi-HJI5z1m9yd5VFLXLM69V0yD2-R2sFwHaXZ7eRBSW4qMqcFSulr7w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYMMhIx_rEHYoyg-MYXHHIkLy2EpZXb51BA0ZRXEdBCw&oe=6AE358C0"}, {"file_name": "screenshots9.png", "id": "959703436791776", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618887_959703440125109_3178594479974263102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Gp4vZytTIoQ7kNvwEWHySJ&_nc_oc=Adqtw6ajvj5naEO2Gn6r111fK1FvO5_rX9uq0u3qrbPTVyq2FWEodQPc0WpSE1RW91E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMffPhmMn35o0e8wWA37rI14IOyXBzfM98jFfXC6tBYhQ&oe=6AE36878"}, {"file_name": "screenshots2.png", "id": "1723845045451876", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMjEN2sMVRMQ7kNvwGZ9_9_&_nc_oc=AdrR-viK1BfrKz9V-xhGTuS6vAtUkiL35YoRr_VO8kGPqDig7O04VlJuMbmRl9CtFWU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzAQQCYUyJPqpkPyE-Gbw5Spawl-zqgDqph_5ek5GGNA&oe=6AE35C3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZeUocx1dzMQ7kNvwFRqN-0&_nc_oc=AdpMPqX1FCXXt8c91q8g0Tmt-3pCEbabTG7-2mLpEqH5J12dDi6QVpfGaUyPjvjzUL0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs7Orb2ESHjvs1kiQdQp0Hvln_ZqDMsZUiBDwJtb4G-g&oe=6AE36928"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in early access open-beta; we are aiming for a full release in December 2026. We plan to use early access to gather feedback, improve gameplay, and identify bugs before the full release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.\n\n# More About Us\n* Boundary Interactive: https://boundaryinteractive.com\n* Discord: https://discord.gg/9hhGvvrBD2", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boundaryinteractive.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Boundary Interactive LLC", "support_website_url": "https://discord.gg/9hhGvvrBD2", "website_url": "https://boundaryinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28805257719106742"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622919_2193202178186023_878171098810592239_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YODiuGo9j0Q7kNvwFU9Oh3&_nc_oc=AdqTncNdWx1PtWYObOlpg8vRUGCJXsQRvwnnkE18uHjF1eEfkSVDXFE1b0Cch4q_g7s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIHT90szIUnqksKI6PGDfvyPi2Gr0Zp0B2pM47BVp6Hg&oe=6AE36031"}, "is_concept": false, "is_test": false, "is_tria
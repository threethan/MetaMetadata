.png", "id": "956970690656863", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617719_956970693990196_47857746065808507_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PO8GbbYSmH8Q7kNvwFwQRRC&_nc_oc=Adp-GdFIEwLf6dRiTntDx-2kC7JvqOOUtZOfN4BAJC3IXVxX9bm_5dsJ0AiXPUFdegQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCKsaFyPhDJQ1PMO3VYXAo4OkIeNtkDevuq6yI_BMnyQ&oe=6AE4A854"}]}, "id": "1415873140662028", "locale": "en_US", "screenshots": [{"file_name": "screenshots8.png", "id": "1446956070061251", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624983_1446956073394584_4704076419519867488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulQBHxlpZV0Q7kNvwFzlhUU&_nc_oc=AdqQdcZ8NzZcpWkHO5nRaH2OPtHZfb-TGZuRhw9WtaAodElkCt4oK55gMn-BAZoODV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqxrgUtsdHGSbqGWDC8v2sQsayDqF555Wqb99JaZAl2Q&oe=6AE4C011"}, {"file_name": "screenshots7.png", "id": "1811235983170311", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827067_1811235986503644_8326159895068878359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxofERqGsgEQ7kNvwF6Nn69&_nc_oc=AdrmEYofro0x7Pj1GjyVMvg758JXIq2gUaxetAuN1nEwnUf_0FQ2Cs5bFavgVWra53M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxzVeXCfdKDQmzYeSaphUmfLAKmVSjAOvb4JvJlJDqog&oe=6AE499F3"}, {"file_name": "screenshots6.png", "id": "27149189664677469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_27149189671344135_902662876833686434_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKgDVl2FolYQ7kNvwG5ll7H&_nc_oc=Adqo_Etqupeb2We-y-2VL1ra4KL9VpsFD_jFfiGt2viaT5Lh2NZ1hOT7lq_CIqcBt3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTc0vRpZLlcSmGCtBqv-egT4hk1Ow28xWe_bt88ROivw&oe=6AE4AA40"}, {"file_name": "screenshots9.png", "id": "959703436791776", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618887_959703440125109_3178594479974263102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Gp4vZytTIoQ7kNvwHocysV&_nc_oc=AdpnO2t_jad7cuoJvNW2GabIgRKqFUVBJf-dTNGtpgNOevCpuFrfNNQUuCFydXx_c3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCCYuOsKeFS5vHUI1894vGRyosPWoGGFQssT2qhaoEyw&oe=6AE4B9F8"}, {"file_name": "screenshots2.png", "id": "1723845045451876", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMjEN2sMVRMQ7kNvwGOIc1J&_nc_oc=AdpOguVlageCSA1j-s2KaFBCw0EdQK2oTyhrCCnz_CST3lmeFsvU10J6qGg3OSBtzsk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnMIHuF8N0R5MEV42aWYHIqTpbOUSAhg9eCEPUqDQeTQ&oe=6AE4ADBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anhMaW7IE4oQ7kNvwG_56MW&_nc_oc=AdqtvQOh__PfT0OUNizJbeUJTCdNE5Yi0VxywhHJiBpq0uyy-NUcMrf5tVlhGMwK50o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-Y1fEa_Ptpc4LT8Hr4PV4OjDHjvac3C7UA2HLlFM3lg&oe=6AE4BAA8"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in early access open-beta; we are aiming for a full release in December 2026. We plan to use early access to gather feedback, improve gameplay, and identify bugs before the full release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.\n\n# More About Us\n* Boundary Interactive: https://boundaryinteractive.com\n* Discord: https://discord.gg/9hhGvvrBD2", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boundaryinteractive.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Boundary Interactive LLC", "support_website_url": "https://discord.gg/9hhGvvrBD2", "website_url": "https://boundaryinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28805257719106742"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622919_2193202178186023_878171098810592239_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YODiuGo9j0Q7kNvwEre3yZ&_nc_oc=AdqAI1aWW3mgTiLZAaFxCuIb0ecIm_86Pic688ypYL2T1G_xBHKAKHUSr0J8jOPAjjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXyZqt6FP08LfbY3YW0rUT_2hq0DUEzckTxahqT1w9DQ&oe=6AE4B1B1"}, "is_concept": false, "is_test": false, "is_tria
sea5-1.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuwjztY46isQ7kNvwFK3fum&_nc_oc=AdqMRes_aWI0NcFPET3RCWaFMigZ7x4P39UBrn7d9a1pGVlsY6hR0QJEJXLsvrydU4o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoVg54uPtUOf9gLCxfh7cIA5YyQ5Ikd8lXWSmOSYcmWA&oe=6A92B87B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1K7y6JnoegQ7kNvwHi99vq&_nc_oc=AdoVJTgBX8GI70bngW6RMTLBdKYn35vhbrKSoej4IzeTov8wQYxvEXOkyy_ksw9TPv4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJhEW4D8AYg7t3FXbzzylJbdwoa8adIAZQ-CyLMtaBxQ&oe=6A92C568"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in alpha and is set to release in June 2026. We plan to run an early playtesting phase to gather feedback, improve gameplay, and identify bugs before wider release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "develope
7.png", "id": "1811235983170311", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827067_1811235986503644_8326159895068878359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AziXnHMgxwQ7kNvwFqRT46&_nc_oc=AdqyEmOiaWBgKJmkGRDZSoxEUJc_-676ewWhpqoNqqVVlWy9bvk4apSwVgzHBl2PmOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQP7kBRjZxEZv_DLDfrDmvufqex1bZ1UHe1YLtwfbGhg&oe=6ACD1733"}, {"file_name": "screenshots6.png", "id": "27149189664677469", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618064_27149189671344135_902662876833686434_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLaU61-424EQ7kNvwH6jAyC&_nc_oc=AdqOt-Ua5DxNuXmen7iFpIzNXjY4dFeT1NLnoQr7CCDODsVXDMx1psbUjwq7Gqz9sC8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnT-IKO_UW6ucXlrsrGywGLu9oQ_Z001dlBUxYIEXslw&oe=6ACCEF40"}, {"file_name": "screenshots9.png", "id": "959703436791776", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618887_959703440125109_3178594479974263102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfzcSxBle9IQ7kNvwHxdmtQ&_nc_oc=AdrmAP_Breg9ae7cXDJ0-pbLSYN7cnCrhankSHXq9RIkSgU1aF7TUuH3vcFkFTIL3gE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM-tbcQa0zU_Y4vMKgOB9j66rd_c0IvqwKnpvCPbP2HQ&oe=6ACCFEF8"}, {"file_name": "screenshots2.png", "id": "1723845045451876", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mp6dihVs77QQ7kNvwFCKjlb&_nc_oc=Adpqz0jt_182r5wrFVHHWYnjYwDJrVa3T2ZX7KqOyaF_Ayp-f4MejHKQxmGQcBRCQQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOtO5PSlw4Jx7XhIKM3wvVUUoiAvAIu3jIrw8AXIkV8A&oe=6ACCF2BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tisKlxzWB-4Q7kNvwFn4vOM&_nc_oc=Adrwf-43UdIiVKNk9AkpASRdLELwhCufksGJV9hxK8Ei9fmhofyaBN-G2bc9nj09DcE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP693SCrCcIz7J7z2n91OWuykD91Txn_xQbPU7sYuI_mw&oe=6ACCFFA8"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in alpha and is set to release in June 2026. We plan to run an early playtesting phase to gather feedback, improve gameplay, and identify bugs before wider release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gist.github.com/SypherXN/3af4dc6d51d7478a47843d00c29ba7b7", "developer_terms_of_service_url": null, "publisher_name": "FlyExterminator", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1NJoQ3Kw9rW6rvEgnv6dgrImcZyAKBz5ySz9_VPlgZvE/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED"
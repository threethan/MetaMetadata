.png", "id": "956970690656863", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617719_956970693990196_47857746065808507_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFw-A9hOGJYQ7kNvwHzSgtn&_nc_oc=AdoD-IY9ytX0NTcfZmCc7xVpxYgjJZ8-jPdYjUX58NIRC-WJUq2JFW8nSOrR2i840ag&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVL5H8zLb6cR4m8XWe34gXY-KNRcNElVGRlo62vQitfw&oe=6AD3BD14"}]}, "id": "1415873140662028", "locale": "en_US", "screenshots": [{"file_name": "screenshots8.png", "id": "1446956070061251", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499624983_1446956073394584_4704076419519867488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACXm80Wv12EQ7kNvwFSRYuT&_nc_oc=AdpvpRgSbFLlNFFRAWAM8XG_aDroq0aWzZSpXy5wSDwZEX9XecJuViPWE1LbczSSleE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxd_vqDstClnIWMbo8GBThcGqAQOGcisbJarh7CTVDBQ&oe=6AD39C91"}, {"file_name": "screenshots7.png", "id": "1811235983170311", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827067_1811235986503644_8326159895068878359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOc4tFnNXOAQ7kNvwHOovzC&_nc_oc=AdpJRqa5jfvepW2wBWOIF5EU_b-lQNUOIWrP2kc69YjKFjnenA9fp475zFgoLOd9MJM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhF8lNBjHHImJkwtweoAmNn2uxRaG23fLfIyn-99Fqhw&oe=6AD3AEB3"}, {"file_name": "screenshots6.png", "id": "27149189664677469", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618064_27149189671344135_902662876833686434_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sfUJDhL8moQ7kNvwHGP4kS&_nc_oc=Adoge93AAMzx38qiCnM5B_an80QMwn0IpoikQ185SbAg5IzVXvDfEzyO03WDk6pjgYA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaHJNAl9KLMevMAW4SljO2vgqqNwM0bPqqybfSrYresQ&oe=6AD386C0"}, {"file_name": "screenshots9.png", "id": "959703436791776", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618887_959703440125109_3178594479974263102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlPFzd-13HEQ7kNvwE_fINJ&_nc_oc=AdrjIS3Q5TJ7EDvSHLK-T-CsH2CxE47ATn2J8aabh0_9-QXSaKV8g3SUb502KmWy1wE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAFQw8JZK2WYdYZVworJvxV9BmCH0ddqUAAWdWwbXk9g&oe=6AD39678"}, {"file_name": "screenshots2.png", "id": "1723845045451876", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3RZdpgGoMAQ7kNvwEKUDJ4&_nc_oc=AdqX3Bbf_Zo15RvAhfHsRpQjimh_Yo4EgoF1VvOt5wmnErem4tlvLsZQlKdub4ctkgU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY_EwWNvFBm-MFPuoNbobNhnHixIJJszE72HRaYZleIw&oe=6AD38A3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-XsLC4TlN4Q7kNvwGQN41r&_nc_oc=Ado6ALdwB5TOvqHbiidVAmshXnjaPzfxmE5dOAQT9rL3FcOWOfZREP07jt6kACuZgQ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMVvI5Gcym8yI_CNz5om8747apyIy9uE_5wiREfaQF3A&oe=6AD39728"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in early access open-beta; we are aiming for a full release in December 2026. We plan to use early access to gather feedback, improve gameplay, and identify bugs before the full release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.\n\n# More About Us\n* Boundary Interactive: https://boundaryinteractive.com\n* Discord: https://discord.gg/9hhGvvrBD2", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boundaryinteractive.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Boundary Interactive LLC", "support_website_url": "https://discord.gg/9hhGvvrBD2", "website_url": "https://boundaryinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28805257719106742"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622919_2193202178186023_878171098810592239_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIJe11Rd3YcQ7kNvwEzMGyr&_nc_oc=AdoUuIBwab0I7oWF8LMPIThRhtFdbGiCMlJgF0k2MdoO2GSHXK_m47aFWY9kcAX46Nw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqTnuHxg6Rd1zy8D6oOVX93oFuK0UDerYf9Z9khpMe1w&oe=6AD38E31"}, "is_concept": false, "is_test": false, "is_tria
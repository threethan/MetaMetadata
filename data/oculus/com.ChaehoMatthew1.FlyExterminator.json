.png", "id": "956970690656863", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617719_956970693990196_47857746065808507_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3puBUpYHksQ7kNvwGZV5O9&_nc_oc=AdpsxvieDJnSmPC5JhOpLk83vJLbz2rEXXJKv4W21Ait70s-yPQ5khAF9Yz_ypbmU-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaIAVYbqQli-adwM4djUuy2XfCgGfY3g-u8PBsZPwNJg&oe=6AF8A714"}]}, "id": "1415873140662028", "locale": "en_US", "screenshots": [{"file_name": "screenshots8.png", "id": "1446956070061251", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624983_1446956073394584_4704076419519867488_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URP3AxSOBhwQ7kNvwGRuyN3&_nc_oc=AdrpwHsV95a3ztyLU9rlA515kUmSdLSFHc0dJrq7kVRAujnWbbFziavk0TdpVrK3bd4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI7PeQ70K7uSpaSFf3zMMvmaAu5fl8lQlFTdbmHuDglw&oe=6AF88691"}, {"file_name": "screenshots7.png", "id": "1811235983170311", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827067_1811235986503644_8326159895068878359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-iewc8XNkoQ7kNvwEyvITj&_nc_oc=AdrmmF2Mg7x66ICUmSnIB_l2Yuwjg4OQOZJHftvDYJDgMMK_f8P2I-RbsclgATn38OQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcq8esNltKKpOpDvihLNHAO5bMkgcqLi_mzxRvXVZxtg&oe=6AF898B3"}, {"file_name": "screenshots6.png", "id": "27149189664677469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618064_27149189671344135_902662876833686434_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dU4Ay794j8Q7kNvwFQ1Pui&_nc_oc=AdqNYIcrRk2GrWH9op3jVtsOjqv3Qa5KUqDIKwMKc3tQ-YFHz3cL4d9gQOViO7MiIIk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfme-Ji_y888PRC1JC-D59Oe5RPGXOXauPAXJ4vSPMrQ&oe=6AF8A900"}, {"file_name": "screenshots9.png", "id": "959703436791776", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618887_959703440125109_3178594479974263102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ws1aa5baFnMQ7kNvwFFKVoR&_nc_oc=AdrLIR63jPdZR8OhFq0F8AriTke_Xj1TO0FKfAvlxrB97Kg-OYl3vpisIR6CtDo6m3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaDBLTJWy54beqa7T4W0U4oiPV8QPnITKqolL545BOFQ&oe=6AF88078"}, {"file_name": "screenshots2.png", "id": "1723845045451876", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ5btXHSolEQ7kNvwHWyVb1&_nc_oc=AdoRwspLGpP1aeOrrEJWRdN-HchhF97n_5MTnS-B2NmX_VDpf0Mf3ejdWJ390aAX0jI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR76uwrzSLRSqBY9QGAasTzdrVKujqpgZnwSu6RlNFluQ&oe=6AF8743B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBq_19pLEbMQ7kNvwFHQWCy&_nc_oc=AdrfiFXPTh5AUQlQFSjU2LXA0XpMbr9d91-_hldRYCO1TA6J6o4kdrrWx0aEGoOhsmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMTbzVieI1vZinWNXhSxnuMZdNYylRB6jNGcTZjz63Hg&oe=6AF88128"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in early access open-beta; we are aiming for a full release in December 2026. We plan to use early access to gather feedback, improve gameplay, and identify bugs before the full release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.\n\n# More About Us\n* Boundary Interactive: https://boundaryinteractive.com\n* Discord: https://discord.gg/9hhGvvrBD2", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boundaryinteractive.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Boundary Interactive LLC", "support_website_url": "https://discord.gg/9hhGvvrBD2", "website_url": "https://boundaryinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28805257719106742"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622919_2193202178186023_878171098810592239_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyxDRI_09qkQ7kNvwFwIn_e&_nc_oc=AdrzOuUVVHGQFi3IdiODRtPerHGlVMFvsxD93a2kcqQwwE61GbAPVf22iZ48biB7ccg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRECfoBWSH-E2BjvoaEI4F3hwkF2rk4cBy1xAQTHrTaLg&oe=6AF87831"}, "is_concept": false, "is_test": false, "is_tria
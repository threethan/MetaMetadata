263102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8ZlLFCxrgwQ7kNvwFdrEFS&_nc_oc=Adprm9ObaNUqw2y8B6C5qIux6Lhcg0ZRwfTs_HA3PDzeoauXiqabrqEtsJu-XizYGi4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML32Rfsf-trrT9mcjKs8LrtMOR-Xii4v6u8Bw-cA7O7w&oe=6ACE5078"}, {"file_name": "screenshots2.png", "id": "1723845045451876", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1723845052118542_506205233041486907_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fO41OSHSHG8Q7kNvwGB632M&_nc_oc=Ado2J8Z4aC8b6zCXorusn-ODYJHIB9FoH2lugd0JD5CGI48xW20860REpOEhNT7gQCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLBycKpUwX6syMiGabWQv6BnwGYborVfvnHpowhQjNFw&oe=6ACE443B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover 2560x1440px.png", "id": "1380139503881097", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1380139507214430_5053591588810208022_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tisKlxzWB-4Q7kNvwEMLENe&_nc_oc=AdrpOL3BGPGBajZe_BW4N9FGrZeEQLIeHw_caYE7SiODmODKzqS-rSB9l_7WviPgpsU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMloLwH0JRhthoAiDhaA9eJTb7JENBX18e8Iw4V4vx9Eg&oe=6ACE5128"}, "display_name": "Fly Exterminator", "keywords": ["Passthrough", "Competitive", "Fitness", "Mixed", "Reality"], "long_description": "# Overview\nFly Exterminator is a Mixed-Reality (MR) video game for the Meta Quest 3 where players chase around and catch virtual flies in your real room using the Quest 3\u2019s scene capture functionality. Work on quick reflexes, satisfying interactions, and immersive MR mechanics designed specifically for Meta Quest 3.\n\n# Current Development Status\nFly Exterminator is currently in early access open-beta; we are aiming for a full release in December 2026. We plan to use early access to gather feedback, improve gameplay, and identify bugs before the full release.\n\n# How to Play\n* Use your hands to interact with and eliminate flies.\n* Move around your space to track targets.\n* React quickly as difficulty increases over time.\n* The goal is simple: eliminate as many flies as possible while maintaining control and awareness in MR.\n\n# More About Us\n* Boundary Interactive: https://boundaryinteractive.com\n* Discord: https://discord.gg/9hhGvvrBD2", "short_description": "A Mixed Reality game for the Quest 3 where you chase virtual flies that fly around and interact in your real room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://boundaryinteractive.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Boundary Interactive LLC", "support_website_url": "https://discord.gg/9hhGvvrBD2", "website_url": "https://boundaryinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28805257719106742"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622919_2193202178186023_878171098810592239_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6ASweuxyHcQ7kNvwHK66n3&_nc_oc=AdqZyPb94AbrbxDCHvmPKgPZjpLYe3z8RrlA-DSzKe9FmS9MptDRxgnBYoASZrxxU1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1cXEg6b2winvSNG5HS_Ox8wMZyoWVb9foyu7pBdjipw&oe=6ACE4831"}, "is_concept": false, "is_test": false, "is_tria
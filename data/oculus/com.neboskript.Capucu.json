699040109_882466893214631817_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XmMOjOgKIQQ7kNvwG_yx4o&_nc_oc=Adq5-e6wGyZKiSLwvOE-dLUXQWnhfr2HeOHazf6r-ZmNN3FZHY3aCFiMiyH5h88HgVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSm5h-CveCmNtVFiEWgMXLMo8j4IRTsuKDBdoYJ823clA&oe=6B0C5D60"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capucu", "keywords": ["capu", "monkey", "monke", "baboon", "chimp"], "long_description": "Capucu is a game where you swing, climb, and launch yourself through fun, creative maps. Master movement, play with friends, and mess around in a goofy VR world inspired by the classic monkey movement you love.\n\nThis game is allowed to use Capuchin VR style of the game by the official developers. (Capucu is not associated with Capuchin VR IN ANY WAY)\n\nCapucu is still and development, please make sure to report all of the bugs using the Report button in your menu while you are in game.\n\nDont forget to invite your friends! Its always better to play with people you know and trust.\n\nBe a great capuchin!\n", "short_description": "Capucu is a game where you swing, climb, and launch yourself through fun, creative maps. Master movement, play with friends, and mess around in a goofy VR world inspired by the classic monkey movement you love."}]}, "developer_name": "Nexus Studios", "developer_privacy_policy_url": "https://capucu.base44.app/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "neboskript", "support_website_url": null, "website_url": "https://capucu.base44.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "N
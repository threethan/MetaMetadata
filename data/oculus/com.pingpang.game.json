uscdn.com&_nc_ss=7f30f&oh=00_AQRoJTiePJ2jlkqwJPg3f01_AafCGrJKoYyBRAWJGjljnw&oe=6B0DBD7E"}, {"file_name": "screenshot_4_replacement.png", "id": "1995873724406125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593942860_1995873727739458_2621552319646039661_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnEplTMmIvwQ7kNvwFTfvjW&_nc_oc=AdrmeZcmPjttQrqVzrOWabHypcLB4a7V4xTazHFRoYqLkSbagEHKADsUGRzkZnSriyA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHFN9zXVrxwrMJv9z0_4ItmMPJJzRVKvQgwQNnZBe2mg&oe=6B0DADC7"}, {"file_name": "screenshot_5_replacement.png", "id": "1358474093118927", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619404_1358474096452260_2779619518313011025_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHDuKkKexmkQ7kNvwGbZ6dh&_nc_oc=AdqkxbUfvX6bLeZ1yi9npbM7b6ArFml1J1loDJaYuI5Bhjw1wCNTSEOZ6oqBcDCzkDs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrQD1TQqiPIhKTv3OVNLbdxJ-TJEIthA4oqYY4wRoJ3g&oe=6B0DCF56"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PingPang Battle", "keywords": ["multiplayer", "ranked", "pingpong", "tabletennis", "sports"], "long_description": "**Grab a paddle and play a quick match \u2014 anytime, with anyone.**\n\nPingPang Battle is lightweight VR table tennis built for fast, friendly rallies. No long tutorials, no waiting: pick up your paddles and you're playing in seconds.\n\n**Play your way**\n- **Solo vs AI** \u2014 face a surprisingly smart opponent with multiple difficulty levels, from gentle warm-up rallies to fierce topspin duels.\n- **Online multiplayer** \u2014 create a room, invite friends, and chat with built-in voice while you play.\n- **Ranked play** \u2014 climb the global ladder with Elo matchmaking and leaderboards.\n\n**Real table tennis feel**\nAuthentic ball physics with topspin and backspin, tuned for satisfying rallies on Quest.\n\n**Make it yours**\n- Unlockable paddle and ball skins\n- Multiple courts, from cozy rooms to floating stadiums\n- AR passthrough mode that puts a table in your real living room\n- Full English and Chinese support\n\nA match takes about 5 minutes \u2014 perfect for a quick break.\n\n**Join our Discord community** \u2014 meet players, find opponents and get the latest news: https://discord.gg/kuU6Kkukc\n\nSee you at the table!", "short_description": "Fast, friendly VR table tennis. Challenge a smart AI or rally online with friends around the world \u2014 a quick match takes just 5 minutes. Realistic ball physics, voice chat, ranked ladders and playful courts make every rally feel alive. Free to play, easy to pick up, hard to put down."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chunjunliang.github.io/pingpangBattle/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Chunjun Liang", "support_website_url": "https://chunjunliang.github.io/pingpangBattle/support.html", "website_url": "https://chunjunliang.github.io/pingpangBattle/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1059186207078377"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_1013217318380824_2205763478337941905_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucket
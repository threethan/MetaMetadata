771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DzgOeIfEVgQ7kNvwHbx8C1&_nc_oc=AdrQacrndBoAl6-jZb_PGx0_1hQqnlP1GIzOm0E_nu00i0KKZphSbce0H3r31cPycNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BE9h8Xm3cPmCDEeONrWX7YN1qrl6xT-AbiSr9_vxDjw&oe=6A428B62"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA5DuygXKpEQ7kNvwHMZSaA&_nc_oc=Adr1iIZH5AVtxlJ-CrLWoByprNFXrAs576QeRv7VULCMzbJua_p9jhdTnzmmIX4F3z0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y4gz6dIxeX28ReTBW0l4qO3xL7fBTBhSjD3wlfJqFmA&oe=6A427BCB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mACTLcm2N-MQ7kNvwEZDhVI&_nc_oc=Adr-kAojzrsHZ9lhe7P6Sv2cEP0R6l0Vj3fk42m8tpJAC00b7chS4_hFb-JiEXTk_F0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kJSDnLUOLYqOx4LK0BtzvXs-Ak5P9P0ZdrdY989eeTw&oe=6A427EFD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fw54u4Yd1M8Q7kNvwGbSjFR&_nc_oc=Ado-UVpi7lVczf7QEgS-qi_X-8Te47r8z2laWxTZSDpY_kW1WXy1zzzX2jixsKTJSvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m2ZZQ1FlAXZPlo1zeIPiywlQpWcmX4ZxS1S5JFIbghg&oe=6A427CFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPkuh5rPCv4Q7kNvwHSuTRu&_nc_oc=Ado_T0wHs6VP3-4btPiz2yRoICTjxX_Y4n7Hz_6mEkApsaClkl4L7Xu6FV3nQxaCfQg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y65tP2xsRR43OP84R7wMGbMxpmL8oYthXNQjs9ETwXQ&oe=6A427F9C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
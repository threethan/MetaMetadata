771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTG2ARwQdw0Q7kNvwFeZ1Xx&_nc_oc=AdoALME98t3b2I39SfhZrGO1TAgy8WRZd4_Wl9rbomtTmlKl8ovWyHURK9o3-MHpSII&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_IGErlHQt_xqwDyR0TcsXZQ-Dz0Pu1_Xss0OSb53Uvw&oe=6A2C21E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQ7oCPm99pwQ7kNvwGV3E4_&_nc_oc=AdpB-nZLOFBy8i7780WqwGCxElfFC0STxTeUfgwi_r9qOMOUfL1HrXJs9GgNdzxiz2Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OsSpce-sAuN8E5eHVKbTo9onQX85Vba0jYj9vdkFHYw&oe=6A2C124B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqB-vMybmv8Q7kNvwEzBX7Q&_nc_oc=AdohGAAj34ECKm2nrnwM27ojWdo4PzufUE2acBdTv_wwle3WLAXwFSJKuQQWpcNiOpQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XvQCOaRWGMEFqEbAHPQJX4r5fmFEUmpbJzo2eI1HSVw&oe=6A2C157D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhd_6gg5GJ8Q7kNvwEypPBF&_nc_oc=AdqfLRTsTsYjQC6PdUKsrw-Se6PDQA864x45hmZyzBJm2y9kmQEnNKksyFf61Mgp4lA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J-VgjJNJrxR-pwsC7AwoUs561-PSta8EYwAvrwdrHtw&oe=6A2C137F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2Nb4-LfkhsQ7kNvwFYTDOw&_nc_oc=AdqGhxOqnUsccc5xrtur_7cl0UVoppoCVx3fzTbjXOo-i2e2f1v_pZ91vUAbnUpuxZE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-he3zCtJ-NpEpUXhqlPSeSBVS1qulwJoMb2IvUXDvWKw&oe=6A2C161C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
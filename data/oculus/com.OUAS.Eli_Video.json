771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0XxareY6t8Q7kNvwGf601s&_nc_oc=Ado7UVTwhSK6-aBI0UzOkmaK4KguUp1QT9cGLX_TEchuCHNsl7QQxCj6p0BDnqmHxhE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HlBz8-y6lv0Si5-wbvr7eg7mSqAEGZejRl7IxmdjsGg&oe=6A355C62"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vUy5g9HSA0Q7kNvwG07Mqa&_nc_oc=AdrjZP9gFuCGdFS8OIblRknah_16Pw28LmumjnI6pVVCIaCese52yPC4JMBGuH79rnQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h7Ss5FmzQo90HK924AchPv_h8RLGRbLZxA71AZMCfcA&oe=6A354CCB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHxcovQxnAIQ7kNvwGsiLG0&_nc_oc=AdrHAUJVMJt4LuXnawXf1Z4RDLJhBA7Eghwc8JMrfaUM7fvV7KZNvSYfH6ef340E4cs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7qkO51TgRAIw36PxYG3vrPJQQf9IU_-ocHkU-uNuxHg&oe=6A354FFD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aR7ry1hFGikQ7kNvwEYeLh5&_nc_oc=AdoKmX37kZJ4nmZHzi8qtospFGrkMQ-MHZdg2Lhj80MFQAyFdZGE629TlejxeUGKhIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D5VVDLfOyXLNh-STkJ20cfUnuX9eokCAO5k08RFVs4g&oe=6A354DFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PkoG1HMuMMQ7kNvwFhoxr8&_nc_oc=Adrmj1VgKJyjmVx-pt8Zw4kQChR_nforzqxKT9dvVaEz-XmaDuEDQRexr-BlE-mBfAE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rJOeEABwoz7CvN0PwAyZWq-cHE8APGj74KYB3w92Akg&oe=6A35509C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
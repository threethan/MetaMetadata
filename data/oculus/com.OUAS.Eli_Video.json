771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLMa2IAs7WkQ7kNvwHOwFtl&_nc_oc=AdrUV6_DqeUcFsupLzEsh0mWRdZQnG5WGazdM2b4LTlPo0d_P1oSDShPhG__yN-6Fvs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlqZkALM2r_JxtOHj70c52WTfWYF-hSgTu4sdLcmMrHg&oe=6A64D262"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBMs59DHwgAQ7kNvwGlR4Lb&_nc_oc=AdrBRsQaPYxkpz5jOMa0NfSOoE9cvK9ov4gGVoTtS9wHI0lb-m0pNkgBs2B0wrtkp4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_dQn9ATFfM69gK0d03_SJVDUCPS9Ap2qcy_49RW9_8w&oe=6A64C2CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnZC2qQivkYQ7kNvwHTWDvQ&_nc_oc=AdqLIa6kh2yPKKzxci0eQVMAIcTMPDokhZaWqJgc21QmUb_imCwTBvl5JZi2UGREEmQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqPvBOXL7tFj1UxbY_QQ4jrxg-_0-igXA8-TTf6gDvmQ&oe=6A64C5FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjhcAyYqGLMQ7kNvwFMxBpX&_nc_oc=AdrC0lUWV5D3FcFIGiwbzVIc23W_GXs154bVyUaBqNdhDLnhzJ6QEPy8VZSs43x47P4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3XJyTNXzzpH5acCjtSxlIC92A3X8j6Y9MFYja166lCQ&oe=6A64C3FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0BiOlTyCc8Q7kNvwFbLL5b&_nc_oc=Adq7fRP0JPhu9siqFLXbeVPmT564rb4CB1zOpXUDwibKexIcRZmZTwCoF014dFrdH-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7y8wULdrKBfr_4G_Z7Qf0ddlu_6ZyhDM_OTgBMPTkdw&oe=6A64C69C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
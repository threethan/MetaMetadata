771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GD6Sn9kog0Q7kNvwG1fBam&_nc_oc=AdqzlLxuS5iHyjWuW9Z8ZXppBNVfXKRmuZomhiQDlci2IrQeGjwiIW1MUqJ8u7j9wpo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPgWiBoKF9BsUnuT7UOlCOPKXV4G4ZWGH5Z31TU4Eqeg&oe=6A576B22"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mlptGYQP_YQ7kNvwFrFigs&_nc_oc=Ado6D9wXGC6xFXJus1xqZ5suiIbTmub64wTQYzarNGeLUpuKqbul2Y3YIsqkYlMLM9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjEgtbrXbe-iJUodHv5tzYT9kt8-Ds9qA-tyrC_f4_EQ&oe=6A5793CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m5duYY-QEYQ7kNvwHlEp7z&_nc_oc=Adog9LiV5IVhd1z_WoFqbhERz71wkw_9UF9NWVCblORPThbjiG2CIMZeSAwV__gZlA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbuGxwbNeYXm9-E7A8-_yOnbBiYbhdxhsqDy26VhQbhQ&oe=6A5796FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsndYtUUzQMQ7kNvwEXpNrL&_nc_oc=AdrBzt0xWQuRmcMBkNDeYGKOhpFI0qOecKyEk8yQkcryvuZSV7PaGXzi4rP1KPy9YzQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAgsC9qEPI0aSJGnN3eLSkVhMB-jEnT1NdW1ju-0O56w&oe=6A5794FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0ONqtbGnWcQ7kNvwH5xbkN&_nc_oc=AdpLgipqIytvi-EDs_8juHF_fAPmCbbl-BqPIxjHsibFjT8NDr2Sh98pXM_zDWzLRzw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAwsWP2I5UYKp3_eRwYxpKOptM97mBragfPTIHSlZm7A&oe=6A57979C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6eoHeBw3PUQ7kNvwH5UPef&_nc_oc=AdrAAJaoWgl5H0cOPKLffMnf1SNfzwtO-jse4XeeM4SX7J9FUap8Y9-EA3xveAHmavQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCayDUNXDC4OHh-70USnpMBR4YWWFVcRJu1bZ5o1ZnZQQ&oe=6A550062"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mlptGYQP_YQ7kNvwFHv4fL&_nc_oc=AdrBAevtW9107ynjIVXjseMzlQQwOmnqnjRKRLLVDao36VMlBqzu04oFNv94lgx9Cxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGbP7E0asGZx3W9bBgY6R4ezLKmResR5BLm5YxrwK6gQ&oe=6A54F0CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpO_yz97pnIQ7kNvwEyN3oF&_nc_oc=Ado5q6uKlTDPuQfW5xEKZI_nCp9KLtUHj9x3PV_nK5d1r--pl7G7QCD6mLVKpGlk8pQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxj9m4pF_AOtOFueSiPdfvIPxSIELNxM2syrLqRGtsTQ&oe=6A54F3FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGMXE4_YId0Q7kNvwGll7w6&_nc_oc=AdqsnRLgD2Ihz-AGZosOzlFqoP7sdgpAbq8Deemv9dYOlA3lv0pUEg4P9IjZB6HbYiY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtlrIbE2pb8sHugolY7FsBUKqfe7Vx7wvK_tbGsGr62Q&oe=6A54F1FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0ONqtbGnWcQ7kNvwGRY1Xa&_nc_oc=AdoaFx0Ec62Tt-7UzcMmqT6nyi6tNQMKd85n_QsTybqTLBckdCykahzF_5uz4B3G9Zw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHs2r2Y3Uuh09NJ1Y-7T-z2W4IArY0w3KZjV5vrKyN_A&oe=6A54F49C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UImimlG0tsQ7kNvwG21P0A&_nc_oc=AdrPUKj3NusViakHcTHruL3J6gPMW-dVO899a6YMYcRPtToclxN1rQLpwixcPQmmnuQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoEqAv5xwGYBwNwKh3LAE-3j5RLGq5MJXqA_F976QPhg&oe=6A720162"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdxo13Sgk9QQ7kNvwEx6sbO&_nc_oc=AdpRClhugSDG7O-w7SAHK9XcWQ2zChTaHe5Vm4AEcRCscqlxsRHYorKMtUocN-L280Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0qKChZjMVo5lPDNbbMiWjhSlvlb6HSN3EsMelS6X8Vw&oe=6A71F1CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXX6ch_dTkEQ7kNvwH4_yNB&_nc_oc=Adq-CKFCINm5kedsxUGWnZbfAqij7qP3CUuwO5j8tRXXHxImLBE1roc3lLVlJ9HJ_aI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6pjwShp5jHIwdAkYCRWLmZ8v_s-74dR19ktOJ-G3iaA&oe=6A71F4FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fz9ozqKRGN0Q7kNvwFYvbbs&_nc_oc=AdotxtO1vKKQ_OutoNq2zddGWrbjsqZ9g2-3t6Fbp9f9qmYTgr2MhOem4gv1Ygn2AYY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5MhIrQ28nX1R3aqh05AU4Po_FbisbM5SnpVT0YS6jHA&oe=6A71F2FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrHSTkZ9OlAQ7kNvwH1NpNg&_nc_oc=AdqzHqqx3Fi3uDHmlvXzantsGUHk3IwTd9nQi0QPgsVH6aehcNsjI9lRAyrkzcE3iFo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUtnVeF1cnYMfvN8zw5jJxYv3UjODOZTXItb7HtZJy8w&oe=6A71F59C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
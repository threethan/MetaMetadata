771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8fgVcnl_qAQ7kNvwGaAmjw&_nc_oc=AdrZR0FOlkVDuvr5YGCICPc-z55h_olJYmEGLTCAYMjr4CBH2NhSnH1YXpj-qy38dtQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e6YD9hbEthGBSYQJKv9DRD7BuuKeRJLSTZDhpOdW_Dg&oe=6A452E62"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv2cQZedGWMQ7kNvwEtsxtc&_nc_oc=Adri_qthKQhcJ_MjdFAGNTB_BF31W0wIR2mJqnqb-YXvpZMq9JJ3sRZV7cuKVu7nBVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NeKTAdMXK-USBNKD4_zgDViG5EMM_RZJCjclV8HkJDA&oe=6A451ECB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-cFn-riheIQ7kNvwGayiI1&_nc_oc=AdrcDDpt_LQUiFcAqshyuxxSVsDw25LNY4jXgEVoSuLZ1g-uRjo5EPCUit9mFz4R3dE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UaZ_RbuZA_ef6YftrXONC1nHmh_3MFlvJQ80cKzqgXw&oe=6A4521FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3w7hlrO-WwQ7kNvwHOFyzX&_nc_oc=AdqIIU3FGBVNLiHBoTk9Z1aYDhDWK58sFYrTsB1wnp-K0gihTAL5OZdSY3y8qCzMMhI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NQhfCWV_G0k35OR9TXT63JLCwgWYHNJKIyfPEHCS3bA&oe=6A451FFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9rxpb5UvN4Q7kNvwGLRy2k&_nc_oc=AdoPFNF2z7Qe_RldKvcUzX9Lx2xjkIl1K4bQ4rR9vvF4nIYi-t6RzubNoPl0RZRqVo8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a-LBRiOLvyzy322b_Odl30vCm9VYd4S6so5FKyB2rbA&oe=6A45229C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
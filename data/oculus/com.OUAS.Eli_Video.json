771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnJGx67_7VkQ7kNvwFxlNhN&_nc_oc=AdpNq-hNdJKRXuHFTcx1CJdumcxudIKARfPmN2EpP6FZYncCpKzCbZW0kL6wz5sBGQQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87LbSvluhvELcQ33IQtvS7I5UNyo4QpA1TCXyblJXkqQ&oe=6A3D4562"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mifo73Lj3nUQ7kNvwEQ7JSb&_nc_oc=AdoiAnt4Mld69rrJurFDECVHWNgOfg6WxR7CS9Ptaksh-avAu1uaMG_SA0ufLGJnEIw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sPSwqUqD-KiTvrm1PiaMBAm1yV0qjbHmejQ0tD15_hQ&oe=6A3D35CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyoHjjOBKlMQ7kNvwFxIcqU&_nc_oc=Adryhqb5VB8f2rrepg8p8K2Z6x5KkfuGPThTGbHeiy_aaoQ0jyWC8ghFESt5dphDKyQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u3FSees0bCbsoIUKOhb2g94whjsuRWo3evVeGJ1cMFw&oe=6A3D38FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lh7N4zp6nlUQ7kNvwGTzusq&_nc_oc=AdpvonZT8nZLY-KoKa1lZEwvEYEPEJ3K5a2Kb5CiL4yLTYCEIIl5KCx2NmazJm-ohIc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KMs52-7iOa2wMhb4Utbx3fT5L4LM_52luZ21q0mV41g&oe=6A3D36FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiktSs-X4uIQ7kNvwFZPBjB&_nc_oc=AdqX4xGQDCm6o53m4y7dEvwFbgqUdUqlQgtlFmJrdxlauVQVcHXmUao3Gtg3hkyaCoQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g02NpRkD6l_AhMylRs2Yk3IYDsbegORmuIfyxx8G-jA&oe=6A3D399C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
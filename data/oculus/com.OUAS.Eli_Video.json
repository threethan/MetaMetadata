771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViZm2eeUqG0Q7kNvwFFw3JY&_nc_oc=Adq247VbM6R9cMdCeCdRlllSvBML5SuGjXx_2NjMGQF9jSBzCRoYGEvJUaZ_jZLv5gk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9SwpW6BcefEY48lafzk35wqqm_K6UmHZLobg1ahqvbw&oe=6ACA55E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pr-bv6Q0asQ7kNvwHGv9ux&_nc_oc=AdrRbpQ8mMORzd4beGf5LHkqcHlSkK15RNptoXJ7VkaQZh149ybCbJxyH-5Le-FEAg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPObbnvtqXLW3o-OiBUq7gyHFBk_9XIWurkYB_bngi1Ag&oe=6ACA464B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-LJt-LmwXIQ7kNvwGMAX6g&_nc_oc=AdqjqQUcYdg7mILyEfJdtf_EM4-uZgyBTPfpyTOHpV0-xZ282iwemr_G50XOrOdtR2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWajK3u27nMak_xq7xcCx8BzUYc37YxH8iIeOZmFiJTg&oe=6ACA497D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-rwiZ45yv4Q7kNvwE5zAqi&_nc_oc=AdrEtVSscrNv9vzsocqI9SBVgb3ngbCZd3Ugg_y218ItKt3Bgob4dQ6irKygZEglnXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF7IR3cMBMLqyCXthUfQ0jJ2ooJ-HwOYuZTCnBCvyBig&oe=6ACA477F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fln0mUtHoUIQ7kNvwEwipu1&_nc_oc=AdqI8_q7kSkC1knUIZqJYTQ8nMncceEtmewUQJ-hK45u0cc0j4riFkduBNg6j30br-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9GKy1RJo9j9mBlbFpEvjLxkszHzfbWg5RZQBrG1AAIQ&oe=6ACA4A1C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
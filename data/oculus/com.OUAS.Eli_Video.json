771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3RoVnoY8UgQ7kNvwFZzkjG&_nc_oc=Adqnj-yeFyGZ7wio-TGEzZb6cFrwRlVMKsLsLwkwHew1i87lc7u2mDmzPEtW7K_gop8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAn43UGL5jOMANujYzc_4Zff7lbrvIizJHgrHj4ligcw&oe=6AAFF7E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7Dt2m6XkAsQ7kNvwF3JDtu&_nc_oc=Adp6AU1cZw36okrSCsM9BgEQw0_keqPT-Cmhu4E6bV-1vV8glOAH_4RT2OgtTkvvWys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeuaRn-IjudsrsctkW50khl-ESqhG3tm4VQgyPv_GQCg&oe=6AAFE84B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eMUjwqI9HMQ7kNvwEqpKIl&_nc_oc=AdorDUZ-nPS3dslvdVacW0ZXYpoloYhDIRJwMgbTlH3Vo4XFkb_-lz6dA1aUtU1rSWc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1te982h27NEElAqQhHI6uQfL-wWn20XzwxYTOqg3KUA&oe=6AAFEB7D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqi14Hc__T0Q7kNvwGN2ZNb&_nc_oc=AdrWnbHX_081k4k2eA8aa8VyM-1Ma6lHbCzUDPlri-dBhd2Isp1T1csPZeLdwwRGO2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPjfx4tpHu0PDaKkY6GiaDxxXpHSFhK6eUr1Q9GPSxRg&oe=6AAFE97F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztiKto8v8VAQ7kNvwGigQV1&_nc_oc=AdpLkki7k84uTnV7ZbkESbiQ7jNTmgCso8OokSn3Yb5AK7bhxUzrYz6MABwXJX3cCA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf5JpRFoZ7AQiryt9Em7SFzStW77HZVe3ZNpeYaOWpag&oe=6AAFEC1C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
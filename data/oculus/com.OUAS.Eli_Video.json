771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GD6Sn9kog0Q7kNvwEuoI-s&_nc_oc=AdpOQ1s6g1bhrJIJ9ZXFbSHY5iLZ7wHLIConS7Nb0iokOnUc-h-66sGbafm4xhH92tw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBtFSgqDeWNgr5YZnTP411ZwVgIZ5flIu-SB2mv4YfHg&oe=6A5A4662"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uF0z0cpMoiYQ7kNvwGGOemo&_nc_oc=AdpJN1UIJRrPoWY37-WzMicSd-VvCUjWdOCc2q0Ux3Z0CJq4frb6ief8IcdvgfbMjco&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWAnXDU1RXQGBvLdd4zeb-GDg0igXlUNpD5B7n4YuoFQ&oe=6A5A36CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m5duYY-QEYQ7kNvwF5JeTK&_nc_oc=AdpTy3qRD32VWIjTGhkE3SLbRyLx-wuikdniNDl9qI1CvKenvV7xwJgK3GHbloXQbxc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmAFUPPTUCwn62MNwqmQ_gqFjv7P5miGdesTFU_5uKeg&oe=6A5A39FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsndYtUUzQMQ7kNvwFnyZJj&_nc_oc=Adp9UgO-TYqbFQrZ4kiyfxo1E49FSFVB4FQExGRpL8zZMpNIORjeMMbonlhWNL_o7l8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9_dkBTij39G2trcBYslzYJNOmLiMxWeIuT25c5tiOlg&oe=6A5A37FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfBkC7IJEFQQ7kNvwFzfD7J&_nc_oc=AdoezCLmtIRiGDeTlNvI86unjpzfXssQwFSLOTkg3zlrw5-ovdsqLIRksvzw3ddEnFY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMWGdL7RLBzmguhgK_9L85l0liqIohBR9Cg8gNpXd04Q&oe=6A5A3A9C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
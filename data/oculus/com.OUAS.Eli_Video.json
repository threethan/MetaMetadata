771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHaUF7J6zzcQ7kNvwHS2m4I&_nc_oc=AdplqEJ6SH10JUpM1VGicASscGeL9D5QU--UZb6Ng8CiGUc5CcxA3FNuXPHb9AXszDY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cko9RisI1TBR-8Q8WWgVLLr55aB74wionrw2XXQxMGg&oe=6A0F20E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwAshEf1dN0Q7kNvwG2s5ng&_nc_oc=AdoZe3Q4rNN278dWHGgh2koRFOETPz0NX44xKvq6zCnA1RX4dVx0hRw4qmdGMcUEgNw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L2Rwq_ugYyaUNSVHLi_5rbOUuIXP7uZX9b3b9fLxm6A&oe=6A0F114B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qql3zoP7bXMQ7kNvwG8Jx73&_nc_oc=AdqaIeDuohixqPrS2jVKXqr1FGmySis9gOe2MwSxzXqpP_Ia133FgDvoZhkV6EeNDpM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78T0R7qYUnwzV1RdWsYqDlGsj74IIrWEbzmnbOziJrwQ&oe=6A0F147D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfuBUcq_568Q7kNvwHJ496t&_nc_oc=AdqhQoKBha_rXyk_3j9css2fDVgFuTHVQG11Zsv7w791dQu_2faukr6ovc_YbGnv9xk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZwABV6rJFZffMCIGL9Rk9-nGXBZo2Ip0a8bMUZ8lkSg&oe=6A0F127F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V75Et4RwPT4Q7kNvwFKvAz4&_nc_oc=AdoKnG9--DGIj04yKy9JvIMvdRiuC3sgL-ag9HU4DUeugvCjEHMKT3JMo6jZezUO5wc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MWLWTle_o0D2M7OIaX6UOriebx2DXkm6JLwhfoDM-Vw&oe=6A0F151C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
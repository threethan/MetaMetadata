H9ZhTd&_nc_oc=AdpGYrEnzM9N93XgXlkIlhbgtiS0YE0iDTcu_P9BacTkKWHuC0APpUU-02k_BIg80Z0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9IHsRacjP_GeWyxM56iwuXKc7DuKOheos_evV-WgxJA&oe=6A8D78A2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgHGe1aXP0IQ7kNvwFh0ODq&_nc_oc=AdqfZWZm9XRJjLzVrRc-vn-k7AXVTXGutcadJT5FGDPipOuhuaobgTVJLDnWFe7pYvA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmBPBY2ilgehfdVYSjXCIt6Mlh_WUn2ACzYf9SLKSRug&oe=6A8D690B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60_eI3U0PqoQ7kNvwF7K5Bm&_nc_oc=Adq8g2PW8_3j7mGhnWIKSx28GvxvsDCt4JVUntrSde62wFXFzNeITHJfSNWGpuUwp6I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_Up-CWou358wmKeak4XP6LIf8ikdA3o4Qf9HzUwJXig&oe=6A8D6C3D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=md1dOpFAyssQ7kNvwGIiMxM&_nc_oc=Adr0Snlp_Uok7SVK-6gJtrmam6a4UkcepYUVZf_qAMPtQ69UYluRBwVTzMwhqiCLkcU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtXpu9mP8QkWnaKxT1V0RvLS_IAQIi9hOaSS4Dznwfiw&oe=6A8D6A3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjZelWnmjMQQ7kNvwE57-OD&_nc_oc=Adpid0a6vQYHPgrZyr736Koz7mHmK3CcV0T-ULjVBy4KWGLpQYtLtncFtioHU2vkz60&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGE8OWmuWokEH4j1NygYSLMCwZxvwrPGSYgQ3Zwo0SoZA&oe=6A8D6CDC"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
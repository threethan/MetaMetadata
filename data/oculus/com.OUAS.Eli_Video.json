771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dy_bWcpVS6MQ7kNvwF4pYQ5&_nc_oc=Adpi7T1wVMCqbomsm7nhaDPcHIbO6eCobopjQTWE3Trl4GAjTqX2jRHxDTyLtfxfpRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7maVLrS0URqJzDSxX7V6TSBQnKCf9qGMiDjFEoSpkHZw&oe=6A1DA162"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVVHDXEHqF4Q7kNvwHNB47U&_nc_oc=AdqL68fc7PDedbp8rEmOLmkhKgwS8q2vwcAdNMq_Cyf4giuMMiNXyjvnXHzEv0dU88E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af705aRurY6Hd4b40GrIeZrBiHyyamfxF4QuB9qxVs5Vhw&oe=6A1D91CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxQ1FhYO-IQQ7kNvwFE0xXJ&_nc_oc=Adr4DXkpXeEPh8-60QByLh9i93MQZjojHceNGytOeGTXwXK6OcvGnutgDhDpJokt1yE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IjBJ6uRBwB9pIrCjD5OrM0mU5JZZfnnTLkCrYBPhN2w&oe=6A1D94FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tv0c6BXkhmsQ7kNvwHaO9k1&_nc_oc=Adoa2TLdVsJ6PTqeS7kEh_MYwRoK_wLefE-OW10F74UljikwxE9Jga471i8p_l3dxwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nl3g9d6G7EEzjA_ykUHciyvErbkqxGUKwRwehLPY5fA&oe=6A1D92FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AneouLtXi_IQ7kNvwFiuIhe&_nc_oc=Adpv5RzgzDIZUBjmhqVv14gcdK3MieQqTSM_IZATjTmHTfHveD0ZE6eru6QFxKaW8V8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kRh43AbPHBReXIrtIZGFBoCaF3BWuGfGY_kpeYra5oQ&oe=6A1D959C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
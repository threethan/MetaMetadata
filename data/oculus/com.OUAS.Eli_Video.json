771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzoVh4OYEkgQ7kNvwHuWLqX&_nc_oc=AdqizWYjcnM8Ic-YOvjR4r2v6eOb0S3XdJ3JOtSeQ50u5rZNe3MZtYrPj1TwvIbCceE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEW0y3SWHpjQsQIT76E4ju75FhIpvjAUW1qK_XpclWiA&oe=6A4FBA62"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg5S3pF21i0Q7kNvwEa3d3P&_nc_oc=AdoXpuoKL2kECwblrRGY7Kgj101d83Zszh7dd1ug6_DXbBAbRgS3qdHO4ojdzxZp_CQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMZlH4ln_bsgwpZITorg34Nf51eig5XqLPRetzcCfQuQ&oe=6A4FAACB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGyV8BfmXKsQ7kNvwHr7NlK&_nc_oc=Adr_vY7Xx1NFKv1QAuQfhH7pO-SE4ZITSGEExM2aGZUIzdEPL7Q4bKTgZnkuHHtemDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4PY_5pj3O3GxDZsf516whYpHL3gUPNqpQKTbghydrIg&oe=6A4FADFD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KT0gwSVCE98Q7kNvwEkGiGE&_nc_oc=Adr7eftwQl3a2G8vvQukxZ_Mfz-URZUsq_97_O_H6WBjBXx-W-O2nGXjfftHakSNhIg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqwcl7kFXPG7er6Tn0JEhK_XMMxEWPWjYgy2QMVLvMUA&oe=6A4FABFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRPU3J5Bm7EQ7kNvwGme51y&_nc_oc=Adq3r2pILLbVEndpcNc1PrZA5dkp2wzEklERORHMYUBTcxnWNn6T5nVEQosHBp9w3kI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDviv0rUtltcBl_BfZmCv8FVrLddzc6HT21kCPUePbvQA&oe=6A4FAE9C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
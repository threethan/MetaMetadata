GjQq0k&_nc_oc=AdphdnNOICioWHi7BD8c6i1KvrYmvYkX4BBQ64p1zu-pAH_liNSM3ZIIxCq6edRrXwY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0lV5esLO37Tyugkmcy18BMJq1WiUt6Rg45NnZZ8MYzg&oe=6A8ECA22"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgHGe1aXP0IQ7kNvwFa7AzA&_nc_oc=AdpD_7FuyZHAAE5S14rJGsukU6VhZ1Bogadj1Tt8r0KJFBG5rqv4qoeXP4lKlYKbqco&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDHb1Hkcsz6NA8Y8O9T_-v-sfv2mmoMWnLuaIj0XdNsQ&oe=6A8EF2CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6D85B7Md-wQ7kNvwEJHsh7&_nc_oc=AdqpFV4L5c45aX4Jn5u-FCQPylLC7iIdTDqrENTAuzC0e1bY3qNRRs3AGt_JKH-BrFA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYPSMPRK0UjTs7Ja50yFI7dWpBBJEnu_DVph8N0KXm4w&oe=6A8EBDBD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jq8y1rQh3l0Q7kNvwH3fkOs&_nc_oc=AdoHIqs11KW8BCkO_O21idCSBr8lR7IB0Jsf91Fh5alY3zJNeKnWAPv2rF97xO0xwEA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBvoevNSAwpohbJLgr6hXhxXnr4pThEK7KZJTEjPg54w&oe=6A8EBBBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjZelWnmjMQQ7kNvwFAljyn&_nc_oc=Adq6KbxL0ykwWhGCqJNUvaRdifQOYpAmWclGbxiBbkl2bmBNUKPbL-PHUODCHltvlR0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdHTn5AUeTTsgC_BaQL9bsdk_-_M1ePOOIyQBltbP38Q&oe=6A8EBE5C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
_nc_oc=AdrCxFL8PP0K-VEHeSWxVXgT6tHUeS0si3efj1GIQlJcieZOFTE3Jjl69z6Y_3IIb0U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw3hywWV539RvsjAIu8qyubQT0Ku7Yf0_f6wDlvKSUoA&oe=6A8AD5A2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDZS5Ix8ptwQ7kNvwFXMr5-&_nc_oc=AdqCDIfthiqC7v5o732lunT61jGI8DK1tlngPvFoQFR5x5l2gxBtTKBxSwb3E1JYOCw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoVx8oIXsxBngRN3jwnut25R2ABmHONRNQMUSmZmVZ9w&oe=6A8AC60B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60_eI3U0PqoQ7kNvwETeV-2&_nc_oc=AdoAo_wOOW2P4AolroQVy2sl-MfHhfpwlHOlSHpqPEz0_h3W1hfMmeyzn-7SsXZm_U4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqG4sqOvKbvBKi3kP6aHcOPyLpv0s8n84lsQPRoA6CuA&oe=6A8AC93D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=md1dOpFAyssQ7kNvwEXo4WT&_nc_oc=AdoOEtSPiKHaHm6xSXUFy26erpWSd1mFvAYPn2Lgt-DDSkW-DHLEaxVnMPqugzT6Gno&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE90H7BYKj0ANzBwW1ZrVCXoOt9yKXgtlupz0CTzhCg5A&oe=6A8AC73F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiAuFRpAJ70Q7kNvwGQYF9b&_nc_oc=AdrAxtNxDaSxnrzlWxNmE88o3317f_v_hcsZLyiGGLTcm2zVixEoE44oCtQ7EYcQU8M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-KceDPd4l8hTYobGXudcytCuMXs887ff2OlJRclA7DQ&oe=6A8AC9DC"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "268496269
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8648ptGObAQ7kNvwHHwgzG&_nc_oc=AdqEi76GAQVtgUgufvcaYEjWXkk4WxrPHjkq0eiU2n6Y6D68g2Idxb3SeFF0bqTETUs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRR6wjAEoieILfg9zb63q_HCJGLLFrlqBGY2GTBvr6pw&oe=6AD0ED62"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTitmBCZr8oQ7kNvwH8SmD8&_nc_oc=AdrGyrtdezdTrQimpFT_UvijpoNGVUPZF5zozyDzA1-X1WhGpIRiAdiCqAM1e5ynuBU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyipEsHjHbcnrrUECckL_-8vGSESmGNo2idt4J4UX_oQ&oe=6AD0DDCB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0gjPzPd4a0Q7kNvwHPjgz0&_nc_oc=Adrq4_bLxvd8iJFABSp2hWwub9KMWn1f1TgxNeluII0Gpod3iOT27FTmdG38yG_EPzM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHnd-Z5AeDPol4Tah-i3yVgWFw0hBJdJn9UGsdAyKSYg&oe=6AD0E0FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtL_Q4cGZWgQ7kNvwFtcNdW&_nc_oc=Adrbj7OMlgWitchWotet7FeX2KSy7NH3OnhaJlZyeL-oVCSzKN4zs-1nrZtEq4fiPbo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIVa73b14YsGLkI4doHUFrYe1AOoMVd9qOI52NtHuOSQ&oe=6AD0DEFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGxtz6bBmYQQ7kNvwECXzF4&_nc_oc=AdrUsCkb9wKQiMmSnLoxD3bN0WzP07NqIBf3VHjMsm-RFGJYU8zIIEqdM2PbxyUidLc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfrlvaVByKNF40sSgJNrt1Ls9s_Q7NulqY86bIRtWmEw&oe=6AD0E19C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
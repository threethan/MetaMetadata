771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7ia3jsAmmYQ7kNvwFIuStE&_nc_oc=AdrVKC3UB9cqATsQ-Psa5ZpcNOawqeDNaFO3JeaBLUP3JZy5E6O9ntlYaj_DnpYAMA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X8ZxL0jdMpwg0-pFpuuXKyg-iroRBcf2SYHEiLNu-hA&oe=6A258A62"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xuHmXc_Gc8Q7kNvwGOHVH-&_nc_oc=Adp2_qE8T_ICsmOEHZ8clYNGB5MeFlIcEPIzK-D7_NGqMr0CNpwGBAFvO2flyfS7ieE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AYqdmOMqYkaZOHHXVVkTWKXtpwTzN0Zeqz3BbhQGv4w&oe=6A257ACB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mivJ5gxxGaAQ7kNvwH3thLz&_nc_oc=Adq4yY3_f4ZsWMMUDjJfom-OTWHuSOnE-UtuvztO212_7inoZBp07hvKVSIpZ0FtEvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rgJGF5FEKwdgcxRlAHah39s-YwP-JCGjAagXZyd9lDA&oe=6A257DFD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mx-IhIWAEKkQ7kNvwFJX4vq&_nc_oc=Ado50CiGjwDDQGrOFHnqXXmS3JWHFr9qJnau3OneodDt2c9uYBmfIMH8XArFOQOWnLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af972kdboaFvFrYiLj0LPaNroDLaWruQ8X3NpByKQRAGRg&oe=6A257BFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fyQr7RN3i0Q7kNvwGDw6zv&_nc_oc=AdosLpker1u93LdYvbYao3-u9M5Utmr-wDALDqk0Kzs9wppYYpxiqwCnliWPVXOcXaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QkCdywbXnDC0ZjlgkdE3wsCKKPQgZjUhLCroll2hA6A&oe=6A257E9C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
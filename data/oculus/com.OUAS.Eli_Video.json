771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awSmaYb0V7MQ7kNvwE5KptG&_nc_oc=AdqAY2NndpYTAlq8uAKemt4qeu5R85sBojXmNSOr4KRpS1Mo94GJukNXGhqj6fxLebU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1S-OgzFXO1sUuGzxr8Py8Qt2NMHx2oXemRROQiqCvQw&oe=6AF87A62"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVixHxvocOgQ7kNvwHShP2j&_nc_oc=AdoelV1QQZmXbTYI-jM7Vb2KCtFK9AF0709-ihLKm_aB4ccZhhOa6ggWvsW7vIqjITI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSeR18drpvjcB2jga880Ls48OgL35VvPC7mn8yn8ccCQ&oe=6AF8A30B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LJ2yTCN7VgQ7kNvwEt8Zrq&_nc_oc=Adpv2q_5zk9MMtNIpeKZITWB5lybi0x_YQ9GDhx1LjLJADfnpse_vf23M4SA5XLbHZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSR39t0nS978DvDWRyTPoBLgIXw03z-BqHXq_QiVaHsg&oe=6AF8A63D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ_5QV5ox3EQ7kNvwFPFOPl&_nc_oc=Adq7pDgrsIV70bHOaP1mDczJ5O3MreT3eqLufPnul0HbX6ld63M2K28we3be1Fsrc3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHU1qBHj5ZXvHjlpj9wSL86q-Rf79WXpkDHng8bIFMDw&oe=6AF8A43F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mcvhcw9ftmIQ7kNvwGRgBo-&_nc_oc=AdpryjsDcNJ1US1IPW77vqB0a-DofeWzDuQ4WaYVCuqjFUnGr_tKz2DsigLZbTRX2JQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLB5uj7qUzi1DB0PlyvxrEUoWwuCsqcHoFyaVwKt8k6A&oe=6AF8A6DC"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnvHhK_FniwQ7kNvwH945H5&_nc_oc=Adqv-TuzVs2HEYBDM9LkBRdxaNzfBdS5NO79N3Z7G55WnB_R9M1mKSnFHoiEc15-L8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HTvx2W1fyiStoFryHr1YNR7NXmZzONunGtaaMtkh8zQ&oe=6A3AA262"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNZmfg9QamgQ7kNvwGoGzf3&_nc_oc=AdqtoUb1K1fmFLAHsQuuzMcbGv7whWDVw-tnx21mlajGH0SXLKvRuh-X5B66qeqWmeY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GTFnq0LPQ2raTgK6QrE8i5PEO6T4s7bFHiDHFfguYEA&oe=6A3A92CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bkzl8shCgnIQ7kNvwGTtGAv&_nc_oc=AdpJeYZ_IWVfa1-zKEVVL6x_du2g2I9rrsHwmpXftL9KXaarEZk20WoffOWF58v4-JY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w8gIDvrQzBR6hi_oRjTYGpNm-mnaefi-HxLJcA4zPuQ&oe=6A3A95FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lvy-LeY6_oQ7kNvwFRltsT&_nc_oc=AdrOWA5CFVutLZJm49sC334GT6req2k7gUmgvsO_ddPLpbPr_ZeJ--bDutFxdxVKFPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-loWCkZMskLXb7aTxJZIpE4iRtqRgckurXZVvXldimTg&oe=6A3A93FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8xi6MZtHRAQ7kNvwGLad4A&_nc_oc=AdoKNGH8W6XKggCzYku8xZ60y2GI_wj-5BXadY_QuT-yvzeJmOs0cBlgeMSHOQijWXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O6OMgAYmDlowJ_cSRyZZtNRC9L9NhHP7A_r2Y1j3Tyg&oe=6A3A969C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdsX29cw9KUQ7kNvwHYMj4L&_nc_oc=Adq7frmR9JRczQuPowycnRqhEsatLLqf7fxLnSB-aLlX0iIdR10SDcIE9xntYPdw7Dw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwKoFTfNMPUvp__rZN_JipoYxKZ5RIP6ORTgdAqdUZew&oe=6A6B69E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEKFAqWGwPwQ7kNvwEzrqxA&_nc_oc=Adofp3-QKfdPtqIX0Q5uX5QvELC6nEGv-ZronAsVG9IgEKboKc1ovTL16GJRvp8NBn0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy0MuWWBgqY_5c0WbNXNGsFVIeqzzG3ExZcy3pIOW4Gw&oe=6A6B5A4B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoeVhZAqmTIQ7kNvwHbbB3o&_nc_oc=AdrcJvTXhcIlnizhOgCJbf_F2lLCbUfZ41mGwIzhJrm69SOUZ86vAGzn8yX_MhB5tVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbt6ITDaLIUxlzXIhW3bEbPAIJzMYMUhhS4UDUWgIjYA&oe=6A6B5D7D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwmwXPTN5xAQ7kNvwGgY0sl&_nc_oc=AdqswfHQ39pmBDmC8Hn5sAGFD3sy5TpeVaTgNRRVX8f9_iSN9aHtUSw0pAHbs8I1oU8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6UGmJUropEbaerA7vp_rWoIZet_1VFDtiVnPVfhZDcA&oe=6A6B5B7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e87IRHQbt8cQ7kNvwGbkPOn&_nc_oc=AdqwdhtoSgJomiiJGrx8rTQSKKnQd77pcGbsZO22gRjQpvm9ezsC0FmJOS-Rwp6SaRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuWHigAZ4_ZPDcQga380n9gHwxzMEHcN7970-DA7QgtA&oe=6A6B5E1C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
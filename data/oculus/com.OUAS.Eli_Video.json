771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2HUs_J5gd8Q7kNvwHWg03e&_nc_oc=AdqYMOfoAS3yT0NmeZKDpHb2T9Y7QQ7ELrcUHWppMQA7plm2weBRkzcQTPZTxCwGEx0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6TGvlrSNlYFB5sjudGS7Yss3BBpboHdXvHf2_DfSR-A&oe=6AC90462"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pr-bv6Q0asQ7kNvwFLaXB4&_nc_oc=AdrDnRErvVRAOkVTKOumMdoovzpwPTWCTVb6QbT_3BNqX5X8LcERFu-ZA5I0csd8zc4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu53cKbcVGNdF9Xtg7vhGO5NhXejgQzoMGFsQ8YIOzIQ&oe=6AC8F4CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG7OXlYeisIQ7kNvwG6coLN&_nc_oc=AdpGQd2JxAy9CLZ0Gja9lIi30AUNxwrtkGcJ7P_Tf6Ol4MzJ9PIvdsHvMmebKhXlFYM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA99JV0er_hVGwU-ftoMZb-5luVvZTaPNGdeFvbQYrQQ&oe=6AC8F7FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyluktnKXiYQ7kNvwGmWPAq&_nc_oc=AdreY0tRmDf3GOGB055rvwOsTMQhb94UCDShYwpHXSqbhkVdpYNpBwonC-V1wXhvVGA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM03VNjfnGjvldYR9Pl9w2jc9YkcAag2QUNyPgn0FfOqg&oe=6AC8F5FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fln0mUtHoUIQ7kNvwGVT0mU&_nc_oc=AdoJeeJiyEnFqJ8KZtN93uoVfjHbtYhax8aKXBpwVZ_U2KWq6Wmx4D65NXtL0vSV8rA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1R5L-iut9z-uuJG1vD-uGb00SrNQw3LU633a_97dWTg&oe=6AC8F89C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
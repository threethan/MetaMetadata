771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJuvdTayaScQ7kNvwEDW4Vy&_nc_oc=AdqHxVe4jV7EnAq9wK7u4mHfklSnJyJBTOCDO_Ch3AQA9JJz-YtfMQDT_0aJSM45Xzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ks58gMpbh1wy5yJ-TVXvA17HJGhyhj0Ei4Zx1tuKhnA&oe=6A47D162"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv2cQZedGWMQ7kNvwGSybgX&_nc_oc=AdoieKP5G2ncnM1dt1HECPA0IvXeS6n5VrMxzTdlw6vj9ELAZlhxMJkPPxFHiVGpGkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WdI_hcPC4zXAE8SzQoAMN_kI9QXe8_2Z6dqJ7AJpkAg&oe=6A47C1CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU4fVp95nfUQ7kNvwFjvYkF&_nc_oc=AdogVFHF8uVUYmPr2j5XMe2tZl7W9bsCpPkn7JCOxaiXGSpMenkP0kfENHw4ZFRQd2U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LN5cNlpbNJwetnentZkMVo4C3RqarIO4D8_l7rcvRAQ&oe=6A47C4FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJUiZUplKRwQ7kNvwGeLqZf&_nc_oc=Adqn6O5Beib-y1JdZ4ysLP89TRdG-t8zvaufDHsCKU84-WmHhm5ENBSnVEn_JSLR08A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7VnrHgRvXS5z6kRDgQLMvcXNcQ_m-VJ2zupcboO7hzg&oe=6A47C2FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9rxpb5UvN4Q7kNvwGrhtN1&_nc_oc=AdrLckGfgbZhJx69aUISfL0K0YTrYh5cxStpCHYpXUB4szwXh5vloDg3Rm2L9KrRPQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d3U47wIZt4ehXSF4ex9I_jGNJGYqdUnjBZfCOvKyAcQ&oe=6A47C59C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
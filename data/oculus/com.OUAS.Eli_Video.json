64.5771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii-WTf76IPkQ7kNvwHTGpXu&_nc_oc=AdokZDWBUu-wXGwK2g4mnwU4RC1d7e2AsV-NYF5gC4g7gjjdC5q-9iI4Fiin7pAHMNY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdg2_94LrwhQzF-KZ4JrxAJF-KR2KsVtUfdhQ2K5FYEA&oe=6AA41A62"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Wm2dD_b1YEQ7kNvwHaDdAv&_nc_oc=AdpWdd6i1bs0KrvkDo--McjI5Zmln-2WGrmcyNybiiQIdVkEja2Efr8s2CQ7Gi6h3Gw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj5HFCAJTbVoGutThea6BQP1Xyy8cVJxGNvm1OhYWtFA&oe=6AA40ACB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGQGhE6t_1AQ7kNvwGb4l5J&_nc_oc=Adr6rYHkzQh4ALgW9eVV4Btq1BV4zKgozxzvuj1qRV9L-SSUedCKTs6eV9Pm9zqFSPI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqG63H_PTzibggRldNfE0l7NhB4C7iIxnj1A2iU3F1QQ&oe=6AA40DFD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CAVLx0jRHkQ7kNvwGvnCiA&_nc_oc=AdpLKjnu9HuAUuOidCjLktlKY8KtPqkG7-48w2SpuVDLtgcwbwlHZptjck4-WkA6FB4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxy0pGYj7iGojo2i-7LKbqM6XSkcyplms81Ww_7zJMFQ&oe=6AA40BFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t90b8-Mz2sQ7kNvwFNlGJN&_nc_oc=AdoEZGgdpIP_VVgYNAaHTiBDl7Ig0lGYGZ5jWqxiZtQitmQziHGjWna7uFaxhJdPwcg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-iI1-EAiP8s-J_Vmefv_LrUvKl8IAsqCSOLZD_Wd0aQ&oe=6AA40E9C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
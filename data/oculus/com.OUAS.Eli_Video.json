771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mD5XCygbV8wQ7kNvwHfio2C&_nc_oc=Adq8Ww6WiuszufrABHW2LX_pn42SZpJ9Vr2fPUY2nSpT8npcTkmNXq_ECU8LaOMMSVM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81BE-R98CgytOo-lMEsdgwdIt-VHcFWEvxzLC2Jqs5ig&oe=6A3167E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33PhprbD_pIQ7kNvwHjOkJH&_nc_oc=AdrBR19KFyMC_AS9Jz8G-JxaUCxE0_Z11-5rrKoHbBk_9FTijjXPkzuUgejDbP1Qbl8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LWL9VLBet7rBbPEw0x5vh3NfYe2_U8i7FjqM4mhYr_A&oe=6A31584B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xs0drbR_J8Q7kNvwHc5rcn&_nc_oc=AdraxnOo84m6ZfVnxa0sTi_38X6-MGtme5DPVjHYb0EWHMg3JpppbB868v2CHwJQjME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MbtNqj1c9vQUlX5cU58bofnYobEdFEAaD_5OQby-oDA&oe=6A315B7D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KFEbpMAZQ0Q7kNvwGmvb5q&_nc_oc=AdoEFrRsn3bAIJ_HENSmvDSmeIHGA_L2O1MnwwlvYxb4WlIfX1cs_XWiNRkhdE1THLo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BXs93h-4VdsTh_n3h2kBSgHcuysvbeVzE5MN4Flgytg&oe=6A31597F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSUZd8Wk9yQQ7kNvwEDfBLG&_nc_oc=AdrYqw_r2bnYFdXvHFhvF5YjVxb31BNpzgjJtP7VV1XB_3pXQnV76KU_5dKK7kAzUYs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zH6eAO1cuxyddT-zLZh_hGEY1_OS_Mh94IYlrA0AXHg&oe=6A315C1C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
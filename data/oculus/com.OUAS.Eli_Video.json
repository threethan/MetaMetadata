771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rdKuqkKYDIQ7kNvwFZoDNU&_nc_oc=AdputuOJxoqxng2sBBM1PaTqHeYx8M7gwhHF2PB7BOkRdCGIztbPwj1cHEd6C3L0UbY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Yll4kHVb4EimLvsb3ukQgBA-D2OFe4LkY9HxIsqKIQw&oe=6A15B862"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcchbggoLCcQ7kNvwED7Ksd&_nc_oc=AdqkdLpRn8bAD0jkTLe6RSVgOir9_-Yp7h_Sj9ZlA1upOPyGgdr7nPOBpkOCOpvuwa4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af737lnZ1OkvXC0q7K0lxRtnw1gL6pjEQ65HpMISUHJBlQ&oe=6A15A8CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUVjAClEyusQ7kNvwGOuwvx&_nc_oc=AdrVlaiEWuM_Kh2kV7Ss3VTAfNrIUK6P-3pYf12UkI0Nx54_5y9AafvJczivT11tCPA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4I6VvC8FaGVjuhYNS5PMi4zAqt_SrLaDECeUdWw2fIuQ&oe=6A15ABFD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV3ZuGm3VtYQ7kNvwFPUPpW&_nc_oc=AdpGdrfkBYvTahOI_5DrsqEDhTyUPvwNhBMbwZRqda1PoBQ5pPHLeCV-xQcFmh3jpB8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iSUj1r1-mTqmDTbkBeTO_z8QJeebFUM4xVfRNn4rO4A&oe=6A15A9FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THkFccz-jV8Q7kNvwHFG1TO&_nc_oc=Adp4edvWEYAODI7VVr3ZiSWfrNqQuqYd64Wmucs4s0W_gsRWJ7dKb-MJHBRVITfuB4g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mXfg6sqB8xGomp2DaYSj7rKwBuHEybNd7JOSlIcgx3Q&oe=6A15AC9C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awSmaYb0V7MQ7kNvwEGZVZD&_nc_oc=AdqAGGtKXto7YcFeXYaebXL4eHL_rQw_957CEDzETKwlzKkQuCAcNziOij8dTTJX8Rw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu8X8z2T9JTFiO5r1TME7q6s9HCp_mDugHLGFT-o_d7A&oe=6AF5D762"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clz12g5vc84Q7kNvwGwsauI&_nc_oc=AdqNEfq8PSbXdOUa9R4m47oDLnsxz0To6LOZDLjZWi6KG-ukJXhCov5_Q2Hl0aGOc4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMsBM1ENFVcGGp13rIPaR9vQHZUHDE_dB3gG_swqm-3g&oe=6AF5C7CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LJ2yTCN7VgQ7kNvwFDwqyz&_nc_oc=Ado-j6NFR_DhZFSFaYnCj-p3jT54ZaQFLumBARbEHl0mspkDQtf3Qm8LVJUkZy1iU34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRAIoxkXyiGwuGAK2mkyWJAcS_ZY8qExvvIdCiSqeIvA&oe=6AF5CAFD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ_5QV5ox3EQ7kNvwFo40Kr&_nc_oc=AdrJKorksfyOqk_J-YjJjiiNlceL43ZnJ-3PKy5Yxe3rzu_IygkJDXA3bccP7Pkt8VQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaPLMKsu3tQXc4q4Gv7dY_TeyNjPRM6eeRFw-UyMkqgA&oe=6AF5C8FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BVNAne_YOIQ7kNvwEe2PSC&_nc_oc=AdqZnrZ7mQ-ANPVNzS24dxQUpX6Y2_8xmqOM24odhW9GU1ouoaIDh-IwM4k0tE5LnY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYJqAlbhFgkAhK1wYfVp4yFCQjGVYRpIzu46Jr_2L1gQ&oe=6AF5CB9C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
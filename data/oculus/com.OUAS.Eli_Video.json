771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dy_bWcpVS6MQ7kNvwHMByD8&_nc_oc=AdpcZbL8wqAfIzkkNFIBUXTMVY_qyW2ze0p_DTwdQtx6za6CqWlBppVo0uvLzf8K7co&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GJE49UYqODy5ss4D366c6N_lPJmK42WOT0IGwTKC1yA&oe=6A1EF2E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVVHDXEHqF4Q7kNvwG908x8&_nc_oc=AdomCWFJYuo1LquP8IAs0-eTpow8gBJXK94hdYJl6THliFgAi11f2jVzixdSm_u8PMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af442hfG2QPK2-7uVXqGHhZE-vumUBDgw8jg9cU3k1nnaA&oe=6A1EE34B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxQ1FhYO-IQQ7kNvwEUPT27&_nc_oc=AdqFSjwdsP_xiXe8cRDn_8Zn7YtUVYCd3PPJS8TdW5XR_gdO4qGU-eKelHkahOb9bfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53wm5yfA6UQeo2e9ulFyf7LisouKvm1_rn5OYiYLWIZA&oe=6A1EE67D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tv0c6BXkhmsQ7kNvwG4iNSL&_nc_oc=Adq0Aca7zRUnEEMYFLRfXSLzdR9BlLvXO_oHwhYU0KAkih9aBoCqUROYhngBILeWviE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56GVl_msXqzI8VQBdXx7jejo1PbeuakObFji6OreTHXA&oe=6A1EE47F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AneouLtXi_IQ7kNvwEqWJ08&_nc_oc=AdqTS_EkTRDcShgPBv-BTYfFw_c8_OJpPHhCMhLwdO-_E1n_3EkDzCRJSPsvIDP9-jI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bnf_MR0pTovcOEAqhFgQmaI_j7sJvJ0ovt4FEKewIng&oe=6A1EE71C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
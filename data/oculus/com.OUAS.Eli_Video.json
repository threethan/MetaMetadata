771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYaACF5vr48Q7kNvwHoYFSR&_nc_oc=AdrlaReseh08V8X64FJtzVlt1RRMntqCEzcS_c4UOYJ7WfhVY_0TWAfSZxfmiyU4y-o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2OvsW_kVgKx-6D5RMALFMWfqLTWrxS09wwCoLUVH2Hw&oe=6AA025E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxnfA4Sg5foQ7kNvwGS_MeW&_nc_oc=Adq6zga_V_uHeQUDGzhAOqpM1honqK7xB-9kBs3n_WCY8CROGICQhPeTBYBqAqwjAaY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUcR5IZ_V--fsA7kASNFM7Q3OBKX3AbZD3Fll2tI3w5g&oe=6AA0164B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP3zRYt1VJ0Q7kNvwEQS-d_&_nc_oc=Adq38EH-Z2aX5PKDLs83hgoIXCbr3uW9AqKiu5ENvtbYvMnJ9dibZIKaiHMRapQkSeA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz7T0LDf4WJjbbZlGs49xh_GdSRznIXFW2ny2B4ty8YA&oe=6AA0197D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YG_49WIF6RAQ7kNvwEet7In&_nc_oc=AdqSgXODmFZEsPVyRtHCdWNcEejRzhYV1YloywVtWukNXp_qouLdz3IE96fc5Ivmlv4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyq2vU_R3qTaS4O2vRKEMI-qvAeZ10sBXwTOt-vP4jVg&oe=6AA0177F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4X_9FUEFFkQ7kNvwHGX-c9&_nc_oc=AdriUunBFljZvaq8UE5yUyUU2JQXHMGELd8w06q0XQLeRzF54dOs217D5LzzTPgKOcE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfNuex_W9pNTka-QLfxU6n-12ENMMgzboMSEjGQmFT2w&oe=6AA01A1C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
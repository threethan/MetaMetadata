771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2whWXV_n1pAQ7kNvwFOf0Ot&_nc_oc=AdrBUsrlFM0YJv9XzSeS9sXDXlubiDGQcwfd1dh3VnxyjMfJ5pG1SYdALKH_wSLTF1w&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JF2vqZj30hQ9zH6yViVedNSDXKDojKj0VfJDxikVneg&oe=6A107262"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwAshEf1dN0Q7kNvwEAU4p8&_nc_oc=Ado7c4IR6Jr9MI--ytHmuYaN7R20kfjVD0L995ZakdSHaYl6syyt8aHxFJTZMOK7bfk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HaFY_htbvnIYz83ohxiIhaNgLsKidYAKsKJkdg8FuxA&oe=6A1062CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83aV9O1KV1UQ7kNvwEA5MM6&_nc_oc=Adqr00Nm0qgXIPJjWNsbdXYcm0DHVorR5cv4kIiMyv67AS5fBVMfdDTmVFaNhoNyN2g&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54A4aaMfXbrmXiaBJqIboybYJNd27kjekJiXfojUP1SA&oe=6A1065FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6p80LpnLkIQ7kNvwF1wzHj&_nc_oc=AdrDScjCnQwn2yyB5i73SFKK0uFgeJSYYSWSsklBc948jIGBu7-cyFG4oL-lrGOsPAI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hooUIxgt7nJRBVm9lvzAwK5wVqO1g3wSvqXce_XQfiQ&oe=6A1063FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V75Et4RwPT4Q7kNvwHOyUcW&_nc_oc=AdoExpqAVPXsn1-nDpQT5bgJLnP8-6WBU72_98qckrwLq4q9ri7Ri7r0g-K7Zx5S1WE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RjX8tQaQadet8uU697c7-Pxb6O9ztuQPfLxbZyNRHBQ&oe=6A10669C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBYjL0LCnkAQ7kNvwFlU_2l&_nc_oc=Adr1Wh85DwYv0klcB542jhjTpKpIiJhetMQ6zx53emkugsFcxhi22m5q5bHmT-PVxg4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD9hNBr_icc8Ml82XvsT_Z0pM7a_V5j7AxQFda2vymWg&oe=6AEC9CE2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uB8di73OGUcQ7kNvwFIrXog&_nc_oc=Adql2aAaM-Q_oNJl540Y-btNiX4Nxz_O1aYv3uo1hHiEltdqu3jZPReaBRXRDWwz0hI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSF0t3bfMGf_3aYyHP3oevja_zi-QVDwOV5kONb3Kr-g&oe=6AEC8D4B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6dBr4WQr_kQ7kNvwHXAiY9&_nc_oc=Adpy2GHi39vB4S6IR_KUSfu9a5iSTTaoX0wJI4Y8AvHgnHg_pJ97awpK2QZY-e8kvVY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX7W7RuPRssyOehRq8y_RMx01ifHpw-q_OY0L2gVLqRg&oe=6AEC907D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erpYAMqoiFsQ7kNvwEuwAk-&_nc_oc=AdqqgW8Nqcm8EjxplShr2wA0Wu3lWuS1v0WyqZpNIeAhseuHE-bsFz7TQehVx0SkFbQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWSlDFOKTNR1cvt9wGEn77Y0sFXskv33AutUPdX3WGHg&oe=6AEC8E7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTwf8UG7WrMQ7kNvwFDVWeI&_nc_oc=AdotxPzpn4nUGE5WpDN-VYahmFklVFh0T1XZ1-st0mv5MLMstlGikJWEnzh8KVYhiQg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHj4ZfkQ8OSRvIiWRepAMxL94ANhLVVPvbnwuqtCAwQQ&oe=6AEC911C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJuvdTayaScQ7kNvwF942Ds&_nc_oc=AdoZLp5Q_VfxLwrfgdd06ZoWWd-06Mig74cHO5RDqIEfrj6_WMAs5pFA_UBF7C3DHrk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLHoFj07nyITpo67zq8bUGdjDBq7z5hkbNaWDA7xrxdw&oe=6A4A7462"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8Nrcfbs3YEQ7kNvwGiEdzq&_nc_oc=AdpExP1ZYKxf_1OSq35slnD4cmECFdcW1GniF0vWc_cFsNVcMy0QkFNM3C5FPXuQj3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHwrNsRjOrqWv9HFxuVWrp1NmVwBNxHBFJU4dvusQHOg&oe=6A4A64CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU4fVp95nfUQ7kNvwF9JBcq&_nc_oc=Adq-C4JBxTZa5Dwq73s_r-OKmBxdsmBfuThUkTJjQqnNj84qbi_VCdgizXF8X13mrB0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0xkhmgKu59Sl0JDmPi9MXlSyTESR_RworR9ewA45cWQ&oe=6A4A67FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJUiZUplKRwQ7kNvwE-kRs1&_nc_oc=AdrTRaHexjwEXTrcj89vVg3X3rxeDn0SSGqrf_qW6CGwqyvnpDfK36CDEVtl7KVZQsY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNKANHW4LecTV5RvDBXJsoxO876WY38OSmYW1wBMSc9w&oe=6A4A65FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9uZfkn5ZKYQ7kNvwESxDe1&_nc_oc=Ado6r224XAdet5BxTVlIPJLV4A8lPMjDZb7y0bk1xDQn1p70-8mYkJyHwzzaEOJBpXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH6ilkoRAfVx8oeQJI2Vpwwe0iblbAlerK9umJYvMVLg&oe=6A4A689C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0XxareY6t8Q7kNvwH3TUT5&_nc_oc=Ado49XTelu7lN6lvl3hnRUU5ufvLlRjCzXetVahhM8yylC9M06RjVsRipMI0ZkMhSrE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v6iROAopuAmwuhRX1tKBRA6WjYqGnEoaOgEnfMZoArg&oe=6A340AE2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33PhprbD_pIQ7kNvwEaaZPj&_nc_oc=AdrTDVWSWUzs9nSoHH_9QjlnckYIx2E62Ca5NM9btTwMmsUMOFIdMX3wwN4Inpg6olI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-as-OpczXqJQ1dspMQGsGc59XHS8momfxMV-FgP_smfQ&oe=6A33FB4B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHxcovQxnAIQ7kNvwEiPqkX&_nc_oc=Adpq3r5_vBtrDrZMjxb0DRpjyHmWo09UMxV3rol4_5NJ5v4vMHybsvQBUK6eHiY07ng&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m7wXhw4-590hPgKWpvFlyTshAwbpyBE608BBlZOIizg&oe=6A33FE7D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aR7ry1hFGikQ7kNvwECx4uY&_nc_oc=AdodoAOFKplQSVgStjDAvFL-20OVVRyNHkqrxc5p-jhBWs3fabp1ZTqXXDAIKnPyUqg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aM7obL-cE8s-W5FfZW5joGgRCakvDGEtDPmr1vuSlLQ&oe=6A33FC7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSUZd8Wk9yQQ7kNvwFCniIv&_nc_oc=AdrDDkIvXfqLuf0VgEerNsSKRvYW3DpFbeLpJKL2mvJcfHw-ldHs6TKJJm1rDzR0pxE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rkxZDopjxpdr1uhGHKT_0pZS5gqb_LXfKHrtSWekbIA&oe=6A33FF1C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
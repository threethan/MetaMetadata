64.5771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3RoVnoY8UgQ7kNvwEMPXuh&_nc_oc=AdpbJoNw30ry4ftqM5iN4g2oQxJ7mhiptvfnK6eQUYuaqNeyio3fjibj6QWbC6OcTQY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2puHP3WBNSb_SU9TCdiNuroa8MWa8E49PYZybEcC95Q&oe=6AAEA662"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mc8gQOiMzKwQ7kNvwHCoJF-&_nc_oc=AdqtAboYcSLWOJeML8EVz39B3OM1yKW5lXpM7EEjUHyOO_8eYPDDjuQY6WxLYJcGZts&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWBvqU2fqEZCBZK9tbJyMmQFRW8manb1nR0X0V53nvGQ&oe=6AAE96CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eMUjwqI9HMQ7kNvwH77A_Q&_nc_oc=AdqDHjijccwzs4W_UncDVwbKya7HILiteDqcdjuDJ6hV2YnkfoQk7dHuvCTdRIpN0GY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY1pgtqUnVW4QDO4_Spue-Bt002lCdj6-uGeqWKEgkfA&oe=6AAE99FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqi14Hc__T0Q7kNvwFJL-yz&_nc_oc=AdpnkYL4pdOTp9Jp7lFwJemsqUN8joEcQgUWmk8GH-X7beP3u6QN2r85GYOaSJ-z9ls&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBC4LUqX7HmyAtZXoD83iALJQda7vn3ftTnSEdmQgsPQ&oe=6AAE97FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-xMOzRlIMUQ7kNvwFJG7iv&_nc_oc=AdrEHuMmmEu6KaKRCYTfgsJA4VwEuOlIVW_XX0WJbKJiEqpjUGHyF4szY1KihNNrVCg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9tWTv6c07tSj22yIhe88tS-ULGC3xuZALXRYXTyvUbQ&oe=6AAE9A9C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
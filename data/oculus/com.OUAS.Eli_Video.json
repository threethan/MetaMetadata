771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVTj5WMXVNUQ7kNvwEdIVVF&_nc_oc=AdoTzbuDJmFfPnrQZx2hSxFtvipP5HS-MdwRGCRj6Q5wiJ6QWSKnbUFjeEUa95IaaDw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMluPpaBJTEwoKk-Mb9pnAdRRTdUcgEPR69SkRCOT6Yw&oe=6ABFC9E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlLomfKzlvYQ7kNvwFzgfkt&_nc_oc=AdqDnKvaUIUfaZzCDNQrYEgTjihzTv77iQMl1FwsIfwnM6kHnXsnIJQvkYuLcR3E3Bo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtZfCD2KDohBJux9oScFQHkG4bTqs5eIxHB8ytkwXV8g&oe=6ABFBA4B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3ajf_NFe0EQ7kNvwHFTFoZ&_nc_oc=AdoX-xt0LlIfWIhHiww4jAZgHvySV2JoAGN0JDIN9Pm1VW2dLAMEro4SQcbh9JGeQ0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwmWMMINOdA2xya_4yEqakTdDGydgUqFgkkbs8JKMIZQ&oe=6ABFBD7D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijKMx2_MbA4Q7kNvwFdm70l&_nc_oc=AdrkFe3uw5qpOu5vPcG4MZQwHEBjfOB0JAIevHP_zeAeGXb6ZJ0WDfFV6TXkXLmeMcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOchu-mkDjUSJ369oLDVB-uO2WasLGB-AHdorhWmFmwAA&oe=6ABFBB7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwMP5NPsp0YQ7kNvwGj7pJ1&_nc_oc=Adokrp__0PgWSSE1KbzK4RuuQ5Muh-AHwCKSbFa4ugtc6FBp-CO3Q3CbsfPVJ8ClqWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE31K8JAqKyVL8opmI-Gcc2lli8JpiYBAJXwpwikDUhg&oe=6ABFBE1C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
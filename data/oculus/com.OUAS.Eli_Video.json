771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feX3RiWkVAAQ7kNvwEAB0G4&_nc_oc=AdrNnW9Elov9kJVFEpDmsUJzEmy-NhHnwjnsZQuDfUoDlb4nLf1X9JhNgYhXyvdw14w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMwUZYW2LDUQo8ehtnGRpYOaPMdHJzVx4zQFVPH7BuYg&oe=6AB7E0E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxxnHZ6hQfUQ7kNvwH1iQfm&_nc_oc=AdoDImigTVRM4MqTZolqGO0xzxOboDA_x3LRbmYQl519EGy9mFxN8wDWgq30GH_NGhs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmoFrw9l4PdgcjSdV2jQeMQyWmQxr_eMAePksRITXCyg&oe=6AB7D14B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ef5K6Ag8fPUQ7kNvwETxxaP&_nc_oc=AdolK7j-q0W0a2z8WosO9DRcJv9w8XSp5pz3SC7vSaJ9kYeePkZfPgw7hmoKtiUGDnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0DYUw6FSx57i_WNyFh3u5vQ4MsU43vePC6FxdLExmxg&oe=6AB7D47D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6XqEdl7LMQQ7kNvwGKFrmI&_nc_oc=Adq9xBIwiTjj6klNrLKiPz7Rdv7wnN9fbP4d_H76f4suqTlmq9K_ni5UCZZiAXdR-5M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaqc5QrDScdjKgnQAgj3J-j5s7gPXYwpFXkRTRoz25Vg&oe=6AB7D27F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbxAO_5ETAAQ7kNvwGZj5zx&_nc_oc=AdqhPfxVZ_gqOtJLLSP7DRd83ba3Mvf8QB9sV2vUvUKNdWSciROFIxA_kBZ-LUp56tA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlb0thfqaPWG42MpOoTZu4ImyuCIsy_E4V9ObrMqkWYg&oe=6AB7D51C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
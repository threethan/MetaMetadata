771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii-WTf76IPkQ7kNvwGc4cun&_nc_oc=Adq2XTxZCzk_t7o6gEY2fo-KKZt5MpAoutmhhHttpd5Rk8KOjY-qdXmJDgiBE6vaoUc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw2JgvqdIkcZINGOTZCXuvFYok8uNDLjKDauC9V0wu6g&oe=6AA56BE2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Wm2dD_b1YEQ7kNvwFT4Rng&_nc_oc=AdqoB759DEHynfcGCuaxP9z_r-s9Z8v0xHZjIwkK6nwIKRLWPnWjor5PefFyBuqujHs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRMxK2FI1nPqUgzi-4lrqRl3Ru_Pxb3WtRM1--AIWBeQ&oe=6AA55C4B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGQGhE6t_1AQ7kNvwGxfC2o&_nc_oc=AdrURK2mPfOQ74mf2NpTSjQy5QES6GLshHPlfEtRxTpCFJMl6HUlMAy17nsVBB_8eHg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqCO1VCn2EoEmv7_LNu-OaQYHscRhYh3VP0KRKLv8nFg&oe=6AA55F7D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CAVLx0jRHkQ7kNvwGOW2xD&_nc_oc=Adpe9GIlNH_ut7HmGDU_b5ayWtTHJdo_GZoZAfYxsOXaOqqKGTU3qPXSA5JnooWarWg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM09f9dnW7gPZTegGR333EK8Ai5_Cxo6prSNFSnaT2LQ&oe=6AA55D7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t90b8-Mz2sQ7kNvwG6hFJd&_nc_oc=Adq7bpsqsfwCtAsi0Qds8ixKU9KSLvmdb0pDVuoik-T0oGFepTmk4lCEHkRyNMDiL28&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIys-9BXr4nH5BcwB_h9mQE_b_1-ISzYXxOJ0_xzX8yaw&oe=6AA5601C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
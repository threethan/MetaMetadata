771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0WyvVRdfvUQ7kNvwGK6-tj&_nc_oc=AdpvXlmSbPSW8XIQiJXYmgXkQiuEYKv4aGtxFNA5N7RHdE-58Jo0W-G6lvY1QYi42gY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlpIDnvcqhV5--il9F9UmQ2V8TMdqL6syWbDZlL7k-Kg&oe=6AA6BD62"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Wm2dD_b1YEQ7kNvwE-pTJo&_nc_oc=AdqOeJfdUIOxXPwgEjOuN-76qxhsu81XxTGD9g0pjTro1dL0x5hXGB46ISStWjVjhtc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoAmgzPKSSVBEbDGaOm-hm3sQlhR-Ypu-cMWVKysCcjw&oe=6AA6ADCB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEx4IhSdwGgQ7kNvwG66vK7&_nc_oc=AdpAh6vm2-06xHBkMDpgua2lSKLtVX3JElJrFFHK-HXwlzzWVdCtbvIL-jc1YOHJucQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0n-_CLFFf12wzRG9j1VAMITbpffOfdXZ4AhZP0M30DA&oe=6AA6B0FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-ckbALdLgAQ7kNvwFdnwQa&_nc_oc=AdrbzrCjEdxvgpRco9xszmYUHQskdm4UVOT9GNlqSa8ryyS2FvdHFn-aXH9tHPPyqZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkWROGUEAHS9tXslMy0tN4t15puB9JkVbZ9NrniYnXjQ&oe=6AA6AEFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t90b8-Mz2sQ7kNvwEKS4bV&_nc_oc=AdqfC-Giv-n-1E-y5R3e08YTB57fOVCzg14KQToyPEIzUW2d2vJWsOdwyI5rnAdbcsg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID0ln8JZPbhvsHomelNkjH2ZFC_ktpSaX3yJYLTyA1Ww&oe=6AA6B19C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
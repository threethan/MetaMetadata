64.5771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8fgVcnl_qAQ7kNvwFyBq0u&_nc_oc=Adr2iL_yV_dtUrd9Qg9VG1hRZ2Llqtf9zK-8n-bIdTaegDajwtJkFrZ0r8RjFA1Wi4Q&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xn9UVeL5Vz91l9-0UcspjuLOVvS6v_JKHwoQUg5BB0A&oe=6A467FE2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pv2cQZedGWMQ7kNvwG2gVtp&_nc_oc=AdqMK1PGMTEQRSR6e97mmO0Yzq69H2rfDPGAcXWdnlL6iWadFZech4gRuc1y6Rx5bII&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SKDb86W8sKrku9Hu0fMh-8nZA9IUFraQnnTO4_w0pig&oe=6A46704B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-cFn-riheIQ7kNvwGu7WUF&_nc_oc=AdrWD8YAHHfTMNWGq6K0QQUFO4rGK3JD2evyM_QttWyGYGp0uDxnraTnmg3HxMeKZCE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YL9JtZRXqaFAz7WtH85vMSUjap_2bAwLVGkkmF00YQw&oe=6A46737D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3w7hlrO-WwQ7kNvwFm8LJz&_nc_oc=AdrXTKxO4o7yQ8hl0k32kteTN8oYyB8ZrM6loAv--If0CNG10Xri4JpzMEED94S7RHw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NLcg-0wmwXBP5KCzi5KO9qnAKT8WC1cQVfa3NIWx6Mw&oe=6A46717F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9rxpb5UvN4Q7kNvwG_tQ6n&_nc_oc=Ado2w52WH9S52ar-iuQJdvUcVfCad1n96Q_1jFeRmytZ50abgQp8SGApB8wmiWhy2-U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SobNE6lz0enEPZ4B0hbNVpz7g2gfgLEzh-kjBmfdATg&oe=6A46741C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzfKufsEL-gQ7kNvwE1ZD7y&_nc_oc=AdoRo_mVwZcvu8WXJTtGX1ZtAerBlaqmo2dTfiN1G4BQcXzVEWBkLBHBkbX9KYNp6fU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKnpBvkfWHOKCQ-hs5rmsuL2iFX6YWggqNZW9Jr55TQg&oe=6AAAB1E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yDJkDtSx84Q7kNvwHtubOl&_nc_oc=AdqUQ9Hondo5TkinPp6gTsRGLEAjoGw2tEyzDKExUIarglekCF0akQH4aShYctQd62w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWmUOyKGco0ahT-Wtanle0ZnUK_mgWyiPDoiljMeU66w&oe=6AAAA24B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGbrGskeyAcQ7kNvwHm0KkX&_nc_oc=AdpMg1DYzZms1BGeu_dM4rcT-NQ8NKGPr4m6SX2yAi26cG6F3VDvtVUQzzemhCKDbCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKto7SBIGCYtPJ03gUzmHgHrGRitFf_e9WGvcPcNaUFlw&oe=6AAAA57D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVuCsw9E9FMQ7kNvwEu0YEI&_nc_oc=Adqhr7B95JHz2yDVuggx7uUyhDZ0ygNGs6foL6vi-1O6s5BJ7PXeqj2CLDR1BQkCQ-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbwypvSTfwANupVXlEnlETvqpHG73gfOQrAJghhxPhpA&oe=6AAAA37F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFfoKS1STPMQ7kNvwEqHn3S&_nc_oc=AdoyGIJaYeDdmrQKCrFM9sKGydf3zVt3RJljXyQCy-O-G9WghFU3R0uuh8qTEJ1PcKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB8MKOIzYrzFXSbhWlf5cy1uwgod-WY1SwxzeawKcb4A&oe=6AAAA61C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
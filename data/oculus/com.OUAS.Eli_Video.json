_nc_oc=AdrGj39rUPY0j_BoGM3H1dVITcIXH8M0tLPjey9SgcPvuAeGlQQDUb7lCw73E7x1SIg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ234Z74fQGGdrb7wgU8Senu1nzu7Eg0TyW9BRrcW58dA&oe=6A9D82E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUCOGjUkeWoQ7kNvwEO3PUf&_nc_oc=AdrJeR0ZwxWDG56V0cbnndxyFhHN3Du6ytqshwP7roWUgtSaVfQ1ezGIIOj0NAIGsgM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtPdHfzeXdaBkdqLgMNEQEQE4LLcbKAuyG-pV1hD216g&oe=6A9D734B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gb9h6Q111AEQ7kNvwEzQcNg&_nc_oc=AdqUVHrTMWMhTU2W9s0rlffgD1yAORxqffRo_i6MS1nnbTATfh_I2-n2vm9fP6kObP0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr9MbN7o8Ow8J3tZfV6RkugWpi0uugrzRBPHNRH-zjdg&oe=6A9D767D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRJGR3rPOacQ7kNvwFjj0rd&_nc_oc=AdpSlxTI0_u8qNQk7odKWTkOlcXP1iSNS6_etGML0V2zfqzDLTWQgb2csVrd0X2CNG8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYxPjBbEc20A-wL61YP19qj6EZq3OhU7FjOnzXXgRUwg&oe=6A9D747F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWXcVoVC0rYQ7kNvwHPwtIq&_nc_oc=Adr7LuCvYNYzVkisWyZrIXCOmAlO-skAnRwg1B_FxTo_6Wwt_0iiy3rIeoTvi2kJB-s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGAiaslp8PXLNBjnzY_IoKipq56d-6EQ3FmJKkyBL_tQ&oe=6A9D771C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "268496269
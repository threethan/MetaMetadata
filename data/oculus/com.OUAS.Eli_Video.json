771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rdKuqkKYDIQ7kNvwFH0nzr&_nc_oc=AdqMpinP77gOz_DoGaw7dXHtYKozOPNvDIqzN2QIuU6-SUO-FAh76RnhQHz32kEEaN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Mo9y5f7WdeOVf951zVkLN7ipK6RySTlmTlZlmlDZcsw&oe=6A1466E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlocCUHEBD4Q7kNvwE902Ue&_nc_oc=Adr0sMChx-6x1gok-G8_T3ncpQhV-6qOEe_a7KqaMNi9nYo2rTYz-n14_xIJknvKcxk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53vICTaC03WJkr70rykXIFiC4GfjFRAzrPiEU6ZghruQ&oe=6A14574B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUVjAClEyusQ7kNvwFJNP3y&_nc_oc=AdpoJ8Q4Bm7AIQhCwWVkFUw5opn0XseH7jpjz9wTaTTEzj-sgBI2GLXTQpFIB7HqhVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mJFwb_9cG_pdLcWNuDrwV4vySTL_R9iIUJdxHI_07Ag&oe=6A145A7D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV3ZuGm3VtYQ7kNvwHeuaJ3&_nc_oc=Adr0N7sl7OX2vUMVZaQbQZ-Fu0lwro2qA8jJInv1VBwOTodCkNiSOIOWWREcBABzwkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4flXEHdcuW9b17MPYdXCK6R5V09SQWJsHaCtkWMSMebQ&oe=6A14587F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juVdVkC9T6MQ7kNvwGLyBLZ&_nc_oc=AdrF_eotcxhu9V83np-17ABhc_GEmK1cpCQa4j9KMVybIaB2G1Gr8flknOgepTzaii4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Vevs_E1Sfph2ym4EOQ--pvJvwxYtEJs_imzOV_x20yA&oe=6A145B1C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
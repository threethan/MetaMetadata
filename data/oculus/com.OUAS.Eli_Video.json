64.5771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnvHhK_FniwQ7kNvwH3j9-o&_nc_oc=Adps5fgRrgT-hgmxBZ6_NFSOtzao7esZ1kIqk-iFz_1KojA00S4gaNJoacqKLRqYoFs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-f2u07kKqcY2N1M4vjmb0sqzuVJB8s8shA_A6W_MNO4A&oe=6A3950E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNZmfg9QamgQ7kNvwHXeGvC&_nc_oc=AdptXqOy6ZXQYgd0MqmyXnFlWOCMyKPfC9q5yEZUcBBpRgVb_OJtP3qpIEP5kPDlWXc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x-jOY4mkzEZhRI9f6SQiida1l63HhqGQ5Ij1eDbVpUQ&oe=6A39414B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bkzl8shCgnIQ7kNvwGsz8xO&_nc_oc=AdrpBhYid-lRyEzGHQbg0a4_Z6fKYlV87ilxgbJqCTacrCevx37TDL7WdeYUt4km5B4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90UPqu0TwITU1AA3HFIeJdUcDzYinp9xNwyBgUymv3KA&oe=6A39447D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lvy-LeY6_oQ7kNvwHL6S_D&_nc_oc=AdofljWK6aPDECH1pkXCzE6nA6Y1ePekcJbNw5wJjFgnwcdM7F2s-RJfdoxpkpvWEdQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sJ2v1FiL3SN9jzZXH5yClzq7CX0ye1eTO6Q1MSj2fYA&oe=6A39427F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8xi6MZtHRAQ7kNvwEvn4R6&_nc_oc=AdrmGEWdbO2pyWYDiTT-M75G2aOLvDCI12hR6n0JvlGgSpTQzZTFsm8IzxjUV_tfslc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83b0zEMBsqYNGyJFExcFx-QMyRB2dajTv-H1c_Rw4VNQ&oe=6A39451C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pl
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAfTGkfv1LUQ7kNvwF2zgYZ&_nc_oc=Adp0Qy30npQtA3bHafmWC2yksazawAVcm9xdOksHyx2gXXrF7HEixkN1HC85NJJAgtc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZvMDB77BMTky0ghJurswHSzwkE1LjmriMYVHDvgYUWg&oe=6A1AFE62"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQIA2fTUEzMQ7kNvwGxcVCD&_nc_oc=AdrLGi7eLAmF_74Up-UkSt-VjsiVSJxqNLSHtnpSjXVDy4fkiquRzi8ujLYA7ljVxpQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yVsTqzYH4mCq0UH5JSxEqgECqdR1XONoPFO2st_KnPQ&oe=6A1AEECB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvSjHMjfNTcQ7kNvwFesa7I&_nc_oc=Adp9a0yJQPX4s26kWQDGUpIBkZLWt3mvD9NzJhNUGVRKEy3GmUDhFZGQkFk-4nPlDSE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u8VPZWn_5xv7TFzKVn3i1uyhtCT1bJevbrUP2homrGA&oe=6A1AF1FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykZjC9Sv_vsQ7kNvwE-oKTh&_nc_oc=AdqbsU85IVrMc-ve221J1Lywzb4DEjkoc-a5934K9AodCDIqOPXk9cv9B_vq4SSX-zU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FXJvLYX-6uSEaCuay-fnDfBG_jjxM59f_xmHYKLiZFQ&oe=6A1AEFFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jTvTwIUR_MQ7kNvwE1jiG0&_nc_oc=AdqoXtt1mJy-UmefekMwlXdNhWjd353yoUUiOI-ysJFgcbX6gIeISp4xr911y4tSwdo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fK05laMlO3GLpRnkW3_ql5tPy-SoYGS99MvbXW70mxw&oe=6A1AF29C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DzgOeIfEVgQ7kNvwEWX3pu&_nc_oc=Adq1MTzzoV3A0UCnguGa6RkJpgkf7M86EaKh78YSnmNrVCGWml6x6_ItYc7Hdi_KZnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W1AftTq4Z867LtjdlwqvCrD1B3ll4rw0cFYhTvSw_WA&oe=6A3FE862"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mifo73Lj3nUQ7kNvwFwSXrs&_nc_oc=Adrcg5S4NoJarVyE84OdPnpRlC1vewlwkit7jZntN02J5yO9AHxqtluAD9dl4QPTwuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KMU6PBcDG4cVehYzFMQM0Q1nweIaVqvR9JbKr0qY2fw&oe=6A3FD8CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mACTLcm2N-MQ7kNvwF17q-P&_nc_oc=Adryjj70S37chKDOLXyO6oEIEvF9i7g5LIHfjHTKVRDfWz5XhWtHZcjGVKdvdpGZaz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83Gvj7XIIIIP3g0npEqXw3s8X3V5n-q9Jl-N72M_Enjg&oe=6A3FDBFD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fw54u4Yd1M8Q7kNvwEVNlnS&_nc_oc=AdpauvdJSSqQMp4DQB1-aIC6gmL-VJQDwTPuwo5rhvMYz1a9T4aBnuALr1HzO66cPbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83tz4tXSgODNTduiYGrGWljpUdnXqeNUF2hbeAd3Uk0w&oe=6A3FD9FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiktSs-X4uIQ7kNvwFe_33T&_nc_oc=AdrhUdQcUAmoeV43rh49mi675Rt-MRhUARFLeOuRDUzA1d0G8bn752stDcZ85-GuB4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5WxTTYWd8NxM9nnVUdi7U2s7w1kamneRp4PjTsLEChw&oe=6A3FDC9C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
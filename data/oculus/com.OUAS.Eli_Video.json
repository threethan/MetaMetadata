771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVTj5WMXVNUQ7kNvwGPQsQK&_nc_oc=AdorfnzN780QUm16pY_SCPzEJcoH10OorzvjmoaKYPgNXryCRGvGOqI2eTQR2IV_r_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI9UiPNEJMWB7HskFyOtfeTxcFWDX8rCC-wqe5sGBUzA&oe=6AC11B62"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlLomfKzlvYQ7kNvwHPkWuH&_nc_oc=AdpU95HCnu8N9v9SB3fVGLtTMpwyBmjhQiRCcf27SMCMZPE2cJ-JJ7g8BEgdGn_fsE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmka9yXzkQhwGmCoC8vh6QbVwa5TjHTwq7xQnQoQyGBQ&oe=6AC10BCB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3ajf_NFe0EQ7kNvwHS3gne&_nc_oc=AdqaKQvPkct75cGVjAucLgMMFesUl7UH73Qr6gntFiz3ItZ8tdzJ_HQN5l0J57fFLb4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmro8Fg8gwlq9ktA3vIuLxl29Cc2bqGzPxyGWOH0isAA&oe=6AC10EFD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijKMx2_MbA4Q7kNvwExYSJ8&_nc_oc=AdrzcbKLrUIVDZXx3pO-JYSyxtZhAE3ejBmzIDiK29Z7BuLHIFUZ8bnJLO6aBXrlXzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqp79j8msRlgVP16nr4RgpJTVUhqdSswMy8uQkEn9f8g&oe=6AC10CFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwMP5NPsp0YQ7kNvwGVaWCe&_nc_oc=Adp7l3nxDCUW7IMHbD4sl2MBxQAgWpzSCYMpMRim4mKWbRJeK1CgUd7i47gGjX7Z68o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOp52ggFT5ApzfrPsI3KkR4115rBns5c2Zc_k2kmJWB4Q&oe=6AC10F9C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
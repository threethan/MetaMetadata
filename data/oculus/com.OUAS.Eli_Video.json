771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViZm2eeUqG0Q7kNvwGLtGWc&_nc_oc=Adobsv6Pugae50cf_uPa5jXlDTlFZyN-xkPG6jTTi8H-WBntj3J6kOiljpbw1Ep9ncE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM83ArpzT14_aahnMojZmKw3COlHQkICGPfhTsBLVEWhw&oe=6ACBA762"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MGSBJklpI0Q7kNvwGA2Z_g&_nc_oc=AdqP8bwPDuOAJ8JdAtD8a0Y9cFaCsUVb5FlDdlv42K-WIuzB5NKWg6IiP3dEDwSBA2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSjhcPupaF8NQ9BmRVhREBnhWQ0APYAVbLYr8E5tJ8fA&oe=6ACB97CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-LJt-LmwXIQ7kNvwE30e2Q&_nc_oc=AdqbaVKE8G3sfieHTw-dR9O2mtn_BoqVM-oUO1WGEmZ8iaKIK9ERG-uj7IQzgDFEMJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2MjoIbHR3UwUxCMniDfEicb56ic5gwL1ii7XLTdLfNw&oe=6ACB9AFD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-rwiZ45yv4Q7kNvwFOQrTy&_nc_oc=AdqZmirq5IKmoj_NgeTW4O4DnQ-C7LHnFzUW6HTgEvaPzN-IgTVeIhTneVxjfc4TUKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKDkcoyVUxLB7f_eYXKfP0MjahuOEFW_QIr26UeWz5yw&oe=6ACB98FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raUHgv4djWUQ7kNvwGbdemF&_nc_oc=Adri_PxCfB88Yg-GkzHHys6b7lGoLvRJLbL3-9ZStkYWmr_Go10UVwxUo-P0WaHZGZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHPgCLDY0eP7W5wVGUY2NaJZaa_icyDJ4dg40K6XxR8g&oe=6ACB9B9C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
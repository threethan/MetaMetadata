771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upIn-40wHboQ7kNvwFkem2r&_nc_oc=AdqvHPtk5gUPccIl_y_eyow7qzJ17FyviHqq8xAdiRtSoeIQtHT0X2dmqEkY-rSIAVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFI_t1pFBAHOGthj2LumLOhAAocKYlrkL_-72J-VSo-w&oe=6A5CB122"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOJ6uh_kATgQ7kNvwH14h8V&_nc_oc=AdrsJDyq3sJNUIqPg-ZaVx3yIm3LMSuljuerPJEb4IP8Bt8n-pVoGCKseDufs_uH3k0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNGqWvuKOFNnZh6Z_Bde65ppKOCfOoipj79Q57TMJjbg&oe=6A5CD9CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ2OtlPI1j4Q7kNvwG_IYWp&_nc_oc=AdqXy7KCp7MBioo34tf89unPvApzXN1IVHIEvnrbE8wGRQs7ezpV-qszGqJWV4ISx0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBctULurUco6rIAOHip-1O-BtJXdqc54M1YyCePoFifvw&oe=6A5CDCFD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6q4eo__GOUQ7kNvwHgXQs2&_nc_oc=AdpR0rK3xJJLeXzE4tZB4_a2ZFBsJyAdyUACfUNktzEah9apGB5hpkYrVfJlymcFXcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJk0Va6BuF5k_11tmMgeXe6u7c-c9ePqhr3LksL-uTtw&oe=6A5CDAFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B72IcLHrYjoQ7kNvwEH2xhn&_nc_oc=AdruBAK7wS5EEyhmVWw7USNXHvEH2tv-iiRk42CZnGyU0ThLT8bfygvoHxX2wMWuUWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbEi4Cm5aebQti-tieKzRCzBvy-hUcGmtmRRHJZ2pvJA&oe=6A5CDD9C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
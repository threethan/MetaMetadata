771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2whWXV_n1pAQ7kNvwHegKQe&_nc_oc=Adpt5d_eYNjaaaUHVCJzb6YJD1NltJ7MPtxKaZoK1D3TThVwH7RXipZ6cj1UEibypSE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42bBEnF49i07dnTQoKrHldjDpp5ZulBTIAffwPuVRQTQ&oe=6A131562"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlocCUHEBD4Q7kNvwHPsdRp&_nc_oc=AdrnudvjzbYF0d2XHO22WOt3o_JlJdQEoFpy4lYLpLj9et8Mx2yHAPvz5p1h1nPPEng&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yEIVQ68Uy6I7z7p1hSPRpomAGk_bpHBZl5B2H84YpUA&oe=6A1305CB"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83aV9O1KV1UQ7kNvwEoksAR&_nc_oc=Adqt_xxq0aKv8sdCVGLLNjfqKOvfRErnOSs457zkRamWEPOyWF4B_ZaI-OfG8TnL5qM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4umNbR7iiZqQzVNqGkwzmGWLUKAlUMtPOyaXc45uMiUA&oe=6A1308FD"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6p80LpnLkIQ7kNvwEoFEeN&_nc_oc=Adpa0tGx0Bhszt7I6nKHV6LsSBeI9-8-XUHYe_tuzLsYZUoaoZyOq1IqUEo3WU8CXdg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79D1aA18U4E3UNWst8egrMjnUOa2xZw5Yb1Pov6vPDVw&oe=6A1306FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juVdVkC9T6MQ7kNvwGkFRX2&_nc_oc=Adps9NM4z0IsB7hqReyZUtX_m5h6quDKX0Zkz0N_oKlJBsBxHG8hzhwqMWos0MrY_LM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Et-3DXQ9qCi1uGhnD43MhBX7_Pwo40cYS2_77-VSEWw&oe=6A13099C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
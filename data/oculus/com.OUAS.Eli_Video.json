771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGGzZ7hD-tcQ7kNvwGVX9wm&_nc_oc=Adq38fQ66yXN9Jd3uGk1q4CRI5Fzmov0rsMxLCIg9Wmtxh7nD11GCAu2vI9p89bng90&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaqQFQtCPZzOVKDe2WnudWU1l_rLDvrH1N4UeoqZBFaA&oe=6AC26CE2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlLomfKzlvYQ7kNvwH0pUHA&_nc_oc=AdpxqZo3wz3Cwb77NtHC-tHA7vY7uLJ-d3Hx1aFm71Q461wS5aqP7zu_Q2TSQYE7VPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ3Bl4KoLljMHQKi1C4_zxAGfFe27yI5-MSkm4F7pvXA&oe=6AC25D4B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeGNeJlRGtsQ7kNvwEJ1aLZ&_nc_oc=Adopk9WwWiMPgh8e2YjqQzPwgFGL1Z3BUoMniPkFspF5F9ES4gGNhMBoAhieXkHBqEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaFvPAYHsj4zaezaEFzB1FBAC9KQFlG6UIvkAUPWWbTQ&oe=6AC2607D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwqjlMy7IRQQ7kNvwGCsMif&_nc_oc=AdriOc3wE7r7I1NyhJbixyPl4kZV-fQSuN2uBbbdE4hxnpwbfYiOn1L5tMrYG_FSdso&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy3v7zB4l72jR8w7ofXM1Ip_vNrTUBz7vbmkbe20O-dQ&oe=6AC25E7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwMP5NPsp0YQ7kNvwGhALD5&_nc_oc=AdrnNf4D2Sbsk8jSw0qHEv1F3za2lCIATHHD5g1o1Ov8T9kIGhI3bv95zVEZfcfTVyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcW4u60x004BfH2mPpHoHg-AJXuj8LGj5BOjaH4Eo-jQ&oe=6AC2611C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3sTGq6JbfQQ7kNvwFkIZ2V&_nc_oc=AdolxTmRQqN0FhWH6Z7CkXXJEc5oEBu_9br29j0RwzXCvSCkC9i9Ihr2Fct9q7zHjk0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xrevDjsTAaMDFRor88lh_7XKog_fv_hd1rZeiXpmKQA&oe=6A297EE2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQ7oCPm99pwQ7kNvwFO1qnP&_nc_oc=AdpYuElhMEORsfV2DzKEYABiZynKMTyMl-atWjBUoQxu07JwAGVcioVPbOPNDnlhJHI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PBTOglnMc4j8Mqfr1B4ZSvSXIJ0Q7gSWLa5_Cg_J3RA&oe=6A296F4B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3IAYMCOywMQ7kNvwF8zrK5&_nc_oc=AdruvDFmBtD9CvIzIAuFMhk2oL1cDtuuqSY-zxOYjHXCI9PnIa7X2gqmvywrUUCtops&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Oc_m3bKW9QuGgn90-SeL3WhQaQG3RqHlJwiPURMC-ug&oe=6A29727D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdW2Dw4jOB8Q7kNvwGKEHVK&_nc_oc=Adoph3kqURXRyJRtlO18f-VPs7XXzc_IMQm41RtGvCQzCkHwfW_1nihGNrc192VwJ9U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sr60Z96WlplA7ab_c_d4IYfBLrvkDqNa1pswXb9TWpA&oe=6A29707F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2Nb4-LfkhsQ7kNvwEga-Mw&_nc_oc=Adrv6axsg0gIye2WbUSWj85M6pvH0R9f5rXXZc3_XUM0Kfhl-DDgOdywhi5kJOrc2pw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tsabn3NRKB0pjUKgLAPfW4-VFdjXoROwZUKCQmQ5t_w&oe=6A29731C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
771-25/39031532_690597441908888_7729672314162681071_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atamgZNCbYwQ7kNvwEm-eBI&_nc_oc=Adr3kxlFF-XUH3lTA7-uA2Kw5PQ_xvxvWgDPjGd24-_32P9eYFXU164bIKXf9zgtOgc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gHkcCq9gFU-p8Ss6F7LXuaelMvM8yNTPkJ5GQE6AAGA&oe=6A2195E2"}, {"file_name": "Shot2.png", "id": "2413922882072083", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031532_2413922885405416_5375032612976288373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGpwTn-2qy4Q7kNvwEMoDs7&_nc_oc=AdpmNomhf3YRyFXMdcylVYA-ruTSzM2ZAUb7gvLHsR2GmbGgWzOPqOkxegb-8t6FAkY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_i7pLfHFJqDhV5n0cBvV0SF5wTwpB_03ju8J3aO4eQ1Q&oe=6A21864B"}, {"file_name": "Shot3.png", "id": "1074668270025440", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974504_1074668273358773_8502574131406873418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PJpwtXOrTAQ7kNvwHz2Xde&_nc_oc=AdrDk1pH5_abKiOV1TWUdLH6WlTaQEpa2ftI1325kCqqz0tBIt9kVYSsOvYO-2wY7-I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gx86RAMhQmdkrWt7AsCEixg42vffl1EV-TUW_YA6o8g&oe=6A21897D"}, {"file_name": "Shot4.png", "id": "587633365637564", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75234364_587633368970897_3367106121711931455_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8JykV4iQuYQ7kNvwH-rdxU&_nc_oc=Adod3YE5Ozal7zbGjd9IKUaG-e81fhrLxHS5OwR50AiYXZbxKCSRRAdZ-W5jmnVKozo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jvknWoYYxwr8fope-hDd7IbwDLCuyQlUomakBY34q5g&oe=6A21877F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "276525354504752", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031532_276525357838085_6991066571000915733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlPQGknN5UsQ7kNvwGKT6yK&_nc_oc=AdpKIrUemhABf9XnjsavQE_WNQQBfBu9nZn24T_6FeCt74Dw9iIc5f7fm-8ScXTxUz0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GBOS87rvfS2wbE53k8eIGS-1MaXyIWIDasvRU2JQ1fw&oe=6A218A1C"}, "display_name": "Once Upon a Sea - Eli Raz - The Prophet", "keywords": ["Environmental"], "long_description": "\u201cFor millennia, the Jordan River flowed into the Dead Sea undisturbed. Today the Jordan River is a polluted trickle. Industry and mining drain the lowest place on Earth\u2019s water even more. The Dead Sea decline is triggering a catastrophic movement of underground water. As it moves it dissolves deposits under the region\u2019s shores, leaving behind an ever-growing network of dangerous sinkholes.\"", "short_description": "Once Upon a Sea\u2014Eli Raz\u2014The Prophet offers a stark educational journey into the environmental crisis facing the Dead Sea. You'll explore the region's geological history and understand the devastating impact of industrialization and over-extraction on the Jordan River, which is now a mere trickle. The core gameplay involves navigating the landscape to witness firsthand the consequences of receding water levels, including the proliferation of dangerous sinkholes along the shores. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://blimey.tv/privacy", "developer_terms_of_service_url": null, "publisher_name": "Blimey", "support_website_url": null, "website_url": "http://blimey.tv/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
022988194152164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1022988197485497_448957098194233682_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcvtUQ_ELqAQ7kNvwHJ6Xq6&_nc_oc=Adof7Eq_olGcsi5swq7xcvedMEKrzBxx1vbroRyWGvI0D1cqRecw7SBWndRF3unsaEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTeUbIvoubAqMjmItm6G8FGhtZ-abZYEN1BpTOsd02kkg&oe=6B0C7BDF"}, {"file_name": "shot-1-cockpit-hoops.png", "id": "3510270419182245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_3510270422515578_7013435355532164855_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPckiIL2wIoQ7kNvwE7h4V7&_nc_oc=AdoawyadidFg_jhqTFBcF57gmoawo2CmaikOwmucw09NwVOV8TjO3QWzjkEHY_00s80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTF9zrFxihq2d1bpiONx_XCIeytogjSTImXakEH798cQQ&oe=6B0C4B5E"}, {"file_name": "shot-4-table-cleared.png", "id": "1588740052539988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_1588740065873320_3362043578396110672_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVOQcQvlOlUQ7kNvwFyXGk4&_nc_oc=AdoPtN4vk1jNp_flkClx9_LcyWJSZxKRKfQzp64WQQu6QhdaeWcE7DUMhesCh7Z9S9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRdSo7ElFIWrtM_BNCjZ4ItfUJ1W9p66FKi6WD8KVTAoQ&oe=6B0C69D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-2560x1440.png", "id": "1549164096962165", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_1549164100295498_3242036792273529955_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeTMh8wyyjgQ7kNvwECVGhT&_nc_oc=Adr2j8nIsrFiSMXALTqeu0SVcdn6J81oDJ6dFIlDw7lP7MfF3ClCHF8HFLsS0lHEQz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4E_r-uSxlVu9MwUPV88Zu43gAnFSIumFVHAZ6cVq63A&oe=6B0C51D2"}, "display_name": "Aether Rush", "keywords": ["aether", "pilot", "racing", "shooter", "arcade"], "long_description": "You are the pilot. Sit in the cockpit of THE DART (or switch to a chase view) and fly a kilometres-long table that rolls out\nahead of you in porcelain white, electric blue and gold.\n\nTHE RUN. A short interactive training, then five zones that each add an idea: bumpers, target banks and R-U-S-H lanes;\ndrones that shoot back; forked roads; the gauntlet; and the boss with six hull points before the finish line. Two AI rivals\nrace the same road, so every run ends with a rank.\n\nTHE LANGUAGE. Gold is bonus: lumens, target panels, crowns, the finish. Blue is speed: hoops, boost pads, ramps, sky gates.\nCoral is hazard: pits, spikes, drones. Nothing has to be explained twice.\n\nTHE SCORE. Multiplier from bank clears and lit lanes, a visible hit chain, near-miss bonuses for passing hazards close,\nzone and finish bonuses. Stars per speed preset (reach zone 3, clear the table, clear it with the boss down and P1) unlock\nthe Glacier and Linen looks and the Ace trim. Best scores are kept.\n\nCOMFORT. The horizon never rolls; the camera rides the craft through smooth filters with a vignette on acceleration; three\nspeed presets (Calm, Standard, Rush); optional snap turn and always-on vignette; a 3-2-1 countdown and a pause menu with\nrestart. Reactive synth music that opens up with speed. Single player, offline, no accounts, no data collection.\n", "short_description": "Pilot a white dart down the Lumen Table: a bright, airy pinball race track in the sky. Five zones, speed hoops, ramp jumps,\ndrones to shoot, two rivals to beat and a boss before the finish line. Chain hits, risk near misses, earn stars and unlock\nnew looks. Seated, comfortable, 72 FPS.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/aether-rush/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/aether-rush/terms.html", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/aether-rush/suppo
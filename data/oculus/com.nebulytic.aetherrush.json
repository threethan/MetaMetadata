022988194152164", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1022988197485497_448957098194233682_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LpQvfgH3CIQ7kNvwGWrIkj&_nc_oc=AdpPaO5_UK4nlt9FrQvDK18fRqxwHA81Uj5GG8p6_fqNdMGwcfKVyDk75qy6yewJqkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU74BNkZ-Zh6WPhctcJ9fZTVAj-ESUuxvd_jpQzBeKGLQ&oe=6B0F1EDF"}, {"file_name": "shot-1-cockpit-hoops.png", "id": "3510270419182245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_3510270422515578_7013435355532164855_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPckiIL2wIoQ7kNvwFoDihD&_nc_oc=AdrS5MfDdS-Q91JGQ-ORM4jKePiLsAo4zgdv4ELJMql75V0_IKSn2IxAGxbxliGvpIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWgJ_1kqLWVXpFbGNT8cwJ_1I8hbPbzgJ10DKJf2LV19g&oe=6B0EEE5E"}, {"file_name": "shot-4-table-cleared.png", "id": "1588740052539988", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_1588740065873320_3362043578396110672_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpGgH3gtN4gQ7kNvwGb-Tp3&_nc_oc=Adqzk1AYVFTvMaRdKzbtVXIy4uJD3EsRuR-jzHDGn3W9qBP6AoAxHc7VZzCiyNriR5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXmIE7AFpPPQSKKnuiKxS2HLLb_kyC5LOnpVZO7OMPfRg&oe=6B0F0CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape-2560x1440.png", "id": "1549164096962165", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_1549164100295498_3242036792273529955_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeTMh8wyyjgQ7kNvwHqOd9k&_nc_oc=AdoxrKH17lDRGqfkUhQQUx59mOwrXKMw1xDLL5Ie4XHoN4DDtx18ekDjxRZjmIKRIMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXOyiRittj8YCITJmO0V370SGm2At2g_EgDpJCJPBybBA&oe=6B0EF4D2"}, "display_name": "Aether Rush", "keywords": ["aether", "pilot", "racing", "shooter", "arcade"], "long_description": "You are the pilot. Sit in the cockpit of THE DART (or switch to a chase view) and fly a kilometres-long table that rolls out\nahead of you in porcelain white, electric blue and gold.\n\nTHE RUN. A short interactive training, then five zones that each add an idea: bumpers, target banks and R-U-S-H lanes;\ndrones that shoot back; forked roads; the gauntlet; and the boss with six hull points before the finish line. Two AI rivals\nrace the same road, so every run ends with a rank.\n\nTHE LANGUAGE. Gold is bonus: lumens, target panels, crowns, the finish. Blue is speed: hoops, boost pads, ramps, sky gates.\nCoral is hazard: pits, spikes, drones. Nothing has to be explained twice.\n\nTHE SCORE. Multiplier from bank clears and lit lanes, a visible hit chain, near-miss bonuses for passing hazards close,\nzone and finish bonuses. Stars per speed preset (reach zone 3, clear the table, clear it with the boss down and P1) unlock\nthe Glacier and Linen looks and the Ace trim. Best scores are kept.\n\nCOMFORT. The horizon never rolls; the camera rides the craft through smooth filters with a vignette on acceleration; three\nspeed presets (Calm, Standard, Rush); optional snap turn and always-on vignette; a 3-2-1 countdown and a pause menu with\nrestart. Reactive synth music that opens up with speed. Single player, offline, no accounts, no data collection.\n", "short_description": "Pilot a white dart down the Lumen Table: a bright, airy pinball race track in the sky. Five zones, speed hoops, ramp jumps,\ndrones to shoot, two rivals to beat and a boss before the finish line. Chain hits, risk near misses, earn stars and unlock\nnew looks. Seated, comfortable, 72 FPS.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/aether-rush/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/aether-rush/terms.html", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/aether-rush/suppo
96Y2ER1cw&oe=6AF5D792"}, {"file_name": "Screenshot_v1.2_SinkOrSwing.png", "id": "1449711233325549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1449711236658882_5780587047701120746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujcH9K4OyEIQ7kNvwGoIkP-&_nc_oc=AdrFi_TQ_0AvIDznA2uudbif_e8gMSN73XA7jFU67GMOFBZOieM6-Wojj6PWm7Qojh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRdu8PsrwngvKfUwwIi9DSEqNg54-jWgHlZQeTGZQsnQ&oe=6AF5C05C"}, {"file_name": "Screenshot_DinosaurFight.png", "id": "24035588319445976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24035588329445975_1902468389789138026_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hc4QdFAzO9EQ7kNvwHid2zq&_nc_oc=AdpH87SJhzRW3eZDsZxq-AVuk9gloOQVhzTQTaYRVF9VMyWYqzYCAoZe1fMCcD9OH0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKuGZKf9pREIZKY7LUfNMEuK85m3icJy9LdvczbP_SEA&oe=6AF5F003"}, {"file_name": "Screenshot_MysteryBox.png", "id": "1460281521953497", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307413_1460281525286830_4551044826683119470_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJaMLDT9YnsQ7kNvwF4Fl1l&_nc_oc=Adp35roAATL9FxpsGfrA-jcsV-oTuUtbh4Ne2_-cuyVHafjIN_HwmPyOsB2lHhpL-HQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7nSwc5tXuVNXclceexoK2RtZ3Ii1DDNttMXYCgFJE4Q&oe=6AF5E421"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_8.png", "id": "1997194977535539", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_1997194980868872_163954643928721285_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYxGzZwmwpAQ7kNvwENnOdJ&_nc_oc=AdobTbC2x8zh1c-UDRbRU92DmfAZ4SdhmJzu5Ih17Dv4jvDTl3CYzrr9MUBSk5c_q-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkOZuBjZqBFrsxGuO0765ZlcUyebui-qlA4OrUgMupqg&oe=6AF5E25A"}, "display_name": "Spatial Web Shooter", "keywords": ["spider", "superhero", "superpower", "simulator", "physics"], "long_description": "**Spatial Web Shooter** brings your superpower dreams to life with creative mixed reality interactions and exciting challenges.\n\n# Free Play mode\nIn this mode, you can freely shoot webs across your space.\n{1842242750054347}\nWatching them wrap around your environment is deeply satisfying, but that's just the beginning.\n\nPlace **fun, interactive props** like doors, chairs, or a fridge, then move, swing, or smash them around with your webs. It feels so real, you\u2019ll start believing in your powers.\n{2997543517304777}\n\nThen come the **Reality Enhancement Props** \u2014 a whole new layer of immersion.\n- Put the **Mirror prop** on your real mirror and **see yourself reflected with real-time web effects**. For the first time ever, you can actually see yourself as the web-powered hero.\n{2084031372123948}\n- Place a virtual zone on your kitchen range hood so it absorbs webs.\n{998980768864915}\n\nOr bring a **dinosaur** into your room with a **Super Prop!**\n{1277336690551238}\n\nAnd there\u2019s more \u2014 unleash **Webstorm!** Cross your hands to send a storm of webs across your surroundings.\n{2187976878751875}\n\n# Challenge Modes\nYou\u2019ll start with 3 props unlocked. To get more, take on thrilling challenge modes.\nEarn **Web Points** and redeem them for **Mystery Boxes** \u2014 each one unlocks a surprise prop to use in your space.\n\n**[Sink or Swing]**\n\nTake on **15 skill trials** across varied block challenges, then push your limits in **Infinite Mode**.\n{1266004858789911}\n{1405798324126994}\n**[Dinosaur Fight]**\n{1789510425329065}\n**[Treasure Catch]** **[Web Escape]**\n{3977436725902520}\nTurn your space into a web-powered playground full of creative possibilities!", "short_description": "Spatial Web Shooter lets you shoot webs with your hands and turn your space into a web-powered playground.\n\nPlace fun, interactive props and use your webs to swing, grab, or smash them around.\n\nUnlock more props through challenge modes like Treasure Catch, Web Escape, Dinosaur Fight, or Sink or Swing. With Reality Enhancement props, even real-world objects can react to your webs \u2014 and the Mirror prop lets you see yourself reflected with web effects like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tangochen.github.io/spatialwebshooter/quest/privacy.html", "developer_terms_of_service_url": "https://tangochen.github.io/spatialwebshooter/quest/terms.html", "publisher_name": "TangoChen", "support_website_url": null, "website_url": "https://tangochen.github.io/spatialwebshooter/quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "fr", "ko", "es", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28909097782046039"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825497_2043681839829775_7712984615272888591_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i925nRvNIMAQ7kNvwELN_eE&_nc_oc=AdpJxMP1DujiwwjIFCk-Zm5FNFnwZGkBv7nMzpe1J3c2QhN_TXeqHFP1o3yTovizCFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTipbGD0dQtlOQmMonGZkh4Yyu3coftHgwEIGBt6uOKnw&oe=6AF5F52F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spatial Web Shooter", "platform": "ANDRO
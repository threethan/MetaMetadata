}, "display_name": "Spatial Web Shooter", "keywords": ["simulator", "spider", "physics", "superhero", "superpower"], "long_description": "**Spatial Web Shooter** is all about web shooting \u2014 with tons of unique experiences to bring your superpower dream to life like never before.\n \n\n# Free Play\nIn Free Play, you can freely shoot webs across your space.\n{1842242750054347}\nWatching them wrap around your environment is deeply satisfying \u2014 but that's just the beginning.\n\n\nPlace **fun, interactive props** like doors, chairs, or lamps, and use your webs to move, swing, or smash them around. It feels so real, you\u2019ll start believing in your powers.\n{1973394560139385}\n\n\nThen come the **Reality Enhancement Props** \u2014 a whole new layer of immersion.\n- Place a virtual zone on your kitchen range hood so it absorbs webs.\n{998980768864915}\n- Put one on your real mirror and **see yourself reflected with real-time web effects**. For the first time ever, you can actually see yourself as the web-powered hero.\n{2084031372123948}\n\n# Challenge Modes\nYou\u2019ll start with 3 props unlocked. To get more, take on thrilling challenge modes like **Treasure Catch**, **Web Escape**, or **Dinosaur Fight**.\nEarn **Web Points** and redeem them for **Mystery Boxes** \u2014 each one unlocks a surprise prop to use in your space.\n{3977436725902520}\n{1789510425329065}\n\nWhether you're experimenting, practicing your skills or showing off to friends, Spatial Web Shooter transforms your real world into a dynamic, web-powered playground.", "short_description": "Spatial Web Shooter lets you shoot webs with your hands and turn your space into a web-powered playground.\n\nPlace fun, interactive props and use your webs to swing, grab, or smash them around.\n\nUnlock more props through challenge modes like Treasure Catch, Web Escape, or Dinosaur Fight. With Reality Enhancement props, even real-world objects can react to your webs \u2014 and the Mirror prop lets you see yourself reflected with web effects like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tangochen.github.io/spatialwebshooter/quest/privacy.html", "developer_terms_of_service_url": "https://tangochen.github.io/spatialwebshooter/quest/terms.html", "publisher_name": "TangoChen", "support_website_url": null, "website_url": "http://tangochen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja", "fr", "ko", "es", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8384271051622013"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1438445230693070"}, {"status": "PUBLISHED", "id": "767126095726200"}, {"status": "PUBLISHED", "id": "1115097248145160"}, {"status": "CANCELLED", "id": "1651679162973638"}, {"status": "PUBLISHED", "id": "1703031400831718"}, {"status": "PUBLISHED", "id": "990595913404300"}, {"status": "PUBLISHED", "id": "1100469278227715"}]}, "baseline_offer": {"id": "1100469278227715"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790877600, "status": "PUBLISHED", "id": "1115097248145160"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28916879514601199", "version": "1.3.1"}, "id": "9337235279636683", "channel_name": "LIVE"}]}, "is_for_ocu
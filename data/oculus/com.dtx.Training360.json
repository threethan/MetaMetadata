FKsQ7kNvwH7fXS-&_nc_oc=AdnlCFM4bA6-__QZj1VuJJMOUcaRjJH-yMqYSTOnjUOsHfsGieNPgGP2z612IHwTGaI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft-jHBo347bynRXxtXlD3pgmBM_AaqfQQcdWApbN4c8bg&oe=69A98FD9"}, {"file_name": "04_Manufacturing.png", "id": "485039189609153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974866_485039192942486_8983657717342528058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2VWu7di0X4Q7kNvwFZrmgm&_nc_oc=AdmLbBf-smOmvFYaF20Ap89os2hMd0-4cH4GdsFvVzpCeHQaW16AjJ0xPwiyfJj5YcM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsQ5YoKG-zmva4GINuHondDtWNEyoQ0XqQpKbQFEHXILg&oe=69A98FF3"}, {"file_name": "05_Scaffolding.png", "id": "306583724364500", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001707_306583727697833_5477069484724668049_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uYuRKkdxX4Q7kNvwF9t-Hq&_nc_oc=AdntEzscpQxj3DKjgZUVeqxCjin6DCb6QVENQEHY34Zr9U-ur_TPyADy0OMA_VBDmqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft2UJjyIDlwLuCioRay8wHslHG5FAPPlVCgWn4rdPvJmw&oe=69A96ABD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560 x 1440.png", "id": "1233589303798531", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982500_1233589307131864_891965906717263628_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jUdJxkn_SQQ7kNvwHw3pan&_nc_oc=Adlqd32VgSvIUZgloby-ZojPo5OLqfXRupQOp2Svlbh31OMfIre9Pv-rAStRt_HO9jw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftgjvI1SCNEsQkjc06ydggXWNPX8qwVuBplWu9hhIGqUw&oe=69A9773C"}, "display_name": "Train 360", "keywords": [], "long_description": "The Train360 app was developed by a passionate group of tech enthusiasts, storytellers, and innovators committed to creating immersive training solutions that help save lives.  VR sims help learners move beyond basic safety compliance skills to develop: \n\nVisual literacy & hazard recognition skills: Allow learners the opportunity to develop identification, see past normal working conditions, and then bring that fresh perspective back into their workplace.\n\nSelf-awareness & confidence skills:  Each training simulation is developed to support Total Worker Safety\u2122. Learners that are self-aware, empowered, and skilled in recognizing potential hazards are foundational elements to building a strong company culture.\n\nThe Train360 app is a FREE download. The VR simulations that accompany the Train360 app can only be accessed by entering a 4-6 digit Learning Code associated with the My Virtual Safety Trainer (MVST) eLearning courses. For a FREE TRIAL, go to https://www.360immersive.com/mvst/", "short_description": "The Train 360 app is developed by a team of software nerds, creative geniuses, and safety geeks passionate about eliminating serious injuries and fatalities in the workplace. Traditional safety training is boring and lacks engagement. Try this app in your next safety training class, see how much fun it is to explore your surroundings in VR, and practice what you have learned in the My Virtual Safety Trainer (MVST) courses. To learn more about MVST, visit 360immersive.com/mvst and try it FREE"}]}, "developer_name": null, "developer_privacy_policy_url": "https://360immersive.s3.amazonaws.com/NewLibrarySystemTest/2021_Train%20360%20Privacy%20Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "360 Immersive", "support_website_url": null, "website_url": "https://www.360immersive.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
46517_4267731080747246327_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j9epyFFbcIQ7kNvwE3i2k4&_nc_oc=AdqjSfIXPHqXtdU1nUF5IY9Gud_uoNDaQEUGMa6rB0_4PCPg86Lq7858SurAvqHpROE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQLJFv7LfRSEabZQVQIGWtdsKPC8qblzb4v5gAv0rNFYA&oe=6B0DB8BB"}, {"file_name": "Screenshots_52_2k.png", "id": "1704526940747126", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654985632_1704526944080459_7878588583824358291_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmx-9wvy4EkQ7kNvwFJqzCz&_nc_oc=Adqxh1c9MIznCRiSjlRQweDuQB0vBGghwYn_u891yrO-DxW6gaGaKaaN3Gn8YOVKqjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFywnL7CNr3n8fIljF9I67U940ikf4shXcRZeE8dIR3Q&oe=6B0DAA97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1170900479437913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_1170900482771246_659576753864769615_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5epc090UUPYQ7kNvwF5s46z&_nc_oc=AdoPyxdr-UiJMhsBTr8pVfC0fp3eGRzXu0dToHdb1Avl3mvChtv6CMcT-ZNWhUCyBJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRsBY0GyQQJLo3VroeruO0mOcQtUTOHBvItLZuwnQQMFQ&oe=6B0D9C46"}, "display_name": "My Store VR", "keywords": ["supermarket", "simulator", "multiplayer", "shop", "coop"], "long_description": "\ud83e\udd1d Online Co-op Multiplayer\n\nRun a supermarket together with up to 4 players. Divide tasks, coordinate your work, and grow your business faster as a team. Whether you're stocking shelves, organizing products, or working the checkout, every player contributes to the success of the store.\n\n{996681396414349}\n\n\ud83c\udfea Build & Customize Your Store\n\nCreate the supermarket you've always wanted. Arrange shelves, place furniture, organize products, and redesign your layout whenever you want. Sell unwanted furniture and optimize your store for maximum efficiency.\n\n{1863577045011325}\n\n\ud83d\udce6 Manage Inventory & Grow Your Business\n\nOrder products, fill shelves, adjust prices, and make smart business decisions. Expand your store, increase profits, and transform a small shop into a successful supermarket empire.\n\n{2171501563633349}\n\n\ud83d\udea8 Hire Employees & Stop Shoplifters\n\nHire employees to help manage daily operations and keep your business running smoothly. Stay alert for shoplifters trying to steal products and protect your store before they get away.\n\n{2243351839534230}", "short_description": "Run your own store, solo or with friends! Stock shelves, set prices, buy products and furniture, and expand your shop however you like. Be the cashier, hire workers, or team up online. Build your store your way and watch it grow."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.twinsoftwarestudio.com/privacy-policy/", "developer_terms_of_service_url": "https://www.twinsoftwarestudio.com/terms/", "publisher_name": "Twin Software Studio", "support_website_url": "https://www.twinsoftwarestudio.com/contact/", "website_url": "https://www.twinsoftwarestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "1009165411654050"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"stat
.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oAs1svv9QwBbWqnoKByw5z82wh5vMsb4lYp2U6WQz7w&oe=6A16EFF9"}, {"file_name": "5.png", "id": "955176890416082", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823837_955176900416081_3006611531093752489_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpLc7KDmkPgQ7kNvwHP-Dj_&_nc_oc=AdpAImID47XMTX5_zT-iofaNDzNTT2Crd_AotdgqCRCocix-NBP5YM0o1VC6RXAt71s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yFw3vc0299GdgepQLo_XrbevTuKI-BC9UnV8xejiHZg&oe=6A16E8CC"}, {"file_name": "6.png", "id": "1546817596411693", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821704_1546817599745026_5649730398876791296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUrj9XiXiZkQ7kNvwE__Chp&_nc_oc=Ado_2661-hf5Bd8b0r9pXZFN7cNubfym8wnA5sv9G2MODfAGwfqPYeD6svBScFscTcU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZE2_3cUJGYu74kWbZWQaEkP7UAvExd2I6NzgD2KMs2A&oe=6A16E0B7"}, {"file_name": "4.png", "id": "1557490932422398", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819356_1557490935755731_3626577608583045222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y6oMTIXUzoQ7kNvwEZdGXo&_nc_oc=AdrQhB4FMWrtrZfe32NrhVe9b6VN8bmrIGyRlPaHspnYBCk3iy5HuOwYtqDsTenXvNY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lKN95rZgG6AhiFarNv9n4E5ljHGT6puST_TlbqgigiA&oe=6A16E666"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1222965636683441", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824700_1222965640016774_6922275024395629217_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqkBHDT7288Q7kNvwHuYk0v&_nc_oc=Adpj4TlrLjfUufh64DkyDbm40FZvjE4aXpvzYaKbvBPJj5Pr-7Rt48WMVp_vuCJmJf4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40G0wB3Yf0hSTsxh-ENRJRe-DVGjp-UbnzcHx3M2eJ-g&oe=6A16E794"}, "display_name": "VR Schoool - Atoms", "keywords": ["Education", "Chemistry", "Science", "vrschoool"], "long_description": "Step into the invisible world of matter with \u269b\ufe0f VR Schoool - Atoms.\n\nShrink down to the microscopic scale and explore the building blocks of the universe. Discover how atoms form everything around us \u2014 from the air we breathe to the objects we touch every day \u2014 in an immersive Virtual Reality learning experience.\n\nObserve atoms up close, understand their internal structure, and see how protons, neutrons, and electrons interact to create the diversity of matter \ud83c\udf0d.\n\nLearn how atoms combine to form molecules, why some elements react with others, and how chemical bonds shape the materials that make up our world.\n\nFrom the organization of the periodic table to the forces that hold atoms together, this journey will guide you through the fundamental principles of chemistry in a clear and engaging way.\n\n\ud83e\udded Key Features:\n\n\u2022 \u269b\ufe0f Explore atoms and their internal structure in immersive 3D\n\u2022 \ud83d\udd2c Learn about protons, neutrons, electrons and atomic shells\n\u2022 \ud83e\uddea Discover how atoms form molecules through chemical bonds\n\u2022 \ud83d\udcca Understand the logic behind the periodic table of elements\n\u2022 \ud83c\udf10 English and Spanish narration\n\u2022 \ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67\u200d\ud83d\udc66 Designed for students, families, and science enthusiasts\n\u2022 \ud83c\udfa7 Immersive sound and music that enhance the learning experience\n\nExperience the hidden architecture of matter and discover how the smallest particles shape the entire universe \u2728.\n\n\u269b\ufe0f VR Schoool - Atoms is part of the VR Schoool Series, where education meets imagination through immersive Virtual Reality.\n", "short_description": "\ud83c\udf93 Discover the invisible world of matter with VR Schoool - Atoms.\nExplore the structure of atoms, learn how protons, neutrons and electrons interact, and understand how chemical bonds create the substances around us \u2014 all in immersive Virtual Reality.\n\n\ud83c\udf10 Languages: English and Spanish.\n\n\u269b\ufe0f Learn, explore, and have fun \u2014 perfect for families, students, and science lovers!\n"}, {"images": {"nodes": []}, "id": "1265010935562110", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Schoool - Atoms", "keywords": ["Educaci\u00f3n", "\u00c1tomos", "Ciencia", "vrschoool"], "long_description": "Entra en el mundo invisible de la materia con \u269b\ufe0f VR Schoool - Atoms.\n\nReduce tu escala hasta el nivel microsc\u00f3pico y explora los bloques fundamentales del universo. Descubre c\u00f3mo los \u00e1tomos forman todo lo que nos rodea \u2014 desde el aire que respiramos hasta los objetos que usamos cada d\u00eda \u2014 en una experiencia educativa inmersiva en Realidad Virtual.\n\nObserva los \u00e1tomos de cerca, comprende su estructura interna y descubre c\u00f3mo protones, neutrones y electrones interact\u00faan para crear la diversidad de la materia \ud83c\udf0d.\n\nAprende c\u00f3mo los \u00e1tomos se combinan para formar mol\u00e9culas, por qu\u00e9 algunos elementos reaccionan entre s\u00ed y c\u00f3mo los enlaces qu\u00edmicos dan forma a los materiales de nuestro mundo.\n\nDesde la organizaci\u00f3n de la tabla peri\u00f3dica hasta las fuerzas que mantienen unidos a los \u00e1tomos, este viaje te guiar\u00e1 a trav\u00e9s de los principios fundamentales de la qu\u00edmica de una forma clara y fascinante.\n\n\ud83e\udded Caracter\u00edsticas principales:\n\n\u2022 \u269b\ufe0f Explora los \u00e1tomos y su estructura interna en 3D\n\u2022 \ud83d\udd2c Aprende sobre protones, neutrones, electrones y niveles electr\u00f3nicos\n\u2022 \ud83e\uddea Descubre c\u00f3mo los \u00e1tomos forman mol\u00e9culas mediante enlaces qu\u00edmicos\n\u2022 \ud83d\udcca Comprende la l\u00f3gica de la tabla peri\u00f3dica de los elementos\n\u2022 \ud83c\udf10 Narraci\u00f3n en ingl\u00e9s y espa\u00f1ol\n\u2022 \ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67\u200d\ud83d\udc66 Dise\u00f1ado para estudiantes, familias y amantes de la ciencia\n\u2022 \ud83c\udfa7 Sonido y m\u00fasica inmersivos que mejoran la experiencia\n\n\u269b\ufe0f VR Schoool - Atoms forma parte de la serie VR Schoool.", "short_description": "\ud83c\udf93 Descubre el mundo invisible de la materia con VR Schoool: \u00c1tomos.\nExplora la estructura de los \u00e1tomos, aprende c\u00f3mo interact\u00faan protones, neutrones y electrones, y comprende c\u00f3mo los enlaces qu\u00edmicos crean las sustancias que nos rodean, todo en una experiencia inmersiva de Realidad Virtual.\n\n\ud83c\udf10 Idiomas: ingl\u00e9s y espa\u00f1ol.\n\n\u269b\ufe0f Aprende, explora y divi\u00e9rtete \u2014 perfecto para familias, estudiantes y amantes de la ciencia."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr-vr-schoool/", "developer_terms_of_service_url": null, "publisher_name": "VR Learning", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/vr-schoool-eng/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34426118073702371"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819982_1500459101648375_6939539899885565559_n.png?s
&_nc_oc=Adp217Trymtc2d3Y0rsMIkKCBk1D7qIHaEg3QwDBOTFFNZCCuj-2-oN8bqYb8AsjkM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eC1aLu-vS0wWBSuh_zho6vBDsfuKCNdUclv3L5s5o3w&oe=69D4F949"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_Njfhu0qf0Q7kNvwGvjIQj&_nc_oc=Adr2I86Vglpitvfm0hswZ4puLVXKMlQNUuqFEFCVWvYPHGdr-IU4pL85J2wE8BCTnuQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1attdeokRqOpynndjlmYGV4dX92cYtUqVEv3wrL5DzGg&oe=69D5073F"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0RhXiIRmZQQ7kNvwEZy6tj&_nc_oc=Adps8gl4UwR6YrlbIyuR3uDl9kPrVYna2Q10d8AZI2eqq2RSnPfZsOr2aNDj5NdgrCM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z6jRjQDdrYhH7SRlIE9Jwvhye5O8eBAj820flVPVIPg&oe=69D50259"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedu
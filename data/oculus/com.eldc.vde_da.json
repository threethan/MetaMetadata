35492120331744587_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQxw3CNHYTMQ7kNvwHC25vj&_nc_oc=Adqdztqb4vIfNTZm4KMzR150hQNZrgL6DHYav2jiFA4doBSLy0PxkWEIYifiX9brZW0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI39vhtUGa0pqwz0-lhBX_FUwyrKRIB5AiN8d1MOSOxIA&oe=6AB6767C"}, {"file_name": "Screenshot 2025-03-05 160420.png", "id": "607652402095856", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394301_607652405429189_6818233144605625461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxamV5Rim3cQ7kNvwEQnSea&_nc_oc=AdpyhZ5dVHRxOk3ZJBV5KDkgV49EpMS21O46zXTXbGsxvGcjGFZMNAfO4fMnaJPNNmQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJviyZnCX_VUYdSN2XH0JlMyzQVNXe9hFt_QLAn0gwmdQ&oe=6AB69D0F"}, {"file_name": "Screenshot 2025-03-05 160332.png", "id": "611318862058895", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393663_611318865392228_6034972908677871382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hON575uokt8Q7kNvwEtu9XR&_nc_oc=Adrxw0vwAD5KnsY4Ld039o_yJM1KQgO5ITWeOz4WrlOpSDFXG3k2I6dVWP-gPOzK23U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9IjIdeyYdXpA25kIo_sWpfnJtd6gG1pqMsvapQClJJA&oe=6AB669C9"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zM_NpyDwSNoQ7kNvwE8few8&_nc_oc=Adp98iDa1BefIxk7cANe9kATJCCCfNlbJWBZ5e4uNTvNZM-IPWwZT5nYqSVW-xIprKU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5t2NkEtPbHWtMpsaMDoPlcRGxy86tjYJy52DXYfwelQ&oe=6AB677BF"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvnuaKpCV3YQ7kNvwGh9jXQ&_nc_oc=Adrak2B3rQhOsLPv6Q4ab8AivY6eQM8J-XheyMUJajUliXnnjznRLoh2sYRA49QTf0U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbiUV6YRguT24q1VYPpe4EB5p4z4ceDy1Yn4cYWrN3yw&oe=6AB672D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedure, the learner finds the patient in an angry and agitated state, not willing to cooperate with the examination procedure. There will be a need to de-escalate the situation by talking to the patient, getting them to calm down and consenting to the CT scan. This will be followed by assessment of their pain levels and an examination of their bowel sounds. This scenario is set in a photorealistic environment and all necessary affordances are made available to "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
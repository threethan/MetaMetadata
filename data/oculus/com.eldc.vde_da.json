35492120331744587_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hqbifFotL0Q7kNvwGyBJO0&_nc_oc=Ado1ev82VEYayfw5bCU6anXNlp9b1d4ycE7d5YjMXVrw8Tq3D28UYDLGEG56i8mTvqQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJatQGeXghcnDUHd5q1qiIZFXDaBseZG4yL67TRnpGeWA&oe=6AAD3BFC"}, {"file_name": "Screenshot 2025-03-05 160420.png", "id": "607652402095856", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394301_607652405429189_6818233144605625461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=przPm8kvuzgQ7kNvwG8lAv6&_nc_oc=AdpM6UrUpmAzsl1rJqiftPXzGxdxTlZaZrswPE1qFRwNDNFEwMlgtkvAx6OJwaM0B_A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwxjpYljyueFRpMvmP_Z6U0wiy77rt6ci4BNf5vmJdIQ&oe=6AAD628F"}, {"file_name": "Screenshot 2025-03-05 160332.png", "id": "611318862058895", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393663_611318865392228_6034972908677871382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-uc3FLyHsEQ7kNvwECQjXK&_nc_oc=AdpTrYwK6pUDh2pCsAfBhEoOFiXPwJld6E8YZgs9BiDj2j_6zWwGC1lv8PhRQZ0eKac&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLbjH-2HfSXKCYt9A7u6KmO7SO1DOROxQhBvKALvBeqQ&oe=6AAD2F49"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPZJ2Z6FaJoQ7kNvwHpXLvq&_nc_oc=AdruQmybBGeVUb3KBt1joBrPuvAvUUIdySkQ-vJuKDs6J59LmqD-T45OpE-3UPJYZDc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN8fZqoMSwsLB4f7AnWi2mOFjnl4--_TQvzMph8Jzg9g&oe=6AAD3D3F"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFioECxvHC0Q7kNvwEZ37p0&_nc_oc=Adq3qKOqDue25o7J1c2R9C2846wIb1FYmwVweTC5zGDGL63Nk0gGuKsA3eFE_z2nQjE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3DBRhf0vlEBmsE6LcZrj5_dt-YAjch7Ihn3XXeMmMSQ&oe=6AAD3859"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedure, the learner finds the patient in an angry and agitated state, not willing to cooperate with the examination procedure. There will be a need to de-escalate the situation by talking to the patient, getting them to calm down and consenting to the CT scan. This will be followed by assessment of their pain levels and an examination of their bowel sounds. This scenario is set in a photorealistic environment and all necessary affordances are made available to "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
35492120331744587_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrPtVnokGlMQ7kNvwH-C4yk&_nc_oc=AdpDPg7gOjZb_fFVBMqrlLYW3LiwlMB2Zrsl4Q93EvMMmezb2YmSDp6LQBjz3Uqbtbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3CHgoSgKCa6PMelpoU4WiCt0GuZfoxw6Aj5hm-eBJTA&oe=6AA7F5FC"}, {"file_name": "Screenshot 2025-03-05 160420.png", "id": "607652402095856", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394301_607652405429189_6818233144605625461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEY19FV2A0kQ7kNvwEGavO1&_nc_oc=AdrsAeADF2aOlnSBoM85hv_w7AYWmFk2yGy-X-QvmGDKHVUFwtVXI9q_okZvY3jnhA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCEQiM6QI973gC-AgUeu-OS3hYCsIP4VTNciXMPsGurg&oe=6AA7E44F"}, {"file_name": "Screenshot 2025-03-05 160332.png", "id": "611318862058895", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393663_611318865392228_6034972908677871382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=capExHVL5zUQ7kNvwGRFCmg&_nc_oc=AdrF8KL9v6hK05NQ69onowB-s0xKusQU0pYLrPhcVTTZGu6-1U7mMUKnJJJ_dXB-FtQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDfZEhTkF9uaK7UsxGT2e3Xavvw-YpKuSLLBmUA7QTEg&oe=6AA7E949"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTL7tYyQq94Q7kNvwE9QrSO&_nc_oc=AdopdG0PzgGf49jIKMqnN9cVZwg4bKSF_ylrA_ncfZa9XfXjYSKsApze4bg649MkNYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYLME14mJWAMGlNbUiN8oO2agw25NFqp0lhgcxYfetuw&oe=6AA7F73F"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEa2DF7rHdEQ7kNvwHP-3J0&_nc_oc=Adr5tIP-Xdtg7pgsyfjtyTmiAAkTuCESdiR25xLMPiZ8F9I0MU9AP3V3bwDQe_Bz8Us&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9YU-fnKfVjeAgrCg2BezEHEdeR3zcqt2g5o1wgrNIjA&oe=6AA7F259"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedure, the learner finds the patient in an angry and agitated state, not willing to cooperate with the examination procedure. There will be a need to de-escalate the situation by talking to the patient, getting them to calm down and consenting to the CT scan. This will be followed by assessment of their pain levels and an examination of their bowel sounds. This scenario is set in a photorealistic environment and all necessary affordances are made available to "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
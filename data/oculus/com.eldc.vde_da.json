35492120331744587_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shIAO2uS770Q7kNvwEr7OPp&_nc_oc=AdoVPmPRLgUXtlH50IHvPZS1cvNJSjb534tJU0i6LaCKRYugYywMiSBbpI3YI8-Ihik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3zfTHfDhvSn8I9W_-oJ8_IBLJmreppMqOQwXvDuqC5A&oe=6AE73DFC"}, {"file_name": "Screenshot 2025-03-05 160420.png", "id": "607652402095856", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394301_607652405429189_6818233144605625461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsdAG51HeGYQ7kNvwEiuUmZ&_nc_oc=AdreYYZND4L68xMoArNSLgOC0UyvCjO2AVSxEdT0gkfj3-Dv5i97z0QRqKfXBu3mI7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKj7b_98T9_KKt6SHML48hlCBz_7-FR3nM-p3mcNjdcg&oe=6AE7648F"}, {"file_name": "Screenshot 2025-03-05 160332.png", "id": "611318862058895", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393663_611318865392228_6034972908677871382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dyu4R0Ud3_4Q7kNvwHUcf-N&_nc_oc=AdoQS8ga3V07IQNzPZV87yFpHnJE6Pl9WKniMAKuHSSRoFiss3EKFnwvgGu-suV1Kes&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV_CKQbCoQjf_eOZ9ErQlpM14tqROgRn7l5K_aIUuhZg&oe=6AE76989"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DB2JuMplOwQ7kNvwGBmifo&_nc_oc=Adqr6wh4qo7ClOFTPhw20dl-BRJB2AL2hQKabiKqJZIidLiYqf5yZagu-lRqRPy8qEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL606KPE5IKdT9nwO59u83SjoJlVSz2UlQMhAsW-QeUA&oe=6AE73F3F"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcZXWg1Sd9UQ7kNvwHGFfWg&_nc_oc=AdoAtqKbt-4eJKXbWPiqNgdPW62w6Tt42VGWXH-uXmJR8wkRWQsuE5OjTqLbVhHWhRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUhlBN0GCUY5UMS_h7MuJvhiP-Cr-r-ZwKsEkm1yw0aA&oe=6AE73A59"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedure, the learner finds the patient in an angry and agitated state, not willing to cooperate with the examination procedure. There will be a need to de-escalate the situation by talking to the patient, getting them to calm down and consenting to the CT scan. This will be followed by assessment of their pain levels and an examination of their bowel sounds. This scenario is set in a photorealistic environment and all necessary affordances are made available to "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
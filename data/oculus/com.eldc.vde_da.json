5771-25/473393663_611318865392228_6034972908677871382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8txcrpJ_4wQ7kNvwHju_Cj&_nc_oc=Ado3yavUhfZwXuTbhzUzeWqVmxrfAJFwaSD4Tk-5wN2p4gAiBQxSnGNLJ9J3QeMYoLo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13KQRUj4BFuGGAOncSf5mdMBD0QinjEnIZNDbQ-TKQ2Q&oe=69D79C49"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_Njfhu0qf0Q7kNvwFOhJiy&_nc_oc=AdrqmC-fImxPvUS5FnkrJPQi6Uw4GqYN6Ykk49y2W-W02kcc337Kwlj6KdnNOVhJx_E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14evDmEku5ESdsqBOYPTXk2HLsZyboCTru2IA-R1eC-g&oe=69D7AA3F"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fz93LwExNcQ7kNvwGU7ce2&_nc_oc=AdoUmnadn6Ymh4nYNbSNsoP44lzi4B5sD-fNptFlcXl9_4UlEUNsW9qXRH8T9pVpQ2E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1he9BM_7TGf8Cg_ss9PJoehPG6dvDZgy7hLYhWsYBMaQ&oe=69D7A559"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedure, the learner finds the patient in an angry and agitated state, not willing to cooperate with the examination procedure. There will be a need to de-escalate the situation by talking to the patient, getting them to calm down and consenting to the CT scan. This will be followed by assessment of their pain levels and an examination of their bowel sounds. This scenario is set in a photorealistic environment and all necessary affordances are made available to "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9406614499416432"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1376444903770465"}]}, "baseline_offer": {"id": "1376444903770465"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743511860, "status": "PUBLISHED", "id": "1376444903770465"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24178425178475454", "version": "1.7"}, "id": "4
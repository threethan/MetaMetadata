35492120331744587_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQxw3CNHYTMQ7kNvwH8jJ0k&_nc_oc=AdrdkkKjYgJafUlQSjnTOjp-MbClLjU7QH3XwM1_eU0PGMHrNpRTGlnmivuEMu3mPkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwKy0xme5ykzcQe93eEicnITRwrxjNLRmJw8tsWbeymA&oe=6AB7C7FC"}, {"file_name": "Screenshot 2025-03-05 160420.png", "id": "607652402095856", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394301_607652405429189_6818233144605625461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxamV5Rim3cQ7kNvwGAERmm&_nc_oc=AdoNwakatMCwqazbuI_z5hTwLqeyOKrSOae3DRJNKZ80bZcNeidTQNlgPWdhLlyt8VA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPqFKujwntJgd2gcYhaabmMNDlTA5cr7UjtH265HAPJw&oe=6AB7EE8F"}, {"file_name": "Screenshot 2025-03-05 160332.png", "id": "611318862058895", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393663_611318865392228_6034972908677871382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hON575uokt8Q7kNvwFt38b4&_nc_oc=Adp644_O8ct1TZFamjF7m53mP3VXyiTwJs_Spt2lByKjkg274Bv4khYq4V7YDcB3ba4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZSqeYTL20GSrleH61E0x_oLzaXxJWQ6qzxM0j6nu63g&oe=6AB7BB49"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zM_NpyDwSNoQ7kNvwEK9vPr&_nc_oc=AdrR7scgGLIC_2WqaY1S7M06Y4ke0lAxLKz-YIWxgUVfwT_ckdd8P2N_KSlg0OhtAzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9V4YiRB9cZUCYGy1YAAzySWsij2grUbXrwysbCK6F_w&oe=6AB7C93F"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THlMSzJxdfoQ7kNvwGAqc5S&_nc_oc=AdoOcBlq7aOGScZxOE-c5xwuP3DjS55YzQB508De2hEmxt7yR1yeLrWGRSvWxtToaYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3XOsDgtVjgeUUcrCcAji9NSylumZWQEsOBa7hj245EQ&oe=6AB7C459"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedure, the learner finds the patient in an angry and agitated state, not willing to cooperate with the examination procedure. There will be a need to de-escalate the situation by talking to the patient, getting them to calm down and consenting to the CT scan. This will be followed by assessment of their pain levels and an examination of their bowel sounds. This scenario is set in a photorealistic environment and all necessary affordances are made available to "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
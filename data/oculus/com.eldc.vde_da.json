35492120331744587_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGAfMBdk35UQ7kNvwEPYiGF&_nc_oc=AdqVU34JzGmhs_5vtMnkM7CzejZQq7IS3vScAbF5oo1Ym-kC6K0EDDqlRY2WTHRzkdU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_aRXbqENspaSNCTD7HcLmC30LLe6Y2t_Ka-31p5DuPg&oe=6AE88F7C"}, {"file_name": "Screenshot 2025-03-05 160420.png", "id": "607652402095856", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473394301_607652405429189_6818233144605625461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUUy7Y31AboQ7kNvwEXgyrv&_nc_oc=Adp2OqF8wBF1BM-olFCf0wnnDqAlNsvumgxzsR4OuZeI7ZPQFqxQc5Q9ZoqCarRcWj4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0VQPbMbTrl6OUAOEqiU9UybxVDUSfJPCBJwiHH0Chhw&oe=6AE8B60F"}, {"file_name": "Screenshot 2025-03-05 160332.png", "id": "611318862058895", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393663_611318865392228_6034972908677871382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhFEmApylIcQ7kNvwGIUN7x&_nc_oc=AdpisdsCj_jKVPq4b-Z9G3_2lrtb9NE733cpCnPFc4_FSPZ6dMqAuKOAsKj66ZvUsFc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg0iUf9nw9GJgHV3LWQzk6kS-iDw03HExL2ulBj5Q3hA&oe=6AE8BB09"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DB2JuMplOwQ7kNvwFlXljO&_nc_oc=AdpSwl3Z1yxjs_jBTroXs9HhhLihPUnU55ZmCQWt8ujMZHzTs2PSgBMXOcM86_Xramw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuPa8PnP4ZNUO4l8GWkTK4qhjJZiGFG8JRA-6sCjU1Xw&oe=6AE890BF"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcZXWg1Sd9UQ7kNvwEIwaDT&_nc_oc=AdpT7CDqFaZQ38QTl636IzTypGsmEcTdRoEdw8HaboeCK67LppIWpw9jlETR45EfBlQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFV3MpEFsINuvj0Qpw9lj-i0wzaehbBY5bbobU9QC4Iw&oe=6AE8C419"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedure, the learner finds the patient in an angry and agitated state, not willing to cooperate with the examination procedure. There will be a need to de-escalate the situation by talking to the patient, getting them to calm down and consenting to the CT scan. This will be followed by assessment of their pain levels and an examination of their bowel sounds. This scenario is set in a photorealistic environment and all necessary affordances are made available to "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
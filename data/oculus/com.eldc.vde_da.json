gXjp5-vMXM4XarNnN4lYCXljpr8bA&oe=6A1ED9FC"}, {"file_name": "Screenshot 2025-03-05 160420.png", "id": "607652402095856", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394301_607652405429189_6818233144605625461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=069IB8ZcPfcQ7kNvwHDqjou&_nc_oc=AdoFFhqXzCLi6JSignZaI51z_pIjDoKkIDwU2X-koTfyQd9h3z3SZeEqnTnaVzONj-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hbDyPKnwEgEOW40tvHYjrjga6eIw4Lt_2OfeS71zuOA&oe=6A1F008F"}, {"file_name": "Screenshot 2025-03-05 160332.png", "id": "611318862058895", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393663_611318865392228_6034972908677871382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXwh3At_ZuEQ7kNvwFYtgsO&_nc_oc=AdoZPFgqVKFgqAvBSsh7r0MKQcbpj-ZKUuKeoT3BI29Qhdv13_MVG77zN0PTWVhWXsA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vpi4wyYgY55BOse4JmgWM8S11nmi2WefDxid-Lfmr9w&oe=6A1ECD49"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-v0zwEoI11oQ7kNvwGnXIdq&_nc_oc=Adpoh3hrErMR2AZm-LgVcgn7ojgkOHAv700MGwTvi2pzZf0K7md6AgaWybhAFYqYEJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MKEkR4IZ1Xi8nmrJEJBeEenjhDQGVlOjNuWoV_dCYWw&oe=6A1EDB3F"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDRGgBJ5gvUQ7kNvwEgmmDL&_nc_oc=AdrlEo6YFzAxVUZH4b2EiEKxItwHiN5TZxdWYtrqzVy1OD-QRzAs33ddEPBng8xfhb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wZ0zDrZpVCUk5LaYCKRmrmljPMjcZ9NSZkIvGR_sIGQ&oe=6A1ED659"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedure, the learner finds the patient in an angry and agitated state, not willing to cooperate with the examination procedure. There will be a need to de-escalate the situation by talking to the patient, getting them to calm down and consenting to the CT scan. This will be followed by assessment of their pain levels and an examination of their bowel sounds. This scenario is set in a photorealistic environment and all necessary affordances are made available to "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
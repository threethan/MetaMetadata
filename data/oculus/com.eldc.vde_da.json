35492120331744587_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-36Z36TpKsUQ7kNvwHNzJ5d&_nc_oc=AdqdKRU1abXNb9EPsIDW8FiooA1JJUn2JyDbWEDllVtAco1CfWM-x4UKpKeDzax5MMU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKyBDxQuBy3ErjycX9r51Y7iI9AkSbTvv4PG37qGOmzg&oe=6AE3497C"}, {"file_name": "Screenshot 2025-03-05 160420.png", "id": "607652402095856", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473394301_607652405429189_6818233144605625461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHC339E0HIQQ7kNvwEYM_A-&_nc_oc=Adq46NotHC5EajbvRjSa_Aq6Ya0DSOgBseQi21Mg0lmr2WANxU8ZHL57kYuePhTIfrE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM75zmQyJeJzd_hy7AlCzwUR-vrhRKmORdkISAV7IIq4Q&oe=6AE337CF"}, {"file_name": "Screenshot 2025-03-05 160332.png", "id": "611318862058895", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393663_611318865392228_6034972908677871382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mYtxyPBXagQ7kNvwF2qO5Q&_nc_oc=AdrqPbYI5aPZCyiwHoWt4Dbj7dGo7BY_9zOLT_-QqcYY-1Fhr4bhDjgZU5nbQGmflkE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcF6IbHlQVXoU7JniHgmjYPXcqn-4yDio22get6U_aEQ&oe=6AE33CC9"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGdTDfcFLrgQ7kNvwHMFaVl&_nc_oc=AdoOehSXZMDZMaXj9OGrdGIM_lu8BHRSy6KfFAdsTPoiF2Nl_HjMOLhHnMK5dldiC4s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7RdwC1bEXGNdWxrriTdj2yg3aUgu5ngXtcou5o1nrqQ&oe=6AE34ABF"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hSAptiRURgQ7kNvwEXNY9L&_nc_oc=AdrUefLjms3_27ukVKZAFgyedUt9gMdF2vwSi_39XDXO0dWeWGQkBmjo_bq3SreL0IY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZgmszq2g-xkZC68PHMtW2jEwXLmgc5_qwTpisvwbKQw&oe=6AE345D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedure, the learner finds the patient in an angry and agitated state, not willing to cooperate with the examination procedure. There will be a need to de-escalate the situation by talking to the patient, getting them to calm down and consenting to the CT scan. This will be followed by assessment of their pain levels and an examination of their bowel sounds. This scenario is set in a photorealistic environment and all necessary affordances are made available to "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
35492120331744587_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGAfMBdk35UQ7kNvwFOfJmY&_nc_oc=AdpGAkZ4Yd1zBGO4FtUBvf1T-jGhMeycHngec4As-JnXchL8ebvy7HKqA6tXhZ12Jjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaRMURcpQ25q9kwnhPxBCgYuGLBjdglMHoa3kl2-ulNQ&oe=6AE9E0FC"}, {"file_name": "Screenshot 2025-03-05 160420.png", "id": "607652402095856", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394301_607652405429189_6818233144605625461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUUy7Y31AboQ7kNvwGYn_DZ&_nc_oc=AdpKajbKnuQ-7K0aRPNNdF7hzfJ7riqIGEUYDtox3iXwjD_GhqTkgmXCnirl_i4EUIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-l7_lRtBGO6krK3jeGGxMWJkosPQ6xH8ccZCWS_6c-w&oe=6AEA078F"}, {"file_name": "Screenshot 2025-03-05 160332.png", "id": "611318862058895", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393663_611318865392228_6034972908677871382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhFEmApylIcQ7kNvwEkT0cO&_nc_oc=AdqHVCdvZAQp4fOnMkncZ4oht1ue04hL3HsFgpnhwsRi3wwrJpvNft7YhjLZAaMA7Fg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNZhvuj__dhP-C4P71B0R_vnVcjQWl3So2BYd1O0YUqg&oe=6AEA0C89"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4A6is8S6ToQ7kNvwEbs-jW&_nc_oc=Adqe__rIilE3K-6JhUbVLxPkbtuFwP4f73Dyjg-mo10GiuzcSK5BahsfmdVyQNLr3VQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT1dCGVsd_GE6yxL5pnDmR6Ik44QII3-j_j7tFTPX1jw&oe=6AE9E23F"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcZXWg1Sd9UQ7kNvwF0G75o&_nc_oc=AdpNHCbCR_5xbf2jKQFzvQIzzZ2OUZ-uWI4_ifnX1Ni9j1uNzusKohVallro3Kwgvyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7bKu9rqnJ0gxVrJMYFajH56PbGnMW_Puct2tZOKJ2YQ&oe=6AE9DD59"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedure, the learner finds the patient in an angry and agitated state, not willing to cooperate with the examination procedure. There will be a need to de-escalate the situation by talking to the patient, getting them to calm down and consenting to the CT scan. This will be followed by assessment of their pain levels and an examination of their bowel sounds. This scenario is set in a photorealistic environment and all necessary affordances are made available to "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
35492120331744587_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYUI_J0VZb4Q7kNvwEkeACa&_nc_oc=AdqPKpNXNVaQ-J7KjhVIPv3Vt4kL-OM83hgwzNKoiAjVHoRIA8SCBkthfW5ij39zEOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2urcQJsMI8xXSD_i_rx7MasBuTt5tNzu2hYLWy_E7cQ&oe=6AD25E3C"}, {"file_name": "Screenshot 2025-03-05 160420.png", "id": "607652402095856", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394301_607652405429189_6818233144605625461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7vCdJ1u8WQQ7kNvwHYmvYV&_nc_oc=AdrF3gR0ek2dS79d30wRKBTuA2uVTlbjk36KJ--hplLkBx75qxgIQuJlKXQOpym6sew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZWlbNRzJRSTKyQvJdkdSuHzI1ym9o2plkmHvGXBRwZQ&oe=6AD24C8F"}, {"file_name": "Screenshot 2025-03-05 160332.png", "id": "611318862058895", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393663_611318865392228_6034972908677871382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqLSVO88-yUQ7kNvwH-U9pW&_nc_oc=Adqpci2urBdczv1J7wzKDrBRcSH0nd1Mzd3MKD5sOT6ieFD_y60Pyz-cthwZpmXjPYI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE_dmnj_ofuwUeBhyKJEwjNZLQAyMJfJBn3VSFRKM4HA&oe=6AD25189"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjlD3FMg9V0Q7kNvwHUl-KM&_nc_oc=Ado3srzkCHX_gFZfR3QWJVSQiYp9SARm_yX3J9j7THR1coVhQoqv0K00gWSAAgtBHHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPs5w34jM5D3QCVia1S4twMsdGSDOr43ddOIe-9S367cA&oe=6AD2273F"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOSVZwTCXT4Q7kNvwH0d3no&_nc_oc=AdpS0jNHJ_SMKS0WFvatL7VU55XTGBSsRcZqVXkRHP12y-eHkhyDn6ICP_I8TmDzQTc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHZ_4Dj_DS9PtDSJcjUJ6mAMvcHjHqOEfIH2AtqYbTCA&oe=6AD25A99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedure, the learner finds the patient in an angry and agitated state, not willing to cooperate with the examination procedure. There will be a need to de-escalate the situation by talking to the patient, getting them to calm down and consenting to the CT scan. This will be followed by assessment of their pain levels and an examination of their bowel sounds. This scenario is set in a photorealistic environment and all necessary affordances are made available to "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
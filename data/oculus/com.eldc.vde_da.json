35492120331744587_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue9wHpFtdswQ7kNvwEDcdvk&_nc_oc=AdqynXum3L63Ki1Dczp2ZqBBB1F1KPqF9I0zmMME2BHcuMxTFiWhKB9XtRZ8xFm4z1I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx4NjFBJwZn6Gf9cDzfTqXbj68zKRDeWgKuPw25tkLpg&oe=6A748B7C"}, {"file_name": "Screenshot 2025-03-05 160420.png", "id": "607652402095856", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394301_607652405429189_6818233144605625461_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-ObRraXyssQ7kNvwFPzgEH&_nc_oc=AdqrMVg2B_WQ9reVHcFnLqUEnwtpHXQjTifNSKwGP8-UqiNbFe56nxmF50AQKmSVoAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNCvhWQZDt2ExPi-Zy1E8UKWXN5TZY4juC1jmdWv0T6Q&oe=6A7479CF"}, {"file_name": "Screenshot 2025-03-05 160332.png", "id": "611318862058895", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393663_611318865392228_6034972908677871382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnTUQaOU73IQ7kNvwGu599E&_nc_oc=Adr-nFRbj8qrd-HwveHSRc6x_hzDEEZML6YWsmEhRTQSwxfnHET2ZWEJc9QqJCuhOqs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCZzeT3ClQQQZ0pGkV519lAf2BLeTCgv3_fjDSHHq7Dw&oe=6A747EC9"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9laTrK8EI-kQ7kNvwHyTgXB&_nc_oc=Adq6-MAz04G1zKQr_Teqn2l35abzVbJBEF5vDkTfSZyrkxCxF3gliJRWwksvTh4a6ks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsOhZTkhIZ8GmGpK9lw9oTOygkq5y-ZWZvnUz3AOpr5g&oe=6A748CBF"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDbVR_lnov4Q7kNvwGieJJV&_nc_oc=Adp6SuXbpaVq06e1xkbAz4mvcjGKROSwLNf_rc5tR9HCmN6UZcID_uRozqEHoJVZE-M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDalkiHpnFe52iZQTZKHSvtoUW6RcmTynpXd-7QyVm8Q&oe=6A7487D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedure, the learner finds the patient in an angry and agitated state, not willing to cooperate with the examination procedure. There will be a need to de-escalate the situation by talking to the patient, getting them to calm down and consenting to the CT scan. This will be followed by assessment of their pain levels and an examination of their bowel sounds. This scenario is set in a photorealistic environment and all necessary affordances are made available to "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has
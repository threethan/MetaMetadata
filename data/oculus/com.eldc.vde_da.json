c_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3aG1tv7KmERw3njD2z-ifznfQoaWjhcWAfGtOSRbhHMQ&oe=69F88CCF"}, {"file_name": "Screenshot 2025-03-05 160332.png", "id": "611318862058895", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393663_611318865392228_6034972908677871382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BOgVLEXfbUQ7kNvwE4zaMZ&_nc_oc=Adr8lcY5s8EicomKvJEFMAGdOFnqxZkB5JePKP5IhhONWl_IBuikZocD9pD3snvipTc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12M0qabr1QmoUkV22iUAR1y4ePv5FOzGQCXHurWx_sGA&oe=69F891C9"}, {"file_name": "com.oculus.vrshell-20250305-161135.png", "id": "970346388528787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392062_970346391862120_7546539720029584701_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynIhUl-aC9QQ7kNvwFnjMWH&_nc_oc=AdrY07jno4tiimCEUUC3fl-XS5LRIberfsyAMG9805LIKQ8v6hAtO2bGMRfEnUdJoMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oEENxiKESqUmadmhWJfglJqVsnumHN2bR5m-OfvWVDA&oe=69F89FBF"}, {"file_name": "Screenshot 2025-03-05 160744.png", "id": "1879212519149186", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473400239_1879212522482519_2233836328268102413_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHzovGtqjFAQ7kNvwG7N5vS&_nc_oc=Adqyf1eJS6rJMnIJTopBq2buPr3r33Z2xOqP_rmp1SZIl9P1X1sCe_FaAFJnczTROOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tW9D7ybU4OUNMscl5ZhlgFxUgHwJdkllMcj9fvZTMsA&oe=69F89AD9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme Anger (Abdominal Pain)", "keywords": ["Extreme", "Anger", "MedVR", "deescalation", "VR"], "long_description": "John Smith is 45 years old and has come to the emergency department with severe abdominal pain. Due to reasons beyond control, his CT scan has been delayed. His long wait without being seen turns to anger and frustration, and he starts yelling and demanding immediate attention. His agitation grows, and he starts throwing nearby objects and threatens to leave without medical advice.\n\nThis VR simulation is designed to provide practitioners practice in managing and de-escalating tensed situations like an angry and frustrated patient. It helps test learners on their patient management and critical thinking skills. ", "short_description": "As a part of this De-escalation procedure, the learner finds the patient in an angry and agitated state, not willing to cooperate with the examination procedure. There will be a need to de-escalate the situation by talking to the patient, getting them to calm down and consenting to the CT scan. This will be followed by assessment of their pain levels and an examination of their bowel sounds. This scenario is set in a photorealistic environment and all necessary affordances are made available to "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "9406614499416432"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1376444903770465"}]}, "baseline_offer": {"id": "1376444903770465"}, "is_approved": true, "firstOffer": {"nodes": [{"sta
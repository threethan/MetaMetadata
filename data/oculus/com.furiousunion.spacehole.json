8838_1550162895294105_1476230678_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7jAcKiRO7IQ7kNvwF9bAyE&_nc_oc=AdrJQFDnpB9K2hAedSVJAyGK3X0XQe3x5rU66NjbFqxRCOtZB5HeSbqk1lhiRzdr4IA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_tT-XC6oEmVKQEwWC1YMt40ULm4G8vNAYftyttoB2uA&oe=6A747DDE"}, {"file_name": "migrated_image.png", "id": "513728509566749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138833_1021436187920514_1333976237_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qY7HqoYBbSQQ7kNvwFprGIl&_nc_oc=Adpi2cFKlmoI3F6cDvkl7JD2HZStMHkvqmVsA76QKz6NVJ989dFvY7hDdFtN2yb1xQA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB1y5tfWW9wJ_RVDIZgLkuk14IcCD2sm7bR2sNHtXTtg&oe=6A7473CC"}, {"file_name": "migrated_image.png", "id": "209252160182922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138787_457869757734084_1143974185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ2cnRZe4icQ7kNvwFHhrFC&_nc_oc=AdrinhpC-TpjwkOil-GYf_xaKE6CXCL7TrNs6IwnlvO5lZZ0dh3uUxZCBLUx3G4sbSA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESejpzga__GMTDmI7wWu_xBTk3mlIaad5sCNaWmFfj7w&oe=6A7473C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mega Spacehole", "keywords": ["Mega", "Spacehole", "Arcade", "shooter"], "long_description": "New Low Price: $2.99\n\n\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\nMega Spacehole is a fast paced vr-cade shooter that puts you in the center of the action. Survival depends on your lightning reflexes and strategic decisions.\n\nEach spacehole is a unique and challenging arena you must survive, and ultimately master, to become the new Mega Spacehole.  Unique powerups are placed in each arena to destroy your enemies and restore your shield. The more shield strength you have at the end of the level, the higher your score - If you can last that long!\n\n", "short_description": "\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.megaspacehole.com/", "developer_terms_of_service_url": "http://www.megaspacehole.com/", "publisher_name": "Furious Union", "support_website_url": null, "website_url": "http://www.megaspacehole.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485791169585186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138836_784339765027905_1065375798_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7kdgw2NyU4Q7kNvwHphjtm&_nc_oc=Adqrx-Cq5kaft1lYcpn_qfsDgIBxz4WkFGtIL0d6FrQwcvr3WPyidxiYV7lYk2sspVY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxaqCu9jNla6VMgb-vsbbTSHIR0MhO0UQGdWXra8fCKA&oe=6A748D24"}, "is_concept": false, "is_test": false, "is_trial_o
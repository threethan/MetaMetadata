8838_1550162895294105_1476230678_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piaOIDtqC9EQ7kNvwEUUnio&_nc_oc=Adoi7PZpH4IPg1GK4x6l6dfwTnjaoaEP2J8EilXYfoVbZrsYT_BDEAk26wEUkY36AwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlyiwo2lgy7ph5yqoKvldEqcofslNUw3cgQZXgutmFbA&oe=6A6DE65E"}, {"file_name": "migrated_image.png", "id": "513728509566749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138833_1021436187920514_1333976237_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3buP8U9CSQQ7kNvwGGRCMq&_nc_oc=AdrGfDx2Zbhv-Y1UWgdMRr6lhW2r6EbWl9ARQt39kKR81D8o61_v1D3RbVUhK7MqYHg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxV_fC_TrSAgN6CJSEd1INmD_G2V5YZEZ7CoCZ7KVItA&oe=6A6DDC4C"}, {"file_name": "migrated_image.png", "id": "209252160182922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138787_457869757734084_1143974185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoO6xzMHcpkQ7kNvwHs2TsP&_nc_oc=Ado8hXeKHDl5gAn8RSNuzT0AcUnYP-EDGXQOWu5IF4UEtAckp9pgCySfTjs6P-zBKng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEr843g-291BQXG-Ya_vbCnzcvRBDwU3yFxkOavtcRXw&oe=6A6DDC42"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mega Spacehole", "keywords": ["Mega", "Spacehole", "Arcade", "shooter"], "long_description": "New Low Price: $2.99\n\n\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\nMega Spacehole is a fast paced vr-cade shooter that puts you in the center of the action. Survival depends on your lightning reflexes and strategic decisions.\n\nEach spacehole is a unique and challenging arena you must survive, and ultimately master, to become the new Mega Spacehole.  Unique powerups are placed in each arena to destroy your enemies and restore your shield. The more shield strength you have at the end of the level, the higher your score - If you can last that long!\n\n", "short_description": "\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.megaspacehole.com/", "developer_terms_of_service_url": "http://www.megaspacehole.com/", "publisher_name": "Furious Union", "support_website_url": null, "website_url": "http://www.megaspacehole.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485791169585186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138836_784339765027905_1065375798_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvM4o--uxi8Q7kNvwHofy64&_nc_oc=Adqkb3tJ8Ask4LSOyQN3TG1AQEW5zEcuubL6Q6344ZprhXTCHdY0HDffieSQYBeEdxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAYo7M8K9AbL_K3Ytm4cQa19pgpXL93rglXhVhobXRGw&oe=6A6DF5A4"}, "is_concept": false, "is_test": false, "is_trial_o
8838_1550162895294105_1476230678_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIiRJmjvPdkQ7kNvwGlagHY&_nc_oc=Adqf__C2PYBrHX0m28EHVHApN1YizqVnUgEipKghkh9M2GIglDCAj9zOCkeqqfXb-pE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQzxSvodCeCQ3srpoEcBBa-50sA77-aA1J3ma3UVaqOw&oe=6A68A05E"}, {"file_name": "migrated_image.png", "id": "513728509566749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138833_1021436187920514_1333976237_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KygrHUSDYXkQ7kNvwFJB_sE&_nc_oc=AdrAKzjNuk4t2-CsXCwsldFJwyq4EV4o4yoWcUNS4Qc5MpiMcOBvqhs1j2u-TuDW5nw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5OGc_6fWAh_UN2yAqx5aJUb5daDgDS07RKdtgdcZ6jw&oe=6A68964C"}, {"file_name": "migrated_image.png", "id": "209252160182922", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138787_457869757734084_1143974185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aGagoLEg5QQ7kNvwE96atL&_nc_oc=Ado5zNxQoaCpNZBRJxKh-F96Qeqpr13GM2Eh7POu4-QdV2s3Z3lzR-SvhzQDn_gUN1E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARix8uMr_waB5_PwF1QCc_VpQP0D8POAupDayqkNllbg&oe=6A689642"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mega Spacehole", "keywords": ["Mega", "Spacehole", "Arcade", "shooter"], "long_description": "New Low Price: $2.99\n\n\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\nMega Spacehole is a fast paced vr-cade shooter that puts you in the center of the action. Survival depends on your lightning reflexes and strategic decisions.\n\nEach spacehole is a unique and challenging arena you must survive, and ultimately master, to become the new Mega Spacehole.  Unique powerups are placed in each arena to destroy your enemies and restore your shield. The more shield strength you have at the end of the level, the higher your score - If you can last that long!\n\n", "short_description": "\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.megaspacehole.com/", "developer_terms_of_service_url": "http://www.megaspacehole.com/", "publisher_name": "Furious Union", "support_website_url": null, "website_url": "http://www.megaspacehole.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485791169585186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138836_784339765027905_1065375798_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcvsN_I2CwYQ7kNvwGe1rrT&_nc_oc=Adry1AsnI0tNj4SyWUDt56i6C4u1OTqstnJ7-YygzfVpFLrGs21qyd4zjvRASVdqoP4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArtKPDkppN_890nEgobYTAG9RGGGvmJSm-muAIjdnrrQ&oe=6A68AFA4"}, "is_concept": false, "is_test": false, "is_trial_o
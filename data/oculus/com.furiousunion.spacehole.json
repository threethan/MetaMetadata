8838_1550162895294105_1476230678_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWOyM7x_5VAQ7kNvwGH4sOv&_nc_oc=AdpkDepPqxU4Ub-Ig2oVd8fVh92EggAQ870GvZnlcZIZ0yIuSJajDgOtdcDmI2lhu4I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrZItnsssEXXqtA8koPOWFjW8GOSPHEXnHc2sotltn0A&oe=6AA5455E"}, {"file_name": "migrated_image.png", "id": "513728509566749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138833_1021436187920514_1333976237_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-7riTMBResQ7kNvwF8jmLz&_nc_oc=AdrOvc1OFXEZUkhsUk4qq1kZz87zVLfR6aGHQdUbYBv-UnMpAtARczRvFb6MPK__TFw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKssDPqebdKCcUEfrjrCp2HIzMwdZtv2dYbgt4z4aLoGg&oe=6AA5738C"}, {"file_name": "migrated_image.png", "id": "209252160182922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138787_457869757734084_1143974185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQI_LNjme2AQ7kNvwGldyGM&_nc_oc=AdrPIqfiuHCAP5Ln7Xs1Sg01Dx6I4sE6zdaIAyFPZkTz_mRg297-MLdiMEBbsmqb_bk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHU1O5O7LqMCnr9Ji6o_6miNqB8ylrMAeZjjLTBBxBdQ&oe=6AA57382"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mega Spacehole", "keywords": ["Mega", "Spacehole", "Arcade", "shooter"], "long_description": "New Low Price: $2.99\n\n\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\nMega Spacehole is a fast paced vr-cade shooter that puts you in the center of the action. Survival depends on your lightning reflexes and strategic decisions.\n\nEach spacehole is a unique and challenging arena you must survive, and ultimately master, to become the new Mega Spacehole.  Unique powerups are placed in each arena to destroy your enemies and restore your shield. The more shield strength you have at the end of the level, the higher your score - If you can last that long!\n\n", "short_description": "\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.megaspacehole.com/", "developer_terms_of_service_url": "http://www.megaspacehole.com/", "publisher_name": "Furious Union", "support_website_url": null, "website_url": "http://www.megaspacehole.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485791169585186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138836_784339765027905_1065375798_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umChrQbYROYQ7kNvwFp7SdI&_nc_oc=Adow3H-VkK1tzdMjkWI5BsM8w4tuf8ncGa4GUNWy6oy06hp0gVRIovY2zlYCshp0y3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnCH1JWkHraDhHVnu7UgoVhblwXOJ3R8WDs9KrSH23Ew&oe=6AA554A4"}, "is_concept": false, "is_test": false, "is_trial_o
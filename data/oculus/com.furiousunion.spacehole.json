8838_1550162895294105_1476230678_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcM94PHQZ4UQ7kNvwF0K-DQ&_nc_oc=AdqAYN0udBun_EMWz3XtITt8dpal9sCiQP13BECl395yi08U0llslqxxHdkz22WkIaQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznHoC_6H-U8YPLaJP0QiI3v2gnQ5k_WdAOnqzuwAUpYQ&oe=69C7C95E"}, {"file_name": "migrated_image.png", "id": "513728509566749", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12138833_1021436187920514_1333976237_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gO4056oIp5gQ7kNvwEt1DVJ&_nc_oc=AdoHT0Au_d6zdyKTWcul0FY867CZGQxt07rRzJWu7Ru3lxYc1XSzgAd5C70aRkhGLt4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1l2oy7KdqXiChVQt5WZ4OtILiI6X0zewU5w2mjbpkBg&oe=69C7BF4C"}, {"file_name": "migrated_image.png", "id": "209252160182922", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138787_457869757734084_1143974185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2asfeAqjr4Q7kNvwFvgwLl&_nc_oc=Adpkz8WTo1SGjZBoAWLS596m35kChFN_hJRTj6V3TxXJ_AHQyFDC_MJbNu4Mwd3Dke8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5o3Tm70_RXPpuHiwholLb9jo0BMmTaVrkmZQHWc717g&oe=69C7BF42"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mega Spacehole", "keywords": ["Mega", "Spacehole", "Arcade", "shooter"], "long_description": "New Low Price: $2.99\n\n\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\nMega Spacehole is a fast paced vr-cade shooter that puts you in the center of the action. Survival depends on your lightning reflexes and strategic decisions.\n\nEach spacehole is a unique and challenging arena you must survive, and ultimately master, to become the new Mega Spacehole.  Unique powerups are placed in each arena to destroy your enemies and restore your shield. The more shield strength you have at the end of the level, the higher your score - If you can last that long!\n\n", "short_description": "\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.megaspacehole.com/", "developer_terms_of_service_url": "http://www.megaspacehole.com/", "publisher_name": "Furious Union", "support_website_url": null, "website_url": "http://www.megaspacehole.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485791169585186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138836_784339765027905_1065375798_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3DdfoZ6Xa0Q7kNvwHYXtTC&_nc_oc=AdrC1msIT8ykPRrjTtaD52kL4u9e70e8x8dulipEufk6E7GfIDgp2TvoQz0Kn1KJ7ms&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy07BrU4t-JC-urNdo0RuX_Z6QFxL9x1y-qI2Wt1SOzqw&oe=69C7D8A4"}, "is_concept": false, "is_test": false, "is_trial_o
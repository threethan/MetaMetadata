8838_1550162895294105_1476230678_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSTQWScSqTQQ7kNvwHhH8k3&_nc_oc=Adrq9t4XjYKhe9i8OuznGl7nsSB4YrbQw8yq37Q7Y4naGGVMcTYBXKIsR0B3VTKsQPU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICRf9pZmXjYh3ARcejtm6p6tQaGIfadIPm26GeZKI9ig&oe=6A9FFF5E"}, {"file_name": "migrated_image.png", "id": "513728509566749", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138833_1021436187920514_1333976237_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmzqJDwHFbgQ7kNvwEk0hX_&_nc_oc=AdpE2b-lrgsuvrh8X9Po7D5um3ri7Cvon6qd_Z3fxke-Mmwv1wI8PLQC6kJz_z016hI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaijTYv2zmS76g--tP9IEdC-jxhQkXZkBsauAfPzLz7w&oe=6AA02D8C"}, {"file_name": "migrated_image.png", "id": "209252160182922", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138787_457869757734084_1143974185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adHnrRFSFIgQ7kNvwFGugJR&_nc_oc=AdoIay9AWtwkmLNg-ag-A1MKl5CJlo6dt320bHMg3U-FRUzlXPJifAgroEh-hFnO_rY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv4JnxbzNc9U4irZrnr-fmkAxoA1nUEQApfNgijA_Blg&oe=6AA02D82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mega Spacehole", "keywords": ["Mega", "Spacehole", "Arcade", "shooter"], "long_description": "New Low Price: $2.99\n\n\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\nMega Spacehole is a fast paced vr-cade shooter that puts you in the center of the action. Survival depends on your lightning reflexes and strategic decisions.\n\nEach spacehole is a unique and challenging arena you must survive, and ultimately master, to become the new Mega Spacehole.  Unique powerups are placed in each arena to destroy your enemies and restore your shield. The more shield strength you have at the end of the level, the higher your score - If you can last that long!\n\n", "short_description": "\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.megaspacehole.com/", "developer_terms_of_service_url": "http://www.megaspacehole.com/", "publisher_name": "Furious Union", "support_website_url": null, "website_url": "http://www.megaspacehole.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485791169585186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138836_784339765027905_1065375798_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWhFbh_8YOoQ7kNvwFXdh4w&_nc_oc=AdofMew2bDDiPZYOdorKfh2a88006W8QTjZIRQVIAjPdfH-ekCUsBY1imDiarNFzpC4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIArJPu2OPr0hxyb1CwYGivnYZWD8mbiWkjxC0wQsRR5w&oe=6AA00EA4"}, "is_concept": false, "is_test": false, "is_trial_o
71-25/12138838_1550162895294105_1476230678_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCjRiQf_jmgQ7kNvwGyIF6D&_nc_oc=AdqYYiHvG7xcGPAv_yszbMl7qszmw7uB4J5XZOHriEUvNw7xHwg1RGjj3tTm7CVpeak&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbzIrQ_Lg7P3c9izbMb0Aa7fkdJuZPl0fwXJnVIpHZcQ&oe=6A8EDBDE"}, {"file_name": "migrated_image.png", "id": "513728509566749", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12138833_1021436187920514_1333976237_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtwQdipPEsYQ7kNvwGACl4_&_nc_oc=Adot_0t42r2HUwLYeRheUergiO2V5CBP8uXbqzY0MLUMK6AYucLido2oQw9-gCXR5cA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWlov2kOzMW69MDuRGAOcExKoSJ5ObbsyuEAhd_sbpcw&oe=6A8ED1CC"}, {"file_name": "migrated_image.png", "id": "209252160182922", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12138787_457869757734084_1143974185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgcOmce6-9wQ7kNvwH4Oqfv&_nc_oc=AdpJ6zd7rlxMyxS3wDdltbyi-pLm7BneDIESA1qJ908wPvCLoUXfWv6WM_9-eJLGj3w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8fcapjlLt7eJHvCKCCOaRtZbkxSixwjFdkhnC9EiLhA&oe=6A8ED1C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mega Spacehole", "keywords": ["Mega", "Spacehole", "Arcade", "shooter"], "long_description": "New Low Price: $2.99\n\n\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\nMega Spacehole is a fast paced vr-cade shooter that puts you in the center of the action. Survival depends on your lightning reflexes and strategic decisions.\n\nEach spacehole is a unique and challenging arena you must survive, and ultimately master, to become the new Mega Spacehole.  Unique powerups are placed in each arena to destroy your enemies and restore your shield. The more shield strength you have at the end of the level, the higher your score - If you can last that long!\n\n", "short_description": "\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.megaspacehole.com/", "developer_terms_of_service_url": "http://www.megaspacehole.com/", "publisher_name": "Furious Union", "support_website_url": null, "website_url": "http://www.megaspacehole.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485791169585186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12138836_784339765027905_1065375798_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pANcpU2XhJIQ7kNvwEyCmZu&_nc_oc=AdpKRqerdteAXY_lNl6VqgOOpLNJhiRscj1jquNKTizBI4GW_Nt7oED-pnVtXg5KbAM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjqSRbeZ1dM0Z-5kcajMgFtHLZ2nFQzEzjdoIY9BpWkg&oe=6A8EEB24"}, "is_concept": false, "is_test": fa
8838_1550162895294105_1476230678_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jrqmtWeq-0Q7kNvwEBDue3&_nc_oc=AdojCOPWpe2cieLErt6-F8k2vO6JznZk4eln5MlgnMjx4KVcL5-iaVEvYj735mWDsK4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF3pAV9o-z9mpxtz-g6W8lMWAHJf1wOzgtXaRVnVaxXA&oe=6A8995DE"}, {"file_name": "migrated_image.png", "id": "513728509566749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138833_1021436187920514_1333976237_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxIRiJR9_SAQ7kNvwHhtCYE&_nc_oc=AdrhzgLjR5TQmoYxJriDDZ-Ix0Awau9R7i34ZlIVktDdXwsnXs2d6kBeckRcCWwPkCI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJGIWtAXJ2HmpKkl1fO1K9K6Eq9Rb3NdhhsjHOsU-m-Q&oe=6A898BCC"}, {"file_name": "migrated_image.png", "id": "209252160182922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138787_457869757734084_1143974185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ce7iIBmnBUQ7kNvwHdJWr5&_nc_oc=AdoKlk0_aN_xcpjgXkYdMgxcvfJncBgX8KR0jYPoD_hvEWRPHZ86keR5nciIef_CUTM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdswsGHFlu5B66doglS7F5cRGPn4gdT9zS9zVtaDb2Pg&oe=6A898BC2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mega Spacehole", "keywords": ["Mega", "Spacehole", "Arcade", "shooter"], "long_description": "New Low Price: $2.99\n\n\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\nMega Spacehole is a fast paced vr-cade shooter that puts you in the center of the action. Survival depends on your lightning reflexes and strategic decisions.\n\nEach spacehole is a unique and challenging arena you must survive, and ultimately master, to become the new Mega Spacehole.  Unique powerups are placed in each arena to destroy your enemies and restore your shield. The more shield strength you have at the end of the level, the higher your score - If you can last that long!\n\n", "short_description": "\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.megaspacehole.com/", "developer_terms_of_service_url": "http://www.megaspacehole.com/", "publisher_name": "Furious Union", "support_website_url": null, "website_url": "http://www.megaspacehole.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485791169585186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138836_784339765027905_1065375798_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9MVqr02DGsQ7kNvwEUMZ4U&_nc_oc=AdroSCDOIv8ud4RS13kAiTW2Z3eThIsldsWaMyUscFDSn5i4gU_oF9s2y3FF43QTbto&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOzgEPFBkoduu0Mit90NbtxwFmn642KwiDLRdk4gP-SA&oe=6A89A524"}, "is_concept": false, "is_test": false, "is_trial_o
8838_1550162895294105_1476230678_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIX-vYb6s58Q7kNvwF11aCP&_nc_oc=Ado8X2xI3malXdgN-6ysdPLz4ELm4cS1pyB78Y3pb50pI4L5tex9TFYHjT6s1wPbddY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbTnQKXFiNvpFKw8H1R1207cXe5kYPUWzumRVh5_N1iA&oe=6AF9DD9E"}, {"file_name": "migrated_image.png", "id": "513728509566749", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12138833_1021436187920514_1333976237_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alFouLydyCEQ7kNvwGoDyEE&_nc_oc=Adqx44tpLDJovEUVWueeNq22VN7pdBspefVpW-uvshV7wY6cId4O-rQr5leg3Oa6_14&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGN0p-yyYp5JVFUCUckxcO3-RLIaCNhxFBw_BQy9PBBQ&oe=6AF9D38C"}, {"file_name": "migrated_image.png", "id": "209252160182922", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138787_457869757734084_1143974185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=se2-chpE-H4Q7kNvwG_RGb8&_nc_oc=AdqOGtZVNQeiNN30uIDxg11GsdR85_w_2V1YCsccACD-tarkbVLxDK1n1i37UrkkidI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_iWccUjw2QG8gmWT2cRSMN35mQfAOGGfZ-ULTrKN6YQ&oe=6AF9D382"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mega Spacehole", "keywords": ["Mega", "Spacehole", "Arcade", "shooter"], "long_description": "New Low Price: $2.99\n\n\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\nMega Spacehole is a fast paced vr-cade shooter that puts you in the center of the action. Survival depends on your lightning reflexes and strategic decisions.\n\nEach spacehole is a unique and challenging arena you must survive, and ultimately master, to become the new Mega Spacehole.  Unique powerups are placed in each arena to destroy your enemies and restore your shield. The more shield strength you have at the end of the level, the higher your score - If you can last that long!\n\n", "short_description": "\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.megaspacehole.com/", "developer_terms_of_service_url": "http://www.megaspacehole.com/", "publisher_name": "Furious Union", "support_website_url": null, "website_url": "http://www.megaspacehole.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485791169585186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138836_784339765027905_1065375798_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zD_HV1eJUxwQ7kNvwHqVwGF&_nc_oc=AdqkdeMJZ97csD0G5SPoHa-dVTZ5D7t0rgQsNkC3b8G8RiGPByfsmW5_yhAvLP78s1k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFmMd1onlDv5Uzifa0_8Grc_OP_n1DTiGGS3aGb8K9bQ&oe=6AF9B4A4"}, "is_concept": false, "is_test": false, "is_trial_o
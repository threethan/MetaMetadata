ontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2MGsRK5DcsGhHMQugCtCzMBgr62WVi2kTofY2yCZIEQ&oe=6B0862FE"}, {"file_name": "migrated_image.png", "id": "535716207137820", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138838_1550162895294105_1476230678_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyU0_GHd0oQQ7kNvwG3-0iJ&_nc_oc=Adr-d8Ej21zIRprxh6-vfwZJDd0LXCKVDlQTcarGRMoj3qdV_QDwTUzfvXN_J8zuvpE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKAWNNllH92e_dg-f3AEUmfxwil-IYYB2zIGKH755uDg&oe=6B085E1E"}, {"file_name": "migrated_image.png", "id": "513728509566749", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/12138833_1021436187920514_1333976237_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdOm0HxaI7EQ7kNvwH8cK92&_nc_oc=AdozAw5f68NEvyvfwXCgvnDE-LuqycNJ587wQg8cNERHfIT1_RV5Ypm4Od7drpr8lNY&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZUP9unKUqoBc6DbfAqgz-itGg5ix-iP7eV3yyZGhs-Q&oe=6B08540C"}, {"file_name": "migrated_image.png", "id": "209252160182922", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/12138787_457869757734084_1143974185_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KS8MfR0ozGQQ7kNvwEkF3ny&_nc_oc=AdqANsC-D79HFnk0lhxde7Bl9Eumf6qvpk3cQCE6QZ5dk_s3QwHzr8Yd94VfOVV32zw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjH5JPz0FUr34ssXoRp4rQNp-_ckCNrfbwpYcJuFzPDw&oe=6B085402"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mega Spacehole", "keywords": ["Mega", "Spacehole", "Arcade", "shooter"], "long_description": "New Low Price: $2.99\n\n\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\nMega Spacehole is a fast paced vr-cade shooter that puts you in the center of the action. Survival depends on your lightning reflexes and strategic decisions.\n\nEach spacehole is a unique and challenging arena you must survive, and ultimately master, to become the new Mega Spacehole.  Unique powerups are placed in each arena to destroy your enemies and restore your shield. The more shield strength you have at the end of the level, the higher your score - If you can last that long!\n\n", "short_description": "\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.megaspacehole.com/", "developer_terms_of_service_url": "http://www.megaspacehole.com/", "publisher_name": "Furious Union", "support_website_url": null, "website_url": "http://www.megaspacehole.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485791169585186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/12138836_784339765027905_1065375798_n.png?stp=dst-png_s360x360&_nc_cat
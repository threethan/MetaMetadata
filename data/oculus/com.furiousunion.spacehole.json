8838_1550162895294105_1476230678_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iiEgfAF358Q7kNvwHXyZl6&_nc_oc=AdqS4VtQmf9gSwNesRBg69uRcy2WFW35_MkKIwUrHqtAaymtJ1pDZ1bFi_bcHKpryW8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WBqAHXjx0Cdaqmj2Dw_0IOtSdIPIRrYS0_oivLmLdIA&oe=69D2555E"}, {"file_name": "migrated_image.png", "id": "513728509566749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138833_1021436187920514_1333976237_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-beQc3jTi2sQ7kNvwFrN-d0&_nc_oc=AdowHPXb6QBBqwAFWk0qG0wzuvYzmsOxfFRKtnbYSUNEaqkp0lBRgi_j6mukRtSum-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hIC0sNJOwmzM1Z0XR5F-pXY6Us4ubINIs3yK7p49mpA&oe=69D24B4C"}, {"file_name": "migrated_image.png", "id": "209252160182922", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_457869757734084_1143974185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frM07Kw5GBUQ7kNvwHq1D1E&_nc_oc=AdofgRuB3bwZ2z-17kelahajLu8U_F52KoCNfnTOMX12Vzy4f3H_dPIKlFLeUo_EcVY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TpYuTrP0-57ni8l2RSCOITniyl0eR8oEJzPQhmpqDAg&oe=69D24B42"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mega Spacehole", "keywords": ["Mega", "Spacehole", "Arcade", "shooter"], "long_description": "New Low Price: $2.99\n\n\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\nMega Spacehole is a fast paced vr-cade shooter that puts you in the center of the action. Survival depends on your lightning reflexes and strategic decisions.\n\nEach spacehole is a unique and challenging arena you must survive, and ultimately master, to become the new Mega Spacehole.  Unique powerups are placed in each arena to destroy your enemies and restore your shield. The more shield strength you have at the end of the level, the higher your score - If you can last that long!\n\n", "short_description": "\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.megaspacehole.com/", "developer_terms_of_service_url": "http://www.megaspacehole.com/", "publisher_name": "Furious Union", "support_website_url": null, "website_url": "http://www.megaspacehole.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485791169585186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138836_784339765027905_1065375798_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7W9rfBi_9sQ7kNvwFOkfvG&_nc_oc=Ado0sYkqbbfgY349R3V0pvtV_BasR0TYGGcBQryoUpWLKBfNRRbz2OO3bez9-l6FKS0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QYKij7sU7oU5igkiF5pAzDnzQ0m7svZgr00G9B1w3lQ&oe=69D264A4"}, "is_concept": false, "is_test": false, "is_trial_o
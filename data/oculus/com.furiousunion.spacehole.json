ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n32sHn9xzmwQ7kNvwEZ7eLE&_nc_oc=AdrW7C4UQG4K1nNeFdxZXHipBxPD41YdaxBduzJCwOxSoz5YuH-qdhc52-sUXhK8JO4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxruNUaTM4NPOzbvagCuzMOYcl5gzRvUmUdgwn0MrIG4A&oe=69C131DE"}, {"file_name": "migrated_image.png", "id": "513728509566749", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138833_1021436187920514_1333976237_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBoWLHN5PDkQ7kNvwHoM-O8&_nc_oc=Adq5i1XG-8J0KbsrbIqw128-7Nx6SEVbtfYlg_gEM2r7QYdsTBvpcbWuWGHpfvEihzI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfziRNW2R4WH_q-2PPhNNU8oUVpa31YZ7O2R2UFpX8LigQ&oe=69C127CC"}, {"file_name": "migrated_image.png", "id": "209252160182922", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138787_457869757734084_1143974185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6LXmlGKdBAQ7kNvwH1xRJu&_nc_oc=AdoATa_KhYviApdGAksbFaTNM8ikYYHvPfzqa7ut0acI-R47pAAfSe9XZp_lMTYjngs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdTU4-HB-X0EZWIBgtR3pZbft-ls_XgXmq2-RwLDKsIw&oe=69C127C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mega Spacehole", "keywords": ["Mega", "Spacehole", "Arcade", "shooter"], "long_description": "New Low Price: $2.99\n\n\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\nMega Spacehole is a fast paced vr-cade shooter that puts you in the center of the action. Survival depends on your lightning reflexes and strategic decisions.\n\nEach spacehole is a unique and challenging arena you must survive, and ultimately master, to become the new Mega Spacehole.  Unique powerups are placed in each arena to destroy your enemies and restore your shield. The more shield strength you have at the end of the level, the higher your score - If you can last that long!\n\n", "short_description": "\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.megaspacehole.com/", "developer_terms_of_service_url": "http://www.megaspacehole.com/", "publisher_name": "Furious Union", "support_website_url": null, "website_url": "http://www.megaspacehole.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485791169585186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138836_784339765027905_1065375798_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-AmN2VhQH8Q7kNvwEmb20o&_nc_oc=AdoIy0M0p3MzI_i0mviQ80t-uHCOlTY_0hJCa6D7eXw0YbLm_nGBpI4VDgd_-8APzH0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNGcCYlNltPciLE8IquA584IxmFsy5Tu418-Bkxh1uTg&oe=69C14124"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mega Spacehole"
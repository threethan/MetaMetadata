8838_1550162895294105_1476230678_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLd4FhNzhvIQ7kNvwG2eYty&_nc_oc=Adr4SgVCEi2t1G67siOfrG-zo31PEjCQePrt-C8Qve6RFIAjb9bI8K8LVKQbw_CwqpY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk1ZnqG7bV9-v6fkN_Nbe5M34pmfY7ZApGnnL0gjhVZQ&oe=6AEF519E"}, {"file_name": "migrated_image.png", "id": "513728509566749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138833_1021436187920514_1333976237_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-ac0UpnhOwQ7kNvwHPqP6J&_nc_oc=Adp9qnzkom4nkLEfpWoIteeuzt7bl9CpbRHRrSDEsoGjhvM1EjaEGuxjgHhqQXCZr0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-I7n4tLpghjrLqAyxLU1elCpE0OkEbLYA-TzaMfbYDQ&oe=6AEF478C"}, {"file_name": "migrated_image.png", "id": "209252160182922", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138787_457869757734084_1143974185_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTDTOIFI0g4Q7kNvwFOCYJs&_nc_oc=Adq1uTW0rBdKByxh17Rua2NUuyV28T06I6lczUl7lRLFS8juXfFjCetSifZtySNTdQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzYuOhfZDiP6brG4vy74wz7PPTvF7FSdIgzmLoPsbziA&oe=6AEF4782"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mega Spacehole", "keywords": ["Mega", "Spacehole", "Arcade", "shooter"], "long_description": "New Low Price: $2.99\n\n\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\nMega Spacehole is a fast paced vr-cade shooter that puts you in the center of the action. Survival depends on your lightning reflexes and strategic decisions.\n\nEach spacehole is a unique and challenging arena you must survive, and ultimately master, to become the new Mega Spacehole.  Unique powerups are placed in each arena to destroy your enemies and restore your shield. The more shield strength you have at the end of the level, the higher your score - If you can last that long!\n\n", "short_description": "\u201cI love this game\u201d\n-Twisted VR\n\n\u201cIt\u2019s wonderful\u2026there\u2019s no other game like it.\u201d\n-Gear VR News\n\n\u201c\u2026you\u2019ll have a blast with Mega Spacehole.\u201d\n-VR Giant\n\nObliterate the enemy with your mighty gaze. Dominate each arena with the mere turn of your head. Master every level and become the Mega Spacehole you were meant to be. \n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.megaspacehole.com/", "developer_terms_of_service_url": "http://www.megaspacehole.com/", "publisher_name": "Furious Union", "support_website_url": null, "website_url": "http://www.megaspacehole.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "485791169585186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138836_784339765027905_1065375798_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eh-Bi4MM7sQ7kNvwGZS2S4&_nc_oc=AdrS3GMArMO7rsKY0ilGnGBFSbR5-PB0-IiJM_vahvALiGil7lNpRgvNKgJu573KgM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3wpaBFX62Alz1Z84prNSEmJOFVi_YkiCyzj7JuxZ6mA&oe=6AEF60E4"}, "is_concept": false, "is_test": false, "is_trial_o
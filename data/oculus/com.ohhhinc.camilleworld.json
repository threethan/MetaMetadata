bnail": {"file_name": "Title_2560x1440_ver1.png", "id": "1596233751961843", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622184_1596233755295176_8076945324368250134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELfp9RjYhBgQ7kNvwGHhNC2&_nc_oc=AdoVWI7SgQi5Ar9I3vKv5mhvASHWhaIv2bwRQz8P1IQtFutd24U63aSWRHICQBWYhzc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTis0qkUN5gjI4oDbQEboHdqp4CpCfEO5ZBitMmgIVXgQ&oe=6AF9DC5E"}, "display_name": "Camille World XR", "keywords": [], "long_description": "Welcome to Camille World XR \u2014 a playful 3D world where you can explore, solve puzzles, and interact with items.\nGuide your character through immersive environments and discover how the world responds to your actions. Use pathfinding to move your character naturally through each space and interact with items \u2014 walk over to a chair and sit down, find a bed and lie down, and explore the many details hidden throughout the world.\n\n- Explore UGC Worlds\nDiscover worlds created by the Camille World community. Each world can offer a different environment, challenge, or experience to explore.\n\n- Solve Puzzles\nExplore the world, find clues, and figure out the next item to complete its challenges.\n\n- Interact With the World\nYour character can navigate through 3D environments and interact with items using AI pathfinding.\n\n- No login required. Jump in and start exploring.", "short_description": "Explore a playful 3D world, discover user-created worlds, and interact with the environment through immersive character movement and puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ohhh-inc.com/privacy-policy", "developer_terms_of_service_url": "https://www.ohhh-inc.com/user-agreement", "publisher_name": "Ohhh Inc.", "support_website_url": "https://www.ohhh-inc.com/contact", "website_url": "https://www.ohhh-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_catego
- Interact With the World\nYour character can navigate through 3D environments and interact with items using AI pathfinding.\n\n- No login required. Jump in and start exploring.", "short_description": "Explore a playful 3D world, discover user-created worlds, and interact with the environment through immersive character movement and puzzles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ohhh-inc.com/privacy-policy", "developer_terms_of_service_url": "https://www.ohhh-inc.com/user-agreement", "publisher_name": "Ohhh Inc.", "support_website_url": "https://www.ohhh-inc.com/contact", "website_url": "https://www.ohhh-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1387608037767549"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1119380510607227"}]}, "baseline_offer": {"id": "1119380510607227"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792380060, "status": "PUBLISHED", "id": "1119380510607227"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1387605167767836", "version": "14"}, "id": "1404289247884089", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__i
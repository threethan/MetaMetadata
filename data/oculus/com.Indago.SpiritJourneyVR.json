id": "661856761291852", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386365_1754821228068985_1760708586_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWhl9g2z4LsQ7kNvwGV5AUL&_nc_oc=AdnZ7P3lwN-vZ-ymu1JpwerldD1ubThfeCDupbJ50rY0DZJIXWtW47nRzh1_oL232-4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdvZIOHzdVY_YVF45ICcHxGExi6g4cs6zs-WmgXxsGIw&oe=69BD2AAD"}, {"file_name": "migrated_image.png", "id": "572785376782082", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12602337_1313453538689307_1152795255_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlX9QSrtqWMQ7kNvwHZbxvS&_nc_oc=AdlZRDfnQJ-NRbr_PEQUmC_t41wQ8gv7HTiqD-AQnGmp3wYBFsya-4jYNgRpuwIoz5g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwwgwkgm_JPGr0YW42oWn2P5X_EwObwIc1t-INOvedcsQ&oe=69BD58B6"}, {"file_name": "migrated_image.png", "id": "522630592016738", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410242_148626835581980_299381781_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqiwgSMQZSUQ7kNvwEH9xDu&_nc_oc=AdmOUBT7YIVU07uJHnW8wxCqqQ2Irfkok3gCzA5YtmMIqeWdf9P8JTn9YrFQvzL_Lvg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUPUu-jW5whqqSPsc443lvv9vROYEDyJ0n2pZYn5bHfA&oe=69BD524C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spirit Journey", "keywords": ["asia", "journey", "spirit", "grappling", "exploration"], "long_description": "You will embark on a spiritual journey inside yourself. Lanterns floating in the air will guide your way through the pitfalls of your own thoughts and memories. You will have to find them quickly and aim precisely to pull yourself towards them. Fight gravity pulling you towards the abyss or spikes! Beating all of the 10 levels placed among Asian floating islands will require a calm mind and a fast hand - do you have what it takes?\n\nSpirit Journey is a non-violent shooting game, offering 10 amazing levels. You can play using a BT controller or the touchpad. Like the game and want more? Be sure to let us know, and we will make updates with new levels!", "short_description": "Embark on a spiritual journey into your own mind! Use your willpower to pull yourself towards lanterns floating in the air, but be quick and precise - otherwise you will fall into the abyss or get impaled on spikes! Get ready to conquer 10 challenging levels and fight merciless gravity!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/spiritjourneyvr/", "developer_terms_of_service_url": "https://www.facebook.com/spiritjourneyvr/", "publisher_name": "Indago", "support_website_url": null, "website_url": "https://www.facebook.com/spiritjourneyvr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "497850938567795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12602103_710537365762797_1097881728_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfg86O2JOnoQ7kNvwEhLm_n&_nc_oc=AdnA2mpif44AnuXIo7dfu3-HQ8UFxCXHZHT37PiL40awHqAWOZU1ztVhrr7C66-5oeA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSE72ahHTNfbL2cFP4cCkn0TwkFJNkw_lSRse9Ng1_-g&oe=69BD5490"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spirit Journey", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1471417200, "lastRevision": {"nodes": [{"id": "1045302075519332", "release_type
id": "661856761291852", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386365_1754821228068985_1760708586_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWhl9g2z4LsQ7kNvwGA4rvH&_nc_oc=AdnUC3Y-m60aj0PmXMOJETd84jGPwB12vyAEIwwnenbaGXHYWyyTS3ydR54AbBtD76k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxNw1Z3jtuyIA2Z3dP0WA9wCMNBh0dMfLobN66lj-yERw&oe=69BA87AD"}, {"file_name": "migrated_image.png", "id": "572785376782082", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602337_1313453538689307_1152795255_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlX9QSrtqWMQ7kNvwHlPmce&_nc_oc=Admwnf9psZB4EeoX611wme_xcoG_hpxkfsT-1XrrGMfLK4d-qL8WHTflUh9y_TDtmaY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyjMa9IZ8c4T77YBr9a9pKA9MlY7dlynNlxu6YLdcNxDA&oe=69BAB5B6"}, {"file_name": "migrated_image.png", "id": "522630592016738", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410242_148626835581980_299381781_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UbVYbkf_NkQ7kNvwHD3dUa&_nc_oc=Adl2wrcgD-0v3Uv_X5R64RxGkpHZ6XmFJ9ERQ5JaCXOqlktfhowvKT1oClaCXoJnl0Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwKzglk3fdOaKu_suDBdqVZhnrWnNZM7uSmmYnYmiL5zw&oe=69BAAF4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spirit Journey", "keywords": ["asia", "journey", "spirit", "grappling", "exploration"], "long_description": "You will embark on a spiritual journey inside yourself. Lanterns floating in the air will guide your way through the pitfalls of your own thoughts and memories. You will have to find them quickly and aim precisely to pull yourself towards them. Fight gravity pulling you towards the abyss or spikes! Beating all of the 10 levels placed among Asian floating islands will require a calm mind and a fast hand - do you have what it takes?\n\nSpirit Journey is a non-violent shooting game, offering 10 amazing levels. You can play using a BT controller or the touchpad. Like the game and want more? Be sure to let us know, and we will make updates with new levels!", "short_description": "Embark on a spiritual journey into your own mind! Use your willpower to pull yourself towards lanterns floating in the air, but be quick and precise - otherwise you will fall into the abyss or get impaled on spikes! Get ready to conquer 10 challenging levels and fight merciless gravity!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/spiritjourneyvr/", "developer_terms_of_service_url": "https://www.facebook.com/spiritjourneyvr/", "publisher_name": "Indago", "support_website_url": null, "website_url": "https://www.facebook.com/spiritjourneyvr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "497850938567795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602103_710537365762797_1097881728_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UG8Tn3HSzU0Q7kNvwEZ5cBB&_nc_oc=Adnn4TQo30fGC7A1zi_NVGLrFEqLafJff3-pGn2Ww4r2IHdzxRzY8NOVFLfK1Vnuc2E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwpGKpMBY5-ZW_bxM5NtKlr5lSH-kbLugUGITKzat8liA&oe=69BAB190"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spirit Journey", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1471417200, "lastRevision": {"nodes": [{"id": "1045302075519332", "release_type
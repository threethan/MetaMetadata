25/12386365_1754821228068985_1760708586_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIcxQPg-AWEQ7kNvwFo_goK&_nc_oc=AdliJicpTOQmrXN7BlxJJwWEo50PCCPK3k1GQv5c7_irQ4vTJXMeCYRimuWrFZflJRA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftiCjOS6b5ZQIhvCr6tctyu8n0pevoo_zWxuv05xp8aLQ&oe=6999922D"}, {"file_name": "migrated_image.png", "id": "572785376782082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602337_1313453538689307_1152795255_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG1ggZqbVpUQ7kNvwEgWPfG&_nc_oc=AdkNISV4vj6OyxNsPLe_CsIe9YR4xEZOSt_h1SCHFbBOjvEBkYzmItfOCgpFAZX3QSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuwS9TEM5ISdtAtL1qEDpKZizTWyyHDK9tRQkxpsXpkPw&oe=6999C036"}, {"file_name": "migrated_image.png", "id": "522630592016738", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410242_148626835581980_299381781_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK-RhY7IRr8Q7kNvwEdB45v&_nc_oc=AdkGBK6SgxIucF5uQ39L9AE2RmJqOnOy18m7Zlir8hVpXA1yME_OBofOxk-3L3FXsHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsIkXDkCVJJaHKi75msA1zz-3yMk9l-fZCUqJQqMhrvtg&oe=6999B9CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spirit Journey", "keywords": ["asia", "journey", "spirit", "grappling", "exploration"], "long_description": "You will embark on a spiritual journey inside yourself. Lanterns floating in the air will guide your way through the pitfalls of your own thoughts and memories. You will have to find them quickly and aim precisely to pull yourself towards them. Fight gravity pulling you towards the abyss or spikes! Beating all of the 10 levels placed among Asian floating islands will require a calm mind and a fast hand - do you have what it takes?\n\nSpirit Journey is a non-violent shooting game, offering 10 amazing levels. You can play using a BT controller or the touchpad. Like the game and want more? Be sure to let us know, and we will make updates with new levels!", "short_description": "Embark on a spiritual journey into your own mind! Use your willpower to pull yourself towards lanterns floating in the air, but be quick and precise - otherwise you will fall into the abyss or get impaled on spikes! Get ready to conquer 10 challenging levels and fight merciless gravity!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/spiritjourneyvr/", "developer_terms_of_service_url": "https://www.facebook.com/spiritjourneyvr/", "publisher_name": "Indago", "support_website_url": null, "website_url": "https://www.facebook.com/spiritjourneyvr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "497850938567795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602103_710537365762797_1097881728_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgXo4LphdbAQ7kNvwHFME_2&_nc_oc=Admb2K7NXv7p0IuZMpVOxfE5C40j9ijJ5z1W6w9WC521HYujOZWNVRCj2mcEfvqKDGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsGxtXiVfMd92w1OFd8pBJnjVcxrt8ODBdUOHgOfrE4hg&oe=6999BC10"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spirit Journey", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1471417200, "lastRevision": {"nodes": [{"id": "1045302075519332", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id"
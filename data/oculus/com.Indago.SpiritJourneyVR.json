B94"}, {"file_name": "migrated_image.png", "id": "661856761291852", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12386365_1754821228068985_1760708586_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyvmuIWpCTgQ7kNvwGUbUlB&_nc_oc=AdoteiVhWlohY3rzcVWNJ1cLeH0Rj-IB1bioN4t2ToQFg65Lh6ubK8f5r6Q4LT0Vcgw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcClDEHQp2tXlIXw1QOx48qTIT60abBjQUgjRZAblfmA&oe=6A8D77AD"}, {"file_name": "migrated_image.png", "id": "572785376782082", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12602337_1313453538689307_1152795255_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RICb9lFdMIQ7kNvwG0AXHr&_nc_oc=AdpPSITtH3pIl9foIKY-Zp3xuQK1iAT5yi1CC0e4MiXzn7Ov8Zp3kYtm8XZpG2OR5_8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4V1JWMMQpA1kuF1n-Lnsqg4Q3JMAen6Ynh7tKwDFLHw&oe=6A8D6D76"}, {"file_name": "migrated_image.png", "id": "522630592016738", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12410242_148626835581980_299381781_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSrSyTcb0tYQ7kNvwHtqD2n&_nc_oc=Adrnl7TgKwq8wv-yjlVOaOIrlAMIFyTK7fIzF_03qLnFZb5vJdoWtP0Kt_NaqpqHMW4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEep-C_P_2PJeUtlxXsEh9Z639RRAJltTYDYVgTFoqxdA&oe=6A8D670C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spirit Journey", "keywords": ["asia", "journey", "spirit", "grappling", "exploration"], "long_description": "You will embark on a spiritual journey inside yourself. Lanterns floating in the air will guide your way through the pitfalls of your own thoughts and memories. You will have to find them quickly and aim precisely to pull yourself towards them. Fight gravity pulling you towards the abyss or spikes! Beating all of the 10 levels placed among Asian floating islands will require a calm mind and a fast hand - do you have what it takes?\n\nSpirit Journey is a non-violent shooting game, offering 10 amazing levels. You can play using a BT controller or the touchpad. Like the game and want more? Be sure to let us know, and we will make updates with new levels!", "short_description": "Embark on a spiritual journey into your own mind! Use your willpower to pull yourself towards lanterns floating in the air, but be quick and precise - otherwise you will fall into the abyss or get impaled on spikes! Get ready to conquer 10 challenging levels and fight merciless gravity!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/spiritjourneyvr/", "developer_terms_of_service_url": "https://www.facebook.com/spiritjourneyvr/", "publisher_name": "Indago", "support_website_url": null, "website_url": "https://www.facebook.com/spiritjourneyvr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "497850938567795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12602103_710537365762797_1097881728_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QayG-WWzd50Q7kNvwHWx7fG&_nc_oc=Adrt19od5LCIBZ9DQGj8HawHIra9GzpP6PUoR2Vyih9z-i3jnNK4P_BP_CF91904WB4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfGX1N9z5vnmyNXNX8k-XfLRrkVpTyHraNPCVmwo3qNQ&oe=6A8D6950"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spirit Journey", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1471417200, "la
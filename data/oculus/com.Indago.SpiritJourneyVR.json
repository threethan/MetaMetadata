25/12386365_1754821228068985_1760708586_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJPXlbBgFNMQ7kNvwEecL6s&_nc_oc=AdkUThY40aUDo0LBZlI9Qa0N6E_OTeIPhtAtjQEt2hB5rkGKoJEwLGyjuzQ_G4gKFs8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsB1yCpyu5aAOm_fWjNOnmbamlohpKzJTudWfRI1VdFXg&oe=699ED82D"}, {"file_name": "migrated_image.png", "id": "572785376782082", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602337_1313453538689307_1152795255_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9qg94pq5IIQ7kNvwEDUIa1&_nc_oc=AdnfXsg6vm7cC3ULcLQeAQsZ9JWPyxUdTYQGUlP5sDzifgCSb_zLjHlxa0iHYPERYoM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuVjp4LOA7pTqz0lxGHpf9zARsZLnEHmlR40caChZ4nNw&oe=699F0636"}, {"file_name": "migrated_image.png", "id": "522630592016738", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410242_148626835581980_299381781_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oJLEkbdfo4Q7kNvwFX5vjJ&_nc_oc=Adlx41jc65v0GGm5E-nVzeE_Xlbu5VE6dfGMH02__hiU0fY-HoP6_ECOxEy6X5Dforg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsnfdlefKEQfLZ4sCGkgbw3CC5ihYLhXYLNaiC3zb0pYg&oe=699EFFCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spirit Journey", "keywords": ["asia", "journey", "spirit", "grappling", "exploration"], "long_description": "You will embark on a spiritual journey inside yourself. Lanterns floating in the air will guide your way through the pitfalls of your own thoughts and memories. You will have to find them quickly and aim precisely to pull yourself towards them. Fight gravity pulling you towards the abyss or spikes! Beating all of the 10 levels placed among Asian floating islands will require a calm mind and a fast hand - do you have what it takes?\n\nSpirit Journey is a non-violent shooting game, offering 10 amazing levels. You can play using a BT controller or the touchpad. Like the game and want more? Be sure to let us know, and we will make updates with new levels!", "short_description": "Embark on a spiritual journey into your own mind! Use your willpower to pull yourself towards lanterns floating in the air, but be quick and precise - otherwise you will fall into the abyss or get impaled on spikes! Get ready to conquer 10 challenging levels and fight merciless gravity!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/spiritjourneyvr/", "developer_terms_of_service_url": "https://www.facebook.com/spiritjourneyvr/", "publisher_name": "Indago", "support_website_url": null, "website_url": "https://www.facebook.com/spiritjourneyvr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "EXPLORATION", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "497850938567795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602103_710537365762797_1097881728_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zO-RfKRXtYAQ7kNvwF2e-sp&_nc_oc=AdmniWVTPvB1DseTbFPItloBY63R6_cNUpiZtmZtxPqJiNfwP__BuHLBuXZRZKVGDgg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftg6ByUYbKeJ3jNmE6DAJWsPsRTCK_52y4gWVzFE6sVhQ&oe=699F0210"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spirit Journey", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1471417200, "lastRevision": {"nodes": [{"id": "1045302075519332", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id"
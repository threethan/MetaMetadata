BtoY5Vo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKMt4nVsdWrcP2UV9txxvMDYkOkTzUJeqgeWNXFTmVnw&oe=6AEF3CEA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W61QcERGtKQQ7kNvwGNCjv1&_nc_oc=Adp4ST8V1uWJKoYMtiZcHOHlDJkykEn6RuEFkuXq0-aIk3t2WAHofFPK-aNCtaT06-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCGcCkX12OtD1-Yz6VR6i4GFNqi_HaT3489JA08h7d6w&oe=6AEF3FF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hqu9kzUs4AQ7kNvwFd8cgV&_nc_oc=AdqhtNY8optohChAB36Ha3ucb9tvDlEWsfBjaFGanHpL5lQA2OXR58duvbH201MQJy4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkyADBZDMxQkciE-_trRROxwr9-7g_cQC2in73EnShJA&oe=6AEF3A52"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdAmSHIPFFUQ7kNvwG-wloB&_nc_oc=AdrhOTyzJMbPGuspk64n5Rl0Il7hO6Dl__TR3nidtGZKR6FdQwFiXrpyTq3IWYsTr6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx0OyhwEcPzBr7ppQ-5e2tqKZv2YmAXI6r83Hhphv4BA&oe=6AEF5C73"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL6p8K_uDc4Q7kNvwGtQPz_&_nc_oc=AdpOPPtoc0PUaUJ4xTAvvHSiE6OycV_nRYmm0oILTCc5EwQafb0YAWVSi_pPqyR91Vc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOf8wGOghG1PqgBjbJ8sqdVM6tYnT8ALgpI-s25SZixg&oe=6AEF47A5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eBpRmjDG5IQ7kNvwEpWO56&_nc_oc=Adov315e9FB8UeYRUrZ3gqUZDzDaW5Hic26qLE3t7vfW81fjTg5Dj21jRzKr708_LF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGQNcAQW8g179-mTqpTHCYofkpWA9jM9Mcgl3P1f53QA&oe=6AEF3F5F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
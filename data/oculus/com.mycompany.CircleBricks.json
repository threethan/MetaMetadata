L9i-4TY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rql4XyDehXrI3mt2g4JLQOzBnazWxuF1ArfEI1JXp0w&oe=6A3E93EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ug8mGFQtOssQ7kNvwEqBt5C&_nc_oc=AdpU3rl0T83LSi1ODPQ4eFjm9n6T8LnOz3S9W2Lz6LLJNMoP-j6HpBTmmSXB3ntbH0g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80RCBUkB5zqP-4ZKIEbxkLRNJT5NzkiYfes0Nnj9cW4A&oe=6A3E96F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQNqb7dXcxIQ7kNvwFkUnXr&_nc_oc=AdoszRrk6LsVVnIJ6h4xnieniTBXzGBGjoOuIbKPnfq6U0vtUKAumE8uExAZY4C9gnA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z4Jssy1KxHht4t6TWtCHss3-iUDyQMytszBhNXCEK_A&oe=6A3E9152"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_I8eIn-zTHYQ7kNvwHd9F58&_nc_oc=AdoGRBYvHMRMPj3PKWKVhC9U8juePOcxFoiRnhmxTnagVcSk1UsHELGQXwiDqmdKwWE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89rfFR28vAZ6lq6MvwV0ImftpWYwIOEIzTAhAiA9QCKQ&oe=6A3E7B33"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roKxGQFbDPwQ7kNvwEQ2kDW&_nc_oc=AdrZ-DqJr-zL7rQJ8RFN5aplSWbkjbKzQIt7vV-wDPxTMIacSHebTKmhHOEF75BBnNE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ewZABQLszAaZVhruPHzr43v_gxc8nO-3VaDqsfdt24w&oe=6A3E9EA5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hV15srtJDW0Q7kNvwFSa9pJ&_nc_oc=Adp9dWmFO1-Xu-ypnQEfmqZRuSe0L469_6Cmgybive64T3TvwbKaT6yGSVfHd8sKnao&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Tk2dw4OmXdjP67jbWOq72bOMCclgSw2GlzluHTHQP1w&oe=6A3E965F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
F9vDf3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLPLyi62qqU_Ufu8avs8LQnel-cJ2aRdMVfIS6l4x25A&oe=6A9C2E6A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywb0qNosBokQ7kNvwETxqCq&_nc_oc=AdrdxSvePOAjFd-C5lVQAcrvKemsCmB3wRz7nZQH8Q3B77pArhKUrnSszd5Faeuqq68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4C5Mz3JyNLYcCLmL6Cp_V1zI3Xzg3PqAKyjLwj796hg&oe=6A9C3175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPgDTHnWT08Q7kNvwFAsvJI&_nc_oc=Adqy7brBmatxiJuEOe7b2g5KkiNtakiXn4SuCdlUh5xQauq0hNRKxI1-E63LzWVcQBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdakDM-v9JFvy96TrSnzi9xGFbY8Sj8ZU9OflvjHK5fA&oe=6A9C2BD2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVhONzY7quoQ7kNvwFLydvk&_nc_oc=Adr0ZG3e7rAKAV7S13Hu-ZyVbeK80ROu9FxQRK32YloqFTWLSFm6OrHdkcoqmc74ywg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSBgtfMQQGX5e1kY2ItHpmXw-Waw9SEdumT3g00tNRpA&oe=6A9C15B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWdadeqj3IsQ7kNvwEvh33Z&_nc_oc=AdoDDetMZEfmKBigUTiTSBf6-zSbySN3yaJhi0GBL2s6PgI9EBuOll1pZ7F2lYItnTY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVU_pG8aVkPv6LLuPOFSzQn1naAXjXhW3i1gXAm9Fn4g&oe=6A9C3925"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYq5utiQECUQ7kNvwH90-xD&_nc_oc=Adr6gebHuLjH8YxXU8Ou4d37yobKuyyp3_VX3hYE_iUDoU9zFke6bUS_F7BnAISuG-Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlD7badubEktAOIzNBtQ7SKuL0b0leyYYHZXP8q1LExw&oe=6A9C30DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
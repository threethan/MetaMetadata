hZN25cQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbR_kZvWC40kbC4rYSieikuNSXd4IQwja42HTi455SbA&oe=6AB53AEA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ly6oLcLwMXcQ7kNvwFMYkS0&_nc_oc=AdqaAy4AtbKI5AP3rBxfZvgvome1V2U418AmjfOuWPGNikyzS7VXJ5NKnInv4NkpQ7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs7nR0JPJX8zAUBndbtgujbPmW-K_TbPOb3-CC4MJk-w&oe=6AB53DF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eg72UKp3Fm4Q7kNvwEvq7TN&_nc_oc=AdoObm0shjVuermaDylfL_jqP7hdYK1lOqZIwSNk5QrD7ncVQeSgR5kcQa5NaedBwFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUFAWxBqVIkMO8cbiurA-IusefUMIO7KVXTtQCQ-XW3A&oe=6AB53852"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG8TykkhnMwQ7kNvwE21T7J&_nc_oc=AdpwFmauZMcxJf5ch6JxIXoqJUUTx0wYDK7otOXAiUpnJd4lhRnusfTILi5tf5VpOks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8Y2igc5-WjO_2moeHDUjDkzB4nlZB9Ri367asMY_9fA&oe=6AB52233"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84ladOa-ewwQ7kNvwGsezlt&_nc_oc=AdpcfJ3qEfNIguC0QgTTWbMuVU2pIb5YLZ9aV3NubV06-FSH_BTd5lq_LmQcMV23qS4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKk2b-WuQ2rApNdSO63195ry-AYxoLVgQJk4BxURa7xA&oe=6AB545A5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kd40N00zhOEQ7kNvwErw2Jj&_nc_oc=AdpgT_K2fYY_FFh8XhSkR8LqZMWDQl9HVZs44PW0BFeVyWy9UyvIu_kGxzYEsMjjfsU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEMO2BZp17h3yEfU_v7R3O3jT9yKKsFDCWbvdkyU54BA&oe=6AB53D5F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
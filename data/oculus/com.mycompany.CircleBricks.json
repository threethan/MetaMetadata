AJ1i_k4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ItCdmbEi3nyKEn_Iq4kpDeUzKCX_IIsei_jx86EuNfQ&oe=6A15B56A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDmIcRueooQQ7kNvwFZeZ_z&_nc_oc=AdqlBSEblOF8I6c2J0UhcnSoCHPxnp8eSyoaClSZ1DEjK4EUA7N7192jAM6J5-rLmGo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wFvAaWi1NxnOVR4e0Nu9f8imC4n08tyizn7hwqKs8Tw&oe=6A15B875"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amJTrgjK7ncQ7kNvwEs1hHb&_nc_oc=AdorLR96M1Ir2QTjlCe4n_p7vV5YoG_fN9ueR1nbnSLf7PIJfDnQ1C5m5ioCnnfPVpk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ac4J4OE_I8md7TzjF7mXhjJeYUYjWEE2w4tggxheqOA&oe=6A15B2D2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pp0QSC24ns0Q7kNvwFkJAIM&_nc_oc=AdoELq6tBZ2ngBW65k_BHQ308a0wXmS5C9bBh1ErGJY5GADaAZ3MUTx8p25_eiD5ACw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f2b7my4QT7PireCmX2BMO97H3AK7Ymi2XFG2DIxVp2Q&oe=6A159CB3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Z286UUJLKYQ7kNvwHnxT1v&_nc_oc=Adpa2kmwOwjIYQCoCY6vKOxFq1D6OnmWeYVR_x3gs0OQMS4qJGzipsVv4JMFcZZp34w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a06G8DVml5_lYjXbVNV8HfNJ10BbmgbnZwpQ8JA8aDQ&oe=6A15C025"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUXG_Q3Cf8kQ7kNvwFRmjjW&_nc_oc=AdpoG8n3utmdoB5JI_I1LpDcf_3WReSMGB2vPbPMvB_Szu6NfHkHWp0S8jnZZfR8S_Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Kam8qop8wvkKFMP51eBVZCCLDqHX5iNJ86b0JJIDP_g&oe=6A15B7DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
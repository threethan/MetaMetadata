OR68-BY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jATMafuWN_erac17RfbUomHm4e8zrcbIS9pZlfGtz6Q&oe=6A2C1EEA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeH5UpiNAB0Q7kNvwFwTtVU&_nc_oc=AdqPaC_fsDW6y9tm47PJhK93aM2gbpR3HzMGeGUK_261ksxkJc-CJJ6DRYaKzsIhN88&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92KT6Am9MNsJ4TrHGdShqZ0gNetVyuC462ag-AjyJ2ew&oe=6A2C21F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_etssJy2PMQ7kNvwHXZNm8&_nc_oc=Adr2qGi0XGWO9XgsAUxlf_80YXgcdNsns5uNDPqCsIe8L9JCs3wpO8EORAfXZ9hOqqI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9RYo-L0JjYcWeu_9z2xOShAp3dONi6aLk-Q2oxDKbBA&oe=6A2C1C52"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feqsjKEIQBIQ7kNvwGOL0IT&_nc_oc=AdoSYZc-jeKrKCaZbVScTY5-RzngfB0goh2r7RFM5-vF-dQOq9Hb-3jVoxbvPa1s5iQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QIekxUoSZo3UdBdVBgpID_sYiBYLw1hyZESurYbUalA&oe=6A2C0633"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuuK4vhRBPMQ7kNvwFE45aF&_nc_oc=Ado6y3GJ6frOt0ESytW3OPr2vF9zYwX1z83HJLJ7TxnbB0y70-T6DKOY08slpN-nHSU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kE5rRQJLd_twW40I78v6uQ72jGhjvldHz8AQTgmpg5g&oe=6A2C29A5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVEMNgqQVWwQ7kNvwGBkPMz&_nc_oc=Ado1LuomKtSvdZrJPN98GV2euqrO8QW7Z_GN9n3BICSt2qaPmy4vYwFGq5yPz7Nm-QQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IDl1oQBfa3NCQdQp6K7BJAvqakHkAdWDtuPGALk6pdA&oe=6A2C215F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUlBJuCejIYYyEeHJ-coRj3_0oMcgn4RsxqtuVfZspCQ&oe=6AA95AD2"}, "display_name": "Circle Breakout 2D blocks breaker games", "keywords": ["Breakout", "Blocks", "BrainTraining", "Breaker", "Casual"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive"}]}, "developer_name": null, "developer_privacy_policy_url": "https://namcreations.cloudfree.jp/CircleBreakout.html", "developer_terms_of_service_url": null, "publisher_name": "Nam Creations", "support_website_url": null, "website_url": "https://www.facebook.com/share/1VavtPiL5F/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cate
w_AQEsDS9hZEUBMkH4NQMlFap8gxE81M4Ms-jufQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpvPFzhYBhb7_Rke_JfkvR5B61EltyVHbl91gm-ubWJA&oe=6A8D75AA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxsPGTyR4n8Q7kNvwFz_wdJ&_nc_oc=Adq6x5DddaazfXm_5qu-znLYCXIPA22Pahf7YHPOrYRvGajNiZrEjMQGmaDZiF9RqtY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmLNdbbiF6WdnxibZ5P844ML-B6YkfQHJRuVGawPrHHw&oe=6A8D78B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb9P5fSs-6sQ7kNvwHL_imW&_nc_oc=Ado1j2SnFbyf6aO1Fw7I2pQDjeQ6q6sH-mNTo4HYwf7y4QqImeCTXm7ojCfabwesDrI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5ODeZUccXCQQ7n6jy_XWAgbULVzMRz6OlhR2EoTIl5Q&oe=6A8D7312"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLVI2An1bC0Q7kNvwGXPm8U&_nc_oc=AdrXXTi31jS3DX60BWhcUv7A13XHyUTGNfKIbmBgdpBXaPe-szLxDam3Q9HgHf97k2M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_1zQ8dlblSEf2nC0llbq3fW--kcREQsfcln5lmWOQKQ&oe=6A8D9533"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDB_CUST7B0Q7kNvwG6h2YT&_nc_oc=Adp2gzMUBO6f5WSK4Y3CE6PGwozHF_OcYUf5C1kU4EQK7K1WqDqlamEAuwS-TYg_Kjs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4Wo-7nIjvCw0kuvdj57uWHZ0Dwhg-Lxdu_2OPp3VUbw&oe=6A8D8065"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXixm7RY5sUQ7kNvwEtVsG9&_nc_oc=Adq1F9K8bf7F_jAX1P6NfdlKLY-NAwEUpeDQefZfVYvYyT5pjExgwQKv8MFp5gGewpk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDDFvJL9_pmyihxAY4fiT_0aBgE9w1UVpyjNeWpGkkTQ&oe=6A8D781F"}, {"file_name": "CircleBreakout512.png", "id":
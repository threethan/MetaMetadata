60mPiLo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JxUPz1z0bkt8uWEX-d5eSSRddgKvOmcZV9Y2IipBu0Q&oe=69E24AEA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTdlyFVPymoQ7kNvwHeHXk7&_nc_oc=AdrDxbNQfYghU3emgEkjJgjqkec1Ye3kpqzaaD5DmHSBet4rGKR46Q4K6sR_UKFCj4A&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a0jk553pMc2O7yeNdtTkODWkTfpEIgTzZaZinhhFm6Q&oe=69E24DF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWkKJA48BlUQ7kNvwHFc3h9&_nc_oc=Adq_kdfyhtkeMJZ1tiNB504ewYiUJa9jEiuCHiNLwV7LWBmsQRnBonh6j0TCBnRCQsA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eJOVWHDszRjyGHLphMy2C6_vH1aTkpLACc6a8fP0sog&oe=69E24852"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYMVHLL1TQYQ7kNvwGY_riY&_nc_oc=AdpPF6Aaj4lvZrh7HeE_K4tJb4mE20r8g0FX3f75t-fOj92dhqVbMB7k_WUsf3Iaet0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3D0u4Ze6Csi3QLrFDXrHUgBlfvCgsSGMekZq7zADYzPA&oe=69E23233"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEIgDcI28t4Q7kNvwEU8vrA&_nc_oc=Adq3YtpkdtAXaFU5_LpLXyLQmeIw-b7RznDcXO8l5SksKp22NcZj0Kj2It26RI0fyEE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19-EINNr8hL0gpYNu37Z8BHOy3x4S--NXzgHZ8ffclrg&oe=69E21D65"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5DIxtXvpXEQ7kNvwH8uxUy&_nc_oc=AdpDqjNmjzPtPwFl0_Gm9vkrTyt5ij4RnvwbJ6F9sKUoN7GGgjvgPUCoIh_lgCOHK2U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ld-uydAzgjoZyJGmeT4lRq7WTyFB_0TbdESYaNrAm-w&oe=69E24D5F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
I2FO5po&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrQWZMm89stq8xdRTC2lls1yNfwY0aN32Iw3BA8Hlfcg&oe=6A4FB76A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3Hxcbiz99YQ7kNvwGOOGtK&_nc_oc=AdoNlIVxRLUSC1DpaLc6_pjaE2Z4mBjsjXyoTsJC0JQsGGjS1rjjVByfDpE-SR0V3sE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaHOlisQCXcPlvoM0PIZtM0u5z5po4WaCavE97izMG-w&oe=6A4FBA75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2k1lzBZWgcQ7kNvwEZAB8p&_nc_oc=Adre0tSmUfYCjL5xF1fI_Gq9QSu5B4Cn6gDcNvPTtgK1tuNJqDYQ4I3loKCMxUoiLK8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWh23sJGaHtGIN8xrzmVn6MT0HE1w4J11uBoPsk7rkxg&oe=6A4FB4D2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrG24u9VrfUQ7kNvwEpS5dP&_nc_oc=Adq3riGektCVjq6kIs-KFR9BM2SnyiF7ieluChBjpubcFGNfm51VDo55z_oT-hZoKII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWb_muGOUHk7pZ2JDI5XS1nRnWMzgbChp34rWAds_EQQ&oe=6A4F9EB3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aR7vi_FteTMQ7kNvwGwkzSh&_nc_oc=AdrxFmSqLSuJ8fypmn4ykDKCCpln_Oquqh9n4AgfwtE62uhGlsjFl2W2L_IrXJ5p5JM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgCATd95E-rdlfWD3pn_jqmS2F2gSlanKOeVzHFT79ZA&oe=6A4FC225"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrwbwHcRZ5MQ7kNvwFlBjyU&_nc_oc=Adpt66WZwbl484uc0gT6eym3gQI_cQ11pvCpaNFO38wQFG2jtiOlFfGAPL77XclZEd0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxyK13TrsbeBndZDe29E4oVAHMmg7VDTwQH37ujkCJEg&oe=6A4FB9DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
_3M-QQQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkoe7R1oWr7nGh98DykhSPbq_RjIT-0wQDlGH3Wo9edg&oe=6A71FE6A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avgJoE8c8v0Q7kNvwFvf8za&_nc_oc=AdqWYM5cOUrBfDFhYzxxuRleV-V0lKWhEHhlHkekImawMXd4C90Nju1IP5MJX6GRB80&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSojkDsANWMzeVKlANuSK6l9duf-Q95lR_MjBamNDBqw&oe=6A720175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfKdqLL0QEcQ7kNvwFh_e6G&_nc_oc=AdrA1GJpTifR-BrDPU3EFdGgFlNAGAJjYMRNmrfOZs9SVFEo2SXtTD2QGysVwNWX21I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh1zTjE2LDKgqLB9XBkGWBm4bTwxR2ZANKRIyHT9yiZA&oe=6A71FBD2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8l9NzkSbn9AQ7kNvwHB1-A8&_nc_oc=AdrjT0WLUMeR-KTqvPdyUhBGxPmBPJPh6uKXjO88Jv4rQuxmCRsnel5gnvg80ZIz0Q0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExYvdeycrqoQz4gHMznFYpkpvZmj-YRltX8TTr3YyRxQ&oe=6A71E5B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70W7AOzX9JEQ7kNvwG8jxOW&_nc_oc=AdrIhniWq7ry49KRAtdIOG7ouQwLuOjDGtYznCcGSmtmPZrNsCSijfA4JcZcbhhmrxs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjOJWgZmmZC3-iGIXanvFEHzYLJlr6pc2EB2T6VJJk1Q&oe=6A71D0E5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_EAMgWfVogQ7kNvwFeQ_i6&_nc_oc=AdpccVoldhxSlEl2T31xTCFmo7LP85cHsKL7v_1PjQxMTo_FPfADlEhSRupDR2dfVSc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyapkqs_8McG5YuUQF_ZvFUfUbqSkRVTyvvJRfIStINA&oe=6A7200DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
3EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxQhTD031rMQ7kNvwErkHa6&_nc_oc=Adk-gzPsJdPMIftC3isNlvnUEw56N0q1ysekSSWDY3WXpH8nn3IkqH7ZzR2AXKivx7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyK0pwNtXdfkmtvK2dw15OYCGo50KrVGVQK-zgs3BJp9A&oe=69BFCEB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9BQnHwUe9gQ7kNvwHRXCUm&_nc_oc=Adn_4fTG5RzhZj-W1EY9sUUgOFWHZKF_Imk-eBGF9HF6-PyxbK2sK-EzzFQHa0v3dpg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxefrYKgNBtPrrtorFumj1xKJXvVK1Dzlk1jdnnS9WKyg&oe=69C00152"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ml0asrZt5IQ7kNvwEQkiBJ&_nc_oc=AdnE0LxjNnvR2sS1K4sEc9D1IReUfVRplDcR4AdetI2-yaZrXlu6MPxZNGiJw-HDKss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwbG7ti156Cc7LirtQ-oc18XU6YQirrhFV7diHHFdrCVg&oe=69BFEB33"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vemMnEhf8egQ7kNvwFUGXnj&_nc_oc=AdkayRx8fxKUJ9v26CcdEnOnE7HVxBosW_r_lbrLHXWKmKEI6LQq0V_cLgyKsMWv5dg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzyHk5LcokpU29bThS7qc3K9N4qvbiJTicFUUaZ9o7uXQ&oe=69BFD665"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7Ul0reoVC4Q7kNvwHoxWqz&_nc_oc=AdmyPNGDNFtKyfQK2uD3qLYjj1HtUK1Q7jeZr1brKRJkoGvM739x6Jbvq62kYxjXzzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzWPMmPoeZvOLMoXWToyuJ0zeZQClKDGrLWbudQlGHohA&oe=69BFCE1F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1055972959474869_830596178173793119_n.png?_nc_cat=111&ccb=1-7&_
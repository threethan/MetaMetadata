QrMtAKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwg1DtT13G0Z4jGUBOLOxs_YoUUrVrSikQOBJZeqN3gw&oe=6A79E76A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnIichjQiDUQ7kNvwEamp5Z&_nc_oc=AdoEkdc7BHhr8aagPsM_vHJBYhI1tVWxKczQ_APw6ShEfjcG6fpNNhTjGdUABeTofT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsfYPWKnmy-v2In0C0G93VAcVSoBbQ5e_2tIDjlrS2tA&oe=6A79B235"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0q5B9MhylAQ7kNvwH3j46n&_nc_oc=Adryc64PvHXTBLNImvGSiKYMegr7kJDGKK09mrXBGVR4Eriy66DjqLezhSfEZ6XJmz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG61WBEdJsR7MZQ_v404jFmZPiJK9Z_lT6GZb7EEuNjww&oe=6A79E4D2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1q_IXhxkIUQ7kNvwFxKKji&_nc_oc=AdroMudza0Iphfx_N2KWgRQEyMl5ePNhGWSDFbLGgy0wBpC5Zh9_ySaNQCxfYiJCE50&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8GV8ZKxno1DoiXIlMYuqumTJogksRFimgMTazhPmERw&oe=6A79CEB3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNzhnZv1zIIQ7kNvwHZu15M&_nc_oc=Adr9AFk6FtAL6EB1aWxwP8Ilw4KTJ0oGOIjBolcyrQ3Dx1NmzMx7z4xmqrWvyqPpOD4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcafW9GwCz4TG6vF52w-HCAtSahu9JU7Gpw7kRuK47Ww&oe=6A79B9E5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYRK4k9TylgQ7kNvwHQKs3S&_nc_oc=AdqIdceDbOyqR9FfT3BzMU1XlhRnC3MZm7cvt84ZwSoCwzEpf0nxGjHhDD_BKTqftGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDRxt6vWOf7u_90c5N4BSEFnIWWnxJOl5HJHAr7ZBZyQ&oe=6A79B19F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
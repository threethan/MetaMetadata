=1kilmsEho-wQ7kNvwGTa1oF&_nc_oc=AdnlUJcgLidiU_riVEazlF8JJOlRotwxBqMlfNBoyiIq_46ZNNkOtiCDDla34S7wqGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzmJMYQFqbOc9WofR6ApatYvjQ1ys-B7uhOMroiXohjw&oe=69B55143"}, {"file_name": "Shot2.png", "id": "1110660511112030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819421_1110660514445363_6186410734796643971_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qgt6GoQwpfMQ7kNvwFc6y56&_nc_oc=AdnyY_5YlxEOHdsxm2PqWEdqRsZi2bPxAiqkbjAhznTz0QC7sgHgROUTYsSwBlHFD94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyP8uodiMH5OaopEYJZT2JtmO2-K-GZCQtTTE_2OZcTlQ&oe=69B5658E"}, {"file_name": "Shot3.png", "id": "678692261393364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831382_678692264726697_7703266729207161117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRwxTWnI6wAQ7kNvwH7Vi5e&_nc_oc=Adm2_-IKaxHA61lrFv3Sv8Peni2ZjnlMT6K9y3pUjy1gjwbOq33sf-O-l3TvilRVEsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTwA4f2JVI_QhejXveG-caXBC0jOXAZ5gGFOf6UilHRw&oe=69B53FAA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSyDEG0TenwQ7kNvwFIgQP1&_nc_oc=AdnBzADP4s1AJ78Z7xL8lf-CWqfaJGDRcz5cZNx4xClgZxZ47pOsi9Z0wcS2eDmJQXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxh-h37leDOhJqiq8iHg3mdT1jmzGS9-TI2iFF42Mw1Ug&oe=69B542B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LRqdalXFgwQ7kNvwHlcUUV&_nc_oc=AdlfAyiKkQKb3dW6mc07mJlS3gjQBMaK52S5IPYaFoVKzm8av_NJs5dnL1SOheL1770&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxrFITosSZ0lyiVrPxoOSfTLZOnlXe_5X2CShg_Js_OUA&oe=69B53D12"}, "display_name": "Circle Breakout 2D blocks breaker games", "keywords": ["Breakout", "Blocks", "BrainTraining", "Breaker", "Casual"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive"}]}, "developer_name": null, "developer_privacy_policy_url": "https://namcreations.cloudfree.jp/CircleBreakout.html", "developer_terms_of_service_url": null, "publisher_name": "Nam Creations", "support_website_url": null, "website_url": "https://www.facebook.com/share/1VavtPiL5F/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "1672577
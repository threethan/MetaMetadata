42A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdcIKe2Q7-AQ7kNvwHMwV7C&_nc_oc=AdniLI-2Ky1cHsmP96LUL8s9U5rI3u1YA8R5O9O3qWZbDivuCCrIrOmVrSMzBQb5erg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1IjWdeXn1VN9oNrInUnRSqlzB0jVJLVxmC17tYFI4JQ&oe=69B93735"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5EW9AdnJNQQ7kNvwG6i1JU&_nc_oc=Adk0FcjdfDr4kx2HL2_vQNjC2RUUQhlB8PdgqTkWeu0ZThX-ILz6_-_7uX77tVO9Z-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhgFQfRtzffwrVnJr7ZWXlE6XQu20Y--eH2gwziSv1Ug&oe=69B93192"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3ilyzUMT84Q7kNvwFskNdU&_nc_oc=AdlMOX8kt1Le7GodefeZj3akPoj89rN-6a_4AngagS0DjHOM8J04OiR8Tg4nIB8kVFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTjo1WzCG5kA4_Gs0OFkUim5k8P0UquryjOKNY4H7f8Q&oe=69B953B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chci6rRjmAAQ7kNvwFO4P6K&_nc_oc=AdkkzGxrlVpf4LHrpXepa4ekc2CusJOrIemAQPxI1dLXohdfC-kz9OOpyAiNfaY9hr0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw-3QVrGtkz08uoRqLyA3eIsfcbZ-T_i8QTkYImPziIlA&oe=69B93EE5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OJ-x6ByaBYQ7kNvwFpjrnz&_nc_oc=AdlBErgUfEKMD1kFBpiTRLgOQGOF8v3BCMr2CcjH5sh6izZxEq20ihZfD4tON5pS_l0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzL3NnAhe4fGdBzaEiOzT3H_Q0ORUOL4M-97EXV9Psgdw&oe=69B9369F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828816_1055972959474869_830596178173793119_n.png?_nc_cat=111&ccb=1-7&_
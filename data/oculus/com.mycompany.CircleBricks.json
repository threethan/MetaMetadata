pxOIoOU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJy-sTOp09HMwp4sjeAiZjvn48XU2fJpWLppVLQDV8D0A&oe=6AA6BA6A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIQilgttHggQ7kNvwEZcMta&_nc_oc=AdqP9nh296GJMK7A33nvu_3K3LiUzBt3ZNSIfL1n1nXIGPMUpJL8Y7zt6Cbd3sCZagY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiAccSov4z4pUBkmG3bd6Q4Vxmp1p6gXx5sURFQk06IQ&oe=6AA6BD75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBTEEMtMxD8Q7kNvwFwZche&_nc_oc=AdoAI4xaVjoku1Y4P-Ca1ZhbILN_mpo4nONKjMNbG2viOP0YWBOGrbIHO_Ap4kVCgnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqO3gUESJlBASF4tYukp2gerBIls3OWcc7AQd9272SXQ&oe=6AA6B7D2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqNchm7GX8AQ7kNvwE-ocD5&_nc_oc=AdqRYbIwh9I5U8Tk_EpyXCTkUHgSBTRCGVGLRncgibtoOZJ_2v7iCFEZ5EL5I7i2ovQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYgPntDKPA3DcMNzwl3v1Ut41g_C_XQaa1VXFz2OACVQ&oe=6AA6A1B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7ccPZCcsxMQ7kNvwE1FSxf&_nc_oc=AdqYviowFCluiT4rjykIIgmkTey8s51ikns1GWOyD7A5EMeSB4q__JB8TcxXpqITQi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhytih8GWVFfcKkgaSbgvhfGI44oLn-bVtt9jm5P13oQ&oe=6AA6C525"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPVLccTNxXYQ7kNvwGMs1ei&_nc_oc=AdqPeDkod7KeX4H_tvBFDxOm-6pOw-At644w6gLIRGk2Opn6f3bBQUTg0cxE4u-QEBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDOIWlWwTxG5x8gnh7_xYXpxiNGkxZCHwddDxrwwV0Yg&oe=6AA6BCDF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
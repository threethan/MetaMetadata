6X0ie9s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwvmbDguFZh9aDy5hDdnRZwi5RzsPphmyf_UJtYeNeZg&oe=6A7B00AA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnIichjQiDUQ7kNvwFwsjw5&_nc_oc=AdomaWAzAuI5zZzZBrY0AMHgLADoGWdPTe9ydPVJne6IHX9qgPJZR6K9jXs6-tuO1As&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtX0eaOofAwodjaMBVzKF8zSf_nnjaXaB6dmU9_6QOUg&oe=6A7B03B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0q5B9MhylAQ7kNvwEscPZU&_nc_oc=AdqOH80zCLpWVezfSzA9JhsZSYQMaEN6D4m7MG7KLXLU-tb8y1rjqWVzxQ6OwIn3ESU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXGL2b4q8wB7bfzFXocuF30znwjh0XLUqYawBgNGrxyQ&oe=6A7B3652"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r29RyRdIir8Q7kNvwFrg6Tm&_nc_oc=AdrPJD0wlOlFGpXBw6yftIliDQQ4ImO4EJUP71oLHJwxb6yl7Fwc75rbhCqeoZnK_KY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE36oiuA8gODwT4qyvFuozgxJr0pNTcKHMmim9FLYyYfQ&oe=6A7B2033"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNzhnZv1zIIQ7kNvwFDQ0Oq&_nc_oc=AdqCS6KoeDl8TlKKc5p-ercFLgYm-wdyLQCD676TGSCXaYDzRR009UOK4NyRoklfKJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErPeDJQoxwgDSMhvkOCiG4QfjRLzMgEnhx3djuwISV2g&oe=6A7B0B65"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q8bXMNUFaYQ7kNvwGlCisG&_nc_oc=Adq8jsPxiVJSYNwTQMuLaeDKZm6bwX8hNl9OG32smfUW5EsXe1XJUthH3uDGDeYLvoc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy7s8Be01BrNPxSg93vo-pT2tNCCLeku7RfWxUfxSmOA&oe=6A7B031F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
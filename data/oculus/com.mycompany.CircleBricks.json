nmuqc8fiL_JSmrKi85laFtXIZP8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYAdXm-fR_i75SgfMwI27S0JAZbgf0t6Xq2LlDM7OY6g&oe=6AA95D6A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsyIqZzEC64Q7kNvwEkt0oV&_nc_oc=AdqRjWw3oIJm-2Rsiscc3clv7R9RYPu_RD_XhCXEogoEHsvZSRYYvNgxW5Al6Gr3j5A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5N1XoH4wTRCJVvqDw0YPW8jlL8RoJsy0hfaUigo0fLA&oe=6AA96075"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJpWLzWdYhwQ7kNvwEG9Gd4&_nc_oc=AdoPdji4kQexogzSsC64aRUChUa1_UyEF7l5ekSliiln7fRbT7j0Z8ry_wDdSPhbrqA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUlBJuCejIYYyEeHJ-coRj3_0oMcgn4RsxqtuVfZspCQ&oe=6AA95AD2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqNchm7GX8AQ7kNvwEWWXB0&_nc_oc=Adp6tqHulqrnoBMie6bgWMS6hPE3siOrxuy7hCvW5GF50Pkv48Cehs9GPFqOM6iDdPI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN8HBEfFqUynkV4gmelceHiVMxnP-pQAXLB5BzoRJ9JQ&oe=6AA944B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGCPNyv6gmwQ7kNvwGKW1v0&_nc_oc=Ado6Jf3n2QAbIHDotKNr0_QWxp44TTJAY21IO_96NwEe3smgGwSziRVTnfajzmx3SUQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2HDZDDEZnEd3FTiSS2ZK1dhONcGSJJXSp4oes-xn-Og&oe=6AA96825"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPVLccTNxXYQ7kNvwESRI1z&_nc_oc=Adp5Y_JSZZB4d_HzTeF00IQCviqeGrei2wnYly_bMAbpv7N--OACtaZtNW_1LaXP6dI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV6wpIrP3mhF7jD8fRM03echnShI0yTWLFI5UtCaVvtg&oe=6AA95FDF"}, {"file_name": "CircleBreakout512.png", "id": "105597
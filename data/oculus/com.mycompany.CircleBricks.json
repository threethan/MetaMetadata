rt4C9h8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iiP3VoIDlIrWj2H40qRb9_iPxy22kDhrPDCnETnMtAA&oe=69D278EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DS1g_3Vxa-UQ7kNvwGR0iqf&_nc_oc=Adq51pfLzSY4zzFwZSwAiN_5Fmvqxx-ftPFDgS550e8Cn6IeaH3cY3dkqnxvwYhzJE8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZK0jlCvWuhTeqSaTKXy28pjONmb3A3ArnFdutE0JI9A&oe=69D27BF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cn1qN4C8W8Q7kNvwE8F6AA&_nc_oc=AdouJ-tgv4sojHHGVWZ8TKpqv0Tuxj6IFuTq3EltbEm1tDJUBPkPWJUss33EW3DDmb4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_MoNtNKYTdvwDfJRIYhA-OpUww1OBJweLYlIa_yWmFA&oe=69D27652"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T_wyFyS-csQ7kNvwH1V1C9&_nc_oc=Ado1Vz12uAR2VVkaTA9grK3vG-uWopJw4oNB7Nf-vDjKDtHI0ynKAxymAa2UrWdLKBc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18zVO29cIkZQtOawIFfLYskcvjl3amIQVJKdB94LlpMA&oe=69D26033"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KVKiuhas8gQ7kNvwHQa_Yz&_nc_oc=AdrrrNS8UaPEOLFn-YpqPBj-Llq_VAIVGPWE6KvMMrFPGqTz7Nz7O8d3huTEMv2dtA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af328RWs01s1Ml6ZWX8cEiC-N7CJWEGtusvHrTQHLeFEqw&oe=69D24B65"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-Vbwd8ZY8kQ7kNvwH9nRBY&_nc_oc=AdqTSO8oj_gb8_aKCtzmYajLZ8BeAfwfhah8gAeQTy0Zt-cw9PMwegbH5urLu1vUyzo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SOqpJuDPHEqloMdeSVk2HMQSrEESMDWOcXF2BbqGRjA&oe=69D27B5F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
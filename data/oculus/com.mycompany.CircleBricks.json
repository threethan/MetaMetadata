cKY8jPE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07ZAYRheWyLOe5dZ5wawinMkoAZeKVpOPuRNcSJ_yKQA&oe=69EA33EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dWrJHm1c2kQ7kNvwGS7iAT&_nc_oc=AdpT26I8DRlwUttfGfPEGkCdOew992pr6CGgKhT8UV3gmvf_4qiEvNMsHdtcjNQ53Uc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16DcCFj8fH7jM8yHkyi9f_HZ4cGj-85JjoaGCDfmN98w&oe=69EA36F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYwoYRdzm6gQ7kNvwFIdmFF&_nc_oc=Adrb56RR2bhP0C3d0fR6ua1WdEI8uUj_b7vkFLknn-VOM1qAEetFyN8fPaJwJMqhtyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I0TQ4LSQAeqgIpVJTBcaPooSh8SONyb_ov3GzcfJe0A&oe=69EA3152"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFFpHm1wmDEQ7kNvwHUZoxO&_nc_oc=Adp0J5mAdRcAqk3bPwG75IptimoCJ_CgbrBd_GmoSpD1knuETwB2Qps7fJFCwFq8oHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NV7_Mir2i2rT2teYaTVJaPLLuFNtNYhjrA1Q7xvu2CA&oe=69EA1B33"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wYKjQvlACcQ7kNvwE58gNO&_nc_oc=AdpevFBHkTJqpvwNpu0TQ-rH4_gqZb8tc8zZ15mNPpRt_UJYWUWjMiNHjMVnL3WLCnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Yh9roJtHpAq39WdVZZFTasMuvE-ppKCk6ocXEcsNL2Q&oe=69EA0665"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJCLWo8PdpIQ7kNvwGIF5r6&_nc_oc=AdpTJK3WVz_E3EwHx6yTB1783Vh8M_UNqv7Mo_EhwI0Lxtl_ZCG6OyySmzsThQwVvd4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36BT2kWrawXBO9McQDFc1dCLPX3WYW4BDiQgf9WXEy4A&oe=69EA365F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
6AA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYU2UYz19SsQ7kNvwHHESe5&_nc_oc=AdkiFkbQvwNjiKoyCjLVdH8-R6PK52bqsMCQzVppP8hsaiewupyWWaLLsYPEH_UdncU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsD_gAA_3V1AsqH2lgfdj7Ypq2QGhuxMvA6xti8Eo7Pg&oe=69AD59B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8IidYDmZHcQ7kNvwEEbHuf&_nc_oc=Adks1ZhbWDQmbGq6wGbvPJppM5MW-aRSz67BOhoJvsuW8M2rg2Z-p_auna4eIZ5y2kA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlvVQrYcIX3uAV-PIibBv3jjtvF2JQ98cgpN66ucsm4A&oe=69AD5412"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSs_-K4rcJkQ7kNvwG6NWD9&_nc_oc=AdnXha9-RgYIntyaJqOMauJdiHlcre--t_yRm60OmAkZu2fMLQ4SjDFhZWBWoh1dqWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhnFfGQEsUn1vyfXYC2Xu4LJJ1OosgFAOH04Fhre_gOA&oe=69AD7633"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9k58kjPHRYQ7kNvwEbUy9G&_nc_oc=AdmV_r5N9AXSCn1YKC2xBlm6C-e2CJPAsi0V1xixu46T0sDN-7YG-Zkjw0Pessvl0jI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwe0zcquRE5ItDFcsb-3x9B-ZkPSkLpqSpqQbjAPPTyxw&oe=69AD6165"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4G4_xD1_bTsQ7kNvwG2tnjh&_nc_oc=AdkNEYOQa-MzRVwg0zxdP23iA07W_KdMkP7vQdjlPJC8cNxIiIS1Hfo9HKOfIbamJFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8Yxz6wtcYGbxVOwJuMB8H0cs_QxxJlJg62iuw7AV8dw&oe=69AD591F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828816_1055972959474869_830596178173793119_n.png?_nc_cat=111&ccb=1-7&_
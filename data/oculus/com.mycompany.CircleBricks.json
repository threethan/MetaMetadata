FAA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSyDEG0TenwQ7kNvwFIgQP1&_nc_oc=AdnBzADP4s1AJ78Z7xL8lf-CWqfaJGDRcz5cZNx4xClgZxZ47pOsi9Z0wcS2eDmJQXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxh-h37leDOhJqiq8iHg3mdT1jmzGS9-TI2iFF42Mw1Ug&oe=69B542B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LRqdalXFgwQ7kNvwHlcUUV&_nc_oc=AdlfAyiKkQKb3dW6mc07mJlS3gjQBMaK52S5IPYaFoVKzm8av_NJs5dnL1SOheL1770&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxrFITosSZ0lyiVrPxoOSfTLZOnlXe_5X2CShg_Js_OUA&oe=69B53D12"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckEyVKv-svQQ7kNvwHaNgfw&_nc_oc=Adk1nAaaRclwUl8GToL_8wysOlGdZ20rt5jhIdS_-85HBGTbCg0Ix4nx576F0IWmlvI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfydIiKIYfzkoDLM8l-QdY5NbJFdCtdHIbJKH6csuY751g&oe=69B55F33"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVj5oE3g5LcQ7kNvwFjHBYz&_nc_oc=Adk0UhQ7tL8dtKdaknqwhnE8COWcGSKtc84bHj5EUbuiTdh9s-nJLE7EGoYh6Eob3To&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz4Pf508hQbjoJFU7hiztVY8pxyzAXrUGXlT_D6HJGh7w&oe=69B54A65"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzSo8EbvS4AQ7kNvwEG3HPa&_nc_oc=AdmsIt8dTfvVLVJ-YTvGdoC63PoyI6MtxJVlRFTxSdO9M3wUJsj0i6b3i_JlRQXdZwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxrirUJxwAM1cJI6UzO81cuPLitcZcXexmUJdVep7nTjg&oe=69B5421F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1055972959474869_830596178173793119_n.png?_nc_cat=111&ccb=1-7&_
BpVn3xc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDITidPsubqDJGwyKTkMptqNHyYSHvnuFfwEPUo6abmPw&oe=6A5CE66A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpH5TXKEfk0Q7kNvwEo6Uav&_nc_oc=AdqwO6CMOcRfLk_LuV3qr5qMwrQLKax7c457ZLsxYwQsbH_fkHEmXiQFOJu8hUCeGjQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgdRxMnqr2QlmbLCVi6wTSZMTzL1EdGlqKXerug2oYWQ&oe=6A5CB135"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tmomYahO8sQ7kNvwGFN78_&_nc_oc=AdpJbxBdMQFvhMDXQUNRjQRm7MMeceaK2Rx9kax9Kcl1GoYtHQ8RZjF1UkXTseh_F4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCs8kpI42w93RLp9MeySCVV_v4kqjKG51JvoRZ3S_f6HA&oe=6A5CE3D2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEWI_UwdbNIQ7kNvwH29Iit&_nc_oc=AdoWGPKl0I6ScUiy8wDBip4hAcJNksj0x7azPVzwcDBr4BoeNDCdyW_jOLHBJCiSP2Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm7VX-RHp4D5RViqjLoACC5QpTz75ALLcNY7YeL0Mz_A&oe=6A5CCDB3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CnfKJt00pkQ7kNvwEhyKyK&_nc_oc=Adr2vQkLtNqIsDhmO7zfUdH5zXAynid-dpgdfwNCioZa6_q01HnzQfdzWH7b1yDzhZk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD88tiE3g8UYsFLuIw7TCA8mD5drAkplfhOid7GrRgY2g&oe=6A5CB8E5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mus2QT9pHEAQ7kNvwEO9TFG&_nc_oc=AdpuhixH0eiEMOu7eGkKj2FutJPhO2bOEhgKXo9eNt_2EWXNn1Iacyn6XXiTzCAeJr8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfpfMEYwbofQsYuSVehJEhQH9OwZg_xziTLw4jf3dPew&oe=6A5CB09F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
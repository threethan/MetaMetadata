e3-aGtE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVXw1kl1YxbYApsqEzTIeaxBKpWoelkOfCdEpOWuNFiQ&oe=6AC9016A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGFPeQA7bpgQ7kNvwE0oD1G&_nc_oc=Adr_iUwQIGzlDUG68D4T9-vZFzZ1X2SI5FtFpIHaIVE8pL4mkW1aTz-qJvKtsISPkcY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrdM8y92TDJb2-vsp9-O5CwdxZNq1UsgeRVHNICTS4cA&oe=6AC90475"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHmtLtfUpA8Q7kNvwGsWUUT&_nc_oc=Adqz1lTBMUSSD8v51Y40Y6lJ9BHhWREnn3FLL-rQJMFbMm5FZU8Fu31x6mUFzB7LeYM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2xSkuV59deiYb-fbPolXMvGIgstDv4wEiTkacsUSF9Q&oe=6AC8FED2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-p9SPWYcxQQ7kNvwGNhTFG&_nc_oc=AdqC7oFK9sX2fyYGo7aK86KD7bpO36WXjULCUADYeXcbm7Qyxw7ADBV53sEGZcZ0g-0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkOk5EFHG2RTGdFhEaRFhZaJiIEfcLa-xI7iqMoZNvJg&oe=6AC8E8B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHUEs9h51qkQ7kNvwHUAMGJ&_nc_oc=AdpcTGVEcqhvxhpmC6zAsiSgrs9ybw44mObNynME-ms1fejjVw_UYBt2eNZyV6dTN6k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMakOmD3KdjvcAmT6H6DkPPRPM-k9nM7BVX95fGHy6FQQ&oe=6AC90C25"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgrgdrA6YjEQ7kNvwH5aBlt&_nc_oc=AdrgbtYJ-lHPWSioFcX__x0aLj9RLJL6YuzzPBzmT9f3zLrKoyP-WVPjPR575MXJuVI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi56MePdlGibOvcUrRD4YqrbDs27otXdz8nJp-Ip30Bg&oe=6AC903DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
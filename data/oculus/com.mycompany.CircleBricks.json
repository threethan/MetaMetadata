fqvt4uA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91oH9grNHJNbQeTAue-WslKC0Y6YgRVKQOFOCPS04vUA&oe=6A43D9EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0Jhfib2tVkQ7kNvwEFYl3T&_nc_oc=AdrwLGL5j4dFvkPL7CwtXhFSGN0GIFavUgvEITB3Uratx44iBy7MfiLY9ounX8OGLJk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_USjZwUmtwmhR-6jFgJolO2mDw3yZbltV69V6Obd5Xw&oe=6A43DCF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXzYUOAL_AcQ7kNvwGwisQp&_nc_oc=AdqJH-tOLaTJI7MrYdaBwzNTfOBYO-6EluJxEJEr6EHvGlvMXwky6PdPvDgk48oE_FQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_klxMu-dEZhIQby0o-kJsNHj1K9kK0Dpykrvu_D8caUg&oe=6A43D752"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCt8lR0IjVQQ7kNvwG8GTY6&_nc_oc=AdrP5cjKlbTTgsGrEyxRZxT7xzLAaghuHmqRO7Bjvkbs-2FBchd4B4tCrLS8oJFZ5MY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CyT3VemrIMQv5cwYAsJ5vKzW4WFJGzhQFF5R5tO8WQw&oe=6A43C133"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wV9__ppOxrUQ7kNvwFb5dGh&_nc_oc=Adqfh_HsHAX9vpmPk3b3H3MfGd8b3EuBQ7F5EJErphoXUPIQLSHbnzb-6uj6y4e_FRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TivoFmMoejnTNfD2Twb8fLLm-3H2DtW6GHY0smQCxww&oe=6A43E4A5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yx5G7WGrnLAQ7kNvwG6q5aU&_nc_oc=AdpT6X3ec35flx6HM3KQqP9KaX7yMlO638bed945weZRN60g6mGAPK8oTnYkrHuiXmI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OWWrT4CJvVKyIl1B155TEEnq8_G2RF6COzwspKZ2eoQ&oe=6A43DC5F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
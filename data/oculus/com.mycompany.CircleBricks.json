T0e1IUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQthnlmkBnwd7L-05ldT1V7LVJyXovgX5EnRN5KmAiYXQ&oe=6AEDEB6A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W61QcERGtKQQ7kNvwEfjT7C&_nc_oc=AdrBoDRyyK3hE-Dfd9rqFXjiwal4FXFKNjmyqYYAbFaFFxFS8V1ub0FAr1LBIJTAyJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQttWbyWyyQezyjJhL36tFcAjBFkIPdIfnabkCI-mUaWg&oe=6AEDEE75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hqu9kzUs4AQ7kNvwFnLxMW&_nc_oc=AdoSDlsPuSbnxcooQFjVuhyOTzY-RtM3yJhjWXB-MlDaQbjWsMz5zv1EwvSbhu-ogws&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_Qm9r9K3uxOtgJ8Y6MJpI8uA3oq0WoRyDoLvYQmcUXQ&oe=6AEDE8D2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdAmSHIPFFUQ7kNvwHT60jY&_nc_oc=AdozhaeoTK-QBUxMluodf6OHUCY3pSkaYgW80Evk0hMF5KzqFNkZuTu-Ddg5vmBTaUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZUG5pDnbsQUzDT5yUkih5PJi-Pr7PHmj9KIRuTZfP1Q&oe=6AEE0AF3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL6p8K_uDc4Q7kNvwGd4Cz4&_nc_oc=Ado81idRAPCtI5skySZxZ_zFT8B53xv5LAXgWeH6nSkfrp9Alkl3REa9ubhDYCHCCnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpCCTQWhe2jgQyF8jMXIUnHVc6x4pnRKhEbrmlb2rlJQ&oe=6AEDF625"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eBpRmjDG5IQ7kNvwGHzJ4a&_nc_oc=AdqmFPixrWog405FR36yiCUA9mw3FO7mRqMAKAFXSvXc1Q-TJOL2_SfiqqwPuE2Z2B4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFEBh-x20uW4pVRLnMV_tei0aBxQ4vrty6GRuUu5i3uA&oe=6AEDEDDF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
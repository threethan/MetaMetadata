c8D5CMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvPL3O0z1AYhT_lPVtPw1nfLoI-RjDDYIXPGVFlMjYbw&oe=6ABBD26A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZ4pJoukZEcQ7kNvwHGqj1L&_nc_oc=Ado-N3sT_RYWYB_P-1-n9ZqIkJdmY3PhGvchIx0MPYVu5jiMqEn72w84ACS2fLvanJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsq4T99J4CcdcyPrZZxIB6TqEb4XJnxblTB5bokxbIww&oe=6ABBD575"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o95r85DVrVIQ7kNvwHgvyI2&_nc_oc=Adr8P1k1cromyGUL-rtU7rgdtm7__GssjfLzulreWHJ7OEe0ucWf2n2xOS0xoEBpKjc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-bxVr2O-NrRaIo0hfvu_uLxGh_alE4qcb11H3QXCRzA&oe=6ABBCFD2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdlxaf0oLqcQ7kNvwG6e6pz&_nc_oc=Adru6EEXGXGBJYdVwVEGo6GtSd7DHRBMr9VDHPSV2riTfA1vVrjmb-mriCYZa5qoagQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKfd4onKnFi3safr_CZZ-pSXynoQZUAi9GSWw3Qobr5w&oe=6ABBB9B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Pm-dGhw7JUQ7kNvwFr2ala&_nc_oc=Adp8wWfnAo-pbBj4G6UUG1VoTcWPmXgfxWcD4A7TSlHt1QfU518p9l0B8RjtmClIQME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKWzAOemyVlKLHoSbBVFFjqhfM_r3gp8cgZ8nuwkF_ZQ&oe=6ABBDD25"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2Vi_PDNymIQ7kNvwHfe8cz&_nc_oc=AdraVp8uAoOuUScFlDwoZHWuniNUMPe2xgP2shY3GH0NOpEzqm4HAyMY-QHdm5C8pK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcwli9GP5YCk6kwT2dqjOUvOmuhMR09IsyMESGuijkKA&oe=6ABBD4DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
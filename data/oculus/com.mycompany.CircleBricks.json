iWj1p78&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Akapa0sgWBJ01oi_TWMrY0Le92fXkzAH9EpbzEwxBGw&oe=69EB856A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN_QtvD4laoQ7kNvwGHxuuz&_nc_oc=AdpMg8TdL_hJNnbrGSSmoGrWsIToPuYqUmSvAyTIzjvi0DuFag57o0vK3TGjg7j6u4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AItDE6RNk8yT5kEqqLnwNMNXn4RF54GMNrd6sVvBhDA&oe=69EB8875"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgYuBhiOtaYQ7kNvwH5o5Du&_nc_oc=AdroRstWs9JrNwbwnP5FZL4I4Bvx7--CniRh4bU8cOcR2-FsIU2RFdS8oEEJDigoZyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RaiNW3t6fH2cwj5VMY2rXz0FYACbIWzEhymhy1-Pvqw&oe=69EB82D2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFFpHm1wmDEQ7kNvwFBQOKC&_nc_oc=AdrqddMMn89ey-s-4P1AcIc7q-lzUr2yUkQaj3GpcLjQKILO2jgSA_hAqTN1_Gw_yQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_KH10aoQWFECCB0hDRJ65ONfTSxLBmv4hwS5OD9Kg-w&oe=69EB6CB3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wYKjQvlACcQ7kNvwHAfVv0&_nc_oc=Adpalpu4a_mELmCFJkJdffw425j0SSe_kEgw9LbTA86WzjkZc7dSFjGOyPMnFL11qfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cOn-Igh0qgtR2eZmzrkeJhkscAk1BRyeun-Djk82gpQ&oe=69EB57E5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJCLWo8PdpIQ7kNvwGgT4oT&_nc_oc=AdoRVelq03lDJOGJIxdHIXbL6Y559_1OgOHVMn3iBYNlEpYySbSGURTZrNtYHQjfGIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nDUs2Z1Mb_MXui903vjjZ0xknU1ainMzZj8JMI0uiBQ&oe=69EB87DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
tWrcGrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUQtBeUz_r96Eitmy2f9h_x24ecZvHM8r3N8_3OEzgWA&oe=6A7C522A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnIichjQiDUQ7kNvwH3G9B_&_nc_oc=AdqIZhy4DRfpA4UFTekxUYHc3Rl3AFsCOiXf9au3QARDrudI1u8kE6vcfdHQulf1p4Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzBI9QKRso6MscoCRLfUpVLYrYmkr-g_V2_yTbs_h8XQ&oe=6A7C5535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0q5B9MhylAQ7kNvwHVf3aW&_nc_oc=Adoci7_gnGuuUGtbV9ZGJ6npiFGPW_t0jlGmfHyjzHWiWIMGe65Rk3d21i0iz8ctBUs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMalYzUg25GXDx6Pt6fP9V2JN9GpotOXNuAXEqvGciig&oe=6A7C4F92"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r29RyRdIir8Q7kNvwHXyG3H&_nc_oc=AdqizV5BJC-wHlNRwmYjUDiwU_YXcJPLu5_mYmi2NFs9VOhoWm28XdKy-Gn37pAVyGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7Dkq3Q24w2FS2Envpkn_F8bzfsAybgg4_VUqboSUZng&oe=6A7C71B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM1a7-FcyrIQ7kNvwHwvTbK&_nc_oc=AdqBxgorGTVr_7RPaPbRsrP7FjFtyc5BuGpU8HhVxYlWeKVmBrRu03heUtaL7fpK1Vo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK-4lFTFOhu0vasw9MAU9y4vySVpCpRuF7oENLc74tHA&oe=6A7C5CE5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q8bXMNUFaYQ7kNvwG7caiY&_nc_oc=Adr1rAtRXvCO5TtDMgmazKukaUxjm1XxuhxvAbbc37TmTiuKurHl8TaAxNQi21j6Oh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVFRecrtGfxXr-zqjO16LBH5d-glGvJoi0AP6XjfQJ9Q&oe=6A7C549F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
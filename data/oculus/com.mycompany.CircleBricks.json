V_lHGbLweXyUviCbcLyUmj3xw0vyQJA&oe=6B0B3643"}, {"file_name": "Shot2.png", "id": "1110660511112030", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819421_1110660514445363_6186410734796643971_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSKFY_ujXuQQ7kNvwEb1X_C&_nc_oc=AdpsUIuiA7PsrYuG1r-CfBnm08FabUsgfsnqMI0MxA7VH8Inp7gSe-Yhe3TL3Kqcjxc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6X88Kha-0xUIO1TCn6ORLdZsJx_7ne2JJlPBksYeG7A&oe=6B0B124E"}, {"file_name": "Shot3.png", "id": "678692261393364", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831382_678692264726697_7703266729207161117_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCi1j537KBYQ7kNvwGiCH2F&_nc_oc=Adr8f1gKHaRS2yZkAOvlcNmotm21E-BYc8qCutZT9Xle8F8rBUOgtuezEsqbnejFpUA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSOBgjHr1uFFvzTB2gDPzRmn4aOEQmQaKPART9QDmtDQ&oe=6B0B24AA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLVGihGFU3wQ7kNvwGuP_kE&_nc_oc=Ado3Pc2n5GduzWe_Ut7ri7oKGJOu98emMyGyya8gAtY25lUhdMZPyjWWeB0ihjLtbuk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvntW3gCqr7mcfggaXvTB1xc-UgwV9av0rhV3q4qRVdw&oe=6B0B27B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbh_A3Ik6foQ7kNvwFU08jz&_nc_oc=Adou4wrBFf1lpDdzxvZsmk6qRJOzdahr675GBC65i6xDbHut8FkGA4hYhgkWICpGum0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJBrusUg7LEw-Tsrh2xWAM-jAaDjsuI5Uiu3MoUukp_Q&oe=6B0B2212"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPHO3Gmv398Q7kNvwHgxjuc&_nc_oc=Adq70P3a0A_MFCy9VGXHhPYAvrPOGI3nAAgcFmIXamkXnYWWL7c9k5NT5md__j53u0Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQA8I4kqWghaEEmquxK6ipRXCtEglX8i1jeZNQXOBl1w&oe=6B0B0BF3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculus
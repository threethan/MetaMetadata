h5AVW6Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNORI_Pc2iiVdZc_Wjg9OxYorxSIOmLHretl_qNvYKF5A&oe=6AC7AFEA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvAU_8w1YoIQ7kNvwHAsWNU&_nc_oc=AdoMxqysq0YftRe0UsURIuGkHrEYw5dMZCmjTeUNqFKi89VP2Tf_GVD_bRgpIgtNr78&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMND-Ov8xtlT3Rk5TEDOvn-x0aVEhnpJonbXVrP9GjnA&oe=6AC7B2F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvVW6rKCC7AQ7kNvwE-LRYI&_nc_oc=AdrU_odil-WrFV-ChFZ4n0Rvdnp92mkNa7inrqfVYyB7Hlv6SP1Mapj0Sf5YBaopPhU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH-V3EXWz6mixxPuCL3sqUQLcIaE_K8zGBenUjIAa2cA&oe=6AC7AD52"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-p9SPWYcxQQ7kNvwFIXwB8&_nc_oc=Adqt7NS67VYL3uByS1ZZS00ksP7ekGsLj4H8AySwzpWrK9Dcv5d1Wtl86xnI6XyeOYo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA_VhYY1T_azTd2TKT-sqDugmnVE3-Ah5JzEw00PDvOw&oe=6AC79733"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHUEs9h51qkQ7kNvwHF9w2D&_nc_oc=Adqpm51mN3GldwnkPE-VWfXnRvxtCjjHZ-fuF46xwrEjwacJ3YJ5679RSBfxav1uB5Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoRITrfmuPfZjofhVZ_gzGBe1J0sJPOSUV9O40wFRqIg&oe=6AC7BAA5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgrgdrA6YjEQ7kNvwHPeiN-&_nc_oc=AdqiiZ4vN_-7hwYKwtfwQJ0RMm-tZE1rwqxL6IOXwZ6b4dnCv9aoS6XaqD8b7WQ9XRw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4lHfqo1vFPa110CeLx-kkSj1cehu5YqWhxRMH3_v2RA&oe=6AC7B25F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
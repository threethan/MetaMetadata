o533mIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICcjzjT08N0QtZb34l4L5HMdDJIb8M7Dt1KWNEN3IKpw&oe=6AA2C5EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cFEQNE9e8sQ7kNvwFQKYa-&_nc_oc=AdqgOSjEHvNRrT8FcZR1mnEkvvFc5tRbKGx2MN33lRJDca5wgoajkueS0S6-pc0iJuw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiweB1_vUGuetS1h60r3uKI_7r4qPdpZtUXtHra9nkSA&oe=6AA2C8F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAqL8CXlgPYQ7kNvwE6dxIQ&_nc_oc=AdqoUVDtInmh7hmePSU3i_DIifYO2YmsHIWI4_cshBwvKJjU2cJHi5XnYL52f9XxGns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsAF2sN96lAdAwsuwBmy_LYz_guhkD3U-eIbjdv0JIug&oe=6AA2C352"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG0nVgUTUQIQ7kNvwFtAsei&_nc_oc=Adr7PGB-7x0putob1ISuD2auBtD171bQWCcHCzJqf-WGOoj_YvEiBdkyd77BGT0GH6I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_FXy9ztGgZx-Q-RSyuoLI2wAhRXWXYnvJgK-S2HpxXw&oe=6AA2AD33"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4n8NpCgiW04Q7kNvwHPW91J&_nc_oc=AdqWNXfUpRntSD4L9q237r6fcKoHUFFJdQfmgdDzN1MQY8ZjFvFj4Mct6Gnu6zSbwEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxZoOaE_JaoHOwMFGGhJlJbirw--hv7ineMQz5rjahJw&oe=6AA2D0A5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeTnAzCEVQ8Q7kNvwGrWkIn&_nc_oc=AdqRpu25o7capMO5_SfSyWViWH1DRFJzKT595KiqkB1h_j3sx6p029yXRX31OPm_wcg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQrokKYExE3ynb9te0R8PXpAFgBmxBqD8hh3f61kO73g&oe=6AA2C85F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
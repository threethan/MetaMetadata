ReGs1Gs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTQaAuKTb4x0OJFxLObPTg4tWGwV3CKGjSJUqkiRiAwA&oe=6ABD23EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY5zb47TG3MQ7kNvwEwiWqo&_nc_oc=Adq7Alcqoy0u9xqhnxP1YJxXorjDjRTtA3OZtvf-9JCgLGbCU0K6ohc0BEgxjuan2Ss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcgnkNy4JzvR9lupWR7qyd43SbODt2Mhg2BdHx3zEMiA&oe=6ABD26F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0vZj3rC2jYQ7kNvwETwdnK&_nc_oc=AdryV09ourkNEU8VrK-P4jg4IBKAqGjm8ipfc6jrogKQDqQALWj4hwyqj-GjycLEkZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDPQ9MmNT4ZUmbYzBhTnpoIOvvUMFU4L_sWsTcegYdag&oe=6ABD2152"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdlxaf0oLqcQ7kNvwEv0lDY&_nc_oc=AdrH5SKU2QUO3m4hBa-xWnfJUxL1keWHMMyNH3WpzMisxatMy3UwN-iR8Ggh82Ii4Og&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFUMPfKf65soAe7YeVohnXK21xC4diPSmfU-9SLJlTYw&oe=6ABD0B33"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Pm-dGhw7JUQ7kNvwFUPFl0&_nc_oc=AdoxLMC8WjRryPIR0JPpYoVMBd5lmjfM38Rfl7LKJ3tI5z_ZvpfkENqe0d5IQitlELA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0bKGdXXrFBv3ZlkZ4tyh4eLfDoAbnsBVEijI-0Kn8Og&oe=6ABD2EA5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2Vi_PDNymIQ7kNvwEqw20G&_nc_oc=Ado0E9bN26Zi-XH__88lXB63O3rutTzYiEreeIMhWqs1RLhjveq4ZPiO8y8-OYtszb0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5sDrqOAhWBS4jpHNRH0xT0F53AetQrnX0tUDmvSoG-w&oe=6ABD265F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
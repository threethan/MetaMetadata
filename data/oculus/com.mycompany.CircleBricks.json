sHO--Zo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8A-mw4lR1nEM9bsdr_N6WuDpbKgr3DW1fyiHCYC-7LGw&oe=6A2D706A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeH5UpiNAB0Q7kNvwF_D0QY&_nc_oc=AdqfB2tk_f92-Hi69pJVn-vyOBT19GsdR8iR-Vp--AMwlTT-LMCR8-j9nBkimb0WH1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85VU7dJ8nQpDSzxQ29WmibuBQFejIVUkXawjH96OPibQ&oe=6A2D7375"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_etssJy2PMQ7kNvwFhuhfF&_nc_oc=AdpaxQ8ko4nlJ63DOLuWz56ZUKCpuovXPRtRilHgLPYr-bEkQCwen1RomEYABcAC1MI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_prJAiCdQiqQpKO7-KnO0_L0qAeJykISeF7xE05cy3wg&oe=6A2D6DD2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feqsjKEIQBIQ7kNvwFddStj&_nc_oc=AdqElgIZG5UFRHi0YsuIXYB9CakzhJH_00mVqwECcmCU-_OVpUmdwc8g_LUvtPfi6eQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93q1jwVFYPFSXlgUMB9lYHfUfH3TBlyw2WQ47QHI7QUA&oe=6A2D57B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuuK4vhRBPMQ7kNvwGsbYzX&_nc_oc=Adpax5K395X2Nssieqk4OYjjXJ1mZujQRVLLgErSowsN3iBTitrztl412RpRMAOAgKE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0sibo6E6Ioqx1vKMo6vXzP1xHwj1qT4NY2EB7WAEiMg&oe=6A2D7B25"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVEMNgqQVWwQ7kNvwFd_hT3&_nc_oc=AdprM2AZ4RuhMkDG1J75XOyaVUyCcBmLIdqpiznLYAI4Sp-jPzH-c3xPkqbgEykSkkY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xZm0CpqLTIv5iIHEi7ZeMD1i50eRjGr-11OH30R4tAQ&oe=6A2D72DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
ghbl2Hk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9MprIYHCFXWalkF7AyqtnO6yHaMkRDjbObsbQYKyM_g&oe=6A6620EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sfGBWNYx3sQ7kNvwG7QAji&_nc_oc=AdqZye-uaRtMB-iKDi2l4lnNJkcB0wrbJ5IK2b2LqL5NE8fOPdxhz3RBuzLyzc_Q-ys&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC5Y6YoZfHZ1ohRX4ofFsn4-kjrlSf8P0QlCOcPRAcuw&oe=6A65EBB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W71HuhA3sr0Q7kNvwEo5qlj&_nc_oc=AdrCC1OxNCX-Xpbc4Vbuxm8AxiSEn3I8QRJFxz9aAil5sFsfp08FDuAC3rVZbpsOEyg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwe1w2_io6bUpybuYU0TbaAwkyJ1W12Zw6VbD6nTQD_A&oe=6A661E52"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_D5ggijPSzcQ7kNvwG7uagL&_nc_oc=AdrfAWCK-SpXPra0yaIy27L_KKgjDbrLexuIuUjcd9kW7nsmziYgxIboJX0Tt06mn_M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZs7qeMCHs5MKs97zutYPeZdy3QdNxECuQKxehhoj_Rw&oe=6A660833"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVbNxwo6dfIQ7kNvwHQSWCK&_nc_oc=AdpX2Gik1WThQI0TwqJYe0ZopoPKE-5iyGevdl2OZzmfyuLm-eETbunetw2CNTe4IwM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDq2_eGdhIhYroKdQG1LDmTlj_JahtxHV3A8OHhjtdNAA&oe=6A65F365"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJHtk68TUsIQ7kNvwE0Q8kQ&_nc_oc=AdqTR2iSm0nKyhzjAAZG8ZtQe3yI7ZTzE3v2O4WvC0InI8TZhk7MbOpUt39o6azbU7E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeadIdAjdsfgigqSfuR6W_uyIvZUwf0bgb-WG_adHSyg&oe=6A65EB1F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
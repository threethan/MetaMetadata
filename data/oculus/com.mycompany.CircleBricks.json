9gWaSw8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf3tuJbM9-uAI2HfS6L_bR3W9i4_qI-ikZwkoCPh6glw&oe=6ACF98EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqAzZfOcEEMQ7kNvwEOKSi2&_nc_oc=AdrQWrGGztQ6axoPl4bNTK8hIvgXZn_zPIAH5H7W2MwKq83gbj5exs-U1o3YtoB-kOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfphVMqmskNfl4fhBjbj1dhlGQLMyXuthg3vJZ5jGmrQ&oe=6ACF9BF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESafc01Fw9IQ7kNvwER4An6&_nc_oc=Adr_bQm-JEMAOnRNrh5aNQWsxCATlEyPalXjgtnJbdafAq7mjvBj6S3tdFd0MfqaLVE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvyNf9qN_jMhJVudVjRNL4TabM-yft1Ys0OAQu2Xckhw&oe=6ACF9652"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLWgOb1zAOAQ7kNvwEdCM0X&_nc_oc=AdrfS_8HmPXh1dN0QFiNOeOwsqLS5UmeCWnSDaQQM4-BDZ0pZWzN8jN4wEVVzimso_A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg3zMFYwaeHIDQe76t-Xwhnoe3rN9x2JZ-wrhrFWFnfg&oe=6ACFB873"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aq9-cC_bCl0Q7kNvwHJq8lW&_nc_oc=Adqq6YnCRqYEVuXTaDPSgc5e9A-dmm6GTRBMiKWM9-okoY1EXGnfSgE5SYh18OLn_TA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrpzOLoahpgSTmAxI2w2XXDkVaeEH1xy6YURwbchNMQA&oe=6ACFA3A5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5Y-nxJ1n5cQ7kNvwEuS-R9&_nc_oc=AdqoJgzqHBV_vyufGxIMESaKQtXIKauPDxYgy2BL92avEml3zinJXbIwOfWnMPfPeE4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGZD9pWhG5QXdHFZGuUaAyQFewyDsGc2slt_q6xMlqfA&oe=6ACF9B5F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
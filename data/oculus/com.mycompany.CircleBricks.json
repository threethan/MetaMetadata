i4PUJOTjrKg&oe=69AAB3AA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adqD0FW6QEgQ7kNvwGSPO1o&_nc_oc=AdlMbZUecXTruZf-yt4Bt_0V3IF5_Zi8rLEdlzFDOnRfbMDZHY8FtiPTpOyceaqwyGI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxqOAkZbM0eHCVKAQBZovDY6RqflQqDw5q525dGyuzUVA&oe=69AAB6B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQzENLP7SKQQ7kNvwGX3xTQ&_nc_oc=AdnplGSlPcUtcrO6xEtbe6BrJDLymuXpSzsZB0t7t4Sxup0k9mpl1Lel8Y9pQTigBZM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7lbcMZrnkUdZ6qyGgWvH4cMJ7x4wtoUCrOFtiHbEeZQ&oe=69AAB112"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCzCYaXh6rgQ7kNvwGhr8ZO&_nc_oc=AdnfOvXa9fZ1Kf4iSCF1mbvDyn95Q5oujjnhaqWOnMLlCt2EztCux8yT8HzRUbWU118&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQw7hUNoSLJ4XBWfi4CDRlkWUw5OzWumAyy8Cw6Rjv0w&oe=69AAD333"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9k58kjPHRYQ7kNvwEjPd-T&_nc_oc=Adk02QLjozyKCSUhUyOIQ1xQE9tb6QJlzXcBUfTkX_FW_Sbto5odUdg-7AysTqN5KNw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEy31rXr3ex-OJpqyn15Py2vqsiBVapi1zL1kBNQI8wQ&oe=69AABE65"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvaNJySlXx8Q7kNvwGa4l12&_nc_oc=AdmdlokGNzbtsjV-ACHuBZ1qiQLwUppIG79wRbXS2x8YZ4xy0Ux0XMyu_qvbki6Bd2g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjlBNkBcid-mxuNjUBmrZYQSulrB9iKGDi62BreYo9ew&oe=69AAB61F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491828816_1055972959474869_830596178173793119
Dggr734&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g2DDhKVj2qDp6XNr9XvLs-oYPqzwL8ekUoq16IA9Otg&oe=6A1D9E6A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whkq5cpx3vQQ7kNvwGzXl9F&_nc_oc=Adpco-imNIp9WImnmU1X3KddMkynHGJMDUb5W9JITdrcnlpU701J6mIURZkCjrKuOBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4efNx424MVtPikXRboevln_WqtHrlFy8y88FsCs9GcIw&oe=6A1DA175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY5jvRGmQY0Q7kNvwGMSfDq&_nc_oc=Adq67gUHLqtYZjcpv5VYxmMyJd3xqrXb6x2LPBaXjL45LPqGxBaDJRkboeLKr8B7Bjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R7ltThGfKY0bfh6z_aECgrdPceiPOcVm5nwWE0YNx8w&oe=6A1D9BD2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djUm34T6gGoQ7kNvwHsN68g&_nc_oc=AdqpLEKoJIdxPiVPsKUFPbkKSzeXu6FzD9WH5VyzG59_pIBMlC7mA0WheGXwaLSE2Cw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h3Ej-Xy0iZzFqPcFTWG6oCi0l7N162yFEUFjsCX05_A&oe=6A1D85B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCJK8Z4E_XEQ7kNvwGbawiG&_nc_oc=AdrCUFC5dCg3DerERG0uE-q7eugC1khvbU8B7Kj2H_83bZ1kjQjSV2CXdu3N3CqxsbE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43dE3N5y0OCOAbA7MNhN3qqmaX2VptbFB6RPP8ol-X4Q&oe=6A1DA925"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArWHKvFYQBgQ7kNvwFgr8Yz&_nc_oc=AdodW_Peu1-8hSy_5nUk8XasuWFdMSXk8OXwR6y2WHu6swOcM7MQ_UPcurYkwPldX5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5otsy4h6ds7cSEtixmveH8XuSL-D0c6X7e74AiNmgwmA&oe=6A1DA0DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
f3IeGD9mHzQ8I0jz5mtXUe8nTA0EkdLCUKoCk906Ml6mQ&oe=69F0A4C3"}, {"file_name": "Shot2.png", "id": "1110660511112030", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819421_1110660514445363_6186410734796643971_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXvXD0oz0yEQ7kNvwFVKk7C&_nc_oc=AdrPgsv2LVXHdYEtndeigf59Ab9eDJsMZ8jdP4XRQOfx5Pa6VqjQe3HqbBEvCm2Kfrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3kCG4lG7B443tnAyI_5-JLuawSt2xOQpCGFMr4Y3TcbA&oe=69F0B90E"}, {"file_name": "Shot3.png", "id": "678692261393364", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831382_678692264726697_7703266729207161117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGhkqxtxBwUQ7kNvwFbN0Ed&_nc_oc=AdoSxQBfHE62l4qgqMBBCN0D7r_FL6AtJ_4D2Jdx_hvqCKrQGmcn2pBwCchNBpbOuSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af378C7nUzVhFtmMxtVvmtSQWgJTYcFVLZlrN-_Bzsrlsg&oe=69F0CB6A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAXgxJZ8YTcQ7kNvwFEYubD&_nc_oc=Adr3qKAIM7FzU4fUb7DkEpKI32_8kauN2nKBr7glY0G-gDkhMgwkcEH__zIH5morVDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Kyjtbx4kowPSP8Z_xV1RrTGwAkYeqL5LL6fDS1EUZ6A&oe=69F0CE75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDUHn2eJVkcQ7kNvwHGw9X9&_nc_oc=AdqpCsrjx2-Ua__cvA8LO8i-DzJX-kmjeQpKd5WQQIQMAW-4IfxQbj8pc-QPYg3CpH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2grSpaEPJ_3gJ0yvAryfGkmhh1Xz9m4NpbMhuTb1JjjA&oe=69F0C8D2"}, "display_name": "Circle Breakout 2D blocks breaker games", "keywords": ["Breakout", "Blocks", "BrainTraining", "Breaker", "Casual"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive"}]}, "developer_name": null, "developer_privacy_policy_url": "https://namcreations.cloudfree.jp/CircleBreakout.html", "developer_terms_of_service_url": null, "publisher_name": "Nam Creations", "support_website_url": null, "website_url": "https://www.facebook.com/share/1VavtPiL5F/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "re
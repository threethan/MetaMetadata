=T_P_q7CQEXwQ7kNvwH_gCQE&_nc_oc=AdleaPCEzXrfOtziBtCY-psfRVtEg4NRIQjD1TL2NU78RoRR2msrw4-uMyyxqhq1Akg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyE0MaxMCDO_gnAmFutkOKJPw8s934vef_PlRmCYVjS7A&oe=69AD6843"}, {"file_name": "Shot2.png", "id": "1110660511112030", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819421_1110660514445363_6186410734796643971_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xL7wP16fBPcQ7kNvwE8Uct7&_nc_oc=Adkd4dP9zjC0lXc0WodneM-c5lD1HAn0lKaaIwQQQ8oOg0ujKDPpxlRdarO5l9KVc2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXylhv0XRYT4ltwoKFsPfqo0SByYg5egMyw7ZL9QJIKw&oe=69AD7C8E"}, {"file_name": "Shot3.png", "id": "678692261393364", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831382_678692264726697_7703266729207161117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8nk_b3q8pYQ7kNvwGLg_8U&_nc_oc=AdkX9RJxc3QcN3iQiJFxxlKJ9lKs3xD81jOiYo8IgwPEMb7t5y2GrrVcMMEqM9vWl1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoiZwCe9yES-F02iOjlSn3sWwYa7vgO04HkbnkrUl73w&oe=69AD56AA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYU2UYz19SsQ7kNvwHHESe5&_nc_oc=AdkiFkbQvwNjiKoyCjLVdH8-R6PK52bqsMCQzVppP8hsaiewupyWWaLLsYPEH_UdncU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsD_gAA_3V1AsqH2lgfdj7Ypq2QGhuxMvA6xti8Eo7Pg&oe=69AD59B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8IidYDmZHcQ7kNvwEEbHuf&_nc_oc=Adks1ZhbWDQmbGq6wGbvPJppM5MW-aRSz67BOhoJvsuW8M2rg2Z-p_auna4eIZ5y2kA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzlvVQrYcIX3uAV-PIibBv3jjtvF2JQ98cgpN66ucsm4A&oe=69AD5412"}, "display_name": "Circle Breakout 2D blocks breaker games", "keywords": ["Breakout", "Blocks", "BrainTraining", "Breaker", "Casual"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive"}]}, "developer_name": null, "developer_privacy_policy_url": "https://namcreations.cloudfree.jp/CircleBreakout.html", "developer_terms_of_service_url": null, "publisher_name": "Nam Creations", "support_website_url": null, "website_url": "https://www.facebook.com/share/1VavtPiL5F/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "1672577
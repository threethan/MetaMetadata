5-wSWAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClqXaBhKRHcjijg25-Xcfk3HSCOUdA87bRpiefinAWQA&oe=6A57A06A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-snafqc4M8Q7kNvwEHmlYy&_nc_oc=Adr7DTGEGYB8VJTe2sLAorrGwGi8TWUpu1IyJbzX-MM71VRPwxNmCoe4CYpLomiQhOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_yrPrbB3NDXhJTD5K5kqyMpgFlaFsU8TEiYN9e4_43Q&oe=6A576B35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8aInCmmYvQQ7kNvwHERf-Q&_nc_oc=AdqWNBiUnYAWWcg2qSlojsBt9HdkdbGX0Mx-KT4db1Z_iELfSzJk-j-a9fZZdManHVY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2epA_jn203Wg1eO0ewTc5BTIVPto_5Wuf-f4FSVBbmw&oe=6A579DD2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIbQSD5GkiQQ7kNvwH2Pgyz&_nc_oc=AdpNDTPi7uzODduM2Oq5OfwOnraOOpG2f6EqxjS5ZE50PkGGinR8kWIabewhVuEGxns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu_mCv4o-VBVhW8jASqStcVFxihHQWDyH7BDhGLnC77g&oe=6A5787B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tB2kF7X0LH8Q7kNvwEXg5qb&_nc_oc=AdpWsIc9TMreGYzyZQGbt03sRgmGpwDHCUCMr3AwGTTUMwLyILrU68j9n5nZeiYcEMY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq4aQPpy42HSAlL6I6d7MQWXf2RY-EdhDBhf_1_07HJw&oe=6A5772E5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Q1Rh5a1HpIQ7kNvwHhzNWF&_nc_oc=AdopFVNA7av_l_1GqPrwwWpiD3MK-vQTVAgLhItMOLCcGn2ab6_l7JyJfzrEphTxvc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4kj4FakyLMIX_ANZWFi319RII7V0cTmHfe7KNQ_Uddg&oe=6A576A9F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
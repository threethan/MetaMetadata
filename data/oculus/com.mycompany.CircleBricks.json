ah3qeAU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItv7t2qwORRz2JeaSWXEuQM-BtiumlErj4AS1kI8G3jg&oe=6AA1746A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cFEQNE9e8sQ7kNvwGaSCtj&_nc_oc=Adr0gwbKVKyTY6OIsryC110oisRZErVhpdknf9oyMhfFXZpXSFpNj7p4f_45yBTI938&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINVUT8iPP9nJo6OiNc8LwhA8MtYEkK9iIqZYKgY4oJjg&oe=6AA17775"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAqL8CXlgPYQ7kNvwEgKlrb&_nc_oc=AdoPvLnF1r1qdijoJgpd5y_oug2HeYo04pq6J7aiadMd_4OTvX_umtimcuqDRsghY8I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjpsXdtHodLjwFnk2OdPSEhtGTUUMdwy6rSTtASqKHMw&oe=6AA171D2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93-9k_U40CoQ7kNvwG5DPbF&_nc_oc=Adp0DVVZHpJZRIFqNBW9AWwUIJYYYnjnDRwTVKeEXILy6zdEm8lu0Xh_StzAQagKyS4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdUUAf2hfrAytk7_zhl9xqxE4lmb3CAU2NX1bRK3rE9A&oe=6AA15BB3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4n8NpCgiW04Q7kNvwF8ijxm&_nc_oc=AdpOMyKtXGb_wgpLI8KxqelqMTXh6UfZie2_PyNIEoUeku5wq894tQQA1h7xVPLmL98&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDkq0gvT_DIY5mH9L1QNXKNA-pku2UxeHlLhpErXP32g&oe=6AA17F25"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwCocA8JrzUQ7kNvwFY8sDX&_nc_oc=Adr0hxn2FuZgx1hODe2OzEKLlA6urWdnJITzKsz1H-FQyJqA4QQYYi3X3HKkFY45Haw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdeV46c3vsIBCFb_IHa8SNpY7JxVFffmqhJJzHWivrjA&oe=6AA176DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
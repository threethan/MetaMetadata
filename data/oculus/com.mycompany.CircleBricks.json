n2Qx2v0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RaNv_5peqQXzMRfaNfbW0tYOUWTKOBh1gVNOYH2gjtQ&oe=69E790EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dWrJHm1c2kQ7kNvwG1wLm9&_nc_oc=AdoUJvHXGKIEUXQ37nTKz-pPBrRmih0AvT3lVzG9v4K43LQ34BvM6tiGqiUB-5Iwmpo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uvMXRKjNhb2cC6rUY3Yg4yaan3wjVktmbzsaHqcpn-g&oe=69E75BB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYwoYRdzm6gQ7kNvwFboek7&_nc_oc=AdqVId_bT6uL-QNfJC0Fudv9R7V6r-wTgm7sMO9ngSKM9edYmfEoU12sbH3FnT97IeI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CL98Rq9wRjkc47k9KtTX_LYonQae6DoSPv4YPS2j5pA&oe=69E78E52"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htU06txhTh8Q7kNvwE49lk2&_nc_oc=AdqDqScEqBblMzukLmNI6GuVB5OoAUBrwfFKTa_7JQ1QHiG3MhvXHI8OyT4OUBaISNQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2veFO3pVCdz5YplHP4-07ZkpI7-_OM9aNIeHevSMduMA&oe=69E77833"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWjMExl5WlIQ7kNvwGJehzZ&_nc_oc=Adoz_ynwsfUTIYT4edBUQH4aBF8b0HQ5U6o2gG334RON9otNztesiRMunObu9IvLcq8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qZuUPNVuYRfqHzCcNN-4oHOOWHDcUffVOTANZdodWPw&oe=69E76365"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30RvL8i9gN0Q7kNvwGHNz14&_nc_oc=AdpSY5Jnv8uRcCngG6dE0iQKLXB_nFFSpWbs_c13jZ5pdk1E9fUpYJ4jjwcq1dv0rLU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M0YIg1TCRcerSgMv8ugOkB-dirxmACMu94kg3ZfC_Vg&oe=69E75B1F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
pZh6HrI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yTEAjQHzn3bf1oZFkLo6b6TKz2Rm-V_bfbto1JKYbTQ&oe=6A01EEEA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sq404WLF0z8Q7kNvwEja4Cl&_nc_oc=AdpN3ViIVxug34L1UA4yxLTf03hL1lXo2D3TZSsiVsOLRVb0H0efddpewH6rZFDz82k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ao2Bcn-8c-Mcb2V2tcCySGwroQAUKjhmOytIY58h3Yw&oe=6A01F1F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruCZTnyFh4YQ7kNvwFDau-T&_nc_oc=Adognr10LAaW5T-U8c1MEa_z0lITxl2Zy4GMrG5qAS9x9OVAxTmeKpHTmxYva2Ig6AY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZF_fwKdedikd1pT8OSnsDDVMDmMceYOY1NxySNcgOcw&oe=6A01EC52"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTGB9xgV_-cQ7kNvwFlbIhj&_nc_oc=Adq6xXMSmS7XtlDJDWB4_-_sueIrqvah-x9QrVWjkLR5JtNPCDkWfMOnLS0NNSbQYxw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CAlO4y3L3z864qNfHaeZ7xGEO-EI3KVz48LYhKI_y5g&oe=6A01D633"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ke2XsVebtQwQ7kNvwFReaHT&_nc_oc=AdqioBJ4fn3vdFssrHT3wKx1YDnnzjLQo_z8AhpeZDJiXn2K8jFNqU_gbGZJrwPaF5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bIIVOzVFgHEca2SzHm5FMX-euov7G7b0TSISvmfAciQ&oe=6A01C165"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WaFsMXEuHYQ7kNvwHySGSO&_nc_oc=AdpxYLRQiHtfJkvQu9noa0WL8GtL3SDWJJSu3IuonZp3y-1k4YdXPLqdJG6DQawewPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WhqL6_a0j3Kh19C2F25AfzlZh60HxNIvuv74ZKLmldg&oe=6A01F15F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
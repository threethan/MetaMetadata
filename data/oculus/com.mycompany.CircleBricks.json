eaHGts0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6Cb3Tf3hwlnxwiEuYS9-zngVoH7O0Fh6P_sktMm_d5A&oe=6AB297EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-g3eHVFsusQ7kNvwGf56CS&_nc_oc=Adodnu2BGWO9Id6MAgOJ8UZwJ1zG2YH8r49wIp7u9bZlijPr_fFjBoXca0M9sk3Y-6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKxCmYWVifyso0l4UJ6pc0DVqBctyDkaXiea-6ye1b3g&oe=6AB29AF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z86DD6laGSkQ7kNvwHIPKsM&_nc_oc=Adr1wyljgsUqO_lL_67Um3KUUZxIcpRHuJCFDrmLlGXUNp-AZh4mLT5oH2HWsn8o9nA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIem2nlAiGtlHb7uw9eVCv7Cu4V3oP2dzxu4UnqGC85ag&oe=6AB29552"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG8TykkhnMwQ7kNvwHW40tM&_nc_oc=AdogGqyRMSw-ZMNR8FKUBMNbrBxwe_h8-Y0gfSQbgXNDWTxpOm05JshAFMZK0_a7Fis&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiD2QB2b59B12W36XpVN_1t83p-b6QPLyJgI5mZq6O2w&oe=6AB27F33"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCpWouRTfJQQ7kNvwGRcuQa&_nc_oc=AdoprNQRJ8oBgL1hOn0IhCCz6NryDExSERIQJOaw97ex8nxjOLtn5PC6siRQhCMhJ9Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvQ5rI6y0HE61UBU_Sq_Ob7tISo0cWGdyX8UmyO2G_GA&oe=6AB2A2A5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kd40N00zhOEQ7kNvwHVgx08&_nc_oc=Adr3_bJ3ZFigBYcCGAqDL_azNGYVeUYYgtdoVWZHBbh5R3b_QWpJthK1avGthV2FNTo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMNzIg6JVTPPTirAM6FB9TBNpJFSqOnR8IMbLgIQvhqw&oe=6AB29A5F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
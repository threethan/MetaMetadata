=imuuqh_6oO0Q7kNvwFTBSxN&_nc_oc=AdnFUQ23ti18DUkRY_orJZfavHr5tzGSR-hNxZiTAB29MQyPu83jp6ZBk7hdQcS22x0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvdbLuA7xiR-_yTpl31CfkIHzU2pmiNo58AsVrhMUPisw&oe=69A973C3"}, {"file_name": "Shot2.png", "id": "1110660511112030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819421_1110660514445363_6186410734796643971_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-xl-WBTiYAQ7kNvwGs6wNZ&_nc_oc=AdnZ5NETw-72GDrKWwOc-xADz5eWfXOpfeITJsU3iikpx5JO5eHisV012qLvS8lHv5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afsil8VZIDnr9njFKsA5frbBYN_ttJYuZ9U1r-n7Nz1o3Q&oe=69A9880E"}, {"file_name": "Shot3.png", "id": "678692261393364", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831382_678692264726697_7703266729207161117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFp6dEiBJCkQ7kNvwHgo2X5&_nc_oc=AdlZb-QN8XyniHxIXnZsvC6D_QdsVIgWLqUWVG3jsnOE8pzID7rj1gN_-xoN8Wms3nI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs65z-DhMZ8GSTSpcMvU98HYMvyl9SV-eORg4xjzs2U-A&oe=69A9622A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adqD0FW6QEgQ7kNvwHvwemu&_nc_oc=Adm75DNEaneP35jaCoV6klLOouMc6vr_VQMUFDUkGFIZEpcNXMvcMYfberGi704ezcc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu_tYlJ6uzLRsro9QcpZ7PlsKwLVrO9vWiOR1F5wrdNfA&oe=69A96535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQzENLP7SKQQ7kNvwEaxd7r&_nc_oc=Adn3dT0ldFdMahAwZGkqvkdgKL3Z-nk6B-GXgiet61t98n1aiB-ACWodcwBb1e_OK7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvoBOZtZz-d9iAxrQwq2Li1F0-fIh_viltU7MAzGFT5Hg&oe=69A997D2"}, "display_name": "Circle Breakout 2D blocks breaker games", "keywords": ["Breakout", "Blocks", "BrainTraining", "Breaker", "Casual"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive"}]}, "developer_name": null, "developer_privacy_policy_url": "https://namcreations.cloudfree.jp/CircleBreakout.html", "developer_terms_of_service_url": null, "publisher_name": "Nam Creations", "support_website_url": null, "website_url": "https://www.facebook.com/share/1VavtPiL5F/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "1672577
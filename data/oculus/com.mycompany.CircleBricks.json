pFyOPFE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PqT9RYZECnj8tpXLh-Z5KrtFsqfPcuNpqmOWzGlCkjQ&oe=6A297BEA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sa8mpA5MyQsQ7kNvwFWKaxF&_nc_oc=AdqqiNvOnbcwm5A0ZRcdSxetot0FUiRjPRQmLUmcDLv4zB1vdKvdK5efRrozFU3WIIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MUvf1k-ThqqOpuPpS1ixVkdmUeWZBrW7p-P0dzW60yQ&oe=6A297EF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE2IZQKWzaQQ7kNvwHKk6pi&_nc_oc=Ado5yqfQhAK2dynFckQOt_jRSlSgboaPLv3iVeKZQR0RjE2_AaSJzKVb9Fvo_XbB5PE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xoRfv6C9o4UgVhKLRrRI94RU5fYYwLOJW6ROvQcy5vQ&oe=6A297952"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtIRLJfF5r0Q7kNvwFDSmb0&_nc_oc=AdpXbX26ePUyPZj8yox_0zHEjcUhQe2ThrqFTECCrRDVZZxILghUWVd32gb3IZ0JRE8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sjqNUe0W8Y3fc1zEow__hv1VHjVLcNV4bVX_hMUCKww&oe=6A296333"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dF6oFZvpYYQQ7kNvwG0zXFO&_nc_oc=AdqnxTAdJCQHFJ-9rmxVUS7xGDgkemXDUoRYtoLd_-OuHAqEqPmgsh19P3seTGdGxTw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-Q3w7rtFj9ZKDjO_FS-HwGDz7GNQ5Trd0oHuplDdCwA&oe=6A2986A5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYiy_UvBArQQ7kNvwHlIzdU&_nc_oc=AdpTZz0PdanN62zFmPW6sKN-OimjCO9VtZyzlipfcDEHbNXywCThSa5cvhFwAaokszY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90oB9a-jn99YIMjrY5epQJ6q2Wcie3_YK8sjFSzkhUWQ&oe=6A297E5F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
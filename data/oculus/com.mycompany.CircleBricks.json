GjJux58&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3t9LG3CU_6_YH1kzfi62wj59983-u6edSiNB4nb3jEw&oe=6AF08E6A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ouv55QXFmO4Q7kNvwGb6hLK&_nc_oc=Adq5VLElO5SVJ3BtnOvvw_Wn7maLsAINzB81HM_urvb-FdmIHlSnsJW-Q5ZBCDmR4gM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH1nT8N5h9m8Yj3I9jkZ-w8M0L3IgJdotoICOWzfuZmg&oe=6AF09175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9Hc1wIgRt0Q7kNvwHRv3Rf&_nc_oc=AdpWhZw7EteBrbEHVCr6rJsh0zwsxCuub5TsXLIyVogaKiXLmaGoWnSMf26wJXRGgQo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwHkT_MgEpZ4m9RX_GGCVvj0qY8YybL9gBLzWHd1sptA&oe=6AF08BD2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdAmSHIPFFUQ7kNvwHEQbuK&_nc_oc=Adp-WQbKMLUzjUYc_LyBhEDZE-lA3Y076bnFNpqFbC_0YAlToKqbhN7AHEV7N_Aj7eA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRHVKufqQ7rWy_awHc4Uw2sBbtdsIyRJ-9yTM2m47dsw&oe=6AF0ADF3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL6p8K_uDc4Q7kNvwEVogN-&_nc_oc=Ado7Bs-dj0bhFTXsT5FTi3UeXg69D-8Qo9OBNmaPyVBAHiUo0OBmnO7b4AooTTvX2VY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAoF1OluhjC4_0XGCI0BsZznBq3pZ--ez2u5Je_Tntrw&oe=6AF09925"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eBpRmjDG5IQ7kNvwFVikNY&_nc_oc=AdpqoNBzSW41eBUEgz3vVRmcBS6uq7KUt4WmrzNnyOHuJXBPWSmDngET8W99BH_Cwrk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdYmYpoSEJB2FXZRGuASHAdlaoqQU8Nxd9G-cbZEpBHw&oe=6AF090DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
793_736174579157821_2740953542277832357_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGBVM0j1VpoQ7kNvwHxWzMC&_nc_oc=AdoputZnIhrjcmGwrapLMoLYmrNy9nrS0YmZoHDhnOdT2oNg6g4IjfBxn-68TLIx50U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHADe-2sBHXp1FyDDtkvu9Vnl2_00Fk39aAms9KqHIefA&oe=6A8D8743"}, {"file_name": "Shot2.png", "id": "1110660511112030", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819421_1110660514445363_6186410734796643971_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3XVeKNZcVAQ7kNvwHCQ23x&_nc_oc=AdqEfXJGOGNvC3oWCKRtoOtVKWGeHqlrj_2qZdLzQDRNB6vGRTUi0hkIAOM3xLqg8dQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6E7efUK8aBc6gZsMdAnS-SDfuUUcAMdxVqrVvi__Fdw&oe=6A8D9B8E"}, {"file_name": "Shot3.png", "id": "678692261393364", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491831382_678692264726697_7703266729207161117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3-_3P5xqFsQ7kNvwFV4768&_nc_oc=AdoGTA2U58QicauVJ8SHAwPy8DLw_AQEsDS9hZEUBMkH4NQMlFap8gxE81M4Ms-jufQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpvPFzhYBhb7_Rke_JfkvR5B61EltyVHbl91gm-ubWJA&oe=6A8D75AA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxsPGTyR4n8Q7kNvwFz_wdJ&_nc_oc=Adq6x5DddaazfXm_5qu-znLYCXIPA22Pahf7YHPOrYRvGajNiZrEjMQGmaDZiF9RqtY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmLNdbbiF6WdnxibZ5P844ML-B6YkfQHJRuVGawPrHHw&oe=6A8D78B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb9P5fSs-6sQ7kNvwHL_imW&_nc_oc=Ado1j2SnFbyf6aO1Fw7I2pQDjeQ6q6sH-mNTo4HYwf7y4QqImeCTXm7ojCfabwesDrI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5ODeZUccXCQQ7n6jy_XWAgbULVzMRz6OlhR2EoTIl5Q&oe=6A8D7312"}, "display_name": "Circle Breakout 2D blocks breaker games", "keywords": ["Breakout", "Blocks", "BrainTraining", "Breaker", "Casual"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive"}]}, "developer_name": null, "developer_privacy_policy_url": "https://namcreations.cloudfree.jp/CircleBreakout.html", "developer_terms_of_service_url": null, "publisher_name": "Nam Creations", "support_website_url": null, "website_url": "https://www.facebook.com/share/1VavtPiL5F/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
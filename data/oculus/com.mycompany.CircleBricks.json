t6XzHe0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0QM89lMroZDZJ5_KfhIlUMDfJR0L1pKkE3WswdsNhxQ&oe=6AE0BC6A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYlY-_e5DZoQ7kNvwFhZUtc&_nc_oc=Adoc39nYWkLvnqfaG9CUwKM0XJ_sxehgik58v1fvzC0iww8xFA4rvdXA-7UCxc_kvgg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOshU9edMjADRwbFs8zeCeY6kGN5I_nGUkp4a4hHFXcBw&oe=6AE0BF75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPJyA_WyMDAQ7kNvwENxBVW&_nc_oc=AdpSSHL1DXhABEamIBJ3SDes4iTu4FptJ4mYL9UVb_tCBLD-SZger5Awy60qXnVtp94&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN7lsTHu3RXW2UvHv0LmUZLySRdQAKQVpDcWb9eZlCKQ&oe=6AE0B9D2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00WFBmkAFgcQ7kNvwFF2k2H&_nc_oc=Adp7RbZjl-rrmvDMTm2TluURwVqkJoJnRMaHUeUFRkPZOvB8jlQ8S1i-u7KQIvIK9_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyJ3U9XP0jTBgRaPlD6p6d7OnvxLrAnwjKP4lfzYMffA&oe=6AE0A3B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LMl98_AfNsQ7kNvwEON_1T&_nc_oc=AdoFI6hlTzI9V4X1ta18sCyJLxPhq6R24y82BlVgvEfyvIaCpse9wO6ApmsIdTu8bGc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3FyZdFY1KsULA9o00cqWuFgBALbT3_2VwXOCTMxzkSg&oe=6AE0C725"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSZsokrYxdwQ7kNvwH9cHco&_nc_oc=AdpgeW8WNfyT2gCHJ5uJRDlvnvzGipMlVmfqqYhcHC5ucGxn2FSUJbDP7q2YeJs8kaY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbbLOKVnZ9CspaoNjuCgkBrYVjTNhk_X3H8ANxoEzspg&oe=6AE0BEDF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
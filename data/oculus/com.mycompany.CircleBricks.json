ftf1-5K8cnWxx153mE4jVqZ337r7xyR7j7VS6ZR0me7rA&oe=69A18AC3"}, {"file_name": "Shot2.png", "id": "1110660511112030", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491819421_1110660514445363_6186410734796643971_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awUSwYAHu5sQ7kNvwHApA3Q&_nc_oc=Adnrh0FxhKwuZrzNhf5QSLcqa5vu4cab29DCRDCwv00oMAfbu-RaVUuo1aTOwR5ucy0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuXxmdqLo72FYRiIjvvbhJH-bM_cckh_IakHmBVd8eqEA&oe=69A19F0E"}, {"file_name": "Shot3.png", "id": "678692261393364", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491831382_678692264726697_7703266729207161117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PlftDeoEoAQ7kNvwEP0QU-&_nc_oc=AdnhnqqtP61q6wYblTskfgWI6U6Iua3QlDJBzlTtER1dacs7X8CqGI_mGPq975CrIsU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftAMUCDMFpyhFcpZUSUxRdyw7N9hlCzsExszCnxaDXGiA&oe=69A1792A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2ALvpEVHMUQ7kNvwHKUPPE&_nc_oc=AdkJxPQssPMN8tNtMgsGCfBLewh3lH7O1traHu-DrqjUJ9H_EG3-jDvf1p_Hlx9idUo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft3yiMTKW3DqRIkIXVHcQuLUWxLgIyR2N1wHvnGoeX8fQ&oe=69A17C35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgv5Ynh6koAQ7kNvwH98Dc7&_nc_oc=AdmMQ5Ns7kQByRnpqtKidsVF9DkC8Ia98DLcM57igmFxbYUbf82zUV5B2uW3nbf9pTs&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvRbil5RZPBVbuPZJgqjDFk79KZ9VNYDXWZApwnY4CAeQ&oe=69A17692"}, "display_name": "Circle Breakout 2D blocks breaker games", "keywords": ["Breakout", "Blocks", "BrainTraining", "Breaker", "Casual"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive"}]}, "developer_name": null, "developer_privacy_policy_url": "https://namcreations.cloudfree.jp/CircleBreakout.html", "developer_terms_of_service_url": null, "publisher_name": "Nam Creations", "support_website_url": null, "website_url": "https://www.facebook.com/share/1VavtPiL5F/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "re
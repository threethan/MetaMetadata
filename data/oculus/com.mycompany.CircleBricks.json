EvHjCFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QSSYt42wr6HPdl8Fkaoc_-mU5yjXkoFxAYTjg1IWkyg&oe=69DBB36A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNFMhDOydcoQ7kNvwHbMdfa&_nc_oc=Adr864cNUR0vKMQSthcDoeZv5bfn-hBSJ-OBp5Z7JOxcvFC5KRLrO2Elqbnru_hUlV0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YOb4BEvBWvrdtqom8oBBp33djB4yed1yEDSLQjcBPlQ&oe=69DB7E35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UloJCM-IyqUQ7kNvwGc8fhQ&_nc_oc=Ado5_w7ybcW9CkDV1rhYGRnQKuiYm0EP3fWWMzXYxHoG3x4lMOXbr1GAeQfBiT4hc3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fRafOGDkkseldSQ8IZrhL2aURFjZmpz_OiDKVOFUvgg&oe=69DBB0D2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8hi5f67D6AQ7kNvwEKqy3B&_nc_oc=AdpY2FAHwRx_XPnQaAai6ADCwCfhg-UF9lHHMNbRejaGgIVUtCrOzdofSJNa6vTsRuk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2do7VodqZAXIsqK8UaysSpFSXMXKoTROjVo8MxB8KndQ&oe=69DB9AB3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAJRgiwWCp4Q7kNvwHpPcIe&_nc_oc=AdqWaY8eemZ-7521qZPNO_50nTPNp_w_JM9Qei8vCwGAUF_OHexAkSKlSuJtTFSUotY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ks8ugEwr6AdSjLuSUhDvBuCW4byX8suRtINHVsNASXQ&oe=69DB85E5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82MuXv5EtkoQ7kNvwEruWtE&_nc_oc=AdofY9ndw9gUFgOknMel-Haqxie7RKCF48-4-kgdqaTB69Ub4ppMxJo8JDiTu39MEkY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10yUco1T19fscXoRk38fh4KqiRASMduVskL9rUrGXwSw&oe=69DB7D9F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
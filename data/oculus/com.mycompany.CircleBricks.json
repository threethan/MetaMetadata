tJ4B5mw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FK4OFC3lVNtaGVVo5LDB84B1vDQgklOADF0uxicrw8w&oe=6A0491EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gze41PR83soQ7kNvwGOjdP_&_nc_oc=Adq6qVOoDW5IWBKwnohW4InP_7e3-EM_VmahWZJkCj6bsyxQrjeaR4SOsaQuxDmgcZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wGTNEGE6bkPei9Paayfxtk9PmWwnsQW0CdAgF109_PA&oe=6A0494F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-_pRfF4CW0Q7kNvwHD4DRQ&_nc_oc=AdrDwL87o8INYls7klKOr0U_ce_rjXQEtNBcxciw36V99WfpQ6EPUXd81ZpZHkqIWMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PcxP87GM3U5o11hNvdBOr8rQJxNeC41P7g9kWaql4OA&oe=6A048F52"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lu1CBymuLjoQ7kNvwHngvd2&_nc_oc=AdrAK2ZhKckQK-EQprcguPxK_pCb3Iwaa5n4fbU7BS24SLHjFG_p5reYRaX7S4FN2wI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QoMoocEl6JxCjE_qe0pQU_4tQMkMBxZ20fGXOHKVzkw&oe=6A047933"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ke2XsVebtQwQ7kNvwGhj5Py&_nc_oc=AdpH-3yOwFLEvx48LMAPRirv-L0XcbcgcE19hbcCuBs2f-7XP8rb9fW_eQbInvUZ6YQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vwQNmGOsQmEhfRUgCtXVG1Ue-lfXoWq7ygYtbuWrHJg&oe=6A046465"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8tnciY7O-4Q7kNvwGoKT8G&_nc_oc=Adqi9fwZHhJIrMlVEnFCAzrxFE_T7G07g0YOz4ZCrjXOArU9NVRF4aA73eGQOklxTCw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4POR_mUq5SeI86iOPGF_jOZnNL8ZUI1WBauarOXVA-GA&oe=6A04945F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
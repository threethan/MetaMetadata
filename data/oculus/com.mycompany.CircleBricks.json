IVGQmnY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOae-903FToEiWsLrljeu9uGybgkNWTuQ0TbgxyvJFCQ&oe=6A64CF6A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vNgbSEAKLoQ7kNvwEhM76l&_nc_oc=AdrMedkTpdy4BDs0ZajoGMwefPP6UyRgSqgUeBSjRY3ZTzcu5iVtihlUtfkArqS60q4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUSGA3wgcHH6lT_Nn-A-JLuk0YZ11oEiUu2lWqdCmSiA&oe=6A64D275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOFTkzuQ0vAQ7kNvwGkiDE4&_nc_oc=Adomsu5_bNquBJZGWAEsTWPzfSyViioGz90UFDeKmEKm-C_jcY9SeJlWmru4a5kwxl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK0QbIggRgViquuHwSZFhIGEAi62b5tMgg7icC_5jLqQ&oe=6A64CCD2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_D5ggijPSzcQ7kNvwGSaTLJ&_nc_oc=AdpgC94gYJvuNpslnTioC5R2FDH2OcZ75DjoodcNEExx3hqorjkKlzs8n4p9oZWEzkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSP2vQJdR9Ds5lGuCKF_oNCVH8t3lqzXLtA-kTaMCblA&oe=6A64B6B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVbNxwo6dfIQ7kNvwEtI5st&_nc_oc=AdqjwPhl6g84udUe7mfHU4Xe5kZpRn0STPHkPqBNiH4u3fEqlVIzDuvFRF-xWi7jNl8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOEWxM88VmOPdKzbkJrlKIDegr45Q57tsHHeEr1IXlkA&oe=6A64A1E5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJHtk68TUsIQ7kNvwEYCQo2&_nc_oc=AdpCX8WYEPsjTvWT8qR89pVyGr2ZUJjzqZepQb9Z349lp61fDKgE5lbllyHk9HsBRvo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEh8XCJfFEmTCKJPF4u5O9N47g0HID-xUwTvQRAMMvzw&oe=6A64D1DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
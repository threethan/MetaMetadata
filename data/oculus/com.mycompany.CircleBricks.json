qDN83CI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn6ziFqMJ5vjxop6M2sNwcketElIjK_B3C1GAJnP4tpQ&oe=6AC269EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw1shGSqjL0Q7kNvwHHikZk&_nc_oc=Adoerma61qJNPq-_iv-fhCOwRITa9hcy2_YCoF_6-yIzfFagqv5T7lVDMoVElpdG5Jg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6JYasbNFBJ2nlP6sFPoZIfYrBzG7aHEQHbhsFEJGtmA&oe=6AC26CF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BAbnWOTuIoQ7kNvwEW4eg1&_nc_oc=Adpl_bC4aAkp-l0N9NkNqgKj08s7R1ForD_bOwALXO5vWUsRsRCVtUW80x9Ve8Ji9X8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJsVLyAHVAnD4AiCfMkZPl1eufdRoUyLLex9tkW2PUrQ&oe=6AC26752"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0RRzftbNsAQ7kNvwGJHo6L&_nc_oc=AdpJU6KQ-F5rvmkMoF1_r0vrGcnUSM8Z9YCBhKNw6ntZ0oi5CoWjLfATEHWAh4WoChk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqSuC73qCp_UbxsLAjdRIKGggjaVIbxwqIC9FchQOP0Q&oe=6AC25133"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cCD-8-fAWoQ7kNvwFXhiLR&_nc_oc=Adp-avPBLmdaZEdTxe6v1XTkZo1HYpSx6hyE8kTXyUyJAjwAAfWW6t7JFQkk3tJK-do&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeS4un29iVDKxeZ205FCniKtJmAafBY_JMgnzs7VqOPA&oe=6AC274A5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad6PRXpdnrcQ7kNvwFWWGys&_nc_oc=AdoUMnEa4gp5ckIIganjXbU4orJINiLoN5nRhZuZF5bwvflB0SIfYfUZwHg5Abszo-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEMtlt_yle__kfhyHkBsgvEcNH8JojHUFY0Lm6J_ImRA&oe=6AC26C5F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
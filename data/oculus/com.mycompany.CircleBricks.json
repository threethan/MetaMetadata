kjbFRzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8krFM7F4_FCg0gErZuub_w_mUz1Ufq8nVTq48Fmboyg&oe=6A998B6A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywb0qNosBokQ7kNvwEv8Ej9&_nc_oc=AdrloIn-EGfw7rdKusN4HFhSzfU-0D1mGCSBJ-wZQYM8IxKO9_wGTzWL3hJu3CrWxew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk_DL4YapM9RI3XxuKM1syOfsGZjoWAYFHZgAzrgSIpQ&oe=6A998E75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPgDTHnWT08Q7kNvwEywRIK&_nc_oc=AdqSXCKq0ldrqXEtGnxprJp_0Dq-kg_JOXUTjiNjbBd73ZKney4DjTCJd3JANhzhc3I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtSW5MQ1RgzqYGSVpKi78Yerwavp1OmdmwvPueAHnppw&oe=6A9988D2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fjwe_VdRCX4Q7kNvwF5a_P3&_nc_oc=AdooxShdW1bCzA1cL1bfbZzDwLoP53WYCwFNOfS16El8Lp78X-t2_oQOfhYeEsJRBh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuhq4fOED1ySVf1CyxFowxtL7jjCtYxFaQNDzfGHsp-Q&oe=6A9972B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tqAy_OzL0IQ7kNvwFCo6Q3&_nc_oc=AdoKhPvG8xdWJaa1c7JtVkIlGp6L0nBIWTP2690vkPtGUKQekRs5dnK-fYmB3Vx4M5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6R9iW-Ze68qGwFryWb8i7qUH0JGYZ_YGZZEOAanKmBQ&oe=6A999625"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rb9zfDjbYgQ7kNvwHbCOnb&_nc_oc=AdoD0MNvwtEFprpgANmZ6Sw2YYQ7gTnAAcKHVx3_6cvnZA55BU4JYLrZJdCyUBocgRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJptEdqI6v1bD27bXDpeUmA72ujoIWZXO4uEEFgfjSy6Q&oe=6A998DDF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
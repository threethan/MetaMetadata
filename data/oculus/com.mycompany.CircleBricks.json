SnhhRGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCZu7w5UCMvH4Z5DYrwGbuA6uxQ6QGA-fDvpRm4FgDoA&oe=6AF725EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwpiNrLNTQQQ7kNvwFNqpku&_nc_oc=AdqwSbxx4NzQF1TEd6OZ1LNPcjDei6qx2DEPV8pvt2m1sgauzkpU7x5OMqQKSk65jQM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw2P4arTaFfH-sddNzhOHODf7c0w1rKLTi7ApRSzEAAA&oe=6AF728F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7_-5J_J0n4Q7kNvwE87eG0&_nc_oc=Adpy7OMhhQHXGoOHGAxUwhhCyPaP3rMF2B4Fh6si6kgrrR8EgbVNsE_RQF7Z34qh8v4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsYaD4jXcSM_B5-1isffLtNIRiBIHHGUj2GttEutLtFg&oe=6AF72352"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suvuUhHjxVUQ7kNvwE8wwwp&_nc_oc=Adoxosr4Yc5hItCyKpZmGmEb5S98FIfocvdaAnpxhCv6HuDAWktyvkU4VZ4vFt7n6Tk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGn8afZtU6-pXyPO2-Fd7Kn4bMEyt82a1FgiD3mCDX_w&oe=6AF74573"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoGMf62XpV8Q7kNvwF535tP&_nc_oc=AdrVjyY8bnpD4Fa6TR7SUeRR2XCNZ1DT95njNZiDJws50WksYQ9giyx5Y8CyHCIPfC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYcZrAApUtwspQtWcDmFpljp_S18NdNayRN7a715ukqw&oe=6AF730A5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leq3vLTSsSQQ7kNvwEfZLoG&_nc_oc=AdrWXZXJQh8-_mtiVsxFesVq1cDlzLWHl-j-s5ENNd0WaTosydqvOkhc3GsuyqJIESM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI4XHFHhSBRJM2Fj2tVCweMLW38CSpiPgwgGnXYvLABg&oe=6AF7285F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
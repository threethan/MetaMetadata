oZQWSj5k4cYFfk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwxXUazPQI76VXFfPSnKNpRUKI2aPxv8WUJhIL8BXt7A&oe=6B030675"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBwC7bvOA4sQ7kNvwEL-zVo&_nc_oc=AdqlOmykzskmxMzoPqg7FdgOq2KFKJyOW1Xj54ICJ6aSwtF9pWdliR4Bx9Lz5DqP-ng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcoH4WJNoRz2OjOZYnsdVGpuYh7t-gT0pjtTslHJv_Bw&oe=6B033912"}, "display_name": "Circle Breakout 2D blocks breaker games", "keywords": ["Breakout", "Blocks", "BrainTraining", "Breaker", "Casual"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive"}]}, "developer_name": null, "developer_privacy_policy_url": "https://namcreations.cloudfree.jp/CircleBreakout.html", "developer_terms_of_service_url": null, "publisher_name": "Nam Creations", "support_website_url": null, "website_url": "https://www.facebook.com/share/1VavtPiL5F/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24184572587825992"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830893_1056075093298398_5978155163250603428_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsAr2Bi77-UQ7kNvwETVQX5&_nc_oc=Ado9hH8HypG6X8ZKDbTC6oKTD7KA_astw03raNYq2jnSN8wNjqqafA9baZhmNM0mZX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRptOeZjRDScRHWnXxTUbESz1EO0MrYxZ4up-SWoV90gQ&oe=6B03307D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circle Breakout 2D blocks breaker games", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Rhythm", "id"
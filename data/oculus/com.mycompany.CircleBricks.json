tyZ9a7E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfyNoCBvxmLqg1wifdneAjWXedUJfPuf0B2j1HovKx6w&oe=6A882FAA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Z6eZTApoS0Q7kNvwFAfEFj&_nc_oc=AdqgxU5vu9txcgf3hMAEbC7_zYXDJisY2GBq4moOl1EDl-rHg-BcU9EuVGo4nfXXpQs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKl8fPw98xxcVU5XsUiIrmBEjv6LqBpqfksKPqHAIYAA&oe=6A8832B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9S3TmnN1X94Q7kNvwFACz1y&_nc_oc=AdoHjK-bBxHG-0mW-RzKAHSOyns0KEPz31X-D5nP_48DMAnW-Cg3J7P77u2Rif_aycI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHSQGFS6RyJw0Dw_AbeVGIjQcM-KcVBaGPwTV8FyDSTQ&oe=6A882D12"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5QvPGdXf1MQ7kNvwFQNcOT&_nc_oc=AdpXvc_No4sY25w-3tI4CFE-xFeFG1RMKrEBxKqHJiaToaMqlXgA1O4bHyAlVtwa3JY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE74LLM6U9Ggn-h2UNb4hSlL_x6g8Qw2uLrEw_A8Tkjgw&oe=6A884F33"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4WvSjAccKAQ7kNvwHHQQSt&_nc_oc=AdqFDfycjcm_v44Huj4_RoV0tNrOq7cXd4LlSW6_Cm2WZ8ebjo_PJDf18grHd_pj8x8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhtTgTPFeOVJTnxeG609vthH8Q1Yi8C_G1nQJgobSe9g&oe=6A883A65"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYOCmnpn-sAQ7kNvwGwOS0_&_nc_oc=Adobt8BQTS3NmJnzCc-JZMl0OwE445yxMpyyzxc3LEwl4a5SVfUJT0NkHL9cWCNYifc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8eD5FDya7aGERiklAVkByPJijLi6ndwu2ldJHXylmVw&oe=6A88321F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
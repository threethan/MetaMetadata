22A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adqD0FW6QEgQ7kNvwHvwemu&_nc_oc=Adm75DNEaneP35jaCoV6klLOouMc6vr_VQMUFDUkGFIZEpcNXMvcMYfberGi704ezcc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu_tYlJ6uzLRsro9QcpZ7PlsKwLVrO9vWiOR1F5wrdNfA&oe=69A96535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQzENLP7SKQQ7kNvwEaxd7r&_nc_oc=Adn3dT0ldFdMahAwZGkqvkdgKL3Z-nk6B-GXgiet61t98n1aiB-ACWodcwBb1e_OK7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvoBOZtZz-d9iAxrQwq2Li1F0-fIh_viltU7MAzGFT5Hg&oe=69A997D2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCzCYaXh6rgQ7kNvwG9ROw2&_nc_oc=AdlSW_gKAHQc9_N1wtsWW6Z5N-9afADZPLFCaTaT5cZWpaX2P2Zcqsbyb2DxcdBAmLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs7GlR2uGEjvkfPbRyM1rYMRdZHt_oeiRwKJxv_uWWjVw&oe=69A981B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyf4tII_qgAQ7kNvwEGB42z&_nc_oc=Admi8YCf1ECmwd0I1ewyxkV_CfBlTTMsBayclrNdIdtZanzAjay0mXaOKQBaTnOHbWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv6Y9GdlkNdbvxPC2_UGW3J3WoG1aE0tBQwOM0GjdpNpw&oe=69A96CE5"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvaNJySlXx8Q7kNvwH_-N_A&_nc_oc=AdmVB27NTYhcjFX7VYW1Q-VjLK59N6-l30myaeIpMAJBQtixY0XNeHCipg1Sstgi6AY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuIpTE2u8OPSN5qq0MytfsUOllxS_Mj928RoPmS7lD3Nw&oe=69A9649F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828816_1055972959474869_830596178173793119_n.png?_nc_cat=111&ccb=1-7&_
nOx-v-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpnBTDmN1kjXo1hH-5MrGxW8uTTOirnzKnGc1g_eQ7oQ&oe=6AC65E6A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvAU_8w1YoIQ7kNvwGIvf9b&_nc_oc=Ador2fH8lNl_hohgI_wx_jx24_NWKi4xYb6eh7kyH63GEWAZYCVaYUNOzfoZJ8RxoKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpL1TxUFXmkgNOfxOH8R4SijetlwXKxU-CxHtHR5bviA&oe=6AC66175"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvVW6rKCC7AQ7kNvwEoHrOA&_nc_oc=AdppkTM59jmB5La1_oJwlS-xnte5ta499mKywEbGcdNvCKgSYrWWW5QZoeKCafOTjvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLW4_8H9JyRcowUo7c3qXoorvVt9y5_k7h3_oGYJInwA&oe=6AC65BD2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-p9SPWYcxQQ7kNvwHlBDNZ&_nc_oc=AdpCYzrQhqMOIC1olQSZXXI5UhjG2bxVd9kwEiUiZpFW-64UrbYfBAnCY3zKKbsnjPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwlm58EFTALYTFFdq7wPMjHj2F3L9Qbv-ljXtbM7-m1A&oe=6AC645B3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHUEs9h51qkQ7kNvwGVqmAF&_nc_oc=Adqn8cXYduyC2okVWu1lbi2uriaa3o4xcInlP0gsjXNsaCuvUERW2MqaM0dfxSeT2qQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLfRrqyhRt7U1VXsBK82cCIRJV6CVG6dB7gx8LjFX--w&oe=6AC66925"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgrgdrA6YjEQ7kNvwE4ooVM&_nc_oc=Adr1BMHgktZEBupNb7Q7WvqUViHMyM7mSNS2rX68BllOs5AkcyiudA9HndWZeZ1JHug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8VF1Ss1gtrFup63ii_SGHoM3tMZYvSUIQBidsixcJVw&oe=6AC660DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
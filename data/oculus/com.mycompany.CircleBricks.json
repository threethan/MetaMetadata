EJlgFqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHdCsMg2z7JiWgCDigLMEdKwE_bXkLj8vbsmOcSeRG2A&oe=6A5E37EA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0ThMiYKGUYQ7kNvwHAK2_a&_nc_oc=AdpUMcng5X9oBqcPjCxz5nnjRKjQtn7q8mJHOgYhHyiD0YKSwYK4IpzY11_Fg6h3dPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRtYegb-QBSzTTW0r5NApalWAYcTaNAsKwJ-qiqykuWg&oe=6A5E02B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzz-C3N3AsAQ7kNvwHZC5Bj&_nc_oc=Adpo3073pWTRhTOcmm33PeeDAs-gimuwCaEiw6hBOE2S4ZlGJ6CtNxTISOB9Z-bazEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkCFJ1QEkHisMPFJd4O8LdoWgW7L-OaV95vg3IINSsVg&oe=6A5E3552"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEWI_UwdbNIQ7kNvwGjP9H2&_nc_oc=AdoKK4GB4s7G6Ic9fhpIEktMyq2Whvdi7EG8owgGU0pWlqjmAbMEpj6bKIb4uyvlO3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRN1XF-fzUlDNlqE8FApQ72X6LuGKDGIRZOZSZ5wxD5w&oe=6A5E1F33"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CnfKJt00pkQ7kNvwFr5Ws6&_nc_oc=Adp_qDazclBcW5EMou9to5hkHGxvEF0YmbujVh3TFETjLR_r_IpjmDg1FQCvtG5zMHk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaafV9CRgXa-XO-uP2_1gxtGoFocWD31jorCMqD2YfUQ&oe=6A5E0A65"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mus2QT9pHEAQ7kNvwG5G8uq&_nc_oc=AdqeuIeiXxbI4RaP9if0zyiulwPlLB5SnDeNF0PfIJLFGA1r6Xp6VMaZvgta3s_laSA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbAHGIXta2rgBs5rqO7-6ltiWP60LZ53HluK1hqvdu5A&oe=6A5E021F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
S3-mbCg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UaSZY0Y2Qbr0FlE77iZ_ymHMo0MeFDlTX71ewZgV2Xw&oe=6A32B66A"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FrY4UT6oQ0Q7kNvwG4NfU8&_nc_oc=Adpd_LmT0qhVrVm1ULiZka66dgEvorscufPy-hCRFMkEwHf-PZzw946N2NnZwo96OhA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UJrO-duXyUBh-amLrZvzQCwpghnIt5ICNTDNrDOo9DQ&oe=6A32B975"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEXlADrx5bEQ7kNvwF9P5XE&_nc_oc=AdqE5_Y5e4hBh5JWePNR4ySeZgze56R25LwKu5ZqBCP143IvKHcnqaN4nrdtyWjT4ew&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96I_RKbJI6GWkaockZr5JqcdFCg9PGuBiITTR1y-604g&oe=6A32B3D2"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siDudFYYBBEQ7kNvwGpXapx&_nc_oc=AdquV08xuQMDz2U8EaBH5be8ZERsQieJWqKOgCVlZDABlY9uW5ADZKRYrqlMjNc3bsQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aTR1ZsPlnC0nzX6_PfNXY5eKWCvj7AeqLhHx2bAliqw&oe=6A329DB3"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIT0hjlYrYwQ7kNvwFUJHHv&_nc_oc=AdqEVdqNsgy4JEGSDKCO8jmZRUGNzjU_AAgHpyCIF7TW6E44b_6sdKUVsOOvLwWgBUQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KCUz8xui-HxfT3uUDIpCyKn96kZ7FD5sf5GlxPl7gbA&oe=6A32C125"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9t4lRtOcvMYQ7kNvwF2L9-T&_nc_oc=AdoYEJ3Ab2QLUy1LjT5wHkelJi13HNoYsCvGckU6EpE2A6fW7sKnD6ssj_7IA0oektw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hf5ev7TSxP9evp4nFpE1d8161nRoDjGCMDQc2JjkPiQ&oe=6A32B8DF"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
-HWOIaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGb9BWpXYtYLWilb94Kqdzv7ntUn8xTPUa7nNJH6WdWA&oe=6A5B5CAA"}, {"file_name": "Shot4.png", "id": "585539091291926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822045_585539094625259_6069379373409993880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpH5TXKEfk0Q7kNvwFWKfe0&_nc_oc=AdpDPyqVfrlfK7OqzNWp9wUbIavvkRD53AQivmqNoBcq9T3KU1W-HPJ-pXsxN1ADBuw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa24e5VlWRrFKlnV-qxp8zGgKcCJASha3PwaMVKF0tkA&oe=6A5B5FB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CircleBreakout2560x1440.png", "id": "1204131848147991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820058_1204131851481324_8818813520380379182_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tmomYahO8sQ7kNvwFMypf_&_nc_oc=AdqGO4fRGzcgKRsOYwK3vRBLcFKA393yVL9dIYncgwC2kwYRHyUC1d1sOSP51QUZpz8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRlig8fakB94Mzqnk0hpFfoMpQ-mEwSk4HhK0kySGAJQ&oe=6A5B9252"}, "display_name": "Circle Breakout 2D Immersive block games", "keywords": ["Breakout", "2D", "Blocks", "Casual", "BrainTraining"], "long_description": "A revolutionary block-breaking game that rotates a bar like never before\nFree, simple, and fun, you can play it in your spare time and it's addictive\n\nPlay this brain-training block-breaking game with a new sensation and unique visual design in four modes: Normal, Speed, Chaos, and Max\n\nNormal: Easiest\nSpeed: Fast ball speed\nChaos: Blocks life game\nMax: Speed \u200b\u200b& Chaos\n\nAim for the top of the high score rankings overall or for each mode\n\nAim for the block in the center and hit the ball\nEliminate blocks in succession to get a high score\nTest your reflexes and sense of balance...\n\n[How to play]\nFlick left or right to rotate the blocks left or right\nWhen waiting for input, use one touch or one click\nHit the ball at the block in the center of the screen to clear it.\n\nClearing multiple blocks in succession will earn you a high score.\nClearing all blocks will clear the stage.\n\nModes: Normal, Speed, Chaos, Max, in that order, give you high scores.\nAs you progress through the stage, the number of blocks will change and the ball speed will increase.\n\nCopyright 2024\uff70 Nam Creations", "short_description": "A new, unique visual design, brain training breakout game"}, {"images": {"nodes": [{"file_name": "CircleBreakout3000x900.png", "id": "2179087925845946", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821849_2179087929179279_7828120221150218200_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEWI_UwdbNIQ7kNvwGMafvU&_nc_oc=AdpS0Ji8aScKnQlnFIpJ73wZQyfTIxWvV7bR4ftqzF09qvGCDmHFGXpWYUcUOJYlmkc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj94BKXBHIzFFW9khu0rZR7ExSVmgy9zI32BzeZFDpeg&oe=6A5B7C33"}, {"file_name": "CircleBreakout1008x1440.png", "id": "1723935451625163", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295391_1723935454958496_7569400114340341643_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpWnHv2YF3cQ7kNvwFOGjxq&_nc_oc=Adow0Im9_fXEzaOiv4iPhdjS76iJW4MfrK9Z5j2lxRSHAtv0n5HzizamwBty64OPlb4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCicgySRw2bMDBRdrqJNhV_CkdyJg0Wg-jnHBR8nJl3Qw&oe=6A5B6765"}, {"file_name": "CircleBreakout1440.png", "id": "1252350136423870", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300541_1252350139757203_6277398520691606500_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mus2QT9pHEAQ7kNvwHUtRTl&_nc_oc=AdqYMsFpfiNPQ8wV6IRFhWPXh7SShNHuKuFJUKvc9skHy-Zd1qy940pLSq2Ts-DAiTY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI0pTMplHSlQtAbvjwuPeSs06SBLzfIiEf0ABFmzSiTQ&oe=6A5B5F1F"}, {"file_name": "CircleBreakout512.png", "id": "1055972956141536", "image_type": "
JYcQ7kNvwHDVsQc&_nc_oc=AdryogkN9Fsmbc5N8q48aKL5mxqQ6ikatKgz52lJ_CK86FM_6OVWcpo8eI-DOXBBr6o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKOfqPKBAao4URQWrGgGHL9AqtSRr7ueJ1Z26-heBILw&oe=6A973E16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xC2BdNygQEQ7kNvwHpzAzC&_nc_oc=Adq0cD4uFV7VsbKmnqERpUewImWI12CotN2TyEyhZLYOi-1at6J9Do2WstwLOcovvdg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_sShfSaip0q5ZicY3Nz0tj7N595POA5FVP05fu7j6HQ&oe=6A97260F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijtqO7PVoI0Q7kNvwEFCFyh&_nc_oc=AdpgB4X1O7hcuzjPPKgUXB_IlEqJxBjYlAg-sHw3W4K34VBn3Oc1iYhRLcnz2GdJIXg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqWTko1O_s3cf4jlBeSD45_GijADuKDx9ox7ekIdMwMQ&oe=6A973836"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
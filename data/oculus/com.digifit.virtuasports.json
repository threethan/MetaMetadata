H3cQ7kNvwFF0u8S&_nc_oc=Adrp2Q6e27HiQhbjZkLBv37B9iNjfYJuz-6h9hn2ROnYPt7cfgNNXr6rf2zOEeK2Cpc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94OHV2pqOgOVtzKt7OlOVgm1i06cvPp463dnyd5Wb35Q&oe=6A426D96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTI5ySs8xJoQ7kNvwFOCEFq&_nc_oc=Adqlms_X2ehfAOiJpG7j3MNA3RDbfKl0F7-anm5KD_szo0CmaumNSUHbGOWdOOOYlwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QnhA_h1otMcPVLBV2mLGuipPSCc7DH5lMkpwJeCFD8Q&oe=6A428DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NhVFeoHSwsQ7kNvwFHz7k5&_nc_oc=Adq-T_X4rYIwPgHITekeYgcXq7tEWGoKs_W0uNq2n7-RfsgVR-lFoh6YRhN4Kgy4HJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cYtSrp02pbRsrLCqEtIWo7D8S7OTP2WvNxE5VW9r52w&oe=6A4267B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
MJsQ7kNvwGTJceZ&_nc_oc=AdpWbtQ51UX-Z7ae61NopwmpEusZxIUbWXKpybKZU2nYl-88Pb93WgkX1xr_dmENOe0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ2RHbr0lxxytivx4dIsrHPx-Gn_SVW6opzDMfPd4r5A&oe=6A6B4C16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xln9LVIw9AsQ7kNvwHEhdPW&_nc_oc=AdqUxqx1SOysCgee-A-D6d3rDyPlB1HwtM7MJpo_M7lvLX7l4NySLcJKcbhtH-k5QU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqCOjIPZRVIf8lK9yI3Cb-if90wcda-6Fa0Xerbv2jQg&oe=6A6B6C4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziN_wSN4Q6MQ7kNvwFA8rhu&_nc_oc=AdqyCGxdE6t348MTwqr1o5PuEaZJhMwU4rE0uJLQ5bQcJqHy1RO4BCWPUsSbrJdl1No&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXrynFI_2pv-YTebowcdYuc4ObfeKFpkV8KJWpNCPd1w&oe=6A6B4636"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
Lm8Q7kNvwFcOtfI&_nc_oc=AdotfVU2PxBdkeLuKltaDYOhP2wF3Pg8scLGdIysWsmMADwHAjSDYHJxPvuE4U1O20c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80sJ0pykG8bVAm9FO8IJD8xv1L3cGdt22RmbzcmhTh7w&oe=6A2EA716"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk-Wq7u8zrAQ7kNvwHtgrTC&_nc_oc=AdrmZw8GFMTP-ddmZJHioZYJ39x36EX6F-4EdcFtj0G1PwovQaOenTJLGYrt5pYtew4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uFS26Hw-nMkmwwX0J5GDLjx0rqRKmPmnvPrFXVuWvNA&oe=6A2EC74F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8of6B32bU4Q7kNvwG2InSk&_nc_oc=Adp5QLhhvllI_riIAce3mdSfsqyP6qwcolIAEFq_TMso8Wo0KBnIMEistuvqWW60QQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K585744T8cW_FSZicv10h6AZxFEBJwrbFiF2UhViFIg&oe=6A2EA136"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
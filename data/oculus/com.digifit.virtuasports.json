Da4Q7kNvwGhVO7Y&_nc_oc=AdrIxd5W2vpuJ81Sv-grer8R8pKxRV5z9oyR4gg1KG1StGHy21rx5iA9OHnfzqquVgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xuDTLDFleUwlTLjhmtl0aWLgRlvMKktk2p2sUfVcEgQ&oe=69D8F596"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYuNQUBrLXsQ7kNvwEzerdU&_nc_oc=Adoj7IiyfKWMYhHAZwpGlb8tpHXEz5HYOpLMDpuyO83rl9wmyiCP0HpBi9fICOpnTpo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39gfd0Xnun2B4z70MYAUiXo21GbVD6gp-tuAnUCF_xdw&oe=69D8DD8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3k_6wjL4a0Q7kNvwFEPALl&_nc_oc=Adp8m8tAmhFUFR7zKbgxhymdfDkD2WBDgVv1oX7LsVgl61ZFmT84H_oiRGJAGLCEN5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kHxvLmi4AEjoP-EnzPt8SO6diI2zqw9uEzDwoKUYFkw&oe=69D8EFB6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
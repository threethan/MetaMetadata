nT4Q7kNvwE62n3G&_nc_oc=Adqe4xv4oxByYA3DG6_BIE_TZCWTvrgjwoiPCHti8ZkMYpDfZu86GJyI5VY_09cKjIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzfurj2EsZol7UP6Lvfe05HZTUiHQFGZ5o76qdrS4l2w&oe=6AEB2D96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXeFzsPTZTMQ7kNvwFnTeaN&_nc_oc=Ado93odPztKDKUgdh0a5jh5MAdud-Kw7fjNLo5tbhVMCxvBmQHbmitM89TfQtEB2Kyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIDdtLXHjUtn0OaQjxQpcHqo91JjTQ8gcotbDBwTO7Vg&oe=6AEB4DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ttpb6PcT2cQ7kNvwEuPgES&_nc_oc=Ado4csgT5LcwTR9ulw-a1l2dzoiuLtSWqQuyCskPY2as6LODUOeXIx9IY-GX28GTrGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuaYAL9xh-XBXIWvEgzqj81tjogtEb0nu2mvswJwyUAQ&oe=6AEB5FF6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
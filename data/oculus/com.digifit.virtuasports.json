_FUQ7kNvwHK1R8e&_nc_oc=AdpVqI-GwaxOqPohBzCLI6g1ivglPfDgwEl5ywlIwDCdOk3Hmyrz1DYjgiPjgsZ_cVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NVmr8C9nD4svM2B-83P-8fDsalBYLADS6au0xbUQsoQ&oe=6A0DB196"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRIFo7EgAFQQ7kNvwGPq3vY&_nc_oc=Adr-wTGz1ME0PnLwcRX91BfddT28c5aGNkUc9dkO_pPegIlNyJSHSt3c0QdGpLDdskI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y583VHbUlfnsIR3EgnXp_ZohEinl6D3JbAz10oAggAQ&oe=6A0DD1CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd2gwmIim9wQ7kNvwGvb9hy&_nc_oc=AdpEU5bNyUx_7e4hvH28ApQSHS1B9Xzyts76RBukMEycuxdvpkuQaO90iy-kbWESCk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ni_GIteQq-aXnJ3yQTM9sx8RCBDJyvupPqEitzojYZA&oe=6A0DABB6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
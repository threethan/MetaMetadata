pPsQ7kNvwHvOm1x&_nc_oc=Adqh5vW4U2mwJm6dE5tonNuEs2bKroXwHMRKg8Jy-jmcw2usu7ONOLecn51eWBVsa-w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXVoNYkEMPGkzL6T07tPxUVPpMozV-0a8kM8crFY0CRA&oe=6A806416"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxME19HXqNkQ7kNvwFOSYc9&_nc_oc=Adqvm-YMESIcqYH7Pjf6wUcuIqbolwkxM_g0pz4XFCJZmhnEwmWRKSXezriDYWewhyc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFchJrR88P9A1K11WhNWzmsr0HImCSOy9kYxmPYvqu_RQ&oe=6A804C0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wyqm5jaqpe8Q7kNvwGfbMx0&_nc_oc=AdpYhvjm7yLDZOFsXVCC4ou1pm0ayRbUNBJd8oPcHCC_yBHK7uswrpLYgotsPVFxJ3M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvGmzHEgWna0w1cdZlo4yPfYatnTnVd6jk01UlrfbkaQ&oe=6A805E36"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
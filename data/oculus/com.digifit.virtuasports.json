QvYQ7kNvwGN4jlt&_nc_oc=AdosUu95BPdIaW0ltdi7YdKj5jDcrWS8hupJ82jzLwUsLw_TEzGCkZIVR0cJGjtZXGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lk6QssNqjeHEsUNFRMF7NgtQyNvEZfyNivzkbYapAww&oe=69D50116"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRZazGpbH08Q7kNvwE89llT&_nc_oc=AdoZp6roVw0n11bhqNbxyk7KdZd1hXTVZ0rOlwMb8CfEzNuysDBQqh2mioIyJ7I5Myo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3he49_xWiF3zfkHGX-FvsbhelTP-NkMtUWXVY5oM9ATw&oe=69D4E90F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTgLvENTcLkQ7kNvwHlqeSe&_nc_oc=Adp0N2PhQKxZpShNmxfSF_8Vd3SC-deds03PROqwPtsUs9PKpPDZl1Qin6c_U1D3O4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MtsvL-GkbPr1cPI3yc318bXU93aefvmgPjZqNH7hkRQ&oe=69D4FB36"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
4p8Q7kNvwF18-5h&_nc_oc=AdrJKwvt9IkKOcqVLwgwTEOwX5vI5hAAlHRYHG2e1cQX6ZxhL0I0_D7Vvq-uYDMqPro&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmWXdk-KKIfKXiTTwh3Vb21l0JRfryOorBZ6OylSY72w&oe=6A8AF016"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brNuxF4ikcsQ7kNvwFpbB6C&_nc_oc=AdqG03U2TXtPQYHoijxcNWrNAHSlyXRag7JpXmv2i7IbAaVbQjmownzZNnj8v3FbrTA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOMLwGfNuKFogCRA_LwbZr573gv8G9mUyV76QyPYt0Vg&oe=6A8AD80F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTDa7QzcuPoQ7kNvwF28_BP&_nc_oc=AdpUVXYksdVqOxllHzHuBjuzVPTeeMFQW7kJmCzdFikpNA-GnKNZJrZydNg9C863Evk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF04ZqSjD4auyigQ55OALPK7cq4AXE_f2-ItRd6NJpPhg&oe=6A8AEA36"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
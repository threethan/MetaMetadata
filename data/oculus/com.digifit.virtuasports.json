7w0Q7kNvwEYr7gK&_nc_oc=AdppsaI6KgzvxA2A4DY020TaE96F8MxokWq_JGEaZAX4u1r5E01KrWHDQOewdpFY_Qo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nud-NVOe10qOTA0GfYwHcC5SzFCcyGCeZUuhLDGo2ZQ&oe=69EE0D96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awonmiBkMfYQ7kNvwEZ4Jqp&_nc_oc=AdrK_wQedEsQ58cl-n0VB0FceASl6jFKglq5wCsiIN5oMheyyXUmwnTTxM9nOLSQP4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HwTIHOIvMSyykWe_pgfJ32WYh-Py43TacniYithNazw&oe=69EDF58F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZdmK3uul7cQ7kNvwFmK2-q&_nc_oc=AdpaPfkZ0AeVyn7qxylpp8EiXf0qLe4kKT-fPVkpp0v-TzxQUDfFG01DGTl4Fxwi4Vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IRTxJyRpZ_YCgKng-6LhOXbOpR8qSxbJ9k5DJUJsL9A&oe=69EE07B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
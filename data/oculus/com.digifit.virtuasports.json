8VgQ7kNvwF5DtBd&_nc_oc=AdqGEmxaWiMJwugLlYmCUBdXYiui_Hu9KuAKNgqUR3RpPV8pkvNKhjTrhi8anLAx_fQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LJ3lehNBXHe6MlkR9VcdHdVrPBSiWybC96nPCavaXwQ&oe=6A1AE096"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQdOEgrWb7AQ7kNvwE_9lEi&_nc_oc=AdrpBMekaERdYcIeTTIbGi8rrLZMU5IewoDhPQbOVfKcU5KFDtt8Vzo_qjH0E2gNQEI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74LqtRQ_7duBJDLVbivq2JF0xpa1dmJQZeJUdX3TcXuQ&oe=6A1B00CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlQGjESLQHwQ7kNvwExJm4T&_nc_oc=Ados-MpHSzFbqg-JcYlkPTUQRmi1gHI67xUnY2eH1Fll1DR7D_pX8z1etIo6J9FZ24c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iH8d1VsURRBizwHZAIMZucZ6C5CsFNPuVZ3-kU6pk6g&oe=6A1ADAB6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
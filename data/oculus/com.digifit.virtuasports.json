7uoQ7kNvwFYq1hB&_nc_oc=AdqLhYBPA1vI8POIXUE0Rwt2XaOGwBRGPIjpNTTuzrY8eVO9-IwFgSSZKvnipNEBkpc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dC-SKohRE7sUfrsxJEr4NZnkePYC71_f8O1-r-1rmQg&oe=69E38196"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yg4su6gPYxoQ7kNvwHKCvsK&_nc_oc=Adqckne7wGM8Ek1Hxr702ITby4BNXy14T8nw-MQRxP4D0dC1xcuU3yZGxXpVQ8SERKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PnzsKAN75uTjy7QvFXq_o1R4DS_GYCh5vXstdn4QOGQ&oe=69E3698F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ahg4u6ywmAkQ7kNvwEHubFi&_nc_oc=Adom6XdvCJPoFMbve3Yh9ExMfLByfvEw4Cl2n-ETsyT8NOkgSuaSnZo_pcG9rwtGQA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YRu6gfA8vQg67vmzY8QsCxC999kPY579Rx_HfSS2HvA&oe=69E37BB6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
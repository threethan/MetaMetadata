giYQ7kNvwF3aH2B&_nc_oc=Adp3vry-YWwUGIvhZv5NGhqSB9iXoEi1dCUSGnUrHW12I5XUmyxovwJt7m5SuOgJA-Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpQR78srC2JGTAGYN70WiqwwCxDCbpJ8SSYYPLJITTOg&oe=6A58D716"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZIxPwmDdYcQ7kNvwH0v6sK&_nc_oc=AdpkBAG0O69skXdxvTdpAxMWk88sV9B8ZGEe-ue9TRo3lDP5xSQLNDT-vfh12YLCArs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARAd2iLq65bjJ-13dMLADWgqOmF5xZDMmflkQrg1yUEA&oe=6A58F74F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0l6olzg260Q7kNvwFgpBVE&_nc_oc=AdpXpYAIvfEMR4QdQrrfkhPiSsxEugjM3BD8DyNsC2VSAmeOQiOvDT7N8KkCcabL4DI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt6ounCy98bDE_O4i0ZpYLDjn-7kw2vdeP69SapuK_EA&oe=6A58D136"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
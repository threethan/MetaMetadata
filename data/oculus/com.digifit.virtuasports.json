MCEQ7kNvwENsfFs&_nc_oc=Adq5XNVuf3UNxu6shmr1VYvt5ebaIfe5q-J_oWXEDb9BZusQYfoRBizl2O40EYE9P-w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnx7GrTWv5hkyS_6iqlH0-RC3f3h6qXRbsG_SO1x40dg&oe=6AF34ED6"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHzOhKiwAisQ7kNvwHZBTyW&_nc_oc=Adp-7Yw7Z5Giuvi-SJL95hsX_biROF4GOnYhopugKnBKowe3v9wUGRTkQWhdID523pg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx0gIf8f5QnDFLI2LWiW05b-5dL5vX8xuUEiSraa3MXw&oe=6AF336CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76jlv56bf-EQ7kNvwFT5-Uw&_nc_oc=Adpx_TkZq0vabohnsnGa9KK5TMR1k5mnuxDk9YhxiZs67uuhPy7oQkdR7O_p9-0oAV0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF3mdLP7fo_S0EG_Z61KRY6cTv6pFEt2ijygVyqZ1zgw&oe=6AF348F6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
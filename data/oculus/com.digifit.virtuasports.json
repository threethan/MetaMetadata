7XkQ7kNvwFDOs38&_nc_oc=AdpIKe7LZdp5ogWb3dAnKslBkeekjFXrLNQiaoiZCKbxTsmPYUjQTZICVPEaaN52rUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxz6hl_3cGit1XVOpd941htrUowwenqfhxWKMec2kNwAA&oe=69CD1816"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u688sKFM-RoQ7kNvwGY5Pom&_nc_oc=AdoWlU1dShf5cU9yTZEUO2n7b03vUuTjoQoNAA-4lbyfUD35Q79Do_UNHByJP0stTtI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3d3oS8qcZGtUlniPlws9b_lZVKUGKVxoWSYka7b1b9A&oe=69CD000F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUvw-h3xRdUQ7kNvwETx7nI&_nc_oc=Adq3I0ZhYpA6ZMptUyHWGhggS3i8nutgj5mDx8VYAZelYv5tr1QLNA_KPH9x1fvvSLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYnwLJUfJXOMUTh-fgGbXT87D1ecqT2O7dHYwUH7LRLQ&oe=69CD1236"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
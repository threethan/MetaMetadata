E3IQ7kNvwE9h4pn&_nc_oc=AdobdcCXKBU-J0NsEsO3v5zVqmOCvnNs6tNh8lypEibHuKdH53GhC4Q9jAsuy8dFG9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1BsPo90jXX5YI_6Vs7Fzmhgafyr3XGAhTb5fN0Zg0Aw&oe=6AA7F116"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPCAZJu0Al4Q7kNvwFiAZ35&_nc_oc=AdquOQqOjZwo82ui3eB_8IUXgjRYHV773M6wmJgc-EB_eLEtOiLTKtNt_h9RcGwFCaU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc9Nc9tTJjMLDo4MuhraKPJaXpHOJm-1McBwGeAZ4dHw&oe=6AA8114F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8uWG6dKSc4Q7kNvwFspjle&_nc_oc=AdrnLNhQwKuXlM_xXJCz7QZP8d4nAqKY8h9Aec-pfzWlhwYknoOajbnL3aojALDY5fs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQgYTVaY4zqBE2CzqXNuWqt6Z4Yk3uRJXCrzQKmoLheg&oe=6AA7EB36"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
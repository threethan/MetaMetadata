4p8Q7kNvwGoaaQ1&_nc_oc=AdqNoqfreOgzm1iK6dE7feHuNv1x7OfddzaFk7Sk0zd7wWk6immdwKiQPsZ-kECItjk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErdpwqaNQTLIOw3S6YgtLYZTQ7pQUljI1wFltU0zfNSA&oe=6A86FB96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0CPlNpM0g8Q7kNvwHwR4SY&_nc_oc=AdogJVSY3hbKQ0H91k4HUaBTmczjXqoHzm7iHEtQhU4rD90W7pJ1vxWtOHcgfFVQMVI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrc73NsNPxwjou1YnM60I4hvc35uZ3pfe_mITehcX90Q&oe=6A86E38F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkU8SygP1BsQ7kNvwFGrLCz&_nc_oc=AdqF1dzMxTOolRmsBjuEvUBU_b75gNUG-ejzw0m3yVMkA9yzhQrCuWOHcI53nD8PW6I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY2B7NXrQTImRrpIuCM-AEpzal3UQpDvu_TPhljNgzOg&oe=6A86F5B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
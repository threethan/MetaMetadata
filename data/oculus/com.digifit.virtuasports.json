H3cQ7kNvwHli1VI&_nc_oc=AdqTr3wU14K7gBMLDgPlghF1Bt9wnur4Zai0horaVY4GOlLIJfS8oQDWunc1WGpB6UE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oO8Y04KajJrixyL1QSuk_sHw7dph8dhOPOOs39hiUog&oe=6A3FCA96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTI5ySs8xJoQ7kNvwGk4s4Q&_nc_oc=AdqfMqZW7SEmHJpOlsQAHegZiIgXgFS-ndQl0-wLSRwv0tpGOB2CoVnqS65FstgBy3s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oCKVO9PoaMIe74A-tPYSfJSZmODlhNFN03YhSkGsdpQ&oe=6A3FEACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2M2gOa5H9JgQ7kNvwHHkdHj&_nc_oc=AdpEExqgkc4BQrjYS97ukq6i4kxqpaDjepplWLR4rAprMSyHYEWW-D7tsqH1D7Ivs94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EJAdDFcMX2QCynHUcdbiRG6JyLh7uzxzlzfCcsOxRGw&oe=6A3FC4B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
4TwQ7kNvwH3hWz2&_nc_oc=AdoPKawka6YX5qBQDapfW14GhJMFWYGwZHl6pEEiftZWZZLNzDl-bz3pwiuXgKb7Gfs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUI0XNKBLVUPEflESbxVm3lxa7gJ3hxL0FP4EqLjI9yA&oe=6A636316"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAcvlpTAzr8Q7kNvwGtWwH0&_nc_oc=AdrMtecUo0LNOydA1vp4_Hi2aC_DEHdgyoNzqRFsQ6TxOI8XqSD7WA0kSH0iKJp3cn0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN-GhUHek3VEGJ8ZQGKUVa8_XzYKZ_vJwUayjhI7K3vw&oe=6A63834F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROWYf_TJ7NkQ7kNvwExaN_k&_nc_oc=AdqA2qyXn-h15eA27Fatleitd9_Q4Ekci_IKypo4EuAr4Y8k-JYAOvKJ2mqb3-lVhyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO25DKmXjMwuKWRR9juJI1JqVNqvO08m6ezlYvI3cP4g&oe=6A635D36"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
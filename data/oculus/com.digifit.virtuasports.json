3bwQ7kNvwH9y7iO&_nc_oc=Adrf4H1aSBnNDVzyS0f4DQdVrGyS7H6InCFlpgYKrWwfqcYvtEoP9OlccO0DHS5okYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N8akizgegJtnkLLrF0HeHdDlwPlVJHEthjI8qcskLYw&oe=69F9EB16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVwKGcIg22QQ7kNvwF1p1vt&_nc_oc=Ado-1MOI_EASZHXb1wg2kVLfJzSt9P2jix_f6vJ4tRkzdfN8986CLgI7qjXz3oSLrdA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HwFH80zVSe8cH2ygnVVNjbYyyQLOgPW1iX4Etbj4X9Q&oe=69FA0B4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sol8qwmT-AUQ7kNvwHBLMck&_nc_oc=Adqq0TBhgH8ECx_EcrYgmaWhqZOVToxyGJhoWPBQNrxVVgCSXoK7Enp5cbOuPKUJZQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N-RiQ7KXGsFTFyj9ufvVRvLA4aEWKJcSYUErx9NN2TQ&oe=69F9E536"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
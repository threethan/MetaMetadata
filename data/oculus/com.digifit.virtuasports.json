29gQ7kNvwGF9btL&_nc_oc=AdqAvr9MFpaQ-GuxcufvrPpTYke2uBjMdA29kmkbCHr8D50DT_KEfI4fXoIXAqtlc4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr8rjJUpQ6Vkz7vEx6LpXNnC6JmBbhPCXeBU4IF7_7iw&oe=6AE1F316"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAaIWwYix5UQ7kNvwHS_Pmx&_nc_oc=AdrAd39OJPaBpxWiGbHFtvMna5acKUCSBFUZvYESrP_xn-wfRRRa-nxMX-jIjaNH3Oo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMliJTUnTB1M2epaS3s1i50iEg0G0n44RZqdzQLMDp-kg&oe=6AE2134F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2an9CiBwm4Q7kNvwGmOBjU&_nc_oc=Adr10HbC0HCL-uzOoSFYBMh4y_-obx_E1hcVQ5fC7fyVztLocStiM-hNEDIJjTAas2M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkFOaJxbWoE9A0T9YFnUDxXv20tOyyZBj4pbvfIereGw&oe=6AE1ED36"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
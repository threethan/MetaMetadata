Q00Q7kNvwG1pA9W&_nc_oc=AdrHdkX5qFXNJJCHxyMGr9WRqnQzs4wSyT4zYsAMH9W8wRwJ30l4Kqav5nB2HHPcix8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnKHMDYmgGsHT_fLUFx-iSEjXnXG6C5HMdkOQ5vaew7Q&oe=6AF74356"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6BsoqdzXy4Q7kNvwGkbty_&_nc_oc=Adr1kRZhk9WmQcwQp4H8LM59KEFgCmT2zXbgJ7nciOL-eok72HvCdW-C8cLI_oPH5C4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZpXlZb96j00zG3UsQW67qIcThJzqvg1a7MT_oyqk2kA&oe=6AF72B4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amk-ESlDGV8Q7kNvwF6Ukm6&_nc_oc=Adp3IugURvkyI1HDVZYwsUONKiIZxQVk4f0R3Bdm-6rUmdyizopZ6sB-8JGmXnYV01g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR15iUMMuYQAals8HO8YlChX43i4m0kmcSlf2HewPGr5g&oe=6AF73D76"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
yhUQ7kNvwE_AMyF&_nc_oc=AdoH78024GO0Zhffl0mPr2y7iAVoVJp_6EKtwxTXESMwJ2-SyHNz6BPUhdO5RqmETbU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JmdST8eDjHdjsQ-K-VLXmg7J1Bef8rAFnuNOs8KZLcg&oe=6A26BE16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GD7R4qAeR6AQ7kNvwEzE9VH&_nc_oc=AdpPQImw9gblwJjtRqAbxKgfBgijj18VBjGFpMffnxrEOHIUztjv7Efqj4W2qU9i96c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uw-LUv5GnyZi3FO2Nh3n5D1pKfw0yOcw8mBtx1SVcRg&oe=6A26DE4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYfgp2hTp8wQ7kNvwHKG6qZ&_nc_oc=AdqogdyCNqgkoASmn9O9LtuSkHQ3-0Ef7Fa5_yUveaf5GDtcLrMZfrDyoJfUIMpoGls&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VKp0oEKlSV_4d1MniB-qT_UaVj8DophcF9CeB8qZ0Sg&oe=6A26B836"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
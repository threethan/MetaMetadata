cOUQ7kNvwF4tRhR&_nc_oc=AdpRUvGUa48OZlC8dIJ7M3TF64fYeQkQfIdc2x1CubqvCaxr4Av-G0xQfAXZnuVZ8SA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTxp8XH2BTkI1rcXoPtzh0-OeWBPpB_kUwwWfErNobPw&oe=6ACD1356"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25_az1hDesAQ7kNvwFmezCU&_nc_oc=AdraaIt1BIOLyHhvheOGKMVpoWrIAYTi8H5-q75jSsx_97y4zoHZWHQc5GhWLjp-0Nk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7lmNZ0PqAmLgYDFo35Nof5QcM0H0rBX7sXmL3RsD_LQ&oe=6ACCFB4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FC1BzkzHuZ8Q7kNvwF_pJ5f&_nc_oc=AdoHxNYFmbNbNWmvYUYijD5RLZPsvXrA7vnbrZMGmsmmhO5aLsj-1Il0jS7-V3UWeoU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsYv0YXIQ263FMys9b2vobloJz52NiexA0Ztol40mL-g&oe=6ACD0D76"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
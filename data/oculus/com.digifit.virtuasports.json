yhUQ7kNvwGN474n&_nc_oc=AdoNMzAXgL6IyFbXUAh-bSsbIUPWEvZ2kDjj6Lk0fQhsxK2Dw7SW5TH6H_AyLWDx7_A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DbD70CdWQ22DwIFp0yUJtoCM3zySGg-lZkGVfzafHUw&oe=6A241B16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GD7R4qAeR6AQ7kNvwHCgpz_&_nc_oc=AdqIuLOxqoaQUECz309JLAFEcF8N0gCCZasKZzAESy0rT7lVAoIirxa8gXkZA0Mr4JM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XW4z7-_pMpxtLNLMEIiuDDf8ZM4vd4XAH5T39jWzNsw&oe=6A243B4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwxmMS7FV9oQ7kNvwEtr_yt&_nc_oc=AdpLa5FfrZS1nZShwaWFgDNkiY-yOrro8Hcl5LqdHGwt0zQIPfJwf3YhJIM4Af-pboM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZJZ1oxkjn3Gky3bWCNVmEkWbDSQbFgwLS-S4s5BwiSA&oe=6A241536"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
k64Q7kNvwHlJpQ1&_nc_oc=AdpeTwwInoWCUUZKV7zIF8Ryi0Ski_UiBF7ijGqfncciuaCyEuQ7wbnOxNM0b81wLNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEqZDbmKr2jhQgwn17qlHSYf0-bg85SLlnT1222pX6DQ&oe=69D10C96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJa8H7fg0ewQ7kNvwFlEFl7&_nc_oc=AdoXxvA68TwE-Ht7f0VN418q4NkDfoVokcHkgbgv4mfNobTV55aAQHpmrbDB9YHbey4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAiKKtJKHkQdW1ybIq1SYlECivJAQ9USHXwnhUSwfCfQ&oe=69D0F48F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkI-LTcX2SIQ7kNvwHxsf5K&_nc_oc=AdqyezknKsu8osfgRDmNpDexHIwa0gEBtYVtxg9dLUAztKEQ29Jcct292tBdBB6vAbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx87mpeqm9KFj_iy8dRw6SVt7p8HF3y_C_A5gO16Y84oA&oe=69D106B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
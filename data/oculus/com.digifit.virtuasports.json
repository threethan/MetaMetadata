j88Q7kNvwHSdbnl&_nc_oc=AdoF7xRfQFzIO3tDUFuHrMJxUp8CLOu-pgt0__ySIUJ9x6MX_T3TES4yuIzUtt6yLR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYdqXHuaN5JeXEF1355gyt4srFVCzEmX3xOHY5r2Gn1w&oe=6A7B1E16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PO6c05B7PQgQ7kNvwGsoRvR&_nc_oc=Adoq_qIady0CpnBjb8CCgYe6FPTCdN1asMBj_lbibnFhaFqUKTcua8dxMSKS9lfnTeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRV8AaEqf_xYB_3xVy7gg8cfmkDLtVdKq8o-fDkRH_vA&oe=6A7B060F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyGX20J9m18Q7kNvwHOajco&_nc_oc=AdrFxWFTajO8arBBK7_0aXGhc02C_ciDivadI48iOduRsp0lKGu8C0f9E6fcjPHZHwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4qHQNluVgy9ZiSw30J_SQkcwj_BP0auQt4yWAPwPGmQ&oe=6A7B1836"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
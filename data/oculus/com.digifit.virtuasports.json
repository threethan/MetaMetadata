v38Q7kNvwHj4oww&_nc_oc=AdoqOeDpB9nwG8DDUHK5jXOl5cBkrN2UL0YP9GDTGc51fEqnfiivFR_ZqJbtOs_bnc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jeiN8PJaNNME1NgEc8LlsgpwHzTTjN9Iv_76HUvC8zA&oe=6A01D416"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PN5u2QC7fOAQ7kNvwHNSIlu&_nc_oc=AdoOKcWn8dvo6ANfogbTT4oD1jzdkBGdZy7VzBrZL_TAaEOWdiUZ71PrYKiCZRYSh98&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RBlwVM7kLrHbl1FqkXIi68BCNnrLkIP59Mi3t79WSvQ&oe=6A01F44F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jN6qCN2K9T0Q7kNvwEB7Utz&_nc_oc=Ado1L-ydCtrp44bFPip3YLAOxjPCRP_7z2cNUs1C7erXNCMUJyqbJfVv6ZwHKOAkOTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44xzPSlzg_wIGTFXxjGROaNP_wZ-1W7k_2Qr9BksLXew&oe=6A01CE36"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
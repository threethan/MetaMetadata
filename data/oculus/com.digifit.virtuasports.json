8MwQ7kNvwECJIBR&_nc_oc=AdrNySvrv2Jc9RaNBmmqTa_3NJfnz59FfWFNJ_YzhxTHXODcI8dtT7VtuIEy7hrXFuY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwE3UcPyqmqbgt-m9zMJRCkPG65frVlCli_5EWw77GbKA&oe=69C7D216"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWcZVKD_8vYQ7kNvwGO_gED&_nc_oc=AdrpvtR2JF2QDup-sKbmaz4AgpAvjanlxLbLPbcjvl9mdJBoLyxrWxi1EGZzndPFavE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOlovCpnl6ZVzj6HLRmcgMqJZvxcrds2bfMsb3ctH7uQ&oe=69C7BA0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CiHbxGP1jAQ7kNvwHspCf0&_nc_oc=AdocHpN1tgoz1olQBKYPp-bMmPcRt6j3alhtE9F3WS87kZLKmByIzgzlu3QkOadK3xU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHqDGQmoizotWmHj59s4nwTHLWq6woXaxR5jWZg0s9Fg&oe=69C7CC36"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
ZiAQ7kNvwHtk1mX&_nc_oc=Adr6zrfa_DqqjwwCrS4o80M02oyrElPtMUOnphh_Y657Xvyl0it9eVMeoSzR_sj9ad8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MPO1u5o9epzNmRq4GTN0wusMm_SDetiEE325iQ0WVyg&oe=6A2FF896"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0ZZyfDElX0Q7kNvwG2gWwe&_nc_oc=Adr4t13Fb13xvK5Ij_JdayHhRMqDq4G9hAksP6fUX5X_Yd8heJOHjWWpgt-faodfFyI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LRoWXtrEmj0pfj6tY325kcczBMshB4HCHY_9SYVwSmQ&oe=6A3018CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8of6B32bU4Q7kNvwFX7VtE&_nc_oc=AdpEgRxNpDYOXhOgBGzTqCRJuFXWISHDSQtNWqaE9W3TlWqCmyzxNHomzKMBavZMrik&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3aS7IBKdL4u6LaLpWZVJRYSZHAKePZ0YyciNXLaKPsw&oe=6A2FF2B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
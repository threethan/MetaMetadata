lLEQ7kNvwFt_GQ3&_nc_oc=AdoiaYAlow21vpY5ohbtByJGTflcQk3aNs9A0278AdHYj4mchwQM-XIje4cSJe5xDyw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQrndva2JdVg3VjgC5WBxfjW04dzbxnJ5zdW3VFC4oPg&oe=6AE8C2D6"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXeFzsPTZTMQ7kNvwF-_4N5&_nc_oc=Adpkqyidiq3hh5Rz5VlDQm0hjVrVLbtSvADMx-AuIivLpQ0FELBKwO_uCkZ9yZiUg-I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyRhVhIurOSpO5AnGIWM9Q2WeMf2tfRvkGe2ekHEBygA&oe=6AE8AACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ttpb6PcT2cQ7kNvwFid8Hq&_nc_oc=AdpEAApngi7A0neyw8mDxmq3KJ8PgJtAoXZL8bjMNvhxxoko0oyDqgp7D0nYIib6l8A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxekjfXfQObMISoYJzOPO7qgw4E8c9gMtT7eTBtbawiw&oe=6AE8BCF6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
4ukQ7kNvwEwYV4I&_nc_oc=AdqvrAqegR5uzgIRFbkAKICWE9aPrm-JlPn3Ldn-2xJ3ee1oRiJ8eN4l1slTt7tyX4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCejSg7CZl8meHZ-EWk44kghWGoZ8QkTwAgmK_O2_TjGA&oe=6A54E296"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWzo7FrvuzYQ7kNvwHN4F6m&_nc_oc=AdpW5ZI3IpDPRxFEprBFluBWJdImyfoT3-XgUW3FiTyt4-kES4lrWHq-CTqogw6fWfU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxhNGzxaDv69JzJKbCOpN3oNXdTvrg0nn1HynP4b81yA&oe=6A5502CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZ_VxMLhrtoQ7kNvwHvK16_&_nc_oc=Adpzv1yYbgaq64Ousj5ppQFBPNqh7C8SIlaGFiQ7oO7c8Ibjqu3EPeLfW49th-1nQmg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5GIVydabmfP7WUMJ1J0cYDQ7yfTGnZcFH6O7FCuK8qQ&oe=6A54DCB6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
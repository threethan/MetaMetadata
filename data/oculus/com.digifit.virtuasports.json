DBYQ7kNvwEps_or&_nc_oc=AdpmMCFOsbG7_azmx2a5gWLaYKhL2grsWxrZT3ahNQikMfYE-C_KPCQbeV24NjEI_cs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b0MQWWwmu-LogZBiMKh72BItfs82D1ul5BeC-Xg7gSA&oe=69EB6A96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oj-3Y0iQOa4Q7kNvwFstSut&_nc_oc=AdpJAtYjTrdEn07FGX63vSU9z_aGQyhm3QOGaxW-Hmy_gyuRRMEz74xLIpyJ60oUirQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ngwwL6aTj05KII6w3gSOy8_2abbmHB3CNj_fUOhXWog&oe=69EB8ACF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZdmK3uul7cQ7kNvwEZ4W8n&_nc_oc=AdohqgnfchXTeI5c-X0TBDRN6ETEDwWHszNWUQB0XbGp83Seq3YCegTCt2xsQ3mfJn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34GQvsQm0IWFkHVBSRj4IwELPtmxqf2gNNefC5viGKQA&oe=69EB64B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
pHgQ7kNvwEwBicg&_nc_oc=Ado0CsZ2iXlyWdgzytIyRUBHLElWg2NpMwH7OM8KIznknEV-FvYKtpYX62y1r3j8Bas&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjNu_iu7mRy7lu_u5lakbAEJwg-eJS-C5rP7hPR08kuQ&oe=6A9AC216"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQI5YYjeB4UQ7kNvwFOM-0p&_nc_oc=AdoxB8X9UqN5urRPC4CgtiGoD1_4MGUtlqJQCEEoQ8KAmSyTuB4Nw2jWt1zeCQd50-I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAtyNMOknU0gzSkruNQXTB8FAHzqUfcfBNMkM8_ldDug&oe=6A9AE24F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tzyde1d-M-oQ7kNvwEzFoYS&_nc_oc=Adoj_7qy7J0ydeAIoimJzhVV_n6qapJD_aDb2GsKS-v3yB0f9tv2-I69HwhN1QOgJ5k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVr1Di-PS3uO04ywQoADjSgvcG9retR-GvFBpWNaB1YA&oe=6A9AF476"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
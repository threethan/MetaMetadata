_xUq1Q&oe=6B070A0B"}, {"file_name": "4.png", "id": "1314636626810551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819464_1314636630143884_131987649802123726_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xrb9cpKn-YUQ7kNvwEpkPZT&_nc_oc=Adrvaxn-1IWvSYxyLnGyUg3xcuMiTF43EIPe1C3_aK7snA52lP105GSVlcqLRctmFA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-OXuCdhpKkPOeOtU4y9C4rZIUt8oJLK1bja4gibzIqQ&oe=6B071556"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_WiYKRDwOcQ7kNvwFIx_0u&_nc_oc=AdrUiAAOJBc5wZB8Wbb4XBP6hWHTsko6SMpgop_JFRMQxisYjja0sa3q0f5dPJz_Cl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1ALJPaMLTu_4-M4W642kwnJW33sOKq8kb5Sz2Q2k8Lw&oe=6B06FD4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A80N2N0dFQ0Q7kNvwF6t_s9&_nc_oc=Adob42LGZZ0v76pVXxOoqytvakL5EeiUCzELbeUr3kwnz8gg0iugOSzqBVwIGGXRi8g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIG5c5oyr-G-qWcRyfvQCvp41ptpMzRG0gvKxBDeh4oA&oe=6B070F76"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_description": "Embark on a VR fitness adventure and ride, run & row in virtual worlds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtuasports.virtuagym.com/webshop/terms-and-conditions", "developer_terms_of_service_url": null, "publisher_name": "VirtuaSports", "support_website_url": null, "website_url": "https://www.virtuasports.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25824222697207777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818925_1470776471146651_7193465605441863216_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EY1vX64tp7MQ7kNvwHmxKXz&_nc_oc=Adqu1zWYH5M3I45EoyXoYSGeJIz46WK8B-pmijE931yJmHQRI4T15-DE85MIj5llAN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkGtJNCmALlrtNJp84I3gkHYrFAIJPoyFaOt3hCQxR2w&oe=6B071EB0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VirtuaSports", "p
a_4Q7kNvwFYJeEn&_nc_oc=AdrcYFL1vwfPseYu5cocWR9xRGT46innOfBy-334mJFNjTCxPG51DUvmudWT-eWdtkg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R9ojY989PExMl_9W8ZqBpURqtGJ1pQBy4hys5sP9ewg&oe=6A071A16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XOlqxRS8rsQ7kNvwHvVu6q&_nc_oc=AdoYWw-Z-QV3IvUIaNXP3SCsxiBr-3GITHhOjKpVISTCPYNh-VzXknK99jP8vqE_2VE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c8-LBB2mTqLf81t07pQ8KvxAe2-rKPFNXcX38SMnZrw&oe=6A073A4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwUPsgLisb0Q7kNvwEzG9Gx&_nc_oc=AdoUWZyxls8DlwsGjJErt7DsF3XKXjugWGugof3kdIGNCPJZJ0M8hmfU8NtJbLm-Zag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EMpQKyxgCworviz-RSBhgt6eJ3uHAbpg8RVwxTW62iA&oe=6A071436"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
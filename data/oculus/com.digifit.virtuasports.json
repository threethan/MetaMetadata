7w0Q7kNvwGBFSFF&_nc_oc=AdrcEe_mQ45LYtGnYmrxN0vFGahA6WlhQECEUC-YSsyQKLr-JqpQxgtprvQuPT05b7Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lLnVIzbkSOs6jv8RzuKB0Jd_rJbSfpPD9pj2jV-hZCw&oe=69ECBC16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awonmiBkMfYQ7kNvwHZo8-q&_nc_oc=Adq8tbjbbCz0QD7GErepFufDoA_85-AwjBtWqRSN8q9F4MJ5minS9N7_sm7fB2ITlKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fdKuzyL0GUbzEnnPXb2Fo0jLBwe7FU6GDP11O1-dPXQ&oe=69ECA40F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZdmK3uul7cQ7kNvwFPPfu1&_nc_oc=AdqnBwes5cgLpfylzQxsdl9XizZPVUCr-drRPtVHlpdWDQc084vQLMfXPpIap64wQm4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xD10uYJAJSBwqJwm92OFtb9NaacrXE2zKcxTC1wjEQw&oe=69ECB636"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
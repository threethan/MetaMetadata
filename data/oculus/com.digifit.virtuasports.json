NfwQ7kNvwEc-73H&_nc_oc=AdosHMSplE6cJfRi7wIGmQUU8c_mOxqJw8MBQZGaehlvuHkALQR7H4jAFr7xt2rl7kM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuAa-9EmHSUfPIMMnJ-620oWnXZFbJxTi87hBVPT7TFQ&oe=6AB52016"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVJgS98ROpwQ7kNvwE76vSW&_nc_oc=Adrr-Mhc__NbSnXLqadZOWJqAAbotC-uBUwYnbFiXCRuvE1aWTZB6EvqU-jBmwg-hM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbVZh8H0M-7ELfyzHQVNQ0vBhl_6Nzgx5uay6ouY6OuA&oe=6AB5404F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FltOluNH7F4Q7kNvwGl8P6S&_nc_oc=Adolzs6KBUeyru6bLIwoBwfaRlVjvlFCW43CQRIyvKBJHAYQD6TrF_MnxU0TxkR6ck4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW_ky_BA5qMs1MvQxH_AVpeA4yQ15drMq1XKorOaXTXQ&oe=6AB51A36"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
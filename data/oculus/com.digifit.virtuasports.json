nFsQ7kNvwHUmdNl&_nc_oc=Adqz6NlIcaA0naKgQ12rOnvWSMKGvdutWLJaGYUmTNonZZVQbVr1rCTS8QVScr6UBM8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GPzOm-AHLF71eAEmcO4lVmqxxKXWfEemWeNTdtu9-QQ&oe=69DE3B96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yluHYxekK7oQ7kNvwHTt-Lg&_nc_oc=AdqLmhenMf0BUSHPGm-28XnDeHezTvkinKpmKU34uLvmVM4SwA-GRbM4KUjGptBn0P8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af247-CUVe19A-ZT6oYQbg6zbeIZvBW33Qu6Z2CgYFeJ-A&oe=69DE238F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPamIDfbLN0Q7kNvwEoyC-_&_nc_oc=AdpfRnG3-Ij9EMFhmwtRN7vG2Hq_uYXOGS9sPnZ_u_Kp9GStobQ_l5h3yLziwXJRSUE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Rj4CNs-hd4M4Gd1-_Wrhhp6cMYKpIbIlp2gcpST-SYw&oe=69DE35B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
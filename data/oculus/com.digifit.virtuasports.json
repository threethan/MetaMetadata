JmEQ7kNvwH9yHBM&_nc_oc=AdqvWQT7ywUag1wkKTgzrqPLMMUdPGls8QTddw2ZfY0h_o4v22bDFCOj1MaacY-KJNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gqVg0FHLiI6aHHh86z70pgWhKbIwqmdA73ByGS-ndJQ&oe=6A37E196"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2_OPOL5uD8Q7kNvwEb-1Jy&_nc_oc=AdpDPle5qWoY6IucsVmkl3K6T8wqhzx3H-Az4KH2rK-7WP4Olo9Zq56sl7UFg0sh__0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_pVYoTAALqqeq_PDyXArN1cY9rOYrnxvgCuD7QPt12Q&oe=6A3801CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNL4nneHyOAQ7kNvwFztgnu&_nc_oc=AdoMjTuP88FepkaTQyiEOQ028qrv9O7RTRk2lx8ePhvZJPTcva5pABuYWxFadbRe1fs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yjCaInBERmQ0QR-SS1opA_00dzT0PM6IyQLOMFZW0-g&oe=6A3813F6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
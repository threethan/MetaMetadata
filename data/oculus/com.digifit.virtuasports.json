zfgQ7kNvwF77-Sk&_nc_oc=Adrn6JcnlYvrm4JKbeeWqbRNdIctThSBwyqphMHrnXotS7L61xg4DlPH1hs1bZt54Ys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2ayGLgANItSbiQeE982MxDTfy2Y0VaumhdykNo3cB1A&oe=6A8C4196"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brNuxF4ikcsQ7kNvwF1zpJx&_nc_oc=Adq_SyoMGm78cBKGVmTisFRRoJ9TA7ysu0fSoVXxG_T9VyoVh1TzJWpNofOIZe-DBXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwc_tQ6esa7YpGJU6iD0RA5JXJQUhcOn5462ErUhg2zA&oe=6A8C298F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTDa7QzcuPoQ7kNvwF9RGs-&_nc_oc=AdrvrnsAR2tQgFauVNZllZiHI2KeAdD1S57GVNDkon8HR4Cw7uEp4h6TrV3TJfEkClc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuFSdYI1k5v_KCu1TcFyY-WwCuGjRx8gEQaMekyDAZaA&oe=6A8C3BB6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
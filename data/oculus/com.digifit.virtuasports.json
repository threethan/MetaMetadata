DGQQ7kNvwHQIAYI&_nc_oc=AdrGgoADDa_YmBvKpbBKL_2kbx3sOnaRg8ObJQBrh-uc6-fPfXzTcrUvvkFHm3rh7h4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MJEh228oWaDLNriEmBmI_b560edanxYzHFKDHy60AAw&oe=6A09BD16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKF7n6bdFlIQ7kNvwF3GJuz&_nc_oc=AdpePPZDnm55nnvhUuH_-ci2uE8Kr0AMQCbinyUDd0kYTN2SLueq5zwUUBFXADpOpaw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-yA4h1_6p8U_KjyQFC8JFZFnCX1So7XL6UKB7gqfRpw&oe=6A09DD4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwUPsgLisb0Q7kNvwE-Tko7&_nc_oc=Adp-hptyEk2TbByL_rNP5Yj6IXJ9lDdunzwusPof1Qz1fpmyDwRkqC6u2M5uDuqCXTU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68N6RcLhCEFpHupOs6lhjs52ZBJDAYybk1ls7dUI8pIA&oe=6A09B736"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
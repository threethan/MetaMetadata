7w0Q7kNvwH348lQ&_nc_oc=AdpBk_QnxmRwxraq1D1jdj5ptpdn8glCF7UT2Yp3MjvnHnclb7bRhjeBJ0vk-e8WhXU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ysXpI0JgvRLfxYo0BBqkMH4JqzsGeetdm-YGLeCTznw&oe=69EF5F16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awonmiBkMfYQ7kNvwHBsb9G&_nc_oc=AdoU9BFsd-K6k8IPNgDNDMf3UxrJz8LHSmDedKARbpuCVCYNxNqUmGHL-bGVQfop8bY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-rEQf3Mt8490k9m0KH7eXIM57P9YMGNgRCR06rh2w1Q&oe=69EF7F4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXI6_jHUQToQ7kNvwHZN09l&_nc_oc=AdrTKV3HTGgK7XD6nEjWfNtEAzO8LAOZ9Jx3TCp2Fvy0kMwE4_c2d7UCuhIo-nM2IbE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PF42utCQZ_9zXCrXDoUiT54HoxrZ7TkIY9h08vFiRkA&oe=69EF5936"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
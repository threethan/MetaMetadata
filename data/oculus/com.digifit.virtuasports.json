wE0Q7kNvwG2Xtwg&_nc_oc=AdoAaMzHvphr_Wo1bUyt3wvAGjnjgzieHWiTTbcHbYnXXWrxUSPiiqfgMfXWkdrQra4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMRWrsA4miH_0q35QWZlKbalJpWuO56Cbt7nJX_ewYqg&oe=6A95B456"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xC2BdNygQEQ7kNvwHNcNRm&_nc_oc=AdoLDWpr3vp4Pxhxt-WSmU_fCCXlT0btMJtoRghyKGrmbNG_4OBtJ6y7NrfSDk-KjDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBVTdYug9fTwKRVfn3hKJJbddus-QpXDDNi2ERweadkQ&oe=6A95D48F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijtqO7PVoI0Q7kNvwHvQVBC&_nc_oc=AdoQ3Bwwzq0KIomja7TdG9_7jyLF8nv8wWV2u9HXVWLLXiomRGfqsxrM7iecOKaRmGY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm4B_2XWOUbtwDe-h0cTHp44EWqsVm0rgqaAHC8G2NlQ&oe=6A95AE76"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
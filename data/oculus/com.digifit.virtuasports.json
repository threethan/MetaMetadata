4OwQ7kNvwGemY5M&_nc_oc=AdrMtljPZYJKRlKZ9tvHY9HKGqGgyjEqRxbGO5ejtExw-0Ixyqsi6Gnzm5TNNeIkuPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T1PEmIYma2HVSU00Z1vURWVlsGyA-NNYv-ha785uw6Q&oe=69E4D316"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSKFAYLxf5wQ7kNvwHq5TWp&_nc_oc=AdrE5coead_mlxqRyOYwV9ehBSUlUySNzbnq8H8HTJcu6C9uWMEZ70JGWVevFieSqno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bbOzCNdyqP0LpBZsuDmZR1B8RtBwaeJUwFmDHiHZr4A&oe=69E4BB0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ahg4u6ywmAkQ7kNvwEY2i-I&_nc_oc=Ado3Ek_k4WKvcBNTRXgpnkrx1hObxlZ_eP1RPPfdv9IyDGs7_YWiw5pddlYj8A7xtBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vJ4yyoaHUZQxO94duZFYPUSkVwzPnojwCT4YUh0SxkA&oe=69E4CD36"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
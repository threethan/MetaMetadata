CkkQ7kNvwEmdTZs&_nc_oc=AdqO-foBqPfPlMpz4X1YuDIxOz0arPbDcUth31oC1DZXGCppTJ3wDIY3TXkN_DgH8jM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2tl01jmk_7MvmUO3ejqUa-CxzCIIjwGmWiL3BGm9jyA&oe=6A4BA816"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcun57u3XWsQ7kNvwFf8fcM&_nc_oc=AdoLd9BczB46EEhS5NBFmI3pUo7kdyLO8bobSH2wzSBcU30RQQORwaB5e0xViuGSFvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkokZs-5LAZuCjF9AO0opPM10PJHeyPG2fbPxd5zljQQ&oe=6A4BC84F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDNaf7Um4G8Q7kNvwHO4-Bh&_nc_oc=AdqiBal3100HSKWwbUaErzirSW9f7eZVbLRP3Ns4dVSL6sc1OWR8Kum2xYGSDkLJluo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDamcpu6ByHmTKxuNxEkv89q4Hx765GsLv2e650DuM96A&oe=6A4BA236"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
3GYQ7kNvwFqGhYA&_nc_oc=AdpggRJMrsyEIjoVzEf9XaGxumuSzGdgq25dsoSa-n5iLEXTcPwSLk-M6f1T07dHgO8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9kYx1MIyY7fepLEDR1TGv5dUZ6kx9Rk60p_R4P100QA&oe=6ACE64D6"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25_az1hDesAQ7kNvwGxiZiu&_nc_oc=AdqJujI6nmDHaFvzdtLDzPNX1F6jUA5a5BVDDfW-UZREHVR7HqmtnWZDqPcAkapKv_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM9-ykj4pDsKDoiqWcAjlMRQKO4S7ouuc6Y_07ph9M4g&oe=6ACE4CCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FC1BzkzHuZ8Q7kNvwH0Yk0k&_nc_oc=AdoqFZlEMbodnEC0dSme5ABrSSE4gBRF9XvZzW6fqDF48xuE-bEb7slkGsHgOjvtO6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWCWt2MBtKRufdnWg2f148HDVuNnCzOib3yKprNWu1xQ&oe=6ACE5EF6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
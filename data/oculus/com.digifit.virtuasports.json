_FUQ7kNvwELZEZi&_nc_oc=Adqrv66F7czAN2sQrijXzXdk12RiED5tcvbr4o8ByzY-6eTHxUY7IDq2Q73kj2DCVf0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55q61GjRiX1PUZqxSwGsc8nrXuCIM4P2DrFNxzKAd5eg&oe=6A0C6016"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRIFo7EgAFQQ7kNvwHhyGu-&_nc_oc=Adp8RBthaIfrexdJJjucg9FdBYwPROdBmZvP5PjsAgB9XYyGgrZBDDxb6CeI9gvCG2E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q_NeR1Uz9OSC9yWCSZGTN6hgVO5B9yXIS2Rmymc4Ffw&oe=6A0C804F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd2gwmIim9wQ7kNvwG8xHb_&_nc_oc=AdoJhHyT5ClHmjAPJ6OZagc7If12pYK-4K9BxxCKWzluSeeNvOiJ6xbpJHSgCW-KylQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sOg0_ZalUbprkHqX3TFCH5d-lpkwAlIXZy7hZueYw9g&oe=6A0C5A36"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
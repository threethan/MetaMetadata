QckQ7kNvwHBqQtf&_nc_oc=Ado_0sqCTP2JmU8wE0IY40DSFl5FehJHVwQt4gZQqjUigDt6WtiKRForrscbH3IizOI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLwGn0eCJ7SCr9En66Sriuz4KAfhClOgo8iCvWeQPALA&oe=69C3DD96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSflmqHi1g8Q7kNvwEkyLA6&_nc_oc=AdoQMUHMVsn26p_zsMOgg9n0aTjQ7iORHdqBxDKy6tdIHDlOgSrxk5F7s3F1MOFoeYQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLnwUFR8Qlv94OnlKkJcw5-5fsENTsCdZUkI9yEYUIyg&oe=69C3C58F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XNaLxMpb3cQ7kNvwHocPu9&_nc_oc=Adou612riNykSFpT4dLS2gIh9fFV2UqUd8I1jIQ4ZUlfUQB5ysqhj350ztmFV6KFX_I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJZGHp2L37fFRUx24QlOHGaj-uEdjOL8xJiSMD-ecmag&oe=69C3D7B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
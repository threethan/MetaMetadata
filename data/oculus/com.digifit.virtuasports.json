4p8Q7kNvwHfapKE&_nc_oc=Ado6yaho8dWCqxz6Bdv2jDtc50v4JcmvP1f3p9jv7uMDkhb9Xw8bsWaRt65A8_2hczQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa7WnZ90zIwHFgIlkQ2-MgyzbqKWfoMSn7lnBIjvWLgg&oe=6A899E96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0CPlNpM0g8Q7kNvwHbIlnf&_nc_oc=AdqCHLqw48A_4jp28aLrfy-4ZOkGkfjlRiFVA8L13PPg_rwCpXE0Hmor-rjF3M7crPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErPou4c3oP_n_gGsA-ONbX4JF2XMD99xqaGjMwiRry3A&oe=6A89868F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTDa7QzcuPoQ7kNvwFMNkyR&_nc_oc=AdooDFzgAUo68QgFYNvZXLRjIDQ_Y_arxZJEPTPXRmE3i2DBSzoqgk9CoTj0w5H2sTQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyvl0CQTkrezD5Ks2Cw745LeFJ5Sflc54rADy5aliX-A&oe=6A8998B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
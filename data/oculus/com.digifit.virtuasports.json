4ukQ7kNvwF8gAMK&_nc_oc=AdoyDvPa95dRzMwh7ePZFmpIAFnE7_yPVGsb8JQZJ7MJay4ov0Upg0D7SHwJmQhMP4o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB-1R86zNZ6ZSTprBIQjnJ_TJruQXttENfEqm9uCsspg&oe=6A563416"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWzo7FrvuzYQ7kNvwF3SJGF&_nc_oc=AdqoWT8E6dfUQFST4YK4M9a3K6I_9iYhKrv9hmyeCweg6VsIzSjTBJlbUiB6_nMJ9TI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvuIc2b4oEmnGR_rJeaG9dFvCmIyeE2E-vXMzevlT2Fg&oe=6A56544F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0l6olzg260Q7kNvwELN7eT&_nc_oc=AdrafsPXF2jRptUNyPSVCEfZOdektOOrnLd279UxsI5OFe33TxG_Ni7D4a-7eWeXk00&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcsDs6KMJuCAyW9UslJHwSgmj4ri6Ru0dy1MAXmuVclg&oe=6A562E36"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
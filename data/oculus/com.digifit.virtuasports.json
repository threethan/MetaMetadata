k64Q7kNvwHpzVRH&_nc_oc=Adp9L8Rhn7W9fQu4C95nfDqjHNIepORMGNzgC-e8DQ4s3ttwzMnigAf4BDOz10YMJM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CbUD-gDDcXFsEDoZ3e8qZXHS6dlgVVMEJf8XeolD2eQ&oe=69D25E16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJa8H7fg0ewQ7kNvwE3oDgH&_nc_oc=AdpN31Fn0Pww4js-gZQYlvgBHFfx0L0UuGa5MM3ChzPxhdegIvGxuIRYecugVTpqW1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KWAa7Sb5p5OsO4iRpOXiBtMrb-Q8RH3xZe2I8CceddA&oe=69D2460F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkI-LTcX2SIQ7kNvwF3oEOG&_nc_oc=AdpH_geAfndEPUzn5zzgkDBwOqYREKYvDK3TMTVvlY0qFkHDcfv0EBKdo1d_FyLeuLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MzngIIOU2TIzpDDEuM6EbZoemsGrOLLg8KykLpVMZsg&oe=69D25836"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
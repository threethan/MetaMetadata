dhkQ7kNvwH-sRs8&_nc_oc=AdqHv9GA4E0xkBAbVSvx9kj5NDwlAULNJmlCfL_z0r1z0KyyTd2gtaViOMw1HmFzNEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMUXEHJl5aO4Mv37SJU0sqa6zf-4c3rgtCvjxUp4o-zg&oe=6AD25956"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrhrPibf6FQQ7kNvwHeHpyq&_nc_oc=AdrG8qis0PitNBb72ZN4KlX-r27HCAQeGsF6aBfxlvit1ndxY4WARC1rdotU6Van11o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1UnBf6ZHSDTaaPtml5Sg3fpCIc3mR6UMcZ9Dq-0UlsQ&oe=6AD2414F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc9kW4sVU1YQ7kNvwGcbCIy&_nc_oc=AdpkKLsQ-YZhczk2fLq5rVsbgXnjw9x51kkCcKHngLSBIgx2LdHavEg4nhYKbalDWvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpQNUV8sakHZe1fhTXc8-ACZsHowjS7G8P7G0BaZBlfg&oe=6AD25376"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
l18Q7kNvwHIpOFD&_nc_oc=Adocvnbp3AKZx01KVeCsvx5SBiaqaxpNzAfd40BlM0KU44q6OmQA86RuOSvH2JP7nyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSaSsCegc378psoMh1oielf8HF6K_pDCt9BkA4Y_gxHA&oe=6A79CC96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiBBeO3X0awQ7kNvwEggsU6&_nc_oc=AdpH27W4ywkeO82R9nDlySEoPoMRnYHA-4LPCeKQl6nktiL9_P9Cj68EmLpTyFEZTpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgrR-wR56dpkJDRa3EKnndj24-VP5NPWzzGpPTV2tFaA&oe=6A79B48F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyGX20J9m18Q7kNvwFh2HWC&_nc_oc=Adq0in6fQLKrbdUO01aLm_NHZNt1M5nK-P5OI7N9Ivp17wYrD4ndTphnisQmh-_YVik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyexLToxVM6SNUDtSsbkqM3xL44eQZcBcL2K8HBfn4Pw&oe=6A79C6B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
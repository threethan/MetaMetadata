dhkQ7kNvwEenIsT&_nc_oc=AdrzJV5EaCG7HnOmbH1Ht2pqtjFbKceDhlAxg5-CvmZaeIzOxMrWTUGaYh19qJTf9dc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxlIMaZDPa8KB4bRX4KqUBdw7YselQkQwIFnhdne8k2Q&oe=6AD3AAD6"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrhrPibf6FQQ7kNvwEF1AcK&_nc_oc=Adq6Jtd4JUu1lrKwGtX8FjQsNGPYrYCVyUfldfOr_rhy-1N4L0khkjbo7P8dT27_4IQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgb1EVhKkbdZQmEgPVSSRW1BPEFaMyTMxlb1d23yOH6g&oe=6AD392CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc9kW4sVU1YQ7kNvwEA3ZhP&_nc_oc=AdrR1bx6c9roZJBEFhdN_DfXtic-LlBmt6I4a6HP_avKVr_GTT0r2qDzf9x6FPggWhU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyJAqwT0TzTK1e9VW2hdTASNUZWFQjludDhY5IV9dkAw&oe=6AD3A4F6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
DBYQ7kNvwHZwSiV&_nc_oc=AdpDKW9BHanVgEItgNbL8agQrKx8rRXmC48_FN9Kp3QTdm2sADV7lnu5wA5Cr72S2Jg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1je0Z62fjar_Hu70KCZnj9PSehsCTfeH3v7RfKuNJ2Hg&oe=69E8C796"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oj-3Y0iQOa4Q7kNvwGugfZK&_nc_oc=AdqUK9gtat02AEP6K1nojVFR8RaSn_j4qAVlK0M_-_m8nbfhgB4kozBDW8yPKMByuE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oDN9IxbV496JParYng0BMPbfITFNJ4xNEVCAkW1RfSQ&oe=69E8AF8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gY_uEjL1UUQ7kNvwH3Kbfd&_nc_oc=Adr4g96G1O4VHaIntNd1Oh4MAHYbNnZ9UB1ABU7szAGXkVz3IJms0vtwgQXLXe3HeZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1y_f8khI-mDbRiDe3S5P0SvImhKlW97JNBnXtgq1kAlw&oe=69E8C1B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
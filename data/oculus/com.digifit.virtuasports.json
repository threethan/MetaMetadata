wE0Q7kNvwES9Xs6&_nc_oc=AdrtFqAb5RQHGrLwzg6WVA0G7iA-L9nktIF7aou_PO3yX-sMYFFOZXi-3s6gC3dBwyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMAGzkxy3AR9xadiZBijX5OROn4JR3_jWY2UQ6RXE7vA&oe=6A92D916"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTUwzqTyzBYQ7kNvwGNaiMG&_nc_oc=Adqpg5PQqS0t_zqI8ZjyXM2jz7JKbaZHXh7Z3VE1vbgEQlFuNhCg7aWvJg8enT7SB8c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF77NwkMqRC5K8dCwUU86X7Gs-rtECDlv8hPX67-nsPDw&oe=6A92C10F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmoCXnpjzqkQ7kNvwGEiW_8&_nc_oc=Adp0Dp-KaEetEVOyq2AjxzFean2xU_J2CzbVWsX_2E2sa6L_P6DMNELHkcZYLdCmsL0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF78CaPcC-71Xo4lcMADXT9EFnKW2Q4BDpptS56bYbeAQ&oe=6A92D336"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
DGQQ7kNvwF0t1Lj&_nc_oc=AdrLk4kVC1iFKP0qPvZrH2o5orEa3_KRYmIeKzWH1APiN11fjMPFEIYIv3EW7W40Qxk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x71qUcXwIqWYJV9tnjw1lDRWD6QX1a3BmZH-V6sc7Rw&oe=6A0B0E96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKF7n6bdFlIQ7kNvwFktGrK&_nc_oc=Adpt-F83ZAWoPIqMxGrwmr0pKr_ls0fbryB0ewamoXghE-f-x-BfoWO5jSSlPj3Vccc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FFuMnNQC1r_pGRGWJ3kiP2BErK9z4OSKEx--rJRIdeQ&oe=6A0B2ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd2gwmIim9wQ7kNvwGb8xOB&_nc_oc=AdpVvghdSB_yXdX4sw8IkNEoOofTp5xqDCwfddVRqZn-JkAz0Pe_EkS1kEV5ouTcdyM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RHYrkolkGXCneF_BfPrKDMHFc8934C2aP8vDAzXexHw&oe=6A0B08B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
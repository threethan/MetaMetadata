4f0Q7kNvwGN69SC&_nc_oc=AdqkIxBtV-72C5ylTfp1uChDq8O19GshZZnJYWMbR7BsNO1nc1Gay3s6tH1SstepPJk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyHzR06s62D_tYkEnXakqu8wozlodMW8wqDQWjlR-uoQ&oe=6A5F6E96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6GMlWi5JtoQ7kNvwHrgfmP&_nc_oc=AdopfuWW-PmhL9uWdJsx-jc4RrmVE_RpW7QPwamOfbq55vNoIdvSEmpXX69qRDtGhzM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-zBht24l-FUYWbVbKbS6Ms-k_gWx_xrboEBkZ4Z4Yzw&oe=6A5F568F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8q33TB2uGKsQ7kNvwHVQCmK&_nc_oc=AdptT6TYBzSx1z2DBiWSQeMqss3XiX-0de_bw11m1vCYBbaVtqmmyS94G5i1Xds-9wQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvNZdQHc6mVIDN-Tw94H0gD6-sUyURxgk2UDtxqprgyA&oe=6A5F68B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
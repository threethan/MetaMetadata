cOUQ7kNvwESydhJ&_nc_oc=Adql-WGtDjfdPxzO6pf8GkoRrp5CzS4-5EmOPqsHWWdPHXKSuB-iv2tA0mc2bLbeePE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_69HHSzHoPGGH2Tx187OUkIp8Cxfhn-zjAZ4qjR_2Nw&oe=6ACA7056"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjIHDmoodBQQ7kNvwEyE8or&_nc_oc=AdpBZTcCYQqHsMDTBCnXYWlFkDJC_JYRL3EKgel47s_QnMo4_BdN7X5RtURUm8izmpM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsjXPfHqXRU5Q2R0N-8g6QEcuvUIImyoDukppOHT-WbA&oe=6ACA584F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfwSeJs-_30Q7kNvwGqMvvY&_nc_oc=AdpX5jgc6iNqz51Llb6ysgWxejYuFkTjjfNCEja4q9dKi9tUGVLj2I_XU4z62lo61ns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvSRH7nAeetcBmmSMPLQu3Jszctgpt5EAPoF4W9LUL3Q&oe=6ACA6A76"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
9lkQ7kNvwGej7vC&_nc_oc=AdrZzMDknpBZr2-NgbibPK2gUVY7swL1qXei_W5rOHJpaxlAOnx-TeL5xDbb8H7pvuw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoAfYVg2lcFb6olTtk7ZglhbBNmymlGQUmEEsiyax0tQ&oe=6A5CCB96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktZe_i-fMX8Q7kNvwGR0O8_&_nc_oc=AdovYtb3VZo0jPeT0aFItzXv3mintqUu-N64Dz2swISPTcJUknlW01c4aHZiw5RsKGA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ747-QkAqK9ZNFxHJgg6SNtKUMz_peXe4jg673uC5sw&oe=6A5CB38F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyLp9ehjVRMQ7kNvwFprPBG&_nc_oc=Adrc7z7IbcwRBQRV8I9RivnEQLEt0DrWq-vAzs8tTzmA64O8-i4IzOOq_-74kBWQoDA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVnMFaF4MH-WGo7S3o8Rnx8YDMk6zzn_3DHlRbT7EjQQ&oe=6A5CC5B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
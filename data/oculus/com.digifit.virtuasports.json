nFsQ7kNvwH63wDP&_nc_oc=Ado99nb4M8g7q14VsIEg-ZydJIZ42p_6rB40RCPIk8wrcBYBck8u_UJnj10cm9h4mUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30GM4UNOGsBikw4WFgeTfX5sbRbg4GBQlJiH5XCytpNQ&oe=69DF8D16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yluHYxekK7oQ7kNvwHH236g&_nc_oc=Adq-XZ6jt0xh6KlxlGnWqUZ-hBr6QLJurPfQXT0om2Vx9bV8sBBRn2qImKmB-yhQwkk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24BkBbFrKPQNG7WKNolFrt-BaeUf0ggPSgPBNam1so2A&oe=69DF750F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltb2xuA189kQ7kNvwH-1U6P&_nc_oc=Adp6z2KoImatGuhJxivVq-V07vtGH4G2WOyIQ13l1cBbSr8ah8wpZdnUK4few3iZeCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3acJM1j27qlkmNgEWVnoWcdYcrkjPDlo86h5I6zjkoVg&oe=69DF8736"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
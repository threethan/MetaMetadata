nlkQ7kNvwF8IPPl&_nc_oc=Adr_zLnMbUvWs_mdHYDRwQnjbjpvK8ITinpISUsOy1X_05RguJXr3vx4mKPmSFslxT4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE5G_o7Urlk-4QMLkU12NeZHqpBSX2AVYKuKNizX3HLw&oe=6ADCAD16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Og8k6yxPu18Q7kNvwG4WuzG&_nc_oc=Adro4XxnaUYFvIa3mpbPnW57y-dihl1PbmIHPmB2oLY9fvt_8ZGTS0lj0nnafjCoXI0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjQpo5R0YxPn943M8vXHPmavS-3PUbLyvV48pHtP4DWg&oe=6ADCCD4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMARzokJX3YQ7kNvwHRmYl1&_nc_oc=Adph5pa4i8FIOcgStxV_nzEYOBeGJh7TacbMOvQcATqiTp5SZwXyZzQzkL32Fs3Ei94&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqllTYionNTGK1hSsFQfi_qctNGkmhx1QpnqR2QgIr2g&oe=6ADCA736"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
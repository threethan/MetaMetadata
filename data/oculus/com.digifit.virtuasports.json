MCEQ7kNvwEIBbRZ&_nc_oc=Ado5tFOJz5m-tWqjkPNnZcy2lfbj-iK6s466tcL_HXaKzThGL0XmdM37weMgL3mi5rQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_YMa_ITS0l3lmzINrME8iFiuuTLGuWARhbHoMl3yvPA&oe=6AF1FD56"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHzOhKiwAisQ7kNvwF35rtJ&_nc_oc=Adpy3Ca7RFqVes-giFrhp5s4uGyekNVm7HulvBqkhklrKjML66JM2QWR657zWAB2SEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqn0fy4JfvT_PtQ8l0y47m68NN3rsn7-fzZROzAM7T_g&oe=6AF1E54F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76jlv56bf-EQ7kNvwHo5S2e&_nc_oc=AdqZx8P_WJIFNQ_Bfty4JDGJT6dBIJoRpcP2tv9JbcVKaVzg7bNu3FfiQMqd9N-uBek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1CsN43d3nQbZ5axzNX4wkvZHehCvPYNncxQcy3eGZ5w&oe=6AF1F776"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
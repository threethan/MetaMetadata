E3IQ7kNvwHA8Esc&_nc_oc=Adpxia0VzVHcsh9BtWZUVhXmAn_4qUm2v55YpNZfH_Pok7nZ20yuJ9R0-tI00_1wvTY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKZSZh5Xp8MucN4_QrQUuFfVzsl_fDUcBogwDC7UEVkQ&oe=6AA69F96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPCAZJu0Al4Q7kNvwHiObR4&_nc_oc=Adpcg5uRj-9BhzLchA9vs4tcYi9Q83uoWxzSxvnY9NzEuOOQ2QnuYOFWr09P8nwh2nY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgf0Cg9GOGNlfdhW5hya_e8FqgxL1Z1f4x1HtL4SF-cw&oe=6AA6BFCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8uWG6dKSc4Q7kNvwH4hJwM&_nc_oc=AdoZyyYNJSbbvsXbXu2sf-05b29gLAlvk1ISUXjthuUOTNcl3x1LLKyjSAdyqWxwV4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJblS7sql20JUjrovdkyu_s3meCyfNWpXbhcMFzTosz4Q&oe=6AA699B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
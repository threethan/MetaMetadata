JmEQ7kNvwGzmZiO&_nc_oc=Adotf9hIW9_OokXLKQ55xMb17qOhuM2nV7j9yFWOiLOzIlXJzLlDkfyGxBLAiPuUcOo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V9iwXtzzHgscL3VzuRmm7TPH_H7XOQ93i3LDnMX0BQA&oe=6A3ABCD6"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmlrqJKCA3oQ7kNvwEeHv9t&_nc_oc=AdrdtuIKjGHID1OARCHMu0vZStO5ixW4XREhbsSzlTZpiuPXPg7PPlZO3L2Xm4YezWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QPBp_sg68cPEt3NiGekhVxTqs9LwF8K7BnhtM3GVVxA&oe=6A3AA4CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrw5AVTh3sIQ7kNvwH8e6lG&_nc_oc=AdrvipOEuzCC1aMMU6ET05V-qYEoiGvAic7y9hFedp5gjCYIfQ216eQMMgMJUMpY-bE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WWoGI94mUunGKqPk-1Fv3jdDfVallYU6IT6NGfZXGAg&oe=6A3AB6F6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
wtAQ7kNvwE1HUr3&_nc_oc=Adp5alTFWogE9NkcUFpsoVuwACoUZaVU-5L30lkmhQ2HD6hLXoXthsw9OzwtcdNOlWc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EQ3ibq_h_dktyZ5H2a27yy4Sk409zUB43qrfBxXRTMw&oe=6A280F96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6JOi7ukjiAQ7kNvwGU9SBL&_nc_oc=AdoiN7vKUQqpSWIJ3q3pB9OgVzhhx8Q39-gochZGLV0O2y79LxJ1JTOOiWWDc1W5Vxk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SQp76o7WofEJAhZVogVdPvi5pxP5AiPOOBGTiMDSpjw&oe=6A282FCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYfgp2hTp8wQ7kNvwGd-Uq0&_nc_oc=Adp3Yjj9FiJfkQDVr4TVn1SLaW4IXR4myJ2Att9Kt0BVSk4TStl9jDTlFxYJw0Z9PuY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_MwmuviKk-10S5hr9_r8bSAcXGzATdKJji25SdZelsw&oe=6A2809B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
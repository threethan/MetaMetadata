NfwQ7kNvwGiuaBq&_nc_oc=AdqtOaXZPTNGhwfp6d6W0UlBzUVdE1mwRkxzWU2bkn04dQQsWgJ6xVW1-X1qPia7CfA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWK-cwHuMU55SHd219LzruVRJeAu5poa6wZHHrLYo_Eg&oe=6AB27D16"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVJgS98ROpwQ7kNvwFbR5d6&_nc_oc=Ado8Q2s9_5S6cYTsbrkn49S3NJyfIQJLeQ49xJktWe7aWoLFn8M750lqkbfKvOtO5Q4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQaYC79kV2MNiNmfq3-BNkxQQ_wO5CvAL1Jqop4acJuQ&oe=6AB29D4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nUUBI2OHqMQ7kNvwEEnkgk&_nc_oc=AdrNwZ9XsxtOsLBe-zB9mpfd2FdLm_eqY_C-5NNBHrT_Af7FFGzxtbpPAFj-r63gamg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3u6oHqvBOzqPZOsSm1TeCFjN5kNDyrXLKOGQyfhlZwg&oe=6AB27736"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
WRMQ7kNvwErTRtg&_nc_oc=Adrf3g_HEl5KDiRrQ-50ZBk-wmKQItpdDC16nIuiaupZ3XxEdMHOmyut8e_uuM2bnj8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC0CpwbSa046VRZfh8lsEBT0vrXvCJf1a8FN40M1g0XA&oe=6ABA6616"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9Q_pWH0ZmcQ7kNvwFtXiLy&_nc_oc=Adrn-7yWD7ihwbTml0dm9OhPelTCoUYKvhyJBq-XHtQT9M_i5kuKKf9kyuzw9S5yFJA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEUuc09JdW1FKMZqRIejKoSgxppj8lp6Ud5zS42h-nlQ&oe=6ABA864F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QDdGg_AJbwQ7kNvwEpQV5A&_nc_oc=Adq5PAfLSZQJ1kc7FB6rjgXtjJqWUWvsAWqrTIzJW-mP89tySLrNahCTCd8LNO_hqZs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS7FRHaE1fOoh3vDSssqr902Cnre7mYztB9L2f2lFmSw&oe=6ABA6036"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
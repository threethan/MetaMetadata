Da4Q7kNvwHjpJ9j&_nc_oc=AdovrNERWG0xdaNRlJj7NzsLoxXUU6anc42XpL2eLTi3HGZDJH_TrO66MRbhAWk2Vow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Rvt-5F7BfVOz4NiZTk6zoFhHSSMQdIS1uFDa5ThtPwA&oe=69DA4716"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYuNQUBrLXsQ7kNvwFohe98&_nc_oc=Adrgba8HRi99BOEh0rzkf4uK-I0Cq6tv7-4dp_v8-mFkw81mvFbTHrsSvOSfG0a2lvM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t-pNP-r9YVgvvKgbzwzHBIe8_0aVq5lRAL2Cw2z2QiA&oe=69DA2F0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3k_6wjL4a0Q7kNvwF9XeC1&_nc_oc=Adp6YT6wCiLX_P9O-O1dpzY6cdxftGOnokd4fDwADGzV023R4lPr6XTyISBOhmeCguY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MeGoWnEDvpSmNPfWFx8m8HDi41XwHbDE_2vNhK1yxzg&oe=69DA4136"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
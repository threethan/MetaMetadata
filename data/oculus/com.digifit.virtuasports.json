zFMQ7kNvwHBaOiH&_nc_oc=Ado0yy9IYoTj-Q4_uSMF8rh261pdK8SN1JOsQg7BrZ0WkINDx70f43V4LsiJU85_BOE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFbDd29fdtnFfMGGP0hXwluQfcx_ikz80Zdf6ios_A1Q&oe=6AAD3716"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2csCpMXLMIcQ7kNvwHkq1iX&_nc_oc=AdrEtrhWJRSI_UG_CbJXNmcEwTdf5AcqUPkVTC5wL9HgF_md8uLFfNpEjcrD9O4-udU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiTGYB_r8ZB04f17mdG91eDVZEZGcFIMwFcaFk_rny6w&oe=6AAD574F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ne6SWcUMOBQQ7kNvwH-IPb5&_nc_oc=AdqGyzfw3uVT1lj4wLYwUMtKuj5GpUrwSWSKujPVmpcJRxA3UNwXkbYqocVZnO7CqDI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxa37NCnv3W7ypkINd5NnCQfQymxIhHta29M1tDtAwaA&oe=6AAD3136"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
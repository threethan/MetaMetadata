ad3-1.oculuscdn.com&oh=00_Afv2qtzL5lS_-z1sP5OgwB_XGJwjlxY-yRVcNPrED8hSrw&oe=69A04516"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXDl-DOosb8Q7kNvwGT8rID&_nc_oc=Adn-HBT8akF6MYWqIL3mxZMpV6ilxNRzpbxVnI6rAC8lCseqAIRMtAb4HzIILZJW7E4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftYSO22L6oDR5SHmCZrKe0yTMZ6Kgc2vEH4ta7n0aaefg&oe=69A02D0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_VL8g3gtaQQ7kNvwElM63a&_nc_oc=AdksVZPcXDGp79oo4j8QBOQ79WmMfL_n62aSDi3PcD9WQP3tP243qwcC5mgBchd8lNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvE2olgIuCh6ztW2cLTZnf17CHQuNBoYihqEmSH0woEog&oe=69A03F36"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_description": "Embark on a VR fitness adventure and ride, run & row in virtual worlds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtuasports.virtuagym.com/webshop/terms-and-conditions", "developer_terms_of_service_url": null, "publisher_name": "VirtuaSports", "support_website_url": null, "website_url": "https://www.virtuasports.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25824222697207777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818925_1470776471146651_7193465605441863216_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xGX-7Nzl_UQ7kNvwHmD-B6&_nc_oc=AdkRu2NZnEafdVtDycPTAjtNtdfKzS3DbBQsX9vNgzh4I5X0McODn1RD_cMg4TtA0Es&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsBPQIGA1HHKqV7khEzcp0L53HsYH0VmgIaFaFsVdMorA&oe=69A04E70"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VirtuaSports", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1764849720, "lastRevision": {"nodes": [{"id": "24732833923013332", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2473283388301
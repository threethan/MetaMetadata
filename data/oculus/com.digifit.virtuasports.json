wE0Q7kNvwHE9A5i&_nc_oc=AdrqWc76BXMKm7q_WhZTwCfZtYwtw2rJzBjvo6ZE1SSyloF0qQ8fzpTNOTLY9uuZps8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2SYpIV3Z7JlVdAl4-A-GHN-ISTJx6zERuUM0bIInJpQ&oe=6A942A96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTUwzqTyzBYQ7kNvwFQCMIz&_nc_oc=Adqr7DdHSof3sjg_obccx6g_hXqwHpX8I9_6uSspmyHKlsM9ukU5NdIZ8TbtiybTc-A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmOY3osOM1ecv14VdhIK6czzQKwDVwLnWWRWSo51MU5w&oe=6A94128F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmoCXnpjzqkQ7kNvwG9IbVg&_nc_oc=Ado8IIQX7c_aKqhGq6vvozCh_LzUSfvbQOcIscJhjyBDe_KTWk3My1ogrUnJKrwCKrc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjGKT1Ebot00sQlPID3G5rW85SpXkW6zRBlhZByX6ajw&oe=6A9424B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
MJsQ7kNvwGi63nZ&_nc_oc=Adq2ckbmkWt4HmRLmnfr54unLWAZDlK0Bp3H896_Q9Gk2lnnheB631hmLay3lopgHWs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABVg78Wl0gSk6NtYc7pHznZ8bYqya7cA84aGa9rlg-5A&oe=6A6C9D96"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xln9LVIw9AsQ7kNvwET111-&_nc_oc=Adormk4EFS5-UyjzJgyaFMWM9K3x7PoTX_0Zug_DVa4IPT5rRgspt96GVAKtP13JyCY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY6CczC5yWU-7uLFcBuR2PP3SSbZZ9ChSzg5xnPERvcQ&oe=6A6CBDCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziN_wSN4Q6MQ7kNvwEzbSzH&_nc_oc=Adr_fQatGKcBoHYPZFhLiuTOJ1AFwFMTX5Aom2wLWQB89SrKOMvXrSAwCxBz7Yt-51I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5y3GHZnoPsI8nXqAxMzKjkWaKM7wWod1oGNC738f07Q&oe=6A6C97B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
d_4Q7kNvwELdaJE&_nc_oc=AdrO4G6JIiHv_vjS5TeVd3bA8PQEZfF8NtZpRqfHJL5XmxGr5d8vNjhFRJH2arUvcR8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KCVBCCvxXBv6qKRScUoBUW6Hv1gIQFJY0EAxbWLup6g&oe=6A12F796"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx54mKn7miAQ7kNvwEJmPyc&_nc_oc=AdrJZCZb4R3rD1KE6NvYgUBgL6f8KYFe2A8P7GjEGVziO8ztAfSMPb4cRyoEz0sbLZk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5L5jWVZzT_-Zp3qqxh1rrmfmR2KNIv0fL5wFXHb4SjSQ&oe=6A1317CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBvXp22s__MQ7kNvwGTYPg5&_nc_oc=AdpRMpGPD00Iy8L7Lqqs63oHAmqScPwRD5S3sdJR4NmDJrzEGnftWSjoJ5sPWOY4RaM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zIcl2pqaXHvcePgLUvHTF88ELh8XS_WmJEqY-YMLrsQ&oe=6A12F1B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_descrip
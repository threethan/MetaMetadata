7XkQ7kNvwEpHjvD&_nc_oc=AdrapiuijPsn4oR1qeOfPC9WFRZOq6VKHPgT4TLe_OfvHSFvIaNWYgRz7w0W9n3RBE4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfrNYkqYw03EC0ym8FJAa1c_GZnutjgIU20Yg_VllL7A&oe=69CE6996"}, {"file_name": "5.png", "id": "2189380564903637", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307479_2189380568236970_674864971544444212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u688sKFM-RoQ7kNvwFS5XID&_nc_oc=AdrIAaTPD_aqTB0v-WWaNXKjoTi6Cj4yvmZR4jTQfmN3JOKSNeTq-IM0ie6dp6mCiBg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPQ5A3SMolH0lT9OE3js8H0WH4zm4XO1KJv9NTBkTa7A&oe=69CE518F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner.png", "id": "1143713407352319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823286_1143713410685652_2535227240892824168_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUvw-h3xRdUQ7kNvwFgODuH&_nc_oc=AdpzElMO_Xd9o9s2B-HdhI6mdCJkg0kW7T5AQota3QvJhY6Nf-nalYszctrZ6cVqmwI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7TjPeeQdkkRvHybLvR7SwjCXX5jxz5Bl1n2YQsvc04Q&oe=69CE63B6"}, "display_name": "VirtuaSports", "keywords": [], "long_description": "Hello Virtua Athlete!\n\nWelcome to the future of digital fitness with VirtuaSports. Ride, run, and row through exciting virtual worlds together with your friends \u2014all from the comfort of your home. \n\nGet ready for some friendly competition in multiplayer mode or challenge our AI players if you're flying solo. With the VirtuaSports mobile app you can keep track of your activities and progress, access video workouts and join our community.\n\nWe are continuously improving our app, so please join and download our mobile app to provide feedback. If you want to support us and get access to special features, you can become PRO at virtuasports.com. \n\nThanks for your interest and we are looking forward to build the future of fitness with you!\n\nThe Virtuasports team", "short_description": "Embark on a VR fitness adventure and ride, run & row in virtual worlds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtuasports.virtuagym.com/webshop/terms-and-conditions", "developer_terms_of_service_url": null, "publisher_name": "VirtuaSports", "support_website_url": null, "website_url": "https://www.virtuasports.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25824222697207777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818925_1470776471146651_7193465605441863216_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOC5flU23F0Q7kNvwG0iQ5W&_nc_oc=AdqbC1X1PKYhfyHePWD3GDY-CDrk50WkjZ99N0wBvHZP8Z_VPykEjpwOEVhSP5Bjck4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-F2uZux8Kcn3CN5e4sfbPJFYcIEx2Mi9pRRxZNQ9pcg&oe=69CE72F0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VirtuaSports", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1764849720, "lastRevision": {"nodes": [{"id"
8", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491829120_1026850020403931_7659213534684975554_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V0-tAMIQ9YQ7kNvwHAM9Er&_nc_oc=AdoRW-avwb_uNPh5XW93BpXQYJbz_b0FG8lTRPdZzyd02eDXTpWKBHfjo5j38pi9oFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZptY0GrH_bv3xeaATn_91n8EY3TCmsGxef1js8nn5jg&oe=6ACB91E3"}]}, "id": "29828019723464449", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLxCJYpCTM8Q7kNvwGiBpaI&_nc_oc=Adpr7QyQbxUWIxRvPQWTk0Z2wbbKkE-heVlaNaYjXEp7q9M00JUmkFACm1SKYekugPM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFXbenriOHqqnn_uE1gXT3p2Ev17wjkOf-N386Vx2EuQ&oe=6ACBB019"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85k-mjJ058cQ7kNvwG2V-ul&_nc_oc=Ado-6J3RsCZ00WFVLXjX0JNkOhIOaBdYeQ6kvgl6yLYaWlzYa9FD7czFuQpodLv2U2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw_EvoPQBDoIhjH3qGvLUoSYewpZK3wrFfQdiN2RNang&oe=6ACBB118"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqFjj1NYZlMQ7kNvwFgxBPe&_nc_oc=AdqMAcfiFBe36a94iFO3tu0rLZGIYDGXLdmqZm4BHbZZsMmE1yc1OJGTihBIui8ZlH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMb8_T6BZwTCd8XisGJNnY_TPwphNt65uRRVeGa-E4nw&oe=6ACBA255"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPZreuJ9bH0Q7kNvwEMAZDx&_nc_oc=AdrBWfo9lVPZ6OKal0W_25UYoKA_ImPswxYsUmOjQL3LTX67mftyND10kYxbcRM9CSQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcwFfWOobzGZG-aN9WKxa2MPtp1XkcEnypnz8aRqibNQ&oe=6ACBB407"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfqhdI6Ii8wQ7kNvwEXmNSn&_nc_oc=AdqLcxzxf7_s3NYDaR8kDRh5xypy2_9jrP_-yeSpc-wDTM61IyyBRZOigTL4ZYXP_4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBCTtAkVjkno153ptsmDaa5Kx4bVmUFAdvBHf4ummjMg&oe=6ACB918D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKN44evdiUwQ7kNvwFOUzcF&_nc_oc=AdrIvpbWY4h5I35PM9DGWy01dyw25Z8C-9NoXQfrS61ZWwcULPiBxrLDOIPzenf5J5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPO-Ev7HcmfBGRnYDcfh-BNy2gjCJmAoauZ7UoIY0RbRg&oe=6ACBBB38"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**Free to try for 3 days.** Everything unlocked. Then one in-app purchase to keep playing. No subscription.\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe optional mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3543613075811708", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_3543613082478374_638908712768740982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJmz2J5Q9dcQ7kNvwH-p7Vg&_nc_oc=AdpB3JWgH3HNySgRkcWcFXKzR2F-bo9pKM-TnfgChZfoWQ6GX2Uq0DcGu2X9LoBY0Xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNResa42i1buxnBkXVem42DcY1qxeNvDEBPdAkYW-bVIA&oe=6ACB9ABA"}, {"file_name": "Korean Quest Store - 2560x1440.png", "id": "2026406291329707", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_2026406294663040_7189430179496047163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bv2bvd00pbsQ7kNvwF7zyyK&_nc_oc=Ado6fuUAu_8bRMo0DdlBprYyavsVms7I6BELx5Ew0ym-Sb-14_BXxdhv8kWztwCTrVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTiOPQDipAizJAv_00vuSYGkQm1meFrFMp1wzpq5q9rA&oe=6ACBAE50"}, {"file_name": "Korean Quest Store - 1008x1440.png", "id": "1568265651414352", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord
8", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491829120_1026850020403931_7659213534684975554_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ae_r4pb8vcsQ7kNvwGv3aid&_nc_oc=AdoFZgk1nlh5nhnrDU_jLSNgZ1DPkza4MdIddr8iOFumkqXgsYlHT2yuR7UOUQJGm9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0S3flcTDK6KaUHtfV8yA-JPisam1ObQIgrBY9fIhdSQ&oe=6AEB35E3"}]}, "id": "29828019723464449", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqhP8_rKuE0Q7kNvwHsrkwR&_nc_oc=AdoLeKhRV3g-B_sa4tYXLDxSsIpunY__BHLh0CUlvtYgS3Q9Xnkq0s5In9CDF5ZWvM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsbD-ZuHjJFPzea19ecQ15Drs4spqsVRwU-hviLStr-A&oe=6AEB5419"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu6k9zLtLYQQ7kNvwGTNllD&_nc_oc=Adq4PmFcwUP7HQeN49-PWvOJ2Vwy3KnaViE1dD4YWId9QHCUmII7e9vhoE8tSv30y34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm5O2EnwBrC_0wV8tOcoLqRmbLifObzqitQ_j745cLWQ&oe=6AEB5518"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8syMi-_YU4Q7kNvwG7Ba7j&_nc_oc=AdoQtE0IT6kaDUrdICiYcejNTTVMbjJcQHAKmRTCPhzPSNI5qZ9SC8n1I1NDv9y7RlE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD6AHekC8d4omGsMGoprkRDpoQ1bT9wgnsk66OoyXX7Q&oe=6AEB4655"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTIZqzk0x7UQ7kNvwGJhWHi&_nc_oc=AdqWvp0VMny6TTb3g9DVHzo3Iqh4xTv_ZzV03mUNNr4jLt4aaGMAdxOOVZ-ncbMtiSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd4mgfVlzPln3ODmuyyJKglaLraYKPSX9APRGH2gWXew&oe=6AEB5807"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y803Ts0LBAwQ7kNvwEpAlPG&_nc_oc=AdrqdWaq85sCuzRM1h275p3MX493W6xowfYVQbmJBxIK-YKQsfiCUCZuXqaJcYKdMVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIV3hpBcfDVlRQ0mhHgKCqwH3tWyjR2bwnu1ix1owfxg&oe=6AEB358D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVWl1tN_lSEQ7kNvwHjR1mZ&_nc_oc=AdpMxMWNlOi8j8a0DrFC1Bm9wemiIW52Lv192-0deavxEhX8pX2Ts1SpaW60kXEXXE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVHRFqy2gpgxN4nO1bWf5CLqJrsga36qKNODcU3pbxgg&oe=6AEB5F38"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**Free to try for 3 days.** Everything unlocked. Then one in-app purchase to keep playing. No subscription.\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe optional mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3543613075811708", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824307_3543613082478374_638908712768740982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGRyftQsxwwQ7kNvwGVCZ4w&_nc_oc=AdpRy8UIDXaTFoJ_OclA0jcDruSMNeRCstyTvAPm7sftvREfNaGy2cSE5i2c0rbaodc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTifVWmyjljmkpQxiU7rjo0Juk-2I_wlfWuQaBEkLM8iw&oe=6AEB3EBA"}, {"file_name": "Korean Quest Store - 2560x1440.png", "id": "2026406291329707", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_2026406294663040_7189430179496047163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nX0PxcxOOLAQ7kNvwF26pKR&_nc_oc=AdrMncHG3qqgJJage7vhMiVLiUdmgkshC1nvupxMiTQ4BefBTbV5-ddYOmsVu4XFtXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWqpsUeku1yi3P1luYligPfmmPK8ZQ-2kllDnUgKrJkQ&oe=6AEB5250"}, {"file_name": "Korean Quest Store - 1008x1440.png", "id": "1568265651414352", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad
8", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491829120_1026850020403931_7659213534684975554_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ew4-PF-mHU8Q7kNvwGw_aRy&_nc_oc=AdroOY48cUORym6T6c6Y5Vwu41XqGgNfVp1MahX7k86ne-Y5OoUIxY5rtPh_Q31_9Eo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCb_RQmBaMNYLzg5d034TufFMIGsdPHzdFLkavYDMTmg&oe=6ACF8663"}]}, "id": "29828019723464449", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ev-2xZGfZz4Q7kNvwHp8XAt&_nc_oc=AdoPa0YmV5tAMN04VEYMpTLvsCZoPmL67gf0nK_vmvACNQ_ZEOIWP4Zjuapi8wsqvPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM64dqMYCBQcMDrEeX1XP4TQcjPo2EUa0QS7bVkEKDi5Q&oe=6ACFA499"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkrMIEsrS9cQ7kNvwHSdusR&_nc_oc=AdoIg47STdpiVrl-G6UhGYS-OHn8ZJ8SV0DIQ2u4qlXEbsodJxP8XZ1rXrYFX6UErAg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTHLnSzJOocD3BbSE8SW76osQQJ7_W2P1dT-NJJ05_1A&oe=6ACFA598"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zRATxyyt7IQ7kNvwEemxcj&_nc_oc=AdoHkDbwyiFv_hI92QToJHNvKtXXIY3UHFTCt9fl5nIFW6FNgimSoP3xmPZNp5PcXyQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqfosM-oobWA_s9Cngj2_GLe2cSJo2cYEl6WhIIEz_xw&oe=6ACF96D5"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_6CpnlgLaEQ7kNvwE3ppxK&_nc_oc=Ado6X1CxTr6VFK6TwiAtj3ot3VQZDpN7sBF02EWA-na1ZLw2fyb6B4RRNX59cx8WMPQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMa6V6PpAd_rWbH8p_IA3WMh9nTzgLeRZmaVDnPglZYZg&oe=6ACFA887"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaOGk3QTp8MQ7kNvwG94ts7&_nc_oc=AdoCfWJNQrz6YgZnwZoM_ZcN7rRGqoyw7f3aoFZVhu7GR5uOrTJPluNUd3Ia1tgaqG0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLXhOhbXs60A7AMTy0zXcZ--PtvH8lxpxjP2oM2FHufA&oe=6ACF860D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1k2nlK5cp2gQ7kNvwHjk_zQ&_nc_oc=Adphi4EVNqx2M9KzPc0EW-kpmdJA41jKaIIvnioXLEXxXK5e2LENRxl8wslHHghb6y0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGNRKIvcxPXXvBwa_lLedeYu1sVzSY6DBKgFtB7_-PMw&oe=6ACFAFB8"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**Free to try for 3 days.** Everything unlocked. Then one in-app purchase to keep playing. No subscription.\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe optional mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3543613075811708", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824307_3543613082478374_638908712768740982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPmguldaw9IQ7kNvwHjWrGL&_nc_oc=Adp0CG-iPbLBNWOhjFx9T4vRXyLh7YcEo2JFbon2eLnhoAfh_n28mC9YANFrEWzcmJs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5wRaAz2uOI_1LRpoVizOHv01FOTG_Vvw2hKN6P2Su4g&oe=6ACF8F3A"}, {"file_name": "Korean Quest Store - 2560x1440.png", "id": "2026406291329707", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823837_2026406294663040_7189430179496047163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKnKXavKqpwQ7kNvwEOg7eg&_nc_oc=Adq_Rb1XAHMs7RHhPvE-EnVxZoTlv3yxsvzeWIDzzxchdVSpoDjoBvVWHh5grgN6huI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrQrLBiG4tL9uR8TuQpI0l2AqXq7a1CTix7B68L0q8Lw&oe=6ACFA2D0"}, {"file_name": "Korean Quest Store - 1008x1440.png", "id": "1568265651414352", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc
8", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491829120_1026850020403931_7659213534684975554_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Il5LkhSMRcQ7kNvwGzA7Y3&_nc_oc=Ado3FH2U7gVQy4B3KLczhqfeO8WsDZK2xilMNwL1yU_7uH9-rH5QpkgXCin3vslG1x0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1Dbp3kNOo0OyiXjouWcVro9oEu75srIVCAxEPWpPiEA&oe=6AEDD8E3"}]}, "id": "29828019723464449", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQAIjaS_OmkQ7kNvwFE-NqS&_nc_oc=AdrRaL5W8FZq7BCPjhDx1BV0-K88YLM5gm1EIkcRMgTTvH_yGNKwzq-ieZKTP3VEj54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsEBNDXU73rBCulS65Tp9mAAQOy5Prid2_YQOXRt6Cmw&oe=6AEDF719"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyBksYqKaZgQ7kNvwHtrG6T&_nc_oc=AdoKJ75QOFwNaKOgKc9TkhU4wbGbpBTF93jpjTlzAIisEtS3qUyGaNPvhKUPROlDH30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTnx8rE3DYJdZs-UGyxnMZOgZtfEaa6ogBkFT-ZR37lg&oe=6AEDF818"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8syMi-_YU4Q7kNvwHPKQ1f&_nc_oc=AdqjQGfRGutv3htGOeF5ZhfOZgrWla6Jitj-TrDuj-CL9DqUKPbfW2nnk4jkVl5KL6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLF4GyySKEI-CLQzWZTi72LrP9nhvtlw6miQwi_l64bw&oe=6AEDE955"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P3HUaDv1VQQ7kNvwFzJ_kN&_nc_oc=AdoGn5kjtBu5NBmyQypAhJ2EbZLAB3I3-77d2HBjEdwWCqfRN4jy7rpHEDGq2bi959M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLGCnFnSHfH72TFmaBKfdajt3tGrP90rq8jN7eIg7cPQ&oe=6AEDFB07"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEbGeDbPIcoQ7kNvwEq7Vpe&_nc_oc=Adp_aml6RqU30DNRZLQeMYv65E-cNXTXug0OPoDlu50m9a8QarlgRHhUnUeHtbD_Or0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZtNipxWzwsx-AkoIk9u-buz-eHHz56zfuy1rqWXL8RA&oe=6AEDD88D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTD6j0cjeUAQ7kNvwET_iXa&_nc_oc=AdqqXVwEQ3YBI9jeOIV7iwis8Lp7LkXdQdhETOwZnSNEvTNdExF3GjZQwo6Mzx9Kj2E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9UAb-odluMGpHnelqC9_-oEOE4x0WgYLALPLXQA-YgQ&oe=6AEE0238"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**Free to try for 3 days.** Everything unlocked. Then one in-app purchase to keep playing. No subscription.\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe optional mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3543613075811708", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824307_3543613082478374_638908712768740982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxpeUjKhlJ8Q7kNvwFWH5AU&_nc_oc=AdqTG4U9clzawP6qCXhStr5oYoLufRvhgfnz9g-_bf9J0cxzaXCgQ7VT_rBhaPTlTc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTG1istUOeTQxjm8FW2QyLcXcpdY4KAAXg_LlQQbD6Mw&oe=6AEDE1BA"}, {"file_name": "Korean Quest Store - 2560x1440.png", "id": "2026406291329707", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_2026406294663040_7189430179496047163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEcNUMmcH8sQ7kNvwHtsvTF&_nc_oc=AdrBiEFUF5m1Vfpt7fapiYQgWbpvW16A2wM4b07Oc1OeZB6l0RsGMu0_FPiVy28NCfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS41i82VV2UMKPQQPq8ZzcVHr17ZIyP30ikwS_EF5oMEQ&oe=6AEDF550"}, {"file_name": "Korean Quest Store - 1008x1440.png", "id": "1568265651414352", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad
8", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491829120_1026850020403931_7659213534684975554_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfAgyAdbs9EQ7kNvwGC_1AT&_nc_oc=Adq04lULUS4wa-QNRFdjd6LZyW7UcHpOVPTJYgeOR1_QTsNs7kkFWlpOkhnjt2Qrtjg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWK6GaGnHF8kVuLWJ9GGEBVwzZP0nMch0YddLAWEgxyA&oe=6AE34CE3"}]}, "id": "29828019723464449", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVfOMPBYt60Q7kNvwFdU2An&_nc_oc=AdoABtVQwXbLoy7wSKn0GzDIS_39hDSUU5RVIl0iMojBypCGKHOIiP6F8dOm3u8kJSM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzoV5pTqUJkxeDfJDTLRMemOaZCHA_rhVTzW6CVSBRpQ&oe=6AE36B19"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z03eEvuM1aQQ7kNvwEnKn7w&_nc_oc=Adr0b6aWqde_jT2kZkXGks56Qi2tXdTSNNbJEH8hAGcYBT1NtW6CG5XRAWjgMyLmIbI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ5cU8EATBrSaaKv5tNfHMeF2gho8-4ygvcQn-4QhxvA&oe=6AE36C18"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSzW8X-Qmf0Q7kNvwGfJygL&_nc_oc=AdqTDOmrlzx2heO1EdBMIRZ5JSwER1QPmsOOVDH-hgipFW_AiqXPmuKJykRkutOWTNQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBly-PqvHHi3HSRuvf25jX1Ws_Siu8iX6ClPBMzntphw&oe=6AE35D55"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9L4tew4YrAQ7kNvwEkZ1Hn&_nc_oc=AdqOI5FfTwtvAwMUb_sOCo78PnUJKlxakr8-hNmDcI6CS29lRdyqihQcX7IfvZ0ty1A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOptrUe08ekXcuppBcuJ5WVKyTOCT9rXMT9AKsWxZHSLg&oe=6AE36F07"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXUNsilK024Q7kNvwGHrRSq&_nc_oc=AdoStc6ScsXvVuaxvMAeFfOihSrSNAYBW1Q0kIUns2Du19KMM41j86ovz_wbBTBOhDg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVC7KIWn-TgBQUXCgndPEqN2xz3pMzEC10Muu0Fq8WKA&oe=6AE34C8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRCr1u8D53EQ7kNvwEh6WS6&_nc_oc=AdpSPjuYSrjk04dnoVvfcezxY-TQwBQxIi5m_wpg8yw2ijnpx-FDk81XCagx8XZx8Gw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHez7HFPxs3KzHqZlruEDtczDmobxPpL9y9mZX9MwbLw&oe=6AE33DF8"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**Free to try for 3 days.** Everything unlocked. Then one in-app purchase to keep playing. No subscription.\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe optional mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3543613075811708", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824307_3543613082478374_638908712768740982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAKu3WJ81gMQ7kNvwHqbE1Y&_nc_oc=AdoGSdY7w8y3ELKDjpXa7k0qBFXH-VelOXvbkWPs_j71A6ggcrrn1yJiwe6-P8qmMyc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFhvV7zo0SzAjCsfm8eCw1_NoFOafjls7TJwLBwI6SYQ&oe=6AE355BA"}, {"file_name": "Korean Quest Store - 2560x1440.png", "id": "2026406291329707", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823837_2026406294663040_7189430179496047163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ws-ArAAsIRQQ7kNvwG3jlQv&_nc_oc=AdrT_Auwy_R8sFaYwegOdsVFwyzZWNdQ5beoO-OmVo7xkMr3v33UMzUx963_umPdK-w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_Xkj6aO1JOHNRhB2QHgRJaTz9rZcri353DmChboJe5A&oe=6AE36950"}, {"file_name": "Korean Quest Store - 1008x1440.png", "id": "1568265651414352", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw
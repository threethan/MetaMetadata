8", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829120_1026850020403931_7659213534684975554_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Il5LkhSMRcQ7kNvwFm0X0j&_nc_oc=Adr6aEl-9cOZDho4HJk11DL3Dtw4rjI7x9_6kITwGpzON7tc5cP_2EWCCPFYmu-QG1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3grt0wyWkdXxogEqihesCSiw0CM-9CUBTFpYpmWtpMQ&oe=6AEF62A3"}]}, "id": "29828019723464449", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQAIjaS_OmkQ7kNvwGVaEt3&_nc_oc=Adr9f09MvoIMJ5krnWKgNYgA9iiinPb2dayPe0iz2upsx2e5sF-l5hq55QyHL4G548E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSReT59Vx_arqHszWt8U0IYg_k-OJXMOpPmK0ghh8rpWQ&oe=6AEF4899"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyBksYqKaZgQ7kNvwFY1Q4A&_nc_oc=AdpsKiK7BoTPLKORKOJO3MWfxVLr14z38vfjYY77guc2av09RaqvUzRtHn7yhKC1_4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz4rdj-fMAyNXelwrYpReEqfB7pE4ThQ7I_papIZVovQ&oe=6AEF4998"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aey98ld3yo0Q7kNvwGqcGex&_nc_oc=Adq_FkupuGSGoNy1dsbaao4ihGuXX_rRTXsHqD-rshodLpt9h6O_Ekvs0xAyRVQhLSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoTkJqUxxxRiaYTy5UQCYXRW2HPEMyehrkMIC6COWGgg&oe=6AEF3AD5"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P3HUaDv1VQQ7kNvwF06xPV&_nc_oc=AdoNMkknILQflAl-hxT2sPJosVd3tcPAMnh_EZaHN7TYRVc8pqRJzDb07GD-hNb6l_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBBcl85c7me4Oxs3n8aM3u5DoeKulhEIUkVtbsQU65Qg&oe=6AEF4C87"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCiDWrH6JpkQ7kNvwEmvLQv&_nc_oc=AdqkHpJYTUK9smyx8P7fuLMhhrn8ZMHDI8RE9wzZAodOFzH5rwSJowcgZMHaevifrVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmHEpKFo0CVuWqtf_EYrIcEHOa8Db4j0CB9CQw-QYcHA&oe=6AEF624D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsiItxhOKJEQ7kNvwHt8QHY&_nc_oc=AdrK1bYMd1510431hFkx3cIW2iAQwlvKJU_rawyCwgnspA6piqZWtGjKN0ELEDt9cCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE-Wncod8DBAU0tiW0y2V65XZqbnfAJy1QByYOBWsnzA&oe=6AEF53B8"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**Free to try for 3 days.** Everything unlocked. Then one in-app purchase to keep playing. No subscription.\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe optional mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3543613075811708", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_3543613082478374_638908712768740982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxpeUjKhlJ8Q7kNvwEbr6Sh&_nc_oc=Adpnmu4a70RKdRBoY9djCt1OW0jlwZBYocLIlQT7wUpWOfxf2qM6UmJGWfpsjXxoB-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT0m9Cx8RqOwgpFpN-eJxHQVxmzjcOQ9OrwiLBABsuTg&oe=6AEF333A"}, {"file_name": "Korean Quest Store - 2560x1440.png", "id": "2026406291329707", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_2026406294663040_7189430179496047163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEcNUMmcH8sQ7kNvwEZIATX&_nc_oc=Adq9nzyxdboW6km9vpv8nBp15wH7FA6ob9wm15LaflzDztno1jNTC1GZwVQMCLjrqsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE8KLVWBsv7uuNzfry0Q25-E-BV4EP4owUcSmAF1uMDQ&oe=6AEF46D0"}, {"file_name": "Korean Quest Store - 1008x1440.png", "id": "1568265651414352", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord
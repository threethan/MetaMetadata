8", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491829120_1026850020403931_7659213534684975554_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEJ2heahwUAQ7kNvwF5RIyC&_nc_oc=AdoGlkSN-GS52U9r9KJI7sBR-zC3Gj40mK8DSkB9bF2qNeJTz9PqhJ9vQZ2y_vNHGY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFkMPXnyB179lnNy6w5rF-FftlARwWGTBIt1reWMTeeQ&oe=6AE74163"}]}, "id": "29828019723464449", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ygn0DnO39wQ7kNvwGsqmqW&_nc_oc=AdpHasJu3ar0DxOxwR-bwUFu7TtwtOUrEoB9XqetoGOvpRdFOBUCGEuhaunatAl7Dfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvaxi8LaOEWYDNG_0DTlfrH1xsIYGWQBn-8GxdsDcHgA&oe=6AE75F99"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ld4s9gYFVkIQ7kNvwGkORbY&_nc_oc=AdotKllKjoJYCS7TjNFfh_E6joMLvZIkAwZptnMREu8N5nM6UQ4E9b2mWFLT4_hi4rU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSo3An8jeUSwcWjpnDjGn7Ob7tKY9q0OnMpg4RqJ4cKQ&oe=6AE76098"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKDF26qtNL0Q7kNvwH6AkxX&_nc_oc=AdrvfmCKoYyrBNwGO85ryzgRVMtTDyy4-Er5RBMB5UbHpqOgIEcLz_ZJsM-0CqYRqMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRzZfkvRRCjDbHHshEaNJZNyzjW0blFxKHLvJ89l5wVA&oe=6AE751D5"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U711en_43PcQ7kNvwHDTPY0&_nc_oc=Adq8Eqnd9cPOgCPfiEG9AAghAlszPlU4vmgJtn4XnYuKlzDvZQozCp3zQd2mM4MMtrk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSiCxrxt_jRpBG_ifB4Vs43W349Mm0PDvXvDLrcSSTow&oe=6AE76387"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sMqIVgYjMMQ7kNvwH210yk&_nc_oc=AdrOO8ZIEKwhjnG6YsPUm1ZUi9Xyqa7BHm22dsvvsidw6OnvaMXOsrvumQduHWMZwFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvEa6fGdCdG4Xz9CLfilB0xpgpLYhBARUU3K_b7QbbRA&oe=6AE7410D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2PmdffXfJkQ7kNvwFIPQSn&_nc_oc=AdoXUkTVsjKJF3S1sj7XELDOgUZFMrJqr2SS4yK_m7tveyY5Zoe_sP_tLD-08rKV2eM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmzzgpoXkdLluv_-bf0a50b6_N67GAIYYAeawYgg6GgA&oe=6AE76AB8"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**Free to try for 3 days.** Everything unlocked. Then one in-app purchase to keep playing. No subscription.\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe optional mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3543613075811708", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824307_3543613082478374_638908712768740982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L7TUT1vlF8Q7kNvwEO5nO7&_nc_oc=AdpiT-UjVUXvIg9qrw6VHDw9z2m6qYv5eQx7LTqta5MqjzLeR9ciAnzELM2chw8I-dI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLrcCmFAq_zKh6voxTvoTh_h9ZC-Jsk2p5rKsH4e1W1A&oe=6AE74A3A"}, {"file_name": "Korean Quest Store - 2560x1440.png", "id": "2026406291329707", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_2026406294663040_7189430179496047163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwsy63qzopoQ7kNvwGEkZBi&_nc_oc=AdpbjwvxLaMrBwNARwwRKRFQtvroN2lvwYjt1sPOU1yVCSLh90hjB8AaHMvvMhMDBJg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuwAKW4O5AkVXdnEBQb6ZywPXWajULE7xPDyefKaq88A&oe=6AE75DD0"}, {"file_name": "Korean Quest Store - 1008x1440.png", "id": "1568265651414352", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad
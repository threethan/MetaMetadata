_nc_sid=6e7a0a&_nc_ohc=Y6bx3gQSrjIQ7kNvwGSpOus&_nc_oc=AdrESKiqgeCV-xx1jO9bvx2y0qWY1WcgGaJOAvCG5ZFRHB5AsJj75zBPs_lwbyzlh6I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_kq5LIEAs1PlznS49EcT4hjZpTIarqV68Cu-Hel3XIQ&oe=6AC7BF87"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXrL9i16MsUQ7kNvwEhpXr5&_nc_oc=Adp25PQ2OYnTv7waCGw_TOOZB58thqYxZmE1aurMqqrG-1iXHIKCmXX_gKCukeDmJ3k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFzlLSkndCSbmRyugTfRAzsYNvja6Rq-Nbjo9kX8yPgw&oe=6AC79D0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtwXsIFD9xMQ7kNvwGwHtZE&_nc_oc=AdojDXg9jhsu-byJyLMbBO_jGsvg7xajhUF20IhGdd0WTEFoNpIz7Una9sY2uZEjA8Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9bFSHJibk_Ex8ucHKENMpkhunyVVQwek0RSp4A6ruhw&oe=6AC7C6B8"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**This isn't a golf game. It's real putting practice with your real putter and a real ball. One price, no subscription.**\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nPractice smarter. Practice anytime. **Score lower.**\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.puttervr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "SMB IT Ltd", "support_website_url": "https://www.puttervr.com/help", "website_url": "https://www.puttervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28310784865257863"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604382710_1358799899
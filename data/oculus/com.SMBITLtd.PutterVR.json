8", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491829120_1026850020403931_7659213534684975554_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3UzohKKeZ4Q7kNvwEB_dDA&_nc_oc=Adp1QEstpop6iKH6ToYv90bIeEkgQCJip3W5FYiyw3t-aLNNi78XxCpFqrBIZc7gi0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF7JBa91LQgP5QGHGUtuPMc-jwxZmiCY8EjKUS2kJ6rw&oe=6AF5C1E3"}]}, "id": "29828019723464449", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qZawAFFY8kQ7kNvwEavDkW&_nc_oc=Adok8Yci6Qe12dbcYrD3WQ9-OxpfdzsV6xNpbYUdKBsMyNHrNhM8VlU1tBIFXjsVNMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgQtN75zKlsUmwuRBYfGCrvD1-ONEga3jd5V_CzgwshQ&oe=6AF5E019"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4JiYTgnYXUQ7kNvwE1tzS6&_nc_oc=AdrEWy1SpL1D-ZO7-TaD1HkfJF9UgdZb9Tzl4IuBiABs-jBafE29anBjDW2UCzMbHCc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkQdLhjwDctaSRos-rGNdocK_V1qydhND89l4cR7r8Yg&oe=6AF5E118"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPbcLKRhGGAQ7kNvwHWA6DU&_nc_oc=AdpncG2XBoGcj48Yknnz9a9mPRFZzqPabqT1H17GiJJRklk_U00rna9Qzr1As0zskgM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkWq31sr6hZX4qOEp-ipyQK2vpSpO_Eu95p2fUnE75iw&oe=6AF5D255"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ep0Z18P2L1UQ7kNvwGfXZUL&_nc_oc=AdqCdsKKUu1gj0QKETzT-GF9whi6X8jOfG2oO2Gp8ivYmtQhxiHJdRMuPetLpJOx-vg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwDRGmVbdx0FYLueTIiUQOJXjxCMIttCeEypy8exKXUg&oe=6AF5E407"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nspgdBxXysQ7kNvwGjyase&_nc_oc=AdreERpLoE3Xp0OU9FFXZSX0VJtVJ5TDy_g1AL2Cl0cnIMz7ar_CSZmcUdjG2RlAvaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxOkVLsY3Tk8OVnkwbJqQN59w_vco8PXY_aK2ynAJyNA&oe=6AF5C18D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkWu1vx12tsQ7kNvwEBV5ex&_nc_oc=Adqap2PpZ9bMRaxpXVv4sBbAJHXgpDFWX5A-KIeNEggslyV5RipE3qjpSDe0ZMP7SXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMOTJyBx2jpoNXo200DMXhqFl4gtRuRwTFU84jpUJ92w&oe=6AF5EB38"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**Free to try for 3 days.** Everything unlocked. Then one in-app purchase to keep playing. No subscription.\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe optional mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3543613075811708", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824307_3543613082478374_638908712768740982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUSf_XZoOGkQ7kNvwGF74Kc&_nc_oc=AdrgZ2i1K06xE2k4KYj1uOFyWdNsAhzhVeU5lTpQzx3t0VvryzSgbL--iEveG4Ig-4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1db-fXAblSukAcAfigFj5m0KLFkNIAJ17upi_6zxbvA&oe=6AF5CABA"}, {"file_name": "Korean Quest Store - 2560x1440.png", "id": "2026406291329707", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_2026406294663040_7189430179496047163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDWQgZaDZ2wQ7kNvwE3Q_Jh&_nc_oc=AdqXqJKi4h_10x74U4-yMlBFU_pZdrm7MpwUN5dwLKV45QcfCVu6NT8c1I-llXM06dc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4By0DQIz6dsoF8exDnSiFP2N9Wp21N2bTJfyWEY5I_A&oe=6AF5DE50"}, {"file_name": "Korean Quest Store - 1008x1440.png", "id": "1568265651414352", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad
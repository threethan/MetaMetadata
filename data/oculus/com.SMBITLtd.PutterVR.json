8", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491829120_1026850020403931_7659213534684975554_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V0-tAMIQ9YQ7kNvwFpqIqy&_nc_oc=AdrztpBdZ6wZFOgYFE9ojJfcSS53VUkDA6I6yNYN6XL48GyPJRQaeMPp_vkxlLjBv1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvX6myH7l1d9LP7-44g3by2O2O28PCTUkrrLReTqgsfw&oe=6ACA78A3"}]}, "id": "29828019723464449", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLxCJYpCTM8Q7kNvwGeHVi5&_nc_oc=Adpchgdq2JBDUzYA0m5eojlCGfS_lvd_TCP2pqQQqAt3QluhLphrpzgK4KVdIym0b5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWBIXvXsb8ix_YG-7qfFkwKI_ulTMKRwmqNbfuH0yM6Q&oe=6ACA5E99"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85k-mjJ058cQ7kNvwEsm758&_nc_oc=AdrvZtrjFZ0bN_HoaJw56l8wpnUrAFYhLUWkLa3d1MAGxyVFxwdQw_W_rR3xw3Td340&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFiwRZV2EA-3XnOyfA2Bb_qisbWW_Pxi-c26JKjOaG-Q&oe=6ACA5F98"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNXUBsvpu44Q7kNvwEJRB17&_nc_oc=AdpFsTXZGolYemsXwtMGNswEHyPDgjLQBr5wf7ijwp4DFgSs1ZBYCJAIuspVRKSff54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPZZElK-E1v2hzJaEYVY2em5dPCDEy_aDdqgp-ISsUoQ&oe=6ACA50D5"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPZreuJ9bH0Q7kNvwHaX1FJ&_nc_oc=AdoGyc2wm4BYHF8lg86Z-tT_23ZXfs2j-JReBNpXqYBlN74Elec4sErr-pEHDLPJXok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLbZGMttAonLlilbWK2X1H1gNeOk16WgjqrZCcc36rFA&oe=6ACA6287"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfqhdI6Ii8wQ7kNvwHgtYJS&_nc_oc=AdrR3ZQRya7-mAsF2X0JzVnfjvg22YZXc3usoMKgOcjqAiq-KPK2zfPVM-lbokEfsSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMem8ARjpukLzCN00Mrh8L50KDjm6F2NRUXb32u3-XQrg&oe=6ACA784D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKN44evdiUwQ7kNvwH0VFJ0&_nc_oc=AdqNgf1I7nOdB_87IKAxpbrqi74GwV9ywjyUv00A_zF9cZtEgm61JW6MCtkgc-T-OMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIyMdFNalTFvzSHrllpRAnOatAJZlUC-YBlalPWWsJkQ&oe=6ACA69B8"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**Free to try for 3 days.** Everything unlocked. Then one in-app purchase to keep playing. No subscription.\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe optional mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3543613075811708", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_3543613082478374_638908712768740982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJmz2J5Q9dcQ7kNvwGjoNBM&_nc_oc=AdrCzhryfeFouxGyalxwjdv-WysZWnsvHO3sebMckq4VB2iZ2FG_sMHSK1DQRTjRUWc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGKLj1CxIqBePRdFR6mU4_txrElVohj0FNVD1HIph0wQ&oe=6ACA493A"}, {"file_name": "Korean Quest Store - 2560x1440.png", "id": "2026406291329707", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_2026406294663040_7189430179496047163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bv2bvd00pbsQ7kNvwGMsPoi&_nc_oc=AdoMSeO68BFuNCdBM9qPhqQo_GAlCrj-bPrD0PuVOVu7F3pu3ZQR_e6wn9Ur2bhJEw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTtxWfIBfn1o__hMLkVuVqQcifNePq3adg7cBa-0M2qw&oe=6ACA5CD0"}, {"file_name": "Korean Quest Store - 1008x1440.png", "id": "1568265651414352", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord
_nc_sid=6e7a0a&_nc_ohc=Y6bx3gQSrjIQ7kNvwFMnDeB&_nc_oc=AdqgqmrvJ__RdYRLQ7qn3HOtdDmZqhLPawIXlVQpEKXhyF0WDrP4n6aTVdVkahZopq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlCEmcG0PISieQEP5cwXf6S10jnYVVbcIX76oAbiOQgA&oe=6AC66E07"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXrL9i16MsUQ7kNvwEtBttM&_nc_oc=AdqTipNeenHyDVxrIkkTPG2G0XjC-E6MlPhrwzuKBY2eue1d5VzQVNAvhSzH5iqrRRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPNL_4SPiQwrd7WF4DkWewZ3RINUoJM0vLmFn34TWKIw&oe=6AC64B8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtwXsIFD9xMQ7kNvwE2v3qT&_nc_oc=AdoSmW9_SsL42gxwVUHUu0j1aqNGIE00Jb1CAMWOnkvtdwz5XIFxIqKWaLaJdyhPojw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORbzGTdR87c_96iiZbZCTizmSPe8NfSEbtrVyQiIyOKw&oe=6AC67538"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**This isn't a golf game. It's real putting practice with your real putter and a real ball. One price, no subscription.**\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nPractice smarter. Practice anytime. **Score lower.**\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.puttervr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "SMB IT Ltd", "support_website_url": "https://www.puttervr.com/help", "website_url": "https://www.puttervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28310784865257863"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604382710_1358799899
n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kIfQkSp370Q7kNvwHVgRDY&_nc_oc=Adq6keIjRJMnb6GpGQ4mw4Qi2JROOZbh42zONMsnpTasjQ1nWUuZ-BqLe1b5wMI5wtg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJDWQa3b8La_werDetAMhLLF7dDPoscyomIkn6RuFpbg&oe=6AB3F618"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5WFxDWQxq8Q7kNvwH3FWdq&_nc_oc=Adq1RLlOuX0WigM7Vq9R1YhkHIOmzymJn9y0FTmTCQ39vpvEIzhNVMyEWVEEj4ekgWk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpynb3PXi3_SDbldzazcj8AFuRdu-wIKyeaMgRkvKxQw&oe=6AB3E755"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVvBjDtsoRUQ7kNvwFm-J2Z&_nc_oc=Ador0RBK7mlr8o6W0eh1ttWht_688dmatJEmCh-jXZusndlgUc3IK_eixeo7kzghszU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ_nnCLEBgURsc2UbZ_lr_a9Ana2-sFPS4lpVXfMJGvA&oe=6AB3C0C7"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLQTxICLA7MQ7kNvwHW0S1j&_nc_oc=AdpdIxOUDfySxGeOq6_WDkCpVO5emmge2Tucyx1hAm7AgDLzisSKBoLSIHlt8hXnAqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGmpBKHvFLeJJqlBsJC_MlEQbSI_1pdn4XIZh9QpBO7w&oe=6AB3D68D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNA4rP-8krsQ7kNvwFbKjYm&_nc_oc=Adp1o0BzjlOpL6LzIOZblSJZP6A6bxWFThrf3YVv-IOg6d-SUzUMlUE7O_ZgLmS7-eI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO8w74CWFkY5cR5vt900M4Yd01j2Hz4JMKMDi_MfmWew&oe=6AB3C7F8"}, "display_name": "PutterVR", "keywords": [], "long_description": "# Lower Your Scores From Your Living Room\n\n  **This isn't mini golf. This isn't arcade putting. This is real practice with your real putter.**\n\n  Attach the PutterVR mount to your putter, slide in your controller, and train with the same grip, weight, and muscle\n  memory you take to the course.\n\n  **Three ways to play:**\n  - Launch Monitor: putt a real ball. We read its true speed and line off the face, then roll it out across the virtual\n  green. Requires a putting mat or similar surface.\n  - Mixed Reality: putt a virtual ball with your real putter while still seeing your room and your feet. *Requires PutterVR Mount\n  - Virtual Reality: full immersion. *Requires PutterVR Mount\n\n  **Build Your Own Putting Studio**  Arrange floating panels around your green: live stats, your stroke profile, even YouTube. Grab them, move\n  them, resize them. Your lab, your layout.\n\n  **Physics you can trust.** Built from tens of thousands of real ball data points, with authentic skid, roll, break,\n  and lip-outs. Dial in stimp to match your course.\n\n  **Tour-level analytics.** Face angle, path, smash factor, impact heat maps, miss patterns. In-headset, on web,\n  or mobile.\n\n  **Every training aid built in.** Putting arc, alignment laser, tempo line and metronome, putting mirror, tee gates.\n\n  **Drills with a purpose.** Distance control, start line, aim, setup, and pressure putting. No weather delays, no tee\n  times.\n\n  Practice smarter. Practice anytime. **Score lower.**\n\n  Questions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "This isn't mini golf. This is real practice with your real putter.\n\nMount your controller on your putter and train with the grip and muscle memory you use on the course. Putt a real ball (Launch Monitor), a virtual ball in mixed reality, or go full VR. Authentic physics with adjustable stimp. Tour-level analytics: face angle, smash factor, heat maps. Training aids and drills built in. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.puttervr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "SMB IT Ltd", "support_website_url": "https://www.puttervr.com/help", "website_url": "https://www.puttervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27321987374137622"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3331715627026387"}, {"status": "PUBLISHED", "id": "838372362243370"}]}, "baseline_offer": {"id": "3331715627026387"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787336460, "status": "PUBLISHED", "id": "3331715627026387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27816534714682883", "version": "0.1.49"}, "id": "1107690551447869", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24782806838055701", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27816534714682883"}, "release_status":
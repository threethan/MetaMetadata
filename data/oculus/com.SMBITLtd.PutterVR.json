8", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491829120_1026850020403931_7659213534684975554_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PhHdAIUPksQ7kNvwGfloJz&_nc_oc=AdpVf6DajhXvQVrkogkZSyofFt6qytAsYFqh1aN0n0seLdDnqKKtsYOSU_tbnSCUB-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUfSmRvep1H8X5_o3Mlcbyi1GJuisPxYlvUsZZvvWk9w&oe=6ADF5863"}]}, "id": "29828019723464449", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eHYquLi_DkQ7kNvwGBw0PK&_nc_oc=AdrrXDeW2gAkCNE_RyTfVGO6zmNYzmJG-GGlQd2Ed9djxfH436JRUOCHcRyto7s9ps4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhdFcSEJ78bd7f5b45fFm-oVrM3Pguw0n7trksvjCOhg&oe=6ADF7699"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eRRC-5W4DEQ7kNvwFXWDl0&_nc_oc=Adphr63mCCdUQ6UuU8eGGORKHm8uDebOFUaroXmkIinMH2HxihGIRNEi0_QzlscDm-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnzM2n5Uh8LdFIWSIV24QUd9Rd8WlgqzX6R4AzHcsTwQ&oe=6ADF7798"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAtByDndD1MQ7kNvwE_ICQI&_nc_oc=AdoclqPvM_cMhnV6oPl8TeHQFWUtHraY8OtNKx41Bfs6EfOz6V0MhCKagsjbNfTx6r0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNCY5BzEGgMqIXArENlOkgprkKOfzIaJG41e57kkcLkw&oe=6ADF68D5"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZuP90v9yuUQ7kNvwF5hhtK&_nc_oc=AdpyX19xsoRBJWa-FzC3mA1vhFjIe5sF-bjObMyteomhilMbBoa_PVm8hgFxEHzuayo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkXMeMKIvhg7kCnJvglus9nIZRoAT1gyfo0RDAfQ2MBQ&oe=6ADF7A87"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPWPf6_A7FIQ7kNvwHLI90z&_nc_oc=AdriHp_E0jwbyyaQOrdoOIiUVOJJB3527tjtZLsR-UQpUDgVpRZfy4-8WAJSXP-rojs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzNKKJDsyu_4CxDm24am2T7GxAr03HQNYH46s_76oJzQ&oe=6ADF580D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ui1tGqUe5kQ7kNvwF7-uEG&_nc_oc=AdqiSYJ194grpfIMhrawZx2BEtAnPityjk4bRxLv0HA8Sd0g46StvTcTmM8iMfkpztI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0-n7msb6099fpXSVJ32XVFdURLQ4O5uUAwJydVxWtsw&oe=6ADF4978"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**Free to try for 3 days.** Everything unlocked. Then one in-app purchase to keep playing. No subscription.\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe optional mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3543613075811708", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_3543613082478374_638908712768740982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VK6h3O2PTTQQ7kNvwEjgxWM&_nc_oc=AdqkpXYUJapiHi02QPeLkrXUguKoIrWNQX5GxXDEN60MxgH0ZUCsOlzmdTBlw_dT00k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvMxVNTz06FmZTM9er7gbrwR1OXPT-J3vat9oD6RS0Zw&oe=6ADF613A"}, {"file_name": "Korean Quest Store - 2560x1440.png", "id": "2026406291329707", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_2026406294663040_7189430179496047163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSha92Zia_QQ7kNvwHnfJoD&_nc_oc=AdoKal09ahfBZb63WRjmvz-V_vtoaJvUjyVz4X_AlImPGGy6h-EU6SIOmlBE72gm4SI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8HUPJihk_ZXqUZGuuihRJdJcrxeWAZN1AoI1FIQ5sqQ&oe=6ADF74D0"}, {"file_name": "Korean Quest Store - 1008x1440.png", "id": "1568265651414352", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord
8", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491829120_1026850020403931_7659213534684975554_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEJ2heahwUAQ7kNvwGxoe9Y&_nc_oc=AdogwJWDeTe4APAvU7bmk-aYBE7F3zX39OFffVZdI50Igu_xBq1ZUdWDeurJR_thjbY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1FUH2BY-c3wO60bczuEtDcZEtXrlnn-rAVYwgqAo3QA&oe=6AE892E3"}]}, "id": "29828019723464449", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ygn0DnO39wQ7kNvwG3lkqM&_nc_oc=AdpR0EvpIYVHAOVdSqzpq1zq_g1izLXmA7h3eT4xaLflatE948Z9ghFtMUhj6PeLVE8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjPwi2RgW0pePB6vNIz7-cKugDychUE0pLT7cas1kFzQ&oe=6AE8B119"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ld4s9gYFVkIQ7kNvwG76rZj&_nc_oc=AdoMXa1XfOszFJCS_PamAOXKWjEvjs0w8sdMOZxMcGwDI2obc9VBgjFW9aG_ZYqUhac&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-dy4Aulim8hljvqn0NOaJKiIuhVdMdRsPfsjqGu47ng&oe=6AE8B218"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKDF26qtNL0Q7kNvwFOWR4e&_nc_oc=Adpkfs2LThdkqZuoAZgb4kk07LYxGEMSnNPO9u708jRFFiSKUfkSRRqsPcGZrN0ufeM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSbO4vn7kP3yPsKUForNI20MUxw1x4VUwawSXeCni2Yw&oe=6AE8A355"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTIZqzk0x7UQ7kNvwGmRlAz&_nc_oc=AdrbFI30RhZgd-dTg2N-zWv2g5x95fA_AXHNWxZ42GW3saVvZzcLWDY2U3RK_i6-4N4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4EmscrLn--MGqqM5cCKoGPdCdWAeabv3SjDokT41h4Q&oe=6AE8B507"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y803Ts0LBAwQ7kNvwG61ray&_nc_oc=AdolH-G32VSgFt_-7NAXRSu3BgnQ0R7Q8G81TcvTCX0qkNgyZS3ROjMd8PL6LLLQ2-w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeMLShh-nFiw3SRBI6HY3_VObklFObP23-kftTgEDL7Q&oe=6AE8928D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVWl1tN_lSEQ7kNvwFfGoDV&_nc_oc=AdoiF1U5e2GGWxguTkWfery2Ptn94efcJTCV87wtFay5zUnziXH9HYh7rXFtZRbHvBM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw6L3Yvcj1hFQ43pw8WYFSq6Z9dh--RakO5X-uV7llbA&oe=6AE8BC38"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**Free to try for 3 days.** Everything unlocked. Then one in-app purchase to keep playing. No subscription.\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe optional mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3543613075811708", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824307_3543613082478374_638908712768740982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L7TUT1vlF8Q7kNvwH3JlC7&_nc_oc=AdrRSy6KzmVChnZm80GxhLpdxm71M2mN4s4XTXprcUCmW1HZWuN7OnleUUrP-JhYtZQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyAkEXFdcbewjC8mB2xWQXA1kYTYfbFdA5ERrzCE5ahQ&oe=6AE89BBA"}, {"file_name": "Korean Quest Store - 2560x1440.png", "id": "2026406291329707", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823837_2026406294663040_7189430179496047163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwsy63qzopoQ7kNvwEHwJ-V&_nc_oc=Ado4H4KTl7W1whwO-kzuKl9fpkOrtD4Rl6JwKL5OJoN22E4qO2jiTz6EEuucZvfULgM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS12M87gyrShPFTvFynjI9cRee9KJuUvJ0WpwABva4EeA&oe=6AE8AF50"}, {"file_name": "Korean Quest Store - 1008x1440.png", "id": "1568265651414352", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga
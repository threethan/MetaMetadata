le_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6PWeQGLzMIQ7kNvwE2gNwy&_nc_oc=AdrYj0fJqTy5LXP4o2DRQ8jVMTFfLH5kBH6nNr7C-Z3Qk7fwzxkTQ7M2jU1We2LfehQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaqxHd4rEhBD0FttdfYCPU4iCzDIN8Htj-Qz8wM8w1RA&oe=6AC27599"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNf4DZTBWZ0Q7kNvwEIk_uD&_nc_oc=AdqypHP-vpl9Md2YkHwz-7KkzHVKYGoe_KcI7Cq0nzODcoBDfZkU3rAJW18QdtW3NtE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaPPNufsYbPmJufkqyOqNEbiRK9v9nXl-QS5vSVRZD_g&oe=6AC27698"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cy3cCHNfO40Q7kNvwFZW-Ju&_nc_oc=Adow9Yma8LjSX8v5p7bmotLR6vnwgwoEz9M3Jcylp__EMuktAgkgrsxhuPGqhvPHhsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7pwnyT7m3l_I78_jQZ_TRR68aa-qNE3X4B7Tprb374w&oe=6AC267D5"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnWdw5APEYwQ7kNvwG_6RBM&_nc_oc=AdrsmLQxMLYgCAz2aezvXQIWDvDQYiR9QEFcyB81Y7wz4zhNzB2-U9RGzENH7hQOly8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP904LUFZFykNBjCwkqXhr6EfuZ5HOJ3775OoERO6Sjuw&oe=6AC27987"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h67VlRQbnKkQ7kNvwHYez5d&_nc_oc=AdqJFLntb9rl9kuEBvptnvru6ZVfJ1Xvn6WwzibMc3o800IEZAhbFw_Pw6NyiFBxNZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjon52Pick5DRvUqjrsIQn09ZSBBPmysNlmxjSPf3I_w&oe=6AC2570D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HjdPDdiLZcQ7kNvwFgYuu6&_nc_oc=Adr8JVNTaDppc-FHBBes9eSfrxq-6bP9CgFRnZ8sUlBn99-pX5zwEtLpIGjyGx1CmxA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqn5umBeaGd54gHi5cZU5JBkYq9QAv0aOPfVEn3ygxBQ&oe=6AC280B8"}, "display_name": "PutterVR", "keywords": [], "long_description": "# Lower Your Scores From Your Living Room\n\n  **This isn't mini golf. This isn't arcade putting. This is real practice with your real putter.**\n\n  Attach the PutterVR mount to your putter, slide in your controller, and train with the same grip, weight, and muscle\n  memory you take to the course.\n\n  **Three ways to play:**\n  - Launch Monitor: putt a real ball. We read its true speed and line off the face, then roll it out across the virtual\n  green. Requires a putting mat or similar surface.\n  - Mixed Reality: putt a virtual ball with your real putter while still seeing your room and your feet. *Requires PutterVR Mount\n  - Virtual Reality: full immersion. *Requires PutterVR Mount\n\n  **Build Your Own Putting Studio**  Arrange floating panels around your green: live stats, your stroke profile, even YouTube. Grab them, move\n  them, resize them. Your lab, your layout.\n\n  **Physics you can trust.** Built from tens of thousands of real ball data points, with authentic skid, roll, break,\n  and lip-outs. Dial in stimp to match your course.\n\n  **Tour-level analytics.** Face angle, path, smash factor, impact heat maps, miss patterns. In-headset, on web,\n  or mobile.\n\n  **Every training aid built in.** Putting arc, alignment laser, tempo line and metronome, putting mirror, tee gates.\n\n  **Drills with a purpose.** Distance control, start line, aim, setup, and pressure putting. No weather delays, no tee\n  times.\n\n  Practice smarter. Practice anytime. **Score lower.**\n\n  Questions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "This isn't mini golf. This is real practice with your real putter.\n\nMount your controller on your putter and train with the grip and muscle memory you use on the course. Putt a real ball (Launch Monitor), a virtual ball in mixed reality, or go full VR. Authentic physics with adjustable stimp. Tour-level analytics: face angle, smash factor, heat maps. Training aids and drills built in. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.puttervr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "SMB IT Ltd", "support_website_url": "https://www.puttervr.com/help", "website_url": "https://www.puttervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27321987374137622"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2114305533303882"}, {"status": "PUBLISHED", "id": "3331715627026387"}, {"status": "PUBLISHED", "id": "838372362243370"}]}, "baseline_offer": {"id": "2114305533303882"}, "is_approved": true, "fir
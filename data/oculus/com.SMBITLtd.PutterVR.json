8", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491829120_1026850020403931_7659213534684975554_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ae_r4pb8vcsQ7kNvwFzFrdO&_nc_oc=Adr46uTgBTj37f3yUW8P3oBMivW0D62LcnMIWbAVP7rlHS28H_dWVuShOLD4GHt0bqg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf1RuameIaBIdy03YMebBOcMOrykyGOK9BLdHqXYALgQ&oe=6AEC8763"}]}, "id": "29828019723464449", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqhP8_rKuE0Q7kNvwHJmcZb&_nc_oc=AdrJBTC-mdNQXdz1yNZEZWKZJLGY_7h-Aa72PkQdGr_BGZAtRuireYemNy1PsvfO91w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSQTM8y5yTgWujAjUL8qL0gORtBJta5H56F8KMPgOwSQ&oe=6AECA599"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu6k9zLtLYQQ7kNvwEi0PLh&_nc_oc=AdrDYe2fyMUMEwt1C2gL2hhc6bIjpL_dwIYfg9fZtLAtbtxNDw7E3GBzLd7ZM8jKafY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3_27qHiOWlM7GmDdKyu9rwH7hrfGiDAc64anLbQHJlw&oe=6AECA698"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8syMi-_YU4Q7kNvwHLtaUx&_nc_oc=AdqwqnQAZ0rkJ_QAVnxUN7BxtiJyjoczu58BTAVrxDssuu5m0qFweIqjRODMfNN81oA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzCpx7I6yZYjFRwt8_CkXEcT6osUS0-VOs__wxQY0pCQ&oe=6AEC97D5"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P3HUaDv1VQQ7kNvwFYc2Pe&_nc_oc=AdqWpZRSFo5WnKRaRYI-n-JgdYQ4e-S1NdXO_u44Zk5YZ-fp4KolRHCXQrwypvJIehI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL81FxsuuaszWG1DAqWSxoAdOqiLK_8vhwbvIQdHPGDQ&oe=6AECA987"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEbGeDbPIcoQ7kNvwHKExN7&_nc_oc=AdpI8I2rB5X_dF8kJ9DD2nboOwNWOpgKK2CI78GIilh2mBQLXFEQcd4wIHPvtNAwfaI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJg7jTzf-l3ZVk2y7O6weHwtw8hfXWJ7-OkTzvP5Yr_A&oe=6AEC870D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTD6j0cjeUAQ7kNvwHsgNd-&_nc_oc=AdrAzAVZEgd88RE3I9SxC6uib2oVYkGWa9y9GD2zbDyuEMr8XcP4KhevXDpeDRmjz68&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8fQw1-4lB6k1-nY60jRRdtSh4z5W3juxZPoF_SjgSVw&oe=6AECB0B8"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**Free to try for 3 days.** Everything unlocked. Then one in-app purchase to keep playing. No subscription.\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe optional mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3543613075811708", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824307_3543613082478374_638908712768740982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGRyftQsxwwQ7kNvwFYj5Im&_nc_oc=AdpV3fhIqltBuOCbZ9guE2yXUKpIFGYBkutxjhpxC1eBMNokz5kvIxwkkwoYkUNijfU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-og0tTZQ3_2U6kKBWbVHpUVwVTH9eypZirj7LdbNmwg&oe=6AEC903A"}, {"file_name": "Korean Quest Store - 2560x1440.png", "id": "2026406291329707", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823837_2026406294663040_7189430179496047163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nX0PxcxOOLAQ7kNvwG3C1UA&_nc_oc=AdrwZBuBHoGCeQeA1frPLtRbHd0YjSUJUPGWNTvU4oDkc6b4vgJ7TndlCpvEwMYu88Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8tjPPyh1bAK2I2n1R_3JznXWcYtSEKvnUW6tbgiHJUw&oe=6AECA3D0"}, {"file_name": "Korean Quest Store - 1008x1440.png", "id": "1568265651414352", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga
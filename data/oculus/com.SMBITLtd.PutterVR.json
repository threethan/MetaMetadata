8", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491829120_1026850020403931_7659213534684975554_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wxvg2bSEcFEQ7kNvwH7QUUW&_nc_oc=AdrPtuU8Oa2gLbmjg5RRaTEB4UjKfl_XlrXCkRTHAFn0JPzStlqpx2AKPP7hqsjy-dA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4DZpAYlxGBkXdLmreqwoMa7WlXMnXli_JoQdpFnsx3w&oe=6AF35723"}]}, "id": "29828019723464449", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWMxnkQthbMQ7kNvwF5GjaA&_nc_oc=Ado-ekHfoZS_ZvJ2Rn88JiBM7AjiO6C8bH8Ec1k_HU6ngoyso4342mioZhk8yJ8IB5w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHD8yVhNecJIGCEjA8GN10r6MThr2UzQm54HNLx-qc7w&oe=6AF33D19"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hpl7wtfBgP4Q7kNvwGPtZv7&_nc_oc=AdqIf6qcyhXtDg11jA_nKx3ANJ2jCKU90dO9cVR9w3WPIeB2Gyrh0ZHb4kuoG7go6CY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMB4rIUOrbfrbkCzY6dQCm-kJVR3tMUNrPuxnIhjcpSQ&oe=6AF33E18"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPbcLKRhGGAQ7kNvwEP53u5&_nc_oc=AdoEBbwxmddMwhG6jYSkX0m-HG2fwVtSXz2P60e2xxKOsFNbpckI5eHV709pm8fgVRI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRtHiD0e9sDkpsXWz0Y2LQcaEAUHIoydR83TG7Vv5tcQ&oe=6AF32F55"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cKEXVKJwd0Q7kNvwGTNNR7&_nc_oc=AdrkyK04HC8PiGaboaXenOiIO6QeMgcUoal6UdtTROUjDfrBvc-CgMYXktl32lzxdsg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5qqV8uRMzQTdBZaTpWYGF50nTaJCZmFWbsKU2Ssy9PA&oe=6AF34107"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nspgdBxXysQ7kNvwFebtqO&_nc_oc=AdpV7Wp0Qm_pP7TcTFCOFZOoK-z-YaSNiHqVKZ3akHaBVXiuvdi-Z5FDFULo2HohW3Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSigfMx_1Zgayisy04ba2_zp9YSmLb4N1faCo78nxiDIA&oe=6AF356CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsiItxhOKJEQ7kNvwGlhEv-&_nc_oc=AdqNSJbcdXcDIVLh-G_uuW0bEBs06iLB9qoThQPDUv8q6oJICjhmcMbAz4OLWbjbzRA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREJsnEjNoY0xTHTBOM9QUHz37DvJtfP5mXIREVrqYfmQ&oe=6AF34838"}, "display_name": "PutterVR", "keywords": ["golf"], "long_description": "# Lower Your Scores From Your Living Room\n**Free to try for 3 days.** Everything unlocked. Then one in-app purchase to keep playing. No subscription.\n\n**Three ways to play:**\n- **Launch Monitor:** putt a real ball - we read its true speed and line, then roll it out on a replica green with real break. Nothing to attach. Requires a putting mat or similar surface.\n- **Mixed Reality:** putt a virtual ball while still seeing your room and your feet (optional mount).\n- **Virtual Reality:** full immersion (optional mount).\n\nThe optional mount puts your controller on your own putter so the stroke is measured too.\n\n**Drills with a purpose.** Distance control, start line, aim, setup, pressure putting.\n\n**Championship courses.** 72 replica holes on greens from the courses the pros compete on every week.\n\n**Physics you can trust.** Tens of thousands of real ball data points - authentic skid, roll, break, and lip-outs. Dial in stimp to match your course.\n\n**Tour-level analytics.** Ball speed, line and miss patterns. Add the mount for face angle, path, tempo, smash factor and impact heat maps. In-headset, web, or mobile.\n\n**Every training aid built in.** Putting arc, alignment laser, tempo line, metronome, putting mirror, tee gates.\n\n**Play a friend.** 1v1 rounds and mini games over ranked multiplayer.\n\n**One price.** No pass, no season ticket, no renewals.\n\nQuestions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "Real putter, real ball, every stroke measured. Putting practice on Meta Quest 3 with no subscription."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "3543613075811708", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824307_3543613082478374_638908712768740982_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vHCBFhMqrIQ7kNvwHeGbDP&_nc_oc=AdqB38fhbc14Q3UiVBIgFJ0Mw-_AVmBI9UWhiSttrgxddwgTxtgyb1M6yo-q7GXct_c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ-Ifi7DKiI3AUE_J6Y2RDTCLZQOMxwwxz9aIR8YcNsA&oe=6AF327BA"}, {"file_name": "Korean Quest Store - 2560x1440.png", "id": "2026406291329707", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_2026406294663040_7189430179496047163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYqOOLNRixoQ7kNvwEcgQZb&_nc_oc=AdpgMX1VUyijitEQbymjdg0jI0__rOukEH3qhdHhm5rCGxuj8eYx1hpJMXLtHoxJ_8o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_YERyBfnD2e2_jKKt5Jq6eYR10FpVNBB_30UziJXR3w&oe=6AF33B50"}, {"file_name": "Korean Quest Store - 1008x1440.png", "id": "1568265651414352", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea
g&_nc_oc=Adpcgn-9O4adTWeXLQbnX9DmaPQCfUELccXQeUvAIn-6GaRvoSCJCDy9mbmItP3mPWM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcKtG-I49UV7Fqf2A6Q24cAroB_xDfZFQ8CwIdGfnaHg&oe=6B072357"}, {"file_name": "Screenshot 4.png", "id": "1259480407251360", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_1259480410584693_4340026904576949903_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaWKO4mgQSIQ7kNvwFCyPDz&_nc_oc=AdpaqG6LgMBLjdmB45jJoDfAhysIpAKG_TZ92g4giftmRmR8RVG1inZ33c-NtIbBRkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKHh8jdiiUFPxycBjkXXhTM2sAxEgx2Dm6v3UkAu9qTA&oe=6B06F7AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Korean Quest Store - 2560x1440.png", "id": "1079416331193405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_1079416334526738_1625900530289992129_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UClmwyDBo50Q7kNvwGJCFQL&_nc_oc=AdpbG7faYZd1rV9s8seuEFbaaUfaLo2-ytReGUu1Uc_yGaS_VxruYZ1Q0KPwcV9UW4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUzqh-ztgsAkWtod-1-xFCHyFiDK91waFeE0uzVypZ7g&oe=6B0728D4"}, "display_name": "PutterVR", "keywords": ["Golf"], "long_description": "# \uac70\uc2e4\uc5d0\uc11c \uc2a4\ucf54\uc5b4\ub97c \uc904\uc774\uc138\uc694\n\n**\uc774\uac74 \ubbf8\ub2c8 \uace8\ud504\uac00 \uc544\ub2d9\ub2c8\ub2e4. \uc2e4\uc81c \ud37c\ud130\ub85c \ud558\ub294 \uc9c4\uc9dc \ud37c\ud305 \uc5f0\uc2b5\uc785\ub2c8\ub2e4.**\n\nPutterVR \ub9c8\uc6b4\ud2b8\ub97c \uc7a5\ucc29\ud558\uace0 \ucee8\ud2b8\ub864\ub7ec\ub97c \ub07c\uc6b0\uae30\ub9cc \ud558\uba74 \ub429\ub2c8\ub2e4. \uc2e4\uc81c \ucf54\uc2a4\uc5d0\uc11c \uc0ac\uc6a9\ud558\ub294 \uac83\uacfc \uac19\uc740 \uadf8\ub9bd, \ubb34\uac8c\uac10, \uadfc\uc721 \uae30\uc5b5\uc73c\ub85c \uc5f0\uc2b5\ud558\uc138\uc694.\n\n**3\uac00\uc9c0 \ud50c\ub808\uc774 \ubc29\uc2dd:**\n\n* **\ub860\uce58 \ubaa8\ub2c8\ud130:** \uc2e4\uc81c \uacf5\uc744 \ud37c\ud305\ud558\uba74 \uacf5\uc758 \uc2e4\uc81c \uc18d\ub3c4\uc640 \ucd9c\ubc1c \ubc29\ud5a5\uc744 \uce21\uc815\ud574 \uac00\uc0c1 \uadf8\ub9b0\uc5d0\uc11c \uc774\ud6c4\uc758 \uad6c\ub984\uc744 \uc7ac\ud604\ud569\ub2c8\ub2e4. \ud37c\ud305 \ub9e4\ud2b8 \ub610\ub294 \uc774\uc640 \uc720\uc0ac\ud55c \uc801\ud569\ud55c \ud45c\uba74\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.\n* **\ud63c\ud569 \ud604\uc2e4(MR):** \uc790\uc2e0\uc758 \ubc29\uacfc \ubc1c\uc744 \uadf8\ub300\ub85c \ubcf4\uba74\uc11c \uac00\uc0c1 \uacf5\uc744 \ud37c\ud305\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.*\n* **\uac00\uc0c1 \ud604\uc2e4(VR):** \uc644\uc804\ud788 \ubab0\uc785\ub41c \ud658\uacbd\uc5d0\uc11c \ud37c\ud305\uc744 \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.*\n\n*PutterVR \ub9c8\uc6b4\ud2b8\uac00 \ud544\uc694\ud569\ub2c8\ub2e4\n\n**\ubaa9\uc801\uc774 \ubd84\uba85\ud55c \ub4dc\ub9b4.** \uac70\ub9ac \uc870\uc808, \uc2a4\ud0c0\ud2b8 \ub77c\uc778, \uc5d0\uc774\ubc0d, \uc14b\uc5c5, \uc555\ubc15 \uc0c1\ud669 \ud37c\ud305\uae4c\uc9c0. \ub0a0\uc528\ub97c \uac71\uc815\ud560 \ud544\uc694\ub3c4, \ud2f0\ud0c0\uc784\uc744 \uc608\uc57d\ud560 \ud544\uc694\ub3c4 \uc5c6\uc2b5\ub2c8\ub2e4.\n\n**\ucc54\ud53c\uc5b8\uc2ed \ucf54\uc2a4.** \ud504\ub85c \uc120\uc218\ub4e4\uc774 \uc2e4\uc81c\ub85c \uacbd\uae30\ud558\ub294 \uc138\uacc4\uc801\uc778 \ucf54\uc2a4\uc758 \uadf8\ub9b0\uc744 \uc815\ubc00\ud558\uac8c \uc7ac\ud604\ud588\uc2b5\ub2c8\ub2e4.\n\n**\ubbff\uc744 \uc218 \uc788\ub294 \ubb3c\ub9ac \uc2dc\ubbac\ub808\uc774\uc158.** \uc218\ub9cc \uac1c\uc758 \uc2e4\uc81c \uace8\ud504\uacf5 \ub370\uc774\ud130 \ud3ec\uc778\ud2b8\ub97c \uae30\ubc18\uc73c\ub85c \uac1c\ubc1c\ub418\uc5b4 \uc2a4\ud0a4\ub4dc, \ub864, \ube0c\ub808\uc774\ud06c, \ub9bd\uc544\uc6c3\uae4c\uc9c0 \uc0ac\uc2e4\uc801\uc73c\ub85c \uc7ac\ud604\ud569\ub2c8\ub2e4. \uc2a4\ud300\ud504 \uac12\uc744 \uc870\uc808\ud574 \uc2e4\uc81c \ud50c\ub808\uc774\ud558\ub294 \ucf54\uc2a4\uc758 \uadf8\ub9b0 \uc2a4\ud53c\ub4dc\uc5d0 \ub9de\ucd9c \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4.\n\n**\ud22c\uc5b4 \uc218\uc900\uc758 \ubd84\uc11d \uae30\ub2a5.** \ud398\uc774\uc2a4 \uc575\uae00, \ud328\uc2a4, \uc2a4\ub9e4\uc2dc \ud329\ud130, \uc784\ud329\ud2b8 \ud788\ud2b8\ub9f5, \ubbf8\uc2a4 \ud328\ud134\uae4c\uc9c0 \ubd84\uc11d\ud569\ub2c8\ub2e4. \ud5e4\ub4dc\uc14b\uc740 \ubb3c\ub860 \uc6f9\uacfc \ubaa8\ubc14\uc77c\uc5d0\uc11c\ub3c4 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**\ud544\uc694\ud55c \ud37c\ud305 \uc5f0\uc2b5 \ub3c4\uad6c\ub97c \ubaa8\ub450 \ub0b4\uc7a5.** \ud37c\ud305 \uc544\ud06c, \uc5bc\ub77c\uc778\uba3c\ud2b8 \ub808\uc774\uc800, \ud15c\ud3ec \ub77c\uc778, \uba54\ud2b8\ub85c\ub188, \ud37c\ud305 \ubbf8\ub7ec, \ud2f0 \uac8c\uc774\ud2b8\uae4c\uc9c0 \ubaa8\ub450 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**\ub098\ub9cc\uc758 \ud37c\ud305 \uc2a4\ud29c\ub514\uc624\ub97c \ub9cc\ub4e4\uc5b4 \ubcf4\uc138\uc694.** \uadf8\ub9b0 \uc8fc\ubcc0\uc5d0 \ud50c\ub85c\ud305 \ud328\ub110\uc744 \uc790\uc720\ub86d\uac8c \ubc30\uce58\ud574 \uc2e4\uc2dc\uac04 \ud1b5\uacc4, \uc2a4\ud2b8\ub85c\ud06c \ud504\ub85c\ud30c\uc77c, \uc2ec\uc9c0\uc5b4 YouTube\uae4c\uc9c0 \ud45c\uc2dc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc6d0\ud558\ub294 \uc704\uce58\ub85c \uc62e\uae30\uace0 \ud06c\uae30\ub3c4 \uc790\uc720\ub86d\uac8c \uc870\uc808\ud558\uc138\uc694. \ub098\ub9cc\uc758 \ud37c\ud305 \ub7a9, \ub098\ub9cc\uc758 \ub808\uc774\uc544\uc6c3.\n\n\ub354 \uc2a4\ub9c8\ud2b8\ud558\uac8c \uc5f0\uc2b5\ud558\uc138\uc694. \uc5b8\uc81c\ub4e0 \uc5f0\uc2b5\ud558\uc138\uc694. **\uc2a4\ucf54\uc5b4\ub97c \uc904\uc774\uc138\uc694.**\n\n\uc9c8\ubb38\uc774 \uc788\uc73c\uc2e0\uac00\uc694? \uac1c\ubc1c\ud300\uacfc \uc9c1\uc811 \ub300\ud654\ud558\uc138\uc694:\nhttps://discord.gg/2SbUnnpCfx\n", "short_description": "\uc774\uac74 \ubbf8\ub2c8 \uace8\ud504\uac00 \uc544\ub2d9\ub2c8\ub2e4. **\uc2e4\uc81c \ud37c\ud130\uc640 \uc2e4\uc81c \uacf5\uc73c\ub85c \ud558\ub294 \uc9c4\uc9dc \ud37c\ud305 \uc5f0\uc2b5\uc785\ub2c8\ub2e4.**\n\n\ucee8\ud2b8\ub864\ub7ec\ub97c \ud37c\ud130\uc5d0 \uc7a5\ucc29\ud558\uace0, \ucf54\uc2a4\uc5d0\uc11c \uc0ac\uc6a9\ud558\ub294 \uac83\uacfc \uac19\uc740 \uadf8\ub9bd\uacfc \ubab8\uc5d0 \uc775\ud78c \uac10\uac01\uc73c\ub85c \uc5f0\uc2b5\ud558\uc138\uc694. \uc2e4\uc81c \uacf5\uc744 \ud37c\ud305\ud558\ub294 **\ub860\uce58 \ubaa8\ub2c8\ud130**, \ubc29\uacfc \ubc1c\uc744 \uadf8\ub300\ub85c \ubcf4\uba74\uc11c \uac00\uc0c1 \uacf5\uc744 \ud37c\ud305\ud558\ub294 **\ud63c\ud569 \ud604\uc2e4(MR)**, \uadf8\ub9ac\uace0 \uc644\uc804 \ubab0\uc785\ud615 **VR**\uae4c\uc9c0 \uc9c0\uc6d0\ud569\ub2c8\ub2e4.\n\n\uc2a4\ud300\ud504 \uac12\uc744 \uc870\uc808\ud560 \uc218 \uc788\ub294 \uc0ac\uc2e4\uc801\uc778 \ubb3c\ub9ac \uc2dc\ubbac\ub808\uc774\uc158. **\ud22c\uc5b4 \uc218\uc900\uc758 \ubd84\uc11d \uae30\ub2a5**\uc73c\ub85c \ud398\uc774\uc2a4 \uc575\uae00, \uc2a4\ub9e4\uc2dc \ud329\ud130, \ud788\ud2b8\ub9f5 \ub4f1\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub2e4\uc591\ud55c \ud37c\ud305 \uc5f0\uc2b5 \ub3c4\uad6c\uc640 \ub4dc\ub9b4\ub3c4 \ubaa8\ub450 \ub0b4\uc7a5\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.\n"}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "1819930735853332", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823790_1819930739186665_6518385713734299827_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWHMrxLXkRkQ7kNvwEEWkyE&_nc_oc=AdovCJkjOhu2NpXmlgQ-I9XJloj-weNAcv6pMpXPUGDs0Y8jU6IeESBMskc3a1GFg3Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrnSsq5nE1WT9FMbnknbhtMp3fqgNoAENxVJgxl4wRcA&oe=6B070072"}, {"file_name": "1440x1440 copy.png", "id": "1562860888710796", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1562860892044129_5807699606677943488_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ib01hhuGWAQ7kNvwFkf-t1&_nc_oc=AdpPQnK8kklyc4zYInRG160v9WjduKViOMhxJ93HBvb4UjVhV8S6mvkwfkNintpFSMU&_nc_zt=3&_nc_ht=scontent-iad6-1.o
le_name": "Screenshot 3 (2).png", "id": "1576570460793613", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823949_1576570464126946_1137156280080557780_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EbCzfcEmj0Q7kNvwEfhVyk&_nc_oc=Adqfj8ttL9ABLx4gX8o5tRChJkc3zv5_azi3ANqeVXNDOgU26ZwJFe7L_GFl9VzHwas&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP14XVX0HopL6uNLocbj2FSTYTgMhPZ8c3nkPDJ2SkWxA&oe=6AC90D19"}, {"file_name": "Screenshot 2.png", "id": "1044018491538923", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825305_1044018494872256_7425265315948924184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojJ9yaVdUeYQ7kNvwEpFUNK&_nc_oc=AdqQSFzE2xgrrtBX_lMgORzp_w8KgNz-vcZyx5QgXtA3BukahRCnA-Py1BNt19HDXbk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGuL0wEqDtDpQkqrp8QxEQ0k-LpsZC1ZWmD5_eFZFkcA&oe=6AC90E18"}, {"file_name": "Screenshot 1.png", "id": "1279763534180908", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822723_1279763537514241_9087544449346647909_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNXUBsvpu44Q7kNvwHnQMiK&_nc_oc=Adrj-pGzpfBytWN1E6cVubmRTMrV-Rsani4xnIMGcAXj58ZSI-fPCIYcM52ii8s5Y1I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNpH9iQ3Be03teE1Dseda1IP-3_s4UsqwHqlOLbZ9erw&oe=6AC8FF55"}, {"file_name": "Screenshot 6.png", "id": "2011346012989071", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820980_2011346016322404_297963131427731231_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPZreuJ9bH0Q7kNvwFx3-Cs&_nc_oc=AdpPxiZjTt67PtzZDyrWaDAKpEKdNK4jQ7BM8yU-Mj1RdwkqPTsLoXe2LL5HaoSHu2k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX7NTI3cEoIdrAZ2Xoh_96sBmHzZ0rgNYlB8N9VxDjPQ&oe=6AC91107"}, {"file_name": "Screenshot 4.png", "id": "1512781303346635", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305050_1512781306679968_8311265691607344888_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfqhdI6Ii8wQ7kNvwHtfPWJ&_nc_oc=AdpPoZ5ZdTXzsg6B310T6pSRuFydacmbO8NKDvQ45A9ODqmeUKa0_e33HCflW_DDqMU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnEXeiuCWfjbe2apLhiCPAySVyM8wS5nTD5t6k9cfkHg&oe=6AC8EE8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 copy.png", "id": "4351475101785831", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828038_4351475105119164_1853464437308931599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKN44evdiUwQ7kNvwFvn3u8&_nc_oc=AdoZXuKUmyGC78X4gi1bwSGpsW6HlKu5JXho_jlUKi69cd5LcSyHav1kJ5pTvkE4LnI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_0DynA7WFB56jdr5uUAgqp4-yhbs9gc9SFZ1lBX615w&oe=6AC91838"}, "display_name": "PutterVR", "keywords": [], "long_description": "# Lower Your Scores From Your Living Room\n\n  **This isn't mini golf. This isn't arcade putting. This is real practice with your real putter.**\n\n  Attach the PutterVR mount to your putter, slide in your controller, and train with the same grip, weight, and muscle\n  memory you take to the course.\n\n  **Three ways to play:**\n  - Launch Monitor: putt a real ball. We read its true speed and line off the face, then roll it out across the virtual\n  green. Requires a putting mat or similar surface.\n  - Mixed Reality: putt a virtual ball with your real putter while still seeing your room and your feet. *Requires PutterVR Mount\n  - Virtual Reality: full immersion. *Requires PutterVR Mount\n\n  **Build Your Own Putting Studio**  Arrange floating panels around your green: live stats, your stroke profile, even YouTube. Grab them, move\n  them, resize them. Your lab, your layout.\n\n  **Physics you can trust.** Built from tens of thousands of real ball data points, with authentic skid, roll, break,\n  and lip-outs. Dial in stimp to match your course.\n\n  **Tour-level analytics.** Face angle, path, smash factor, impact heat maps, miss patterns. In-headset, on web,\n  or mobile.\n\n  **Every training aid built in.** Putting arc, alignment laser, tempo line and metronome, putting mirror, tee gates.\n\n  **Drills with a purpose.** Distance control, start line, aim, setup, and pressure putting. No weather delays, no tee\n  times.\n\n  Practice smarter. Practice anytime. **Score lower.**\n\n  Questions? Chat with the dev team: https://discord.gg/2SbUnnpCfx", "short_description": "This isn't mini golf. This is real practice with your real putter.\n\nMount your controller on your putter and train with the grip and muscle memory you use on the course. Putt a real ball (Launch Monitor), a virtual ball in mixed reality, or go full VR. Authentic physics with adjustable stimp. Tour-level analytics: face angle, smash factor, heat maps. Training aids and drills built in. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.puttervr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "SMB IT Ltd", "support_website_url": "https://www.puttervr.com/help", "website_url": "https://www.puttervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27321987374137622"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2114305533303882"}, {"status": "PUBLISHED", "id": "3331715627026387"}, {"status": "PUBLISHED", "id": "838372362243370"}]}, "baseline_offer": {"id": "2114305533303882"}, "is_approved": true, "fir
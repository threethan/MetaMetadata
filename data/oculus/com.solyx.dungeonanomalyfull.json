25/491822550_667371066439074_1019075240074852173_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwPRXnelzdUQ7kNvwFQKP-0&_nc_oc=AdrwEIbr664jHAcmk9xWPu-v8nkCjsDIwVtycK_gf6E6izUXMTHFhpM6rEcN-IUyDP0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56dF5a1sGjJ6p3hdTbMw4ArVQAwm1Q6xQxSBl5ZWpfkw&oe=6A145308"}, {"file_name": "mirrorPalace.png", "id": "752903201224847", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823395_752903204558180_590872009293111077_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMzU1E17AvwQ7kNvwEHNsjO&_nc_oc=AdrGuHEQDppBVEnTfxBCa6r2t1N32fJDXRj-klZnuZkzMXq6T-E6L_ISwIethfEIEyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X8g2pfpxNfHz9de4JDjJ7q3CGf9xKqJF9mWPoneKWww&oe=6A143FAE"}, {"file_name": "monster.png", "id": "1413746300254440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_1413746306921106_5706779719149838312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPJXaZyy3KwQ7kNvwEY4IWh&_nc_oc=Adq6ap3wuNzCam1nMPvZzH45NmQL1zUglzSx7yAdwMw0wUtrDcAY-rNO3uAvvL8Sm7I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KEt4zg3o5LkpybfM64Er9znh0CXysbBjBcgr_VwzrIQ&oe=6A144245"}, {"file_name": "book.png", "id": "2986905345033756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307303_2986905348367089_8169033680678113212_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_imc7zAOnZkQ7kNvwGnUTDx&_nc_oc=Adpdx-dJ82HfMVR6V2AVKM6ew2K5BDZcRLqn-xcU0rbWe8HM-paFa6a2su-sz_kmcY4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tnWbzVUXxi5ulanZD2dWzzATQHxNyKKg__IaN_QiY2A&oe=6A144FBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dungeon Anomaly", "keywords": ["puzzle", "horror", "dungeon", "indie", "psychological"], "long_description": "# \ud83c\udff0 Dungeon Anomaly\n\n## \ud83d\udc7b **Think You Notice Everything?**\n\nStep into a dark and ever-changing dungeon built entirely for VR. Each time you enter a room, something might be different.\n\nA missing object.\nA strange movement.\nA subtle shift in the environment.\n\nYour job is simple: observe carefully, detect anomalies, and report what changed.\n\nMiss too many\u2026 and the dungeon wins.\n\n## **\ud83c\udfae What You\u2019ll Do**\n- Explore detailed dungeon rooms in immersive VR\n- Memorize layouts and spot subtle changes\n- Identify visual, environmental, and interactive anomalies\n- Make the right call before moving forward\n\n## **\ud83e\udde0 Designed to Test Your Focus**\n\nDungeon Anomaly is built around observation and tension. The changes are sometimes obvious\u2026 sometimes barely noticeable.\n\nDid that statue move?\nWas that torch always flickering like that?\nIs something watching you?\n\nThe dungeon doesn\u2019t rush you.\nIt waits for you to doubt yourself.\n\n## **\ud83d\udd01 Replayable & Unpredictable**\n- Randomized anomaly system\n- Increasing difficulty\n- Growing tension the deeper you go\n\nEach session feels slightly different, keeping you on edge every time you play.", "short_description": "Think you notice everything? Step into a VR dungeon where each time you enter, something might be different. A missing object. A strange movement. A subtle shift. Carefully observe every room, detect anomalies, and escape before the dungeon traps you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dungeonanomaly/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Solyx Studio", "support_website_url": null, "website_url": "https://solyxstudio.wixsite.com/solyxstudio", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "rec
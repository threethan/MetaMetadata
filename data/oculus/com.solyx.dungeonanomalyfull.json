25/491822550_667371066439074_1019075240074852173_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYN4NpgqCbIQ7kNvwFo_eWB&_nc_oc=AdoyZy2NtysPnJwfP9y0IscQWAeg5Yox4uJ9j5YBTthLpIdT55JeRESmGjxBQww_MyI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u629l-bevMledEniBRH3vMCGxjJYeGkBSL7JqF1u0iw&oe=6A09C708"}, {"file_name": "mirrorPalace.png", "id": "752903201224847", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823395_752903204558180_590872009293111077_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkXC8YXvkK8Q7kNvwFXf0Dw&_nc_oc=AdqR4r5haoFmAtYx_WmOl5kwvhQGVRCbt89WQWJgIjMLJ0L-BK-ZEKrvISnzWK08de4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lRWiiw0ND6jr1qcdHgIgurS9GdVbFdiTFBGZ8wdIp7A&oe=6A09B3AE"}, {"file_name": "monster.png", "id": "1413746300254440", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491825481_1413746306921106_5706779719149838312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WACc3h2A0kQQ7kNvwHp-obj&_nc_oc=AdojSSG2bwGtj_RWF7Z_Ux2fZO4ZbMfawVlEtCMlzIOCZNl1MhTJ3qsFDrdN9k56rC8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af432-9v6yIGt0CEMekWokfR_7hYZLbt0GEBT7OjxxgcPw&oe=6A09B645"}, {"file_name": "book.png", "id": "2986905345033756", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499307303_2986905348367089_8169033680678113212_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InRr04v6-sMQ7kNvwHoM1TQ&_nc_oc=AdpfM-SPwrCocyzKHj3fSiD-dE7-FoIvGanoAjMUSUa39VHUgfYAJVVE8oaKrVmStl4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lR_q7xo_vp_AjAXTjpy-guijjUnccT6cQYfyi4OcgFw&oe=6A09C3BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dungeon Anomaly", "keywords": ["puzzle", "horror", "dungeon", "indie", "psychological"], "long_description": "# \ud83c\udff0 Dungeon Anomaly\n\n## \ud83d\udc7b **Think You Notice Everything?**\n\nStep into a dark and ever-changing dungeon built entirely for VR. Each time you enter a room, something might be different.\n\nA missing object.\nA strange movement.\nA subtle shift in the environment.\n\nYour job is simple: observe carefully, detect anomalies, and report what changed.\n\nMiss too many\u2026 and the dungeon wins.\n\n## **\ud83c\udfae What You\u2019ll Do**\n- Explore detailed dungeon rooms in immersive VR\n- Memorize layouts and spot subtle changes\n- Identify visual, environmental, and interactive anomalies\n- Make the right call before moving forward\n\n## **\ud83e\udde0 Designed to Test Your Focus**\n\nDungeon Anomaly is built around observation and tension. The changes are sometimes obvious\u2026 sometimes barely noticeable.\n\nDid that statue move?\nWas that torch always flickering like that?\nIs something watching you?\n\nThe dungeon doesn\u2019t rush you.\nIt waits for you to doubt yourself.\n\n## **\ud83d\udd01 Replayable & Unpredictable**\n- Randomized anomaly system\n- Increasing difficulty\n- Growing tension the deeper you go\n\nEach session feels slightly different, keeping you on edge every time you play.", "short_description": "Think you notice everything? Step into a VR dungeon where each time you enter, something might be different. A missing object. A strange movement. A subtle shift. Carefully observe every room, detect anomalies, and escape before the dungeon traps you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dungeonanomaly/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Solyx Studio", "support_website_url": null, "website_url": "https://solyxstudio.wixsite.com/solyxstudio", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "rec
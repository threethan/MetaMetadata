25/491822550_667371066439074_1019075240074852173_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYN4NpgqCbIQ7kNvwE7SBC-&_nc_oc=Adrss0q2nolCe867IloG7uqpSIfRfG3kMdO3au9tDACdaKKTck4U9oIOukS_1IV2otw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nxlForovp-clwl9nlYgW1pnEa4F2ccNc4m32xr69FfA&oe=6A0B1888"}, {"file_name": "mirrorPalace.png", "id": "752903201224847", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823395_752903204558180_590872009293111077_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtgrU8hd6N8Q7kNvwE5KEBc&_nc_oc=AdqA7qV1eL1CE5n3yHOuvhb3QNLWG5NHAvDHa3iAz7_43bYctOUaih2WNpQUHsyAHPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4niAkl-xtYOCjpo1AbdxImuRS-rKeD-PQsD8b_65imSg&oe=6A0B052E"}, {"file_name": "monster.png", "id": "1413746300254440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825481_1413746306921106_5706779719149838312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WACc3h2A0kQQ7kNvwGmr1lt&_nc_oc=AdqO5e26vFP0tRvdSbhoA2ZpOShWWMGctCAkLyujL-lIWRyXiDEI32TlZtOPT02wtEo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vajhND2Kd52vG_f9Wyp6NMXCXZZ8vE2_7YIR3jHABgQ&oe=6A0B07C5"}, {"file_name": "book.png", "id": "2986905345033756", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307303_2986905348367089_8169033680678113212_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeFwxwxstdcQ7kNvwGcDGqD&_nc_oc=Adog-AF5auOT_TscFecH77aSY1hJBKolk2lclMvytBPS3cTGNSKH6E_OSJoInYJ4VWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59cb3sa2qP35N1MToEaQNBm7FhcHy2dOfG5Dtz5JmTVw&oe=6A0B153E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dungeon Anomaly", "keywords": ["puzzle", "horror", "dungeon", "indie", "psychological"], "long_description": "# \ud83c\udff0 Dungeon Anomaly\n\n## \ud83d\udc7b **Think You Notice Everything?**\n\nStep into a dark and ever-changing dungeon built entirely for VR. Each time you enter a room, something might be different.\n\nA missing object.\nA strange movement.\nA subtle shift in the environment.\n\nYour job is simple: observe carefully, detect anomalies, and report what changed.\n\nMiss too many\u2026 and the dungeon wins.\n\n## **\ud83c\udfae What You\u2019ll Do**\n- Explore detailed dungeon rooms in immersive VR\n- Memorize layouts and spot subtle changes\n- Identify visual, environmental, and interactive anomalies\n- Make the right call before moving forward\n\n## **\ud83e\udde0 Designed to Test Your Focus**\n\nDungeon Anomaly is built around observation and tension. The changes are sometimes obvious\u2026 sometimes barely noticeable.\n\nDid that statue move?\nWas that torch always flickering like that?\nIs something watching you?\n\nThe dungeon doesn\u2019t rush you.\nIt waits for you to doubt yourself.\n\n## **\ud83d\udd01 Replayable & Unpredictable**\n- Randomized anomaly system\n- Increasing difficulty\n- Growing tension the deeper you go\n\nEach session feels slightly different, keeping you on edge every time you play.", "short_description": "Think you notice everything? Step into a VR dungeon where each time you enter, something might be different. A missing object. A strange movement. A subtle shift. Carefully observe every room, detect anomalies, and escape before the dungeon traps you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dungeonanomaly/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Solyx Studio", "support_website_url": null, "website_url": "https://solyxstudio.wixsite.com/solyxstudio", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "rec
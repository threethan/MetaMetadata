25/491822550_667371066439074_1019075240074852173_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxX1bymBdkcQ7kNvwHUpO-Y&_nc_oc=Adq4klL5C0fCN69A6AhCal1cu3uQCB9X1lUcBQ9aPFZ4XCAQr2XcKfCLVbj1YLG-oVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21wd4KVZ_Rx9aJ4b5rsCMg_xLEp85xrWZCeCb40zuJKg&oe=69DA5108"}, {"file_name": "mirrorPalace.png", "id": "752903201224847", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823395_752903204558180_590872009293111077_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3QVXBZa6SYQ7kNvwFCJarx&_nc_oc=AdobWxb34TCBPeuB6s5F8qCPgEwMfg_XfzV_6oxNAxofEyBJxFQ3ZRg4O-0eHujaFF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tR2SELMoVC07_8VGITc2H7bR4NzqtU5MQLRqX69SADg&oe=69DA3DAE"}, {"file_name": "monster.png", "id": "1413746300254440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825481_1413746306921106_5706779719149838312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlP7clc-EWIQ7kNvwEqpMYm&_nc_oc=AdpxORZlj6hAzPT9o7KHkxSoMJQA_H0iikJAuYZH-xdEzhrt8XRLic0Z5d6j7ErzLYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kS4UaJ4VTPe5D--a3PDgAD1V1woSG9PTDHtIutVhlHA&oe=69DA4045"}, {"file_name": "book.png", "id": "2986905345033756", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307303_2986905348367089_8169033680678113212_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFoySq8_rmgQ7kNvwFw58CU&_nc_oc=Adqo0qcWjUdiAUaSkHIbmgBmj6IZKVnquhFOF_j330LWaRFwiqDAy-h7a2BjzgRun08&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2O54sfbe7H-J7vUd2rnvEYJM_jaGSphoW1GZDOdRxd8w&oe=69DA4DBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dungeon Anomaly", "keywords": ["puzzle", "horror", "dungeon", "indie", "psychological"], "long_description": "# \ud83c\udff0 Dungeon Anomaly\n\n## \ud83d\udc7b **Think You Notice Everything?**\n\nStep into a dark and ever-changing dungeon built entirely for VR. Each time you enter a room, something might be different.\n\nA missing object.\nA strange movement.\nA subtle shift in the environment.\n\nYour job is simple: observe carefully, detect anomalies, and report what changed.\n\nMiss too many\u2026 and the dungeon wins.\n\n## **\ud83c\udfae What You\u2019ll Do**\n- Explore detailed dungeon rooms in immersive VR\n- Memorize layouts and spot subtle changes\n- Identify visual, environmental, and interactive anomalies\n- Make the right call before moving forward\n\n## **\ud83e\udde0 Designed to Test Your Focus**\n\nDungeon Anomaly is built around observation and tension. The changes are sometimes obvious\u2026 sometimes barely noticeable.\n\nDid that statue move?\nWas that torch always flickering like that?\nIs something watching you?\n\nThe dungeon doesn\u2019t rush you.\nIt waits for you to doubt yourself.\n\n## **\ud83d\udd01 Replayable & Unpredictable**\n- Randomized anomaly system\n- Increasing difficulty\n- Growing tension the deeper you go\n\nEach session feels slightly different, keeping you on edge every time you play.", "short_description": "Think you notice everything? Step into a VR dungeon where each time you enter, something might be different. A missing object. A strange movement. A subtle shift. Carefully observe every room, detect anomalies, and escape before the dungeon traps you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dungeonanomaly/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Solyx Studio", "support_website_url": null, "website_url": "https://solyxstudio.wixsite.com/solyxstudio", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "rec
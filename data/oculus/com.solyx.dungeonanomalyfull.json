25/491822550_667371066439074_1019075240074852173_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTev6re95xsQ7kNvwG-Pv8-&_nc_oc=AdoGDTEJOEdhEXrThieAjpYBLxkk3Q98wrH-ycdlx8nXZ3sXL51B1FMOkRM-0L5y10Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w2q1VrSjwEj2zssGer1efLNGdz9XsxbAr0Pc9aykWWg&oe=6A33F708"}, {"file_name": "mirrorPalace.png", "id": "752903201224847", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823395_752903204558180_590872009293111077_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2rK-tpfozYQ7kNvwFSetsH&_nc_oc=AdpLlKxWzTYknjmCrsSrVNAjAueRpBsjJl09p2XgQqwIB3X2i5RRuQgMSS06-7HESrg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TTOeiLMdOGkcjghJISfvLbiAPT1m5MYkpzqAHfkfSdA&oe=6A341BEE"}, {"file_name": "monster.png", "id": "1413746300254440", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825481_1413746306921106_5706779719149838312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEAgzTuHVtUQ7kNvwHcTU57&_nc_oc=Adq1FamFsNNvdtVbNntKwjVAQvYwVV2NXDqThTgXn1KPbqIqUX0fEtfGlNE6m5AZHRc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CQHc6sceYhFoLt-fgboPbXsMPPZkE82cWpDpatkVYPA&oe=6A341E85"}, {"file_name": "book.png", "id": "2986905345033756", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307303_2986905348367089_8169033680678113212_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQ1jzh1r_5YQ7kNvwGklPue&_nc_oc=Ado6rLc1K2r-idu2qkAUbefogbOqt_gSp5zom1TIX-bM59pBqyPmr9Z4ZmhqrLYIuuM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rUz08FYSrzYqT4uJctzr_RnhFAz25LveY2T3r3nAmVw&oe=6A33F3BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dungeon Anomaly", "keywords": ["puzzle", "horror", "dungeon", "indie", "psychological"], "long_description": "# \ud83c\udff0 Dungeon Anomaly\n\n## \ud83d\udc7b **Think You Notice Everything?**\n\nStep into a dark and ever-changing dungeon built entirely for VR. Each time you enter a room, something might be different.\n\nA missing object.\nA strange movement.\nA subtle shift in the environment.\n\nYour job is simple: observe carefully, detect anomalies, and report what changed.\n\nMiss too many\u2026 and the dungeon wins.\n\n## **\ud83c\udfae What You\u2019ll Do**\n- Explore detailed dungeon rooms in immersive VR\n- Memorize layouts and spot subtle changes\n- Identify visual, environmental, and interactive anomalies\n- Make the right call before moving forward\n\n## **\ud83e\udde0 Designed to Test Your Focus**\n\nDungeon Anomaly is built around observation and tension. The changes are sometimes obvious\u2026 sometimes barely noticeable.\n\nDid that statue move?\nWas that torch always flickering like that?\nIs something watching you?\n\nThe dungeon doesn\u2019t rush you.\nIt waits for you to doubt yourself.\n\n## **\ud83d\udd01 Replayable & Unpredictable**\n- Randomized anomaly system\n- Increasing difficulty\n- Growing tension the deeper you go\n\nEach session feels slightly different, keeping you on edge every time you play.", "short_description": "Think you notice everything? Step into a VR dungeon where each time you enter, something might be different. A missing object. A strange movement. A subtle shift. Carefully observe every room, detect anomalies, and escape before the dungeon traps you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dungeonanomaly/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Solyx Studio", "support_website_url": null, "website_url": "https://solyxstudio.wixsite.com/solyxstudio", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "rec
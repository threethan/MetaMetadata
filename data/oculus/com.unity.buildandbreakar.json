1_467976939292284_6389625638941771409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-UMH0AOz-8Q7kNvwGCHS2J&_nc_oc=AdlrAFMZ8kvdwNzEqFUzMS4NfuMRuaOq-2KhdlCUS3KOAcDytG_cgMb2lCxlEnO47us&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftMieh83UbZKtc4CBtIf_FUafaHPTL7C3sZ2WnKCBEuWg&oe=699D825B"}]}, "id": "1402922514016522", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "3925390104342594", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974725_3925390107675927_2132985269572016553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7549pAabUYMQ7kNvwG7fWKj&_nc_oc=AdnVVWI2RZsIF1lDofaGu41JnEAjDTRMbOptj6epm0Nml4GRC03YjirK7pgMW_EJg5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afssu6jj4Aemgv1Syh39QeC_TCDw5J7qbIsvUDPECh4i4A&oe=699D9ED5"}, {"file_name": "Screen2.png", "id": "624912899866792", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569462_624912903200125_95369952828978215_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaZnrfGvBUIQ7kNvwEh_ZBj&_nc_oc=Adn9G8v33JSEBwSKIRZZpjDpukTpj0lMs_LsOsoeBHgTpCbiqM_iybR83od8PV5n4q0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfspAU91NtR_br-kdwS_sOdg2Yx_Dkl_a5rIawqrSi4v1Q&oe=699DA180"}, {"file_name": "Screen3.png", "id": "506470952446683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036657_506470955780016_4872182285021721507_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlrtT_kk1HIQ7kNvwFmNKOW&_nc_oc=AdnIBdHiA_V5Qr7-EsfnKopshTCR5z71o7ysdBzTnz9rqgBA-nBV_q1qcHuvCDAcCEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuXeql24c_swxJmtgpyoopWL2zmbT5CWtFhQQn9HleScQ&oe=699DA991"}, {"file_name": "Screen4.png", "id": "1239971060392714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1239971063726047_7232279423978251415_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdCKV1EcRJ4Q7kNvwHrVcxw&_nc_oc=Adk55caVNrZS15XLkiM17ar8YwurgbMRAMppdN9CCwrK0XDM0cMvf-bv6YukDhcpITM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftH1UG8G65bnotnX54LoGhhSp9IaUpOtZnly2ijZlOi_Q&oe=699DB37A"}, {"file_name": "Screen5.png", "id": "589088577422664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035332_589088580755997_2176872060444948541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JhKqiduhoEQ7kNvwH8QuOp&_nc_oc=Adn5gdCNW3_BHWdtip44rjxDefKYwUJrXCaIzxUlPVuo8LJhnCLErR1qULZn6cp-C-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuQRvHNxVajj8OKQ2gETNUWnMpjjnUeeaFQS5c6pvDVUw&oe=699D9D58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "474919925634542", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57574726_474919928967875_1437500233645283217_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuZPZpd9hEYQ7kNvwHDd3-g&_nc_oc=Admf-gAlEYpCqXmmiGx_SHPwSNJKo67ckLXdzeEC_Twp5n9JdHdWfnQXLr-UxiQnheg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv3NXiGR7EOKpYpq0L6GBRn-rRSfISjOJdWoM4Cpsh1DQ&oe=699D8340"}, "display_name": "Build and Break AR", "keywords": ["build", "break", "ar", "brick", "creative"], "long_description": "Ah, dear reader, gather close, for I shall regale thee with a tale most grand, a tale of ingenuity, of architecture, of digital dreams born anew! Imagine, if you will, a realm wherein one's very hands become the instruments of creation and destruction, a veritable ballet of fingers, bricks, and unrestrained mirth. Such is the splendor of Build and Break AR!\n\nNow, a confession, one born of humility and slight bemusement. The title, Build and Break AR, ought, by the stern hand of technicality, to bear the moniker Build and Break MR, for it is Mixed Reality of which the game is made. Yet, lo, the fluid poetry of \"AR\" held sway! For who among us would choose a term clunkier than a one-legged horse over the honeyed elegance of AR? This artistic liberty stands as a testament to the whimsical soul of its creator (who is, yes, myself).\n\nAnd yet, dear audience, this humble creator finds himself in a slight financial bind. So I shall conclude with an entreaty most heartfelt: Build and Break AR is not merely a game, it is a labor of love, a beacon of joy for all who dare grasp it. \n\nAnywho, buy my game, please, so my wife doesn't have to work anymore.\n\nYours in brick and jest,\nDoubtNot", "short_description": "Build countless creations using stylized bricks within your own space using your hands with the Augmented Reality version of Build and Break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27892870223693285"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2344503585944854"}, {"status": "PUBLISHED", "id": "614513811635058"}, {"status": "PUBLISHED", "id": "9166807863445084"}, {"status": "PUBLISHED", "id": "626141523129451"}, {"status": "PUBLISHED", "id": "1269918260880475"}]}, "baseline_offer": {"id": "2344503585944854"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749273480, "status": "PUBLISHED", "id": "2344503585944854"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29053481977632098", "version": "1.1.53"}, "
1_467976939292284_6389625638941771409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgrtifLbQ5MQ7kNvwGjAh5E&_nc_oc=Adp55HvuWCUWmvetiILwUoJ3OvDE0NrBeo0OrK67Ulydhvv_wXgL11ETs6DM-Z_o32A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3LCddxxO2z70C16kHyLPxHNpRxu5iAf9jJcnp8-h8YNQ&oe=69F0C91B"}]}, "id": "1402922514016522", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "3925390104342594", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974725_3925390107675927_2132985269572016553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc0rTBSezUwQ7kNvwF_LSTy&_nc_oc=AdpHz1pN2Cs3-tMQzc65JL7jcFn2wFYUs2eozfiM8Sf03WXorwMAf8rnWYCfZlNwoDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af12uzJ9WIXmnN8bS-jsp2zlhw0vAdwwdEnCzS5MHCLuxQ&oe=69F0AD55"}, {"file_name": "Screen2.png", "id": "624912899866792", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569462_624912903200125_95369952828978215_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sI1uQyPUbKwQ7kNvwE4eRuS&_nc_oc=Adoar7ktafli7KM7fAdD50JVi536qQLLQ9zGC5X0NfoaCEtMeHhgFrG7o7EeL5fd4wU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3px2GiISo2HNRFWT410IVQuH7HzUM9YYHvepJTJrgfOw&oe=69F0B000"}, {"file_name": "Screen3.png", "id": "506470952446683", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036657_506470955780016_4872182285021721507_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1sYFK7rJKgQ7kNvwHagROT&_nc_oc=AdqFCyH4JCWEYNWmfluLvUnhSrnCCgGYN2IM326erYMPStVq4vWEL-DXzmyI2qK7nko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af11QwhfN5tYAydwwvD0AHMU7Vtnv_RL-TUQR1MMe5XLJg&oe=69F0B811"}, {"file_name": "Screen4.png", "id": "1239971060392714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974512_1239971063726047_7232279423978251415_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaUnMtEIFQ4Q7kNvwFRt9Qq&_nc_oc=AdrdXiYjIUcPzTpKHfKQm1xZJUfJAmJK0TUe405sEBaHSkP2wJ1Si3YOQA4NagElEuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0ut-gWiw7bnReTtCIjkPxkUMcY4JSSgaAQ0uh6WAtaBw&oe=69F0C1FA"}, {"file_name": "Screen5.png", "id": "589088577422664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035332_589088580755997_2176872060444948541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_BUSZUrBqEQ7kNvwFB1t2i&_nc_oc=AdqCKPlSv2LNUG0SGPpw8K5IBobpxUexLABQ5y7Sosn-tGwuXeTKrPgr7jAYnCiIHjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2ewu45xLfyShol6KEVNEx56TndBW-MkepP6gHgaBWzvA&oe=69F0ABD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "474919925634542", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57574726_474919928967875_1437500233645283217_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNcdBikPhJkQ7kNvwGV8uNv&_nc_oc=Adp-8wPbD-krEmdkX_PFdI9hIoscUEw0CZA6a9mbx542ng_QS0a_6VqLjSzeX5SrZxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1CsJhdX-boAXFSMeVOpYM_tv-eZBTKnFx-5T9K1upffw&oe=69F0CA00"}, "display_name": "Build and Break AR", "keywords": ["build", "break", "ar", "brick", "creative"], "long_description": "Ah, dear reader, gather close, for I shall regale thee with a tale most grand, a tale of ingenuity, of architecture, of digital dreams born anew! Imagine, if you will, a realm wherein one's very hands become the instruments of creation and destruction, a veritable ballet of fingers, bricks, and unrestrained mirth. Such is the splendor of Build and Break AR!\n\nNow, a confession, one born of humility and slight bemusement. The title, Build and Break AR, ought, by the stern hand of technicality, to bear the moniker Build and Break MR, for it is Mixed Reality of which the game is made. Yet, lo, the fluid poetry of \"AR\" held sway! For who among us would choose a term clunkier than a one-legged horse over the honeyed elegance of AR? This artistic liberty stands as a testament to the whimsical soul of its creator (who is, yes, myself).\n\nAnd yet, dear audience, this humble creator finds himself in a slight financial bind. So I shall conclude with an entreaty most heartfelt: Build and Break AR is not merely a game, it is a labor of love, a beacon of joy for all who dare grasp it. \n\nAnywho, buy my game, please, so my wife doesn't have to work anymore.\n\nYours in brick and jest,\nDoubtNot", "short_description": "Build countless creations using stylized bricks within your own space using your hands with the Augmented Reality version of Build and Break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27892870223693285"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2344503585944854"}, {"status": "PUBLISHED", "id": "614513811635058"}, {"status": "PUBLISHED", "id": "9166807863445084"}, {"status": "PUBLISHED", "id": "626141523129451"}, {"status": "PUBLISHED", "id": "1269918260880475"}]}, "baseline_offer": {"id": "2344503585944854"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749273480, "status": "PUBLISHED", "id": "2344503585944854"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29053481977632098", "version": "1.1.53"}, "
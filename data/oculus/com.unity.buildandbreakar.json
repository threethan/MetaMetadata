": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75608441_467976939292284_6389625638941771409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbnlT_A3xhkQ7kNvwF7rMnv&_nc_oc=AdoBrAMRmVpjyzMuwWjLxS2EzFNr2qS53ou5xCsub6PnHW6yjkc-p16hAyTDdt6omnc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpIMdFck4KKeJCk4oVTE3JdNyAN3nDnDNynmUekUuj3w&oe=6AA95B1B"}]}, "id": "1402922514016522", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "3925390104342594", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974725_3925390107675927_2132985269572016553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmNrT2ET9IIQ7kNvwGqAlSC&_nc_oc=AdrWWYxZaCw0lovJSZZyWQU1PcAAqj1ZAXJJoja3s8t79AZNsMGaowWi8sXXCOtwUHo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITJMrD-yrUmdbHWPgCtQ9dGj7lFc-IyO7QXhpIEbY7Fw&oe=6AA93F55"}, {"file_name": "Screen2.png", "id": "624912899866792", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57569462_624912903200125_95369952828978215_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPyI2pBaBMwQ7kNvwGInpmp&_nc_oc=AdqzDWWEUIDn61u1PQ4BZvy8F0uv7imTU1xDF28OSQektan5eKhvvxIYjTHzwv6yROk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOWVC6k8y4v3kOZ-nzvK-LOi3BwjHR8YKnumGynCSaYA&oe=6AA94200"}, {"file_name": "Screen3.png", "id": "506470952446683", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036657_506470955780016_4872182285021721507_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgvsi6OL9WAQ7kNvwGcYWFJ&_nc_oc=AdqbsWprNoqyZcizexR5_cNfZouNmzi0z335fVDxxXll73f0uYlarMlBSIXaVaugW_U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdBfBTXc4b32K7-2twnDiggra4jfFbM2EdjRYX4HJGWQ&oe=6AA94A11"}, {"file_name": "Screen4.png", "id": "1239971060392714", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974512_1239971063726047_7232279423978251415_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=We5DgZ2uJYoQ7kNvwF6aC4N&_nc_oc=AdrrFE7YQzjR37m1eWo17QMeKPmbFEwHcCRad9EiEfW2zM_iNG_M13GUbomTlhZs758&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo7-Lte9Oj_f6_5AfhozXsp_0Sj1JPWeo6vCuqslQPpA&oe=6AA953FA"}, {"file_name": "Screen5.png", "id": "589088577422664", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035332_589088580755997_2176872060444948541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MH-BzHVViWMQ7kNvwF8iSzA&_nc_oc=Adq923lKSfMhwr7cscBAkgJzCK5115ue5FH4UUH4DdEmWBX_6JT3vi0fgXQwVp56L_c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-ufpFFkAZ-dezEzJfUrt0eDp9wJwZO1u6wt1QMSW0-A&oe=6AA93DD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "474919925634542", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57574726_474919928967875_1437500233645283217_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ0GG3Ac3JAQ7kNvwEdFQyL&_nc_oc=AdoWg-ePlQgZ_mmR8aoWm2nvVjpGjtyncs5mdMkyqCpqWUtl-nqqPxyoy04_vCM30Qg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw0OrtHLBXk75VQqPIl1-XTvJdJsY-lbpjNE0QVddDEA&oe=6AA95C00"}, "display_name": "Build and Break AR", "keywords": ["build", "break", "ar", "brick", "creative"], "long_description": "Ah, dear reader, gather close, for I shall regale thee with a tale most grand, a tale of ingenuity, of architecture, of digital dreams born anew! Imagine, if you will, a realm wherein one's very hands become the instruments of creation and destruction, a veritable ballet of fingers, bricks, and unrestrained mirth. Such is the splendor of Build and Break AR!\n\nNow, a confession, one born of humility and slight bemusement. The title, Build and Break AR, ought, by the stern hand of technicality, to bear the moniker Build and Break MR, for it is Mixed Reality of which the game is made. Yet, lo, the fluid poetry of \"AR\" held sway! For who among us would choose a term clunkier than a one-legged horse over the honeyed elegance of AR? This artistic liberty stands as a testament to the whimsical soul of its creator (who is, yes, myself).\n\nAnd yet, dear audience, this humble creator finds himself in a slight financial bind. So I shall conclude with an entreaty most heartfelt: Build and Break AR is not merely a game, it is a labor of love, a beacon of joy for all who dare grasp it. \n\nAnywho, buy my game, please, so my wife doesn't have to work anymore.\n\nYours in brick and jest,\nDoubtNot", "short_description": "Build countless creations using stylized bricks within your own space using your hands with the Augmented Reality version of Build and Break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27892870223693285"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2344503585944854"}, {"status": "PUBLISHED", "id": "614513811635058"}, {"status": "PUBLISHED", "id": "9166807863445084"}, {"status": "PUBLISHED", "id": "626141523129451"}, {"status": "PUBLISHED", "id": "1269918260880475"}]}, "baseline_offer": {"id": "2344503585944854"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749273480, "status": "PUBLISHED", "id": "234450
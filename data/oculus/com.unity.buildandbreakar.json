": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75608441_467976939292284_6389625638941771409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3gfg6Gf_LIQ7kNvwEAh6ZJ&_nc_oc=AdqMcnjyXsLgP0NAk3_tDJs_B7L2pkiNfzhqa8mxsSIL-XOTrTb9_6kCiw0PKH5jIxs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCSGa1UzoUFWxKgs86D_p5DjMQwucwR6d6djfPjKsyGA&oe=6A8D735B"}]}, "id": "1402922514016522", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "3925390104342594", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974725_3925390107675927_2132985269572016553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xZzoyhzXYcQ7kNvwENH3C-&_nc_oc=AdpB2ETkdRBt9eSHORC-H7Hsqc5sTq8q26V8j1vQZpa_8DdAED3T932NQpHGbLHOFsQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMgn8XtuNjElUTyNFg0PkvwfxTN5j07Z_zjCB7zzDBbw&oe=6A8D8FD5"}, {"file_name": "Screen2.png", "id": "624912899866792", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57569462_624912903200125_95369952828978215_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjr8g-1TRqAQ7kNvwEyWD7B&_nc_oc=Adqks4zoB8dl3tP-SDUXFzFPQGjRChmwOf3ju19DO_yWYRlvZFfXhu6jig1pecPjUw0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkKgi6ldJRRP9Q0szyIsUObrI38zXWo8nRfOuROnnLig&oe=6A8D9280"}, {"file_name": "Screen3.png", "id": "506470952446683", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036657_506470955780016_4872182285021721507_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BofGSZRLo4Q7kNvwEarj3B&_nc_oc=Adqz9AG1TCfXiM7ar7Ke2KxuWPun8QaPXY7csAruH6CqUEOAyYyBz65zv3A0oO6NTIY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6P0-EL_1P1GlRkOEqWIq4MGxxcfy0aL5WEuNIyLxrEg&oe=6A8D9A91"}, {"file_name": "Screen4.png", "id": "1239971060392714", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974512_1239971063726047_7232279423978251415_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEUL7hxWHOAQ7kNvwFj5c7f&_nc_oc=Adqx8JFL1kgtIA4Pd7E-fI3pcxZxEPH2LVZxQ3AYlEa3wVhkjNzNDYG_EhW-SkVAuZo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEubKwQtBIZzz3FxB-5tn8jQ8D1qxfPIn_DspyaV5dVOA&oe=6A8D6C3A"}, {"file_name": "Screen5.png", "id": "589088577422664", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035332_589088580755997_2176872060444948541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olirGupH-E4Q7kNvwE_aWSj&_nc_oc=AdrbuMn3EQs0zYe8gUWZG5yXnWD_TAgQdh21dHYGbSZCZS_j9sBOGtSiDRBBIUKRsz4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGwSKdKarSIu_rp8y3tJnkksK1bMw2jVYJsBQJ9JuyYg&oe=6A8D8E58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "474919925634542", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57574726_474919928967875_1437500233645283217_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Wq8YdbeIr8Q7kNvwG3w0ZQ&_nc_oc=Adqcq2TYovvW5EanQlKGj50rxk3gaMn4X98ik-EcVHHiwG9Q_n0TrRdd0k0y0PijteY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3jUeBZxHyt7CgKF_N5GEz6bcfcvscrm_QiGeKm_UUlg&oe=6A8D7440"}, "display_name": "Build and Break AR", "keywords": ["build", "break", "ar", "brick", "creative"], "long_description": "Ah, dear reader, gather close, for I shall regale thee with a tale most grand, a tale of ingenuity, of architecture, of digital dreams born anew! Imagine, if you will, a realm wherein one's very hands become the instruments of creation and destruction, a veritable ballet of fingers, bricks, and unrestrained mirth. Such is the splendor of Build and Break AR!\n\nNow, a confession, one born of humility and slight bemusement. The title, Build and Break AR, ought, by the stern hand of technicality, to bear the moniker Build and Break MR, for it is Mixed Reality of which the game is made. Yet, lo, the fluid poetry of \"AR\" held sway! For who among us would choose a term clunkier than a one-legged horse over the honeyed elegance of AR? This artistic liberty stands as a testament to the whimsical soul of its creator (who is, yes, myself).\n\nAnd yet, dear audience, this humble creator finds himself in a slight financial bind. So I shall conclude with an entreaty most heartfelt: Build and Break AR is not merely a game, it is a labor of love, a beacon of joy for all who dare grasp it. \n\nAnywho, buy my game, please, so my wife doesn't have to work anymore.\n\nYours in brick and jest,\nDoubtNot", "short_description": "Build countless creations using stylized bricks within your own space using your hands with the Augmented Reality version of Build and Break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27892870223693285"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2344503585944854"}, {"status": "PUBLISHED", "id": "614513811635058"}, {"status": "PUBLISHED", "id": "9166807863445084"}, {"status": "PUBLISHED", "id": "626141523129451"}, {"status": "PUBLISHED", "id": "1269918260880475"}]}, "baseline_offer": {"id": "2344503585944854"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749273480, "status": "PUBLISHED", "id": "23
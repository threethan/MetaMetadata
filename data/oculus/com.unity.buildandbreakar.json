": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75608441_467976939292284_6389625638941771409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNQWmAwq42EQ7kNvwHg19Q3&_nc_oc=AdrtRTVHmfOOZFx6zzQgqWMdPdVG0H-yTzVjzsaCfBS9vrS8O-4Dt63Lg5886Rqr8VM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yt41YJJjhFRgM-DaUcMybF0K7RIcaMQDHMBUmHzzK2g&oe=6A22E21B"}]}, "id": "1402922514016522", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "3925390104342594", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974725_3925390107675927_2132985269572016553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5tfEF4F7AIQ7kNvwEbb7-n&_nc_oc=Adrhh5LP6muOCjL_UbCGLnamE4Ie1J97qWISiz4ePZR7nRiUBjoBYg5H1N7NeoEY1Jo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O0BTTJXghndwW94f3vVTFbJ9FVjbk_tDFzUe1CCNMnQ&oe=6A22FE95"}, {"file_name": "Screen2.png", "id": "624912899866792", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57569462_624912903200125_95369952828978215_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xg0WzfLkOvgQ7kNvwEgg7KC&_nc_oc=Adr21y4uj-RnGQ61NH3feRfcEKxP9qixRtDWVcU2faVXC_t41I-W70-6R2-Kg4mqZYE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7peUnKNGDP0A38gfXfBiLuRLDAqH5gusTeDgVR4SeFQ&oe=6A230140"}, {"file_name": "Screen3.png", "id": "506470952446683", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036657_506470955780016_4872182285021721507_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUedD_1PKDEQ7kNvwHIpcAN&_nc_oc=AdqlbQnR_BWn6KOudDT7i5Wb7wUucaclZZ6OjrdbqmYHvlhA7CTBM0TLOxEon1JxzZE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98p2DC2xd8lsni1SZi_d1pANcXOCTED-bQZKVrXFGyAw&oe=6A22D111"}, {"file_name": "Screen4.png", "id": "1239971060392714", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974512_1239971063726047_7232279423978251415_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr-BQaAHzQ8Q7kNvwEhGslz&_nc_oc=AdqFAnM8JhG_jfHGFzrnkTQHE3ZegZe5INh7dyvma0yc7aRPMEO2t1EydF5qJJ3RU9k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fIjpzfxpBZKgpNfWApzINK7kXaBFPNu0EvdIU9zqrOg&oe=6A22DAFA"}, {"file_name": "Screen5.png", "id": "589088577422664", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035332_589088580755997_2176872060444948541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GScZ5KMr2OUQ7kNvwHw4Eh4&_nc_oc=Adq_I7CT6KG34y48Y1FzpU2nH2Wr12O05iDPOKDT_M5tyhN6Paj4fPCWe1F1oxP98_U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n6oooKAjjORZVrGZrWo2g61xAe3NCojqq4146jReF8Q&oe=6A22FD18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "474919925634542", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57574726_474919928967875_1437500233645283217_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1U92RqInU4Q7kNvwGyPJbk&_nc_oc=AdpKs4_ORloeD1Z5Q4OwO28wGdH0P1Ybqza6RExC6HI_TQ16SR5RZ-86v0LAB02G090&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ipsyTTK9CN1LYMaQR5HSAJIBcHcHPfP10RXJdJLykhA&oe=6A22E300"}, "display_name": "Build and Break AR", "keywords": ["build", "break", "ar", "brick", "creative"], "long_description": "Ah, dear reader, gather close, for I shall regale thee with a tale most grand, a tale of ingenuity, of architecture, of digital dreams born anew! Imagine, if you will, a realm wherein one's very hands become the instruments of creation and destruction, a veritable ballet of fingers, bricks, and unrestrained mirth. Such is the splendor of Build and Break AR!\n\nNow, a confession, one born of humility and slight bemusement. The title, Build and Break AR, ought, by the stern hand of technicality, to bear the moniker Build and Break MR, for it is Mixed Reality of which the game is made. Yet, lo, the fluid poetry of \"AR\" held sway! For who among us would choose a term clunkier than a one-legged horse over the honeyed elegance of AR? This artistic liberty stands as a testament to the whimsical soul of its creator (who is, yes, myself).\n\nAnd yet, dear audience, this humble creator finds himself in a slight financial bind. So I shall conclude with an entreaty most heartfelt: Build and Break AR is not merely a game, it is a labor of love, a beacon of joy for all who dare grasp it. \n\nAnywho, buy my game, please, so my wife doesn't have to work anymore.\n\nYours in brick and jest,\nDoubtNot", "short_description": "Build countless creations using stylized bricks within your own space using your hands with the Augmented Reality version of Build and Break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27892870223693285"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2344503585944854"}, {"status": "PUBLISHED", "id": "614513811635058"}, {"status": "PUBLISHED", "id": "9166807863445084"}, {"status": "PUBLISHED", "id": "626141523129451"}, {"status": "PUBLISHED", "id": "1269918260880475"}]}, "baseline_offer": {"id": "2344503585944854"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749273480, "status": "PUBLISHED", "id": "234450
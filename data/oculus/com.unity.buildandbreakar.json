1_467976939292284_6389625638941771409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMSm8Saou5EQ7kNvwFgWF1Y&_nc_oc=Adk3eVPPNRzA8Hxjd4u-fQ3jdIawQballYoYp4Es3ABtFyfOhhlL_6cBmdGK-Ly7m_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftTT1iA3AwNEraK8JcYoGrkda634U7A9YUt4ckkgtgBrw&oe=69A6BCDB"}]}, "id": "1402922514016522", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "3925390104342594", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974725_3925390107675927_2132985269572016553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viyvQhcCIFAQ7kNvwFanlpG&_nc_oc=AdkvIRQ7ME69uDJ0K5mXiMLsCBXs72_AIFRJKbcPUYR6wE3pHVwMbmWWs8pTEfoa3yQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftAYWtHNZBa751BShrvPWZ48v4G4QlVwUqGK7ollzh4Gw&oe=69A6D955"}, {"file_name": "Screen2.png", "id": "624912899866792", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569462_624912903200125_95369952828978215_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2H25P3Mp1YQ7kNvwFsE71n&_nc_oc=AdkI6mDhGKm9G7sDb5iTLDetqMTdu7oB8pYj5NbuzAlgsypw5-qb5IBCXJgct7gxNNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuvfHv2nfoy9YGAY2NVbzDhxlMfvUdD-KAOkb1zBTKEPg&oe=69A6DC00"}, {"file_name": "Screen3.png", "id": "506470952446683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036657_506470955780016_4872182285021721507_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaJmUX6drsAQ7kNvwE1AD3U&_nc_oc=AdlKlii1gro2cfD8MoFWnyQEv0_wXuyRBS-c6FqBb3THpNr39U1Lnw8sfd50m47gwAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfshKp3MV2UdYTg2fe1lRQQIYDFndzNrGwdvo9ewvMgtIw&oe=69A6E411"}, {"file_name": "Screen4.png", "id": "1239971060392714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1239971063726047_7232279423978251415_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bq5KJcvjEsQ7kNvwFzzkab&_nc_oc=Adl7hbfpRHp35-OJu3x0fGb3i6TrH7FtMYjEyPQW9FVQTE27HJ10j4CsgVOvUy9AuYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuv8MWVbbCYekPc2_-0Yix9RUyieDITb3RNWsdgb1fNhg&oe=69A6EDFA"}, {"file_name": "Screen5.png", "id": "589088577422664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035332_589088580755997_2176872060444948541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqaZQZRMfzgQ7kNvwHOdW_T&_nc_oc=AdmZbxz6gAcTnIn5VwVIb2r4kyCPVdk_EgEjVB3VK3ZF68IPR-kdP7HTnyBf1oZt3Vo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv_3Sgo_3JoifeKFnofGXGqLJB0_n9Dym9rXE1NigMZTg&oe=69A6D7D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "474919925634542", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57574726_474919928967875_1437500233645283217_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5MSCtAhekwQ7kNvwGC-EIS&_nc_oc=AdlMd_Et8m1D0PE_dgdEcWpl98N62FJHDiseQ_OqZwIsOgV2ZaZTEeacIOgqePV16Fc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuaAQwSbBy9fhoQOt0HbN71sakPZhkMVyT-LIt84xdLSg&oe=69A6BDC0"}, "display_name": "Build and Break AR", "keywords": ["build", "break", "ar", "brick", "creative"], "long_description": "Ah, dear reader, gather close, for I shall regale thee with a tale most grand, a tale of ingenuity, of architecture, of digital dreams born anew! Imagine, if you will, a realm wherein one's very hands become the instruments of creation and destruction, a veritable ballet of fingers, bricks, and unrestrained mirth. Such is the splendor of Build and Break AR!\n\nNow, a confession, one born of humility and slight bemusement. The title, Build and Break AR, ought, by the stern hand of technicality, to bear the moniker Build and Break MR, for it is Mixed Reality of which the game is made. Yet, lo, the fluid poetry of \"AR\" held sway! For who among us would choose a term clunkier than a one-legged horse over the honeyed elegance of AR? This artistic liberty stands as a testament to the whimsical soul of its creator (who is, yes, myself).\n\nAnd yet, dear audience, this humble creator finds himself in a slight financial bind. So I shall conclude with an entreaty most heartfelt: Build and Break AR is not merely a game, it is a labor of love, a beacon of joy for all who dare grasp it. \n\nAnywho, buy my game, please, so my wife doesn't have to work anymore.\n\nYours in brick and jest,\nDoubtNot", "short_description": "Build countless creations using stylized bricks within your own space using your hands with the Augmented Reality version of Build and Break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27892870223693285"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2344503585944854"}, {"status": "PUBLISHED", "id": "614513811635058"}, {"status": "PUBLISHED", "id": "9166807863445084"}, {"status": "PUBLISHED", "id": "626141523129451"}, {"status": "PUBLISHED", "id": "1269918260880475"}]}, "baseline_offer": {"id": "2344503585944854"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749273480, "status": "PUBLISHED", "id": "2344503585944854"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29053481977632098", "version": "1.1.53"}, "
": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75608441_467976939292284_6389625638941771409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr_ua1lcb80Q7kNvwFaPyxL&_nc_oc=AdqGOhYCU7hPNEu3BLMf8yZceQysAJuickgeFNlkrvPBn7DxuD7HLTsvdl0zziAJ6xo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL50hJUG_KLECuEfRSOdjInwXhCV-ret4s_JiQ4rX1i4g&oe=6AAEA11B"}]}, "id": "1402922514016522", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "3925390104342594", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974725_3925390107675927_2132985269572016553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfygGvjEQYMQ7kNvwHsNEPb&_nc_oc=AdolvJflmyYhAu-3wa25bPFA8_JEgfFmIDqR6FHdcNihZaH-Phy2-EkQQM1UXBz7erk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKze7fFsQbukuYv3BTJC_2C4nvMWUfjb1lX6l62hANXLQ&oe=6AAE8555"}, {"file_name": "Screen2.png", "id": "624912899866792", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57569462_624912903200125_95369952828978215_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmiJGiCpVSsQ7kNvwHmi9hk&_nc_oc=Adoh8Sy-CtB71lOc7-bqYaJy6o42oSHcpNHVBpIxXlZTIguSa689e19a9pTUJ0c4Xwg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoeimnJPW4zcJA3VkMV1BIgIeEX3lB60JEEQPdCh623g&oe=6AAE8800"}, {"file_name": "Screen3.png", "id": "506470952446683", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036657_506470955780016_4872182285021721507_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5_QYOnE5gUQ7kNvwHJOJ2a&_nc_oc=AdoIG0jUfqDvrE4-2m_AOcRaL366guR4SMWUskGY01JGuhAtrspJmCYyDvYQUo2uFA4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkdTks1vMWOXwbi6HfRmJhwSQA3PMn7lUae_KHZ2NuxA&oe=6AAE9011"}, {"file_name": "Screen4.png", "id": "1239971060392714", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974512_1239971063726047_7232279423978251415_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aeRgBLEWZIQ7kNvwEC-wUr&_nc_oc=AdoYWHQcHyiXXTLrtW7_NtLd_QBh6tViF95rU6vMqgv1VAqFLyKMdYZ5eBRNksyw1Lc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNh8-731P1MKq9qnf04VvPTnQqDh9pJmTwqoLTqeOTSg&oe=6AAE99FA"}, {"file_name": "Screen5.png", "id": "589088577422664", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035332_589088580755997_2176872060444948541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6b3Abp65L3cQ7kNvwHwWjqt&_nc_oc=Ado2Zl2fj8Jt-86s2GJAfv2kqDZbnjeR-LqTjdP56tk8hc-TtxJJUYqR0hqaeWlKCZg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuNtwztbSejczKtusqkN_pBkwK8TNV8NK4XDyvazWNmA&oe=6AAE83D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "474919925634542", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57574726_474919928967875_1437500233645283217_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igoDfATPzycQ7kNvwEgMjkN&_nc_oc=AdqmNtUXES9LMW6kR4np3Hg6GiNnSziuLcslHKLcDJerLZ8KfwzWNnjgIOy39T3AU8Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJko4k4_1YFELJNMrX6eQH4Dde1H7yIB1eeIVY9jXKqdw&oe=6AAEA200"}, "display_name": "Build and Break AR", "keywords": ["build", "break", "ar", "brick", "creative"], "long_description": "Ah, dear reader, gather close, for I shall regale thee with a tale most grand, a tale of ingenuity, of architecture, of digital dreams born anew! Imagine, if you will, a realm wherein one's very hands become the instruments of creation and destruction, a veritable ballet of fingers, bricks, and unrestrained mirth. Such is the splendor of Build and Break AR!\n\nNow, a confession, one born of humility and slight bemusement. The title, Build and Break AR, ought, by the stern hand of technicality, to bear the moniker Build and Break MR, for it is Mixed Reality of which the game is made. Yet, lo, the fluid poetry of \"AR\" held sway! For who among us would choose a term clunkier than a one-legged horse over the honeyed elegance of AR? This artistic liberty stands as a testament to the whimsical soul of its creator (who is, yes, myself).\n\nAnd yet, dear audience, this humble creator finds himself in a slight financial bind. So I shall conclude with an entreaty most heartfelt: Build and Break AR is not merely a game, it is a labor of love, a beacon of joy for all who dare grasp it. \n\nAnywho, buy my game, please, so my wife doesn't have to work anymore.\n\nYours in brick and jest,\nDoubtNot", "short_description": "Build countless creations using stylized bricks within your own space using your hands with the Augmented Reality version of Build and Break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27892870223693285"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2344503585944854"}, {"status": "PUBLISHED", "id": "614513811635058"}, {"status": "PUBLISHED", "id": "9166807863445084"}, {"status": "PUBLISHED", "id": "626141523129451"}, {"status": "PUBLISHED", "id": "1269918260880475"}]}, "baseline_offer": {"id": "2344503585944854"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749273480, "status": "PUBLISHED", "id": "234450
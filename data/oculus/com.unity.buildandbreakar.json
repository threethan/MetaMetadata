atUbfijBAwWM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04kZXaVo2debOJHaqZz3FAPRQO7QMXmDlGgNDa6EF-eQ&oe=69F2137A"}, {"file_name": "Screen5.png", "id": "589088577422664", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035332_589088580755997_2176872060444948541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_BUSZUrBqEQ7kNvwFZcPGt&_nc_oc=Adp-SI1CnhAH0w_MqBaphStpUX0YmiSZU4BPpbt0a2soA6swG8F4imU8Mn6LDyV_RYc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1YuxoOTED5u_W_EcQo3YsHfrgNkyQ2104gf2A9KIwn_Q&oe=69F1FD58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "474919925634542", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57574726_474919928967875_1437500233645283217_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNcdBikPhJkQ7kNvwFKif2N&_nc_oc=Adqb8k9dECcYQonYvS92WVYtTNWiMroPnwS0mCm63A1-z670HxprSqcVOZnnGCapt9A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0euRShKpWVUncUalMrICgk6OqisNtgVQqn237Ld1-kmQ&oe=69F21B80"}, "display_name": "Build and Break AR", "keywords": ["build", "break", "ar", "brick", "creative"], "long_description": "Ah, dear reader, gather close, for I shall regale thee with a tale most grand, a tale of ingenuity, of architecture, of digital dreams born anew! Imagine, if you will, a realm wherein one's very hands become the instruments of creation and destruction, a veritable ballet of fingers, bricks, and unrestrained mirth. Such is the splendor of Build and Break AR!\n\nNow, a confession, one born of humility and slight bemusement. The title, Build and Break AR, ought, by the stern hand of technicality, to bear the moniker Build and Break MR, for it is Mixed Reality of which the game is made. Yet, lo, the fluid poetry of \"AR\" held sway! For who among us would choose a term clunkier than a one-legged horse over the honeyed elegance of AR? This artistic liberty stands as a testament to the whimsical soul of its creator (who is, yes, myself).\n\nAnd yet, dear audience, this humble creator finds himself in a slight financial bind. So I shall conclude with an entreaty most heartfelt: Build and Break AR is not merely a game, it is a labor of love, a beacon of joy for all who dare grasp it. \n\nAnywho, buy my game, please, so my wife doesn't have to work anymore.\n\nYours in brick and jest,\nDoubtNot", "short_description": "Build countless creations using stylized bricks within your own space using your hands with the Augmented Reality version of Build and Break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27892870223693285"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2344503585944854"}, {"status": "PUBLISHED", "id": "614513811635058"}, {"status": "PUBLISHED", "id": "9166807863445084"}, {"status": "PUBLISHED", "id": "626141523129451"}, {"status": "PUBLISHED", "id": "1269918260880475"}]}, "baseline_offer": {"id": "2344503585944854"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749273480, "status": "PUBLISHED", "id": "2344503585944854"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "
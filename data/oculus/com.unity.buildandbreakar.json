1_467976939292284_6389625638941771409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elYIHn7fL3cQ7kNvwEG-GzG&_nc_oc=Adnctk2wbtj20NTs2F_b_IxwIHbzVtFrdnQbZzlaJPeVj5xs6CbCRdfL8Ui68VEpe6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftnm5zIeI13u_MBkHJsKs58TVjeQWNvQ2AG9jsPoc-Efw&oe=69A419DB"}]}, "id": "1402922514016522", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "3925390104342594", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974725_3925390107675927_2132985269572016553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6aH-y_Q_mkQ7kNvwGdB3WX&_nc_oc=AdmhczTI4IFmcj2F7prOaXjmIpH8oZlttYGsX09rSgfBcdhOYlRnqA9NJgLtUsn59-k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvrik0MphgnD0r3akcQxwqXiyQ1VM2-DC__S7KYLmwYHw&oe=69A43655"}, {"file_name": "Screen2.png", "id": "624912899866792", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569462_624912903200125_95369952828978215_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDMu3c0oCUkQ7kNvwGhCOTv&_nc_oc=Adkrbwt-bwRwzvZvSG1w6FRHnoL9W-hgLyE0nH4pFlrdGIpBUhIPf4zkSh78ZBCw920&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs0WpMQR7E1ESPchZfQMzxsIUhE6qc4_rd9m2aVoo0DKA&oe=69A43900"}, {"file_name": "Screen3.png", "id": "506470952446683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036657_506470955780016_4872182285021721507_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VzfmNPf5BUQ7kNvwGWIlKV&_nc_oc=AdnBFYgS94LZJ3AtcTc3y3y6LMeEaviYdV84ZbZQtHdU4QmNphuZMG4TOGqdHarb1LM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftiI9Qu0fESXO5crgt150d_Iv-P19Xf5boH70_B7hxHhQ&oe=69A44111"}, {"file_name": "Screen4.png", "id": "1239971060392714", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974512_1239971063726047_7232279423978251415_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY0nMvICu8oQ7kNvwHtoUVo&_nc_oc=AdnNjzGN-hrcbXG_b7Fka49LW3XBOjrcAndLi-78EUfRr3vD3ImXGB82fcoVcAaeH-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfslMIqtw9eSFQZ36T3GM8hYTFnKqqK2ZLdrL0CBhXhazQ&oe=69A44AFA"}, {"file_name": "Screen5.png", "id": "589088577422664", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035332_589088580755997_2176872060444948541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqaZQZRMfzgQ7kNvwHWM-FQ&_nc_oc=Adk8pc2sXTwoCsuUCiXOCDjdSI5v9P8qgiSyLwuDqLE5QJvTL2wxtkqAjV3HnzJ9Yr8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftxUCunTR0DoNrjG1hcF3SSvo76kHzAUxYKbeL5_EZS6Q&oe=69A434D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "474919925634542", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574726_474919928967875_1437500233645283217_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5MSCtAhekwQ7kNvwGL_9fM&_nc_oc=AdmavsNWcH4BD9aP7x12LOjhjArG55i0a-M0o1Yd6Eq7BlLYFvZa6QrFVNnH49jHuTY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftQ1bTAHw9ENrHQy5vbWLO6IA8jWytgN8fgXGw0eBmz3g&oe=69A41AC0"}, "display_name": "Build and Break AR", "keywords": ["build", "break", "ar", "brick", "creative"], "long_description": "Ah, dear reader, gather close, for I shall regale thee with a tale most grand, a tale of ingenuity, of architecture, of digital dreams born anew! Imagine, if you will, a realm wherein one's very hands become the instruments of creation and destruction, a veritable ballet of fingers, bricks, and unrestrained mirth. Such is the splendor of Build and Break AR!\n\nNow, a confession, one born of humility and slight bemusement. The title, Build and Break AR, ought, by the stern hand of technicality, to bear the moniker Build and Break MR, for it is Mixed Reality of which the game is made. Yet, lo, the fluid poetry of \"AR\" held sway! For who among us would choose a term clunkier than a one-legged horse over the honeyed elegance of AR? This artistic liberty stands as a testament to the whimsical soul of its creator (who is, yes, myself).\n\nAnd yet, dear audience, this humble creator finds himself in a slight financial bind. So I shall conclude with an entreaty most heartfelt: Build and Break AR is not merely a game, it is a labor of love, a beacon of joy for all who dare grasp it. \n\nAnywho, buy my game, please, so my wife doesn't have to work anymore.\n\nYours in brick and jest,\nDoubtNot", "short_description": "Build countless creations using stylized bricks within your own space using your hands with the Augmented Reality version of Build and Break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27892870223693285"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2344503585944854"}, {"status": "PUBLISHED", "id": "614513811635058"}, {"status": "PUBLISHED", "id": "9166807863445084"}, {"status": "PUBLISHED", "id": "626141523129451"}, {"status": "PUBLISHED", "id": "1269918260880475"}]}, "baseline_offer": {"id": "2344503585944854"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749273480, "status": "PUBLISHED", "id": "2344503585944854"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29053481977632098", "version": "1.1.53"}, "
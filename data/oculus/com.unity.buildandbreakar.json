1_467976939292284_6389625638941771409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-UMH0AOz-8Q7kNvwH127Qs&_nc_oc=Adl7BnvMNCJZ6vTCjTGdMM3Y1NX2qjrB3HwchC63WSvnL_NxznsWuVbzuCEsF68j52w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsfFn5UWGU7WRPPZg3XjZhTAwRNBtRSX976hcoIKhS5_A&oe=699C30DB"}]}, "id": "1402922514016522", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "3925390104342594", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974725_3925390107675927_2132985269572016553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7549pAabUYMQ7kNvwHUxJpd&_nc_oc=AdkeKh7M4RY8Q7FPaD9aI83IJQQAsfxCgZQFUO52N6Z8AjHnuSle4XiuZT7gKHu8EwU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsmrDOoQ2pjGcguLE3fJCSbtcuVV8aggdE8HsgUAwSV8w&oe=699C4D55"}, {"file_name": "Screen2.png", "id": "624912899866792", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569462_624912903200125_95369952828978215_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0bcH3aSe1sQ7kNvwEGtGxJ&_nc_oc=Adk5UxNf9GCWtn7Xb7TyeHoTzzl21QJRBolaHO1E8YDhUUbUFyfd0GM3N7mGRPEagCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfubjW5ek4M_rPIzXpPff1OUiET9lCef8-heW86ANA8uFg&oe=699C5000"}, {"file_name": "Screen3.png", "id": "506470952446683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036657_506470955780016_4872182285021721507_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlrtT_kk1HIQ7kNvwFMsRRr&_nc_oc=AdkFuZZMK5oWZkgbi33Rz9dnPNwY-N6S_I63SEvy1TDJAC9Q2lpUhKic5buDpABQ3T0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuDkW13cbcIkTpagOSgZe71-w3aq3Mg8-s2Pov7c8rURA&oe=699C5811"}, {"file_name": "Screen4.png", "id": "1239971060392714", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974512_1239971063726047_7232279423978251415_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-gvvqs-B2kQ7kNvwGjnZYW&_nc_oc=AdlRelOKhg7Ksfoq9SDx4VZz946YHwHLOwLYdu6jABqhIr35UWj1aH-81l-d8U73rPE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuMnWOJrDNkV7U3NVNWIxDsD3TpegYPC-9KPMFuV3iH-A&oe=699C61FA"}, {"file_name": "Screen5.png", "id": "589088577422664", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035332_589088580755997_2176872060444948541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JhKqiduhoEQ7kNvwHqLxTW&_nc_oc=AdkJcAYOIVQkDrhVHWFmJ8yEB6dxVbvmVnxAheOeXtyl9ElG4RPAbvDePqGz0K4LkgU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsjSm0PWuEAlwlciiFUUsazUYb-KxHty9HADiQPsTVbTw&oe=699C4BD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "474919925634542", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57574726_474919928967875_1437500233645283217_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuZPZpd9hEYQ7kNvwHGJkgv&_nc_oc=Adl2P_DO_IVzD15xyuUVEcgPqpXSncU1BenLMyHbhiJIAwuP0uAUcyBJm4eh7PfOJMU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvtfzzGKQMKlY3KK4XJwdk_8ODGoogx6KcEP0UF4q6eHg&oe=699C31C0"}, "display_name": "Build and Break AR", "keywords": ["build", "break", "ar", "brick", "creative"], "long_description": "Ah, dear reader, gather close, for I shall regale thee with a tale most grand, a tale of ingenuity, of architecture, of digital dreams born anew! Imagine, if you will, a realm wherein one's very hands become the instruments of creation and destruction, a veritable ballet of fingers, bricks, and unrestrained mirth. Such is the splendor of Build and Break AR!\n\nNow, a confession, one born of humility and slight bemusement. The title, Build and Break AR, ought, by the stern hand of technicality, to bear the moniker Build and Break MR, for it is Mixed Reality of which the game is made. Yet, lo, the fluid poetry of \"AR\" held sway! For who among us would choose a term clunkier than a one-legged horse over the honeyed elegance of AR? This artistic liberty stands as a testament to the whimsical soul of its creator (who is, yes, myself).\n\nAnd yet, dear audience, this humble creator finds himself in a slight financial bind. So I shall conclude with an entreaty most heartfelt: Build and Break AR is not merely a game, it is a labor of love, a beacon of joy for all who dare grasp it. \n\nAnywho, buy my game, please, so my wife doesn't have to work anymore.\n\nYours in brick and jest,\nDoubtNot", "short_description": "Build countless creations using stylized bricks within your own space using your hands with the Augmented Reality version of Build and Break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27892870223693285"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2344503585944854"}, {"status": "PUBLISHED", "id": "614513811635058"}, {"status": "PUBLISHED", "id": "9166807863445084"}, {"status": "PUBLISHED", "id": "626141523129451"}, {"status": "PUBLISHED", "id": "1269918260880475"}]}, "baseline_offer": {"id": "2344503585944854"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749273480, "status": "PUBLISHED", "id": "2344503585944854"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29053481977632098", "version": "1.1.53"}, "
NzaYGhapOeZ7ujDQ3ouFq6EF3lKT2AdgqBoyfrg&oe=6B05CB51"}, {"file_name": "Screen4.png", "id": "1239971060392714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1239971063726047_7232279423978251415_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WU5XP5lERNoQ7kNvwEmygMZ&_nc_oc=AdqERG4j-oaOfMnkkbm4rkHSg0IC-5yZWKBJvIWLn36XihuvFU4Dhlv_MfbWiHyLQvQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZUOYmE4IQ06_XSBiGjGEr1yGh6ZnvtyxUUXuY8uDuww&oe=6B05D53A"}, {"file_name": "Screen5.png", "id": "589088577422664", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035332_589088580755997_2176872060444948541_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfG_pucPJOEQ7kNvwGBaDCg&_nc_oc=AdpML5D11Fr8guLWMI8ODqavp5aJpg3Juct7-L4DRCwudJDcpx0H-fl1lICwlcJMnBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_I6aUZz9vmA-ej699BEXG0nmZGMz5UgkiV1WzgQR35A&oe=6B05BF18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "474919925634542", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57574726_474919928967875_1437500233645283217_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBFqFrMUKXYQ7kNvwF4FerO&_nc_oc=Adp7JLOIfnRpZhVRPXZ3DvQsuVlD6s4pmPmavLYbxThAsQDbdZBK0vLTIgss8nogRDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLznRILPf6K4N7aOkRri4IjNvPKQYM7GYa0L-HRtGdkw&oe=6B05A500"}, "display_name": "Build and Break AR", "keywords": ["build", "break", "ar", "brick", "creative"], "long_description": "Ah, dear reader, gather close, for I shall regale thee with a tale most grand, a tale of ingenuity, of architecture, of digital dreams born anew! Imagine, if you will, a realm wherein one's very hands become the instruments of creation and destruction, a veritable ballet of fingers, bricks, and unrestrained mirth. Such is the splendor of Build and Break AR!\n\nNow, a confession, one born of humility and slight bemusement. The title, Build and Break AR, ought, by the stern hand of technicality, to bear the moniker Build and Break MR, for it is Mixed Reality of which the game is made. Yet, lo, the fluid poetry of \"AR\" held sway! For who among us would choose a term clunkier than a one-legged horse over the honeyed elegance of AR? This artistic liberty stands as a testament to the whimsical soul of its creator (who is, yes, myself).\n\nAnd yet, dear audience, this humble creator finds himself in a slight financial bind. So I shall conclude with an entreaty most heartfelt: Build and Break AR is not merely a game, it is a labor of love, a beacon of joy for all who dare grasp it. \n\nAnywho, buy my game, please, so my wife doesn't have to work anymore.\n\nYours in brick and jest,\nDoubtNot", "short_description": "Build countless creations using stylized bricks within your own space using your hands with the Augmented Reality version of Build and Break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27892870223693285"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2344503585944854"}, {"s
1_467976939292284_6389625638941771409_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV8orgcMtLIQ7kNvwFruP9y&_nc_oc=Adl1TAWkY8FQ9LNjBYvtAfEputDC8CNQFM9LW5BVKrHPQVtpqRqLbOXUsCc38z3G4AY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftY8nj1Vi9A1afMzlOUKu6BwpDGR7DJTYKbKht1GsDHIg&oe=69A0255B"}]}, "id": "1402922514016522", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "3925390104342594", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974725_3925390107675927_2132985269572016553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIrsQrr9wCYQ7kNvwGTZ_29&_nc_oc=AdnfOoyClPag_ZfFnyLav-VYX0I2UfEvxa7wBRzY3MavGvZvGuUchkxfX-roneg1LGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvxniN-PvAn2gS9FPUmLBre4qd6YN3UB9a9Y09WBWp9tg&oe=69A041D5"}, {"file_name": "Screen2.png", "id": "624912899866792", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569462_624912903200125_95369952828978215_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaZnrfGvBUIQ7kNvwGKVTgF&_nc_oc=AdlUxKx9FAs4NpWFe5j3P9ARkb9U1pV_b5HHRmH69FXrdrkGotOLjq2QmeW6gFgRP7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afub95e2vDmqxzdGxX51TNz3wVyuGTdpEL3q5mGKemZ5EA&oe=69A04480"}, {"file_name": "Screen3.png", "id": "506470952446683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036657_506470955780016_4872182285021721507_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3O7C8tqAzykQ7kNvwFrPlkw&_nc_oc=AdkWMp9T_yFUQ5EH8K5CEYj8ugaIfmEtMz7sKqbuInvYDjry6goux-MnTrDNh1Lh6vE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftW0cmLY-aZlAukJiKlpaywl8RXGAJFNie4LkFZ0rhjlw&oe=69A04C91"}, {"file_name": "Screen4.png", "id": "1239971060392714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974512_1239971063726047_7232279423978251415_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdCKV1EcRJ4Q7kNvwGUTiO0&_nc_oc=Adk8IBYEUBAhwiIHN3lmTLbZ_Broxc76hSfEuSFnn2zL4kqK1K_xxpf-qgw_YWdFqTQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afshndik0OqPV7iW8d4zEYEPc7UHsVW2cedmv66D8icHYg&oe=69A0567A"}, {"file_name": "Screen5.png", "id": "589088577422664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035332_589088580755997_2176872060444948541_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ha1W3f0ZUdYQ7kNvwHRP24_&_nc_oc=AdnQACNTfeEWvG3ZR8-epZGNl_GMfKm-d1-ZusJi8FN3jx8Z3MfXmCEa9a22KxxmJew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu64gdvm3l0nOaT5DKjXLbJ_yF30c9NYJxeQSE3V56wwg&oe=69A04058"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "474919925634542", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57574726_474919928967875_1437500233645283217_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3ogijKvavkQ7kNvwFFXSjM&_nc_oc=AdlQSZDUUU2nsg4reScXgmhL0SuCzNGMQQuNV1KUjjIAqod7y1aI2E0Wrbf0zzSymdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuMCbWAi5U16HFyf3AXLeffHzSdOMaAA9VDhmn8MlGrFg&oe=69A02640"}, "display_name": "Build and Break AR", "keywords": ["build", "break", "ar", "brick", "creative"], "long_description": "Ah, dear reader, gather close, for I shall regale thee with a tale most grand, a tale of ingenuity, of architecture, of digital dreams born anew! Imagine, if you will, a realm wherein one's very hands become the instruments of creation and destruction, a veritable ballet of fingers, bricks, and unrestrained mirth. Such is the splendor of Build and Break AR!\n\nNow, a confession, one born of humility and slight bemusement. The title, Build and Break AR, ought, by the stern hand of technicality, to bear the moniker Build and Break MR, for it is Mixed Reality of which the game is made. Yet, lo, the fluid poetry of \"AR\" held sway! For who among us would choose a term clunkier than a one-legged horse over the honeyed elegance of AR? This artistic liberty stands as a testament to the whimsical soul of its creator (who is, yes, myself).\n\nAnd yet, dear audience, this humble creator finds himself in a slight financial bind. So I shall conclude with an entreaty most heartfelt: Build and Break AR is not merely a game, it is a labor of love, a beacon of joy for all who dare grasp it. \n\nAnywho, buy my game, please, so my wife doesn't have to work anymore.\n\nYours in brick and jest,\nDoubtNot", "short_description": "Build countless creations using stylized bricks within your own space using your hands with the Augmented Reality version of Build and Break."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.doubtnot.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "DoubtNot", "support_website_url": null, "website_url": "https://www.doubtnot.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27892870223693285"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2344503585944854"}, {"status": "PUBLISHED", "id": "614513811635058"}, {"status": "PUBLISHED", "id": "9166807863445084"}, {"status": "PUBLISHED", "id": "626141523129451"}, {"status": "PUBLISHED", "id": "1269918260880475"}]}, "baseline_offer": {"id": "2344503585944854"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749273480, "status": "PUBLISHED", "id": "2344503585944854"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29053481977632098", "version": "1.1.53"}, "
/v/t64.5771-25/43931328_750182757094708_5139216177211643994_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAXDoQZjybYQ7kNvwFUZTPS&_nc_oc=Adp4VeYZF5wwx7lfuJ53LkcoXe1LXG15OKkUDpxZEzae2S0DZoc2D5HvlOJp6op0JXA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rgG8PxuZhiIPCna5P6WiSsDMp-Pkz05kBLQcGEms64w&oe=6A11BDDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Macaques!", "keywords": [], "long_description": "Hello! It is the creator here, AlbinoGT!\n\nMe and Beach have teamed up to create this Gorilla Tag fangame, known as Macaques! We have a lot to offer, including a Glass Bridge gamemode, lots of cosmetics, and horror! It would be cool if you downloaded the game, since we have worked very hard nonstop for 2 months. We even had to remake the game! Hopefully you will enjoy our game!\n\n- AlbinoGT and Beach", "short_description": "In my game, Macaques, you can chill out with your friends, and have fun! The game will get updates a lot, and is based off of gorilla locomotion physics."}]}, "developer_name": "AlbinoGT", "developer_privacy_policy_url": "https://sites.google.com/view/macaquesofficial/home", "developer_terms_of_service_url": null, "publisher_name": "AlbinoGT", "support_website_url": null, "website_url": "https://sites.google.com/view/macaquesofficial/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "250189502744195
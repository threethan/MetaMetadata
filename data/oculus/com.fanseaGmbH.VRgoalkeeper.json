_0000.png", "id": "1851298358787259", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825052_1851298362120592_2480888107755513649_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkEhFU5X_cEQ7kNvwEXiPQI&_nc_oc=AdqdLO6d0PR0JCZ3Qzgj3RceuvSPlARf-65u8674n88hWFI2sucSQoOFmHLRI44Cuwk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3PSMppGcPo8IdqSXOLkGA_YKJPUrTyTVo180acGaVzuQ&oe=69F4BCBB"}, {"file_name": "MinigameShots_010_0000.png", "id": "757809916901973", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830607_757809920235306_2947710171665264322_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcXnnuDcYu0Q7kNvwEQkx1L&_nc_oc=AdoLNx-gHeSkcIKTTMf4AOPrXZ5UyHiX0PoZBD4ZFIw-PBSU6lX4NsaYeMaeVPgYfe0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2JEvJ9dPnqRzFRer1JOVx9k9Bls7XVbK8rO2YHfgPbcA&oe=69F49914"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "202501_Goalking_AppStore_2560x1440.png", "id": "1510558696780849", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499295661_1510558700114182_7362275698290106383_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvdQAGD1kCIQ7kNvwFpuUnc&_nc_oc=AdoDbVlgcjaBMVc_d6fhkW7ZdFqED_9cEnY9t6aX2ZaQg2iXYwbwVMVEgnYEBp_8jAc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3caz5G5ELQYGV5pVMasslBnVDoc6uBZaIWK3Tb8iB9dw&oe=69F4C648"}, "display_name": "Goal King", "keywords": ["soccer", "goal", "football", "king", "sport"], "long_description": "In this game, you can play a goalkeeper simulator. The mini-game gets harder over time; if you want an additional challenge, you can adjust the size of the footballs. Try to beat your high score!\nYou can also choose between different ball models.\nThe game is still in development and we are currently improving the game and will in the future.\n", "short_description": "Test your skills as a goalkeeper in this game! Beat your high scores and challenge yourself with multiple difficulty levels."}]}, "d
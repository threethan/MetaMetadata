png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ps4Owu5BmyAQ7kNvwH3vxce&_nc_oc=AdrUMWWHGcLuEqvoT7wTHxilOJ_DHdbbjAbYK-qsxaBIkRygU5jh_k_C5TD7CY30Cuk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k9o2kbgv-AvhLrNhSVyjZ1uaiVyStigkICnGJ7k_0kQ&oe=69FA1318"}, {"file_name": "Captura3.png", "id": "1398865407198674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_1398865410532007_3171647694905464275_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZtwBGu-9CsQ7kNvwHVok43&_nc_oc=AdoTAs7-JLm-hdmWhNz9S7gJ0vZzNi6d8dAMkQTBTEeR0Bbq7Ped-nxquWRPTrOUxG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4puEmWnpdH1czX78vOzjSSsm18fJIpJfO5t9PcO3d5Tg&oe=69F9E44A"}, {"file_name": "Captura4.png", "id": "986812128591165", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572948_986812131924498_1951616489467178268_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B-1kBVZyP8Q7kNvwEAYJa2&_nc_oc=AdosmQ04_LfPFG699sgywm__1_2kQaYQprQLEl0QCjNQB7hpsHwgCTrmjQyFVEBMpUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52J3kj3qVdq3oomYw3P0J_YsKKQYULAjIxaSOBr5E_FQ&oe=69F9EF98"}, {"file_name": "Captura5.png", "id": "1099572100862173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569445_1099572107528839_9081737173627849113_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_omtPIv0SQQ7kNvwGpMUtZ&_nc_oc=AdraApgehpIcG57DG31B8zjWDYBd_SyY-Pzr7EMx1St2G-gLZKQy3J6bkzBEE-QXzxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74tlT5IFU2OwO_Y5wypjPBnXTr8UIEvi4U499pyUKWTA&oe=69F9F288"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_rehametrics_HORIZONTAL.png", "id": "672993257473730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031427_672993260807063_9029047505207585330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk9Q9tw9_2YQ7kNvwFydhQX&_nc_oc=AdoraSg8_p5zDL0UTrVAq1_W_Car3oklygR5GPXj6K1dZ9uPc1Tg85PSTcbTiHfMZjM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zI9L2770RJzg_JFHGWW-k7gn7xCgaAYcqoxunI-C1mQ&oe=69FA0587"}, "display_name": "Rehametrics Clinic VR", "keywords": [], "long_description": "Rehametrics Clinic VR is an app that uses gamified tasks for upper extremity and hand rehabilitation. It is designed to be used with the guidance and prescription of a clinician.\n\nThis application includes clinical exercises to improve hand, finger and shoulder range of motion, coordination and strength. Some of these exercises mix both physical and cognitive objectives while using tasks associated with ADL and gamified environments.\n\n\n\nRehametrics Clinic VR es una aplicaci\u00f3n para la rehabilitaci\u00f3n de las manos y de las extremidades superiores. Est\u00e1 dise\u00f1ada para usarse con el seguimiento y la prescripci\u00f3n de un terapeuta.\n\nEsta aplicaci\u00f3n incluye ejercicios cl\u00ednicos para mejorar el rango articular de manos, dedos y hombros, la coordinaci\u00f3n y la fuerza. Algunos de estos ejercicios mezclan objetivos tanto f\u00edsicos como cognitivos al tiempo que utilizan tareas asociadas a las AVD y entornos gamificados.", "short_description": "Rehametrics Clinic VR is an app that uses gamified tasks for upper extremity and hand rehabilitation. It is designed to be used with the guidance and prescription of a clinician.\n\nRehametrics Clinic VR es una aplicaci\u00f3n para la rehabilitaci\u00f3n de las manos y de las extremidades superiores. Est\u00e1 dise\u00f1ada para usarse con el seguimiento y la prescripci\u00f3n de un terapeuta."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rehametricsresources.blob.core.windows.net/public/okulus/Rehametrics%20Clinic%20VR%20Privacy%20Policy%202022.pdf", "developer_terms_of_service_url": null, "publisher_name": "Rehametrics SL", "support_website_url": null, "website_url": "https://rehametrics.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahLdenMfnpkQ7kNvwHnG0xC&_nc_oc=AdqkpIJJH-p-ea2ueVa01Xzkkn-K4QumgtfM-gzd_1GUlvkCF-2qpujkrn7kjdxqjag&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGaD9Dst_GhHBZcAjQk5oRf2ERF8WOrR-yfy9K0ylrOg&oe=6AF9D618"}, {"file_name": "Captura3.png", "id": "1398865407198674", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982685_1398865410532007_3171647694905464275_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67ikrIJUzQMQ7kNvwFXZr2v&_nc_oc=AdqM5cB12mheFQy9aVL2aydcx4u6buvVkbkO5LX2dKSWnYvpyzFk5SbEjhGt6BeGY9w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpRjdvEdxOxi6W6PmG3ZIEXcK1Gr2Qln6gzmQqppZRrw&oe=6AF9DF8A"}, {"file_name": "Captura4.png", "id": "986812128591165", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572948_986812131924498_1951616489467178268_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1mKbiWI_TgQ7kNvwGAWE9r&_nc_oc=AdpaaIQ8AYi6A2Mg_Vt1AkkRrALsTU6qWP-lpjiLsBxkrydzZtPcUj_2kCbu-6qTC3o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0pri2gn3fP-Jp24gRyw-nh0BjvoGqL5ybO_5iMaRWXg&oe=6AF9EAD8"}, {"file_name": "Captura5.png", "id": "1099572100862173", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57569445_1099572107528839_9081737173627849113_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LsYO9f27ZQQ7kNvwEfAup0&_nc_oc=Adrc4P6ahnccRuo3FqAsoWOI0zu-9n4pO10ySQm8us-KEd0IKhjaZ40eLjj7xrUGKmQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0yb9ONy5o9ypy59iAx7pbSMs1_B9PUK4KCsAYDMJDCA&oe=6AF9EDC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_rehametrics_HORIZONTAL.png", "id": "672993257473730", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031427_672993260807063_9029047505207585330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSIxEJSu5xUQ7kNvwG1KKVM&_nc_oc=AdqQfakKmhVlEHr5-NxHREYC8fmWmyGONADTRdhEzgd_Uh_r15IVvCVbnYnDzPOf2j0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf4TCBQ1wub0vs2upYGm_LvaX7eraePQsS-O-zWvJCAA&oe=6AF9C887"}, "display_name": "Rehametrics Clinic VR", "keywords": [], "long_description": "Rehametrics Clinic VR is an app that uses gamified tasks for upper extremity and hand rehabilitation. It is designed to be used with the guidance and prescription of a clinician.\n\nThis application includes clinical exercises to improve hand, finger and shoulder range of motion, coordination and strength. Some of these exercises mix both physical and cognitive objectives while using tasks associated with ADL and gamified environments.\n\n\n\nRehametrics Clinic VR es una aplicaci\u00f3n para la rehabilitaci\u00f3n de las manos y de las extremidades superiores. Est\u00e1 dise\u00f1ada para usarse con el seguimiento y la prescripci\u00f3n de un terapeuta.\n\nEsta aplicaci\u00f3n incluye ejercicios cl\u00ednicos para mejorar el rango articular de manos, dedos y hombros, la coordinaci\u00f3n y la fuerza. Algunos de estos ejercicios mezclan objetivos tanto f\u00edsicos como cognitivos al tiempo que utilizan tareas asociadas a las AVD y entornos gamificados.", "short_description": "Rehametrics Clinic VR is an app that uses gamified tasks for upper extremity and hand rehabilitation. It is designed to be used with the guidance and prescription of a clinician.\n\nRehametrics Clinic VR es una aplicaci\u00f3n para la rehabilitaci\u00f3n de las manos y de las extremidades superiores. Est\u00e1 dise\u00f1ada para usarse con el seguimiento y la prescripci\u00f3n de un terapeuta."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rehametricsresources.blob.core.windows.net/public/okulus/Rehametrics%20Clinic%20VR%20Privacy%20Policy%202022.pdf", "developer_terms_of_service_url": null, "publisher_name": "Rehametrics SL", "support_website_url": null, "website_url": "https://rehametrics.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
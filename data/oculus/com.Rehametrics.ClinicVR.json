Z0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvZIFL1FA3QdkXKkXEeZn_IUPs7iv9UQ5PjmzgzMKupQA&oe=69A42958"}, {"file_name": "Captura3.png", "id": "1398865407198674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_1398865410532007_3171647694905464275_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDc9Ilqo4lgQ7kNvwElouHA&_nc_oc=AdnaxQ5H16pcRX6Mgpl0s4kROD1HyU321JJ5uHBh7HUF9gJ6mRL1tw8WzsBndJ6g3iA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfueOdCvyn6CMZZFshw36ZTTqg7MvIuQ1xC4w2BXQjMMaA&oe=69A432CA"}, {"file_name": "Captura4.png", "id": "986812128591165", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572948_986812131924498_1951616489467178268_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HibcmrxLQh0Q7kNvwHE2Buf&_nc_oc=AdlO6b5kbD8rg_mQMpNTH0buwJE-PTnLOF0VZk25hNq5Il3fbP-pBxFjsFU5cAoqnRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvT2GUqDFOxTLlZpTbgirfi3PHAGJNjRk9Lx73wrboYCg&oe=69A43E18"}, {"file_name": "Captura5.png", "id": "1099572100862173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569445_1099572107528839_9081737173627849113_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bi3O1s-brwQ7kNvwHAa1VJ&_nc_oc=AdlwURUyVFkzSfB1nV9G2J3BgKW9-V4betxnXqtywOKA0V7LJdUbiNAjYCvtx3qNxPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsrkpUPgITslx3bV-5SfbSgJcRKZyXVLm5O9FY1LiOhwg&oe=69A44108"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_rehametrics_HORIZONTAL.png", "id": "672993257473730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031427_672993260807063_9029047505207585330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8kttkWtZc0Q7kNvwFuPRiv&_nc_oc=AdlqUxhJTJvKfl_CkqOP1_6B6MRKi-lYuZ4TyhXV8x41YrnXxnlF5n_nhhGEQShYBWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afug6a0hxfLO7BV1DxNQUlq3dVM2RXWWGM7b-1-GYYhCsw&oe=69A41BC7"}, "display_name": "Rehametrics Clinic VR", "keywords": [], "long_description": "Rehametrics Clinic VR is an app that uses gamified tasks for upper extremity and hand rehabilitation. It is designed to be used with the guidance and prescription of a clinician.\n\nThis application includes clinical exercises to improve hand, finger and shoulder range of motion, coordination and strength. Some of these exercises mix both physical and cognitive objectives while using tasks associated with ADL and gamified environments.\n\n\n\nRehametrics Clinic VR es una aplicaci\u00f3n para la rehabilitaci\u00f3n de las manos y de las extremidades superiores. Est\u00e1 dise\u00f1ada para usarse con el seguimiento y la prescripci\u00f3n de un terapeuta.\n\nEsta aplicaci\u00f3n incluye ejercicios cl\u00ednicos para mejorar el rango articular de manos, dedos y hombros, la coordinaci\u00f3n y la fuerza. Algunos de estos ejercicios mezclan objetivos tanto f\u00edsicos como cognitivos al tiempo que utilizan tareas asociadas a las AVD y entornos gamificados.", "short_description": "Rehametrics Clinic VR is an app that uses gamified tasks for upper extremity and hand rehabilitation. It is designed to be used with the guidance and prescription of a clinician.\n\nRehametrics Clinic VR es una aplicaci\u00f3n para la rehabilitaci\u00f3n de las manos y de las extremidades superiores. Est\u00e1 dise\u00f1ada para usarse con el seguimiento y la prescripci\u00f3n de un terapeuta."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rehametricsresources.blob.core.windows.net/public/okulus/Rehametrics%20Clinic%20VR%20Privacy%20Policy%202022.pdf", "developer_terms_of_service_url": null, "publisher_name": "Rehametrics SL", "support_website_url": null, "website_url": "https://rehametrics.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", 
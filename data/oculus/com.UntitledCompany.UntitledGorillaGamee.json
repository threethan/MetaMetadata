14_073306.png", "id": "483352854739870", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035413_483352861406536_6744303534838728423_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=or_8Hp2sh64Q7kNvwEg8Xdl&_nc_oc=Adpg0R6W9kfTXy1a3H_Y4SKlk5e4-nJj7B6EERKZmP6FQe4gf6Fa6mBOUuawKHZb81I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0xe7oReX-sIvWVFzOoTapGU_X7YFkiY_KbJ7Nx00BmMA&oe=69F0A1CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Untitled Gorilla Game.", "keywords": [], "long_description": "Dive into a fast-paced, VR multiplayer experience where Gorilla Tag-style locomotion lets you climb, swing, and leap through vibrant arenas! With a variety of game modes, you'll never run out of action! Interactive moderators ensure a fun, fair environment, while new content and surprises keep the gameplay fresh. Get ready to run, jump, and outmaneuver your opponents in this chaotic, competitive playground!", "short_description": "Experience intense VR multiplayer action with Gorilla Tag-inspired locomotion! Swing, climb, and leap through dynamic arenas in multiple game modes. Engage with interactive moderators for a fair and fun environment, and enjoy constant updates to keep the excitement going. Can you outmaneuver your opponents in this fast-paced virtual playground? Jump in and find out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doublegold88.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Doublegold88", "support_website_url": null, "website_url": "https://doublegold88.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_g
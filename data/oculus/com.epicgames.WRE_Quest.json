fcUJIUGs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6M4bBvzn9kgAp9jwa2bducRFUUXPaoJwyxotb7BhGzg&oe=6AA94851"}, {"file_name": "WRE_Screenshot_5.png", "id": "1316595949327517", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982524_1316595952660850_5765538543146256488_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ao4sFx4XEpsQ7kNvwH3juTC&_nc_oc=AdrZh1Ba_nSImDEbc5zwhZpcL1kvamfrxhfY2AWtCyHeZ_19i3yJb7FO0JAn7SZJtVM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8VlzpQJ3R4-QdmpxuQo3xilzQLEmTaL-Qq0NKT5CXAQ&oe=6AA944EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WRE_CoverArt_Meta.png", "id": "540389318795849", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974469_540389322129182_8256867722120283670_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1sGBaAOgmIQ7kNvwG8U8AF&_nc_oc=AdrTFxhgAO3LhVtWpHz1nmiohk9R4BThNAQk1FR_nk8BrJU3bF3FfCcTvXI68wt-HHk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfLG63v5CDHypXKxSbRrbDGTv9O-kwpDKd7Iec934pUg&oe=6AA93758"}, "display_name": "Wild Ride Expedition - Africa", "keywords": [], "long_description": "LET'S GO ON A SAFARI ADVENTURE!\nExperience the adventure of a hunting expedition in the African wilderness.  Drive your off road vehicle through the dusty African bush looking for highly valuable animal trophies.  \n\nSTAY ALERT!\nYou're not he only hunter lurking about.  Be ready to defend yourself and your vehicle from menacing predators.  Survive until you reach the extraction point to keep your valuable trophies.\n\nBECOME A PRO HUNTER\nSometimes being a sharp shooter isn't enough.  Upgrade your equipment to gain an edge.  Improve the performance of your weapons, vehicle, and personnel.  Complete challenges to unlock unique skins for your weapons and vehicle.\n\nENJOY YOUR TROPHY ROOM\nYour most prized trophies are displayed in your home base to relive the experience of the hunt. \n\nIf you enjoyed our game or want to give us some valuable feedback, join us on Facebook.\nhttps://www.facebook.com/profile.php?id=61561158972131\n\n", "short_description": "Drive through the dusty African wilderness collecting valuable animal trophies while defending yourself from menacing predators in this exhilarating extraction, shooter. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zlandgames.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Z-Land Games", "support_website_url": null, "website_url": "http://www.zlandgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7478800875535716"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1123915465784089"}]}, "baseline_offer": {"id": "1123915465784089"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736272800, "status": "PUBLISHED", "id": "1123915465784089"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24175337478788793", "version": "2.2"}, "id": "1090176385407753", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7478800862202384", "is_concept"
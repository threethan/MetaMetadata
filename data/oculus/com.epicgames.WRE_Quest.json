.png", "id": "612782724641801", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031329_612782727975134_3446460324494740140_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B55yFeNayLAQ7kNvwGheVoi&_nc_oc=AdoHYoYtlAmBaCw3lUI_3Zlt832-GOuCUC53bzT9c04forSyJs51n98i6fwUHj1hSb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVGeluVOF1qMcah42bjjhDR21ew0hDt-h2xbd_2dBVu4A&oe=6B105591"}, {"file_name": "WRE_Screenshot_5.png", "id": "1316595949327517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982524_1316595952660850_5765538543146256488_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulRajI4iYjkQ7kNvwG7U0Yc&_nc_oc=AdpVAf7SdCPHhAI02a90BtNkKlZpbAWNfRB37V6eReFvIj_KeA070vowUBq5z1Jmq6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW6Bl9YfrhvjKyNlZcQSUKdO4XGGpK46_UMTcBliZHDSA&oe=6B10522B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WRE_CoverArt_Meta.png", "id": "540389318795849", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_540389322129182_8256867722120283670_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7yEG2qtK94Q7kNvwE8fTkP&_nc_oc=AdoXtlbu0s5Bs5qXbwca84HjPw5c1Y-OIplkL-btn-yZ-SrwziHAAHTc1QV3Q_RJsMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUlH1e98OOs8BW0h3cJ9_jnD69w3nLyBPCZKwixLuNc0g&oe=6B104498"}, "display_name": "Wild Ride Expedition - Africa", "keywords": [], "long_description": "LET'S GO ON A SAFARI ADVENTURE!\nExperience the adventure of a hunting expedition in the African wilderness.  Drive your off road vehicle through the dusty African bush looking for highly valuable animal trophies.  \n\nSTAY ALERT!\nYou're not he only hunter lurking about.  Be ready to defend yourself and your vehicle from menacing predators.  Survive until you reach the extraction point to keep your valuable trophies.\n\nBECOME A PRO HUNTER\nSometimes being a sharp shooter isn't enough.  Upgrade your equipment to gain an edge.  Improve the performance of your weapons, vehicle, and personnel.  Complete challenges to unlock unique skins for your weapons and vehicle.\n\nENJOY YOUR TROPHY ROOM\nYour most prized trophies are displayed in your home base to relive the experience of the hunt. \n\nIf you enjoyed our game or want to give us some valuable feedback, join us on Facebook.\nhttps://www.facebook.com/profile.php?id=61561158972131\n\n", "short_description": "Drive through the dusty African wilderness collecting valuable animal trophies while defending yourself from menacing predators in this exhilarating extraction, shooter. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zlandgames.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Z-Land Games", "support_website_url": null, "website_url": "http://www.zlandgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7478800875535716"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1123915465784089"}]}, "baseline_offer": {"id": "1123915465784089"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736272800, "status": "PUBLISHED", "id": "1123915465784089"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "bin
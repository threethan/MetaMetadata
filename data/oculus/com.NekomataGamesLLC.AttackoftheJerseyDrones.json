zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcT3YufuUv9-fWgnwT4DljMhq9-YKYacQT47enQutxrw&oe=6B0B33CC"}, {"file_name": "Attack of the Jersey Drones - Screenshot - 04 (2K).png", "id": "1157389179215788", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392028_1157389182549121_247136915608063211_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuSF4ZavIWEQ7kNvwEOu_47&_nc_oc=Adrz2z_Mwg-sDv-CCxKqvZ33WnwgZKFLk9NFtoFtSf8M-q_mW7QfK9gzpSFOjhqWcQ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQpesftTL4EqYwyI4-6PLjzCJemHd3Rc07O6aF4138qDw&oe=6B0B3B38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainImage_Meta_2560x1440.png", "id": "1118660673326412", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393713_1118660676659745_5147356761935099200_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN-hf-qKwm4Q7kNvwEYbGGm&_nc_oc=Adq-NrpuUPfkHJ0UZ8POgZrhWtixnWaXIiIM2ZbDKCagxPS7WMJNpfyw_l1qHhFjnU4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9Ffmk3g8o__kEJXVYLKEIyN0MjaB8xYzJaiHKFjGVbQ&oe=6B0B27CD"}, "display_name": "Attack of the Jersey Drones", "keywords": ["meme", "drones", "political", "funny", "freedom"], "long_description": "ATTACK OF THE JERSEY DRONES is a short and simple Virtual Reality game about FREEDOM and PRIVACY!\n\nAs a retired war veteran, all you wanted was to live the rest of your days out in peace and quiet. Unfortunately for you, a swarm of drones (WHO COULD THEY POSSIBLY BE?) won't leave you alone. So there's only one thing to do. DEFEND. YOUR. FREEDOM!\n\n- 15 to 30 minutes of pure patriotism!\n- Shoot down an aggressive hoard of drones invading your neighborhood\n- Unlock various classic American firearms (M1911, M16A1, UZI, M134 Minigun)\n- Simple, easy-to-understand gameplay\n- Roomscale experience. No need to worry about motion sickness!", "short_description": "As a retired war veteran, all you wanted was to live the rest of your days out in peace and quiet. Unfortunately for you, a swarm of drones (WHO COULD THEY POSSIBLY BE?) won't leave you alone. So there's only one thing to do. DEFEND. YOUR. FREEDOM!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8822674014509668"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473394202_1359210858826012_4136444792959156349_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyDRUpKa7L4Q7kNvwE7q813&_nc_oc=AdqTeooFeYYhKfiYpV0ImAM7lSv5CuU5wtPqmCAkGveH0QqNNBtPge3PKwq5RNIBs3g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSalmBbCBmP4jXWnmdCJfV-VSmSsE_eQAo6pYIZgRY_g&oe=6B0B2D54"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Attack of the Jersey Drones", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic
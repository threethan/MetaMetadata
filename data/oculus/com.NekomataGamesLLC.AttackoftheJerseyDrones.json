.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WyYd8xNMOYB9LJ0DUIWRbC1TUVVPwUS0JhP0Zx9DE5g&oe=6A22FAF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainImage_Meta_2560x1440.png", "id": "1118660673326412", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473393713_1118660676659745_5147356761935099200_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwO7gkwNWT0Q7kNvwGjXE3w&_nc_oc=Adok3wOn-cmtV508T5pf-TU0x6tcSkyMAv-YkOAJFtlXr_cT0qGrbGBMjD21M3-P-zw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zgz9VeNA26m3auhF52uKlco2sWvW0M3IUd3sRPiaFlA&oe=6A22E78D"}, "display_name": "Attack of the Jersey Drones", "keywords": ["meme", "drones", "political", "funny", "freedom"], "long_description": "ATTACK OF THE JERSEY DRONES is a short and simple Virtual Reality game about FREEDOM and PRIVACY!\n\nAs a retired war veteran, all you wanted was to live the rest of your days out in peace and quiet. Unfortunately for you, a swarm of drones (WHO COULD THEY POSSIBLY BE?) won't leave you alone. So there's only one thing to do. DEFEND. YOUR. FREEDOM!\n\n- 15 to 30 minutes of pure patriotism!\n- Shoot down an aggressive hoard of drones invading your neighborhood\n- Unlock various classic American firearms (M1911, M16A1, UZI, M134 Minigun)\n- Simple, easy-to-understand gameplay\n- Roomscale experience. No need to worry about motion sickness!", "short_description": "As a retired war veteran, all you wanted was to live the rest of your days out in peace and quiet. Unfortunately for you, a swarm of drones (WHO COULD THEY POSSIBLY BE?) won't leave you alone. So there's only one thing to do. DEFEND. YOUR. FREEDOM!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "conte
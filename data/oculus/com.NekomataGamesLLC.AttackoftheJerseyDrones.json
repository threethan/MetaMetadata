2028_1157389182549121_247136915608063211_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGklonyxXEkQ7kNvwEUGMPy&_nc_oc=Adoka-eX0BSb3BcbxKZ0qIBTy2nyHCQ1Q7ald8j_2nDzheTEIgXCFnbVw-H8vImcTgs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfLxzed2oM-uh5CrKEPcUB2CdxIsT0lxP4NRqvfAH_IQ&oe=6A577EB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainImage_Meta_2560x1440.png", "id": "1118660673326412", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393713_1118660676659745_5147356761935099200_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dxuq7Az6SmIQ7kNvwG3G4za&_nc_oc=Ado6WneD3flU9aexDXGOBhoVPVy7Ck47H6yD7Ju8V98GRYT6kLeblSwKcBr64ytTwAM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbcptwXRhkx-h6kPZL51ac3Gkzkp8oe0LKuXNIdG-ySQ&oe=6A576B4D"}, "display_name": "Attack of the Jersey Drones", "keywords": ["meme", "drones", "political", "funny", "freedom"], "long_description": "ATTACK OF THE JERSEY DRONES is a short and simple Virtual Reality game about FREEDOM and PRIVACY!\n\nAs a retired war veteran, all you wanted was to live the rest of your days out in peace and quiet. Unfortunately for you, a swarm of drones (WHO COULD THEY POSSIBLY BE?) won't leave you alone. So there's only one thing to do. DEFEND. YOUR. FREEDOM!\n\n- 15 to 30 minutes of pure patriotism!\n- Shoot down an aggressive hoard of drones invading your neighborhood\n- Unlock various classic American firearms (M1911, M16A1, UZI, M134 Minigun)\n- Simple, easy-to-understand gameplay\n- Roomscale experience. No need to worry about motion sickness!", "short_description": "As a retired war veteran, all you wanted was to live the rest of your days out in peace and quiet. Unfortunately for you, a swarm of drones (WHO COULD THEY POSSIBLY BE?) won't leave you alone. So there's only one thing to do. DEFEND. YOUR. FREEDOM!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_se
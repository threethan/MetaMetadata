2028_1157389182549121_247136915608063211_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7USu-Ymf6UQ7kNvwHLN0XD&_nc_oc=AdpBWbqQmkobMc_vO7h7RUE1dKXfumiHrQpTkCvr6HXgZVMe0SxHmiK1uL0xHUE6leY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO8NIMM7gmsEuRh2p5S7iCXoULLYlt-BeleJesyIBTxQ&oe=6ADF4938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainImage_Meta_2560x1440.png", "id": "1118660673326412", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393713_1118660676659745_5147356761935099200_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92fHa6keNAsQ7kNvwEvg4Zp&_nc_oc=Adpl56kD48XagolBw5yECHrXlAUNp3v3VO_hdG351hBwBkBRuN9VZSGAWQC9vyyLWAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNb5bPmEcbXdWcT-JYyQtXq7uA_cQj8AKMf9Ce-VMUW8w&oe=6ADF6E0D"}, "display_name": "Attack of the Jersey Drones", "keywords": ["meme", "drones", "political", "funny", "freedom"], "long_description": "ATTACK OF THE JERSEY DRONES is a short and simple Virtual Reality game about FREEDOM and PRIVACY!\n\nAs a retired war veteran, all you wanted was to live the rest of your days out in peace and quiet. Unfortunately for you, a swarm of drones (WHO COULD THEY POSSIBLY BE?) won't leave you alone. So there's only one thing to do. DEFEND. YOUR. FREEDOM!\n\n- 15 to 30 minutes of pure patriotism!\n- Shoot down an aggressive hoard of drones invading your neighborhood\n- Unlock various classic American firearms (M1911, M16A1, UZI, M134 Minigun)\n- Simple, easy-to-understand gameplay\n- Roomscale experience. No need to worry about motion sickness!", "short_description": "As a retired war veteran, all you wanted was to live the rest of your days out in peace and quiet. Unfortunately for you, a swarm of drones (WHO COULD THEY POSSIBLY BE?) won't leave you alone. So there's only one thing to do. DEFEND. YOUR. FREEDOM!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_se
sid=6e7a0a&_nc_ohc=_VDpeOgmP7wQ7kNvwFsB2YE&_nc_oc=AdoBpn-xHMcoyXV59fDjdwVLAdI8PXjQBmjtsTRKHGHojT6IA5CCMNZwnPaxW94vmbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3C_kAYKsmEjijsxtGUjhYmJT2iy6fMuHjLZg9MjCOwg&oe=6B04640C"}, {"file_name": "Attack of the Jersey Drones - Screenshot - 04 (2K).png", "id": "1157389179215788", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392028_1157389182549121_247136915608063211_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Th8ANj_MEiwQ7kNvwEfcDfp&_nc_oc=Adoyis2h-jH7BCF0ojATrnyByp5ds4f2ypR1fX2C-zkNIhlyu4dgleaMAAj1YBMPRVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYPsURKbNRrI7Y2JzogbHz9yMVZEby_nyF4Iv4OKaDbw&oe=6B046B78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainImage_Meta_2560x1440.png", "id": "1118660673326412", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393713_1118660676659745_5147356761935099200_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0yzNmbsyQ0Q7kNvwER8aDB&_nc_oc=AdoiNtrAWLpRcn-WXXiF5irspCjSG9SwQp5CGtrnIYopeeUfY1nakNkwpPitACbTisk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGuEnb8LFc80DaR-unTNlQ5TBeN4qzCaBTK1BG-OWm0g&oe=6B04580D"}, "display_name": "Attack of the Jersey Drones", "keywords": ["meme", "drones", "political", "funny", "freedom"], "long_description": "ATTACK OF THE JERSEY DRONES is a short and simple Virtual Reality game about FREEDOM and PRIVACY!\n\nAs a retired war veteran, all you wanted was to live the rest of your days out in peace and quiet. Unfortunately for you, a swarm of drones (WHO COULD THEY POSSIBLY BE?) won't leave you alone. So there's only one thing to do. DEFEND. YOUR. FREEDOM!\n\n- 15 to 30 minutes of pure patriotism!\n- Shoot down an aggressive hoard of drones invading your neighborhood\n- Unlock various classic American firearms (M1911, M16A1, UZI, M134 Minigun)\n- Simple, easy-to-understand gameplay\n- Roomscale experience. No need to worry about motion sickness!", "short_description": "As a retired war veteran, all you wanted was to live the rest of your days out in peace and quiet. Unfortunately for you, a swarm of drones (WHO COULD THEY POSSIBLY BE?) won't leave you alone. So there's only one thing to do. DEFEND. YOUR. FREEDOM!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nekomatagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Nekomata Games LLC", "support_website_url": null, "website_url": "https://nekomatagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8822674014509668"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1564136360938986"}, {"status": "PUBLISHED", "id": "994954665928683"}]}, "baseline_offer": {"id": "994954665928683"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744995600, "status": "PUBLISHED", "id": "1564136360938986"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24560578276959322", "version": "1.0.2"}, "id": "3666461686830950", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary
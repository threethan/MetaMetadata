1VM7zFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft5RvzbLTP8UVeDDeD1JFDANSa3ajTDTtRyoj_I91Jvuw&oe=69A4475D"}, {"file_name": "screen3.png", "id": "913630351176538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618472_913630354509871_327748029909089271_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhNK4B0ik64Q7kNvwFe4KCD&_nc_oc=AdmQLfHOCnUlOkHEnAw4dlrXXUqMNe97Rifl47YAs6hgB2RNk5gp_bvM1YwJSz7Nkjs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft9efXGuQLem2S2maHn99TnxpeeHIdCtT43483tHXtdjw&oe=69A4297C"}, {"file_name": "screen4.png", "id": "1299514725327559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619174_1299514728660892_3218217996615132690_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvkZrTSOlQYQ7kNvwGOFHNn&_nc_oc=AdmzlbyELtjmX6XmKqsBqP2gsmg0rS9B6XcPIByo3OQCCLHqY4vwWGdyd-cyd8QaTJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfucT2ar8GXvf5UjqKQmOfaP9Hqzby5UYUrjzR49XV3Tkg&oe=69A43F80"}, {"file_name": "screen9.png", "id": "1948725762708703", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618284_1948725766042036_3395648209226047057_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfP347Y3YhMQ7kNvwH3thxi&_nc_oc=AdmSqvyWgLW0-VtpJ5z8WRCXnRRzgzPPf-eZXRtTFpbZ1wg4JARIO2UCrxEQ5TG2czY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuVaH6ix9r7jtqtuqoGxvUW3aJxni1y-fsV0p64fOrXXw&oe=69A4485B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Machine", "keywords": ["Concert", "Performance", "Arts", "Experience", "Live"], "long_description": "**DREAM MACHINE** is a music-driven Virtual Reality experience born from the visionary mind of Nona Hendryx\u2014legendary artist, songwriter, and member of Labelle.\n\nStep into an imaginative world rooted in Afro-Futurism, where dreamers can gather, connect, and watchtogether. At the heart of this experience is the **Cyboracle**\u2014Nona's digital avatar\u2014performing original music in a handcrafted virtual environment.\n\n**Virtual Concerts** \n\nWatch the Cyboracle perform in stunning, custom-designed environments. A pre-recorded show you can experience anytime, alone or with others.\n\n**Live Performances**\n\nJoin real-time concert events where Nona performs as the Cyboracle. A shared experience with fellow Dreamers from around the world.\n\n**Multiplayer**\n\nExperience concerts together. Gather with your community in virtual space.\n", "short_description": "A music-driven Virtual Reality experience from the mind of Nona Hendryx. Step an imaginative world rooted in Afro-Futurism and witness the Cyboracle\u2014Nona's digital avatar\u2014perform in a bespoke, handcrafted environment. Experience pre-recorded concerts or join live performances with others. An ambitious synthesis of legendary artistry and future-forward technology that invites you to imagine another world is possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreammachinevr.eyejack.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "EyeJack", "support_website_url": null, "website_url": "https://dreammachinevr.eyejack.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25787350604218012"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2120134505479969"}]}, "baseline_offer": {"id": "2120134505479969"}, "is
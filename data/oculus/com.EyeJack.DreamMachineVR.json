png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ahP4yTt1EcQ7kNvwEJ7TI8&_nc_oc=AdpA4QRvaLkRzSfdYeL39RC0t75wVosid6MYVn3Bi-1cKDuGRpuFGe8kx9q2ob9MPsA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnyoEttSslDra0eorcKiAdh6fs5lIbLYgecqZyYvxYcA&oe=6AAEB0BC"}, {"file_name": "screen4.png", "id": "1299514725327559", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619174_1299514728660892_3218217996615132690_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reb49LWEtWwQ7kNvwHmkRwS&_nc_oc=AdquYo2DZVLDD65DZh8-0NzHWhPwF3ARzPRkibV9dvgSTHMvhTwOf3xVtjleNcLWH3o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRVl1U85QtbdQRe9XLVicbyBf3neLsdDc4G-tac3wQvQ&oe=6AAE8E80"}, {"file_name": "screen9.png", "id": "1948725762708703", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618284_1948725766042036_3395648209226047057_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txjWch46dWIQ7kNvwHE43ft&_nc_oc=AdrWpJXsJTJRxo3lWsotKyAK1zWyTgU1Zl6TYdYWjRs0FWRwH27B-blKR4bagx0V8M0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJezf8OdGvizo1BrIcxY_U8kTvfEFN4dPEEEXjGKVUO7A&oe=6AAE975B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Machine", "keywords": ["Concert", "Performance", "Arts", "Experience", "Live"], "long_description": "**DREAM MACHINE** is a music-driven Virtual Reality experience born from the visionary mind of Nona Hendryx\u2014legendary artist, songwriter, and member of Labelle.\n\nStep into an imaginative world rooted in Afro-Futurism, where dreamers can gather, connect, and watchtogether. At the heart of this experience is the **Cyboracle**\u2014Nona's digital avatar\u2014performing original music in a handcrafted virtual environment.\n\n**Virtual Concerts** \n\nWatch the Cyboracle perform in stunning, custom-designed environments. A pre-recorded show you can experience anytime, alone or with others.\n\n**Live Performances**\n\nJoin real-time concert events where Nona performs as the Cyboracle. A shared experience with fellow Dreamers from around the world.\n\n**Multiplayer**\n\nExperience concerts together. Gather with your community in virtual space.\n", "short_description": "A music-driven Virtual Reality experience from the mind of Nona Hendryx. Step an imaginative world rooted in Afro-Futurism and witness the Cyboracle\u2014Nona's digital avatar\u2014perform in a bespoke, handcrafted environment. Experience pre-recorded concerts or join live performances with others. An ambitious synthesis of legendary artistry and future-forward technology that invites you to imagine another world is possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreammachinevr.eyejack.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "EyeJack", "support_website_url": null, "website_url": "https://dreammachinevr.eyejack.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25787350604218012"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2036699336965118"}, {"status": "PUBLISHED", "id": "2120134505479969"}]}, "baseline_offer": {"id": "2036699336965118"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773065040, "status": "PUBLISHED", "id": "2036699336965118"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": 
oc=AdkIKK3wA8iWO8meOAiOrcckSUmShuMdFyIWVcyrUm4_hibfOhlA_BU6n2GuPjK6n34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs5de51uDiZXgq5oL7CyPqpwrMj5QKfxsy2P7VKx-8Hhw&oe=69A98D5D"}, {"file_name": "screen3.png", "id": "913630351176538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618472_913630354509871_327748029909089271_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCf1-eUjW_AQ7kNvwGC7zJ7&_nc_oc=AdmBJOdVrF9AHFqhLMML-G_E1NUs7KkxqIaC_a92mOrzOOJAKzkgwElR-mxIOhouVZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvlrM-FQP0Vkg0MLzggTDkyhMmZ7caqol5vFAvVIo9_tg&oe=69A96F7C"}, {"file_name": "screen4.png", "id": "1299514725327559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_1299514728660892_3218217996615132690_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKWKO46gtRAQ7kNvwGPmHig&_nc_oc=Adnjksn9v07l3ukg8w4mVW-RkoO1w-gG1RVM45T5kwqFiKKc8wgsHbO1E4SdqHsSm4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsrwuEhYJul4rZvJLyY-wbXrPKPqNeERs8YgniVKQczcw&oe=69A98580"}, {"file_name": "screen9.png", "id": "1948725762708703", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618284_1948725766042036_3395648209226047057_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsCWae2HLkkQ7kNvwG1QjtA&_nc_oc=AdlMtGi1tkk6kEJiW9X44Hsz1onRZARbyUcNiQFamvFhEXdquLdy3mmhDIY-jN8QlM4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsndpnNcZiIVKUsnkyMzK7qpmpZOOWA-m3aJpPCaxxWKQ&oe=69A98E5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dream Machine", "keywords": ["Concert", "Performance", "Arts", "Experience", "Live"], "long_description": "**DREAM MACHINE** is a music-driven Virtual Reality experience born from the visionary mind of Nona Hendryx\u2014legendary artist, songwriter, and member of Labelle.\n\nStep into an imaginative world rooted in Afro-Futurism, where dreamers can gather, connect, and watchtogether. At the heart of this experience is the **Cyboracle**\u2014Nona's digital avatar\u2014performing original music in a handcrafted virtual environment.\n\n**Virtual Concerts** \n\nWatch the Cyboracle perform in stunning, custom-designed environments. A pre-recorded show you can experience anytime, alone or with others.\n\n**Live Performances**\n\nJoin real-time concert events where Nona performs as the Cyboracle. A shared experience with fellow Dreamers from around the world.\n\n**Multiplayer**\n\nExperience concerts together. Gather with your community in virtual space.\n", "short_description": "A music-driven Virtual Reality experience from the mind of Nona Hendryx. Step an imaginative world rooted in Afro-Futurism and witness the Cyboracle\u2014Nona's digital avatar\u2014perform in a bespoke, handcrafted environment. Experience pre-recorded concerts or join live performances with others. An ambitious synthesis of legendary artistry and future-forward technology that invites you to imagine another world is possible."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dreammachinevr.eyejack.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "EyeJack", "support_website_url": null, "website_url": "https://dreammachinevr.eyejack.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25787350604218012"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"s
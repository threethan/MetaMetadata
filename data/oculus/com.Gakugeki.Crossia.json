QEmTV-yb-OdXWjx3hM6hsb11JTpn2YvxUeBPfE4aCTuaA&oe=6A7C4CDA"}, {"file_name": "4.png", "id": "1349962170298913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831056_1349962173632246_1683676009474194531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_lrobj1kJwQ7kNvwEx5suU&_nc_oc=AdoySDnZAbsgfd_a0wbyEaMLYw_HWYsHvA7Zm3hqpz6DP34YsOdMGHdkc87IEEDZ44w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElyrKGknjsKg-Ih0Pcw35cl59NcBJLq3miXzdchAwtGg&oe=6A7C764E"}, {"file_name": "Image_Sequence_090_0120.png", "id": "1629975598289881", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620504_1629975601623214_3077587533505430695_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeHFvFrX2dgQ7kNvwHB5eW_&_nc_oc=Ado4xTGvi283etdm2IOM0OepfhQmfVsWH7n7KK7a3RcvWTa8a0O60n6pNdhW_6v1mx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8wu2PVn3tEjGviqF26KeJcj1ogZ4sPZi76VGWQaUmqQ&oe=6A7C7149"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CROSSIA", "keywords": [], "long_description": "CROSSIA is a VR entertainment platform where fans can step into a character\u2019s world and enjoy special experiences in immersive virtual spaces.\n\nInside CROSSIA, you can purchase in-app coins, use them to get tickets, and join character-focused experiences such as VR photo sessions, autograph-style events, and more.\n\nDesigned for fans who want more than simply watching from a distance, CROSSIA offers a new way to feel closer to the characters and worlds you love.\n\nExperiences may include:\n\n\u2022 VR photo sessions in themed virtual spaces\n\u2022 Autograph-style character events\n\u2022 Ticket-based access to special experiences\n\u2022 Ongoing events and new character content\n\nCROSSIA is currently available as a beta version. Experiences, characters, and features may be updated over time.", "short_description": "CROSSIA Beta is a VR entertainment platform where fans can meet their favorite characters and enjoy immersive experiences such as VR photo sessions and autograph-style events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gakugeki.biz/en/privacy-policy", "developer_terms_of_service_url": "https://www.gakugeki.biz/en/terms-of-service", "publisher_name": "Gakugeki Inc.", "support_website_url": null, "website_url": "https://www.gakugeki.biz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26978229205174568"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623601_26574740198893949_767464938231577622_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jb0eHjv0eCwQ7kNvwHuTA5o&_nc_oc=Ado0d-6YPXYVhjhj09JhjgH_bUL1UP0i22meNHVx7vMYjNA-duQRFB5J18GqRRJMTos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE06q897npw_fO0Fjd-rwEBf4w4rYdpCYC9WH8ltMUdPw&oe=6A7C6420"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CROSSIA", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Events", "id": "2687655338230691"}], "release_date": 1780074000, "lastRevision": {"nodes": [{"id": "26532568579740635", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": 
ZxlHl8_GnbWpVJSTsoFP-M2Fat7twENRGv2y_kLsFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRd_wGenBC4ef1jQDU--qsqtxYEpMSdbPzdczdHyaSXw&oe=6AFDB954"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499619805_1159090093106379_1744562832788334874_n.png", "id": "1743246113488172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620559_1743246116821505_7028789490726194083_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jE5u5NSjUkQ7kNvwG5k-6r&_nc_oc=Adri4o9LjlcJ9G_VDEkHlpPYRQq-xdAxrqeyw2wnEUDn3-UW6KNv625WrhUv9gUPZgY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUu3PfuK7RytRRJzH1trpYOyoEt3Qpd6yjAK9G6J4U6w&oe=6AFDC4EB"}, "display_name": "CROSSIA", "keywords": [], "long_description": "* This app is designed for fans of specific works and characters. It may not be enjoyable for everyone like a general game. Please check the current booth list before purchasing. More content is planned.\n\nCROSSIA is a Web & XR entertainment platform for fans who want to experience characters and their worlds in a closer, more special way.\n\nCurrent booths:\n\u2022 Aoyagi Kaiya (3D): Ended\n\u2022 Afro Samurai (2D): Available\n\u2022 Sayo / SAYO (3D): Available\n\u2022 Gomano Rio (2D): Available\n\u2022 Mashiro Io (2D): Available\n\u2022 Yamabuki Shion (2D): Available\n\u2022 EiL (2D): Available\n\u2022 KIRA (2D): Available\n\nMain experiences:\n1. VR photo sessions in themed virtual spaces\n2. Ticket-based special fan experiences\n3. Ongoing events and new character content\n\nThis app is not fan-made or derivative. It is provided through official collaborations, so available experiences are limited to currently collaborating anime works, VTubers, and creators.\n\nDepending on the work or character, the VR photo booth may use either a 2D panel or a 3D model. 2D panel booths are also designed for clear and attractive VR photos.\n\nTo join experiences, you need tickets inside VR. Your first app purchase includes 500 coins, usable for tickets worth 500 coins. Additional coins can be purchased in VR as needed.\n\nCROSSIA is currently available as a beta version. Experiences, characters, and features may be added or updated over time.", "short_description": "CROSSIA Beta is a ticket-based Web & XR entertainment platform where fans can step into the worlds of their favorite anime, manga, illustration, and VTuber characters, and enjoy immersive experiences such as VR photo sessions and autograph events. This is the XR version of CROSSIA."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gakugeki.biz/en/privacy-policy", "developer_terms_of_service_url": "https://www.gakugeki.biz/en/terms-of-service", "publisher_name": "Gakugeki Inc.", "support_website_url": null, "website_url": "https://www.gakugeki.biz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28001372486193563"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623601_26574740198893949_767464938231577622_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFiLAI9Lsa8Q7kNvwFuCGsF&_nc_oc=AdrsiCAM1BkEdMhMY9jcParZ3VEC3VUSUfPh4Us_wBL8x1TCg8ezHG6Ohv6RCl6nqFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSrlEMLROsjY5pX0EWKTOG5mssxg_PNm0
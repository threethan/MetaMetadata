QEqv61Hw_B8U8uFI7PbNgfA0QmwgnAVT49g3sFXbuVSiw&oe=6A8192DA"}, {"file_name": "4.png", "id": "1349962170298913", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491831056_1349962173632246_1683676009474194531_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irWvOUeuTL0Q7kNvwFy7oPn&_nc_oc=AdrpJv93H5b22oa-VqPASM9OsOZaFsdnQjnqdy-dT25RoAGXWiFhmYGt4rOcsDg4JWw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzbN2CZ-7YFeks_mW3AcFEpL2JUZ3T_Uo5xCwHsFe8CQ&oe=6A81BC4E"}, {"file_name": "Image_Sequence_090_0120.png", "id": "1629975598289881", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620504_1629975601623214_3077587533505430695_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tqLb0J3j1IQ7kNvwFx5_Zw&_nc_oc=Ado9NxsMYGMLgYSDSR7T02bU2j87G5yHeq3iWKxWVIym-jfUJC_t9pXDuuIaqvcx0k4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpAzsXli-WTq_vK5hafKIntw_D70EwThDGIPN8vy6dYQ&oe=6A81B749"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CROSSIA", "keywords": [], "long_description": "CROSSIA is a VR entertainment platform where fans can step into a character\u2019s world and enjoy special experiences in immersive virtual spaces.\n\nInside CROSSIA, you can purchase in-app coins, use them to get tickets, and join character-focused experiences such as VR photo sessions, autograph-style events, and more.\n\nDesigned for fans who want more than simply watching from a distance, CROSSIA offers a new way to feel closer to the characters and worlds you love.\n\nExperiences may include:\n\n\u2022 VR photo sessions in themed virtual spaces\n\u2022 Autograph-style character events\n\u2022 Ticket-based access to special experiences\n\u2022 Ongoing events and new character content\n\nCROSSIA is currently available as a beta version. Experiences, characters, and features may be updated over time.", "short_description": "CROSSIA Beta is a VR entertainment platform where fans can meet their favorite characters and enjoy immersive experiences such as VR photo sessions and autograph-style events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gakugeki.biz/en/privacy-policy", "developer_terms_of_service_url": "https://www.gakugeki.biz/en/terms-of-service", "publisher_name": "Gakugeki Inc.", "support_website_url": null, "website_url": "https://www.gakugeki.biz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26978229205174568"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499623601_26574740198893949_767464938231577622_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EepdKsLNS7MQ7kNvwEUAMx9&_nc_oc=AdrwvNxZ-oC9c-8Q_Rzu6skFxypKffM16ejbrIPrn9xkrwtb32mXz8YIdMXwe6DcAuY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGScfz0AlnMKMSPBTFIfQAHEr4nF91fTGfL19lwsTFibw&oe=6A81AA20"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CROSSIA", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Events", "id": "2687655338230691"}], "release_date": 1780074000, "lastRevision": {"nodes": [{"id": "26532568579740635", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": 
5771-25/491827646_922365710891717_2444198043335137829_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-3q18ZYIroQ7kNvwHv1yhS&_nc_oc=AdpyYPY5H5NYGxTOnz-41G0-cnxFDWifT41pG18IdScba8KD2H0uI111o0FhDpn-y30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYGhvpBFePd2mW6qW6Usq_ST89ajMpaeontB2SAIC77A&oe=6A9EE08D"}, {"file_name": "5.png", "id": "2043653249592516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_2043653252925849_7889331218216339855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_Hxf2U0wNEQ7kNvwEHhS7g&_nc_oc=AdointUzXXdrpnfIQBlnDGQ6JE3GoMRI2dfaa1R8io49WyjxFXIBBsSV5h7mkSc1J3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcI-3HKKFlDADwUsRVj8MPFSwDP3PWQ8m4zUA0jlAgIg&oe=6A9EE2FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo-Wide-con-Scritta-_Personalizzato_.png", "id": "2108764886571756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827626_2108764889905089_5789425334365975714_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqahN4jRAvsQ7kNvwE-WPVY&_nc_oc=Ado_lzsQHcgacHo7WBWjLCSkgj9yh5fUf3A_nS6-4FUjaO1TQZa4VLeGynqi3OxRnQw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeCZM9pK917_Dk3tckasBNkWKCcm1x2ClVtXJBbCL6mA&oe=6A9EDD2A"}, "display_name": "HoloPets: AR Pet Simulator", "keywords": ["Pet", "Cat", "Dog", "Simulator"], "long_description": "\ud83d\udc31\ud83d\udc36\u2728 **HoloPets** is the ultimate Augmented Reality pet simulator that brings adorable cats and dogs to life inside your home, with **more than 20 pets** to choose from.\n\n**Your virtual pets don\u2019t stay on a screen**: they roam your real room, jump on the couch, chase toys on the floor, and react to everything you do. \n\n**Each pet has unique characteristics, moods, and needs**: some are playful, others lazy, some curious and affectionate.\n\nTake care of your HoloPet every day:\n\n- **Feed them** with delicious food.\n- **Play fetch, laser pointer, ball games** and much more!\n- **Manage hunger, energy and happiness**.\n\nThe more you care for them, the stronger your bond becomes. Unlock new accessories, clothes, special behaviors and surprising evolutions!\n\n**Key Features:**\n\n- **Realistic Environmental Interaction** : pets intelligently navigate and interact with your actual surroundings.\n- **Cats & Dogs with Personality** : choose from more than 20 pets, with dozens of breeds and distinct characters.\n- **Deep Care System** : nutrition, play, rest and affection.\n- **Offline Progression** : your pet\u2019s needs continue to evolve even while you\u2019re offline.\n- **Bonding & Progression** : pets grow, learn, and surprise you over time.\n- **Voice Commands**:  interact naturally with your pet using your voice.\n- **Daily Challenges** : complete exciting daily and weekly challenges to earn rewards, strengthen the bond and unlock new content.\n- **Mini-games** :  enjoy fun mini-games like fetch challenges, obstacle courses, puzzle toys and more.\n\nAdopt your holographic pet today! \ud83d\udc31\ud83d\udc36 ", "short_description": "Adopt adorable virtual cats and dogs that come alive in your real home! \n\nChoose from more than 20 pets and enjoy an AR pet simulator where your holographic companions interact naturally with your environment, chasing toys across the floor, lounging on your furniture, and responding to your movements. \n\nFeed them, play with them, groom them, and build a unique bond with creatures that have their own personalities. \n\nUnlock new accessories, clothes, special behaviors and surprising evolutions!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cyberbitgenesis.com/holopets-privacy-policy/", "developer_terms_of_service_url": "https://cyberbitgenesis.com/holopets-terms-of-services/", "publisher_name": "Cyberbit Genesis", "support_website_url": "https://cyberbitgenesis.com/holopets-feedback/", "website_url": "https://cyberbitgenesis.com/", "category": null, "comfort_rating"
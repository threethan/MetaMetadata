rated_image.png", "id": "677610226319421", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QyT87zwsOYQ7kNvwFmIivN&_nc_oc=AdrXBCqbuL3AMIAeEZ_J9rQxREyl5v9VUrrX21MNgmpB_SgOszf1MbkvXgeyd3U5sMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TycULAATVD-JhSPnyQT4vtUOI8zuNltFDM6vyFyOaIQ&oe=69D8DC0D"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYjlcHvhqg0Q7kNvwE6TgqI&_nc_oc=AdojiTvH-QKalhdYYAPQMbPSVs1bglEiXGeB4AiuDT1wFdzHoCbuqwA5gPyiFjZnIMU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V9ULoq5mT1cXCUm4b588yupv-riUV_GvGsEbTnUfF_Q&oe=69D90D1A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6qXizDcR8UQ7kNvwEDkRWb&_nc_oc=AdrBGK4sUrHwtF1XfPxZC9rzCbncu2Di98NZSyN3tqFw9buguEWGq2ZOgPxBwG2QgFs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gURqkrv3tB4ZMM__cPpl9QaIVrUFUqoBbUpUa6G244Q&oe=69D8DDE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot, Bandit Six delivers intense first-person aerial combat in over 30 missions set amidst skies full of tracer, flak, flames and planes. So man the guns and join the fight.", "short_description": "Updated for enhanced graphics and new game controls exclusive to Gear VR Controller.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.climaxstudios.com/", "developer_terms_of_service_url": "http://www.climaxstudios.com/", "publisher_name": "Climax Studios", "support_website_url": null, "website_url": "http://www.climaxstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "ko", "zh_CN", "de"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412829732465129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162719_1403660426387673_7967629320124366848_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7yNzKSEgbQQ7kNvwG-vw55&_nc_oc=Adr7O1xRTB3i7ETgwwSaMqzcw2FNJuYuwWOVOhEMVZ_uA5skcGrsuJkd-2aqr8R9Fz8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0igeCj7Am2zsZQ_VR-jgi0UV4ETeuxLi7CaM3ObY_zCg&oe=69D908EB"}, "is_concept": false, 
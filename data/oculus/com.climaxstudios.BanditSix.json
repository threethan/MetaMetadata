rated_image.png", "id": "677610226319421", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opuKgS3mrP8Q7kNvwEycBgc&_nc_oc=Adp84l0cWA4bukFS4-QqeHm1DaVJh10P7X_pcBvuh2rKpih4i4V64vjlbz_8TAhtC4A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1itKwbkhYirLGKhFsncx2qxF-xycZm9b0reVv-jN6Rw&oe=6ABA84CD"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyM1N8n1EqYQ7kNvwG8wYwv&_nc_oc=Adql8VL41UbjZ3URDIv_BHB781wtHOMBvZnFLbOxFI9DlDHPTRbJ2c3pZNO3kK-BIis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8PnZekbVTOF4EyUiG5X9_Q7-M1b0DMAx5fbe37N2GRA&oe=6ABA7D9A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddXR4hcl6W8Q7kNvwF8CwOf&_nc_oc=AdoxxRX_7A82WLrPXJS9zEateSM7cEWnUGQuSizgslysTmXXRORXGPLn0HFkAPVC8uQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNatmYji_PJqPvvZg5goNekh5zIJRfMQEGVH9U2CeKYQ&oe=6ABA86A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot,
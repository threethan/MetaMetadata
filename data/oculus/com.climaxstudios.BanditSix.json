rated_image.png", "id": "677610226319421", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiCl2k707ogQ7kNvwGPw_Cl&_nc_oc=Adqj0LalnqXaSgfYrdhOIA-929UrG4LpcNYh3JtnbllLJa89l9xnEhpPptukpu5tJ-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYutwH1QCYwvVXhkW-FFi64HXUDAiHTI1nkRFHdRHgBA&oe=6AC11C4D"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hO6arSCwpQoQ7kNvwECOklM&_nc_oc=AdoWAGFKPOd8sWoiTOohdWS7tOMNtgU2gRU2_h9IMHYnOALUlB7M0jps__ihNg8OZiI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsfwuR4GFo8ytntwlG1TOZ_I878_O1nXSgkV62xNufPQ&oe=6AC1151A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-c3aoJQqemsQ7kNvwEcjijj&_nc_oc=Adq3TL9aA-8yKPGnkxbXn0SwudMyIYdTgRXNQKCMS853BjVjiBi4oqeHc4HZ25-jPLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkOx5qzhpqb1vKwxP-iG8fKSXxTUMA3yNrIOAFeJfSPA&oe=6AC11E26"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot,
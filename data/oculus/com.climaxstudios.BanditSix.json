rated_image.png", "id": "677610226319421", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdDC2jdYWKAQ7kNvwHiNrcP&_nc_oc=AdpQqRoYFMI05RgaAUcQz6U-nwjHCR0m1jHuiWz1ElydlFKqV0iyv2IqBQzQmW2DoDk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiNXsOQIVXF5xhEw8QZe2KQe4qcPg1fGmAzyJmB6-yzw&oe=6AC7B3CD"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSnBPHExqxMQ7kNvwFeE3pd&_nc_oc=AdoToDQY56uqhyfKDqdncywCpnHZU_5UygO6Slf0KRRI5peGU1AcaXbZ39o7c3yGmtA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBQGqoFJ3bGt5qMuFWUTSHkI4m8tojDc6rhxTMwotQ-g&oe=6AC7AC9A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X19Ghi-N7qkQ7kNvwF9m-iq&_nc_oc=AdoBgqdkkSRYHfn40z5MW3vcwH7It8HyfxMVTjqE3-phJaYzPZv6Uey7Ez2x0sEn8kY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODmp_MX-dHgVwFTdu2uu0XumZOAq04YFkon62cdciYKg&oe=6AC7B5A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot, Bandit Six delivers intense first-person aerial combat in over 30 missions set amidst skies full of tracer, flak, flames and planes. So man the guns and join the fight.", "short_description": "Updated for enhanced graphics and new game controls exclusive to Gear VR Controller.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.climaxstudios.com/", "developer_terms_of_service_url": "http://www.climaxstudios.com/", "publisher_name": "Climax Studios", "support_website_url": null, "website_url": "http://www.climaxstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "ko", "zh_CN", "de"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412829732465129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162719_1403660426387673_7967629320124366848_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FUVnqoEoo0Q7kNvwE3Av1T&_nc_oc=Adp3f1GWooAmlNzevVLA6XqpGIRF5wy8O3Fkyw4djy38cFSCewXGaCIGnh7fSzv1sG8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg8nGtfR2X4FE-SN3BRhTdSHmToEL2kq5Ikkm_juwuYg&oe=6AC7A86B"}, "is_concept": false, 
rated_image.png", "id": "677610226319421", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQvKR93D0lIQ7kNvwFKUGcl&_nc_oc=Adqj2chImFHmZnmYQndE0r-waU0O7P7S-6q9ybTKMTU6dTkIosZZ4010h3ilXveoW1E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHzn1b0J0LCQvuZrlIfcIewfDNqqYA9QoL9IkCKuxmrA&oe=6AB6904D"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCoLzV89QNMQ7kNvwGAXwoG&_nc_oc=AdoT8KQwEf-UELsMvYs1GdANmra5d92Y7Pdxyk4BYUSlSAZ1nzD5KX85pRIZng2xrak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4KpVZ5oVy0ToJFWlYg5m_c8T05Kbm8RkLm5GErxRX2Q&oe=6AB6891A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXx8YMdgqWkQ7kNvwHwcw7S&_nc_oc=AdpMReVU7oNTqojlzgNEwdfJjMmp72H2A-atgrMluf7sr8tpAIQii4rlmJFCtvOwruU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtNcRcwCX0MHhc861a-9J0a_6ejttfR4p-k7oDG85u3A&oe=6AB69226"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot, Bandit Six delivers intense first-person aerial combat in over 30 missions set amidst skies full of tracer, flak, flames and planes. So man the guns and join the fight.", "short_description": "Updated for enhanced graphics and new game controls exclusive to Gear VR Controller.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.climaxstudios.com/", "developer_terms_of_service_url": "http://www.climaxstudios.com/", "publisher_name": "Climax Studios", "support_website_url": null, "website_url": "http://www.climaxstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "ko", "zh_CN", "de"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412829732465129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162719_1403660426387673_7967629320124366848_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeU4ZjTEoGcQ7kNvwHbrvZI&_nc_oc=AdqkFK2TwrOfEQ_5IWlCbwWmuQmt7l4kujYkD74dd9rRwB-eYTUgEGXQZl-1KsXUstM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS7Rb_10lFQRSRyNhDVC5Pmhtdu9CVShD1SUbj1eZrfQ&oe=6AB684EB"}, "is_concept": false, 
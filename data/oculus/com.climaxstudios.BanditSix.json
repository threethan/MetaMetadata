rated_image.png", "id": "677610226319421", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBOls7P6G2kQ7kNvwFSHH3C&_nc_oc=AdrNDNfd0aIqJReKqeFwXQrLuOEIwafJmXMspm2-cU5fI_7D5bibg7chRjukyHoHmI0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzywDHmxj3G4mWileBls-UjHfG16eTAlG4ENMUR6ju-4Q&oe=69CBAD0D"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aiX9B0xnBQQ7kNvwGSEQuc&_nc_oc=AdpSo0PgYjDgA9HmmZWBlrHqPEmhZ3tH0oKl6HT651epB-4nWp6tnPDhHK1zDRRNgHg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7gdSC3m8k2ACsUsbZZpUJiU4FCX75EEKWDbvw77GCcA&oe=69CBDE1A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-rDDucb3TEQ7kNvwG43YiN&_nc_oc=AdrRBNbnhIwvl4F23FVZ8yD5DEIlxiHBk66rVKfy9QsYfFj-h9PgvIlWLQjKnCQlTcc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRyralN705J-HX9GR_lDt7TD_dF_0eNZcWQMQ5Ebja5w&oe=69CBAEE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot,
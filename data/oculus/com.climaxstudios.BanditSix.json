rated_image.png", "id": "677610226319421", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbtywNxam6kQ7kNvwFg1erP&_nc_oc=Adry5wRmLlSynxbDSYSfi0_HOjOK2cs5IyP1wDv5j32sqiZYs7vrlZRVD-N4vzYCiRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQz0D7wmu1UdRmvkdlGfnzVd18_modpT1_WXdL9MMwKw&oe=6AEDEF4D"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhFGTjmN6RUQ7kNvwFIq1BS&_nc_oc=Adr-3RqZ9IQvyJtsCLmB3fuEoLYgesyhUsWdGXDGnBK5NJzi1EHBfZP-Pvx3cGbcQbk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCNOoGaCDkq7XUZy8BnYF14A62NN5R0rGSz07yYjB0tg&oe=6AEDE81A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkLe3LmubAYQ7kNvwEr0hQP&_nc_oc=AdpwoOHU7alVH8lgnmckfeYPzMwUTtwO7tT6VlvG7q42DvzmzpLXLQmGOi375dyma-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBGVxBFyveYY7PzqY7_pcNl6T74l6j5mu71S2EiycQ2A&oe=6AEDF126"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot,
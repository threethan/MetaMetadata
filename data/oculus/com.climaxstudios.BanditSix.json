rated_image.png", "id": "677610226319421", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls1Swfor7VwQ7kNvwH7NbAV&_nc_oc=Adpv_lNAVVjGxJwv7AGKxaijh6n4L3IThBhS_4wZQrUA_HR6H7iBsFOg53PBDtRKfXA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIumFEwMYE3HblNO3OyGkN3khdd_IueOH3NgTnq8wY0Q&oe=6A5B608D"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1UX48o1ZO8Q7kNvwHYU9xN&_nc_oc=AdoVjAPTcj-wjoYPTg54VTnQWrkdNR-vGTBFoydU2XXbWqEoE863FAK7NQ4YwyXz3Ao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxymAoxcAD7Xi2KnzmYduJ0rX-DegfyEqBgtixrCfkLw&oe=6A5B919A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQxvu0YwaX8Q7kNvwHEZeMz&_nc_oc=Ado9pBdInHrwtA5RNCjutZIVi6xZTVHastkbpHsQslLBrw7TPHsDG5TrnONv6nFVThI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLw_SLac2kHhaAfx_XDvT2lb8Rntk-RgJRx9deSaBt9Q&oe=6A5B6266"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot,
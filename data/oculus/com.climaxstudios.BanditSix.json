rated_image.png", "id": "677610226319421", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPo45wH4DOMQ7kNvwEZxYcX&_nc_oc=AdquRQi2i9sv35_2p7A49evpt6n3rKESqQTCv9VWiXJ6syiAwfasMumAgQ2CtxR_7bg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nXv0Cb4y9XN4NeRKNiO_S5pXhXwuw_ezrjMrR_PZ5yQ&oe=69EF7DCD"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMT0AO9ep0EQ7kNvwH40eSm&_nc_oc=AdoRTltPiXOzDPM2ucd9N1MGEwUbVpCcpO_ILaRyH-M6zj6a7JvTmq3SDmHi4-jAhu0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oa_P_-Rbc2c5gFTJrjUAUbEniPzKkGvYAJi-7AB_SBg&oe=69EF769A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VBm3nuSzmoQ7kNvwHmdOH2&_nc_oc=AdrMf_5d0xnccxy1elu1yLK7awjFbCT4WetNZCt7AM4aU-b4Iy0zlvujEHke7gTcjrs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bM9IfRIKOmFFdyrDPBTlNc-8pFKcR_ryrUJDbW50MuA&oe=69EF7FA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot, Bandit Six delivers intense first-person aerial combat in over 30 missions set amidst skies full of tracer, flak, flames and planes. So man the guns and join the fight.", "short_description": "Updated for enhanced graphics and new game controls exclusive to Gear VR Controller.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.climaxstudios.com/", "developer_terms_of_service_url": "http://www.climaxstudios.com/", "publisher_name": "Climax Studios", "support_website_url": null, "website_url": "http://www.climaxstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "ko", "zh_CN", "de"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412829732465129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162719_1403660426387673_7967629320124366848_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Bmq5CnOHOcQ7kNvwFt-eW5&_nc_oc=AdoAWEIH5JJEOP-M-HkEFO2YTn5xvSfKcIn5-zfPqNRftbwaOiSQJIY_rLd2RmzgHKU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YYygORuonqbZGKXA-OKEI4s91tvYggp5d_-C4TG6PcQ&oe=69EF726B"}, "is_concept": false, 
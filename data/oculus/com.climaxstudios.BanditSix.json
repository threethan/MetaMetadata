2761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoMZ2QeTCAUQ7kNvwFP0ycL&_nc_oc=AdlgsD4D4Ma4TaGPZcqIV3Dy8BAMULVyPNHANrWzHj2stqijVCZ6YY3qM5Sl4GkELV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvvEMlLgoTqqIq2C6P4vCi2PpCkojS9G-mjcdML9ifFww&oe=69A02B8D"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fkl_54gApycQ7kNvwFTNgU2&_nc_oc=AdmQZ-u5nQXKgRIPtwZnIBNGp0JxYCR70nZHIT74P7aglgKZdSECmajgI9-GsdQs1zE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvbMvt11MJe2hFheJm3V1ysmENa5EoVAhsLPBz2OGhKGg&oe=69A0245A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ySwM69WLiwQ7kNvwFl3NNo&_nc_oc=AdmCiMhCL9n8Or_5TeZATdRD-MJ6yh-pxNep6n7JynT196SiT6BKSxbnMMU5pYGZSv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmoTFtIUI25nigjdYByuhjEXp99YE1tkvrOeFqAJAKkg&oe=69A02D66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot, Bandit Six delivers intense first-person aerial combat in over 30 missions set amidst skies full of tracer, flak, flames and planes. So man the guns and jo
rated_image.png", "id": "677610226319421", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iBTVdp0gSoQ7kNvwHPYZpn&_nc_oc=Adp5pFL7GQa916A0UQz0GSc_XV6fbos2zTM-3-qHJG9jQ8-WnHlXPbbv7iA-mlzrLJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCN0fx0Grqk3HzOkx9Sjlj9wXJXJzvBO5lAEukY8dGVAQ&oe=6A688F8D"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMlckdjg_gAQ7kNvwEBpuv8&_nc_oc=AdqggXI6RjK6HS-6LPiFOIRPMdAqkQX1Zx6O0BIsoWrhAkfIQcbuuVXCTLa-8Ih32hk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQYy2B5BIjMJQIsoXkXwsAa2wvRuwaoC4eOdN-NVTzbA&oe=6A68C09A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPwOuReiWTQQ7kNvwGdqbsz&_nc_oc=Adqyuqq130Arlxv9JuOmgzogmOeK15ly4_35SpveuVYUoxZfkmwP-E9BM8big740ayY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuM0YuVwA1OeHIVdbCasVpMv9BhYFPu621K7FBZE6Wzg&oe=6A689166"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot, Bandit Six delivers intense first-person aerial combat in over 30 missions set amidst skies full of tracer, flak, flames and planes. So man the guns and join the fight.", "short_description": "Updated for enhanced graphics and new game controls exclusive to Gear VR Controller.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.climaxstudios.com/", "developer_terms_of_service_url": "http://www.climaxstudios.com/", "publisher_name": "Climax Studios", "support_website_url": null, "website_url": "http://www.climaxstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "ko", "zh_CN", "de"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412829732465129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162719_1403660426387673_7967629320124366848_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2tWZhSiq4gQ7kNvwE42Jd2&_nc_oc=Ado3OhzBKGqK8R39YA9-rAUasYAa8j6GF8Yywa1IPjEFTp7rCGngVoZlUnvEMnoClWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEnvpaUezcLt4U9CrwOB_FT1ZuS_eR6AMrzDdj02e0tQ&oe=6A68BC6B"}, "is_concept": false, 
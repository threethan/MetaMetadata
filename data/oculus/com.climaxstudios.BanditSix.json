rated_image.png", "id": "677610226319421", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMQlLR9k2VkQ7kNvwGKKhJ1&_nc_oc=Adp7ISi-iSWVGvLel3SAZq3wlFm27Oi28mnzcFbI8oEWs8JrCE-Rohi89a7L5Ol57hA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICQfjSsiFxKQJkPZE_Q43f1h_c-VXCyPbgtbvgKcAZMw&oe=6AA56CCD"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk-VOWo4glAQ7kNvwEMjNC5&_nc_oc=AdqSLPM9N9-jz7SGi0F-SUdk54QtcUVu8hmR0ZHgy4UgeUYeLY3m1OLGXlrWN1RdR34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3vNY96VKIOxknI8Bvj3HK7FP6M0Xq8pKe0BZPW5pdeg&oe=6AA5659A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pbC9hNYfRAQ7kNvwG1slgW&_nc_oc=AdrkrUwcUyS0eAfcmToNeCx6BCDgj8RM07y4efh-2YC6bswfd4sOt2yuibJXBkFAiFk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxhMHpQjDhlZ275YgaxdPcR9KmpLApb_mgcOMuc25GIA&oe=6AA56EA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot, Bandit Six delivers intense first-person aerial combat in over 30 missions set amidst skies full of tracer, flak, flames and planes. So man the guns and join the fight.", "short_description": "Updated for enhanced graphics and new game controls exclusive to Gear VR Controller.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.climaxstudios.com/", "developer_terms_of_service_url": "http://www.climaxstudios.com/", "publisher_name": "Climax Studios", "support_website_url": null, "website_url": "http://www.climaxstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "ko", "zh_CN", "de"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412829732465129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162719_1403660426387673_7967629320124366848_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgkUg0q7NtMQ7kNvwFzjv78&_nc_oc=AdpRKjp_13Dyber2F7q09BxrKLS7N-EDfuN22kiZV8hRhRCYd2l4z31abXvvMtFzbuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRy8NoBFztSJqMu8V86p2Iwa9H9FoR83yFopY4cAnmUA&oe=6AA5616B"}, "is_concept": false, 
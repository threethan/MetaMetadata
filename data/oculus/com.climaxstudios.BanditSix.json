rated_image.png", "id": "677610226319421", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om3Um99LCXAQ7kNvwGzT50_&_nc_oc=Adqx3wLdGYBlxIUDoYJNe44ROeE6NWe0AYXXJ2LrzsOoShuzhz8A1lxgbsnuQWJGXkE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ewsgwRXU1CILnRuUvr0zRZLxlhO5I-dDTJy7cwJzVkw&oe=69D4E78D"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WTcqHxI4C4Q7kNvwE0YcHt&_nc_oc=AdrrEsvJzh5Br27bj5nDekPi6A3k1mgL3mr2pNYJxaEm9OlKSNTXTlIdYi-Yj7Ym0-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zqG8gdusCS85EYxhQ0pNcVdK_sN2QqKsHiJccmrrt-w&oe=69D5189A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDNVcaME_iwQ7kNvwForN9s&_nc_oc=AdoAxpfcj1iwr_sneuJ7Szb3bCTBbnYO2pS_0rsfc68R9jtMgUGvfFvWl3Ri81hDMO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2r7piXbNhSIS6XIumLCIrYGeLS-RR9koKOPeiLdi78hg&oe=69D4E966"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot, Bandit Six delivers intense first-person aerial combat in over 30 missions set amidst skies full of tracer, flak, flames and planes. So man the guns and join the fight.", "short_description": "Updated for enhanced graphics and new game controls exclusive to Gear VR Controller.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.climaxstudios.com/", "developer_terms_of_service_url": "http://www.climaxstudios.com/", "publisher_name": "Climax Studios", "support_website_url": null, "website_url": "http://www.climaxstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "ko", "zh_CN", "de"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412829732465129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162719_1403660426387673_7967629320124366848_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_FlOmlMOrAQ7kNvwGLiKfD&_nc_oc=AdqK1-1FHWixVOIYKd3vTc_0Zul9FFnyNz2K5N9fDn9DUvP9VsZ0uGke8g8rUnyshvU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3X2cpnp4wlxZLQN2X0vc5mY2tSG1hbq8IFo9u5g2C2Mg&oe=69D5146B"}, "is_concept": false, 
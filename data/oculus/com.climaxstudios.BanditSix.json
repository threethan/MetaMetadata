oQ7kNvwGJtrsh&_nc_oc=AdpFg-c3BUoJA5oU4EcefPvjHC1Nxr67oyd1pjcVdyvr89AzS1LFO_Dwgkjefd5fiSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRch1rucD5Det2eLH7p8qVF_dau-O_1FLM0JMAruWPpCw&oe=6AFDAD61"}, {"file_name": "migrated_image.png", "id": "677610226319421", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_gfMBIar1YQ7kNvwG5lC7t&_nc_oc=AdrNfowvA0YnkMyyfBWaP_Amu_uASr_ude7a_I7h5h73eQ6uU0Avos6qLvIpVA4y79k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7uu66-pL4CtHMBa1NN-Hu9YK4TneXFvfp1MO0JJEm_Q&oe=6AFDC14D"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSLA8ch-q24Q7kNvwEIuUNF&_nc_oc=Adr6LJ5LWblgqos8NfoNshfPI8cXJVKen2Lqoxdj74XaXl_3BwfSulx2bs8ZlVgxM_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-9cengcOiFHj9J2pUDUyGo1vLls33kGUdb0kVFC0GoA&oe=6AFDBA1A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2lBgQEVPNYQ7kNvwE4TlQE&_nc_oc=Adouy9iziUdbg3d-zit3GolUS1fD5F4_Wm9i6tG3VvI6erg38pGOyoOXRvUawdncbAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVo6RnPdoBjMTJEZwWNoqZi2zN153-1hs2487EgbnPLA&oe=6AFDC326"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot, Bandit Six delivers intense first-person aerial combat in over 30 missions set amidst skies full of tracer, flak, flames and planes. So man the guns and join the fight.", "short_description": "Updated for enhanced graphics and new game controls exclusive to Gear VR Controller.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.climaxstudios.com/", "developer_terms_of_service_url": "http://www.climaxstudios.com/", "publisher_name": "Climax Studios", "support_website_url": null, "website_url": "http://www.climaxstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "ko", "zh_CN", "de"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412829732465129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162719_1403660426387673_7967629320124366848_n.png
wQ7kNvwGdtXrx&_nc_oc=AdoluANNB8TG6R2_RbXsZelS-0umJRaDui2Bx4sHlG15qojhMxYEkWrfRETE1nhIPD0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJmLuYYymhoSgt-vzp4PniqBrHMGnIE27AeQbnH5W-qA&oe=6B072021"}, {"file_name": "migrated_image.png", "id": "677610226319421", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MrbsQ_9bm4Q7kNvwHwlSil&_nc_oc=Adp7kt9JJ8WpxC01rSNY3FB2VjmwkfXy0-3bZ4sv1xpjzkfn_Tr6ZDzZjzBbWWPWDdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPSsbkCrxyGT1xN7deX0WYFKQZ-GpUllCoWmBFb6hmxA&oe=6B06FBCD"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8aqlBIgcCUQ7kNvwEae6iX&_nc_oc=AdqtM8e_hSGszjQE_8pKM8OB-Os86Hk5_JOYa2J4tk7jcWg9tv2bDQR2UQQJfeYQLxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQafXRy6_Q4qTs4nQ5D00sQEu3qHV1nlVUSoHzcFmk_YQ&oe=6B06F49A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-2VWAWOxlUQ7kNvwERNR8P&_nc_oc=Adokk4F6ipr8fg9GC4iOSjn4L8sLoPjEN9_rV1_LApxFNcD-VMsoNI_qEHe25i4etlE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXxi0GuBYDneV72KH05EmaiM5GUeuyfwLaRqmXwogVdg&oe=6B06FDA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot, Bandit Six delivers intense first-person aerial combat in over 30 missions set amidst skies full of tracer, flak, flames and planes. So man the guns and join the fight.", "short_description": "Updated for enhanced graphics and new game controls exclusive to Gear VR Controller.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.climaxstudios.com/", "developer_terms_of_service_url": "http://www.climaxstudios.com/", "publisher_name": "Climax Studios", "support_website_url": null, "website_url": "http://www.climaxstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "ko", "zh_CN", "de"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412829732465129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162719_1403660426387673_7967629320124366848_n.png
rated_image.png", "id": "677610226319421", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162698_291422761293408_7481340873624518656_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LvCTENA9wYQ7kNvwHRpd1_&_nc_oc=Adp4M0HIHrLQumxTlA8k4ZtbzJYvWEft1e1D28nTPi9NVxWBVrIIjezuQM8NceTHDN4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aPn9ksHop3RTIHEnZAqPYu5jb_GFgNHWO8hc4UCvo-w&oe=69ECA28D"}, {"file_name": "migrated_image.png", "id": "541172783197221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162699_790554757780712_3944076022764273664_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMT0AO9ep0EQ7kNvwGrns6x&_nc_oc=AdrF_-HDk4Z3duXl_EaGmR4rNi14_6gpfXy0Ag6xltCo_KmFSO_DzH2bxTSfpXbrfn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GgAHx2nZVD2kvq9o9Zx_w2y7Jpl--7fjdGjLcA26Mow&oe=69ECD39A"}, {"file_name": "migrated_image.png", "id": "510182182979340", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162685_114047519158412_8256914359855349760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYN-T3ANsQEQ7kNvwEfkvzD&_nc_oc=AdqfJSpfX9mMirfM5rvv9SoW0oP66YdfrThNjiwp3h_EuenwwfZjubwtHhaRR2IdMS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EOxgSnMmR7UWjtj4ewBDvh6rSZoNjP_XTrRn2Lssj0g&oe=69ECA466"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bandit Six", "keywords": ["Shooter", "Turret", "Fun", "Game", "Bomber"], "long_description": "Aim high with Gear VR Controller added support right in the palm of your hand, blow the enemy out of the sky and watch your six.\n\nWe give you the firepower. You give 'em hell. Strap on your Gear VR headset and man the tail guns of a World War 2 bomber fending off swarms of attacking fighters as they close in for the kill. You'll face the enemy's deadliest aerial weapons, from the iconic Me109, to V2 rockets, jets and missiles. Designed exclusively for the Gear VR where you use your head to aim and the touchpad to shoot,
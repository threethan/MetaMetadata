content-lhr11-1.oculuscdn.com/v/t64.5771-25/39035458_519112374348433_7582077520722969287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUq8ugvp4iMQ7kNvwEfU6Lk&_nc_oc=Adq-Qu_-vUDtlWSnCIEEJwZ-BpbwO1pX-ZHNIa4c3jEAihbvGMTD0oPG8QvHMNCrPN8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGbLifJ-VrEjVYatB0WnEHkkaIwyLQ0gL67B4bPR_hTA&oe=6A858DE8"}, {"file_name": "img007.png", "id": "1062469368590565", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982711_1062469371923898_7438566791589549366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5R0-unCISYQ7kNvwE92wqX&_nc_oc=AdoDvR5YKkiClQPnYXeT6JMrMAy7F1Tvk3FWteVJs2v6pMuuAMySsXFlUqaP-JkNOhQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG10GVClAH1bbUB0_wFaOSyzioHTWWgW-VShm_LRGI-zw&oe=6A85A4EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "801518798634378", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031529_801518801967711_7657638633483599136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFzPr4V3ggEQ7kNvwHu8NlU&_nc_oc=AdoIf8l2qwzzkU5f_f2_oeqxXy503NsRkL8HpnmTr2sxwTijufVDEKNKQZmupF-I3PE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK9xuISAOEEHNTQdB_kEpnm19YCzSfw9VqnI9hF4E_tg&oe=6A85A3FA"}, "display_name": "VRGym", "keywords": [], "long_description": "Workout Modes:\n1. Battle Rope Play Exercise: Engage in an intense arm and core workout by \n    virtually swinging battle ropes in different patterns.\n\n2. Sandbag Boxing Exercise: Combine virtual sandbag boxing with real \n    punching techniques to improve your boxing skills and fitness levels.\n\n3. Reaction Metal Balls: Improve your reaction time and agility by hitting \n    random virtual metal balls that appear in quick succession.\n\nOperation:\nThe interface is user-friendly, allowing users to start the workout by simply pressing the Start button.\nEach workout session lasts two minutes, after which users can switch to another mode.\
519112374348433_7582077520722969287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CF1klD6i4okQ7kNvwHX7WMk&_nc_oc=AdliCAoLFiwxbNhFiKGul55fM3qjPIDg1cjmKzIk6C1mSh-dXGZbSNv2zglFaXMxWtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzdlau6AuC7iY91UdXCMvoiLHhOH_0QF4uFY5oT-s0KEA&oe=69AFFAE8"}, {"file_name": "img007.png", "id": "1062469368590565", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982711_1062469371923898_7438566791589549366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUFHMeNle20Q7kNvwHn_Oo0&_nc_oc=Adnj2buYGyxW868QuqpVducXRnjhvS-yqbmlpTwq-2bSe63KN7Z_CXDHECfh1x8vDic&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRJoVK6HTBYS2re151KSN_Q6j4d8kkIRg8nX_YTuZlyA&oe=69B011EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "801518798634378", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031529_801518801967711_7657638633483599136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lD7H4JBaMbAQ7kNvwF5crnt&_nc_oc=Adkdg6sWcm5dWLVd7aWY71ctiw1YWxpTB4YoPUJZoMMjhhq6T3gPKog2_eICrCwp1fQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJY5e2qdvzVV_lg-E7lISQLgMIlaVtdYW0EKbiLCmfDQ&oe=69B010FA"}, "display_name": "VRGym", "keywords": [], "long_description": "Workout Modes:\n1. Battle Rope Play Exercise: Engage in an intense arm and core workout by \n    virtually swinging battle ropes in different patterns.\n\n2. Sandbag Boxing Exercise: Combine virtual sandbag boxing with real \n    punching techniques to improve your boxing skills and fitness levels.\n\n3. Reaction Metal Balls: Improve your reaction time and agility by hitting \n    random virtual metal balls that appear in quick succession.\n\nOperation:\nThe interface is user-friendly, allowing users to start the workout by simply pressing the Start button.\nEach workout session lasts two minutes, after which users can switch to another mode.\nThis app blends efficient exercise with a gaming experience through virtual and hybrid reality, making it suitable for fitness and entertainment for a broad audience.", "short_description": "VRGym is an innovative fitness application offering both Virtual and Mixed Reality scenarios for users to engage in three different exercises."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ecom.iscom.sg/index.php?route=information%2Finformation&language=en-gb&information_id=3", "developer_terms_of_service_url": null, "publisher_name": "IS COM XR Apps Developer", "support_website_url": null, "website_url": "https://iscom.sg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26898669616443466"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "885694764238881"}, {"status": "PUBLISHED", "id": "3645015698969603"}, {"status": "PUBLISHED", "id": "899729759375574"}, {"status": "PUBLISHED", "id": "825763066868777"}, {"status": "PUBLISHED", "id": "1121500853240236"}, {"status": "PUBLISHED", "id": "2203790390071507"}, {"status": "PUBLISHED", "id": "984831777143503"}, {"status": "PUBLISHED", "id": "662142086386166"}, {"status": "PUBLISHED", "id": "1259269228483064"}, {"status": "PUBLISHED", "id": "1656923361554109"}, {"status": "PUBLISHED", "id": "462635533469434"}]}, "baseline_offer": {"id": "462635533469434"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status":
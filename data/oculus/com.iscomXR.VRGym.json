519112374348433_7582077520722969287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcW-3YG3Y08Q7kNvwFhRJW2&_nc_oc=Admw7vScMm6CbEb_mOlrecWAP00TmrxtXmb-Q8Fo4eSIyQEGNjRTI0w8PoK2FIoZxU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxjxHNZXyBXw1qhvOWcSnzebaoPYi9cT4j7RLnsr7q02Q&oe=69AC0668"}, {"file_name": "img007.png", "id": "1062469368590565", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982711_1062469371923898_7438566791589549366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tfSz1p3AYUQ7kNvwFkcWYU&_nc_oc=AdkPx0xOSpr0eIpE3x1Nrq4WXQ_MCWZp-Mm15ztDIVAClvrW6Gktyg3zm85RsbTPPmM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyChiHSPstLw9BDqCwik009LRBhPwF7Zdtw9mZm5D0AoQ&oe=69AC1D6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "801518798634378", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031529_801518801967711_7657638633483599136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9YNElSRLEYQ7kNvwGjuXSe&_nc_oc=AdlsbmPP4M8YHa5lp2_Vmh1eVglCBXYLHEWOzIwMs3lRlU0BrulH2i5dugsNFqBNXVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyA_TO6xJ3DGnVIcse8FFt6I1gOjQhMv5-xozUERxxiww&oe=69AC1C7A"}, "display_name": "VRGym", "keywords": [], "long_description": "Workout Modes:\n1. Battle Rope Play Exercise: Engage in an intense arm and core workout by \n    virtually swinging battle ropes in different patterns.\n\n2. Sandbag Boxing Exercise: Combine virtual sandbag boxing with real \n    punching techniques to improve your boxing skills and fitness levels.\n\n3. Reaction Metal Balls: Improve your reaction time and agility by hitting \n    random virtual metal balls that appear in quick succession.\n\nOperation:\nThe interface is user-friendly, allowing users to start the workout by simply pressing the Start button.\nEach workout session lasts two minutes, after which users can switch to another mode.\nThis app blends efficient exercise with a gaming experience through virtual and hybrid reality, making it suitable for fitness and entertainment for a broad audience.", "short_description": "VRGym is an innovative fitness application offering both Virtual and Mixed Reality scenarios for users to engage in three different exercises."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ecom.iscom.sg/index.php?route=information%2Finformation&language=en-gb&information_id=3", "developer_terms_of_service_url": null, "publisher_name": "IS COM XR Apps Developer", "support_website_url": null, "website_url": "https://iscom.sg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26898669616443466"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "885694764238881"}, {"status": "PUBLISHED", "id": "3645015698969603"}, {"status": "PUBLISHED", "id": "899729759375574"}, {"status": "PUBLISHED", "id": "825763066868777"}, {"status": "PUBLISHED", "id": "1121500853240236"}, {"status": "PUBLISHED", "id": "2203790390071507"}, {"status": "PUBLISHED", "id": "984831777143503"}, {"status": "PUBLISHED", "id": "662142086386166"}, {"status": "PUBLISHED", "id": "1259269228483064"}, {"status": "PUBLISHED", "id": "1656923361554109"}, {"status": "PUBLISHED", "id": "462635533469434"}]}, "baseline_offer": {"id": "462635533469434"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status":
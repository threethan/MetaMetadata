fw5-2.oculuscdn.com/v/t64.5771-25/39035458_519112374348433_7582077520722969287_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jV86WnFeRIIQ7kNvwG-vxpn&_nc_oc=Adory5YhkVACuQcf6GspPBQh6zZL1jY_QWEn7AO3_m9va2EFuLlJ8zETkkKf_iKd2WM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR3p62B0sV0bmiSCkYrlDp3s0xFhsIPi--_M1c6XsEvg&oe=6AF9CA28"}, {"file_name": "img007.png", "id": "1062469368590565", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982711_1062469371923898_7438566791589549366_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNtSwXTf-2QQ7kNvwEnxQnn&_nc_oc=Adqc6LfWtppv2AEn96P4sRmIjas_EeBlCyp5as7d35TCKypoYL4IZUoHmJn7oiy2d44&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT5cK66_Uc7JXsN3uBr6INPLa71_knpioFL8uB-nJUsw&oe=6AF9E12A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "801518798634378", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031529_801518801967711_7657638633483599136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmYXBvqJDn4Q7kNvwH0Vk_E&_nc_oc=AdoaIQfZWuaC7bD32ZauLBPbtY9_kkplWNjEPdd4xio8ZzSJJTpKq3N-8inMiCC4wfM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5yNULzZcVLSzK_4DYi6uY0qTRnSDgiYfnbpy2zn6DhQ&oe=6AF9E03A"}, "display_name": "VRGym", "keywords": [], "long_description": "Workout Modes:\n1. Battle Rope Play Exercise: Engage in an intense arm and core workout by \n    virtually swinging battle ropes in different patterns.\n\n2. Sandbag Boxing Exercise: Combine virtual sandbag boxing with real \n    punching techniques to improve your boxing skills and fitness levels.\n\n3. Reaction Metal Balls: Improve your reaction time and agility by hitting \n    random virtual metal balls that appear in quick succession.\n\nOperation:\nThe interface is user-friendly, allowing users to start the workout by simply pressing the Start button.\nEach workout session lasts two minutes, after which users can switch to another mode.\nThis app blends efficient exercise with a gaming experience through virtual and hybrid reality, making it suitable for fitness and entertainment for a broad audience.", "short_description": "VRGym is an innovative fitness application offering both Virtual and Mixed Reality scenarios for users to engage in three different exercises."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ecom.iscom.sg/index.php?route=information%2Finformation&language=en-gb&information_id=3", "developer_terms_of_service_url": null, "publisher_name": "IS COM XR Apps Developer", "support_website_url": null, "website_url": "https://iscom.sg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26898669616443466"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31447635428213506", "version": "1.0"}, "id": "514651291346823", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26898669593110135", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "31447635428213506"}, "release_stat
-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTALejAas7_UR-NILYf7b__why2lHPqSOjIXkReDy0XvQ&oe=6AFB3B99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Final_cw27_5.png", "id": "719973655505875", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75549080_719973658839208_9047536876870375886_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaPipYjsiiYQ7kNvwGQToRN&_nc_oc=AdqgaBVoGz8OLq5-3luQbeJOloAvaPf3Mh5lwU8wyloVQnYqPTIi67Rhf9FQBxbCXRM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgE31cJOdecPhvhjiTEdv-Me7vEjHNhHpXWDnUSvNUkw&oe=6AFB1557"}, "display_name": "Alcove", "keywords": ["family", "travel", "health", "social", "entertainment"], "long_description": "A virtual home filled with endless experiences to discover and explore, a place to connect with loved ones. Casual games, world travel, media customization, relaxation, and adventure.\n\n- Invite your friends and family, and play games, share photos, upload and watch your own videos - standard, and 360, and step into them together\n- Travel to new places together and see the world: take a city tour, a hot air balloon ride, or a back-country road trip\n- Explore the depth of the ocean - go diving in the Great Barrier Reef of Australia, or swim with dolphins in the Pacific Ocean\n- Relax on a beach practicing guided meditation\n- Listen to classical music\n- Play with your virtual pet\n- Change your perspective from ocean to green meadow, to snowy mountains\n\nAlcove has something for everyone, no matter your age. Download Alcove and start exploring today!\n\nNote: Alcove will keep growing with new immersive experiences and features. Please leave us a note to let us know what you\u2019d love to see next.", "short_description": "A virtual home filled with endless experiences to discover and explore, a place to connect with friends and family. Casual games, world travel, media customization, relaxation, and adventure."}]}, "developer_name": n
69D26F20"}, {"file_name": "S5.png", "id": "1349976393285578", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821782_1349976396618911_4120503720318518765_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UnGGpetebMQ7kNvwEBeoeA&_nc_oc=AdpzeStCV_5PYL0BOer7NXs1QrVZkdyFWHkekV8dRuMrgdzo_pyVk69px1-BGCYiYcY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lR_192jFgE4x7EtxPI1fa3wzBE7SPiKZLY3j8v_rEhg&oe=69D27AA1"}, {"file_name": "S2.png", "id": "24471407709203321", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820428_24471407719203320_6103774758443139753_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_x8SKGLOwcQ7kNvwEMQjbh&_nc_oc=Adpx8-k5jHIyso_cDTJhdPxCHjl18t0XYjrUl4LI6etHJMJR9TeW5bZG7WcBgRLzopA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3f3hvNH-PVbfIz_cdXM6bKpivnxv-KgWUjiPUsAtJzSg&oe=69D25273"}, {"file_name": "S3.png", "id": "4303899076560262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821702_4303899079893595_4894940060417453601_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2g_vBi1ZZUQ7kNvwHh_Ipy&_nc_oc=Adp7dqZUJN-mmbjdnxNBAuzlewrNHtGBlU6V_iCF8pwT8tktk69J-Luv06ncjMVhq1U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b41ylVcqtq3UKzK1VVfhCWJfYBaPEVzExzfkV02y_gw&oe=69D27782"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F1 Racer : Formula Car Racing Game", "keywords": ["Racing", "Formula", "F1", "Car", "Drifting"], "long_description": "Get ready to experience the thrill of real Formula racing in F1 Racer: Formula Car Racing Game, built for the ultimate VR experience. Put on your headset and feel the adrenaline as you take full control of high-speed Formula cars on world-class tracks. Every turn, drift, and overtake brings you closer to becoming the ultimate F1 champion.\n\n\n**Features:**\n- Realistic Formula car physics and controls\n- Immersive VR view\n- Racing tracks with increasing difficulty\n- Dynamic weather and day-night conditions\n- Championship and time trial modes\n- Smooth performance and optimized VR visuals\n\nStart your engines and feel the rush of F1 racing like never before. Download F1 Racer: Formula Car Racing Game and take your VR racing experience to the next level.", "short_description": "Get in the driver seat with F1 Racer Formula Car Racing Game. Feel real F1 speed, race on challenging tracks, and compete to be the fastest driver. Experience realistic physics, smooth controls, and immersive VR racing that puts you right on the track."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32167442892871325"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "3128343274011223"}, {"status": "PUBLISHED", "id": "1243935014364346"}, {"status": "PUBLISHED", "id": "823569964060479"}, {"status": "PUBLISHED", "id": "1273362601352626"}, {"status": "PUBLISHED", "id": "1967144050794624"}]}, "baseline_offer": {"id": "1967144050794624"}, "is_approved": true, "firstOffer": {"nodes": [{"sta
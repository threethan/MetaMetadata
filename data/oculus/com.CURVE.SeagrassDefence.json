539525319903_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7OiQiRQt9UQ7kNvwFzu-ct&_nc_oc=Adr0rjhAkN2n5hk9O_gdB1Pw33j42iTmrrjxeguuEe0gy3wyElxXKQ0HaGteWnIDzoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEYz6mJdXUjCZmfy0VInk9vWEUPZ_Y8sHpzRYxWwMfrQ&oe=6AA694A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CURVE- seagrass-2560x1440.png", "id": "787348091031294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823431_787348094364627_3840562624497437375_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2fuZZt8SPoQ7kNvwEqopL9&_nc_oc=Adrg4RZdDT_cmmuJJhANhF9Ah81SZ0mv56Gi5VTC3rdGoBzfNkif__FqAciThW0Jd04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf23MXsscg31NK2cwi_jFqBrn5ofqOuY_F69pWqkLdUw&oe=6AA6B768"}, "display_name": "CURVE- Seagrass Defence", "keywords": ["education", "underwater", "research", "science", "seagrass"], "long_description": "Coastal Underwater Research: Virtual Experiences are a series of virtual reality (VR) modules to provide virtual research experience to academic individuals in the marine science field. This particular module features tools and techniques used for a real-world experiment conducted by Erin Johnson. Users can learn about and conduct essential fieldwork tasks needed to run an experiment that investigates how seagrass defenses affect sea urchin consumption.  Seagrass defences are related to the \"day of seagrass collection.\" In the experiment module, users can manipulate variables known to significantly affect sea urchin consumption and receive simulated data based on a built-in equation from the real-world experiment. Users are encouraged to design an experiment, analyze the data received, effectively communicate their results through various forms of infographics and tag the creator!", "short_description": "Coastal Underwater Research: Virtual Experiences are a series of virtual reality (VR) modules to provide virtual research experiences to academic individuals in the marine science field. This particular module (Seagrass Defence) features research activities related to a real-world seagrass experiment conducted by Erin Johnson."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curves-learning.org/projects/seagrass-defence", "developer_terms_of_service_url": null, "publisher_name": "Sea Adventuren", "support_website_url": null, "website_url": "https://www.curves-learning.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25602703169359999"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "759770093730700"}]}, "baseline_offer": {"id": "759770093730700"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767243600, "status": "PUBLISHED", "id": "759770093730700"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28270560935907529", "version": "0.5.2"}, "id": "1869556797327182", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25031484059815249", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2827056093
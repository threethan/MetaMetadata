e=6A830742"}, {"file_name": "499311597_2833689820297403_7735388869743187987_n.png", "id": "1470361847599012", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313072_1470361850932345_7665977127383493823_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTVsgswHPD4Q7kNvwGuN_mL&_nc_oc=AdqcrcWnG9wgmmYm7RvcqErer8ik7clAaUmGNQC9qoifResRt_9WOAuVSQYiKpCbR4M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqpHtJ6Q4neYvWcBAFDpBY5En-vHQdv57xAzuwMMLYvg&oe=6A8318C8"}, {"file_name": "507849536_1468224018115911_5711762963589366957_n.png", "id": "1329748579251412", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310726_1329748585918078_5962697925566154048_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMIjY8McA5YQ7kNvwGjhZxg&_nc_oc=AdpVjj1tkcgg1TfQEzuuEzHVflSZK-1h8L8zThImzzOlx3GWhzNJOTVb6MV3b1S51Hw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTW6WVH8M7cpM5zhT5d31Gm-baysWxq6uRNqKhcAjTKA&oe=6A830818"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blitz Tag", "keywords": [], "long_description": "Blitz Tag drops players into a massive interactive world built entirely around immersive hand-based locomotion. Instead of using traditional movement controls, players move by physically pushing, climbing, vaulting, and launching themselves across the environment using their hands. Every wall, surface, and obstacle can become part of your movement path, allowing skilled players to chain together advanced techniques, gain momentum, and master fast traversal routes throughout the map. The movement system is designed to feel smooth, responsive, and highly skill-based, rewarding practice, timing, and coordination while creating an intense and engaging multiplayer experience.\nThe world of Blitz Tag is filled with large explorable environments, unique terrain, vertical climbing sections, hidden pathways, and interactive obstacles that constantly challenge players to improve their movement abilities. Players can scale towering structures, swing around corners, leap across dangerous gaps, and navigate complex areas that require quick reflexes and precise hand placement.", "short_description": "Blitz Tag starts you in a large interactive map where movement is controlled entirely by your hands. Players use hand-based locomotion to climb, push off surfaces, and move around the environment, creating a more immersive and skill-based experience. The map includes different areas to explore, obstacles to overcome, and challenges that require precise movement and coordination."}]}, "developer_name": "Blitz Tag", "developer_privacy_policy_url": "https://sites.google.com/view/blitztags/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blitz Tag", "support_website_url": null, "website_url": "https://sites.google.com/view/blitztags/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1111399942060861"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_970929238984655_4924343219696415378_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yW9N1aqX6OAQ7kNvwE45J3E&_nc_oc=AdoqX5_3OY6qOhXDq17YYpsHXL_RHlnxapPV5vVeDmuTVcpHH82veehkZCnxVaLBLos&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjAtcYFdDIxOY42oXTJ5L5EJQAkdrgJXqSyf
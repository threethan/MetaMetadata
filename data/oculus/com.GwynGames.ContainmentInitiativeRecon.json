n_SS_4 2560x1440.png", "id": "1443657016474755", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035416_1443657019808088_2486947651465581524_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QplqUstL9E0Q7kNvwEKQnAP&_nc_oc=AdqUGRr-5ieajlH2Aj5vUjfMKKsymWjQKdEuD17snGzgat3nmh609vwNrXJ3wkUSe9s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHWTrsK94StUWSH7s_ajh2zNtNuJdfh7uxEiyP68b6rA&oe=6B01D543"}, {"file_name": "CIRecon_SS_3 2560x1440.png", "id": "610435117841403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035361_610435121174736_7614005424375505611_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzY4-uY0kkIQ7kNvwGle74w&_nc_oc=AdoBPiOnuFEMupdhLMnjEBFQ6Q46Oee2cAmATqsnevi2y7_UBVtXACsLBCytj3ga4YU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxTa0ZPnPFIUJKHqKvaIj1I7KL91umRyOzqnari05sGQ&oe=6B01D24F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CIRecon_SS_5 2560x1440.png", "id": "120405504445546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75339313_120405507778879_6926521371564161931_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jpuj06hisRUQ7kNvwHKAYbR&_nc_oc=Adot6aHbfuRJhlISHCIoKSd6JC-90bw-nPKGlHpt41Y_w7IbJ2pwupl5ZcLqFsniZc8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW5z6XeLC98tQn8AE8hqUljeiD1LNZXbs5Nti5YAtE4g&oe=6B01EA87"}, "display_name": "Containment Initiative: Recon", "keywords": [], "long_description": "Containment Initiative: Recon is a singleplayer version of Containment Initiative designed for standalone headsets.\n\nRealistic Reloading:\nEach weapon handles and reloads just like it's real world counterpart. Mastering reloading is essential to surviving the horde!\n\nProgression:\nRobust progression system which includes: Unlockable guns, attachments, player upgrades, and more.\n\nMission Types:\nCollect supply crates, defend objectives, or just try to survive the horde.\n\nLoot:\nFind random drops that include exclusive weapon skins, a new melee weapon, and ammo upgrades\n\nDismemberment/Blood:\nHeadshots trigger a slow motion effect so you can behold the carnage!", "short_description": "Containment Initiative: Recon is a singleplayer version of Containment Initiative designed for standalone headsets. Take on the horde with different mission types, loot to collect, and gear to upgrade!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gwyngames.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gwyn Games LLC", "support_website_url": null, "website_url": "https://gwyngames.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2309937129194063"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "1426457959372585"}, {"status": "PUBLISHED", "id": "2073591586637561"}, {"status": "PUBLISHED", "id": "1718946162429442"}, {"status": "PUBLISHED", "id": "1444790973854448"}, {"status": "PUBLISHED", "id": "1648470726329749"}, {"status": "PUBLISHED", "id": "1911924086415201"}, {"status": "PUBLISHED", "id": "1888632382067924"}, {"status": "PUBLISHED", "id": "1251467346735105"}, {"status": "PUBLISHED", "id": "1863713321148744"}, {"status": "PUBLISHED", "id": "3047084905458424"}, {"status": "PUBLISHED", "id": "9588028424616725"}, {"status":
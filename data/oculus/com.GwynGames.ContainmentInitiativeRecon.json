37"}, {"file_name": "CIRecon_SS_4 2560x1440.png", "id": "1443657016474755", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035416_1443657019808088_2486947651465581524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kHoRG8X7xcQ7kNvwEgZObN&_nc_oc=Adp5Hdfq5DmTN9FRuC8crIEH2yJkPzvtKSH495DfII0W0ZLYqOT2cHdE06-dPw0oH5s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH5iZnUbecfmOlAXHpyjW5RvWkgqfNgT96mKT0OEonxQ&oe=6AE34A83"}, {"file_name": "CIRecon_SS_3 2560x1440.png", "id": "610435117841403", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035361_610435121174736_7614005424375505611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQNxzNeH_QQQ7kNvwH6-A9g&_nc_oc=AdpioRD-J37dISQCfkk3PqjWYpbHr2Y0jW-_adBZRgpg3r_mP1CU2p8MI85UZtileC8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_fjfNkWq7VkCW3_rCWT1BNfkTlLzywmd8lg3K-kW5UA&oe=6AE3478F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CIRecon_SS_5 2560x1440.png", "id": "120405504445546", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75339313_120405507778879_6926521371564161931_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSbwYtLiaE8Q7kNvwFg3Owj&_nc_oc=AdpFSn94QpanVXfasodAnxoEI0Y84H5JNtJ1BF3-1H2ZrzInwftoxy6_HbxYHNTCH8A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpFAjD1bX2hKb0VcPqh4xST1TRxKSqb5RqlRL6-CdOGA&oe=6AE35FC7"}, "display_name": "Containment Initiative: Recon", "keywords": [], "long_description": "Containment Initiative: Recon is a singleplayer version of Containment Initiative designed for standalone headsets.\n\nRealistic Reloading:\nEach weapon handles and reloads just like it's real world counterpart. Mastering reloading is essential to surviving the horde!\n\nProgression:\nRobust progression system which includes: Unlockable guns, attachments, player upgrades, and more.\n\nMission Types:\nCollect supply crates, defend objectives, or just try to survive the horde.\n\nLoot:\nFind random drops 
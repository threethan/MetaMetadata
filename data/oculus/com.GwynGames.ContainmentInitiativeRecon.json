05611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp82Zysi-YcQ7kNvwEqMD6P&_nc_oc=Adr_yZQwaioObIkncLhye4iyWp5Co8x0-DnyRfGxah2EInfxpmlJAu-t0AOuw91x2r4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGrff8jBMEpYaiH6qSEKLXr0oENhnbwBjlDCkjqVN2gw&oe=6ABE5D8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CIRecon_SS_5 2560x1440.png", "id": "120405504445546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75339313_120405507778879_6926521371564161931_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujK_0F0QRWUQ7kNvwHoIjGs&_nc_oc=AdoaQHs7AiWKrkbXBPT2s04n1pUO0waErBPWW0XD4-jG8lF16WEj2_-SE3PosC4g0PU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4Up9aWJx_qv5hGGkFSx_jXeyWjNh-2besK-w8x92w0w&oe=6ABE75C7"}, "display_name": "Containment Initiative: Recon", "keywords": [], "long_description": "Containment Initiative: Recon is a singleplayer version of Containment Initiative designed for standalone headsets.\n\nRealistic Reloading:\nEach weapon handles and reloads just like it's real world counterpart. Mastering reloading is essential to surviving the horde!\n\nProgression:\nRobust progression system which includes: Unlockable guns, attachments, player upgrades, and more.\n\nMission Types:\nCollect supply crates, defend objectives, or just try to survive the horde.\n\nLoot:\nFind random drops that include exclusive weapon skins, a new melee weapon, and ammo upgrades\n\nDismemberment/Blood:\nHeadshots trigger a slow motion effect so you can behold the carnage!", "short_description": "Containment Initiative: Recon is a singleplayer version of Containment Initiative designed for standalone headsets. Take on the horde with different mission types, loot to collect, and gear to upgrade!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gwyngames.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gwyn Games LLC", "support_website_url": null, "website_url": "https:/
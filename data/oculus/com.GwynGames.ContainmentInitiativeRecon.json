B7"}, {"file_name": "CIRecon_SS_4 2560x1440.png", "id": "1443657016474755", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035416_1443657019808088_2486947651465581524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iA3nKtdxPAQ7kNvwHu2T6C&_nc_oc=AdoKOlX3aqQ3l0_jDA-jG-j7Hdq-JCeesY4oDNgRC-xwKXovzMb2sxXcWRuN_u-niqc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITyaqnjK323pseOD8wjsl09PwEQElIscyf3C9oagVXEw&oe=6AA55403"}, {"file_name": "CIRecon_SS_3 2560x1440.png", "id": "610435117841403", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035361_610435121174736_7614005424375505611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewp4JLvvrj4Q7kNvwGe3nfW&_nc_oc=AdoM9QQux1sEPjfUhbTev2eYYYX1zrBxOVWeP7iczPo5GR2ak7oXQWiuRnaewJCG8mQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsR6udQvWNXrfOPk5X9D1IMzKRBYLdS6UrBvQB4nwtSQ&oe=6AA5510F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CIRecon_SS_5 2560x1440.png", "id": "120405504445546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75339313_120405507778879_6926521371564161931_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RbxmAlFbdkQ7kNvwF7dPEx&_nc_oc=Adr5LGNz26Yq1FBgsggVa9OHsmYC5Adc8cT_xoaA8l6zEjm5bmZ3_x1ecyWvTFNN7wY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJni0QiAj2lrj31EGHNLRvBZMCIFL9pPwQJzWpKagLYiA&oe=6AA56947"}, "display_name": "Containment Initiative: Recon", "keywords": [], "long_description": "Containment Initiative: Recon is a singleplayer version of Containment Initiative designed for standalone headsets.\n\nRealistic Reloading:\nEach weapon handles and reloads just like it's real world counterpart. Mastering reloading is essential to surviving the horde!\n\nProgression:\nRobust progression system which includes: Unlockable guns, attachments, player upgrades, and more.\n\nMission Types:\nCollect supply crates, defend objectives, or just try to survive the horde.\n\nLoot:\nFind random drops 
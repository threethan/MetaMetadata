60x1440.png", "id": "1443657016474755", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035416_1443657019808088_2486947651465581524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNbKDdnOLEoQ7kNvwG6Fxsi&_nc_oc=AdkncuM7YjhKScn9D16JGjiPt6Swf66vOuClwAa2gojw7CxljJsunKqdxNhdCZe_L78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxM-HKwlDE74YXjrmhkWBc651Yb_SQz5nPiibnyC8esng&oe=69B56303"}, {"file_name": "CIRecon_SS_3 2560x1440.png", "id": "610435117841403", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035361_610435121174736_7614005424375505611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YA-x-WqisC4Q7kNvwGie9GV&_nc_oc=AdlELERfpFpzDWDUR1caMc5cCfl42-V7k56MeXcr-GflJN1S8iU1gPBfj5UlfXtGdlg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwfbnfWc6Web99BYh2wj0yJ1-gTCZkPYXDaDb-hADxoSg&oe=69B5600F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CIRecon_SS_5 2560x1440.png", "id": "120405504445546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75339313_120405507778879_6926521371564161931_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaLSyjJRW6oQ7kNvwHtVWMu&_nc_oc=AdlFYYGUm6PYElus4Jkbljc8ziSVJ7PmwNI-WgGYkZ1_tmSSLDxq8OqY7N6fkG8PWoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKnRx-zdxoArh7rcH0JY9hh5wAYbeValjgPeyGxxJSvg&oe=69B54007"}, "display_name": "Containment Initiative: Recon", "keywords": [], "long_description": "Containment Initiative: Recon is a singleplayer version of Containment Initiative designed for standalone headsets.\n\nRealistic Reloading:\nEach weapon handles and reloads just like it's real world counterpart. Mastering reloading is essential to surviving the horde!\n\nProgression:\nRobust progression system which includes: Unlockable guns, attachments, player upgrades, and more.\n\nMission Types:\nCollect supply crates, defend objectives, or just try to survive the horde.\n\nLoot:\nFind random drops that include exclusive weapon skins, a new melee weapon, and ammo upgrades\n\nDismemberment/Blood:\nHeadshots trigger a slow motion effect so you can behold the carnage!", "short_description": "Take on the infected horde with different mission types, loot to collect, and gear to upgrade!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gwyngames.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gwyn Games LLC", "support_website_url": null, "website_url": "https://gwyngames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25190751047286316"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827038_684459317681813_164758179976889068_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STFfkicTCnUQ7kNvwGCWAAt&_nc_oc=AdnMsif0pTNcVPtyFPYgw4ZCx3lAURHQvxEBTHJ2c720IG358h7C-wgmxZpJYxn6Pn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXE1fSWQpkG3feiaPyw7TqD3WBVTsb_ZhRdJlD251b_Q&oe=69B55AC1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Containment Initiative: Recon", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "45978150496
05611_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ju2xx2D1LoQ7kNvwF_POl3&_nc_oc=Adr3VTRb4z_ENe0s96G39Yh6FzWAMyldh1D0xVVddnwWcn570J2z8_2B3I64V7n6DI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cmse3huRjThGUW0BUivpmVZd8cg3E7cJZj3XbBJsbbA&oe=6A2EAA0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CIRecon_SS_5 2560x1440.png", "id": "120405504445546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75339313_120405507778879_6926521371564161931_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpRuvosGO8gQ7kNvwF2WvQJ&_nc_oc=AdogAdVs78GWwcL1qXxGKbEJNyURFAErnSsrs-OaEsgNDBbBkw2S8lkLYMoELSOm6ig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9psYDrT8Jpcibw9UFRbGMGzzcjIj4_8rXJH3D9Z4Jfnw&oe=6A2EC247"}, "display_name": "Containment Initiative: Recon", "keywords": [], "long_description": "Containment Initiative: Recon is a singleplayer version of Containment Initiative designed for standalone headsets.\n\nRealistic Reloading:\nEach weapon handles and reloads just like it's real world counterpart. Mastering reloading is essential to surviving the horde!\n\nProgression:\nRobust progression system which includes: Unlockable guns, attachments, player upgrades, and more.\n\nMission Types:\nCollect supply crates, defend objectives, or just try to survive the horde.\n\nLoot:\nFind random drops that include exclusive weapon skins, a new melee weapon, and ammo upgrades\n\nDismemberment/Blood:\nHeadshots trigger a slow motion effect so you can behold the carnage!", "short_description": "Containment Initiative: Recon is a singleplayer version of Containment Initiative designed for standalone headsets. Take on the horde with different mission types, loot to collect, and gear to upgrade!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gwyngames.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gwyn Games LLC", "support_website_url": null, "website_url": "https:/
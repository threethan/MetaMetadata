LQ5F&_nc_oc=Adk2p8AUy5K_ja4kPkkFqMaIsAP_7WjTCCePmZes1SrbZd6HcKgmtijwi_tgVYQ3tGQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_Pzev43FxyHsYi3GwAyL3ZDSlqFEA2T0ce7OkeP8EHQ&oe=69AAD40F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CIRecon_SS_5 2560x1440.png", "id": "120405504445546", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75339313_120405507778879_6926521371564161931_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imMfKJdAdNcQ7kNvwEVIaQT&_nc_oc=AdlvSfza35A57PtQyfylr1jESdFCPksDURjACrKPsglnSXr5jDasgAOiNrT0h5tPST4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6O5A65_CP3n1QMqT9nZ25CBHAs9AeNm9xG55katWnbA&oe=69AAB407"}, "display_name": "Containment Initiative: Recon", "keywords": [], "long_description": "Containment Initiative: Recon is a singleplayer version of Containment Initiative designed for standalone headsets.\n\nRealistic Reloading:\nEach weapon handles and reloads just like it's real world counterpart. Mastering reloading is essential to surviving the horde!\n\nProgression:\nRobust progression system which includes: Unlockable guns, attachments, player upgrades, and more.\n\nMission Types:\nCollect supply crates, defend objectives, or just try to survive the horde.\n\nLoot:\nFind random drops that include exclusive weapon skins, a new melee weapon, and ammo upgrades\n\nDismemberment/Blood:\nHeadshots trigger a slow motion effect so you can behold the carnage!", "short_description": "Containment Initiative: Recon is a singleplayer version of Containment Initiative designed for standalone headsets. Take on the horde with different mission types, loot to collect, and gear to upgrade!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gwyngames.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gwyn Games LLC", "support_website_url": null, "website_url": "https://gwyngames.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags
content-ams2-1.oculuscdn.com/v/t64.5771-25/38974806_1888505351334811_8490911553489365475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNBAqVdh2J0Q7kNvwH0NPkl&_nc_oc=AdpsY5_TZUzL7bAH3tBOkQBlh60U3Yde_qTVqZayRCbwXzWcrRkPVyJZYsA-QS0B8bU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDxy5uLB0kIzp0NfJQS8OI5qSyji9b_xbwFji-y5ABoA&oe=6A9C143D"}, {"file_name": "12.png", "id": "6730338670340826", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974580_6730338673674159_1231446345782209565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMM6DO-03oUQ7kNvwGzfawB&_nc_oc=Ado0xKsrn5NyLiK0gLoJihBDrdCZBAkkFUk5XRTDWfQIvwep42WDq-gB30Mc34wZ7UI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJxs7w5asSYEb8MnZZH1ilbRDhByJIG26EXfz8xSM6Yg&oe=6A9C2338"}, {"file_name": "08-2.png", "id": "545669991589312", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_545669994922645_2369205904750413908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9g9QQ528OwQ7kNvwFXLafg&_nc_oc=Ado3DQUVWqF42H9I8rAYjuutN66gxRjGQKszXuw2W_GYzUlJCDmfr1if8KV_EmdHl4E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3mkrC7HzI1sSiMt5UfE3WMuLnBQ88A2N4h_laaC1fJw&oe=6A9C37A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-02-07-16h44m46s625.png", "id": "981071482834135", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982532_981071486167468_2138473656712619050_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfZSMr6v7YkQ7kNvwFZr7Nw&_nc_oc=Ado891GYOTsYuA3H5BHdQhHnVo4jwOX5CSuOvUbT_O9fJfPEJDFmXfT6OSQIxOurvK8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFKNnsNnlwNymg66QEC8JOs8KyTuDszr1_mdDBmwUiiw&oe=6A9C2AEA"}, "display_name": "Vessk: Play with hand and desk!", "keywords": ["vessk", "handtracking", "desk", "casual"], "long_description": "*All content is currently free and open.\n\nTouch, scratch and tap your desk to control games!\nA casual gaming hub that lets you experience the game with your bare hands!\nThis app is not compatible with Oculus Home desks and couches.\nBut don't worry, you can set up your desk immediately after starting the game.\n\nFeatures:\n\u2605 Take full advantage of hand tracking!\n\u2605 MR experience!\n\u2605 Free of charge! Free coin!\n\u2605 In-game rankings, achievements and following others!\n\u2605 No controller required (if the battery runs out, no matter!)\n\u2605 Fun and easy-to-play games! (Whack an animal, Ball panic in tube)\n\u2605 You can aim for a high score, collect followers, collect achievements, or develop your own style of play!\n\n\u25a0 Vessk is a VR game and SNS that aims to become a space like below:\n\u30fb Everyone can play for a long time.\n\u30fb Follow other players and connect with them in a loose way.\n\u30fb You have your own space and you don't have to stress.\n\u30fb And above all, you can be absorbed in playing.\n", "short_description": "Touch, scratch and tap your desk to control games!\nA casual gaming hub that lets you experience the game with your bare hands!\nThis app is not compatible with Oculus Home desks and couches.\nBut don't worry, you can set up your desk immediately in the game!\nFeatures:\n\u2605 Take full advantage of hand tracking!\n\u2605 MR experience!\n\u2605 Free of charge!\n\u2605 In-game rankings, achievements and following others!\n\u2605 No controller required (if the battery runs out, no matter!)\n\u2605 Fun and easy-to-play games!"}, {"images": {"nodes": []}, "id": "942062107783940", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vessk", "keywords": [], "long_description": "\u203b\u3059\u3079\u3066\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u73fe\u5728\u7121\u6599\u958b\u653e\u3057\u3066\u3044\u307e\u3059\u3002\n\n\u673a\u3092\u89e6\u308a\u3001\u64ab\u3067\u3066\u3001\u53e9\u3044\u3066\u64cd\u4f5c\uff01\n\u7d20\u624b\u3067\u4f53\u611f\u3059\u308b\u3001\u30ab\u30b8\u30e5\u30a2\u30eb\u30b2\u30fc\u30e0\u30fb\u30cf\u30d6\u304c\u767b\u5834\uff01\n\u2605\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u3092\u30d5\u30eb\u6d3b\u7528\uff01\n\u2605MR\u4f53\u9a13\uff01\n\u2605\u57fa\u672c\u7121\u6599\uff01\uff08\u30b3\u30a4\u30f3\u8ab2\u91d1\uff09\n\u2605\u72ec\u81ea\u306e\u30e9\u30f3\u30ad\u30f3\u30b0\u6a5f\u80fd\u3001\u5b9f\u7e3e\u6a5f\u80fd\u3001\u30d5\u30a9\u30ed\u30fc\u6a5f\u80fd\uff01\n\u2605\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u4e0d\u8981\uff08\u96fb\u6c60\u304c\u5207\u308c\u3066\u3082\u5927\u4e08\u592b\uff01\uff09\n\u2605\u89aa\u3057\u307f\u3084\u3059\u3044\u30b2\u30fc\u30e0\u304c\u8907\u6570\u642d\u8f09\uff01\uff08\u30a2\u30cb\u30de\u30eb\u30d1\u30cb\u30c3\u30af\uff01\u3001\u30c1\u30e5\u30fc\u30d6\u30fb\u30dc\u30fc\u30eb\u30fb\u30d1\u30ba\u30eb\uff09\n\n\n\u25bc\u7279\u5fb4\n\u30fb\u3042\u306a\u305f\u306e\u90e8\u5c4b\u306b\u3042\u308b\u300c\u673a\u300d\u3092\u3001\u7d20\u624b\u3067\u89e6\u308a\u3001\u4f53\u611f\u3057\u306a\u304c\u3089\u904a\u3073\u307e\u3059\u3002\n\u30fb\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306f\u4f7f\u3044\u307e\u305b\u3093\u3002\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u306e\u307f\u3067\u904a\u3073\u307e\u3059\u3002\n\u30fb\u72ec\u81ea\u306eUI\u8a2d\u8a08\u3067\u3001VR\u306b\u6163\u308c\u3066\u3044\u306a\u304f\u3066\u3082\u3001\u57fa\u672c\u64cd\u4f5c\u306b\u8ff7\u3044\u307e\u305b\u3093\u3002\n\u30fbVessk\u30b3\u30a4\u30f3\u3092\u4f7f\u3063\u3066\u904a\u3073\u307e\u3059\u3002\u6bce\u65e5\u5fd8\u308c\u305a\u306b\u53d7\u3051\u53d6\u308a\u307e\u3057\u3087\u3046\uff01\n\u30fb\u3082\u3063\u3068\u904a\u3073\u305f\u304f\u306a\u3063\u305f\u3089\u3001\u30b3\u30a4\u30f3\u3092\u8ffd\u52a0\u8cfc\u5165\u3067\u304d\u307e\u3059\u3002\n\u30fb\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30d5\u30a9\u30ed\u30fc\u3057\u3066\u3001\u30b9\u30b3\u30a2\u3092\u7af6\u3044\u5408\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\u30fb\u30e9\u30f3\u30ad\u30f3\u30b0\u30dc\u30fc\u30c9\u3092\u78ba\u8a8d\u3057\u3001\u81
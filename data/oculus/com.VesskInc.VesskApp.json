content-fra5-1.oculuscdn.com/v/t64.5771-25/38974806_1888505351334811_8490911553489365475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtdO7cAMtkYQ7kNvwFC-7rJ&_nc_oc=AdqfZj3tim1qXYtegawPM_sqyxKcd-dvy-QjhxG4gCXeV-s08DGasYLfASCkAhzpIsA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYQbxopx5BHxMr5K36bpDHE-_ROqzSVjJC0V6Emg_Htg&oe=6A5634BD"}, {"file_name": "12.png", "id": "6730338670340826", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974580_6730338673674159_1231446345782209565_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTQJnwivgAEQ7kNvwErhfyw&_nc_oc=AdqvIdHP5wSXe5tET1Lhb1FKyFi2HI-sAJt37h8G52n-ywOVMpOuEG_UUO4eTFAdH_M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEIoM_UMd_A2seRYqBdDJxG5KMP6RDu8_1Sx0S3jWe0g&oe=6A5643B8"}, {"file_name": "08-2.png", "id": "545669991589312", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982699_545669994922645_2369205904750413908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukSQaH3a4w4Q7kNvwE8IM_L&_nc_oc=Adr4RRoAFKsSMskDPXivVWiva9v1uOct12YRqDuXuMUOiU4-V37UksAlD0lpGBUTPu4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXLMcByg7owtVzRonLI1ovG-GDIAJ-Hf_Gz00cwuSo-Q&oe=6A565824"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-02-07-16h44m46s625.png", "id": "981071482834135", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982532_981071486167468_2138473656712619050_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMtZo0XWFqMQ7kNvwHuDWrn&_nc_oc=Adpc9aNpQUZSzff2p17qIY7SU3ut0QRyFxLwcYkKYiPd_zSLvH-TUW45C9kVyVzrWUE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXPleMkPC1dos5q7lcL6yLcXep7M8jRCDEmsTQKK2Yig&oe=6A564B6A"}, "display_name": "Vessk: Play with hand and desk!", "keywords": ["vessk", "handtracking", "desk", "casual"], "long_description": "*All content is currently free and open.\n\nTouch, scratch and tap your desk to control games!\nA casual gaming hub that lets you experience the game with your bare hands!\nThis app is not compatible with Oculus Home desks and couches.\nBut don't worry, you can set up your desk immediately after starting the game.\n\nFeatures:\n\u2605 Take full advantage of hand tracking!\n\u2605 MR experience!\n\u2605 Free of charge! Free coin!\n\u2605 In-game rankings, achievements and following others!\n\u2605 No controller required (if the battery runs out, no matter!)\n\u2605 Fun and easy-to-play games! (Whack an animal, Ball panic in tube)\n\u2605 You can aim for a high score, collect followers, collect achievements, or develop your own style of play!\n\n\u25a0 Vessk is a VR game and SNS that aims to become a space like below:\n\u30fb Everyone can play for a long time.\n\u30fb Follow other players and connect with them in a loose way.\n\u30fb You have your own space and you don't have to stress.\n\u30fb And above all, you can be absorbed in playing.\n", "short_description": "Touch, scratch and tap your desk to control games!\nA casual gaming hub that lets you experience the game with your bare hands!\nThis app is not compatible with Oculus Home desks and couches.\nBut don't worry, you can set up your desk immediately in the game!\nFeatures:\n\u2605 Take full advantage of hand tracking!\n\u2605 MR experience!\n\u2605 Free of charge!\n\u2605 In-game rankings, achievements and following others!\n\u2605 No controller required (if the battery runs out, no matter!)\n\u2605 Fun and easy-to-play games!"}, {"images": {"nodes": []}, "id": "942062107783940", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vessk", "keywords": [], "long_description": "\u203b\u3059\u3079\u3066\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u73fe\u5728\u7121\u6599\u958b\u653e\u3057\u3066\u3044\u307e\u3059\u3002\n\n\u673a\u3092\u89e6\u308a\u3001\u64ab\u3067\u3066\u3001\u53e9\u3044\u3066\u64cd\u4f5c\uff01\n\u7d20\u624b\u3067\u4f53\u611f\u3059\u308b\u3001\u30ab\u30b8\u30e5\u30a2\u30eb\u30b2\u30fc\u30e0\u30fb\u30cf\u30d6\u304c\u767b\u5834\uff01\n\u2605\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u3092\u30d5\u30eb\u6d3b\u7528\uff01\n\u2605MR\u4f53\u9a13\uff01\n\u2605\u57fa\u672c\u7121\u6599\uff01\uff08\u30b3\u30a4\u30f3\u8ab2\u91d1\uff09\n\u2605\u72ec\u81ea\u306e\u30e9\u30f3\u30ad\u30f3\u30b0\u6a5f\u80fd\u3001\u5b9f\u7e3e\u6a5f\u80fd\u3001\u30d5\u30a9\u30ed\u30fc\u6a5f\u80fd\uff01\n\u2605\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u4e0d\u8981\uff08\u96fb\u6c60\u304c\u5207\u308c\u3066\u3082\u5927\u4e08\u592b\uff01\uff09\n\u2605\u89aa\u3057\u307f\u3084\u3059\u3044\u30b2\u30fc\u30e0\u304c\u8907\u6570\u642d\u8f09\uff01\uff08\u30a2\u30cb\u30de\u30eb\u30d1\u30cb\u30c3\u30af\uff01\u3001\u30c1\u30e5\u30fc\u30d6\u30fb\u30dc\u30fc\u30eb\u30fb\u30d1\u30ba\u30eb\uff09\n\n\n\u25bc\u7279\u5fb4\n\u30fb\u3042\u306a\u305f\u306e\u90e8\u5c4b\u306b\u3042\u308b\u300c\u673a\u300d\u3092\u3001\u7d20\u624b\u3067\u89e6\u308a\u3001\u4f53\u611f\u3057\u306a\u304c\u3089\u904a\u3073\u307e\u3059\u3002\n\u30fb\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306f\u4f7f\u3044\u307e\u305b\u3093\u3002\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u306e\u307f\u3067\u904a\u3073\u307e\u3059\u3002\n\u30fb\u72ec\u81ea\u306eUI\u8a2d\u8a08\u3067\u3001VR\u306b\u6163\u308c\u3066\u3044\u306a\u304f\u3066\u3082\u3001\u57fa\u672c\u64cd\u4f5c\u306b\u8ff7\u3044\u307e\u305b\u3093\u3002\n\u30fbVessk\u30b3\u30a4\u30f3\u3092\u4f7f\u3063\u3066\u904a\u3073\u307e\u3059\u3002\u6bce\u65e5\u5fd8\u308c\u305a\u306b\u53d7\u3051\u53d6\u308a\u307e\u3057\u3087\u3046\uff01\n\u30fb\u3082\u3063\u3068\u904a\u3073\u305f\u304f\u306a\u3063\u305f\u3089\u3001\u30b3\u30a4\u30f3\u3092\u8ffd\u52a0\u8cfc\u5165\u3067\u304d\u307e\u3059\u3002\n\u30fb\u4ed6\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30d5\u30a9\u30ed\u30fc\u3057\u3066\u3001\u30b9\u30b3\u30a2\u3092\u7af6\u3044\u5408\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\u30fb\u30e9\u30f3\u30ad\u30f3\u30b0\u30dc\u30fc\u30c9\u3092\u78ba\u8a8d\u3057\u3001\u81ea\u5206\u306e\u5230\u9054\u76ee\u6a19\u306b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\u30fb\u30cf\u30a4\u30b9\u30b3\u30a2\u3092\u76ee\u6307\u3059\u3082\u3088\u3057\u3001\u30d5\u30a9\u30ed\u30ef\u30fc\u3092\u96c6\u3081\u308b\u3082\u3088\u3057\u3001\u5b9f\u7e3e\u3092\u96c6\u3081\u308b\u3082\u826f\u3057\u3001\u81ea\u5206\u3060\u3051\u306e\u904a\u3073\u65b9\u3092\u6975\u3081\u308b\u3082\u3088\u3057\uff01\n\n\u8ab0\u3067\u3082\u9577\u304f\u3001\u307e\u3063\u305f\u308a\u904a\u3076\u3053\u3068\u304c\u3067\u304d\u308b\u3002\n\u307b\u304b\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u30d5\u30a9\u30ed\u30fc\u3057\u3066\u3001\u7de9\u304f\u3064\u306a\u304c\u308b\u3002\n\u81ea\u5206\u3060\u3051\u306e\u7a7a\u9593\u304c\u3042\u308a\u3001\u30b9\u30c8\u30ec\u30b9\u3082\u304b\u304b\u3089\u306a\u3044\u3002\n\u4f55\u3088\u308a\u3001\u5922\u4e2d\u306b\u306a\u308c\u308b\u3002\nVessk\u306f\u3001\u305d\u3093\u306a\u7a7a\u9593\u306b\u306a\u308b\u3053\u3068\u3092\u76ee\u6307\u3057\u3066\u3044\u308b\u3001VR\u30b2\u30fc\u30e0&SNS\u3067\u3059\u3002\n\n\n\u25bc\u904a\u3073\u65b9\n\u30fb\u673a\u306e\u4e0a\u306b\u3001\u5341\u5206\u306a\u30b9\u30da\u30fc\u30b9\u3092\u78ba\u4fdd\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\u30fb\u5b89\u5168\u306e\u70ba\u306b\u3001\u30a2\u30d7\u30ea\u5185\u306b\u8868\u793a\u3055\u308c\u308b\u6ce8\u610f\u4e8b\u9805\u3092\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002\n\u30fb\u3010\u521d\u56de\u306e\u307f\u3011\u8aac\u660e\u304c\u7d42\u308f\u308b\u3068\u3001\u4e00\u6642\u7684\u306b\u30d1\u30b9\u30b9\u30eb\u30fc\u304cON\u306b\u306a\u308a\u307e\u3059\u3002\u305d\u306e\u9593\u306b\u3001\u73fe\u5b9f\u4e16\u754c\u3067\u76ee\u306e\u524d\u306b\u3042\u308b\u300c\u673a\u300d\u3068\u91cd\u306a\u308b\u3088\u3046\u306b\u30013D\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\uff08Vessk\uff09\u3092\u751f\u6210\u3057\u307e\u3059\u3002\n\u30fb\u4ee5\u964d\u306e\u64cd\u4f5c\u306f\u3001\u57fa\u672c\u7684\u306bVessk\u4e0a\u3067\u884c\u3044\u307e\u3059\u3002\n\u30fbVessk\u4e0a
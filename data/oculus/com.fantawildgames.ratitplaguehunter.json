FnyVMlZqRQhc4jDV583b-CRRliLCJgsqIKSzbbHs3kb035psu4-QlZL33dB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvq3D2qN1nqbdB2irwxXBdViDB6VB4WeOUABe7dtS-BNw&oe=69A6F414"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1080823372945703", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982609_1080823376279036_4465831012023362906_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qraHRRK7-EsQ7kNvwGLTMER&_nc_oc=AdlyzwBF66kCpWeb757dxaF1EBbJYMyNNSZdP6Oe1J3fsS_EYDpPKQWrjgCGpwWF_Y4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsXmfa9oRQXG7y5qhgQKwTexCHwiOF8b2WpeWluOQRX3w&oe=69A6E455"}, "display_name": "Rat It: Plague Hunter", "keywords": [], "long_description": "As an outlaw alchemist drifting around the ocean. While exploring an abandoned pirate ship, You Have uncovered rats who have been corrupted by the evil spirits of the deep. It is your duty to pick up magical slingshot paired with alchemical projectiles to exterminate these monsters and uncover the secret in the ship.\n\n- Dynamic VR aiming and shooting mechanism.\n- Combat enemies with different distinct styles and characteristics.\n- Meticulously crafted level designs and engaging interactive \n  elements.\n- Develop your own style of strategy, grow as you play.\n- Advanced enemy AI and mysterious evil boss, learn to exploit their \n  weaknesses.\n\nJoin the official discord for future news:https://discord.gg/gjbp4Q9HeA", "short_description": "Rat It is a single-player magic shooter game in VR. As the alchemist, you must wield your powerful slingshot to eradicate all the evil monsters on a medieval sailing ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com/privacy-policy-en.html", "developer_terms_of_service_url": null, "publisher_name": "Fountain Game Studio", "support_website_url": null, "website_url": "https://www.fountainmeta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], 
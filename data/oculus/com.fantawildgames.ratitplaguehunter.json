iUlYe-HU8OtQqyERxUnjIEmxQVa59kjc4gm6iTI-RmebVAKVVmMUg0jMSesw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs96IMUR0u8cUDNRRWNxKPIzItUxarUnsi-19hTHmJXCA&oe=699B1694"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1080823372945703", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982609_1080823376279036_4465831012023362906_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uPX0Jj22HwQ7kNvwGvN_Y6&_nc_oc=Adk1r6viIBlMUM1v5iD1vST_tmHF_x4FScI43tkqgCOD8N8AQ66pX1GubbeiMgFgOmE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsq9PHSBpraLDzxKzW8bvxJPxS7vRGQ2-h4B3Ngo5O3Xw&oe=699B06D5"}, "display_name": "Rat It: Plague Hunter", "keywords": [], "long_description": "As an outlaw alchemist drifting around the ocean. While exploring an abandoned pirate ship, You Have uncovered rats who have been corrupted by the evil spirits of the deep. It is your duty to pick up magical slingshot paired with alchemical projectiles to exterminate these monsters and uncover the secret in the ship.\n\n- Dynamic VR aiming and shooting mechanism.\n- Combat enemies with different distinct styles and characteristics.\n- Meticulously crafted level designs and engaging interactive \n  elements.\n- Develop your own style of strategy, grow as you play.\n- Advanced enemy AI and mysterious evil boss, learn to exploit their \n  weaknesses.\n\nJoin the official discord for future news:https://discord.gg/gjbp4Q9HeA", "short_description": "Rat It is a single-player magic shooter game in VR. As the alchemist, you must wield your powerful slingshot to eradicate all the evil monsters on a medieval sailing ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com/privacy-policy-en.html", "developer_terms_of_service_url": null, "publisher_name": "Fountain Game Studio", "support_website_url": null, "website_url": "https://www.fountainmeta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], 
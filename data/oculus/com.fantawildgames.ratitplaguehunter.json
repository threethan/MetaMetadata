t64.5771-25/43931327_737571601612335_409887962552474893_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQf0SPkKnVoQ7kNvwG4H39f&_nc_oc=Ado673-ztMotPIN5GbmQsAExW5Q-mpTNGtuD60wOsRdWTcFpUN_eGoiQTuHKlzzTQVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQII1kLr7n_xnHQuVsWSECs5yssY_xrUQRIzqhV1xFylxQ&oe=6AB29494"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1080823372945703", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982609_1080823376279036_4465831012023362906_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93NbzqvAqPgQ7kNvwGYRpG_&_nc_oc=Adpy_dDDCjduPhKz1m-YFZbaJj0_q6Hgploa12QvsCSS43kbWSQKknNE_AJezIO9OFA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4a9CagQM_9_0b_CiIXejqlW1L_qMZrcsxdZUT7l6-Jw&oe=6AB284D5"}, "display_name": "Rat It: Plague Hunter", "keywords": [], "long_description": "As an outlaw alchemist drifting around the ocean. While exploring an abandoned pirate ship, You Have uncovered rats who have been corrupted by the evil spirits of the deep. It is your duty to pick up magical slingshot paired with alchemical projectiles to exterminate these monsters and uncover the secret in the ship.\n\n- Dynamic VR aiming and shooting mechanism.\n- Combat enemies with different distinct styles and characteristics.\n- Meticulously crafted level designs and engaging interactive \n  elements.\n- Develop your own style of strategy, grow as you play.\n- Advanced enemy AI and mysterious evil boss, learn to exploit their \n  weaknesses.\n\nJoin the official discord for future news:https://discord.gg/gjbp4Q9HeA", "short_description": "Rat It is a single-player magic shooter game in VR. As the alchemist, you must wield your powerful slingshot to eradicate all the evil monsters on a medieval sailing ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com/privacy-policy-en.html", "developer_terms_of_service_url": null, "publisher_name": "
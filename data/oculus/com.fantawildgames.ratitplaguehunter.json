tRqV7piL_zI0UHugj00x-5LMLvbWbKxEE9CzaXomojpMpQRe5B6K7HvqfP53D8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfOzuvnkY_mxpOVNFzYj4--JTpRJZVXHqJ-KbO1tuTTQ&oe=6B08507B"}, {"file_name": "1.png", "id": "737571598279002", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/43931327_737571601612335_409887962552474893_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIL5dYoc85QQ7kNvwHdFBpg&_nc_oc=AdpApER5UKZeb8lIXPnDME6qFapyqnZg4bDVurugiOI1Jzt93rH4oSyASXFgePFF_bE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTYrpJJ6PIu6XdgSG8edIJc8epMHLDF9YBh6bjhQIL3w&oe=6B084614"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1080823372945703", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982609_1080823376279036_4465831012023362906_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRlC4EfT1F8Q7kNvwG-IQr4&_nc_oc=AdoM2nPPaX0s212PiQ8nnOkokxFc88MtEEf7hhCbGuzKFBKbfljTGOhJbRq3ntCQYVU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTucV7HEQZpz7lqXMZ4YjGiCcH6-C0mN54t0YEIRn2Nzg&oe=6B086E95"}, "display_name": "Rat It: Plague Hunter", "keywords": [], "long_description": "As an outlaw alchemist drifting around the ocean. While exploring an abandoned pirate ship, You Have uncovered rats who have been corrupted by the evil spirits of the deep. It is your duty to pick up magical slingshot paired with alchemical projectiles to exterminate these monsters and uncover the secret in the ship.\n\n- Dynamic VR aiming and shooting mechanism.\n- Combat enemies with different distinct styles and characteristics.\n- Meticulously crafted level designs and engaging interactive \n  elements.\n- Develop your own style of strategy, grow as you play.\n- Advanced enemy AI and mysterious evil boss, learn to exploit their \n  weaknesses.\n\nJoin the official discord for future news:https://discord.gg/gjbp4Q9HeA", "short_description": "Rat It is a single-player magic shooter game in VR. As the alchemist, you must wield your powerful slingshot to eradicate all the evil monsters on a medieval sailing ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com/privacy-policy-en.html", "developer_terms_of_service_url": null, "publisher_name": "Fountain Game Studio", "support_website_url": null, "website_url": "https://www.fountainmeta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7046861118690350"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75322596_2656048577896266_5126679464239060501_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkk0fAJdHrcQ7kNvwGP_0kV&_nc_oc=AdoRdw6LboWWR--66T9BtqQ6eXDfUbZPcDm2CWR6WO0wASIBYtxY56uwTALxmmeSOnk&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3yiBFS_kx6F9uHjfcqqdY-NQdF9la5tSqfn0QO094Bg&oe=6B0850C3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rat It: Plague Hunter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1704355200, "lastRevision": {"nodes": [{"id": "7046861138690348", "release_type": "SCHEDULED"
lYurIHLUKxxau85IW3cc0t5qHaDiuIntEvm34-fp80HLHNTZdG_f0SsI1eRU_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz_-iFkIqojLeiv6Znk63ZTWxqeu11_Cg0Dze5vJC5kg&oe=6B030A7B"}, {"file_name": "1.png", "id": "737571598279002", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/43931327_737571601612335_409887962552474893_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AlwqIQcRpkQ7kNvwFc_c36&_nc_oc=AdrTwDoIlSy0cnZDBruBXiPAjQ4JKxK00yZ9y0Ud6DODLjLND3HNFC28cV3ZlL9RzA0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIU9XV0TZtdGTSm9v9uNJFuCVhT1T0MBf9Q25iu5m4sw&oe=6B033854"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1080823372945703", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982609_1080823376279036_4465831012023362906_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_NeEgaXFeEQ7kNvwHsL7li&_nc_oc=AdqmKPS8mNzusBL4Rc6RwRXXtCmUQYzWwWNnq_079Lz9XxmpaP_wHlPj8gMvGb_gYOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPtsV7jgBuUS9ZMwlaFCC0c_4USvnrfH1KGl_4lNDRBQ&oe=6B032895"}, "display_name": "Rat It: Plague Hunter", "keywords": [], "long_description": "As an outlaw alchemist drifting around the ocean. While exploring an abandoned pirate ship, You Have uncovered rats who have been corrupted by the evil spirits of the deep. It is your duty to pick up magical slingshot paired with alchemical projectiles to exterminate these monsters and uncover the secret in the ship.\n\n- Dynamic VR aiming and shooting mechanism.\n- Combat enemies with different distinct styles and characteristics.\n- Meticulously crafted level designs and engaging interactive \n  elements.\n- Develop your own style of strategy, grow as you play.\n- Advanced enemy AI and mysterious evil boss, learn to exploit their \n  weaknesses.\n\nJoin the official discord for future news:https://discord.gg/gjbp4Q9HeA", "short_description": "Rat It is a single-player magic shooter game in VR. As the alchemist, you must wield your powerful slingshot to eradicate all the evil monsters on a medieval sailing ship."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fountainmeta.com/privacy-policy-en.html", "developer_terms_of_service_url": null, "publisher_name": "Fountain Game Studio", "support_website_url": null, "website_url": "https://www.fountainmeta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7046861118690350"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75322596_2656048577896266_5126679464239060501_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBNTCaG14QUQ7kNvwEAahLl&_nc_oc=AdphDSUcp4Y418jNM9AJrZ8qdl7v73B2vYI-4iLP4798Y6Gqr5kQf7apUWYEeQ4-LLQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvsdO5sXDpbamUEBJ0hFNm-EXpX6IwmJUNyo04_-bjkw&oe=6B030AC3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rat It: Plague Hunter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1704355200, "lastRevision": {"nodes": [{"id": "7046861138690348", "release_type": "SCHEDULED"
j4Re8TF9z05_g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9Y7UgmEfWwMwOQzN-aDkqbOF4791j8bcAnmuCp3Qf7w&oe=6B0C4A40"}, {"file_name": "04_\u6e38\u4e50\u573a.png", "id": "1863427574653528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628436_1863427577986861_8833135093954642145_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fg_QpMnSOGAQ7kNvwHekHVE&_nc_oc=AdrulMWwROemWlOoZy5CHUZD62DfHvb4gXiADXU5-6Ssb31977kIeRioBGwHadDfxmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGHhoWf1TRWFQf_F9vEAOvHGqcfGEo5iyjMZJNggoJSA&oe=6B0C6065"}, {"file_name": "05_\u5c0f\u533a\u5165\u53e3.png", "id": "976003428507384", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624395_976003435174050_8729402861946452592_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_agGenTJNgQ7kNvwF2UO0i&_nc_oc=Adp-1Ys9UqHT4wzC216f6QnqV6UFb_m0zRCmw3Jo01ezby9htapD0nNbY0iDqc6h-sw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRnwhNIgHrLwTYKuAQKJ4jUIhNKsanYwEOZ-x9L6hS2qg&oe=6B0C4B5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u7248\u5c01\u9762.png", "id": "1189218307009815", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624395_1189218310343148_2698386406489628834_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkPAAwQQe24Q7kNvwF8tbR8&_nc_oc=Adq8AsxZ1hFuJXVlEHN1DlmiI9WqtFRblLzFZLjEX9OxYm18SCT5CfBh6IhXVBm7Czo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdfL2mlIMdqathW2fr2fDZbs8yY6ZMzzXQON1JadZNsA&oe=6B0C607B"}, "display_name": "Return to 2000", "keywords": ["nostalgia", "childhood", "courtyard", "exploration"], "long_description": "Return to 2000 takes you to Rongyin New Village, a Chinese residential neighborhood at the turn of the millennium. Walk past tiled apartment blocks, follow the paths under the trees, and spend a little time with the things children found to do before dinner.\n\nThrow a paper airplane from the courtyard pavilion. Try hopscotch, flick marbles, or pick up a paddle at the table-tennis area. Walk down to the corner shop for an ice pop or soda. Inside apartment A101, slide the window, open a drawer, and look through a picture book.\n\nExplore at your own pace with teleportation, smooth movement, snap turning, and height settings. Watch the neighborhood change from a golden afternoon to rain, snow, or night.\n\nThis is a single-player VR experience played with tracked controllers. Menus, readable signs, the picture book, and the telephone message are in English.", "short_description": "Spend a summer afternoon in a Chinese neighborhood at the turn of the millennium. Fly a paper airplane, play hopscotch and marbles, and explore the corner shop and an old family apartment in a quiet, single-player VR experience.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rongyin-privacy-orange.awareeel11.chatgpt.site/meta-quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "oragneLaoLi", "support_website_url": null, "website_url": "https://rongyin-privacy-orange.awareeel11.chatgpt.site/orange/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1401398999729487"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/4
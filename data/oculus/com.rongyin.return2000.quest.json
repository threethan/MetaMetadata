_J8t7FYDgdxOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFRzZoSUlFR9b2UcV9uPOjcDo-GhZl5sgrV52oKL2fYw&oe=6B0EED40"}, {"file_name": "04_\u6e38\u4e50\u573a.png", "id": "1863427574653528", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628436_1863427577986861_8833135093954642145_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fg_QpMnSOGAQ7kNvwFiReks&_nc_oc=Adron-Bn-j3-t4tqU4Mh22HoxAYF21F0kekSFt1b1qFx2sjERr4sUG5ARL7m4io57Xo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVg_0-rVdoUUaDcXUI1LsX3YJrCiG_Qa9dYNezVNOOu0Q&oe=6B0F0365"}, {"file_name": "05_\u5c0f\u533a\u5165\u53e3.png", "id": "976003428507384", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624395_976003435174050_8729402861946452592_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_agGenTJNgQ7kNvwHArw7e&_nc_oc=Adr6LdfyhxD3VyPTinFCvWOpshVwGs4-zr-wFl7UZEWu7kczb9yO5nppv66xFRNHUR8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWjGkQ9XwPn-7aKUxEo5vZBuhJwhRRIdPIQxeMeskcvNw&oe=6B0EEE5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u7248\u5c01\u9762.png", "id": "1189218307009815", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624395_1189218310343148_2698386406489628834_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6jKq8EgrdoQ7kNvwFU0EL2&_nc_oc=Adrvxt1NJKuKAbMeTX3h8oSroxPfaKx5Y5s2TIaj1p9VFaw7Upk1CB5-fV2143v_DwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWilXE8pKa7HK8FrrH_BzNPtOav65VAY58Bkibjh-dyiA&oe=6B0F037B"}, "display_name": "Return to 2000", "keywords": ["nostalgia", "childhood", "courtyard", "exploration"], "long_description": "Return to 2000 takes you to Rongyin New Village, a Chinese residential neighborhood at the turn of the millennium. Walk past tiled apartment blocks, follow the paths under the trees, and spend a little time with the things children found to do before dinner.\n\nThrow a paper airplane from the courtyard pavilion. Try hopscotch, flick marbles, or pick up a paddle at the table-tennis area. Walk down to the corner shop for an ice pop or soda. Inside apartment A101, slide the window, open a drawer, and look through a picture book.\n\nExplore at your own pace with teleportation, smooth movement, snap turning, and height settings. Watch the neighborhood change from a golden afternoon to rain, snow, or night.\n\nThis is a single-player VR experience played with tracked controllers. Menus, readable signs, the picture book, and the telephone message are in English.", "short_description": "Spend a summer afternoon in a Chinese neighborhood at the turn of the millennium. Fly a paper airplane, play hopscotch and marbles, and explore the corner shop and an old family apartment in a quiet, single-player VR experience.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rongyin-privacy-orange.awareeel11.chatgpt.site/meta-quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "oragneLaoLi", "support_website_url": null, "website_url": "https://rongyin-privacy-orange.awareeel11.chatgpt.site/orange/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1401398999729487"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/4
1540_1006225453899517_5127082584470305371_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QwxYoirI-UQ7kNvwHqCpMh&_nc_oc=AdqTrILyc3XruAbvffBeAypmKxheAkC3NtNfVGBpFDeOjq_MRFxU0XKeZXStMtbtD4E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ7tSy6jrANb86kWrwMjTS2W5ZiH7PjtbJLNguyW5kpQ&oe=6A8D71B7"}, {"file_name": "\u5c0f\u5c9b2.png", "id": "3462144454101465", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75429287_3462144457434798_1598793223503684954_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yd4lw-NkodAQ7kNvwFBbhTQ&_nc_oc=AdrfV2-NTtmd0x3dKexm--cazf-sDraWZ7VkGxi0MnXhWsVzJSwFhytG4qvrRgkdrMw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6aouWfXlBmPe_GvCJSMhSCFa11Q04YYppJ6v8LENPOw&oe=6A8D85B4"}, {"file_name": "\u793e\u4ea4.png", "id": "679237577464246", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75469631_679237580797579_8604269461118317557_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0zfXmEvwugQ7kNvwH6tV8K&_nc_oc=AdogQNIoufi3cn29ishwYhgIcGSOEO86Uh8Jenm7TagcFhYEN9brjZwD5FIdRMq8vpM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXXseFTF4ew4pM5dWtqjLynjuFknl-3Cx4nJYLV5hb9A&oe=6A8D93E5"}, {"file_name": "\u5ba0\u7269.png", "id": "1053853492663802", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75286676_1053853495997135_4368583599451324300_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kBzRnMdN2wQ7kNvwFwK_C3&_nc_oc=AdqmBkTiGCoaOuPc8A4zissJ3n-dqCLZLpA5biX8feZGGPH0pF9B0kqXgBZTMktT_M8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpJKLmFO8MYtjV-UbwdDeiRbznsnX_Duv_MxPFzONdVQ&oe=6A8D83E0"}, {"file_name": "\u6e38\u620f.png", "id": "605428455093106", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031511_605428458426439_6010738124872691051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKwrpJbcoAcQ7kNvwEQRw2_&_nc_oc=AdoVyDpW2dhxxn6J4mrElZd6Opg80A6w3d4Zd014Y9VmgBCmdMcespLt9T7BSivsMwU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCL6e0tQAheH06q66DzRZMrT_k9at-CvSWyF2L8pIPpA&oe=6A8D8216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "221031960469976", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75334055_221031963803309_7065784649018345335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzLoyK5HLJsQ7kNvwHNKbhs&_nc_oc=Adp-9872SxDySdzQ9xQtKW3HedanzkM6yC0MTUjsNZwCnzqTvDu_Lp2BQtGX5M7Guas&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyy0bQrFD51xGv5JvDfH32bzNCT5ZbshlUYpqD3HG-iA&oe=6A8D9A97"}, "display_name": "MageCosmos", "keywords": [], "long_description": "\u3010Own An Island Here\u3011\nMageCosmos is an open world where your adventures are unlimited. Your incredible journey starts on a magical floating island with your own cozy house on it, like everybody else. Looking around, you will find neighbors living on the same island as you do. This is a HUGE world!\n\n\u3010Farm&Factory, Keep It Running\u3011\nYour life on the island depends pretty much on how you manage it. You have a big farm to grow various plants, feed animals, use your harvest to manufacture new items, and complete orders requested over the community to get huge amounts of MageCoins in return while having fun! \n\n\u3010Friends With Neighbors, Even Not With Real Human\u3011\nSpeaking of that, friends are important or it'll be so lonely in such a big world, shake hands with whoever you meet to become friends with and send gifts to them. You can also use a small rocket, fly around and explore the islands. Some AI live there and they're desperate to meet visitors, ask them anything you want!\n\n\u3010Mini-Games And Worlds\u3011\nAs is implied in the name \"Cosmos\", we are creating diverse styles of worlds to travel across, and party games for you and your friends to play together...It's going to be fun!", "short_description": "MageCosmos is a creative VR community for those who look for diverse experience in a single game, the one you can't miss in 2023!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.magecosmos.live/privacy-policy", "developer_terms_of_service_url": "https://www.magecosmos.live/termsofservice", "publisher_name": "Zaidengdeng Holdings HK Limited", "support_website_url": null, "website_url": "https://magecosmos.live/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SOCIAL", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "31603993612582356"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974713_829501881827121_7384025479414914470_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv-6TxdLh-IQ7kNvwFXUoLp&_nc_oc=Adpjb20fAUbxA-f-X2DdXt2KATLo6Ky6mJ9WduMdXy3JCX2XGT2tv3vgAtX9eN5rstw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfLEBu14XT3tXm4Ia41xJ7RyA-mKzrHc3YXzpySLNnbA&oe=6A8D87EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MageCosmos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1623454600, "lastRev
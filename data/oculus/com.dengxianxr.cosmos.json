453899517_5127082584470305371_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5tDXlAU4AcQ7kNvwFhk75h&_nc_oc=AdrY3Kg-brozWHwdkVUgixk3-_5E0HL5WEKr-413puCUh3j2d-fhu82VtleexCTALb8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af369BNvRRkrmKvVb7UAV4_R8UHOZVpK3XyjQyB5ulLkNw&oe=69DBAF77"}, {"file_name": "\u5c0f\u5c9b2.png", "id": "3462144454101465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429287_3462144457434798_1598793223503684954_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEac9MdIyu8Q7kNvwGE-luE&_nc_oc=AdrJgMU3fbZc8Ij6UdIu0cJaRcjcmryhARV73GjYX_UoGBiR-Tp9qEZw9-BocvyxdO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O2PZn_pFA-iZaekTGsGGBcWRu8dSVbnIsCDpqa8Eekw&oe=69DB8B34"}, {"file_name": "\u793e\u4ea4.png", "id": "679237577464246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469631_679237580797579_8604269461118317557_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XwNZRKMPHMQ7kNvwHMY0de&_nc_oc=AdrX4eyC8v2OHk7k_Tuzs_F2KsrHnQhq3HpmmX5-7DR5z85tEQ454W7RdogTBb837l0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yWRV3qTtvXoGgBewGPvHefJXtEkruq5CDxeSR5YWJBg&oe=69DB9965"}, {"file_name": "\u5ba0\u7269.png", "id": "1053853492663802", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286676_1053853495997135_4368583599451324300_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNSRMbULQi0Q7kNvwFbkxra&_nc_oc=Adr12UL9bM7jLAFc-V7x3SSXKQEmSRk9chZI7EZI_UV76Awrde0ql_Hd9zbZy-KpH0Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RAHISK7h4xaDwfENymdxnqjUotGzfc6Hfth-0Dk2-Fw&oe=69DB8960"}, {"file_name": "\u6e38\u620f.png", "id": "605428455093106", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031511_605428458426439_6010738124872691051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b06zBJbaAGQQ7kNvwHvGtTl&_nc_oc=AdoIPHD8LPL5IF58HwVEjVj1C4EpjOWeEcTBGMW7XMabv1rcSmDZQvdjNeLK58rotUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38U5SXdLE0La1Ayzj-cVvBTmGKPzeaFrPiBGC6BTmJKg&oe=69DB8796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "221031960469976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334055_221031963803309_7065784649018345335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPDCOhgJk5wQ7kNvwE74w4X&_nc_oc=AdqEAzP_soHJUjSDYMOHMXDsTKElREkjhweZjcB0fBnh2z6dbULx1YJvrecmW7aCZJk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OfPf6AzKuKeCObqPADTKDk_2O_iw_9iSrnxrV2S_3Iw&oe=69DBA017"}, "display_name": "MageCosmos", "keywords": [], "long_description": "\u3010Own An Island Here\u3011\nMageCosmos is an open world where your adventures are unlimited. Your incredible journey starts on a magical floating island with your own cozy house on it, like everybody else. Looking around, you will find neighbors living on the same island as you do. This is a HUGE world!\n\n\u3010Farm&Factory, Keep It Running\u3011\nYour life on the island depends pretty much on how you manage it. You have a big farm to grow various plants, feed animals, use your harvest to manufacture new items, and complete orders requested over the community to get huge amounts of MageCoins in return while having fun! \n\n\u3010Friends With Neighbors, Even Not With Real Human\u3011\nSpeaking of that, friends are important or it'll be so lonely in such a big world, shake hands with whoever you meet to become friends with and send gifts to them. You can also use a small rocket, fly around and explore the islands. Some AI live there and they're desperate to meet visitors, ask them anything you want!\n\n\u3010Mini-Games And Worlds\u3011\nAs is implied in the name \"Cosmos\", we are creating diverse styles of worlds to travel across, and party games for you and your friends to play together...It's going to be fun!", "short_description": "MageCosmos is a creative VR community for those who look for diverse experience in a single game, the one you can't miss in 2023!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.magecosmos.live/privacy-policy", "developer_terms_of_service_url": "https://www.magecosmos.live/termsofservice", "publisher_name": "Zaidengdeng Holdings HK Limited", "support_website_url": null, "website_url": "https://magecosmos.live/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SOCIAL", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "31603993612582356"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_829501881827121_7384025479414914470_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwMCX_ZuFxUQ7kNvwF0hye1&_nc_oc=AdoJilly1CUK8nAUXFpUbVc_hMFS3SQZQcKAhwtQEeNsdCO8kpCOei2Vn-koCibB90g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NxpKlE6Tyd3831Vl6WK_S0LR2LPGCsFFggW8PqqXuRA&oe=69DB8D6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MageCosmos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1623454600, "lastRevision": {"nodes": [{"i
.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uBk6lOoCUUQ7kNvwGYXwe0&_nc_oc=Adk6hkU4MMrRVLs0DOrWXnDSSMNcdFFF2ncTP48T7P1LpjAv9Um6-tH7PliPQmL3TqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJCw1UGodmK-weiEhM0mpJylAmwUpN6UlS5Ac1wN6xXQ&oe=69A2D3A8"}, {"file_name": "2023\u5ba3\u4f20\u56fe4.png", "id": "3319674008284898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031605_3319674011618231_7592473528731392338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmljKTAQ2xwQ7kNvwFvPu-y&_nc_oc=AdnyomuJDxdLKwkCxh3rNlLZ4NAHDadU0lq6X4fTAYCt3QxH7kyM5jqlSFp-f669-10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuOWi3EEs885KVDUVLdrQDMzxLNHUEdOhlw1eZxkCmXUw&oe=69A2EE87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "556498836578982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031605_556498839912315_5621686033570235859_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCUmbBYqY44Q7kNvwFpAcOT&_nc_oc=AdlyLVyZ0GLe1KgDHCELySbeRl5JHyxbSgbcBOL3ZhqDBL4gqVhnHw0kaNGfrPQaUdc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftO0UNUpGLr6rLTvJ8L9Y8NmCJNwxXnhvkIg597BL51gw&oe=69A2EE20"}, "display_name": "MageCosmos", "keywords": [], "long_description": "\u3010\u6765\uff0c\u5f53\u5c9b\u4e3b\uff01\u3011\n\u5728\u5de8\u5927\u7684\u5c9b\u7fa4\u4e2d\uff0c\u4f60\u7684\u5947\u5999\u65c5\u7a0b\u4ece\u4e00\u4e2a\u7f8e\u4e3d\u7684\u6d6e\u7a7a\u5c0f\u5c9b\u5f00\u59cb\uff0c\u4f60\u5c06\u62e5\u6709\u81ea\u5df1\u7684\u6e29\u99a8\u5c0f\u5c4b\u3001\u7cbe\u81f4\u7684\u519c\u573a\u3001\u673a\u5668\u5de5\u5382\uff0c\u4ee5\u53ca\u901a\u5f80\u4e16\u754c\u5404\u5730\u7684\u7a7a\u95f4\u4e4b\u95e8\u2014\u2014\u73af\u987e\u56db\u5468\uff0c\u4f60\u4f1a\u53d1\u73b0\u5468\u56f4\u5e03\u6ee1\u7684\u5176\u4ed6\u7684\u5c0f\u5c9b\u3002\u6ca1\u9519\uff0c\u4f60\u7684\u90bb\u5c45\u73af\u7ed5\u5468\u56f4\uff0c\u7b49\u7740\u4f60\u4e0d\u671f\u800c\u9047\u7684\u63a2\u8bbf\u3002\n\n\u3010\u519c\u573a&\u5de5\u5382\uff0c\u8fd0\u8f6c\u4e0d\u505c\uff01\u3011\n\u4f5c\u4e3a\u5c9b\u4e3b\uff0c\u4f60\u7684\u9996\u8981\u4efb\u52a1\u662f\u7ecf\u8425\u597d\u81ea\u5df1\u7684\u519c\u573a\uff0c\u8fd9\u4e5f\u662f\u4f60\u53d1\u5bb6\u81f4\u5bcc\u7684\u4e3b\u8981\u6e20\u9053\uff0c\u79cd\u690d\u5404\u7c7b\u4f5c\u7269\uff0c\u9972\u517b\u5404\u7c7b\u7272\u755c\uff0c\u5b83\u4eec\u5c06\u4e3a\u4f60\u5e26\u6765\u5404\u79cd\u5404\u6837\u7684\u6536\u83b7\u3002\u800c\u5c0f\u5c9b\u4e00\u4fa7\u7684\u673a\u5668\u5de5\u5382\uff0c\u5c06\u4f1a\u4e3a\u4f60\u628a\u8fd9\u4e9b\u539f\u6599\u52a0\u5de5\u6210\u4e3a\u9ad8\u7ea7\u7684\u98df\u54c1\u3001\u7528\u54c1\uff0c\u4ee5\u6ee1\u8db3\u5468\u56f4\u5c45\u6c11\u4eec\u7684\u751f\u6d3b\u9700\u8981\u3002\u5f53\u7136\u4e86\uff0c\u8fd9\u4e5f\u5c06\u4e3a\u4f60\u5e26\u6765\u4e30\u539a\u7684\u56de\u62a5\uff0c\u63d0\u5347\u4f60\u5728\u5c9b\u6c11\u4e4b\u95f4\u7684\u58f0\u671b\u3002\u603b\u4e4b\uff0c\u539f\u5219\u5c31\u662f\uff1a\u4e0d\u8981\u8ba9\u673a\u5668\u505c\u6b62\u8fd0\u8f6c~\uff01\n\n\u3010\u8d85\u6709\u8da3\u7684\u4ea4\u53cb\u8111\u6d1e\uff01\u3011\n\u4ea4\u670b\u53cb\u662fMC\u4e16\u754c\u4e2d\u7684\u6838\u5fc3\uff0c\u5728\u8fd9\u91cc\u4f60\u5c06\u6709\u5f88\u591a\u673a\u4f1a\u8ba4\u8bc6\u6709\u8da3\u7684\u670b\u53cb\u4eec\u2014\u2014\u79c0\u4e00\u4e0b\u72ec\u5bb6\u70ab\u9177\u7684\u5f62\u8c61\uff1f\u70ab\u8000\u4e00\u4e0b\u521a\u521a\u62bd\u5230\u7684\u5f3a\u529b\u5ba0\u7269\uff1f\u53bb\u522b\u4eba\u519c\u573a\u5077\u83dc\u4e0d\u5c0f\u5fc3\u88ab\u6293\u5230\uff1f\u8fd8\u662f\u4e00\u8d77\u6765\u4e00\u573a\u9163\u7545\u6dcb\u6f13\u7684\u7edd\u5730\u51fa\u51fb\u5bf9\u51b3\u6bd4\u8d5b\uff1f\u8fd9\u91cc\u7684\u4ea4\u53cb\u65b9\u5f0f\u4ece\u6765\u4e0d\u53ea\u9650\u4e8eSay Hello!\n\n\u3010\u4e0d\u88ab\u5b9a\u4e49\uff0c\u73a9\u6cd5\u5c42\u4e0d\u51fa\u7a77\uff01\u3011\n\u9664\u4e86\u8fd9\u4e9b\uff0c\u5728MC\u4e16\u754c\u4e2d\u4f60\u8fd8\u53ef\u4ee5\u53ec\u5524\u5ba0\u7269\u966a\u4f60\u5192\u9669\uff0c\u4e0e\u597d\u53cb\u7ec4\u961f\u8fdb\u884cPVP\uff0cPVE\u5c0f\u6e38\u620f\uff0c\u53c2\u52a0\u4e30\u5bcc\u591a\u5f69\u7684\u793e\u533a\u6d3b\u52a8\uff0c\u8fd8\u53ef\u4ee5\u57283D\u7ed8\u753b\u7a7a\u95f4\u5b8c\u6210\u4e00\u5e45\u7acb\u4f53\u7684\u753b\u4f5c\u5206\u4eab\u5728\u793e\u533a\uff0c\u6216\u8005\u72ec\u81ea\u63a2\u7d22\u98ce\u683c\u5404\u5f02\u7684\u804a\u5929\u5ba4\uff0c\u7559\u4e0b\u4e00\u5f20\u5408\u5f71\uff0c\u4e0d\u7ba1\u4ec0\u4e48\u4f53\u9a8c\uff0c\u90fd\u9887\u5177\u7279\u8272\uff01\n\n\u6700\u540e\uff0c\u6dfb\u52a0\u5c0f\u52a9\u624b\u7684\u5fae\u4fe1\uff08\u641c\u7d22\u6e38\u620f\u540d\uff09\u624d\u662f\u6b63\u7ecf\u4e8b\uff0c\u52a0\u5165\u6d3b\u8dc3\u7684\u73a9\u5bb6\u793e\u7fa4\uff0c\u83b7\u5f97\u7b2c\u4e00\u624b\u7684\u65b0\u9c9c\u4fe1\u606f\u548c\u6d3b\u52a8\u9884\u544a\uff0c\u8ba9\u5404\u4f4d\u5927\u4f6c\u5e26\u4f60\u98de\uff0c\u671f\u5f85\u840c\u65b0\u7684\u201c\u4e0a\u5c9b\u201d~", "short_description": "MageCosmos\u662f\u4e00\u4e2a\u5145\u6ee1\u521b\u610f\uff0c\u4f20\u64ad\u6b22\u4e50\u7684\u5f00\u653e\u4e16\u754c\uff0c\u8fd9\u91cc\u7684\u5c45\u6c11\u4eec\u90fd\u88ab\u79f0\u4e3a\u201c\u5c9b\u6c11\u201d\uff0c\u5728\u8fd9\u4e2a\u5de8\u5927\u7684\u4e91\u4e0a\u5c9b\u7fa4\u4e2d\uff0c\u4f60\u7684\u65c5\u7a0b\u5c06\u4ece\u81ea\u5df1\u7684\u6d6e\u7a7a\u5c0f\u5c9b\u5f00\u59cb...\u6211\u4eec\u53ea\u80fd\u900f\u9732\u8fd9\u4e48\u591a\uff0c\u63a5\u4e0b\u6765\u7684\u63a2\u7d22\u5c06\u4f1a\u7cbe\u5f69\u7eb7\u5448\uff0c\u4ea4\u5230\u4f60\u7684\u624b\u4e0a\uff01"}, {"images": {"nodes": []}, "id": "4250942308562803", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MageCosmos", "keywords": [], "long_description": "\u3010\u6765\u3066\u3001\u5cf6\u4e3b\u306b\u306a\u308d\u3046\uff01\u3011\n\u5de8\u5927\u306a\u5cf6\u7fa4\u306e\u4e2d\u3067\u3001\u3042\u306a\u305f\u306e\u4e0d\u601d\u8b70\u306a\u65c5\u306f\u7f8e\u3057\u3044\u6d6e\u904a\u3059\u308b\u5c0f\u5cf6\u304b\u3089\u59cb\u307e\u308a\u307e\u3059\u3002\u3042\u306a\u305f\u306f\u81ea\u5206\u3060\u3051\u306e\u6696\u304b\u3044\u5c0f\u5c4b\u3001\u7cbe\u5de7\u306
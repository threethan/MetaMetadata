=00_Af0mx6QiO1jAnXXsQsmKOTaVpwEL7Nm0KfgBYc3gyPOIfw&oe=69EDFC96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "221031960469976", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334055_221031963803309_7065784649018345335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpqwTh70dRkQ7kNvwFwoVOt&_nc_oc=AdqNrk_lNuUttkGxF82HTwVFCtzbBvABIK8Ky2QYELq8GhWgBkuouf8aveO4a5ih64k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18K6W0YsfCpw6RvJsjoADZnTagr_nqWQBmbthdLvuGsg&oe=69EE1517"}, "display_name": "MageCosmos", "keywords": [], "long_description": "\u3010Own An Island Here\u3011\nMageCosmos is an open world where your adventures are unlimited. Your incredible journey starts on a magical floating island with your own cozy house on it, like everybody else. Looking around, you will find neighbors living on the same island as you do. This is a HUGE world!\n\n\u3010Farm&Factory, Keep It Running\u3011\nYour life on the island depends pretty much on how you manage it. You have a big farm to grow various plants, feed animals, use your harvest to manufacture new items, and complete orders requested over the community to get huge amounts of MageCoins in return while having fun! \n\n\u3010Friends With Neighbors, Even Not With Real Human\u3011\nSpeaking of that, friends are important or it'll be so lonely in such a big world, shake hands with whoever you meet to become friends with and send gifts to them. You can also use a small rocket, fly around and explore the islands. Some AI live there and they're desperate to meet visitors, ask them anything you want!\n\n\u3010Mini-Games And Worlds\u3011\nAs is implied in the name \"Cosmos\", we are creating diverse styles of worlds to travel across, and party games for you and your friends to play together...It's going to be fun!", "short_description": "MageCosmos is a creative VR community for those who look for diverse experience in a single game, the one you can't miss in 2023!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.magecosmos.live/privacy-policy", "developer_terms_of_service_url": "https://www.magecosmos.live/termsofservice", "publisher_name": "Zaidengdeng Holdings HK Limited", "support_website_url": null, "website_url": "https://magecosmos.live/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SOCIAL", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "31603993612582356"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_829501881827121_7384025479414914470_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE_oPE2-JLEQ7kNvwE6HGin&_nc_oc=AdqFoMwW3qY_UYRIcmMW-Tr33cJHzo9mWb2fwsIcFVJ0wV6J9EJ6V2YK0_mm3MJkbO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06qSFX_brpFoF2MFC11LR_xCh7rVFLR63oXKgU_mt3Dw&oe=69EE026B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MageCosmos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1623454600, "lastRevision": {"nodes": [{"i
453899517_5127082584470305371_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsG6bcIZtvEQ7kNvwFzvy0O&_nc_oc=AdpHCoo8hI3fYGGFABaAEnBf6dnz5Tsz7X9jW2JhyFC8ui2LbGYW4prNRYwRulr83YQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3LTsmpJHMgb6mICBvKEft21_bAVlgs4mYyLxVP10evw&oe=6AE74FF7"}, {"file_name": "\u5c0f\u5c9b2.png", "id": "3462144454101465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429287_3462144457434798_1598793223503684954_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvNZY5EFxUcQ7kNvwElNMW9&_nc_oc=Adog-G1Yf8o3Gk8I8A-X4XJhXsygGM9lMTHXvHFzAPVYBCS3i49EtWOQDvpRewMwqSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPIUu8MQ9Bq9KeqcH-vdJs2QIPtaz2DPK5P8Is6O-o0Q&oe=6AE763F4"}, {"file_name": "\u793e\u4ea4.png", "id": "679237577464246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75469631_679237580797579_8604269461118317557_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZgXoQdC6V8Q7kNvwE5VLDe&_nc_oc=Adrq6HW3co0E_bwIBCHIHkC3aLItbWrMoHQKJ0KV40Mtkx54gVtIwap6Y9hoOh0r9Lw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRODLDX5gALz9sRiwqsoLmojV-cHz6xlQXHmr2jCq7pPQ&oe=6AE739E5"}, {"file_name": "\u5ba0\u7269.png", "id": "1053853492663802", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75286676_1053853495997135_4368583599451324300_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CkJVSGiPMcQ7kNvwHMd9r6&_nc_oc=Adr4iNaT7eL366TgyrMuVWtXdshvozdBEa6zlxtCKaPAjLoYg_2U_E4zQq3G-Wovh_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPSxq0LbfClPq6mpuysc6ty-Tl7nqJ5B2hBkmmWKbd8A&oe=6AE76220"}, {"file_name": "\u6e38\u620f.png", "id": "605428455093106", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031511_605428458426439_6010738124872691051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N7GR7cIa5UQ7kNvwG6rlUj&_nc_oc=AdpW5ZDdBtjOUnxqpmbST7Y2B20KU7aWp2jWVf-3vHiniECZjPsRlV52PIkLoE2W7Yg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcVirAXoKPh6TVzMTXU471jlXfp7z3GV1OxDgKXkYM1w&oe=6AE76056"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "221031960469976", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334055_221031963803309_7065784649018345335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmLFC_z8b4oQ7kNvwHVeO_6&_nc_oc=AdpoMPgAUCe6pOhohW4GNBxPIIh6RSm-vVeVlxyKdv33fP4SRKG8IlOFRXvH4F6dKF4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8gIuHjjEpIgSuD2KMwvvsrxur4tUunEl7SAcZITL1HA&oe=6AE74097"}, "display_name": "MageCosmos", "keywords": [], "long_description": "\u3010Own An Island Here\u3011\nMageCosmos is an open world where your adventures are unlimited. Your incredible journey starts on a magical floating island with your own cozy house on it, like everybody else. Looking around, you will find neighbors living on the same island as you do. This is a HUGE world!\n\n\u3010Farm&Factory, Keep It Running\u3011\nYour life on the island depends pretty much on how you manage it. You have a big farm to grow various plants, feed animals, use your harvest to manufacture new items, and complete orders requested over the community to get huge amounts of MageCoins in return while having fun! \n\n\u3010Friends With Neighbors, Even Not With Real Human\u3011\nSpeaking of that, friends are important or it'll be so lonely in such a big world, shake hands with whoever you meet to become friends with and send gifts to them. You can also use a small rocket, fly around and explore the islands. Some AI live there and they're desperate to meet visitors, ask them anything you want!\n\n\u3010Mini-Games And Worlds\u3011\nAs is implied in the name \"Cosmos\", we are creating diverse styles of worlds to travel across, and party games for you and your friends to play together...It's going to be fun!", "short_description": "MageCosmos is a creative VR community for those who look for diverse experience in a single game, the one you can't miss in 2023!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.magecosmos.live/privacy-policy", "developer_terms_of_service_url": "https://www.magecosmos.live/termsofservice", "publisher_name": "Zaidengdeng Holdings HK Limited", "support_website_url": null, "website_url": "https://magecosmos.live/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SOCIAL", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "31603993612582356"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974713_829501881827121_7384025479414914470_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCG_liIF6oUQ7kNvwHWvjQl&_nc_oc=AdrB_JETUXf6ZqxeVGNlFcUTN3ElLPZRAKQvcvV7J8A1AmkVJRTRrKGOummhdzmhP30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWK3wiA8nTnxqDLpyj0p0t6JskV9-FZ3rDyvXsXNN3sg&oe=6AE7662B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MageCosmos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1623454600, "lastRevision": {"nodes": [{"i
s49w&oe=6A940CE7"}, {"file_name": "CPR Simulator Screenshot 2560x1440 3.png", "id": "237152124713912", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974499_237152128047245_4186549481188625791_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLBVtlOrvvUQ7kNvwH78vRW&_nc_oc=AdreOMMSAME8khXdCQaN-EP3q2vfOiVd-vlIhacGBjNjBQ4XAGEOKqgsyNMnFeQ929g&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZzcLqn7cBKpfYZW1iz2qm8ntqhWsLjvRMME2GpvkzuA&oe=6A9419E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CPR Simulator Cover Image 2560x1440.png", "id": "248337803509881", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982568_248337806843214_8523022448071488780_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoqpbb2uqvMQ7kNvwHNIrXj&_nc_oc=Ado_EKVvKZrguaHUxVG-tYl7pRKFOpSVddY9xi4ysMGaKuwTw2i2WEKfpRd7K4gKedU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-60oRhq51iieopTkdRhuVBwFLNL7DHM0lFG6LKioKjw&oe=6A9409A2"}, "display_name": "CPR Simulator", "keywords": [], "long_description": "This type of training is often difficult to get access to, because it often requires an expert instructor, CPR Training Equipment (doll, AED, hygiene material, etc.), and a lot of time. \n\nCPR Simulator makes CPR training widely available in a simple, intuitive, and customisable way. \n\nAlmost every person needs to go through CPR training one or two times in their life, and many professionals are required to go through it every year or every second year.\n\nAATE VR has partnered up with First-8, who's a  renowned company, selling first aid courses and material to both consumers and big companies.\n\nMore environments/scenarios will be added, variations of AED models will be incorporated, and NPC\u2019s will be added after release.", "short_description": "A simple tool to train CPR practices, and learn how to use an AED.\n\nEach sale of CPR Simulator will go into creating an even better learning experience, with more environments, types of citizens, random events and scenario customisation."}]}, "developer_name": "AATE VR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1nF9x3658ovfvDoo2C6i5clupYAiGe4TwFG3wLTqlwJw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "AATE VR", "support_website_url": null, "website_url": "https://aatevr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "MEDICINE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "343011881026697"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "303710558931330"}, {"status": "PUBLISHED", "id": "534313217922918"}, {"status": "PUBLISHED", "id": "1141853079756623"}, {"status": "PUBLISHED", "id": "533894971078882"}, {"status": "PUBLISHED", "id": "1533417267405794"}]}, "baseline_offer": {"id": "1533417267405794"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1695675975, "status": "PUBLISHED", "id": "303710558931330"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33970414369269170", "version": "2.3"}, "id": "238748594519640", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Appli
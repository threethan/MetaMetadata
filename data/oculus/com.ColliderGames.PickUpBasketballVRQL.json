rihDkFMp-9-H7_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2K1V9ASq1deRC2ugzzygJtpyL08iPnGRKqhvijr1cFWw&oe=69E8C695"}, {"file_name": "Shoot Over Player Oculus Store.png", "id": "333725871202780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75435285_333725874536113_7065744928366206780_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jq1crRMud0UQ7kNvwFBm-Z5&_nc_oc=AdpnMzLzBhVFHvtqC7h7P6PqHCm6EI-g446Zg3oqweGhOS7RMvKi4lwQ7usdxdRQPBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UcKVP-Q64zkuZF8pTKVFL9b4MUAW_03QrCLqmvk86fw&oe=69E8AF17"}, {"file_name": "Paris Bright Oculus Store.png", "id": "220059216432030", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75375083_220059219765363_5619007595863505849_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOXieq5OQUsQ7kNvwFEqcVm&_nc_oc=Adomg6Qgw0GrpHUSbiyYUYMpIBlxT3KFhmeHUeb9oys73SJkYQgf1BgeT0NZvS69J4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2w_97bYVGUGe6GPfoiGe8rd50KOq9n7oHrq_TDZI4oIA&oe=69E8BD2A"}, {"file_name": "3 Point Winner Screen Oculus Store.png", "id": "1095687000936315", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575347_1095687004269648_6352501114012345669_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WANzILZ-BT4Q7kNvwEa2XaQ&_nc_oc=Adq85iyHLZuhkxHLm-Jg5sbdbnuqC5LkU-8tNiryHEWp1LPILIS-qRxMgDGh3sNVEjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Lt_yuENj7vdcukgJLqm8_uP_xtGJ4qAvsvMmFq9eAiA&oe=69E8BBF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pickup Basketball VR", "keywords": [], "long_description": "Pickup Basketball VR is a multiplayer VR game that lets up to 4 players play in various game modes including 1v1, 2v2, Horse and 3-point contest. Pickup Basketball VR allows players to compete online with or against friends and players from across the world.\n\nThis basketball game is an immersive sports gaming experience like never-before utilizing the technology of VR.\n\nPickup Basketball VR utilizes unique technology in allowing  for a never-before experienced simulation of basketball featuring:\n\n- Realistic controls that involve dribbling, shooting, passing that brings you the feel of a true basketball game\n\n- Multiplayer mode where you can play other players online and test your skills in full play pick up games\n\n- Different court options including playground, gym, skyrise and more.\n\n- Customize your player avatar with a variety of options including face, skin tone, hair, jersey and other accessories", "short_description": "Pickup Basketball VR is a multiplayer VR game that lets up to 4 players play in various game modes including 1 v 1, 2 v 2, Horse and 3-point contest. Pickup Basketball VR allows players to compete online with or against friends and players from across the world."}]}, "developer_name": "Revog Games", "developer_privacy_policy_url": "https://pickupbasketball.riffxr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Ron Revog", "support_website_url": null, "website_url": "https://pickupbasketball.riffxr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1737450049940320"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1
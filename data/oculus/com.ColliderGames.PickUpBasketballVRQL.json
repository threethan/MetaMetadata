arD9miRO-KJWIKE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFwsvgNLgxkuxse0aBJyrOjO5gGoKaAxICD8opnJHCmg&oe=6A7F1195"}, {"file_name": "Shoot Over Player Oculus Store.png", "id": "333725871202780", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75435285_333725874536113_7065744928366206780_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tjexitt115UQ7kNvwFEnMwd&_nc_oc=AdqqrNr1yZ48YqsfwBsngXxj1YhBAlDVaZzOJGd-L66dvHbySOhl-jtwfBLmHstLMDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI6NFViP43S3xMqNecTHtQUgdguz0sumwXE9HCu0czgQ&oe=6A7EFA17"}, {"file_name": "Paris Bright Oculus Store.png", "id": "220059216432030", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375083_220059219765363_5619007595863505849_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtRK0mDmZFMQ7kNvwGIWwbm&_nc_oc=Adp8vJI3MwEyxxQKaT4ugGLvJ4QMNlKG6yLhykvTyY-MTeNHkzarrYLyvveIykZ4nV0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6vo7J38Vb5i1_npPeEi6lqEvfeGufTfXIYG3sITJv_g&oe=6A7F082A"}, {"file_name": "3 Point Winner Screen Oculus Store.png", "id": "1095687000936315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575347_1095687004269648_6352501114012345669_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3EQakuCxqMQ7kNvwEXo1GT&_nc_oc=AdrXkBzifkNjGiI2NK04-qmkaO4Dut9CYTJ0i0awDbPPJxUkn_Nl3HPZ5fDotx5oO8w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc6MyqaefoN-5O9hpPBh60TY2dwMIqLXwaRv6TQnFUiQ&oe=6A7F06F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pickup Basketball VR", "keywords": [], "long_description": "Pickup Basketball VR is a multiplayer VR game that lets up to 4 players play in various game modes including 1v1, 2v2, Horse and 3-point contest. Pickup Basketball VR allows players to compete online with or against friends and players from across the world.\n\nThis basketball game is an immersive sports gaming experience like never-before utilizing the technology of VR.\n\nPickup Basketball VR utilizes unique technology in allowing  for a never-before experienced simulation of basketball featuring:\n\n- Realistic controls that involve dribbling, shooting, passing that brings you the feel of a true basketball game\n\n- Multiplayer mode where you can play other players online and test your skills in full play pick up games\n\n- Different court options including playground, gym, skyrise and more.\n\n- Customize your player avatar with a variety of options including face, skin tone, hair, jersey and other accessories", "short_description": "Pickup Basketball VR is a multiplayer VR game that lets up to 4 players play in various game modes including 1 v 1, 2 v 2, Horse and 3-point contest. Pickup Basketball VR allows players to compete online with or against friends and players from across the world."}]}, "developer_name": "Revog Games", "developer_privacy_policy_url": "https://pickupbasketball.riffxr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Ron Revog", "support_website_url": null, "website_url": "https://pickupbasketball.riffxr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1737450049940320"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1
0_AfvxBJtVj93rK7p3D_PmX1XCcCI61XiHvXkV_moplAiaDg&oe=69A6D30F"}, {"file_name": "s1.png", "id": "1322096299115905", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391946_1322096302449238_531702345048591404_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtlRJYIK5okQ7kNvwHyiIFr&_nc_oc=AdnHKUg9rSLEa8e2yzbLFn2ERjxGVsWm5XgHYjqwsHGCopLb4o2sS8XDY93RSXQSNyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvsRb1J868vLfOnC3aUXT1RXiBWUcbzYML5Q6d1rhWMZA&oe=69A6D5BB"}, {"file_name": "s4.png", "id": "635328276046486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391964_635328279379819_7863509223355269491_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCLWiDlmfxcQ7kNvwF9YCEQ&_nc_oc=AdlxUDfJ1kc7Q0e98b65kSC532DU-PAd7VUUVw-DxAoZ6_d5VZjXFNUql290B9_e7Nk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afso65uS4tdr9kjjFNgRZi_6_M6UgCMSl3gmJJoSx7c0Gg&oe=69A6F2AB"}, {"file_name": "S2.png", "id": "1293326435227812", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396830_1293326438561145_4766677995765604708_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnuPZLYECD4Q7kNvwFmpSXM&_nc_oc=Adnbc-_OIz1YBjfeglWlQgIrCjGZKa1i6yXAGhkOwyOKdP_ntTJRaZVnapxDLcQQYvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsL2THPdUUM_gyQksTN2uwH3zCidopwFwUYNPd17s5EQQ&oe=69A6EEF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "t1.png", "id": "962436479347423", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391955_962436482680756_3387414641939824076_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9A8D_BTldG8Q7kNvwFktD2k&_nc_oc=AdkRzg4pyY3vPHiA4npznDB5M84nwepOiOEsGVopKamnzAPFEEhUTJlZWkp98zh0YWE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuE8RQXQgFFYvvfevJewjrMeuiMxTFMsYuP8cGkup7eTg&oe=69A6E1E7"}, "display_name": "Trickshots", "keywords": [], "long_description": "# Trickshots \u2013 The Ultimate VR Challenge!  \nTrickshots is a **physics-driven VR arcade game** where skill, creativity, and a little chaos collide!  \n\ud83d\ude80 Hit giant soccer balls into giant red cups inside **giant environments!**\n\n\n---\n{615395374790353}  \n\n# \u26f3 5 Full Courses, 45 Trickshot Holes!  \nTrickshots isn\u2019t just about mini-games\u2014there are **5 full courses** with **45 insanely difficult holes** of **Trickshots Golf!**  \nEvery hole is a **new puzzle**, pushing your **precision, creativity, and patience** to the limit!  \n\n---\n\n{513450385195256}  \n# \ud83c\udfae 15 Mini-Games\nEach of the **15 mini-games** in Trickshots brings a **fresh challenge**\u2014can you **master them all**?  \nTest your **skills**, adapt to **wild mechanics**, and **outsmart tricky physics** in every game!  \n\n\n---\n\n\n\n\n\n\n{1438381634201281}", "short_description": "Trickshots is a physics-driven VR arcade game where skill, creativity, and a little chaos collide! Launch giant soccer balls into giant red cups inside giant environments!\n\n- All updates and content will be free\u2014forever!\n- No refunds for the frustration you'll feel trying to beat each course."}]}, "developer_name": "Alex Howell", "developer_privacy_policy_url": "https://www.trickshotsvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.trickshotsvr.com/terms-of-service", "publisher_name": "Alex Howell", "support_website_url": "https://www.trickshotsvr.com/contact", "website_url": "https://www.trickshotsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_play
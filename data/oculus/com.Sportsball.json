S5A5S0rNuif3T2DSJBAQgPrvCn_mBlkycJbMnag&oe=69F0A70F"}, {"file_name": "s1.png", "id": "1322096299115905", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391946_1322096302449238_531702345048591404_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL_eRMSQ2AUQ7kNvwHHk7cX&_nc_oc=AdpCer_4AnOgdm0gtDhftvH6zyHoKWetOGSpX8bEpzwv_hXDE48v8STCvS0RQa9mdYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3Zpllvvnrs9vl75dCJavflq086-GhLW0lje-raPN7nvA&oe=69F0A9BB"}, {"file_name": "s4.png", "id": "635328276046486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391964_635328279379819_7863509223355269491_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzxzwaKbw6EQ7kNvwHtzUA9&_nc_oc=Adp47FWNLd2RnRDPvzL5Hzi9l__khe8tj2wRCDXxuv0R-kFeEk82vnVuLkRyVKrtcY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1YZ9jzc66Lq9COtYaUusTrwhiuR3_PrJPHX333j7glPw&oe=69F0C6AB"}, {"file_name": "S2.png", "id": "1293326435227812", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396830_1293326438561145_4766677995765604708_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3kITyYVw-0Q7kNvwGiXUOw&_nc_oc=AdpUvJHOHaBMI3V3UJRP-WZn258LjAI5lOqBhT-9HmpZciak42hLBGYpcUoS5y4DGfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3jXWuz0sxzximEcuXhNEWV-jF8ShtE0qrcnhGAVgeWqQ&oe=69F0C2F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "t1.png", "id": "962436479347423", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391955_962436482680756_3387414641939824076_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ApEzQiKkqEQ7kNvwFapmDt&_nc_oc=AdokRHaVbW2t7rsWKUA0Nhf07E7IK0MA67H9zsoPdbMgOHFAYdaOjqgBYQhiOuHkLdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0HNTqGpwEyxtSQUFfJXSJGlQPkQvwKzVjT00Dt62Gv7Q&oe=69F0B5E7"}, "display_name": "Trickshots", "keywords": [], "long_description": "# Trickshots \u2013 The Ultimate VR Challenge!  \nTrickshots is a **physics-driven VR arcade game** where skill, creativity, and a little chaos collide!  \n\ud83d\ude80 Hit giant soccer balls into giant red cups inside **giant environments!**\n\n\n---\n{615395374790353}  \n\n# \u26f3 5 Full Courses, 45 Trickshot Holes!  \nTrickshots isn\u2019t just about mini-games\u2014there are **5 full courses** with **45 insanely difficult holes** of **Trickshots Golf!**  \nEvery hole is a **new puzzle**, pushing your **precision, creativity, and patience** to the limit!  \n\n---\n\n{513450385195256}  \n# \ud83c\udfae 15 Mini-Games\nEach of the **15 mini-games** in Trickshots brings a **fresh challenge**\u2014can you **master them all**?  \nTest your **skills**, adapt to **wild mechanics**, and **outsmart tricky physics** in every game!  \n\n\n---\n\n\n\n\n\n\n{1438381634201281}", "short_description": "Trickshots is a physics-driven VR arcade game where skill, creativity, and a little chaos collide! Launch giant soccer balls into giant red cups inside giant environments!\n\n- All updates and content will be free\u2014forever!\n- No refunds for the frustration you'll feel trying to beat each course."}]}, "developer_name": "Alex Howell", "developer_privacy_policy_url": "https://www.trickshotsvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.trickshotsvr.com/terms-of-service", "publisher_name": "Alex Howell", "support_website_url": "https://www.trickshotsvr.com/contact", "website_url": "https://www.trickshotsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes"
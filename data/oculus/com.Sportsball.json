LZXJ3FISC5_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzH0fSZuE_iCu5tOimi50cgb4CwIURElCC6uzQkmIZMwQ&oe=69B6A50F"}, {"file_name": "s1.png", "id": "1322096299115905", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391946_1322096302449238_531702345048591404_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxFsAloYGAIQ7kNvwGt1MP4&_nc_oc=AdlLY3uTVuNN9J8pjWUI2Ni1V6FvMwmGaNRXCbR-6LVSHbxJrnarjdIM4BxtA-VKZoo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5akbk3wc4y795t1fRM3Xx7osGPOje7AO5gWcDGOQ1hw&oe=69B6A7BB"}, {"file_name": "s4.png", "id": "635328276046486", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391964_635328279379819_7863509223355269491_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZ2P1TBTBqwQ7kNvwEN1ATz&_nc_oc=AdlJPZUpojxn9IEPUFzCQ1t7iqk-vONZAdKbHPgg5xmXNgsWI4s5y9EzyjbXHI5DbCY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsPZE0R4v401r5ZtGcVSItML-01MNpqGl39meSfVEMag&oe=69B6C4AB"}, {"file_name": "S2.png", "id": "1293326435227812", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396830_1293326438561145_4766677995765604708_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7LdkuUJLsYQ7kNvwFtPreX&_nc_oc=AdkgmVmoPrvhgZtKUO3jDAY9ctKejDzCRlFIggADu8e4nyAk-Q2UNabAWOUBlxPwWbg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9rWlhf0zOG7HfqPGCX-FmZnTgji1-t0Gl057gTVGvhQ&oe=69B6C0F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "t1.png", "id": "962436479347423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391955_962436482680756_3387414641939824076_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSquLvolqkMQ7kNvwG_CR6N&_nc_oc=Adlu5H3OouQg0HV-U6cqB4Tp7c1ppk0WYNnHN70cGmG_MXALqLgFK4wa5I4rMjR53Q4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxK7sy4Q1cWFFuRGc9WtikVPLgTY07yNjxuMd1qzeHJ-g&oe=69B6B3E7"}, "display_name": "Trickshots", "keywords": [], "long_description": "# Trickshots \u2013 The Ultimate VR Challenge!  \nTrickshots is a **physics-driven VR arcade game** where skill, creativity, and a little chaos collide!  \n\ud83d\ude80 Hit giant soccer balls into giant red cups inside **giant environments!**\n\n\n---\n{615395374790353}  \n\n# \u26f3 5 Full Courses, 45 Trickshot Holes!  \nTrickshots isn\u2019t just about mini-games\u2014there are **5 full courses** with **45 insanely difficult holes** of **Trickshots Golf!**  \nEvery hole is a **new puzzle**, pushing your **precision, creativity, and patience** to the limit!  \n\n---\n\n{513450385195256}  \n# \ud83c\udfae 15 Mini-Games\nEach of the **15 mini-games** in Trickshots brings a **fresh challenge**\u2014can you **master them all**?  \nTest your **skills**, adapt to **wild mechanics**, and **outsmart tricky physics** in every game!  \n\n\n---\n\n\n\n\n\n\n{1438381634201281}", "short_description": "Trickshots is a physics-driven VR arcade game where skill, creativity, and a little chaos collide! Launch giant soccer balls into giant red cups inside giant environments!\n\n- All updates and content will be free\u2014forever!\n- No refunds for the frustration you'll feel trying to beat each course."}]}, "developer_name": "Alex Howell", "developer_privacy_policy_url": "https://www.trickshotsvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.trickshotsvr.com/terms-of-service", "publisher_name": "Alex Howell", "support_website_url": "https://www.trickshotsvr.com/contact", "website_url": "https://www.trickshotsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
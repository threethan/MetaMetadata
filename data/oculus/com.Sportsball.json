amtkS8YQOGHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFdbOY5TBPmB6jRBVQyit_uKiIWYz4dOfEVGk29r0M1A&oe=69AD6A8F"}, {"file_name": "s1.png", "id": "1322096299115905", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391946_1322096302449238_531702345048591404_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFZogsWg1xkQ7kNvwFE-Abi&_nc_oc=AdmzhfTlLzOMTEMF7bU0dZMEV1XRSvkvsHt8ihyWNye6SSVpZq9rwkBSDZnBtKSWWjU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8dPYq4mgHQvUs9dPmPyuOYAYqZP_sve-RJmKQNbEHvg&oe=69AD6D3B"}, {"file_name": "s4.png", "id": "635328276046486", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391964_635328279379819_7863509223355269491_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMJbAaNQfJIQ7kNvwE-CZVt&_nc_oc=AdkQ9hdXJ7ubVd9qQaCzisohVk6pxQhy_BT6eG-Z-trqWzyQf8PI0Tv5-Q6RYBSREVg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwr8Bua9hlhxQGIKwqd_zd4omX9W2ZGUHt1edgGxcMBBw&oe=69AD51EB"}, {"file_name": "S2.png", "id": "1293326435227812", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396830_1293326438561145_4766677995765604708_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Idr7nkNggdAQ7kNvwHN5iQp&_nc_oc=Adlf1PLux5J_o7NXfb1Zv_yxH75eMs4ZRu5mwBSjm_u1ZIdPq_ET9DuI0J2oloH4d5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdU1oJOhltdcP_g7V2I6HGGtmZwSOU-0t6p16YbDAlhg&oe=69AD8671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "t1.png", "id": "962436479347423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391955_962436482680756_3387414641939824076_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-r37hlQrfIQ7kNvwEjMBXY&_nc_oc=AdkjASD-mkO6gs-71nu9M0gTwJoc2PI2zWW-DLIlsLOPsqYDNH8q83EuB5X9UpnsvDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxK495u_q1uWdoR8PSOtZiW6k5yhYORltVL_6lItRR0Ug&oe=69AD7967"}, "display_name": "Trickshots", "keywords": [], "long_description": "# Trickshots \u2013 The Ultimate VR Challenge!  \nTrickshots is a **physics-driven VR arcade game** where skill, creativity, and a little chaos collide!  \n\ud83d\ude80 Hit giant soccer balls into giant red cups inside **giant environments!**\n\n\n---\n{615395374790353}  \n\n# \u26f3 5 Full Courses, 45 Trickshot Holes!  \nTrickshots isn\u2019t just about mini-games\u2014there are **5 full courses** with **45 insanely difficult holes** of **Trickshots Golf!**  \nEvery hole is a **new puzzle**, pushing your **precision, creativity, and patience** to the limit!  \n\n---\n\n{513450385195256}  \n# \ud83c\udfae 15 Mini-Games\nEach of the **15 mini-games** in Trickshots brings a **fresh challenge**\u2014can you **master them all**?  \nTest your **skills**, adapt to **wild mechanics**, and **outsmart tricky physics** in every game!  \n\n\n---\n\n\n\n\n\n\n{1438381634201281}", "short_description": "Trickshots is a physics-driven VR arcade game where skill, creativity, and a little chaos collide! Launch giant soccer balls into giant red cups inside giant environments!\n\n- All updates and content will be free\u2014forever!\n- No refunds for the frustration you'll feel trying to beat each course."}]}, "developer_name": "Alex Howell", "developer_privacy_policy_url": "https://www.trickshotsvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.trickshotsvr.com/terms-of-service", "publisher_name": "Alex Howell", "support_website_url": "https://www.trickshotsvr.com/contact", "website_url": "https://www.trickshotsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
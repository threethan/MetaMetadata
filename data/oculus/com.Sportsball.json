vo1DVYJRl9_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw8OE8eS3hR7y1eJ2rY3oUvciZ3KJoY3MbpmUU2CIMM8g&oe=69B7F68F"}, {"file_name": "s1.png", "id": "1322096299115905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391946_1322096302449238_531702345048591404_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxFsAloYGAIQ7kNvwHXqcab&_nc_oc=AdlZBaS3orxco9cPqYU759Q6bMr1CS6Ws8-_rW49aH7JhYjXgphAOnsRO9J6I_Z8zt8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz--oLrn0_3B6alyc6xt3HaxUPPnsf6aws2p6tLww2izg&oe=69B7F93B"}, {"file_name": "s4.png", "id": "635328276046486", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391964_635328279379819_7863509223355269491_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZ2P1TBTBqwQ7kNvwH3tjoO&_nc_oc=AdlU0_7Ofr7kbp6kdi3P4KBg_8WRSMF_MaEzbUyDxPnWRshNHnhQQuJuAdlbHWdnEDY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzWBcP6wRfYpGBfNDxJnKOlebxvX6JvtUGUXFgp9ML9tA&oe=69B7DDEB"}, {"file_name": "S2.png", "id": "1293326435227812", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396830_1293326438561145_4766677995765604708_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7LdkuUJLsYQ7kNvwGK5ka_&_nc_oc=Adl6B2Rakxem-yG7-210438lskN9VzTMD5v6Nr5j5OsVWnebYhsqiHV_LNRiE8hIyPA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyIc4Y8J5u-DetdzRC4bZ4Qu9L3qpQ2cjA6i9F7SDAImQ&oe=69B81271"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "t1.png", "id": "962436479347423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391955_962436482680756_3387414641939824076_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzT_5tWzdiMQ7kNvwE-CeoQ&_nc_oc=AdmHx1r9ihmRK5QFbDGZuhxrSSqgo7Nsf6d3lBcifIOBT7glZYSKGLdS23rwDtH5fDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxHiiXNW1V5pumygw-9gvLE33VxUuK0s51wsSnDI7fzQg&oe=69B80567"}, "display_name": "Trickshots", "keywords": [], "long_description": "# Trickshots \u2013 The Ultimate VR Challenge!  \nTrickshots is a **physics-driven VR arcade game** where skill, creativity, and a little chaos collide!  \n\ud83d\ude80 Hit giant soccer balls into giant red cups inside **giant environments!**\n\n\n---\n{615395374790353}  \n\n# \u26f3 5 Full Courses, 45 Trickshot Holes!  \nTrickshots isn\u2019t just about mini-games\u2014there are **5 full courses** with **45 insanely difficult holes** of **Trickshots Golf!**  \nEvery hole is a **new puzzle**, pushing your **precision, creativity, and patience** to the limit!  \n\n---\n\n{513450385195256}  \n# \ud83c\udfae 15 Mini-Games\nEach of the **15 mini-games** in Trickshots brings a **fresh challenge**\u2014can you **master them all**?  \nTest your **skills**, adapt to **wild mechanics**, and **outsmart tricky physics** in every game!  \n\n\n---\n\n\n\n\n\n\n{1438381634201281}", "short_description": "Trickshots is a physics-driven VR arcade game where skill, creativity, and a little chaos collide! Launch giant soccer balls into giant red cups inside giant environments!\n\n- All updates and content will be free\u2014forever!\n- No refunds for the frustration you'll feel trying to beat each course."}]}, "developer_name": "Alex Howell", "developer_privacy_policy_url": "https://www.trickshotsvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.trickshotsvr.com/terms-of-service", "publisher_name": "Alex Howell", "support_website_url": "https://www.trickshotsvr.com/contact", "website_url": "https://www.trickshotsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processo
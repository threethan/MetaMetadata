7333102555_4948322990888946293_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tE1rfwhRrrgQ7kNvwFEZJRp&_nc_oc=AdpgAm8aIkWkjssOOIUd7wmIjL0Po17IVsfQC6IHb4KAT16oS_TaERz6nqrTvAcpepc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fSTMit6evDrzFDahlX_rDTLC972sDSbZKifBE0U6shg&oe=6A11B03A"}, {"file_name": "S2.png", "id": "1293326435227812", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473396830_1293326438561145_4766677995765604708_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfvj9VeJnGYQ7kNvwGq16TQ&_nc_oc=AdorLDCzrmUeOPvNuMjkv3Jr1m3gL4JxzgKmAJtCU7R0Dd7YvXnM13XqaaVtdx2Mans&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7neWiksvIaDfOpRfhEg5sAaiWwEeq44ZmRzZEMfJ7dlg&oe=6A11B871"}, {"file_name": "S1.png", "id": "576195548730540", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473392038_576195552063873_419433955237512097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3ptByotSUwQ7kNvwHpMb9g&_nc_oc=AdpMzQqHQKu8011h62xWXbjaNJM7sERrifck2ONJmbv8vwC9T93fPqC4q1s_KtMaXcQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B7eqvhIZPhoIgr1d0wb3fVN9Kc0U_8dZPT3UxFr5cKQ&oe=6A11D02C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr2.png", "id": "9784555354902429", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391883_9784555364902428_9101637434317102160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBWQMAXrXfUQ7kNvwF3ZurJ&_nc_oc=AdreH41UD0rNywFp6yIqIEeL4n4KUNLIrm9V6130UfimZPym1TKBO3lWSx0n_1jQLSY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QnmUib2omO3q2ghufaVusDJPjO12xVXkgglFDfzyx6A&oe=6A119C56"}, "display_name": "Trickshots", "keywords": [], "long_description": "# Trickshots \u2013 The Ultimate VR Golf-Bat Challenge!  \nTrickshots is a **physics-driven VR golf-bat game** where skill, creativity, and a little chaos collide!  \n\ud83d\ude80 Launch giant soccer balls into giant red cups inside **massive environments** and **uncover secret codes** as you unlock new courses and bats.  \n\ud83c\udfcc\ufe0f\u200d\u2642\ufe0f With **10 courses, 90 holes**, and **14 unique mini-games**, there's always a **new challenge** waiting.  \n\n\u26a0\ufe0f **Fair warning\u2026 this game is VERY hard!**  \n\n---\n\n\n---\n\n\n{615395374790353}  \n# \ud83d\udcaf 100% Free! \n\u2705 **All updates and content will be free\u2014forever!**  \n\ud83e\udd2c **No refunds for the frustration you'll feel trying to beat each course.**  \n\n\n\n---\n\n{513450385195256}  \n# \ud83c\udfae 14 Mini-Games \u2013 Unique Challenges in Every Game!  \nEach of the **14 mini-games** in Trickshots brings a **fresh challenge**\u2014can you **master them all**?  \nTest your **skills**, adapt to **wild mechanics**, and **outsmart tricky physics** in every game!  \n\n\n---\n\n{1336055930776731}  \n# \u26f3 10 Full Courses, 90 Trickshot Holes!  \nTrickshots isn\u2019t just about mini-games\u2014there are **10 full courses** with **90 insanely difficult holes** of **Trickshots Golf!**  \nEvery hole is a **new puzzle**, pushing your **precision, creativity, and patience** to the limit!  \n\n\n\n\n---\n\n\n{525975200522242}  \n# \ud83c\udfb8 Unlockable Bats \u2013 Earn Your Style!  \nCrack a shot with style! \ud83d\udd25 Beat a course and unlock a **secret code** to claim a **new custom bat!**  \nThere are **10 unlockable bats**, each with a **unique feel and special sound effects**.  \nUse them in **any mini-game or Trickshots Golf hole!**  \n", "short_description": "Trickshots is a physics-driven VR golf-bat game where skill, creativity, and a little chaos collide! Launch giant soccer balls into giant red cups inside massive environments uncover secret codes as you unlock new courses and bat. With 10 courses, 90 holes, and 14 unique mini-games, there's always a new challenge waiting. \n\n- All updates and content will be free\u2014forever!\n- No refunds for the frustration you'll feel trying to beat each course."}]}, "developer_name": "Alex Howell", "developer_privacy_policy_url": "https://www.trickshotsvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.trickshotsvr.com/terms-of-service", "publisher_name": "Alex Howell", "support_website_url": "https://www.trickshotsvr.com/contact", "website_url": "https://www.trickshotsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9410513042321247"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "643152901391584"}]}, "baseline_offer": {"id": "643152901391584"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741360320, "status": "PUBLISHED", "id": "643152901391584"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9630208663685016", "version": "0.1.111"}, "id": "1168645194781669", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9410513018987916", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9630208663685016"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1168645194781669"}]}, "change_log
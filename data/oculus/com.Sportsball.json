ntck2TisD7wqWpeXwZGWzxxWJpG9JmZNFyCR1hQ&oe=69A18D0F"}, {"file_name": "s1.png", "id": "1322096299115905", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391946_1322096302449238_531702345048591404_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjtWF2MVRXoQ7kNvwHcgBIO&_nc_oc=Adk_cNUmwNt9AiITr9Oq71HzwBkvq-FeYbFoz2OLx-IOU7sZrpOYVDEc9qTBEECyrgM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftt_24yo6CUP6llk2-QrqWFLXDMLJ-00U-tx37tgoc6Zw&oe=69A18FBB"}, {"file_name": "s4.png", "id": "635328276046486", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391964_635328279379819_7863509223355269491_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4iNMcTROFEQ7kNvwE0ET3U&_nc_oc=AdkOPCBPbsb-YviUXRi78bRONXPf8-yvEAFcVosXSXPOhOx2bHGMEjXVVxDsHV00wG8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfubKL-EZLA4gl8unOK5FHKz4T3AGUV9bq7eI7eeHaRLfg&oe=69A1ACAB"}, {"file_name": "S2.png", "id": "1293326435227812", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473396830_1293326438561145_4766677995765604708_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Kt69BriJRQQ7kNvwHbSBKp&_nc_oc=AdkkWyuhuvTTc-LKG9ufe9Xll_a5BA0nAoV8jCY2qtHVej7-H9XWHqX_2e1cws5ejqw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsN7gSUF17Oyk2JJZPJ_hsq9uJtyfYhYQWcujYz6-g-Sg&oe=69A1A8F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "t1.png", "id": "962436479347423", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391955_962436482680756_3387414641939824076_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSSAuLxMq2IQ7kNvwHnPA2h&_nc_oc=AdkqA0LSaUVIkI4VYUp_NP_wy4aWiXr2QbmgEV3caP39D3XoaZdIMNy4SnQomifiCpc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs4SSqwED4UDJ7_EUFtRnIPaPkP1XsF_Swx25dLPbCQPw&oe=69A19BE7"}, "display_name": "Trickshots", "keywords": [], "long_description": "# Trickshots \u2013 The Ultimate VR Challenge!  \nTrickshots is a **physics-driven VR arcade game** where skill, creativity, and a little chaos collide!  \n\ud83d\ude80 Hit giant soccer balls into giant red cups inside **giant environments!**\n\n\n---\n{615395374790353}  \n\n# \u26f3 5 Full Courses, 45 Trickshot Holes!  \nTrickshots isn\u2019t just about mini-games\u2014there are **5 full courses** with **45 insanely difficult holes** of **Trickshots Golf!**  \nEvery hole is a **new puzzle**, pushing your **precision, creativity, and patience** to the limit!  \n\n---\n\n{513450385195256}  \n# \ud83c\udfae 15 Mini-Games\nEach of the **15 mini-games** in Trickshots brings a **fresh challenge**\u2014can you **master them all**?  \nTest your **skills**, adapt to **wild mechanics**, and **outsmart tricky physics** in every game!  \n\n\n---\n\n\n\n\n\n\n{1438381634201281}", "short_description": "Trickshots is a physics-driven VR arcade game where skill, creativity, and a little chaos collide! Launch giant soccer balls into giant red cups inside giant environments!\n\n- All updates and content will be free\u2014forever!\n- No refunds for the frustration you'll feel trying to beat each course."}]}, "developer_name": "Alex Howell", "developer_privacy_policy_url": "https://www.trickshotsvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.trickshotsvr.com/terms-of-service", "publisher_name": "Alex Howell", "support_website_url": "https://www.trickshotsvr.com/contact", "website_url": "https://www.trickshotsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes"
_nc_oc=AdnUvznuBMuUPvwWVyFIvBvUYX8geUPbCisepZHnvhsm3aWuUapydfe0sOYngqLdLFE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdCHHpSmelY8JCLHFVnOfO6RnCox51t5AMvN_9T24xtA&oe=69BEA1BA"}, {"file_name": "S2.png", "id": "1293326435227812", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396830_1293326438561145_4766677995765604708_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cp8ylcKrNkIQ7kNvwEYJGZK&_nc_oc=AdnHv346B-fq7jA-l0PaJIWrWdntTwVfno0RVo7Y4UA1MwTdeSNhIUPVhIkAhe2LyaY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOQvrBs5fH_il7WWTsHopZ2f36dzeuWhhYWiA7UoclmA&oe=69BEA9F1"}, {"file_name": "S1.png", "id": "576195548730540", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392038_576195552063873_419433955237512097_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_1aJ9hs--wQ7kNvwE64RkB&_nc_oc=Adk4lr8QkwajvkdRdOk-F7VvdB7wr2vv-XZ_ru0i8xu8DK8LxPYFl6Fs5aMPNq-2w0Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxslCu4gwtzgutAWNlXSJS4TIqyi3SXaXwwF64jMUEtvw&oe=69BE896C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tr2.png", "id": "9784555354902429", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_9784555364902428_9101637434317102160_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8KPSUk1kmUQ7kNvwHlltf_&_nc_oc=AdnX35AUL5bq6P2rPiLBDQdyMStwHx3p5zU4TvjoSHB5ZuVRRtpaRYRWiG5fK7woUnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLPFFLc5w9H1fnWS1HDjr6YF2mjj-_e2tWNmXLCBh59Q&oe=69BE8DD6"}, "display_name": "Trickshots", "keywords": [], "long_description": "# Trickshots \u2013 The Ultimate VR Golf-Bat Challenge!  \nTrickshots is a **physics-driven VR golf-bat game** where skill, creativity, and a little chaos collide!  \n\ud83d\ude80 Launch giant soccer balls into giant red cups inside **massive environments** and **uncover secret codes** as you unlock new courses and bats.  \n\ud83c\udfcc\ufe0f\u200d\u2642\ufe0f With **10 courses, 90 holes**, and **14 unique mini-games**, there's always a **new challenge** waiting.  \n\n\u26a0\ufe0f **Fair warning\u2026 this game is VERY hard!**  \n\n---\n\n\n---\n\n\n{615395374790353}  \n# \ud83d\udcaf 100% Free! \n\u2705 **All updates and content will be free\u2014forever!**  \n\ud83e\udd2c **No refunds for the frustration you'll feel trying to beat each course.**  \n\n\n\n---\n\n{513450385195256}  \n# \ud83c\udfae 14 Mini-Games \u2013 Unique Challenges in Every Game!  \nEach of the **14 mini-games** in Trickshots brings a **fresh challenge**\u2014can you **master them all**?  \nTest your **skills**, adapt to **wild mechanics**, and **outsmart tricky physics** in every game!  \n\n\n---\n\n{1336055930776731}  \n# \u26f3 10 Full Courses, 90 Trickshot Holes!  \nTrickshots isn\u2019t just about mini-games\u2014there are **10 full courses** with **90 insanely difficult holes** of **Trickshots Golf!**  \nEvery hole is a **new puzzle**, pushing your **precision, creativity, and patience** to the limit!  \n\n\n\n\n---\n\n\n{525975200522242}  \n# \ud83c\udfb8 Unlockable Bats \u2013 Earn Your Style!  \nCrack a shot with style! \ud83d\udd25 Beat a course and unlock a **secret code** to claim a **new custom bat!**  \nThere are **10 unlockable bats**, each with a **unique feel and special sound effects**.  \nUse them in **any mini-game or Trickshots Golf hole!**  \n", "short_description": "Trickshots is a physics-driven VR golf-bat game where skill, creativity, and a little chaos collide! Launch giant soccer balls into giant red cups inside massive environments uncover secret codes as you unlock new courses and bat. With 10 courses, 90 holes, and 14 unique mini-games, there's always a new challenge waiting. \n\n- All updates and content will be free\u2014forever!\n- No refunds for the frustration you'll feel trying to beat each course."}]}, "developer_name": "Alex Howell", "developer_privacy_policy_url": "https://www.trickshotsvr.com/privacy-policy", "developer_terms_of_service_url": "http
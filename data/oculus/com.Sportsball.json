hmjxClPWplUx9KtIw3yCaCGbGQepOlXvsaBCmRQ&oe=6999A40F"}, {"file_name": "s1.png", "id": "1322096299115905", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391946_1322096302449238_531702345048591404_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvaxCLMjtX8Q7kNvwEnHA6C&_nc_oc=Adn6TYGNxJhoYYh8cvQf08R4rCx7IqWbps-DXWBgO2_7OyQMOYlTHDJ7fTd1rNz459g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpGMN8-I5HclOc1tKOVu-9H_LB2K9JmrYg4ilzZ3Q7Og&oe=6999A6BB"}, {"file_name": "s4.png", "id": "635328276046486", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391964_635328279379819_7863509223355269491_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YZly6w2AkwQ7kNvwH8EbJp&_nc_oc=Adk2JJhdf275Rj9ImaeTiE4K7GbOrtNG4bBy6cUllHZpCSqEfbQB1LYJ-3OuRn-txSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv_Em2Q2OHuMEAbUHxYKCQKvV_HTLYzwdNRa98txudCKw&oe=6999C3AB"}, {"file_name": "S2.png", "id": "1293326435227812", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473396830_1293326438561145_4766677995765604708_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZHP8QVF2_cQ7kNvwFQqlti&_nc_oc=AdnotOoOVrZeqhOkLxV0W3lVDWDopy8ewZcdhC9esgMCfBQ55sdiqYY0PG7k8dsaXvo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvb42odkUsKjpl4dHYKq5FxkNSZXPj50Ug6qGsUW4wP1g&oe=6999BFF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "t1.png", "id": "962436479347423", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391955_962436482680756_3387414641939824076_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ANl-CRZDMgQ7kNvwGuwG2G&_nc_oc=AdniHkmw3rOEZm8aDTPU0iB7kOaM0qdYM8J5FrcDHa3YWkjI_sBY92OXXvrFCu-Tl74&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfucFsBHiMUIag_1pAO9Yvy23hWk0C_vaIiGc79vfIvc0Q&oe=6999B2E7"}, "display_name": "Trickshots", "keywords": [], "long_description": "# Trickshots \u2013 The Ultimate VR Challenge!  \nTrickshots is a **physics-driven VR arcade game** where skill, creativity, and a little chaos collide!  \n\ud83d\ude80 Hit giant soccer balls into giant red cups inside **giant environments!**\n\n\n---\n{615395374790353}  \n\n# \u26f3 5 Full Courses, 45 Trickshot Holes!  \nTrickshots isn\u2019t just about mini-games\u2014there are **5 full courses** with **45 insanely difficult holes** of **Trickshots Golf!**  \nEvery hole is a **new puzzle**, pushing your **precision, creativity, and patience** to the limit!  \n\n---\n\n{513450385195256}  \n# \ud83c\udfae 15 Mini-Games\nEach of the **15 mini-games** in Trickshots brings a **fresh challenge**\u2014can you **master them all**?  \nTest your **skills**, adapt to **wild mechanics**, and **outsmart tricky physics** in every game!  \n\n\n---\n\n\n\n\n\n\n{1438381634201281}", "short_description": "Trickshots is a physics-driven VR arcade game where skill, creativity, and a little chaos collide! Launch giant soccer balls into giant red cups inside giant environments!\n\n- All updates and content will be free\u2014forever!\n- No refunds for the frustration you'll feel trying to beat each course."}]}, "developer_name": "Alex Howell", "developer_privacy_policy_url": "https://www.trickshotsvr.com/privacy-policy", "developer_terms_of_service_url": "https://www.trickshotsvr.com/terms-of-service", "publisher_name": "Alex Howell", "support_website_url": "https://www.trickshotsvr.com/contact", "website_url": "https://www.trickshotsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes"
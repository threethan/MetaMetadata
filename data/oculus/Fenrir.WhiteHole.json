d6-1.oculuscdn.com/v/t64.5771-25/39001663_712430049463654_1391127670088407973_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZnNG4WSOr4Q7kNvwEm244k&_nc_oc=AdozsFH3g6X2YiTXbbtN8fYlFlcPjkE8DhaohzpD_WReC-QFpWpfz0DgcEzne8vWT9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJpSpgQ7YjZlDTvMd-_oKN61Y4B178Bxn5MFCip8FY1Q&oe=6B05B680"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cov$.png", "id": "481432056345302", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031331_481432059678635_8968693732856012714_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cv4Fm86Ow3UQ7kNvwEnKm0r&_nc_oc=AdqswZl06ARzP2hPfpALzP936BUkiBHg0Y3J6B-WXbw8voSHBlGsFjnN-A0nC-wYUiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmtdGS2cfjnQeZLOPVqT_NsqZhBq0VvH1s542UrqyX-g&oe=6B05C21F"}, "display_name": "White Hole", "keywords": [], "long_description": "Build and customize your own ship as you want with a multitude of components that will completely change how you deal with all the situations encountered in this unexplored part of the void. You can meet a lot of adversity in the universe and you will need to fight your way out, negotiate with the different powers ruling the place to make the most of the situation, solve some deadly enigmas and decrypt mysteries to learn about the most hidden galaxy\u2019s secrets. Will the Earth survive its ordeal or will it get destroyed once and for all ? That\u2019s all up to you !\n\nWhite Hole uses the guardian system to build your ship, you need to use a roomscale guardian in order to play the game.", "short_description": "A shadow lurks deep in space, getting closer and closer to planet Earth. If you want to rescue your homeworld, you must forge your own ship and go explore the infinite universe to discover ancient civilizations and unearth the clues that will help you find out how to fight this new evil."}]}, "developer_name": null, "deve
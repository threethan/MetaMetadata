ost in the swamp! Navigate the swamp, light torches, and call out to your dog using the microphone in your headset to try and find her. Every action you take is saved in a log file which can be extracted from the headset. Analyze the log file to get a better understanding of where you went, how long it took to find her, and other revealing metrics."}]}, "developer_name": "Pacific Northwest National Laboratory", "developer_privacy_policy_url": "http://www.pnnl.gov/security-privacy", "developer_terms_of_service_url": null, "publisher_name": "Pacific Northwest National Laboratory", "support_website_url": null, "website_url": "https://www.pnnl.gov/projects/stemvr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "958472484810525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974595_2526712914110175_7462697374075322368_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4yvwAbTL-sQ7kNvwElBaCG&_nc_oc=AdqDQSr9rWuYoGzWINAiIaBhA3DFZwEF6g3ydrxVK8mRY_7uxXO-QFXwNxHNoQXG33E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ0r0MgKgYTNZlE_t0hMg6FNzR2_aId9QUXwG7a0lFMg&oe=6AAE9857"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Locating Luna", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1574964045, "lastRevision": {"nodes": [{"id": "198519435487101
 call out to your dog using the microphone in your headset to try and find her. Every action you take is saved in a log file which can be extracted from the headset. Analyze the log file to get a better understanding of where you went, how long it took to find her, and other revealing metrics."}]}, "developer_name": "Pacific Northwest National Laboratory", "developer_privacy_policy_url": "http://www.pnnl.gov/security-privacy", "developer_terms_of_service_url": null, "publisher_name": "Pacific Northwest National Laboratory", "support_website_url": null, "website_url": "https://www.pnnl.gov/projects/stemvr", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPLORATION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "958472484810525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974595_2526712914110175_7462697374075322368_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piTLyFi6UCQQ7kNvwHkF6fk&_nc_oc=Adky-nMQ1QObrN8Zbrtcc19K5NjN-2P4llny-zOEVXyO2zGWfXBo1BqkW6RvYJ-LPo0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWN_WOxZ28r7-HSIxiR6DcrIyiKcz9gicnfb1DMJMS9Q&oe=69BD55D7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Locating Luna", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1574964045, "lastRevision": {"nodes": [{"id": "1985194354871017", "release_type": "SCHEDULED", "administration_status": "APP
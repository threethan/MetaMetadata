y29e9so0G2jQivn6ddWP-NTT8Z5X_rWcNFCqz4g&oe=69EA27F3"}, {"file_name": "promoPictures2.png", "id": "1483353439106541", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974671_1483353442439874_7624395518505693168_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuTjvPjHABMQ7kNvwG62ivD&_nc_oc=AdrcNYomCmbX-eMrSjJQV4Zr9OWXNeEfYCR3a58Tkph89e2SHevl7rfimZVN1q3Ajng&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-5vYCBGQgE-DuVsrKnBl4UTpMNT5U5Er9yL8g59p8vQ&oe=69EA25C5"}, {"file_name": "promoPictures4.png", "id": "879331253766974", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974866_879331257100307_140468917921770257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUqPwHGRRTsQ7kNvwEP4Lr-&_nc_oc=AdrTOah_IUh84kk86DHslV2juiywFugUt3eITIXz7Ff95URnc-J8EnKrPqsTjKId6Ww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25pafku6TiqaJV7U4EgBWr7etgnOBbHIRg8SYJsjtjsQ&oe=69EA29DB"}, {"file_name": "promoPictures5png.png", "id": "327398366514509", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001661_327398369847842_872979340882226211_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HOL3MA7DuYQ7kNvwEIbymv&_nc_oc=Adq1DITuuLAqZ4tyGYyC2LlRjzua2s67DCE-VZN-sUStRWcYjf8z2oBXiCEEx2WQ6fw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LBYh4Cgn-RCfCJgM33qg7WkzxdcSL4_IwZDTEjBAPlQ&oe=69EA1289"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pzaaaa.png", "id": "1271131920213258", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035412_1271131923546591_3976609245821279261_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UOVijBOpOoQ7kNvwFrn34B&_nc_oc=AdpHwsl1swOi4xSv183DJKbH03nubqHVh6RNPPU9m_DBScO1gkvZ2AYV0gGGiPdsUSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1B8cNm2EP8eUREmohp-7tXA9sx4DXAX_4W_bIv_uns_A&oe=69EA1E8D"}, "display_name": "Pizza Cafe VR", "keywords": ["singleplayer", "simulator", "shortexperience", "pizzacafevr"], "long_description": "In Pizza Cafe VR, step into the exciting world of virtual reality where you become the proud owner of a bustling and delightful pizza cafe! Put on your chef's hat and get ready to create mouthwatering pizzas to satisfy your hungry customers' cravings. Top the perfect pizza just the way your customers like it. As you serve more customers and earn profits, you can invest in thrilling upgrades, not only unlocking a wide range of delectable toppings but also acquiring state-of-the-art equipment to enhance your pizza-making prowess. From classic margheritas to adventurous gourmet creations, the possibilities are endless! Become a master of the pizza world, earn a reputation for your outstanding pizza cafe, and watch as the virtual world lines up for a slice of your culinary magic in Pizza Cafe VR!", "short_description": "Create and sell pizzas, make money to buy upgrades to make your pizza place stand out from the rest!"}]}, "developer_name": "Freefire Studios", "developer_privacy_policy_url": "https://sites.google.com/view/freefirestudios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Freefire Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/freefirestudios/home?authuser=0", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28660758796856104"}, "review_messages": []}]}, "cover_square_image": {"u
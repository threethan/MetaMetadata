ryh1-8ppOq6_FVJ3FfSh8jhaovB1GB_lMRoi0xQ&oe=6A7889F3"}, {"file_name": "promoPictures2.png", "id": "1483353439106541", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974671_1483353442439874_7624395518505693168_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2D-yumwWt4Q7kNvwHkwxiJ&_nc_oc=Adq7KByHNxeVgUs3bi4d68BAv1awSWXnSvo-NNHkJF1NVCLbcBoTjZ1SWBK8NBij4s0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYG9YeS_qmtbZRnPLI80c19QGsHz1Dzf2YpSV0JBHjjQ&oe=6A7887C5"}, {"file_name": "promoPictures4.png", "id": "879331253766974", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974866_879331257100307_140468917921770257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSF82Y41WRkQ7kNvwG6R03k&_nc_oc=AdqHo4P6BmPmiyeTWBlh81zESuJxm-cSPJ9UsU9vgf0g9u92QFTbVWKXPmNbbB2ceCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_FoYlfvr4WMRXcc_FUOs9ril0Fqkv6w6_EYZiZbiPwA&oe=6A788BDB"}, {"file_name": "promoPictures5png.png", "id": "327398366514509", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001661_327398369847842_872979340882226211_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EseKd5o1Oa0Q7kNvwFzot7t&_nc_oc=AdoKOrBYLp_KW0Ur7nl8ZhsMmh8jH-gjSpdCd9reTechLtxAttay82o-qj1QJrXadBY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgbbmTJNMp4qNmjLauvPPc9KZdVKS-PK6ef3Z0Arad8w&oe=6A787489"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pzaaaa.png", "id": "1271131920213258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035412_1271131923546591_3976609245821279261_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTta4thuuWcQ7kNvwFJoKTM&_nc_oc=Adr6m_rj0_gGXg7wh6v1Hs1nSd92YQrgrSoslVdAHS2zZRFMFuoiC-64yyi6QcuqR2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV0TaHhFhMaR04o7_r5M52pyHj3OeEW3azGBsN_vpQgw&oe=6A78808D"}, "display_name": "Pizza Cafe VR", "keywords": ["singleplayer", "simulator", "shortexperience", "pizzacafevr"], "long_description": "In Pizza Cafe VR, step into the exciting world of virtual reality where you become the proud owner of a bustling and delightful pizza cafe! Put on your chef's hat and get ready to create mouthwatering pizzas to satisfy your hungry customers' cravings. Top the perfect pizza just the way your customers like it. As you serve more customers and earn profits, you can invest in thrilling upgrades, not only unlocking a wide range of delectable toppings but also acquiring state-of-the-art equipment to enhance your pizza-making prowess. From classic margheritas to adventurous gourmet creations, the possibilities are endless! Become a master of the pizza world, earn a reputation for your outstanding pizza cafe, and watch as the virtual world lines up for a slice of your culinary magic in Pizza Cafe VR!", "short_description": "Create and sell pizzas, make money to buy upgrades to make your pizza place stand out from the rest!"}]}, "developer_name": "Freefire Studios", "developer_privacy_policy_url": "https://sites.google.com/view/freefirestudios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Freefire Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/freefirestudios/home?authuser=0", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28660758796856104"}, "review_messages": []}]}, "cover_square_image": {"u
1770257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFqCDbWHC20Q7kNvwGO1GGm&_nc_oc=AdqxWMFzA4EtvDeM3aDgpNGaYQcwiCVDar8MRSkGoBSKpOfl_qQWSteWo07CPfhQjPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsEGYTZL9VPTb_1c5IXYi23h2hdC0N6XiMg78k-Mz7aQ&oe=6A9EC75B"}, {"file_name": "promoPictures5png.png", "id": "327398366514509", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001661_327398369847842_872979340882226211_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzVpiFibNyAQ7kNvwEJL1mf&_nc_oc=AdoUbXG6vf00Ny1ZRDYTWkZCh8Cjal5-uzzmlm_629bdMyZQ3Q_w2mR4RqWYcsfmu1o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3CgnzxLW2qK4ipb8FXhF78BSmHO6W9WzxDpR-bREsIw&oe=6A9EB009"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pzaaaa.png", "id": "1271131920213258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035412_1271131923546591_3976609245821279261_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpCHzNWMbZQQ7kNvwHJWgmJ&_nc_oc=AdpYNDLhWBQIdBFecQ8Own639Uy1-gbusPatQqBppovZ5hlr_-F3BCyyG_1DmRFMBac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCrAV4-qeGa5F0pHm1AHVDK7gMCbCd9kt-wv6RnBx7Qw&oe=6A9EBC0D"}, "display_name": "Pizza Cafe VR", "keywords": [], "long_description": "In Pizza Cafe VR, step into the exciting world of virtual reality where you become the proud owner of a bustling and delightful pizza cafe! Put on your chef's hat and get ready to create mouthwatering pizzas to satisfy your hungry customers' cravings. Top the perfect pizza just the way your customers like it. As you serve more customers and earn profits, you can invest in thrilling upgrades, not only unlocking a wide range of delectable toppings but also acquiring state-of-the-art equipment to enhance your pizza-making prowess. From classic margheritas to adventurous gourmet creations, the possibilities are endless! Become a master of the pizza world, earn a reputation for your outstanding pizza cafe, and watch as the virtual world lines up for a slice of your culinary magic in Pizza Cafe VR!", "short_description": "Create and sell pizzas, make money to buy upgrades to make your pizza place stand out from the rest!"}]}, "developer_name": "Freefire Studios", "developer_privacy_policy_url": "https://sites.google.com/view/freefirestudios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Freefire Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/freefirestudios/home?authuser=0", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24153595110905851"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "777925948003456"}, {"status": "PUBLISHED", "id": "1140366681212843"}, {"status": "PUBLISHED", "id": "874230307445442"}, {"status": "PUBLISHED", "id": "982402269550171"}]}, "baseline_offer": {"id": "1140366681212843"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755277200, "status": "PUBLISHED", "id": "777925948003456"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24408486868750006", "version": "23"}, "id": "805674221139619", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typen
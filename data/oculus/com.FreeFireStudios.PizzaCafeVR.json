U_sNgm2vAIP9cC2FGH9qgZ2Ik56VNfyX3LpQQEA&oe=6A897533"}, {"file_name": "promoPictures2.png", "id": "1483353439106541", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_1483353442439874_7624395518505693168_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3Y-bPV5zCgQ7kNvwGq3Fha&_nc_oc=AdrDKu_BdCItufot_VjXRL2vUcynJUm9LsOjw5ZSHvQ_2Hkx4vuAsrruJ_bDv4yyto4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENSHvR9_JGEj8r5yM_RA8ad9BpEZ855CcUhQmJhAi7Ew&oe=6A897305"}, {"file_name": "promoPictures4.png", "id": "879331253766974", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974866_879331257100307_140468917921770257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNGZ2VM4flUQ7kNvwHisFgF&_nc_oc=Adp_8V6VkCcMj99WnIwkIYa5-v3Gaa5U92fBk_a87o7GlT9bBI3LBELgUU5LpAoBLm0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKwyI6HRQR-FyHdvHRN1kB4-XAYOqB1THwFVi29ptWbA&oe=6A89771B"}, {"file_name": "promoPictures5png.png", "id": "327398366514509", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001661_327398369847842_872979340882226211_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nt3O9C-_KB8Q7kNvwHT8bn7&_nc_oc=AdoaoLX3vIU6eqkCCnsVXBe4J8sSRoAPyZu9RtC3NhL0CDr-WPEw5Gf6x4gbcWsrVlc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdkEboGcMGFuL7tj59QQtulSxtSYNHbYjsyc1CJZhKGg&oe=6A899809"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pzaaaa.png", "id": "1271131920213258", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035412_1271131923546591_3976609245821279261_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2aQ6XQ71NsQ7kNvwFTlPqF&_nc_oc=Adq7VA0QFBuW6APBlxXfXzNVH7JCoM-rpspbAK6Km8hR_cOMWwmj_U2sG012bajbwXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHExcOmjwDSx8DedBsy2CI7Rxlq9Kb6nTQloOFxwKt00A&oe=6A89A40D"}, "display_name": "Pizza Cafe VR", "keywords": ["singleplayer", "simulator", "shortexperience", "pizzacafevr"], "long_description": "In Pizza Cafe VR, step into the exciting world of virtual reality where you become the proud owner of a bustling and delightful pizza cafe! Put on your chef's hat and get ready to create mouthwatering pizzas to satisfy your hungry customers' cravings. Top the perfect pizza just the way your customers like it. As you serve more customers and earn profits, you can invest in thrilling upgrades, not only unlocking a wide range of delectable toppings but also acquiring state-of-the-art equipment to enhance your pizza-making prowess. From classic margheritas to adventurous gourmet creations, the possibilities are endless! Become a master of the pizza world, earn a reputation for your outstanding pizza cafe, and watch as the virtual world lines up for a slice of your culinary magic in Pizza Cafe VR!", "short_description": "Create and sell pizzas, make money to buy upgrades to make your pizza place stand out from the rest!"}]}, "developer_name": "Freefire Studios", "developer_privacy_policy_url": "https://sites.google.com/view/freefirestudios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Freefire Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/freefirestudios/home?authuser=0", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28660758796856104"}, "review_messages": []}]}, "cover_square_image": {"u
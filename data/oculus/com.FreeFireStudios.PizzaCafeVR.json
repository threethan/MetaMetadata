-H3FpYfnbyldhRl-Is3D7WUrBrwzPvt2R0gNOXw&oe=6A257B73"}, {"file_name": "promoPictures2.png", "id": "1483353439106541", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974671_1483353442439874_7624395518505693168_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-gkbR4muNgQ7kNvwFNmlqP&_nc_oc=AdpaG4xdKa3soqj8aSxKzL8FC7JbkXv249RbJp3sVccJGEITQc7icYD27GCztvNB0bA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IBVaYF45t7jCW5annj_Z0bgExgt62DOB5mjnWx1XKmg&oe=6A257945"}, {"file_name": "promoPictures4.png", "id": "879331253766974", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974866_879331257100307_140468917921770257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-maKLagYMIEQ7kNvwFNq7U7&_nc_oc=Adq0yRBILs7umSm4IUknNYjulO0nDnd-h-6qJ-gi6r_uuaN9hUF-l3zC1G2HA28u4d0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B4molMRcgk60C0rS9VCxlQ-28dt8ULCOrQXzLrUuHkg&oe=6A257D5B"}, {"file_name": "promoPictures5png.png", "id": "327398366514509", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001661_327398369847842_872979340882226211_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOuevGecVFcQ7kNvwHf0MFx&_nc_oc=Adq2-72wZ-MTMfKrmiZ3Pnv99y3D8UUIGawaq0HMLtqyG9-AxO930SEwp3sWeaOdSFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vahb483kUpTNRoHQK39KRLLUC3VdC9EueHrbV5C-WIw&oe=6A259E49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "pzaaaa.png", "id": "1271131920213258", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035412_1271131923546591_3976609245821279261_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJy79ObMyfUQ7kNvwHE8-6N&_nc_oc=Ado_7ZTVwIEsdpFm65Y-L5wM5pMGv6gSKP6P3d1QdwaG0QyrBXbM7wnLcwNkfV7xVbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fIM-lL5eN-q2bBu7yP3qXDiS68QStZr50GAuUf5GouA&oe=6A25720D"}, "display_name": "Pizza Cafe VR", "keywords": ["singleplayer", "simulator", "shortexperience", "pizzacafevr"], "long_description": "In Pizza Cafe VR, step into the exciting world of virtual reality where you become the proud owner of a bustling and delightful pizza cafe! Put on your chef's hat and get ready to create mouthwatering pizzas to satisfy your hungry customers' cravings. Top the perfect pizza just the way your customers like it. As you serve more customers and earn profits, you can invest in thrilling upgrades, not only unlocking a wide range of delectable toppings but also acquiring state-of-the-art equipment to enhance your pizza-making prowess. From classic margheritas to adventurous gourmet creations, the possibilities are endless! Become a master of the pizza world, earn a reputation for your outstanding pizza cafe, and watch as the virtual world lines up for a slice of your culinary magic in Pizza Cafe VR!", "short_description": "Create and sell pizzas, make money to buy upgrades to make your pizza place stand out from the rest!"}]}, "developer_name": "Freefire Studios", "developer_privacy_policy_url": "https://sites.google.com/view/freefirestudios/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Freefire Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/freefirestudios/home?authuser=0", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28660758796856104"}, "review_messages": []}]}, "cover_square_image": {"u
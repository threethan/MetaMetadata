3Yl-I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4Y-mi43UNfE1jwoq1diSE-5Eo9puu3b8QhblSB7GAdg&oe=6ADCD3EF"}, {"file_name": "3.png", "id": "1302547955335316", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303707_1302547958668649_2333352333100934110_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9TlRalWgewQ7kNvwF-7zVo&_nc_oc=Adrfwh8YySL1AP9RBPTmBSfHxAp_ynLZhfJFc7R3C7jfJQ04V-SLr_QDn7wFrWY_mm0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY9YwTrZqJb--3aV7RMCiHJI0YyngEG_izH_VPskjJ9Q&oe=6ADCDAC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover land.png", "id": "972076055477846", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_972076058811179_7405970237990503310_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ag3d55I3ibMQ7kNvwEOX8wZ&_nc_oc=AdrR7d-CV31hmvF69t2qMRa9BNTnywa1o8QL_SpnoIdk_Jg2Q1R7m2w_VfepAGILc98&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgZvDIxWkoneHHXtNZ_TGwjC8iiNz_Vk45x_7Z1VAWrg&oe=6ADCD0A1"}, "display_name": "Prep2Drive", "keywords": ["driving", "simulator", "practice", "drive", "car"], "long_description": "Winfinity Prep2Drive is a virtual reality driving simulator built to help learners develop confident road ready skills through immersive and repeatable practice.\nLearning to drive in the real world can be stressful costly and risky especially for beginners or nervous drivers. Winfinity Prep2Drive addresses this challenge by providing a safe VR environment where users can practice essential driving fundamentals without pressure or real world consequences.\nInside Winfinity Prep2Drive users can train core skills such as steering control speed management lane keeping turns traffic awareness and hazard response. Scenarios are designed to be repeated as often as needed allowing learners to improve through consistent practice and familiarity.\nWinfinity  Prep2Drive is designed for individual learners and scalable for training organizations. The experience focuses on skill building rather than entertainment helping users gain confidence through immersion and repetition. Progress tracking and intelligent feedback features are planned for future updates as the platform evolves.\nWhether you are preparing for your first road drive, rebuilding confidence behind the wheel, or exploring safer ways to practice driving fundamentals, Winfinity  Prep2Drive offers a focused VR training experience built for learning.\n", "short_description": "Winfinity Prep2Drive is an immersive VR car driving simulator designed to help learners build confidence and core driving skills through safe and repeatable practice. Train steering control lane discipline traffic awareness and hazard response in realistic virtual environments without real world risk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://winfinity.llc/privacy-policy-1", "developer_terms_of_service_url": null, "publisher_name": "WINFINITY LLC", "support_website_url": "https://winfinity.llc/contact", "website_url": "https://winfinity.llc/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27517052371292307"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313072_998577492494694_7681475477098511091_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyFPKt6l1rMQ7kNvwGaHGtr&_nc_oc=AdqUs8C7rqE7
eWSN4wKK0kQ&oe=6AAA922E"}, {"file_name": "shopbbb (1).png", "id": "748004780886227", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825029_748004784219560_6116206468442816297_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aeoa0N5VVb4Q7kNvwEUwB0X&_nc_oc=AdrBAR3qUgP1_HKMhfJegP-yhm-xEO4htGcCryLwpB4Lo6JWCzpBobskkMsPkO7krQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJByT0diFnM2EL7VDc2TQz24jNfgJ6WXCpQhZkqyLeFWQ&oe=6AAAB55C"}, {"file_name": "stumpthbbb (1).png", "id": "1014764844147854", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820270_1014764850814520_8179639573244492953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_BqOc8mKq4Q7kNvwFyk-Ax&_nc_oc=AdrnRznvex2Wqy92oEM5VT-AQwB8XtaLo72uLJZCNfo_CJ46cSuH0qBNJU12ibTYSY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPxm8psj1boQJ8okJ1T5QL3OimeM-vcAqjKmzAXh6J9g&oe=6AAA9FB3"}, {"file_name": "forestbbb (1).png", "id": "684538787834752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830597_684538791168085_1727959957459805399_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxtMX66BqiYQ7kNvwEXPwXc&_nc_oc=AdrdkzeMuqUPO7BTzWwg3MVEHa3NeAbnZJNShUSBJKu8WVEqXHsctVSgYE4hblXs1XI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIjBjLresi78OpYlwdMOAmIYtxBLp-PIvuCP3iPyUuzw&oe=6AAAB4F6"}, {"file_name": "whole_mapbbb (1).png", "id": "1048658816717414", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824203_1048658820050747_3830925882966996295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZWDufDQDFcQ7kNvwEbL0MS&_nc_oc=AdpXHGniJ2rzfqR0B69ogeXLz0axhNUStY2dRYNq3nazXZaTTJ71v6iCf5aLYXBQ6Tc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLroa065uLpT0y_mfCVgiMMc3jcKn3ESEXoyr2DiH6UfQ&oe=6AAAB773"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supernova", "keywords": ["adventure", "strategy", "Action"], "long_description": "Supernova is a fast-paced, multiplayer VR experience that brings high-energy movement and non-stop fun into a vibrant, ever-expanding universe. Whether you're sprinting through futuristic landscapes, launching yourself across alien structures, or outsmarting your friends in epic games of tag, Supernova is all about freedom, flow, and fun.\n\nBuilt for players who love to move, Supernova lets you climb, jump, and explore using intuitive locomotion mechanics that make every match feel unique. From intense tag battles to creative mini-games and relaxing hangout spaces, there's always something new to experience. Team up, go solo, or compete in chaotic showdowns\u2014no two sessions are ever the same.\n\nPacked with rich environments, hidden secrets, and a strong sense of community, Supernova is more than just a game. It\u2019s a living, breathing world of adventure where movement is your superpower and fun is just a leap away.", "short_description": "Supernova is an action-packed Gorilla Tag fan game where the chase never ends! Dive into thrilling tag battles, explore vibrant maps, and enjoy a galaxy of fun mini-games and activities with friends. Whether you're running, jumping, or climbing, there's always something new to discover in Supernova!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://novatag.lol/pp/", "developer_terms_of_service_url": "https://novatag.lol/tos/", "publisher_name": "LSG", "support_website_url": null, "website_url": "https://novatag.lol/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
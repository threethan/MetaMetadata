_1446708009849039_6665751589881146098_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wqoQjBopaIQ7kNvwHcD5Y2&_nc_oc=AdlX7-4cHmuKQxT4hXjB7VyAa_Pl7u5P32r28u1p5D80b8L-fClpS29wOSDc2Z0EL2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftVRSWGOIXP2MGRJ5wRdnt1atgW_BzOBSQPwax0_cN1_A&oe=69A6DAAE"}, {"file_name": "shopbbb (1).png", "id": "748004780886227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825029_748004784219560_6116206468442816297_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HS7zhBH5hz4Q7kNvwFlSJ1-&_nc_oc=Adm8ZuvJuxQd2PX3Eb6uNAQhrxoBny0EHz47gJexq5zwskmA3OR6finqBv6APt0CMVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu3m8m-Lhqm_HQ1OxYp6B4UY5ItusobXCAkcKntHpaEqg&oe=69A6C59C"}, {"file_name": "stumpthbbb (1).png", "id": "1014764844147854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820270_1014764850814520_8179639573244492953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3oYEFaxeboQ7kNvwEZtoLq&_nc_oc=AdmHjxlDoDZ9qVqPXQjpCWmrPsR-mKQn1BFmX4Tjup2bblxMl4QH9OMNB9RB6LzPbz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu3OQWIFk76VPn3xQP1WRRzRL_WAPzuAfXngp3SBDrSnw&oe=69A6E833"}, {"file_name": "forestbbb (1).png", "id": "684538787834752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830597_684538791168085_1727959957459805399_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sW7bhBRCYwgQ7kNvwFekTgX&_nc_oc=AdlSVx5i-58I-8GxEdq3sPfM8GKEWhL9n5tdOi4RTwh1C_jv38SBK0SkxGIE_XnqTvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs9yBMDgnKIOsoAAywUxMKu2W8uF_TYoIuhbd9I6QfxVA&oe=69A6C536"}, {"file_name": "whole_mapbbb (1).png", "id": "1048658816717414", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824203_1048658820050747_3830925882966996295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXk_mq8upF4Q7kNvwHU5LbG&_nc_oc=Adm2a1dtC6PxKtagGMO6qGp9jQA1J_03b2v4Pe2-j6qrtanVAOuyBGmXXz92_LT7I5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftwAlRQeV413N2SSxijDe_6qDNqKzSarD-_BGRYnJcn7w&oe=69A6C7B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supernova", "keywords": ["adventure", "strategy", "Action"], "long_description": "Supernova is a fast-paced, multiplayer VR experience that brings high-energy movement and non-stop fun into a vibrant, ever-expanding universe. Whether you're sprinting through futuristic landscapes, launching yourself across alien structures, or outsmarting your friends in epic games of tag, Supernova is all about freedom, flow, and fun.\n\nBuilt for players who love to move, Supernova lets you climb, jump, and explore using intuitive locomotion mechanics that make every match feel unique. From intense tag battles to creative mini-games and relaxing hangout spaces, there's always something new to experience. Team up, go solo, or compete in chaotic showdowns\u2014no two sessions are ever the same.\n\nPacked with rich environments, hidden secrets, and a strong sense of community, Supernova is more than just a game. It\u2019s a living, breathing world of adventure where movement is your superpower and fun is just a leap away.", "short_description": "Supernova is an action-packed Gorilla Tag fan game where the chase never ends! Dive into thrilling tag battles, explore vibrant maps, and enjoy a galaxy of fun mini-games and activities with friends. Whether you're running, jumping, or climbing, there's always something new to discover in Supernova!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://novatag.lol/pp/", "developer_terms_of_service_url": "https://novatag.lol/tos/", "publisher_name": "LSG", "support_website_url": null, "website_url": "https://novatag.lol/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads
, "id": "1446708006515706", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824532_1446708009849039_6665751589881146098_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67PTu2s6CsoQ7kNvwG6-Sk2&_nc_oc=Adr65MhdUnii6VpbdsFIgR9eLH3jbuUPSJip0yeelmuWDVhBNIRvX13M-uKkhGn8sIY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsylS67NzOLlot_AawqM4jj-jrGaH3LYIN44HOhUEgnw&oe=6A8D912E"}, {"file_name": "shopbbb (1).png", "id": "748004780886227", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491825029_748004784219560_6116206468442816297_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8K3ptk9tMVwQ7kNvwHE2Z0c&_nc_oc=Adqh8lbdBApXjbnWPhyN9qhgummnIN_Opquzih0OZK2Gbb441GRvOxgr4W740eVxg90&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbiMKUDf47PB6yQLYVfCXhIhFDBLRao6nOVul_7skVuA&oe=6A8D7C1C"}, {"file_name": "stumpthbbb (1).png", "id": "1014764844147854", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820270_1014764850814520_8179639573244492953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-25hbXpFDhsQ7kNvwFt8wd6&_nc_oc=Adr9clObtxk0rWrJFdrH8_ma3U0NprjNQeTAgbZbmvsNE2gi5amWqXdMIkZsUoih3uo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvtx6TX0M0UKhWpKjXVR5oVVTbbMu_ncsV-HDyYPoAbw&oe=6A8D6673"}, {"file_name": "forestbbb (1).png", "id": "684538787834752", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830597_684538791168085_1727959957459805399_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_shsq-ENdyIQ7kNvwFg6ASP&_nc_oc=AdqA96DEfnSgKdzsgWM997k3LPYPGDYd3LsL4tCj5eoSdouafRJKzojTqyGH_0VWCPM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTj1pN6261-R6oQLB4GiRCyE7031B94XlfD0hmwRbdgg&oe=6A8D7BB6"}, {"file_name": "whole_mapbbb (1).png", "id": "1048658816717414", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824203_1048658820050747_3830925882966996295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8_fDLpfmHIQ7kNvwEVA59z&_nc_oc=AdpI_6wRx_rFVQrdBuDZh2aQO6FJw5breBpE5hMq7QPk0YK1PWuktxuOTTrCo2YtHCM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8n8ZbHK1MaD3OUMeh2X_2lJ-3NCBRqS530fY6sOi38Q&oe=6A8D7E33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supernova", "keywords": ["adventure", "strategy", "Action"], "long_description": "Supernova is a fast-paced, multiplayer VR experience that brings high-energy movement and non-stop fun into a vibrant, ever-expanding universe. Whether you're sprinting through futuristic landscapes, launching yourself across alien structures, or outsmarting your friends in epic games of tag, Supernova is all about freedom, flow, and fun.\n\nBuilt for players who love to move, Supernova lets you climb, jump, and explore using intuitive locomotion mechanics that make every match feel unique. From intense tag battles to creative mini-games and relaxing hangout spaces, there's always something new to experience. Team up, go solo, or compete in chaotic showdowns\u2014no two sessions are ever the same.\n\nPacked with rich environments, hidden secrets, and a strong sense of community, Supernova is more than just a game. It\u2019s a living, breathing world of adventure where movement is your superpower and fun is just a leap away.", "short_description": "Supernova is an action-packed Gorilla Tag fan game where the chase never ends! Dive into thrilling tag battles, explore vibrant maps, and enjoy a galaxy of fun mini-games and activities with friends. Whether you're running, jumping, or climbing, there's always something new to discover in Supernova!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://novatag.lol/pp/", "developer_terms_of_service_url": "https://novatag.lol/tos/", "publisher_name": "LSG", "support_website_url": null, "website_url": "https://novatag.lol/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"},
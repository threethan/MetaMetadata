epNnIptw73g&oe=6AEB2BAE"}, {"file_name": "shopbbb (1).png", "id": "748004780886227", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825029_748004784219560_6116206468442816297_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCkaVWbj5GUQ7kNvwGQv9gw&_nc_oc=Adp-OVa0j757wGOmPbYo6QykdlW_ZYF0eVjzPiUr4cU1-untxHuy8EPuEpiJMgjropw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDtaGS92boy2b0wUjDOs-PBuP6PnupTuR68-Qesn_J8A&oe=6AEB4EDC"}, {"file_name": "stumpthbbb (1).png", "id": "1014764844147854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820270_1014764850814520_8179639573244492953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WdirWui08wQ7kNvwEiKMVH&_nc_oc=AdodscLKFLA23F69jlG81Mb3SkkzdQ9UaOWjoKsCoaHC5_KZKK8yNx7S6G_R3RIxFXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8q0Sjq--pxoCcOiGlznv7zo567wrNWGTSOoEFdTRNPg&oe=6AEB3933"}, {"file_name": "forestbbb (1).png", "id": "684538787834752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830597_684538791168085_1727959957459805399_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGTRe3cfPr0Q7kNvwF2YtBZ&_nc_oc=AdrRnFoPEOmB959uPdjFl01jKt_G97fgSLTT-dTU7RMPpptr_Se9rQ_PBwv9B9AvOO8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGy3O8c_Lh6UA4RyZcpzbe3DhD7GtGudtXLLGtRZfTmg&oe=6AEB4E76"}, {"file_name": "whole_mapbbb (1).png", "id": "1048658816717414", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824203_1048658820050747_3830925882966996295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGoeWmJeTCgQ7kNvwGznQ1A&_nc_oc=AdqsJFrohnWSLtMmzAGMM-_9CKKjzGQWbgVCXeaZIB656UezvUBvMCOu9saMypRMLFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUdGzvYdhs-o0xJtgOx6jsOtURiuRp8ymoy8OiRnOCuw&oe=6AEB50F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supernova", "keywords": ["adventure", "strategy", "Action"], "long_description": "Supernova is a fast-paced, multiplayer VR experience that brings high-energy movement and non-stop fun into a vibrant, ever-expanding universe. Whether you're sprinting through futuristic landscapes, launching yourself across alien structures, or outsmarting your friends in epic games of tag, Supernova is all about freedom, flow, and fun.\n\nBuilt for players who love to move, Supernova lets you climb, jump, and explore using intuitive locomotion mechanics that make every match feel unique. From intense tag battles to creative mini-games and relaxing hangout spaces, there's always something new to experience. Team up, go solo, or compete in chaotic showdowns\u2014no two sessions are ever the same.\n\nPacked with rich environments, hidden secrets, and a strong sense of community, Supernova is more than just a game. It\u2019s a living, breathing world of adventure where movement is your superpower and fun is just a leap away.", "short_description": "Supernova is an action-packed Gorilla Tag fan game where the chase never ends! Dive into thrilling tag battles, explore vibrant maps, and enjoy a galaxy of fun mini-games and activities with friends. Whether you're running, jumping, or climbing, there's always something new to discover in Supernova!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://novatag.lol/pp/", "developer_terms_of_service_url": "https://novatag.lol/tos/", "publisher_name": "LSG", "support_website_url": null, "website_url": "https://novatag.lol/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
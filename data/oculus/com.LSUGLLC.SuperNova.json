WXMlNZVlpfw&oe=6A1052AE"}, {"file_name": "shopbbb (1).png", "id": "748004780886227", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491825029_748004784219560_6116206468442816297_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-CsBdH3Y04Q7kNvwFj19lN&_nc_oc=AdpUtc6BkApxdFAHIAoe1aJhke0yXZN_Czhsg5F6HjTmUKofCht7zy7ZD4gIrOwHMWA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DXft5dj8J2ZYyl0C5HTkaeWqlRdYQWSA3AouA3Xhjvg&oe=6A1075DC"}, {"file_name": "stumpthbbb (1).png", "id": "1014764844147854", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820270_1014764850814520_8179639573244492953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgWw8r8eDh4Q7kNvwGS3LYW&_nc_oc=AdqRYqN8AkvkNER-Z5pGxhXMDAuZQRZNTfY7PxxT9qjqUn_1Fw-ViGM-XoIJ_0rQg5Y&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vUa65Cuxxf7OVSSnARbsv0CB83-yBuXGp5pIw7dcQHw&oe=6A106033"}, {"file_name": "forestbbb (1).png", "id": "684538787834752", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491830597_684538791168085_1727959957459805399_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fjBaBPxyaAQ7kNvwGroqDT&_nc_oc=Adq5Z2tuSjRe9ugcXadmMsLR9C9-RtxX6hkyGyjr-bfAwjT6hSDFl740fAhMUtLIeAo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Wl9EfxwwAUMv2p_1AQV5u_3gN0vtQFRXpuSi0-1ZjPg&oe=6A107576"}, {"file_name": "whole_mapbbb (1).png", "id": "1048658816717414", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491824203_1048658820050747_3830925882966996295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iowHIzeEJr0Q7kNvwGXZpYw&_nc_oc=AdpYzApSxE4dvFgTdiZWHQSzL6YIn0WyIRwUJ20Uql3zb-bP1tOGIeSlbhKuDV9I374&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B2-14kRw58CSNCyDpjFR1uiVojU10LEdTqj36ADoJww&oe=6A1077F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supernova", "keywords": ["adventure", "strategy", "Action"], "long_description": "Supernova is a fast-paced, multiplayer VR experience that brings high-energy movement and non-stop fun into a vibrant, ever-expanding universe. Whether you're sprinting through futuristic landscapes, launching yourself across alien structures, or outsmarting your friends in epic games of tag, Supernova is all about freedom, flow, and fun.\n\nBuilt for players who love to move, Supernova lets you climb, jump, and explore using intuitive locomotion mechanics that make every match feel unique. From intense tag battles to creative mini-games and relaxing hangout spaces, there's always something new to experience. Team up, go solo, or compete in chaotic showdowns\u2014no two sessions are ever the same.\n\nPacked with rich environments, hidden secrets, and a strong sense of community, Supernova is more than just a game. It\u2019s a living, breathing world of adventure where movement is your superpower and fun is just a leap away.", "short_description": "Supernova is an action-packed Gorilla Tag fan game where the chase never ends! Dive into thrilling tag battles, explore vibrant maps, and enjoy a galaxy of fun mini-games and activities with friends. Whether you're running, jumping, or climbing, there's always something new to discover in Supernova!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://novatag.lol/pp/", "developer_terms_of_service_url": "https://novatag.lol/tos/", "publisher_name": "LSG", "support_website_url": null, "website_url": "https://novatag.lol/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
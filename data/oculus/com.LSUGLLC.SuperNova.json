kpeXIN_j28J1w0Cy3h_f9skiFNmIb13QUDjrwJVS9eoJwsqG7XSyOa-fjXwcFvxSs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs1gyNKLAXTabozBz4ZCuTyrh9uktMoDxnpcoTsTu-JZA&oe=69A17F9C"}, {"file_name": "stumpthbbb (1).png", "id": "1014764844147854", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491820270_1014764850814520_8179639573244492953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fv6tDLUGq3MQ7kNvwHhClKV&_nc_oc=Adkm41vDYQzgt__UQFSy8TDg8vb4oWCGGAfzb8FoF2UvrAKKh_ipjfO63dkmAoC81v0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft1keJ0b27A2Otf9r4YLdIdBol_9t42P6Fe5OzVGHggbw&oe=69A1A233"}, {"file_name": "forestbbb (1).png", "id": "684538787834752", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491830597_684538791168085_1727959957459805399_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foCFDlYHeWMQ7kNvwGFUD6G&_nc_oc=AdlP-r9dirMwSQy2po5ireNW-IpUbwUoWnVBbYgT9QQJkSHxwKHA1amSRYYeh57T4kU&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftKGPY4r47CsvyKAkg-pA-DsmaYx6w909ZZgCKX_GwipQ&oe=69A17F36"}, {"file_name": "whole_mapbbb (1).png", "id": "1048658816717414", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491824203_1048658820050747_3830925882966996295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ura9i2nvELYQ7kNvwFKw1c7&_nc_oc=AdnAvDWq7WeOb3Gg2On-JCXTI0TgtDzoxkyuKPOonyN_bU-C6GHgufnvjKZ0EySaG-4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsJFZygTgO5UcjRlVlLcIlUBIE5_Gys0bq4YAASCoe33Q&oe=69A181B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supernova", "keywords": ["adventure", "strategy", "Action"], "long_description": "Supernova is a fast-paced, multiplayer VR experience that brings high-energy movement and non-stop fun into a vibrant, ever-expanding universe. Whether you're sprinting through futuristic landscapes, launching yourself across alien structures, or outsmarting your friends in epic games of tag, Supernova is all about freedom, flow, and fun.\n\nBuilt for players who love to move, Supernova lets you climb, jump, and explore using intuitive locomotion mechanics that make every match feel unique. From intense tag battles to creative mini-games and relaxing hangout spaces, there's always something new to experience. Team up, go solo, or compete in chaotic showdowns\u2014no two sessions are ever the same.\n\nPacked with rich environments, hidden secrets, and a strong sense of community, Supernova is more than just a game. It\u2019s a living, breathing world of adventure where movement is your superpower and fun is just a leap away.", "short_description": "Supernova is an action-packed Gorilla Tag fan game where the chase never ends! Dive into thrilling tag battles, explore vibrant maps, and enjoy a galaxy of fun mini-games and activities with friends. Whether you're running, jumping, or climbing, there's always something new to discover in Supernova!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://novatag.lol/pp/", "developer_terms_of_service_url": "https://novatag.lol/tos/", "publisher_name": "LSG", "support_website_url": null, "website_url": "https://novatag.lol/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24013476758303222"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChan
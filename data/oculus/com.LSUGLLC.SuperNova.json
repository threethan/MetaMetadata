_1446708009849039_6665751589881146098_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wqoQjBopaIQ7kNvwGzJxyr&_nc_oc=AdkOD0d0Menh09hjp_gyeS8xMGsQBd1DVSGo71unR7H5s8cOAvsR8qHFTJfu1C-A7SY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuJ1PJ3GjrA3KNn1rk-PSMsagNolR-sdnK4R89Foghxhw&oe=69A5892E"}, {"file_name": "shopbbb (1).png", "id": "748004780886227", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825029_748004784219560_6116206468442816297_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juQkYtEojt8Q7kNvwHQAD8_&_nc_oc=AdmlY6HIFIWuYILV91cgVz9E308u_Te7HgGeYdfypNEuhedyPQE8g_8ykdrORFHqB-U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuqAU661JRtVpS0d3a6PL-Betp0tTjRvezVxHK37wAkYw&oe=69A5741C"}, {"file_name": "stumpthbbb (1).png", "id": "1014764844147854", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820270_1014764850814520_8179639573244492953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3oYEFaxeboQ7kNvwGvJCLF&_nc_oc=Adm8thm-QmJo7zkCDwIA4U2ouvvEepYuk9waXQyOhqHixNcQvPx8svDIW8aEfz5MYlU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs2RCdwxFdhKjbgYX9GMSFbMCcSmJDTygYdUz5rMHrRwQ&oe=69A596B3"}, {"file_name": "forestbbb (1).png", "id": "684538787834752", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830597_684538791168085_1727959957459805399_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sW7bhBRCYwgQ7kNvwFW8fZI&_nc_oc=AdnLdQtq8XF9NmeX89EYo_R4QyrY10mhOGDJovkRw3L0PPUo1lVfYNB0TqQ1z1m5AxE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvOT-U9c1PIGvaytpeDt69BHVQ653AF4LF3YUF2GL5NxA&oe=69A573B6"}, {"file_name": "whole_mapbbb (1).png", "id": "1048658816717414", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824203_1048658820050747_3830925882966996295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mmf5aBmu2CoQ7kNvwFjEAeb&_nc_oc=AdkXRtEYxzFZum1Qiern-F3EQSs07cVFfPZMN-7Valbax_Gj1hiUgXLl-1tSaraq5zQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv576BxhCTBc4vV6VGbd-GGrzV1s-U9BMUq5RMOHp9Bkw&oe=69A57633"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supernova", "keywords": ["adventure", "strategy", "Action"], "long_description": "Supernova is a fast-paced, multiplayer VR experience that brings high-energy movement and non-stop fun into a vibrant, ever-expanding universe. Whether you're sprinting through futuristic landscapes, launching yourself across alien structures, or outsmarting your friends in epic games of tag, Supernova is all about freedom, flow, and fun.\n\nBuilt for players who love to move, Supernova lets you climb, jump, and explore using intuitive locomotion mechanics that make every match feel unique. From intense tag battles to creative mini-games and relaxing hangout spaces, there's always something new to experience. Team up, go solo, or compete in chaotic showdowns\u2014no two sessions are ever the same.\n\nPacked with rich environments, hidden secrets, and a strong sense of community, Supernova is more than just a game. It\u2019s a living, breathing world of adventure where movement is your superpower and fun is just a leap away.", "short_description": "Supernova is an action-packed Gorilla Tag fan game where the chase never ends! Dive into thrilling tag battles, explore vibrant maps, and enjoy a galaxy of fun mini-games and activities with friends. Whether you're running, jumping, or climbing, there's always something new to discover in Supernova!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://novatag.lol/pp/", "developer_terms_of_service_url": "https://novatag.lol/tos/", "publisher_name": "LSG", "support_website_url": null, "website_url": "https://novatag.lol/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads
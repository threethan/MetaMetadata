ERocMLPVs0A&oe=6A26BC2E"}, {"file_name": "shopbbb (1).png", "id": "748004780886227", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825029_748004784219560_6116206468442816297_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUGpXDbo_GQQ7kNvwFk8jIo&_nc_oc=AdrRS6e_VLXiFtBoaIlisU5mE4YDuCyVHu_GqxxyjaCiy8rDFuOfZOAa2Loymb01yyU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7dn_SXreuQOfTVpytCdaUsfK9CkCS8AYRjUOt4bvPPQ&oe=6A26DF5C"}, {"file_name": "stumpthbbb (1).png", "id": "1014764844147854", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820270_1014764850814520_8179639573244492953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eMGiEX-tYkQ7kNvwFRu25E&_nc_oc=Adra2VlAcv5lnJb0fP4WvE8I_2mFKK9lMUTl2s_SxCyoaF3sQ9jHSsu8Rd5oYqjNFc4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JJe653YKZaZ7MWQ29sbSHT_M-f33zupX1P5w8bBznzg&oe=6A26C9B3"}, {"file_name": "forestbbb (1).png", "id": "684538787834752", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830597_684538791168085_1727959957459805399_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BgA1p6DrZgQ7kNvwES9nvM&_nc_oc=AdoN3YmRYLnsfPFoqy3Pc-k4EsDaFg6cpwU6P3T_eTF5vHPOCGzdetE6ehMAP6hdH8I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lcSgYOGncRAe0-vNvpxs1ZZ32z6rUt3B0KK7Bap9Pxw&oe=6A26DEF6"}, {"file_name": "whole_mapbbb (1).png", "id": "1048658816717414", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824203_1048658820050747_3830925882966996295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2mWXlXHMOAQ7kNvwGcnA9p&_nc_oc=AdquYSXZGp5MjlrZXOTYOxATCy6aWcXJIV7fxu_funFh-EnLJ1bx43mHjlzhf72a4PQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qz1_MIvTCQWEa_RKBIQSNk5cbGU8mwjikocX1VCZybg&oe=6A26E173"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supernova", "keywords": ["adventure", "strategy", "Action"], "long_description": "Supernova is a fast-paced, multiplayer VR experience that brings high-energy movement and non-stop fun into a vibrant, ever-expanding universe. Whether you're sprinting through futuristic landscapes, launching yourself across alien structures, or outsmarting your friends in epic games of tag, Supernova is all about freedom, flow, and fun.\n\nBuilt for players who love to move, Supernova lets you climb, jump, and explore using intuitive locomotion mechanics that make every match feel unique. From intense tag battles to creative mini-games and relaxing hangout spaces, there's always something new to experience. Team up, go solo, or compete in chaotic showdowns\u2014no two sessions are ever the same.\n\nPacked with rich environments, hidden secrets, and a strong sense of community, Supernova is more than just a game. It\u2019s a living, breathing world of adventure where movement is your superpower and fun is just a leap away.", "short_description": "Supernova is an action-packed Gorilla Tag fan game where the chase never ends! Dive into thrilling tag battles, explore vibrant maps, and enjoy a galaxy of fun mini-games and activities with friends. Whether you're running, jumping, or climbing, there's always something new to discover in Supernova!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://novatag.lol/pp/", "developer_terms_of_service_url": "https://novatag.lol/tos/", "publisher_name": "LSG", "support_website_url": null, "website_url": "https://novatag.lol/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
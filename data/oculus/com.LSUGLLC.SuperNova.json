_1446708009849039_6665751589881146098_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBeHCJD1vZ0Q7kNvwGgbTNl&_nc_oc=Admxor50tKMWEEUEucxfJCe_XN1sGBaQ6_qe1NrT47DQw2qkreHARTl9OOkCcvHS3lk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZLnt6Rq2zRxm5A4-H_sxBoAKKzl05Gf0NgDBmtZyttA&oe=69A2E62E"}, {"file_name": "shopbbb (1).png", "id": "748004780886227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825029_748004784219560_6116206468442816297_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juQkYtEojt8Q7kNvwGeA5d1&_nc_oc=AdmR4CggPgFrgRUgkcFvG7sGGZb3qOyK5fdGZxKHrQDdIlqNZfcPKd8C7Xf14H-B5X4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvS8EnR-gw4nmlC_3UuWZraUYZFm9H5VLCDbTug4Tnyqw&oe=69A2D11C"}, {"file_name": "stumpthbbb (1).png", "id": "1014764844147854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820270_1014764850814520_8179639573244492953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fv6tDLUGq3MQ7kNvwE4W2Ot&_nc_oc=Adl8g20cY5Tvq7TW3oKZOh3ZgTlvWwmu_j9NVoTodBb-NWDNnJUsk-Onn2aLm737lLk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftzqw67PbkDlnk47Xd0Z8_xz8B7O8PH_lw85_x-eOXKzg&oe=69A2F3B3"}, {"file_name": "forestbbb (1).png", "id": "684538787834752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830597_684538791168085_1727959957459805399_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foCFDlYHeWMQ7kNvwE7gk7q&_nc_oc=AdldGE4AXqzRVyZVgbscxaml7BaasELURpocPdoBEXbfmmjZV_37c4cQIViL-u-2FFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftp5nsUe8nGi0xhoo3PttbO6X1_FkdopEMuHExVbpc72g&oe=69A2D0B6"}, {"file_name": "whole_mapbbb (1).png", "id": "1048658816717414", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824203_1048658820050747_3830925882966996295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mmf5aBmu2CoQ7kNvwGvPgan&_nc_oc=Adk-QdZqG_AmzXjpFWhrJi9nPJNWCZk5ejuoZuYIO5-TiYAPjbVU8SFKxEQ7jKVVJU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuUvPW4URkE65YtkJAxD8pIX2WeL-Bc4KyFcUnFg_xY6g&oe=69A2D333"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supernova", "keywords": ["adventure", "strategy", "Action"], "long_description": "Supernova is a fast-paced, multiplayer VR experience that brings high-energy movement and non-stop fun into a vibrant, ever-expanding universe. Whether you're sprinting through futuristic landscapes, launching yourself across alien structures, or outsmarting your friends in epic games of tag, Supernova is all about freedom, flow, and fun.\n\nBuilt for players who love to move, Supernova lets you climb, jump, and explore using intuitive locomotion mechanics that make every match feel unique. From intense tag battles to creative mini-games and relaxing hangout spaces, there's always something new to experience. Team up, go solo, or compete in chaotic showdowns\u2014no two sessions are ever the same.\n\nPacked with rich environments, hidden secrets, and a strong sense of community, Supernova is more than just a game. It\u2019s a living, breathing world of adventure where movement is your superpower and fun is just a leap away.", "short_description": "Supernova is an action-packed Gorilla Tag fan game where the chase never ends! Dive into thrilling tag battles, explore vibrant maps, and enjoy a galaxy of fun mini-games and activities with friends. Whether you're running, jumping, or climbing, there's always something new to discover in Supernova!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://novatag.lol/pp/", "developer_terms_of_service_url": "https://novatag.lol/tos/", "publisher_name": "LSG", "support_website_url": null, "website_url": "https://novatag.lol/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads
_1446708009849039_6665751589881146098_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWAp5lfJUYQQ7kNvwFOSbJo&_nc_oc=AdmI1JP_DaG557hZev_YIbNIAyRJ30q2tYzhtPmX3RE4SbYyQPVRpBg5gFGfCrbCt0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu5i6BSSrlqD3ptediJSG9H2DTONKoyW-EeTyo8ws-JWg&oe=6999ABAE"}, {"file_name": "shopbbb (1).png", "id": "748004780886227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825029_748004784219560_6116206468442816297_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2AZ4JxianUQ7kNvwEz0I86&_nc_oc=Adlek5ou8560vU7RrSmZXCr6DvxHtMptwuzISINpn5jXjoVwh-3g_pqXFB7N28ahVZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuHnKoY4ZzwWkuTdqDIlyowb2oYj589T07Up8TyF7vA6w&oe=6999969C"}, {"file_name": "stumpthbbb (1).png", "id": "1014764844147854", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820270_1014764850814520_8179639573244492953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-p35fqrrbMQ7kNvwFB2-ra&_nc_oc=Adntu1HQRDu6WRlRWfou27Wueu8N8BGkfkTi6UmYMB9CgNkRyPB5Ek8fLGeHENnq4oI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCqe_Q0w-qwEC9bHWXD4e08x0_2wc0qACxSpWWV4OnPA&oe=6999B933"}, {"file_name": "forestbbb (1).png", "id": "684538787834752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830597_684538791168085_1727959957459805399_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9QeRgp0cFsQ7kNvwF2G4nP&_nc_oc=AdkVle3kOVgUuibNEduVC2hhFiaQWmd3DHVB4D6f54XT_IjcKCEir2OCH59dxZAVdlY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZZi36axETZGN4nEId-4Oo_T4vfRkDSCnpLUqO4OCBlw&oe=69999636"}, {"file_name": "whole_mapbbb (1).png", "id": "1048658816717414", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824203_1048658820050747_3830925882966996295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0W0FJp0fmwQ7kNvwHmwRwu&_nc_oc=AdmYqSsGzurOizMBAQ4MtCM-vTX-THn1J6YZhUXdsjD3J2L6RKWd0TRyGf0afZDIIJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuLm5fadljnzry9AqcelftNGTX5g0xaJ5vEWj9L-h3zZQ&oe=699998B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supernova", "keywords": ["adventure", "strategy", "Action"], "long_description": "Supernova is a fast-paced, multiplayer VR experience that brings high-energy movement and non-stop fun into a vibrant, ever-expanding universe. Whether you're sprinting through futuristic landscapes, launching yourself across alien structures, or outsmarting your friends in epic games of tag, Supernova is all about freedom, flow, and fun.\n\nBuilt for players who love to move, Supernova lets you climb, jump, and explore using intuitive locomotion mechanics that make every match feel unique. From intense tag battles to creative mini-games and relaxing hangout spaces, there's always something new to experience. Team up, go solo, or compete in chaotic showdowns\u2014no two sessions are ever the same.\n\nPacked with rich environments, hidden secrets, and a strong sense of community, Supernova is more than just a game. It\u2019s a living, breathing world of adventure where movement is your superpower and fun is just a leap away.", "short_description": "Supernova is an action-packed Gorilla Tag fan game where the chase never ends! Dive into thrilling tag battles, explore vibrant maps, and enjoy a galaxy of fun mini-games and activities with friends. Whether you're running, jumping, or climbing, there's always something new to discover in Supernova!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://novatag.lol/pp/", "developer_terms_of_service_url": "https://novatag.lol/tos/", "publisher_name": "LSG", "support_website_url": null, "website_url": "https://novatag.lol/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads
IRwEpaIdrvw&oe=6AF9E46E"}, {"file_name": "shopbbb (1).png", "id": "748004780886227", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825029_748004784219560_6116206468442816297_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Tc3ay4c86wQ7kNvwFyUSd4&_nc_oc=AdrVrE08cAmzaamj-9TEdZai-yrLmOyp998oI4qUhUI_DsLSaq4oGlZ5wWQCYOwXCPM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0JhpTMO3y-Y0Flf_XLDEe1I0Ax3_zZA7euXk7mv-_8A&oe=6AF9CF5C"}, {"file_name": "stumpthbbb (1).png", "id": "1014764844147854", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820270_1014764850814520_8179639573244492953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDe8opSRpLUQ7kNvwGTl6Nf&_nc_oc=AdpEVo5rkeWCkf7EchPz4sPaSWPbkurUN4q4Ak_EIV-TXOQagKdGS6ff5J16mXpcjpE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIzO4SX8n5ubBouyl1sxwdEhUMcMhMmMCzzPvJHQFwUw&oe=6AF9B9B3"}, {"file_name": "forestbbb (1).png", "id": "684538787834752", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830597_684538791168085_1727959957459805399_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16gsJWK5uPIQ7kNvwGhKB27&_nc_oc=Ado2YGNcQ4IQrx_MIRA9xxy2HTRnlju4y7REMpfoMjHDGyucEVD-74D-EKKKPI2HmII&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVHcB3pn7f8dzteyE4zBAI-3nKRoyvMPeLWpthpOuAag&oe=6AF9CEF6"}, {"file_name": "whole_mapbbb (1).png", "id": "1048658816717414", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824203_1048658820050747_3830925882966996295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECOhIhgOL48Q7kNvwEzW_HD&_nc_oc=AdrTyd_1eIPRqhwbWkwYoMl_yhYmza19nlG0I6ijNTCezGn8OZgCZ7DM26jKlcd4sK8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTITeLGMJMaP7gZ4kjsHZhYmtmpekb-Dj5UjrQUgp2mPQ&oe=6AF9D173"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supernova", "keywords": ["adventure", "strategy", "Action"], "long_description": "Supernova is a fast-paced, multiplayer VR experience that brings high-energy movement and non-stop fun into a vibrant, ever-expanding universe. Whether you're sprinting through futuristic landscapes, launching yourself across alien structures, or outsmarting your friends in epic games of tag, Supernova is all about freedom, flow, and fun.\n\nBuilt for players who love to move, Supernova lets you climb, jump, and explore using intuitive locomotion mechanics that make every match feel unique. From intense tag battles to creative mini-games and relaxing hangout spaces, there's always something new to experience. Team up, go solo, or compete in chaotic showdowns\u2014no two sessions are ever the same.\n\nPacked with rich environments, hidden secrets, and a strong sense of community, Supernova is more than just a game. It\u2019s a living, breathing world of adventure where movement is your superpower and fun is just a leap away.", "short_description": "Supernova is an action-packed Gorilla Tag fan game where the chase never ends! Dive into thrilling tag battles, explore vibrant maps, and enjoy a galaxy of fun mini-games and activities with friends. Whether you're running, jumping, or climbing, there's always something new to discover in Supernova!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://novatag.lol/pp/", "developer_terms_of_service_url": "https://novatag.lol/tos/", "publisher_name": "LSG", "support_website_url": null, "website_url": "https://novatag.lol/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
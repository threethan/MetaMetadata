3htCj51PvPg&oe=6AB129AE"}, {"file_name": "shopbbb (1).png", "id": "748004780886227", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825029_748004784219560_6116206468442816297_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq_Qu1Tl6ugQ7kNvwGAPepO&_nc_oc=Adr_99YK3sPli1WqF29a1nX4Ymxqw8Y2hqD8Ui_d5xvyAjrNW197EwgG3Od7j27kYdk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8qXp9jYD1rjDhSBmesr8g9W9qP4m85ngtiBcw_hdMRw&oe=6AB14CDC"}, {"file_name": "stumpthbbb (1).png", "id": "1014764844147854", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820270_1014764850814520_8179639573244492953_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiSoDM62GfsQ7kNvwG_1DMI&_nc_oc=AdqFuYP3FMndv419lRltQVBUM5QQ0gRJBYANnUZkrL9j9LX0V3YKNe2N7rfjDwLKyoY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFihBpF2nfmWjFUEpz2R5qh9pCtDasKkgcbB4D2TGUhw&oe=6AB13733"}, {"file_name": "forestbbb (1).png", "id": "684538787834752", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830597_684538791168085_1727959957459805399_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoWcSMqk_U0Q7kNvwGtkQ8L&_nc_oc=AdoyTyylYH2JZVe7JcIDYGcG2bOeiLNqPVtSqZef0hxBrLns32Ggv4IR-MV2HwfEh68&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGuufUoNHNOmNr0M18KsyVOUs19yD3oaE7IGFoMGQ5Qg&oe=6AB14C76"}, {"file_name": "whole_mapbbb (1).png", "id": "1048658816717414", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824203_1048658820050747_3830925882966996295_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwQ9Muk2ueUQ7kNvwEA2R62&_nc_oc=Adp6Jt2l5ua0KEhxndF9amN2duzHcmDNdPfigyAV9uer5ujPRo1KXezDXQzM0LTuZko&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPw2U7n0Roe34b9RafPHRuR_yNBr0J3BWd9wGSVW4A-Q&oe=6AB14EF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supernova", "keywords": ["adventure", "strategy", "Action"], "long_description": "Supernova is a fast-paced, multiplayer VR experience that brings high-energy movement and non-stop fun into a vibrant, ever-expanding universe. Whether you're sprinting through futuristic landscapes, launching yourself across alien structures, or outsmarting your friends in epic games of tag, Supernova is all about freedom, flow, and fun.\n\nBuilt for players who love to move, Supernova lets you climb, jump, and explore using intuitive locomotion mechanics that make every match feel unique. From intense tag battles to creative mini-games and relaxing hangout spaces, there's always something new to experience. Team up, go solo, or compete in chaotic showdowns\u2014no two sessions are ever the same.\n\nPacked with rich environments, hidden secrets, and a strong sense of community, Supernova is more than just a game. It\u2019s a living, breathing world of adventure where movement is your superpower and fun is just a leap away.", "short_description": "Supernova is an action-packed Gorilla Tag fan game where the chase never ends! Dive into thrilling tag battles, explore vibrant maps, and enjoy a galaxy of fun mini-games and activities with friends. Whether you're running, jumping, or climbing, there's always something new to discover in Supernova!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://novatag.lol/pp/", "developer_terms_of_service_url": "https://novatag.lol/tos/", "publisher_name": "LSG", "support_website_url": null, "website_url": "https://novatag.lol/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
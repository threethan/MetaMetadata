P9UB78p8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoj4XUC4wXaF1oMn18qffFUIYS58DWYnuEXdj-FVQjqg&oe=6AF87721"}, {"file_name": "5_TowerVolley.png", "id": "2671513183310707", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831299_2671513186644040_4333653591909642125_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Se5y_yWyYVcQ7kNvwF2EYnH&_nc_oc=AdpYEhc9e4T6xQL7GAfN1hAgwtlaLv2e_CvyWcwuiVV_NnaNEPLBTIpjQtbguXtjO0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-fOmSKyZPUZjMTHsYvghd7HYHfJXLsEI0aySIRA3B_w&oe=6AF8996E"}, {"file_name": "1_GateCaptain.png", "id": "1775364196877009", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/756589809_1775364200210342_8076723170285672084_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4LNaRAZom0Q7kNvwGV5aZ8&_nc_oc=Ado3F6BfUXnE8YSJwhKBVAzmqhX7Sgue_f2-An5axY1-_2zi0XWLUYkOhVxpog9v7qg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmt1t_vfJ0aZc4IrTBT7wGccOneoEmqTGWFMbFZji8jw&oe=6AF88F4D"}, {"file_name": "4_SteelClaw.png", "id": "2244012969505083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604310912_2244012972838416_7136578537294076356_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YxF38U0S5oQ7kNvwEQ3aD2&_nc_oc=AdrXy1QFj3GzUHGplvAAh5cTcdNLU7R2R6k-F1mkOHudNixJKiebWyjwXUvJjQtwL5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFsDGs-z6AukHEd1dFXyVKRIsVa_mGujQV5VkTc84MAQ&oe=6AF885FB"}, {"file_name": "3_BannerCaptain.png", "id": "1060416616955424", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673536876_1060416620288757_2580171733664666962_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_drWBiKrXQQ7kNvwEmAGlu&_nc_oc=AdpCvKUJ-oZZMjseJ5mU-V1XPHtSBK4XpRzJGppTLuAo5Lf1FZanlCNutjC3u69qyWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwhTpL7UiZuJyPkZpzxsxYsewiXTFNYjs4FmWVu27_0Q&oe=6AF89731"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440.png", "id": "1499713912181331", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596168449_1499713918847997_6161723442624004798_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw3IpaWeyB4Q7kNvwGoFed9&_nc_oc=AdrYrTpmLxyI0s_ptrMdV4ZcOGAuk9LiyaAIkL1YQW0Ep7-6YZxWpSYQkKhrTOh3Gb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnIK-R0aN5qW-DYT-qcGRIZ6lu-5Zqeuv3KRDMknGiAg&oe=6AF87E95"}, "display_name": "Kale Muhaf\u0131z\u0131 VR - Castle Guardian", "keywords": ["archery", "castledefense", "siege", "towerdefense", "bow"], "long_description": "Stand on the ramparts, draw your bow and stop the army before your gate falls. Kale Muhaf\u0131z\u0131 VR (Castle Guardian) brings Seljuk-inspired castle defense to VR.\n\n\u2022 14 campaign chapters, from the Castle Gate to Twilight Pass, Banner Hill and the Siege Ring. Earlier chapters now include tower archers, catapult batteries and distinct final leaders. Kara Arslan awaits in chapter 11.\n\u2022 Counter each threat: break tower wheels, shoot a catapult rope to interrupt its attack, disrupt commanders and strike armored wardens when their weak points open. Raiders, javelin throwers, shield walls, ladder crews, medics and vanguards keep each siege varied.\n\u2022 Manage fire, ice and bomb arrows across the whole chapter. Ammunition does not refill between waves; every two headshots reward one special arrow.\n\u2022 Unlock 5 bows and 5 arrow types through victories. Shoot a power-up card between waves; use castle traps, focus and a triple volley to turn the battle.\n\u2022 Draw with either hand, read brief changing winds and feel controller feedback. Play standing in place with snap turn; pause to change equipment and settings.\n\u2022 Trial Arena, single-player offline play, English and Turkish.\n\nThe new siege trailer and screenshots are staged in-engine promotional captures.", "short_description": "Defend a Seljuk-inspired castle with a real VR bow. Face 14 campaign chapters, tower archers, catapult batteries and distinct chapter leaders. Break siege engines at their weak points, use fire, ice and bomb arrows wisely, and unlock new bows and arrows as you advance. Single-player castle defense in English and Turkish."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/kalemuhafzvrcastleguardian/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "DorukTech", "support_website_url": null, "website_url": "https://www.facebook.com/doruktechvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1346265555239618"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824671_4531183337171122_4171532996689135983_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_-nwKAOYKYQ7kNvwF3zdC8&_nc_oc=AdqespYbJQ7h1ueQ9lQahomGbjo_NgLn6r6TW4kVJWzuW382Z2kjab1ezlfPtOtFDeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTioOLPWGF1l2j_cLR0k-p3gZsGJc8tsTo8H1STgy3kQ&oe=6AF889F8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kale Muhaf\u0131z\u0131 VR - Castle Guardian", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Strategy", "id": "275629210202852"}], "release_date": 1791300600, "lastRevision": {"nodes": [{"id": "1336697632863077", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1336697619529745", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1804388830603763"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1778900369928377", "locale": "tr_TR", "screenshots": [{"file_name": "5_KaraArslan_Bow.png", "id": "28907608558877555", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_28907608568877554_2525311325083086409_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ROqtoKBFCFgQ7kNvwGpG3Lj&_nc_oc=Adr4XTFdjJhpaIOQUQGFMwc0CTKmD1PT25DEfsVEq_VrSylAUFuYVHokplCANr704Z4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7jf_ogjsgz9lwFGMT8VfsnQevhmIkjA_MXfUVHxaO0Q&oe=6AF89548"}, {"file_name": "3_Ladders.png", "id": "2910512375974181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_2910512389307513_4955520990640300480_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGJcb5MSmxAQ7kNvwGLcUU-&_nc_oc=AdrAWZ4-JLadJQbo3lxDQ47kcxorFysVbHbCKpi02q1XIA5vjhtHUovDP0CYyy5NtK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_n9uQ50JT6Cbb6kq_RMqE39wEPeT-kaC70cMjhW1sXQ&oe=6AF8766B"}, {"file_name": "1_Wave_Bow.png", "id": "1128016283337756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1128016286671089_7063843350158977864_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEZHC9vjYDwQ7kNvwF_deAj&_nc_oc=Adrqi5o-awZmRP8LXdzCPdU5vEA-84DxzUVv4ZkEuLK1Mi6mQ3KwiUH5Qb0p1Cwk428&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTRqNcGjNY1JLo4yCEbmbhcRVAAOjow83i2q10AHCx0w&oe=6AF89835"}, {"file_name": "2_River_Bridge.png", "id": "1773860053845285", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_1773860057178618_8738452438273855785_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPwZ8SsI7TcQ7kNvwFeQmxX&_nc_oc=AdoPbvD2FBdCAPNdEciPFocdGXpR8KTydSoKv_Ue--mNByZOVOQRRBGTFUYKVAHhZYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPvHJ05zhki0otm7l-KNl2vBZi4y7fy9O97UTDGWK4Iw&oe=6AF8825A"}, {"file_name": "4_Warlord.png", "id": "1763032414900862", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1763032421567528_352465577248756467_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjDLOuKUyY4Q7kNvwHNeai8&_nc_oc=Adq2e_ZDS4abzdnLeDQF_ASLOh3b_Zen3yI-JaMgRJjHSwA_4r4TG1TIEBYpOnbsuwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9SUKjRerOgVFYndvSRA8_StWgr_Hi4RR-zTKnkgj8KA&oe=6AF8AA2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kale Muhaf\u0131z\u0131 VR - Castle Guardian", "keywords": ["ok\u00e7uluk", "kalesavunmas\u0131", "ku\u015fatma", "sel\u00e7uklu", "yay"], "long_description": "Kale Muhaf\u0131z\u0131 VR, Sel\u00e7uklu esintili bir kale savunma oyunu. Kap\u0131n\u0131n \u00fcst\u00fcndeki n\u00f6bet yerindesin: elinde yay, \u00f6n\u00fcnde surlara k\u0131vr\u0131lan yol ve o yolda dalga dalga gelen d\u00fc\u015fman.\n\n\u2022 11 b\u00f6l\u00fcml\u00fck sefer: Kale Kap\u0131s\u0131, Nehir Ge\u00e7idi, Da\u011f Ge\u00e7idi, Gece Bask\u0131n\u0131, Kervansaray, G\u00f6zetleme Vadisi, Son Ku\u015fatma, Harabe Yolu, Nehir Liman\u0131, B\u00fcy\u00fck Zafer ve Kara Arslan'a kar\u015f\u0131 son direni\u015f. G\u00fcnd\u00fcz, ak\u015fam, kapal\u0131 hava ve gece.\n\u2022 Her d\u00fc\u015fman\u0131n bir i\u015fi var: ak\u0131nc\u0131lar, cirit\u00e7iler, balyozcular, kalkan duvarlar\u0131, askerlerini h\u0131zland\u0131ran sancaktarlar, surlara t\u0131rmanan merdivenliler, ko\u00e7ba\u015f\u0131 ekipleri, z\u0131rhl\u0131 \u015fampiyonlar ve hepsinin ba\u015f\u0131 Kara Arslan.\n\u2022 \u00d6zel oklar: ate\u015f, buz ve bomba. Odak dolunca a\u011f\u0131r \u00e7ekim ve \u00fc\u00e7l\u00fc ok.\n\u2022 Kalenin tuzaklar\u0131: zift kazan\u0131, barut f\u0131\u00e7\u0131lar\u0131, k\u00fct\u00fck tuza\u011f\u0131, ar\u0131 kovan\u0131 ve kap\u0131y\u0131 onaran gong.\n\u2022 Dalgalar aras\u0131nda g\u00fc\u00e7 kart\u0131n\u0131 okla vurarak se\u00e7. \u0130lerledik\u00e7e 5 yay ve 5 ok a\u00e7\u0131l\u0131r. R\u00fczg\u00e2r okunu yana iter.\n\u2022 Ger\u00e7ek bir yay: istedi\u011fin elle tut, kiri\u015fi \u00e7ekerken gerilimi kumandada hisset.\n\u2022 Deneme Sahas\u0131: b\u00fct\u00fcn \u00f6zel oklar, tuzaklar ve ku\u015fatma d\u00fc\u015fmanlar\u0131 bir arada.\n\u2022 Yerinde durarak oynan\u0131r, y\u00fcr\u00fcmek yok; kademeli d\u00f6n\u00fc\u015f var. Tek oyunculu, internet gerekmez. T\u00fcrk\u00e7e ve \u0130ngilizce.", "short_description": "Surlar\u0131n \u00fcst\u00fcnde tek ba\u015f\u0131na bir ok\u00e7usun. Kiri\u015fi T\u00fcrk usul\u00fc ba\u015fparmakla \u00e7ek, kap\u0131na y\u00fcr\u00fcyen orduyu durdur! Kalkan duvarlar\u0131n\u0131 ate\u015f okuyla par\u00e7ala, surlara dayanan merdivenleri devir, ko\u00e7ba\u015f\u0131n\u0131 k\u0131r, zift kazan\u0131n\u0131 bo\u015falt. R\u00fczg\u00e2r\u0131 hesaba kat, dalgalar aras\u0131nda g\u00fc\u00e7 kart\u0131n\u0131 vur, yay\u0131n\u0131 ve okunu se\u00e7. 11 b\u00f6l\u00fcml\u00fck seferin sonunda seni Kara Arslan bekliyor."}, {"images": {"nodes": [{"file_name": "Icon_512x512.png", "id": "28450152117986564", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824671_28450152124653230_5164661097279647223_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sxm_SggxSPEQ7kNvwE86pFV&_nc_oc=Ado9B6EgsvKKVH1157BCW95L9kPDhftFYa3Xim9q9Z2cHpVJoGP_JjW3YvRKRiwOYpM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnHgM63A2fFGttMBezL_7jqbXU_VJ7H1RYX4cqg23NEQ&oe=6AF88AB8"}, {"file_name": "Cover_Square_1440x1440.png", "id": "4531183330504456", "im
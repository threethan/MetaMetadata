666183075", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828050_4074430669516408_3979608834263180895_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PgDoyT_-usQ7kNvwGXLQjw&_nc_oc=AdotDSWf6_VyyDfrVznZiSE41spuSKESpJpTNESrt5v_AeBbQ-uH9g-dtoFl0r9uLns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgX5uSrMZCQAK9w1zyunY9jeGl3-OdDPbU3mU6H44Phg&oe=6AF885D4"}, {"file_name": "3_Ladders.png", "id": "1493990555883920", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821796_1493990559217253_7629746177234797997_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0-NDRK3pI4Q7kNvwEyutMW&_nc_oc=AdqgUlQ0aoDzgH4d2AP0sfFOV4FBB1GoQKFEExthvo0W9_33h8UI__KT325Zta_PQeg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcXYKA8GEivSkxXr4XgJ3LdLmw6pwxCJ32X3g77INI_A&oe=6AF8A176"}, {"file_name": "1_Wave_Bow.png", "id": "1417221733859354", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_1417221737192687_7911887793521602782_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47rMXF9jcsAQ7kNvwG39vu4&_nc_oc=Adpyx_GXgaeFVOO3TRJqu2S3_0e5MLIvAzcyqBQVGL_k2-5dm6yBWDPXtVvbGMFIY-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxlsnVI5KVm8VZd47VzAdj7uHuxuXEPyjDqg-VCYu2oA&oe=6AF8A18D"}, {"file_name": "2_River_Bridge.png", "id": "2083618996360002", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_2083618999693335_5747791748849489698_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1i2bfagm3NoQ7kNvwE8hS8k&_nc_oc=AdpY8YlMXRmSHkPIxu77_q-tdg3Mt1dTG3zCfaN7utfqWXJSyy1DU-TLt3KB5mN2iBU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRN2gL1y448_xD1QLK2rPhNqPvMEsv3oTvMopq72MGEw&oe=6AF8AC97"}, {"file_name": "4_Warlord.png", "id": "28533472169645183", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_28533472196311847_2155285360544025034_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5WWiPUWD-wQ7kNvwE891VV&_nc_oc=Adrp5okiDajR2hG_CmZIDsqM3tbG7xEKeE0xdcPnikxNqjJQO-8VmRqQSipnzOb8dII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs8PiFN-IQfg3GMoNh4fROf8EVPoGGCjJrrk-ECFz5Ng&oe=6AF8AC69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440.png", "id": "1499713912181331", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596168449_1499713918847997_6161723442624004798_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw3IpaWeyB4Q7kNvwGoFed9&_nc_oc=AdrYrTpmLxyI0s_ptrMdV4ZcOGAuk9LiyaAIkL1YQW0Ep7-6YZxWpSYQkKhrTOh3Gb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnIK-R0aN5qW-DYT-qcGRIZ6lu-5Zqeuv3KRDMknGiAg&oe=6AF87E95"}, "display_name": "Kale Muhaf\u0131z\u0131 VR - Castle Guardian", "keywords": ["archery", "castledefense", "siege", "towerdefense", "bow"], "long_description": "Kale Muhaf\u0131z\u0131 VR (Castle Guardian) is a castle defense game inspired by the Seljuks. You stand at the post above the gate, bow in hand, the road winding up to your walls and wave after wave of soldiers on it.\n\n\u2022 An 11-level campaign: Castle Gate, River Crossing, Mountain Pass, Night Raid, Caravanserai, Watch Valley, The Great Siege, Ruins Approach, River Port, Grand Victory and the final stand against Kara Arslan. Day, dusk, overcast and night.\n\u2022 Every enemy has a job: raiders, javelin throwers, sledgehammer men, shield walls, standard bearers who rally their troops, ladder bearers who climb your walls, battering ram crews, armored warlords and their leader, Kara Arslan.\n\u2022 Special arrows: fire, ice and bomb. When your focus is full: slow motion and a triple volley.\n\u2022 Castle traps: the pitch cauldron, powder kegs, a log trap, a beehive and a gong that repairs the gate.\n\u2022 Shoot a power-up card between waves. Unlock 5 bows and 5 arrows as you advance. The wind pushes your arrows aside.\n\u2022 A real bow: hold it in either hand and feel the tension in the controller as you draw.\n\u2022 Trial Arena: every special arrow, trap and siege enemy at once.\n\u2022 Played standing in place, no walking; snap turn. Single player, no internet needed. English and Turkish.", "short_description": "You are the lone archer on the ramparts. Draw your bow with a Turkish thumb draw and stop the army marching on your gate! Shatter shield walls with fire arrows, topple the ladders thrown against your walls, break the battering ram and pour the pitch cauldron. Read the wind, shoot a power-up card between waves and choose your bow and arrows. At the end of an 11-level campaign, Kara Arslan awaits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/kalemuhafzvrcastleguardian/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "DorukTech", "support_website_url": null, "website_url": "https://www.facebook.com/doruktechvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336697626196411"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2769535973440697"}]}, "baseline_offer": {"id": "2769535973440697"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791300600, "status": "PUBLISHED", "id": "2769535973440697"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1346759611856879", "version": "1.1.2"}, "id": "1603301604614930", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1336697619529745", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1346759611856879"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1603301604614930"}]}, "change_log": "\"1.1.2 \u2014 Kampanya Ku\u015fatmas\u0131 / Campaign Siege\\nTR: 14 b\u00f6l\u00fcm ve Deneme Sahas\u0131. Eski b\u00f6l\u00fcmlere kule ok\u00e7ular\u0131, manc\u0131n\u0131k bataryalar\u0131 ve farkl\u0131 final liderleri eklendi. Kule yayl\u0131mlar\u0131 ve devam eden yanma art\u0131k daha belirgin. Manc\u0131n\u0131klar\u0131n \u00e7evre nesneleriyle \u00e7ak\u0131\u015fan konumlar\u0131 d\u00fczeltildi. \u00d6zel oklar dalga sonunda yenilenmez; her iki kafadan isabet bir \u00f6zel ok kazand\u0131r\u0131r.\\nEN: 14 chapters and the Trial Arena. Tower archers, catapult batteries and distinct final leaders now appear throughout the campaign. Clearer tower volleys and visible ongoing burning. Fixed catapult placement around scenery. Special arrows do not refill between waves; every two headshots reward one special arrow.\"", "created_date": 1791734530, "id": "1346759611856879", "version": "1.1.2", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1336697619529745", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1346759611856879"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes":
cale": "en_US", "screenshots": [{"file_name": "1.png", "id": "702303288679584", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035430_702303292012917_5426113279519549706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54sYbwnmj2sQ7kNvwF4uGVL&_nc_oc=Adpqi9MRmz3X7iOA9vlJSGuGfmJQTese2yBnOFYq38EmTecVYsem-5CqsLEF3HT025I&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FfRb_iEZoq6OUSLISb0rX3bw79hjju5gYZrmErlr38w&oe=6A22F173"}, {"file_name": "3.png", "id": "401166389011293", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75195906_401166392344626_529102331902465248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdlXBEHYI4kQ7kNvwGS_sRH&_nc_oc=AdoggPFyiES-og_D2gCVizmBhLcUwojsNd-5RhSkfX6vqC-3J53K3E4W5rdnJKIN72w&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A6HxPw3ByPFaeir_Et4SsRCUO4RWQWsjFgSDG-vB7FQ&oe=6A22CCBA"}, {"file_name": "2.png", "id": "751444239669178", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031478_751444243002511_4704187049000736001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7CgCIjCyhkQ7kNvwHQBOSq&_nc_oc=AdojLamYXTqL2NwGj8OZz5gtaO9PWdHWo7ynZtBWHXRXJnwi6CYEFlpzdJrsqQZMrYk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91t_d0WXnMhb7tkINkq1USyVlqPYS9t_8EEmPP_yvucg&oe=6A22EEE2"}, {"file_name": "5.png", "id": "345190021689752", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982514_345190025023085_6623884767608765634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EH24R3U5xIQ7kNvwFm3UWl&_nc_oc=AdqmiJhBZh5TesESndwfaxquH4Vu6ClXptLCahzopcMo_nIMBBwMb85K1ATJ2yweLSM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MOkQyRhKtszrBhpk_D0R02pA_NejNZqKjaEZ6aTqTUw&oe=6A22E168"}, {"file_name": "4.png", "id": "361574336572935", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75485578_361574339906268_3314483090300090112_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8y6Bp5clXdcQ7kNvwEl8qqK&_nc_oc=AdrbGKuGcEQ49NUwerq_OCC8xCSD7z9lNxBupioiuYXf0TYMfd-WewvXiUNF5pDb7EQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-t_Rta_GeUHnNHXoHE4XYeVpox0FQqhQTM6Z7BFZxl9Q&oe=6A22E31D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OMA War", "keywords": [], "long_description": "\ud83c\udfae Welcome to OMA WAR! \ud83c\udfae Exciting VR Adventures Await!\nEpic Battles: Engage in heart-pounding battles against formidable foes as you navigate through visually stunning environments.\n\nGet ready to experience the thrill of your virtual life in OMA War.\n\n \ud83c\udfae Kill it your way: 1st-person combat with a variety of weapons and minions who can serve as both allies and enemies\n\n\ud83c\udfaeImmersive Storyline: Dive into a captivating storyline that will keep you on the edge of your seat, unveiling secrets and mysteries as you progress.\n\n\ud83c\udfaeCutting-Edge VR Technology: Experience gaming like never before with state-of-the-art virtual reality technology, putting you right in the center of the action.\n\nDEMO VERSION AVAILABLE : https://www.meta.com/en-gb/experiences/6892512294198801/\n\n\nAnd follow us on: \n- Facebook: https://www.facebook.com/OMAwarVR\n- X: https://twitter.com/oma_war_vr\n- YouTube: https://www.youtube.com/@OMAWARVRGaming\n- TikTok: https://www.tiktok.com/@oma_war_vr ", "short_description": "\ud83c\udfae Welcome to \"OMA War\" an intensive virtual reality action game that will test your reflexes and strategic thinking to the limit. \n\nStep into the immersive world of \"OMA War\" a ground breaking virtual reality game that promises to redefine the gaming experience. Join us on this thrilling adventure filled with intense battles, stunning landscapes, and challenges that will test your skills to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://venus-games.com/privacy-policy", "developer_terms_of_service_url": "https://venus-games.com/terms-of-use", "publisher_name": "Venus Games", "support_we
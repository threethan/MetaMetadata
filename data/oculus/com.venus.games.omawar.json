cale": "en_US", "screenshots": [{"file_name": "1.png", "id": "702303288679584", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035430_702303292012917_5426113279519549706_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktohHtqUqDsQ7kNvwHeiYUF&_nc_oc=Adr3QJtlFwpW0LwsU5Sei-SZiH0udbWnC7EpzdkqK3_sPH4c08qEjcx8dYRM8JBL6XY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IFJpVUaCbUNiphw9cwer81LmpfmmzsVp7-_ASF2VblQ&oe=6A11CDF3"}, {"file_name": "3.png", "id": "401166389011293", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75195906_401166392344626_529102331902465248_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ae77E0fkJgQ7kNvwEjt6Z0&_nc_oc=Adozb2wHAz2IWv7bSSJlNgz3edZylG7jcX2XNr_nxa5dLv1q0c-IwSYy6szlWGizCio&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57Jrqbj-s7OOclXkZYMTqAmxHUESnmRGepkhtBiiIbaw&oe=6A11A93A"}, {"file_name": "2.png", "id": "751444239669178", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031478_751444243002511_4704187049000736001_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u44WF7iavygQ7kNvwGSjbzP&_nc_oc=Adps0EdG5nxGeHSIMUjYEPxBiDs1v67Ab6TbK39xmj0iVvOw-oO0xvkY70A82cr06Pc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sMQqcskurvU9DE15yPZtPG12q3gLRgaODw86YXNV_mA&oe=6A11CB62"}, {"file_name": "5.png", "id": "345190021689752", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982514_345190025023085_6623884767608765634_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFxfyVWRjNwQ7kNvwGQ-H_G&_nc_oc=AdpomKlr-2Wm6hmLzgInUTfFUWQofcQLqTgSMjSXWpjCabCSq11byoy5OgjiYP06R_g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XmENI8VU5mwpD9FSRC811YMsq7kP7ipn6naZ7-yigjQ&oe=6A11BDE8"}, {"file_name": "4.png", "id": "361574336572935", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75485578_361574339906268_3314483090300090112_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6mWd-WvSesQ7kNvwGgJT7R&_nc_oc=AdqBGLDcEIpSONzvgjTUEA8s60jdBHZYlC5RWVMCwipMRQb1J09JJ4XAi3lhwm_nzU0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pJSBOaXwxwRE3A9GGeOdvgmg708He4SEb2r-90erIjw&oe=6A11BF9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OMA War", "keywords": [], "long_description": "\ud83c\udfae Welcome to OMA WAR! \ud83c\udfae Exciting VR Adventures Await!\nEpic Battles: Engage in heart-pounding battles against formidable foes as you navigate through visually stunning environments.\n\nGet ready to experience the thrill of your virtual life in OMA War.\n\n \ud83c\udfae Kill it your way: 1st-person combat with a variety of weapons and minions who can serve as both allies and enemies\n\n\ud83c\udfaeImmersive Storyline: Dive into a captivating storyline that will keep you on the edge of your seat, unveiling secrets and mysteries as you progress.\n\n\ud83c\udfaeCutting-Edge VR Technology: Experience gaming like never before with state-of-the-art virtual reality technology, putting you right in the center of the action.\n\nDEMO VERSION AVAILABLE : https://www.meta.com/en-gb/experiences/6892512294198801/\n\n\nAnd follow us on: \n- Facebook: https://www.facebook.com/OMAwarVR\n- X: https://twitter.com/oma_war_vr\n- YouTube: https://www.youtube.com/@OMAWARVRGaming\n- TikTok: https://www.tiktok.com/@oma_war_vr ", "short_description": "\ud83c\udfae Welcome to \"OMA War\" an intensive virtual reality action game that will test your reflexes and strategic thinking to the limit. \n\nStep into the immersive world of \"OMA War\" a ground breaking virtual reality game that promises to redefine the gaming experience. Join us on this thrilling adventure filled with intense battles, stunning landscapes, and challenges that will test your skills to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://venus-games.com/privacy-policy", "developer_terms_of_service_url": "https://venus-games.com/terms-of-use", "publisher_name": "Venus Games", "support_we
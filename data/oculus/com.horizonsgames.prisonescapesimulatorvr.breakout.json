46129541_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiCp-L4hXIMQ7kNvwEjD0Ex&_nc_oc=Adpjpy3cClJxtpHQ_yv0kyLg1in-LGYORZh6fSlUFgZVDJwm30VaI2yHea39b9k43MI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCvWfL33raIvVNC7-QN-YSMzQ0nHHKe6nyn1fA-vy1jA&oe=6A84668C"}, {"file_name": "Screenshot_2.png", "id": "2035516100561723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824611_2035516103895056_6431816728383820057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnWSl6oshmAQ7kNvwG_5UG3&_nc_oc=Adpzq1x1zHcCtO5Ui_0x6piHtRXIU47fSqG8aNFP6lotjETMAFIwxfEtfVE9oC1WtrI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVO5wr8BDux_pu3ZV1ZRmV8kFhbbpwU9cAaV6nrgx9mw&oe=6A8439C7"}, {"file_name": "Screenshot_5.png", "id": "916038124109355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819323_916038130776021_3583095485596991264_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ-YGMiY9DcQ7kNvwFE2Yk7&_nc_oc=AdqEPqWDDbU0WUyNaR475cxEC7yyeaNG9JJUhZavzLf5hm13s-XnlSyNN9UmoWAZDpU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjMgrFmtkn5_2Dd4dR4fukj_mxxJYL7g6Y999ZFa5Gdw&oe=6A845295"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Prison Escape Simulator VR: Breakout", "keywords": ["PrisonEscapeSimulator", "Jailbreak", "Breakout", "EscapeGame", "PrisonSimulator"], "long_description": "Prison Escape Simulator VR: Breakout puts you inside a high-security prison where freedom is earned, not given. Plan your escape, adapt to changing situations, and use every tool available to break out.\nExplore detailed prison environments, interact with objects using realistic VR mechanics, and choose your own path to freedom. Sneak through guarded corridors, solve escape puzzles, distract guards, and decide whether to use stealth or force. Every action matters, and every mistake has consequences.\nThis immersive VR simulator gives you full control over how you escape. Observe guard patterns, collect items, craft tools, and time your moves carefully. No two escapes are the same, and multiple strategies are always possible.\nKey Features\nImmersive first-person VR prison experience\n\n\nMultiple escape approaches: stealth, strategy, or action\n\n\nInteractive environments and realistic object handling\n\n\nChallenging puzzles and dynamic guard behavior\n\n\nDesigned for smooth and comfortable VR gameplay\n\n\nWhether you prefer careful planning or bold action, Prison Escape Simulator VR: Breakout delivers a tense and rewarding escape experience built from the ground up for virtual reality.\nCan you outsmart the system and make it out?", "short_description": "Plan, sneak, fight, and escape prison in this immersive VR breakout simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonsgames-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "HorizonsGames", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonsgames-com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26047657554839132"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2809410319415118"}, {"status": "PUBLISHED", "id": "1800
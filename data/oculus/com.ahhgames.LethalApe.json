c_ohc=4KxtTI-cHL8Q7kNvwGNQNNM&_nc_oc=AdoCyht3btf6eFl0QPaUgB154L2Ap0p3F1pwfUm-0hIcYkYJ8FAvTUE9MJmfiDiQDUY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTGSrnjdP6B8ZhwdThwD-kWs4OlgiwhoilUE4192uxrA&oe=6AFC5EA9"}, {"file_name": "SampleScene_Custom..._09.06.2026_08-55-55.png", "id": "2409620316198630", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499310651_2409620319531963_6046684402385634987_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J3IUE7x_9cQ7kNvwGuaGl-&_nc_oc=AdqD4f9521GvzL_4xK48FPxY0IqudCl2X3wKDlO4tvo4uM7z7ASpPFCv1IlOVxmLiN8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJhTup1ubgddCPjLWo00Xi30Y6yAQgYpQ1WA7XSgS2-g&oe=6AFC69E7"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-48-42.png", "id": "1036595025365206", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310667_1036595028698539_8641733737473493796_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljeoYqzDIPoQ7kNvwGG_WuA&_nc_oc=AdrFRiuQa7GPKESUcI2KOaB-y0vRRc8v_Km1iNsFGrYL_jlQUXHiWmgEQl22cuQIN_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6hn8nr-zWyqrXekSjcbnCQJHX3x8k6FbvOsrg9hzBxA&oe=6AFC73A6"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-48-27.png", "id": "1286455573475278", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507828918_1286455580141944_5855412513946132712_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9gdDljZijEQ7kNvwGQcgGq&_nc_oc=AdoFd2n9TQxI1-hoRC1Q8GSqUQ9tWkFnL6cnjdF5HMVPf7jhMo83Mgim_qT3f7cyp-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDZbZaOQxdRgk6NdtflHXb7OAf-oMEoNuwE0NO2bbr5Q&oe=6AFC75C2"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-47-51.png", "id": "1304236951791100", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314660_1304236955124433_5498190661790169790_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHjwmebn2WMQ7kNvwGMiXIO&_nc_oc=Ado9mOofgPtCTkym7p8U7H9kVywp9TFCVON3B7e3KXpQF7Ko32Ioa-BYDmTjBzoQWqU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVkRQKrZwQIC1BvgiOEe3lodcQX3UBVIWGud8bEEcqLA&oe=6AFC835A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape 2 OG", "keywords": ["Lethal", "Ape", "Monkey", "Horror", "Baboon"], "long_description": "Lethal Ape 2 OG is a fast-moving multiplayer experience built around chaotic encounters, quick decision-making, and unpredictable player interaction. Players explore compact arenas, use a variety of tools, and react to situations created by others in the match. One moment you may be working with another player, and the next you may need to change your plan completely as the round shifts into competition.\n\nThe game is designed to reward awareness, timing, and smart risks. Every match can play out differently depending on how players move, cooperate, betray, hide, chase, or set up traps. Short-term alliances can form naturally, but the fast pace and changing environment keep everyone on edge. This creates a mix of light strategy and spontaneous chaos without making the gameplay feel too complicated.\n\nWhether you are teaming up, escaping danger, creating traps, or reacting to sudden changes in the arena, Lethal Ape keeps the action lively and easy to jump into. It is a simple but engaging multiplayer game focused on social interaction, fast reactions, and memorable moments that happen naturally during each round.", "short_description": "Lethal Ape 2 OG is a fast-paced multiplayer game where teamwork can turn into chaos at any moment. Move through compact arenas, use different tools, form quick alliances, set traps, and adapt as every round becomes unpredictable. With social gameplay, quick decisions, and constantly changing situations, every match creates its own memorable moments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalape2ogpolicy", "developer_terms_of_service_url": null, "publisher_name": "ahhgames", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape2ogpolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1015893957641606"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1542067764052555"}, {"status": "PUBLISHED", "id": "2590075388114950"}]}, "baseline_offer": {"id": "1542067764052555"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783347120, "status": "PUBLISHED", "id": "1542067764052555"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1027889606442041", "version": "12"}, "id": "980323321282146", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1012000921364243", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1027889606442041"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "980323321282146"}]}, "change_log": null, "created_date": 1782431199, "id": "1027889606442041"
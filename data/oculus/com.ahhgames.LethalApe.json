CWOIXSkoLOWkRzm8VpQ_cwYIpH_l6u7gfQ&oe=6AEB3B29"}, {"file_name": "SampleScene_Custom..._09.06.2026_08-55-55.png", "id": "2409620316198630", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310651_2409620319531963_6046684402385634987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svKpMPMNUj4Q7kNvwFhcTk0&_nc_oc=Adooj_ii6U0xif9Xz01eOWX-uyZGH2TqTRqTeWtisf0sVUKjJJoPAsMitt72-O8UBmE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx1xhUo1WdEdPzSHNSalwypTL8B4pl6E4r8VLWpoFlJA&oe=6AEB4667"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-48-42.png", "id": "1036595025365206", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310667_1036595028698539_8641733737473493796_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMPf4yYZeUoQ7kNvwFVwaTM&_nc_oc=AdraIMImlQDIs4PBmfBfXb6T4iI4R9qynsyyeDroIVBoYGMg2yXIObSpBd9w9J0vPkE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT024czQB2eR3nSS1TXdT4p8P3EosBMcptwlny88J9bsw&oe=6AEB5026"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-48-27.png", "id": "1286455573475278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507828918_1286455580141944_5855412513946132712_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idql3te6prkQ7kNvwFgenjU&_nc_oc=Ado3DGLo2J8IvX8YkiMPdUYE9SrlJraBVmih06U1ifEHTSN4crM3TUZb33n4J6RV76w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzuYOd19BSG2aSjLyxx4Sx7xH8I7AL7WrwRGf3YI5GIQ&oe=6AEB5242"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-47-51.png", "id": "1304236951791100", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314660_1304236955124433_5498190661790169790_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lufphStN0g8Q7kNvwECOgcu&_nc_oc=Adq2YY-aIaLXLYl627CjKYWurw26vd7akQOfWQ36_emXHBDAzom9TaJModoY3vDKdp8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9TeyJefqerFhDafwnJNMAWcji7yd49E_Sp4MZs9CUow&oe=6AEB5FDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape 2 OG", "keywords": ["Lethal", "Ape", "Monkey", "Horror", "Baboon"], "long_description": "Lethal Ape 2 OG is a fast-moving multiplayer experience built around chaotic encounters, quick decision-making, and unpredictable player interaction. Players explore compact arenas, use a variety of tools, and react to situations created by others in the match. One moment you may be working with another player, and the next you may need to change your plan completely as the round shifts into competition.\n\nThe game is designed to reward awareness, timing, and smart risks. Every match can play out differently depending on how players move, cooperate, betray, hide, chase, or set up traps. Short-term alliances can form naturally, but the fast pace and changing environment keep everyone on edge. This creates a mix of light strategy and spontaneous chaos without making the gameplay feel too complicated.\n\nWhether you are teaming up, escaping danger, creating traps, or reacting to sudden changes in the arena, Lethal Ape keeps the action lively and easy to jump into. It is a simple but engaging multiplayer game focused on social interaction, fast reactions, and memorable moments that happen naturally during each round.", "short_description": "Lethal Ape 2 OG is a fast-paced multiplayer game where teamwork can turn into chaos at any moment. Move through compact arenas, use different tools, form quick alliances, set traps, and adapt as every round becomes unpredictable. With social gameplay, quick decisions, and constantly changing situations, every match creates its own memorable moments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalape2ogpolicy", "developer_terms_of_service_url": null, "publisher_name": "ahhgames", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape2ogpolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id"
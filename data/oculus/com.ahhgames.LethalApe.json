DFNBSNEW36rl0KZyeLQjTFfkJW0bEsbEWA&oe=6AF20AE9"}, {"file_name": "SampleScene_Custom..._09.06.2026_08-55-55.png", "id": "2409620316198630", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310651_2409620319531963_6046684402385634987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHDT6qCPmmoQ7kNvwFUrbmM&_nc_oc=Adr2L-A444dkSDSkQOowWB7DEyo-fQFXiqSEwFiNkMqZCK0luAPEWG9nNmbruIt77RY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXAqBJ1IkWF8JV1o6mJ1EW9OpJQhBSo59PUw27rne3WQ&oe=6AF1DDE7"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-48-42.png", "id": "1036595025365206", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310667_1036595028698539_8641733737473493796_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ahgDoatYsUQ7kNvwE2yBJJ&_nc_oc=Adr0WfVsmAEeWKNkoQZ9X7AqIAnG66Q0adAAM-8yaH8Y8ycz9fTuHXUJn-1O4JJJ6RM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU_KGX7d99zM-fI3sfcmxxF6nsMB3MDabL3CzoLzZeBg&oe=6AF1E7A6"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-48-27.png", "id": "1286455573475278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507828918_1286455580141944_5855412513946132712_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWp4O4Oqvx0Q7kNvwHIH6fR&_nc_oc=AdpZwhuiuj7dJyX8iTqTleV_BD2g4CtrmT13V0x_c052nuwvnBiCMErJkbatHxKhKMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN9ZUP-1QPyfgHVrMyhyOsSWA7b8JldkPRHUDyBQy2dg&oe=6AF1E9C2"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-47-51.png", "id": "1304236951791100", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314660_1304236955124433_5498190661790169790_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhNehWy1tXkQ7kNvwHb57rD&_nc_oc=Adr09XwvHC4vQDhRQHrVloNO9p4Ue5gFCifHEQa5c11jeT0_wtO3N0-_9nwltifPpI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-Yuq0vPvXhBnXB-IR_6O--12Y0obOtktIpy-6TSSuTA&oe=6AF1F75A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape 2 OG", "keywords": ["Lethal", "Ape", "Monkey", "Horror", "Baboon"], "long_description": "Lethal Ape 2 OG is a fast-moving multiplayer experience built around chaotic encounters, quick decision-making, and unpredictable player interaction. Players explore compact arenas, use a variety of tools, and react to situations created by others in the match. One moment you may be working with another player, and the next you may need to change your plan completely as the round shifts into competition.\n\nThe game is designed to reward awareness, timing, and smart risks. Every match can play out differently depending on how players move, cooperate, betray, hide, chase, or set up traps. Short-term alliances can form naturally, but the fast pace and changing environment keep everyone on edge. This creates a mix of light strategy and spontaneous chaos without making the gameplay feel too complicated.\n\nWhether you are teaming up, escaping danger, creating traps, or reacting to sudden changes in the arena, Lethal Ape keeps the action lively and easy to jump into. It is a simple but engaging multiplayer game focused on social interaction, fast reactions, and memorable moments that happen naturally during each round.", "short_description": "Lethal Ape 2 OG is a fast-paced multiplayer game where teamwork can turn into chaos at any moment. Move through compact arenas, use different tools, form quick alliances, set traps, and adapt as every round becomes unpredictable. With social gameplay, quick decisions, and constantly changing situations, every match creates its own memorable moments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalape2ogpolicy", "developer_terms_of_service_url": null, "publisher_name": "ahhgames", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape2ogpolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id"
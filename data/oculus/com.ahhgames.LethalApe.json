x4MtQ9M_0zkpwYPtXUJYewDwJXQJmf0_Ug&oe=6AEF2FA9"}, {"file_name": "SampleScene_Custom..._09.06.2026_08-55-55.png", "id": "2409620316198630", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310651_2409620319531963_6046684402385634987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOz3RIxaY5IQ7kNvwELk10c&_nc_oc=Adrwc1W5Rn6tSD40mtaPRs1oPOFyHukNVf41sknEgl9tr92jXiCbFfAej5voxERapqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYz9WVNzAMJbDq5I7R5Wh4oZ-Qt1Og995VekTUZNRcqg&oe=6AEF3AE7"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-48-42.png", "id": "1036595025365206", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310667_1036595028698539_8641733737473493796_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLZvSykb_eYQ7kNvwHAiTLj&_nc_oc=AdrgIpvHhhj80CRPTPGFYs6IJ_eZ-wPfT_UWIhqyhQ_lIYlsY7_57I8SY6G-JJWjyRQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFvMtlXR8gO-rtCsymT_KbQOikdHGanki4Ls_lqR6l3A&oe=6AEF44A6"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-48-27.png", "id": "1286455573475278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507828918_1286455580141944_5855412513946132712_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWp4O4Oqvx0Q7kNvwFjhw3A&_nc_oc=AdoMJ6eryhGF3NkbYUDcezXsjD7fvwdyZ5RE1SgJwYW66jEJtKcAJF2ej_wwXZBkt_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9wwCwnXJVoAk0BOBmkNKPECyPe_ZH1QTvalEqx0kzwQ&oe=6AEF46C2"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-47-51.png", "id": "1304236951791100", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314660_1304236955124433_5498190661790169790_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhNehWy1tXkQ7kNvwEDah-E&_nc_oc=AdpmVoQPUSdvwV6bXppfvNt6xS9O2vWROgAJgepkRGSZCj1eYXT61wTI3AzRqUlm6xM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR70aPN_dM2s7gRbTBOXTwtHPAknoCmWq56nON74nwYyg&oe=6AEF545A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape 2 OG", "keywords": ["Lethal", "Ape", "Monkey", "Horror", "Baboon"], "long_description": "Lethal Ape 2 OG is a fast-moving multiplayer experience built around chaotic encounters, quick decision-making, and unpredictable player interaction. Players explore compact arenas, use a variety of tools, and react to situations created by others in the match. One moment you may be working with another player, and the next you may need to change your plan completely as the round shifts into competition.\n\nThe game is designed to reward awareness, timing, and smart risks. Every match can play out differently depending on how players move, cooperate, betray, hide, chase, or set up traps. Short-term alliances can form naturally, but the fast pace and changing environment keep everyone on edge. This creates a mix of light strategy and spontaneous chaos without making the gameplay feel too complicated.\n\nWhether you are teaming up, escaping danger, creating traps, or reacting to sudden changes in the arena, Lethal Ape keeps the action lively and easy to jump into. It is a simple but engaging multiplayer game focused on social interaction, fast reactions, and memorable moments that happen naturally during each round.", "short_description": "Lethal Ape 2 OG is a fast-paced multiplayer game where teamwork can turn into chaos at any moment. Move through compact arenas, use different tools, form quick alliances, set traps, and adapt as every round becomes unpredictable. With social gameplay, quick decisions, and constantly changing situations, every match creates its own memorable moments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalape2ogpolicy", "developer_terms_of_service_url": null, "publisher_name": "ahhgames", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape2ogpolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id"
pqdlB1Bgx1J16M0AAXeb8Xy-yp6cX3wp-w&oe=6AEC8CA9"}, {"file_name": "SampleScene_Custom..._09.06.2026_08-55-55.png", "id": "2409620316198630", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499310651_2409620319531963_6046684402385634987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOz3RIxaY5IQ7kNvwGpJSU-&_nc_oc=AdrLDsL7GhiQ8wMWLEKhZLDDh0iI0iqwrsS9lNxGopog3Tb6QdgCi5uNWw6EYeVTL74&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJXhILkDpbt70QOVaz8ADh_1b9Ezm0AgSLsNukr23fcg&oe=6AEC97E7"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-48-42.png", "id": "1036595025365206", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499310667_1036595028698539_8641733737473493796_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMPf4yYZeUoQ7kNvwGj0F1P&_nc_oc=AdqFnMnS6hFZEIv1Dwc0BijJ81NlnNjllZs0ZoUC-GsO_e0iyyf_1051U8q-QnvDMrA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR11uGr4gutX64pvaGCT1uW_DygV47heRXokKlSRQFnDg&oe=6AECA1A6"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-48-27.png", "id": "1286455573475278", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/507828918_1286455580141944_5855412513946132712_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idql3te6prkQ7kNvwFjS37H&_nc_oc=Adpx6lVws8UQfDMPZCzyxkADO4zeEDeNs8dtIsr2PHmoVC_uJeVUX80b34PUU9jZBDg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4onLRY5J97dTJqN9AxxD4Bv5yj1tN_ygwvnNxpaEN8w&oe=6AECA3C2"}, {"file_name": "SampleScene_Custom..._11.06.2026_08-47-51.png", "id": "1304236951791100", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314660_1304236955124433_5498190661790169790_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lufphStN0g8Q7kNvwHs8iUi&_nc_oc=Adr94cJc3NHpDatEPjle-QrD888EWuEe1yhDA5Q0p5-wCwtWkIeICYXL_F1G0MPgc18&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStIpBX1JqMFDgTj-ziG-UMUzrSladNKeaGvwpEU3306w&oe=6AECB15A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape 2 OG", "keywords": ["Lethal", "Ape", "Monkey", "Horror", "Baboon"], "long_description": "Lethal Ape 2 OG is a fast-moving multiplayer experience built around chaotic encounters, quick decision-making, and unpredictable player interaction. Players explore compact arenas, use a variety of tools, and react to situations created by others in the match. One moment you may be working with another player, and the next you may need to change your plan completely as the round shifts into competition.\n\nThe game is designed to reward awareness, timing, and smart risks. Every match can play out differently depending on how players move, cooperate, betray, hide, chase, or set up traps. Short-term alliances can form naturally, but the fast pace and changing environment keep everyone on edge. This creates a mix of light strategy and spontaneous chaos without making the gameplay feel too complicated.\n\nWhether you are teaming up, escaping danger, creating traps, or reacting to sudden changes in the arena, Lethal Ape keeps the action lively and easy to jump into. It is a simple but engaging multiplayer game focused on social interaction, fast reactions, and memorable moments that happen naturally during each round.", "short_description": "Lethal Ape 2 OG is a fast-paced multiplayer game where teamwork can turn into chaos at any moment. Move through compact arenas, use different tools, form quick alliances, set traps, and adapt as every round becomes unpredictable. With social gameplay, quick decisions, and constantly changing situations, every match creates its own memorable moments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lethalape2ogpolicy", "developer_terms_of_service_url": null, "publisher_name": "ahhgames", "support_website_url": null, "website_url": "https://sites.google.com/view/lethalape2ogpolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id"
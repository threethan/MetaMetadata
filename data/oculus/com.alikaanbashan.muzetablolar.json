_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZtkosRst4IQ7kNvwFdqngd&_nc_oc=AdohyeJEcrh5ntm2YIKxyp1bKQAXVvEDMosrQN9sm-d4ich6sNyqBnhferDKOvfgTdA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXMtWRBgM04gTy6HaRBr47dV8wL30t12645KQ5LV0XZg&oe=6AE2024D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kapak_yatay_1440.png", "id": "900935955631245", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823270_900935958964578_6269975705844571005_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQClwp_Ze98Q7kNvwE3OI4T&_nc_oc=Adr6T8m7RG1jYFdyVCZRLx0YLhIvjrd3AELUaTuUCOQIWqwul5L3B44ORbiUbHY3s8E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_0vFcrG59n5CPP8O3K-q2cNXxQ-Gkb4nL8uHrsMVrDA&oe=6AE206D3"}, "display_name": "Virtual Art Gallery: VR Exhibition", "keywords": ["artgallery", "museumtour", "virtualmuseum", "gallery", "art"], "long_description": "Virtual Art Gallery: VR Exhibition lets you experience a relaxing, museum-style art gallery in VR. Browse famous paintings with simple right-thumbstick controls, view an information panel for each artwork, and enjoy optional voice narration that updates automatically as you switch pieces.\n\nDesigned for calm exploration, this app has no combat, no objectives, and no pressure\u2014just art, atmosphere, and discovery. Perfect for quick relaxing sessions, art lovers, and anyone who wants a stress-free virtual gallery tour.", "short_description": "Explore famous artworks in a calm VR exhibition. Swipe through paintings, read info panels, and listen to narration\u2014no timers, no stress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/7_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id":
821696_977171928157848_3069831251807899375_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPNj5kmG5mgQ7kNvwGsd7zu&_nc_oc=Adp38pCneKJGr56iakjGdzelwP-5-9V_woMRC2JzineyWurjdNGFIVUPh9klreWCZJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmMPELaJMksLAP2bWdXpcuPBDWMdq9dO8_DkKxEUwPMw&oe=6B0EFF5E"}, {"file_name": "Screenshot_4.png", "id": "1681925022778446", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1681925026111779_4053949340069332498_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MviqDS3BT58Q7kNvwGiKSuy&_nc_oc=AdocbiVrdB-pV6-0mLJuu82mWiffElqGFkQOHAAMjYlvpOBLSwT60WDPxESEjpt7-6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW09V8aXPLGQn8UCJDBpoIIAT7CUQCjREHmmNLcYFEphA&oe=6B0F0D8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kapak_yatay_1440.png", "id": "900935955631245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823270_900935958964578_6269975705844571005_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJKvH4y_rWsQ7kNvwFFSx37&_nc_oc=AdpOwHhCzTv8YWlnssS7VrpQd07EYwDYTQpq--u4LaFtRAkdSMlxoxERpiz3uQL6uV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVGowEzs6A7als7eIEus91X8gM8gF2b3lrDnXDmJuUQEg&oe=6B0F1213"}, "display_name": "Virtual Art Gallery: VR Exhibition", "keywords": ["artgallery", "museumtour", "virtualmuseum", "gallery", "art"], "long_description": "Virtual Art Gallery: VR Exhibition lets you experience a relaxing, museum-style art gallery in VR. Browse famous paintings with simple right-thumbstick controls, view an information panel for each artwork, and enjoy optional voice narration that updates automatically as you switch pieces.\n\nDesigned for calm exploration, this app has no combat, no objectives, and no pressure\u2014just art, atmosphere, and discovery. Perfect for quick relaxing sessions, art lovers, and anyone who wants a stress-free virtual gallery tour.", "short_description": "Explore famous artworks in a calm VR exhibition. Swipe through paintings, read info panels, and listen to narration\u2014no timers, no stress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/7_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24113706484993911"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1444489837871857"}, {"status": "PUBLISHED", "id": "27644017351959724"}, {"status": "PUBLISHED", "id": "2566242343795525"}, {"status": "PUBLISHED", "id": "1314039867312578"}, {"status": "PUBLISHED", "id": "1345250937426001"}, {"status": "PUBLISHED", "id": "898790892733616"}]}, "baseline_offer": {"id": "1345250937426001"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795118400, "status": "PUBLISHED", "id": "1444489837871857"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24167868896244336", "version": "0.3.0"}, "id": "1449863066480428", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary"
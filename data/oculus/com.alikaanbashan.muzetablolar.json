821696_977171928157848_3069831251807899375_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLXmRW6NmJ8Q7kNvwHvl1vF&_nc_oc=Adqv-EVuELTkbDgl_ZadvIBcrIJsgXmeXc2BblRiN-G-gXtlMnCjcVsKxygpKcSgR9A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTA-B7HBuHIvF8yyzqKBkbQzJWGJbjHmedbCW7regmWFw&oe=6B0B431E"}, {"file_name": "Screenshot_4.png", "id": "1681925022778446", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823341_1681925026111779_4053949340069332498_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2BW-ozi_TYQ7kNvwHYUKT1&_nc_oc=AdqTGUzGcs9EyUM5wnP221gupJ9PvD6iZsJB58umLGmYwvGylQOk0SK1WF8_EB7kVyw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTksDQuZaPWMHwkq_lr0J56DC3B8hhLClIpZTU8_NZ-jQ&oe=6B0B190D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kapak_yatay_1440.png", "id": "900935955631245", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823270_900935958964578_6269975705844571005_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVOgs4Bf3G4Q7kNvwGRxvsg&_nc_oc=AdoIdcSA9hy1uMKhhatHlq-w3bci-X8XZda21okUo2V9Sieu2V-20MWFKNHPbiBXuDw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQROc4CM6XYaLEQ_tiaOve0qKKlj5GXIqgjJhf2V1Ztobw&oe=6B0B1D93"}, "display_name": "Virtual Art Gallery: VR Exhibition", "keywords": ["artgallery", "museumtour", "virtualmuseum", "gallery", "art"], "long_description": "Virtual Art Gallery: VR Exhibition lets you experience a relaxing, museum-style art gallery in VR. Browse famous paintings with simple right-thumbstick controls, view an information panel for each artwork, and enjoy optional voice narration that updates automatically as you switch pieces.\n\nDesigned for calm exploration, this app has no combat, no objectives, and no pressure\u2014just art, atmosphere, and discovery. Perfect for quick relaxing sessions, art lovers, and anyone who wants a stress-free virtual ga
1681925022778446", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1681925026111779_4053949340069332498_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRt8ovdxXukQ7kNvwF3bqtw&_nc_oc=Ado6_AJxaGVhmTHHQEYVbXTWutLMAufrokEHKc4_XqoVK9o1rC1L79fLo4K-ffGPAAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFMAg26o5ib0FYYuHLYULtKzz8qM_ObgjJmmgTXvCEUg&oe=6AF1D44D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kapak_yatay_1440.png", "id": "900935955631245", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823270_900935958964578_6269975705844571005_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhSo5Pug7acQ7kNvwHqbqcG&_nc_oc=AdoCPczSsIaQUEw_WAFDjGatww2Fr8JrOuNHoQP7vHBU5uN4eRq9ekC5Va8Ja_Ze1Cs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0Sw-oJLJoskb7QZx2MRBkIiXgGvdgcpF49-E85m086Q&oe=6AF1D8D3"}, "display_name": "Virtual Art Gallery: VR Exhibition", "keywords": ["artgallery", "museumtour", "virtualmuseum", "gallery", "art"], "long_description": "Virtual Art Gallery: VR Exhibition lets you experience a relaxing, museum-style art gallery in VR. Browse famous paintings with simple right-thumbstick controls, view an information panel for each artwork, and enjoy optional voice narration that updates automatically as you switch pieces.\n\nDesigned for calm exploration, this app has no combat, no objectives, and no pressure\u2014just art, atmosphere, and discovery. Perfect for quick relaxing sessions, art lovers, and anyone who wants a stress-free virtual gallery tour.", "short_description": "Explore famous artworks in a calm VR exhibition. Swipe through paintings, read info panels, and listen to narration\u2014no timers, no stress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/7_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.co
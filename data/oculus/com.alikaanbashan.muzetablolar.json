om&_nc_ss=7f20f&oh=00_AQQBFsZSAite-tboMCx61n0vae7Uw35NQxD30QxSANm7_Q&oe=6AF5F2DE"}, {"file_name": "Screenshot_4.png", "id": "1681925022778446", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1681925026111779_4053949340069332498_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzw8M42LyrEQ7kNvwGgB9ZK&_nc_oc=Adrr8_HH7b3sp64ixofATyqaW2eVUSPmsreoUiBUk0R2sN2ZI_dzsLiI_bs4p2ZhdYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGZ5KBWt2P2wbDuFK6D3H_JYCTXYEqMFX_S9dL1W5TFQ&oe=6AF5C8CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kapak_yatay_1440.png", "id": "900935955631245", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823270_900935958964578_6269975705844571005_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJKwIuuV1ukQ7kNvwHXMbne&_nc_oc=AdpVN-X7dS09oYj2-eCSZbOsTFKhjbxm3sf4aEQFEQLs6wqbKkQpN9zEhRUwLkHkHj8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK3cbx91D3c-Jvck2orbanlexZoYGwnNs6ya0hW6HkTg&oe=6AF5CD53"}, "display_name": "Virtual Art Gallery: VR Exhibition", "keywords": ["artgallery", "museumtour", "virtualmuseum", "gallery", "art"], "long_description": "Virtual Art Gallery: VR Exhibition lets you experience a relaxing, museum-style art gallery in VR. Browse famous paintings with simple right-thumbstick controls, view an information panel for each artwork, and enjoy optional voice narration that updates automatically as you switch pieces.\n\nDesigned for calm exploration, this app has no combat, no objectives, and no pressure\u2014just art, atmosphere, and discovery. Perfect for quick relaxing sessions, art lovers, and anyone who wants a stress-free virtual gallery tour.", "short_description": "Explore famous artworks in a calm VR exhibition. Swipe through paintings, read info panels, and listen to narration\u2014no timers, no stress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/7_vr_privacy.txt", "developer_terms_of_servic
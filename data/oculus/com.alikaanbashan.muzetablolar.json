om&_nc_ss=7f20f&oh=00_AQQNDODBwommoHU3j2JAvUbST_bKfYYVJhdd-XCMxrr3jQ&oe=6AF895DE"}, {"file_name": "Screenshot_4.png", "id": "1681925022778446", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_1681925026111779_4053949340069332498_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzw8M42LyrEQ7kNvwHyLEqK&_nc_oc=Adp2f-PV8HqzFGMjgoAFxoTzpCsH8EZPnOwPVm-sxBAn0QY17Leb1zrUv63zu20AZR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA4Xkgc5LRcK0Dy_rj3cJbz6O_kZecIDzt9xc8F_wCZA&oe=6AF8A40D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kapak_yatay_1440.png", "id": "900935955631245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823270_900935958964578_6269975705844571005_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fihee2pbT1AQ7kNvwFnajGJ&_nc_oc=AdrcA2IWTdPdYrvhZnuu194NofliCj_QFZBbrEFwibYXyY7ZVNk-eitmRZCy8_hbTn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAW94uU3B6J09z_VGJZWXM4Ko1QHQQwSEcq8DCBlby3g&oe=6AF8A893"}, "display_name": "Virtual Art Gallery: VR Exhibition", "keywords": ["artgallery", "museumtour", "virtualmuseum", "gallery", "art"], "long_description": "Virtual Art Gallery: VR Exhibition lets you experience a relaxing, museum-style art gallery in VR. Browse famous paintings with simple right-thumbstick controls, view an information panel for each artwork, and enjoy optional voice narration that updates automatically as you switch pieces.\n\nDesigned for calm exploration, this app has no combat, no objectives, and no pressure\u2014just art, atmosphere, and discovery. Perfect for quick relaxing sessions, art lovers, and anyone who wants a stress-free virtual gallery tour.", "short_description": "Explore famous artworks in a calm VR exhibition. Swipe through paintings, read info panels, and listen to narration\u2014no timers, no stress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/7_vr_privacy.txt", "developer_terms_of_servic
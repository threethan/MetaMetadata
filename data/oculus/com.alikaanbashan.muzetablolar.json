_LTalIHXxsC-0rSf4adhFWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrc8EJjtL2NxrQ0AxxhqUU9WgnjAp1A233Dxcq8aAyjg&oe=6A6A09CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kapak_yatay_1440.png", "id": "900935955631245", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823270_900935958964578_6269975705844571005_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5pavKm4s0AQ7kNvwEmueBv&_nc_oc=AdokWIWGNRtwutSpnahzy_Ncn2bIBG181mtDH3sRYsMHsXKAXkeu_EGPrWrM232yuW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4sR7MeUPiydsWbXzhdQMngLL3ccl58j7cO5GS3TAJeQ&oe=6A6A0E53"}, "display_name": "Virtual Art Gallery: VR Exhibition", "keywords": ["artgallery", "museumtour", "virtualmuseum", "gallery", "art"], "long_description": "Virtual Art Gallery: VR Exhibition lets you experience a relaxing, museum-style art gallery in VR. Browse famous paintings with simple right-thumbstick controls, view an information panel for each artwork, and enjoy optional voice narration that updates automatically as you switch pieces.\n\nDesigned for calm exploration, this app has no combat, no objectives, and no pressure\u2014just art, atmosphere, and discovery. Perfect for quick relaxing sessions, art lovers, and anyone who wants a stress-free virtual gallery tour.", "short_description": "Explore famous artworks in a calm VR exhibition. Swipe through paintings, read info panels, and listen to narration\u2014no timers, no stress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/7_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type":
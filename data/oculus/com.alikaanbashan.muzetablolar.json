821696_977171928157848_3069831251807899375_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPNj5kmG5mgQ7kNvwFGypPL&_nc_oc=AdolrrUPpIzqx8XaY_bzEONusmmO_nWxANlO03usGM64WaxY7CTUepsLYcpoast-R4Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6VO-qjq6aNMGrL8Elwflz2z3dzsd6bsEacfjP6P0gsw&oe=6B1050DE"}, {"file_name": "Screenshot_4.png", "id": "1681925022778446", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1681925026111779_4053949340069332498_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MviqDS3BT58Q7kNvwEuTvn0&_nc_oc=AdrHSf6fuTYt8ezwbC4K00TCeC1mQ8gIVcruSRyPcUxwLxLAVOoXgZ5JqrMtBFSrbx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTHdtIrZOn1LZ9LI729Td4RGPMpdcRTqZdQXpqC5_U8w&oe=6B105F0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kapak_yatay_1440.png", "id": "900935955631245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823270_900935958964578_6269975705844571005_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JnHoSkq_TwQ7kNvwGcP1qL&_nc_oc=AdrPnPgTEoib88dBI5GkEkIscDFnm_V4ZH8VLF1kTjAco3VooRUqX-siqN7cojemGEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWsFmw_L1xWtqP8JDy-Go-sYV8sCk1I-LL59PjN-QV0kw&oe=6B106393"}, "display_name": "Virtual Art Gallery: VR Exhibition", "keywords": ["artgallery", "museumtour", "virtualmuseum", "gallery", "art"], "long_description": "Virtual Art Gallery: VR Exhibition lets you experience a relaxing, museum-style art gallery in VR. Browse famous paintings with simple right-thumbstick controls, view an information panel for each artwork, and enjoy optional voice narration that updates automatically as you switch pieces.\n\nDesigned for calm exploration, this app has no combat, no objectives, and no pressure\u2014just art, atmosphere, and discovery. Perfect for quick relaxing sessions, art lovers, and anyone who wants a stress-free virtual ga
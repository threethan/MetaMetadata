821696_977171928157848_3069831251807899375_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLXmRW6NmJ8Q7kNvwHqgTaK&_nc_oc=Adr-Kfz_45MxBpw8ASjm784rxDjzegT50TEMgZzHctmHYkC71tMVJjDs_eOiuJHv-gQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMEv49-SJU0UMX_Vzwl9pwNo8UEDkE3tYlPevb1jWRWQ&oe=6B0C5C5E"}, {"file_name": "Screenshot_4.png", "id": "1681925022778446", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1681925026111779_4053949340069332498_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2BW-ozi_TYQ7kNvwGFhW_h&_nc_oc=AdoJ_RyayQagImTlrvJ--6vKHGOoJjavl9Q2fyVahunpSQ79p2fyu2TcJkW47Q-0lFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuAfDBRT7uzUkcA5JUndyGTmj04FhWnmqkBLNxyLNNTA&oe=6B0C6A8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "kapak_yatay_1440.png", "id": "900935955631245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823270_900935958964578_6269975705844571005_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJKvH4y_rWsQ7kNvwFW5F6V&_nc_oc=Ado2bzudxg672gHC16MoeUtPRC4TR5O7O1jQ4gijOqR9ujFTxrxHAYl54r4nxVsr2sI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQROfH-c4O_UP2dFwZKckMeSTtipqGG1VHfA1OAoNK0Xyg&oe=6B0C6F13"}, "display_name": "Virtual Art Gallery: VR Exhibition", "keywords": ["artgallery", "museumtour", "virtualmuseum", "gallery", "art"], "long_description": "Virtual Art Gallery: VR Exhibition lets you experience a relaxing, museum-style art gallery in VR. Browse famous paintings with simple right-thumbstick controls, view an information panel for each artwork, and enjoy optional voice narration that updates automatically as you switch pieces.\n\nDesigned for calm exploration, this app has no combat, no objectives, and no pressure\u2014just art, atmosphere, and discovery. Perfect for quick relaxing sessions, art lovers, and anyone who wants a stress-free virtual gallery tour.", "short_description": "Explore famous artworks in a calm VR exhibition. Swipe through paintings, read info panels, and listen to narration\u2014no timers, no stress."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/7_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24113706484993911"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1444489837871857"}, {"status": "PUBLISHED", "id": "27644017351959724"}, {"status": "PUBLISHED", "id": "2566242343795525"}, {"status": "PUBLISHED", "id": "1314039867312578"}, {"status": "PUBLISHED", "id": "1345250937426001"}, {"status": "PUBLISHED", "id": "898790892733616"}]}, "baseline_offer": {"id": "1345250937426001"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795118400, "status": "PUBLISHED", "id": "1444489837871857"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24167868896244336", "version": "0.3.0"}, "id": "1449863066480428", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary"
&_nc_ohc=LDo2LqaYm1QQ7kNvwE00aZp&_nc_oc=AdpZ_PzpyvhWQsmXJWKAPwE8pY3Snf9J_E2dbh3e-D5MBNBQKZaF1xsa5A4DfEt4wzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZZkb4Ru_tDGevDS0Rrmx2IZttWj5Cp1gmd9iUmNuSqw&oe=6B0DBB35"}, {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN4GN0brtDcQ7kNvwHQthyr&_nc_oc=AdpGctVCTIuyUmjOILaL8b5HH7vVupGjIGUvrV2iDdK9iVaMMeJUoqpg2sumTOeGdK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfS680c4JdbXRuXBY_a_kS3P808iz99xEFk-egLnAqLA&oe=6B0DB877"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMgPV4Qyu58Q7kNvwFOzT8j&_nc_oc=Adq6ImA7tg6sAYHqS0tQfiEs5AmNis4K66BGgi7ZQAGkWJhk6AfoHPUrTLAQ-GPg22Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRy-O6xsDme6wjw9Z48W9MIRgs3OB5XeKHqxkZgulo4bA&oe=6B0DB841"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsC_NsoaOEgQ7kNvwG-4WWX&_nc_oc=AdrwywEu29oX-6XErsaIX0NsK8oirQw4aKn7t7BDD_6nkhocO_AJyDpwkAP1TKhjNPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJEAva6_vD0DczD8CwDajSD-KOS4_n6ZWYi3zlpeF5dg&oe=6B0DAF51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLPvmSgys0QQ7kNvwH1xpbR&_nc_oc=AdodZtvYr6mXy0HWdLH81mnR_-iQhiokCgu-eaP2hwdZelz9kCIKAHK99h7ubhkFenE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTiZLdnN6jGq9_l7BzEEanuflMS_N6x82H_8isM_tojAA&oe=6B0DD061"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
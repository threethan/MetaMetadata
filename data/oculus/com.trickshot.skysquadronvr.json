&_nc_ohc=HTy9yUOeb5kQ7kNvwFntI-f&_nc_oc=Adp2vck0M75-1iiz2xn-6VRsAmZJPCiE58odijTwRH4G2q4JaG_OG6GodSoTXYr7T6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDDZAXdOj2gRmsEh0OrXFFNEW2ssTEyOfTryniU45Qmw&oe=6B0053F5"}, {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYBNmsYxydkQ7kNvwEFTgsJ&_nc_oc=AdpbkEYUoLtISdf46ovlM_83XVe4YhQLoKQv9FI3Lk349QLmnd9oZYelD0CBojeaquo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLS37mapb8EV6fUHXaRsyS5snc4OCsTYI4nZY-Ux5aHw&oe=6B005137"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biKJ_oWY5DoQ7kNvwF_3TzN&_nc_oc=AdoTsvWd4FnDovMZ_-A1xnTs7WqXiFjCXthjMFMcDkgF0slZ8j2GU2lKa9UXRMMlT2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcdIruZvo2jNjM64B8FjCKWasIHe-vKm9VC7Y3uumdvQ&oe=6B008941"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3skoej4iH8Q7kNvwEhTHYE&_nc_oc=AdquNQIHlvZSOX4HGUImYZ7mESYqeugI0fjdyIW4CLyIE31lYOCIe0-HQxFqMQDe8zs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNRJNaKCcpzPfI3t3CVYTFaJ2zvh4nKEAHU8uasXKPdA&oe=6B008051"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOBTE7FxHxkQ7kNvwEQOTIq&_nc_oc=AdpD9Jp6p6UD9JgEZsEFJMmSo_cEvyFBT8OApbeRwu2DGhsEtM_sC14im7k_wndNxDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThCa21Upz2DiFW3qs21dvJI-BXsi1RtRH9s2RUclzYFA&oe=6B006921"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
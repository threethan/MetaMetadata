&_nc_ohc=a6YaKXVRwnsQ7kNvwFri39e&_nc_oc=AdqHrVKsaCOD0G4igyacTMDVT4cNY7RFpe_u73rjz3wNVfqMEZfkRnGIeuONKpxYrWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ73cqeXCqdBiixX-x9En7pgOWnygeeDxHd77F5y3dGXw&oe=6B0480B5"}, {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLeiw78F-gIQ7kNvwFDfsM1&_nc_oc=AdoMqqnmcM-CUv-PW6JDVgxFXtkyesSYXRn8ejduec2lvPzBduv8oObPC83Sl_yE20I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcoxl1gtDqyyd4IrvQ0tUfXE9H0byV6EZrS_24SGAbBg&oe=6B047DF7"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYwlaSaToH4Q7kNvwHPcJD9&_nc_oc=Adqu9UnFUXC8B-xq1rUdKWO1DqXyPJTdMNyKjk9R9ZFFU6Yxu6EomrWcb9N1HvNzV0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTudZleyvFYve8Q-oN2V_Cy9OM_IhV4TPhpXTYAtHrLbQ&oe=6B047DC1"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE5xD_mMW-oQ7kNvwGMCQZ5&_nc_oc=AdoTQ982cFWXytzPRtxgiMyFq9EGPdsHEFK0GWIJetlVQvHzBuTqg3h3CL2b1gfoThE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNm6wqEE5-EE371NFBCOH3R1rv99-tYOTAqWy3C6tsWA&oe=6B0474D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTlZygn2sjYQ7kNvwH-IpQT&_nc_oc=Adq6h-L5N1dRQAzHDLxDA-QTPY6Se0RsuKnM8NwmKDk6vnw6CGAq9YclQ_l5rMWejSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo_9R5ezCP1FfbalQmmuS5B0qkuKQnx6qS5hDlWdIsBw&oe=6B045DA1"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
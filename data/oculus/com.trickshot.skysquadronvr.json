&_nc_ohc=HTy9yUOeb5kQ7kNvwF35DNg&_nc_oc=Adoudt9heZWWSO6P3yDlD56A3Ov_OneJ42ZKD9kiVlLOv7lkH8Ve6lmoI7aqc4aUluw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWouC7FmidOZeNHKnVwpn2qjuwo9ty32IPRGy90-psBQ&oe=6B032F35"}, {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYBNmsYxydkQ7kNvwFNBNT1&_nc_oc=AdqMOUmGuaexc6OpsNRAXqq-74wcsGRZpgHzZQ3fBc2bmBsMal-FB7wv6ldf7Us5TGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7YZv_NYoVCwBEw8XFGBXkhaS1l7fYSqjsk2uQj3z20A&oe=6B032C77"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biKJ_oWY5DoQ7kNvwFxL1bz&_nc_oc=Adpsm14x3Eg4vZkfEScH5nC9YwbzMLIAve22ck9WlOuLeJuRSq3OB-92NZzWynfwBhs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxTmd-_WOisF9KcY6M2rICiQSN8ixSLIBstl6QVSYa7A&oe=6B032C41"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE5xD_mMW-oQ7kNvwGc7k9A&_nc_oc=AdqlFXhK7WCZ7KPDT1tPhdY3-dgOsBSCzRDZvRaXafd-9a4ls0ZM-lfuZ1c4P4rGt5c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1BOhLX6FwL5hDjV2xo_cnagt3f0XsOS_eVLLZTQUQRQ&oe=6B032351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTlZygn2sjYQ7kNvwHaCO0z&_nc_oc=AdoLGdXqrIXcd1H8-WY6fVFOz_g12C39idA2KwgqKjChZpRyrxKpTxlUw3B7hZCV98E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2gcdEFSbG_cAt9m2wVuzQ6EWscYJ5I2uKZcH_fANDjQ&oe=6B030C21"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
&_nc_ohc=lPVV0rgY2zwQ7kNvwG0satT&_nc_oc=AdoZ7OZfkOQ8FCFS5B4xwl-5OcsCDx6acT3Iqsmj1O5bpYzkn8X70OVixMxRalMp5Uc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxmdYzB42lGEq2Ee6Z_2Azem3biFkrOlcMvG65b2ejbQ&oe=6AFF0275"}, {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7BVoUGkaXoQ7kNvwHHpD2N&_nc_oc=AdpWOaxMvqPQ683CDSl-FfWofyIIw87a0aLooWqAFSSxlnronYH0dkK6NreMx7gPjVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThH-XLTwBUO_0Cn8Bli3tF8GFd2ojLMMgAYO3daJRdyQ&oe=6AFEFFB7"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpAJJ-yY-XcQ7kNvwEvv5w9&_nc_oc=AdrsewHEmMEBFk6b23yyLYCwZAA-G29YBS4Fx4_z1QFzOp6qkvGK31YxWg3xBJ9jTTg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2peDSPYnExsPxBLimGS8-xWduekJWksoW7f7vSTl1uQ&oe=6AFEFF81"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3skoej4iH8Q7kNvwHj99-7&_nc_oc=Adq3CB_Fmw1H9LszK_UbnhEMDukF3h4NASg1XMEOU0mCOi8bxSbxGUamHYxSIK4XIS0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScIIxGX2Fikehao3MJTDgIcwuuZTIIfWAYk_buUa2SsQ&oe=6AFF2ED1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOBTE7FxHxkQ7kNvwEs6PWq&_nc_oc=AdpuaSbsX11OKWr7e682mtx3MqM7bq4BmquB2mR6ZkbsddDghtK-2gaz4DN7uQ92EEU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpTgsX2Zkh2ppM_3dje-1hCSRUFkKuVF9PCJvYSkv4MQ&oe=6AFF17A1"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
 {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPKbUqibxO0Q7kNvwH9yq5A&_nc_oc=AdqCBOJidglJBGaz4xhpWsmoVbdAO7PZB_C2mGnMvN4LsnPv8Oju6qRxF9bTa7Rc2-s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8RJGp8xCft4ppJHNfWZeFlK-8xb2XzegwXWy0edeT2A&oe=6ADCB8B7"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJ7ZUo-Ah5gQ7kNvwEZKrCK&_nc_oc=Adpmh1eeQEVantv-7BHulH5FgyIeOlU5f-wZEMuiro9PdhPzOc1S-CMt5mA1lxnq5EY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODQ88NPDDID_dTcFOXv7JpVI6vdwGL62rqewsgZWDKtw&oe=6ADCB881"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BlZvoglHR4Q7kNvwFUUhX1&_nc_oc=AdoeQ_pSMM5zW66KZqBnk3cShBbaMWnUcZBcfN9lrvmEdY13xpIgO3ChTx3of8ywWT0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrycxd0EgWDUBE5oExthaqIBmjT5tjCNZuicM58HliLQ&oe=6ADCAF91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6mtrTIg7ucQ7kNvwFpBl6O&_nc_oc=AdoXOTOFSM2565J97qApG2GI3KUt0VfLNnbv6LGPI4oNB-6onHuHeRgEjv3j6_-H7yQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk81IfCp_GIM0s3R467MaY4c7B8p4ftD7X8Our7nN5og&oe=6ADCD0A1"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOV
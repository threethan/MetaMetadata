t-sjc3-1.oculuscdn.com&oh=00_Afu2dCIWT15pXHAZ4O2CmFU6meTsHvUfUAxui7YMD8CkEw&oe=699867B7"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mopEspsDvRgQ7kNvwHABuqu&_nc_oc=AdkE15tZsVVAK4eQVYp1pM7DxUeo1ryr2_CO7rJ734lnhQJj68fBv0rdOhy5vy1Wd-0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftGfd6o_cZqpAccYp8p8dDMv6G486r6c94ZOJXaQSUoow&oe=69986781"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSc71JjPhRsQ7kNvwGM00kB&_nc_oc=AdnikkbXCtl7iZaBCc4VibQOHemZLMosCwBV0JeS1YwtGgs8YAUCGFAkKNlH6k-aQts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuD9CNzfKhmvj8eRQTX2xD0cgAFfccXQp7DgAue9EV45g&oe=69985E91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJXFZsQM2-4Q7kNvwF9wLc9&_nc_oc=AdmFA8EBBszPEifSmK3x18wr4AAqGJYDt55vFlhGSV7O7A2Q5s2IO3LXVe6ENE5ql20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvs8VwdBtwnzXwinkX-kVcYqV6-n4iZGyMBnrjnJ1GG2g&oe=69984761"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "462939568597233"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "926313825146205"}]}, "baseline_offer": {"id": "926313825146205"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1683727200, "status": "PUBLISHED", "id": "926313825146205"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25432957952984993", "version": "1.0.2"}, "id": "1035667083977793", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8077938768913514", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25432957952984993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1035667083977793"}]}, "change_log": null, "created_date": 1711614546, "id": "25432957952984993", "version": "1.0.2", "version_code": 10002, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8077938768913514", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25432957952984993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1035667083977793"}]}, "change_log": null, "created_date": 1711608788, "id": "25432468329700622", "version": "1.0.0", "version_code": 10000, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8077938768913514", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25432957952984993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1035667083977793"}]}, "change_log": "Update 0.47 - Mission Update: Dam Busters\n\n\n\nThe town of Kookaburra Flats is dry as dirt! Some sneaky snakes have been stealing all their water. Find out what\u2019s going on in the latest Mission update.\n\n\n\nWhat\u2019s new:\n\nNew mission \\\u201cDam Busters\\\u201d\n\nNew cockpit interactions\n\nA new slimy boss to stop", "created_date": 1691126988, "id": "10070455566328481", "version": "0.47.01", "version_code": 4701, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8077938768913514", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25432957952984993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1035667083977793"}]}, "change_log": "We\u2019ve got some fresh new challenges and achievements to unlock in Mission 2a: Take Out The Train!\n\n\nUse those powerups to tear through those baddies and unlock those \u2018cheevos!\n\n\n\nWhat\u2019s new:\n\n4 new challenges and achievements to unlock in Mission 02a", "created_date": 1687920018, "id": "9855057847868255", "version": "0.46.01", "version_code": 4601, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8077938768913514", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25432957952984993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1035667083977793"}]}, "change_log": "Update  0.45 - Outback Rumble!\n\n\n\nWe\u2019ve had reports of a few dodgy drongos scoping out the tucker in transit for mates out whoop-whoop! Time to head to the outback (and try not to get sand in your dacks).\n\n\n\nWhat\u2019s new:\n\nOutback mission is now available! Protect Perry\u2019s jam from being pilfered.\n\nVarious bug fixes and updates", "created_date": 1686703016, "id": "9764282560279118", "version": "0.45.01", "version_code": 4501, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
&_nc_ohc=HTy9yUOeb5kQ7kNvwEda0gS&_nc_oc=Adr4mYhcoI_GiDXVNjFNavKlRsyt3AHSedMhoKKXBaDl4tmgRYiHxW6BuN_VAwmSicE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXFejP5QVmAPL3-SQxVJEmGrJU-V3Hjz-Lzjj1OODyFQ&oe=6B01DDB5"}, {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYBNmsYxydkQ7kNvwE2PeNT&_nc_oc=AdqoLlR9boRLw82H1DH1tofQaN9C32Q3DIlRT95hz1EAb8iX8qs5RTDtpKUX7UR2DG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnxWMLF8xtqtsRrj6FJDYUDtcQCG6R-eUnvZ6R3mCtvg&oe=6B01DAF7"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biKJ_oWY5DoQ7kNvwH4Keam&_nc_oc=AdrgsNSxtKTIbgo6acJwxjPecwdNLa-fkwXSssuOAJv-plBVUODTDDDfrZZGPk2XGZw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLv-IaslOc0k6mLHh5f4NnKO9con6juyfex8yKzI8Teg&oe=6B01DAC1"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rE5xD_mMW-oQ7kNvwGyG1gP&_nc_oc=AdoYOaLQpjuapUfIiZZ-H2nOraEJO7Yr0DITLiIXyzZfSQiP9rGzlAXGjIQEJqPx7M8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYs7vXYlXATEHIjlMFOEWllFZ9lPUIGqKKRpET2eAS1A&oe=6B01D1D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTlZygn2sjYQ7kNvwEku-M3&_nc_oc=AdrPhVpCM5wAbvbERFe0-hH6rlXrOaa9i2qWI5-ZoT2giyvUBk_Jzgi3oMOqJW49X1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKl2MknIl8d90cr7T9-yCrnXnPCqIkLbbvc4auU9V5UA&oe=6B01BAA1"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
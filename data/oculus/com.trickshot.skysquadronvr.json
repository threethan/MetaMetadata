&_nc_ohc=lPVV0rgY2zwQ7kNvwFCBZ28&_nc_oc=AdqHRX-xkkNG-AgViRQgSkXnbdJg91IQnTszv7RkU4-Ne2PI1_X0edaWZmLGUHd2SgM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH96sfL_z1HzoiuaSjEkwn4z2AT_Z8MiwKSvTkLGBm9Q&oe=6AFC5F75"}, {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7BVoUGkaXoQ7kNvwHJHidL&_nc_oc=AdpyiPZpQD17UMyNT6iRAXgFkhAdEIliPO9SIfOipkj3Cj2F98AKSJn_cnTqVueBaqE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn4L9UTqe72wkbfup2uVjR1Jq3lKU5kZY6ZlWX_RVqLg&oe=6AFC94F7"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpAJJ-yY-XcQ7kNvwFV90Il&_nc_oc=AdrK2mdfUs9zGt9KrDnT7G7UFyi4opgcNuUBJYxIvb6TF6543m4kp38xpfugfGENtG8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEiA4kJxgdqEi7c0zME4EiewxY8poXeNeUFd22jS0L4w&oe=6AFC94C1"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4v06Ja67w4Q7kNvwFoUAD1&_nc_oc=AdqtRNGGAajlwcWKNg4JlLSW9spR6BpBB50uL_JL2XFzJaLJKELIcG3UGDnrjYmYdus&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfeN5UVSpWUra2NNC0WCWLCmDSSr82B-QMq0dshtJ9Dg&oe=6AFC8BD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxKeWFxnHGwQ7kNvwEm80ce&_nc_oc=AdpE1DwE5OHg6F9a6hMF3yvSUQl6Gysd4gelnGTBvPbvQVVChPRCnbDUynGkyrq-7Ho&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi7Yvt4Ag0OH6VNpOG4QlzmjIvHEVCVw98AGTAoR-QLg&oe=6AFC74A1"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
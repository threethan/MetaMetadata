log": null, "created_date": 1711608788, "id": "25432468329700622", "version": "1.0.0", "version_code": 10000, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8077938768913514", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25432957952984993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1035667083977793"}]}, "change_log": "Update 0.47 - Mission Update: Dam Busters\n\n\n\nThe town of Kookaburra Flats is dry as dirt! Some sneaky snakes have been stealing all their water. Find out what\u2019s going on in the latest Mission update.\n\n\n\nWhat\u2019s new:\n\nNew mission \\\u201cDam Busters\\\u201d\n\nNew cockpit interactions\n\nA new slimy boss to stop", "created_date": 1691126988, "id": "10070455566328481", "version": "0.47.01", "version_code": 4701, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8077938768913514", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25432957952984993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1035667083977793"}]}, "change_log": "We\u2019ve got some fresh new challenges and achievements to unlock in Mission 2a: Take Out The Train!\n\n\nUse those powerups to tear through those baddies and unlock those \u2018cheevos!\n\n\n\nWhat\u2019s new:\n\n4 new challenges and achievements to unlock in Mission 02a", "created_date": 1687920018, "id": "9855057847868255", "version": "0.46.01", "version_code": 4601, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8077938768913514", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25432957952984993"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1035667083977793"}]}, "change_log": "Update  0.45 - Outback Rumble!\n\n\n\nWe\u2019ve had reports of a few dodgy drongos scoping out the tucker in transit for mates out whoop-whoop! Time to head to the outback (and try not to get sand in your dacks).\n\n\n\nWhat\u2019s new:\n\nOutback mission is now available! Protect Perry\u2019s jam from being pilfered.\n\nVarious bug fixes and updates", "created_date": 1686703016, "id": "9764282560279118", "version": "0.45.01", "version_code": 4501, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
&_nc_ohc=a6YaKXVRwnsQ7kNvwEkOUrN&_nc_oc=Adoi19ZAD2RIPSe-Mv7llVTUfeYEsqt5vVo2t4doaUEa1VbDZO0wFHcyK2x8wHnsMYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5-BQL-U20vnIT7zjXx7Xbc6_ToTLTSF_K70NJlIjX8A&oe=6B05D235"}, {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLeiw78F-gIQ7kNvwGeOQPi&_nc_oc=Adr9vKCeaMHa-B-EGLrMCkpaZrzkx61wLmNDDkCdqHka5-BGmHBIjcGd3MxtWpM7Vio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk8aCvBsNmbrOJnb7OXwY136lOvV8C2Euns2UZzVPBsg&oe=6B05CF77"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYwlaSaToH4Q7kNvwGg7-HN&_nc_oc=AdpTyqLZ2-Fep5Rp7OxthaCiGGsjaQp6HVhoAApw3Ct3NK-_TdFfUR4Kbdcvqfy61Lw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT23Q7R__Ag8zfaQjeqff8IVjvxr4yIvat3ezFY12J8Hg&oe=6B05CF41"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mkIgidSfAUQ7kNvwEvM6Mb&_nc_oc=Adq2mG61jlrds7ZbLFaJaCqbDKxnWiD1Et2TyAR0k-HfcnH0kCo8F_msygcWtObiURE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW3xdYZs5gsCVKqRCshLSwcIcXHLueW4N1q2za5QL-9w&oe=6B05C651"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1VqQikav3kQ7kNvwFKK-__&_nc_oc=Adoo0BD023oGMMdwCsP2fGwP-c6PuvnY7xYaOV7acUIF1xVlQBEM9TXVtfRx1C1_-2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJCLpqdI88tp38nXMyGfaABynF3dvVPiUq3jaHLq-8WA&oe=6B05AF21"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
&_nc_ohc=sXONCn83Y0QQ7kNvwHBBiyi&_nc_oc=AdrpcLf731YByR9wRljin6NzKGFBj4LSwW-uoACdfEmpA2Ol6SGfcrGnRkFlclJ2Mu4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXjs0wVoOvpE6xD5vMaQvQ2OMWNIgxwtvruaOdRzKyHaA&oe=6B105E35"}, {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdN6FQV8kMcQ7kNvwHfHZJ3&_nc_oc=Adpg6ZDYF-wtL6lyCq1-C9H6ier9X3z7cyrbNh5qCnoW8vgiOWjgPGNdvDc5mBGFC2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvQtZNhjyPn44VY8VG1QyvBrFuNoedaDd6zagbenleBw&oe=6B105B77"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqRN1YD0QiMQ7kNvwE-lguy&_nc_oc=AdppsyhxOfk_1JJ2vzKYVaYwKr2UCz6tcFCGLRra6l3QYINC4wcdxfnPejbzeVE1EoE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWJfM6Ma7ARVl7rBAr7hTC8ucmyXoQlrPmV2chhvNAv1w&oe=6B105B41"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsC_NsoaOEgQ7kNvwFen8oq&_nc_oc=AdqzqVPA-mxrGaLWZBDRijOC17jyZlMVQXQCcRpq4qbLjPtvWTVst75akcXZsTfar6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrJDY3Xg3bFx_LUe0WP4eg6IJvf3ky5gWY3sA7Fr4a7Q&oe=6B105251"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLPvmSgys0QQ7kNvwGOC97K&_nc_oc=Adr8-QgCgWWaaXp1f9K_nRg8wH1YKkHk1uMXl5hwa8bRm3bnRl2nHSBzxVelowPUo44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXolYdr4vQ_bQYpgZDFsRuOsMGQGLAqGG_u2BtK4vlN3Q&oe=6B103B21"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
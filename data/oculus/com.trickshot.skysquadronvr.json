&_nc_ohc=a6YaKXVRwnsQ7kNvwFYtLRq&_nc_oc=AdoX1eSLkZ_sk9yp4hlOS6gn6R1xoTRTyo3njmVmUIiBWaxhw9s_NOxFWV8d134_src&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_ndVoZbLKbBo4rcxDoDG1-N-LgXSXHCfVk-a9mCj4cQ&oe=6B0723B5"}, {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLeiw78F-gIQ7kNvwG8te-A&_nc_oc=AdrLnAKxICy5OFE13o074tQb1tDyjvsD96_knzS0qsUGR5-D4dcOy5qIknwDMBzYgBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTreoBxy4LgssKSXYaTWm9gwFEmBNNQtJCNo3fYjNzcfw&oe=6B0720F7"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYwlaSaToH4Q7kNvwGGxYy-&_nc_oc=AdoVXFntpAeHtQDUoXjU0Fy9ZcSqLdNaHW4C9-Zmaz4SBgdvR0-7JgWOKrkds-mgTXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS4QXk9FP7W66y-3JNQp9a0rJ5D-7MJ59feB87ASSO5g&oe=6B0720C1"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mkIgidSfAUQ7kNvwG3BJNV&_nc_oc=AdrsTRgVxKCdV0lnjSi_cgzp84zCXAmhmaJD1qFe6UpTZ2iWSxIJARiBu9cE-O74OaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtdR51TlKh8bVqZUb0sVXhqFfq-5-1nMAATYdKRiE3rA&oe=6B0717D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1VqQikav3kQ7kNvwF2ggwS&_nc_oc=AdrIMiZoBtt5-8749xkY--7JTpNoYL874cBQI1llOjfj4C7UvSs9zMmTLHvZQLN6teM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzDlke5qfNJeC_DtWOx9Xy-0mJFmNSp_vT-CWkXVv8NQ&oe=6B0700A1"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
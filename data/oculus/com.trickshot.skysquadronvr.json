 {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUQaK4FyEHMQ7kNvwEiOhV_&_nc_oc=Adrmc9eAYQi5mZ1B1RLt388LriUo-U2q8rHBLZ4fIH1fKBEkg8uu2N5Pu3J_4zxuAOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrW1_o-ggPh9ZBZNVmpDeHw7Dp5iiKVY176grSnVLSjw&oe=6AB52BB7"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC9urZqC944Q7kNvwEDNcSa&_nc_oc=AdpaKhY3Sn29Yb8Ny8Mv91AcaCIj5uZn-BJAm_TUGEPPc6qc-Xpi1Su4Wxi4lYXzJC4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY46Lp92JUxdwBO5rNkiYfkQ3lxcOF7l0t8A84s3jaVQ&oe=6AB52B81"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBxPkMF9QOMQ7kNvwGsvPz2&_nc_oc=AdpILH4em5MmR0MJcrXQXXiM_b9sD1qBnsN5cFjo_k0wzNG9mNuxDvx8gvVK93qMiDk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK13zsdI99CVD-_aMJfS2Bx4nrqirtWm8IZnt70UfgI0g&oe=6AB52291"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjLiSnz2wb4Q7kNvwE6F9pV&_nc_oc=Adr3vVgZqQ54sCE208Sk5dgwgG84xAGqKIkA4hq2YhVMQBOAZqDv0Zgfj7Xz12xkaAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkHnqgraqpDUlELPeV5u7i_MSVQoYFY4s-QJohw0_t3Q&oe=6AB543A1"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOV
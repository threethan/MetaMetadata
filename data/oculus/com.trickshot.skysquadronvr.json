 {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1-WE8hLVl4Q7kNvwE0CMXT&_nc_oc=AdqwtlJlceBDNgAAvfllP9aVrc1PMP-6KEL6FCQ5pKyjHmY6Mwfu8l1UF31pX8DN-Oo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHppjLBKvXEypfL5xmC__AppirUBMfxRA9opyR5Q0TcbQ&oe=6A93FDF7"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrrMHN9fyWwQ7kNvwFU9Ww0&_nc_oc=AdpPgBNjp7hwqw9ZDsvHm2VVgLNPGMWOisSow7XzNNfu03p5EwNngOHH3p7ix-E7QA0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAdIa2dkev0yl51b8ahdSB81xnPoLLndhUMPNjgT5xPA&oe=6A93FDC1"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJSeBGlk0EwQ7kNvwHQ5G9F&_nc_oc=AdrzTyAQcvHQtS3eZuaSGXA5_bptVf64HEw3BnB-Eu-IdPSBDDrGum42ducANRs2-PQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEom0tAEDpjQGxJL0fzQiKrJAS5DNLPyQWg0awaCZdYcA&oe=6A942D11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaNF-Yncg4EQ7kNvwHzlwUC&_nc_oc=AdqO6rBJBvRQDTRAAIsM1Z0eqFkaJvjYkR8jPND6ZWVuBxu8vidf22_toAaCNugjQlg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3YyA0QcrZtqgWj8NNh_RKmbKkre5s2R98WymSXP5j-Q&oe=6A9415E1"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOV
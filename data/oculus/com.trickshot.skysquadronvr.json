&_nc_ohc=LDo2LqaYm1QQ7kNvwGAWtJe&_nc_oc=AdrVJGkokqnONTap_VbFJVfFwDITZi_7hpBkZGqlndlRsIc35JLuqBTXE-YDpkqFEm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTce4CHY0F4Ce-jXQOQJPb-h8PVTomCpHcrcLS3LUpg-g&oe=6B0C69B5"}, {"file_name": "Screenshot_03.png", "id": "750887156432789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001724_750887159766122_1493923655041025906_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN4GN0brtDcQ7kNvwENhaUY&_nc_oc=AdpULN6IjebILLpoKqextd0Dzpg8VJs-bu3hoPxYlI7IogTICshV8Iy_yUGg621Q4Tg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNafIpkt3-Ir-EeaVoOTr3zIozW6DjQtFkrpD_Ii3-TQ&oe=6B0C66F7"}, {"file_name": "Screenshot_04.png", "id": "911467930162886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003243_911467933496219_5018844149446080143_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMgPV4Qyu58Q7kNvwGrQyLV&_nc_oc=AdrZEBmF_teJ2z_UExNJPsW1cXUiCQIFYa56J2iIGdttNRBM0ytbxt6jEb_f5oFJHwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEFfzABOqx3NPMKMFN-VwAPod727dKUHIE-UA29pxoBg&oe=6B0C66C1"}, {"file_name": "Screenshot_05.png", "id": "174155445030577", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222945_174155448363910_8892028513575383207_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V83mZlYT4yYQ7kNvwEGOIMJ&_nc_oc=AdrL11LQGseGyVeX2d9t5uEDj7u81qdyP8Ew8VfBTnO-PIT-P22B3SxIjjtfS7iGUB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQjNHQmLrcIn0a4uxoS296B6yIB4LLcMTKvFKzN3FOpPA&oe=6B0C5DD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverShot_Sky.png", "id": "757988159035053", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974736_757988162368386_3128866040929659758_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqAPrpjG_-UQ7kNvwHDdjHL&_nc_oc=Ado_SvzqIB8cO9EkgwO5EwCDNhDXCp6HW8-tZAWHNFPEFv14y4AVzpp31j59VbZIwlM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRlgXgKJdLBosT7kJCTEfmIH_CO0Z2Eu1Jx_7DHFKY2mA&oe=6B0C7EE1"}, "display_name": "Sky Squadron", "keywords": [], "long_description": "Think you\u2019ve got what it takes to keep Australia\u2019s skies safe?\n\nThe tropical island paradise is being invaded, and only hot-shot Keith Koala can jump into the gunner\u2019s seat and fend off some of the most menacing meanies that the Aussie Islands have ever seen! Grab the controls hands-on to blow fearsome foes out of the sky in thrilling aerial combat before they plunder everything your home has to offer.\n\nFeatures\n- An Australian take on the beloved \u201cStar Fox\u201d rail shooter formula, combined with thrilling WW2 gunner gameplay.\n- Experience a koala-ty cast of Aussie animals fighting to survive against invasive enemies!\n- Use devastating powerups to take those drongos down! \n- Blast through every mission alongside your friends in seamless online co-op.\n- Branching missions & varied objectives. \n- Tear apart foul foes piece by piece\u2026 literally! With dynamic and fully destructible bosses.\n- Dominate the skies and claim your rightful position as an apex species with global leaderboards available for every single mission.", "short_description": "Jump in the bloomin' gunner seat as Keith Koala to save your mates & their island paradise from the evil invading empire! Sky Squadron offers a unique Aussie twist on shooter classics like Star Fox and Panzer Dragoon, while adding thrilling & immersive VR gunner gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_
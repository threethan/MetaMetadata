s, and availability vary over time and by region, platform, console, and Game Pass plan. See the current game catalog at https://www.xbox.com/xbox-game-pass/games. Learn more about supported regions at https://www.xbox.com/regions.", "short_description": "Play hundreds of high-quality Xbox games on Meta VR headsets with Game Pass. \n\n*Game Pass Ultimate: Subscription continues automatically at regular monthly price unless cancelled. Xbox Cloud Gaming (Beta): requires supported controller (sold separately); streaming limitations apply, server availability and wait times may vary. Subject to xbox.com/subscriptionterms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://support.xbox.com/en-US/help/family-online-safety/online-safety/privacy", "developer_terms_of_service_url": "https://www.xbox.com/en-US/legal/xboxapptou", "publisher_name": "Microsoft", "support_website_url": "https://support.xbox.com/en-US/help/games-apps/cloud-gaming/guide-to-cloud-gaming", "website_url": "https://www.xbox.com/play", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}], "external_subscription_type": "REQUIRED", "genres": ["ACTION", "ADVENTURE", "RACING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_PE", "es_CO", "es_MX", "es", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr", "fr_CA", "pt_BR", "fr_BE", "nl_BE", "nl", "ur", "pt", "sl", "it", "ar", "zh_TW", "zh_HK", "zh_CN", "de", "ja", "ko"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "757525235779115"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status
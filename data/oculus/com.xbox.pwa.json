.png", "id": "1862092871277301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499295974_1862092874610634_6800276154742057243_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z135Efse3vQQ7kNvwHu8AIi&_nc_oc=AdpnJolGhW1zKU5LCF0CV4VnNNTps3dBtYasAShrUQBMfJnGi8ehD6b3QMDAnXuSMxY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-hwQs5Wo-pN-5LwF6-g41M_L-wK5lL5KgZBbzxLxAtA&oe=6A3D4E83"}, "display_name": "Xbox", "keywords": ["Xbox", "Cloud", "CloudGaming", "GamePass", "XboxGamePass"], "long_description": "\n# Stream Xbox games directly on your Meta Quest     \n\nStream up to hundreds of games* like Halo Infinite, Forza Motorsport and Starfield on a massive 2D virtual display in Meta Quest with Xbox Game Pass via cloud gaming. You can also play select games installed on your console via Remote Play.\n\n{1982044279075370}\n\n\n# Customize your screen\n\nAdjust the screen to fit your space and comfort level, from a big screen TV to an expansive display for epic battles.\n\n{1689941275512813}\n\n# Progress goes with you\n\nStart a game on your Meta Quest and seamlessly continue on Xbox console, PC, or mobile devices with cloud gaming. With cloud saves, your progress stays synced no matter how you play*.\n\n\n\n*Via the Xbox app, free in the Meta Horizon Store. Xbox Cloud Gaming: Requires high-speed internet connection, supported devices, and Xbox Game Pass subscription (all sold separately). Cloud playable games not included with Game Pass are sold separately, and may be made available with Game Pass in the future. Game Pass library varies (xbox.com/play). Server availability and wait times may vary. Select regions (Xbox.com/regions) and devices. Terms apply. Xbox Remote Play: Requires Microsoft Account with Xbox profile, and Xbox Series X|S or Xbox one console with remote features enabled. Some games and online console multiplayer require Xbox Game Pass subscription. Games, console, controller, and Game Pass subscription sold separately.  \n", "short_description": "Play hundreds of high-quality games on Meta MR headsets with Xbox Game Pass. \n\n*Game Pass: Subscription continues automatically at regular monthly price unless cancelled. Xbox Cloud Gaming: requires supported controller (sold separately); streaming limitations apply, server availability and wait times may vary. Subject to xbox.com/subscriptionterms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.microsoft.com/en-us/privacy/privacystatement", "developer_terms_of_service_url": "https://www.microsoft.com/en-us/servicesagreement", "publisher_name": "Microsoft", "support_website_url": "https://www.meta.com/help/quest/articles/in-vr-experiences/oculus-apps/xbox-cloud-gaming/", "website_url": "https://www.xbox.com/play", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ACTION", "ADVENTURE", "RACING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_PE", "es_CO", "es_MX", "es", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr", "fr_CA", "pt_BR", "fr_BE", "nl_BE", "nl", "ur", "pt", "sl", "it", "ar", "zh_TW", "zh_HK", "zh_CN", "de", "ja", "ko"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25502236549433969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617799_718323637610966_6796658840411888187_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gv5CQXqE2EQ7kNvwHiMyYA&_nc_oc=Adpx_sIjpC2SBSu7TjcBx_EHkjnahL9o9u7pxEAjMb6K
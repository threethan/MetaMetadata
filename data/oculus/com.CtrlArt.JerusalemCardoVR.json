hnology.\n\nJourney through time, meet captivating characters, see age-old stones come to life and hear voices from the distant past reveal centuries-old secrets.", "short_description": "Cardo Tour is an exciting, futuristic time-traveling adventure in the heart of Jerusalem\u2019s Old City where you can relive the history of the ancient Cardo with the power of Augmented Reality technology.\n\nJourney through time, meet captivating characters, see age-old stones come to life and hear voices from the distant past reveal centuries-old secrets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ctrlart.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Ctrlart ltd", "support_website_url": "https://cardotour.com/", "website_url": "https://www.ctrlart.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "he"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10095494557215148"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974689_952601856666103_4425301214922583053_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJ97K1tp9ucQ7kNvwEMqT3F&_nc_oc=Adqr9x8UduGMLnUVzUc6FPdHxzfbNO4XeAJUeaDjP6I7OwYNPUeZLDrGztpnyXIc3EE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPIQNsSq55HvlFyhz-GjE1SLTMVYv_vkS6r3XVjZt0l
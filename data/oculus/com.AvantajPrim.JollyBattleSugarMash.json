9013560656_3742418311996540390_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJ0tumoWzD0Q7kNvwGkInmt&_nc_oc=AdqJ6EVV0EJra5P2eG9Cw0Y1vxiSN6p6yK1sADIzwBZIA2bL9B6290e24ZL_g8Ym7XU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-c9lWVSk7uhCRVDTUYy8t2N_TSNG-Cn4gEkaswEUmbQ&oe=6AC90FC7"}, {"file_name": "5 (1).png", "id": "826808915135470", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75404385_826808918468803_7339830255906415332_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9ZEt85x0w4Q7kNvwEbaYOQ&_nc_oc=AdqH3HiBm4qQ_xZDMT9PsfgMngmTuSQOUhFnqRCASkSJ1JzWLkDprfxx0724lrtsEPI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP22zYBxbpMXWpZ0JWy4hIH5cv5RtmxwMBIL-iIpecvYQ&oe=6AC90FAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (1).png", "id": "495657506005616", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75196229_495657512672282_1984150092161742931_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohl8MhBqgSsQ7kNvwGrmmQq&_nc_oc=AdpZUlmE-IPpeZUa5sAsY6X7lGmw_3lZD4FDNY_22Z7Svf1LGeVK2nsGd1h_h9821KI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM96aMRUPrrZrdIDJ9tbYnEuLJ3DefFQlNqh6ZfTtTLwg&oe=6AC90D41"}, "display_name": "Sugar Mess\u2014Let's Play Jolly Battle", "keywords": [], "long_description": "Sugar Mess\u2014Let's Play Jolly Battle is a fun arcade first-person shooter for the whole family!\nEmbark on a journey through the amazing levels of the Sugar Kingdom! Fend off the attacks of hilarious yummy enemies that shatter into pieces on impact!\nMake use of your vast arsenal of weapons that get stronger as you use them. Use special items to gain an advantage over your opponents.\nChallenge mighty bosses, use their weak spots to defeat them!\nOther exciting activities are waiting for you: solve challenging puzzles, ride in a unique vehicle around the kingdom, feel the rhythm and participate in musical performances!\nDive into a fairy tale world and find out the exciting story of the Sugar Prince and his mysterious enemy!", "short_description": "Sugar Mess\u2014Let's Play Jolly Battle is a fun arcade first-person shooter for the whole family. Shoot from a variety of weapons at hilarious opponents! Pass colorful levels with different mechanics and immerse yourself in a fascinating story!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jollyco.us/docs/privacypolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "JollyCo LLC", "support_website_url": null, "website_url": "https://jollyco.us/sugarmess/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1099574127529782"}}]}, "scheduled_offers": {"count": 23, "nodes": [{"status": "PUBLISHED", "id": "898799256435736"}, {"status": "CANCELLED", "id": "1492845472604120"}, {"status": "PUBLISHED", "id": "832518789827800"}, {"status": "PUBLISHED", "id": "942183255539282"}, {"status": "PUBLISHED", "id": "1476460840495811"}, {"status": "PUBLISHED", "id": "26018934641051095"}, {"status": "CANCELLED", "id": "1247022907357492"}, {"status": "PUBLISHED", "id": "1552858912569611"}, {"status": "PUBLISHED", "id": "1344312794043235"}, {"status": "PUBLISHED", "id": "646348144578185"}, {"status": "PUBLISHED", "id": "2176027176252140"}, {"status": "PUBLISHED", "id": "62950269674221
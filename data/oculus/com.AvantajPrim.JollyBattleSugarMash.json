9013560656_3742418311996540390_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmWdHrxCe6MQ7kNvwFNhEDS&_nc_oc=AdrYzPOpOK_3W32CuOcW4OvP0jSqSrUq0dC2VCAXS1FlmbDeKvwIOTfr0RTZT8w7BeQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuiH6sd-l6ghXHGY2DuQketXgOfIYBZQBTmRYzByr7Qw&oe=6ABD3247"}, {"file_name": "5 (1).png", "id": "826808915135470", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404385_826808918468803_7339830255906415332_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mqqivETBFoQ7kNvwFe8KTv&_nc_oc=Adr6c-NRRq0F2mTe9143rwURjeYj1sGm_2hqHHvfTdYqO76NrutRpBwKMPSCwt59h60&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0ZERukMSjq7qLl-ike4-caPUCZILnt7ePkbLTJjbFNg&oe=6ABD322B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (1).png", "id": "495657506005616", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196229_495657512672282_1984150092161742931_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfFbaWvQs38Q7kNvwH46tCb&_nc_oc=AdrqoHUTzwNPfwV3uQ1xdvEvR4Wn7npqcZl0nrCOuV8mvir5j4tJ3Cb6bFg4LWMjv48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpqUtGmjZTLp7mZ_6wlAYDeniWsFnxztrF0sWOf4YSYQ&oe=6ABD2FC1"}, "display_name": "Sugar Mess\u2014Let's Play Jolly Battle", "keywords": [], "long_description": "Sugar Mess\u2014Let's Play Jolly Battle is a fun arcade first-person shooter for the whole family!\nEmbark on a journey through the amazing levels of the Sugar Kingdom! Fend off the attacks of hilarious yummy enemies that shatter into pieces on impact!\nMake use of your vast arsenal of weapons that get stronger as you use them. Use special items to gain an advantage over your opponents.\nChallenge mighty bosses, use their weak spots to defeat them!\nOther exciting activities are waiting for you: solve challenging puzzles, ride in a unique vehicle around the kingdom, feel the rhythm and participate in musical performances!\nDive into a fairy tale world and find out th
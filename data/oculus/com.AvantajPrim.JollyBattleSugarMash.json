9013560656_3742418311996540390_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxNu3F0ZZcMQ7kNvwFdBa-5&_nc_oc=AdpW9U1Ldu_1dFW08mKQgO8A0hgskVceL_ygH4V-W5Kanmpmcmn-PVwzsj5-_p4cQsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAm3tfwSAjqiVJq2lS6n3JAuR1ZeTmzCXiSd_xN-MB3Q&oe=6ACBB2C7"}, {"file_name": "5 (1).png", "id": "826808915135470", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404385_826808918468803_7339830255906415332_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efBWzEQjLtYQ7kNvwEH9hmG&_nc_oc=Adp7btqYtuuLLfThtuVxOkktLN7_D5XPxOVxMzsZ4C9kWKL1v8mSodP91ln8HZJ_c38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPUCbrlwZBb74as8vh2IDHpncfZugJb7Di9VN-QztlNw&oe=6ACBB2AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (1).png", "id": "495657506005616", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75196229_495657512672282_1984150092161742931_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohl8MhBqgSsQ7kNvwGsF2Xa&_nc_oc=Adr1UcR2dVASDIT6k_EqYNbh1HkZXdEeUyLcIwXjMBKVsaOFCnwNsdRvTPqyaK_kvSM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnyHp1ZZpcLeQg6lVAyQs09pSiB0Pzf0NwPQp5sWO5oQ&oe=6ACBB041"}, "display_name": "Sugar Mess\u2014Let's Play Jolly Battle", "keywords": [], "long_description": "Sugar Mess\u2014Let's Play Jolly Battle is a fun arcade first-person shooter for the whole family!\nEmbark on a journey through the amazing levels of the Sugar Kingdom! Fend off the attacks of hilarious yummy enemies that shatter into pieces on impact!\nMake use of your vast arsenal of weapons that get stronger as you use them. Use special items to gain an advantage over your opponents.\nChallenge mighty bosses, use their weak spots to defeat them!\nOther exciting activities are waiting for you: solve challenging puzzles, ride in a unique vehicle around the kingdom, feel the rhythm and participate in musical performances!\nDive into a fairy tale world and find out th
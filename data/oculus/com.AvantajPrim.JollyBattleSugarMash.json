9013560656_3742418311996540390_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKsp9RyNCj0Q7kNvwHt6HV1&_nc_oc=AdobqpN4L5VLG3p9i8DJVlB5WyuJB8nVl5vkIZL3z_knUGssx9RvktdGErUZZ3VFKH0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdeexlmsgsd-pLQQ6MOkvvvfKlQL0xsujZCb2WuALQgA&oe=6AD0F8C7"}, {"file_name": "5 (1).png", "id": "826808915135470", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75404385_826808918468803_7339830255906415332_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZuL8Cwoyz0Q7kNvwH3Uszt&_nc_oc=AdqE-7vYrlNV_fx3APEPQvy2t7uFBXnBYgBIV25JZ9TrZyUD4qxK71HvLBETet48mZs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLWUkDEN_weX_Y3qnCs0KbMIT7c_vSLvqis8d86EFzzg&oe=6AD0F8AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (1).png", "id": "495657506005616", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75196229_495657512672282_1984150092161742931_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDxGoOnU9t4Q7kNvwGPIdAt&_nc_oc=AdoAca4GVhGLqOvRq9rrAFyBdDK-Hdk-yys-h0Pcx1cT2aw9WgtUz3FzgekeKc0Nj2k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9rNwf4YVRm8xc78Otobyw55KUP6LZpgfUs9A0PcB3TQ&oe=6AD0F641"}, "display_name": "Sugar Mess\u2014Let's Play Jolly Battle", "keywords": [], "long_description": "Sugar Mess\u2014Let's Play Jolly Battle is a fun arcade first-person shooter for the whole family!\nEmbark on a journey through the amazing levels of the Sugar Kingdom! Fend off the attacks of hilarious yummy enemies that shatter into pieces on impact!\nMake use of your vast arsenal of weapons that get stronger as you use them. Use special items to gain an advantage over your opponents.\nChallenge mighty bosses, use their weak spots to defeat them!\nOther exciting activities are waiting for you: solve challenging puzzles, ride in a unique vehicle around the kingdom, feel the rhythm and participate in musical performances!\nDive into a fairy tale world and find out th
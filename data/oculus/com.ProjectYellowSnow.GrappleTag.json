scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRPm0uEZ3oixMPYGgom4e2O5aOJ0AruHoraeQiE_xrOA&oe=6B030710"}, {"file_name": "Pic8.png", "id": "974766515120606", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823366_974766518453939_1529589863988486316_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0AoUuEkHhUQ7kNvwE6Qeub&_nc_oc=AdqjrCCXNs5hOo4JjrW0xDmAixa1sE67HmjsOmkW3SMwraBdngkFbymnQYMN0lmDJeo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjud8H8VmkZu3guCVT1jEPmxUkJGE1x7VpN0A_fN7YCA&oe=6B0335DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grapple_Tag_Universal_Basic_2560x1440.png", "id": "977070694840503", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_977070701507169_9091913246025926319_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVCHjVH-TpgQ7kNvwG-GGRw&_nc_oc=Ado-alLP9qurcTJq6XjgL4xfvX3cquk_iNOrW6OyIYi31lO52hZ0OPEsNFzdKooEpdQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlmJE-MAoSTS90NKEWO_945SUALG80JjfohQadhn_7iA&oe=6B03131E"}, "display_name": "Grapple Tag", "keywords": [], "long_description": "Grapple. Chase. Escape. TAG!\n\nGrapple Tag is a fast-paced VR multiplayer game of movement, skill and chaos! Use your grapple hook to swing, climb and launch yourself around the map while chasing down your opponents \u2014 or desperately trying to escape them.\n\nMaster the grapple, find creative routes, outmaneuver your friends and become the ultimate tag champion!\n\n\ud83e\ude9d Grapple & swing around the environment\n\ud83c\udfc3 Chase and escape other players\n\ud83d\uddfa\ufe0f Explore movement-focused maps\n\ud83d\udc65 Play with friends and cause chaos\n\ud83e\udd7d Built from the ground up for VR\n\nHow fast can you run when everyone is trying to tag you?", "short_description": "Swing around places while trying to tag friends with your net."}]}, "developer_name": null, "developer_privacy_policy_url":
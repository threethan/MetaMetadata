scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfwRGB9JPAwOLRReYKmabgasFckgwfocBFq3skoPb3Tw&oe=6B0B2850"}, {"file_name": "Pic8.png", "id": "974766515120606", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823366_974766518453939_1529589863988486316_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-JWDGrYPMYQ7kNvwGUBnGI&_nc_oc=Adr9qhaOgF3G5vrvEayfYNN3mJku_p4qLb5u5GbIDHDzxB6L7Rnl_a26Wc79HvYc-9I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVsMpevXFeuOT_JKAjVbdTDPrB02SV_wv_iJDwNZZOEg&oe=6B0B1EDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grapple_Tag_Universal_Basic_2560x1440.png", "id": "977070694840503", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825462_977070701507169_9091913246025926319_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uH6RYQLWp34Q7kNvwEZ8xXI&_nc_oc=Adr4LvsDDZiiPeN8fdlq38wS3CtnNjS296vSr-jumxH-q6BuU-iF9zfP2dXsHs20Soc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgT60HBTTyTFgQvDLoo-q43sA9l-I3QyFA0-cZDiUW2g&oe=6B0B345E"}, "display_name": "Grapple Tag", "keywords": [], "long_description": "Grapple. Chase. Escape. TAG!\n\nGrapple Tag is a fast-paced VR multiplayer game of movement, skill and chaos! Use your grapple hook to swing, climb and launch yourself around the map while chasing down your opponents \u2014 or desperately trying to escape them.\n\nMaster the grapple, find creative routes, outmaneuver your friends and become the ultimate tag champion!\n\n\ud83e\ude9d Grapple & swing around the environment\n\ud83c\udfc3 Chase and escape other players\n\ud83d\uddfa\ufe0f Explore movement-focused maps\n\ud83d\udc65 Play with friends and cause chaos\n\ud83e\udd7d Built from the ground up for VR\n\nHow fast can you run when everyone is trying to tag you?", "short_description": "Swing around places while trying to tag friends with your net."}]}, "developer_name": null, "developer_privacy_policy_url":
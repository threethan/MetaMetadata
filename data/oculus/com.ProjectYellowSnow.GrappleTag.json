scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5smqWZ4tHSt0HgOXJtcRO8gJ_jG8WI8b-mGEczuXgAQ&oe=6B05AA10"}, {"file_name": "Pic8.png", "id": "974766515120606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_974766518453939_1529589863988486316_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2TVmZZJbZMQ7kNvwG1qC8F&_nc_oc=Adq4f11ygxg7ccrl-ZWXOk5bwf6Z9-3Y1ZA0MMPFOJn_QQQmZNXoYrhqzlKW7qhdFgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNanXXPU3aLZ_aogy2nruJjmBEZ3GNrTy0Utxk0vMeAA&oe=6B05A09F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grapple_Tag_Universal_Basic_2560x1440.png", "id": "977070694840503", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_977070701507169_9091913246025926319_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uF5gDnNG9csQ7kNvwEBiYZg&_nc_oc=AdqElUJ5q2Evgtgn_QeWTarPxYvHZRJAer65r_5nEqU0StpmPWh-BXnLFtE98gYEnYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFnYLDCIvyVt-Aqu41eekxqdWfgmNREdahpfFrwcro4Q&oe=6B05B61E"}, "display_name": "Grapple Tag", "keywords": [], "long_description": "Grapple. Chase. Escape. TAG!\n\nGrapple Tag is a fast-paced VR multiplayer game of movement, skill and chaos! Use your grapple hook to swing, climb and launch yourself around the map while chasing down your opponents \u2014 or desperately trying to escape them.\n\nMaster the grapple, find creative routes, outmaneuver your friends and become the ultimate tag champion!\n\n\ud83e\ude9d Grapple & swing around the environment\n\ud83c\udfc3 Chase and escape other players\n\ud83d\uddfa\ufe0f Explore movement-focused maps\n\ud83d\udc65 Play with friends and cause chaos\n\ud83e\udd7d Built from the ground up for VR\n\nHow fast can you run when everyone is trying to tag you?", "short_description": "Swing around places while trying to tag friends with your net."}]}, "developer_name": null, "developer_privacy_policy_url":
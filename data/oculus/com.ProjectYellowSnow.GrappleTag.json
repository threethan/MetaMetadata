scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuuF25febSHc3KYswQ96NDiSdQGZoip8qVKc-hq33hog&oe=6AFF1290"}, {"file_name": "Pic8.png", "id": "974766515120606", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823366_974766518453939_1529589863988486316_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC-r403RxvwQ7kNvwFHjlb_&_nc_oc=Adp7XX9z5h5gP0ETfJgjDNHXEHcZ4GI-mycr9-e1x_wmcR8hLgl1ISpKmTJYKsvRedw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTpSmtG-OGMa1znIUwnYBitHcShSLaQThKknpdTybh9Q&oe=6AFF091F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grapple_Tag_Universal_Basic_2560x1440.png", "id": "977070694840503", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491825462_977070701507169_9091913246025926319_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPUvrR_ZtowQ7kNvwEu9Wg1&_nc_oc=AdpxbUFgfZNjjdH3gYfn5GAWfocTtFIXJalJYP_QivRZiunOfrv3MCiXp1a2Bn5DiQM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaVFTl01UnAngdLooXZOR9n9juOXWXyBthd6AYR2dEGQ&oe=6AFF1E9E"}, "display_name": "Grapple Tag", "keywords": [], "long_description": "Grapple. Chase. Escape. TAG!\n\nGrapple Tag is a fast-paced VR multiplayer game of movement, skill and chaos! Use your grapple hook to swing, climb and launch yourself around the map while chasing down your opponents \u2014 or desperately trying to escape them.\n\nMaster the grapple, find creative routes, outmaneuver your friends and become the ultimate tag champion!\n\n\ud83e\ude9d Grapple & swing around the environment\n\ud83c\udfc3 Chase and escape other players\n\ud83d\uddfa\ufe0f Explore movement-focused maps\n\ud83d\udc65 Play with friends and cause chaos\n\ud83e\udd7d Built from the ground up for VR\n\nHow fast can you run when everyone is trying to tag you?", "short_description": "Swing around places while trying to tag friends with your net."}]}, "developer_name": null, "developer_privacy_policy_url":
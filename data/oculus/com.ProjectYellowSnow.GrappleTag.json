scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1qTVRHDf5MZ2aOW-_UQRPixuif46HndKUJCb14h0bCg&oe=6B01EDD0"}, {"file_name": "Pic8.png", "id": "974766515120606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823366_974766518453939_1529589863988486316_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0AoUuEkHhUQ7kNvwF-S5Qp&_nc_oc=AdofTXa7KfQvOj099nh9YZPBkNsVv0P3ASzI9KbMWhYSFbE2KZXf29GDddw7hAq6KKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRby3nLKB-ABMG16j94ZjqJszvolXxfcCkqw5RNzSCvDg&oe=6B01E45F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Grapple_Tag_Universal_Basic_2560x1440.png", "id": "977070694840503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825462_977070701507169_9091913246025926319_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVCHjVH-TpgQ7kNvwH0Wsib&_nc_oc=AdqRfsoCFEN7k0faS7MqjYar7ahW8KRyLFLmD2PB_D33Q4VGyA9EJlzhrE0Tp5YM9AI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1DsYBj5361iVKuBovCavH6wLX3wTwGqOvjb_HocjOeg&oe=6B01C19E"}, "display_name": "Grapple Tag", "keywords": [], "long_description": "Grapple. Chase. Escape. TAG!\n\nGrapple Tag is a fast-paced VR multiplayer game of movement, skill and chaos! Use your grapple hook to swing, climb and launch yourself around the map while chasing down your opponents \u2014 or desperately trying to escape them.\n\nMaster the grapple, find creative routes, outmaneuver your friends and become the ultimate tag champion!\n\n\ud83e\ude9d Grapple & swing around the environment\n\ud83c\udfc3 Chase and escape other players\n\ud83d\uddfa\ufe0f Explore movement-focused maps\n\ud83d\udc65 Play with friends and cause chaos\n\ud83e\udd7d Built from the ground up for VR\n\nHow fast can you run when everyone is trying to tag you?", "short_description": "Swing around places while trying to tag friends with your net."}]}, "developer_name": null, "developer_privacy_policy_url":
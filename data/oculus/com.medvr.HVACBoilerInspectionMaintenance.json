QjZ9GgUFcy3Fwg&oe=6A8AF6BB"}, {"file_name": "com.medvr.HVACBoilerInspectionMaintenance-20260709-184518.png", "id": "1543374167390448", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/654867655_1543374170723781_6943246021799121569_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6V33SspQWQQ7kNvwE685Zr&_nc_oc=Ado_aeAttB16PSWZJM68IqazNCJsUecjMCeP-b3mEvU6qK1jAuJPb0BxCTYXN6zbVrs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQPFVTtAr30U6EWi3XZs0yCDxKO6X11_jCiW4AZmxGig&oe=6A8AC301"}, {"file_name": "com.medvr.HVACBoilerInspectionMaintenance-20260709-184558.png", "id": "1580336753431927", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499624983_1580336756765260_5960406402915855776_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-4znUztZt0Q7kNvwHs6x1i&_nc_oc=Adp5MhS67K0lyc8CZajILrZQJmF_sWUjM56YMr9jC91a97Ws_Ytwkv17i6jrqDL4jLM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm1WtxR3WKVjwL4OxUn4HcF_NYESBEZAeI-Or6LTFiIA&oe=6A8AC346"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Boiler Inspection & Maintenance", "keywords": [], "long_description": "HVAC Boiler Inspection & Maintenance is the official virtual reality training application for the ImmerseLearn HVAC Boiler Inspection & Maintenance Micro-Credential Program. Designed to complement instructor-led and online learning, this immersive simulation enables learners to develop practical skills in a safe, interactive environment.\n\nThrough realistic hands-on scenarios, learners practice boiler inspection procedures, preventive maintenance tasks, component identification, safety protocols, operational checks, and basic troubleshooting techniques while following industry best practices.\n\nImportant:  This application is not a standalone training product. It is available exclusively to individuals enrolled in the ImmerseLearn HVAC Boiler Inspection & Maintenance Micro-Credential Program. Only authorized learners with program access can use this application as part of their required hands-on VR training.", "short_description": "HVAC Boiler Inspection & Maintenance is the VR hands-on training application for the ImmerseLearn HVAC Boiler Inspection & Maintenance Micro-Credential Program. This application is intended exclusively for enrolled learners and provides immersive, real-world practice in boiler inspection, preventive maintenance, safety procedures, and troubleshooting. Access is available only to users enrolled in the ImmerseLearn program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1632742492185889"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1044180041600729"}]}, "baseline_offer": {"id": "1044180041600729"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783925820, "status": "PUBLISHED", "id": "1044180041600729"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1643756187751186", "version": "1.9"}, "id": "1526289348977855", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binar
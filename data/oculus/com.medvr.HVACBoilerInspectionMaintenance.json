9182_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hpu2495VWjQQ7kNvwGzHKsC&_nc_oc=AdoJPsPaNEZ9linc4PO60r7LhPSISmo_kyiD8EtcKVLMHOjaCr4DkC_N54yZtkzN1Og&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWliKgAX_RnUYMcuttqKORBPm8NeBsyrr9yhCOJg-wOA&oe=6AD0D63B"}, {"file_name": "com.medvr.HVACBoilerInspectionMaintenance-20260709-184518.png", "id": "1543374167390448", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/654867655_1543374170723781_6943246021799121569_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js8EtmG89lUQ7kNvwHOfv8r&_nc_oc=AdqOfUZ5ooTHJYkZmG8TGUOAwHEvQCK8lAjywSh7x4pC4s2xtzhTvkiTHELKcuqxuds&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYaMKGSoRe8BPFjGZsezapNFAW3M5FIlykQ0RkR7swsA&oe=6AD0DAC1"}, {"file_name": "com.medvr.HVACBoilerInspectionMaintenance-20260709-184558.png", "id": "1580336753431927", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499624983_1580336756765260_5960406402915855776_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIp2Fl7VVfEQ7kNvwFTY6kl&_nc_oc=AdqDS7WmL9n7gbdxvcVSt2S1xSuvnAIeBoMZKIlTUCVhwZrmXcyKbQ2KVUQ4zgwRGww&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWFLI6Tbal992ztTk46JLo59C7K-5xzrqe-AifgqfcBQ&oe=6AD0DB06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Boiler Inspection & Maintenance", "keywords": [], "long_description": "HVAC Boiler Inspection & Maintenance is the official virtual reality training application for the ImmerseLearn HVAC Boiler Inspection & Maintenance Micro-Credential Program. Designed to complement instructor-led and online learning, this immersive simulation enables learners to develop practical skills in a safe, interactive environment.\n\nThrough realistic hands-on scenarios, learners practice boiler inspection procedures, preventive maintenance tasks, component identification, safety protocols, operational checks, and basic troubleshooting techniques while following industry best practi
4qLnlBSA2MEH3_XWjdOW1J9W8ecamEFDQDykMgzNSjDR5bw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YP_R4cC5AvYN-Q24UJAJR5lrMUc6hhxM_Hfyc3C_6Mw&oe=6A39312B"}, {"file_name": "3.png", "id": "482658897345831", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974715_482658900679164_3239565535811338444_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRZUihQ8kl8Q7kNvwFTaja_&_nc_oc=Adprbi91oNcPc7uf79FL7wZj531odA3IkMey8mwhtDcVNr9jYaXjMt0Qtjru2uzoIM4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OH-vd12Cu_41GznEMthOFOcH5Vap0dNj9PCeLHK2qOQ&oe=6A393E87"}, {"file_name": "4.png", "id": "658102766066176", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57572924_658102769399509_3239659691922919918_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNWUPsT4DckQ7kNvwGioGrw&_nc_oc=AdrlieqmImEe20fVbzkCbfBl0uJK9J4Hf5YlUuMMkm1WkfbSs0Y7en-EujG_b1t8c9o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7Mx-ZTguf9rREWdlVD1ibp7pU8VTMgAXcK4xICWzuVw&oe=6A395519"}, {"file_name": "5.png", "id": "2027968157404636", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974574_2027968160737969_3804447948726642766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbTBe4hWzjgQ7kNvwHgcoF8&_nc_oc=AdqbtFY_8muwZYVntx5Z6TXJQoB2HUc93y3gXTeKKlc7J_q9o0vN6FzfHKcX646UY9E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ok-m7CbTzaVArHee0CcoadIOyx_rNVxFUEfQaEShc3Q&oe=6A394824"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "333.png", "id": "2533816263426523", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982518_2533816266759856_456023630032186234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBOFuutc9sQQ7kNvwHfN1KR&_nc_oc=AdpPLdnePa5MYcgIsgct7uDVlvyGEI9VG4Pz8Ruy1bUsAgPX7yadst6HI6EQ3noRqRA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HpXkFGBFqCq-pNnaecPA5rQSY-JwV2INYkFfu8alE8Q&oe=6A39470D"}, "display_name": "Lonely Shooter", "keywords": [], "long_description": "Maybe you're the last one, maybe you're in the middle of nowhere. But it doesn't matter, all you need to do is hold your weapon, fight on, grow up, BREAK groups of enemies.\nLonely Shooter is a first person VR shooter survival game. There are a variety of weapons, different weapon active skills and the player's passive skills can choose in this game. Try different combinations, defeat wave after wave of monsters, challenge bosses.\nYou can earn a new weapon after winning a certain wave. Each weapon has an active skill that can be used. You can have multiple weapons at the same time, and your right hand and left hand can switch weapons at will.\nAfter a wave victory, you can also choose a passive skill. Each passive skill can be repeatedly selected to level up to level 4.\nThe current version only has Endless mode. Challenge to reach higher waves.\n", "short_description": "Maybe you're the last one, maybe you're in the middle of nowhere, But it doesn't matter, all you need to do is hold your weapon, fight on, grow up, BREAK groups of enemies.\nLonely Shooter is a first person VR shooter survival game. There are a variety of weapons, different weapon active skills and the player's passive skills can choose in this game.\nThe current version only has Endless mode. Challenge to reach higher waves\n"}, {"images": {"nodes": []}, "id": "466284875684874", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5b64\u5352\u6210\u5c06", "keywords": [], "long_description": "\u6216\u8bb8\u4f60\u662f\u6700\u540e\u4e00\u4eba\uff0c\u6216\u8bb8\u4f60\u5728\u67d0\u4e2a\u4e0d\u77e5\u540d\u7684\u5730\u65b9\uff0c\u4f46\u662f\u8fd9\u4e9b\u90fd\u4e0d\u91cd\u8981\u3002\u9700\u8981\u505a\u7684\u53ea\u662f\uff0c\u63e1\u7d27\u6b66\u5668\uff0c\u6218\u6597\u4e0b\u53bb\uff0c\u6210\u957f\u4e0b\u53bb\uff0c\u6253\u788e\u90a3\u4e9b\u6e90\u6e90\u4e0d\u65ad\u7684\u654c\u4eba\uff01\n\u5b64\u5352\u6210\u5c06\u662f\u4e00\u6b3e\u7b
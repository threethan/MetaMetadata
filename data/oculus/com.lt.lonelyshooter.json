eQXQ2QOJCYxSq6fihbGgeZtaBDE5HuwLpN3r36g&oe=69A6DAAB"}, {"file_name": "3.png", "id": "482658897345831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974715_482658900679164_3239565535811338444_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPrg0XFdT7IQ7kNvwF6j8tG&_nc_oc=AdmGh3iKyEGohELUKgXfMFiIlXAjIxkBhEwEkDMGJUhh7KZvQx7BD-6PHozUySaao5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvH-PNlns94xOPaH13ThB-v3IUgf8dSvXBZ74kJv4Xk8w&oe=69A6E807"}, {"file_name": "4.png", "id": "658102766066176", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572924_658102769399509_3239659691922919918_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ew546kq23iAQ7kNvwHd5XCZ&_nc_oc=AdmB6nWWxgoVHfd4LQXgnPjDyeI7elRtQ6D_uUlDDn3buhXHeeEapyJ9VQFRxHHBaGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu2prrDfu5fe8nYSuddowM8kK3eCyBCc--BwM4eBQy9Nw&oe=69A6C659"}, {"file_name": "5.png", "id": "2027968157404636", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974574_2027968160737969_3804447948726642766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJ0l6lzE9V8Q7kNvwEEPeW3&_nc_oc=Adk575Kc1xBK8q-T2XzviGx_wxdh_K1QswtJ1fg58ssv0-izq4srxRH2oVK9jGjgTPM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuS3iEeQ3U59X28cIGprKSjw82dByB-Q38c-ZI6iT9Pcg&oe=69A6F1A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "333.png", "id": "2533816263426523", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982518_2533816266759856_456023630032186234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpFD6yFqK04Q7kNvwHUFbnf&_nc_oc=Adlp3l4lVUrpbusIb58_D9VvFyJ9C-8a9UXA7NMH0uFyzOYkypdkfhTd9fnNqdU--jw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvL-erpI0UplyeBKDfba2GdN3LYAWiF6C4EMcezP613Xw&oe=69A6F08D"}, "display_name": "Lonely Shooter", "keywords": [], "long_description": "Maybe you're the last one, maybe you're in the middle of nowhere. But it doesn't matter, all you need to do is hold your weapon, fight on, grow up, BREAK groups of enemies.\nLonely Shooter is a first person VR shooter survival game. There are a variety of weapons, different weapon active skills and the player's passive skills can choose in this game. Try different combinations, defeat wave after wave of monsters, challenge bosses.\nYou can earn a new weapon after winning a certain wave. Each weapon has an active skill that can be used. You can have multiple weapons at the same time, and your right hand and left hand can switch weapons at will.\nAfter a wave victory, you can also choose a passive skill. Each passive skill can be repeatedly selected to level up to level 4.\nThe current version only has Endless mode. Challenge to reach higher waves.\n", "short_description": "Maybe you're the last one, maybe you're in the middle of nowhere, But it doesn't matter, all you need to do is hold your weapon, fight on, grow up, BREAK groups of enemies.\nLonely Shooter is a first person VR shooter survival game. There are a variety of weapons, different weapon active skills and the player's passive skills can choose in this game.\nThe current version only has Endless mode. Challenge to reach higher waves\n"}, {"images": {"nodes": []}, "id": "466284875684874", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5b64\u5352\u6210\u5c06", "keywords": [], "long_description": "\u6216\u8bb8\u4f60\u662f\u6700\u540e\u4e00\u4eba\uff0c\u6216\u8bb8\u4f60\u5728\u67d0\u4e2a\u4e0d\u77e5\u540d\u7684\u5730\u65b9\uff0c\u4f46\u662f\u8fd9\u4e9b\u90fd\u4e0d\u91cd\u8981\u3002\u9700\u8981\u505a\u7684\u53ea\u662f\uff0c\u63e1\u7d27\u6b66\u5668\uff0c\u6218\u6597\u4e0b\u53bb\uff0c\u6210\u957f\u4e0b\u53bb\uff0c\u6253\u788e\u90a3\u4e9b\u6e90\u6e90\u4e0d\u65ad\u7684\u654c\u4eba\uff01\n\u5b64\u5352\u6210\u5c06\u662f\u4e00\u6b3e\u7b2c\u4e00\u4eba\u79f0VR\u5c04\u51fb\u751f\u5b58\u6e38\u620f\u3002\u5728\u6e38\u620f\u4e2d\u5177\u6709\u591a\u79cd\u7684\u6b66\u5668\u9009\u62e9\uff0c\u4e0d\u540c\u7684\u6b66\u5
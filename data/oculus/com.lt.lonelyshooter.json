uNFdIs7hezMM-FGT7DxOMeQE1pI5Hf6aezC2pGiqCE2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsL2PqsNSEh1KtMDLVx7FQTYpW2TUAd-1FCx02LnzZng&oe=6AF49E6B"}, {"file_name": "3.png", "id": "482658897345831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974715_482658900679164_3239565535811338444_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cW8fvIqwH-QQ7kNvwEBv7D7&_nc_oc=Adr_UrdQGeQcfxVUVtK3vD4YxTz3nLWDBXTKJEJ4PZW_aQ7QdiIjuFC2Ibb_HYuiQyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLeUuDM5hBvWByviS-OewYf4ZkDFAilDZ6KY3eTbd17w&oe=6AF47387"}, {"file_name": "4.png", "id": "658102766066176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572924_658102769399509_3239659691922919918_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNY7qzvhiCAQ7kNvwGtsRtZ&_nc_oc=AdqHlnNyvczRg8UO2dhb6XkOX7XaxxSpJ4iJGoRmD2Er4jMFsuZ7i2aSWViuWHUWF7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS86Vek5FF5FRH59zNiifXtzJvK6A1IWRPlX0vF7zFYfw&oe=6AF48A19"}, {"file_name": "5.png", "id": "2027968157404636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_2027968160737969_3804447948726642766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfqfJO0ofRUQ7kNvwEtp3pl&_nc_oc=AdpTVjVh8ndVseG9v50zzJcIFHreocWVdkz38VMKlRQI2FTmluDfKfWl6T6-NRXrI-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZVAeaSVWtIxBGe23WEWCAPn2Mbds_JeqjPF73JxHt7g&oe=6AF47D24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "333.png", "id": "2533816263426523", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982518_2533816266759856_456023630032186234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULtqoeH5iZcQ7kNvwHWncB1&_nc_oc=Ado17_yCrI-6Qv6uvyqCiIvczE_de1C8HIriE2hq-iNDIorxdrj16t1aKNnX4J5iCLs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8vQYwchxYCnOM8p4slOuOjpN7NlfMixzAdYSLrZgE0A&oe=6AF47C0D"}, "display_name": "Lonely Shooter", "keywords": [], "long_description": "Maybe you're the last one, maybe you're in the middle of nowhere. But it doesn't matter, all you need to do is hold your weapon, fight on, grow up, BREAK groups of enemies.\nLonely Shooter is a first person VR shooter survival game. There are a variety of weapons, different weapon active skills and the player's passive skills can choose in this game. Try different combinations, defeat wave after wave of monsters, challenge bosses.\nYou can earn a new weapon after winning a certain wave. Each weapon has an active skill that can be used. You can have multiple weapons at the same time, and your right hand and left hand can switch weapons at will.\nAfter a wave victory, you can also choose a passive skill. Each passive skill can be repeatedly selected to level up to level 4.\nThe current version only has Endless mode. Challenge to reach higher waves.\n", "short_description": "Maybe you're the last one, maybe you're in the middle of nowhere, But it doesn't matter, all you need to do is hold your weapon, fight on, grow up, BREAK groups of enemies.\nLonely Shooter is a first person VR shooter survival game. There are a variety of weapons, different weapon active skills and the player's passive skills can choose in this game.\nThe current version only has Endless mode. Challenge to reach higher waves\n"}, {"images": {"nodes": []}, "id": "466284875684874", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5b64\u5352\u6210\u5c06", "keywords": [], "long_description": "\u6216\u8bb8\u4f60\u662f\u6700\u540e\u4e00\u4eba\uff0c\u6216\u8bb8\u4f60\u5728\u67d0\u4e2a\u4e0d\u77e5\u540d\u7684\u5730\u65b9\uff0c\u4f46\u662f\u8fd9\u4e9b\u90fd\u4e0d\u91cd\u8981\u3002\u9700\u8981\u505a\u7684\u53ea\u662f\uff0c\u63e1\u7d27\u6b66\u5668\uff0c\u6218\u6597\u4e0b\u53bb\uff0c\u6210\u957f\u4e0b\u53bb\uff0c\u6253\u788e\u90a3\u4e9b\u6e90\u6e90\u4e0d\u65ad\u7684\u654c\u4eba\uff01\n\u5b64\u5352\u6210\u5c06\u662f\u4e00\u6b3e\u7b2c\u4e
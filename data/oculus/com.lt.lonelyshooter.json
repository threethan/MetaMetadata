u79VxcbnGvpBOmfOeKF3Uo1d6p_7BvwbnvlkAColh13k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qAGWMsj1czNc3ls8IcSTe8vLQa5I2ecXjitvVETJ6Qw&oe=6A2AB0AB"}, {"file_name": "3.png", "id": "482658897345831", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974715_482658900679164_3239565535811338444_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESAj46WHw5UQ7kNvwGkFMKe&_nc_oc=AdohjCIYwd6JN2kwBfls5O_-udn_HLECTTKISVt8c2btlood6eyv_HUPgnIpNBAf6NE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cVdpyn9W3zPi9avs07Jz1jph7P7whH2oW8BqNhICPsQ&oe=6A2ABE07"}, {"file_name": "4.png", "id": "658102766066176", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572924_658102769399509_3239659691922919918_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2i95wpwH6QQ7kNvwGGWwu6&_nc_oc=AdrwkysyUk_gqMwa9a1crKNXYORX6pTHqtomG-qCvO5S_rGjBA_wUjho6wxhRfh1GyU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OpJzoQ55QTttSJnV-00_TnHVuO0PC7Y7y03qIyIntHg&oe=6A2AD499"}, {"file_name": "5.png", "id": "2027968157404636", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974574_2027968160737969_3804447948726642766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEr-NaekHn4Q7kNvwHXuw80&_nc_oc=AdooDkjN3fuW4R54Wdsemuuf6HuDfiiNvsG8yI0mYvGXNoqnpSDzCAATUOefWFeCvOk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-_nBmlb9Z2A9W4uqWMJ_Y-qB-H7wFvK7863YxpQHnlw&oe=6A2AC7A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "333.png", "id": "2533816263426523", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982518_2533816266759856_456023630032186234_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3JO3U0pR4QQ7kNvwEPE_fj&_nc_oc=Adq3wHLclTUOcH8Mv3Va2zA23URBpjetZB9PaM4Zuemenw1ZvchpANbL7qSgkWsW33w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2-Mq_Y7Eq2o76Nau6U9UUP4Voa_vPPRCkqJUhO4xddg&oe=6A2AC68D"}, "display_name": "Lonely Shooter", "keywords": [], "long_description": "Maybe you're the last one, maybe you're in the middle of nowhere. But it doesn't matter, all you need to do is hold your weapon, fight on, grow up, BREAK groups of enemies.\nLonely Shooter is a first person VR shooter survival game. There are a variety of weapons, different weapon active skills and the player's passive skills can choose in this game. Try different combinations, defeat wave after wave of monsters, challenge bosses.\nYou can earn a new weapon after winning a certain wave. Each weapon has an active skill that can be used. You can have multiple weapons at the same time, and your right hand and left hand can switch weapons at will.\nAfter a wave victory, you can also choose a passive skill. Each passive skill can be repeatedly selected to level up to level 4.\nThe current version only has Endless mode. Challenge to reach higher waves.\n", "short_description": "Maybe you're the last one, maybe you're in the middle of nowhere, But it doesn't matter, all you need to do is hold your weapon, fight on, grow up, BREAK groups of enemies.\nLonely Shooter is a first person VR shooter survival game. There are a variety of weapons, different weapon active skills and the player's passive skills can choose in this game.\nThe current version only has Endless mode. Challenge to reach higher waves\n"}, {"images": {"nodes": []}, "id": "466284875684874", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5b64\u5352\u6210\u5c06", "keywords": [], "long_description": "\u6216\u8bb8\u4f60\u662f\u6700\u540e\u4e00\u4eba\uff0c\u6216\u8bb8\u4f60\u5728\u67d0\u4e2a\u4e0d\u77e5\u540d\u7684\u5730\u65b9\uff0c\u4f46\u662f\u8fd9\u4e9b\u90fd\u4e0d\u91cd\u8981\u3002\u9700\u8981\u505a\u7684\u53ea\u662f\uff0c\u63e1\u7d27\u6b66\u5668\uff0c\u6218\u6597\u4e0b\u53bb\uff0c\u6210\u957f\u4e0b\u53bb\uff0c\u6253\u788e\u90a3\u4e9b\u6e90\u6e90\u4e0d\u65ad\u7684\u654c\u4eba\uff01\n\u5b64\u5352\u6210\u5c06\u662f\u4e00\u6b3e\u7b2c\u4e
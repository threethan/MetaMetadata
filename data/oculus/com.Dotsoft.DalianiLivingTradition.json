ani-20260505-152145.png", "id": "1459990641994438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823905_1459990645327771_3687014525619409846_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6P0qEST98kQ7kNvwFVRc2L&_nc_oc=Adp6mFy94eRxYOqDFbjPz3mefPgR3FAPKp__lsmO_BBvSZd1OJ643aZnczDqcYTFjyE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_biifCKlyyFXe_EudZBA0mVUMae4XbkJORTBfrMcfLpA&oe=6A2EB230"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daliani: Living Tradition", "keywords": ["heritage", "fishing", "game", "narrative", "story"], "long_description": "In Daliani: Living Tradition, you become Apostolis, a 17-year-old visiting his uncle Petros at a traditional fishing installation in Preveza for the first time.\n\nFrom the viewpoint on the tower, you listen to local fishermen, answer dialogue prompts, and learn how the net, winches, timing, and observation shape the Daliani fishing method. Use the mechanisms to prepare the trap, watch fish move through the water, and choose the right moment to close the net, to ensure the most successful catch.\n\nBlending guided storytelling, challenge, and cultural heritage, this VR experience introduces players to a rare fishing tradition of the Ambracian Gulf.", "short_description": "Step onto a tower in the Ambracian Gulf and learn the traditional Ntaliani fishing technique through an interactive VR story."}, {"images": {"nodes": [{"file_name": "Daliani Icon v5.png", "id": "2209404989875952", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_2209404993209285_757507465839310618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qss6aq1sAqoQ7kNvwGYhiR2&_nc_oc=Adrvc8sIzeNZVstxPiCA-bOGS7phdOx95cgeisjc9iY7Zr-7YcrdMfSARz3pwYCSiRo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sHMZkaAp5bZzZUUy9pUUhyV64cN_NPvqgUqiGWub5dw&oe=6A2EB584"}, {"file_name": "Daliani_CoverImageSafeAreaTemplateHero_gr.png", "id": "2189045815203185", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823270_2189045818536518_1197449426069608052_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enSBPtSOon0Q7kNvwHiYxs9&_nc_oc=AdrDsCGxsuE_gC8HJRSr4jDGuRfdRDhFYDFRHJpNENSnjqL1YIdYbwpgko8gf-yjUVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h56voPZ52BGWFv2UMTtEbcys_zzDdyYq1vAl4AQLiZA&oe=6A2EC0F3"}, {"file_name": "Daliani_CoverImageSafeAreaTemplateLandscape_gr.png", "id": "1772726590372627", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1772726593705960_4264978315132988550_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86AUIlh5V4oQ7kNvwHoscyq&_nc_oc=Ado29MOtOxRHMmsf3hJyQqMZh7u1fuBlYVeFgZLQTcyUI0_J4JN-98-npNbmHGGIYZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qTuAM1B2PgZE5f3dY5C1lZzWK585AbDwO2bZZBGuJPA&oe=6A2EC9FF"}, {"file_name": "Daliani_CoverImageSafeAreaTemplatePortrait_gr.png", "id": "1583897133145655", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818849_1583897136478988_5796830830848411987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rC4XUpcBTlQQ7kNvwEgCAzZ&_nc_oc=Adqdoc4oaiGSl-H1ceq6kqPRgD0rxSak8VlhJvUf6s7D1g_IuwITKMcfKiqsxNn5Trs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fnqHH-DE3py7sREeWpAsWDvFy9t3fcqyNq7wBDIvqzg&oe=6A2EB860"}, {"file_name": "Daliani_CoverImageSafeAreaTemplateSquare_gr.png", "id": "1546951613721263", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1546951617054596_8071610752796397453_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBoY9HUU20wQ7kNvwHO3pWG&_nc_oc=AdoTd6WHGddGLPJzM0Lhq1v9SlazwYfzkBkWuABpPd5lMzS_aP9AcZ9ZsTshTHFu1CY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KpVJ2uHFmOFv08k63W5MsX47IxdnyCohmbfaIYYbq2Q&oe=6A2EAC2D"}]}, "id": "983462414367070", "locale": "el_GR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9: \u0396\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7", "keywords": ["\u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7", "\u03a8\u03ac\u03c1\u03b5\u03bc\u03b1", "\u03a0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9", "\u0391\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7", "\u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1"], "long_description": "\u03a3\u03c4\u03bf \u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9: \u0396\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7, \u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c4\u03bf\u03bd \u03c1\u03cc\u03bb\u03bf \u03c4\u03bf\u03c5 \u0391\u03c0\u03bf\u03c3\u03c4\u03cc\u03bb\u03b7, \u03b5\u03bd\u03cc\u03c2 17\u03c7\u03c1\u03bf\u03bd\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b5\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c6\u03bf\u03c1\u03ac \u03c4\u03bf \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9 \u03c4\u03bf\u03c5 \u03b8\u03b5\u03af\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03a0\u03ad\u03c4\u03c1\u03bf\u03c5 \u03c3\u03c4\u03b7\u03bd \u03a0\u03c1\u03ad\u03b2\u03b5\u03b6\u03b1.\n\n\u0391\u03c0\u03cc \u03c4\u03bf\u03bd \u03c0\u03cd\u03c1\u03b3\u03bf, \u03b1\u03ba\u03bf\u03cd\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03c8\u03b1\u03c1\u03ac\u03b4\u03b5\u03c2, \u03b5\u03bc\u03c0\u03bb\u03ad\u03ba\u03b5\u03c3\u03b1\u03b9 \u03c3\u03b5 \u03b4\u03b9\u03b1\u03bb\u03cc\u03b3\u03bf\u03c5\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03b1\u03b8\u03b1\u03af\u03bd\u03b5\u03b9\u03c2 \u03c0\u03ce\u03c2 \u03c4\u03bf \u03b4\u03af\u03c7\u03c4\u03c5, \u03b7 \u03c0\u03b1\u03c1\u03b1\u03c4\u03ae\u03c1\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c4\u03bf \u03c3\u03c9\u03c3\u03c4\u03cc timing \u03c3\u03c5\u03bd\u03b8\u03ad\u03c4\u03bf\u03c5\u03bd \u03c4\u03b7\u03bd \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ae \u03c4\u03bf\u03c5 \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9. \u03a7\u03b5\u03b9\u03c1\u03af\u03c3\u03bf\u03c5 \u03c4\u03bf\u03c5\u03c2 \u03bc\u03b7\u03c7\u03b1\u03bd\u03b9\u03c3\u03bc\u03bf\u03cd\u03c2, \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03cd\u03b8\u03b7\u03c3\u03b5 \u03c4\u03b1 \u03ba\u03bf\u03c0\u03ac\u03b4\u03b9\u03b1 \u03c8\u03b1\u03c1\u03b9\u03ce\u03bd \u03ba\u03b1\u03b9 \u03b4\u03b9\u03ac\u03bb\u03b5\u03be\u03b5 \u03c4\u03b7 \u03c3\u03c9\u03c3\u03c4\u03ae \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03ba\u03bb\u03b5\u03af\u03c3\u03b5\u03b9\u03c2 \u03c4\u03b7\u03bd \u03c0\u03b1\u03b3\u03af\u03b4\u03b1, \u03ce\u03c3\u03c4\u03b5 \u03bd\u03b1 \u03b5\u03c0\u03b9\u03c4\u03cd\u03c7\u03b5\u03b9\u03c2 \u03c4\u03b7 \u03bc\u03ad\u03b3\u03b7\u03c3\u03c4\u03b7 \u03c8\u03b1\u03c1\u03b9\u03ac!\n\n\u039c\u03b9\u03b1 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b7 VR \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b4\u03c5\u03ac\u03b6\u03b5\u03b9 \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7, \u03c0\u03c1\u03cc\u03ba\u03bb\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae \u03ba\u03bb\u03b7\u03c1\u03bf\u03bd\u03bf\u03bc\u03b9\u03ac, \u03b6\u03c9\u03bd\u03c4\u03b1\u03bd\u03b5\u03cd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b7 \u03c3\u03c0\u03ac\u03bd\u03b9\u03b1 \u03b1\u03bb\u03b9\u03b5\u03c5\u03c4\u03b9\u03ba\u03ae \u03c0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7 \u03c4\u03bf\u03c5 \u0391\u03bc\u03b2\u03c1\u03b1\u03ba\u03b9\u03ba\u03bf\u03cd \u039a\u03cc\u03bb\u03c0\u03bf\u03c5.", "short_description": "\u0391\u03c0\u03cc \u03c4\u03bf\u03bd \u03c0\u03cd\u03c1\u03b3\u03bf \u03c4\u03bf\u03c5 \u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9 \u03c3\u03c4\u03bf\u03bd \u0391\u03bc\u03b2\u03c1\u03b1\u03ba\u03b9\u03ba\u03cc \u03b3\u03bd\u03ce\u03c1\u03b9\u03c3\u03b5 \u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03b1\u03b4\u03bf\u03c3\u03b9\u03b1\u03ba\u03ae \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ae \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9 \u03bc\u03ad\u03c3\u03b1 \u03b1\u03c0\u03cc \u03bc\u03b9\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03ae VR \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dotsoft.gr/en/privacy-policy-app-daliani-living-tradition", "developer_terms_of_service_url": null, "publisher_name": "DOTSOFT SA", "support_website_url": null, "website_url": "https://dotsoft.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26912401901704676"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "991358376591303"}]}, "baseline_offer": {"id": "991358376591303"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779345180, "status": "PUBLISHED", "id": "991358376591303"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27260458626899000", "version": "0.6.4"}, "id": "941944482074655", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": 
60505-152006.png", "id": "1007960685001694", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499624700_1007960688335027_8508758570384968444_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_Mt8z2zYb8Q7kNvwEUa35O&_nc_oc=AdqCGtm1gecAqXoIYfn93_ry_ZJ9GyKQzwYzRDCF4ArJcKZi7iKomlb1dLFXt-55-lQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgLwKh34ZTB3xgvPUJKxdvemMrQdeLhS2dJSOC9ccfGQ&oe=6A8ACD26"}, {"file_name": "com.Dotsoft.Daliani-20260505-152154.png", "id": "1259224769624969", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830467_1259224772958302_5944639226009981632_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0y02SlfbhYQ7kNvwE2cauz&_nc_oc=Adoh0Qx8Ii4mbF1FB6SAA4ApcAtCR5YS6YsZIzrmR-jZDqTjstxWzw4J0gKhhCyvxeI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxGdQ0s8Vq6iowbxC7mbTX9LEQM73lbwSZgyX6d1LYqw&oe=6A8AEC75"}, {"file_name": "com.Dotsoft.Daliani-20260505-152135.png", "id": "943990228508203", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819859_943990231841536_5409489005583405348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHGyWuj2PAkQ7kNvwES7XxY&_nc_oc=Adr9ThWLBf3m1z2FZjC7PxgEYdUz01458JAd4mKcB9djYXaf6tS9QsvlgTNZQs_In9A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETSYkJvdxdnKGLUm6783LRGRmWRDxwU258v5ueZStgZQ&oe=6A8ACA00"}, {"file_name": "com.Dotsoft.Daliani-20260505-152145.png", "id": "1459990641994438", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823905_1459990645327771_3687014525619409846_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvWQ3yufaF8Q7kNvwEyyTW8&_nc_oc=AdphfrtmvtiyVSfL81hFVWckqfeY2tn6ntLptqddHBDJPfnUJ2rxEY9NSEb3nlgCVEc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8S8uYROi1E_JJIxckYfYZ3IaCX5hgaMHfXBwEfccm0g&oe=6A8AC2F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daliani: Living Tradition", "keywords": ["heritage", "fishing", "game", "narrative", "story"], "long_description": "In Daliani: Living Tradition, you become Apostolis, a 17-year-old visiting his uncle Petros at a traditional fishing installation in Preveza for the first time.\n\nFrom the viewpoint on the tower, you listen to local fishermen, answer dialogue prompts, and learn how the net, winches, timing, and observation shape the Daliani fishing method. Use the mechanisms to prepare the trap, watch fish move through the water, and choose the right moment to close the net, to ensure the most successful catch.\n\nBlending guided storytelling, challenge, and cultural heritage, this VR experience introduces players to a rare fishing tradition of the Ambracian Gulf.", "short_description": "Step onto a tower in the Ambracian Gulf and learn the traditional Ntaliani fishing technique through an interactive VR story."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dotsoft.gr/cookies-policy-daliani-living-tradition/", "developer_terms_of_service_url": null, "publisher_name": "DOTSOFT SA", "support_website_url": null, "website_url": "https://dotsoft.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27603968482548011"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827960_996489166238895_696703513192362962_n.png?stp=dst-png_s3
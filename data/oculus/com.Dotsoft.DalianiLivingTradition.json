oculuscdn.com/v/t64.5771-25/491820141_1546951617054596_8071610752796397453_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEmntKCgoAQQ7kNvwGzAhbe&_nc_oc=Adq0Y4mPuucZfVno48Gj4FjSCjwOu_e7XYH5T5JacgJapYfAB1FN9yd_kQnM62OkMjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU8gVzmc8vA_GJb6R_Oof0K7ATr3dPhO42akd64DBgjg&oe=6B01D46D"}]}, "id": "983462414367070", "locale": "el_GR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9: \u0396\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7", "keywords": ["\u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7", "\u03a8\u03ac\u03c1\u03b5\u03bc\u03b1", "\u03a0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9", "\u0391\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7", "\u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1"], "long_description": "\u03a3\u03c4\u03bf \u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9: \u0396\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7, \u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c4\u03bf\u03bd \u03c1\u03cc\u03bb\u03bf \u03c4\u03bf\u03c5 \u0391\u03c0\u03bf\u03c3\u03c4\u03cc\u03bb\u03b7, \u03b5\u03bd\u03cc\u03c2 17\u03c7\u03c1\u03bf\u03bd\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b5\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c6\u03bf\u03c1\u03ac \u03c4\u03bf \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9 \u03c4\u03bf\u03c5 \u03b8\u03b5\u03af\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03a0\u03ad\u03c4\u03c1\u03bf\u03c5 \u03c3\u03c4\u03b7\u03bd \u03a0\u03c1\u03ad\u03b2\u03b5\u03b6\u03b1.\n\n\u0391\u03c0\u03cc \u03c4\u03bf\u03bd \u03c0\u03cd\u03c1\u03b3\u03bf, \u03b1\u03ba\u03bf\u03cd\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03c8\u03b1\u03c1\u03ac\u03b4\u03b5\u03c2, \u03b5\u03bc\u03c0\u03bb\u03ad\u03ba\u03b5\u03c3\u03b1\u03b9 \u03c3\u03b5 \u03b4\u03b9\u03b1\u03bb\u03cc\u03b3\u03bf\u03c5\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03b1\u03b8\u03b1\u03af\u03bd\u03b5\u03b9\u03c2 \u03c0\u03ce\u03c2 \u03c4\u03bf \u03b4\u03af\u03c7\u03c4\u03c5, \u03b7 \u03c0\u03b1\u03c1\u03b1\u03c4\u03ae\u03c1\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c4\u03bf \u03c3\u03c9\u03c3\u03c4\u03cc timing \u03c3\u03c5\u03bd\u03b8\u03ad\u03c4\u03bf\u03c5\u03bd \u03c4\u03b7\u03bd \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ae \u03c4\u03bf\u03c5 \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9. \u03a7\u03b5\u03b9\u03c1\u03af\u03c3\u03bf\u03c5 \u03c4\u03bf\u03c5\u03c2 \u03bc\u03b7\u03c7\u03b1\u03bd\u03b9\u03c3\u03bc\u03bf\u03cd\u03c2, \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03cd\u03b8\u03b7\u03c3\u03b5 \u03c4\u03b1 \u03ba\u03bf\u03c0\u03ac\u03b4\u03b9\u03b1 \u03c8\u03b1\u03c1\u03b9\u03ce\u03bd \u03ba\u03b1\u03b9 \u03b4\u03b9\u03ac\u03bb\u03b5\u03be\u03b5 \u03c4\u03b7 \u03c3\u03c9\u03c3\u03c4\u03ae \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03ba\u03bb\u03b5\u03af\u03c3\u03b5\u03b9\u03c2 \u03c4\u03b7\u03bd \u03c0\u03b1\u03b3\u03af\u03b4\u03b1, \u03ce\u03c3\u03c4\u03b5 \u03bd\u03b1 \u03b5\u03c0\u03b9\u03c4\u03cd\u03c7\u03b5\u03b9\u03c2 \u03c4\u03b7 \u03bc\u03ad\u03b3\u03b7\u03c3\u03c4\u03b7 \u03c8\u03b1\u03c1\u03b9\u03ac!\n\n\u039c\u03b9\u03b1 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b7 VR \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b4\u03c5\u03ac\u03b6\u03b5\u03b9 \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7, \u03c0\u03c1\u03cc\u03ba\u03bb\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae \u03ba\u03bb\u03b7\u03c1\u03bf\u03bd\u03bf\u03bc\u03b9\u03ac, \u03b6\u03c9\u03bd\u03c4\u03b1\u03bd\u03b5\u03cd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b7 \u03c3\u03c0\u03ac\u03bd\u03b9\u03b1 \u03b1\u03bb\u03b9\u03b5\u03c5\u03c4\u03b9\u03ba\u03ae \u03c0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7 \u03c4\u03bf\u03c5 \u0391\u03bc\u03b2\u03c1\u03b1\
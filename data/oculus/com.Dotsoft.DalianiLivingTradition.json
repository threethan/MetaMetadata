f&oh=00_AQGQJcxyVDsJQIb1VC3fRE-8fPewqKfQKqUgPEYpKps7QQ&oe=6A8D6C20"}, {"file_name": "Daliani_CoverImageSafeAreaTemplateSquare_gr.png", "id": "1546951613721263", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820141_1546951617054596_8071610752796397453_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lA_wKdZWXkUQ7kNvwHZ-Gkc&_nc_oc=Adph_cHhZKlYjRvwPyxhAYmeEz9zAW2Jy7h_TcdG8JuXi-aCVqkz0qfASophiXHts5c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUNiL_lBTwqs4oFjxGp0Vir6da30L4mOwNXxMCN1qN3g&oe=6A8D982D"}]}, "id": "2493874131080707", "locale": "el_GR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9: \u0396\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7", "keywords": ["\u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7", "\u03a8\u03ac\u03c1\u03b5\u03bc\u03b1", "\u03a0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9", "\u0391\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7", "\u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1"], "long_description": "\u03a3\u03c4\u03bf \u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9: \u0396\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7, \u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c4\u03bf\u03bd \u03c1\u03cc\u03bb\u03bf \u03c4\u03bf\u03c5 \u0391\u03c0\u03bf\u03c3\u03c4\u03cc\u03bb\u03b7, \u03b5\u03bd\u03cc\u03c2 17\u03c7\u03c1\u03bf\u03bd\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b5\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c6\u03bf\u03c1\u03ac \u03c4\u03bf \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9 \u03c4\u03bf\u03c5 \u03b8\u03b5\u03af\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03a0\u03ad\u03c4\u03c1\u03bf\u03c5 \u03c3\u03c4\u03b7\u03bd \u03a0\u03c1\u03ad\u03b2\u03b5\u03b6\u03b1.\n\n\u0391\u03c0\u03cc \u03c4\u03bf\u03bd \u03c0\u03cd\u03c1\u03b3\u03bf, \u03b1\u03ba\u03bf\u03cd\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03c8\u03b1\u03c1\u03ac\u03b4\u03b5\u03c2, \u03b5\u03bc\u03c0\u03bb\u03ad\u03ba\u03b5\u03c3\u03b1\u03b9 \u03c3\u03b5 \u03b4\u03b9\u03b1\u03bb\u03cc\u03b3\u03bf\u03c5\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03b1\u03b8\u03b1\u03af\u03bd\u03b5\u03b9\u03c2 \u03c0\u03ce\u03c2 \u03c4\u03bf \u03b4\u03af\u03c7\u03c4\u03c5, \u03b7 \u03c0\u03b1\u03c1\u03b1\u03c4\u03ae\u03c1\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c4\u03bf \u03c3\u03c9\u03c3\u03c4\u03cc timing \u03c3\u03c5\u03bd\u03b8\u03ad\u03c4\u03bf\u03c5\u03bd \u03c4\u03b7\u03bd \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ae \u03c4\u03bf\u03c5 \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9. \u03a7\u03b5\u03b9\u03c1\u03af\u03c3\u03bf\u03c5 \u03c4\u03bf\u03c5\u03c2 \u03bc\u03b7\u03c7\u03b1\u03bd\u03b9\u03c3\u03bc\u03bf\u03cd\u03c2, \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03cd\u03b8\u03b7\u03c3\u03b5 \u03c4\u03b1 \u03ba\u03bf\u03c0\u03ac\u03b4\u03b9\u03b1 \u03c8\u03b1\u03c1\u03b9\u03ce\u03bd \u03ba\u03b1\u03b9 \u03b4\u03b9\u03ac\u03bb\u03b5\u03be\u03b5 \u03c4\u03b7 \u03c3\u03c9\u03c3\u03c4\u03ae \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03ba\u03bb\u03b5\u03af\u03c3\u03b5\u03b9\u03c2 \u03c4\u03b7\u03bd \u03c0\u03b1\u03b3\u03af\u03b4\u03b1, \u03ce\u03c3\u03c4\u03b5 \u03bd\u03b1 \u03b5\u03c0\u03b9\u03c4\u03cd\u03c7\u03b5\u03b9\u03c2 \u03c4\u03b7 \u03bc\u03ad\u03b3\u03b7\u03c3\u03c4\u03b7 \u03c8\u03b1\u03c1\u03b9\u03ac!\n\n\u039c\u03b9\u03b1 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b7 VR \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b4\u03c5\u03ac\u03b6\u03b5\u03b9 \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7, \u03c0\u03c1\u03cc\u03ba\u03bb\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae \u03ba\u03bb\u03b7\u03c1\u03bf\u03bd\u03bf\u03bc\u03b9\u03ac, \u03b6\u03c9\u03bd\u03c4\u03b1\u03bd\u03b5\u03cd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b7 \u03c3\u03c0\u03ac\u03bd\u03b9\u03b1 \u03b1\u03bb\u03b9\u03b5\u03c5\u03c4\u03b9\u03ba\u03ae \u03c0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7 \u03c4\u03bf\u03c5 \u0391\u03bc\u03b2\u03c1\u03b1\u03ba\u03b9\u03ba\u03bf\u03cd \u039a\u03cc\u03bb\u03c0\u03bf\u03c5.", "short_description": "\u0391\u03c0\u03cc \u03c4\u03bf\u03bd \u03c0\u03cd\u03c1\u03b3\u03bf \u03c4\u03bf\u03c5 \u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9 \u03c3\u03c4\u03bf\u03bd \u0391\u03bc\u03b2\u03c1\u03b1\u03ba\u03b9\u03ba\u03cc \u03b3\u03bd\u03ce\u03c1\u03b9\u03c3\u03b5 \u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03b1\u03b4\u03bf\u03c3\u03b9\u03b1\u03ba\u03ae \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ae \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9 \u03bc\u03ad\u03c3\u03b1 \u03b1\u03c0\u03cc \u03bc\u03b9\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03ae VR \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1."}, {"images": {"nodes": [{"file_name": "Daliani_CoverImageSafeAreaTemplatePortrait.png", "id": "26175346595472855", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823757_26175346622139519_8842351448860525576_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oZRRW7RWVcQ7kNvwEo5Otn&_nc_oc=AdqheXSkVdxCynVLQyEKa5U_-l46K5pAfPwJclFCPok8qlbuL887EkrCxE89QBSUKCM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8aUxVZy0N-V76Aqe_aetmAjbUdhDxiEWErR-ZaeLT6w&oe=6A8D7A73"}, {"file_name": "Daliani_CoverImageSafeAreaTemplateLandscape.png", "id": "1260790659154507", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499617680_1260790662487840_3872021655171233072_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYDZ9Lt8Y18Q7kNvwEaSyRE&_nc_oc=AdqtjBZjENE_owtMxB8fSc_SjRHu3PsUs3fASEtu17_TqRJH4HMSkGCVOhFUZ2QID10&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1BZhSVTmtwkZFZzdg7i0r7nBBAvT1oWEs5YGCzHLDZw&oe=6A8D6E74"}, {"file_name": "Daliani_CoverImag
 "Daliani_CoverImageSafeAreaTemplateHero.png", "id": "975740844843565", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819239_975740848176898_614160356923714657_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cral9vcsH_4Q7kNvwH1zo9D&_nc_oc=AdqHUma1jJIr6BnB2HapYNggh6JGAg2LyPKtafDcvEnJdqyzbW0Pq86XIxnQafE8sq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87_GF5qeQZq5wWTU1iOwORO_0jSgjdoTeJXQxY4TaMxg&oe=6A35528A"}, {"file_name": "Daliani Icon v5.png", "id": "973386741839825", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_973386745173158_2197407544904841183_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoc9VG3D-3gQ7kNvwFYxgkQ&_nc_oc=AdpP6h1xzEGYFdpCJ1EXqPcqRGuS4nH5HhCD2XkHML1m3SFqV1ONrf-XJbLr5Q8_pjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eWA7zqIA9Hnt-MwdsRR9RDbpM4nINCpCrN7Wj9Zr6MA&oe=6A353F9F"}]}, "id": "1525119779239018", "locale": "en_US", "screenshots": [{"file_name": "com.Dotsoft.Daliani-20260505-151821 copy.png", "id": "971781582104951", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823930_971781585438284_8408649887222969230_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9xKQlKeAD8Q7kNvwFXdJ2A&_nc_oc=Adq0WyujDRghKC3w3gx1ch_Ydn6pwznBiHF78Irh8rWWPapqB_aORfYqmWjc8Dw0fNg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3VCtTv24LRJC8byI1hz6CzmleEUqcWmuyqF-24t5x_A&oe=6A354318"}, {"file_name": "com.Dotsoft.Daliani-20260505-152006.png", "id": "1007960685001694", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624700_1007960688335027_8508758570384968444_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t80cOfrvWDkQ7kNvwGOgxfy&_nc_oc=AdoVb_nNqWVA-vl-QZ7vvmkU4e-rEYq15uwEzD-sw4BU6FJ4wf_d_h-fSi7JeHvM09c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q1ICaNAXcIaSnqxtBPmNwza6C6JGT7rLQIjQ8w5EqJQ&oe=6A3553E6"}, {"file_name": "com.Dotsoft.Daliani-20260505-152154.png", "id": "1259224769624969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830467_1259224772958302_5944639226009981632_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvIDUNMkcnoQ7kNvwH8TA2L&_nc_oc=Ado_tJ1qC-RsxWHvzmTlSkMURK4ZzIg3vOiHiwgngMMKS7LOlVRzCY277onQV-uFtk8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nbVKPuWm_73LRF_JdKIe84Xl0K6x4eedz67NAjm_Fpg&oe=6A357335"}, {"file_name": "com.Dotsoft.Daliani-20260505-152135.png", "id": "943990228508203", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819859_943990231841536_5409489005583405348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXkee6DtRbYQ7kNvwEvJsCA&_nc_oc=Adp-EWJXkgiV9Qw71Dnz8vJaibLcAyFQ1KeoDApv8pD4qHVOIePCV3M6fuXWqU9rvUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ipu4AZGccMWvnaXIhy1kNw-V3ApwbaYIf5OtnHR7X2w&oe=6A3550C0"}, {"file_name": "com.Dotsoft.Daliani-20260505-152145.png", "id": "1459990641994438", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823905_1459990645327771_3687014525619409846_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0z40mUGkU0Q7kNvwHclqOk&_nc_oc=AdpFR5XyX7NbBaMg04bPsdoEmjOyQJuvmHWSEOIVPSPwwnCaCCzCgUW_Kg7hPrKP1Ng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dTtPti4TZPRvz0P5PJD0LQPHmBF5y1TFQz5Yux5M9tQ&oe=6A3549B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daliani: Living Tradition", "keywords": ["heritage", "fishing", "game", "narrative", "story"], "long_description": "In Daliani: Living Tradition, you become Apostolis, a 17-year-old visiting his uncle Petros at a traditional fishing installation in Preveza for the first time.\n\nFrom the viewpoint on the tower, you listen to local fishermen, answer dialogue prompts, and learn how the net, winches, timing, and observation shape the Daliani fishing method. Use the mechanisms to prepare the trap, watch fish move through the water, and choose the right moment to close the net, to ensure the most successful catch.\n\nBlending guided storytelling, challenge, and cultural heritage, this VR experience introduces players to a rare fishing tradition of the Ambracian Gulf.", "short_description": "Step onto a tower in the Ambracian Gulf and learn the traditional Ntaliani fishing technique through an interactive VR story."}, {"images": {"nodes": [{"file_name": "Daliani Icon v5.png", "id": "2209404989875952", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_2209404993209285_757507465839310618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahXdTEBonzMQ7kNvwGGR2rj&_nc_oc=AdpEiAyMrrV2OrauDz-xvmEpteKH6uaYkgdN6zkhkEMlnHglKbtNTajeL_c-sT_3idk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GCKH-nf1UVyfWfKgvXAgJhOjTStj2nHHHv1uF2mNYBg&oe=6A354D04"}, {"file_name": "Daliani_CoverImageSafeAreaTemplateHero_gr.png", "id": "2189045815203185", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823270_2189045818536518_1197449426069608052_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTE8DcPrlUkQ7kNvwH30cr-&_nc_oc=Adp9ObobtfB1GIPosajJ9Fb_QKewO_ennUR4CR0YkQUtAQwSp55P3-YLVICittsRM0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZowLV1G00hvCRnL6U8TyT_1eOSmHA-lSv1PF_altN8g&oe=6A355873"}, {"file_name": "Daliani_CoverImageSafeAreaTemplateLandscape_gr.png", "id": "1772726590372627", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819239_1772726593705960_4264978315132988550_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsFfsr4nQvYQ7kNvwFQUFlC&_nc_oc=AdqgKdN7K9Bih5RnpE1LRw0n04nktNwbRfDkqNtwIY6m-ZZ7or4wq7NvbPblP5L3k0k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ODICYvF0TgJIFTuUaX7PRE9roU-ifu33uwPT76JKJMQ&oe=6A35617F"}, {"file_name": "Daliani_CoverImageSafeAreaTemplatePortrait_gr.png", "id": "1583897133145655", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818849_1583897136478988_5796830830848411987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbOGL8Tz6mIQ7kNvwFZdwfz&_nc_oc=AdqNxooW5YoAExFBK8pAMzhxPNTxF1zsU5-qcRycsI6BzZ_ub-A5JOCqVNeDhk9g_K4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8mZ2ubg2PRck9p0VpiSRUh1UycutL1kQzV7C9S916Iw&oe=6A354FE0"}, {"file_name": "Daliani_CoverImageSafeAreaTemplateSquare_gr.png", "id": "1546951613721263", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_1546951617054596_8071610752796397453_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZQJn2u9l6UQ7kNvwF1Okti&_nc_oc=AdoN8eyvd_Z2BAEst6QjtQU-nuhFPcYbH9NsUhmnNWrFr_odn4RiIWGzooqdByi5c-M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bd11t0oqjPOxN3s-eD7-u_6WRZwD_OfQTR6UIEhOuMw&oe=6A3543AD"}]}, "id": "983462414367070", "locale": "el_GR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9: \u0396\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7", "keywords": ["\u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7", "\u03a8\u03ac\u03c1\u03b5\u03bc\u03b1", "\u03a0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9", "\u0391\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7", "\u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1"], "long_description": "\u03a3\u03c4\u03bf \u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9: \u0396\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7, \u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c4\u03bf\u03bd \u03c1\u03cc\u03bb\u03bf \u03c4\u03bf\u03c5 \u0391\u03c0\u03bf\u03c3\u03c4\u03cc\u03bb\u03b7, \u03b5\u03bd\u03cc\u03c2 17\u03c7\u03c1\u03bf\u03bd\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b5\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c6\u03bf\u03c1\u03ac \u03c4\u03bf \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9 \u03c4\u03bf\u03c5 \u03b8\u03b5\u03af\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03a0\u03ad\u03c4\u03c1\u03bf\u03c5 \u03c3\u03c4\u03b7\u03bd \u03a0\u03c1\u03ad\u03b2\u03b5\u03b6\u03b1.\n\n\u0391\u03c0\u03cc \u03c4\u03bf\u03bd \u03c0\u03cd\u03c1\u03b3\u03bf, \u03b1\u03ba\u03bf\u03cd\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03c8\u03b1\u03c1\u03ac\u03b4\u03b5\u03c2, \u03b5\u03bc\u03c0\u03bb\u03ad\u03ba\u03b5\u03c3\u03b1\u03b9 \u03c3\u03b5 \u03b4\u03b9\u03b1\u03bb\u03cc\u03b3\u03bf\u03c5\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03b1\u03b8\u03b1\u03af\u03bd\u03b5\u03b9\u03c2 \u03c0\u03ce\u03c2 \u03c4\u03bf \u03b4\u03af\u03c7\u03c4\u03c5, \u03b7 \u03c0\u03b1\u03c1\u03b1\u03c4\u03ae\u03c1\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c4\u03bf \u03c3\u03c9\u03c3\u03c4\u03cc timing \u03c3\u03c5\u03bd\u03b8\u03ad\u03c4\u03bf\u03c5\u03bd \u03c4\u03b7\u03bd \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ae \u03c4\u03bf\u03c5 \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9. \u03a7\u03b5\u03b9\u03c1\u03af\u03c3\u03bf\u03c5 \u03c4\u03bf\u03c5\u03c2 \u03bc\u03b7\u03c7\u03b1\u03bd\u03b9\u03c3\u03bc\u03bf\u03cd\u03c2, \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03cd\u03b8\u03b7\u03c3\u03b5 \u03c4\u03b1 \u03ba\u03bf\u03c0\u03ac\u03b4\u03b9\u03b1 \u03c8\u03b1\u03c1\u03b9\u03ce\u03bd \u03ba\u03b1\u03b9 \u03b4\u03b9\u03ac\u03bb\u03b5\u03be\u03b5 \u03c4\u03b7 \u03c3\u03c9\u03c3\u03c4\u03ae \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03ba\u03bb\u03b5\u03af\u03c3\u03b5\u03b9\u03c2 \u03c4\u03b7\u03bd \u03c0\u03b1\u03b3\u03af\u03b4\u03b1, \u03ce\u03c3\u03c4\u03b5 \u03bd\u03b1 \u03b5\u03c0\u03b9\u03c4\u03cd\u03c7\u03b5\u03b9\u03c2 \u03c4\u03b7 \u03bc\u03ad\u03b3\u03b7\u03c3\u03c4\u03b7 \u03c8\u03b1\u03c1\u03b9\u03ac!\n\n\u039c\u03b9\u03b1 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b7 VR \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b4\u03c5\u03ac\u03b6\u03b5\u03b9 \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7, \u03c0\u03c1\u03cc\u03ba\u03bb\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae \u03ba\u03bb\u03b7\u03c1\u03bf\u03bd\u03bf\u03bc\u03b9\u03ac, \u03b6\u03c9\u03bd\u03c4\u03b1\u03bd\u03b5\u03cd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b7 \u03c3\u03c0\u03ac\u03bd\u03b9\u03b1 \u03b1\u03bb\u03b9\u03b5\u03c5\u03c4\u03b9\u03ba\u03ae \u03c0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7 \u03c4\u03bf\u03c5 \u0391\u03bc\u03b2\u03c1\u03b1\u03ba\u03b9\u03ba\u03bf\u03cd \u039a\u03cc\u03bb\u03c0\u03bf\u03c5.", "short_description": "\u0391\u03c0\u03cc \u03c4\u03bf\u03bd \u03c0\u03cd\u03c1\u03b3\u03bf \u03c4\u03bf\u03c5 \u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9 \u03c3\u03c4\u03bf\u03bd \u0391\u03bc\u03b2\u03c1\u03b1\u03ba\u03b9\u03ba\u03cc \u03b3\u03bd\u03ce\u03c1\u03b9\u03c3\u03b5 \u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03b1\u03b4\u03bf\u03c3\u03b9\u03b1\u03ba\u03ae \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ae \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9 \u03bc\u03ad\u03c3\u03b1 \u03b1\u03c0\u03cc \u03bc\u03b9\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03ae VR \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dotsoft.gr/en/privacy-policy-app-daliani-living-tradition", "developer_terms_of_service_url": null, "publisher_name": "DOTSOFT SA", "support_website_url": null, "website_url": "https://dotsoft.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
60505-152006.png", "id": "1007960685001694", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624700_1007960688335027_8508758570384968444_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjqGRuVp_-MQ7kNvwHHRk5D&_nc_oc=AdrI-fHctLeOotUjrLaBIzzx71KQSJGYB5i_A0xeB_bTMVYBMPhSUwtOtkl__mnjwgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbS6T0wGqqD1DPtn3j4dg1qasdMHPlEDGP2Tk0pnFICw&oe=6AA2C066"}, {"file_name": "com.Dotsoft.Daliani-20260505-152154.png", "id": "1259224769624969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830467_1259224772958302_5944639226009981632_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdnNpBYQRc0Q7kNvwFUTyf8&_nc_oc=AdqvCLac4qqQhXC6D0_mjGOlgUiUp00chJH_YjhiWnaNCdoGcQjihFGKdY2r19kjkhw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyYAVj2FUNXMNjmNYjIpbpD734OejcE6BF3NqoczHPFQ&oe=6AA2A775"}, {"file_name": "com.Dotsoft.Daliani-20260505-152135.png", "id": "943990228508203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819859_943990231841536_5409489005583405348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLTufRmMVOUQ7kNvwFkuG2X&_nc_oc=AdoRDwsPDMk-D3J3RreVW2lpS-21CZPO59SgMYESNI1-FMJoAATQ6j-YuAGcjhrhzl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmB7eME78_SlH3GfyRhsSSGJzfLYysDZrSLw5HqayV4Q&oe=6AA2BD40"}, {"file_name": "com.Dotsoft.Daliani-20260505-152145.png", "id": "1459990641994438", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823905_1459990645327771_3687014525619409846_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnL5gt3RtNQQ7kNvwHEyR0d&_nc_oc=AdrBmkihRMnZu1rvZw90jKkjt4xIQb9YKuqqVvNCSIwRY8oHKHFXJPY82kVpwKnGCUk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjfrzrR9HfXrPCznZ7_J70M8Eyl3Uq-qKIeObZ7rnx6Q&oe=6AA2B630"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daliani: Living Tradition", "keywords": ["heritage", "fishing", "game", "narrative", "story"], "long_description": "In Daliani: Living Tradition, you become Apostolis, a 17-year-old visiting his uncle Petros at a traditional fishing installation in Preveza for the first time.\n\nFrom the viewpoint on the tower, you listen to local fishermen, answer dialogue prompts, and learn how the net, winches, timing, and observation shape the Daliani fishing method. Use the mechanisms to prepare the trap, watch fish move through the water, and choose the right moment to close the net, to ensure the most successful catch.\n\nBlending guided storytelling, challenge, and cultural heritage, this VR experience introduces players to a rare fishing tradition of the Ambracian Gulf.", "short_description": "Step onto a tower in the Ambracian Gulf and learn the traditional Ntaliani fishing technique through an interactive VR story."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dotsoft.gr/cookies-policy-daliani-living-tradition/", "developer_terms_of_service_url": null, "publisher_name": "DOTSOFT SA", "support_website_url": null, "website_url": "https://dotsoft.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "el"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27603968482548011"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_996489166238895_696703513192362962_n.png?stp=dst-png_s3
4.png", "id": "1259224769624969", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830467_1259224772958302_5944639226009981632_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHWcds0oF-UQ7kNvwHIIYcl&_nc_oc=Adp9czEWomgvUraUtJcMnzvC1y_Gvmh5ACWiEPUI297wGfkXelp3deqMrD7nAd1P1oo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4VUXa9HusZc4O_9iPuaBMZ8hXfpKfQPpPQSCUPs67yQ&oe=6A411875"}, {"file_name": "com.Dotsoft.Daliani-20260505-152135.png", "id": "943990228508203", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819859_943990231841536_5409489005583405348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRhH7BctTw0Q7kNvwHtjBLp&_nc_oc=Adp7w51zgChy-Q_WVt4_Sti14MzY1Q_PUI-yviIFuEYQ_OXhjRodbey5cDGkrcVo_Ho&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91gtVRBkCuYKnIbKxsF5hRsyAUs_YTzzS6YTYSEBVbbw&oe=6A412E40"}, {"file_name": "com.Dotsoft.Daliani-20260505-152145.png", "id": "1459990641994438", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823905_1459990645327771_3687014525619409846_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyA7mmqdT2YQ7kNvwHWnB65&_nc_oc=AdpDZEzbqDedvSljz9JV9AXNsMtIoo8tIjeW0aSHiPUa9335sBcvyk1NVU-71hsHvaE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g_HzBYOdMuIJg4E4zsBz52WMvDEl6NeAQ34RTPexK2A&oe=6A412730"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Daliani: Living Tradition", "keywords": ["heritage", "fishing", "game", "narrative", "story"], "long_description": "In Daliani: Living Tradition, you become Apostolis, a 17-year-old visiting his uncle Petros at a traditional fishing installation in Preveza for the first time.\n\nFrom the viewpoint on the tower, you listen to local fishermen, answer dialogue prompts, and learn how the net, winches, timing, and observation shape the Daliani fishing method. Use the mechanisms to prepare the trap, watch fish move through the water, and choose the right moment to close the net, to ensure the most successful catch.\n\nBlending guided storytelling, challenge, and cultural heritage, this VR experience introduces players to a rare fishing tradition of the Ambracian Gulf.", "short_description": "Step onto a tower in the Ambracian Gulf and learn the traditional Ntaliani fishing technique through an interactive VR story."}, {"images": {"nodes": [{"file_name": "Daliani Icon v5.png", "id": "2209404989875952", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823783_2209404993209285_757507465839310618_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgF2NF5IMOsQ7kNvwEY2AGm&_nc_oc=AdqUYwUQplUVD5x8tw8uJSp2CjnV1Yx_Ddc5oaAe71NQktuemUWQOQ2lhP2DNlqdeBo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Trbv3RpRP57dCLjnOQMxprel7RKIfSnJYI9MSy0lmmg&oe=6A412A84"}, {"file_name": "Daliani_CoverImageSafeAreaTemplateHero_gr.png", "id": "2189045815203185", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823270_2189045818536518_1197449426069608052_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvtoG9rAk2UQ7kNvwHIF23L&_nc_oc=AdoOR9-xAaC5M0SR3T4F0dZPaumpp6-ItYlP308Hz6IL9Ej1DydQ7krA8dfGU6AIryE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VwlPcHY7rfwBGcWpkHMfe8PUgyIX0Odin5sB0gU5NPg&oe=6A4135F3"}, {"file_name": "Daliani_CoverImageSafeAreaTemplateLandscape_gr.png", "id": "1772726590372627", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819239_1772726593705960_4264978315132988550_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlIQ7GThnRIQ7kNvwHbIzKs&_nc_oc=AdrHnEc7QHmFwa6AVexrgNlNePEqJZHaufI9bgoOK9vXtKE-2HhnJF97zSzUbfb5ZJY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_U6IB7t05nWV4UFFjfeWuNtWqfjoW8YyDDN9JglhVog&oe=6A413EFF"}, {"file_name": "Daliani_CoverImageSafeAreaTemplatePortrait_gr.png", "id": "1583897133145655", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818849_1583897136478988_5796830830848411987_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YQOZyzvqvkQ7kNvwH-PEbQ&_nc_oc=AdqyeLgwF1V4RQA_UAB6ytfamltuzncdMnPOOvpqpBz-aJGiko970tAykQns4oiOr84&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FA3t_2_vf2IxH6MTRDvmVq_TRtNfGqKzNmRvS3zufnQ&oe=6A412D60"}, {"file_name": "Daliani_CoverImageSafeAreaTemplateSquare_gr.png", "id": "1546951613721263", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820141_1546951617054596_8071610752796397453_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jCsYbnAfU0Q7kNvwHha87W&_nc_oc=AdoNkjxs18ZbynUZHqfJfKrvg2l3ieAGcAlSLa8wbLKV00AOYUVI0ovcLoylAqwfOBU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fh7aZNR3Fzu_zd6jvki42fHkE8RkgObzxFGa7a9y7ZA&oe=6A41212D"}]}, "id": "983462414367070", "locale": "el_GR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9: \u0396\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7", "keywords": ["\u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7", "\u03a8\u03ac\u03c1\u03b5\u03bc\u03b1", "\u03a0\u03b1\u03b9\u03c7\u03bd\u03af\u03b4\u03b9", "\u0391\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7", "\u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1"], "long_description": "\u03a3\u03c4\u03bf \u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9: \u0396\u03c9\u03bd\u03c4\u03b1\u03bd\u03ae \u03a0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7, \u03b1\u03bd\u03b1\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03b9\u03c2 \u03c4\u03bf\u03bd \u03c1\u03cc\u03bb\u03bf \u03c4\u03bf\u03c5 \u0391\u03c0\u03bf\u03c3\u03c4\u03cc\u03bb\u03b7, \u03b5\u03bd\u03cc\u03c2 17\u03c7\u03c1\u03bf\u03bd\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03b5\u03c0\u03b9\u03c3\u03ba\u03ad\u03c0\u03c4\u03b5\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c6\u03bf\u03c1\u03ac \u03c4\u03bf \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9 \u03c4\u03bf\u03c5 \u03b8\u03b5\u03af\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03a0\u03ad\u03c4\u03c1\u03bf\u03c5 \u03c3\u03c4\u03b7\u03bd \u03a0\u03c1\u03ad\u03b2\u03b5\u03b6\u03b1.\n\n\u0391\u03c0\u03cc \u03c4\u03bf\u03bd \u03c0\u03cd\u03c1\u03b3\u03bf, \u03b1\u03ba\u03bf\u03cd\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03c8\u03b1\u03c1\u03ac\u03b4\u03b5\u03c2, \u03b5\u03bc\u03c0\u03bb\u03ad\u03ba\u03b5\u03c3\u03b1\u03b9 \u03c3\u03b5 \u03b4\u03b9\u03b1\u03bb\u03cc\u03b3\u03bf\u03c5\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03b1\u03b8\u03b1\u03af\u03bd\u03b5\u03b9\u03c2 \u03c0\u03ce\u03c2 \u03c4\u03bf \u03b4\u03af\u03c7\u03c4\u03c5, \u03b7 \u03c0\u03b1\u03c1\u03b1\u03c4\u03ae\u03c1\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c4\u03bf \u03c3\u03c9\u03c3\u03c4\u03cc timing \u03c3\u03c5\u03bd\u03b8\u03ad\u03c4\u03bf\u03c5\u03bd \u03c4\u03b7\u03bd \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ae \u03c4\u03bf\u03c5 \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9. \u03a7\u03b5\u03b9\u03c1\u03af\u03c3\u03bf\u03c5 \u03c4\u03bf\u03c5\u03c2 \u03bc\u03b7\u03c7\u03b1\u03bd\u03b9\u03c3\u03bc\u03bf\u03cd\u03c2, \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03cd\u03b8\u03b7\u03c3\u03b5 \u03c4\u03b1 \u03ba\u03bf\u03c0\u03ac\u03b4\u03b9\u03b1 \u03c8\u03b1\u03c1\u03b9\u03ce\u03bd \u03ba\u03b1\u03b9 \u03b4\u03b9\u03ac\u03bb\u03b5\u03be\u03b5 \u03c4\u03b7 \u03c3\u03c9\u03c3\u03c4\u03ae \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03ba\u03bb\u03b5\u03af\u03c3\u03b5\u03b9\u03c2 \u03c4\u03b7\u03bd \u03c0\u03b1\u03b3\u03af\u03b4\u03b1, \u03ce\u03c3\u03c4\u03b5 \u03bd\u03b1 \u03b5\u03c0\u03b9\u03c4\u03cd\u03c7\u03b5\u03b9\u03c2 \u03c4\u03b7 \u03bc\u03ad\u03b3\u03b7\u03c3\u03c4\u03b7 \u03c8\u03b1\u03c1\u03b9\u03ac!\n\n\u039c\u03b9\u03b1 \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03b7 VR \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b4\u03c5\u03ac\u03b6\u03b5\u03b9 \u03b1\u03c6\u03ae\u03b3\u03b7\u03c3\u03b7, \u03c0\u03c1\u03cc\u03ba\u03bb\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae \u03ba\u03bb\u03b7\u03c1\u03bf\u03bd\u03bf\u03bc\u03b9\u03ac, \u03b6\u03c9\u03bd\u03c4\u03b1\u03bd\u03b5\u03cd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u03b7 \u03c3\u03c0\u03ac\u03bd\u03b9\u03b1 \u03b1\u03bb\u03b9\u03b5\u03c5\u03c4\u03b9\u03ba\u03ae \u03c0\u03b1\u03c1\u03ac\u03b4\u03bf\u03c3\u03b7 \u03c4\u03bf\u03c5 \u0391\u03bc\u03b2\u03c1\u03b1\u03ba\u03b9\u03ba\u03bf\u03cd \u039a\u03cc\u03bb\u03c0\u03bf\u03c5.", "short_description": "\u0391\u03c0\u03cc \u03c4\u03bf\u03bd \u03c0\u03cd\u03c1\u03b3\u03bf \u03c4\u03bf\u03c5 \u039d\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9 \u03c3\u03c4\u03bf\u03bd \u0391\u03bc\u03b2\u03c1\u03b1\u03ba\u03b9\u03ba\u03cc \u03b3\u03bd\u03ce\u03c1\u03b9\u03c3\u03b5 \u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03b1\u03b4\u03bf\u03c3\u03b9\u03b1\u03ba\u03ae \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ae \u03bd\u03c4\u03b1\u03bb\u03b9\u03ac\u03bd\u03b9 \u03bc\u03ad\u03c3\u03b1 \u03b1\u03c0\u03cc \u03bc\u03b9\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03ae VR \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dotsoft.gr/en/privacy-policy-app-daliani-living-tradition", "developer_terms_of_service_url": null, "publisher_name": "DOTSOFT SA", "support_website_url": null, "website_url": "https://dotsoft.gr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
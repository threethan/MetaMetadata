2Ea8VciplbTkMMa6KA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW6C1wfgbqdOLvhRuwyQwDB3tg8mabQWXp9yrRY119ixg&oe=6B0EFE00"}, {"file_name": "teo_anesthesia.png", "id": "3908098526103674", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031338_3908098529437007_8628813708431480429_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaPEijev5PUQ7kNvwFraOH2&_nc_oc=AdpO3Sqhx9NKynAXUscPWiOq1mLS1pGw72B9X3V2kglwhuK5BjrxfirK-pLDVgMX7Nw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1amNUaZKMDYpzJc1QXdKipes8sEgO68Td90vUfFmuwg&oe=6B0EF18A"}, {"file_name": "teo_quiz.png", "id": "805296555052783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035463_805296558386116_1212904496924617404_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-TdqCwSmFwQ7kNvwEfjCGd&_nc_oc=AdpBA2Ue09f-nVp192baiSDsjSH6f8O1fXksB1ytGPhbxwSjmbstkXms_N7qYo7JdKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUlM7AQkioTnCnDXJcpa73QWTM4FxgHzlsEica0Dsf_UQ&oe=6B0F0183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail5.png", "id": "414066747731473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974753_414066751064806_3780337329690629823_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiFXIFRKi-0Q7kNvwEnT7vu&_nc_oc=AdqqWDTfwPW_mSGBmoUkSvc4rl4ax9IlyK_2G1hdOeZ3wvXFr8Ij5tsAeWbacWNm5t0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVrIucH5wfFfg-yIUZMnA38z_sGcJQ56GQHWzPK2UaPKw&oe=6B0EF8F1"}, "display_name": "Teo", "keywords": [], "long_description": "Teo is a virtual platform for the dental community to get together to study and explore new materials, instruments, and new developments in dentistry.\n\n- Form groups to study and discuss dentistry in virtual environment\n\n- Create and practice step-by-step custom procedures alone or with others\n\n- Load your own 3D models to share and annotate with guests\n\n- Save your scene and make 3D recordings for others to play back to watch and repeat your actions\n\n- Discuss, share and collaborate with others with a single Point of View\n\n- Practice core dental concepts to create muscle memory\n\n- Demonstrate new instruments in the virtual community\n\n- Connect to the virtual dental community anywhere, anytime\n\n- Hold virtual class for world wide dental professionals", "short_description": "Teo is a fully immersive dental training app. \n\nUnlock the potential of spatial learning in Teo, where you can manipulate 3D models, even your scan data. In a Teo session, everyone shares your perspective, regardless of their physical location. \n\nWelcome to the era of spatial learning, reshaping the landscape of dental education. Teo transcends the limitations of traditional 3D models on 2D screens, ushering in a revolutionary approach to immersive and collaborative learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.acadental.com/terms", "developer_terms_of_service_url": null, "publisher_name": "Acadental, Inc.", "support_website_url": "https://www.acadental.com/contact", "website_url": "https://www.acadental.com/teo", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION", "UTILITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_
ool feedback, such as we have in anesthesia and radiology practice, and a much more detailed set of results. Also, procedure creation has been reworked, and is now much simpler and easier to use.", "created_date": 1779995659, "id": "36060969476851441", "version": "1.82", "version_code": 1698, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7171064212935352", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36060969476851441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779978948, "id": "36055605747387814", "version": "1.8114pr", "version_code": 1697, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7171064212935352", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36060969476851441"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779918143, "id": "36037240492557673", "version": "1.8113pr", "version_code": 1696, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7171064212935352", "is_concept": false, "latest
&_nc_ohc=PechXK0emKgQ7kNvwG78ry8&_nc_oc=AdrjMu9wsYFnzdJd4rMm5fz31clr6zTnAOWiuKZOHOr3OvnEUTVsvPrTGTEdU04MS-k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GWei0-nHccJAgQJgPUuxCxPSXtGrxBo5yraA3mwRcig&oe=6A280F71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail2.png", "id": "787760505933520", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974751_787760509266853_1624802308027175440_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDlkX9PmOtAQ7kNvwGlak-A&_nc_oc=AdrJeSYm-ZSZImZQ7vp_CupaitIhUjP9ctLhV87mxED3vDVJnC9v3-Ygblmim06bdCI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9J6GZmLmdhObgdz-15hTz7NPtex326N4EDZ_j17d37SQ&oe=6A283D36"}, "display_name": "Teo", "keywords": [], "long_description": "Teo is a virtual platform for the dental community to get together to study and explore new materials, instruments, and new developments in dentistry.\n\n- Form groups to study and discuss dentistry in virtual environment\n\n-  Use dental instruments to practice and learning new techniques virtually\n\n-  Demonstrate new instruments in the virtual community\n\n- Connect to the virtual dental community anywhere, anytime\n\n- Hold virtual class for world wide dental professionals", "short_description": "Teo is a virtual platform for the dental community to get together to study and explore new materials, instruments, and new developments in dentistry.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://acadental.com/acatest/vrlabtest/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Acadental, Inc.", "support_website_url": "https://acadental.com/acatest/vrlabtest/contact_us.php", "website_url": "https://www.acadental.com/teo", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external
&_nc_ohc=NeJc1GGIcMUQ7kNvwF9F_02&_nc_oc=AdqNHrTUSOAVvk9aSNIOSTy8BVy05qYtOoEq2yD1PA7bUn0K1KmqrbC24q6W39VtIQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af927dD9SelVLms1Q3wF7sSwojrek1WKeJPDEf8FLLzyJQ&oe=6A2EA6F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail2.png", "id": "787760505933520", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974751_787760509266853_1624802308027175440_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXmrcjLyUwEQ7kNvwE8btrw&_nc_oc=AdqeWMrlyDIW_wk0AwLavdsHky1vUR1C8cqV-NOXVgdk3DwFEbDMnBkcm0sGJ2rVMDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6wK75YHx_nlWDyy-8TVm-a8MiiVpQCeyAklvSI5PgWQ&oe=6A2E9C76"}, "display_name": "Teo", "keywords": [], "long_description": "Teo is a virtual platform for the dental community to get together to study and explore new materials, instruments, and new developments in dentistry.\n\n- Form groups to study and discuss dentistry in virtual environment\n\n-  Use dental instruments to practice and learning new techniques virtually\n\n-  Demonstrate new instruments in the virtual community\n\n- Connect to the virtual dental community anywhere, anytime\n\n- Hold virtual class for world wide dental professionals", "short_description": "Teo is a virtual platform for the dental community to get together to study and explore new materials, instruments, and new developments in dentistry.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://acadental.com/acatest/vrlabtest/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Acadental, Inc.", "support_website_url": "https://acadental.com/acatest/vrlabtest/contact_us.php", "website_url": "https://www.acadental.com/teo", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external
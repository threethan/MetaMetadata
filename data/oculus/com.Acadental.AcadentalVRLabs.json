&_nc_ohc=BeFmdoXSfMQQ7kNvwFUkbly&_nc_oc=AdrHQ4J-3Ni1Ru1AJWab4eA93OngO-PWztCM7ADLu2WfhfqOqLtkaRPwiBa_SuvzoXI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E1By09ep-GSKknGfEhsDIU9PaNcrvKQULeo_YefASLw&oe=6A2FF871"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videothumbnail2.png", "id": "787760505933520", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974751_787760509266853_1624802308027175440_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXmrcjLyUwEQ7kNvwEHTbks&_nc_oc=Ado3W_cn36UiwqEeseB3fnvcxieWKCReHHQPyv_4r7z7Na0Ek_grN5OedkC3rHlQ-qo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xXllL9aa5HSD3SL18A5xSCobaxB7sQeZnFF0eD7SOsw&oe=6A302636"}, "display_name": "Teo", "keywords": [], "long_description": "Teo is a virtual platform for the dental community to get together to study and explore new materials, instruments, and new developments in dentistry.\n\n- Form groups to study and discuss dentistry in virtual environment\n\n-  Use dental instruments to practice and learning new techniques virtually\n\n-  Demonstrate new instruments in the virtual community\n\n- Connect to the virtual dental community anywhere, anytime\n\n- Hold virtual class for world wide dental professionals", "short_description": "Teo is a virtual platform for the dental community to get together to study and explore new materials, instruments, and new developments in dentistry.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://acadental.com/acatest/vrlabtest/privacy.php", "developer_terms_of_service_url": null, "publisher_name": "Acadental, Inc.", "support_website_url": "https://acadental.com/acatest/vrlabtest/contact_us.php", "website_url": "https://www.acadental.com/teo", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external
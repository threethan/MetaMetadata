5907956939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031410_1296275911290272_7088334041217182384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXSc_9qs4YgQ7kNvwFR_HKW&_nc_oc=AdqtUykE84KNLSvhWFGWGF_jKJU_xd2Gr-tUSo9JVY5J2Mmezy333-DrZTg52j0l86g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5yHdC60gFpqPHdgMW7Z438LnEgpY9McDH4mlLG1JrWA&oe=6AE4C047"}, {"file_name": "My project(3).png", "id": "1477805639632757", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_1477805642966090_4159052423751168104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LI8HEokSY7sQ7kNvwFuHgCo&_nc_oc=AdqD8Awsa4WRXYfcEFTJu_u8dgT6nfayalF0sl0wpIxIBQG-NvSHMXUpKnO4Zo1f5m8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAtH_7Xeo_SupinFsl3SQ-ZjW_C1k4SbZPDVuKm8ECSg&oe=6AE48DA8"}, {"file_name": "My project(4).png", "id": "1127112965350465", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003236_1127112968683798_1886665868121726424_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEbiIxk4WwkQ7kNvwEq_Adw&_nc_oc=Adp3jrLD_Y_grxecUgsP1nJeXsLWMHeJVU3VsEEQe191WkoHFQEdx5CBglvjPNi2Y8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZglafijWvzBSLJxqT9WL9KhGgUgx-IGMAXpt79BedTA&oe=6AE493FC"}, {"file_name": "My project(2).png", "id": "937620337359087", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_937620340692420_6979206189613251517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0cFkpIcCKcQ7kNvwEbvRSH&_nc_oc=AdoT6Qs6_UaeAeq3LGvEdSPZ3d_DhH57RK9IRwfuoJ7u5OCVVTMUiFz2Pi-u562PZ_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLR2BMSIRy2fLcal5J1oG-K6MuhtPYSfJjwdlnbC1rwQ&oe=6AE49892"}, {"file_name": "My project(5).png", "id": "159778177034433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569462_159778180367766_3647625469398648438_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C69ftAwUbMQ7kNvwH9Yfhy&_nc_oc=Adojiox0a4XSJT3WHyjzowGC7jW4sws8Pi7TBU9PXZJzb35N9_-d9K4kckwOJ6qZWOQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0qZbIJqtJYXqfyW6a_e12wCOy-m6mY_NFquCzc-wGaA&oe=6AE4977F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video cover.png", "id": "498412425709178", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031623_498412429042511_9039778457195236066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ6btYgxiUkQ7kNvwF-R6Dh&_nc_oc=AdpliNFpwcBM_LoAqgNz8O6yGDAFDD59d3NSc2xzkbP_JuDQEIyeuwqSiFrkH7rP98s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZfbCguVsCDQtg_oIvSzUUbevBZRdl-Bt9i0brufLwgQ&oe=6AE4BD2A"}, "display_name": "Auscultation simulator", "keywords": [], "long_description": "Auscultation Simulator helps in the training of the medical auscultation technique. The simulator was the combined effort of several scientists and retired military personnel. The research publications that preceded the invention of the virtual reality auscultation simulator are widely available for free on the website. This research included realistic disease combinations to avoid confusing students with unrealistic sound patterns through the body. There is freedom of movement as in real life, not just some automatic placement of the stethoscope, which means several sounds can be heard simultaneously, like the lungs and the heart. Currently, it supports the lungs and the heart, with the stomach coming soon. There is support via Discord, where ideas and future contributions are welcome.", "short_description": "Why spend several thousand dollars on an auscultation mannequin? Virtualismus' Auscultation Simulator helps in the training of the medical auscultation technique. Much effort was put into creating algorithms that provide realistic disease combinations while creating the simulator. Currently, it supports the lungs and the heart, with the stomach coming soon.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualismus.com/pri
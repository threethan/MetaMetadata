dn.com/v/t64.5771-25/39031410_1296275911290272_7088334041217182384_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shtsofdF-swQ7kNvwEVcZ75&_nc_oc=AdplHOQppIij4BopQN-s1tGTAvflBLvsw7YgkMNQ7qUQFePoYpQfrMFnwe-4IPmPfwM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2f4zJU4TxwPwibltTilma4cOgyCTOxNck2O9WqRm2VKw&oe=69F1F407"}, {"file_name": "My project(3).png", "id": "1477805639632757", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974653_1477805642966090_4159052423751168104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WE7-UGh0wMMQ7kNvwHZT8W8&_nc_oc=Adr_cZ0PYKkgRQOxzBPfElSshh9O7BP_QM_UE4yh0n1xNjaXlOHWKnynhVLrM1dSOhQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GZrT7A3d8TBURLGKPyaR79Td1QWqRerLyyYfakqoa3g&oe=69F1F9A8"}, {"file_name": "My project(4).png", "id": "1127112965350465", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003236_1127112968683798_1886665868121726424_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOQyICAhqC8Q7kNvwFyeUVQ&_nc_oc=AdpJRBt15G1yCKEaRbJV8uwpsDTGmTuFY7eCh_7cWjoPLG8mRfwznRqDyGXLSEivs48&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0F8jcnQOv8Q9tx0EuocIO_ERCD--YQw3xdU2jaR02H1g&oe=69F1FFFC"}, {"file_name": "My project(2).png", "id": "937620337359087", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974699_937620340692420_6979206189613251517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abXEHUrAEdMQ7kNvwFWGXmh&_nc_oc=AdreCoV6WDPnLZDoAIMTBa4Ry9WzAvrFyqeXDWFq4dbHmcP94TDSpSI_6W5VgDTnXAI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3QqDrLjuWMcCu8zdKkQcC_JtwRumGAVZBIUC6DbzxKaA&oe=69F20492"}, {"file_name": "My project(5).png", "id": "159778177034433", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569462_159778180367766_3647625469398648438_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAb6hJSDRaQQ7kNvwHRUe6i&_nc_oc=AdovVaZkzGWroqgMShWAr84vfDlonbdg8py9soTXw3nEivapIgHBctZF5fiTnLEFTcQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3LieRylpf_ynIgt1gh_hGLqWvQr7rvINRIMb8yv4aGCg&oe=69F2037F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video cover.png", "id": "498412425709178", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031623_498412429042511_9039778457195236066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBbwaiQD6KsQ7kNvwErAV0e&_nc_oc=AdpSspO2dik3U6w50DBFF8pE-SNPG8LK1PQuRlQFUypCWwtR9y4eNRuGdBHfj_hKw7o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SCnfuM-bYpRTnwE26ZywIUXChduAXhsqPtAjjn20aFA&oe=69F1F0EA"}, "display_name": "Auscultation simulator", "keywords": [], "long_description": "Auscultation Simulator helps in the training of the medical auscultation technique. The simulator was the combined effort of several scientists and retired military personnel. The research publications that preceded the invention of the virtual reality auscultation simulator are widely available for free on the website. This research included realistic disease combinations to avoid confusing students with unrealistic sound patterns through the body. There is freedom of movement as in real life, not just some automatic placement of the stethoscope, which means several sounds can be heard simultaneously, like the lungs and the heart. Currently, it supports the lungs and the heart, with the stomach coming soon. There is support via Discord, where ideas and future contributions are welcome.", "short_description": "Why spend several thousand dollars on an auscultation mannequin? Virtualismus' Auscultation Simulator helps in the training of the medical auscultation technique. Much effort was put into creating algorithms that provide realistic disease combinations while creating the simulator. Currently, it supports the lungs and the heart, with the stomach coming soon.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualismus.com/privacy/", "developer_terms_of_service_url": null, "publisher_name":
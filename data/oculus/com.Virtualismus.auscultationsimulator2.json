tkVrELe-c7aNAJzv662SrihDx3eSmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J8xeaaFB_Rn-0ftjMLpqClIedBourXKinPUNFQfrsug&oe=69EB6BFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video cover.png", "id": "498412425709178", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031623_498412429042511_9039778457195236066_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oag0e9UXMSsQ7kNvwH1TlJn&_nc_oc=Adrq130OynKbdRGWZY7nzologPxju3jek-bXVljAE4V_8Owxp5kp0GOCVOc8vyUEvRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1M8BzGhxtkNn0iJLkiCvIctw5KYFurzoZnhDIk-nofkA&oe=69EB596A"}, "display_name": "Auscultation simulator", "keywords": [], "long_description": "Auscultation Simulator helps in the training of the medical auscultation technique. The simulator was the combined effort of several scientists and retired military personnel. The research publications that preceded the invention of the virtual reality auscultation simulator are widely available for free on the website. This research included realistic disease combinations to avoid confusing students with unrealistic sound patterns through the body. There is freedom of movement as in real life, not just some automatic placement of the stethoscope, which means several sounds can be heard simultaneously, like the lungs and the heart. Currently, it supports the lungs and the heart, with the stomach coming soon. There is support via Discord, where ideas and future contributions are welcome.", "short_description": "Why spend several thousand dollars on an auscultation mannequin? Virtualismus' Auscultation Simulator helps in the training of the medical auscultation technique. Much effort was put into creating algorithms that provide realistic disease combinations while creating the simulator. Currently, it supports the lungs and the heart, with the stomach coming soon.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualismus.com/pri
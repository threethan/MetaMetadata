XQT_BqMjAtuU7w&oe=6B0717D2"}, {"file_name": "My project(5).png", "id": "159778177034433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569462_159778180367766_3647625469398648438_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bt3SuwRyx14Q7kNvwHHdQfu&_nc_oc=AdoqMM4thbev0EF3TC85B33SMrRC5EOCi6hF0slhAo0CwseAV6qiZvlxs6xIyHwKJCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyRDgKxgjbAA7X_BKcKJPJCUMaRFRksoVRz4qEfTY1tA&oe=6B0716BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video cover.png", "id": "498412425709178", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031623_498412429042511_9039778457195236066_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5TcMOS8jbIQ7kNvwEfGOYG&_nc_oc=AdoQ2jWaXe7TX0OfJmVBbtAHFavgNYh9dG2b8RELtAafl-NgeCVMx8QxqTsFSe8sI4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRl1Y6aRwRAqPdGrBioHVCyhYz6U7BNJsWiYUuTzAkaA&oe=6B07042A"}, "display_name": "Auscultation simulator", "keywords": [], "long_description": "Auscultation Simulator helps in the training of the medical auscultation technique. The simulator was the combined effort of several scientists and retired military personnel. The research publications that preceded the invention of the virtual reality auscultation simulator are widely available for free on the website. This research included realistic disease combinations to avoid confusing students with unrealistic sound patterns through the body. There is freedom of movement as in real life, not just some automatic placement of the stethoscope, which means several sounds can be heard simultaneously, like the lungs and the heart. Currently, it supports the lungs and the heart, with the stomach coming soon. There is support via Discord, where ideas and future contributions are welcome.", "short_description": "Why spend several thousand dollars on an auscultation mannequin? Virtualismus' Auscultation Simulator helps in the training of the medical auscultation technique. Much effort was put into creating algorithms that provide realistic disease combinations while creating the simulator. Currently, it supports the lungs and the heart, with the stomach coming soon.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualismus.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Virtualismus Limited", "support_website_url": null, "website_url": "https://www.virtualismus.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3370836476562042"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6773008472752259", "version": "3"}, "id": "909475037004063", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6153200564733056", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6773008472752259"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": 
_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA47GsxAQE2-i7kMBU1XPUw7IhVQYq9pkRaOFXfYq_lw&oe=6AE33851"}, {"file_name": "com.DefaultCompany.WoodChopVR-20260202-154810.png", "id": "2042645576527019", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499311585_2042645579860352_2261975611151533034_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zP9LCVl58gQ7kNvwENTD24&_nc_oc=AdpYQq9iBFJgy0dFhIa6z0nW00zaOamHcykPm1W22O7Qob8zhrQQgjZsd9wvRZ0foHk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNniNP1Uqauk2xoNZbGcueNcjMRgoVERwlOVcErfuvFg&oe=6AE35A33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wood Chop VR", "keywords": [], "long_description": "Wood Chop VR puts you right in the forest with one goal: chop wood and build your power. Swing your axe, break logs, collect resources, and upgrade your tools to chop faster and harder. As you progress, you\u2019ll unlock new areas, better gear, and unique mechanics that keep the gameplay fresh and addictive.\n\nDesigned from the ground up for VR, every swing feels physical and satisfying. Whether you\u2019re grinding for upgrades, experimenting with new items, or just enjoying the chill-but-rewarding gameplay loop, Wood Chop VR is all about that smooth progression and satisfying destruction.\n\nPerfect for quick sessions or long grinds\u2014pick up your axe and start chopping.", "short_description": "Wood Chop VR is a fast-paced VR game where you chop, collect, and upgrade your way to becoming the ultimate wood-cutting legend. Simple to learn, satisfying to master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1i42R0tHHMLzLjm1cxu4qUigrRAtPp7NJgCM8pZP1TGc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "MemeTheSIGMA", "support_website_url": null, "website_url": "https://woodchop-universe.preview.emergentagent.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_ta
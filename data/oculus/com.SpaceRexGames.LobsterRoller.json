8sept94Q7kNvwFNW8gw&_nc_oc=AdqQ4PsK7Ea0L_IzXb9hj1o23UXS1bEIullT-i5CZOLgDu_HWfk6y782JJ6gu9EHJEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2w1eoVgHv6FGXRuL-cypR0ydcr8YJc-16XrLahb3gjw&oe=6AF5F569"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Still 2026-02-07 223039_1.5.1.png", "id": "940101171919068", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292232_940101175252401_3262343232205312314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzPSSNG6bnIQ7kNvwEiYgaR&_nc_oc=AdrJ-Z2ML3eGJHmUr0ddqDplK4YgxcOtF8ef2GRirBTRCg0_ug_LqoP1UiFYLKF5rTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPuniEFPwo7rzk_od3ne6H1JCoybPd55E8eSW25LT5yA&oe=6AF5D5EF"}, "display_name": "Lobster Roller", "keywords": ["racing", "lobster", "hands", "fast", "car"], "long_description": "# \ud83c\udfc1 Race. Drift. Boost. Flow.\n\nWelcome to **Lobster Roller**, a high-speed **VR arcade racing experience** where **your hands are the wheels** \ud83d\udd90\ufe0f\ud83d\udede\n\nBuilt around an all-new **hand-based locomotion system**, *Lobster Roller* transforms physical motion into pure momentum \u26a1 Push your **wheel-hands** against the world to accelerate, carve through corners with precision drifting, and unleash boosts that reward **skill, confidence, and flow**. It\u2019s fast, expressive, and unlike anything you\u2019ve played in VR \ud83e\udd7d\ud83d\udd25\n\n---\n\n# \ud83d\udd90\ufe0f\ud83d\udede Wheel-Hand Locomotion\n\nYour hands don\u2019t just move you \u2014 **you are the vehicle** \ud83d\ude80\n\n- Press into surfaces to gain speed \u26a1  \n- Drift to redirect momentum \ud83c\udf00  \n- Master the delicate balance between **control and risk** \ud83c\udfaf  \n\nDrifting temporarily slows you down, but fills your **boost meter** \ud83d\udd0b, creating a constant push-and-pull between restraint and reckless speed \ud83d\udca5\n\n---\n\n# \ud83d\udee3\ufe0f Dynamic Tracks & Risky Shortcuts\n\nRace through twisting courses packed with:\n\n- Sharp turns \u21aa\ufe0f  \n- Jumps \ud83e\udd98  \n- Obstacles \ud83d\udea7  \n- Branching paths \ud83c\udf3f  \n\nWhether you\u2019re chasing the clock \u23f1\ufe0f or lining up against opponents \ud83c\udfce\ufe0f, every run challenges you to go **faster**, **cleaner**, and **bolder** \ud83d\udca8\ud83d\udd25\n", "short_description": "HANDS are WHEELS. You are Car. Car is Lobster. Go Fast...Turn...Drift...Boost...Jump...WIN!"}]}, "developer_name": "SpaceRex Games", "developer_privacy_policy_url": "https://sites.google.com/view/lobster-roller-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SpaceRex Games", "support_website_url": null, "website_url": "https://linktr.ee/spaceRex", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25918374191114790"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "829842960222749"}, {"status": "PUBLISHED", "id": "1454351903105330"}, {"status": "PUBLISHED", "id": "2340711746421263"}, {"status": "PUBLISHED", "id": "1403585944841149"}, {"status": "PUBLISHED", "id": "1554941315584936"}, {"status": "PUBLISHED", "id": "2123018038445448"}]}, "baseline_offer": {"id": "2340711746421263"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "8
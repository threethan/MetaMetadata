_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCN_2dJ-iukQ7kNvwEwNrqB&_nc_oc=AdrzsYVi_pz6Gq6tBFgQW_HRdIxpZ3rEDkvr4CuF-Zcpm6okkCVRtijSiNHEyLs7Oc0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9QbMtiEbTikBgT0ybqTcHipIq76iIol_tsazSxH2sCg&oe=6A6609A8"}, {"file_name": "Still 2026-02-07 224241_4.2.1.png", "id": "1540628107166612", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499298930_1540628110499945_6061798521320180066_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pn_OIEfhYHEQ7kNvwHJzLP2&_nc_oc=AdpFV4uOAedPUYOtWpnEekan30t1gRpVhRYGqOFNIab1n-Pfu69zOVJ7VEQyO8HwCIM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADfEyNBhooTPFTBi6qyhrmIw2Whnfou-S4-PwMYcPSmg&oe=6A6610F5"}, {"file_name": "Image Sequence_006_0006.png", "id": "1581380553173138", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303391_1581380556506471_2942103335332937375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbGXXGhW0q0Q7kNvwFa2RGb&_nc_oc=AdrnaeVyxZUvtuO9mC-pIQVsNEHm4ngh2qElBPlbPCBEkOnS-iMtfoWow6StdTO0SdQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2QyALP-p7GDGnSbjsW67ZzHSTE5gvH8on96LBojepFQ&oe=6A65F0F4"}, {"file_name": "Still 2026-02-07 224228_1.15.1.png", "id": "862412086618355", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830812_862412089951688_7431448472693021476_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSmzYAEJUE0Q7kNvwE1qep1&_nc_oc=AdrXtPAjnrOUf0k9vOSy3QVLBDZyhoy3UGz1KbjsdXEcMmRAYSI5nVCadF94gkD6TpQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJm-PiWgwSIM_5Vs2ABMyviSCIoxBYT69K91bl87nPcA&oe=6A6625AF"}, {"file_name": "Still 2026-02-07 224232_1.20.1.png", "id": "930291366002208", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296119_930291369335541_5076931731712998885_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWkGA6w2jsQQ7kNvwEbNa5Q&_nc_oc=AdrAXhZT7P_rfcLO6aJe-vFi6vuOjDmDN_BkDWpCsVq2ik2avNlOjU0odfACzpucWHI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUO1N0S1SxPje71aN8IjLA3rCmeCqi_VspMDAGDnV6dw&oe=6A6609A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Still 2026-02-07 223039_1.5.1.png", "id": "940101171919068", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499292232_940101175252401_3262343232205312314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_5XxKZKfE0Q7kNvwFQYxQx&_nc_oc=AdroZMb3ZDT0mDkj8SgtS51Zj1wZ50xvR8Kc5KM2tNSngpgVN2uIhPpHyNHOHXgrp4E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNOIYN02cFs-oWlymbT8d3EimBL42ymMUgeaEoFJhXdw&oe=6A66226F"}, "display_name": "Lobster Roller", "keywords": ["racing", "lobster", "hands", "fast", "car"], "long_description": "# \ud83c\udfc1 Race. Drift. Boost. Flow.\n\nWelcome to **Lobster Roller**, a high-speed **VR arcade racing experience** where **your hands are the wheels** \ud83d\udd90\ufe0f\ud83d\udede\n\nBuilt around an all-new **hand-based locomotion system**, *Lobster Roller* transforms physical motion into pure momentum \u26a1 Push your **wheel-hands** against the world to accelerate, carve through corners with precision drifting, and unleash boosts that reward **skill, confidence, and flow**. It\u2019s fast, expressive, and unlike anything you\u2019ve played in VR \ud83e\udd7d\ud83d\udd25\n\n---\n\n# \ud83d\udd90\ufe0f\ud83d\udede Wheel-Hand Locomotion\n\nYour hands don\u2019t just move you \u2014 **you are the vehicle** \ud83d\ude80\n\n- Press into surfaces to gain speed \u26a1  \n- Drift to redirect momentum \ud83c\udf00  \n- Master the delicate balance between **control and risk** \ud83c\udfaf  \n\nDrifting temporarily slows you down, but fills your **boost meter** \ud83d\udd0b, creating a constant push-and-pull between restraint and reckless speed \ud83d\udca5\n\n---\n\n# \ud83d\udee3\ufe0f Dynamic Tracks & Risky Shortcuts\n\nRace through twisting courses packed with:\n\n- Sharp turns \u21aa\ufe0f  \n- Jumps \ud83e\udd98  \n- Obstacles \ud83d\udea7  \n- Branching paths \ud83c\udf3f  \n\nWhether you\u2019re chasing the clock \u23f1\ufe0f or lining up against opponents \ud83c\udfce\ufe0f, every run challenges you to go **faster**, **cleaner**, and **bolder** \ud83d\udca8\ud83d\udd25\n", "short_description": "HANDS are WHEELS. You are Car. Car is Lobster. Go Fast...Turn...Drift...Boost...Jump...WIN!"}]}, "developer_name": "SpaceRex Games", "developer_privacy_policy_url": "https://sites.google.com/view/lobster-roller-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SpaceRex Games", "support_website_url": null, "website_url": "https://linktr.ee/spaceRex", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25918374191114790"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1454351903105330"}, {"status": "PUBLISHED", "id": "2340711746421263"}, {"status": "PUBLISHED", "id": "1403585944841149"}, {"status": "PUBLISHED", "id": "1554941315584936"}, {"status": "PUBLISHED", "id": "2123018038445448"}]}, "baseline_offer": {"id": "2340711746421263"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1454351903105330"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26748172831468251", "ve
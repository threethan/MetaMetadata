5/499292232_940101175252401_3262343232205312314_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OcsOIKjtzsQ7kNvwFYqhFF&_nc_oc=AdrESW3RYjBAza4X07vU94vhOWE7I11iax5l07fT6scTTt9f217S6HNMqDYa5OvGAoE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0X2uACISU8X9hAVMx31Iec26xRm2azswuXDF5HbrtGKA&oe=69F0CCEF"}, "display_name": "Lobster Roller", "keywords": ["racing", "lobster", "hands", "fast", "car"], "long_description": "# \ud83c\udfc1 Race. Drift. Boost. Flow.\n\nWelcome to **Lobster Roller**, a high-speed **VR arcade racing experience** where **your hands are the wheels** \ud83d\udd90\ufe0f\ud83d\udede\n\nBuilt around an all-new **hand-based locomotion system**, *Lobster Roller* transforms physical motion into pure momentum \u26a1 Push your **wheel-hands** against the world to accelerate, carve through corners with precision drifting, and unleash boosts that reward **skill, confidence, and flow**. It\u2019s fast, expressive, and unlike anything you\u2019ve played in VR \ud83e\udd7d\ud83d\udd25\n\n---\n\n# \ud83d\udd90\ufe0f\ud83d\udede Wheel-Hand Locomotion\n\nYour hands don\u2019t just move you \u2014 **you are the vehicle** \ud83d\ude80\n\n- Press into surfaces to gain speed \u26a1  \n- Drift to redirect momentum \ud83c\udf00  \n- Master the delicate balance between **control and risk** \ud83c\udfaf  \n\nDrifting temporarily slows you down, but fills your **boost meter** \ud83d\udd0b, creating a constant push-and-pull between restraint and reckless speed \ud83d\udca5\n\n---\n\n# \ud83d\udee3\ufe0f Dynamic Tracks & Risky Shortcuts\n\nRace through twisting courses packed with:\n\n- Sharp turns \u21aa\ufe0f  \n- Jumps \ud83e\udd98  \n- Obstacles \ud83d\udea7  \n- Branching paths \ud83c\udf3f  \n\nWhether you\u2019re chasing the clock \u23f1\ufe0f or lining up against opponents \ud83c\udfce\ufe0f, every run challenges you to go **faster**, **cleaner**, and **bolder** \ud83d\udca8\ud83d\udd25\n", "short_description": "HANDS are WHEELS. You are Car. Car is Lobster. Go Fast...Turn...Drift...Boost...Jump...WIN!"}]}, "developer_name": "SpaceRex Games", "developer_privacy_policy_url": "https://sites.google.com/view/lobster-roller-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SpaceRex Games", "support_website_url": null, "website_url": "https://linktr.ee/spaceRex", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25918374191114790"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1403585944841149"}, {"status": "PUBLISHED", "id": "1554941315584936"}, {"status": "PUBLISHED", "id": "2123018038445448"}]}, "baseline_offer": {"id": "1403585944841149"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773432180, "status": "PUBLISHED", "id": "1403585944841149"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26223781267240746", "version": "1.6"}, "id": "805871112454646", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25371899395762275", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26223781267240746"}, "release_sta
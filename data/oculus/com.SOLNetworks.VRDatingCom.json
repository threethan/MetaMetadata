ohc=B5LJGgirgHgQ7kNvwErkYlQ&_nc_oc=AdnDBCCTatguTiaKv-kn8eQfuJHTGFzcAikXwqSP0Vt3O4ECrchQBrJ0QlRoxLfGh5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftUHBHTCM1k6mYciAV99o-jkGoO4ZqWIfHesA-gj9JRuA&oe=69A02D97"}, {"file_name": "SCR 22 (1).png", "id": "1412642913724393", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1412642917057726_2633471271814102444_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0-3m-Z-YTcQ7kNvwEHJF2B&_nc_oc=AdnCn1MDl38lN11A6WfB8e0Z1D5Cvby6fwsyTmjPWLygBavPrf44ocdMIcZzO0V3EPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftqME_sa8M7wZvdStDTy4JGpJ2rTpJYqLCqc-lmA-xmTQ&oe=69A03B72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art_Landscape (1).png", "id": "1360281199177324", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_1360281205843990_1442608589590148470_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7T5owVzr2IQ7kNvwELQ0Ba&_nc_oc=AdnI3hHvCloHU1Mt-fg4S7OT-kDcFoUIKQmWi4bMPz7hOy3Wm5W8RtZlNPf_ECVmIH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuc5HeLSq3jwh971fJw3F53h30M_TDTnUtlGOI4stYnvw&oe=69A049E2"}, "display_name": "Dating.com: VR Chat and Date", "keywords": ["dating", "romance", "vrchat", "love", "videochat"], "long_description": "Experience 3D dating in VR with profiles from around the world. Dating.com VR offers immersive 1-on-1 video calls with matches who share your interests, so you can see, hear, and connect with people as if they were right in front of you. Step into a new dimension of romance with Dating.com VR.\n\nDiscover deep, immersive VR connections:\n- Expressive VR profiles\n- Meet people from anywhere in the world\n- Fun, warm 1-on-1 VR calls\n- Meaningful connections that can grow into real love\n- Safe, easy, convenient (with moderation tools for a respectful environment)\n\n\n# REAL SINGLES, 3D WORLD\n\nMeet new people globally in a realistic virtual space, feel the chemistry, and stay close across any distance.\n\n# CONNECT IN VIRTUAL REALITY\nLeave swiping behind. Dating.com VR focuses on what truly matters \u2013 emotions, spark, and shared moments.\n\n# MATCH PERFECTLY IN VR\nFind standout profiles with our Popular Members feature, then share a 1-on-1 video call face-to-face in the virtual world and let the moment unfold.\n\n# IMPORTANT MONETIZATION DETAILS\n- Use credits to unlock access to chat and connect via VR.\n- Your account will be charged once you confirm your purchase.\n- One-time in-app purchases for credits used to access premium VR chats. No subscription required.\n\n Our platform includes content moderation tools to help ensure a safe experience.\nDownload Dating.com VR and start your first unforgettable VR date today.\n", "short_description": "Meet real people in immersive 3D dating and feel close even at a distance. \nDating.com VR lets you join private 1-on-1 video chats with singles from around the world and explore virtual intimacy in a safe, relaxed space. \nDiscover matches who share your vibe \u2014 put on your headset and dive into your first VR date."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.dating.com/landing/app/terms/privacy-policy", "developer_terms_of_service_url": "https://vr.dating.com/landing/app/terms/terms-and-conditions", "publisher_name": "SOL Networks Limited", "support_website_url": null, "website_url": "https://www.dating.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_mod
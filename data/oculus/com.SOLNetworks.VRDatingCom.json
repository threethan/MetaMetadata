XxSCSm9HBE16PogZ8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZcvbe5l0j3tBKFx1xHWDzoRX2Zew_YeomxXU9WURl6A&oe=6B08442F"}, {"file_name": "SCR 21.png", "id": "1572862797287620", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830147_1572862800620953_8348774780031360572_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8as56eYw2IQ7kNvwGLG7sh&_nc_oc=AdpGqu238ySiFAxvkQBch062pJrNOBDT1OW5EWQFXRmoCEGdsxukd9yVWWS35f3mLPA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ6auhILO-t7t3hvwhYrQTUuRKW3X26lZt3zpLD3HVnA&oe=6B084F57"}, {"file_name": "SCR 22 (1).png", "id": "1412642913724393", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491825345_1412642917057726_2633471271814102444_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuW9fQ9fi8AQ7kNvwGgaZ2Y&_nc_oc=Adrmmh3c50lhl9gVJt-Yb7m0vS1ZEdv2dy1KLhSZxju7vgpo3erdwJhZgxM73emTF3I&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-LBShbsiWQxTeXKWvUK7Qm29UlHFruoNo8VZRpB2nBQ&oe=6B085D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art_Landscape (1).png", "id": "1360281199177324", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491822550_1360281205843990_1442608589590148470_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMdJwRrTgmMQ7kNvwH9hJu8&_nc_oc=Adqbck-Zv8Bkfm6fKoOTkluc4u1CM35UCTbiNr-BKjKtv_IJEymq5LP26bu7wg_p718&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKXqU8AvtAkpRiE7-6l9OBGTYxK3NFbv8BNwcJy_FnFQ&oe=6B086BA2"}, "display_name": "Dating.com: VR Chat and Date", "keywords": ["dating", "romance", "vrchat", "love", "videochat"], "long_description": "Experience 3D dating in VR with profiles from around the world. Dating.com VR offers immersive 1-on-1 video calls with matches who share your interests, so you can see, hear, and connect with people as if they were right in front of you. Step into a new dimension of romance with Dating.com VR.\n\nDiscover deep, immersive VR connections:\n- Expressive VR profiles\n- Meet people from anywhere in the world\n- Fun, warm 1-on-1 VR calls\n- Meaningful connections that can grow into real love\n- Safe, easy, convenient (with moderation tools for a respectful environment)\n\n\n# REAL SINGLES, 3D WORLD\n\nMeet new people globally in a realistic virtual space, feel the chemistry, and stay close across any distance.\n\n# CONNECT IN VIRTUAL REALITY\nLeave swiping behind. Dating.com VR focuses on what truly matters \u2013 emotions, spark, and shared moments.\n\n# MATCH PERFECTLY IN VR\nFind standout profiles with our Popular Members feature, then share a 1-on-1 video call face-to-face in the virtual world and let the moment unfold.\n\n# IMPORTANT MONETIZATION DETAILS\n- Use credits to unlock access to chat and connect via VR.\n- Your account will be charged once you confirm your purchase.\n- One-time in-app purchases for credits used to access premium VR chats. No subscription required.\n\n Our platform includes content moderation tools to help ensure a safe experience.\nDownload Dating.com VR and start your first unforgettable VR date today.\n", "short_description": "Meet real people in immersive 3D dating and feel close even at a distance. \nDating.com VR lets you join private 1-on-1 video chats with singles from around the world and explore virtual intimacy in a safe, relaxed space. \nDiscover matches who share your vibe \u2014 put on your headset and dive into your first VR date."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.dating.com/landing/app/terms/privacy-policy", "developer_terms_of_service_url": "https://vr.dating.com/landing/app/terms/terms-and-conditions", "publisher_name": "SOL Networks Limited", "support_website_url": null, "website_url": "https://www.dating.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "cont
442xJ8pA&oe=69BC0DCB"}, {"file_name": "SCR 15.png", "id": "1308616810216797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820150_1308616813550130_8778536493975395768_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ezp-Nd_DbwQ7kNvwHMGTzC&_nc_oc=AdnPdBpJFWGJA-SGkH548MHEKXQwPNYMwx4k5fIccMQ-Ga2kjHC1i1InZp2j6HtqppU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw2az_UIoZF0aK7pRI0pmlbVBIrQg-Nq6DZz6haGnY0jw&oe=69BBFBE6"}, {"file_name": "SCR 17.png", "id": "1328995318217082", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827626_1328995324883748_791536120416290019_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llA4lJ0Q7UIQ7kNvwGjYKjA&_nc_oc=AdnmWoErjHbFPavDU5uQHRGx9U8YFo_bkmALGpVSVupNN1Jv2uRD37wxgITmEcBgLaQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwOerM5zntDtUhP_S9QCR_6iuZUrGrLLMa2AFK1gkLR6g&oe=69BBF19F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dating.com: VR Chat and Date", "keywords": [], "long_description": "Experience 3D dating in VR with profiles from around the world.\n Dating.com VR offers immersive 1-on-1 video calls with matches who share your interests.\n See, hear, and connect with people as if they were right in front of you!\nDate in a new dimension with Dating.com, one of the leading global online dating communities.\n Make dating more engaging and exciting!\n\n**Discover deep, immersive VR connections:**\n- A variety of dynamic VR profiles\n- Date anyone, anywhere instantly\n- Fun 1-on-1 VR calls\n- Meaningful connections for real love\n- Safe, easy, convenient (Includes moderation tools to support a respectful environment.)\n\n**REAL SINGLES, 3D WORLD**\n\nMeet new people globally in a realistic virtual space. Connect anywhere, with endless possibilities.\n\n**CONNECT IN VIRTUAL REALITY**\n\nForget the hassles of traditional dating apps. Dating.com VR focuses on what matters \u2013 emotions, feelings, and sensations.\n\n**MATCH PERFECTLY IN VR**\n\nQuickly find standout profiles with our Popular Members feature. Share a 1-on-1 video call face-to-face in the virtual world. Let sparks fly!\n\n**IMPORTANT MONETIZATION DETAILS**\n\n- Use credits to unlock full access to chat and connect via VR.\n- Credits give you the power of interactive communication without limits.\n- Your account will be charged once you confirm your purchase.\n- One-time in-app purchases for credits used to access premium VR chats. No subscription required.\nOur platform includes content moderation tools to ensure a safe experience.", "short_description": "Experience immersive 3D dating in VR with singles from around the world.\nDating.com VR offers 1-on-1 video chats with matches who share your interests.\nExplore a new dimension of dating with VR technology from Dating.com.\nA fun new way to connect!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.dating.com/landing/app/terms/privacy-policy", "developer_terms_of_service_url": "https://vr.dating.com/landing/app/terms/terms-and-conditions", "publisher_name": "SOL Networks Limited", "support_website_url": null, "website_url": "https://www.dating.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9378517945592780"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1185494635945753"}]}, "baseline_offer": {"id": "1185494635945753"}, "is_ap
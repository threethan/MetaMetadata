"file_name": "3.png", "id": "846600358424846", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823930_846600361758179_3529209609244605045_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbtMNnfiqqEQ7kNvwEIzL0e&_nc_oc=AdqSaEnkbu92ogwUHl8VJUz_s1TcIKleEndgYQOh2VcM_pdbS4E4bmTHwrKyaxwST7Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73BvBmhLGzoUkzyqBcKMZ_eKa-4pUy7SuUOValK65cBg&oe=6A15C5C9"}, {"file_name": "4.png", "id": "1595669141659874", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823270_1595669144993207_9102657998274728678_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zO5l_lJjbcQ7kNvwEbLOjV&_nc_oc=AdpRFeKuuFNirM5Zl_FvOWee-4ipgfa5f33pGqE4ahxNdeTXxDTUkosiWShuriGeyEU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ym0u_1RVCaEY94I8pzRzODaROwggnKLtNW9T6DdBjAA&oe=6A15B67D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pet Doctor Simulator - Vet Clinic Game", "keywords": ["pet", "doctor", "hospital", "animal", "simulator"], "long_description": "Step into the world of animal care with Pet Doctor Simulator, the ultimate VR veterinary clinic experience!\n\nPlay as a professional pet doctor and treat adorable animals including dogs, cats, rabbits, and more. Diagnose illnesses, perform medical procedures, use realistic tools, and bring pets back to health in your own virtual hospital.\n\nThis immersive simulator combines fun gameplay with realistic medical interactions designed specifically for VR.\n\nWhether you're cleaning wounds, giving injections, performing checkups, or running emergency treatments \u2014 every patient needs your care!\n\nPerfect for players who love simulation games, pet games, and relaxing VR experiences.\n\nKey Features\n\u2022 Realistic VR veterinary gameplay\n\u2022 Treat multiple animals (dogs, cats, rabbits & more)\n\u2022 Fun and relaxing clinic environment\n\u2022 Progressive difficulty levels\n\u2022 Interactive hand-based controls", "short_description": "Become a real pet doctor! Treat cute animals, perform surgeries, diagnose illnesses, and manage your own virtual vet clinic in this fun and immersive VR simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/valid-games/privacy-policy/privacy-policy-meta-quest", "developer_terms_of_service_url": null, "publisher_name": "Valid Games", "support_website_url": null, "website_url": "https://sites.google.com/view/valid-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26266739672910142"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "927046010176117"}, {"status": "PUBLISHED", "id": "1334675855131976"}, {"status": "PUBLISHED", "id": "1644727123187851"}]}, "baseline_offer": {"id": "1644727123187851"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "927046010176117"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26327192686864840", "version": "1.0.1"}, "id": "1447460040222760", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26266739576243485", "is_concept": false, "latest
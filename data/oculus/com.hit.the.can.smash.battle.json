_Nm-FA&oe=6AFB1E4F"}, {"file_name": "3.png", "id": "1567321665083962", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/585799753_1567321668417295_4374720640753500458_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjDV2_yZgzIQ7kNvwG1DSoQ&_nc_oc=AdrJ2CH4Qj5xZMFeHpyFCg2-vXp5v6Y_L2iftdarjr9Gaxpz8b3F6D0vd3WUONO_uWU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvvJlAqXU1n3Kz5-HWPywtrLSj26ay1dZa4IAw2i2AsQ&oe=6AFB1C71"}, {"file_name": "4.png", "id": "1411478767239615", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/753032404_1411478770572948_244266057180623043_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYXqCZvvkFMQ7kNvwEejgBA&_nc_oc=AdohyUo6OQioqeWcKfs7QYP53VuQxpfoKbpQ4IHmMT0gPxi-IDK4V3dKfitNX3kQh5A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh-txWvfYxRXiqOtY_ceadVfZMPE6gz1Qxok4JQ9EOrQ&oe=6AFB3821"}, {"file_name": "5.png", "id": "1109569884806059", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673531334_1109569888139392_2133930726655397861_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qQLh1MKhl4Q7kNvwEki8dn&_nc_oc=Adothd-HwK3nQuw2i5T88yy-CgLqeWAlZ9OWOu364uqYR_kjT2Vpgcs_hwV1k6hJ0FI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfdUaluvPm_HIdlJyhFt3AUrNc5GStoMmolmmzpwpA5A&oe=6AFB1B03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HIT the CAN", "keywords": ["hit", "shooting", "smash", "battle", "horizon"], "long_description": "Target. Throw. Demolish! Welcome to Hit the Can VR.\n\nReady to test your aim and destroy target stacks in immersive VR? Hit the Can VR is a fast-paced, highly addictive physics arcade game where precision, timing, and strategy meet pure destruction!\n\nSet in a vibrant desert landscape, your goal is simple: pick up explosive orb projectiles and blast through tricky wave formations made of cans, barrels, TNT containers, and obstacles before time runs out!\n\n\ud83c\udfaf KEY FEATURES:\n\nSatisfying Destruction: Feel the impact of every hit as cans and barrels explode, tumble, and collapse realistically in full 3D VR space.\nProgressive Wave System: Face increasingly challenging target layouts\u2014from simple can pyramids to multi-tiered structures with obstacles.\nIntuitive Throwing Mechanics: Designed specifically for Meta Quest motion controllers for smooth, natural hand movements (left or right-handed play supported).\nExplosive Combos & Power Targets: Hit high-value barrels and bonus containers to trigger massive chain-reaction explosions and clear waves faster!\nHigh-Score Chasing: Compete against your own best performance with dynamic score tracking and \"New Record\" achievements.\nPick and Play Fun: Perfect for quick gaming sessions or long hours of high-score hunting. Easy to learn, difficult to master!\n\nWhether you\u2019re aiming for a relaxed shooting practice or pushing for a flawless high score streak.\n\nGrab your controller, lock your target, and smash those cans today!", "short_description": "Step into the ultimate VR target-shooting arcade! Hit the Can VR brings satisfying physics-based demolition straight to your headset. Aim, throw explosive spheres, and smash through towers of cans, barrels, and targets across challenging wave-based levels. Test your precision, break records, and conquer every wave!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nomanawan89.wixsite.com/brokenengineers", "developer_terms_of_service_url": null, "publisher_name": "Broken Engineers", "support_website_url": null, "website_url": "https://nomanawan89.wixsite.com/brokenengineers", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external
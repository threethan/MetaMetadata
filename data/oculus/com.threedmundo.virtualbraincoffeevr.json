w&oe=6A92DDB5"}, {"file_name": "screenshot_5.png", "id": "2973701612963027", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623295_2973701619629693_1690750734526046540_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUER3XcfhdIQ7kNvwEN_hfg&_nc_oc=AdqhHVpjjCXs953rG-bI2oKja3kvIVj_q3FJTmQ3VJ3VhCRAYplnJ2YkrLuKapdFu-w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmsF_7OPMIxgtfQ-AjPeRUdgyrBkt7LspNLPuPQqX4aA&oe=6A92D7CB"}, {"file_name": "screenshot_2.png", "id": "2146075762996795", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619668_2146075766330128_7134984111116982560_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRpSSy_2pAkQ7kNvwG13nvO&_nc_oc=AdqaAgsA4e2ixxn6crMzhOFOVqReAoy21l1peAqEIHfzZvY7kaW_Z7eZizHEzb61-vQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG28uHUoau8JzR2jGAJJQdNyO7A2R6-RktZkiHm1j-gjg&oe=6A92B9A1"}, {"file_name": "screenshot_6.png", "id": "1038018798869634", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620921_1038018802202967_5454610850256896486_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbTQPnb0H7EQ7kNvwEgCSIN&_nc_oc=AdraYU3G5nSDOb8V2OMHpU8AUE2qs-op25HVGgIEmHyzBjV4JLMRUbeM6V403Megn2Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk6-irvNYNqCbznou_kE74nvBb969mGS01hTH1SmeD9w&oe=6A92D142"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1051926940573879", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622315_1051926943907212_2110796268171041497_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvp8iUvvcRYQ7kNvwG-8i5f&_nc_oc=Ado3EofzltVpJFuLcGHvdd_phr1Eaf_elh3MPm_1a6L4MSCY986n23DIOu1w5UIELz0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTUjD2JZ-EOy0rtCXjfqOj788596EVUMhmVi48qo_N1Q&oe=6A92DA3A"}, "display_name": "Brain Coffee", "keywords": ["cafe", "energia", "enfoque", "motivacion", "bienestar"], "long_description": "Step into the most exclusive coffee house in the universe: your own. Brain Coffee VR is a premium wellness & entertainment experience\nfor Meta Quest. A black-and-gold futuristic lounge where the coffee ritual\nbecomes audiovisual sessions of energy, focus and motivation \u2014 rhythmic\nmusic, a guiding voice, golden steam, and a holographic brain that lights up\nwith your progress.\n\u2615 DOUBLE ESPRESSO \u2014 YOUR ENERGY PROGRAM\nTen professionally mixed audio tracks in English and Spanish: five deep\nsessions (Morning Ritual, The Grind, Extraction, Aroma & Memory, Energy &\nFocus) plus five 5-minute quick shots for when you need a boost right now.\nMusic, positive affirmations and rhythmic pulses, mixed for the headset.\n\ud83e\udde0 A BRAIN THAT PULSES WITH YOU\nOur holographic visualizer \u2014 an artistic representation, not a medical one \u2014\ngoes from dormant bronze to radiant gold as your session builds, beating in\nsync with the music.\n\u26a1 POWERS STAGE\nSome sessions wake up the caf\u00e9's electric side: surprise visual effects at\nthe center of the stage, different every time.\n\ud83d\udc9b COFFEE DATE WITH VALENTINA\nFive minutes of virtual company: Valentina walks in, sits at your table and\nchats with you \u2014 hundreds of voiced lines with subtitles, facial\nexpressions, blinking and natural gaze. A warm way to end the day.\n\ud83c\udfc6 YOUR 4-WEEK PLAN\nA consistency calendar, streaks, accumulated minutes and the Brain Caf\u00e9\nCommunity. Everything is stored locally on your headset.\nFeatures\n100% comfortable: fully enjoyable seated,", "short_description": "Your futuristic brain caf\u00e9: energy & focus sessions, golden beats, a\nholographic brain \u2014 and a coffee date with Valentina."}, {"images": {"nodes": []}, "id": "1206224115025209", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain Coffee", "keywords": ["cafe", "relajacion"], "long_description": "Entra a la cafeter\u00eda m\u00e1s exclusiva del universo: la tuya.\nVirtual Brain Coffee VR es una experiencia premium de bienestar y\nentretenimiento para Meta Quest. Un lounge futurista en negro y oro donde el ritual del caf\u00e9 se convierte en sesiones audiovisuales de energ\u00eda, enfoque y motivaci\u00f3n \u2014 con m\u00fasica r\u00edtmica, voz gu\u00eda, vapor dorado y un cerebro hologr\u00e1fico que se enciende con tu progreso.\n\u2615 EXPRESO DOBLE \u2014 TU PROGRAMA DE ENERG\u00cdA\nDiez pistas de audio profesionales en espa\u00f1ol e ingl\u00e9s: cinco sesiones\nprofundas (Ritual de Ma\u00f1ana, Molienda, Extracci\u00f3n, Aroma y Memoria, Energ\u00eda y\nEnfoque) y cinco refuerzos r\u00e1pidos de 5 minutos para cuando necesitas un\nimpulso ya. M\u00fasica, afirmaciones positivas y pulsos r\u00edtmicos, todo mezclado\npara el visor.\n\ud83e\udde0 UN CEREBRO QUE LATE CONTIGO\nNuestro visualizador hologr\u00e1fico \u2014una representaci\u00f3n art\u00edstica, no m\u00e9dica\u2014\npasa de bronce dormido a oro radiante conforme avanza tu sesi\u00f3n, latiendo al\nritmo de los beats.\n\u26a1 ESCENARIO DE PODERES\nAlgunas sesiones despiertan el lado m\u00e1s el\u00e9ctrico del caf\u00e9: efectos visuales\nsorpresa en el centro del escenario, distintos cada vez.\n\ud83d\udc9b CITA DE CAF\u00c9 CON VALENTINA\nCinco minutos de compa\u00f1\u00eda virtual: Valentina entra caminando, se sienta a tu\nmesa y platica contigo \u2014 cientos de frases con voz, subt\u00edtulos, expresiones\nfaciales, parpadeo y mirada natural. Un momento c\u00e1lido para cerrar el d\u00eda.\n\ud83c\udfc6 TU PLAN DE 4 SEMANAS\nCalendario de constancia, rachas, minutos acumulados y la Comunidad Brain\nCaf\u00e9. Todo se guarda localmente en tu ", "short_description": "Tu caf\u00e9 cerebral futurista: sesiones de energ\u00eda y enfoque, beats dorados, un cerebro hologr\u00e1fico y una cita de caf\u00e9 con Valentina.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/94b69974-999a-
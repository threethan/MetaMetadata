ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuxXNZtbovM0eQEeiDhkkiVdK5c2TEV-FBZuuFEthW_Aw&oe=69A83D5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Steal a Monkrot", "keywords": ["steal", "a", "gorilla", "tag"], "long_description": "\ud83e\udd8d Steal a Monkrot \u2013 VR Brainrot Chaos! \ud83e\udd8d\n\nStep into a wild VR playground where gorillas go absolutely bananas! Collect brainrots, earn coins, and unlock crazy upgrades. Outsmart your friends, cause chaos, and climb your way to the top in this frenetic gorilla adventure.\n\n\ud83e\udd2a How to Play:\n\nGrab monkrots scattered around the map \ud83e\udd64\ud83e\udd77\n\nSneak or race to steal from other players \ud83d\udc0a\u2708\ufe0f\n\nEarn coins to buy fun items and power-ups \ud83d\udc18\ud83c\udf35\n\nRebirth to unlock new abilities and rewards \ud83d\udc38\ud83d\udede\n\nTroll your friends with quirky tools and gadgets \ud83e\udd88\ud83d\udc5f\n\nEvery gorilla is out for themselves \u2014 can you protect your monkrots and dominate the jungle? \ud83e\udd4a", "short_description": "\ud83e\udd8d Steal a Monkrot \u2013 VR Brainrot Chaos! \ud83e\udd8d\n\nStep into a wild VR playground where gorillas go absolutely bananas! Collect brainrots, earn coins, and unlock crazy upgrades. Outsmart your friends, cause chaos, and climb your way to the top in this frenetic gorilla adventure.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/steal-a-monkrot/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jakalvr ", "support_website_url": null, "website_url": "https://sites.google.com/view/steal-a-monkrot/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genre
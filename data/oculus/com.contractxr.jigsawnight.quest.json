nsbdJYl7DKnrtPowyDBKhBuwx-l_gg&oe=6A216F00"}, {"file_name": "temp-quinn.png", "id": "1666950277352344", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304870_1666950280685677_8766750966799573718_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WZc7egh538Q7kNvwEU-8DD&_nc_oc=Adr2CtbYVfFSsTGieyMGssNa-7bJM5B7n1DSnXqxgniqtiW6xbmB2wDFbg2JyoSi53U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M2q4gBRrJNtKmSvDcXwCFwkF2dz-SSJ_XGLLSXnr1GA&oe=6A216EBD"}, {"file_name": "kidsstanding.png", "id": "1219627489466959", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821955_1219627492800292_3918659132358799655_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fsK2jCh990Q7kNvwGEN6Ze&_nc_oc=AdowhYtShiEB5QMs82VuPPk5oYK61OArGhoTyx-GKJHDT1vVgdZ_g3SW3n81rLA1VZU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Hcrcl1CBXm9leoC-OlrLeEiiZ3Nqg0TLtg3AOUENX_A&oe=6A2179A2"}, {"file_name": "temp-workwonder.png", "id": "1576844762982611", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391920_1576844766315944_9182939816336911220_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UffVLP1BDGIQ7kNvwFgpyng&_nc_oc=AdqEylRDzQ7CThWoA-jPVRhdvmgt-dD8E_bqIERxO0FyEwZt_99Dc8-3qxmCR9Cn2Yk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2ZGPJtwutvl95JaaKJl6DgdKvua31pHEkX--wOE0N2w&oe=6A217CC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tada_w_logo.png", "id": "613585824415659", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491831000_613585831082325_1279577589252595943_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-s4LVqm2uXIQ7kNvwEBzpPd&_nc_oc=AdpEcCKmNd4I6Wh4K949Oi2h9toWiF9FFqMXtybwWGvwFIJ5NjvJ-56-uO0GQIWmUaQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lOn8B6eNyD9Ce9LV-0NV81T2N-AIT5uDOScUzfgspdg&oe=6A2170B7"}, "display_name": "Jigsaw Night", "keywords": ["jigsaw", "puzzle", "multiplayer", "puzzles", "family"], "long_description": "Jigsaw Night is the most satisfying puzzle game you\u2019ll want to play forever!\n\nBuild jigsaw puzzles in 3D space with pieces floating all around you. Play on your own, with family at home, or friends around the world!\n\n**Fully Accessible**: It feels so real and natural to use. Use your hands or controllers to place pieces together. It\u2019s the ultimate way to introduce new people into VR and MR.\n\n**Intimately Social**: Play together in person. Build puzzles together in the same room while spending quality time in person using automated one-touch multiplayer. Perfect for family game night.\n\n**Endlessly Personal**: With Facebook photo integration, build old memories and create new ones assembling puzzles with friends and family imported straight from decades of stored images that are served directly from Facebook itself.\n\n**Spend time together from afar.** Play seamlessly with up to 4 other people. Avatars and voice chat make it feel like you\u2019re together for real.\n\n**Variety of puzzles to choose from.** Choose from a selection of curated puzzle imagery and settings for a custom experience.", "short_description": "Jigsaw Night is a satisfyingly simple social VR jigsaw puzzle game!\n\nFully Accessible: Build puzzles in 3D space like it's second nature with hands or controllers.\n\nIntimately Social: Designed for in-person play for quality time while supporting online multiplayer to connect with friends and family around the world.\n\nEndlessly Personal: Connect w/ Facebook to build personalized puzzles straight from your own albums.\n\nIt's the ultimate way to introduce friends and family into VR.\n\nTry it today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jigsawnight.com/privacy-policy/", "developer_terms_of_service_url": "https://jigsawnight.com/terms-of-service/", "publisher_name": "ContractXR Inc.", "support_website_url": null, "website_url": "http://www.jigsawnight.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST",
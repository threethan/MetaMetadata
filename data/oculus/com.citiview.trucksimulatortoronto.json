5444072523841_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvioGx8isekQ7kNvwFHNWl7&_nc_oc=AdomKOgHxNJw7zmKKYPKZR75GMjFXy4DaRFsmg5h37cXJVZKs1Ml2X_icpuaYr-DoOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9F5VrKxKW816Moi_7fl4HxKyVWFMUNQL0Q_QZQrcI-w&oe=6AF5DBD3"}, {"file_name": "screenshot_1.png", "id": "1123045120063269", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595119480_1123045123396602_8251649338889502289_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCroA6IoSe0Q7kNvwEJr5zE&_nc_oc=Adr-Muh7Q7mLtmznd90-v-WsSdFd_4Ile_iEVCcCtOLnjCU3NUbCQ_bzIa9O30ZmFX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqBr_wDg_kBA0hYUu3aEFkDMlz-fHehaRF8OaNaK96Ww&oe=6AF5E671"}, {"file_name": "screenshot_4.png", "id": "1068990046012382", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_1068990049345715_5644690609355432735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKkMAgUb0FgQ7kNvwGF_7tf&_nc_oc=AdqiMOv5qWoB0wtg1KYBqDeYLpkNsrgVOgm0QY1FaLASMgKau3Z9aRANyjOz52Wfohc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3ENIdNz-we9ElhUJoVzDIbj_34xpVdzKyD6I11Erj6g&oe=6AF5E5F6"}, {"file_name": "screenshot_3.png", "id": "2044153746304226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831964_2044153749637559_998345977667307184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngo5I7QwX4QQ7kNvwGXBoc2&_nc_oc=Adp8xCeiCpeG7qTl7teMPpQyrCFcIb40qf5o-hWc_ps5L4PcdzC5sC-5vmRVQ5gQ_zs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNAC0lgCZ0El5Ub53Vl4NH3H4M6seTu4P1Hm-m9a3vmw&oe=6AF5CA40"}, {"file_name": "screenshot_5.png", "id": "2367495087354480", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_2367495090687813_5107074382154831039_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGiKOk-q1IUQ7kNvwGNI41L&_nc_oc=AdpYY0_auitNGceaPPPbne_yvlLfIrIVutO1R0JeML9sQcAj53hN5Epg1I3WQ4-CliU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-SjiSIxYu0vVBUsV9nnrf8ZtBYpVwbsVOWlI6y83RVQ&oe=6AF5C758"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1105773351946833", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830576_1105773355280166_9005912515176579500_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kr_trA12N2MQ7kNvwGEtFxw&_nc_oc=AdoKOQQgRDh_3t-bKHcHr0QkHoZ165Gx9W4LhACu5V4qglUpE-0WhzjXxYQVSDiIXsg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkXpwQcetEC3guAco2liuZ3dYOuAOgyNtbJwam-bMQMQ&oe=6AF5DCA6"}, "display_name": "Truck Simulator Toronto", "keywords": ["truck", "trucking", "driving", "simulator", "toronto"], "long_description": "The open road, from the driver's seat - in Toronto.\n\nA REAL CITY LOOP\nA 63 km loop of Toronto highways built from real map data: west on the 401, south on the 427, east along the elevated Gardiner with the skyline and the CN Tower ahead, then north up the Don Valley Parkway. Real ramps, real bridges, and the cloverleaf that crosses over itself.\n\nA SHOW TRUCK TO CALL HOME\nWalnut dash, cognac tufting, fourteen working gauges and a starlight headliner. Reach out with your own hands: grip the wheel, pull the air horn, set the parking brake - or drive with the joysticks if you prefer.\n\nA REAL 10-SPEED\nPick AUTOMATIC and just drive, or switch to MANUAL and float a 10-speed through the H-pattern with a LO/HI range. Lift off, match the revs, and it drops in. Miss it and it grinds.\n\nHAUL REAL LOADS\nSix depots in real neighbourhoods. Back under your trailer, take the load from dispatch, merge into city traffic and deliver it. Dock it clean for a bonus and climb the career ranks.\n\nDAY AND NIGHT\nDrive at noon or after dark with the city lit up around you. Night runs pay extra.\n\nON THE RADIO\nA real dispatcher and five truckers on the CB with local road talk, coffee tips and photo radar warnings.\n\nTHE SLEEPER\nParked for the night? Leave the seat, walk back into the sleeper and sleep through to morning.\n\nPlus 17 achievements, 9 truck paints to unlock, a live map, and seat height and position settings for a perfect fit.", "short_description": "Grab the wheel of a long-nose show truck and haul freight around the real highways of Toronto. Drive the 401, the 427, the Gardiner past the CN Tower and up the Don Valley, by day and by night. Shift a real 10-speed manual or let the automatic do it, take loads from dispatch, chat on the CB, then walk back and rest in your sleeper."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/trucksimulatortoronto/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/trucksimulatortoronto/", "website_url": "https://citiview-games.pages.dev/trucksimulatortoronto/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1291980620674577"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1164529896095389"}]}, "baseline_offer": {"id": "1164529896095389"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791814020, "status": "PUBLISHED", "id": "1164529896095389"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "129320163388580
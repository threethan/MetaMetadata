uWBT9YqkqRyGQRxxT4jntrFv3ncLsI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHbpMg_JlZd-Lc0tTjJBIGzMNSP8sATk7kw3oLY8J6hA&oe=6AFB2219"}, {"file_name": "3.png", "id": "1029219243349967", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823757_1029219246683300_1837710193037491028_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpMjb2oe58oQ7kNvwHNradF&_nc_oc=AdqS5PfeyOnIWmPfiZhqXnIDSGqzM3uchB5VP9_iQgOUxGhp0Zr_XUn8II0qeBA6b-o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUMFpe83IPZmtF6OSAg54apwo8wBe04050pYQtQX0f2g&oe=6AFB1809"}, {"file_name": "1.png", "id": "4470627449862598", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821796_4470627453195931_2196487897678524902_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0_W-0EQm8MQ7kNvwHHma8o&_nc_oc=AdqcZL70B7PJF6XnffQz2Z2F1GtQOFW6KhCOqZC07D-VU1a15Tbtu39991vhEYPjV2U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsB1LS_a3XMf9UjDLrqxm7NfhRivTgvPdM_ygQroN-dw&oe=6AFB3E0F"}, {"file_name": "5.png", "id": "1056409053759264", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824741_1056409057092597_48935579424925536_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGFyg2Z3WCUQ7kNvwFUL7KJ&_nc_oc=AdryJ0IoVgjmEnsvoOSFWHYEpvU_uUCkuFei2Gm-yrD1sFwDrrW82GyNH9a0YFfskiQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkQIgYxRnHLoc4D5zSKat0Wt2kzRhdg2pxedpPniXKsw&oe=6AFB3F6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Speed Horizon Car Racing Game", "keywords": ["SpeedHorizon", "CarRacingGame", "RacingSimulator", "SportsCarDrive", "RacingGame"], "long_description": "# Speed Horizon VR Car Racing\n\n**Speed Horizon VR Car Racing** is now available, delivering an immersive virtual reality racing experience for players who love speed, realistic driving, and powerful cars\n\nStep into a fully interactive VR garage where you can walk around, inspect vehicles up close, and sit inside detailed car interiors before taking them onto the road. Explore four unique showroom rooms featuring Sports Cars, Supercars, Muscle Cars, and Off-Road Vehicles.\n\nRace across highways, city streets, and exciting racing circuits in immersive first-person VR. Experience realistic vehicle handling, detailed cockpit interiors, and smooth controls designed for an exciting racing adventure.\n\nEverything shown in the screenshots is real gameplay captured directly from the game.\n\n**Features:**\n\n* 8 detailed vehicles available at launch\n* 3 unique racing tracks\n* Fully walkable VR garage\n* 4 unique vehicle showroom rooms\n* Detailed cockpit and interior views\n* Sports Cars, Supercars, Muscle Cars, and Off-Road Vehicles\n* 10 different tire quality options to customize handling\n* Immersive first-person VR driving\n* Realistic driving mechanics and smooth controls\n* High-quality graphics optimized for VR\n* Regular updates with new cars, tracks, vehicles, game modes, and features\n\nDownload **Speed Horizon VR Car Racing** today and begin your journey to become the ultimate VR racing champion!\n", "short_description": "\ud83c\udfce\ufe0f\ud83d\udd25 Speed Horizon Car Racing Game is Now Available!\n\nThe wait is over! Speed Horizon Car Racing Game has officially launched.\n\nGet behind the wheel and experience fast-paced racing with realistic driving, exciting tracks, and intense competition. Master every turn, unlock powerful cars, and prove your skills on the road.\n\nAll screenshots shown above are original in-game screenshots captured directly from the actual game.\n\nDownload Speed Horizon Car Racing Game today and See you on the track"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neon-horizon-games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Neon Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/neon-horizon-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1396161660238084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623295_1795036181877940_6032214228685290350_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDAjA1ad04cQ7kNvwEv_RHC&_nc_oc=AdoXlOvOSjRLNsYiFDLiVRk60Q9djwFYkdu71nBSMkm7sbG2njwYoKxltAmsJ5DPt4A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXstsXLd9zyGqqtiJvOc65kYJ01XnqNqnI0XJOtfV75g&oe=6AFB22D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Speed Horizon Car Racing Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1788368400, "lastRevision": {"nodes": [{"id": "1264550216732563", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1264550203399231", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2095683838039064"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [
https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622334_1571969911159230_1093903761674688273_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4v_U9J0VLwQ7kNvwEcRaTq&_nc_oc=Ado7_Jo4eqmm1-sKNSBrlWqsQkFdpRzvmZlkLbZo_eHos9wOjcg1TkS5Tf5Ap03ej-c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfLW1xjO40M9wcknzb4ieFxN_o4iKjtOLt93jIfrIVvw&oe=6AFB26C9"}, {"file_name": "5.png", "id": "1011110561468924", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622285_1011110564802257_9129636241154005667_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNoV34xmQUcQ7kNvwG4B3Dd&_nc_oc=AdqtUad6w-L73Sb9L8TSjoiUhLYr7rCgyl8JYrTxdOk1MHnWEQs5sM8gixDskAwI9Q0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpryEyfhuKGoc_JdYi8B_eZeCLfSMrT92iIsdueUVykg&oe=6AFB2F39"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Speed Horizon Car Racing Game", "keywords": ["SpeedHorizon", "CarRacingGame", "RacingSimulator", "SportsCarDrive", "RacingGame"], "long_description": "Speed Horizon VR Car Racing is an upcoming virtual reality racing experience designed for players who love speed, immersion, and powerful cars.\n\nStep into a fully interactive VR garage where you can walk around, inspect vehicles up close, and sit inside detailed car interiors before hitting the road. Explore 4 unique showroom rooms featuring Sports Cars, Supercars, Muscle Cars, and Off-Road Vehicles.\n\nExperience high-speed racing across highways, city streets, mountain roads, and racing circuits inspired by real-world locations. Every race is designed to deliver an immersive VR driving experience with realistic vehicle handling and smooth controls.\n\nEverything shown in the screenshots is real gameplay content available in the game.\n\nFeatures:\n\n\u2022 20+ detailed vehicles to drive\n\u2022 10+ racing environments and tracks\n\u2022 Fully walkable VR garage\n\u2022 4 unique vehicle showroom rooms\n\u2022 Detailed cockpit and interior views\n\u2022 Sports Cars, Muscle Cars, Supercars, and Off-Road Vehicles\n\u2022 Immersive first-person VR driving\n\u2022 Realistic driving mechanics and handling\n\u2022 Global leaderboards and racing challenges\n\u2022 Day and night racing environments\n\u2022 High-quality graphics optimized for VR\n\u2022 New cars, tracks, and features planned for future updates\n\nSpeed Horizon VR Car Racing is currently in development. Add it to your wishlist and prepare for the ultimate virtual reality racing adventure.", "short_description": "Race at top speed, master challenging tracks, and become the ultimate road champion in Speed Horizon Car Racing Game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neon-horizon-games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Neon Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/neon-horizon-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1264550210065897"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1368678909653026", "version": "1.3"}, "id": "132615764
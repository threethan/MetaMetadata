4LmIlrZSQn7itlrlnnnV5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVfvgruzCZ1DjQeaRXCygYk-OUT2R8HI62t1JNTYX_V-w&oe=6B105692"}, {"file_name": "sky-beat-4-shot-3.png", "id": "1611978093194475", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825503_1611978096527808_8855934504507519302_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayPNtPF1hhEQ7kNvwHzj-RG&_nc_oc=AdrsJBW-HOGWU916Q3FwOLic6hlqDJT_1E-NqF46DEnnnC55j30C2RKK1XS2-z8ob9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVSDn_04lmxcqhQ1R67Lvk0aV0TN5LqQwB9sH87fKE_uQ&oe=6B103591"}, {"file_name": "sky-beat-4-shot-5.png", "id": "1096032396531920", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825563_1096032399865253_7792806543165094150_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3JUE3HGeEwQ7kNvwFDTLhA&_nc_oc=AdoRytlr7LgFBI4RMl6vYBlfbv3UNmd768dsS5vBKH64VyCupadhap5dMRdTzn4qK9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxQmi19_KNoToSzPZRL-jCF3el44rD04dvjdjfJLihiQ&oe=6B1039D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brojek Sky Beat 4 Pirates", "keywords": ["rhythm", "pirates", "music", "drums", "sword"], "long_description": "Ahoy! Brojek Sky Beat 4 Pirates is a pirate rhythm game in VR.\n\nEvery round starts on a pirate drum kit made of barrels and brass cymbals. Then the drums sink away, your sticks turn into two cutlasses and a wooden conveyor brings everything to the beat: treasure chests full of coins, long crates you rip open, chains, cannonballs, barrels, ropes, bottles, maps and gems.\n\n- Drums, swords and fists: play the drums, slice to the beat, then punch down 5 meter brick walls with steel fists\n- Cut pirates, the arms of the Kraken and the fragments of cannon shots\n- 7 arenas in 360 degrees: Turquoise Bay, Sun Fortress, Ghost Fleet, Volcano Island, Ice Corsairs, Treasure Grotto and the Kraken Storm\n- 7 original pirate songs\n- Standing or seated mode, 3 difficulty levels, coins and gems to collect\n- Don't slice the skull bombs!\n\nHoist the sails and play to the rhythm of the seas!", "short_description": "A pirate rhythm adventure in VR: play the barrel drums, slice treasure chests and cannonballs with two cutlasses, cut the Kraken's arms and smash brick walls with giant steel fists."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brojekgames.com/privacidade.html", "developer_terms_of_service_url": null, "publisher_name": "BROJEK", "support_website_url": null, "website_url": "https://brojekgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1372659812601145"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829120_1832786344403723_245916021698523453_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLKwfBjjOOYQ7kNvwGU2OkR&_nc_oc=Adq-dRXAEx6S90SoQKdCb2y62az1VFzRnaQRDp-JVcEZTnSnZvBahMU6MUJv6Klp7vE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU6-n98KhT04PDXmC3ynt6JU_TvZmPGMOetKPeJ9fyd3w&oe=6B105347"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brojek Sky Beat 4 Pirates", "platform": "ANDROID_6DOF", "context_category":
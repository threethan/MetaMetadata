7Y3-jXdXGN4VN9QqQ&oe=6A8580E8"}, {"file_name": "void.png", "id": "907825661550798", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312649_907825664884131_4192754845143370771_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vy1EEm_tkdIQ7kNvwHVXPIo&_nc_oc=AdojJIFEsDAiGKTzx06FerPNt2Frpx_VGp8MEngf68vtKNBmAaAFY1mv4FOG5XxLdGE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzGCYxRPymK98DrgsNBfc_MuW0e7X53HoNqy_t5SsPqA&oe=6A85ABED"}, {"file_name": "shop.png", "id": "1177142504428672", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827063_1177142507762005_6964122265032431161_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HN5Ck5QEeyEQ7kNvwHm4xgO&_nc_oc=AdroSGhv985EVHysWtLiR2T-GOBS7ukpKnvZXY4S5PQ3TRRJLYsOYJY6kmXNRZsy0Po&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXtmAMC--H1RuleKAMfCA4Y-P_AkQiU_NLlv5BXnzf3Q&oe=6A859B46"}, {"file_name": "lowerforest.png", "id": "1474888003698317", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/507833247_1474888007031650_2819775234743884767_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFbFMd4z7vwQ7kNvwHxqs4d&_nc_oc=Adog9Qj41tF2wO_Tk6kn0itRlfVGwk6KREZh5SQAQe9-XD2gU8WaUtV2YCJotZuAWgc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4jInpiZ7OQ2jGkhOJt8VYBeCyt8cQB6S6RNYfu3XN6Q&oe=6A85A0E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Banana Bros", "keywords": ["monkey", "Gorilla", "Tag", "fangame", "banana"], "long_description": "Welcome to Banana Bros \u2014 a laid-back multiplayer monkey playground where fun comes first and competition takes a backseat.\n\nSwing through treetops, bounce around using your arms, and explore hand-crafted maps with your fellow bros. Whether you\u2019re climbing to new heights, showing off tricks, or just goofing around, there\u2019s always something to do and someone to do it with.\n\nThere are no enemies here \u2014 just a bunch of bros, chill vibes, and endless monkey business. So grab a friend (or three), hop in, and let the good times peel.", "short_description": "Banana Bros is a chill multiplayer monkey game where you swing, explore, and monkey around with friends \u2014 no pressure, just bananas and good vibes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elementalapes/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Swift0555", "support_website_url": null, "website_url": "https://sites.google.com/view/elementalapes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9993389050765970"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821755_1246311153542141_2234505887658940952_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_Q_ia5GymMQ7kNvwH8bKyy&_nc_oc=Adozi4eFf-aBe21o8fMIC1EujCUfnCAxDFfcUiPI7CCGWahXotT2_ZF9bt2KIVv2mkA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX_Hw8bXexCeObH2NciBkcA5imKlQm9nVpV9K-CZYUzg&oe=6A857B3B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Bros", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure
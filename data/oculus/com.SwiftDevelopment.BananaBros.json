QCw&oe=6A048628"}, {"file_name": "void.png", "id": "907825661550798", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312649_907825664884131_4192754845143370771_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGT1iBHmpicQ7kNvwGScm-8&_nc_oc=AdrQIi9HCMWsb6KApWLJaU2DSoR7rsxrr0QKMilT7S51yt95ykcRWt2or4NrrImsD0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sJG3ShWexL_p0ao8WuFVF8E04iMIUFx-cR4oMq6Da6Q&oe=6A0478ED"}, {"file_name": "shop.png", "id": "1177142504428672", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827063_1177142507762005_6964122265032431161_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNiLj_uNyasQ7kNvwGVGFct&_nc_oc=AdoqgMl39wObLXIhJ1JGuOrySdidZ0lJtY4xOZFdk8DP8dBiA_wCBOd4h0pZ1CFGT4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BjPIztkReKejKEGS_J5VNLooXyu2BBgR4WU-j7wHXgg&oe=6A046846"}, {"file_name": "lowerforest.png", "id": "1474888003698317", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507833247_1474888007031650_2819775234743884767_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-YfPx4iJWoQ7kNvwEyYPMq&_nc_oc=Adrh2C3ryMDHmuuMuH9WJCyerJTOp3K8V12sfcjR77ydqga67DhmcLyol3mAzQw5uoU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oAGOL4gAvL9KmxjOPPlz8r-zko-VP36jdVqDRRFFR8g&oe=6A046DE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Banana Bros", "keywords": ["monkey", "Gorilla", "Tag", "fangame", "banana"], "long_description": "Welcome to Banana Bros \u2014 a laid-back multiplayer monkey playground where fun comes first and competition takes a backseat.\n\nSwing through treetops, bounce around using your arms, and explore hand-crafted maps with your fellow bros. Whether you\u2019re climbing to new heights, showing off tricks, or just goofing around, there\u2019s always something to do and someone to do it with.\n\nThere are no enemies here \u2014 just a bunch of bros, chill vibes, and endless monkey business. So grab a friend (or three), hop in, and let the good times peel.", "short_description": "Banana Bros is a chill multiplayer monkey game where you swing, explore, and monkey around with friends \u2014 no pressure, just bananas and good vibes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elementalapes/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Swift0555", "support_website_url": null, "website_url": "https://sites.google.com/view/elementalapes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9993389050765970"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821755_1246311153542141_2234505887658940952_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIdd8UoICjEQ7kNvwEZ8wzg&_nc_oc=AdokTWxuwWxoMabaZ9zaN_RqTRPyuc8h0MnWh-ltGvYHGXg3q_rproR44bc3Yb_NxwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RzcNpETstNTse36QBv7a-3CuXw9EynEvqu76Fe_wZrw&oe=6A04807B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Bros", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "26918901
4mw&oe=6AF5C8A8"}, {"file_name": "void.png", "id": "907825661550798", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312649_907825664884131_4192754845143370771_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e3GdqR6yosQ7kNvwHX44Hk&_nc_oc=AdpTL808vHoDF7oJ2bG2_etsleQuLFovwf_mBaBwZb2LB8YjmPJ8tv-0OuvNBen9J3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHCjQmX4FWtH3pMb4EI7ADiquKVYXBmq20FCsFUYzFlA&oe=6AF5F3AD"}, {"file_name": "shop.png", "id": "1177142504428672", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827063_1177142507762005_6964122265032431161_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGa6z-aoHQAQ7kNvwFg8Atq&_nc_oc=AdpSsvpk66auPpcBro5M2Io2T_Gn8_UYGe1jM6h-BTjnUSVntl7PkJL_Wf_x2a8iX4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4HpBEJ1BJO0TbljVD_zBAqDiT2eFAbiAdIfhiUK9IhQ&oe=6AF5E306"}, {"file_name": "lowerforest.png", "id": "1474888003698317", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507833247_1474888007031650_2819775234743884767_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NlvIgrfKgkQ7kNvwETdX6q&_nc_oc=AdrN6TPIexjYW0SAErgyLg-U0SW7NfKWCSrTOJ4S2GRkIqj9BR8Mg5Q2_ORljwo1Xx8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIEbpJ-ZxPSkeeWt_cOGDqV48Gg1qKUpVj9K4hWYpjdQ&oe=6AF5E8A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Banana Bros", "keywords": ["monkey", "Gorilla", "Tag", "fangame", "banana"], "long_description": "Welcome to Banana Bros \u2014 a laid-back multiplayer monkey playground where fun comes first and competition takes a backseat.\n\nSwing through treetops, bounce around using your arms, and explore hand-crafted maps with your fellow bros. Whether you\u2019re climbing to new heights, showing off tricks, or just goofing around, there\u2019s always something to do and someone to do it with.\n\nThere are no enemies here \u2014 just a bunch of bros, chill vibes, and endless monkey business. So grab a friend (or three), hop in, and let the good times peel.", "short_description": "Banana Bros is a chill multiplayer monkey game where you swing, explore, and monkey around with friends \u2014 no pressure, just bananas and good vibes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elementalapes/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Swift0555", "support_website_url": null, "website_url": "https://sites.google.com/view/elementalapes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9993389050765970"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821755_1246311153542141_2234505887658940952_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7Uj_ILOgEcQ7kNvwFjivoh&_nc_oc=AdqZHhy7pUvC_yDeK6oFiAiXguW0HK9hryUBwvCnU14qAH3JlT8FAFgNRlpcZy1SIe4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvgLDsJZI-Qc2vYML0PBd4BXM6pb0b4xC18QGFpT4BQA&oe=6AF5C2FB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Bros", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "26918901
 multiplayer monkey playground where fun comes first and competition takes a backseat.\n\nSwing through treetops, bounce around using your arms, and explore hand-crafted maps with your fellow bros. Whether you\u2019re climbing to new heights, showing off tricks, or just goofing around, there\u2019s always something to do and someone to do it with.\n\nThere are no enemies here \u2014 just a bunch of bros, chill vibes, and endless monkey business. So grab a friend (or three), hop in, and let the good times peel.", "short_description": "Banana Bros is a chill multiplayer monkey game where you swing, explore, and monkey around with friends \u2014 no pressure, just bananas and good vibes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elementalapes/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Swift0555", "support_website_url": null, "website_url": "https://sites.google.com/view/elementalapes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9943794952392047"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "10092107890858729"}]}, "baseline_offer": {"id": "10092107890858729"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753191960, "status": "PUBLISHED", "id": "10092107890858729"}]}, "liveChannel": {"nodes": [{"latest_su
uAV4yrisQ7kNvwFjTNNr&_nc_oc=AdqxhWo6z-ll-Ypd7zsPmxbXFyDGHKjzkvmXgzR6juuymQGBFEEZN3yZLL-4U4NxbMI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw2vSgHmiGKS5GFEz9oaCerN2-Kff7Km2tD5KDid37lw&oe=6AFB19D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Defibrillator Simulator", "keywords": [], "long_description": "In this training simulator you will learn how to properly use an automated external defibrillator (AED) in VR. Practice the proper procedure for using an AED in the event of a cardiac emergency. You will also learn how to correctly administer cardiopulmonary resuscitation (CPR). CPR is an emergency lifesaving procedure performed when the heart stops beating. Immediate CPR can double or triple chances of survival after cardiac arrest.", "short_description": "In this training simulator you will learn how to properly use an automated external defibrillator (AED) in VR. Practice the proper procedure for using an AED in the event of a cardiac emergency. You will also learn how to correctly administer cardiopulmonary resuscitation (CPR). CPR is an emergency lifesaving procedure performed when the heart stops beating. Immediate CPR can double or triple chances of survival after cardiac arrest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
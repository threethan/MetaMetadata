nt-fra5-2.oculuscdn.com/v/t64.5771-25/499300946_641758112338990_4436843572709011840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCQxF7k238UQ7kNvwFVL91h&_nc_oc=Adop6dTgexZPnT_PYbGXIm8tBYpTZ22kmj1NG8isW90GDooijnyh1NzzgGQvbu4OdzA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-03-otNOKaPcrv4JlngoMHVMrd-EtrvSoovUZ9Ap2RPA&oe=6A2C0DC6"}, {"file_name": "Screen2.png", "id": "1125110219567170", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499303769_1125110222900503_3934625776265974094_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtLXGC9jPXYQ7kNvwG0fEGD&_nc_oc=AdpS1bsur-RHa_ep0vbpP_K1AsciTDtMt6ofyJhveQ6DhYaUALmfh2395-Ez6Wb0dds&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GLpY13D_OOs5EKAiapF3EMnMZcAwPJgns6i9SbDDKLA&oe=6A2BFE95"}, {"file_name": "Screen4.png", "id": "1777740536185805", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827067_1777740539519138_4771868571748201233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyIgg8gIwY8Q7kNvwGUSa77&_nc_oc=AdqyEo9SmTrLJ3MvEZGmj4vT39QjuFf12548-a97-Yyn-fvCtSK2j4702eClRAOG9m8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SUjjjnOaith-4oX89jMTdram0xoyuA5YEHRC1F3JfPg&oe=6A2C2D66"}, {"file_name": "Screen5.png", "id": "1798679524072148", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617762_1798679527405481_6084302047502627610_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug3DaItjllEQ7kNvwFj2gN-&_nc_oc=AdpN5d2xegZvmNDQw1M97lspgmci5PPQi3d7l1arxurcSNPBCBuqv2nB04igq5ce1Ig&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l9jRfpBqCDw1VsMmS3jGk0NrGY4GaIP4El1rqleWtxQ&oe=6A2C34EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F/A-18 Pilot Simulator", "keywords": ["Flight", "Simulator", "Aviation", "Pilot", "Sim"], "long_description": "F/A-18 Pilot Simulator \u2013 Experience the Thrill of Carrier Aviation in Full VR\n\nStrap in and take command of the legendary F/A-18 Super Hornet in F/A-18 Pilot Simulator, the most immersive and realistic VR flight experience available. Designed from the ground up for full VR touch controls, this flight simulator puts you directly in the cockpit with unparalleled detail and interactivity.\n\nMaster the skies as you navigate high-speed jet maneuvers, then take on the ultimate challenge: landing on a moving aircraft carrier in dynamic ocean conditions. Feel the adrenaline, the precision, and the pressure\u2014just like real Navy pilots do.\nKey Features:\n\n\ud83d\udeeb Realistic F/A-18 Cockpit\n\n\ud83c\udf0a Stunning Water Graphics: Fly over breathtaking ocean environments with dynamic waves and lighting\n\n\ud83c\udfae Full VR Touch Controls: Reach out, grab the throttle, flip switches, and steer with lifelike responsiveness\n\n\ud83c\udfaf Landing Grading System: Receive detailed performance feedback on every carrier landing\n\n\ud83c\udfc6 Global Leaderboard: Compete with pilots around the world for the best landing scores\n\nWhether you're a flight sim veteran or a VR enthusiast looking for the next-level challenge, F/A-18 Pilot Simulator delivers a true taste of naval aviation like never before.\n\nDo you have what it takes to stick the perfect carrier landing?\nTake flight and find out.", "short_description": "F/A-18 Pilot Simulator \u2013 Experience the Thrill of Carrier Aviation in Full VR\nStrap in and take command of the legendary F/A-18 Super Hornet in F/A-18 Pilot Simulator, the most immersive and realistic VR flight experience available. Designed from the ground up for full VR touch controls, this simulator puts you directly in the cockpit with unparalleled detail and interactivity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems", "support_website_url": null, "website_url": "https://tasappsystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "
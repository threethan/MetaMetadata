s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQltbjHPBqgQ7kNvwElQcZL&_nc_oc=AdoID8c6WJ8Dk4V7w46RHR1ByTCV2b04xeibCvs1QbpFMlJgfKLMRlmtTMg-Sd8osv8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZqaSOiH2IcIQYQCo3U4O71BeM8ma6bgUd_p8gR5DeBA&oe=6AFB4186"}, {"file_name": "Screen2.png", "id": "1125110219567170", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303769_1125110222900503_3934625776265974094_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_zEPagFyaMQ7kNvwG7DREM&_nc_oc=AdpOXDhBNQdgpaT_NTPQPbow_WZxx24paPWwPHzYAd04z9RmpKboaF7iiHP_d3khS9E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbcDJ7mouCNT9VOAboqW61GNkBBo7o27VGvnql8YNmyA&oe=6AFB3255"}, {"file_name": "Screen4.png", "id": "1777740536185805", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827067_1777740539519138_4771868571748201233_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7Oz0Nb96AAQ7kNvwE27rjP&_nc_oc=AdqWY_SavrkEdFcP0Yu9JjY4D6jGU9Xs3lpFf98qaB2KOu3Ztixg38DX_6q7Dyz2AU0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuO-9om2xzcfyC7vAa5kH16Wm1ceABH3baN-dugOYgPA&oe=6AFB28E6"}, {"file_name": "Screen5.png", "id": "1798679524072148", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617762_1798679527405481_6084302047502627610_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oqWXtgOXtIQ7kNvwHGzVOP&_nc_oc=Adpdg0UP5Lr5SraJx7McwtpRNp-R9p1Glf_hSS5h70Yq5bJqOE8kPlXWE0frDSISCOY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRue8P7ZFpLWfzNq3d3Jq7roHWd88zjQUn0tVIRuKS9w&oe=6AFB306F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F/A-18 Pilot Simulator", "keywords": ["Flight", "Simulator", "Aviation", "Pilot", "Sim"], "long_description": "F/A-18 Pilot Simulator \u2013 Experience the Thrill of Carrier Aviation in Full VR\n\nStrap in and take command of the legendary F/A-18 Super Hornet in F/A-18 Pilot Simulator, the most immersive and realistic VR flight experience available. Designed from the ground up for full VR touch controls, this flight simulator puts you directly in the cockpit with unparalleled detail and interactivity.\n\nMaster the skies as you navigate high-speed jet maneuvers, then take on the ultimate challenge: landing on a moving aircraft carrier in dynamic ocean conditions. Feel the adrenaline, the precision, and the pressure\u2014just like real Navy pilots do.\nKey Features:\n\n\ud83d\udeeb Realistic F/A-18 Cockpit\n\n\ud83c\udf0a Stunning Water Graphics: Fly over breathtaking ocean environments with dynamic waves and lighting\n\n\ud83c\udfae Full VR Touch Controls: Reach out, grab the throttle, flip switches, and steer with lifelike responsiveness\n\n\ud83c\udfaf Landing Grading System: Receive detailed performance feedback on every carrier landing\n\n\ud83c\udfc6 Global Leaderboard: Compete with pilots around the world for the best landing scores\n\nWhether you're a flight sim veteran or a VR enthusiast looking for the next-level challenge, F/A-18 Pilot Simulator delivers a true taste of naval aviation like never before.\n\nDo you have what it takes to stick the perfect carrier landing?\nTake flight and find out.", "short_description": "F/A-18 Pilot Simulator \u2013 Experience the Thrill of Carrier Aviation in Full VR\nStrap in and take command of the legendary F/A-18 Super Hornet in F/A-18 Pilot Simulator, the most immersive and realistic VR flight experience available. Designed from the ground up for full VR touch controls, this simulator puts you directly in the cockpit with unparalleled detail and interactivity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems", "support_website_url": null, "website_url": "https://tasappsystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "co
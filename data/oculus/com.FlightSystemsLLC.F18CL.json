s&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sc7bS2CEhlMQ7kNvwFvtP-j&_nc_oc=Adp2QCnjci3bpziHy25AMouZbZy1fvmOKyrJuyszGdGnOslG6oz7oIqursCnN22DFyU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLavq5Xig4eK2PDgvKgeX4ksmEdislz9PQMy5HdAZbHA&oe=6B032A86"}, {"file_name": "Screen2.png", "id": "1125110219567170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303769_1125110222900503_3934625776265974094_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkAGaYuXJgIQ7kNvwFyrvB5&_nc_oc=AdqMYYaWYJb0NM6OVtJ6lBfjfV8tmntTW-86hM-vq-O2Var2KRb4UGo98IKHqDTU9to&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE1a6BvabPYEeb-TBACr6kpmJ_IUwpNlVUcM3NImRB0w&oe=6B031B55"}, {"file_name": "Screen4.png", "id": "1777740536185805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827067_1777740539519138_4771868571748201233_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtNGWLmR-mYQ7kNvwEf-__7&_nc_oc=AdqTOk38Jfk7J3GZrTPqXZSfjetKBer_Jkt757lvntTHmz0VPsdMEV66IKj-IHqBKSo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7FvvBhphTEaAywVE-6cXycIG9y7Tq8PHRBvp_gGRuhg&oe=6B0311E6"}, {"file_name": "Screen5.png", "id": "1798679524072148", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617762_1798679527405481_6084302047502627610_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blDsrDo4yr0Q7kNvwHOrWVB&_nc_oc=Adr_efPF02Z4faHOneziNpDMu9fvuSmFnOkPBC7aDfhTOP7U_JA8HPyWWXlykyJGn3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn--JpJtD0g7ESigAVhXVIbWM9XsUQc6BzMoAAexLB6A&oe=6B03196F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F/A-18 Pilot Simulator", "keywords": ["Flight", "Simulator", "Aviation", "Pilot", "Sim"], "long_description": "F/A-18 Pilot Simulator \u2013 Experience the Thrill of Carrier Aviation in Full VR\n\nStrap in and take command of the legendary F/A-18 Super Hornet in F/A-18 Pilot Simulator, the most immersive and realistic VR flight experience available. Designed from the ground up for full VR touch controls, this flight simulator puts you directly in the cockpit with unparalleled detail and interactivity.\n\nMaster the skies as you navigate high-speed jet maneuvers, then take on the ultimate challenge: landing on a moving aircraft carrier in dynamic ocean conditions. Feel the adrenaline, the precision, and the pressure\u2014just like real Navy pilots do.\nKey Features:\n\n\ud83d\udeeb Realistic F/A-18 Cockpit\n\n\ud83c\udf0a Stunning Water Graphics: Fly over breathtaking ocean environments with dynamic waves and lighting\n\n\ud83c\udfae Full VR Touch Controls: Reach out, grab the throttle, flip switches, and steer with lifelike responsiveness\n\n\ud83c\udfaf Landing Grading System: Receive detailed performance feedback on every carrier landing\n\n\ud83c\udfc6 Global Leaderboard: Compete with pilots around the world for the best landing scores\n\nWhether you're a flight sim veteran or a VR enthusiast looking for the next-level challenge, F/A-18 Pilot Simulator delivers a true taste of naval aviation like never before.\n\nDo you have what it takes to stick the perfect carrier landing?\nTake flight and find out.", "short_description": "F/A-18 Pilot Simulator \u2013 Experience the Thrill of Carrier Aviation in Full VR\nStrap in and take command of the legendary F/A-18 Super Hornet in F/A-18 Pilot Simulator, the most immersive and realistic VR flight experience available. Designed from the ground up for full VR touch controls, this simulator puts you directly in the cockpit with unparalleled detail and interactivity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems", "support_website_url": null, "website_url": "https://tasappsystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "co
/v/t64.5771-25/499303769_1125110222900503_3934625776265974094_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwqBq5pH984Q7kNvwGUIFyG&_nc_oc=AdqYOv47blZpLNAQKBM5bwTn5v-vj76I35N8rftXyj4ZahZ27YHLtryeM9olTjNbjSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmui05xkBLeVIwPBKQRDFg2X2h06len1DVrX91Ec7k-g&oe=6AA2A595"}, {"file_name": "Screen4.png", "id": "1777740536185805", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827067_1777740539519138_4771868571748201233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13vuPeETvdUQ7kNvwEPVVPn&_nc_oc=AdqHzHxqLSwPLPJ2P9Nvbi7Xb7mNfHPmEPGK3OTitJBnUP8u3RGDrqMjGq3ZgMqK7_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzA5P3bZ_nIevEkCyHvzr3aTlbBvXueeZlZUEbzPhajw&oe=6AA2D466"}, {"file_name": "Screen5.png", "id": "1798679524072148", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617762_1798679527405481_6084302047502627610_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgarVPcMAVkQ7kNvwEzq8bY&_nc_oc=AdoBc3_oHLJpR6QpYjqP93oLUMxXMjTKVxGl8hqUhjeARU2lQ88lbaX0yV-thdkaA2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlKI41GvuGSmlxkKWeJGDWSBZeM6JZghEz40upOe6jBg&oe=6AA2A3AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F/A-18 Pilot Simulator", "keywords": ["Flight", "Simulator", "Aviation", "Pilot", "Sim"], "long_description": "F/A-18 Pilot Simulator \u2013 Experience the Thrill of Carrier Aviation in Full VR\n\nStrap in and take command of the legendary F/A-18 Super Hornet in F/A-18 Pilot Simulator, the most immersive and realistic VR flight experience available. Designed from the ground up for full VR touch controls, this flight simulator puts you directly in the cockpit with unparalleled detail and interactivity.\n\nMaster the skies as you navigate high-speed jet maneuvers, then take on the ultimate challenge: landing on a moving aircraft carrier in dynamic ocean conditions. Feel the adrenaline, the precision, and the pressure\u2014just like real Navy pilots do.\nKey Features:\n\n\ud83d\udeeb Realistic F/A-18 Cockpit\n\n\ud83c\udf0a Stunning Water Graphics: Fly over breathtaking ocean environments with dynamic waves and lighting\n\n\ud83c\udfae Full VR Touch Controls: Reach out, grab the throttle, flip switches, and steer with lifelike responsiveness\n\n\ud83c\udfaf Landing Grading System: Receive detailed performance feedback on every carrier landing\n\n\ud83c\udfc6 Global Leaderboard: Compete with pilots around the world for the best landing scores\n\nWhether you're a flight sim veteran or a VR enthusiast looking for the next-level challenge, F/A-18 Pilot Simulator delivers a true taste of naval aviation like never before.\n\nDo you have what it takes to stick the perfect carrier landing?\nTake flight and find out.", "short_description": "F/A-18 Pilot Simulator \u2013 Experience the Thrill of Carrier Aviation in Full VR\nStrap in and take command of the legendary F/A-18 Super Hornet in F/A-18 Pilot Simulator, the most immersive and realistic VR flight experience available. Designed from the ground up for full VR touch controls, this simulator puts you directly in the cockpit with unparalleled detail and interactivity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems", "support_website_url": null, "website_url": "https://tasappsystems.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
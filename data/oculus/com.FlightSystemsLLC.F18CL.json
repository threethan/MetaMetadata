luscdn.com&_nc_ss=7f20f&oh=00_Af8xpD_recXGbwYKLpmuNKYbOtl3rDZjqKqhDx4ug_pIpw&oe=6A2C1B76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1aa.png", "id": "841207988415041", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619685_841207991748374_7037287863324806512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rtwfunpqa3cQ7kNvwGjY3Z-&_nc_oc=Adqxe5CRJOBMedn_g8PFP0ELEPD0wI5MbT_grY-FsuvRBQHhjQWf5Pie2mg6f9gn-SQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iNm6COH2yuL4llAwGImFcJFRRDZeeC4GiFqvZPsuCxg&oe=6A2BFFB9"}, "display_name": "F/A-18 Carrier Landing Simulator", "keywords": ["Flight", "Simulator", "Aviation", "Pilot", "Sim"], "long_description": "*Graphics are optimized for the Quest 3\n\nThis is an F/A-18 Hornet Aircraft Carrier landing simulator exclusively for Meta Quest. \n\nExperience the thrill of landing on an Aircraft Carrier.  Strap in and take command of the legendary F/A-18 Super Hornet in F/A-18 Carrier Landing.  \n\nMaster the thrill of landing on an aircraft carrier.\nFeel the adrenaline, the precision, and the pressure\u2014just like real Navy pilots do.\n\nKey Features:\n\n\ud83d\udeeb Realistic F/A-18 Cockpit\n\n\ud83c\udf0a High Detail Ocean Graphics: Fly over an ocean environments with dynamic waves and lighting\n\n\ud83c\udfae Full VR Touch Controls: Reach out, grab the throttle, flip switches, and steer with lifelike responsiveness\n\n\ud83c\udfaf Landing Grading System: Receive detailed performance feedback on every carrier landing\n\n\ud83c\udfc6 Global Leaderboard: Compete with pilots around the world for the best landing scores\n\nWhether you're a flight sim veteran or a VR enthusiast looking for the next-level challenge, F/A-18 Carrier Landing delivers a true taste of naval aviation like never before.\n\nDo you have what it takes to stick the perfect carrier landing?\n\nTake flight and find out.", "short_description": "Experience the thrill of landing on an Aircraft Carrier.  Strap in and take command of the legendary F/A-18 Super Hornet in F/A-18 Carrier Landing.  Designed from the ground up for full VR touch controls, this simulator puts you directly in the cockpit so you can try your hand at landing on the carrier."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems", "support_website_url": null, "website_url": "https://f18pilotsim.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27193192940278520"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618937_1356176733011440_8861961445809124767_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kk9M9hacJggQ7kNvwEfNTK4&_nc_oc=AdrvDFEJwrPRZqnxxp0HTfEOi1vccVKq6NkwQOKTPWJYVutmDwjPnLasCaB5TZDeoaI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5KZggaUA2b5c6eaBfJLPYD78Sz6HEEIp6ti3_g_F53A&oe=6A2C3011"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "F/A-18 Carrier Landing Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "
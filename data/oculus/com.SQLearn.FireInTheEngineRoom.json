385_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMzZF6OA748Q7kNvwFFxN4c&_nc_oc=AdpCJsOL6kO1cKYQzS1YsmcZzwfWxifOv5Rt-4fHmYQr9aW9B-hZa-d4nZdKxnhu7z4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-kfQJ3qV04_h6JZSDYLJ_7QCnhd_s3QyMwMegUflK2g&oe=6B1042F3"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDY8cqPS9cQQ7kNvwE1pU0V&_nc_oc=AdrTqP_w1E09Zb1yMar2B8B3kcgKElPQ09ec1ATwc1QXLxAi0aBhw8zLzCfXd5P4lfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWLWpZD9XVyDsdnKSwBCdgCXpDcCNMCCclnejjh6qFGlw&oe=6B103C3B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The consortium of the VR-ME project", "support_website_url": null, "website_url": "https://vr-me.eu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5133173290112133"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_1054130171806235_1296855974191282056_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJKljWW3bFcQ7kNvwE9Zspt&_nc_oc=AdoQ1yXJAgcjm6q3To5eRq2hsZdXTKn45hW6rodqUl8Pv-EaRirmSkLvJCSJlrE-Kv0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVPxniFIpcrOxMuHxqxWd1ZE5HU-Yv-jqE7r64Qq05-lw&oe=6B105454"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR-ME: Fire In The Engine Room", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211
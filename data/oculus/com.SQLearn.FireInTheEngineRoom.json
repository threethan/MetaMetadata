.com&oh=00_AfsubB05rZw8qDgapohVnsLOGUii68zTGXsIt9KZwS5YGQ&oe=69985161"}]}, "id": "1864934070381654", "locale": "en_US", "screenshots": [{"file_name": "FireInTheEngineRoom1.png", "id": "999332160703715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974504_999332164037048_8352848161181583365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2yZFDhWpgMQ7kNvwERhomQ&_nc_oc=AdkwN3xz_PC5E415lPPBWTzjRtDaFxtEHn0wL7ulq0WKYE9l4ia6COCdjuTDN2L6qKE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftRm3dE4_CBziBbU00xLj84_pmhRTEaoqKAGpnrEPAnxg&oe=69983EB9"}, {"file_name": "FireInTheEngineRoom2.png", "id": "1060903411489141", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031501_1060903414822474_9192607785681237416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOxUSKB4RdYQ7kNvwF3QBr4&_nc_oc=AdnZaAk5DdVCEvRmHxlFGJ8VJ04Emwc_uaixHyQ5Mxt-AbjqOiSq4VK9CHQ5wEje_8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfusRycRvw7yAbAKq5Dduyub1MLRakymFgvlJp09fRR6XQ&oe=69985043"}, {"file_name": "FireInTheEngineRoom3.png", "id": "1333559243720099", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001717_1333559247053432_5526570972152141129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjLz5f0mG_4Q7kNvwEdkdZu&_nc_oc=AdmurWyisnoN95XUyeuRhAeUB9B6T9u-wKS6oPle27uARhz7_A9S1OPoVy7xUp-_L1Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvAcO_4KsG1_8WMkikQEVth5vR3Q76Vy6CoeJXJIlwwew&oe=6998470E"}, {"file_name": "FireInTheEngineRoom4.png", "id": "403819987828479", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982552_403819991161812_8720327022213224385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=771xaLEx9asQ7kNvwFmC-WC&_nc_oc=AdnsACl9kbgqKnNsoBarKZpo3EfsB0JA5XBlqA6ppwebd_nEjgUR1nB2_gkrLBkvhgc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfumhpGmnalxvJ0sjtseiNvBJ00NRUDj5DtfekmNJBNTTA&oe=69984F33"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDnfDPn9BjAQ7kNvwHu3W0W&_nc_oc=AdnHQPUndA-REDVyuSN82TL_kBi1Xl5-HxlcTxCM8GRVmPI5fLna13OMpQ4tgcT3RMk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvsFalYZzhDluSU4TPVey7sorS8uIYdd25khZxnqLmXKw&oe=6998487B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms
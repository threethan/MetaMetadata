.com&oh=00_AfsSr3O0l1-agz8ncXI1V3gSEWYVK_7ImfCRYLlr8eaJ7Q&oe=69A03A61"}]}, "id": "1864934070381654", "locale": "en_US", "screenshots": [{"file_name": "FireInTheEngineRoom1.png", "id": "999332160703715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974504_999332164037048_8352848161181583365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAGPMuZLAlUQ7kNvwElEH9K&_nc_oc=Adm54hXYM2oj2qNNrOxEoGlPOXb9Ina4VpTue-TDkqu8439PEhK0-njJk7mKC2vdyi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfspnUVw0HKZoXfxI9_HFnPsEvi332F3vl0kdySTntJxMw&oe=69A027B9"}, {"file_name": "FireInTheEngineRoom2.png", "id": "1060903411489141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031501_1060903414822474_9192607785681237416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLuJmC28SfMQ7kNvwHgKrC1&_nc_oc=AdkV8NoPy8JBbhfpO7ltnOx36A0dP0B8L49I3_glUnXS81-6vL3G3S9T6zmDU36eNuU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsBF5WF6UWITkAbu5T0GEzJ8bx2rAU0PDQmxB4vyX_FRQ&oe=69A03943"}, {"file_name": "FireInTheEngineRoom3.png", "id": "1333559243720099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001717_1333559247053432_5526570972152141129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwIAlCiRgHQQ7kNvwGNrZcq&_nc_oc=AdlfZ-HtcE6E4mF-5JkGuXZg7PupfVB4wBw8K7piCn8OUqGStKtklAssO4h6ONZJ4DU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsGKKXGMOkHDjn4LKqd3ulJKqbpb1df9oi-SVMklNGyTw&oe=69A0300E"}, {"file_name": "FireInTheEngineRoom4.png", "id": "403819987828479", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982552_403819991161812_8720327022213224385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1U5Z6YTr9cQ7kNvwEkP9el&_nc_oc=AdkFTdRRtNOROKWxtAgEmb-WvNgNfeMDIx7pUtdh1O3AjwxGYPGhafl5NiX0YqIuKwI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvWJPN81jdKDgiE_pmdBwbHsz457SeV-AWGvg5HRWvkeg&oe=69A03833"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbDL0yAxaWcQ7kNvwFRhQUh&_nc_oc=AdlfzXWbKC_uMSuQ5uTLnEETLWOdXMNY_LG3EKUu9-mIgFqcH1kQVX7C_WGimcKbCzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjyC1MjmSU_YI8UkBKG2XFIZHcBW7XrJ_4sxDbQAH-vg&oe=69A0317B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms
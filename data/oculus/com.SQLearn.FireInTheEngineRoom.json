.com&oh=00_AftXgND0zfcoxf5rdYJy2zwNPqL_AvS_sEu-yUFID9ZTfQ&oe=699EE8E1"}]}, "id": "1864934070381654", "locale": "en_US", "screenshots": [{"file_name": "FireInTheEngineRoom1.png", "id": "999332160703715", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974504_999332164037048_8352848161181583365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAGPMuZLAlUQ7kNvwGYzDNg&_nc_oc=AdkX7xB2e5UHaJaMiLbFg3oLzx7Z87aABus-MV5SQIwQ9PF81Q6zGIWCO3eR-R6b-cY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuEhk4ZsyiGJEJfADS75-Crq23AwS1EG6eGMpG5fNdHqw&oe=699ED639"}, {"file_name": "FireInTheEngineRoom2.png", "id": "1060903411489141", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031501_1060903414822474_9192607785681237416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLuJmC28SfMQ7kNvwE3Ig2B&_nc_oc=AdnCtdXjCZsgQ6KhjTtdAS6ieqy88pQjp6dP-5aMKYuN1zgRhSDc3tjKBlCWbazrS1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu2JHDyOcPS8nkvpBcVJgIU8hRLfYoMEBQ0Ec44dbfWAQ&oe=699EE7C3"}, {"file_name": "FireInTheEngineRoom3.png", "id": "1333559243720099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001717_1333559247053432_5526570972152141129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI6kUrqiV_8Q7kNvwEclghO&_nc_oc=AdlzK_B82HZ3qOMS7aAih97JXKoxSP3yRFl94YZEBuTddlswvc_bhjyRqNUxjqBolt8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv5S7QHtIEHsJp3SUfJdCnpFRA-7k8YMevnwEJTQKEOcA&oe=699EDE8E"}, {"file_name": "FireInTheEngineRoom4.png", "id": "403819987828479", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982552_403819991161812_8720327022213224385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1U5Z6YTr9cQ7kNvwE3rOXA&_nc_oc=Adm6uo6N29NT1ZSLvxtrIstpJ2ZvN6nj3_cX-Me-XHCAWvN-ZHDJISeD1Ux4N9qUJpM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuTEWW0bVQqEWeONR74Chz55ihVp46Fn5QdqEX__I7EZw&oe=699EE6B3"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbDL0yAxaWcQ7kNvwG7EEl8&_nc_oc=AdlrgkVnLZPZN5e3vANL2rY3mm9t-ZiaUAsi6qLJiw4YeI0Y2mBxbRXWBwr6otGROA4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuMSE9_I6p1JpvCC6QAFAmpKz71IxZ_6bQpyTPjasbYkA&oe=699EDFFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms
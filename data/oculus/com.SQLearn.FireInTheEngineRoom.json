.oculuscdn.com/v/t64.5771-25/38974504_999332164037048_8352848161181583365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJPTmld3S9sQ7kNvwEwK4IN&_nc_oc=Adod4prLhfQKT3D41oT3T4P2cCnl1iY5U2F6K-E6_UAfRP5r_k-_DRJLkTewMVSY4wc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzAe3TSbsiFtgK9g-vy_UerOpqSq2AZiDDcfeqorcSpQ&oe=6AA41779"}, {"file_name": "FireInTheEngineRoom2.png", "id": "1060903411489141", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031501_1060903414822474_9192607785681237416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCsBOOqDyCYQ7kNvwG0GZEd&_nc_oc=AdqgjP-iP8cW8cj-V-HKeNoNa74NMLfB7k9O-2V9FaQkJV4UCnXgF8bqD9pp5XpY8UM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL13pQIHBEmPlvRaOiCStOHxlq7rzNNBimxKNFkJU3Zxg&oe=6AA3F0C3"}, {"file_name": "FireInTheEngineRoom3.png", "id": "1333559243720099", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001717_1333559247053432_5526570972152141129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eEG93WjvGAQ7kNvwGLUp0L&_nc_oc=AdpV1b9HHFVrMg9E6xB3SOMIU62v9gSj0A0EIPCJr1XMqfRkcIv8U-dyg-MaLFFUtQI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGwOQRrpKpBHSTHufbmjlXfwuWYFTzELUYtsGXegZc2w&oe=6AA41FCE"}, {"file_name": "FireInTheEngineRoom4.png", "id": "403819987828479", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982552_403819991161812_8720327022213224385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4sEF5nZ1DEQ7kNvwEO4JuZ&_nc_oc=Adq2inHntPJ7yLz1fY3Jcus8UHr2OVCB-Ak6BuMuIuuMcfs0EpDTq5uOqLwJtw7bxYo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7gATUk4nfLPvYIz5ueu0jmQn2GxCo_DqvZ-nvbLIASw&oe=6AA3EFB3"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG-H6qpM2sIQ7kNvwG8ojDg&_nc_oc=AdrgS6Z3B-U6JRjh2r4mk1Px7AZ3UqgBqJ61wm92d29kNTEofNpPEiB4y6RdYvtpZJ0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPNixDkc49SEiX4fuS-E4foRpgC0IlKyeRmbRXVyFTNg&oe=6AA4213B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The consortium of the VR-ME project", "support_website_url": null, "website_url": "https://vr-me.eu/", "category": "APPS", "
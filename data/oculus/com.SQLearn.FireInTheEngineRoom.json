.com&oh=00_Afthx_Sj4bZq2TI9oLjKi_XRZ0XDuKh0vCjhzvi0_C_0hw&oe=69A18BE1"}]}, "id": "1864934070381654", "locale": "en_US", "screenshots": [{"file_name": "FireInTheEngineRoom1.png", "id": "999332160703715", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974504_999332164037048_8352848161181583365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAGPMuZLAlUQ7kNvwECForN&_nc_oc=AdmXonFk7D9u3wIZtTyQoPNk_EEFcxAwIqznTGkcpN84chgvM6SUlgRJ2uUC3MPAWWs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afu9sj6kClr52rwX8e5rqytq_g96zDF6NVHCl4DXist34A&oe=69A17939"}, {"file_name": "FireInTheEngineRoom2.png", "id": "1060903411489141", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031501_1060903414822474_9192607785681237416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIIyhGR1b2UQ7kNvwF-Obs_&_nc_oc=AdmkbrON9qY4QtE5aGbbQ4SqVGiXVL1RcsaZXqhl5YUTKVlr11iMdQa--KstcVevSFc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvD1-x-uVTSXJJ8YuIeCfv7dYPIdV1-cznqu5ZW9N9Pfw&oe=69A18AC3"}, {"file_name": "FireInTheEngineRoom3.png", "id": "1333559243720099", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001717_1333559247053432_5526570972152141129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwIAlCiRgHQQ7kNvwFhhKHm&_nc_oc=Adl19mItr19NMrDKowtKOaS1vritOe4V--pF2H61CH_ee6-2KqK6Wf-BvpsHx4Rw_o0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftZLcbyaNurbD68cPVNqT7e8XTNsA34XVqsxY-WWDRkWA&oe=69A1818E"}, {"file_name": "FireInTheEngineRoom4.png", "id": "403819987828479", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982552_403819991161812_8720327022213224385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJ2rhFGsrcoQ7kNvwF14Rpy&_nc_oc=AdmjR96tZ6CLu-7IMJdHE05xqSxS7wKChrZRQgypksro6oAy9lRXLN6KIs90D-7SPiE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsXL1_as4ouMihgCcT6tY_KEete6FaySMh6mgqydLG5Gg&oe=69A189B3"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdmNSb8cLxgQ7kNvwH-ujxE&_nc_oc=AdnLMlbdL4fTPyPoIpRGenPNL4d-Wfy3W6zrd8PTag0nBSKiU0NJcLJBtRTQR3gOctY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftXWpO2dgKxfx7qswyYfYBFKzzQPhfNWV9RADt5wnDnxg&oe=69A182FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms
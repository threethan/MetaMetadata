.oculuscdn.com/v/t64.5771-25/38974504_999332164037048_8352848161181583365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jbDf5xIA30Q7kNvwHw8Z5Z&_nc_oc=AdoTDQTYN_HYVX7pOhV9M7AEiln6eKxefICxYHomIsb2UO6U2eP_iv2wbXoTvPkHYjo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YxqasW9OaBzCv2iu76wAP3B9HQW-4yVg1d8GcJIxiqA&oe=6A22E479"}, {"file_name": "FireInTheEngineRoom2.png", "id": "1060903411489141", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031501_1060903414822474_9192607785681237416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngop4lcYKYsQ7kNvwHE7lJR&_nc_oc=Adrr2dJo88FERfKuXMUlIMJIRR2FkYgT-P_hTaVYzKTxTO-ODLgGNUJThyzazjChku0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZxXBbn8C0MRxmNP4y4jLXQetCn2MX3zaRxBcWSGsYvg&oe=6A22F603"}, {"file_name": "FireInTheEngineRoom3.png", "id": "1333559243720099", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001717_1333559247053432_5526570972152141129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTOdKWdR5TEQ7kNvwH29gT3&_nc_oc=AdrfaWQAsJaQtqTdRD7u82F4SaKohrZtFif1dgftl9dX4MfICxg2Dg1ldEJz00tBcoE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--cjeloljm4HXIYJK7sgQ46GItCh0V3jBDzOPqMuNakg&oe=6A22ECCE"}, {"file_name": "FireInTheEngineRoom4.png", "id": "403819987828479", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982552_403819991161812_8720327022213224385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D02KNA9WwyAQ7kNvwG3L5jN&_nc_oc=Ado0fMAAvbT8Ns-OFzNup3UfjQF8ri4a9BfRl1yTdcQb45tmR-BM3Nar6OuOEqU86Pg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RuhZhkmz-PYzJ0rLs-vm1mpMfO4xetpNVBFPWIJovow&oe=6A22F4F3"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wlABDacSTcQ7kNvwHcKKWQ&_nc_oc=AdpKC_-gKkur5xyldnk_4SyYiCapoUuHn6AvtcWR4BGNKit7lyjgaHXjWEmEsdXzxZE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8angUf02BmrS2BSFajTWtI-Ca8Cq8AQdAOizMgp43Q4Q&oe=6A22EE3B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The consortium of the VR-ME project", "support_website_url": null, "website_url": "https://vr-me.eu/", "category": "APPS", "
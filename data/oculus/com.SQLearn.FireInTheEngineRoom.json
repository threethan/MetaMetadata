/v/t64.5771-25/38974504_999332164037048_8352848161181583365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=of3Z1TzW7zcQ7kNvwGhPuAs&_nc_oc=AdoIHWXXPcZ-9Q-f_-AT1SHsFuhmaeXtfXNj-8aFqlkGNwqjKAmvL_RTa_XZhAIbYQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeZvr48inK-JjOOiOVD880TY5jVdHDBgPeCagZ-7XaZw&oe=6AF5D479"}, {"file_name": "FireInTheEngineRoom2.png", "id": "1060903411489141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031501_1060903414822474_9192607785681237416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1POiyTVmW8Q7kNvwEmUUFq&_nc_oc=AdrPJfLnS8hhtHoii501giMxDTcDtNKaBuru709Hc3BrpBGKbOFvykUiucdiNSs8bzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy7d3UEhaqE_SjxOAJZz5jekLSyPTmfCifkVxj-QYHnA&oe=6AF5E603"}, {"file_name": "FireInTheEngineRoom3.png", "id": "1333559243720099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001717_1333559247053432_5526570972152141129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTpbgBM5z90Q7kNvwFbw6qn&_nc_oc=Adpg8F1C5dbNXuqQnoJguTU0Yzm5CtnpVR-x20o-87_bPBq-swozrBGsWSpawFMbmqc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMzI-3K6G5tRrue_d-MhjpnMoCuC7qB4gH2FlaWIzIBQ&oe=6AF5DCCE"}, {"file_name": "FireInTheEngineRoom4.png", "id": "403819987828479", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982552_403819991161812_8720327022213224385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RScSWzg87uYQ7kNvwFGeCEj&_nc_oc=AdoVHSb1vZGpQPodb2bUy5aV6GYwokRlRN8WbDK4uXqoXwlALxxIoQ7NlulkRDL6v7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRve-Y-IIbx1cV6LaMEWHt8Pc19VElLSbHeD5lrf-I7dw&oe=6AF5E4F3"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1uZzE2r2Z0Q7kNvwGMj8-4&_nc_oc=AdoNWG9_eNTPBoDdjgEcY_qDU59ltx197w9w5_JEOlWRXE9ThthFZL6zyoSL8iGUt0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgHVXVVcCULhuKPTel2WyDTIoQAAMD7-doidmaRhy73Q&oe=6AF5DE3B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The consortium of the VR-ME project", "support_website_url": null, "website_url": "https://vr-me.eu/", "category": "APPS", "comfort_rating":
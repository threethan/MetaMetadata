.com&oh=00_AfswZd0cZ9gwSUIyz9JgB6EreOKsEfLlm9STLgVWzGzwvA&oe=699D9761"}]}, "id": "1864934070381654", "locale": "en_US", "screenshots": [{"file_name": "FireInTheEngineRoom1.png", "id": "999332160703715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974504_999332164037048_8352848161181583365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNraRVacSfMQ7kNvwFWqmEa&_nc_oc=AdkO6-HQ0QPS-K4qUWS1wHICQfrbmcaZoGCKPKy5WYB17WOCMn4tnYRlZFzv1_CPVzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKhVPJyYhYpyWLLPXBnmyUayBk-j77WbQUbqWFoCLwBA&oe=699D84B9"}, {"file_name": "FireInTheEngineRoom2.png", "id": "1060903411489141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031501_1060903414822474_9192607785681237416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLuJmC28SfMQ7kNvwEAjmB9&_nc_oc=Adnr_fKxDT-VYd9eklk9N_PF_xAQZObWOe3c-vGxC_HdZ6LrWiG0DB_WOIz0cfom5KU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfszFhUuZGJPgyBO6DnlelouL85ax36ACTrBgl2B8V8qWA&oe=699D9643"}, {"file_name": "FireInTheEngineRoom3.png", "id": "1333559243720099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001717_1333559247053432_5526570972152141129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI6kUrqiV_8Q7kNvwFv8Z_l&_nc_oc=AdnmFAmBrWZCUf1N0nduAlTEYg_j-0b6buao5mWZpiRvWH-7PV4ZcUlkdz3kT3G1UxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsf5d2TMbtGqIJaTfxG8tOOKJ4y3vadMt7bDlUlG4wJaQ&oe=699D8D0E"}, {"file_name": "FireInTheEngineRoom4.png", "id": "403819987828479", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982552_403819991161812_8720327022213224385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1U5Z6YTr9cQ7kNvwEusezw&_nc_oc=AdlN-Ax12jtC2MW9HEOTFSIGPS_w8qRN5qpSw4BESnT4E5VAsXDhrycdSz57MWiEvGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuyK_7_6RfMYeQfqBmsOpN245ZUNIxVn2R69yiVky9Hyw&oe=699D9533"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbDL0yAxaWcQ7kNvwEcHOce&_nc_oc=AdnVEeuqf34mxbHoxyV1GJN_hhKJ5fJK_C4YSwGgomRiOKzPa5RmO3gGrzfDcFdJMoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afum_tZv79oOGID9jpWKGvVSEUlrwNYbGobd7UhlMdj4Og&oe=699D8E7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms
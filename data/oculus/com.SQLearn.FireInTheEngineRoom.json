/v/t64.5771-25/38974504_999332164037048_8352848161181583365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uk9IwriM96IQ7kNvwHZlEXQ&_nc_oc=AdoXuWKs3RDM25IGXYwku1wOkmHyHe1pQZqexe_UWzIq5RPDdiwmt4Gf9QpjzCSc5Y8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_eJ9U4dxc7W70a9FuRbatD1A0wye79iZy6LBibHYGcQ&oe=6ACA52F9"}, {"file_name": "FireInTheEngineRoom2.png", "id": "1060903411489141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031501_1060903414822474_9192607785681237416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Io5UPi5I7wQ7kNvwFA66eb&_nc_oc=AdrAlbq32OOHS9n01Rs3w_Qqa_flLGv0Vvi1WeqU7LxtcG1l6_-GWmGKGWXzIjyizVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORPsnJ9wzTgRQWvl9g0sz9oHfR7UEB9i37x5lcpNRokg&oe=6ACA6483"}, {"file_name": "FireInTheEngineRoom3.png", "id": "1333559243720099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001717_1333559247053432_5526570972152141129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxF8z-6o-HMQ7kNvwEPCOYE&_nc_oc=AdoNzVUtDt8kQYtWVAvGu_Tg0T5-Y6VY-3Mk0vzTUaeeiE5_9POJ-xJtM0gYbznJuic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFYQS5XcYd6rOOHg2BcKEQqxfIaX19E3uelImTzMrZ_g&oe=6ACA5B4E"}, {"file_name": "FireInTheEngineRoom4.png", "id": "403819987828479", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982552_403819991161812_8720327022213224385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-geT0yiQzoQ7kNvwFuIUtn&_nc_oc=AdoEYGWwE1IpLo7Ors2asBywZ5v7_CAAsIm-_AQE4rN_E-rWxQeZ6r-K1M8X-8hXeG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpKLGyoov8ZmXrkXe15BjMQYhNB4q8AMAJrmVkIvV3Og&oe=6ACA6373"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63CnbViWW5oQ7kNvwEDIEbs&_nc_oc=AdqKnE3H56WU4hOAQQQKh3OdIbAiUZc5U71rZkpDxoRAifyNfin_Xms-qv0kzxjHAMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuIm2L5S0_wN7Ch6fpiwounMsLGlUgjwOq5kAHko5U2A&oe=6ACA5CBB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The consortium of the VR-ME project", "support_website_url": null, "website_url": "https://vr-me.eu/", "category": "APPS", "comfort_rating":
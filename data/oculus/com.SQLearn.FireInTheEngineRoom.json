.com&oh=00_Afvjz9jeXYbcxg01DkF8_einGzqzGKU_VQMbqu4zqoxmpw&oe=69A2DD61"}]}, "id": "1864934070381654", "locale": "en_US", "screenshots": [{"file_name": "FireInTheEngineRoom1.png", "id": "999332160703715", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974504_999332164037048_8352848161181583365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF5XNq42vGYQ7kNvwGprkAw&_nc_oc=AdnfZQES2o253N313QzhvlPGcVdlbGVjFmTQ6xeR137OyLKQegTumJhJLKm1ccxr_wY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftYHO-wimdDS4KOkjXy2Tedsr-9a3YB4gmsvvHmcKd7RA&oe=69A2CAB9"}, {"file_name": "FireInTheEngineRoom2.png", "id": "1060903411489141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031501_1060903414822474_9192607785681237416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIIyhGR1b2UQ7kNvwEJnA4k&_nc_oc=AdlIYG4YKPT7m3DO2aHXFPts-VvvG3hgHvFsl5wv0_t-bw753kmNVVGe4ZHDFBIWhRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuK7PV3O0rjEDw9T--l2J7dxaRzHeMrzXK5lEsP0x7irA&oe=69A2DC43"}, {"file_name": "FireInTheEngineRoom3.png", "id": "1333559243720099", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001717_1333559247053432_5526570972152141129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwIAlCiRgHQQ7kNvwEDqVJa&_nc_oc=Adl1l-No1PV-ZStPAkG3NH5-tF0XrJRYbKiSRZa2YVuMeZGXjytYQUJ7r1fkdGrA6E4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvCMz5Xy9FRoRYI_VMb7QN1zqwQWQ6AwhhlRAeP1vKhAA&oe=69A2D30E"}, {"file_name": "FireInTheEngineRoom4.png", "id": "403819987828479", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982552_403819991161812_8720327022213224385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJ2rhFGsrcoQ7kNvwH670ru&_nc_oc=AdkIXEt5zaZ738-af70YKLCEShUPLv38IQwF1nyYbGKC5rVKMRXs2GFOC5NO7Ar2OGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCDNgKyFlIrYqLxT9BSvopYMspK_z6pl4ujxYdDg8ddA&oe=69A2DB33"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdmNSb8cLxgQ7kNvwF4l9c4&_nc_oc=Adkk7OzTc5_qmQkijQRT1WTR_efzxO3uoKmoHceKCrkYjZUlPIpZj3-hZSwIUec4mAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvEYjkO2TUNb0GZDSzFxIgISUtUUdpbLBov9FIxzdWvtw&oe=69A2D47B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms
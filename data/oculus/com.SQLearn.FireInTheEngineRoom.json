.oculuscdn.com/v/t64.5771-25/38974504_999332164037048_8352848161181583365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBA69PbxKrcQ7kNvwGM-qxt&_nc_oc=Adr35Wy-DZJZCubGg0xSWua9MC0-MJ2U6uGCK8jyRWyVnZtFJUbL7dUk56eGnaWz5nQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI20FfJp_Pp4PPPejj0aJKSQW-D8y6RT28DHjWKZMjNGw&oe=6AA95D79"}, {"file_name": "FireInTheEngineRoom2.png", "id": "1060903411489141", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031501_1060903414822474_9192607785681237416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSvU_4uWYBgQ7kNvwEUaUhJ&_nc_oc=AdrDLnl3XimKWRumgfCXeSgDnFtT0VLb8_1ZJttY-KF6RlcvTxEsPTLtozqBADaDfeA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7EBOtyPQIC2UlsxvTHoFpQf8Xu9gnRChx6vEkzUo7hQ&oe=6AA936C3"}, {"file_name": "FireInTheEngineRoom3.png", "id": "1333559243720099", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001717_1333559247053432_5526570972152141129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyjsiAz6oK0Q7kNvwGjEQPt&_nc_oc=AdpdkWweAPIgCi528NmE-UTFaartBBcs6xOQ1EBey1eyDh8diKq-_LCzZ4pnMbQ1yl8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPTKwNMQPDagA_3t9Jb-dFR8_oSVsqaHCAPCIA7HnHLg&oe=6AA965CE"}, {"file_name": "FireInTheEngineRoom4.png", "id": "403819987828479", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982552_403819991161812_8720327022213224385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93fGu2r9CisQ7kNvwEy1Fb1&_nc_oc=AdrqetJxDN8IVGdKQT6bxmmDqbwh0yvaHWexVzf7aa9C3UIrGJ84jH-lNfgxk4fhTow&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbH6vOr08L3_3gEGEBp0e-ofXjzISQk7PnsPGkg65WLg&oe=6AA935B3"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8T_b8jEMfjEQ7kNvwHwJ7VH&_nc_oc=AdrZc-EjLnpWh4RTlKv_IQHVYeB1hQrATWQU7H3bRzOAA_-td-gwxWCgvWy3iab6mME&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcbfFIyz7nH2frxUxTOIsloDtkjxeQMWs85uCjZt1ySA&oe=6AA9673B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The consortium of the VR-ME project", "support_website_url": null, "website_url": "https://vr-me.eu/", "category": "APPS", "
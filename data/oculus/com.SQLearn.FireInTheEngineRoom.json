.com&oh=00_AfvSXvmzLqlHAZ7n9kwuVi9m9ltwoT83cxEvOidKqxClow&oe=699AF461"}]}, "id": "1864934070381654", "locale": "en_US", "screenshots": [{"file_name": "FireInTheEngineRoom1.png", "id": "999332160703715", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974504_999332164037048_8352848161181583365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNraRVacSfMQ7kNvwHjJNzp&_nc_oc=AdkTaR4GMH_92n40iacxjiK0a0liifxGSwSMLdyOCtNCwHQPumrk6V4EoSvQ3ztYn4U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu_iP7l_DMpK4uV19sqR7rXMsDd4s90Y9GRQIXgVH6JAA&oe=699AE1B9"}, {"file_name": "FireInTheEngineRoom2.png", "id": "1060903411489141", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031501_1060903414822474_9192607785681237416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbpFT3YoGysQ7kNvwHlsAbE&_nc_oc=Adl3Bv-H1gAHOjnsXh_XkSH5himZmPyURl8wAxu6WKLsstu8V064EKJH2DEkZrzqXh8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfunFUoz3W2Mce2HCFTbEdAFP3OFFzLHOwmwnZZX_fZ48Q&oe=699AF343"}, {"file_name": "FireInTheEngineRoom3.png", "id": "1333559243720099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001717_1333559247053432_5526570972152141129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjLz5f0mG_4Q7kNvwHI9mqs&_nc_oc=AdntGlVEV6yrU4UAztOj5IM9W5Onak1fKbPoF6pwqYPx-K-82FlvcaogulHzZa_1YrA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsvJWVCNpmguRkdpEKOpN2aGuNvPDubiSisHn_zTlaTHQ&oe=699AEA0E"}, {"file_name": "FireInTheEngineRoom4.png", "id": "403819987828479", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982552_403819991161812_8720327022213224385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sffzEzxftQQ7kNvwGgAmEu&_nc_oc=AdlV_rT4LXzexBt9axD9jQund-TCdfIX606HGI0pQRGTho3qJ6XN3B4VPSm-sQx50H4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvFFR4VD9SnHT_T5ZQBYblmrGMt6oCFv0L0nWnv-7MjXA&oe=699AF233"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVl2Vqit2OUQ7kNvwGw2xcj&_nc_oc=AdmdCDy-p0e36nV32TklEsY-gAtXGh2qdQW6Kc01bNU6RFilFYbLuSKS7ooaqEFbxRE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftg2B5vzceCUMu-6EIMUsT2F7561LifFtVqAqwBG8MVjw&oe=699AEB7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms
.com&oh=00_Afvt7qBeci4LatWrAFIJJfXXyynTjuMxsO7JSdChRqN60Q&oe=69A58061"}]}, "id": "1864934070381654", "locale": "en_US", "screenshots": [{"file_name": "FireInTheEngineRoom1.png", "id": "999332160703715", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974504_999332164037048_8352848161181583365_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF5XNq42vGYQ7kNvwHe0jom&_nc_oc=AdlsS8Ds2mEoxqzO3Aum2It87TPXzLDa9q2ZVzxl19RA4iexC4N92GvWZNKGOOZgIjo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs-PKYZeyMFXkDZT-UygxdblzFzW6vhoi1oMllSLwuVpw&oe=69A56DB9"}, {"file_name": "FireInTheEngineRoom2.png", "id": "1060903411489141", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031501_1060903414822474_9192607785681237416_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Dax-igyQm8Q7kNvwFw2sop&_nc_oc=Admw4-vdZTdwutwd4DdWF_sdnT2R-5QKgFrtW086LQ73NRT_38-DSKE4x_7Sz69dX2s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftHFPQhtIWrmCvDfcDeyy4pYGYbt71QKVn7oYSJjci7pA&oe=69A57F43"}, {"file_name": "FireInTheEngineRoom3.png", "id": "1333559243720099", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001717_1333559247053432_5526570972152141129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfSI8_zfMxQQ7kNvwHpItx-&_nc_oc=AdmgWAQDJDLi9Bcfezk_RZSJothgMx9_tCUWiO78BEXzXuq7cYQ28S_4CaNZbipDk78&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftzGeI1tlbOyVzr_0Ii9KPVMUacx2_N1GaaJXCDWe-3TA&oe=69A5760E"}, {"file_name": "FireInTheEngineRoom4.png", "id": "403819987828479", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982552_403819991161812_8720327022213224385_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFAhB2GD-jIQ7kNvwGlGqqE&_nc_oc=AdnsOTH7FyCngAJO13G6EyZb_dKJulnx6dsxAfoJMqpZqf9hjIAi8KOKYzkGOI5DvTQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvu3w9umpDMvsntEL5Hf2Op9kz8vwz5KMzaOw18eyQnNA&oe=69A57E33"}, {"file_name": "FireInTheEngineRoom5.png", "id": "397854095192936", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982464_397854098526269_4581865977018394136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtwA0HkW4oIQ7kNvwEkaKFp&_nc_oc=AdkDiIzXeOKB9DkxDf_zOEOq1nZE5DqesR08osZy-ZXjK7RxyiXTnYfd0rGHwKlrjxc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu3X3wOhnGBCu83tawh49e9AX0SwYuzMefnfGdMXqySOg&oe=69A5777B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR-ME: Fire In The Engine Room", "keywords": [], "long_description": "In the script of the scenario \u00abFire in the Engine Room_VR-ME\u00bb after some welding work in the engine room, a fire starts in the bilge of the engine room, also spreading to the main electrical panel.The \u00abFire in the Engine Room_VR-ME\u00bb app includes actions mentioned below that are urgent at the situation of fire:\n\n-Go to the meeting point. Recount\n\n-Grab, carry and put on \ufb01re \ufb01ghter equipment, prove function     and adjustment\n\n-Grab one \ufb01re extinguisher and put it ready for use.\n\n-Going to the engine control room and trying to su\ufb00ocate the \ufb01re, with a \ufb01re  extinguisher.                          \n\nThe development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project.", "short_description": "\u00abVR-ME: Fire in the Engine Room\u00bb app is about an emergency situation when you\u2019re working onboard a vessel that is out to sea, an engine fire is one of the last things you want to deal with.Engine room fires also obviously put a ship filled with maritime workers at risk of injury or death. The development of the \u00abFire in the Engine Room_VR-ME\u00bb app is co-funded by the Erasmus+ Programme of the European Union under the framework of the Virtual Reality for Maritime Emergencies (VR-ME) project."}]}, "developer_name": "SQLearn", "developer_privacy_policy_url": "https://www.sqlearn.com/privacy-policy/", "developer_terms
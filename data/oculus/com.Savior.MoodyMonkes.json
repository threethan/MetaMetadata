SsfR3ghydEFJlsDn4IlCwLhY6KcOsJp_6-721gARk6Ds&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx5KRc3UaReaHpydabtpBZ1CNqVMLJfenWkmVz6erMHw&oe=6AD39E82"}, {"file_name": "SampleScene_Custom..._21.06.2025_18-28-18.png", "id": "1641331783192613", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/507892326_1641331786525946_261604555932053195_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpqyXU8H18wQ7kNvwHhbslp&_nc_oc=AdoCwQisS_dB_iJvUtCQRiScFMpCEyvWmyd17fvzXufk0HGRdmN3i-4cHHPZFR4hFVI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7V5Lj90SNB2ue1gAUTBLiG5rYUTOAmSwnKtQiNpJfWw&oe=6AD39593"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moody Monkes Reborn", "keywords": ["Adventure", "Action", "Chill"], "long_description": "Moody Monkes Reborn is an immersive social VR world where style, attitude, and evolution collide. Dive into a vibrant facility of expression and creativity, where each Monke has a personality as wild as the environments they inhabit. Whether you're swinging through dynamic biomes, customizing your avatar, or vibing with the community \u2014 this is your space to be unapologetically you.\n\nExplore hidden lore, unlock legendary gear, and rise through the ranks as a true Monke icon. With a focus on creativity, connection, and freedom, Moody Monkes Reborn isn\u2019t just a world \u2014 it\u2019s a movement.\n\nJoin the tribe. Rewrite the rules. Get reborn.", "short_description": "Step into the wild world of Moody Monkes Reborn \u2014 a vibrant VR experience where attitude meets adventure. Explore, connect, and evolve in a universe like no other."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/1b9e1747-f19d-4403-9b9c-ee7534f82968", "developer_terms_of_service_url": null, "publisher_name": "Savior ", "support_website_url": null, "website_url": "https://sites.google.com/view/moodymonkeysreborn", "category": null, "comfort_rating":
7a0a&_nc_ohc=F6HCMdrVQ9gQ7kNvwFEV5fQ&_nc_oc=Adowox9SZ9bSHcVO4OrCHhDThCxnMDSxsyMRJGIFZkpEKrWfbHysPUGzSzWOdSGRhpE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNXei5dw4JcevLv4rXbttG7GOekx9gYO4sNQgO57qeWw&oe=6AFC8130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapeasset.png", "id": "1764659868202745", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823790_1764659871536078_1971284504079001392_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JgDVp-BLD0Q7kNvwGrfOKZ&_nc_oc=Adp27cpG166lh0Q9CuaQSFi9vk6aNSOyTJmpwSJuCMhMiobYHKDD6BcXpR1bvq87pIc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhegSAbI9i-6_qRiMTEIMFh9rxWkL0oO_UjIZyRDIvgA&oe=6AFC8F12"}, "display_name": "Vaelorys", "keywords": ["Action", "Adventure", "RolePlaying", "Arcade", "Fighting"], "long_description": "**Step into the Abyss. Claim Your Legend.**\n\nExperience the dark, visceral thrill of a classic dungeon crawler reimagined for Virtual Reality. Vaelorys is a high-octane hack-and-slash RPG that puts the spark of the arcane directly in your hands.\n\n{1006696361970189}\n\nIf you\u2019ve spent countless hours chasing the perfect loot drop in classics like Diablo, Vaelorys brings that addictive \"just one more floor\" gameplay loop into a fully immersive 3D world. No more clicking from above. In Vaelorys, you are at the center of the storm.\n\n# Core Features\n- **Visceral Combat & Spellcasting:** Don\u2019t just push buttons. Swing your hands to cast a library of powerful spells to incinerate waves of monsters.\n- **The Ultimate Loot Hunt:** Explore dangerous dungeons and untamed wilderness to find rare gear and artifacts. Every piece of equipment enhances your power, allowing you to tailor your build to your playstyle.\n- **Epic Progressive Challenges:** Face off against relentless mid-bosses and towering final encounters. Each victory grants experience to level up your skills and unlock devastating new abilities.\n- **A Living World in Development:** This is a true Early Access journey. Vaelorys is constantly evolving with new systems, features, and content shaped by the community.\n\n**The dungeons are calling. Will you emerge as a god, or become just another skeleton in the dark? Join our Discord to get all updates: https://discord.gg/RprhzVkgAa**", "short_description": "Diablo-style dungeon crawling meets immersive VR combat. Battle through dangerous ruins, unleash powerful gesture-based spells, and hoard legendary loot in this visceral hack-and-slash RPG. Level up your hero, conquer epic bosses, and help shape the future of Vaelorys in Early Access!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vaelorys.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Spellbound Studio", "support_website_url": null, "website_url": "https://vaelorys.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31826464160285952"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1797180984936924"}]}, "baseline_offer": {"id": "1797180984936924"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793221560, "status": "PUBLISHED", "id": "1797180984936924"}]}, "liveChannel": {"nodes": [{"latest_s
.oculuscdn.com/v/t64.5771-25/491828008_1560437572378404_1596798309527356036_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWExg6eL0QsQ7kNvwF9O8h8&_nc_oc=Adr5Ajd0LZsirWhq2opTWDnbxzmEnPr5kda8VcxeIjfDO7zmbLfLwNgZvXISA6AeP3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk5l-lTpQ9lTqByHKZHpx9nU1h9mxOpa7_CrjRJZ0U1Q&oe=6AF5C3FD"}, {"file_name": "Screenshot_20260710_124357 - Copy.png", "id": "27409480322041547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827626_27409480338708212_8093474763508091425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI1kt6ycPCoQ7kNvwFQ14aO&_nc_oc=AdogFHVLCYly7oB4fFsJGasGBHpwv2gebeQmdkqW0rZyDGnR2TtfzTSW8A0OrliyOYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVT_ai72hy7DErUbkYyJs4v-D-Znj4Ek_RbUGoGCVKzw&oe=6AF5CACC"}, {"file_name": "Screenshot_20260710_123052 - Copy.png", "id": "1744718143220044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_1744718149886710_6227326422124483575_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDtPtfqys_0Q7kNvwEyn4CE&_nc_oc=Adotn4izuAqKKsShrxuW0uL9UJm5A18HKNkhY-qB5Ak1SxB-4ybzSLp8ktGgMaw2ufU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVqLGUkFMbuoB1dUKe1fWgkOCEb6e-GfBl14nwwTdoAg&oe=6AF5E2FD"}, {"file_name": "Screenshot_20260710_124218 - Copy (2).png", "id": "1057663196945226", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_1057663200278559_542144841284487158_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRAaRG6nqq4Q7kNvwEt_YTH&_nc_oc=AdoFxJdrL8SbFLaOkZkdyWCjMe_ALaGAevoMUHBTzPVW_op42TD3sIZB0hUVCS5SeJY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_30wLxqa2IHIialPGN1Q8nYRwC2VqtKb-L-68SSkMmA&oe=6AF5E9B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapeasset.png", "id": "1764659868202745", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_1764659871536078_1971284504079001392_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpgSAjAImY8Q7kNvwEP0P3E&_nc_oc=Adr0RR05wnSz-Q6pFZs7uP5MPL_7DMVu63cR4hisBAsRrRzCjTS3sHzClG5K2ZlMSeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIvoF-wJHnhLt10obQ-AHJcbYFUTDq-v7e-ELYPodsew&oe=6AF5BF52"}, "display_name": "Vaelorys", "keywords": ["Action", "Adventure", "RolePlaying", "Arcade", "Fighting"], "long_description": "**Step into the Abyss. Claim Your Legend.**\n\nExperience the dark, visceral thrill of a classic dungeon crawler reimagined for Virtual Reality. Vaelorys is a high-octane hack-and-slash RPG that puts the spark of the arcane directly in your hands.\n\n{1006696361970189}\n\nIf you\u2019ve spent countless hours chasing the perfect loot drop in classics like Diablo, Vaelorys brings that addictive \"just one more floor\" gameplay loop into a fully immersive 3D world. No more clicking from above. In Vaelorys, you are at the center of the storm.\n\n# Core Features\n- **Visceral Combat & Spellcasting:** Don\u2019t just push buttons. Swing your hands to cast a library of powerful spells to incinerate waves of monsters.\n- **The Ultimate Loot Hunt:** Explore dangerous dungeons and untamed wilderness to find rare gear and artifacts. Every piece of equipment enhances your power, allowing you to tailor your build to your playstyle.\n- **Epic Progressive Challenges:** Face off against relentless mid-bosses and towering final encounters. Each victory grants experience to level up your skills and unlock devastating new abilities.\n- **A Living World in Development:** This is a true Early Access journey. Vaelorys is constantly evolving with new systems, features, and content shaped by the community.\n\n**The dungeons are calling. Will you emerge as a god, or become just another skeleton in the dark? Join our Discord to get all updates: https://discord.gg/RprhzVkgAa**", "short_description": "Diablo-style dungeon crawling meets immersive VR combat. Battle through dangerous ruins, unleash powerful gesture-based spells, and hoard legendary loot in this visceral hack-and-slash RPG. Level up your hero, conquer epic bosses, and help shape the future of Vaelorys in Early Access!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vaelorys.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Spellbound Studio", "support_website_url": null, "website_url": "https://vaelorys.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31826464160285952"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1797180984936924"}]}, "baseline_offer": {"id": "1797180984936924"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793221560, "status": "PUBLISHED", "id": "1797180984936924"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "40591537443778536", "version": "0.0.427"}, "id": "3042463359259862", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "31826464120285956", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40591537443778536"}, "release_sta
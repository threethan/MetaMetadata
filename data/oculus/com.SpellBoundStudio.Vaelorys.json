Q7kNvwHF9Myh&_nc_oc=Adrt-3wMUFsaRayFlfQDiv6etm1Vsta_aTz9GYimVImFiGIuP_E1_jXKb3nej5zkmyc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQPg5EFMK5T81Y64FAmI0aruaIwQMlRriavHxe9EkZq-w&oe=6B0C6C8C"}, {"file_name": "Screenshot_20260710_123052 - Copy.png", "id": "1744718143220044", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_1744718149886710_6227326422124483575_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfyuGWGRvoAQ7kNvwFKQQQ3&_nc_oc=Adpcno1V-5Fzhdu2CQBmRkiniHndzo2KUd84Hki5gjTsVFqYruoRnaoqI9GyCaqVsd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAh0czc_izN2EB9DoERMHyGaygRPQ0Quws0POuXj2Y1w&oe=6B0C84BD"}, {"file_name": "Screenshot_20260710_124218 - Copy (2).png", "id": "1057663196945226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_1057663200278559_542144841284487158_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asU1GHcYbGQQ7kNvwGctK56&_nc_oc=AdpgRRgNaO-j3ozuexdF0oih9rEa1x7aQXeFzCmviawyTO6TXvifeamUzi-AfXZ57aU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTom0kq7nco70MV9WXguPLWhseaPKuYuqRdYuIkhUSysQ&oe=6B0C5330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscapeasset.png", "id": "1764659868202745", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_1764659871536078_1971284504079001392_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWgQPLLzSggQ7kNvwG1BdoU&_nc_oc=Adreje2vpbIz0ky4LWkmHAkLo_ufOAV9Mx4uFLkeIOMWhXprI7KQIBL5VcAb817YY_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVddVpunWnWAyIkDhecywZml4_CrvAjVOkUH7GrwcXwA&oe=6B0C6112"}, "display_name": "Vaelorys", "keywords": ["Action", "Adventure", "RolePlaying", "Arcade", "Fighting"], "long_description": "**Step into the Abyss. Claim Your Legend.**\n\nExperience the dark, visceral thrill of a classic dungeon crawler reimagined for Virtual Reality. Vaelorys is a high-octane hack-and-slash RPG that puts the spark of the arcane directly in your hands.\n\n{1006696361970189}\n\nIf you\u2019ve spent countless hours chasing the perfect loot drop in classics like Diablo, Vaelorys brings that addictive \"just one more floor\" gameplay loop into a fully immersive 3D world. No more clicking from above. In Vaelorys, you are at the center of the storm.\n\n# Core Features\n- **Visceral Combat & Spellcasting:** Don\u2019t just push buttons. Swing your hands to cast a library of powerful spells to incinerate waves of monsters.\n- **The Ultimate Loot Hunt:** Explore dangerous dungeons and untamed wilderness to find rare gear and artifacts. Every piece of equipment enhances your power, allowing you to tailor your build to your playstyle.\n- **Epic Progressive Challenges:** Face off against relentless mid-bosses and towering final encounters. Each victory grants experience to level up your skills and unlock devastating new abilities.\n- **A Living World in Development:** This is a true Early Access journey. Vaelorys is constantly evolving with new systems, features, and content shaped by the community.\n\n**The dungeons are calling. Will you emerge as a god, or become just another skeleton in the dark? Join our Discord to get all updates: https://discord.gg/RprhzVkgAa**", "short_description": "Diablo-style dungeon crawling meets immersive VR combat. Battle through dangerous ruins, unleash powerful gesture-based spells, and hoard legendary loot in this visceral hack-and-slash RPG. Level up your hero, conquer epic bosses, and help shape the future of Vaelorys in Early Access!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vaelorys.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Spellbound Studio", "support_website_url": null, "website_url": "https://vaelorys.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", 
XKFLzYwuJ-kqj5-Q8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTTNeb5EtTzxRt0coYIk6gS9qGZOgNHqmdxQrsFDAQKg&oe=6B0C7366"}, {"file_name": "4 - Old Town.png", "id": "1922914775788010", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604293968_1922914779121343_4383991089395734820_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKPhaeuCD60Q7kNvwHZJDTE&_nc_oc=AdrUI2mPE1j_yAWDSvRnrqSRelyfFCX9mkhvIOA8MIFBAEBGlBquUdz-huThxCQwpak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT_ZCNN8OtHQ0YnFBlQE_9WlTbWS60KOH0-4FBvWyHxcQ&oe=6B0C7630"}, {"file_name": "5 - Sniper Tower.png", "id": "1168045662550541", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596106838_1168045665883874_8000359162995282421_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j044DRhpRXkQ7kNvwHJb6Bc&_nc_oc=AdpW2B0qIJtwylL8t-mj9yk8kXg65AWfzX0nWVkCjVlcIb89ki4xbgH_KlyJocB3raU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSYuHxW4LyOFo9JyaSzDBLbFSkLOsnvSUdha1t1M1a0HA&oe=6B0C5E04"}, {"file_name": "1 - Military Base.png", "id": "1493185632683608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596106838_1493185636016941_7356100735961935464_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kbhe3i8kvGEQ7kNvwEnhYJ_&_nc_oc=Adqi2yyABimtIFXhKyGV-Atidh-WdTJi8L7EmAnVhI-tMFYK1wzBsp2qnDSaAnDHgus&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTq2afVrI6Yod7hRZB0Z_N2J5Xd4Wz2SGrd51RHrFpYSA&oe=6B0C707C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "1490632739591447", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596068480_1490632742924780_92200404424606132_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlwNi7cn3SYQ7kNvwGiGS8f&_nc_oc=AdpA_fZ6Etr6zShDW6G93QneO7hM2KPCYuX06xZgdEvKxiXnAUldi6vIv0wc0F9nGnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzilpZW3gUz6SASU7rPrcYHk4Ld9oQodl_haM7dJ4a3A&oe=6B0C80EA"}, "display_name": "Night Garrison", "keywords": ["zombies", "horde", "baseDefense", "apocalypse", "shooter"], "long_description": "When night falls, they come. Your base is the last light for miles, and you are its garrison.\n\nNight Garrison is a wave-defence shooter built for your hands. Take a rifle off the armoury wall, brace it with both hands, drop the empty magazine and push a fresh one in yourself. Sling it over your shoulder, draw your pistol, pull the pin on a grenade.\n{28950079054644293}\n\nFight\n{1519593749973703}\n 14 weapons: AK-47, M4A1, Thompson, shotgun, sniper rifle, LMG, crossbow, bazooka, M134 minigun, blowtorch and four pistols, plus a knife, grenades and flares\n- Hand-driven reloads on every gun\n- Endless waves of the infected: soldiers, hulking brutes and giant bats, tougher every night\n{2712172642534793}\n", "short_description": "The last base standing. When night falls, the infected come. Grab real guns, reload them with your own hands and hold the line through endless waves, alone with a squad of AI soldiers or with up to three friends in online co-op. Four maps, a sniper tower and 1v1 online duels."}]}, "developer_name": "MDC Studios", "developer_privacy_policy_url": "https://playmdcstudios.com/night-garrison/privacy", "developer_terms_of_service_url": null, "publisher_name": "MDC Studios", "support_website_url": null, "website_url": "https://playmdcstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
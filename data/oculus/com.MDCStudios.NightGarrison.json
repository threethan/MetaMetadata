U_NO19AzAuKDTB4N0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUPpg8IxsKlKHoCoHVpZSO8_2R3LTH0RUupmNPsOviRug&oe=6B1067E6"}, {"file_name": "4 - Old Town.png", "id": "1922914775788010", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604293968_1922914779121343_4383991089395734820_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMWfTinUwD4Q7kNvwHVWa0L&_nc_oc=AdouKaxSo7K-lnenvAXzIPFpXvEpoqDny5mHRcFLKabF9kVysTGemIjvVoUnNN5h0-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU1sVgRKLLQztxDJZvwjWgASHyCMIsuMKmA8SHm0brzuw&oe=6B106AB0"}, {"file_name": "5 - Sniper Tower.png", "id": "1168045662550541", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596106838_1168045665883874_8000359162995282421_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=759GW1pij5oQ7kNvwH12HNj&_nc_oc=AdoDG3G0elzJ1wE350fP1I0qiJ2AjsCyAs_h3-ZyDeQGEun5_CpSD1eIlzVyJyWun7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0NlM4qNoXu1ufdPvhRXZ7go1cnVeZaanGiw2eTV8NDA&oe=6B105284"}, {"file_name": "1 - Military Base.png", "id": "1493185632683608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596106838_1493185636016941_7356100735961935464_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ntVcYGMzqUQ7kNvwEa_O_G&_nc_oc=AdpumBazcKCOr6b8orFdzrXaDBlWLhU5vvAIEoLm7P3ygSXGAINYckRIQA0T7WBhgy4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU-JP2960_c1Pioozeo4A6vIjG6j5Mt_-Z91nxa4cZEEA&oe=6B1064FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440.png", "id": "1490632739591447", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596068480_1490632742924780_92200404424606132_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KNXxMUrpxQQ7kNvwHi7ZYO&_nc_oc=Adp82yTPLCNfhG0CpcTFkmAE_w4RjrLWFgyfvJNhLo7EE4D_GoVTvb4GX1iPY2U5oi4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVBjyek6WPCvDHGiM6-KI8p25-LSwGoTe5Q2e-R-8ShoQ&oe=6B103D2A"}, "display_name": "Night Garrison", "keywords": ["zombies", "horde", "baseDefense", "apocalypse", "shooter"], "long_description": "When night falls, they come. Your base is the last light for miles, and you are its garrison.\n\nNight Garrison is a wave-defence shooter built for your hands. Take a rifle off the armoury wall, brace it with both hands, drop the empty magazine and push a fresh one in yourself. Sling it over your shoulder, draw your pistol, pull the pin on a grenade.\n{28950079054644293}\n\nFight\n{1519593749973703}\n 14 weapons: AK-47, M4A1, Thompson, shotgun, sniper rifle, LMG, crossbow, bazooka, M134 minigun, blowtorch and four pistols, plus a knife, grenades and flares\n- Hand-driven reloads on every gun\n- Endless waves of the infected: soldiers, hulking brutes and giant bats, tougher every night\n{2712172642534793}\n", "short_description": "The last base standing. When night falls, the infected come. Grab real guns, reload them with your own hands and hold the line through endless waves, alone with a squad of AI soldiers or with up to three friends in online co-op. Four maps, a sniper tower and 1v1 online duels."}]}, "developer_name": "MDC Studios", "developer_privacy_policy_url": "https://playmdcstudios.com/night-garrison/privacy", "developer_terms_of_service_url": null, "publisher_name": "MDC Studios", "support_website_url": null, "website_url": "https://playmdcstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nul
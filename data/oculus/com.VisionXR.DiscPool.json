ontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGHs13fIOfMLQFEZetNkeKm4pxpxE5S2NalqT_6fsUbw&oe=6A5B779B"}, {"file_name": "ScrSHot2.png", "id": "2038710707042280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619465_2038710713708946_7441268096511211992_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JDi3n9otPIQ7kNvwEsJ_8w&_nc_oc=AdrP1ylRbqaDQxTSIe4w-F66ruYKvkHOguHlSjo708QdkRa9JL_0Qf2UpEZureMmqZE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsN91fU_xhb9_nyHU4PKbSV0Z6r8YQ_10C2CmNZKWSZQ&oe=6A5B5EF7"}, {"file_name": "ScrSHot4.png", "id": "26925800070379623", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618069_26925800087046288_8681292664559350495_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7iHTeCBD0wQ7kNvwGsxSxU&_nc_oc=Adrii8TKAaXtD0IEpiGiQeibs97xsSadMXdRsnvwKwbHgBiemD40KxUcpwa-WESvmzo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfXUu352XCNx1YPQlxLJ2J5Riqhn4_1Udzw7tW3T5S_w&oe=6A5B8394"}, {"file_name": "ScrSHot1.png", "id": "788496127290707", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618288_788496130624040_7005408535905486752_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7KyFEHiHhEQ7kNvwG92n03&_nc_oc=AdpA3jcxV_GxMF6wTu19QceFBfJYZxcb2A-dx3QK1QwLC88j7zbJfyskHTRdk7TRDvs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEgHMHB4p0Ls8p4ZZDmncTdvK705Jd9X9py24NAjPXTg&oe=6A5B5F10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Logo_2560x1440.png", "id": "3321975841307912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499624983_3321975847974578_6655988139958111276_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i5ZsYhgNH8Q7kNvwFy37PY&_nc_oc=AdrnPpVSo05SZJp8sfAOHBKxIIvFXNKy2Mc7MXVxfqXbecyjl0KARwePV-jXnW5xGvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9HJ77GaEIC7eeorHm4UFhJET4IoVPAKJ5YY19x6Lkkg&oe=6A5B81F9"}, "display_name": "DiscPool", "keywords": ["Pool", "Snooker", "Billiards", "8BallPool", "MultiPlayer"], "long_description": "Step into a new dimension of play where the tactile flick of Carrom meets the world-class strategy of 8-Ball Pool and Snooker. Disc Pool is a ground-breaking experience that reimagines cue sports on your terms.\n\nForget the heavy cue sticks and the need to walk around a massive table\u2014we\u2019ve brought the game to you. With our innovative Rotating Board (Lazy Susan) mechanic, you stay in the flow while the table aligns perfectly to your next shot.\n\nGame Modes\n 8-Ball Pool: Striped vs. Solid discs. Clear your set and sink the black to claim victory.\n\nSnooker Mode: Experience tactical depth with reds, colors, and precision point-scoring, all on a dynamic flick-style surface.\n\nMulti-Shape Arenas: Challenge yourself on Square, Hexagon, Octagon, Triangular, and Circular boards that change the physics of every bank shot.\n\nMaster the AI\nSharpen your flicking skills against Adaptive AI. Whether you want a relaxing solo practice session or a high-stakes challenge, the competition always feels real.\n\nPlay with Friends & Express Yourself\nConnect and compete in seamless matches with your friends. With real-time voice chat and customizable Meta Avatars, every game feels like you're sitting around the same table. Test your precision, outsmart your rivals.\n\nPush your skills to the limit and unlock exclusive achievements as you master each arena.\n\nTrack your progress on the Global Leaderboards and prove you\u2019re the top striker in the world.\n\nMaster every board. Become unstoppable.", "short_description": "Spin. Flick. Pocket. Experience the next stage of Pool evolution with Disc Pool. Master 8-ball  pool and snooker on rotating geometric boards that bring the game to you. The ultimate Pool-Carrom hybrid, reimagined for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/discpoolprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "su
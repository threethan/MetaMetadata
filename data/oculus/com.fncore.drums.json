KwaT6SMIm5kQ7kNvwFRIR9a&_nc_oc=AdoX-6vltN07zBPn1w6K-K0HKfluk7wYyhKkt9glZBPTAxnuk_TZnP2qHRvdJ-ADIa4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn_D85cjM0QGVaQyJTsYCT1CIFJ5cuYRdAgRyaFqBOow&oe=6B09B2DA"}, {"file_name": "screenshot-4.png", "id": "1887391855764901", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/908839675_1887391859098234_506287598860414257_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZXbJFTUAKgQ7kNvwEcX3x4&_nc_oc=AdofuFrA0dlHScwOFgVbcuTpOwX15EsedNd4LakeFfSUI9f63FRkl_m5WTKQOHv3ZO0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqnJCoN08miTZGdCiqzkL0gfKWmxqTsQCxyvAcv1o5gg&oe=6B099F5D"}, {"file_name": "screenshot-5.png", "id": "1742805834110366", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/908839702_1742805837443699_3343238834299570501_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8H61vY2bh8Q7kNvwH_TM7C&_nc_oc=AdrFvIDs2vI9oWqGXNBisTlAk7ma6UM_tCP98eDFWqgS-EPEIHMHDy_jmoli1bqMiNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTJ0TWsb4bjkzRIF_y9uW0U62fgeyRPAqbvmU6tX0LLw&oe=6B099A01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11_trailer_video_screenshot.png", "id": "1844896346647705", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/908839680_1844896349981038_6594546478411703836_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8AlNEZe6LcQ7kNvwHJ6Eih&_nc_oc=AdrZnzaynk4zt6g2H9_DkdCE4Us2ROcSzOO4sis9yv1NSCD6jh_WjIZ27vw0kKuUgE0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpfEAt79pjFCz-yS9WaDeMXNiecErryNY_mWTOTYqqPg&oe=6B09BCC8"}, "display_name": "Drum", "keywords": ["drums", "percussion", "music", "instrument", "band"], "long_description": "A drum kit, in mixed reality.\n\nSit down and play it with your bare hands or with controllers.\n\nPick from three kit sounds: a big, deep kit, a bright studio kit or a vintage one.\n\nStrap on a marching snare or quad toms and march around the room.\n\nPlay with friends online, whichever Fncore instrument they have: Violinist, Trombone, Trumpet, Cello, Tuba or Drums.\n\nThe music stand shows you how to play 20 songs, like The Stars and Stripes Forever and When the Saints Go Marching In. It lights up which drum to hit.", "short_description": "A mixed reality drum kit for Meta Quest. Sit down and play it with your bare hands or with controllers. Pick from three kit sounds, or strap on a marching snare or quad toms and march around the room. The music stand shows you how to play 20 songs, like The Stars and Stripes Forever. It lights up which drum to hit. Play with friends online, whichever Fncore instrument they have: Violinist, Trombone, Trumpet, Cello, Tuba or Drums."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/drum/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3160277370985417"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624395_4736540846491136_232662523418460342_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=
uluscdn.com&_nc_ss=7f20f&oh=00_AQRpfEAt79pjFCz-yS9WaDeMXNiecErryNY_mWTOTYqqPg&oe=6B09BCC8"}, "display_name": "Drum", "keywords": ["drums", "percussion", "music", "instrument", "band"], "long_description": "A drum kit, in mixed reality.\n\nSit down and play it with your bare hands or with controllers.\n\nPick from three kit sounds: a big, deep kit, a bright studio kit or a vintage one.\n\nStrap on a marching snare or quad toms and march around the room.\n\nPlay with friends online, whichever Fncore instrument they have: Violinist, Trombone, Trumpet, Cello, Tuba or Drums.\n\nThe music stand shows you how to play 20 songs, like The Stars and Stripes Forever and When the Saints Go Marching In. It lights up which drum to hit.", "short_description": "A mixed reality drum kit for Meta Quest. Sit down and play it with your bare hands or with controllers. Pick from three kit sounds, or strap on a marching snare or quad toms and march around the room. The music stand shows you how to play 20 songs, like The Stars and Stripes Forever. It lights up which drum to hit. Play with friends online, whichever Fncore instrument they have: Violinist, Trombone, Trumpet, Cello, Tuba or Drums."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/drum/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_mo
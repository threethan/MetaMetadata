_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SamP2wqX4dcQ7kNvwEVSbpk&_nc_oc=AdrTQydoGCJ-lDhMYbvNSutkQ8lZjR4-DmUj7ILX_yWB7jH-JuAy7CwCtNtYg4mP00o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVjpiYW751JSzJ2DHb75O_0itdqFWt3YCLUSSzti5LnPA&oe=6B0F1D9D"}, {"file_name": "screenshot-5.png", "id": "1742805834110366", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839702_1742805837443699_3343238834299570501_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4UEJiJfgtgQ7kNvwGCKDWD&_nc_oc=AdohBF4_cP_F-7-6qv0qwbUyMTcPIrhYutG_hWEPvWgEDGFIMDWTtelqka8uz2uQDxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVopalgcQYiej-MqOnzPCzj479sTROP8qzN-yyp-6tc1A&oe=6B0F1841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11_trailer_video_screenshot.png", "id": "1844896346647705", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839680_1844896349981038_6594546478411703836_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2tFvh2Q94gQ7kNvwGXXh7h&_nc_oc=AdrXmHkK3ixmhKuYOG3YRsLu6bjt9E6WjBYzk6OV-Kvz7ZapCTGZiyJc0ElaweNxObw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUM4HuYhfiAaxvTjVdVosfUiN1nb85Z9eKiPYD0LEx28Q&oe=6B0F02C8"}, "display_name": "Drum", "keywords": ["drums", "percussion", "music", "instrument", "band"], "long_description": "A drum kit, in mixed reality.\n\nSit down and play it with your bare hands or with controllers.\n\nPick from three kit sounds: a big, deep kit, a bright studio kit or a vintage one.\n\nStrap on a marching snare or quad toms and march around the room.\n\nPlay with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest).\n\nThe music stand shows you how to play 46 songs, like The Stars and Stripes Forever and When the Saints Go Marching In. It lights up which drum to hit. Nineteen of them are holiday songs, from Jingle Bells to Auld Lang Syne.", "short_description": "A mixed reality drum kit for Meta Quest. Play it with your bare hands or with controllers. Pick from three kit sounds, or strap on a marching snare or quad toms and march around the room. The music stand shows you how to play 46 songs, like The Stars and Stripes Forever. It lights up which drum to hit. Play with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/drum/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3178275365852284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499624395_4736540846491136_232662523418460342_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12369sViB1gQ7kNvwEjYO10&_nc_oc=AdriRThx8daSJfVbn-frhcBc1B-ain6MWytjKA87DjUe4s_pD23cCHCIw-ZRkRZiQKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWUYqNB8nU6pY0Xg-0TY5Y
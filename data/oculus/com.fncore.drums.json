_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SamP2wqX4dcQ7kNvwEoT0cS&_nc_oc=AdpG0ufdWxr81SjFnwIdGss5JGlIBwhbel0Yj2iCR4HrXi35swpQff6dBvbgxXpMgbs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTuETxPX4kR6Yrnj_58QzbUiloilA5g5pS7Mc62yCFPcA&oe=6B0DCC1D"}, {"file_name": "screenshot-5.png", "id": "1742805834110366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908839702_1742805837443699_3343238834299570501_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4UEJiJfgtgQ7kNvwGH6c6-&_nc_oc=Adom1-2uLaCov5_SR_fEq8Q3TL5KOX99aZEVZzALta1c9skoj9KSvWReylfzY6WjWbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSrcROYXNIwJ4fnDcean4_Pkk9AlDYCd9a1LFCL4oHWbg&oe=6B0DC6C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11_trailer_video_screenshot.png", "id": "1844896346647705", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908839680_1844896349981038_6594546478411703836_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2tFvh2Q94gQ7kNvwECyBgc&_nc_oc=Adq3t2-5lvSZxX4T24xdvtbCGZ0uccdvY43zHIY6bY0mFhGoDfosPPTIWz6NeuEHL_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-tX59Kz_7_vKRrPEYf5dBPI2rcMnVX1g5nORE1wb3Bg&oe=6B0DB148"}, "display_name": "Drum", "keywords": ["drums", "percussion", "music", "instrument", "band"], "long_description": "A drum kit, in mixed reality.\n\nSit down and play it with your bare hands or with controllers.\n\nPick from three kit sounds: a big, deep kit, a bright studio kit or a vintage one.\n\nStrap on a marching snare or quad toms and march around the room.\n\nPlay with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest).\n\nThe music stand shows you how to play 46 songs, like The Stars and Stripes Forever and When the Saints Go Marching In. It lights up which drum to hit. Nineteen of them are holiday songs, from Jingle Bells to Auld Lang Syne.", "short_description": "A mixed reality drum kit for Meta Quest. Play it with your bare hands or with controllers. Pick from three kit sounds, or strap on a marching snare or quad toms and march around the room. The music stand shows you how to play 46 songs, like The Stars and Stripes Forever. It lights up which drum to hit. Play with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/drum/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": null, "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3178275365852284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624395_4736540846491136_232662523418460342_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12369sViB1gQ7kNvwHfzDlY&_nc_oc=AdpFi2NSTcOeaQFDYGVjiARPwhiIEBfWbJGRxi0RN2j97B2AaMA_Z2qtaIQlwvpqNnQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1ex6NRaOgQ780ZW0IAGB
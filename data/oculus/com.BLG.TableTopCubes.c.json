.com&_nc_ss=7f20f&oh=00_AQTo5qMHf6AyIxZr9K2JqxiilrYClPFQ7TAA8s7Zn7tgJg&oe=6AFB4CD6"}, {"file_name": "NewB.png", "id": "842599584518731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974871_842599587852064_223036225614200381_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AS7NvIjtJ4Q7kNvwFAU0uV&_nc_oc=AdpMaQgKx6-e-jVN5IS-zZVvfeYoTigAVP4LuXZ9xeQ1U3K1lTO9PWSspT4CrmHyyQY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7uZAOY1GO6Q113-pcnRuAn4fvB98MCQzLSXdlMHIOOg&oe=6AFB1FE2"}, {"file_name": "NewC.png", "id": "3787104081538670", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974666_3787104084872003_86056560471706045_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbwzS5zqsHEQ7kNvwHB4_ba&_nc_oc=AdpMZEsLyHgIIAd4oa7Nn_qmw7nBqOqQBmDZ7PlubZ6f8NNey_zSDoOpYntY3yiqc0A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThddV_VTtIY7IIeQ70c6_2C1A41C8Kt4mfhUJ5OYQsfA&oe=6AFB33AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner2560.png", "id": "1067636008083648", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974638_1067636011416981_3036941726911093889_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzDaFrPSvPcQ7kNvwHLQtyc&_nc_oc=Adop4A-HHmX78B84aECcWi1S3bjrh2n85C2saDpeZBdN8-DmfBPM_Win0D6WG05roQw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR78v-EAZITgLp5vPrBZydwzIf_sDAPtAw8Yr3b3L67ZA&oe=6AFB39D5"}, "display_name": "TableTop Cubes", "keywords": [], "long_description": "TableTop Cubes is an innovative twist on a classic game, bringing the timeless puzzle into a captivating 3D augmented reality (AR) experience. Designed for solo play, TableTop Cubes transforms your coffee table into a dynamic, interactive gaming platform.\n\nPlayers can enjoy the traditional  gameplay, but with a modern AR twist that allows for a fully immersive experience. The game board appears in front of you in 3D, enabling you to manipulate and interact with the pieces as if they were physically present. Whether you're a long-time fan of these puzzles or new to the game, TableTop Cubes offers an engaging and refreshing way to play.\n\nFeatures:\n\n3D AR Gameplay: Experience it like never before with a moveable 3D game board that appears right on your coffee table.\nIntuitive Controls: Easily adjust and interact with the game pieces using simple hand gestures.\nSolo Play: Enjoy the challenge of beating your own high scores and improving your skills.\nDynamic Challenges: Each game is unique, with pieces that move and fit together with precision, ensuring a challenging and fun experience every time.\nBuilt using Unity, the META SDK, and Avatar SDK, TableTop Cubes leverages the latest in AR technology to deliver an unparalleled gaming experience. Get ready to rediscover the fun of Tetris in a whole new dimension!", "short_description": "TableTop Cubes is an innovative twist on a classic game, bringing the timeless puzzle into a captivating 3D augmented reality (AR) experience. Designed for solo play, TableTop Cubes transforms your coffee table into a dynamic, interactive gaming platform.\n\nPlayers can enjoy the traditional  gameplay, but with a modern AR twist that allows for a fully immersive experience. "}]}, "developer_name": "BLG", "developer_privacy_policy_url": "http://www.tabletopcubes.com/pages/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "BLG", "support_website_url": null, "website_url": "http://www.tabletopcubes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "reco
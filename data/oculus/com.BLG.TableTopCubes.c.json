, "id": "1202675858345179", "locale": "en_US", "screenshots": [{"file_name": "AI Concept - 01 - Home Hub - 2560x1440.png", "id": "1368361501914874", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619374_1368361508581540_4009246752706269675_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcgVCCSV5UkQ7kNvwEJMihs&_nc_oc=Adq8iodeqWaRt6OLWFlrqAHe5V3bL9gHKQ6skaSVyz7N213tlX0cNJl9nPxb8oBCq-0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPpCpOdlygAhh0zBxyvvDbeblufsJFh9E6hapOUnYmcA&oe=6AFB3CB2"}, {"file_name": "AI Concept - 04 - Snake - 2560x1440.png", "id": "2207220179876073", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593767690_2207220183209406_827148057132691589_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6miVLJbHMdYQ7kNvwGKmWY9&_nc_oc=AdopoHBq8ha9hZSj6Ccbypckt2mtTY-nonW5OCRKRO10NQ9HT4JVp7mSg8e6V2WFVqk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOqNHjDroCsBYnPlKVq8h6s6KLJqXcfIpFMNpZRGk_1g&oe=6AFB1FC2"}, {"file_name": "AI Concept - 02 - Cubes Planning - 2560x1440.png", "id": "2675773422862669", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499627502_2675773426196002_4093636049896623351_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5cNxEejbpMQ7kNvwFMheCH&_nc_oc=AdrTqMcw-fFCB_1ONUVHurpHCfwR8LMgcigJD0enFi4FNwA6xsrvhj2eUW-0EJGFmu0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-C0xG3hSzaNl4h3op9HfI8pYbRVKRUnYn_Dpg35oZeQ&oe=6AFB4B56"}, {"file_name": "AI Concept - 05 - Pongo - 2560x1440.png", "id": "1680276806875019", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593727470_1680276826875017_4858632307809958157_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BcLssdQxqsQ7kNvwF5YA4e&_nc_oc=AdrDke17OTI3H55SLcCaYd-quWjv-dz_6hcrEzrgRnz__N0NGliRPL0uj7m6Mj71nBI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKvDyojchp10OO6pefjqKu3TwKrz_Tib3MHZ6MLz1I3g&oe=6AFB3CFF"}, {"file_name": "AI Concept - 03 - Cubes Gameplay - 2560x1440.png", "id": "1813895759945849", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593868733_1813895763279182_7035577510879435615_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDCD0hy_U28Q7kNvwHnLM_c&_nc_oc=AdrRnL29MNfqH1kr_o30AlRaw6dJOO6tAxeuLZ0N3l_qpFZGDtZYO_fA-GL-a2Qvv9U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCYpitz44koY-kG46F8Ixq4Hym4Y-9UW3xiShgV967MA&oe=6AFB264E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META - Trailer Cover Image - 2560x1440.png", "id": "1824368398600712", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628092_1824368401934045_2419597181656136293_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvVyBlRjOv0Q7kNvwG6s99A&_nc_oc=AdpOJ1J06zcNJrLSP7rmlHY9Ii9qnGx_OGDJX3Xf6sekE-n2LE6xIuAAsO7Lh6fA4wM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2hlmVTe6qg3ZZfO9A8I3uGcGjbLZUtWzGzLX6uVuVRA&oe=6AFB3606"}, "display_name": "TableTop Cubes", "keywords": ["tabletop", "arcade", "puzzle"], "long_description": "Three games. One table.\n\nTurn your table into a mixed-reality arcade with three solo games, colorful 3D boards, and a redesigned home hub.\n\nCUBES - STACK AND CLEAR\nPlan your placements, complete lines, and clear floors. Choose Classic, take a slower pace in Relaxed, or race the clock in a three-minute Sprint. Preview your next piece, hold one for later, and earn combo and floor-clear bonuses.\n\nSNAKE - EAT AND GROW\nGuide your cube snake toward food and grow your trail. Plan your turns, keep moving, and try to beat your personal best.\n\nPONGO - BOUNCE AND AIM\nGuide a moving paddle and steer the ball toward targets. Use tilt and rebounds to keep the rally alive.\n\nA FRESH LOOK ACROSS THE COLLECTION\nDark boards, cyan grids, coordinated colors, and matching menus bring all three games together. Choose your next challenge through animated game previews, check personal bests, and compare rankings. Cubes online rankings apply to Classic mode.\n\nOpening instructions, help and pause screens, clear results, and shared audio settings keep the focus on play.\n\nPick your game. Find your rhythm. Try for a new best.", "short_description": "Three games. One table. Bring a mixed-reality arcade into your room with TableTop Cubes. Stack and clear in Cubes, eat and grow in Snake, and bounce and aim in Pongo. Explore a redesigned hub, chase personal bests, and choose Classic, Relaxed, or a three-minute Sprint in Cubes.\nPlayers can enjoy the traditional  gameplay, but with a modern AR twist that allows for a fully immersive experience. "}]}, "developer_name": "CC Creations", "developer_privacy_policy_url": "http://www.tabletopcubes.com/pages/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "CC Creations", "support_website_url": null, "website_url": "http://www.tabletopcubes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25059277313726395"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499621314_1453517816869790_5188280430753321682_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc
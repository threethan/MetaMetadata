02&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGv0noBEuEkQ7kNvwGf_I5e&_nc_oc=AdlHRCJ4oVWm9APD_YSi6BpnIwVyDvu-XruTt5Ho8lGS1xVmEzBvelpgZXvjD9xh0wI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsFRCTD8tEFUDCgbIzb2K6Hm1SqMFRdtchxJIFTFPKK1g&oe=699992F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "872339911471866", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974632_872339918138532_6392877820072822291_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f5tbzC1aDYQ7kNvwFckFeN&_nc_oc=Adl-EKF4WtoA4_Tf-YUaoNfVqPaONvtqFz84oipU_uCdycoOs4rLZciu9ERcZy83MYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftogTmZNYeTKjEFn8A8dAaHASN7wyzf-TZEH1q3DfeW9Q&oe=6999BDBB"}, "display_name": "MagicPals", "keywords": [], "long_description": "**Meet Lumi**: In an accidental time-space teleportation, Lumi exhausted its magic and unexpectedly fell into your world. You have since become aware of the existence of another world and started to learn many magical wonders.\n\n**Become Friends with Lumi**: Sit down and chat with Lumi, learn about its story, and share your daily life. Lumi will remember the topics you discuss, and through these interactions and shared moments, you will build a strong friendship.\n\n**Touch and Interact**: Use your bare hands or items to interact directly with Lumi. It will respond to your actions. Pat its head, poke its belly, or even give it a gentle push... but don't be too rough, as Lumi will remember your actions.\n\n**What's Outside?**: Turn your room into another world! Together with Lumi, capture Aimo in various magical worlds, collect magical crystals called Mana. Expanding reality will be an important gameplay feature in the future, providing limitless space and possibilities for your adventures with Lumi.\n\n**Decorate Your Home**: The Mana you collect can be used to purchase items to decorate your home. Each item has its own characteristics, and Lumi recognizes some of these things. Maybe it can tell you about them?", "short_description": "MagicPals is a pet-themed casual game based on MR devices. You will encounter a magical creature named Lumi, an adorable and enchanting little sprite. During a time-travel mishap, Lumi exhausted its magic and fell into your home. From that moment on, your life will be filled with an interesting and mischievous companion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vibellm.com/magicpals-privacy-policy", "developer_terms_of_service_url": "https://vibellm.com/magicpals-terms-of-use", "publisher_name": "Vibetech", "support_website_url": null, "website_url": "https://vibellm.com/magicpals", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26892103917041585"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1881842349237460"}, {"status": "PUBLISHED", "id": "1190925159262404"}, {"status": "PUBLISHED", "id": "1105465077726742"}, {"status": "PUBLISHED", "id": "1778880032879353"}, {"status": "PUBLISHED", "id": "943494890669450"}, {"status": "PUBLISHED", "id": "1004728471338475"}, {"status": "PUBLISHED", "id": "411034998517271"}, {"status": "PUBLISHED", "id": "2871546666342545"}, {"status": "PUBLISHED", "id": "1024435055611611"}]}, "baseline_offer": {"id": "1105465077726742"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750
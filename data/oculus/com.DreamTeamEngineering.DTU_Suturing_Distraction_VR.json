"}, {"file_name": "beach.png", "id": "1829455203887236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_1829455207220569_178758151851518834_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUX640sB8D8Q7kNvwF0dq0z&_nc_oc=Adq5UrLFiuNvzdI2Uo8vjzhBAMPHdVC7I512F6GBALxuKnXWRPQqq1HJFndmQz4HO7g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV-L0jQx7CUPgZDoIt_75PEqXu0tqq0uB-SAkVdunUrQ&oe=6B03164F"}, {"file_name": "forest.png", "id": "431548231520794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982670_431548234854127_7928222096587893478_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWUEMRix9b8Q7kNvwG_NCmE&_nc_oc=Ado8MARHQ6ha_2SpUVYyq8K-bkFr6_iI014EWuri_NKlGzUn6RshTysHEoSXSBpE61s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5B--X6IZfdr7BFe6b9aK-yH9QAcJ9rRWwsKEMEoaJ9g&oe=6B0306C7"}, {"file_name": "desert.png", "id": "1053831951790065", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031493_1053831955123398_738398746983768786_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5DjkUCLKbUQ7kNvwFIvs0f&_nc_oc=AdpJn8MTPJMP3WCVNFIzfu6fmCoQSuOIRPI41PF3Axh8lz7IOpAGcYM6kdn8GLuBBXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkE7qGT_PjrJu0jC3xUa_zHDWq_JEfg8hefpRVeHqZHg&oe=6B030EF6"}, {"file_name": "startMenu.png", "id": "423322422225187", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031391_423322425558520_2333985987481995841_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSYUQK_HVJsQ7kNvwFxSyoM&_nc_oc=Ado_WQfmE-X0mdgweQokaUsaa3_-gS8cR760gC8TDNvFMBCELADMJ97io-hSkEbYmv8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShmvHn6hywy-qgBCRQI_m9aW9oTxeJL_VQPHH7H_0bvA&oe=6B0319FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SuturingVR", "keywords": [], "long_description": "SuturingVR is primarily designed to be a highly immersive game that uses the unique aspects of virtual reality while also taking into consideration design constraints inherently imposed by the use-case situation: a child will primarily be using this before and during routine medical procedures, limited in motion in their hospital bed. Limited FOV, simple and intuitive controls, fluid motion, calming music, and immersive environments are all crucial to keeping the child comfortable.\n\nThis application is for use as a VR Distraction-Based Therapy tool in the study \"Feasibility and Acceptability of Virtual Reality to Reduce Perceived Pain and Anxiety Among Patients within a Hospital System\"", "short_description": "VR Distraction-Based Therapy"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suturingvr.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Team Engineering", "support_website_url": null, "website_url": "https://www.ufdreamteam.org/dream-team-engineering", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "891464948193902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031561_970887483317603_6371120202163132512_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xObSi8bjVYQ7kNvwEngo1q&_nc_oc=AdqG7M
c_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftOvxASA9f1Hyfqx5JWbsZZcIEek9M0xAFJXunbXt_hpg&oe=69A03A8F"}, {"file_name": "forest.png", "id": "431548231520794", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982670_431548234854127_7928222096587893478_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSJXHkE1m3oQ7kNvwFz9a1-&_nc_oc=AdlLJIV2YGCKEqSDXOjrg7Fbw6M9XsaJy9piwzn1njOY4YocE9O_FVcqJP0HEomOo4Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuxdSzVKtAwwqd5m7p_xM0h9sZowyk6XHnib8JBPDO3OA&oe=69A02B07"}, {"file_name": "desert.png", "id": "1053831951790065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031493_1053831955123398_738398746983768786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ExThws-lqEQ7kNvwHxudgG&_nc_oc=Adkff96we8Qu_gGrk-BBnROQdOokl9HxLrU4WVusEulWjnAJovU2WCMiN1vQ3F0KMtQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfulYrJPFh_wupu0AZ1q3YagZPPOk5EeeLPCWt1Ge0S_5w&oe=69A03336"}, {"file_name": "startMenu.png", "id": "423322422225187", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031391_423322425558520_2333985987481995841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRxlsOU2JWgQ7kNvwGKDbxl&_nc_oc=AdnFTiKLQ2hXNMyLhRBP_Ul0LK6tp2hwjM0O5-GEjTQwKMPirmr3o4cQSIyuhf1J3Bs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsfNjQDvfgrZaxseWCt7W706Gy_wn1-D5mL3TdSSdhwlQ&oe=69A03E3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SuturingVR", "keywords": [], "long_description": "SuturingVR is primarily designed to be a highly immersive game that uses the unique aspects of virtual reality while also taking into consideration design constraints inherently imposed by the use-case situation: a child will primarily be using this before and during routine medical procedures, limited in motion in their hospital bed. Limited FOV, simple and intuitive controls, fluid motion, calming music, and immersive environments are all crucial to keeping the child comfortable.\n\nThis application is for use as a VR Distraction-Based Therapy tool in the study \"Feasibility and Acceptability of Virtual Reality to Reduce Perceived Pain and Anxiety Among Patients within a Hospital System\"", "short_description": "VR Distraction-Based Therapy"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suturingvr.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Team Engineering", "support_website_url": null, "website_url": "https://www.ufdreamteam.org/dream-team-engineering", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "891464948193902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031561_970887483317603_6371120202163132512_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCeJnrCaJDoQ7kNvwG8B1lY&_nc_oc=AdngXsxuktdDALDbttse43oFARpioeynR0rLV7CXEtemtMn9sXFPrN_p8b_52j-Zh2g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvJ50nY5-ixK5bsiY5DjksY93hhT-BwkWw-myNutmH6aA&oe=69A03AE4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SuturingVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1615486797, "lastRevision":
"}, {"file_name": "beach.png", "id": "1829455203887236", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974469_1829455207220569_178758151851518834_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PKk94G3Y9MQ7kNvwFUawDi&_nc_oc=Ado-DkWCKVFJ8-p7Qod3nT_WRxpVtNxBnLr0_5am13V-B_Z25cXF1H36COuxHbCffrE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcdT-T7j5QVxG-ASt9cLECW5S4ONazOaqXfopz8lqCiw&oe=6B0B378F"}, {"file_name": "forest.png", "id": "431548231520794", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982670_431548234854127_7928222096587893478_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pYJ4C82x8UQ7kNvwFRT_GC&_nc_oc=AdrhXj6e6bZY0hFCiDP0lPB2AFudHXfml8_DSPXrT1VWvzjGNYPiFsEZ9quwb_ge7SE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7ot-GgLQRvXXUOi-DK5FJgDkRLUbUNifB5MC4Y9Adug&oe=6B0B2807"}, {"file_name": "desert.png", "id": "1053831951790065", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031493_1053831955123398_738398746983768786_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlJ5ylWSMfkQ7kNvwF0xylz&_nc_oc=Adr9VMoBRzQorV98FM2iUNb2sPHX6799RdJywFjB1vd-QDe3--8qARaxlgAuuiOW3Dw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJfUL0OWVGS8Z-NbA9D2mu0lU6kurWuTL0w9oQgo41Yw&oe=6B0B3036"}, {"file_name": "startMenu.png", "id": "423322422225187", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031391_423322425558520_2333985987481995841_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJrvk0v9UZsQ7kNvwH2FoY1&_nc_oc=AdpxyBt5ICt76kqWYIj0engyO2fWLc_VLP9xSm5h_gykykMUj8GVu_PlNx38vEULCro&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEpOeNpp92jdVmM_Qve89k9jMx2k53_L95YNIP5EsqnA&oe=6B0B3B3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SuturingVR", "keywords": [], "long_description": "SuturingVR is primarily designed to be a highly immersive game that uses the unique aspects of virtual reality while also taking into consideration design constraints inherently imposed by the use-case situation: a child will primarily be using this before and during routine medical procedures, limited in motion in their hospital bed. Limited FOV, simple and intuitive controls, fluid motion, calming music, and immersive environments are all crucial to keeping the child comfortable.\n\nThis application is for use as a VR Distraction-Based Therapy tool in the study \"Feasibility and Acceptability of Virtual Reality to Reduce Perceived Pain and Anxiety Among Patients within a Hospital System\"", "short_description": "VR Distraction-Based Therapy"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suturingvr.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Team Engineering", "support_website_url": null, "website_url": "https://www.ufdreamteam.org/dream-team-engineering", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "891464948193902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031561_970887483317603_6371120202163132512_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rh3iPcMdN00Q7kNvwHZ3ZGo&_nc_oc=Adpmp2
c_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu82vBvhfpflCFltFnrWunYbTUiLtN2EoWCNdcK5MsFyg&oe=69A5808F"}, {"file_name": "forest.png", "id": "431548231520794", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982670_431548234854127_7928222096587893478_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eum8JLCAn1oQ7kNvwGJO7G6&_nc_oc=Adlmhjbjr-kLHwBTgdpy9d2Cq3JFlIJ5t1X5Ibeaond_ehTH2Q7Yh0QqJ3z8GP2NYHo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvlSXfamPo2XOUl7NCx6c6qQRUcTqQjASm10Wr_nd9hXw&oe=69A57107"}, {"file_name": "desert.png", "id": "1053831951790065", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031493_1053831955123398_738398746983768786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DietUkioLysQ7kNvwEKtSQy&_nc_oc=AdnvOHsz4Yohn_B0h-aU7fUFzXidaNbR5svtGtUgp88dcfC05LPxdOiKDbsmnL9jYk8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftMps6QCD0hmlG0CpLQuGyb-9_uXyiNHhCK3RjVNnO3KQ&oe=69A57936"}, {"file_name": "startMenu.png", "id": "423322422225187", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031391_423322425558520_2333985987481995841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmYV3yaiWRMQ7kNvwF8lv8Q&_nc_oc=Adnjh7rp33mNSxvGJQeOOSu5Cgdmml-gqB4zYzE1PDpBq8dw2xXcNt--gzIrGJDfNOI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft5XjkjJhT7TIg3oByHcXVZswH7O8jFzEDWhhhm-SSU9g&oe=69A5843E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SuturingVR", "keywords": [], "long_description": "SuturingVR is primarily designed to be a highly immersive game that uses the unique aspects of virtual reality while also taking into consideration design constraints inherently imposed by the use-case situation: a child will primarily be using this before and during routine medical procedures, limited in motion in their hospital bed. Limited FOV, simple and intuitive controls, fluid motion, calming music, and immersive environments are all crucial to keeping the child comfortable.\n\nThis application is for use as a VR Distraction-Based Therapy tool in the study \"Feasibility and Acceptability of Virtual Reality to Reduce Perceived Pain and Anxiety Among Patients within a Hospital System\"", "short_description": "VR Distraction-Based Therapy"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suturingvr.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Team Engineering", "support_website_url": null, "website_url": "https://www.ufdreamteam.org/dream-team-engineering", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "891464948193902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031561_970887483317603_6371120202163132512_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ofliW-flwMQ7kNvwF1wbwV&_nc_oc=AdlqjYv4pcXnhZ9YT40X987ke0GQtuEVrR9IiS_KSzJYiMNeQn7hjeDiQEGiZDxlFQY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afuk8j7vM5w9Xs1vBFgGAtxQP0uLllrk3vIQBkCf--6UAA&oe=69A580E4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SuturingVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1615486797, "lastRevision":
tent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031493_1053831955123398_738398746983768786_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ur7dBov-ONgQ7kNvwEUrpzy&_nc_oc=Ado5DrfJwHQXo1u7eqPfgHtvIBAG1jk0MbQpLSJW8hUf0PUdgD79cP49yM4i7eqF0Dk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo6bQLcA-HdZp4OYbiFP13Swc1Q66xwZTveAIyPnHWQA&oe=6B0854F6"}, {"file_name": "startMenu.png", "id": "423322422225187", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031391_423322425558520_2333985987481995841_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4K9MN0VNDAQ7kNvwHKdQY7&_nc_oc=AdodrC4BI0t04RS93Cn4xprUqhpFgLyWetIcbpSwmS8sgmmzBgUoEPNs-ZQB5yUss8k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3ift6CgsqmMMWm0FQa7430xFrWJZ0nHODpg-hUW--6A&oe=6B085FFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SuturingVR", "keywords": [], "long_description": "SuturingVR is primarily designed to be a highly immersive game that uses the unique aspects of virtual reality while also taking into consideration design constraints inherently imposed by the use-case situation: a child will primarily be using this before and during routine medical procedures, limited in motion in their hospital bed. Limited FOV, simple and intuitive controls, fluid motion, calming music, and immersive environments are all crucial to keeping the child comfortable.\n\nThis application is for use as a VR Distraction-Based Therapy tool in the study \"Feasibility and Acceptability of Virtual Reality to Reduce Perceived Pain and Anxiety Among Patients within a Hospital System\"", "short_description": "VR Distraction-Based Therapy"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drew-gill.github.io/DTU_Suturing_Distraction_VR/", "developer_terms_of_service_url": null, "publisher_name": "Dream Team Engineering", "support_website_url": null, "website_url": "https://www.ufdreamteam.o
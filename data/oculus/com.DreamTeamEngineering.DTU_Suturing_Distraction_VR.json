tent-sea5-1.oculuscdn.com/v/t64.5771-25/39031493_1053831955123398_738398746983768786_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oURgEhsxq60Q7kNvwF0UQBd&_nc_oc=AdrXG925lxnmFo5ntkztw2PTcdcmb4PchTGxevIQaPYSGNv9yzgtW-oWeaZVAGEWsl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaBTByagRPsYSm8OrbQC5sCEVT6cRw8TU9R_FHMX0lhQ&oe=6AFF1A76"}, {"file_name": "startMenu.png", "id": "423322422225187", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031391_423322425558520_2333985987481995841_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgda6ASV1NEQ7kNvwEnEx1Z&_nc_oc=AdrahooM6AC0oVA9H-vdczkAzFDQkjctCzwy_mYfwByP8JEZqryK5sZ9v6xTJr1KQJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCkxQczIF85qKuPkcLjcPwsEZPsXl3MNBnLC08bWCjJA&oe=6AFF257E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SuturingVR", "keywords": [], "long_description": "SuturingVR is primarily designed to be a highly immersive game that uses the unique aspects of virtual reality while also taking into consideration design constraints inherently imposed by the use-case situation: a child will primarily be using this before and during routine medical procedures, limited in motion in their hospital bed. Limited FOV, simple and intuitive controls, fluid motion, calming music, and immersive environments are all crucial to keeping the child comfortable.\n\nThis application is for use as a VR Distraction-Based Therapy tool in the study \"Feasibility and Acceptability of Virtual Reality to Reduce Perceived Pain and Anxiety Among Patients within a Hospital System\"", "short_description": "VR Distraction-Based Therapy"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drew-gill.github.io/DTU_Suturing_Distraction_VR/", "developer_terms_of_service_url": null, "publisher_name": "Dream Team Engineering", "support_website_url": null, "website_url": "https://www.ufdreamteam.o
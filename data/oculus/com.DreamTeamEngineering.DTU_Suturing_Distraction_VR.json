c_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1s8psJxxqLVP0fmxK7Lrv3ZnbR-jF_uhma3TrvXbfmjQ&oe=69F0A60F"}, {"file_name": "forest.png", "id": "431548231520794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982670_431548234854127_7928222096587893478_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1Qs5YnMhZ4Q7kNvwHl9lCj&_nc_oc=Adr7jO1Pzk50PJLccFunBMpaxPEl_mY-qjk5ZMV1pbLCLxdlUCDloxlVnxQLpR9nnsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af37HJN-ZCZWWHN3DGC7WpZYjNgXhvI-DIK0asTSDnNEBw&oe=69F0CEC7"}, {"file_name": "desert.png", "id": "1053831951790065", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031493_1053831955123398_738398746983768786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkFFNaHMbYkQ7kNvwFrtdcI&_nc_oc=Adog9XBfzgpoAPCV_s3I0kvJci-VEA2VKhXlOgdCJcksDm8URftYdVwoyrzUJTFuBio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af11kqATfqE6TRO_1yHm2GvcO4dzs8r3IPnNxgWNPP9Upg&oe=69F09EB6"}, {"file_name": "startMenu.png", "id": "423322422225187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031391_423322425558520_2333985987481995841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iuyS98OutQQ7kNvwFbmvCK&_nc_oc=AdrHfVLwTUf_N0SzjZnIT1r_O8xlCB8r6okkM5Fp6oNgpa78o95w3vvIdxwi7LMAEeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af29vkaty3oPQwA39sX9EB02jOWsZnNYE7TLrJa2ifW1mw&oe=69F0A9BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SuturingVR", "keywords": [], "long_description": "SuturingVR is primarily designed to be a highly immersive game that uses the unique aspects of virtual reality while also taking into consideration design constraints inherently imposed by the use-case situation: a child will primarily be using this before and during routine medical procedures, limited in motion in their hospital bed. Limited FOV, simple and intuitive controls, fluid motion, calming music, and immersive environments are all crucial to keeping the child comfortable.\n\nThis application is for use as a VR Distraction-Based Therapy tool in the study \"Feasibility and Acceptability of Virtual Reality to Reduce Perceived Pain and Anxiety Among Patients within a Hospital System\"", "short_description": "VR Distraction-Based Therapy"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suturingvr.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Team Engineering", "support_website_url": null, "website_url": "https://www.ufdreamteam.org/dream-team-engineering", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "891464948193902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031561_970887483317603_6371120202163132512_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haqTXDQPEn0Q7kNvwFKJmxI&_nc_oc=Adr2IYeyjWj0yd8gS1nO5Yotn3SKwUo4x7m2PAuvBhjJHAKY845nsUOcgThykE61h9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3Sm2p0oEnDaxUkHeugYQJwChhCSZYYGl0HpGSCqWan3w&oe=69F0A664"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SuturingVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1615486797, "lastRevision":
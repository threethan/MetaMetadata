c_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftFuyQe1tQflQitswKajFMVOHE7AQQSwpFwGrA-PnZtrQ&oe=699EE90F"}, {"file_name": "forest.png", "id": "431548231520794", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982670_431548234854127_7928222096587893478_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJDCw7UWkfwQ7kNvwEemgVP&_nc_oc=Adm20uDSuj4I1ZljBpJr3NRwP6M5Jd-RA4pPVNHjHlWZqCDGl-15UV334MTTEnmX_FQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuIKEyfpXgxgFxc1d7Yso6PXnF81vPxHFnI4MRCzK-PhQ&oe=699ED987"}, {"file_name": "desert.png", "id": "1053831951790065", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031493_1053831955123398_738398746983768786_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ExThws-lqEQ7kNvwEgbIml&_nc_oc=AdlxvD8WhXpJxwmx8488siqymjxtQj3UhKBxM10aakSXaXD9QwiEOM2P0tASMVmLj3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvUoopxOpOd5VPja0azjUPT4Xvk4UK-hzqOblkp_7IzFg&oe=699EE1B6"}, {"file_name": "startMenu.png", "id": "423322422225187", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031391_423322425558520_2333985987481995841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRxlsOU2JWgQ7kNvwFOiNKQ&_nc_oc=AdkBLnP7iZIv1h826NhGkG5OPzJwuxEmpqWOpWdO99BLlA_kvn05bmza60T9x2gGfKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftJCG-aNlVNIE-Zmn9PsScpvrqpuqE89bI0kfBM9jqaIA&oe=699EECBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SuturingVR", "keywords": [], "long_description": "SuturingVR is primarily designed to be a highly immersive game that uses the unique aspects of virtual reality while also taking into consideration design constraints inherently imposed by the use-case situation: a child will primarily be using this before and during routine medical procedures, limited in motion in their hospital bed. Limited FOV, simple and intuitive controls, fluid motion, calming music, and immersive environments are all crucial to keeping the child comfortable.\n\nThis application is for use as a VR Distraction-Based Therapy tool in the study \"Feasibility and Acceptability of Virtual Reality to Reduce Perceived Pain and Anxiety Among Patients within a Hospital System\"", "short_description": "VR Distraction-Based Therapy"}]}, "developer_name": null, "developer_privacy_policy_url": "https://suturingvr.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Team Engineering", "support_website_url": null, "website_url": "https://www.ufdreamteam.org/dream-team-engineering", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "RELAXATION_MEDITATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "891464948193902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031561_970887483317603_6371120202163132512_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCeJnrCaJDoQ7kNvwHWu35w&_nc_oc=Admhe_nty8Z4cd49K4SJwW9mkAPkOCMOqcfANVIoiEMiyzVugaRuD5_CrPSM2gkDM2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfswTMNvmy5zUO2yn2SqtMe69Zr4N-ZjN8Zg0Y0jDbbnnA&oe=699EE964"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SuturingVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1615486797, "lastRevision":
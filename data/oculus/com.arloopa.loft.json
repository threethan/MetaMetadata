=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaNjEW_1gCAQ7kNvwGSbi5G&_nc_oc=AdnhDtOueLmNKJYe69-vFRidnjsXebDpFG-QUtwpTo5XooYIa4ebgM_Qk5xssW0uqjo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvRNQ0R8FZi2gmR0X_cL6VhYH19xI9CkCvjSuxPy-EbOA&oe=69A02922"}, {"file_name": "migrated_image.png", "id": "1087965194936168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386392_142442282852733_407964807_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CJDwIo9zxYQ7kNvwEydBmg&_nc_oc=AdlfDzk7aEsWNqZvAU2uphP1RM1QOq9f9NxWhqv8oQRaRYLpclldi-9IYtQhlNv_TpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv_AV1SxSnjBjK1GpQGzZp81LDwXMYYnhPQU4szNh7mzg&oe=69A036AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Loft", "keywords": ["Loft", "Console", "News", "Music", "Voice"], "long_description": "Feel yourself at home with your personal VR Loft. It's your cozy corner, with a futuristic menu/console. Menu/console can be controlled via either simple clicks or various voice commands. Simply tap the microphone icon and speak out one of the available commands (the options are yet limited, more will be added soon). Your can listen to shuffled music from your music library and browse the news, by reading the content provided by one of the leading news providers in VR industry, UploadVR.\nGive us your support to add more functions and news websites.\n\nPlease suggest what you would love to have in your own VR Loft.", "short_description": "Feel yourself at home with your personal VR Loft."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.arloopa.com/", "developer_terms_of_service_url": "http://www.arloopa.com/", "publisher_name": "ARLOOPA Inc.", "support_website_url": null, "website_url": "http://www.arloopa.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC", "UTILITY"], "has_in_app
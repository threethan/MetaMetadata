istic menu/console. Menu/console can be controlled via either simple clicks or various voice commands. Simply tap the microphone icon and speak out one of the available commands (the options are yet limited, more will be added soon). Your can listen to shuffled music from your music library and browse the news, by reading the content provided by one of the leading news providers in VR industry, UploadVR.\nGive us your support to add more functions and news websites.\n\nPlease suggest what you would love to have in your own VR Loft.", "short_description": "Feel yourself at home with your personal VR Loft."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.arloopa.com/", "developer_terms_of_service_url": "http://www.arloopa.com/", "publisher_name": "ARLOOPA Inc.", "support_website_url": null, "website_url": "http://www.arloopa.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1819718034883883"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "100501887308478"}]}, "baseline_offer": {"id": "100501887308478"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1501088400, "status": "PUBLISHED", "id": "100501887308478"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1031404393653147", "version": "1.4.1"}, "id": "294389544227089", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"n
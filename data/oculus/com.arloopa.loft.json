ntent-iad3-1.oculuscdn.com/v/t64.5771-25/12138798_154810934942185_1088107912_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fYmkTrvK-YQ7kNvwHDHa2y&_nc_oc=Adl2p4TI_2-VDXO-D3sGSgFgtwGeLVIeb_tcJH_RjBcBSq0jtEqsImkVeW6Wi5BkrYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAuTEH1CebS-3mURh_sGHrsViS0ACSsKGGzPpAcEzeZQ&oe=69BFCD22"}, {"file_name": "migrated_image.png", "id": "1087965194936168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386392_142442282852733_407964807_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2GaUC-gkSEQ7kNvwE-zXfg&_nc_oc=AdkWub_0oL81HeOInHiaMPeoIK5LbhC5JwL2mLMZH3fXWjlbRuG-dW6vmZWNwdJuRfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfybcWVyYhW0Se0HEC8_rAXPQxOPPGhc1FeT3cFR1HuKtw&oe=69BFDAAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Loft", "keywords": ["Loft", "Console", "News", "Music", "Voice"], "long_description": "Feel yourself at home with your personal VR Loft. It's your cozy corner, with a futuristic menu/console. Menu/console can be controlled via either simple clicks or various voice commands. Simply tap the microphone icon and speak out one of the available commands (the options are yet limited, more will be added soon). Your can listen to shuffled music from your music library and browse the news, by reading the content provided by one of the leading news providers in VR industry, UploadVR.\nGive us your support to add more functions and news websites.\n\nPlease suggest what you would love to have in your own VR Loft.", "short_description": "Feel yourself at home with your personal VR Loft."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.arloopa.com/", "developer_terms_of_service_url": "http://www.arloopa.com/", "publisher_name": "ARLOOPA Inc.", "support_website_url": null, "website_url": "http://www.arloopa.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "co
=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuSXSRyD4bYQ7kNvwFZxWNz&_nc_oc=Admu68-79y26FEJ9PX5sxIhRrlmwDfpDmI7bpst0Cq51BCqsDDG9TXYoa8deZUL52wU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvgFeWNpyfkngRgCgkms3JRtakEQf2rUnLe1On6nYV-Hg&oe=69A6C0A2"}, {"file_name": "migrated_image.png", "id": "1087965194936168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386392_142442282852733_407964807_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9a9igWmfvYQ7kNvwGbHXOH&_nc_oc=AdkALLuYgzZcLpXYJzApvI6Yita4dyk8BJiVCuRBriviKgFIovpjMZ7ZW36YoyuODkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftJe-pgDLdPGhvcsxCca2lyRE9uu7bOtIBlibsL30l7Bg&oe=69A6CE2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Loft", "keywords": ["Loft", "Console", "News", "Music", "Voice"], "long_description": "Feel yourself at home with your personal VR Loft. It's your cozy corner, with a futuristic menu/console. Menu/console can be controlled via either simple clicks or various voice commands. Simply tap the microphone icon and speak out one of the available commands (the options are yet limited, more will be added soon). Your can listen to shuffled music from your music library and browse the news, by reading the content provided by one of the leading news providers in VR industry, UploadVR.\nGive us your support to add more functions and news websites.\n\nPlease suggest what you would love to have in your own VR Loft.", "short_description": "Feel yourself at home with your personal VR Loft."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.arloopa.com/", "developer_terms_of_service_url": "http://www.arloopa.com/", "publisher_name": "ARLOOPA Inc.", "support_website_url": null, "website_url": "http://www.arloopa.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "MUSIC", "UTILITY"], "has_in_app
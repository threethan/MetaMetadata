241936880178767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139007_2195604380662587_2179980972584337408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCxkkUPYqhwQ7kNvwEfVCdP&_nc_oc=Adpz5zKBM2HFfKa2-T3cu3qz9NU2oME7dWX5R97Do_pquYkLfjbKMcN8ULJMSLY_w10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3Bln5Xqv9sel1kht3w8UQLl3e96Ek07YXmAEAw29wJA&oe=6A64CBF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AJC-Trailer-Cover.png", "id": "165605770814618", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602063_165605774147951_6124442185195585536_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLNqzCshNdYQ7kNvwHxBDKx&_nc_oc=Adp2JaGr_NqobQIluXTnhVyAXY3tKcOfXmZVySfdORYiymeg-AHARqww63k1zpK5G38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4SdELRSN8e9_qqxex18FQsvSeav706RqgGHhByR8A1A&oe=6A64AABC"}, "display_name": "Contrast VR", "keywords": ["contrast"], "long_description": "Contrast VR \u2013 Al Jazeera\u2019s immersive studio \u2013 pushes the boundaries of storytelling while\ntaking viewers directly to the front lines of the biggest news events around the world.\nExperience Al Jazeera\u2019s bold and fearless journalism with thematic, in-depth experiences: VR\nand 360 documentaries, linear videos and photo galleries covering pressing global issues from\nthe Rohingya refugee crisis to environmental devastation in Nigeria.\nImmerse yourself deeper in the story. Be transported to regions that are underreported. Hear\nfrom voices on the ground as they share their own perspectives directly in VR.\nLearn more about the studio at contrastvr.com. Send questions or feedback to\ncontrast@aljazeera.net.", "short_description": "Contrast VR \u2013 Al Jazeera\u2019s immersive studio \u2013 pushes the boundaries of storytelling while\ntaking viewers directly to the front lines of the biggest news events around the world.\nImmerse yourself deeper in the story. Be transported to regions that are underreported. Hear\nfrom voices on the ground as they share their own perspectives directly in VR.\nLearn more about the studio at contrastvr.com. Send questions or feedback to\ncontrast@aljazeera.net."}]}, "developer_name": "Shaking Earth Digital, LLC", "developer_privacy_policy_url": "http://apps.aljazeera.net/privacy/", "developer_terms_of_service_url": "http://apps.aljazeera.net/privacy/", "publisher_name": "Al Jazeera Media Network", "support_website_url": null, "website_url": "http://www.contrastvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "480770880283488"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2826094997405427", "version": "1.7.52"}, "id": "945753458896208", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1912168575464745", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2826094997405427"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "945753458896208"}]}, "change_log": null, "created_date": 1565639082, "id": 
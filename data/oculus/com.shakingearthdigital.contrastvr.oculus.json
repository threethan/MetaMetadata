n.com&oh=00_Af2iOUsR-yD5QknV3JsDFp6xXedooByWNuzTVSoCnQMtYg&oe=69F0C7F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AJC-Trailer-Cover.png", "id": "165605770814618", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602063_165605774147951_6124442185195585536_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7_YYGS8zNoQ7kNvwFsT9Or&_nc_oc=Adrify20uxPQODkl5Dg-vqLsGUlEqg6CGMDGwHkOHLdDwY1kZEyw25Ov9Lw6mw6K0Hs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1qWvD39REQFNOgjrpRNolFSX4qF5E_nl0llx0-Xj6G7Q&oe=69F0A6BC"}, "display_name": "Contrast VR", "keywords": ["contrast"], "long_description": "Contrast VR \u2013 Al Jazeera\u2019s immersive studio \u2013 pushes the boundaries of storytelling while\ntaking viewers directly to the front lines of the biggest news events around the world.\nExperience Al Jazeera\u2019s bold and fearless journalism with thematic, in-depth experiences: VR\nand 360 documentaries, linear videos and photo galleries covering pressing global issues from\nthe Rohingya refugee crisis to environmental devastation in Nigeria.\nImmerse yourself deeper in the story. Be transported to regions that are underreported. Hear\nfrom voices on the ground as they share their own perspectives directly in VR.\nLearn more about the studio at contrastvr.com. Send questions or feedback to\ncontrast@aljazeera.net.", "short_description": "Contrast VR \u2013 Al Jazeera\u2019s immersive studio \u2013 pushes the boundaries of storytelling while\ntaking viewers directly to the front lines of the biggest news events around the world.\nImmerse yourself deeper in the story. Be transported to regions that are underreported. Hear\nfrom voices on the ground as they share their own perspectives directly in VR.\nLearn more about the studio at contrastvr.com. Send questions or feedback to\ncontrast@aljazeera.net."}]}, "developer_name": "Shaking Earth Digital, LLC", "developer_privacy_policy_url": "http://apps.aljazeera.net/privacy/", "developer_te
n.com&oh=00_AftBzJvf2W9jAlLoHZA8PsVvyKWPimOV9Ch002-nUS3MHQ&oe=699ED2B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AJC-Trailer-Cover.png", "id": "165605770814618", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602063_165605774147951_6124442185195585536_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_VooQjVmz4Q7kNvwGV1lZ9&_nc_oc=Adk7hdJvjm5OyP48SaUoohVnOcsCKTRkXgtzgtq8xBoMoVwHkb6KsunXRjuVv5-Z85M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afud3uMGwclyGrdZ2Zj1FdNfBLBsXbsWwP4qWEMiMxp83w&oe=699EE9BC"}, "display_name": "Contrast VR", "keywords": ["contrast"], "long_description": "Contrast VR \u2013 Al Jazeera\u2019s immersive studio \u2013 pushes the boundaries of storytelling while\ntaking viewers directly to the front lines of the biggest news events around the world.\nExperience Al Jazeera\u2019s bold and fearless journalism with thematic, in-depth experiences: VR\nand 360 documentaries, linear videos and photo galleries covering pressing global issues from\nthe Rohingya refugee crisis to environmental devastation in Nigeria.\nImmerse yourself deeper in the story. Be transported to regions that are underreported. Hear\nfrom voices on the ground as they share their own perspectives directly in VR.\nLearn more about the studio at contrastvr.com. Send questions or feedback to\ncontrast@aljazeera.net.", "short_description": "Contrast VR \u2013 Al Jazeera\u2019s immersive studio \u2013 pushes the boundaries of storytelling while\ntaking viewers directly to the front lines of the biggest news events around the world.\nImmerse yourself deeper in the story. Be transported to regions that are underreported. Hear\nfrom voices on the ground as they share their own perspectives directly in VR.\nLearn more about the studio at contrastvr.com. Send questions or feedback to\ncontrast@aljazeera.net."}]}, "developer_name": "Shaking Earth Digital, LLC", "developer_privacy_policy_url": "http://apps.aljazeera.net/privacy/", "developer_te
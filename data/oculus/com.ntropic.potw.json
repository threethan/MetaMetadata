scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB3D4qQZ2FEQ7kNvwG_cv-C&_nc_oc=AdpaZSOMukjsGqvNqWjA1PhRuA_kqC5-3qc6fojjr1nKz6izh7B_2Wd8NiHWvIlgfvE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af24HpMI1ZNeKNhUuvcGG7evyAkpfC7TFv-TG0sMbfQyyg&oe=69F36FF2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHs-ZL9zkBwQ7kNvwHVoREa&_nc_oc=AdpEQmU-4Fah53M143HSXZIJ4oxPAOUZ5LiVyqbOemnpfQ6SuGLu4Ewryj9zWZoLYzA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1P_co40pbT6NCwbsvtZriXNv7dzjTC2J-NSaHGy_K_7Q&oe=69F34F6A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-33ZPZckRDsQ7kNvwG-6-op&_nc_oc=Adp1LX2d6AgkS7IVK6TnxwMenl1hhFDyQ1rZ6Pw6JfYACxnn8WgjvHceKjWoC3ocywY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Psndtn0Gchu_N6Luzg42j6bd8IR3Z0e9fHrtG_qmv0Q&oe=69F36D26"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2D6HRhZb8EQ7kNvwGIEYnA&_nc_oc=AdrwMLH9urzgCaB4SD8STtZQxZp2EBu1Q8870v5Msk9tj8HiM_E8XUqAff64x9BcTZs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wL-i6xotn340Xiw7ib-LQ_UZlW_6cnPWEF2G7CMfaSA&oe=69F35DA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K12EQ5KEKQQ7kNvwHWTOlE&_nc_oc=AdrO6C0yXcBDL9-UhX1QhbCFtG3uEVpLwmnpBb5sqxA8f0I0Bd9szaVEl951KRoDrBs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3f6JCIPEAY_6OZfSpnA8rnRHqFV
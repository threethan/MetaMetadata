2.oculuscdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77Ga5liH6dUQ7kNvwGdqfxS&_nc_oc=AdqIXNuSKF4hAadHbSJxEi-7J6EdBONtpizsTucj9EDOAEKgi9sQ6lbBPnzovFh2DTY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z4gONAHA7cSbOi8NXgVlzCUYBAfEOGDrJmoHIWnbf8w&oe=6A467E72"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozpn2HQrc8AQ7kNvwF8l3Le&_nc_oc=AdoWGZcIyprbOSABNLYlCMeN-iNNNu_l2rhRHpXaF9LwA-a4biWL0c_o17GRWlpiin0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f98cet_ppkPwUKqDkuhQUO74q3RECVZfbFHyxuJn7eQ&oe=6A465DEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DENZ7fvlCLsQ7kNvwH3nbfX&_nc_oc=Ado9HLmHS45Mj70qFtk3qXQhJBVA_GK69-nKdVkhmKu6PN3qjge4yT6ZlQhtJq9Jsrk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HdmRQ9_METxbpgIcjkL8rU3Mro6NR8HsHhEC8PkQRdQ&oe=6A467BA6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwHucGCXOyIQ7kNvwGor7Ap&_nc_oc=AdoK7bpbC7VYn7fQFR85OVjdn3JquofNzx9yuZZ3s70-rt0M31RaMdB8OMOCJyNBnKM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yEqX1IVijAflaeP0NE-FSObEkHFgoI4L3vXh8ccTYnQ&oe=6A466C23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi0j2BMvxwsQ7kNvwGu2Qwz&_nc_oc=AdqTcBv8qfv-qq0j6RMogSZcW6wjHwZUS8GAdF5q5ieq1b1UhFC7zY3AFp4d4NEw6aM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oIVdp50K9NoxYE
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7ShvJq26MsQ7kNvwEszsh-&_nc_oc=AdrdHCaWV3Gf73G3uyqxjCLgAZd7SyyOu5z2Hkmp7oIplMR-ZHCVrK8RQ_L__q_nIAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Kato4vws-hRBGzBEOxKfRLRp7I4CKtmRVH8B2xnLBLw&oe=6A1D9FF2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksTeTAaTf3EQ7kNvwEyqmZ7&_nc_oc=AdoX0DaaZ2oxrE-tXEDRRH2pIPVRObZbFMu2LvcY3vSFt5GxbfYIJNu82ql4T5KCBjI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fgz_S9x2yxV3V39wyNy7dHLUUmfJKC4OX9wNoAHiTig&oe=6A1D7F6A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLknq2Ea3EcQ7kNvwEbPeJL&_nc_oc=AdoVSDsHVVe3EESgO1J-JqDqKSMJexwDe3XUEXmGDbQ5Le1tgP_RuBy-4a0BodJegnw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q31C0GULitxHKSnTGB1rn03h4Y6PYMS_thiMZMeIU0g&oe=6A1D9D26"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMvpM79uFBsQ7kNvwHGesxK&_nc_oc=AdqcWkqwAoKxvo-Fyd6IAMuRRpBaZFhxzu-VaNOSg_tshGsLuFUMdcehseczXIXjUI0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47fXKISi9ZfAqJhMEbOOXUMkdSaSal3UQEaHQ2dMAQeg&oe=6A1D8DA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0oqurZpWr8Q7kNvwGGrk1M&_nc_oc=Adpp4AxFrvCmeWa8QTFMmUcSioynNSInC0PEtHyznZVl74cCKL6I6KBtJD3HG9EpyLo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75dcckpdPtKGIr_61wTdRXuuFIs
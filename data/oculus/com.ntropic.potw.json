scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fohBUoSzyS4Q7kNvwGkiiOG&_nc_oc=AdoxmMWf6CwBKw7Fz3GZ932k7A66Gf2fcTeiKXxfjajkT2_qOwA0uaqlpOl3HTu4azQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWbnRUF-pIJRIEV5E1m7W_rsBXCVe6UQBG4yaTH3tRAg&oe=6AAAB072"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPONCJSnobQQ7kNvwHyJukh&_nc_oc=AdrBjCvOCBe8LihkyYywtN7VvReocxGHk6PdgdsEHB2n5grLeXUtTCrBidHGdxLtf1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXFesigPNRluu8QTe0nmlA5sEy-pSOYzxJC9W4wNMiZw&oe=6AAA8FEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-S7BeEdE_QQ7kNvwETS5NK&_nc_oc=Ado96g0toI10kBQdtTuo-31OU1CB6Y-qb-XvcFdfFebvwGzvd-RYt_U1kAz64QwMEXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKchUmnwsHkSPF3hynPM9budPnrFmDKR9ihQGWJy432FA&oe=6AAAADA6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQFHM1g4J9wQ7kNvwHt5QAq&_nc_oc=Adp9R09ZrmlM55u2vjxhqggCJX2QBNst01c_NllVHFkkOvQUivRQl8_HUlCMDoYjYQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwLHA5S5hTCEDxU2ULXMRGiqtYA4xdbeX20ywGZnl8jQ&oe=6AAA9E23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6FZfgOmjw4Q7kNvwFv_sjj&_nc_oc=AdpCZEVIt8JpodLFQ5sks5CtW7gwsXZFW1-R0nAWgZj_QEpIY5mwkqC-Lhr7K2lWuLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuuhKq17jt8OIvze62CmX-LxDQO
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE5Hl0C0BA0Q7kNvwGeTue-&_nc_oc=AdrZj7BTjsXBI3_gHeom6AeN-JrIv0rkspIa5gL0mqtFVLN33GaWPVT1lc6ggTq84Pk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0p-bcePgXwSYTvlb8ayFi0aKBf_PovB86C3nRiaQqrA&oe=6A9ADE72"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUiLqFeNdJIQ7kNvwE2er4y&_nc_oc=AdqZznZ3UCttHWxA4UpOnxYrendomjYULvyMV7CO2XrLB-1rhnjdbvYhqTnmh1fXXQs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRCVdcnq46Yv-UkHvDdRvq9Nl5ltoUBUXL-vSlyqL3WQ&oe=6A9AF62A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAbpz1hHIAcQ7kNvwEekXe2&_nc_oc=Adou-liXwNHCYAR9dhZsI3PHR44UHlENJnHoCE5RKdcQZa3kzXKSwme5dR0kDHIWMMA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_NEmdlzNffTdpIg_EAQohaFjnBcbAqeWOPoZOM2QzEQ&oe=6A9ADBA6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2G5NK4xXToQ7kNvwGIFcMr&_nc_oc=AdoXKU3oi1AOscCMtR30fuqCjvOKpFDl4vNdBEQ7qicIOYz0H87wUrcXxtYzDua-8V8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmuA3xKzvB7p2w03sEp7wdasfmXgRshcbgWN5j9aF8WA&oe=6A9ACC23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39-aRC0o-3EQ7kNvwFlE7mf&_nc_oc=Adq8DO6TguvtmdGLuzxLhyMdwMYsElkJ1jkzE87RcX8BchS5Jc6EPuQpHidL-1KqEQs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3e1Dr09xW3XGX8GvxGe2EJ-35x
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueIw4IcwzK4Q7kNvwEvd_vj&_nc_oc=AdruItqSZQR8Yu2mOa5JoRVcZpZChvJqyqBAEXrUmQH2DgViH-cjA8aJTbLKZxZKNcc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUy3lGqe2ZwMj5nrfeANmiygq4BtoejTmqx7riXCLBPA&oe=6A4BC472"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtLbfXQLWMUQ7kNvwE01SpA&_nc_oc=AdrjWsZtqs90qfhLsJpHxjvVjXgfosbpgtxtk8CjnLV-Wo1jGQTEL7mZhiFL1N_kCTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnebk9mc5UfeRAL2lB-UnMpcngEKvgrIYU6zZLXyXsTQ&oe=6A4BA3EA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6oGvD34KSkQ7kNvwFAnNn9&_nc_oc=AdqFyyya2GejewGBGHfrOAyr9hEohNRbnEUnbOXJYN0VXK8K-b0jQ4OxiHo7eywvs3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3ra8MsIHJhpP_Eu9BZzKHx8mCK9Au74yqFKVEOElNFQ&oe=6A4BC1A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UagZgynU13UQ7kNvwE_CF-n&_nc_oc=AdpclSSHTl2iNuaUrbIblcbERRrygvO46u79WLrL4rZratI9Ljr6cQTvDEMonE_U8VA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADkIZY9I-1FJq6XEvzlabws1BbQlhtQJTeeK--P8RzDQ&oe=6A4BB223"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KpdYaMc9-kQ7kNvwFAbvGs&_nc_oc=AdqNHGg-pzF7UTvNoy5JRN8CftyXSbVRkiWNIkVVlmuo-W5zm4CexmDbSQeKCXIFCnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvlWNsPaYuFFbK9JjF0E8Z6akxX
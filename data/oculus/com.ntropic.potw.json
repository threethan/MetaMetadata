scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8oiSTqkDtwQ7kNvwG_NvSZ&_nc_oc=Adoh32Dtmg7e3FASHYPj-QKYxE1RvEx1d1uN4fKJWJIecfxM5IFVy-QMreBLXq7DWJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGZleBuh0PEEShenNWg1rwSleEUOxWk54IMzjUEE8ehg&oe=6A637F72"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Etb9qWOQj6IQ7kNvwERWEay&_nc_oc=AdqamsS1UsLhubc6R0QISoisz7URGW0-Up5qgNxz-ff7SjdW8syztxJZfIqF04PDjYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWzD-DNdcC_S78WmUEZcQ-qXfNVmQYA6DGdNGxOkaoag&oe=6A635EEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsmBWi9jAd0Q7kNvwEFI3bv&_nc_oc=AdpTcz-O46MgS-LBlA_XgXyQD1spFfWzEaOe9r_OpzoUbiihpNqX-7xMK6TZRr91f-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLcu3S9QovF2qIemaal0Pdb1CtM1LPRpaqHIpcm5ViVQ&oe=6A637CA6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-GZ914roC4Q7kNvwE3f2xy&_nc_oc=AdpkVaP42rWbH9oQnA5ah4JNJTEET7ecH7ulD9vvgShorAnUYe_K3rtiL30OdAg-JC0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjGH6Rg2AXE_JwLWYzQyLcoLtEeBGv4AZnPxOayEIOVQ&oe=6A636D23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsYYJLde6iEQ7kNvwF_njWQ&_nc_oc=AdqcfXgrbgJoj9DnQYzAyV12M6uLiLi3aSKUNT2mbSz83psPJUltkzp_WYxD2O_E_gI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc90uZ0xaHdaXB_tvtDBRfTXxg4
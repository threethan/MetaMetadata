scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saR3eBY2BREQ7kNvwGBjSNh&_nc_oc=AdrYK1NJRuyR8LbnmNp5r7-UEKOnV9m8B_HI_kEkvNPS9VBf5TZAu6LmjbJeJAVttkQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO0jx9b0ZLZLsyJQbnb6s1-Efwlnh-1P3PcvmCE1IENQ&oe=6A940EB2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeAGkvCdyqMQ7kNvwGBx6Gt&_nc_oc=AdqPPqM1G7rI7uk3oPRFGaXMhsEd-WXDJrTMrFPCUJ1PzjSoBmgQfv0t8QZzzmMf3zk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF602llo-IbeuwzggsxV9tJb_eW5g0aF9buj4s02hF83Q&oe=6A94266A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEtJmIexQY8Q7kNvwHRiVwf&_nc_oc=AdqcoowBGBlA6Z-bH__XlReRz-s9rXsdFQx4yKb-cpPhGY0mmgqEVo566EKctNjXWSQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO-kzG7V74estEWBSJeQYdAL2Yxd2IhW6_wBEpXqzhZg&oe=6A940BE6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8Z-f9UA5msQ7kNvwEm-gSv&_nc_oc=Adrjm0X7PWbd2GruS80OdyfigaNHEZv_OyQZcAtsM4XvaDBOXRkEJSThLHeZkj1dPe4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERoNUlzF5Ced4cdgVAK9-yNHmabSQtKrZrOGFjYtkULw&oe=6A93FC63"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcFQMq6VwPAQ7kNvwHDPYyK&_nc_oc=Ado1K4Uu5_2Eyjsq9l4dkw60wRBfQaa7aNMkBFxwSvzfmOv4-MbkPs4rM8fzKlqh9do&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGbwBOnq9hOHo3BLbdSQq_L0PRb
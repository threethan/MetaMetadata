scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiHYUcPLt5sQ7kNvwFBEkSU&_nc_oc=AdreBGKuf_2LhZnkxtZV0QsP-W9TGbYfYdKtvlofzPckIO_4qTIglill6qfKptg9sHk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwOtLXhSuGzTMTamiblvx18Oo2svP0InDCyB_-UpgcAA&oe=6A972232"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=689BQehodgoQ7kNvwFlUVzK&_nc_oc=AdrviQgFZxB87XnjVRiX1W0h3DJsJui_PnMAYhm_Fi_BcAJR7sH0ouRRkNTBakZ_S-Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnyXIF29MWh99mD5zxW3nSpLTx_nUK82SA-PXa4q8xLQ&oe=6A9739EA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLVEwggRJ40Q7kNvwHrn9RI&_nc_oc=Adqc9wvCGusTJOXf6oiAa-_0G5ybiOJHaS1b1qyyqASLK_J4VlIuAkf-W4M_F4HXOis&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMu4_BrzVxXHQniRvFuyITYCeLKNMH36zW7OFwZZOS8w&oe=6A971F66"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94Al-vHOgdkQ7kNvwGHrj_K&_nc_oc=AdqB8Y1OClt25r3zpOSbsd_lQTFb2wBpdGHH1DMK5JaLIPjs-Y6bEQsjLO7AB7_bgPU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdPu4Fguxgyjwn5G3lDAj977Z6MGzcm7BsPC3y-7h_sw&oe=6A974823"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-5CJJy4rHYQ7kNvwFOMFwL&_nc_oc=AdoxTBML7RYWnE94yqW7YK3byFGYTX-Jp8SgP6ZFSI2UNuYyPEWFCUVHdJWD7PkLW4Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUccyFj_6cvsiii4syWKHW-wwbZ
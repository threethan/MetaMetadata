scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5IELzsHSs8Q7kNvwEs2HtJ&_nc_oc=AdoYO2u6tawP2-TXuXjq2SZu4f4cuxznEywqJ5w2tl27zJd3Roy2qDr2VC-X1YXNl_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANNdw3kIOu0YyPTHFMw5XM8zA_6HHVG1_ZDSGhug-VvQ&oe=6A525BF2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wS_d7AHc8uEQ7kNvwGqdDHN&_nc_oc=AdqQC9tsXZtaF3Nz-rDFmX-_M_GBI2JMvpkoqxB3amYZ0u9dwJb_9KvlKgI2Pc6mZSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDThbNioslH9PbWpBSVcis6G5M2VccJz_74DQdYK0vYpg&oe=6A523B6A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P95pBoj7-MQQ7kNvwG3YC8m&_nc_oc=AdqnEecnDiE2a_x4Ml_1D13IceJJ9rVFx6fso1kdfWPTJEur9osXoCFV1ZsoE1d_L2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCIolk0Naip872ESXbD_MH1ylVm5OwUh9k6Epe2v4Aog&oe=6A525926"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvtco4e0PDoQ7kNvwG3lpKC&_nc_oc=Adq1-DTIqZKsa3P0iqvFOxfr1dvxc3I7UQEewTuTICcoEODxNTmQ_JD3nvWuv7oLU7s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCuJekv4cb2EoABSPW3ltj1py17sgZK7FbDLjPUURwNQ&oe=6A5249A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkBclGqe-e8Q7kNvwGIUBAZ&_nc_oc=AdreZXQd-XAV89ZMtdTcTa8qvi2-G9h2ZcjGiV7p1TjXdqMbU-8IlQXVeOxFI6lpHN8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDry4zpFjqtqAufeUPUfMWZFuvR_
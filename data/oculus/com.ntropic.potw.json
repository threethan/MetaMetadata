r6-1.oculuscdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6b53Uj5OSQQ7kNvwHqdKTz&_nc_oc=Adopb6-unyEdEKZQ3G7DRg7iIRXK6H4tkG2jaz64TfBbyTfc9ns5EiXLC9MkQs8G-ng&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFtJGsMNUSP5-RPeN0v_jw7O3W0YkjPN5DePjqpd384w&oe=6A8D7732"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxzRtXk3v6YQ7kNvwG3mwPM&_nc_oc=Ado4InLX0VBTiRGTBKQepGbUfOmzWJ56i35aswPcDy6xtCxfjEeVv9U28ZchOKdPrOo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJE0_f54vEX_d3IySnH_qbFpc0_biD2lEy2sIwPl88fA&oe=6A8D8EEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWUCJSP-9G8Q7kNvwGNq3Hx&_nc_oc=AdqGLqeY6kBBYF10X9ZvYufaz-X9fTtoSAi3DOFYY8-ScNkghBe8zpoWOtyVV9b_Pd8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx3bLoFfmC6SH7TB-4sArj8GIGuJT97x9uhh_kn4vY2w&oe=6A8D7466"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HCUTEvTqaUQ7kNvwGHzHz_&_nc_oc=AdpyCO74daj5EKY2a4NPjZ1CXgL2Ep9RATTByrHMtnUzDXexsqWKsWKZuMsFm4tJhd4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0ES0gAX7S2Ro41fq1QuKZkJoTidJ6rfZIvAINkzwzyA&oe=6A8D9D23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMcA6cbyqcIQ7kNvwFgbv29&_nc_oc=AdpcZGbRrMiun4z42T_XKfTLYVHmGO__1vFc4DItZ-1-B6HpMQfYFF5gNOjPj5fNdo8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1KIq1l4craa4
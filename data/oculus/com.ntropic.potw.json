scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-0gkNFK7rQQ7kNvwGVCf-w&_nc_oc=Adr6Q28JvcUQN1Tx64693HLOgzkeDYaPD8q99TJgZiogpbzlCacARlUyV7pGKwL7zWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClan_MvPplgqs5t0XTZSR7UCZ2GQMWUfTDgcebI48ulw&oe=6A688D32"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXkMg2EVmZwQ7kNvwFtvvbI&_nc_oc=Adpirsoi-cNPG_YnRmjGbsM35AOWoDqibyzFwXqQkopheff4giouvEpmWtXHsU0HoGE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD46oXESJF4ob1Etu1zaoYaiyJf4W36KfNAQzr_aRphvg&oe=6A68A4EA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNQi3bJr2p8Q7kNvwEFBbVd&_nc_oc=AdpQ4c60MHgN3rH4vmzEbrUU63ZumrsYTRlnunvdxIYFCnLGN9_0j3QmqVZyK453hBY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7uwZWlVWprser-eKfuO9gvlxFQXJCxOXFTkBy_PWJ5Q&oe=6A68C2A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4NsQd6cJ2oQ7kNvwFU05MG&_nc_oc=AdpCfhen0PjkpyrldZDFNOqfy0TimWp8fytZo-M8i6ezGHATYQoDyApiBMenpgu-OIc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCap5Ov1lmUoGBJkXROCVwzUnkGVJspFxzkcY8SaJw2rQ&oe=6A68B323"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7J3LfIiwKoQ7kNvwEjE3MT&_nc_oc=AdqIEMNcN5auCGG33-sS4zVCjgz1f3OAwsjhzW4Axcl3DD_Ofv0IiVci8MiRgPvw8nk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvU2NBlz4y185_hTxecGuHxk_iM
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hdYJYXjO4sQ7kNvwHhN_Ax&_nc_oc=AdreEse16wRAYWUy5PSIwVqL2L4S9sA0WhCqJQzaMAZLyERBLQIt9YEF5ITfP4PHPnY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO55c4ikMnxfEL6ZrA_tMy8AvUXaW3lKoCCkz9A4eLUjg&oe=6ACE48F2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZnloCxl8OYQ7kNvwGe4CaW&_nc_oc=AdoJR6MrsZueuSK_8fhpgOPn295qanapuraupKKJINJ504FLU9N4Cg2tU6tcMYmnAK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu-Aw2Vub5cFANHKQglk8FLsqigtqWHyNolXJjDaY6EA&oe=6ACE60AA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoyPnwil6QUQ7kNvwF3Jz4p&_nc_oc=Ado_MjQX0GFTl6cHllmBtU3ujRh6uQbRz3fnHahbYBRmoPtBPLDUNNLb8WSQluR3oP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1cQIg1niOg2Y8hbN2A4RmvZzVgo4vauP-aGCwG1xRBA&oe=6ACE4626"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mhOCc05UK8Q7kNvwHizu13&_nc_oc=AdpAOw6ICAabt1TqavTLjMbrrQj3Y53HI_QxaFYGMJXqhXA61Q7NcTfGUOUOaZtjpDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3EcheTihrZzQ7FtOb2g1I--XsZ2M8tkx93ZNmQm2sjw&oe=6ACE36A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79tYsOMFuvwQ7kNvwHRBQh4&_nc_oc=Adr0Lr9qqLjET2mpCPwZ2mmwKzSx0nHgkaoicTNLAXHyKNQW5Hgzp4oyFncE4EFTRXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxKo2T1RlZdn1oIwrs7NRSzM1_o
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7ShvJq26MsQ7kNvwE4-Wv4&_nc_oc=Adp1cRaW3R05nFx1nzm_KGYeU-v6uJ6o5V4n7yHU3MLE_b1k25NM2Ot78iLZUkhZeu4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p2fTMqSSeuS9sWLdb-oGWTYL91ytUEDktliPiWj6RhA&oe=6A1AFCF2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhWLOkEamsQQ7kNvwHk6lKY&_nc_oc=AdoTYJKXeDhge_6Vo9UZhsX47PCz0n2Lirq26S1qbwdfOqOg18As4ISgGhUrVjl7Qw4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qEluukjkBia1It_H2Lz_gbVsxiee45_Zx2KT3_qmJmQ&oe=6A1ADC6A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLknq2Ea3EcQ7kNvwEAJy2M&_nc_oc=AdqIxWpmIPwTYuOzsr5O42oE5EK1ZXovaS8UPCFqhZrhP2H_xKx7Z49aC9Ug3UvqpuU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r0m1YXu1iuI-PId3O2uXOCIF0jB7NL9jAXVMh_YoYPg&oe=6A1AFA26"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMvpM79uFBsQ7kNvwGclfVJ&_nc_oc=Adqz5PNnmKdQ5hxZwgK1uV0cbrgj-wT59K99M-1tI2cd8XKWmD-t0Ebkq84q9GBhcic&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pwYoVqO8_EWWrzuw8qg538ipID_CetjdXtcd49qGttg&oe=6A1AEAA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vktQsjoQONYQ7kNvwHrzVvA&_nc_oc=AdotxxXD58NCXjz2zqQ2egoBNUYGegzLKLmGYna3iULhrcLE_gea1wBK7177KQTCNBQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gbGw-RESvxVj7iMMGASO4p_9CJ
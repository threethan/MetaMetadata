scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-0gkNFK7rQQ7kNvwG0C9QL&_nc_oc=Adr4o3wRebC2lCdp2r5dss1V4M7vYxA0udNPIxoFsTw51V_egtzr4tj7JTQ9PT4UWak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxdy45E5YwtT_TY_E_mXhNDHwTwGmdHxuSLPk3dyGdKw&oe=6A6773F2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXkMg2EVmZwQ7kNvwHWBjAe&_nc_oc=Ado6sensrN33VdV5dywDk2KnpNXvFEs_m-6oE9tuvAZHLV7wcxPddC31K-qmxd-azDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtSXpcp1avtJfHTfJQqctZsdzBUMqZRY7NqT9Wn9n__A&oe=6A67536A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNQi3bJr2p8Q7kNvwFc7H3P&_nc_oc=AdqLmhwZjvpznfCPbyAuoZjXcvQr7wYCXKM2l1Motpt5Ii7RzNFMUQEnuEMDjvZ_AHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-8NPciqhILHURu-2kpcA8nymk6q0dDtnYKizg15FG6Q&oe=6A677126"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4NsQd6cJ2oQ7kNvwFDQqZR&_nc_oc=AdrPTk7Epr7K4PE21CBMKWFLIcIqdb3Q132J_TfScVbH2MdmPFCg23KUXLddj4xS0iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4JKnKEk3rDyV9E3wZXf5xOvL9x_7E3ZgoWPc_zvSmZw&oe=6A6761A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7J3LfIiwKoQ7kNvwFYNoKN&_nc_oc=AdrKW34xHJiOJg3sFk3x5huL9lfhbQnOg026icPPZGIuKm8szm4KYNNLaZXo6jP4Qro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDIA8vRI0Zi6rTcwb2zxPkx_NvE
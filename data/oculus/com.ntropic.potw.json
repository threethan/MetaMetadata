scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5ID0JURrQUQ7kNvwGkhO-x&_nc_oc=AdrIR_Fe5OGJrdrs0TtC0-EL1wOi6IKaxTpGT_3vFOOl4gXqBZdnBTxw-8G5eDlA9y0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFB3dOi_Z6Rpc_bfTYf7VlA5QGk3iGbQNldzGQVXGJDw&oe=6AE9F872"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFck5ThFbg0Q7kNvwHVXqfq&_nc_oc=Adq9RI9rFBR9WjcvnfVokOpFX1C5513uexztqsAwdapcpF7QY_6ri48tqAWz1cVfEn4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4rN4eQGnx0Azra-zgEMQBJfTqdUPNLyLaptdd0pVn2A&oe=6AEA102A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvxy0vKalO4Q7kNvwFvlR39&_nc_oc=AdryRxtkU2QuxrBZzss7Nt3Kz5sgWSWzs94CzeCqlQbQXm2neI0tt6xFgTRzqRuJgkI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzzXvrhVrpRVEdJ3MzAxw4CWhvpZ5D-McNs3sQcbojFQ&oe=6AE9F5A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEk4gpjLisAQ7kNvwHYFEHh&_nc_oc=AdqRs1HK5E-AOHP3yg9iYaDkgaTycNlsJv-CCvB43GwSbVZfu5Sr3FmLa04bHpj3Xuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1nFjsSuNMlJlCGe5rno7wwGIIi85J8xTPX9AYxWz-pA&oe=6AE9E623"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJi3BoVVRVAQ7kNvwFkqHUx&_nc_oc=Adq5XBBLar_yDduBMpWJwhpjy6Vyc8OEiAo1cWrjjaf4WgpCdxH7ZjhNdH4KvA00LRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXzEWb7uNgG6mSMfhIpMnUl13Vu
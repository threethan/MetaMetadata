scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6b53Uj5OSQQ7kNvwH4-EO-&_nc_oc=Adq1XjLuAlFgR0wfVnqQEco43yX7WW0xOEOIPEWTRHpyQXM45SxBqbqTrR6Ixu-q2lk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEU_bbmDzmdknOeLI1MqjVsl9nNhQ6Xnpl3DKNXZmFMA&oe=6A8AD432"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxzRtXk3v6YQ7kNvwErw1PB&_nc_oc=AdpRzeDf2T4eEvGSgVdb0qWiXxyhXUM1y0ye0wMwpi2RQ_topp-3yxGYdjhgTSmZ1fY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_4ou-yFDpzdJMEf5MWU7EJ8gHtrpp2JoK5v7GEZtYKA&oe=6A8AEBEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNSYzE_ZSgQQ7kNvwElSncd&_nc_oc=AdqS1HEZ08s-oue7zcl4VqWj66CuSZOsRPt1pWJg6V0xwPNjO2M5ONoLe5GRGIoVYLI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEQj9prWxB1EtpMSLunu4Kvlv9nQXpHd9bqdsBD7u95Q&oe=6A8AD166"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7U0LN1xpycQ7kNvwHLRs9y&_nc_oc=AdpYglb3PiPdAHUeades8cCTiL9UWSTWCJhK406DK3HzZW1tjXmn8wxGg4RXKp9mf5Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEKzS5Xanj_VBNJG-BZV1NH7K-U1nk4pWmii-1I8ZYKw&oe=6A8AC1E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziFRQfFssJIQ7kNvwGb34Yb&_nc_oc=AdqJTs17wuigN1qk6Uoa8l4i31r3GUhKO-IeaS5d6QROo1XGdiFhCnWwiPdmOazasSg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYyh1B2TK8FieO_0zScKP8crnj0
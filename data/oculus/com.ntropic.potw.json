scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJm2xf8t9zIQ7kNvwEjYBlw&_nc_oc=AdplDF1gQUqt-LzPLc6m3rqKxuJsxi9VqtfJbIur6GqsucBLi2MFNKOdLHdRy2jtHjE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMqwbX4UlfA3j7YQH3r2FQa5EzVdOaSEBPLY-Zm8fcJw&oe=6AAD5372"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPONCJSnobQQ7kNvwEHX2HK&_nc_oc=AdrAQqeQ2Di2IV2uQCexrnZN0nlqIpAyPRQuZCQDSbz6gfk2whvemQR47vAZXPJf3JQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuTIYHAkmGDdlHfKLtx2flynBRLSnuSZ28TbOFdk2UXw&oe=6AAD32EA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQF91oXrHksQ7kNvwGoK8hq&_nc_oc=AdqoBjaWHyTS7ntQFFcvOggw1tOaDzZx27qLOyILexv_oNhq0Re0Wr0BR7knIwcqhuM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrkIxyG9Pgkz5aB1EmknHWNKvm35NkHnlKxxDGkiEJAg&oe=6AAD50A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3knlp49AyKUQ7kNvwGVVmMz&_nc_oc=Adp9vdWoHqHp_IRmLaeAnPjXqh9ZRJwmznx0Jc6efaK7REmRIHTfJrOa0YSE5mTnk7I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTlCs4c-BCvpNPa4YYrT_xk3fB8P8F_Dd2kiljF61zPQ&oe=6AAD4123"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6FZfgOmjw4Q7kNvwG-X3hA&_nc_oc=AdpO0ZK0JhDC-IN9ZfWN_nXJzsiinkZ9b1VC94Hd3-HWfQfIzBYSly-ruMvg8HZNGX0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXCzCdeUko4AFfxVmBTHBcGt-vH
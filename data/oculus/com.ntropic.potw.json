scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGqz9LS7fOgQ7kNvwGwwnPX&_nc_oc=AdqBPnRin19wZXxtuo0Rf9AEMVNVb-6fpl5hjlrk18sy9ViueQAeYjqKUMNLl2rAzoo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1ZwTHZOPgPxe0K1keuxjj5AxD41Aec_NbTMCEP_YzSA&oe=69C51332"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bi60HwF2DoQ7kNvwEumsxL&_nc_oc=AdpHOg8XdlV-rgnjAdqWSkGfZ3Qu4chqNAcuLDjvxMuXukXrwxrEl1wRyXy5tuIZeJQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9tgv4dscmpHrj0dlVShnwEj-VS6b9ks296QRBSwBHLw&oe=69C52AEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N87lV4_Gof4Q7kNvwHH8pSJ&_nc_oc=Adqyjw0lbSI-1UURIwTDv5Q2Uu6sdRqQxyFNSWHlNBO_Q1BZ7WMDiBMCcSvYrP6sLTc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwl2Gapp15PFGucguhy_HcT90TtK2ImLIaqhbK2s35Pzg&oe=69C51066"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCSjqE6fLVkQ7kNvwHk7mKK&_nc_oc=Adqj07wyNB7NOpIKg5siUWD3iAD4Zfz6lpmk48_VzcPpzSppEvQoxMsajmGuQvQL7KQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyW40CiHONhjW5sKdHeWMOnlfExWR2Pkp6WjmWUiIFq6w&oe=69C53923"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3KFDrsTWE0Q7kNvwHILbor&_nc_oc=AdpeT1URrXJnULit9o4ICvNoc6oNE1lTnrLYk_Ur6JlJvN70Z58QWiT6iXc8SqZkf6Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzP9Lvsoi9EEB5zPKgBkIY39sqL1
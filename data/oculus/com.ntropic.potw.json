scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoYAjPqC7yYQ7kNvwHG9ECs&_nc_oc=AdrzRVO-uMYK1Xa8VAOXcFSJD5rWyoUk_g8Z_WDzuaamIDrzLwEbP6YkLPlJCSHETR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5dGFwOhuPGgVbNNXU0GnJVihp1sLDN1pPBcEbiYYJhg&oe=6AA56A72"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxAbmXgppR0Q7kNvwFYT9av&_nc_oc=Adph9D7WQi52drCIKhomHSdF33JiGqT1gY9Xs5tgRJASQkLeOraREJUxv8I9mUx9ZrY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBqov24k4L4F-xfpwhx7EiptpitAmwBwr5UePXcpRu9A&oe=6AA549EA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoCUtLIyCfkQ7kNvwG64F7G&_nc_oc=AdoztGIXSttC_20aQEcBhUA8XoHpDwJhZl4X8mS4a-H_T0d4onwV4wmmK9_JiAppD3E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIftfRiG3OJ0hIZGl21a71KS2znjhGgoqD8_mJLdnXZKw&oe=6AA567A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jF--gCSfjUwQ7kNvwHW759R&_nc_oc=Adpc_yzfuLi16ZyPOL9niBsLoCODCE-QiUw3jmuFbOWsZ8h-_sfs1Y0VYFoxqp6gbh4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmFJ6TAxxXdmkoaOoa0DKbF4C_uKMiY0Ntt4gWFJwO-Q&oe=6AA55823"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6s2eY8e0xosQ7kNvwGc0n5r&_nc_oc=Adp6qN0pMpOxQ-vOTjGKI3WBlWTFytxQq9EmihhGeQoVOLLcSd4l-kkWvPOZUkzQo4o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6QVwAv5aSt7OnBdRZVP_1YCBFO
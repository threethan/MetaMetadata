scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VShx0o7cuCQQ7kNvwH80_KT&_nc_oc=AdqCUvf0p0EA3ZQFUzsGephuWZxtgv6FtUL4nYWX2fc-4C_1VzI6TlfXOxaTrrTB-Do&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2A2h8_WPwyKg3HP4QvjgwAVLmcYkhlQazzWLt8uGc4yg&oe=69E0FAF2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DILxPdohFQQ7kNvwHkRN55&_nc_oc=AdoveSnUGneYlWpTf7puDCYXYKOCm6jF3NIhliNzcF1mANvaqKECom7eQnYOZDeyyO0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bib4Ix6VAUxo8K_R7LLgeLdKnRIZq3y5mGlxpgUjUmQ&oe=69E0DA6A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lefyLcOT5W0Q7kNvwH8gNev&_nc_oc=AdpsQTl6sBZx_GucN9hZAIeJmCW72hyvmniTx-zy_487qzMdcxLaA8yq8WUOyTOufqY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-_fJS6UdZkTpT5N8g_GKW-vLltVTtkOI9rv0Tshj_Mw&oe=69E0F826"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEdyPVJkaGIQ7kNvwEu2nh6&_nc_oc=Adr3tVqM7GkTCJqZ2QZw9H6QKU7BpGh04DEszhqRQyTbWakjPR1c4iJot7Kn8J7Gfko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bNWtl0QQ6g7RPnf5er0S0m6T4kFPKnYgD28g5CcciYg&oe=69E0E8A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbOvnvLgtYgQ7kNvwFlhycN&_nc_oc=AdoUb1D4dSyClDujPKUR-I04HyLl7tlKDFkn8QkFPpKuEVdJQ_l2WW6A1wieDA0Dxfo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vbf3-quJO-8ScDvLgS5oCPq1-T
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V8uUhuTXgkQ7kNvwE-ZE3Q&_nc_oc=Adr247XeE7G_r7ZjKjg0emn8yiw97UCvFumVmntoWt7DLgAOSYAGOHLS4h19SIyOE4E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AYgKgRewcUSg7Cw4Zbl6y3SEdJyB1a6dt2YVaIKHSbA&oe=6A282BF2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cZ3JbiHwbMQ7kNvwH5z3ZE&_nc_oc=AdpwUGZXMu7OJblcDYqwipeAWkdK6xZFpA-q7DAZ6ff51kdgZDW4Wfpp7Nk51kaIC-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6kfEbSkHGfdFp1wUBZxMPPNjpxskQzf45sh8QLxT4_w&oe=6A280B6A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRMXvVZ7NowQ7kNvwEFryCK&_nc_oc=Adqpim5r2ZwfJNbCWqtpeYhBkw-mfou-MH7EIcx8gPqz9048_xZ4DRGUKAI0vs88KqQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z7KLrtw9U6hscFBFGI-E_5E9M8s2VdqDQYu2NZo3Iig&oe=6A282926"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C3sxaA6J_YQ7kNvwHeWcUD&_nc_oc=AdrhauVNBoHbB76E6xPzApUuGBsiIbTKccugbKvnnCoix3YJqY4IV8HMprwUcDK83zI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XxKWG_ACOVJrGEh8hfeu5c-RcjcuZG7yp2NcuXGaXEQ&oe=6A2819A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJcicj7Fz9kQ7kNvwEYpKus&_nc_oc=Adp1CZQkAHFLM7Me24VY3VfgZ3nEwIksj7jC4ohEkGKpcvkh1A1p4cyoSWJddDNDkns&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M_nkKIKNlqKEzeYgq9Kh2mfNzB
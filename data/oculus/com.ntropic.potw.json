scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oCphRApKCAQ7kNvwEwvguC&_nc_oc=AdojV7Z9hE505QvNnubWNcX1J-VkZlvPElyZ3r7ax-1dNW4IRhCRBFrTByRMGIKIWM0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cLkVsxUFA5OSTo-VxSIkF7Ilmr4XEHKEs_W3oaIGSfA&oe=6A413872"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8ofKefnF2UQ7kNvwGTMIID&_nc_oc=Adoa_FMISBOvWHXkB6Hv_sWq43ODJi8SvaFfleQNuYpLGHYUf_BYQxK6iG5NadHAoLk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PnVTlDmr2E3XRBE_9yC_On5cMKU1hKHi6pa-ha2jK8g&oe=6A4117EA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmTrgrBupVUQ7kNvwEUPmOD&_nc_oc=AdoA0wzywo1cDB75qJSdNU8_BEmJA9GLCHpiCoMwuOQ5ijkQPl-yEMMAolJC8pqnWqM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oZAV_XX6ubdO60hfqbOEiFuN5kYdo_BKLvIY8qyP2eg&oe=6A4135A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18Fp-DoVtWEQ7kNvwE4chYc&_nc_oc=AdoRDRlgtwraixjzRk_B-fWx1xM7Fqyjj6_76Pj65NhFKHUUM3qAAMA5Bj87IUGRP2E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93_vlRZGnyLVzsdQ7MYnhVPcol5SK-RLSf6mMB6wizTA&oe=6A412623"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdaeTlq8cuQQ7kNvwFFVLL4&_nc_oc=AdooI9Yt1J-JNzLKNXsGgM8kwmxNF8_ERM3wsbOmiX8tptuIPTQMiASKiuSS3RnWNGc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Aw_sq_C3r7sA2KNn7aiTK-d_i8
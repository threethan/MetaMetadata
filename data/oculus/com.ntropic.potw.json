scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5CtRGMuhcwQ7kNvwE5cCzF&_nc_oc=AdpfAAJj6JPJ-uxXJ9OXtWUbY74TYaZlkKJVDqOp4JEAH-Y4eeBxMWvvMPsH3VpXoq4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdDogIDt22H5DzzJ3QduLvA1s24WaHSxEXQzJ9Qb0-IQ&oe=6AF9CA72"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AY9BnE5qinsQ7kNvwEbobGF&_nc_oc=AdoKuLpLwfVPzX7B3InHWd5KkzDGWMbvUByg5KZMCfdM_MR2ze5vazQRfHr0Zvivt0E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTreeaPWkefSoeGsOqa_L37WZKzeutYf0AFWYg0M0tdow&oe=6AF9E22A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CStnsmob64sQ7kNvwHjuT0K&_nc_oc=Adr_uMkKQEv5nRJ4bkQkDHc7Ym0BcrI56UW4qhr71mihUGmtahDGbDQwtKE7dQDKBRQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8DynrzWCkJIFm1EZOPs_EtU9fnlGuq-_aaBvVJtleag&oe=6AF9C7A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRgyqc4eD-8Q7kNvwHTQ0tq&_nc_oc=AdpzqHHojOi8FOuFU7d2XyCvCj5uuqBjgu9ou0y8c-WfqFP_vh2hoFyx42FvexaN5eg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRep2kaiaq3E4RVypIlQ0P5oQxmYkx76iZx0zN-0Cvy4w&oe=6AF9B823"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-PTVOwjCG4Q7kNvwEePCoW&_nc_oc=Adohy6qKWUFlSripna-6nhlh8YG54g5QcOXO76101dkgLYZNKpAULkOOuh-Km_f32JM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9AGVk9QhHtFBTb9zSbVBGGUZTJ
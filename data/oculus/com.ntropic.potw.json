scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M159UyXUZTEQ7kNvwHK6o69&_nc_oc=Adpu-fbCm9RDDHFTOv1WM7TmFBCdQgHD9UDTFf9B6fUuT4ECwq-cmRW0j_mg6UMQVcU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5EFoJgQjmgh9tZb0GTBEsZLEW7SuiKSs4P1ECMIY3Wg&oe=69CF9F32"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXynjE43iFgQ7kNvwERUpJx&_nc_oc=AdrebnuVaEK8bQ7gJXpNl7kinPaFh_2UApmj5eCiDomKE62w4zWXCo8amoucLNpU6VI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcAyPpEpEBcX4eBEjEdYkYeKw9T5qwibVbvdpmIKjzHQ&oe=69CFB6EA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4ZV9uTyiNMQ7kNvwF26HOe&_nc_oc=Adq5Jyy9r_bYX8uDgqCZWzyCMYTyxqRTU6aWrBbY7lbugSoA31V0LSWhI-c3jvXnELs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXCxOIiFShyrGXhLtJNZR_aNbB0qy8wF_hZBihzZrS7A&oe=69CFD4A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t88xnitU3JAQ7kNvwHxbWfS&_nc_oc=AdptRHQ3c3fOd8d9ae-b0AmsKAwj154gBcqJ9Zo3RFFxR1Dg_Wm_grcW816mwV2kpi0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1xoI4qgevVf0pyHloUTUrWndCmO1AaZOybbElM3ocLw&oe=69CFC523"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mm9Sh1gzRTUQ7kNvwGYUcJh&_nc_oc=AdpVBXVdjrfRNvi2J1jm3oX3bSXUSLL_MiSsemfgQ22H6G2e-y-8FwZu2JgEWT2bJ-g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUanBkkGhLmgETku9zK4wOKdmPt
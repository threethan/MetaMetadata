scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EP5XdV8_2j4Q7kNvwFhGeKL&_nc_oc=AdqVIBL8_jlFpmyw2v1b6pZtyCrCc0O3vYrM4R_Jlo6egj6YranFzMdU7ZlGQHutBs8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWJ-WFavUlFQlPbypqTzQqDdEcmlqYhFG7D8F7jtIAtQ&oe=6AF08FF2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rn5ft1KUPJUQ7kNvwEMX5hV&_nc_oc=Adq-WU_bmbHSLZI_KLwCaoDB4WcQomdODmDm5ywgDgCFN5HIntcjqmN6sxQQpEgWKlM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1wogPdiOnG7NIQsXmaTV9NWk2lOgeN8roaXvKw4_aaQ&oe=6AF0A7AA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj9XmbbS2xgQ7kNvwGY3RnS&_nc_oc=AdrVXID1CZ6qOAvDtn8xwJVnQuQALI3z7pHrDu6wkIS270gbLP4ybxkz1aSRVcmhYn4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhqWCNZnhEE2KiO0J5mOKboZ7rFTpMBwanATjkcMux8Q&oe=6AF08D26"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hv6ylWy3hEcQ7kNvwGDok-l&_nc_oc=Adqkn2stE3kYuWDgljvQ7Abx_pJne7kCLPBu5aqll2rdmLHUu9XiifGP0cEDka5F8ag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgIFCQMR6A9trfVsmqKV4k9tInQwAiMf1gPxtMPL72Eg&oe=6AF07DA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FpU2A1dIvQQ7kNvwFaaNph&_nc_oc=Adoah694dTQNZB9JIw_inSitmJ0uMxk8lYXsIIBvdTcIHZhbmG-KBeeOh800r-dFjMY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmS3j-12ApMWMZrnr1i7B1qLRCv
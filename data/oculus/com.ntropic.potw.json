scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKHKyZIR9CcQ7kNvwFRjkSv&_nc_oc=AdrR56phs9mPaaVZwsLkMQKPWi4NZqysKxmDJcIVfF3H3OqOOqxPXP1A_Zpdz1-0LIs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58KIL6p_xHTDng5qFNFY2PcXw2K2Y-K-Xn81LkCclqPA&oe=6A1070F2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsdwcdVfdAIQ7kNvwFud_qx&_nc_oc=AdryJC_cJAXyr_6azD1AlcGOJwi1M4us5wTP1Eh9P5iGW2-lYjppA8N3sFq48zaPkOg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m_PaR27x7l1FlCleIhuM0qkZ8VpFzxkZMmqQ4ohD58A&oe=6A10506A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OfdrfaqhcwQ7kNvwESbj6Q&_nc_oc=AdryErmEfSfwaq7g50SqTX8HZ1TcSYNGu5DgBm49iVWgRU0rUEhiYxXxK34mnQf8TdA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qHKsCQpT53Tc5KFr8lqoVfUigL9ENgf2TuVw0MY6rhQ&oe=6A106E26"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxjGdkunEHkQ7kNvwEbc873&_nc_oc=AdrkamqlJKu-6ppNvRAs4qONWZgDScCYPUMI4fx0eJc24P0ThZeH0_FSsB6Vkc1Lc_c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HXHvV2UsvDcD0QqTfF8mGdcUZYkC_lrNsKrdkV7HzbQ&oe=6A105EA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJRnZWF0AKMQ7kNvwEboGBQ&_nc_oc=AdoaUOLVkvIL4wf7sqzNy4d4TikOmpbxJVWJ5uaxo61A270wSQVXRxsXAR6cTVx3p3I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aAOvzqOarpMZKiKldWV_tsDmjB
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLTZNxjcGbcQ7kNvwF3w9AD&_nc_oc=AdoOXqGCl6EJgYbw03VjhBjfUfhgVDBcIGQM9jpZyvqI395jzc1u05eif1wcR4EVlak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pSl3y40QBYIaTxWPHytHkSKRx7x3IgXy493wjQv9_nw&oe=69DE1FB2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JwZupT3PoAQ7kNvwHdoonp&_nc_oc=AdpkMv7-w6PSSSOu_von59Lswa4v1ZVzXfTbJOoqQgXZXgFYzu-l2FdSOGjLVmcYtUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ikVeZ11zN4Jila0Hhk2K6MBp-7FmHYfmNUjG75c7iZA&oe=69DE376A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi5_gC8AVCsQ7kNvwHNA7FI&_nc_oc=AdqprOkqbYkQuzUid4-O_GHKyq-SA4OT_F9v7rWTl8I2iQAggoeoavb_guxCsECIsbA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SO0MPsqcy4hWaW8FV68Xtm6DK8-d9IATqj4BtTY3zGQ&oe=69DE5526"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xss998k6YN8Q7kNvwFHYXeY&_nc_oc=AdpEHBKPMhTVmAbNhuJefaanT5EKmMMA0lPAOFrACtnMP2NT_bClzbLIgxpZu_ioGng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zEtSxoouVVD7bqptENFCfuuf4fQKn8q4ngUlXljwY_Q&oe=69DE45A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIgMokzf_-wQ7kNvwHgT3pV&_nc_oc=AdqT8dMqhYKM6QDF6dVMVG-Ks9O6af1p5d9b6rwyXj6cceu_KObvcM3feDAZ_jpBQM0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AQENt8CQo10r5PG6AuqU6POLwh
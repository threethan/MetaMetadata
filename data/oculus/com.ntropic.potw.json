scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vm9496xPwkQ7kNvwG8ugM1&_nc_oc=AdrKxzIBHm19quFOoxryK9yCW2XRdByhoVkCwfqmaihonkne-4FI5AaaW_qsA5UrDO8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pb1kfxcz5B5hP8__fCdSQEbvQ4hwlBPrIze-DFqQY2w&oe=6A0C7C72"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ft2hHDeM9jsQ7kNvwFlhYwq&_nc_oc=AdrhQGu8lIdtlV19ULea0ktfW5N_yeJVU5RKxBvE8-zjew-3NJxJUAJmYvs2wncpqvw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Itc7eMaSi3WSCALlvCbxXL3_xOwvwZO4voFuUD9e9Ow&oe=6A0C5BEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHJFqQdxZmoQ7kNvwHTeBhL&_nc_oc=AdoYz8updB39S8NAXT3EjDuCsdHYGnaQEaMQY1bCwRy9EfKKuBkv-F-OIn2cf3gmLn0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53wqi99lVMyxmpz5PY_wM_ZojnjFVqWRLY493wuPdcSQ&oe=6A0C79A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INDB__yeXTsQ7kNvwGEyubF&_nc_oc=AdrlZyyPx7LysfwLa40IMzPb5YvlswZRoV8bCfxnVwlV0dVY8YkOf-mmsaSCP-t_GhU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41fZe7YWySnpnHMyHFMSjDAP573FsMzVgM7HGrzADP2A&oe=6A0C6A23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FswsLrUp3GYQ7kNvwERFg_u&_nc_oc=Adri39Ni-5xY846IC64Q4UD3Zh8xG83dzYr6pRyNbrL7KIpuLyiR3mHqOz9x4KGCxsw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Y_5cPI8vd_28YUtQ2tHaqi0Ot4
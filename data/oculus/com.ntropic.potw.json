scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDKiwO1tB-YQ7kNvwFJKdWD&_nc_oc=Ado1ULWh3qCNtZkeYbEPCiQTanbxleCsRHZaOBTKaZI9Gxzs4vcI9zJYaBavJuYEbmo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfKDxr6ilQ7jS9C9PTt4mblfrwZOSYKJb91esjzmw61w&oe=69D0F0B2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zsCGcmhqspYQ7kNvwE8LMj5&_nc_oc=AdrSVz5bmwlcTgSKhCcCo0gW8D5osEGsmvncP-63CQDUXK3FIcwaXXCt1SixhZqslts&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiTdIu_F8tuNu3N80HLw31YWXRb2p8CCHzww5SIouOgg&oe=69D1086A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4ZV9uTyiNMQ7kNvwE8D8Mu&_nc_oc=AdqBnVpQEkiRBq6msE26BcTPt_HJk-TFOpw5T76IxVBWSYPLtJacKwNXaLtIP9j_Res&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzV5mZVa9eDF6bzA_5hX2FDGNsBt4BxF_6ePk5ErPpTuA&oe=69D0EDE6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t88xnitU3JAQ7kNvwFKJ8U6&_nc_oc=AdpI-nAdhvORixUkFcSg7_jV8OrIgpV6FN6nvfILpQw5fzK1BYuVfNEDEQgEGTxA07c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8yiPaw4WMTsb2zLK77TpNSb5ZObTDwALLzMDau53KuQ&oe=69D116A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mm9Sh1gzRTUQ7kNvwH9oUIt&_nc_oc=AdpseubNVSaZ-b2zzeKp9RpsJyjBJ-B98VgAvmt-MNbsLv6MPCedvBisf0ppIVant30&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVF5Pzp2pZugS2G4ELcqbarmUoE
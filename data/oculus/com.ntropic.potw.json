scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xStDbd2vIL0Q7kNvwErd3mj&_nc_oc=Adqq9h4-ptCUqi9Za6lAqdpSgF5aPxg8nCOEfqgjkbA0m5666ynRz9Adeh-TVzLH06w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNLGkX0YRiLr1DCAQduaskR5t7Ho5Hw0zXuwKTTcJ2bw&oe=6A804832"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqQB7OB3vmMQ7kNvwHMqOLo&_nc_oc=AdoKJ4uIFHl95S-5OkfDupRRuKKnk6m0oEnNxUF-k3pfStt6SEkhwjHkj3ZkJlvG40Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY1HxaAtYS3WlEJUtJCjrW83n-jph0fdOpa8nghlWAfQ&oe=6A805FEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHQ4xWG1zjEQ7kNvwFCMEVN&_nc_oc=AdrAcT22mt4x1wJsZJhFdhW2Ph7GbN_gDbK6YvciFemZLN6MjH33e5u3PHAoEpLn5kc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrJQCxXdBvD2WD3ZZFEwBhQW3NF9nIx1Ojslywh3__yQ&oe=6A804566"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_8xxjqdiXEQ7kNvwHlMrOy&_nc_oc=AdrQXkrL5F-MtcLDb61kh7wf4kN3Eflpe4Mchk2-TDJlP6UamOo6pQOgXj1KmbCtBVg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7XqfAJ5Bw9oAy8hmNwzLqlS2kemypbBR3-tNr5-cGrA&oe=6A806E23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMqmPz-s1OYQ7kNvwE-UfxU&_nc_oc=AdpacYR9pS2NFKItM7SEaBVIVncLS0hP1bei5P8lQFRKWOYl6zODvvti5KL8jsLj274&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx2kM_taTi7BQ6pUSE0EuMZ7n7N
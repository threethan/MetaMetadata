scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5ID0JURrQUQ7kNvwE1eSS_&_nc_oc=Ado0iMOa_2ZyYw5aLE4dzuez57vft5VhNp-BCYmg9QfR338kgBhbnxC6Tq8fUNx_3YY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkO9_b11xy34-PYeTK73ypXutP4KthpI5UxAmJTp2fqA&oe=6AE8A6F2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vptEszl-wxIQ7kNvwGJhj_d&_nc_oc=Adr5CwoHoi6krGvNx2LnHrepGOEE8cHwDYicPe2LiB0V_FxCIqOs2uHvlOTM7tfMFus&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjp5vyPBQVXRz7G8Y4DYej0sA2veQ8cOLN_9kLjOOLJw&oe=6AE8BEAA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvxy0vKalO4Q7kNvwEJ10fT&_nc_oc=Adp17ZOjQAqbOnnid-zv7tFxH8xjpy_RZd4sYyF39r0Yxdv6ZSZEeUv4ANDtCLaq5_E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrHBvVR4KXvrxuo6cFZci1bAn8qOwjMP1tIs_V-6XF7Q&oe=6AE8A426"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEk4gpjLisAQ7kNvwEonN7k&_nc_oc=AdpWIZbp7k5FZFDX42YeQc3l3xNxVP6-zMdW3MGdQqSMZmJWG6sinxAhNR3L6NLBidA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5jVbzV6vTkpwGgRqiKYSl3QxhxI_j1wb-q2saRvA16w&oe=6AE894A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5IZCVh-lJsQ7kNvwEHTtCM&_nc_oc=AdrIsaA2YOTuz-h0D0WKBNOZQtEU3iHBs5cAU814AyXAljb0YXdTXzDvMhYTPzHGVE0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSo9EFkXIK_OLXNPcNg2qNRUloE
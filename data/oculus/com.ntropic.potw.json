scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V8uUhuTXgkQ7kNvwFOncwB&_nc_oc=AdrCUiArNeSlfJn8tEpXuNnOKWnpRA29b003nvn7tls0RkkVce6RUnGFkBoMy1M_yXg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-u_pHinz_NwHX7r2LFJI4tEddtTglRQhdCsa1sNJhBg&oe=6A26DA72"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCE4wfcOk3IQ7kNvwF6wr5A&_nc_oc=AdrCBhd2wHwXoO-k1_yuzg8iuX1JW12p_0dqRTHw6L5vv34KcI8vB_-pIM7OS_KcsnA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W6JXrb7nJ_0ScxTSNygjwqrDyGUFsoMGJVMkuTEEPsA&oe=6A26B9EA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRMXvVZ7NowQ7kNvwE5i2Uq&_nc_oc=AdoCdzd8QNiV7cD88JgLyWzcmynFn56I1WzqCp1L088CUzDde4LjpFEAdedJdEA4Dsk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YP_ZytbXhEt-3pl3fOMxlPF6q9LEeCbFKRjvtgcLsQw&oe=6A26D7A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C3sxaA6J_YQ7kNvwGUN840&_nc_oc=AdpXU_zk40dk7Ir36gWZcSE1ofyAp-ySS4TdKyS8ZJgRhQiSByjZl5pFfGlI-FtrCcs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-leDjkFWcADVPMv3cZxgzP2IO-jDsNyGOooQLMYhNrhA&oe=6A26C823"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0fZtze9zkoQ7kNvwHMPPgj&_nc_oc=AdpQKkx9S4gwVmR1O6Ny6R5neQEmKUWiPsWPED1MTS_lrd_hRY5SH7xS0mkwWrtopOM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86y2YOVFLEBXjjgv53djAptPtFZ
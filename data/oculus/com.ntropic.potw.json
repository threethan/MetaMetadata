scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oCphRApKCAQ7kNvwHYBHIE&_nc_oc=AdrK1q2sEGcegP1ihgkSfg1OEnmbJWq_9K6LM5kzyRnelhVKqGNHJ5fxac67hanuPiY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8T4RwL_9pCfW1VrGS92uHbqPYM9kf1TG_0y727VRvYEw&oe=6A3FE6F2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8ofKefnF2UQ7kNvwFbHF51&_nc_oc=AdqymFtJ-sUOmeb-0OH9qLfqvrBZJgZKNP4A2mrpra3mwTNVrygV2LYZjuvBhDPFJGA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nv1rrKdxPlCcVM5_7AC5TBXhKjJ4OxXAGrw_xewB-Rg&oe=6A3FC66A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmTrgrBupVUQ7kNvwHuQXGE&_nc_oc=AdpNVFT5uH5L1Of_6EN89jWFUNSvAWwO-gMscKSCm4cudJ1gSvoKw_iNhrDf3poRsHU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y_VmBWjAr6-yDPf69GZhxlmsTJwtL2tBS6vcs6e83LQ&oe=6A3FE426"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18Fp-DoVtWEQ7kNvwHi_mgw&_nc_oc=Ado5Z884Gx13fHBZhy1PWRtA7Yqq-HsQn-l3xef-cYaFDC5iSGIw_aMCCjPfWrekDrE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_foOqv3nNCOJ2mkqvL9-nZ0TwY5xaW3UZTZ9ud1Jwp_w&oe=6A3FD4A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdaeTlq8cuQQ7kNvwGvaoQv&_nc_oc=AdoB_RXw5E-fzdXL-Si4xGcvmwyz_Egih2paDQW0FXzTt204PZJCI0KD9CZ4flFHi1s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jAUHJvZKeKDBhPI7tN3cTC_H-C
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7ShvJq26MsQ7kNvwEVtY3z&_nc_oc=AdqIloEZ8tiGElAByQCee-u_5qiVkD85pDdz6boXTedBR7VHS56gbX4PVcaCkErXBh8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cNrxoMsO-8cMw5EllZGFoIs_PRjguH8-EH9cEf_ALHQ&oe=6A1C4E72"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksTeTAaTf3EQ7kNvwEZs1ta&_nc_oc=AdrJj9BttB1I4A5u4pVd4d3AWeqU6e1MVD8sgv2WtI6lllHe8Y2oPZptEgxCzeVOex0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XT8k-AYnfVy1NnmWr9vOlu6uMuZLE-8Q1B7P9oYIrBw&oe=6A1C2DEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLknq2Ea3EcQ7kNvwFlFaCb&_nc_oc=AdpaNujUiJPN1XO2JiK5wuzAG6c-drY-wnuDOA9zQv-saspTPghV0R3AEyq-yW_gzmU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jElqoe4p33hgIY5uXNBtNXMt2Bg-VU4VFrQl99u08xA&oe=6A1C4BA6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMvpM79uFBsQ7kNvwFuVQed&_nc_oc=AdoejIAgvLRK9WFoTPAOaqyj48DgjgiO0vouJwRT6iSxwVyEmXZ5jCAZ8xHAvWIpHNQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cy5x-ETKFJ7RO4lDwcUqS9ednJvDRU8hnOUTIRWF_GA&oe=6A1C3C23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0oqurZpWr8Q7kNvwEA-EJ4&_nc_oc=AdqZzWbBjSIgYo3C8S9Xer0fuAkkIpItBtttLUj1_5BtZ8lzUtZpFT9S1YEKUm88ngI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eQfAQnsOG8pDqkZWiV37lQpt7e
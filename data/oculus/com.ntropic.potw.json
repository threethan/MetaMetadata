scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv9wMANj0vgQ7kNvwGXlokW&_nc_oc=AdqNcptZANSdA6nOFspy5IkP3r4yTWXXY_SzbZDWpvY7fqc8c2T659VTKfS9I0RA0eo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQR2KjzKTHKiABmPxRG8mVT2ufIEul8_Mx3UsCySysmg&oe=69C907B2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2JCJtgDtykQ7kNvwEbQUMp&_nc_oc=AdrxjY3rFJ8bcNYUVhH8kj_aO_wymQiCburpfE-ZjTNSLNAatnuDdnMtnMU7d11va2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxv1KpJVcuaBJxFjLRg4rr5t7G5tRHzmurceaLajzhO0g&oe=69C91F6A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5cTFomMYvsQ7kNvwGI7N5d&_nc_oc=Ado04I1THksH0l1fCtkCt5QWBBEebe6Gb5UryVbNVu_6GCTrQLTQlrLnZEblgJ6_oNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLoX-POm7gYKyCQEp7ApSR8s5ULj1JWntszQ_AzOSp3A&oe=69C904E6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hP99snrg0EkQ7kNvwFfhkat&_nc_oc=AdrH7OKbooCZCUqSwOtU4YQOvFrNHgSZTjCPAaAWsmZydxEr6B_QiEDwZuBzeYFZC3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyw9FZGI1jd5O0ypISAapwuHkunW9xNiJiJu77OsazvGg&oe=69C92DA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orPXL2BZiS4Q7kNvwFwvR6I&_nc_oc=AdpaSQ_DxOUcs1RUz5I0Y6hJY5Gsm6AsIjqcqjIf0bUEqCX-tPUmlbn8kFHaYNycOeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwakt8r4YqYVqR8MQgKGPZT4I43m
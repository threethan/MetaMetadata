scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE5Hl0C0BA0Q7kNvwHbfkSB&_nc_oc=AdoYVpgpGhEFUwNdo5rS3Qjy0A1Nx0TAVc4Xxn-USK-YWvBqWNCG9zT1zJ61_G1Mzdg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXa-m-vfme2g43Lws7weDJkDeNyQt2-YjH9VxN8Mp2LA&oe=6A9C2FF2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUiLqFeNdJIQ7kNvwHEP22R&_nc_oc=AdoXg9l4VINQCmFwiob2QarG2Vkqux5KVswmWtl80sR9Hr1Y481hwOpsu5vQjSBzly8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfH9HWFzojlYkc6E-PowyHLchg3vIepeejSJMmgQpZ5Q&oe=6A9C0F6A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAbpz1hHIAcQ7kNvwGyTgAi&_nc_oc=Adrtq2puyN7aq1RsRqHQJ02jYNftA3PNjpbUD_LoCl2OThvMNcKjeB3Fd4FAZS-pZgA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSKYEDf4ukTWkLNgrVEbtzn-qvDcbWlBo3iyr6_gR2Aw&oe=6A9C2D26"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2G5NK4xXToQ7kNvwGhZR9X&_nc_oc=Adpy3G--8H5j04riupWjCVKP5hYd0zHTsN8RJFRuHVYJNWtxwpmuHDCu-EWZq1Kmu98&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_s_Jr8P5Ffv4N8u7j4txdYnN0ndQ_jMGSWxyQKcn6AA&oe=6A9C1DA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39-aRC0o-3EQ7kNvwG0Oe5l&_nc_oc=AdqtZcDnhyHPNWtrpjqjq18GYcUJZ-Up_kMQuUUVDDMHQLwJ_Sh_1P5RuU5v8kGnYyk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6dcyZ4UTyGcDdlC12sutZ8xCQk
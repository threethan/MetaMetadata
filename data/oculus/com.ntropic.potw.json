scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kz4lQkK3MvEQ7kNvwFj-Y5j&_nc_oc=Adr2YGilGsxI5cKNdMaBGeHjbST5U_69t8DtoQLwWeRTiDTtxTEdsGBnDz6MIz7_EhU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABxYGHEt4UrEHlYYi2w6okbUfCVkW060hkiwhUWVvbpw&oe=6A60A432"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5KooUrcNvcQ7kNvwEfErm5&_nc_oc=AdqEczdyw8KowLViFOK2Zlxwv5beWRAh2mGFQ6yr1MvtyKOMQXuiNQ8Kk64yEPd1_sQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAADsrBOCj-nK2Nayb9MPbEaWGkezoPaoAktwH-Rs65VA&oe=6A60BBEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbC2PCNMjNwQ7kNvwE2_MVu&_nc_oc=Adrjjwi7e-P-PK_ANEJ-GCnI_aq0ymOy6aoSAJL5ieWPRYV-20p1_U2-rRiGwybOoKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNMYMLchcnnxQLRTuYYU85y7E02Dz-G7MErT1cX4l-LQ&oe=6A60D9A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKNGQ9KHi3AQ7kNvwGhsJDz&_nc_oc=AdrXfHpjYGyl1YOmhVR6-CsowcDIxz01x9CAXRUIgsvW1hgkWZBX5AHji_Xrcr8Sa2w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPmyAIOYlxabi80VQznnNqdhu9Xbo6nSdugvQeqwd3HQ&oe=6A60CA23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOFsS1NNDGoQ7kNvwF2y12G&_nc_oc=Adr9jKsQXgMX6bjUmHX44g6PCz6Jzy_zp80EZHXXxXdo2R1ikbYgQ1SG1FT9JW5RqKo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0UnMspf2-Eff874Ujv0ysMAzLb
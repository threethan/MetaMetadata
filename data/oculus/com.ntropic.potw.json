scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBVEbTN4rqsQ7kNvwHdo_J7&_nc_oc=AdrNjfg5-keqAIHS4bws7orq02VGJU0BM9Gk9qjH6dRuoREw6utfA8faaTsQjBGEMLQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmIFIkzkiavET55m2MvVF1TaIs-46htHjFshPOXzFhoQ&oe=6A916BB2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78SevrbyCC0Q7kNvwGl01Re&_nc_oc=AdpDRCj9wPlW4IjTkoVsvakKDvZMwlYKkQhja-lFd9FNBw3uXv-zEHMPcziP3Svqvrk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER3cV2I5lPhN4fnLipiQpn_sIZD2tk0jRYpf_YwgFuDQ&oe=6A91836A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEtJmIexQY8Q7kNvwE9ScnP&_nc_oc=AdqeKp02xDKDKKniJW_6vXHFHuWYX_9ltQQqQk1mONgjbFGje4mYsPUZO-dBXg6NwkY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG0pUOp9ZVxagWlaKO-wIeyLdywMB10a5E0WzeS2cgyQ&oe=6A9168E6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8Z-f9UA5msQ7kNvwGocFc2&_nc_oc=Ado_Qc65TN1LMWvDiMmxGd11BqR3cEU7oeRUsjfrwngVrDP_4dXSkkPxbiYePMtbaXc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYSGhlRqJ-HWwYbtf1Qre4YBUxERIV6wf9bu_oKlumog&oe=6A9191A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Esz829r_roAQ7kNvwGaVWvl&_nc_oc=Ado5n80l9xmbJ12CzDyQMjgxr_ejCjB0jS-yQS0HmRXAkBbWZQ2D9qffyGBhOWO64Bc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp0BpViXfQ5YDw8dq5zuasGq9Fs
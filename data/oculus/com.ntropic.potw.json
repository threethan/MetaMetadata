scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGqz9LS7fOgQ7kNvwEQo7L-&_nc_oc=AdpYIHavhd5uOjNOX1qrtRucSQoo1kY_5yGf6J21_mSsD5QmC46v_t_cuqRrTOOoaLs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwesop-f52drr2c1OQnLuQyohxn2F6XVQiwHQOAU6ZBJg&oe=69C664B2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bi60HwF2DoQ7kNvwHDY-O7&_nc_oc=AdoYXeKJxQJ-SWki5rg_wfLUncFnrFCfXE0cQHJ_5tFc4oPxFOJBguBIrlDOsAaJL54&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznVO7RuqntxsKUmXOS9YZPu1iB4VG0M00ylHvS1pGhIw&oe=69C67C6A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N87lV4_Gof4Q7kNvwHASxE8&_nc_oc=Adpawgr5MDOnPEoZbRL_TAJnYq86mvAszLeVAjxJ_CJzyU0bKFmAF9ZlHWxaifmCnqY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmdFENv02Efsn5MJlxjfdQ24yJUFe0c5egJY65xfAVuQ&oe=69C661E6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCSjqE6fLVkQ7kNvwEg3y18&_nc_oc=AdoKbbNGavpuTIpIay-iA38TVAy91jerJozwKbpT7Gv0XJrYl-YP4Kkq7219i8YpF4Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywMlXW7xX7c460KeD_x-EcM9FZv3jblkKVtVf7x2n-Yg&oe=69C68AA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orPXL2BZiS4Q7kNvwGp-tQQ&_nc_oc=AdqOxJdExsG-epcx9U4XjvirBn3Yep8E1ZGBu6kTmtarZTcEToxH-G24FrGcQdWZneU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEEnho03pg_XaUM6YL9FXcyqx3i
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZBmjQmuU4EQ7kNvwFb319e&_nc_oc=AdpajNDoZr_FKCk_zWq-GOssPOFfQnx3eE29HjDyMVgx-Yg9jqeXRrWE1VgVVkkD9uU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WVgd5y27eGw45fJPTQsfrYPkRLBaXgCU69ci_OZKuQw&oe=69FB58F2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdcCv8icO2YQ7kNvwGrWJEX&_nc_oc=Ado6Al5WeQi21D-cAU2GXh0zs0o5jmvsGN76LGKWHdu9EtBYPkFRs_JMhAMJn18thqQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zyYWuRTiaasHKDA1sMSG6F3qbeOPKw_9XYAvQvy5lAQ&oe=69FB386A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-wrUVqQL7wQ7kNvwG87LdW&_nc_oc=AdoXAweEcrh0vM5UBt2kJpEB_A7l1o1MT4LsmU2w6ScnO0ass5-ok8Kq9BGu1yeramE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kQ4OdE8x8JTG7ujXAy2861iYR59jE6Mvy37J0P3tDRA&oe=69FB5626"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82wFoheJhYIQ7kNvwHF5dYW&_nc_oc=AdpBMbqNzfomuGBXln_1RQF6oQsaFGbB-RMKvsKyIO0cEKJooeR9Ukh1uRvcvhr9lkE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-JBPMr0PdPvYxrNL3o6XjXooXWDfEPBf6fXZXcB6P6g&oe=69FB46A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYvDruoQU3UQ7kNvwH6pNrJ&_nc_oc=AdookL3V4OiqvqHQ3iLUW7-nrWa1dY0c-IcR7nSfjxUS5hidwQ5y5NF9wCLHIeHpMro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L2cZNYoioDdJmCcjcUISGFfjnQ
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGqz9LS7fOgQ7kNvwFIkzvV&_nc_oc=AdrBGA_dDyAG0G94cU9chXiV_YouDaJkbwa3K4f-D61ueiINSKuE4t-Pi3eEonVRqBU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwWOiGVCPnpdgyfKi8AsIr9EVbMtpLfyI7b_BHIz0JbQ&oe=69C7B632"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bi60HwF2DoQ7kNvwEXf0rJ&_nc_oc=Adrgh53nXQPc8n1clTEJiCtww_NWTw7VrtIWq3ywW_lAxZZW1GuDjLx4Dhod8h-4-mk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNpKF2aLGwk0w1WwhtCofoml3nwiUYCfKlFd2RV6taeA&oe=69C7CDEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5cTFomMYvsQ7kNvwFzweJx&_nc_oc=AdpfQ4ZF3yi2T3d6EojxtCwl5p0feyDuJJSdhTdloS8ldBGj5JZwEoEoaCrogheKrno&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8ensqWpAMhFCE5n8bkooMLCyvdDi3FsBnbao0GIYIiQ&oe=69C7B366"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hP99snrg0EkQ7kNvwF0FGQF&_nc_oc=Adob9-kKHx3B-FT26tkktNCRaX0aQXV-iGQZgTcaVMqtsdox2tTR3D5336VQSlQ6TZs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUekrU_G0yG3QPR3P7izb0MNxmjcuBdK_ayCIxrKlupw&oe=69C7DC23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orPXL2BZiS4Q7kNvwG0wYnF&_nc_oc=AdqP276EQh0BJQbn5oip401RyRZOlXwp2VeIX3qtrbcdYFcdcDf7UvVhYyT5MognSWY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxmv0tvNzWHgosQttE75aI5FU99o
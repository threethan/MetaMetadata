scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8oiSTqkDtwQ7kNvwGdPojB&_nc_oc=AdrdX0Gp0YRopXrKmg01WQ9Ia1DR_GiJprsduYsHK5ZzsDJH415QD6vx1YhSPWguFPQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlZ9ML3lNzIM67M5r_SMvHXKTpypyhNNYahgJaNaa6Vg&oe=6A64D0F2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Etb9qWOQj6IQ7kNvwGlE9zo&_nc_oc=AdrRq8Cw4Y9a6oXLGCmb7Tn3EiF7jOwupiw5kiu50X37UPapAbjiqePa3AK0Igqn6t8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtoPsVTY2RU4GIR_HGwjnZXyxnwVUO0bq0bfkAuvcLNQ&oe=6A64B06A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsmBWi9jAd0Q7kNvwFxJ72n&_nc_oc=Adrix6-Q4UG1yNHB8u2WzWSi5m3vXtYABWUjhdsP2c41BK0BfZ_5uLNzGKcvjn-ASho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkjhEIn4UWG6WFH5FDToGdxMws74zKUjRE_L27JC--Vw&oe=6A64CE26"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-GZ914roC4Q7kNvwHyO0lC&_nc_oc=AdpP2l5ZAHJDi_ddIkAnMcXtgQ-ziOxc3HEMk9fiW5h7EdEF0nGTIXWCYSV8Fy5kZdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBscVgm4xqds6VTanBZDDwic5ZcM73qaE_bh80-PgaqlQ&oe=6A64BEA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsYYJLde6iEQ7kNvwF49d_U&_nc_oc=Ado4gEw3pIPCLdopb7yhRc1KO-gizhiMxfqln50ddXlmfxT_wk20K_0nsvDaJxKvD4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmXfhlB9cC31I_XhPFOpTfpLBtd
r6-1.oculuscdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBVEbTN4rqsQ7kNvwG4qdfS&_nc_oc=AdrV8ycDqo2ab-FoKs4NUkbq5R7TFtBSYXFnRlOBi6qI6Ay3XOMsCDvMn_O7rp3OV9U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOgd_kbK2IpyHV8kQrRa8_UMI5L5b5mRw9gJqH14EGxw&oe=6A8EC8B2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78SevrbyCC0Q7kNvwGq1XXE&_nc_oc=AdqGVtWZ9UX9HOIPLZmnbLT2aCCBEM6PnXEHp00VHH5hQwQrKgvCJhS0CPfQIr4jqvQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdeQIHdnHZnltIYOqpdMwKOizhWmcu-niwEuXYIdh2AQ&oe=6A8EE06A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWUCJSP-9G8Q7kNvwE2CwBW&_nc_oc=AdrmUqn-D5Hqj-1MaEAHdg7ckpa233uRAOdEsYkzaSra7ObDWjnUWOFxPXPGpRvj5N4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8-KBMMTNH90LwG-HPKjxiPC5se-HGUN2M5VzHGe_sAQ&oe=6A8EC5E6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HCUTEvTqaUQ7kNvwEyP2S1&_nc_oc=AdpE4_82oPXP2W-AMPu-oMotUzTnvdZbMzWg99WX96rbNSC3uG6jfdfgPLea-ag8nlU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx5e7XjQLsd7Q8RVZdpejlOeXz7aApy8X6fHBWcvZhwA&oe=6A8EEEA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMcA6cbyqcIQ7kNvwE8-nOi&_nc_oc=AdpwRWFr2hbN51L_971G6RCu0sbN5KyD-S7XVjDkeeakA8P16vuSdUauZZxh1iUH29g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG8sQmVDS9E1v
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EReBNhk6ZWsQ7kNvwGBhP2M&_nc_oc=AdqXVXn98XGHhoy3joZYYp2XtrHGPv_0LB18jIm0usCUgQpCZu_ZWyqFiPEAA8esA6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI93uI8ifcDuA9Ui3QJjvqXRoa3K2Iu9LXbJ2hPvNF4Qg&oe=6AB3EAF2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdEDho9KywEQ7kNvwFu42B0&_nc_oc=AdqJZSZvpuQDgk-70v6SHfbGzPUeSjBm7_3qSxBEbF-XI-2JocmqH9uG7aw1B5Gbzdw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCQClCziFnTzT-qGhwZTiUUoH4-XLl6jy_RnaN7Zhj8w&oe=6AB3CA6A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M40dxv839ioQ7kNvwHGIkz2&_nc_oc=AdotONJn5wFU3Myp4O-7S-WvjtcR2T_XxzLEjI-9sji23qw9VpYdhxgxagTbf0XdiGc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINV3jFyXO2D5YEGate9TgVJIg9UGE092GEArhdJWoD3w&oe=6AB3E826"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0GsRwYlvloQ7kNvwE2aHzI&_nc_oc=Adqjx_9f6S3ydIF7jvmBT5VFd5nTjRgVaruCWPh1zNDVzmUrwQ6X9VNO-E_ew0ZeH8I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInlwv_jjtOk2AGfAGbyI7_N9Not0OHzMROyl9J6pTrwA&oe=6AB3D8A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vah7G2GhzAQ7kNvwHRkZZo&_nc_oc=Adp1OPFXzM1KTmS15Qw04WHaOdaK0DkqBORes-PEliEFaDGDzuPWcF4owCcmqPQaG04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBFvE-RVJGt_au26zR8kpZoq4JN
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMyI2d6FV3EQ7kNvwH6Bvrw&_nc_oc=AdouJpLqxOp5CNRxBLpOyIxHzmql9CleUFA6y0PWZe2j5baJflDbe1ZGgU4LiwsT7cA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4IDgZ3W-HKDaVbN6qbLyn4w7LKfhpn4DPqx86sWqKkw&oe=6AD38EF2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tODFxWu_eHIQ7kNvwHXb2Ny&_nc_oc=Adpn2cQLRqtSdiVg-p8S4Mej-_dn4JYCJQIlSiCveeGZmchcTR-m1SVOR4LNrXApcd0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlffjcG8fDqpIkyVLCPHEkRZkSTE0RhXO2X24bV63XxQ&oe=6AD3A6AA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W37CKRpkpzAQ7kNvwG_aWq0&_nc_oc=AdoKRaOxwULmXYdCzgSZXtw_dySxvS6P_DaSmp8YzmMfpAzfs1L41D_gXlyTHlCA8C0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOinSeIQJt-vKTPiTMiU9vCpnMgrGkAq_1NJ7dKDyLV2w&oe=6AD38C26"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYmEPjwpHaMQ7kNvwGXU3sq&_nc_oc=AdriiDH34YIIvOIdKQoVyskCcgXmxjLqsC5C2WHwIUftNaXIkf9gaBQE-6bW985qL6Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5WG4U3V8ERi6u6A4slbv3iziQzioqzSOrtCNV8hc-XA&oe=6AD3B4E3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DJKiUGdRu0Q7kNvwGihhXQ&_nc_oc=Adr0ucdreXMh6WPcT8C3oCMsEHPvFyz5rYoyM-bwZIx25p-b7l9bgmIsy0vj8oJSr8Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe_1w9Xd88yPac4Y9z4aw1xE1i9
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCFBAqn2dG4Q7kNvwEBxRmE&_nc_oc=AdoafkSDN4CTeMT6TsRfULYWmCBzlxj5F1cDg8VHbYSq23g8wsEQ0JZpkKL3tJY-gZY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lsnYRlXICfIe_qwbp5S8BLKLXwu8pq1rcYJHapUJvRA&oe=69E640F2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzpwYxnsybYQ7kNvwFNK9pR&_nc_oc=Adp6gBr8nqPDbQdCtN58CmdgLefW0S-C7Pbs3aLEakYfPZU2pl-b4za7ZzpqVFMQMzQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SKwkYkIa6idKGeNte1VsjBZLf9z8hVt3rJDgi2-Am8w&oe=69E6206A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2pRA6OAIesQ7kNvwEEL_63&_nc_oc=AdrtRRDK7Fjju-AUyb9oPvrnXjRAmRwhS3TYm_ZvWNXG2ZWtANnBvEwrn3LsIE_bTGM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tycNxI0oZ8DQ30AytWqJCLJCzp7G326dwMDLlghH1xQ&oe=69E63E26"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K56kmwvRpgQ7kNvwH1tUr0&_nc_oc=Adq2SQZOgFrFWVX7KqUCbolyyx3_aYxzA9HR9seyZD6kwOPqg4p8ESax1UWakpMDJzM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SE7nQ9877qDLR6jtuwj9_CCFLUlxjk3tlDDJk9zYaCg&oe=69E62EA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIxclkLRaV8Q7kNvwHMZoYU&_nc_oc=AdqeWKkUOOFJ_ZvgqxTGozo7bqaD3siSjYXqfWPOmv0Req08TcMJdaNziAYVWpjJmJc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_Z0X2GPOy0xLcSbGQg7pJVF6c6
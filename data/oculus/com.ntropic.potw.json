scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxwM5bMcV_oQ7kNvwE0We6b&_nc_oc=AdrLuCrFCIWCnUNgg6DIIyb_SpHS9XxaE2D_KHv4DbzS0rWyuvyZ80wNeH3nmPoAfFU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lV38y5aAyCwwypShc8tcVI6yeQUyWae_nJEas61bi4A&oe=6A09D972"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQIl7Vk8MiQQ7kNvwH8dU5D&_nc_oc=AdpACAMhBWB7fZdp_IV981NRgeAZJtlkWfh9rs8lVIxlIMmc6bBqIxwwKEE1h8y1w_8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FbV9NR8yjU5Tknv9XA6kamhs7KiXGkxff_PeobEGMTA&oe=6A09B8EA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrTJhdq6yVoQ7kNvwHZ4Mzi&_nc_oc=Adq6muwkW-Jp7Uo3Fwc-jonZHGXXCLPjwFk_zvHLdrgV8FEbmYf2t_8FEr71TdjQ75k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yuxczH8DCwrdrXjIUdSl-A-KgmT7cQdceAxhVlfWb8A&oe=6A09D6A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnE-UM3qLk8Q7kNvwHaEj15&_nc_oc=AdorOLMHGOnt20VydLtImT33mddVTjbrFxGHbNWIBofAXZyq_aXJDE1fIpxpiVYSsFI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66-xW-SXFyBuUA0TlwaIownH8N7pbd4wUvI4by0XSU3Q&oe=6A09C723"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEvtuXdE1tMQ7kNvwF2dZAD&_nc_oc=AdpbHD2t4e7s-eQYRqnHy84mG95N-UokK1qhI3is4NfjexFFJRBwIEzQww_ixzNoo8Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y9EqHRZQ30Av4g7nTS0ct7ki7q
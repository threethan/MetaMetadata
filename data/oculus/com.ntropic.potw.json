scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0QrTenYsB4Q7kNvwG3E3-x&_nc_oc=AdqKY4gPvRXsAUqfUQCw0Tbhj-4OO3LrLNdDZ74dv1gkOsk9Vbm6Br5mFJgBtRSQW9Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUN75ZKHLKL8j44xjxKalJ5d3A6qox-xFLGVRlKhVbJg&oe=6ACBA5F2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ju4CIEHig0Q7kNvwFkEgzJ&_nc_oc=Adqo6Aa7CycynPoDC9lSauWcFNVJXc0FMoYyldKVk2gZ_wGxID_dgsmDksrCT2MzmIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKTp209jCDFUe5YV9vEdro0mJ8o6trWEY4znkhBLU-Bg&oe=6ACBBDAA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaX-obVwCCUQ7kNvwEQUdF1&_nc_oc=AdrTmREuKeIS3NU5s8lH1lYAWJgNADYwzm0xIX7cBvFjIaFqlP5nZ1DIOsxl4lvTc00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-W0fFszUlIWcJZR7Fhd92uuLFYlHPUBd8POYOmGdC3Q&oe=6ACBA326"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwm-7AwPjUQQ7kNvwEvohlY&_nc_oc=AdqdERKHkD6xG5sFP8pTXC9t7LxvGArHk52vrbf2pZfW3kMcgGXxrgHCtdnPTWub9kU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4zqGu4MfZfpA9XaUw8isX9hxbPDzkpczU1Di4bpaV6A&oe=6ACB93A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=364J258cZCkQ7kNvwHLo3B8&_nc_oc=AdpiHYkeGovTeFb-hzPMYztKZbJwSYrj7lk_zz8LN5fQGW8MFcc2RWaBkF2taqAyLok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxcvAu7aKBP_b2pXjFbDN5c28n9
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48xlYSEp1xwQ7kNvwFYjovv&_nc_oc=Adr3Ds1os5-5XEOqQGoHqEBcAIqTaQEsrdNfVY4RbnrIEb-f7s6olvtN1GvJUYYhODc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25PeTmdqvukfixvjb2MHWI5YiBCtrGOwxgZ5bcu3TQzg&oe=69D78832"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRXtoeIhkUwQ7kNvwEuLj4w&_nc_oc=AdqAwvil5Dc-yrc1hDTXsOQ9F5HzQBn0QuyBKyi11XryGQ6stueteA6_wHIgWD0UAjw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3f0fv4qxLwSNHgbZ3G1ICzPWt5ORn-fu3Rvyc-TivUQg&oe=69D79FEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sN1bnm8Qf2QQ7kNvwEWOL4s&_nc_oc=Adqk1y4_Dn52nyUa-4DwpzxwAGH09PTqQ1JPQcaUS4S-UdzU4pZCScmKpO609Cyg3VM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HPTbQhQ3zSQ_WGGYH6gnEybk8Q6KcmoMwB3ZSkVsT3A&oe=69D7BDA6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHp239865ewQ7kNvwH7JKTS&_nc_oc=AdrwvnWUTCB9O8TSAUTGirmA4hZnIkf07ulOL57vzTHi01jW6LN9wrdsLGV7R6YeT8g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nu2LWONOi0-0ZugQ7peDgI3bvVQO9swk2tmvXj4IeRQ&oe=69D7AE23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zu_dWpJQLqkQ7kNvwG-R8PH&_nc_oc=AdrvyxrHR8EV8Q-6FWRDFzK22Rv5PNbDSQWJrK0SsGwvM2XNr5LLpTxW11zYkUVs0Zk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25CLWoCQm8FQ9NO97iAvi9hgcA_
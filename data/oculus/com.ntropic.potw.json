scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuYMZ7Az7fwQ7kNvwEEHjSO&_nc_oc=Adr5ZpcU67ITxW37rSFJ8vu4ZohEfE4rL3PXnAqfqBsID9d8W6v3isBmyQ77lyemoK4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztjpaL0pf_TgY_SEtPO4KX_9ds8I2kvme-PLlBy6cdGQ&oe=69C3C1B2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrUQdRyvrlAQ7kNvwHpC3xL&_nc_oc=AdqcxYod6a0mA4X8J3eTBmjOL8wPLzmBH5duTlGKiOfpUJF9piyxNwqTG_K6X98fymk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzngpPWk0JjEMFF06nqs60AuAE36-6nViP8frgNPRkMHQ&oe=69C3D96A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N87lV4_Gof4Q7kNvwEwv-X4&_nc_oc=AdpeOXbiwXN-ftx3emwIq1gBSWJJcMeiTs5Ww4h1r0XdzzsaxcokWwPodZq9HExjItA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAUJ5ybQFJRfwKVBEv-gVE_1ybyPsbnGk7rnCZPHatsw&oe=69C3BEE6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCSjqE6fLVkQ7kNvwEIaUBt&_nc_oc=Adr0YbpuQrcJCU0gUSvrG3E213yRD9DZLvECYyTK0ISOgc0oHBju0w63s3YVzPJSMUk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnpFJSlgvr0Jo9C_kAUcg5tHhSZUwAl-j8BgG3Uin5GQ&oe=69C3E7A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3KFDrsTWE0Q7kNvwF83Hro&_nc_oc=AdqXteMA8pY1UnhCKYy0Zq-L7nUJGNA_yhdM0H4Xh7Dnwe9SgrDroCdYOXNSRm4wFHs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7h8b_hy6T-9EFzhXE1gPwJAv7j
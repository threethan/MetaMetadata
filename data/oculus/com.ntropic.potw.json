scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hH080CAa_rMQ7kNvwGyrYph&_nc_oc=AdqszBA09oezpa8OIqIJY_VoYJRQ9Pzsm0GIKyButthzVy4BlW0YPMQEy0juDedKv7M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2j-I2JZKRzVQnEk3ufK2LUr8L89eUHQ_4ZAblA_L7uAw&oe=69F4C172"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYZcK7XoMUwQ7kNvwHRkQWm&_nc_oc=AdpIsM5S45tFbYl1vhIg97PYFKLmgC0nAs5zS0tWNefYkHxcK-GXRIq6KTm3BuVyupA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0jFdAmSdJYTE4EXt_03SpzmDQdlVRzBPGp580ubPOdyw&oe=69F4A0EA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-33ZPZckRDsQ7kNvwFDFPco&_nc_oc=AdoL3GSDOvwNE5l1rQQMTTqDpqsU17jOp_bwTrZpnYVeDK_mtMj0slvJI_NLSVpAdpw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lozQjS_lmyirPYNSodbCVWnBjsilDybD71N-cr4hm6w&oe=69F4BEA6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2D6HRhZb8EQ7kNvwEhwjQa&_nc_oc=Adosvo95ALwo0cnyPUv5sdJqkx2FhhNKopizNpoCuZeOWp4uNsk2_h58bAzbb4B2y54&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3eKWLVEOIWf5kpfPC8JQOG-A7iR073-VWLVARUIKdugg&oe=69F4AF23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjEE03bftdcQ7kNvwEQQTuo&_nc_oc=AdqeXPfUZYf61jzRvC6RiN9wKuM9zRBSZO8hAf7wtBJm2r02JQmW0Byz-GnFUYx75AI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mYT3hkTI3W9X8HyMZeG-D5ZYHo
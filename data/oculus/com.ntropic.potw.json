2.oculuscdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RRgSozQaI8Q7kNvwEbxSUl&_nc_oc=AdqEESIe5JIKwSUnyHv2iD8mNQVtWKFlxEsIO0QzBo0KhwVSP2htN6xSYnlLy3R6B0U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EdiQ0q3DCL4TrRdkmINkFMnHjXJvU6k0uj4Qv3d8WTg&oe=6A394F72"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNA896-85AcQ7kNvwGVQky5&_nc_oc=Adr_Qs2NctquPsoIU9NDCzpB-R95CP5VmIO2eVtmHgGTv7JahnqHC2xRPyKottClLAs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-u41mfM7cNuiNGD6vufATjUC7K-xZtSv_RnKbYIG7kw&oe=6A392EEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDgpMe5eGuAQ7kNvwEgp4eh&_nc_oc=Adqw9ErXoTO5kzrXY6tuKbvN-QbNxJjW5QsQfcOvvciz9sOa9f1XVaJ4yoZIAfyqYI0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OKJAL72DLVes1A6UhCBef8WCCuRg8ts6ned5ksyToHg&oe=6A394CA6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXVcyypwNNEQ7kNvwGpEXcf&_nc_oc=Adrf8xpVT4Epgih6MyahX5pWG4omO3Gd6QAssPkwknD6N1hODE5vs-IWsgBNRXc5uZU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fiOjwGemjH76LDAYq3Y5Ck2p9GBA4RASF_sHSWvUu0g&oe=6A393D23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnMM4iO9MB0Q7kNvwEI9_oL&_nc_oc=Adq_7RuAyagmBRGtbWDxAUyw6PDGrAwKpLkJS0OG2WUKpy8k9UKj1zQVGxo9cc6h1Ik&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uoHRREJhCSLd8C
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5IELzsHSs8Q7kNvwGIlqtl&_nc_oc=AdoU2un87mV2dP6t8LEQVlmY7kFBDR8iI5AtBxrH3H5NY786kItY6nPlAygZLMGQNMk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-c04skwa-CGgtBP9yxqhT5hwkNOs39K93M8dHb8uQ0Q&oe=6A53AD72"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yP4tnzG6RdAQ7kNvwHihjik&_nc_oc=AdrGPgpAgnlEKbTDjZVo_TS_acwLgYzY9vbcpWOJLvNZ37SyKFE1MnV2HkKRg_hHlgc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCg8xM4rWmgA7pOtXOyfAg3NtFVZhPxI9VFV-Ndd7QPog&oe=6A538CEA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P95pBoj7-MQQ7kNvwFlmh9k&_nc_oc=Adr75VSd_s67DPITGgMYPCP1PJdNlYa0BbgebewRh_xDkbyz7CmN2fuXgmZOr38uhec&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8njoh2J7SmINtn01EIonVTzjQrWpoBxTsHkuZUxJ10w&oe=6A53AAA6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvtco4e0PDoQ7kNvwF2G-v4&_nc_oc=AdqCC4M1wpthQJ75XToFB436U2bYoXuiI7bTBwNh0BYm9NSm7iYa5orF2itKzU2Uu4A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKh12bN0jrNsON1-Uxjq11_disgKgTqdBnb13b7o7l2g&oe=6A539B23"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-12e9Zxdx4Q7kNvwErnQec&_nc_oc=Adq4T6f8ORYf10LGY7PoqX2_w19UR3bFPqD4N4oMI_L33o1HAKiIm5EMqn7xYQqpVLk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqn3vbg3of2XlicB4OQ6lMBDJN0
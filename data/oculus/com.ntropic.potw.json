scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRVZmn_aXsQQ7kNvwFQIVX9&_nc_oc=AdqOYmjlNCZOvxm_39q8-uckm6PFvJ3XrTIk7h8-RIaHJJM0oigJudoKertd2URYdYM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ntlQTRIAvh8ulgVYIi_TyUnjDtEL0cxzwXYq5l596IA&oe=6A1859F2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhWLOkEamsQQ7kNvwFAumU9&_nc_oc=AdpJCZ5T3cHvOdpdRBuhBAGYlQECIrzlbJEJSzWfXqpXJyJbpEhjE84o5GsD4U6RLLg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hyBwajnlSG_tdJXwD6El33EPLhRdcD0tZWtbjdtYWPw&oe=6A18396A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXLn3WEXTAwQ7kNvwFbNrcZ&_nc_oc=Adp0QzayEIp54OFmW_4lqyTGNRz0tgNF5WeeYRFgsEK9J3ir1fe9YTAlYPhewVEwb0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Qf4NcMTmyfJnk8JojBaXu3w1SGzjykxPK1DwT3GvGpA&oe=6A185726"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1enpYVREXwQ7kNvwGrmlBU&_nc_oc=AdoX9ZddGabGjPihzomXG8lnSg-X8ful5R6Bn4Lx8GfQOqbeeQVWkmj3Qmauml1I0tA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jYvs1oFasT49dkFp-m1atpToTxd-OkcBPwbefBl-kcQ&oe=6A1847A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vktQsjoQONYQ7kNvwE0uRpg&_nc_oc=Adp4TYhfRCeuxgg3yGlOtUOww-zMWdRds8TSOWopkPKablVSdpot_DpQKnEJXyvuFrs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50ZolbqAOdZPz95404mz98WAk8r
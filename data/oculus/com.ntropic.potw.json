scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiHYUcPLt5sQ7kNvwFVAOWE&_nc_oc=AdrumK_KiucufYNDHa9AXyyIfSvzDEuCMSx49rAmGwvhVJCwogsyT7i5LX1MMwB1yjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRoffV48DswhEOEgpvFzZHCylr8MQA5g3q-s6Qn8N4Mg&oe=6A983B72"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=689BQehodgoQ7kNvwH9nCnG&_nc_oc=Adq1f29bsfgssiClJDh-oSfxW9hLdipgzUEADPkqyPlYbe5iLxmTazboEj1p4wCaE5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5NxKECGslIBMeWBeDTcNST8WqSLI2TFVujzgZMwJjdA&oe=6A98532A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLVEwggRJ40Q7kNvwGyLa_1&_nc_oc=AdoIrxcoglw3x9Y79fvlBGQWfXWi1-B_7qZViBybbGzf7fl-e20leFyAgxcXg1x6RsE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkbPLrVxa19c9WjFzxgfqOyh5X7TYHOWZB1f0P_Z4OvQ&oe=6A9838A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94Al-vHOgdkQ7kNvwHzNKNe&_nc_oc=AdpFv5Cym03IoGrW6SioElEpr2KfRXkhMd-d0wGsL7lF2TIFR58O-GUxhqRwmqvJpU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJgz1gOxkirOP1WZ_lj7nHmJ5ugHA7pI7JDfY1vjrhmA&oe=6A986163"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-5CJJy4rHYQ7kNvwEzdYYE&_nc_oc=AdpB4amOPSY2SjC9YZ4lzrj2UZSIDXVKCK-uTh6vZsfbMeQh3oDJe0AJg_HJOdWXksw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOn9u-jw429GRQpVLwt_QvN2S_a
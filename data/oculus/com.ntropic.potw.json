2.oculuscdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fohBUoSzyS4Q7kNvwEwq3Iu&_nc_oc=Adr8whunqRcS9LbacDFos_1aa1Oz56xJXDt5Yv0o1hCqCMhBZ66PYMc79PF428TN2-Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlsq6H3R-EO5dJHV-esGm3vg-inBwHTdNTM-BOaXgKZA&oe=6AA95EF2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APIN7ikV8ooQ7kNvwG_qnuN&_nc_oc=AdoLEsmTUqxJqDZYS_KL-w1JREgiLngfTHaMCI0Bq7oQvBErGNzs5I1nLMJ_QwvYk-Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpo8EBXGSPQVrQGQYNU_eByzVwmBBM33GCp3Ae-OBnQg&oe=6AA93E6A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-S7BeEdE_QQ7kNvwGplbv5&_nc_oc=AdqVgx25Ungj6hYWUP3PCA8I9S6FiUU8Zkg0AV5eTnmN-r6FKJ4h3ZascJomXEGEO98&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnRqDOI_fxAsHhUDS16hBz8wtlFqPqhqiP8poDKmWUhQ&oe=6AA95C26"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQFHM1g4J9wQ7kNvwGQdCF5&_nc_oc=Adol5t1DJSfZX6WVD75a-CJYHqfncp9-uEf5o38Sip9kkm2rdIMISdLVqaQoi8secnc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdJauNB7oagLD-Pf53m_5J6nFQt6Rhkkpc6AuOvVtSoA&oe=6AA94CA3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vh_sDzDfdjoQ7kNvwEetaAC&_nc_oc=AdrDP9LoueXNhqpC2NK9PZFSlmi5O5rEO21Gf2ApI2wjKhDvk4HeMDbVAFX7C6Nm-Y4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6W0w1yovxUJf6D
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6giUiXoNjsEQ7kNvwHFFJ2J&_nc_oc=AdoCVZ0osZe0norsVSSZQV_WgCNgMcKx1MKGBX9_H3Uq43CS4C3OXx9lWuiSLDCCCwA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62mDfxrviA8EendysZPic80CpY7BUlR1D2qs8fuv760Q&oe=6A15B6F2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yH6RHzCvc4kQ7kNvwFcH9JI&_nc_oc=AdrLC8AL9objcTn2Y78wXdyrp8m20mq4Xpod-xULgoQ4AXa3gFKHFs2mX1FCQ8Hn6HQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M-gqJSFeZgjan67y-t_usVqmloTv1uEO1HV70ucR4hA&oe=6A15966A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXfaP3X7fZMQ7kNvwFz1xDB&_nc_oc=AdraMCKhFX5buydX92ixAcmhv_dzbLBJtF8qSg1ZMvkFrDxCQ3-UnU7nc2HsnNDxb6A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rlR4JCLT-N0rouYsq2isRkOMmi57ik9g8bU0d9hu_3A&oe=6A15B426"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xBErDkM684Q7kNvwGL17jO&_nc_oc=AdocW56FU7I5i2ugCM5ak1Hqcz3lz2SBb0ZwDNJCYlCYf1RZ8U-8Te-g5sVOCS3CbNQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fI6Grj57TRn-4w-evpYz21mPPUjFdIj_6OsTEviEQAQ&oe=6A15A4A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-sLYIC-xlAQ7kNvwEArvMm&_nc_oc=Adr1ORJrmCy0wYmimOCLRR1MniYeB1XSGPFyjqZAzyUWCndirfYlXEZ61lHY-Y032_c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NJVUiiZi-0vbIXozx7f6mnL1lD
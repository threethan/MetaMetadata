scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_EMPRrAu5YQ7kNvwHdpmEd&_nc_oc=Adrkp9ffr7a71tvNeex0HpocbYoJuKvwqlaJaWGKUSweWAzyO3b_sc90H65BLp6f2GU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP-ACpTSE5_eJInwV8LxBdaLUTNQpGzhbfRc-GmFx9xg&oe=6A7C53B2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhSDAIT0MBUQ7kNvwHoVv9M&_nc_oc=Adp80FwcvP_XLKVrNpy4ExlPAvTmy73bjiTiJlsMvQwNl-z-Yo_F-JZhCTy4BplEWdA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6fnUhYfXRbEFAwhZRXoIlmSm9dfnNN7zPfM4oG8YYFQ&oe=6A7C6B6A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3h381i44mnoQ7kNvwHgr-ZX&_nc_oc=AdpVhl5zfLCX7sjXdjQC9IbokICmgaZG8Ue9evaFzxdRU1zJ5fHPmQFaIZfIucJyhr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHtfZKqFDciG7mdxJIlHdrUGnfNpsQVX02wwqZ_y5pBQ&oe=6A7C50E6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKJG0OJwK2UQ7kNvwF427bd&_nc_oc=AdrWtez0f1nYd_ew3mWog1MpdUq0304tQrPahNYQ-DIdXLCnL1GbOcy5gHz6luUtN3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH82DXbe5tXhHlm44kcd1I1PYTKVzsGc0EkGram5ZnNtw&oe=6A7C79A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyUMHTx-MvMQ7kNvwEj4CVB&_nc_oc=Adol_QK2F-f_aKmF603FRD8DrkaKcNljgVKPysrBxsKJibeqVIjHNPfL7K9H1okd7Xc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp5MapVSwTJSApPMsQBnzmzj11O
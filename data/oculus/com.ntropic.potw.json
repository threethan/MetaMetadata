scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugB2nxsZZxwQ7kNvwHusYOd&_nc_oc=AdqRoH4hKeFspeNsF4h_XeXWAzv49uDVRCpI5vDE2Qf8XoflOIgc_9ne0IDp0XPda_I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYjIUW2zKNvzddESD3YYT1repM4VJ5C2ocE9LrD52xTQ&oe=6AEC9B72"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFck5ThFbg0Q7kNvwGmXY-G&_nc_oc=AdrDGnZ6NMY1IWmXvfTCgTwIG4M_2ppwoPjnnKBkWRSC0GWiRPYVXFf6P_Wq_BlKXK0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuETU0thTfIIOZjX0z3JmeA3b_Lh5RBaijZ4b_zm3TqQ&oe=6AECB32A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAVHvgcefVcQ7kNvwHT2UP5&_nc_oc=Adr59BXhxeaDahqrZdQjdG6Inosvy40fBjHU0JeM3ZXrERkCKx7TdyauLgUM65OM5bE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9yCKngA5veVAU9TNj6Cg5_d_zjITQ28KoQcnWTZXzpQ&oe=6AEC98A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaSN3-T0ctUQ7kNvwGsDjub&_nc_oc=AdqUzTdQ8kNfenxM8XmzYHje2Vxk_tZCbHheYkV7YjGdD1xZAZeOoWBmhJJk9_El7Fw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7esZF_Vz6eoTOC6-gSLk2h6ixPPxVGy9Z0_SY1_SI_g&oe=6AEC8923"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJi3BoVVRVAQ7kNvwGzjJZV&_nc_oc=Adq2oZouVaMpeWZM8GAYdctqHlQO2TpTuk6jfT1nCkB-7iYbizEnSsx0Yp-uaqgD7e4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjPUJoltYlv5DjpFwF_hjy39eXL
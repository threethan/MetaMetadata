scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_EMPRrAu5YQ7kNvwGFPI3D&_nc_oc=AdpQt8eFk1sqn67b02IzW2G4yFTM4dSoz79Rb9q8sNT-tB0wkSDAtW5paVVhyOYlJBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwNw5ImdiI8jWDBIsza7ftWROwSLSfW0YyfNTKh-yLmw&oe=6A7B0232"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhSDAIT0MBUQ7kNvwFtaNSc&_nc_oc=Adpfr4QfUfAdZSBbQOV-VRl_JfogHQeD9wO2qzQS1CL6BUcecnVrdP7VX9UHoWdzRKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_ZQ9BXas8wNTJOhhZPjkK-C0rvZgjdrdc-vFbcSlkbg&oe=6A7B19EA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3h381i44mnoQ7kNvwGLSbeS&_nc_oc=AdoFGbFCu_SypYEApZ2YC41bz8IYbnq4bBmPeKPLq50TaQsaEnBMtEr5-Q6gZJVkbJQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE3VFTk8KYGKUexbnARAoNV_ur8R1SmCrdpOyfAk0KZw&oe=6A7B37A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKJG0OJwK2UQ7kNvwEwiFJU&_nc_oc=AdpAfrbRNnYpzan5LcQdj94ogM9q0f6MQzMimMiN2kjDsTo0AZhWl-YdddM6e-oHX3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfk5-n6QDIoKqxXj1koS1dBaW9Nk_lHxef5BA2EJ6ZxA&oe=6A7B2823"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFB_Kyq7_74Q7kNvwGxzRch&_nc_oc=Adp-PTRRsKQcwQdK3mV9U4aL-bruyvf899bstjKZQN7JrM6tXBj1SCs_AZVg04JKTmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw2NXB1ztS726ULwsTvbJ9W0Uq2
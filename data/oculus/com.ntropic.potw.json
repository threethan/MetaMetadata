scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6giUiXoNjsEQ7kNvwH8ztrQ&_nc_oc=Adqt7m3sDBbWh8SZeZt-ezzEuDT-xcvkVPFs3krVPCTUDOgDnClA0v0TFJWzINH1sZM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cZVqD1Gxu-t55CFvDlm2P0KkM_aNVExow7S7S672mqg&oe=6A1313F2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsdwcdVfdAIQ7kNvwHV8AsV&_nc_oc=Adpg2TYqiPIpAOO89Zgx0aCZDO7Vb0tWpLPaKdnRBJdp0buce_yMjaC8nluGYxphGKA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G854znXLSa1qb7B6T8m7gd-IjP3A9IljAMP8nFgP6XA&oe=6A12F36A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXfaP3X7fZMQ7kNvwGrpoLP&_nc_oc=Adr1PQ5QYpljeY-oybCPtxJtgkWQ9R6wwORKujjLDzn0epacXQAGMKfgwQ90UcRIXew&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_4NdTWHWVHDet5cBjfNRVNEmiH00aWgMIrDPlKPp26w&oe=6A131126"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xBErDkM684Q7kNvwHHF-IV&_nc_oc=AdpZ_jTvjjmACxBJ7SAM8P64Lpr8ZMtA50AiO8EODV6aLdorO-NmG2n_nYF4pYfVE4U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55cdQzWEChYDU4r91L8bVAbEDiXFsVvq6ltZxB4Wjf-Q&oe=6A1301A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJRnZWF0AKMQ7kNvwGSDdAM&_nc_oc=AdpqMLQWbzVSPEsxvbYJh2_koVpI0CYt9zpYvHAvcH3II90ujoOQvXhrDJYpeFjopnU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KwxVmc6gF6Sw3Y7DvPE_LMhcA5
scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nR1-vsOYw3QQ7kNvwEV7XBA&_nc_oc=AdonQuGKMUd4LaAhCCR2D0mpl2VkNjDJd9IRXCzH4ouPvZTU1bxwT-DFxoPoDh4-pmQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af771JdB78ch2wtGuQBjTZbRz59JhjmFUbmsZ8EOFvuIvg&oe=6A2042F2"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZtnaCZfW70Q7kNvwFMhHHD&_nc_oc=AdpqE4lZLWJqj8ifjJRLIs1B67vgvuvpwSrsv1QpnVa8KmJRkTn-kmRwRBVIytnF0h4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H9zeAVm_3XhiwNKRydL_TOjBUR7Jrk1bbOF7x1R9Dvg&oe=6A20226A"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UO-2-AdgsloQ7kNvwE6JW9S&_nc_oc=AdowUn_cBwJGeIHBDBPSfFst62vkhZIBwFMvSRBhG4bcxYb2hiOr2HjJ4H2K49DOUtI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QOramBvXwGZxHl0nml2B85phkqgEsayarO_P0uwfKvw&oe=6A204026"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7OE2h6qk4YQ7kNvwEy2l0Q&_nc_oc=AdpcYQ6OeBrHfHM2AEHNfFxd2lNKTiD5o6Kz53smercIwkJyBNkESkXMt1-xgh0rmJs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P6NJrRYQJvAZ72PoknLW2kTO1EnJZ8fr3oheaTRyMrQ&oe=6A2030A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkkrbAbDFyEQ7kNvwH3fQhU&_nc_oc=AdqA3iyAXG-iDBrSSZu5K_WJ5O7He6lFRj1F7-7dDeQNfJjFsLK9n2nB4JwHvO4aGZA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DGYlv6SC2zLhKqXuJ0hK7B_ve7
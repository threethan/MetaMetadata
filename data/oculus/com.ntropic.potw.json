scdn.com/v/t64.5771-25/11162732_1548233275269913_4218275380710080512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJm2xf8t9zIQ7kNvwEhsbjC&_nc_oc=AdoxxeP5GPF2zGLo3PXUfWHySmvcvh2DT4ClGVBR8yOOq2NahnIxJG_v_KaBs758pA0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZNtxGYFctXSYqJcJRxIH6Zn8F14qrpdUcZ16ddGhv_w&oe=6AAFF672"}, {"file_name": "migrated_image.png", "id": "526781638245670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_269073823616181_6704332722287935488_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXzMzzs08voQ7kNvwFsUVa9&_nc_oc=AdrzUX_V9HKPmQ0hbCmB-wFBcpoZbIFRk8sKbtBUa1OxqpfkDe5t_3PGEQ-UvC3XwlI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm9UHBn13q00lZ19Yl3wdmDHvXT-CeeNvhxLIUUEBWzw&oe=6AAFD5EA"}, {"file_name": "migrated_image.png", "id": "525323995064903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162788_299760920541396_1440798495144411136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQF91oXrHksQ7kNvwEHRGUa&_nc_oc=AdpgmryerGsoGyy0g-9qPPJLRhHUOQ9nZTjuo_3oTCo85zjGB1jGobOzpG7H2tTX6-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoR7n60TGyAw8ThfUV65z7DTSi7KUTKYWc_LLnAUnJIg&oe=6AAFF3A6"}, {"file_name": "migrated_image.png", "id": "283007502688709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162701_284209382088682_2320645141552955392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3knlp49AyKUQ7kNvwHpRVtK&_nc_oc=AdoUzdSdqmnxFjT1Yg6d-6p587WrgjpbnTOojbyO7m_9V3Ej4nWjhdR781WGofhaBHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILzBIrT5qGqGFHiPjDmqLeIJ0EPoNUnGgeXbSX-MiJrQ&oe=6AAFE423"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phone of the Wind", "keywords": ["Phone", "Wind", "Japan", "Grief", "Tsunami"], "long_description": "In the seaside village of Otsuchi, Japan, Itaru Sasaki built the Phone of the Wind as a way to enable contact with those who are no longer with us.\n\nThe Phone Of The Wind looks like any other phone booth. However, this phone is physically connected to nowhere.\n\nThe natural tranquility and transcendent means of communication combine for a unique and cathartic healing experience.\n\nIn this Interactive Film, experience the real life stories of three phone users grieving for their loved ones, then enter the Phone of the Wind and experience it for yourself.", "short_description": "Experience the Phone of the Wind for yourself and hear the real life stories of three bereaved users talking to their loved ones."}]}, "developer_name": "Yes Please Thank You", "developer_privacy_policy_url": "https://www.yespleasethankyou.com/privacy-statement/", "developer_terms_of_service_url": "https://www.yespleasethankyou.com/privacy-statement/", "publisher_name": "Yes Please Thank You", "support_website_url": null, "website_url": "http://yespleasethankyou.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272609204910025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_137717040281264_945705743644884992_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXishUJW7A0Q7kNvwFWZf85&_nc_oc=AdrCBT_V7PyikZC6W01N6EPFdCi1gkOoA7oTQ0G-WgH7ibWAAI2ENNhbj9jUutkbnmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV-L8ZdQgfZgtAj_b3sUAo4oUri
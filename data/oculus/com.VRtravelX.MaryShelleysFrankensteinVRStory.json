nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeUjIZKqJuNs8Ch9CSHFaJ2dV8Rze0AoMP7P_oRE976A&oe=6ACF8942"}, {"file_name": "Screen2.png", "id": "1044488994894377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/585819904_1044488998227710_363403804110672840_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUrATi4n_7wQ7kNvwGs4NI1&_nc_oc=AdqbQ6ksi4M1gHkjtAYcCoyGibaDVyd1Qm5NajU79M-Q9TGKuBh-rgrpfIShdj9MhbM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdo_bDYlwhDAjhbSEjMNrbX_ymnru_Ug9ai4XGjCnERQ&oe=6ACFB20D"}, {"file_name": "Screen5.png", "id": "1079780184733440", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823746_1079780188066773_1543402210695810337_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHTHepI271gQ7kNvwEwHF8A&_nc_oc=Adrm4TluZb1EYhNAR2OdnjHE6afKYQPR8Ri90R6QA9RHnAsFIIISEhiWXmkDx8nJPJc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTn0CVZdR3OkdZ5KjRKqYB0KpB18ZTaMnKMGvPIN0saw&oe=6ACF936F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Frankenstein VR Story by Mary Shelley", "keywords": ["Frankenstein", "Horror", "Gothic", "Story", "Literature"], "long_description": "This experience brings the atmosphere of a classic slide-show evening into virtual reality. Instead of sitting in front of a wall while someone presents pictures and tells the story, you are surrounded by each scene and guided through it by spoken narration.\n\nFollow Victor Frankenstein from his youth in Geneva to his studies in Ingolstadt, the creation of the Creature, its search for understanding, and the chain of rejection, guilt, and revenge that ends in the frozen Arctic. Stand inside candlelit laboratories, Alpine landscapes, the De Lacey cottage, the Scottish coast, and the ice fields of the North.\n\nEach of the 65 panoramas becomes a place you can explore with your eyes while the narration carries the story forward. You decide when to continue, allowing every scene, voice, and atmosphere to unfold at your own pace.\n\nThis is not an action game and not the later Hollywood monster myth. It is a compact, immersive journey through Mary Shelley\u2019s literary original: a story about ambition, responsibility, loneliness, and the consequences of abandoning what we create.\n\nFeatures include 13 chapters, 65 immersive panoramas, full spoken narration, English and German audio, and stationary viewing without artificial locomotion.", "short_description": "Step beyond the familiar square-headed movie monster and experience Mary Shelley\u2019s original Frankenstein as an immersive narrated VR story. Across 13 chapters and 65 atmospheric 360-degree panoramas, you hear the story while standing inside its world. Look around freely, move forward at your own pace, and discover the tragedy of Victor Frankenstein and his Creature in English or German"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Mary-Shelleys-Frankenstein-VR-Story", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27739993758968743"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_1178832587774072_8945524874565828144_n.png?stp=dst
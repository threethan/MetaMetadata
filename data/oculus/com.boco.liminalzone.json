ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOT4Q-HkTQPe0t2C7u5HjwEoPBGRyyrPBN6wTlNZhRphA&oe=6ACB8EEC"}, {"file_name": "screenshot_07_2560x1440.png", "id": "2528106994294294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_2528107000960960_5872956236025966822_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ax0TeAPhRd4Q7kNvwECK3XM&_nc_oc=AdreMndZwOVxuqkp9TnzWuHudvsimDYQS7kxoumDV2HF1U0vR7FpqjWx4IJKgxuMOIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPYT1VIiIytyHhpx-cyO0RNibcWBrNqlJqNrhuCV4q8A&oe=6ACBAFBB"}, {"file_name": "screenshot_06_2560x1440.png", "id": "2132178290681535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825503_2132178294014868_4938998108962218285_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j67TevLuoJcQ7kNvwG-PqF4&_nc_oc=AdqEQdEIaPe0pp0iyAQaK5QRFWZR5QtAOG2tLlspKAZnsRUMYSfRrN0minVgv7QAmDo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqzcDPrPghqj873rpZ8Xv5VlscvzkBZHQ2GMO8i_GTDQ&oe=6ACBA57A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Zone", "keywords": ["liminal", "exploration", "atmospheric", "social", "surreal"], "long_description": "You've been here before. You're sure of it \u2014 the light, the silence, the way the corridor turns. You just can't remember when.\n\nLiminal Zone is a handful of places that shouldn't feel familiar, and somehow do. A concrete building holding its breath. A park with no edge. A city that simply keeps going. You step inside and there's nothing to win, nothing to finish. Only somewhere to be.\n\nStay as long as you like. Sometimes you'll be alone. Sometimes someone else will be here too \u2014 a voice across an empty room, footsteps that aren't yours.\n\nTake it with you, or leave it behind. The door stays open either way.", "short_description": "Some places come back to you without your ever having been there. Liminal Zone is a quiet world to wander alone, or with whoever finds their way in."}]}
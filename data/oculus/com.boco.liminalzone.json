iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI28F9ieP5rwKChLOt1GJDXqXgr0NcUbh0U7OolpVAziw&oe=6AB7C86C"}, {"file_name": "screenshot_07_2560x1440.png", "id": "2528106994294294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_2528107000960960_5872956236025966822_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWeCcI10E8YQ7kNvwFzy4e4&_nc_oc=AdqJjihedY9xS36lG2Zw0YwQSreJVu4jYGAmi0Jo-RHIz3kcRkSzq1AzxR30pYT1wUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ1m03LIjcIiNdcWFBY0TGFfKRsTnjCDhJ1DILOwxt3Q&oe=6AB7E93B"}, {"file_name": "screenshot_06_2560x1440.png", "id": "2132178290681535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_2132178294014868_4938998108962218285_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OARps6iZw5sQ7kNvwH45I-j&_nc_oc=AdoPexC6UEP27iiBCH1H0qTTt3MI1XvB0KkrMzj-zBxvo0KKD7LOjUOgJa0usHdQFrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9AhGaNOYNWc3OKq545olY9xYcueRGgr2p4qqYUTzm7w&oe=6AB7DEFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Zone", "keywords": ["liminal", "exploration", "atmospheric", "social", "surreal"], "long_description": "You've been here before. You're sure of it \u2014 the light, the silence, the way the corridor turns. You just can't remember when.\n\nLiminal Zone is a handful of places that shouldn't feel familiar, and somehow do. A concrete building holding its breath. A park with no edge. A city that simply keeps going. You step inside and there's nothing to win, nothing to finish. Only somewhere to be.\n\nStay as long as you like. Sometimes you'll be alone. Sometimes someone else will be here too \u2014 a voice across an empty room, footsteps that aren't yours.\n\nTake it with you, or leave it behind. The door stays open either way.", "short_description": "Some places come back to you without your ever having been there. Liminal Zone is a quiet world to wander alone, or with whoever finds their way in."}]}
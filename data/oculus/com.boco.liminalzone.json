iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKQxGkk-P9DTI2CIIeWwfg9uU9fJo45mzM0TnpprCj4Q&oe=6AE5ECEC"}, {"file_name": "screenshot_07_2560x1440.png", "id": "2528106994294294", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_2528107000960960_5872956236025966822_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nz08tsg491wQ7kNvwE5Y4nP&_nc_oc=AdoWZ_21rV4D9NYtX4W4_3yB0hEbsUN_1tCdLZOC2huAjbJRzaDSik3cLa_a9lcMvC0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODwk_WSNmQU5SanDRoEh-CsUj15R5WIzzF4ewlGBiwYQ&oe=6AE60DBB"}, {"file_name": "screenshot_06_2560x1440.png", "id": "2132178290681535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_2132178294014868_4938998108962218285_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVJQVN5NxQcQ7kNvwExY1aR&_nc_oc=AdoloYlsCJSCSmiQOFBxn1U_E5k_wRgD565jlVWAk5YkGykogE9Z72o5-WZ7juqH8qY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMvP7qRb3EEuBUk9hOJZA7rsNcNQNOgrSwRXTyCjw4Ag&oe=6AE6037A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Zone", "keywords": ["liminal", "exploration", "atmospheric", "social", "surreal"], "long_description": "You've been here before. You're sure of it \u2014 the light, the silence, the way the corridor turns. You just can't remember when.\n\nLiminal Zone is a handful of places that shouldn't feel familiar, and somehow do. A concrete building holding its breath. A park with no edge. A city that simply keeps going. You step inside and there's nothing to win, nothing to finish. Only somewhere to be.\n\nStay as long as you like. Sometimes you'll be alone. Sometimes someone else will be here too \u2014 a voice across an empty room, footsteps that aren't yours.\n\nTake it with you, or leave it behind. The door stays open either way.", "short_description": "Some places come back to you without your ever having been there. Liminal Zone is a quiet world to wander alone, or with whoever finds their way in."}]}
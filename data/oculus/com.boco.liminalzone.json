sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeTU0Yt9M2wV8ZiYKMmT1cu6BlDuCiu_6t_EH6v039Lw&oe=6AE1F86C"}, {"file_name": "screenshot_07_2560x1440.png", "id": "2528106994294294", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_2528107000960960_5872956236025966822_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpJMZXX70TQQ7kNvwEdAmPD&_nc_oc=Adp72j-r57l82O4E1Oq5RCA-4f6pDK3YOn3cHNMKjbwFCeq0WSAq0fevCE-EnxVDo7s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq6B7polx-DGNElrOxdNv4t133NSB102D8YoxhHm5cfA&oe=6AE2193B"}, {"file_name": "screenshot_06_2560x1440.png", "id": "2132178290681535", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_2132178294014868_4938998108962218285_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYun0Gih3vAQ7kNvwG7I6rf&_nc_oc=Ado8UkC6QBMKVD3HEQIFdcnrck3sztueRsn2dAXB23UXNYP0yXb6cUR9X6pcFCiP1mE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn2e38u8rlHQuEL9-eSF7ILUmO6ipVXzKFpMl0hf-Jkg&oe=6AE20EFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Zone", "keywords": ["liminal", "exploration", "atmospheric", "social", "surreal"], "long_description": "You've been here before. You're sure of it \u2014 the light, the silence, the way the corridor turns. You just can't remember when.\n\nLiminal Zone is a handful of places that shouldn't feel familiar, and somehow do. A concrete building holding its breath. A park with no edge. A city that simply keeps going. You step inside and there's nothing to win, nothing to finish. Only somewhere to be.\n\nStay as long as you like. Sometimes you'll be alone. Sometimes someone else will be here too \u2014 a voice across an empty room, footsteps that aren't yours.\n\nTake it with you, or leave it behind. The door stays open either way.", "short_description": "Some places come back to you without your ever having been there. Liminal Zone is a quiet world to wander alone, or with whoever finds their way in."}]}
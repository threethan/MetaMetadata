fMXEtat-mv-QkXmUzdlaEp7NnoaDAm-xfpNpPWLHAGf8cxcdeoaq6CSY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG75tFuYLZrrrUa-FihQuefkNeqJ6hxlFdbufFCXtbhIg&oe=6A8EE9EC"}, {"file_name": "screenshot_07_2560x1440.png", "id": "2528106994294294", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823783_2528107000960960_5872956236025966822_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS6ZHhzN-e0Q7kNvwFPohrg&_nc_oc=AdpPObqQWa954FX-3OijnruW6rGTrFt_g7nfbte8YCG8_Pxo-HQBBSk9CNBcLIq01oU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTOgRgQb3kH5Gy9acpv-eWiFcQLyw6T46UpT-Ny4wDYg&oe=6A8ED27B"}, {"file_name": "screenshot_06_2560x1440.png", "id": "2132178290681535", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491825503_2132178294014868_4938998108962218285_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4hZsShZsvQQ7kNvwElbLwL&_nc_oc=AdqyAOLUg9u4_MaKjDoqHiqnYe1umsv4g0G4VXlrHh0du8A0VUidv4nTlYPWWjhkPR0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEFrb0z9nSIgVu3cnGVi_KgKXSbYiGrHWxNdyi4DjQLA&oe=6A8EC83A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Zone", "keywords": ["liminal", "exploration", "atmospheric", "social", "surreal"], "long_description": "You've been here before. You're sure of it \u2014 the light, the silence, the way the corridor turns. You just can't remember when.\n\nLiminal Zone is a handful of places that shouldn't feel familiar, and somehow do. A concrete building holding its breath. A park with no edge. A city that simply keeps going. You step inside and there's nothing to win, nothing to finish. Only somewhere to be.\n\nStay as long as you like. Sometimes you'll be alone. Sometimes someone else will be here too \u2014 a voice across an empty room, footsteps that aren't yours.\n\nTake it with you, or leave it behind. The door stays open either way.", "short_description": "Some places come back to you without your ever having been there. Liminal Zone is a quiet world to wander alone, or with whoever finds their way in."}]}, "developer_name": "Valtiel", "developer_privacy_policy_url": "https://valtielchan.github.io/liminal-zone/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "BOCO", "support_website_url": null, "website_url": "https://valtielchan.github.io/liminal-zone/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24368495179470157"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/673738609_1563985895115429_6659731375979751808_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxBbvziTqMcQ7kNvwEr6vWP&_nc_oc=Adpp4M6ILdXK3hEm37vodkeUEml3N7-Ylm-rkXZnnInhqrXWnN7oCThbBEtbUxj7pM8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc6QE_QFU0KgqJfMeRi525HQmjkZwVy5vfZtsm9rbdGQ&oe=6A8ED762"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Liminal Zone", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1023770785722696"}], "release_date": 1783341540, "lastRevision": {"nodes": [{"id": "24368495209470154", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defaul
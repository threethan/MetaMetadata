sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBiGmBROd8JKT_w7UAKNsV_MLYBX26a5prtO2Ztn1BhA&oe=6A903B6C"}, {"file_name": "screenshot_07_2560x1440.png", "id": "2528106994294294", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823783_2528107000960960_5872956236025966822_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS6ZHhzN-e0Q7kNvwHdvZJt&_nc_oc=AdrKpxZjoIZdiW3HG4c_Gdj1HwnZE_hSbja8XezeN_HalFAq2CCxZC82-NPDr0MmXOY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtHl64mom5MZWnVdyIwA66DKytKG0QaQ_cxU0HyRJ92A&oe=6A9023FB"}, {"file_name": "screenshot_06_2560x1440.png", "id": "2132178290681535", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825503_2132178294014868_4938998108962218285_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4hZsShZsvQQ7kNvwFaIgcW&_nc_oc=AdoH6UIfotW112QjKoHH4qNbBM8COwNh5fmD52XBruWWVxWvfrw3NZWy5qVSXjtOwnc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvt3nEQm6mBhWXTc64s4AQoC1vj6KEuYOP9HLPfGW_Hg&oe=6A9019BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Zone", "keywords": ["liminal", "exploration", "atmospheric", "social", "surreal"], "long_description": "You've been here before. You're sure of it \u2014 the light, the silence, the way the corridor turns. You just can't remember when.\n\nLiminal Zone is a handful of places that shouldn't feel familiar, and somehow do. A concrete building holding its breath. A park with no edge. A city that simply keeps going. You step inside and there's nothing to win, nothing to finish. Only somewhere to be.\n\nStay as long as you like. Sometimes you'll be alone. Sometimes someone else will be here too \u2014 a voice across an empty room, footsteps that aren't yours.\n\nTake it with you, or leave it behind. The door stays open either way.", "short_description": "Some places come back to you without your ever having been there. Liminal Zone is a quiet world to wander alone, or with whoever finds their way in."}]}
lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkRZaxdchsS8gQWcumncIkCzEiC6logyTNS10M7Bbx4g&oe=6AD0D4EC"}, {"file_name": "screenshot_07_2560x1440.png", "id": "2528106994294294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823783_2528107000960960_5872956236025966822_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi_tKzJbZc8Q7kNvwEmwJAp&_nc_oc=AdqlXmlKy2MvIgl9m_joOHlTLO8ai61vNL1Q2Xo746e0f_Tte0vicZoQOgj2Z1xZX4w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM59b0oPgxgUjjIGN1B_4JhlVgWdKVBnetlI5KyiU7VxA&oe=6AD0F5BB"}, {"file_name": "screenshot_06_2560x1440.png", "id": "2132178290681535", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825503_2132178294014868_4938998108962218285_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTgltlY90nYQ7kNvwHgvfF4&_nc_oc=Adp8ZAMG6Oek8yQ8ivB6ufXHMj8ci2kn1McawUVe01Mqfi1NGCBx4WMkKPc7o1S8luU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-XaTtGgIR-nFRZ6aajjRxhx2UyH4E49PquWX9o48bmA&oe=6AD0EB7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Zone", "keywords": ["liminal", "exploration", "atmospheric", "social", "surreal"], "long_description": "You've been here before. You're sure of it \u2014 the light, the silence, the way the corridor turns. You just can't remember when.\n\nLiminal Zone is a handful of places that shouldn't feel familiar, and somehow do. A concrete building holding its breath. A park with no edge. A city that simply keeps going. You step inside and there's nothing to win, nothing to finish. Only somewhere to be.\n\nStay as long as you like. Sometimes you'll be alone. Sometimes someone else will be here too \u2014 a voice across an empty room, footsteps that aren't yours.\n\nTake it with you, or leave it behind. The door stays open either way.", "short_description": "Some places come back to you without your ever having been there. Liminal Zone is a quiet world to wander alone, or with whoever finds their way in."}]}
qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZFGSAV16PGHseEAGP1gQnGEzaW5c_S6kGilYFJVm_iA&oe=6A942FEC"}, {"file_name": "screenshot_07_2560x1440.png", "id": "2528106994294294", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823783_2528107000960960_5872956236025966822_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PynAd3xwUAIQ7kNvwGHUpdJ&_nc_oc=AdoET_sHZjZ-PQxj1ggNOQUh2QaOIj8iyLZnib_p_bvgHgRNq45eCW-bxzjJ2X9WK70&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6qed995aUB6QCwIWIcMgeM_74d4SngNiTbFxoDNXwhw&oe=6A94187B"}, {"file_name": "screenshot_06_2560x1440.png", "id": "2132178290681535", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491825503_2132178294014868_4938998108962218285_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgeG5G8TLsMQ7kNvwEIj_qW&_nc_oc=AdomI9LcO48zW74EOglwc__gRPgNFTGnJ-N-ZHA199MDZX_zl-761u0CtcejgcvJKYw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI4Iw0G-Q2_S2XO-eVNijWJptePeJWQJVCFlQGaBwnjA&oe=6A940E3A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Zone", "keywords": ["liminal", "exploration", "atmospheric", "social", "surreal"], "long_description": "You've been here before. You're sure of it \u2014 the light, the silence, the way the corridor turns. You just can't remember when.\n\nLiminal Zone is a handful of places that shouldn't feel familiar, and somehow do. A concrete building holding its breath. A park with no edge. A city that simply keeps going. You step inside and there's nothing to win, nothing to finish. Only somewhere to be.\n\nStay as long as you like. Sometimes you'll be alone. Sometimes someone else will be here too \u2014 a voice across an empty room, footsteps that aren't yours.\n\nTake it with you, or leave it behind. The door stays open either way.", "short_description": "Some places come back to you without your ever having been there. Liminal Zone is a quiet world to wander alone, or with whoever finds their way in."}]}
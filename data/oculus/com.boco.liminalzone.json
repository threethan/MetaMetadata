iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwiLVuWuOU1Xbm_L8nwVrEy4pqghv5WalBHt8udsgdwA&oe=6A9EBBEC"}, {"file_name": "screenshot_07_2560x1440.png", "id": "2528106994294294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_2528107000960960_5872956236025966822_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfNGRSqq9uUQ7kNvwG1uHDC&_nc_oc=AdoT7L4ljFu8cU8EUUS4hmDxY5OT5j3x0hchrK1FD7CArhSOd4aaLsskm50l9wxVSZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx6PIxcml0HFXtiuBI-RHVpFrpMGvuf2P-ow58h390tg&oe=6A9EDCBB"}, {"file_name": "screenshot_06_2560x1440.png", "id": "2132178290681535", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_2132178294014868_4938998108962218285_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhrCNZBWeSYQ7kNvwGESopb&_nc_oc=Adp5LzeA1yO5bUSs40PMc_N6P_4IOkQbTFEwu9Aao36fk8pticBK-6tvW5tDuvp5lSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUEKkJ9z5mg2wG6xOmEx_KgekYi8Yajfqfr7AhjPL6ww&oe=6A9ED27A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liminal Zone", "keywords": ["liminal", "exploration", "atmospheric", "social", "surreal"], "long_description": "You've been here before. You're sure of it \u2014 the light, the silence, the way the corridor turns. You just can't remember when.\n\nLiminal Zone is a handful of places that shouldn't feel familiar, and somehow do. A concrete building holding its breath. A park with no edge. A city that simply keeps going. You step inside and there's nothing to win, nothing to finish. Only somewhere to be.\n\nStay as long as you like. Sometimes you'll be alone. Sometimes someone else will be here too \u2014 a voice across an empty room, footsteps that aren't yours.\n\nTake it with you, or leave it behind. The door stays open either way.", "short_description": "Some places come back to you without your ever having been there. Liminal Zone is a quiet world to wander alone, or with whoever finds their way in."}]}
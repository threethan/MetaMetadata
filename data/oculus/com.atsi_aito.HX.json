.com&_nc_ss=7f20f&oh=00_AQGWDIHPDkKgzcxQYJPO8MpxdTsGPEGEnaLAbPlgRiZEvQ&oe=6A8D8AC9"}, {"file_name": "SS3.png", "id": "981315902758504", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75203624_981315906091837_1741582177381006512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYek393L37gQ7kNvwHicrik&_nc_oc=AdoWDGo_JPquIkulVESjrhjX-g9qgKN7mWGgqyE-S_CrQ80dgXxDNItS46CwGUQItTw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb8mMPmteiv8zcxKYdBV5eQw5lBK9y28pfjhtFRC0cbw&oe=6A8D8506"}, {"file_name": "SS4.png", "id": "557067342277247", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982601_557067345610580_2643583288745186122_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlLij4BV9k0Q7kNvwHgprX2&_nc_oc=AdpY3CPBqZ2yrYFLDrWPCGQcQTUvxSo8eqpuRLs9VC8B-j1p51DTQWfA-bxE93qx8yg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2xb9nUe2Gp6uLV612dS8gfolrx-SX29527q4-J6jtSg&oe=6A8D9124"}, {"file_name": "SS5.png", "id": "2986662874985687", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974450_2986662878319020_5099916742723345427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhoOi8GULlAQ7kNvwHkuKkb&_nc_oc=AdojBRpcya3Mwt522bwV817nY6QmpfCCV_FlHgWDsh3RcfJBEfLX3sKH_sDNIUbx7-U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6ve2JSu9Z2UkvLWO_lR5pWH5QQLSRTKVFoW3j1453dw&oe=6A8D83E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "238958778249444", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982614_238958781582777_7266351533833194001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPmtgKG1Y6QQ7kNvwE7BLsz&_nc_oc=AdpiR35MS0SguSCDnpmQJv3IyQ1flMOojwXcKUg_ZJ4-O1l9UBuVRHIdIGjtE7YEv9k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIT17Vwsho1VfxK5YK_ip4kEQM3a-GbsUTUo-QeYFvvA&oe=6A8D8DA6"}, "display_name": "X\uff08Kai\uff09-HouteishikiX-", "keywords": [], "long_description": "Japanese-style command-type action game.\nYou will command the two Shikigami.\nThe coalescing attack is exhilarating.\nPlease experience the Youkai tale!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAlthough it is a command button format, some operations are also performed by gestures:\n1.Turn your palm up\nThe menu screen for each Shikigami is displayed.\n2.Turn both hands forward(Both hands are Paper)\nIf the item appears, you can collect it.\n3.Hold your fist with the palms of both hands facing up and accumulate power\nIf you have a Ofuda-item, you can use the combined attack.\n\n\u2022 How to proceed with the game\n1.Start\nPress the[Start]button -> [Beginning]button with your index finger to start.\n(You can skip the opening by selecting the[Start]button -> [Battle]button)\n2.GamePlay\nOnce started, the move is automatic.\nWe will command the two Shikigami.\n3.GameOver\nIf both Shikigami are defeated, the game is over.\n4.GameClear\nThe game is cleared when the boss is defeated.", "short_description": "Japanese-style command-type action game.\nYou will command the two Shikigami.\nThe coalescing attack is exhilarating.\nPlease experience the Youkai tale!"}, {"images": {"nodes": [{"file_name": "HX_HA2J.png", "id": "2897018147115213", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035465_2897018157115212_1361032452077869871_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzKbHLb_U_kQ7kNvwGChxhm&_nc_oc=Adr3ecHGUtat0si42E2gnt84SGAJaF7lf6tV7mhk1gmW6kk0g0MiBPt0coPMl675Ch4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8htPEN-8IZbvd8Y4pRQQrJAzyo5PPNmK10rB8F_VStA&oe=6A8D7642"}, {"file_name": "HX_CA_YJ.png", "id": "1201036327631942", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982708_1201036330965275_477785038644771750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ-P3Ii8erEQ7kNvwGipvtk&_nc_oc=AdpgJTKakf4suZ_OQA01G5AJJGBQ-bmwFuamlWjZe_Ja-u48x6OQe2J_YHSryb
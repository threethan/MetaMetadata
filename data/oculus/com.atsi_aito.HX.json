002\n   \u4e8c\u4eba\u306e\u5f0f\u3092\u6307\u63ee\u3057\u3066\u9032\u3081\u3066\u3044\u304d\u307e\u3059\u3002\n3.\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc\n   \u5f0f\u304c\u4e8c\u4eba\u5171\u5012\u308c\u308b\u3068\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc\u3067\u3059\u3002\n4.\u30af\u30ea\u30a2\n   \u30dc\u30b9\u3092\u5012\u305b\u3070\u30b2\u30fc\u30e0\u30af\u30ea\u30a2\u3067\u3059\u3002\n\n\u2022 \u30b9\u30c8\u30fc\u30ea\u30fc\n948\u5e74(\u5929\u66a62\u5e74)7\u6708\u67d0\u65e5\u3002\u4eac\u306e\u4e00\u89d2\u306b\u3042\u308b\u793e\u306b\u3066\u3002\n\u305d\u306e\u65e5\u306e\u591c\u306f\u3001\u666e\u6bb5\u3068\u305d\u3046\u5909\u308f\u308a\u306a\u304b\u3063\u305f\u3002\n\u3068\u3066\u3082\u7a4f\u3084\u304b\u306a\u7a7a\u6c17\u304c\u6d41\u308c\u3066\u3044\u305f\u3002\n\u5f0f\u306e\u4e00\u4eba\u30fb\u672a\u685c(\u30df\u30aa)\u306f\u7e01\u5074\u3067\u597d\u7269\u306e\u7518\u6817\u5b50\u3092\u982c\u5f35\u308a\u3001\n\u3082\u3046\u4e00\u4eba\u306e\u5f0f\u30fb\u4ee4\u685c(\u30ec\u30aa)\u3082\u307e\u305f\u3001\u305d\u306e\u96a3\u3067\u5927\u597d\u304d\u306a\u524a\u308a\u6c37\u306b\u820c\u9f13\u3092\u3046\u3063\u3066\u3044\u305f\u3002\n\u3053\u306e\u3068\u3053\u308d\u9b3c\u306f\u5927\u4eba\u3057\u304f\u3001\u4eac\u5207\u3063\u3066\u306e\u9670\u967d\u5e2b\u3067\u3042\u308b\u4e3b\u4eba\u516c\u3082\u5b89\u5835\u3057\u3066\u4e8c\u4eba\u3092\u898b\u3066\u3044\u305f\u3002\n\u305d\u308c\u306f\u6cb9\u65ad\u3060\u3063\u305f\u306e\u304b\u3002\n\u793e\u306e\u5ead\u306b\u4e00\u5339\u3001\u8ff7\u3044\u8fbc\u3093\u3067\u3044\u308b\u5b58\u5728\u306b\u3001\u6c17\u304c\u4ed8\u3044\u305f\u6642\u306b\u306f\u9045\u304b\u3063\u305f\u3002\n\u30fb\u30fb\u30fb\u72d0 ?\n\u96f7\u6483\u304c\u8972\u3046\u3002\n\u666e\u6bb5\u81ea\u5206\u304c\u5f97\u610f\u3068\u3059\u308b\u8853\u3060\u3002\n\u300c\u306a\u306b ! ? \u300d\u300c\u4e3b(\u3042\u308b\u3058)\u69d8 ! \u300d\n\u6700\u5f8c\u306b\u805e\u3053\u3048\u305f\u306e\u306f\u3001\u4fe1\u983c\u3059\u308b\u5f0f\u795e\u305f\u3061\u306e\u58f0\u3060\u3063\u305f
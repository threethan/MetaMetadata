.com&_nc_ss=7f20f&oh=00_AQHkBEvLBbvUosePTBil0vCnPeSaujkByDaLDDN1wFp83Q&oe=6A85A1C9"}, {"file_name": "SS3.png", "id": "981315902758504", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75203624_981315906091837_1741582177381006512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5Tnewqu5QgQ7kNvwFcD9V0&_nc_oc=AdpbqvjeotD63GkPzzygknJ6m12ZIyZFt7hih0KhVwH2Q6O9Q6uvIYHGrTaPgaRJSkQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbC20t5KDN-dunc7v3gLAmm7cAg1GF72JGChulKRDs2A&oe=6A859C06"}, {"file_name": "SS4.png", "id": "557067342277247", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982601_557067345610580_2643583288745186122_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2tkMyIL7XAQ7kNvwHxpInS&_nc_oc=AdqfFNXY6zwaoCZcw9fFTaN9G6pfFLiLTwWCrpmR1f09tQBiOgkP7ijMpr03nzGvtx4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh3XANGFvborX25ld3AVrzn1KyF_k2oixZo4nUfqbfDg&oe=6A85A824"}, {"file_name": "SS5.png", "id": "2986662874985687", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974450_2986662878319020_5099916742723345427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_clii2h88ckQ7kNvwGQtC8v&_nc_oc=AdrvLmZ-dEdLTyGD5IWrWrZYYgIpXjApRM-I5D5qNqTlO0tmWZInMgzKnnXZVs4UnvA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBByqgZX7a8_x3ZPMz7Y_PSSEElZ3lYlrWh7c299W5kA&oe=6A859AE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "238958778249444", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982614_238958781582777_7266351533833194001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZkSPuSR32UQ7kNvwEu3lEF&_nc_oc=AdqcUMOkarwgH_3Mu4JjWLA8e3EDY5YmTOzpe4fZz6dT0HXplsKfIUSnYf6KMRUzrYY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmhbRmzTc0Oja7kmFefafEGOSLAh7G3Iv5agfcVnR9bg&oe=6A85A4A6"}, "display_name": "X\uff08Kai\uff09-HouteishikiX-", "keywords": [], "long_description": "Japanese-style command-type action game.\nYou will command the two Shikigami.\nThe coalescing attack is exhilarating.\nPlease experience the Youkai tale!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAlthough it is a command button format, some operations are also performed by gestures:\n1.Turn your palm up\nThe menu screen for each Shikigami is displayed.\n2.Turn both hands forward(Both hands are Paper)\nIf the item appears, you can collect it.\n3.Hold your fist with the palms of both hands facing up and accumulate power\nIf you have a Ofuda-item, you can use the combined attack.\n\n\u2022 How to proceed with the game\n1.Start\nPress the[Start]button -> [Beginning]button with your index finger to start.\n(You can skip the opening by selecting the[Start]button -> [Battle]button)\n2.GamePlay\nOnce started, the move is automatic.\nWe will command the two Shikigami.\n3.GameOver\nIf both Shikigami are defeated, the game is over.\n4.GameClear\nThe game is cleared when the boss is defeated.", "short_description": "Japanese-style command-type action game.\nYou will command the two Shikigami.\nThe coalescing attack is exhilarating.\nPlease experience the Youkai tale!"}, {"images": {"nodes": [{"file_name": "HX_HA2J.png", "id": "2897018147115213", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035465_2897018157115212_1361032452077869871_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r83tv0bhuhwQ7kNvwEFd7Qv&_nc_oc=AdoaeuPga75AH8_OxcS7n6GVLZhXsEviwol_rd67FuckFzzHGFI-B81Fds11YGFF_0U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuBPvEBMf56pucUNz4o9CBXtO-7G4wNxzkxksyRzhWdQ&oe=6A858D42"}, {"file_name": "HX_CA_YJ.png", "id": "1201036327631942", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982708_1201036330965275_477785038644771750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJ_BkW3dWQMQ7kNvwEjJabo&_nc_oc=AdrFapdZWuuelnyHfwys0txQ7q76MUUWqb4Yn8xk5MqhPoUyV4wZAmynkjyakV
QXz24T_9KDvONG5NwOrz4Edx8hs9gr5A&oe=69B40349"}, {"file_name": "SS3.png", "id": "981315902758504", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75203624_981315906091837_1741582177381006512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0LwxLrtK9MQ7kNvwGdlEiR&_nc_oc=AdmUJ65aKYZcMkVpRXpRArMkOSk9n1N6VSbtUIPqfOUvDMVE_Om0rlc0bpnDjhuKOEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsyVt_UXxFr0875OGFzHZ65WuzZQmGfLcRvLtlSXKJRA&oe=69B3FD86"}, {"file_name": "SS4.png", "id": "557067342277247", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982601_557067345610580_2643583288745186122_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKBPIytaAD8Q7kNvwHqLsFB&_nc_oc=AdlAx7n0Ru9y1OfkjF63e9FM-Pi_tSVNP06CNm2gDcjRrM_a2OXpISfPX3bc6GeDOJI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzO8zlQ1F0V7DOE5TZCYZW3ZrieBthEkNzgmaEqHQ8YQ&oe=69B409A4"}, {"file_name": "SS5.png", "id": "2986662874985687", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_2986662878319020_5099916742723345427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1BmsU-ejpIQ7kNvwF1N91i&_nc_oc=Adl8St6azxhjWBcZL0fVJ9ADiHWKqfnSLRrNtF5FLgBB4_pmIdNN9yENCS-XYLpsUG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkbEGSleAy986QN5tznM-0mB_98XFLC2U7v62sop3rAQ&oe=69B3FC63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "238958778249444", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982614_238958781582777_7266351533833194001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3O5KwNshf4Q7kNvwFJVY8r&_nc_oc=Adn_cUuuELcr4mGYfWUJELY6sLDbN240YSEkuVKO9oGBuhFgE6Dosv45iDyMh--DvLA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxo48Qs7rz1Pr-DBkOpA7AP7Fw675xoNsvUdRlK_bJfYg&oe=69B40626"}, "display_name": "X\uff08Kai\uff09-HouteishikiX-", "keywords": [], "long_description": "Japanese-style command-type action game.\nYou will command the two Shikigami.\nThe coalescing attack is exhilarating.\nPlease experience the Youkai tale!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAlthough it is a command button format, some operations are also performed by gestures:\n1.Turn your palm up\nThe menu screen for each Shikigami is displayed.\n2.Turn both hands forward(Both hands are Paper)\nIf the item appears, you can collect it.\n3.Hold your fist with the palms of both hands facing up and accumulate power\nIf you have a Ofuda-item, you can use the combined attack.\n\n\u2022 How to proceed with the game\n1.Start\nPress the[Start]button -> [Beginning]button with your index finger to start.\n(You can skip the opening by selecting the[Start]button -> [Battle]button)\n2.GamePlay\nOnce started, the move is automatic.\nWe will command the two Shikigami.\n3.GameOver\nIf both Shikigami are defeated, the game is over.\n4.GameClear\nThe game is cleared when the boss is defeated.", "short_description": "Japanese-style command-type action game.\nYou will command the two Shikigami.\nThe coalescing attack is exhilarating.\nPlease experience the Youkai tale!"}, {"images": {"nodes": [{"file_name": "HX_HA2J.png", "id": "2897018147115213", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035465_2897018157115212_1361032452077869871_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DyFty0fvc4Q7kNvwGaIhYP&_nc_oc=AdmFompaGRVnD4jXtKPxEE0GevecFGw9w9nTch_qyxkRmo7wDMWyuScSVo8Ny1pXZlY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_rbLSfeO5h-D5nmwVu0Di98YmHwsvU8JtXDa_XIMjvA&oe=69B3EEC2"}, {"file_name": "HX_CA_YJ.png", "id": "1201036327631942", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982708_1201036330965275_477785038644771750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVpXlVVuhWUQ7kNvwGA77UO&_nc_oc=Adk-SEQ0em7S7mv7sxlYuhlIg-jQV6cEN8t27y-ooZ7LPKRiu7qRXk_hDeczRKkn2yk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=
.com&_nc_ss=7f20f&oh=00_AQEEQ52UwJqc4hk6yqUM6voMVFlR1CYWzaVCW0chhp9Org&oe=6A8EDC49"}, {"file_name": "SS3.png", "id": "981315902758504", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75203624_981315906091837_1741582177381006512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYek393L37gQ7kNvwHIUx-G&_nc_oc=AdrOA8xi2ApsYoCPLidGvEAIzaxD8MFXD8-jmaB7-9nTI7ecJac_xPi7CXy7T88-JaY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx7OdOfs5HRd2ybtnnRMU9Mw3DahUM7eEhkrmxgcrFiw&oe=6A8ED686"}, {"file_name": "SS4.png", "id": "557067342277247", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982601_557067345610580_2643583288745186122_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0IIAdnb_uQQ7kNvwHaQnBu&_nc_oc=AdpI82XL3BkniZ77Mtztzq-s7fYo-JNO6VoDhqPRErdoTyw_Suzrn3o36QAG0T76b2Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpfGSHpD0porq0aVBo6xox-n5ZdFdgXaTtRl3gKvWWJA&oe=6A8EE2A4"}, {"file_name": "SS5.png", "id": "2986662874985687", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974450_2986662878319020_5099916742723345427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbiXzQ1otzQQ7kNvwHJOKYP&_nc_oc=AdrldqCrDnRTymGKA1b8FdcXLtbMNYMvsrEgh98-CtXlLU90mHDsRjejIFiLJNOVL10&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtPOrak-cpJDDpBGPFHaR7gE47ESYImLE190ysriP-qw&oe=6A8ED563"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "238958778249444", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982614_238958781582777_7266351533833194001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=conF65rVKukQ7kNvwF-RSY-&_nc_oc=AdrFTiBsy8DJ2EnC6Py1yF3cp58nssfrPw7bedePYoPunzuooNOxwb7TMemDxjnE4Xw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9cY2XLOWnAspUNEUuL7C-KTrqFP3T664S2G-dgSLF_Q&oe=6A8EDF26"}, "display_name": "X\uff08Kai\uff09-HouteishikiX-", "keywords": [], "long_description": "Japanese-style command-type action game.\nYou will command the two Shikigami.\nThe coalescing attack is exhilarating.\nPlease experience the Youkai tale!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAlthough it is a command button format, some operations are also performed by gestures:\n1.Turn your palm up\nThe menu screen for each Shikigami is displayed.\n2.Turn both hands forward(Both hands are Paper)\nIf the item appears, you can collect it.\n3.Hold your fist with the palms of both hands facing up and accumulate power\nIf you have a Ofuda-item, you can use the combined attack.\n\n\u2022 How to proceed with the game\n1.Start\nPress the[Start]button -> [Beginning]button with your index finger to start.\n(You can skip the opening by selecting the[Start]button -> [Battle]button)\n2.GamePlay\nOnce started, the move is automatic.\nWe will command the two Shikigami.\n3.GameOver\nIf both Shikigami are defeated, the game is over.\n4.GameClear\nThe game is cleared when the boss is defeated.", "short_description": "Japanese-style command-type action game.\nYou will command the two Shikigami.\nThe coalescing attack is exhilarating.\nPlease experience the Youkai tale!"}, {"images": {"nodes": [{"file_name": "HX_HA2J.png", "id": "2897018147115213", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035465_2897018157115212_1361032452077869871_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzKbHLb_U_kQ7kNvwGOg_mP&_nc_oc=AdokjsHbBghO42f_C2V0cymI4iKYQ9taDfRF6YdPL34b7fEDkjLnwPckxJoX9fb84a8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZN6mp8qjnACOit8JF7Y_CDajGZ_BQGLHBLLI5YlYIaQ&oe=6A8EC7C2"}, {"file_name": "HX_CA_YJ.png", "id": "1201036327631942", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982708_1201036330965275_477785038644771750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0yqpHInu5oQ7kNvwFrTGVD&_nc_oc=AdolwThQJq3roEYcl0qFMTkXPMFrQciZuYmZeFi9GGPe60cZRW0FcjaR2SIy5k
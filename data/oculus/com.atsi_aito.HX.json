YeW1r161R-l1ttk-5-KO5T7NXzxzPmuQ&oe=69BFE0C9"}, {"file_name": "SS3.png", "id": "981315902758504", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203624_981315906091837_1741582177381006512_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VemEJPXZUA8Q7kNvwHZ1p24&_nc_oc=AdlkmvX5jzb2xcZbO6OoY0U0BizkhzNMbL2eQqcEeWbb-Ahk7_l_1j5z1x26oxHmAVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwM0QzaYkUHSI8seFpbwD5I2RJWi4NmL_vAu1YMEXy3xQ&oe=69BFDB06"}, {"file_name": "SS4.png", "id": "557067342277247", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982601_557067345610580_2643583288745186122_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIvQJrCeOBkQ7kNvwEvPLs-&_nc_oc=Adk4ExM3f7vTBe_3d4DJbW9epEAhdxjf4WYLTtKYn1ZtxEem00ykH_QzVxPyRZNYtZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyKRrbK581k517VgTGcRjdXokOAbmRndYVoHxA3M4cabA&oe=69BFE724"}, {"file_name": "SS5.png", "id": "2986662874985687", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974450_2986662878319020_5099916742723345427_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FDYgVFCLLkQ7kNvwFIeKdP&_nc_oc=AdlSm6Ya7VRWwmhy_LNxD2z58N-SNggjD3xiuT3tVekXFK7Hn3rgxaXJHfy0SNk5hv8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgE222J6rwOlkRa_ogvcKpRYEgvspvKYDzp_9CDQwVzg&oe=69BFD9E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "238958778249444", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982614_238958781582777_7266351533833194001_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhNdYhC0VWsQ7kNvwGMDz-O&_nc_oc=AdmPP4_r51o7lTETA08IvAP2NYji0wKF7dWCw0wmrcDc0hxW8rOQQdYCghIqFmXhBjk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEaQplQnR7yC_zJcDi6XTR3x4LU_hl-Od21Q3Sx3eLaQ&oe=69BFE3A6"}, "display_name": "X\uff08Kai\uff09-HouteishikiX-", "keywords": [], "long_description": "Japanese-style command-type action game.\nYou will command the two Shikigami.\nThe coalescing attack is exhilarating.\nPlease experience the Youkai tale!\n\n\u2022 Method of operation\nFor hand tracking only.\nThe move is automatic.\nAlthough it is a command button format, some operations are also performed by gestures:\n1.Turn your palm up\nThe menu screen for each Shikigami is displayed.\n2.Turn both hands forward(Both hands are Paper)\nIf the item appears, you can collect it.\n3.Hold your fist with the palms of both hands facing up and accumulate power\nIf you have a Ofuda-item, you can use the combined attack.\n\n\u2022 How to proceed with the game\n1.Start\nPress the[Start]button -> [Beginning]button with your index finger to start.\n(You can skip the opening by selecting the[Start]button -> [Battle]button)\n2.GamePlay\nOnce started, the move is automatic.\nWe will command the two Shikigami.\n3.GameOver\nIf both Shikigami are defeated, the game is over.\n4.GameClear\nThe game is cleared when the boss is defeated.", "short_description": "Japanese-style command-type action game.\nYou will command the two Shikigami.\nThe coalescing attack is exhilarating.\nPlease experience the Youkai tale!"}, {"images": {"nodes": [{"file_name": "HX_HA2J.png", "id": "2897018147115213", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035465_2897018157115212_1361032452077869871_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFN4OBzqxDoQ7kNvwHEnAoH&_nc_oc=Adn3P-38ExAutEwB2x9kvHuMgkXqkBaumaSzTXO3r3_NidCUpPDdzj34j2pu30qKbFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfjJrNp9ry9eCyfD3pO3e9yL_iqXELodKSL3CGsLt-Ag&oe=69BFCC42"}, {"file_name": "HX_CA_YJ.png", "id": "1201036327631942", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_1201036330965275_477785038644771750_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=em2S2rbATVsQ7kNvwFlmM5g&_nc_oc=AdmF-b2rDUuC6VpkvIRghi2bk14GuP5VPeGU3HLqP30UDAi4D9uBj7cKNrVatnIbNsk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=
Q_J13ci3wtfJ3nRY_CYjEgXg&oe=6A6DEBE1"}, {"file_name": "1.png", "id": "892530750514696", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310726_892530753848029_94871845166806888_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3Fol1EjPWYQ7kNvwFdrblZ&_nc_oc=AdrX7ZrM8KLeHgUebNNrU90-Wsytij0nuspX-n09euqlDoCtJ4b2NpFTdzvt0kRwEDc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIDBvnRTpdBquk8sSHazXdf8eehTRzI3O-3witAm9Nbg&oe=6A6DD2B3"}, {"file_name": "3.png", "id": "1354175680109922", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304938_1354175683443255_7100859878505488994_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHqcmmhpFeoQ7kNvwEDPQUh&_nc_oc=Adoo7cok2Wujk1FsJL6-KQDpKjGudaq9WdotIft6SFOtZ73pBjUw5fawpKfBt9tfg8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk-Lexl3qwm6FMr9uN7Vkooe47MFlYdm5nTeIf6KX-6A&oe=6A6DF945"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Go Kart VR", "keywords": ["formula", "racing", "car", "go", "kart"], "long_description": "Step into Go Kart VR and experience the thrill of next-level vr racing built for Meta Quest. Race across detailed environments, control powerful karts, and push your driving skills to the limit in fast-paced competitive gameplay.\n\nFeel the realism of a true racing simulator with responsive handling, dynamic physics, and immersive VR tracks. Every race brings intense drift racing, tight corners, and high-speed straightaways where precision and timing matter. Compete on challenging tracks that test both beginners and experienced racers.\n\nEnjoy the perfect mix of simulation and fun arcade racing action. Whether you love casual driving or competitive challenges, this game delivers exciting speed racing moments and immersive virtual racing experiences.\n\n**Features**\n- Realistic vr racing with immersive controls\n- True racing simulator physics and handling\n- Exciting kart racing game with drift mechanics\n- Competitive drift racing and time-based challenges\n- High-speed speed racing tracks and environments\n- Fun and addictive arcade racing gameplay\n\nPush your limits, master every track, and become the ultimate champion. If you love virtual racing, competitive driving, and immersive VR experiences, Go Kart VR is made for you.", "short_description": "Experience high-speed vr racing in Go Kart VR. Drift, boost, and compete on thrilling tracks in a realistic racing simulator. Enjoy intense kart racing game action with smooth controls and immersive virtual racing environments. Master sharp turns, perform perfect drift racing, and dominate fast-paced speed racing challenges in this exciting arcade racing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/photonhorizons/privacy-policy-prismhorizons", "developer_terms_of_service_url": null, "publisher_name": "Photon Horizons", "support_website_url": null, "website_url": "https://sites.google.com/view/photonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35206205835692116"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1013269357778065"}, {"status": "PUBLISHED", "id": "1028349603041991"}, {"status": "PUBLISHED", "id": "1704151447428836"}]}, "baseline_offer": {"id": "1704151447428836"}, "is_approved": true, "firstOffe
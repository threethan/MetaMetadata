vival", "multiplayer", "story", "robot"], "long_description": "**The Abandoned Complex is a multiplayer VR survival horror game** set in a massive, abandoned factory on a remote island. You and your coworkers remotely control Agent robots sent by your company, Facility Archives, to explore the Complex, uncover its secrets, and survive.\n\nThe factory is full of dangers, hostile robots and twisted biological experiments that hide around every corner. Explore old labs, storage rooms, and underground facilities while uncovering the dark secrets and atrocities hidden in the Complex.", "short_description": "The Abandoned Complex is a multiplayer VR survival horror game based in an abandoned factory on a remote island. Explore old structures uncovering secrets, trying not to get obliterated by hostile robots and biological experiments, while remotely controlling an Agent robot.\n"}]}, "developer_name": "Tanek", "developer_privacy_policy_url": "https://sites.google.com/view/the-abandoned-complex/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Tanek", "support_website_url": null, "website_url": "https://sites.google.com/view/the-abandoned-complex/about-us", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25857212853969156"}}]}, "scheduled_offers": {
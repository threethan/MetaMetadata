7&_nc_sid=6e7a0a&_nc_ohc=4-vcb0oAKJsQ7kNvwFrQkAn&_nc_oc=AdpG1cbuP961rfpYAvhBq9F1twaXK2OrMOmqFlLWgI6CQuizkcSzb_6lyJrK48twZhs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13uOIjq8SzVk7Ge9pfYx1eOnfZvq6QvKWEHAVVrp9PTw&oe=69F1F8A2"}, {"file_name": "75340702_2554172494756679_4996336072734693970_n (1).png", "id": "473410155201862", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031586_473410158535195_3839618700909000175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfHNE9hhFxsQ7kNvwGGIw-O&_nc_oc=Adp_ZFrQc4gJCIwdhNGBfUvnYcQtghHtY_hFFGbmjhM6QC-1B0GHOy3W0cbGi-RQ774&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1-QW_NNBbGTo6LCT0Bzd-WlWjq5BGo1kxUCD11-S3E7w&oe=69F20943"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Taggering", "keywords": [], "long_description": "\"Zen Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Zen Taggering is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns, flowing designs, or even abstract masterpieces\u2014all designed to evoke a sense of peace and serenity.", "short_description": "\"Zen Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zentag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ZENIX", "support_website_url": null, "website_url": "https://sites.google
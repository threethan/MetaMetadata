2317095725090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcmqXaQgDFcQ7kNvwFAB7lM&_nc_oc=AdkM-f59H97xBNWmg6oNMB3Sw0HfcIy9h_YrIVPJFXnl_GVXJYbW71XLaI-_8ZjvW-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyQ7lrXMGCdBGvtOxrKE7sStFfTGiY4tZd5uGFduKVcA&oe=69AD6AA2"}, {"file_name": "75340702_2554172494756679_4996336072734693970_n (1).png", "id": "473410155201862", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031586_473410158535195_3839618700909000175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qawLzj5UvOQQ7kNvwFBfQ_f&_nc_oc=AdneMoPZpuoSKkGyK5Fv0gK1apPDkQdWfckIAW82SFMutMf3CrLDqcG5Y-OIsXFHKNs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx07GcuFcNLWA0xeYK3anzBqz4vVQrYyInXuYuxdl1PSA&oe=69AD7B43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Taggering", "keywords": [], "long_description": "\"Zen Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Zen Taggering is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns, flowing designs, or even abstract masterpieces\u2014all designed to evoke a sense of peace and serenity.", "short_description": "\"Zen Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zentag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ZENIX", "support_website_url":
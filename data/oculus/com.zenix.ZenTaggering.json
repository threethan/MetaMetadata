193833_6171552317095725090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcmqXaQgDFcQ7kNvwE3nv7G&_nc_oc=Adlcr2Jr6IB8L12t7imvDSyQNnjEIjLrr0Rd8wxcsGHzOJUppZfWwNOGAecOTLzYcKo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxNY84ry7DcPwrN6Qkqpd-VfqBNKLidPzTRIGk2QgaMAQ&oe=69AAC7A2"}, {"file_name": "75340702_2554172494756679_4996336072734693970_n (1).png", "id": "473410155201862", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031586_473410158535195_3839618700909000175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryyFoM0zgy0Q7kNvwHBiqlC&_nc_oc=AdmwM-rvTJaKnWkNPDddSxTmkvfMyKs-t-kPIrj2kBp_ypgGi1TTUdSK7jtXVIorO8I&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBjHgWKNlBGzh0-QRumxyJK-dE190x6rlcdL_sV81W7g&oe=69AAD843"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Taggering", "keywords": [], "long_description": "\"Zen Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Zen Taggering is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns, flowing designs, or even abstract masterpieces\u2014all designed to evoke a sense of peace and serenity.", "short_description": "\"Zen Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zentag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ZENIX", "support
2317095725090_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRBAQ0k_Y5gQ7kNvwH76XEz&_nc_oc=Adnp8jCfOg9E_Q5JiJXPXHC216MH6iUstMPcc5csevxSECAIju8IPZKNHq8oSt6oMmY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuJGFza1YoXE228k_laWGwXQ0WV-aVFtedNIx4uOao0bw&oe=69A97622"}, {"file_name": "75340702_2554172494756679_4996336072734693970_n (1).png", "id": "473410155201862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031586_473410158535195_3839618700909000175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryyFoM0zgy0Q7kNvwFi1ZXP&_nc_oc=AdlaF4ITd15J0P0GWEfnQtXFC2L9-_Bjnl7onqoGBDweeZqrNsg-kdAQP2XMNw01gQE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvcpbjZqxKJJ7M9zVnOxO-jFtdmZaZnZWLg-lI5zQvDZQ&oe=69A986C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zen Taggering", "keywords": [], "long_description": "\"Zen Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Zen Taggering is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns, flowing designs, or even abstract masterpieces\u2014all designed to evoke a sense of peace and serenity.", "short_description": "\"Zen Taggering\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/zentag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ZENIX", "support_website_url":
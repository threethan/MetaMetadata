X7cUwfBBocOVWbt80lhZjxuHXlpwZcPMvheOkHMlCk1_-s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoRvxm-cxxfFCdUyPZ-Wl02yhfxTYy3XCKsya4FaELig&oe=6AA946F1"}, {"file_name": "ss9.png", "id": "1581331426307111", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823286_1581331429640444_7872995924709462059_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lK_lbXc45i4Q7kNvwH9nB6B&_nc_oc=AdqOnjONyun1IYnfqSFL_URmbh9iLTA8fNNb8l5rpvi03CEte2maqUqAGKO-QnLOasE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZKcskW5YdJzM9tmnlklLOeMGKCuyT-msQ-2gOPb7quQ&oe=6AA9562C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscap _2560-1440.png", "id": "939375715622392", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618512_939375718955725_9026633536255858932_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqAKXwPgo7wQ7kNvwE2_3BO&_nc_oc=AdoJD4BP3tQWdrhkXtyBhx9g6YvCGBBNbHO674PXKYyXhDln3TDjdLKvK7aa2kL0CjQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3vRVcW07lPvqQ3i7gvIIKquerOCmI9thVEVNsfjmZsA&oe=6AA96722"}, "display_name": "Peak Fall", "keywords": ["PeakFallVR", "VRSurvivalGame", "VRGame2026", "BestVRGame", "RealisticVRGame"], "long_description": "This is not just a game\u2026 it\u2019s a challenge.\n\nPeak Fall VR throws you into a dangerous climbing adventure where every second matters. One wrong move, one missed grip\u2014and it's over.\n\nWith realistic VR physics and intense survival mechanics, this game will test your patience, focus, and courage like never before.\n\n{1668591074578882}\n\nCan you handle the pressure?\nCan you reach the top?\n\nOr will you fall?\n", "short_description": "Peak Fall VR is a thrilling climbing survival game set on a dangerous island.\nClimb carefully, manage your stamina, and avoid deadly falls.\nOne mistake can end everything."}, {"images": {"nodes": [{"file_name": "ss6.png", "id": "1918636528777439", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491829120_1918636532110772_4715542523705086781_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WyvtawnutwQ7kNvwFspinu&_nc_oc=AdoZzD05niIyrV5rTGjnFGNG8lw2iX-6q2kqRVWRO-lbFKbqC0vRN_PtZdcXqBqoZaQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILss9Or8JAOHtHF2Pf9wgvPMFsSxkV5FlDwQ50bGzl_A&oe=6AA96752"}]}, "id": "1271370628535076", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peak Fall", "keywords": [], "long_description": "Esto no es solo un juego\u2026 es un desaf\u00edo.\n\nPeak Fall VR te lanza a una peligrosa aventura de escalada donde cada segundo cuenta. Un movimiento en falso, un agarre fallido \u2014 y todo habr\u00e1 terminado.\n\nCon f\u00edsicas de VR realistas y mec\u00e1nicas de supervivencia intensas, este juego pondr\u00e1 a prueba tu paciencia, concentraci\u00f3n y valent\u00eda como nunca antes.\n\n{1918636528777439}\n\n\u00bfPuedes manejar la presi\u00f3n?   \n\u00bfPuedes llegar a la cima?   \n\n\u00bfO caer\u00e1s?\n", "short_description": "Peak Fall VR es un emocionante juego de supervivencia y escalada ambientado en una isla peligrosa.\nEscala con cuidado, gestiona tu resistencia y evita ca\u00eddas mortales.\nUn solo error puede acabar con todo."}, {"images": {"nodes": [{"file_name": "ss6.png", "id": "869320296191591", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819356_869320299524924_2402585437574851140_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PtJuC0EQ9QQ7kNvwEp-sTJ&_nc_oc=AdpuGnxRS6RfKBNdVgyCiSEOd3dxJYr-ncgE9T6iMmshZINpiJBSjdiMPVoFui5-Rbo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvRss3BEV3oS-zNnhJYgz33OrlOFYIx2_MgmOt77Jj6A&oe=6AA95279"}]}, "id": "991713456587804", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peak Fall", "keywords": [], "long_description": "Ce n\u2019est pas juste un jeu\u2026 c\u2019est un d\u00e9fi.\n\nPeak Fall VR vous plonge dans une aventure d\u2019escalade dangereuse o\u00f9 chaque seconde compte. Un mauvais mouvement, une prise manqu\u00e9e \u2014 et tout est fini.\n\nAvec une physique VR r\u00e9aliste et des m\u00e9caniques de survie intenses, ce jeu mettra \u00e0 l\u2019\u00e9preuve votre patience, votre concentration et votre courage comme jamais auparavant.\n\n{869320296191591}\n\nPouvez-vous supporter la pression ?  \nPouvez-vous atteindre le sommet ?\n\nOu allez-vous tomber ?\n", "short_description": "Peak Fall VR est un jeu de survie et d\u2019escalade palpitant se d\u00e9roulant sur une \u00eele dangereuse.\nGrimpez avec pr\u00e9caution, g\u00e9rez votre endurance et \u00e9vitez les chutes mortelles.\nUne seule erreur peut tout terminer."}, {"images": {"nodes": [{"file_name": "ss6.png", "id": "813443578019119", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499300725_813443581352452_5756889001583000625_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBeV07ek7zgQ7kNvwE4NT6Z&_nc_oc=AdpEWWlvruOzfAK3ZjJaMzvwvgYrMMk090pZfQfMuOCz5Grqxvwrk_GVizQbXeV4a_U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGUFzfEuwqeAd1pnkbd5fbVhceiCJ81TkwvQDVrs23mw&oe=6AA95ABD"}]}, "id": "971862621962264", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peak Fall", "keywords": [], "long_description": "\u8fd9\u4e0d\u4ec5\u4ec5\u662f\u4e00\u4e2a\u6e38\u620f\u2026\u2026\u8fd9\u662f\u4e00\u6b21\u6311\u6218\u3002\n\n\u300aPeak Fall VR\u300b\u5c06\u4f60\u5e26\u5165\u4e00\u573a\u5371\u9669\u7684\u6500\u722c\u5192\u9669\uff0c\u6bcf\u4e00\u79d2\u90fd\u81f3\u5173\u91cd\u8981\u3002\u4e00\u4e2a\u9519\u8bef\u7684\u52a8\u4f5c\uff0c\u4e00\u6b21\u5931\u624b\u2014\u2014\u4e00\u5207\u5c31\u7ed3\u675f\u4e86\u3002\n\n\u51ed\u501f\u771f\u5b9e\u7684VR\u7269\u7406\u6548\u679c\u548c\u7d27\u5f20\u
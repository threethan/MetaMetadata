1-7&_nc_sid=6e7a0a&_nc_ohc=W8oo3MssebcQ7kNvwFssVIA&_nc_oc=AdoQ430KB2XSHzUD9_brDXM_bCRwsksQ0PcwqQu24dsEh-4OxBzYqY-P2dxzkeShyK4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_9K_SL2MbviAExTZg8rlv7P6biuFAGSRuwnhoR-zXjQ&oe=6AC79C07"}, {"file_name": "store-04-source-assembly.png", "id": "1548633643226364", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824318_1548633646559697_7297799975838773294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORhvFvQfi-cQ7kNvwFMwC-V&_nc_oc=AdqzXLkv0zuRwfwmsj6TZpPkqQIqmeFIJLQceNsnCqSerxfaEGVl7Cu4GABSodzYZKw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMBnAnIImd3pGLUid8dBR7mK706cnleQJ55l2_JRFFmQ&oe=6AC79AA0"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mm2dW2B_kkQ7kNvwHGwa8K&_nc_oc=AdpQbj_MiuCats5aWSGudjlMkbQyF-xqHC8G6P-nnd5-OFrDRLl4jV3bMYXde_fRFSk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHBbm4QuWoRpItDD4RVKRXhI13zYOuF0hpWYRN5OXc9g&oe=6AC7A422"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLI5YQJqvIQQ7kNvwHqSoVW&_nc_oc=AdrYNIooMV8n1KYY1tRM0ilWep1PTvB2BZrhgjr9FAFQgm7IvwyidWVvrJdQ7Suxk8E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkwTUnIi4b9tCYTNCDoEV2FzGfaF9cUENDX8TMy9mQjA&oe=6AC7CB01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30NBMfOm9MMQ7kNvwFioJjO&_nc_oc=AdrBGX_WmmqQ0O3lx0jA8xeqb_Xk2NzJY0MhT2YEh8zvtw9NqRDSfI3ZXq6_FZ_40d8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSMowidNoEiKPsjEi5B_wUSMhgEUQ0lMlVyRUJlJgGKg&oe=6AC7B912"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_u
284247573373749437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2lEVpRR2J8Q7kNvwE__j7v&_nc_oc=AdqoFeEdey8SkuPdu7EPVuZtnmiUSmvlDN1hfTAQTldlkqKrTXLg8D-znlfzfxU8z9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx-EdWT3K10RSqNNzXQ2vCVcIqVaq4KkN_NlIzdzKPTQ&oe=6AEDF28C"}, {"file_name": "store-01-engineering-studio.png", "id": "28369212106064136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_28369212172730796_5258581881626541407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Cppcc_J3LQQ7kNvwE_SZRv&_nc_oc=AdpJFXxC5jRM-Ybx1uirLC8yRYVncThBkOr8RmrLC6JKuNk4jiYLXoOGtVRP68gAJE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQimyqR-XExd7I-AKObXLeJ8Hv0YsCQCvOJCjlpb8-KYA&oe=6AEDD787"}, {"file_name": "store-04-source-assembly.png", "id": "1548633643226364", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_1548633646559697_7297799975838773294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UclfmPZYguYQ7kNvwHvJPmr&_nc_oc=AdoOnTvIdvu_7D2vl7FvleLCpzt3c51qFNrl7PlswQofBxXuH9aU6EkU_rVec9mb2vM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbL43cupyqVTAYzNCAkLVMfDMIVZuehE4V5VxtRRF0IQ&oe=6AEE0E60"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tf1GnMM84KIQ7kNvwGP_cYV&_nc_oc=AdqzYrxmGhL3C-h2lcowGJaPbOk5nqR81uJJx8IQHc6OAfRE2CTX3JtRR1Vwe-dUULw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLtxB4rVGABKGK_qNpvdIvIEqek1NQY8O2-gdOA14YCw&oe=6AEDDFA2"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxDU10dXs1sQ7kNvwFvyIrk&_nc_oc=AdptmClr_08uqVO0hwkRQ7_dkp_H9tvb55_1FmQgeZeWogHHnEgREGc7c3y4joIavJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRGm3O7W5HM3peniY8mvAipa-sf2jioOrcFbLx82YZ-g&oe=6AEE0681"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNU9unAxEbkQ7kNvwHPUd35&_nc_oc=AdpQBTR_mc74wusV1DA-64GINRvVyILM90YNzkR1IClG2mRj7p2d5fW9lB-5FTKju7E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJYpGzIxm2D1ajLAevH7xyOEaTxukz0qthrBtSPkf7-w&oe=6AEDF492"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/robot-atlas/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/robot-atlas/support", "website_url": "https://nebulytic.com/apps/robot-atlas/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310224485506905"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_933927685940396_3040017305052197031_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEdTS0_sv_kQ7kNvwGh_YHI&_nc_oc=Adr439YY4yuXmsfPggO1g8zjHqlzciM_UDppRiUw-fGPzy1mX70sPi9gCnDapSkdy9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGbV26R45s4wWJvalB8YpkMbrRLWasRWy6Fbc0__0zmQ&oe=6AEDFB50"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RobotAtlas", "
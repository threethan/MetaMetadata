1-7&_nc_sid=6e7a0a&_nc_ohc=ruXUxntR5h4Q7kNvwFCxuM-&_nc_oc=Adp6wz9gMIoB32SHe9Cwdjt-N3y3PNa2wDbQjSECFaNQ14VQ6JWx958jsASRETVoYNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhIuvl2b0VRIjmiEU8HZv3PleGLxsmVUXoAp8rzMtSRw&oe=6AC25607"}, {"file_name": "store-04-source-assembly.png", "id": "1548633643226364", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_1548633646559697_7297799975838773294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ljpeBhramwQ7kNvwGfx2OQ&_nc_oc=Adp5crGwdAiyBgQshCKhZD6nzCz1ljf4mPRdOR7IcMEMyPIGHL_17z4owzK-9QJLhMs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNGGbkQYx47RF4pWVUOhWxXPw19XhSt33ewm-zChsjlw&oe=6AC254A0"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4bNe8gJ4UoQ7kNvwHDHrDs&_nc_oc=Adpsmo0H90iSbOTV7j0BkHr9DZNoRb2YNZNv5IP8NKc-yJlHeI7D4rVS11f5ArIHNVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB_BL0zI3JJUY1zgrzL-JyHwKlkV8W8OOsagwBuBSqiw&oe=6AC25E22"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQ_QwsmPnUMQ7kNvwHI69fr&_nc_oc=Ado9TA9EovCdFnBx8M4fTopMNjuedgWU-XTAJtxmTgOn7vWrfw2RzmehlbAngAHvXU8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsjgIMu4N6dVw6UvIrvrtqdAkDm18mfjW_6o3iq6gwEQ&oe=6AC28501"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dv5hwyQfNkAQ7kNvwHHzInp&_nc_oc=Adq--rG14FonhXwhOrAr3bABNgHgz_FO1CujuYgWYIuRg5jh9Ma4vAYuUEye1QzKuS4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbo57GQaAcZEKFe5XJ2mx4sxvFc1w8Ilva_sRsInNDdg&oe=6AC27312"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_u
31_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9nlYv6rhs4Q7kNvwFDLZrJ&_nc_oc=AdrWYnhtgBegcSg-dx0O4N4V9zEpkO_Eli97VZNXoFCjOzGahiom01YYQEH2XRkLnZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtwxJexgtdVR9-m8bpcfDOYAsYiKAPX6k9v2mTVu8Cuw&oe=6AF88750"}]}, "id": "1713464713698012", "locale": "en_US", "screenshots": [{"file_name": "store-02-color-hologram.png", "id": "2585549218561228", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_2585549221894561_2284247573373749437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPS6dr-1lkEQ7kNvwGF_fSr&_nc_oc=AdpK5VUFVEjIF2JrQtcbSmFzBMbeU9ckegHjZIG_sB_dJFqdMBsutriPq0_7jSNh3Gw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm-u4NnP0z-l9t-Fi4nrjffnk_lIYSHj5dMDkRNFkCAA&oe=6AF87E8C"}, {"file_name": "store-01-engineering-studio.png", "id": "28369212106064136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_28369212172730796_5258581881626541407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrJ1LHQxZ58Q7kNvwFI7Jo9&_nc_oc=AdpI_gJ2dlwJz3AlAHcgz1xPjXXOzaqJJzp2G4tPnB32SJJ58aIbJ_yHttDSRxiD-mw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlkdCI8rED2GbWvbY2-Rb-Rx5RHV-hfWuVoD1EC1n80A&oe=6AF89BC7"}, {"file_name": "store-04-source-assembly.png", "id": "1548633643226364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_1548633646559697_7297799975838773294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lcp6PF4qnDAQ7kNvwFkTtyy&_nc_oc=AdoddDP4lABqcZNhalz70ZNmptXK2RRjPcdXJbaYLV34w77vO0C3P8OTZrZkcKumzqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1OSSpcyrqR3NYBHHvrUpOZ5B8nayYCZd8lz5i5YQw0w&oe=6AF89A60"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjLKF7RGvmkQ7kNvwEc1_-Q&_nc_oc=Adonch8jiJfA_U8VBdrfnTF6K838dOOhOGOP6bYXCXW_lFd0qceUcHwmchZX23sSPJQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOmUXE4CV0U6VPE3ioL1v7cyYAcDnzXNS-VbQX0XOZ3A&oe=6AF8A3E2"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k28yayC7-28Q7kNvwHRM2gr&_nc_oc=AdqG_SUm-opqltXh7unGwH3N3zj16OXX-q43Sa0FKnFeXrnTE0R1NpKnCLfDkBVwQCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcg4S5OLA29GgLy65rEPZho8hEbuzGdFvPxrwEQDKmuQ&oe=6AF89281"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8IT84g5sDIQ7kNvwED2ua7&_nc_oc=AdoERYB_kxdk9cHV1Rr23HOhE4O-CgkyasKK3mJLkkzlIOqwIbuhLjAWaOaAC78d3-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl8LhOc58JAgmqNWUj3uyK9Rdv385KNDS5At-1HR5hHw&oe=6AF88092"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/robot-atlas/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/robot-atlas/support", "website_url": "https://nebulytic.com/apps/robot-atlas/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310224485506905"}, "review_messages": []}]}, "cover_square_image": {"ur
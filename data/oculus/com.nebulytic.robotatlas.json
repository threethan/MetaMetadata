284247573373749437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M05lKkUN7wUQ7kNvwGfKTsl&_nc_oc=Adp9THOKls44-naeNZz-Bl0McgcxlPK-1yZGbUcSEsc8G0MmG30VAQZgh1YH0_NHOJw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS-eBtFw1IHLnGzoGQwdQsp647mopv-zLFMVAKgf_uYg&oe=6AEB4F8C"}, {"file_name": "store-01-engineering-studio.png", "id": "28369212106064136", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_28369212172730796_5258581881626541407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Cppcc_J3LQQ7kNvwHw0LY_&_nc_oc=AdoDJFjSB0qxTtFB3T3H-CJSLQzGJUeW193Y-2XNhmHLVzKWK2ozRxKE1gGTOmDFkjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDL2w8ORfDctoHaOXb90VJHbFh2aiTMjwJ01VN6BjmDQ&oe=6AEB3487"}, {"file_name": "store-04-source-assembly.png", "id": "1548633643226364", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_1548633646559697_7297799975838773294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UclfmPZYguYQ7kNvwFdo7S0&_nc_oc=AdphIDeBR43HEFCaQSHBcDrJu3gCwVEulZgJjlTdCBFIvnrrIZIoJqHUXWz8xVrq-L4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkVwzBVyg7rXdpRfZxa4_Q7Xu_vro4S1K4yu8sp_AXJQ&oe=6AEB3320"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSyu845MANIQ7kNvwERCWev&_nc_oc=AdoMqvoSpe2WjhupvHlsCf5cQ5HJ68IuNC6MW54oNPuha6EYpXMdDUjSbCacy0U0dDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXWCo1eFU4Hk1UIbfZR5nTSEQQTdATmQSS7SEG9uhvTQ&oe=6AEB3CA2"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxDU10dXs1sQ7kNvwEpV0EM&_nc_oc=Adrtj7aWX0nb9Fwac9jRUcE1SonwfDLU526wti_qOtPElwtA8XwiUuPs9BPDAWKnzg8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG2rMdJbs8yAicaVW6dj9ZOIv9mVHUQzP2xFm-qWGZ3A&oe=6AEB2B41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKr8SzqLjW8Q7kNvwHvDGxE&_nc_oc=AdoHZ__KdJ-4twpZoqNQp2oReJFASPOoNgjb3FaC7HBgwUQX9pdnKN7cdmAx3Fif85E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqEUI02ixuZ-7R1XVpkMGVS6PizSp6wgy08no-qtsA4w&oe=6AEB5192"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/robot-atlas/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/robot-atlas/support", "website_url": "https://nebulytic.com/apps/robot-atlas/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310224485506905"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_933927685940396_3040017305052197031_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOq35dFQBBsQ7kNvwHuPwMR&_nc_oc=AdrJtnuJtgScdNlp5yPOeOh97A7usel5Sw8I8fksySndSySOA8LQByxbkKwlMwMGy9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCRfYa9cvE3uz-R4ze0taRa1xSSGg_gonilDp7hdbRDg&oe=6AEB5850"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RobotAtlas", "
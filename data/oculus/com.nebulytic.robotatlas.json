qj6sUffa4SGoRaKbv3Y2iYy3_dmdP1fcBNT79bqrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7msDr_GvHwfS2X3NOnT8iWvqEWK9zWSBxFFdBFmfjxQ&oe=6AE9FE0C"}, {"file_name": "store-01-engineering-studio.png", "id": "28369212106064136", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_28369212172730796_5258581881626541407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyyFoOHZKqsQ7kNvwGsz0FT&_nc_oc=Adqh1dOMRqTxQkVBAOcjr0ldegi7lUTq4ziI5i-z_8SKpQJR388Lfyiorrt6nbPYTEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsq767SolSj6ztJnITTfkKgk7hRqm2RJjBbKztuDlEGw&oe=6AE9E307"}, {"file_name": "store-04-source-assembly.png", "id": "1548633643226364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_1548633646559697_7297799975838773294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sDN3ZR41UIQ7kNvwH1U0_w&_nc_oc=AdoI5QyymfCOsupz3lj85DTCN8z5CHxRaygU4Z-vNPrYXCNgIzSc1SYD_Ad-38zdSLo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3GE4lmEbaxlTxmaugVifdjPgNBnlCJDlcj7ICwWzBYg&oe=6AE9E1A0"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSyu845MANIQ7kNvwGRrEBi&_nc_oc=Ado4xpHDp1tBBX7fLunoPbPSqjpPTnCkZlzeOewG6tRD-oANOD4k0PjkDlNcBVjboLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAO6JEC_wQPfq5R19EJakcTrBQx_zOBODgevokVeyKJg&oe=6AE9EB22"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0XetE-jguwQ7kNvwEzSPyS&_nc_oc=AdqIWwiOaaPhFQ9InHH9VCkxAlCPxm99fWLTUai1uexMGN4KbdvP1_e_CQ42apRRbtA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRREAmcIRfQxFnJBg_1Z7HjLxVGU67pBICsr_NUgVTHZw&oe=6AEA1201"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKr8SzqLjW8Q7kNvwGftU4L&_nc_oc=Adpng8i3URrEAlU_H2_8zg0d9mzrbGS2xZbG4dUJLtewHbIv4byKXj6hisgfA8VdqXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMUUrlzFnfkdy8DrW8cuPZZBW8D3nbkO-FIPNHaz-BrA&oe=6AEA0012"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/robot-atlas/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/robot-atlas/support", "website_url": "https://nebulytic.com/apps/robot-atlas/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310224485506905"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_933927685940396_3040017305052197031_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOq35dFQBBsQ7kNvwFme8eK&_nc_oc=AdozG2l8PBbwhfSVNQELdhDxE5DiOdFOrKq5IliYvkBGMHsQq9Pfijl0dBoBM5IZVlc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8G207WdNaz2PKxIxF_uO2Wjz7-WveqgP_JuPWSNfqcQ&oe=6AEA06D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RobotAtlas", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"to
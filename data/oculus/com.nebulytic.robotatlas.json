1-7&_nc_sid=6e7a0a&_nc_ohc=1lUEm1835ncQ7kNvwEy0I0p&_nc_oc=AdoNEVlWMplhO6m63J_xdUjnrsNjxQaj8AMayEx1uK3yoeyRHnKdju1xzroEm7KIooE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3pBOHO6y8c0G0oR28h9o9jj6B12RLbvpe4FQ4DcR7oQ&oe=6AC64A87"}, {"file_name": "store-04-source-assembly.png", "id": "1548633643226364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_1548633646559697_7297799975838773294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KU5Gg7opFUQ7kNvwEiKcqg&_nc_oc=AdpYMvvslKOw_8cYqjKdyXObd677xHqCaysySvLSdQ9huaGqD-y5FiEU4qk_lfEznyw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw2F8buuRVs1GjlEeatd-gL1Cv20h57voqrnoXcYmbQw&oe=6AC64920"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mm2dW2B_kkQ7kNvwEidl5m&_nc_oc=Adpm7t4Esk0fB5Hc4KeX5lUfjPCncAWQyDkQD_UTlH6kGR3krb38LqbQ8iOe7nUyuk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdMkyu0KkGDdCXuxxDH3Vv9uWQf372YTjgJrfa4EdQ3Q&oe=6AC652A2"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WUP46qPGroQ7kNvwEVu02e&_nc_oc=Adp-VipY-LjN_lDqs6QnV9aLWZ9fYba2vYbTml1jlVEudasaMp2X1p5_VTvRir1otok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTiJQvk77zll-O9C4Rfr7Y78c83q62E2qf6iFUepqvSg&oe=6AC64141"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30NBMfOm9MMQ7kNvwEuGaE6&_nc_oc=AdrzOQY1lyiDir4ZS_GSkXRBY936YIllIWrOdR0jJoZ8e0XtfHSb8r-mt5m9sYvDjOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNosNL3g6GKM_EUp-EZFTwUtTwEc--towiFawHWIflWYg&oe=6AC66792"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_u
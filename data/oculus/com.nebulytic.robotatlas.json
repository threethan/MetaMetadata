1-7&_nc_sid=6e7a0a&_nc_ohc=W8oo3MssebcQ7kNvwHPlWxH&_nc_oc=AdovqL2LWNtSjcZxqSTGlEDnkEnb4pmFwjV6Drt52aDG0peX8fU_gv-X5gpnoEci4fg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrMZpkSz9sDMO3IzCLAnNcAKWFoyXxgrFk6Fv33XHchw&oe=6ACA7747"}, {"file_name": "store-04-source-assembly.png", "id": "1548633643226364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_1548633646559697_7297799975838773294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORhvFvQfi-cQ7kNvwFRfiR-&_nc_oc=AdrQUoNgdbykcxUmLYK55lAgIY_RBRaNEyVV6XYP0DbL77wrH-P2g7kdYY-kY1yoYtM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPLOYzPv8cwx-unfXtaEWNhJ7CKdPcolnPeQN2FWb9zw&oe=6ACA75E0"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZ7MTnlOnbIQ7kNvwHqXpy3&_nc_oc=AdrBAIPZnUsTqa3R2mHRySxW-6lFD7cqicEK96OLFWPPcpc000r5QOH4nTs_HmTrsHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBi230r9KoMsgcgtyRLzsbLEu_FEIVQeufc9TCiIBEcw&oe=6ACA4722"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLI5YQJqvIQQ7kNvwE-i9Mh&_nc_oc=AdphNN6Jcc-WQvDGCv5MJvSZ9qllDoIgmQE9rPqBq1AsonUqIvCxk5J9XUQHnpOr2ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMipjDz3OCxEnc_jlqRbySao4FKKg9vQEQ8tNt_0PNb4Q&oe=6ACA6E01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHDzL3FanvkQ7kNvwFls08T&_nc_oc=Adp_goCd_P79k3plwr7DstcNgFONEKWXmsBuBIhI-bBPt47V6wtxHNdOrQSHsufgM_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzgSjs3mgy7W8Tz4SQPK5kXoZNbQoPd8ngR3-1lsHPvA&oe=6ACA5C12"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_u
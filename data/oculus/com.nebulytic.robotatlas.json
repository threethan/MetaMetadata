1-7&_nc_sid=6e7a0a&_nc_ohc=1lUEm1835ncQ7kNvwFAdAHR&_nc_oc=AdoCUAAo840fjPZHj3X8mx1ZH9ugVx5s2EtqZKO51tBFsJmlRuK88wD3zIPBX3mHmM0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ-64ouyPmta7TI1DBMn73yONPnZmx8oTHg2dx5-ZY9Q&oe=6AC4F907"}, {"file_name": "store-04-source-assembly.png", "id": "1548633643226364", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824318_1548633646559697_7297799975838773294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KU5Gg7opFUQ7kNvwGoom_1&_nc_oc=Ado1Tk3ghitRRzqVyCGC7tk1eZ0j1ZJv5CHx12EiLtRf_kxchWZHGsUQF42Fc7kz-ok&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-2mkbfJJcHvFv2cSIC9OULdQjYoS9LuykXefqtPG9uA&oe=6AC4F7A0"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mm2dW2B_kkQ7kNvwEVjoRt&_nc_oc=AdpmeTckVtB3RT4nIWdUxUUJHUSzl3kdU4PYex_GlvxG6eGOTVVT1xzfgRZSQcfk7H8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGwindSCKm-SjEX9Zqrr40BytsuzdT2VmtSPiSLYAj_A&oe=6AC50122"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WUP46qPGroQ7kNvwGcAHvi&_nc_oc=Adr9EjRpIsPK_Na55vWm2cgtz0k_oWQhLcANn_GglhRr5WmOOPJ_ZTPI6rU0J5SSrpg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4gafSTryvcOe-Sph2UEn9RjNpG6SY9jtE3DsSBnU8lw&oe=6AC52801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dv5hwyQfNkAQ7kNvwGzG9CA&_nc_oc=AdqGDlfggjlorUC6wdcH6rNt9sHyXRVyigo40DapEe2dDZ43IOrLQkfL0aE3BWL93f8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO08wZh6ojs4R72PgRi1lnXG4XhZY7S6FABvsWlKB6UHA&oe=6AC51612"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_u
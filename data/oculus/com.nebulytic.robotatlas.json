1-7&_nc_sid=6e7a0a&_nc_ohc=EHRyCG7_DFUQ7kNvwEl20ux&_nc_oc=AdrOa2cAu1gnV7c2cSFVatGc-CWMPX50GMNjwO6v0zr_v-yXgwUjlnQRmyyqRLWLSWo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfm-dDHW0A1_SYhASArj5MNhfewxHnQq1uda8I2RuR4Q&oe=6ABE6187"}, {"file_name": "store-04-source-assembly.png", "id": "1548633643226364", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824318_1548633646559697_7297799975838773294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JgYuYMe5KQQ7kNvwF7taAJ&_nc_oc=Adp6JlWS0Y4MAFXG1gu36s10W1yZXh4AAvRpO_0pwiPceRwjHVFG_9b166WV7Cfq8xw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbU2g1UwwLgsBBWkpiA1OfyQvhXUZ4VMG6685IfriwIA&oe=6ABE6020"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1kNAL2Mv5QQ7kNvwH4KvVM&_nc_oc=AdrjG9x-S8ajzIyeg1dFeDQGCr9Qd_Fu8tiuzyXbE0q1jeqcStpg9ZJ5ebkU1aBhFm0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo74D5ftGKGhcHNRbGHwX5Hs26xYtLrKoDI3MBp4p0OA&oe=6ABE69A2"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUZpnERteF4Q7kNvwHWMGEm&_nc_oc=AdoN0i3TEBH4rLpPU9xRlojW4gWHpj_tiWOubCV35YtB4fQlYb6SXvsZJIVDBwTcI58&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4L70Ea_MmbjA30PQDhVJ-JNgvPBnpks1Izmw97v_E2A&oe=6ABE5841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzCFbbAfauwQ7kNvwHxcM0D&_nc_oc=AdqxR-CZf3IjjpUsdudsTfRPWXodh-QI7C4CxICbyLM7R0aznC_XHyfbG-yVrdjgmYA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKni1Tv0NcILxPirgkry4UYgmJfTVjC5aJDeCVlM9bLwQ&oe=6ABE7E92"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_u
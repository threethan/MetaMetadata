n.com&_nc_ss=7f20f&oh=00_AQMcNkyueSK_SouoZ4mrQQTbAtDb73Oen0FFol_X5iBhpA&oe=6ACE6A60"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NS2uqm1PQu8Q7kNvwFRbvlx&_nc_oc=AdpBnQ7SeWTPvejQ48qCu8g-FHGzlF8fDvQwWmvSkYLcakrA62j_MsWoqghJ_16hR2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL5vxYXzRaNcFTR6vlEKtVAWXkYUk-OEQ9qpcCjewTZA&oe=6ACE3BA2"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Psrgsk7swugQ7kNvwFsDaVz&_nc_oc=AdpNM5BCXkLWqFhKPoE-1zPsq0j9TL4c7K94OBGJWQLQQr9nISzPB3MXZY9Md_KvMyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj93tRxzxmk2k9UkbAHsaHzJIINRxMNGeEku3446YKFA&oe=6ACE6281"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9ysMvMiM8gQ7kNvwGlhbjf&_nc_oc=AdqBig71soQmmJULci2A0K7ws7CrObrb-0cOjPYxeGGofKSYQa5CpkvgzwKSG_-X11Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMknO0yRtIl0HHHMZulCE_rq1vpR0r51HSskkiDTFtNYg&oe=6ACE5092"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/robot-atlas/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/robot-atlas/support", "website_url": "https://nebulytic.com/apps/robot-atlas/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "
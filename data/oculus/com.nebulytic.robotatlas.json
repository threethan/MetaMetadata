1-7&_nc_sid=6e7a0a&_nc_ohc=1lUEm1835ncQ7kNvwF0iO5L&_nc_oc=AdpSHvTjCivLKrJyMx3Nlfymn35zgLc2mLfusNUeQwYIVGLOvs1zcr__PyohyRZII4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE532mIOck7ChQppNojOPUSXc-sz8TDq-IyJyHhb1dng&oe=6AC3A787"}, {"file_name": "store-04-source-assembly.png", "id": "1548633643226364", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_1548633646559697_7297799975838773294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KU5Gg7opFUQ7kNvwE4XtYa&_nc_oc=AdpiWoFrZrCOh0zUKhfq6AuL5Q3Ue7o8QDXvCv7aO8b7fFscq7aYIOimZYR9UPdAKzE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5I-dZ61w9OMWNITRztQuvJ56kp-G66U0H4L32qZf6Ag&oe=6AC3A620"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4bNe8gJ4UoQ7kNvwEC_l3T&_nc_oc=AdqLtuthmpKod7Vpm4QUk2dG5ZlS0CBpbKb8Gf1_P8E9gJeajnbD1J42kDjyJXQNAYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTV5RD34ZG0bdLiYcTW9dRxdx6SCBO-Vjxk1QM4x4v-Q&oe=6AC3AFA2"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WUP46qPGroQ7kNvwHkMVfe&_nc_oc=Adp8dzmDDfxUUdbyuTYbvCNq43ySF061ruFsfJeCmbdkW_vtDAbIKrNtpvG3O4mOs7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYVggv20qPlYgLyb7A1-7L2Vn2yzUWCAe9hybu7F1D6w&oe=6AC3D681"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dv5hwyQfNkAQ7kNvwHtlvFm&_nc_oc=AdqsbnOJ6yUeTcgwIAHzaPM3lvV2KzoSfqaErf2H2LFynoM1q3sw06FfMQs4sZPHS-8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVbEN2ko4fzdkMPJT1Af4eQ5MjeNCgJarAWVq0VuQbpg&oe=6AC3C492"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_u
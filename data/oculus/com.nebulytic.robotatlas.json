1-7&_nc_sid=6e7a0a&_nc_ohc=ruXUxntR5h4Q7kNvwEHnc_7&_nc_oc=AdpMqG11mhPvkSpyC58NbGfQ_uowUS67yui1B4Cq1ZSsY3cZpot7CUM8NTkpg1X-J8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5lXf8UmsII4_QeF7HeGVBsX5-jd80sXc5yhBNZNnMbQ&oe=6ABFB307"}, {"file_name": "store-04-source-assembly.png", "id": "1548633643226364", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_1548633646559697_7297799975838773294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ljpeBhramwQ7kNvwG4J5-6&_nc_oc=Adqx9RdwEXvhwIj3uCA8DI5ZI4p3tGdslFW-o--ze7RaX4OyBtPO_RGLOh3SGq6ueEY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp_P3_or8V-hLgZlJ8-PyjSqb3m-QRD3xgdII6YYYL1A&oe=6ABFB1A0"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1kNAL2Mv5QQ7kNvwF2oJZD&_nc_oc=AdqvP0dWBFjbx7XyPQ8bSciUb4506x6COYubtYcFaWN-PII3sI0CjbIY9I1FQpjU1Nc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6kl73RGtaAiPmp_G-rWyWOEYgxHRMjpEng6AiXmx4Lw&oe=6ABFBB22"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQ_QwsmPnUMQ7kNvwEDqdii&_nc_oc=AdrWkfDz7Ems9VVJ9j4G5sOQ-jLOodvb5YFU3JDHugk0GrbrEcy4h-1OVErQF6cT69U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxYmpOPJ92BZt2QJOUHbpkUw0GipM0pyOcW43G1uF61w&oe=6ABFA9C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzCFbbAfauwQ7kNvwFQ7hfP&_nc_oc=AdoTMwYsMDWd3oCk8BVu1_VTj7L4zN-0kxv-ulPrXy60MtV0guz_peejtCkjHvsPU14&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0AKRNL9mtzkU53HBIeGct5PEmidV435bOE1hLqFmZjQ&oe=6ABFD012"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_u
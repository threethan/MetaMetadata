NvwGefuDA&_nc_oc=AdqfSyPcQktlf8_2P5w8gGtGA5KZLLG_8rKtT9a34vYr4yNThz9vSBItey1-2wEcIYo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZCBccn7C1rqBcWQW3AOnyqIss3csRA5IRqfcMCuPgpg&oe=6AE89020"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSyu845MANIQ7kNvwF_Yv8k&_nc_oc=AdrLQXJZLGndwxIfhtZ_CK2qg8WseoQ3Bii8iZWqk3r0FMeYtPaLgFhkyFaNqrqqowY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE8gic7exV1dYkxxZxCFstJgl8N9xKSP3zrOhNtVdlWg&oe=6AE899A2"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0XetE-jguwQ7kNvwHMjlgJ&_nc_oc=AdrXfIW9rKpNpfjYzAmP8WgjlGrLMfPKrdd5eZRnBeKK2H-U15-a3MCnESaJnTcM6bg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFj9sWURYn2DxjQv0g-D5NATGHNGZKEL0tSBhz2BEeRw&oe=6AE8C081"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRy1Y2vbpSUQ7kNvwGV6oZT&_nc_oc=AdrcsDj5vGc3mdmCZKNmsifMJiil1BiWyUtw49b1FruDXc4u711g0ngtig_Ko7oFzAY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoX22Oui8fPkTdTxj8PgKvDekWV4jlVmPgZs1e-l0qoA&oe=6AE8AE92"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/robot-atlas/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/robot-atlas/support", "website_url": "https://nebulytic.com/apps/robot-atlas/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "gen
": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_933927685940396_3040017305052197031_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaCq9MyUGRgQ7kNvwHLabUh&_nc_oc=Adok5-3B9fkttcBLyCdd1qT_tevCA-NGnbwrS2b0xm0tPgzhaJOJtpU9Xg2Qu_gsabA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoUf9H9ggPa9j1PbpddmMPr5Yls5sU_JAM00KgZdS2OQ&oe=6ABD33D0"}]}, "id": "1713464713698012", "locale": "en_US", "screenshots": [{"file_name": "store-02-color-hologram.png", "id": "2585549218561228", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823296_2585549221894561_2284247573373749437_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nleNe2CIpZoQ7kNvwH4K-mt&_nc_oc=Adr1tAmtBNhMQT7Zak_Tzj7q_c4FTFFztz5hFpK864bxopoH2Sok5bW4KTUIR2dW7vM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxHDrYxF_cnLPBPrr-dSvKry4Shk0Doeqa_NPwQgnoDw&oe=6ABD2B0C"}, {"file_name": "store-01-engineering-studio.png", "id": "28369212106064136", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825257_28369212172730796_5258581881626541407_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHRyCG7_DFUQ7kNvwGkpMg_&_nc_oc=AdoXeUpRyC0Np09zBDWaRz82gmcdhyBqMUWQjmRGlpKjoc72aioPXufLNNPm08qotVs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwq9SbJJIF_-RQ1QOIw5zG33wXp8V4whGFoJGrediK1g&oe=6ABD1007"}, {"file_name": "store-04-source-assembly.png", "id": "1548633643226364", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824318_1548633646559697_7297799975838773294_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JgYuYMe5KQQ7kNvwGIkBgA&_nc_oc=AdqADljgkQzwg4IFG-CXpcrpYEptVKN_-MnHzi0SSjuEaLJitpH2YZepqUJY9S_wUDE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJugbeSIN-sh9D9WYHYWIlvlhVRn2flyRmBdIAFAcLWeg&oe=6ABD0EA0"}, {"file_name": "store-03-blue-hologram.png", "id": "1160826089604529", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825563_1160826092937862_5729086189951941997_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1kNAL2Mv5QQ7kNvwFEt-jX&_nc_oc=Adrl9hwiJHzdoIw2IbPh0x-c1WBMrB2r21L2SL0Sfev99qOH9utQTEaTxGy1_tTF6s8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_C-TpCLzoKXW12AIqnurjbN8pP9GGnXcA4mnJeZ6puA&oe=6ABD1822"}, {"file_name": "store-06-source-joints.png", "id": "1613021433699869", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823746_1613021437033202_467147905405238580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUZpnERteF4Q7kNvwGYFqgl&_nc_oc=AdpBVET2qxwRplzOYjbaN9te62gHEVinuNbNr7F2R7FhY4qg9AYTvGJ7FFBn1RIC9jg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfHLrGvZXwWIYwqbEt_OvA45mNCQn5D6OvuU8JhVHg9Q&oe=6ABD06C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover.png", "id": "2160832664821064", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824665_2160832668154397_1522314912689723401_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CCGTJ9o09cQ7kNvwEQApkQ&_nc_oc=AdoBnmvsLwO4LFZEU7xQ6PARRz3ajdGunPoENu3A5o_khblxwkvcM9YdArfubWCyOaE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3OyKOEwxPxuWkhYjBEkV-zqLG7WoSAtN29U-aWvZtQQ&oe=6ABD2D12"}, "display_name": "RobotAtlas", "keywords": ["Robot", "3D", "Holo", "Humanoid", "Machines"], "long_description": "Explore published robot models in 3D.\n\nRobot Atlas is an independent visualization app by Nebulytic for Meta Quest 3. Browse 71 models grouped by source company, then inspect one on a movable glass base. Resize the rack, toolbar and model to suit your space.\n\nChoose passthrough, Studio or Black. Switch between full source colour, colour hologram, blue hologram, see-through and exploded assembly views. Exploded view separates only the parts actually included in a source; it does not reveal missing geometry.\n\n70 models use exterior or simplified simulation geometry. ODRI Bolt contains a partial engineering assembly, without complete wiring, battery, camera or factory documentation. Detailed internal systems are generally absent. Published units and materials are source data, not certified real-world dimensions or finishes.\n\nThe UR5e supports six verified source-defined joints for kinematic inspection. Import your own self-contained static GLB files (up to 64 MiB and 250,000 triangles). Imports remain on your headset; skinned, animated and compressed models are unsupported.\n\nYou purchase the viewer software. Third-party models remain under their original licences, with credits in the app. Source names identify the robots; no manufacturer endorsement is implied. Internet is needed for uncached collection models.\n", "short_description": "View 71 published robot models in mixed reality or a virtual room. Rotate, resize, change visual style and separate source parts. Import your own static GLB files. Most included sources show exterior or simplified simulation geometry; detailed internals are generally absent.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/robot-atlas/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/robot-atlas/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/robot-atlas/support", "website_url": "https://nebulytic.com/apps/robot-atlas/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1310224485506905"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2665874550537045"}]}, "baseline_offer": {"id": "2665874550537045"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789563480, "status": "PUBLISHED", "id": "2665874550537045"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1310627982133222", "version": "0.3.6"}, "id": "2321562125332013", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1310224472173573", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1310627982133222"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2321562125332013"}]}, "change_log": null, "created_date": 1789328722, "id": "1310627982133222", "version": "0.3.6", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
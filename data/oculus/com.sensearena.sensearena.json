content-ams2-1.oculuscdn.com/v/t64.5771-25/39035356_346298793138138_4894884039018092206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c44MxYv4CtoQ7kNvwH0xqCA&_nc_oc=AdrmbV-H9xY1mkXbm1wLHCKU8Iu7Yu1LKBpKVI_iHspY2s4XCcn2Rpz3IYgZuCGnKSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sNcQGqfNbjMO6eI4Yl5C9Vy8P5cPz7knUa_Dratanhw&oe=69D27337"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ocl_video_2560x1440.png", "id": "1530109590524550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_1530109593857883_34338324661498769_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3oUmtmwqM8Q7kNvwHqRkOG&_nc_oc=AdrW5M499Q-dQ1Vd1zdahM2hY_Afu_fcPdgGkLUsFApxUoBJ4BfOTHl_AbGdRP4fP3w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EaUcUIXa3yplcoMEDLM_A9blQa6aMp6KpAprn_p0wlg&oe=69D263DC"}, "display_name": "Sense Arena", "keywords": [], "long_description": "- Interactive drills in Sense Arena's environment will help improve reaction time, play tracking, puck tracking and active hands. Measurable results help in the goalie skills development process.\n\n- Watch interactive videos from real training sessions of top hockey organizations. Experience the speed and skills of higher age players. Develop your release reading.\n\n- Develop you cognitive skills and concentration.", "short_description": "Sense Arena is an off-ice training platform that improves players' Read & React cognitive capabilities, which are critical for peak performance. Our methodology and drills are developed in cooperation with professional NHL players and coaches. The University of Wisconsin-Stevens Point and The Charles University, Prague, have done studies on how players' performances are impacted by using Sense Arena.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sensearena.com/terms-and-conditions-privacy-policy", "developer_terms_of_service_url": "https://www.sensearena.com/terms-and-conditions-privacy-pol
356_346298793138138_4894884039018092206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHkW1Yhll5oQ7kNvwF4A0_7&_nc_oc=Adn1MCR1iLgNyWiJDhIEME8DJ04ZTwrefTBO7s10L-sitmcFmBlDbjGC_8pxgsUpk-Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvMRzTX92ylTlojdn4LfbK6g_WArXP2kjzGQ8iLcKrvPg&oe=69A80AF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ocl_video_2560x1440.png", "id": "1530109590524550", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031458_1530109593857883_34338324661498769_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT0Z1lXAyTIQ7kNvwGqejtm&_nc_oc=Adk4PkN-nojUr0HappH83MzIK-GifcoCr_qnpSlyhUwVbo3UHu73dt0QHRumEI25iuo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuZI7_0ebUZUnAsYtzNdoWEaOSFfiahpiZcIO4kazGCeQ&oe=69A833DC"}, "display_name": "Sense Arena", "keywords": [], "long_description": "- Interactive drills in Sense Arena's environment will help improve reaction time, play tracking, puck tracking and active hands. Measurable results help in the goalie skills development process.\n\n- Watch interactive videos from real training sessions of top hockey organizations. Experience the speed and skills of higher age players. Develop your release reading.\n\n- Develop you cognitive skills and concentration.", "short_description": "Sense Arena is an off-ice training platform that improves players' Read & React cognitive capabilities, which are critical for peak performance. Our methodology and drills are developed in cooperation with professional NHL players and coaches. The University of Wisconsin-Stevens Point and The Charles University, Prague, have done studies on how players' performances are impacted by using Sense Arena.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sensearena.com/terms-and-conditions-privacy-policy", "developer_terms_of_service_url": "https://www.sensearena.com/terms-and-conditions-privacy-policy", "publisher_name": "Sense Arena LLC", "support_webs
cdn.com&_nc_ss=7f20f&oh=00_AQMYeqwZYjS003IrnWNJwi_-XX8br9BPke7lgmfHSeCz7g&oe=6AE4B7DA"}, {"file_name": "Screenshot 1 (1).png", "id": "1448111274136239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595119480_1448111277469572_2922346199926303175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5IC-D78QWQQ7kNvwFf3Ixo&_nc_oc=AdrhkgF9-EgdH9_UfakM-Q77v8UC0bgpOSAbu_KBBELUMOAb54bQj6kpxCoNc-9KUrM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNosiulRQ_YrLZO8mBweq0UD0o-Ti-IHGKlgM6ZvPB1Gg&oe=6AE49843"}, {"file_name": "Screenshot 5.png", "id": "1142273521307880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_1142273524641213_8177972829284701471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mI4jQqeM9-8Q7kNvwEMchZe&_nc_oc=Adp4ruJhqZ3_V9kLWc4WOdS3Maj57teHbBkl-DTTS13XiAcg6hV8hFRQ_aVkNaP2zss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp5i0BvwAESj-LCjWLIZSCOyso_geD98RJ2ytUkLb5tw&oe=6AE49214"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NHLSA27 Cover 2560x1440 (1).png", "id": "1565922231492130", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673819499_1565922234825463_1844803798223232541_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW2oKftE-3UQ7kNvwFp1mC1&_nc_oc=AdrwEKzalQqUkK4csjfvPBpsYae5Mpkl3uC8HEqkfOnjK6IZjLqkNl3kfcff6BXlULg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrgIyZbChrVCXFs5URtLX7r1nntaVRsbhKa-apqSXKTg&oe=6AE48A96"}, "display_name": "NHL SENSE ARENA 27 VR Hockey", "keywords": ["Hockey", "NHL", "Sport", "Fitness", "Dangle"], "long_description": "**NHL\u00ae SENSE ARENA 27\u2122**\n\nThe Ultimate Off-Ice Hockey Experience! The ONLY VR hockey training tool officially licensed by the NHL\u00ae and used by NHL Pros.\n\nNHL Sense Arena 27\u2122 brings together DanglePro stickhandling, NEW Playmaker Mode, VR goalie training and 3v3 VR NHL Games to help players and goalies gain reps, warm up better, think faster, train smarter and develop hockey IQ.\n\n{1769083044370528}\n\n**NEW IN NHL SENSE ARENA 27\u2122**\n\nNEW Playmaker Mode - Read the ice, make strong decisions and create plays. Earn your Hockey IQ Score as you train your ability to see and think the game in different scenarios on the ice.\n\n{2055457751805950}\n\nNEW Goalie Shootouts - Face top NHL shooters and put your tracking, positioning and reactions to the test in this fun new game mode.\n\n{1642731280912103}\n\nUpdated Player Animations - Experience a more realistic NHL hockey experience with updated players and movements.\n\n# PLANS: \n**FULL UNLIMITED ACCESS** \n- Annual: $29/mo  | Monthly: $59/mo \n\n**3V3 NHL GAMES** \n- SA27 Season: $29.99 (one-time)\n\nDANGLEPRO STICKHANDLING\n\nReal puck. Real space. Virtual obstacles. Build faster hands, coordination and awareness with immersive mixed-reality training and full-ice scanning drills.\n\n{1598969207760139}\n\nGOALIE TRAINING\n\nBuild focus, stamina and confidence with VR drills and Game Flow, featuring AI-assisted passes, real shooters and three full periods of action. Then, prove your skills against NHL shooters in Goalie Shootout mode.\n\n{1728676584907226}\n\n3V3 NHL GAMES\n\nTake your skills to the ice in fast-paced 3v3 VR NHL games. Put your hockey IQ and decision-making to work.\n\nTrain smarter. Play faster!", "short_description": "NHL Sense Arena 27\u2122 is the #1 immersive off-ice hockey training and VR hockey game, officially licensed by the NHL\u00ae and used by NHL pros.\n\nBuilt for players and goalies of all ages, train hockey IQ, reaction time, hand speed and decision-making through immersive VR and mixed-reality drills. Featuring NEW Playmaker Mode, DanglePro Stickhandling and NEW Goalie Shootout. Take your skills to the ice in 3v3 NHL games in VR. \n\nLevel up your game and earn your Hockey IQ Score in NHL Sense Arena."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sensearena.com/privacy-policy", "developer_terms_of_service_url"
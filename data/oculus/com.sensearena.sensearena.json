L5_g&_nc_oc=AdleBIJV-a04V0osUXjnoPED1SM3nQocowDl13gjKWWK_6gqA2Dzt3ylNE0JtCnRq54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsUwJBe8o2iTSObioyeJf0SUPrujqc7VX6mM1JMLZVY9w&oe=69A6F1B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ocl_video_2560x1440.png", "id": "1530109590524550", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031458_1530109593857883_34338324661498769_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT0Z1lXAyTIQ7kNvwEAUcgA&_nc_oc=Adm9wUdJp6R55OgpqBZu6i88C3b8QF-QW_WG7pf-IHASOIOjAjagW8jBiZxCFyDdhyc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuaEfKt4xLqaiQ5YRRvRw9anhFXnNrDL-NdHZfj4I3bBw&oe=69A6E25C"}, "display_name": "Sense Arena", "keywords": [], "long_description": "- Interactive drills in Sense Arena's environment will help improve reaction time, play tracking, puck tracking and active hands. Measurable results help in the goalie skills development process.\n\n- Watch interactive videos from real training sessions of top hockey organizations. Experience the speed and skills of higher age players. Develop your release reading.\n\n- Develop you cognitive skills and concentration.", "short_description": "Sense Arena is an off-ice training platform that improves players' Read & React cognitive capabilities, which are critical for peak performance. Our methodology and drills are developed in cooperation with professional NHL players and coaches. The University of Wisconsin-Stevens Point and The Charles University, Prague, have done studies on how players' performances are impacted by using Sense Arena.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sensearena.com/terms-and-conditions-privacy-policy", "developer_terms_of_service_url": "https://www.sensearena.com/terms-and-conditions-privacy-policy", "publisher_name": "Sense Arena LLC", "support_website_url": "https://www.sensearena.com/oculus", "website_url": "https://www.sensearena.com/", "category": "APPS", "comfort_rati
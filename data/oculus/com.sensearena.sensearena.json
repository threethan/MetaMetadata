ent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eZaVbu3wZvbRUFJnyF6FwX47Qm46AoK2mEd8wj12LEw&oe=6A11CF3E"}, {"file_name": "ocl_screenshot_5.png", "id": "346298789804805", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035356_346298793138138_4894884039018092206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcZfWdv65WYQ7kNvwET5ZHh&_nc_oc=Adr8nc3yqU6dRsZNdxL-CPo_NpMGBOJz5-RPooMpVZ1zdyOS4T42b07w2LARdBn2qtI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68-xWE-KPRKq9kQRp2foOpzv2-giajicgBGQXKdNYu9A&oe=6A11BB37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ocl_video_2560x1440.png", "id": "1530109590524550", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031458_1530109593857883_34338324661498769_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHwN9mMPqLYQ7kNvwGgkKqY&_nc_oc=AdpioHkPM7J2yhrMiZKLQ71XooVETUT9vM2-arlPUsDR8wTJcJ8piFm48SQ2tVIeyEc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CCIxEdlhtgOOeXaZtSB-PXmYWPIfgGDVfmI3pqtD5GA&oe=6A11ABDC"}, "display_name": "Sense Arena", "keywords": [], "long_description": "- Interactive drills in Sense Arena's environment will help improve reaction time, play tracking, puck tracking and active hands. Measurable results help in the goalie skills development process.\n\n- Watch interactive videos from real training sessions of top hockey organizations. Experience the speed and skills of higher age players. Develop your release reading.\n\n- Develop you cognitive skills and concentration.", "short_description": "Sense Arena is an off-ice training platform that improves players' Read & React cognitive capabilities, which are critical for peak performance. Our methodology and drills are developed in cooperation with professional NHL players and coaches. The University of Wisconsin-Stevens Point and The Charles University, Prague, have done studies on how players' performances are impacted by using Sense Arena.\n"}]}, "developer_name": null, "dev
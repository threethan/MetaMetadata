FYHj&_nc_oc=Adl468a8OtvWtJtNcB8yagsRev3i2l14D7Tu2UEUwx8kR1KOhHId9vbgP0K9hA4B5Kk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsHu8_f3KK65uAe4bp39jr1j1dguWtKL1vjXzQQGTwtcg&oe=69A44EB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ocl_video_2560x1440.png", "id": "1530109590524550", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_1530109593857883_34338324661498769_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_OEPjN1RUYQ7kNvwEwAvHm&_nc_oc=AdnyKgiL56DncgifrqyjlE5UWG3MysE5v1J-6ErzNiREvI2verbpmo3RpSYcut892og&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvd-KKUz2re0_gUlnR0QdbGX5P0sl2HCcfNESxQXLCfrA&oe=69A43F5C"}, "display_name": "Sense Arena", "keywords": [], "long_description": "- Interactive drills in Sense Arena's environment will help improve reaction time, play tracking, puck tracking and active hands. Measurable results help in the goalie skills development process.\n\n- Watch interactive videos from real training sessions of top hockey organizations. Experience the speed and skills of higher age players. Develop your release reading.\n\n- Develop you cognitive skills and concentration.", "short_description": "Sense Arena is an off-ice training platform that improves players' Read & React cognitive capabilities, which are critical for peak performance. Our methodology and drills are developed in cooperation with professional NHL players and coaches. The University of Wisconsin-Stevens Point and The Charles University, Prague, have done studies on how players' performances are impacted by using Sense Arena.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sensearena.com/terms-and-conditions-privacy-policy", "developer_terms_of_service_url": "https://www.sensearena.com/terms-and-conditions-privacy-policy", "publisher_name": "Sense Arena LLC", "support_website_url": "https://www.sensearena.com/oculus", "website_url": "https://www.sensearena.com/", "category": "APPS", "comfort_rati
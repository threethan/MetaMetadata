ail": {"file_name": "ocl_video_2560x1440.png", "id": "1530109590524550", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031458_1530109593857883_34338324661498769_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWDiuGmcpsIQ7kNvwFBRfZ4&_nc_oc=AdqXeNN19I1-Kxf728-zQ8RJHFqyWJj8Z1oGdP3nllIPvl0N14xidpZoV5tQpiM3_nM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zxp_TONYRq5-vojltrfpdLXrqCgHyt4D8EtPCwOxkLw&oe=6A032B5C"}, "display_name": "Sense Arena", "keywords": [], "long_description": "- Interactive drills in Sense Arena's environment will help improve reaction time, play tracking, puck tracking and active hands. Measurable results help in the goalie skills development process.\n\n- Watch interactive videos from real training sessions of top hockey organizations. Experience the speed and skills of higher age players. Develop your release reading.\n\n- Develop you cognitive skills and concentration.", "short_description": "Sense Arena is an off-ice training platform that improves players' Read & React cognitive capabilities, which are critical for peak performance. Our methodology and drills are developed in cooperation with professional NHL players and coaches. The University of Wisconsin-Stevens Point and The Charles University, Prague, have done studies on how players' performances are impacted by using Sense Arena.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sensearena.com/terms-and-conditions-privacy-policy", "developer_terms_of_service_url": "https://www.sensearena.com/terms-and-conditions-privacy-policy", "publisher_name": "Sense Arena LLC", "support_website_url": "https://www.sensearena.com/oculus", "website_url": "https://www.sensearena.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "REQUI
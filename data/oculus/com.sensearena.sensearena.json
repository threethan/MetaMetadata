cdn.com&_nc_ss=7f20f&oh=00_Af_7cIlj7mM3EWg_gZbe2v_y1ssq5aFXioMaIErTJ_skzw&oe=6A36B1DA"}, {"file_name": "Screenshot 4.png", "id": "1158028439169017", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823310_1158028445835683_5626185337386144233_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tj70EOPAImcQ7kNvwGWLrEY&_nc_oc=AdpbkW9e_kFV248vUzVjP46VLMeESw_b908mUtHVv4JYQB_HxPkgjAkbzUTVNSAYrk4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-TU3aEkdYxVtKGMA8VPuIgOtyyGG0OHdiYLr95_WQGA&oe=6A36AADC"}, {"file_name": "Screenshot 5.png", "id": "1142273521307880", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823783_1142273524641213_8177972829284701471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAHLrnRg_dwQ7kNvwEwWNBD&_nc_oc=Adr7frLMfmXZ1c4m4J28Mb6HoTxiUhfqhUvAvO2fLvFsOmAudqtl2RJ2SpCckyKhCpk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qTwe2zCF-MWBsu25AnOZePNwxs7Bx8KsfeX-jnMespQ&oe=6A36C454"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NHLSA26 Cover 2560x1440.png", "id": "1334338518333907", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491818852_1334338525000573_6826442813457927854_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=XGqSDfc68wgQ7kNvwGh_2eX&_nc_oc=AdqKohpRZWqv3yLHoURE7AoyCr8BikmGU7-zBYcC8tC9tdfyFYvrWXT8xjIXbBo6wMg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b6FfSj_hMxHzXWjKgXXQ6FhrbxP50rBwDknIW44Zx2w&oe=6A36A2B9"}, "display_name": "NHL SENSE ARENA 26 VR Hockey", "keywords": ["Hockey", "NHL", "Sport", "Fitness", "Dangle"], "long_description": "# NHL\u00ae Sense Arena 26\u2122\n\n**Off-Ice Hockey Drills, VR Hockey Game, & NEW Mindset Training**\n\nStep into the future of **VR hockey** with **NHL Sense Arena 26\u2122 + DanglePro**, the **ONLY VR hockey training tool officially licensed by the NHL\u00ae**. Built for players and goalies at every level, it\u2019s the most advanced off-ice hockey training ever built, designed to sharpen **hockey IQ, reactions, vision, hand-speed, and decision-making** .\n\n# PLANS:\n**UNLIMITED ACCESS**\n\n - Annual: $25/mo\n\n - Monthly: $59/mo\n\n**3V3 NHL GAMES ONLY**\n\n - SA26 Game: $29.99 (one-time)\n\n{806715751965892}\n\n# NEW IN NHL SENSE ARENA 26\u2122\n- **Full-Ice Scanning in DanglePro** - Build faster hands and better awareness with new drills in DanglePro built to test your vision and hand speed.\n\n- **Mindset Training from Pete Fry** - Prepare for games and practices with visualizations and affirmations to grow confidence and focus.\n\n- **Play with NHL Players** \u2013 Includes rosters and collectible player profiles.\n\n\n\n# TRAINING MODES\n# 100+ VR hockey drills\n- Built for both players & goalies to build hockey IQ for all skill levels and ages (10+)\n- **Guided insights and drills in P.A.S. & G.A.P. training programs** for progressive development\n\n{1513976172936551}\n# Game Flow for Goalies\n- Build focus and stamina with uninterrupted shots from AI-assisted passes\n- Three full periods of shots\n- Real shooters\n\n{798399323008866}\n\n# DanglePro stickhandling training\n- The most advanced stickhandling training\n- Real puck, real space, virtual obstacles in mixed-reality\n- Full-ice scanning drills added\n\n{1598969207760139}\n\n# **Train Smarter. Play Faster. Think the Game Better. With NHL Sense Arena 26\u2122.**", "short_description": "NHL Sense Arena 26 VR Hockey  \u2013 Off-Ice VR Drills, VR NHL Game & NEW Mindset Training.\n\nStep into the future of VR hockey with NHL Sense Arena 26  + DanglePro, the ONLY VR hockey training tool officially licensed by the NHL\u00ae. Built for players and goalies at every level, it\u2019s the most advanced off-ice hockey training system ever built, designed to sharpen hockey IQ, reaction time, hand-speed, and decision-making.\n\n\ud83c\udfd2 Training + DanglePro $25/mo, Base Game $29.99 \nLevel up your hockey training!"}]}, "developer_name": null, "developer_privacy_policy_url": "https:
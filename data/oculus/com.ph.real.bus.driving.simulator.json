ps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827718_762182099786570_4855433368219026962_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bi4yWm8OitIQ7kNvwERW9tT&_nc_oc=AdqKuqF958tghcg9EY5EF8F7cVAioUeBztUO-mcwSuUPQryz2hJ_lyrGArAPNkqFdkw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zizghmHH3wjGG3IvAbJN6qn2XsSTNHbwcEva5_x0u9g&oe=69FB5377"}, {"file_name": "Screenshot 2026-01-13 233903.png", "id": "1358526912625116", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827646_1358526915958449_1046812914645377188_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEoFlV3wSxgQ7kNvwH3lkeR&_nc_oc=AdqTOCsJ97DA17P2OAhZTEP3Clz-mpdF2ezRrIPO8Ygq9642jeaV2NmTPDLEEds1_Pc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71rCgsvhvK7hLz2g0pcuiRibg1Pe9bpyjFV4gu98l1xA&oe=69FB3B44"}, {"file_name": "Screenshot 2026-01-13 233728.png", "id": "1607584356909867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820428_1607584360243200_9004437812988550172_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iKai37bEmAQ7kNvwEdVHVu&_nc_oc=AdpZJ2tblxbOpimh4AocKaPiQUPXIk19rBVplBaJKuLK4sxqhkgiWSiNAB1FbXI2Hoo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-BC9aweyFHFsUx-ew4qaLJxgqyZRULoHz38vr8bhnkw&oe=69FB482B"}, {"file_name": "Screenshot 2026-01-13 233632.png", "id": "1440294990795628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_1440294994128961_5511842392132866273_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1pbWJ8wla4Q7kNvwEqMreN&_nc_oc=AdrRLqyamTV0dksutHcJpNtV5ejIux_9wtnS84TOwAUajd2F82X8T6KAGAfoD3ZDHks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52nvvuechixe_-ht47uF1IRr2K5vTz9LBWVKvT7Ofp3w&oe=69FB5784"}, {"file_name": "Screenshot 2026-01-13 234046.png", "id": "898329845906480", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825481_898329849239813_7826221657110870146_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N5rtJl1cHMQ7kNvwFRHsWW&_nc_oc=AdrYnuDKlsaaBBOqkakRXknf2VxGxBRXaC7AQkbqUNNmgLSwwdhdHztc0KOaZkiho4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hw__gJEQckiwMopxOyZahC1jwqy9L_qorhSkC5uaZmw&oe=69FB4C51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Transit Simulator: Bus Driving Game", "keywords": ["bus", "coach", "simulator", "city", "driving"], "long_description": "City Transit Simulator: Bus Driving Game is an immersive VR bus driving simulator for Meta Quest that lets you experience realistic city transportation in virtual reality. Step into the driver\u2019s seat and take control of modern city buses as you navigate busy streets, follow traffic rules, and complete real-world transit routes.\n\nDesigned specifically for Meta Quest VR, the game delivers smooth performance, comfortable controls, and realistic bus physics. Drive through detailed urban environments with dynamic AI traffic, responsive pedestrians, and interactive bus stops. Pick up and drop off passengers, obey traffic signals, and manage your route like a professional city bus driver.\n\nEnjoy varied driving conditions with a dynamic day and night cycle, making every route feel fresh and engaging. Whether you are a fan of VR driving games, bus simulator VR experiences, or realistic city simulators, this game offers a relaxing yet authentic public transport experience.\n\nPerfect for both casual players and simulator enthusiasts, City Transit Simulator: Bus Driving Game brings true-to-life bus driving in VR to Meta Quest.\n\nKey Features\n\n\ud83d\ude8c VR Bus Simulator for Meta Quest with immersive first-person driving\n\ud83c\udf06 Realistic City Environment with detailed roads, traffic systems, and bus stops\n\ud83d\udea6 AI Traffic & Traffic Rules for authentic city driving\n\ud83d\udc65 Passenger Pickup & Drop-Off Gameplay\n\ud83c\udf17 Day & Night Cycle for varied driving experiences\n\u2699\ufe0f Realistic Bus Physics & Smooth Controls", "short_description": "City Transit Simulator: Bus Driving Game puts you in the driver\u2019s seat of realistic city buses in immersive VR. Navigate busy streets, follow traffic rules, pick up passengers, and complete routes across detailed urban environments. Experience smooth controls, authentic bus physics, dynamic traffic, and day-night cycles. Designed for comfort and realism, this simulator delivers a true-to-life public transport driving experience on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/prism-horizon/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Prism Horizon", "support_website_url": null, "website_url": "https://sites.google.com/view/prism-horizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24065018219862839"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818860_1587462172263193_4568963644353483789_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOFFQkDl6l0Q7kNvwFJALEY&_nc_oc=AdopayV4DYsSm4dldqJzEWeptyqVC8UGsMaTt0LvITvLovrOkxj9UfVkHHc5xxE4CDY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gPeZinZAQCZa_vQAhWFVKZR5mcz7bzdwMx1JAjBshRg&oe=69FB4944"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "City Transit Simulator: Bus Driving Game", "pla
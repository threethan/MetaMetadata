08x1440.png", "id": "1120983077110553", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654859273_1120983083777219_7041402425851901583_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Tnm3Hs97P4Q7kNvwFJ2t-C&_nc_oc=AdrrFUnDJ8Xyy5OO7hC8i3x0M_mMJr90_zsxKNozbaKeYo8fBUF7heiZeA43_pMqutk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAeIeJmUkmsE9nih6UZEOe3aXhZ-_uHBbqgyoxomXcVQ&oe=6AF734DC"}]}, "id": "4195466117412584", "locale": "pt_PT", "screenshots": [{"file_name": "screenshot-3-biblioteca.png", "id": "1596984185508875", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/792716465_1596984188842208_3056730488234438563_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ky0K1i8qvVIQ7kNvwGWE5Sg&_nc_oc=AdroIXKl4lZ_XLOOgDGRD9SlPGFqcsLwaRptF2U5bgW7SfemRRMe-v8Dpaz4Z1nFmCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLrbc-w1tpVvbLSS2DlcloGr6yDJsJkPGSLX-Iy2Uj5A&oe=6AF729B2"}, {"file_name": "screenshot-4-visita-guiada.png", "id": "1683479996735007", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312310_1683480000068340_8154696523900416197_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cpaf2jtOZcUQ7kNvwFHHh7w&_nc_oc=AdrzGu85yIs2O9pXG_BKaIk3Rh1Rx-bR3HpzInCPv1sjwx1lwpfeNAA5EUGeoxb1LFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR65f4L5C2u5f0id31PU2VhVKBmmqZENMNs4FG35Xdk3g&oe=6AF72F10"}, {"file_name": "screenshot-5-cursor-no-chao.png", "id": "2297218031062819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/748811223_2297218034396152_2574199651801257702_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L10RJCjp1zQQ7kNvwEGlQuJ&_nc_oc=AdrslAj8AdSoGjbERCBRtmeCk7VA8wZX8-88KWuRg-wM_wuNEhqzdtqyw-8AORi7RvI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1Du43TQakHGL2D9mRanwA1vaEYQOSCwkT0CRse3TcgA&oe=6AF72B5E"}, {"file_name": "screenshot-6-rodar-a-vista.png", "id": "2373761493371066", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312068_2373761496704399_4146260119974580299_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELBUtwMFwH8Q7kNvwFFyMdW&_nc_oc=AdrdpuEML0kIUDqphVLI83r8OWekWMYlbwrYkW59tcHoO4Ei2sqGeZWN3uuXUI79buQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR19iuQt4hg_66P5oqKckei4PMlBBXLGeC4SQHKUBtkRQ&oe=6AF73677"}, {"file_name": "screenshot-1-intro.png", "id": "1928383488568988", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/753328995_1928383491902321_6621587180502667063_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVWDJY9CL98Q7kNvwGlrr3N&_nc_oc=Adpbht05ys3ZX99BnGJ3NMCnA60ct_nESZL-1LBziYvjX8duFZh7PlMrMC0hbwpdwd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyZ8hi1Lh_ngs-RV2u0G-0PCNKWhSXLxblA-qOem-YUA&oe=6AF74811"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tourio 360 VR", "keywords": [], "long_description": "O Tourio 360 VR leva os tours virtuais do Tourio 360 para dentro do Meta Quest. Abre diretamente em realidade virtual e mostra-lhe os tours p\u00fablicos numa biblioteca \u00e0 sua frente.\n\n\u2022 Ande pelos espa\u00e7os: aponte ao ch\u00e3o e toque, e passa para a divis\u00e3o seguinte. Em muitas divis\u00f5es, o cursor reconhece o ch\u00e3o, as paredes e o teto. \u2022 Rode a vista sem se levantar: agarre a imagem e arraste, ou use o joystick para rodar 30\u00b0 de cada vez. \u2022 Visitas guiadas: introduza o c\u00f3digo que o guia lhe deu. O guia v\u00ea o que voc\u00ea est\u00e1 a ver e pode falar consigo. \u2022 V\u00eddeos 360: os v\u00eddeos 360\u00b0 dos tours abrem na app YouTube, em VR. \u2022 Funciona com comandos ou com as m\u00e3os.\n\nIdeal para imobili\u00e1rias, museus, hotelaria e turismo que querem mostrar os seus espa\u00e7os como se o visitante l\u00e1 estivesse.\n\nCriado pela DSPRO, na Ilha da Madeira, Portugal.", "short_description": "Visite casas, museus e lugares em 360\u00b0 com realidade virtual. Aponte ao ch\u00e3o e toque para andar, rode a vista sem sair da cadeira e entre em visitas guiadas com um c\u00f3digo."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "1673827364754475", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/755802518_1673827368087808_5908370954553964028_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjZAbBfDIRsQ7kNvwHwnpV0&_nc_oc=Adq_9ic07nTiUvR0pvQRqCNfPFYy1G5GM5dKXh1NfoGto6HJFKMoJ2PjPHTR0KMG0ik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyOSt3zlv4ZK9o9fSZofQDyJXFeHXTZobpYzRF6sR1Lg&oe=6AF73736"}, {"file_name": "icon-512.png", "id": "1399784561868676", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312306_1399784565202009_7815367551361586394_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBHDhH5jFBkQ7kNvwFMniuQ&_nc_oc=AdqsFIYeG0s2Ek6uQr7U2qYhxPSmHdwCrP3NuMQi4blP9bQ8Q6f5GviWJbWOSa9fT8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu7lAVYYsh8Q4h-WgfeB2yqZ8Rr6yJW3u7n4213TXr_g&oe=6AF746A4"}, {"file_name": "cover-landscape-2560x1440.png", "id": "990376136648124", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303790_990376139981457_7371890886061920445_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXa8mVhG1B4Q7kNvwHbhfZq&_nc_oc=Adr2BF-4yX2KxXTuS3cd8XaLt3a7Fn8fGKxnXan2PiaW7kuHTsUrT4mtn3Kr0qrGR08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8z8mk6rHjgGU8_crO0KWcTSTaDVVFN3sUoqT5BqE5Yw&oe=6AF72156"}, {"file_name": "cover-portrait-1008x1440.png", "id": "966203179874408", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303707_966203186541074_6277840021226275500_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaX4HW3b4iEQ7kNvwHC60la&_nc_oc=Adri5goR3U0nYZ2Ib1k3yRMdePJxUIlcGlag9TJA9KHsXvmhGZvlnaAw3ebFCa2_xig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgGdEApHJwOmIsimEi-cxCWy
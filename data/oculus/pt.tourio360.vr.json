832222008063014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zuaqZl67fgQ7kNvwG5-1C1&_nc_oc=AdpqwNY178BPyvNnUWQ2kj9Egkp0JaeNsEz5jr61QOb-_RaGnTSYuFysj3943d3ElTQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSIlai0279KEljpzr238Styjtaic8avuMIG_FI4KQzvg&oe=6AF7148A"}, {"file_name": "screenshot-6-rodar-a-vista.png", "id": "1546944010802413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/741360331_1546944014135746_519909596355625912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAyi2zJfCt0Q7kNvwGdGsb-&_nc_oc=AdoToqFyNZgQdJXvC_iCCotDZmtgWQ8xqNyTRteyY3KbN6nuTJJ6uKt59pezWqgJfUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZmAxMu7FfYAHt9RMfDUvptKJVzmkhjPu_lvyMLD8-jg&oe=6AF74A0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tourio360", "keywords": [], "long_description": "Tourio 360 VR brings Tourio 360 virtual tours into Meta Quest. It opens straight into virtual reality and shows the public tours in a library in front of you.\n\n\u2022 Walk through spaces: point at the floor and tap to move to the next room. In many rooms the cursor recognises the floor, walls and ceiling. \u2022 Turn the view without standing up: grab the picture and drag, or use the thumbstick to turn 30\u00b0 at a time. \u2022 Guided visits: enter the code your guide gave you. The guide sees what you see and can talk to you. \u2022 360\u00b0 videos: the tours' 360\u00b0 videos open in the YouTube app, in VR. \u2022 Works with controllers or hand tracking.\n\nMade for estate agents, museums, hotels and tourism that want to show their spaces as if the visitor were there.\n\nCreated by DSPRO in Madeira Island, Portugal.", "short_description": "Walk through homes, museums and places in 360\u00b0 virtual reality. Point at the floor and tap to move, turn the view without leaving your chair, and join guided visits with a code."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tourio360.pt/privacy", "developer_terms_of_service_url": null, "publisher_name": "DSPROPT", "support_website_url": null, "website_url": "https://www.tourio360.pt/vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1428796703643348"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312470_941496882021312_8774133553404664472_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUWKZIMa3OYQ7kNvwETO3yY&_nc_oc=AdokScsvZaOFoqC3Npi4t6Q97AGww3lpQ0zESxVFh16vcmHUwbjQwBEeT2TaJ6Y_G_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQckkYhDbLtUCBT-xvgHEG-L-F8IHChl4-HDMerHseTg&oe=6AF73D37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tourio360", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1792175880, "lastRevision": {"nodes": [{"id": "1427841303738888", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1427841290405556", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1602542944906563"}, "iarc_email": null, "msrp": null, "transl
49244952259909", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/786297305_2649244955593242_6734832222008063014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zuaqZl67fgQ7kNvwG5-1C1&_nc_oc=AdpqwNY178BPyvNnUWQ2kj9Egkp0JaeNsEz5jr61QOb-_RaGnTSYuFysj3943d3ElTQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSIlai0279KEljpzr238Styjtaic8avuMIG_FI4KQzvg&oe=6AF7148A"}, {"file_name": "screenshot-6-rodar-a-vista.png", "id": "1546944010802413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/741360331_1546944014135746_519909596355625912_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAyi2zJfCt0Q7kNvwGdGsb-&_nc_oc=AdoToqFyNZgQdJXvC_iCCotDZmtgWQ8xqNyTRteyY3KbN6nuTJJ6uKt59pezWqgJfUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZmAxMu7FfYAHt9RMfDUvptKJVzmkhjPu_lvyMLD8-jg&oe=6AF74A0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tourio360", "keywords": [], "long_description": "Tourio 360 VR brings Tourio 360 virtual tours into Meta Quest. It opens straight into virtual reality and shows the public tours in a library in front of you.\n\n\u2022 Walk through spaces: point at the floor and tap to move to the next room. In many rooms the cursor recognises the floor, walls and ceiling. \u2022 Turn the view without standing up: grab the picture and drag, or use the thumbstick to turn 30\u00b0 at a time. \u2022 Guided visits: enter the code your guide gave you. The guide sees what you see and can talk to you. \u2022 360\u00b0 videos: the tours' 360\u00b0 videos open in the YouTube app, in VR. \u2022 Works with controllers or hand tracking.\n\nMade for estate agents, museums, hotels and tourism that want to show their spaces as if the visitor were there.\n\nCreated by DSPRO in Madeira Island, Portugal.", "short_description": "Walk through homes, museums and places in 360\u00b0 virtual reality. Point at the floor and tap to move, turn the view without leaving your chair, and join guided visits with a code."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.tourio360.pt/privacy", "developer_terms_of_service_url": null, "publisher_name": "DSPROPT", "support_website_url": null, "website_url": "https://www.tourio360.pt/vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1428796703643348"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1131403889344131"}]}, "baseline_offer": {"id": "1131403889344131"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792175880, "status": "PUBLISHED", "id": "1131403889344131"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1428685603654458", "version": "1"}, "id": "1109409545307534", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1427841290405556", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1428685603654458"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1109409545307534"}]}, "change_log": "Primeira versao publica: tours em VR, intro, biblioteca, cursor no chao, rodar a vista, visitas guiadas.", 
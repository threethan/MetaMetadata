scdn.com&_nc_ss=7f20f&oh=00_Af60cUM3pG5509SA25BNPcElw7bzwgf-Pt4DV63sZS7s9A&oe=6A0B36EB"}, {"file_name": "Oculus_scr_002_1.png", "id": "332335632143841", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569471_332335635477174_358272859827474423_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOl2Wo57nikQ7kNvwHcztye&_nc_oc=Adq_AxP9YfEsrf8W2U_evJtAvQXinQGdcT1cXH3Zr59B5_aa7egT90jobSvHcDlUUgE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aym74Nl2t4DYuOYr5arHnt47j0eDLPi7EnZdW0-W0Fg&oe=6A0B09BF"}, {"file_name": "1Scr_001_3.png", "id": "351810483615000", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031379_351810486948333_8237110008595509183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuQqN1xDuHYQ7kNvwGQ_n4o&_nc_oc=Adre9B3GY6haFB8sjaE3vHLMlmvj7kzeGEJp_4Wd5cFKzDhKz59gDd4yYahWg_BeFdg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sXhachR6CLFF2BZUZ2qzl6LJZLQLxUJyYMj2s6HB5KQ&oe=6A0B2FC4"}, {"file_name": "1Scr_001_4.png", "id": "7209753802383102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251816_7209753805716435_3056192221886878472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U5xQRuAQ08Q7kNvwFvk54s&_nc_oc=AdqttiKvu3jbNWe2gCcN_6GfIJwGxwz_5cRem0_e5kxpOVAu7BRDixT_yrP2RYICyq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FXLAcT02WkDAIqlq-AC9PekqiWwCX9blMpW-v6cPWFw&oe=6A0B07E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_scr_002_1.png", "id": "668818354251530", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035360_668818364251529_1258103518041698246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3dVOteDCikQ7kNvwHCYoJa&_nc_oc=AdovHWQABz41O9kbDhkw4jqA_RXgk2xg6LKBCWGUY_AnHdk6_7Pzh6ciFdTCXR-pmZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Uo4RIqrVw1Ch3bbcbmgS4w_iuCXDtr-HkiC-nDEmZlw&oe=6A0B2221"}, "display_name": "VR Travel", "keywords": [], "long_description": "Your guide to wonderful places of the world. Photorealistic and volume of stereoscopic VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places. \n\nInstructions:\nFirst of all, please sit down and make yourself comfortable.\n-Yes, you can go around the room and fly (look up and use left ThumbStick)\n-Please select and download a tour that interests you.\n-Use Oculus button to reset your view.\n-The volume of the guide's voice is controlled by the buttons on your helmet.\n-The volume of background music is controlled on the side menu tour's room.\n\nOur team consists of 3 people, each review is like a family holiday for us. We read them out in the family circle and disassemble them into atoms to make the application more convenient.\nYour feedback and opinion are highly valuable for us! \nYou can do it here, and in the discord channel.\nThank you!\nhttps://discord.gg/BMYXT5fysk\ninfo@vr-travel.site", "short_description": "VR TRAVEL - your real 3D stereo guide to most unique places of the world. Photorealism of VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1fR-0VY0lebEUvGSO4LjX_Ov7Lg1Lc918ICEz_XoAIb8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Michael Phylattos", "support_website_url": "https://vr-travel.site/", "website_url": "https://vr-travel.site/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MO
scdn.com&_nc_ss=7f20f&oh=00_AQBDaFbEz0XuYepZP318yk-zj75q7czfrfRmY80RDHb2mA&oe=6A6B3C2B"}, {"file_name": "Oculus_scr_002_1.png", "id": "332335632143841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569471_332335635477174_358272859827474423_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQXVBfwrV90Q7kNvwEMObDJ&_nc_oc=AdrLS_c9SMQ66ohBTcTwtZ_Pe2aIxqfhpuoBvr2uK2ypxYpXFj0b1Prds9haUGXrwr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCee23891lLOXz39A4OIlGYGj97qoUHq14gBwdZtLTBIw&oe=6A6B473F"}, {"file_name": "1Scr_001_3.png", "id": "351810483615000", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_351810486948333_8237110008595509183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ5RC3q8GIEQ7kNvwHcuf10&_nc_oc=Adpc8u8ClG07396cQm2EMmhOQH6wx5LeFwS87VEKu6D1SfNHWKOlCNU8ZC9LbXGTeBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmdaiCXCIakXeiISvHGqonfTiGMEeu9aigh8Ux-HWhnA&oe=6A6B6D44"}, {"file_name": "1Scr_001_4.png", "id": "7209753802383102", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75251816_7209753805716435_3056192221886878472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVOb2u5U0HAQ7kNvwEr0hZA&_nc_oc=AdrAidfPU_HouzLCrkt2gYBas-n2RGo-7CnZ-Wynh7WKyT4JlVc8AVWyuwISQg_nzzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFQkMeHVp1871seUhP7BHrfZYjJ0Y9mCkF3vTI49RQGQ&oe=6A6B4567"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_scr_002_1.png", "id": "668818354251530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035360_668818364251529_1258103518041698246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgu_h9YgFAsQ7kNvwEZNRS0&_nc_oc=AdrlkKVbMciwgOlu9F1dZ0e4xpyoHcn0vLsGvpTHKqusz9uJ6jtVZ183SSSKAzUSdlY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0SwHXExa7vceuSX144CG-TFuszboc7OopL603-nH75A&oe=6A6B5FA1"}, "display_name": "VR Travel", "keywords": [], "long_description": "Your guide to wonderful places of the world. Photorealistic and volume of stereoscopic VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places. \n\nInstructions:\nFirst of all, please sit down and make yourself comfortable.\n-Yes, you can go around the room and fly (look up and use left ThumbStick)\n-Please select and download a tour that interests you.\n-Use Oculus button to reset your view.\n-The volume of the guide's voice is controlled by the buttons on your helmet.\n-The volume of background music is controlled on the side menu tour's room.\n\nOur team consists of 3 people, each review is like a family holiday for us. We read them out in the family circle and disassemble them into atoms to make the application more convenient.\nYour feedback and opinion are highly valuable for us! \nYou can do it here, and in the discord channel.\nThank you!\nhttps://discord.gg/BMYXT5fysk\ninfo@vr-travel.site", "short_description": "VR TRAVEL - your real 3D stereo guide to most unique places of the world. Photorealism of VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1fR-0VY0lebEUvGSO4LjX_Ov7Lg1Lc918ICEz_XoAIb8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Michael Phylattos", "support_website_url": "https://vr-travel.site/", "website_url": "https://vr-travel.site/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MO
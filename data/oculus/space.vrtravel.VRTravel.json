scdn.com&_nc_ss=7f20f&oh=00_AQINJs_6oKf_ptaLMxhjdL_ohje2hJOJbFXtzD3cXctBEw&oe=6AA2D36B"}, {"file_name": "Oculus_scr_002_1.png", "id": "332335632143841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569471_332335635477174_358272859827474423_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQpRbzmHFqAQ7kNvwHBu_vs&_nc_oc=AdogY7NJClXbA_0t2gVedXsOdVJx4F-IUeGgUrUjx5itaneoUIYd61UVJNoCyvqGoTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKhz01CEAbRJK8jVCb7ygGj5B1h-UAdJ0Sfm1L9UjgRg&oe=6AA2A63F"}, {"file_name": "1Scr_001_3.png", "id": "351810483615000", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_351810486948333_8237110008595509183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmzQ14d4NPgQ7kNvwHgxUzA&_nc_oc=Adrp9T54r4U0ZBm9rMTkxqYCSVun_yRMeFtBA4RpwAvcZA6ZdHsCdyJaDgu8wfjWUqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvpp5TXRpiFTw8UtGuR3OML6BzvF3SuKYYr4zkig7_qg&oe=6AA2CC44"}, {"file_name": "1Scr_001_4.png", "id": "7209753802383102", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75251816_7209753805716435_3056192221886878472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQtO53qI6HoQ7kNvwG7PkdP&_nc_oc=Ado9VNxIcanOj77nwm2nZHnrS6zJMW4nQPSD1o-QG_XnmcY4zIOzlv9T8FU9HnaIiuQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIYB47HC2kUvv4vYXsqS0O6YZyoiozMnJt3NyLanGS6A&oe=6AA2A467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_scr_002_1.png", "id": "668818354251530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035360_668818364251529_1258103518041698246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAQy60O-xioQ7kNvwE49H7i&_nc_oc=AdqRKiEL2xGlhz8AQ3VX8VUj_p4D0cN7IW6Xb44jTC9K8wzyQRkyyPLROXiBFSJE8G8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYR9BPwctQECvvcjFnRnPf2mRvl9ytZL_2O8ZdmjwqHQ&oe=6AA2BEA1"}, "display_name": "VR Travel", "keywords": [], "long_description": "Your guide to wonderful places of the world. Photorealistic and volume of stereoscopic VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places. \n\nInstructions:\nFirst of all, please sit down and make yourself comfortable.\n-Yes, you can go around the room and fly (look up and use left ThumbStick)\n-Please select and download a tour that interests you.\n-Use Oculus button to reset your view.\n-The volume of the guide's voice is controlled by the buttons on your helmet.\n-The volume of background music is controlled on the side menu tour's room.\n\nOur team consists of 3 people, each review is like a family holiday for us. We read them out in the family circle and disassemble them into atoms to make the application more convenient.\nYour feedback and opinion are highly valuable for us! \nYou can do it here, and in the discord channel.\nThank you!\nhttps://discord.gg/BMYXT5fysk\ninfo@vr-travel.site", "short_description": "VR TRAVEL - your real 3D stereo guide to most unique places of the world. Photorealism of VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1fR-0VY0lebEUvGSO4LjX_Ov7Lg1Lc918ICEz_XoAIb8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Michael Phylattos", "support_website_url": "https://vr-travel.site/", "website_url": "https://vr-travel.site/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MO
scdn.com&_nc_ss=7f20f&oh=00_AQAix7Udp409-KltlJXIo9RUpQfjKesIfKXE7ktWulPCng&oe=6A6747AB"}, {"file_name": "Oculus_scr_002_1.png", "id": "332335632143841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569471_332335635477174_358272859827474423_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tWqXjfrQjQQ7kNvwG4qEMp&_nc_oc=AdrkzBp6hxtyJcdHiw7hwmuCS0Bqz-zYhX12DWkwEGhG4d0_syvzzVuKeXgIUB_ZvsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0Z43rxpyI4dwfBsAx7HxYtqKI3Se9diBXLLzQ3BxHqA&oe=6A6752BF"}, {"file_name": "1Scr_001_3.png", "id": "351810483615000", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_351810486948333_8237110008595509183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGRZtf8L_WAQ7kNvwFuIKG7&_nc_oc=AdqnTGLGyjdh0DB17MAhFhk5-4-k0U_f-U6fsfb8oRq7mv0d18Y1MLti3C4LKqTEWG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQZFGi7zFFSS94mCfN0caJk9Mu1GRicnd-NeWADbm08A&oe=6A6778C4"}, {"file_name": "1Scr_001_4.png", "id": "7209753802383102", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75251816_7209753805716435_3056192221886878472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkLzBAWDkDQQ7kNvwHUdRnw&_nc_oc=AdpmSMnJ0tquj2lb1yE0oN5G8enbR_RjPanseAgXfVmHvD32UmiN-j7xh91rXlTGnrk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqDRL1gVQoBv5Fl22kiiPiSwGW73txcObjhOZ5Bo1pFg&oe=6A6750E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_scr_002_1.png", "id": "668818354251530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035360_668818364251529_1258103518041698246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kohQOSAg9kQ7kNvwEjn-mp&_nc_oc=Adrit5nmCvdXPZnn6Cr9JhESxFV4Sch2EPBI77tRJdPeHwiFn3V1SWB1R9hBsUgroTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-lkSMwnNg8iziewv7rwa1EgpFySO3N0DvsAI2bIqdsg&oe=6A676B21"}, "display_name": "VR Travel", "keywords": [], "long_description": "Your guide to wonderful places of the world. Photorealistic and volume of stereoscopic VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places. \n\nInstructions:\nFirst of all, please sit down and make yourself comfortable.\n-Yes, you can go around the room and fly (look up and use left ThumbStick)\n-Please select and download a tour that interests you.\n-Use Oculus button to reset your view.\n-The volume of the guide's voice is controlled by the buttons on your helmet.\n-The volume of background music is controlled on the side menu tour's room.\n\nOur team consists of 3 people, each review is like a family holiday for us. We read them out in the family circle and disassemble them into atoms to make the application more convenient.\nYour feedback and opinion are highly valuable for us! \nYou can do it here, and in the discord channel.\nThank you!\nhttps://discord.gg/BMYXT5fysk\ninfo@vr-travel.site", "short_description": "VR TRAVEL - your real 3D stereo guide to most unique places of the world. Photorealism of VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1fR-0VY0lebEUvGSO4LjX_Ov7Lg1Lc918ICEz_XoAIb8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Michael Phylattos", "support_website_url": "https://vr-travel.site/", "website_url": "https://vr-travel.site/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MO
scdn.com&_nc_ss=7f20f&oh=00_AQK5JBOQfQTCooBfbCJ_DXkcrFx2G3nQfhyiKjq58ByUHw&oe=6AA8196B"}, {"file_name": "Oculus_scr_002_1.png", "id": "332335632143841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569471_332335635477174_358272859827474423_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWoBb4bOuOoQ7kNvwEWH4jn&_nc_oc=AdqS7dcOof33Sp48D1Y3gQsXKgP-OD-0b2hKyZ_gK2Q40VZhq_5f1SLopJGaotLCUtw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0Jjl6E_alt-iQWxqniv9Cu6SENXR_clY7GKC48uz_tg&oe=6AA7EC3F"}, {"file_name": "1Scr_001_3.png", "id": "351810483615000", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_351810486948333_8237110008595509183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGZSVzxIaiAQ7kNvwEIdVii&_nc_oc=AdrmDEM3evsYnYKCeSmzd-18q_BUBLSPzJKQmIquq5Vn8FdWOy8MFN3c30htkltdMoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpXQ9z85cYx1zjsTG8i_ZwMXGiK_PPcdubszuZtOiODg&oe=6AA81244"}, {"file_name": "1Scr_001_4.png", "id": "7209753802383102", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75251816_7209753805716435_3056192221886878472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-CdLq4_b7gQ7kNvwGTw6XP&_nc_oc=AdrItr0wwkjmyPLlYA1dtv25sG38596_nbQ77M9WyPhSIbZX3u6SckUMxw8KDlUH1ek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRDJnvULx5COUy6yDaZfUzSH3SWyDq_8t1fq4CDZM4vQ&oe=6AA7EA67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_scr_002_1.png", "id": "668818354251530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035360_668818364251529_1258103518041698246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhNQXUswigwQ7kNvwH8HpIx&_nc_oc=Adp-Blx1i-13jbP3FYLDEkZ5AXolgq_9Pf1i0GeVfqfWf6JfBivgSmnYh9ss9H_fUmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvHGLP5KiyV9UilW2an5oRUthWp7HEALSACYC8Dhzrqg&oe=6AA804A1"}, "display_name": "VR Travel", "keywords": [], "long_description": "Your guide to wonderful places of the world. Photorealistic and volume of stereoscopic VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places. \n\nInstructions:\nFirst of all, please sit down and make yourself comfortable.\n-Yes, you can go around the room and fly (look up and use left ThumbStick)\n-Please select and download a tour that interests you.\n-Use Oculus button to reset your view.\n-The volume of the guide's voice is controlled by the buttons on your helmet.\n-The volume of background music is controlled on the side menu tour's room.\n\nOur team consists of 3 people, each review is like a family holiday for us. We read them out in the family circle and disassemble them into atoms to make the application more convenient.\nYour feedback and opinion are highly valuable for us! \nYou can do it here, and in the discord channel.\nThank you!\nhttps://discord.gg/BMYXT5fysk\ninfo@vr-travel.site", "short_description": "VR TRAVEL - your real 3D stereo guide to most unique places of the world. Photorealism of VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1fR-0VY0lebEUvGSO4LjX_Ov7Lg1Lc918ICEz_XoAIb8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Michael Phylattos", "support_website_url": "https://vr-travel.site/", "website_url": "https://vr-travel.site/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MO
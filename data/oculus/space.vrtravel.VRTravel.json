scdn.com&_nc_ss=7f20f&oh=00_AQNyMk-mz5aAKN61FxiggTvCAd-_nEmOcK2VqRjiya0YNg&oe=6ACA606B"}, {"file_name": "Oculus_scr_002_1.png", "id": "332335632143841", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569471_332335635477174_358272859827474423_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq_axyY1ZoAQ7kNvwGG6sCy&_nc_oc=AdoirKFY-CcUAeveXJ6fJqGvSPSbD3zrNzMfoxhSdOwAb2tJA1zAYf1nAWfO7OEzu0Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJQHdhPcGULYI2gE2b3yg1-FBw_JVFblUmCZjwJ7HtcQ&oe=6ACA6B7F"}, {"file_name": "1Scr_001_3.png", "id": "351810483615000", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_351810486948333_8237110008595509183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-KaCZj2eOEQ7kNvwHppucC&_nc_oc=AdqbL0Xeo5WuJ42TlVrfIO05QFW0s_ho2uKkwolH0NzLXs6MjU5i_vZHmR0H7eceOKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYf6i7ylPvnAV84HxRU8kqVrQAabPT4hU0S4hDmN5yCg&oe=6ACA5944"}, {"file_name": "1Scr_001_4.png", "id": "7209753802383102", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75251816_7209753805716435_3056192221886878472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vt9Y9ZbM4dIQ7kNvwEbkmk-&_nc_oc=AdpL-PzFYi0mX_Wrs32WwyOu8NKJpCNTA8vAs-uWM3DLBBtXg41XutBQeYQ_7HdvghE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxDRVYUVNKpzYvDTyLX1u_n967LejW825uy2EUQaW63A&oe=6ACA69A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_scr_002_1.png", "id": "668818354251530", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035360_668818364251529_1258103518041698246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e179A4iEDK0Q7kNvwFjK79w&_nc_oc=AdrZRrFd464B1umuDUyr2VmhU9mv5MbMzqaSZkQnXku6caFGIo65GewbxuqyMQ-I1Uw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLUHgMvsZA8M0kZa7K8A94eenzAWUu6lm35QHMujvQsA&oe=6ACA4BA1"}, "display_name": "VR Travel", "keywords": [], "long_description": "Your guide to wonderful places of the world. Photorealistic and volume of stereoscopic VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places. \n\nInstructions:\nFirst of all, please sit down and make yourself comfortable.\n-Yes, you can go around the room and fly (look up and use left ThumbStick)\n-Please select and download a tour that interests you.\n-Use Oculus button to reset your view.\n-The volume of the guide's voice is controlled by the buttons on your helmet.\n-The volume of background music is controlled on the side menu tour's room.\n\nOur team consists of 3 people, each review is like a family holiday for us. We read them out in the family circle and disassemble them into atoms to make the application more convenient.\nYour feedback and opinion are highly valuable for us! \nYou can do it here, and in the discord channel.\nThank you!\nhttps://discord.gg/BMYXT5fysk\ninfo@vr-travel.site", "short_description": "VR TRAVEL - your real 3D stereo guide to most unique places of the world. Photorealism of VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1fR-0VY0lebEUvGSO4LjX_Ov7Lg1Lc918ICEz_XoAIb8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Michael Phylattos", "support_website_url": "https://vr-travel.site/", "website_url": "https://vr-travel.site/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MO
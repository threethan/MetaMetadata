scdn.com&_nc_ss=7f20f&oh=00_AQNoGBvuTDgKDyIneSH5sHTJARm4OW_bOZGAbb8G04vN7A&oe=6AC90EEB"}, {"file_name": "Oculus_scr_002_1.png", "id": "332335632143841", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569471_332335635477174_358272859827474423_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hq_axyY1ZoAQ7kNvwHX5l_2&_nc_oc=AdouZTEiZVU85bK5fLz5fFCSCQSET7CjUrClN0Fe8chTaWyBuaGETArdyZD6PWqnNlQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpybr04uLIMjLc8pDi60PnnijFOlMlUojrz5Ws2SPznQ&oe=6AC919FF"}, {"file_name": "1Scr_001_3.png", "id": "351810483615000", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031379_351810486948333_8237110008595509183_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXooYjeGT2wQ7kNvwFGOawi&_nc_oc=Adq5BkJ3nJVQEnEWkEyCgQMUZDeEZaLYG4zmfCSWmKZyeH2u5iHya4iI2ZbDjmUry-g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6HuhLCBavQeZtaK2c6NG35KaCuWS3coF4aoHUepw4oQ&oe=6AC907C4"}, {"file_name": "1Scr_001_4.png", "id": "7209753802383102", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75251816_7209753805716435_3056192221886878472_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYgrxa20RUoQ7kNvwE-A3HH&_nc_oc=Adp9LWBdQ8E3Der4KjzhfZkSnSe7lxsq6IIt5tYqnFCIlyNHe04eWOS6jiF_B7d_hGM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu9F8uDcCznBGesQNPtjVzwDMo7_BzBoV6-Stm4XUc6Q&oe=6AC91827"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_scr_002_1.png", "id": "668818354251530", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035360_668818364251529_1258103518041698246_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e179A4iEDK0Q7kNvwE28Sj2&_nc_oc=AdrKZmO5y49KJbPBgo_Eu1t0xczRS2ZFqmtFUgH9BU9gb_PLGSfp14-S6yT5TIpyb8M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMizQbHZ-yoSaawriDZkpKW3FG9QRPJ5rEWyb84KQknsQ&oe=6AC8FA21"}, "display_name": "VR Travel", "keywords": [], "long_description": "Your guide to wonderful places of the world. Photorealistic and volume of stereoscopic VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places. \n\nInstructions:\nFirst of all, please sit down and make yourself comfortable.\n-Yes, you can go around the room and fly (look up and use left ThumbStick)\n-Please select and download a tour that interests you.\n-Use Oculus button to reset your view.\n-The volume of the guide's voice is controlled by the buttons on your helmet.\n-The volume of background music is controlled on the side menu tour's room.\n\nOur team consists of 3 people, each review is like a family holiday for us. We read them out in the family circle and disassemble them into atoms to make the application more convenient.\nYour feedback and opinion are highly valuable for us! \nYou can do it here, and in the discord channel.\nThank you!\nhttps://discord.gg/BMYXT5fysk\ninfo@vr-travel.site", "short_description": "VR TRAVEL - your real 3D stereo guide to most unique places of the world. Photorealism of VR tours gives you the pleasure of a place as if you are there yourself. See all the minor details, unforgettable panoramas and views of your favorite places."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1fR-0VY0lebEUvGSO4LjX_Ov7Lg1Lc918ICEz_XoAIb8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Michael Phylattos", "support_website_url": "https://vr-travel.site/", "website_url": "https://vr-travel.site/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "DOCUMENTARY_HISTORY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MO
SomeLevel132679504008316256.png", "id": "127304822825290", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974591_127304826158623_4600186409568997445_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXkbL1Hye6kQ7kNvwG4fb8Z&_nc_oc=AdoHe8stWkIhrAs_LCE-emW6tV-WnlG0BtE6mGPf0DV0tBJQMGFWqaBTa3hv4PjnCEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAMwzYNurcpS5GkbjKxp7KRIZwhtDyPPXfje7KLq_CNw&oe=6B05AFDD"}, "display_name": "Tank Battle", "keywords": [], "long_description": "Tank Battle is the fastest tank game ever. In the game, you have to fight with 50, 100, even 150 tanks. Your tanks must fire enemies and move as fast as possible, avoid enemy's bullets and destroy other tanks. There is no time for thinking in those battles, you have to shoot or be shot, destroy or be destroyed.", "short_description": "Tank Battle is the fastest tank game ever. In the game, you have to fight with 50, 100, even 150 tanks. Your tanks must fire enemies and move as fast as possible, avoid enemy's bullets and destroy other tanks. There is no time for thinking in those battles, you have to shoot or be shot, destroy or be destroyed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/8b35ed74-fde6-4655-b0e0-1eeda6fe1442", "developer_terms_of_service_url": null, "publisher_name": "Galaxy Lab", "support_website_url": null, "website_url": "https://www.facebook.com/galaxylabgamestudio", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
222945_204741551482647_4567201355233100325_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9DFhF4KhloQ7kNvwFB_RkV&_nc_oc=AdocZJxkWbgsmluPYs7kZH5KMh9ZLhZDGaJ5oEyjrjAFbIwDjlEDnO9qtoxECSEaBus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af397J-_6cxwTL5nKhEq5t4L6sUw9bG2gvnb97iAM3v5cg&oe=69D27D27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "idoga VR", "keywords": [], "long_description": "\"Idoga VR\" is a platform-type video distribution service for \"omnidirectional panoramic video\" that allows you to watch by moving all angles 360 degrees up, down, left and right.\nEnjoy 360 \u00b0 panoramic videos such as rich content such as concerts and theatrical performances, videos introducing sightseeing, leisure, and commercial facilities.\n", "short_description": "Supports VOD distribution and live streaming. It is a VR video player that can play super high quality VR images equipped with \u201dPanorama Cho Engine\u201d that delivers only what you are looking at in high quality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.idoga.jp/idoga-vr/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "crossdevice", "support_website_url": null, "website_url": "https://www.idoga.jp/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC_VIDEO", "MOVIE", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "
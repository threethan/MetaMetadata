_ohc=QASmS_M6NJkQ7kNvwFFGf7C&_nc_oc=AdqJc5Ot1YH96Wpi-WGJpZgiXOrONmQ19nRulUvNUYNMX5knh5f1Mjw6iZKo5N1XsrE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlz-iPHzN9xwWkq6dIKLHCfaKvy_-aSxx-OfZq_2aDpg&oe=6AF9B87B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1133849969334194", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673652249_1133849972667527_741313013308452582_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbSo7F4lgZ4Q7kNvwHu2EDW&_nc_oc=AdrTgvScMYPjnlmPvz91SBHeJByY_cLK0-ayAx6HRCvI5QjSLd4wCjIHzJ3O6M58ous&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVBOs3mCCp5gN8aFqsCfI5V5sG3t2_rrdsKl0qHop2Wg&oe=6AF9CDD5"}, "display_name": "Motorcycle Simulator Ohio", "keywords": ["motorcycle", "motorbike", "simulator", "columbus", "racing"], "long_description": "The ride of your life, from the seat - all the way round Columbus, Ohio.\n\nYOUR GARAGE\nStart astride your bike in a luxury three-car garage in Harrison West. Touch the throttle and the door lifts onto the street.\n\nTHE BIKE\nA litre-class sport bike: a live colour dash with speed, gear, lean angle and a map, two live mirrors, a smoked bubble screen.\n\nRIDE IT LIKE A REAL BIKE\nGrip the bars with your own hands. Roll your right wrist back to open the throttle, brake with your left hand, push the bars to lean into a corner. Tuck behind the screen for top speed, or turn wheelie control off and lift the front.\n\n38 KM ROUND COLUMBUS\nSR 315 - the Olentangy Freeway - north past Ohio Stadium and the Ohio State campus, up the river valley through Clintonville to I-270, the Outerbelt, across Worthington, then I-71 south all the way back in and I-670 above the Short North with LeVeque Tower and the downtown skyline beside you. Real roads, real hills, real towers.\n\nROAD EVENTS + SPEED TRAPS\nSeven events on real roads - race for gold against your own ghost bike. Six speed cameras, and Rush Hour near-miss combos on I-71.\n\nSUNSET, DAY AND NIGHT\nGolden hour over the Olentangy, bright sun, or the city at night on your headlight with the traffic's tail lights ahead.\n\nYOUR WAY\nChoose how much the view leans, bar vibration on or off, automatic or a six-speed sequential box. Speeds in mph. English and Spanish.", "short_description": "Wake up in your own luxury garage in Harrison West, Columbus, grab the bars of a litre sport bike and ride 38 km of real Ohio freeway - SR 315 up the Olentangy past Ohio Stadium, I-270 the Outerbelt, I-71 and I-670 above the downtown towers. Twist the throttle with your own wrist, lean into the bends, race road events against your own ghost. In English and Spanish."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/motorcyclesimulatorohio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/motorcyclesimulatorohio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1388519697674226"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"n
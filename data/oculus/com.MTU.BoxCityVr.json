", "Fun", "Runners"], "long_description": "welcome to box city! this game was made by MTU and HaloPlaceVR. You can play gamemodes such as glass bridge, horror, parkour, run for your life, pvp, maze, onlyup, and hangout. This game was inspired by catos, and munkie deluxe. You can make a lot friends, and might even meet staff Members! This game is free and you can play on any headset. Make sure you read the TOS and have fun!", "short_description": "welcome to box city! this game was made by MTU and HaloPlaceVR. You can play gamemodes such as glass bridge, horror, parkour, run for your life, pvp, maze, onlyup, and hangout. This game was inspired by catos, and munkie deluxe. You can make a lot friends, and might even meet staff Members! This game is free and you can play on any headset. Make sure you read the TOS and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/dd861dd4-4b20-47f9-b1e9-13896634aad7", "developer_terms_of_service_url": null, "publisher_name": "MTU", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vSC1niG5iLFuTmg4_XhPlGS5_24TvwX2--RWK9pu1FWd1tFyGtyW0oOyWOCl4LxBNA_KuJ8mY8rwFD6/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9512403365483060"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id":
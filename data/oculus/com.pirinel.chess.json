6e7a0a&_nc_ohc=myZkZz4pqxwQ7kNvwFVflRf&_nc_oc=Adlh8JJkYb_gx5-DdmD1WnqR-Fia_5fBFAMQuawi0Q6AHlbsKmuPL6pquji13yr3h6U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd16g6povEZV8GFJXL4V0leSIJzTEAz8_I7MXRL16jRg&oe=69BA8944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_026_0000.png", "id": "1663884603977026", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75451777_1663884610643692_5999330319497865154_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANfxMK7hfXAQ7kNvwGaLarm&_nc_oc=Adkp3qTawbYr4RBeYpzpk1t6kunZ9hDtKMWe-ShZx9Lq5fbQR5QtcZ-5vN4egZojMOQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy21DTaZSxmzIsKfoQ2xNl5FW5xypFPhWlgB7JCQlszPg&oe=69BA874A"}, "display_name": "Virtual Chess", "keywords": [], "long_description": "Play chess with your friends, with random people online or against the computer in a beautiful VR environment.\n\nThe game supports many different platforms - VR, smart phones, tablets, smart TVs, so you can play with your friends even if they don't use a VR headset.\n\nThere are also many online players that you can play with and the rating algorithm will make sure that you're matched with opponents of a similar strength, so you can always enjoy an interesting and competitive game.\n\nThe game has many different features besides the standard chess gameplay, including:\n- tens of thousands of interesting puzzles, where you need to find a possible checkmate within 1, 2 or 3 moves.\n- ability to analyze your games and see where you made mistakes, what better moves you could have played, what was the balance (your winning chances) at each move, etc.\n- you can optionally create an account and maintain your progress across multiple devices\n- and many others!\n\nWe hope you like it!", "short_description": "Play chess with your friends, with random people online or against the computer in a beautiful VR environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ches
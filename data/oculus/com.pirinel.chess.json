om&_nc_ss=7f20f&oh=00_AQS2aK9oA6xaupgXm5VvioO5A-y_62_ZPUk8ia8VH4w_Aw&oe=6B005C5D"}, {"file_name": "image_031_0000.png", "id": "667507181187605", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75612006_667507184520938_286378313808694078_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vd94x8itd7AQ7kNvwFmH0cn&_nc_oc=AdqqDsoQ-5xq3p-YpW-76A_pmTtfRioLoJ609zovoxrIVC-ipBFOY-qdizYnL5liZEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQJ2c06ZLj80nd3AfMQrwY7t9cWHxjGSDI8i-hSfa8Hw&oe=6B0087EC"}, {"file_name": "image_033_0000.png", "id": "265075939050528", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297580_265075942383861_4557208847552725230_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaXXKeM4rSsQ7kNvwGP5k7m&_nc_oc=Adpk25wpfn8EpTCi9q3gQ0piKVngz8xQtUTBubIASXcSOSCPsiAvtArQSoPt9tgjtwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdDXeOFs_yDcCyf1f53AvSURrOWQTkBUJYbJXsJ_WrLA&oe=6B006404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_026_0000.png", "id": "1663884603977026", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75451777_1663884610643692_5999330319497865154_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIdC0fvnrPIQ7kNvwE5JsPp&_nc_oc=AdoJmbjniisYwGZUD0rg-rkjAbyvTkrzCapl7dePasJveWz26alunTEUihmkIWxw5z4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6I-zDTaQUFsfSvd7wIjooOn9kITwX8HpmRPWzPE2qtg&oe=6B00620A"}, "display_name": "Virtual Chess", "keywords": [], "long_description": "Play chess with your friends, with random people online or against the computer in a beautiful VR environment.\n\nThe game supports many different platforms - VR, smart phones, tablets, smart TVs, so you can play with your friends even if they don't use a VR headset.\n\nThere are also many online players that you can play with and the rating algorithm will make sure that you're matched with opponents of a similar strength, so you can always enjoy an interesting and competitive game.\n\nThe game has many different features besides the standard chess gameplay, including:\n- tens of thousands of interesting puzzles, where you need to find a possible checkmate within 1, 2 or 3 moves.\n- ability to analyze your games and see where you made mistakes, what better moves you could have played, what was the balance (your winning chances) at each move, etc.\n- you can optionally create an account and maintain your progress across multiple devices\n- and many others!\n\nWe hope you like it!", "short_description": "Play chess with your friends, with random people online or against the computer in a beautiful VR environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chesshold.com/privacy-policy", "developer_terms_of_service_url": "https://chesshold.com/terms", "publisher_name": "Pirinel", "support_website_url": null, "website_url": "https://chesshold.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "479781947223135"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1237471331127882"}, {"status": "PUBLISHED", "id": "927339335678459"}, {"status": "PUBLISHED", "id": "553922430841982"}, {"status": "PUBLISHED", "id": "1598983204389421"}, {"status": "PUBLISHED", "id": 
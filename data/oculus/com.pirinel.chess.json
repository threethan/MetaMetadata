6e7a0a&_nc_ohc=XMJkcr-13HAQ7kNvwEnsUcu&_nc_oc=Adoq9iq4z-W8ZWsBfPMeaohMFxKPfRu4cpbz6HU018yEa5qwvgDclOi58hpeEsYVRUQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4T0xtsByoHXB3d7LZ-CJ0pIdNTJ3UQs56UoQ2J4jP1A&oe=69C120C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_026_0000.png", "id": "1663884603977026", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75451777_1663884610643692_5999330319497865154_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUAOhDA1aSAQ7kNvwFDxVtA&_nc_oc=AdrAx5we6qH25qwuX97uKso1ZbcFz-xDRl7u5vlMUH3_HDb6IBin7k4DqXEpjDeNBqk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzpe1mp-B_2anWlnbXZquzrRam1623kw8ZjxkhudQrXMQ&oe=69C11ECA"}, "display_name": "Virtual Chess", "keywords": [], "long_description": "Play chess with your friends, with random people online or against the computer in a beautiful VR environment.\n\nThe game supports many different platforms - VR, smart phones, tablets, smart TVs, so you can play with your friends even if they don't use a VR headset.\n\nThere are also many online players that you can play with and the rating algorithm will make sure that you're matched with opponents of a similar strength, so you can always enjoy an interesting and competitive game.\n\nThe game has many different features besides the standard chess gameplay, including:\n- tens of thousands of interesting puzzles, where you need to find a possible checkmate within 1, 2 or 3 moves.\n- ability to analyze your games and see where you made mistakes, what better moves you could have played, what was the balance (your winning chances) at each move, etc.\n- you can optionally create an account and maintain your progress across multiple devices\n- and many others!\n\nWe hope you like it!", "short_description": "Play chess with your friends, with random people online or against the computer in a beautiful VR environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ches
zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvMJE7vxVpo0GBayts1drIZ78F-5HG2cwfGRymvrGUwA&oe=6B005DD1"}, {"file_name": "Vinetra_Scrshot4.png", "id": "26280596071559872", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819417_26280596088226537_1801709383045881708_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFW6Kt9KBQ8Q7kNvwF3di9i&_nc_oc=Adrky9voPY0RFVUaNYS9iVPN1bx6d9-CjA4xoV7myClCiCst9yF1YWd1L4swgb6j5C8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTV9NelvLAIlZGIQaL0nYXjWrh1Q5GroutHcDphEz5SA&oe=6B0083B3"}, {"file_name": "Vinetra_ShopScrshot.png", "id": "1707603466926915", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300603_1707603470260248_3050791000607569862_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2K84VRY-IIkQ7kNvwEXDPDB&_nc_oc=Adp_IVhPluRne7kYdp45RVMWoS8E42iQxLZp6BJA2prAXKXiCJgg5F5HkHQmf5_HrYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY7vDaAdsgQGnMV85ZKnlLT70XodS35VaUUdvS-DoprQ&oe=6B006D3A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vinetra: Multiplayer Survival", "keywords": ["survival", "multiplayer", "pvp", "roguelite", "gorilla"], "long_description": "# Vinetra: Multiplayer Survival\n\n\n**Features**\n\n\ud83c\udf32SURVIVE THE WILD\n- Physics based locomotion makes movement fun and engaging. Use your hands to run, climb, and survive in a large open world designed for movement.\n\n- Every life is a new attempt. Master the mechanics, learn the map, and survive longer than your last run. Permadeath coming soon in a free update!\n\n\n\ud83c\udf92CRAFT & TRADE\n- Inventory management: Every slot matters. Balance your resources between food, tools & materials.\n\n- Sell & Trade for the weapons you need to survive the night. From primitive weapons to essential gear, your survival depends on what you can get.\n\n\u2694\ufe0f12 PLAYER BATTLES\n- You aren't alone. Compete or cooperate with up to 12 players in a free for all environment where placing full trust in someone can end in your demise.\n\n\u26a0\ufe0fEARLY ACCESS NOTE\n- **Vinetra is in early access.** Please expect bugs. Report them in-game, or in our Discord server, and help make Vinetra better for everyone!\n\n**Join the official Vinetra Discord server:** discord.gg/w7RexKP7Ng\n\n**How long can YOU last?**", "short_description": "Vinetra is a multiplayer survival game. Survive with up to 12 others in a huge map where placing trust in someone can lead to your demise."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vineswingersgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Vine Swingers Games", "support_website_url": null, "website_url": "https://www.vineswingersgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28911202811841978"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310731_26268129602820211_1764799388594693094_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyopxdpIbYwQ7kNvwEQiCNC&_nc_oc=AdoIcWNYJItf-wZczALhy8K6lUrid7X_m2RdIG35XPmRX_mb5-xmBKzF-jDNkzw57Ko&_nc_zt=3&_nc_ht=scontent-iad3-1.
ontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6_bhFUEdQPcx9KWMoP3H8aWgX9FaShh_UkliwxwvvpQ&oe=6A563F46"}, {"file_name": "Screenshot_com.VRFactory.VRBartenderSymulator_2022.03.23-07.34.53.746_672.png", "id": "636036637494053", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974593_636036640827386_5574898335345545828_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSeiq58I6xYQ7kNvwErTWPy&_nc_oc=AdrD9EeemEZ-01Mi9hf2IcmZiZI5k6bCuURrBHDTAFNhMPkpU_P2YBcnUwd6XxhVzJI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9IDuthCvmS-cyBcWQUYYP7V3PwO6-iyF-C6P32uXdqg&oe=6A563FA7"}, {"file_name": "Screenshot_com.VRFactory.VRBartenderSymulator_2022.03.23-07.33.16.781_056.png", "id": "1131739147592444", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031427_1131739150925777_6967941911669488657_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTge--li2qIQ7kNvwFIxXNd&_nc_oc=AdqBXDpeauQp--OhFsUCPhjNEIly2H8lgdk7bDy0t07DZQARytBC7pNfdAnyNRNO5Cs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9li7faT9I3dyJ2pxUO3VnUSXwgJ6LqIjv8SPZ_3lVJQ&oe=6A5640F9"}, {"file_name": "Screenshot_com.VRFactory.VRBartenderSymulator_2022.03.23-07.34.06.936_774.png", "id": "674566467023618", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57569445_674566470356951_7066716002191437089_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIlHJh949t0Q7kNvwFO6a01&_nc_oc=Adq8BbPL_If0I64Ik79aT-kdSCxuQHI4f8nx07aPkV_CDUuD2Tqk6TY8KdfpVaZZr5Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhoAIZk8G6iLiHea_FUwtjWQ3-_uDubS7zK1BnAiVM3Q&oe=6A564F4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "db1c4c5d53e8430f200cfb9e298a0d37.png", "id": "359125009450435", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031379_359125016117101_6015394047178847806_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5Hyu4X8ytYQ7kNvwHMm4ea&_nc_oc=Adrm9leTDYYOCm_YbU5Y41PFGyJyLJZ6uKONUNIyWVWWUtcOqGTG7xuvtQvF8FZp5PA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwCyW2KTVqDobq9nB_oETEyL0ntiPh4Un-T_tRPqj2Yg&oe=6A5642CB"}, "display_name": "Bartender VR Simulator", "keywords": [], "long_description": "Working in four unique and professionally equipped virtual bars, you will experience the thrill of the art of bartending under the watchful eye of Tomasz Ma\u0142ek, a six-time Bartending World Champion. Begin your journey in a music club and learn how to make four basic drinks. Prove yourself and win the opportunity to train and work in the next location. Master more and more demanding drinks as you progress to new, unique bars.\n\nA range of drinking glasses to chose from, different liquors, beverages and additions. Crushed or cubed ice? Professional bartending know-how. Various bartending techniques. Real-life liquid physics and item destruction. Juggling with bartending equipment and drink ingredients. We serve it all in a super-realistic quality.\n\nWho will earn most money in each bar? Who will make a perfect drink in the shortest time? Who will earn the biggest tip for a single drink by mesmerizing the customers by using the flair technique? ", "short_description": "Bartender VR Simulator offers you a unique combination of a simulator, bartending course and incredible immersive VR game. Developed in cooperation with a six-time Bartending World Champion, Tomek Malek"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bartendervrsimulator.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "VR Factory", "support_website_url": null, "website_url": "http://www.bartendervrsimulator.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": 
_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GUT7wmFCH0Q7kNvwHkajwB&_nc_oc=Adps0zaclxx-SdDasEd0qop2euf7vMMl93LF5y8X1EE2h2V9cuzeoFf3qmMhsSeZz9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcalvXocsBxgT5ypX2FRsGs1LtgIiUv5kSeYGAhhEQPA&oe=6B0C6A7B"}, {"file_name": "05-bamboo-temple-hai.png", "id": "1085651980839982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619602_1085651984173315_8308134302841811369_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXsypo30UuEQ7kNvwEMcZQ5&_nc_oc=AdqyDAaSohZ5TQtUYuymsvNEavCJFP4fc7eiRfZVE74XkOWWA254jza1FdKE8a6U9XA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7nLTj6tFCw5CE4RArrrQJ7oyWBuj0tOzcyQr9DOyNbw&oe=6B0C6D77"}, {"file_name": "02-sumo-stable-osu.png", "id": "1100879695814663", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628092_1100879699147996_4913274930105366672_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMD3cRcueroQ7kNvwHPBguS&_nc_oc=AdoHq1DeurBxkT-ur4RepaZeq-Hnj1M-Lz6vxyxu5tTYzwcFyWvf_fjvIEOpD081u1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRuzkT9fcfyvVNG0wJEbJuCK1V-ARCYIUP0BnInjRye2Q&oe=6B0C7217"}, {"file_name": "01-little-italy-bam.png", "id": "1898295667908364", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623115_1898295671241697_3390723694399816174_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Wwl3EzhjSsQ7kNvwGdTN1G&_nc_oc=AdrpQCxj0GDCNg-tOF-TWpYYzKVMBOZtzHH2NVUffH5ERSUl05-MmgDsMAzBINHWFZ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5erle0Hd_tK-mc4x9B-zPAzH5g4RPjyWtIF1nhWiS3g&oe=6B0C5A63"}, {"file_name": "03-alien-moon-zweep.png", "id": "1112259261299798", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593845024_1112259267966464_2452910603370105699_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLxccGgM9dMQ7kNvwHBT4eD&_nc_oc=AdqWIoPjK0cF1xO6eI-Y23XFQlBB7QXxQvV26r6NKZluntJLt8lTQ_4U5vraiAZ3fHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNYN0VWDU2ioDD6wz98iEVI9DcFFzXHeNxnppAvlB6Aw&oe=6B0C6FFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Punch Maths VR", "keywords": [], "long_description": "**Punch maths. Literally.** Step into the ring, read the question over the ropes and throw real punches at the goon wearing the right number. Fast thinking meets fast hands, in the arcade boxing game that makes mental maths a workout.\n\n## How it plays\n- Read the question on the sign\n- Punch the goons that make the answer, in order\n- A wrong goon costs a life, and you only get three\n- Solve it and the rest are free punches for bonus points\n\n## Modes\n- **Career**: 10 venues, from Backstreet Gym to the Alien Moon, up to 5 stars per level\n- **Daily Bout**: 10 rounds, the same for everyone\n- **Equation Run**: beat the clock\n- **Endless**: how far can you go?\n\n## Why you'll love it\n- Real punches with your Quest controllers: a proper cardio and brain workout\n- Addition, subtraction, times tables, division and multi-step maths\n- Chain hits for combo multipliers and big scores\n- Goons get launched into the crowd, bounced off the ropes or felled like timber\n- A cartoon cast with plenty of trash talk\n- Difficulty adapts to you, so it stays challenging but fair\n- Play standing or seated\n\nPerfect for students, parents and anyone who wants sharper mental arithmetic. Lace up and start punching!", "short_description": "Throw real punches in VR to solve maths! Read the question on the sign, then knock out the goons wearing the right numbers. Addition, subtraction, times tables and division in a fast, fun arcade boxing workout. Wrong goon? Lose a life. Beat the clock, chain combos and fight from Backstreet Gym to an Alien Moon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://panzerlabs.in/punchmaths/vr/privacy-policy/", "dev
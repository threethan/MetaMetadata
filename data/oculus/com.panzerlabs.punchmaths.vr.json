Dly6jLEJ2Ut4riz6rMcFXVr9QujOSqg7C1xW10_Or4TwaDLsOzz5LjmPzrt_FUDg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWIHo2bUsPd12BXsR6cpWxHtKeil82sNy_7qAhPiKV_g&oe=6AFDB73E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Punch Maths VR", "keywords": [], "long_description": "**Punch maths. Literally.** Step into the ring, read the question over the ropes and throw real punches at the goon wearing the right number. Fast thinking meets fast hands, in the arcade boxing game that makes mental maths a workout.\n\n## How it plays\n- Read the question on the sign\n- Punch the goons that make the answer, in order\n- A wrong goon costs a life, and you only get three\n- Solve it and the rest are free punches for bonus points\n\n## Modes\n- **Career**: 10 venues, from Backstreet Gym to the Alien Moon, up to 5 stars per level\n- **Daily Bout**: 10 rounds, the same for everyone\n- **Equation Run**: beat the clock\n- **Endless**: how far can you go?\n\n## Why you'll love it\n- Real punches with your Quest controllers: a proper cardio and brain workout\n- Addition, subtraction, times tables, division and multi-step maths\n- Chain hits for combo multipliers and big scores\n- Goons get launched into the crowd, bounced off the ropes or felled like timber\n- A cartoon cast with plenty of trash talk\n- Difficulty adapts to you, so it stays challenging but fair\n- Play standing or seated\n\nPerfect for students, parents and anyone who wants sharper mental arithmetic. Lace up and start punching!", "short_description": "Throw real punches in VR to solve maths! Read the question on the sign, then knock out the goons wearing the right numbers. Addition, subtraction, times tables and division in a fast, fun arcade boxing workout. Wrong goon? Lose a life. Beat the clock, chain combos and fight from Backstreet Gym to an Alien Moon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://panzerlabs.in/punchmaths/vr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Panzer Labs", "support_website_url": "https://panzerlabs.in/punchmaths/support/", "website_url": "https://panzerlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1356206040912336"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1671295457723822"}, {"status": "PUBLISHED", "id": "1738005067272583"}]}, "baseline_offer": {"id": "1671295457723822"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793170740, "status": "PUBLISHED", "id": "1671295457723822"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1419888301210776", "version": "1.8"}, "id": "1873669037132634", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1324610780738529", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1419888301210776"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794164516, "id": "1420549674477972", "version": "1.8.2", "version_code": 10, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1324610780738529", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1419888301210776"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1873669037132634"}]}, "change_log": "\"Punch Maths VR 1.8\\n\\n- 10 new venues and 50 new levels (100 in all), with new topics: percentages, fractions, powers, brackets, missing numbers, negatives, units, patterns, ratios and averages.\\n- Many venues are now full 3D places instead of painted backdrops.\\n- Redesigned menus in a sports style, with punching bags to warm up on and a trophy room for your venue wins.\\n- New crowds, new things to punch with, and livelier scenes: flickering torches, swimming fish, flying bats.\\n- Many visual fixes and polish.\"", "created_date": 1794142487, "id": "1419888301210776", "version": "1.8", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1324610780738529", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1419888301210776"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1873669037132634"}]}, "change_log": "\"Bug fixes and stability improvements.\"", "created_date": 1793383051, "id": "1395841523615454", "version": "1.5.4", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1324610780738529", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1419888301210776"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1873669037132634"}]}, "change_log": "\"Punch Maths VR 1.5.0 - rebuilt as a native Quest app.\\n\\n- Starts in seconds, plays offline.\\n- Every venue has its own thing to punch with: boxing gloves, a giant sumo palm, nunchaku, a jade fist, a frying pan (with a pizza in it), a gladiator's flail, a rocket fist and an alien zapper.\\n- Cheering crowds in the arenas, a new career map with fight cards, and more realistic gloves.\\n- New setting: Share usage & crashes. Anonymous stats and crash reports help us fix bugs; you can turn it off any time in Settings.\\n\\nNote: progress from the previous version does not carry over, so everyone starts fresh.\"", "created_date": 1792960204, "id": "1383945841471689", "version": "1.5.3", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1324610780738529", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1419888301210776"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792957654, "id": "1383901008142839", "version": "1.5.2", "version_code": 6, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": nu
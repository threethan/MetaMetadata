N0rEZtg-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSblnDX4JEyDLfdmmJE6DaiD7-8WiTI580cI6m_belHDA&oe=6AFDAFF2"}, {"file_name": "14-frozen-fjord-thud.png", "id": "1621581892239004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593761155_1621581895572337_125116021333002851_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVfxXvTaUucQ7kNvwGanwSv&_nc_oc=AdqW4i1rfJjG-tzL-GQT-ptoGQfzfSes-eAREWp_Pchnq-VPDaznvogeJ7QUGxUZZoQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUIGlw5MljM9ncj5r7pNoBc6CfAXK4tnvhpXSK7t4NNw&oe=6AFDBED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Punch_Maths_VR_Trailer_Cover_Clean_2560x1440.png", "id": "3561520527355446", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623111_3561520530688779_4292992240314595547_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQwW6fuycq0Q7kNvwGqCqdU&_nc_oc=AdrOFfI-shyal5uFeikus5OZUfiov3rx4kBFOM1KtrN1KQlJMJDG48Q9pJjUfF4jOY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUf4bwiZPpCFDYYZnvvTqcPaJwlsTZxipuHwg9JWHZFA&oe=6AFDE52B"}, "display_name": "Punch Maths VR", "keywords": [], "long_description": "**Punch maths. Literally.** Step into the ring, read the question over the ropes and throw real punches at the goon wearing the right number. Fast thinking meets fast hands, in the arcade boxing game that makes mental maths a workout.\n\n## How it plays\n- Read the question on the sign\n- Punch the goons that make the answer, in order\n- A wrong goon costs a life, and you only get three\n- Solve it and the rest are free punches for bonus points\n\n## Modes\n- **Career**: 10 venues, from Backstreet Gym to the Alien Moon, up to 5 stars per level\n- **Daily Bout**: 10 rounds, the same for everyone\n- **Equation Run**: beat the clock\n- **Endless**: how far can you go?\n\n## Why you'll love it\n- Real punches with your Quest controllers: a proper cardio and brain workout\n- Addition, subtraction, times tables, division and multi-step maths\n- Chain hits for combo multipliers and big scores\n- Goons get launched into the crowd, bounced off the ropes or felled like timber\n- A cartoon cast with plenty of trash talk\n- Difficulty adapts to you, so it stays challenging but fair\n- Play standing or seated\n\nPerfect for students, parents and anyone who wants sharper mental arithmetic. Lace up and start punching!", "short_description": "Throw real punches in VR to solve maths! Read the question on the sign, then knock out the goons wearing the right numbers. Addition, subtraction, times tables and division in a fast, fun arcade boxing workout. Wrong goon? Lose a life. Beat the clock, chain combos and fight from Backstreet Gym to an Alien Moon."}]}, "developer_name": null, "developer_privacy_policy_url": "https://panzerlabs.in/punchmaths/vr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Panzer Labs", "support_website_url": "https://panzerlabs.in/punchmaths/support/", "website_url": "https://panzerlabs.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1043107547362485"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1419965544536385"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622192_807037329171778_7371932811937382484_n.png?stp=dst-png_
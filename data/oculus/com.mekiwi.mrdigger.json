061681_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGumIMs8zd0Q7kNvwEfSs0n&_nc_oc=AdqqWzPW6uH0Dbqejb2IGFrQ4QWJxpuMFJ46YVjcmco8fXglR7aYXWDYmRX3xHOkF-c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ZhPK4tFgq9BhFm86Ua_Bg5K4DKeGu_UgUMJ1X6-aT6Q&oe=69F1E697"}, {"file_name": "Roomwrecker__0000_roomwrecker_screens__0037_2023-12-20-12-45-41.mp4.00_02_34_39.Still034.png", "id": "287664217114570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035326_287664220447903_3952348847953228022_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4g64tjQ38woQ7kNvwFMxVO8&_nc_oc=Adr2YOdgVxDVPRNlHPFx5oaJVoye9KpAYemJ8cz2DqinAPgydBqh5YJzfWDDF6_j5DY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af05SUhaobc8FrcRfLA5x6RP8RKQUi_11A4-ZvoFK4b0Rw&oe=69F1FAD8"}, {"file_name": "roomwrecker_screens__0073_2023-12-20-12-25-12.mp4.00_08_18_27.png", "id": "891296669061553", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031588_891296679061552_3394896350236532114_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqcG_bL7eswQ7kNvwEK4s_O&_nc_oc=Adozmai2MzLE9O1XsMUO7wY8rqlxvIvmwtxZ7C9lHqx2ZTNzsozBKty-wWr255WG-E4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3bHO9dcH148YrG_dD6wxDTwd3uW5RmxrwFvQDrh5J8qg&oe=69F1E8AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mrdigger_trailer_thumbnaIL_22.png", "id": "862518105372389", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031370_862518108705722_8194575130590500736_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMhSgtVAqU8Q7kNvwG-8FJ_&_nc_oc=AdqKyxzdt-LWWWyS5w0BlHsbrJEHKZXd9wWxeAvhRVtXV47YzFxxCggWSq2BQuwfg5o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0sft_KrnAV2s04yWAudkuSL56V_w--RlZ8CzqcODIrmg&oe=69F21078"}, "display_name": "Cave Digger Room Wrecker", "keywords": ["cave", "digger", "mr", "mixed"], "long_description": "The early access version of the latest title in the Cave Digger franchise is now out for Meta Quest 3 and Meta Quest Pro!\n\nGo to the caves, scan the surroundings for hidden valuables, and dig them up with a pickaxe. Claim the loot with Loot Vacuum, keep thieves away from your hard-earned riches using a six-shooter, and return home to feed your pet Chompy the living treasure chest! As you feed it, it grows.\n\nCave Digger Room Wrecker, the third installment of the Cave Digger VR game series, takes a light-hearted, arcade, and whimsical approach to the franchise's world while taking advantage of the game-changing MR tech features found in the latest Quest device generation.\n\nSo, take your pickaxe, turn your home into a cave, and start looting while taking care of your own Chompy with the riches you discovered! Experience the wall and groundbreaking Mixed Reality gameplay in the long-standing franchise of Cave Digger!\n\nFor the latest updates, exclusive sneaky-peeks, and 24/7 Saloon talks (memes), join Cave Digger Discord community -> https://discord.com/invite/cavedigger\n\nAlso, check below the other titles in Cave Digger franchise:\n\n- Cave Digger is where it all started! Take your pickaxe and get to the train! For the stone and rock!\nwww.oculus.com/experiences/app/1551165681653074\n\n- The sequel Cave Digger 2 Dig Harder includes the first-ever crossplay at this scale: pretty much all platforms in both VR & standard gaming!\nwww.oculus.com/experiences/app/4687168774709280", "short_description": "Transform your room into a cave, meet your old friend Chompy the living treasure chest, and feed her the loot hidden in your walls. Scan the surroundings for hidden valuables, dig them out with a pickaxe, and keep thieves away from your hard-earned riches! Experience the wall and groundbreaking Mixed Reality gameplay in the long-standing franchise of Cave Digger!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VrKiwi", "support_website_url": null, "website_url": "ht
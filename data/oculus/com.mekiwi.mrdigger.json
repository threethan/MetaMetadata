D&_nc_oc=AdkO9ZH7ChQwzIv14_jKSYu30NP9lQxdZ3sm0sfoNDtt3hOVI_aIOfBXdkFaqqGdx9Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftl8YCQ1LIq097qCqzx6qcgDSSG_dR-jiJ1EfvWICM_5g&oe=69A41E17"}, {"file_name": "Roomwrecker__0000_roomwrecker_screens__0037_2023-12-20-12-45-41.mp4.00_02_34_39.Still034.png", "id": "287664217114570", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035326_287664220447903_3952348847953228022_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7i3OGSbn19gQ7kNvwGAfqVu&_nc_oc=AdmnxVgX2qOdvgODKPg4ZGBROxwqlFuBOLHB7R34bVJu6pPbKxfQGtsEbPCqkdRUA3s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftES1wn0lMg30dQ7AEps26bgoj372GWR1gKXP4clbxKng&oe=69A43258"}, {"file_name": "roomwrecker_screens__0073_2023-12-20-12-25-12.mp4.00_08_18_27.png", "id": "891296669061553", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031588_891296679061552_3394896350236532114_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Go5EvQKJYcAQ7kNvwEoaMII&_nc_oc=Adm4uK6MWbFXgVPUATPHdnG6KRpLkTRl3kHjgiKCnRmPGEbV6IloD28h4Bke6a6oMq8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfspqfzrvmJ14KCj6S9Urjn8smL21tnmgS6ZGltjkNQTzA&oe=69A4202C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mrdigger_trailer_thumbnaIL_22.png", "id": "862518105372389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031370_862518108705722_8194575130590500736_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUB9xn8sHSgQ7kNvwHzbX5H&_nc_oc=AdmuuUBUz7qUEyenb0Pgi6DLjSzMIR3Mtt7qUC6Z6XesVRUfOCXjbf4gPHcFmjROKsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvoHZFSSqWUmqyTRQUz20TZ-0FFREJS9mGfHxeJ9Q25cw&oe=69A447F8"}, "display_name": "Cave Digger Room Wrecker", "keywords": ["cave", "digger", "mr", "mixed"], "long_description": "The early access version of the latest title in the Cave Digger franchise is now out for Meta Quest 3 and Meta Quest Pro!\n\nGo to the caves, scan the surroundings for hidden valuables, and dig them up with a pickaxe. Claim the loot with Loot Vacuum, keep thieves away from your hard-earned riches using a six-shooter, and return home to feed your pet Chompy the living treasure chest! As you feed it, it grows.\n\nCave Digger Room Wrecker, the third installment of the Cave Digger VR game series, takes a light-hearted, arcade, and whimsical approach to the franchise's world while taking advantage of the game-changing MR tech features found in the latest Quest device generation.\n\nSo, take your pickaxe, turn your home into a cave, and start looting while taking care of your own Chompy with the riches you discovered! Experience the wall and groundbreaking Mixed Reality gameplay in the long-standing franchise of Cave Digger!\n\nFor the latest updates, exclusive sneaky-peeks, and 24/7 Saloon talks (memes), join Cave Digger Discord community -> https://discord.com/invite/cavedigger\n\nAlso, check below the other titles in Cave Digger franchise:\n\n- Cave Digger is where it all started! Take your pickaxe and get to the train! For the stone and rock!\nwww.oculus.com/experiences/app/1551165681653074\n\n- The sequel Cave Digger 2 Dig Harder includes the first-ever crossplay at this scale: pretty much all platforms in both VR & standard gaming!\nwww.oculus.com/experiences/app/4687168774709280", "short_description": "Transform your room into a cave, meet your old friend Chompy the living treasure chest, and feed her the loot hidden in your walls. Scan the surroundings for hidden valuables, dig them out with a pickaxe, and keep thieves away from your hard-earned riches! Experience the wall and groundbreaking Mixed Reality gameplay in the long-standing franchise of Cave Digger!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VrKiwi", "support_website_url": null, "website_url": "https://vrkiwi.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "con
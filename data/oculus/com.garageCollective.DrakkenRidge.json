ohc=35awkT8GEjUQ7kNvwGQnPrN&_nc_oc=AdrhETG6az5KcwRgIhVCFIqcXYxX6gIcGcKP1H1tM4x2FRDCnTKeEqMLYdlm6YORie0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2zbbp63mAmEvG8PwElOGBD9DQHZv8MihhFrkNYCMVuBw&oe=69F1FC23"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War.\n\nBut now is a time of peace. The Order works as private militia, maintaining law and order, both on land and at sea.\n\nYou operate in the DrakkenRidge archipelago, a string of islands under the authority of the Duchy of Eaglemoore, located on Drakken Isle.\n\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or black powder guns.\n- Craft or upgrade your equipment using the various workbenches in your Hunter\u2019s lodge.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/Privacy%20Policy%20drakkenRidge.htm", "developer_terms_of_service_url": null, "publisher_name": "Garage Collective", "support_website_url": null, "website_url": "http://garage-collective.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, 
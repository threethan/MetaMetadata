825050_1464035238107765_6350430113432465038_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaHy59j8VSoQ7kNvwHoqCwR&_nc_oc=Adk2gBClLeBrWRkXJkFVdvCdCYGC702aXqUCrnODmNOJWy6tNnwZ10baSL2syqu3Gyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfseIPBMB-4Fu79Ic8TQffk_aAggVtj7VEV1G93G7nhJgg&oe=699DA52D"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68OnfY_LXjsQ7kNvwFW0rhu&_nc_oc=AdmOYb4pC6U4Bcv_57awHe58qKstUaJL_iRMEknoZQy2CrxYFzsMuul-BbOUNY1k91s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuaSTdSHu_TumyuODETafUNUeIfWYMeYOjgK2GIggGNRA&oe=699D8313"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpmfD0REoXYQ7kNvwEMEjwS&_nc_oc=AdkOd_yLG8ysFqP87RWzfJ7jX-rHKLIDJiyOeuFAfrqAw7JNIBqUl7eoRocTEery1JY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvBZVvrTq2dFkNg_qzbP1ZbMWsGaqSg1A6GbahOgrarXQ&oe=699D824F"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7ktFyK-WksQ7kNvwEnkoW4&_nc_oc=AdkuIUO23UZEw5CqbRZeA37gr3gVcMaYqX_NcNIW1l9Uqkou_v7i-t36j8oIBiaY_3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfseJa4rKbE_-MbZd_SUQvGabgTexUA5Qo4pWhXxGN5x_A&oe=699DB4F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCard.png", "id": "741409101661743", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619717_741409104995076_6992182711301066185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHAv9rHnWkAQ7kNvwHl1oBw&_nc_oc=AdlbPX6aaTZy3anSleRwtQKpYnbZgSasqdVoVjNm9r675KT7rTI2sjdpoqgBnnK3BdA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvTv05H32s3hRgMoGv9KQdcFfocV_tlTW5MQfD5cZk4lA&oe=699D9C23"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War.\n\nBut now is a time of peace. The Order works as private militia, maintaining law and order, both on land and at sea.\n\nYou operate in the DrakkenRidge archipelago, a string of islands under the authority of the Duchy of Eaglemoore, located on Drakken Isle.\n\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or black powder guns.\n- Craft or upgrade your equipment using the various workbenches in your Hunter\u2019s lodge.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/Privacy%20Policy%20drakkenRidge.htm", "developer_terms_of_service_url": null, "publisher_name": "Garage Collective", "support_website_url": null, "website_url": "http://garage-collective.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
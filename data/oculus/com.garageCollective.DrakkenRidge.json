825050_1464035238107765_6350430113432465038_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LviyKoreODoQ7kNvwGEYQEr&_nc_oc=Adn4OtHUWgGF7GewktkQSZSpPE6Hr8AzaO3GA9oM4nA53ntxpuYBa7kxdV3Ez7JKTmU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvDM8iXQoqnkrI5_aJcA8wOjjCnfAkc6WC1KaYEyeRGtg&oe=6999B0AD"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVIi_eo03ZMQ7kNvwGNg_y1&_nc_oc=AdnCTgL0DPTHO3VdaGMKB6EhY49ccpYQLYM0FONipO8HAsTQ07EZVJLPTMt8-LZm1ek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuYxFSlx1Cm9E7dwTIC-aLL7_vmQT4HKLNJdeciW95XdA&oe=69998E93"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkhvwbiBrHkQ7kNvwFEmOrC&_nc_oc=AdnPCew77aLV1zx-XKDgOK2XHpq99E9PUbun7aL3rNDsTAoOFMABGgTKaIFxXOL3u9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvOvZxt7E3t2dADY5Aw19vil0ZCIsMnekPbZ5ujMkNtog&oe=69998DCF"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgqZvrsf2wwQ7kNvwGgulQr&_nc_oc=AdmME97qUK2_cV9peDX1NjZL5NZk3TI7rGOxLjw_7dxpS4jwfqcVxEUkGjJQ3ilf0iE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvVbAxex6ciAf1i_NewwirGZmSW37kwawp6VUzlSU8Slw&oe=6999C075"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCard.png", "id": "741409101661743", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619717_741409104995076_6992182711301066185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtCcWbSKD-EQ7kNvwH_iED0&_nc_oc=AdnlrvQXPquJVr__ecg_Fht5UfUsXQSkMICjncx78JgqwEg9H11eQP40EbBz8u7hxu8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv3e4mUjDg29nqV5KxgPlPF-beeZzlXNJSvRQKKyJms-w&oe=6999A7A3"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War.\n\nBut now is a time of peace. The Order works as private militia, maintaining law and order, both on land and at sea.\n\nYou operate in the DrakkenRidge archipelago, a string of islands under the authority of the Duchy of Eaglemoore, located on Drakken Isle.\n\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or black powder guns.\n- Craft or upgrade your equipment using the various workbenches in your Hunter\u2019s lodge.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/Privacy%20Policy%20drakkenRidge.htm", "developer_terms_of_service_url": null, "publisher_name": "Garage Collective", "support_website_url": null, "website_url": "http://garage-collective.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
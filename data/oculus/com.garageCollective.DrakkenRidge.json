4kMnnXd71cOzmfO4l3wcuYxZGC_Hm0jz9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuWFuluDH0A7ldqR7KVFRDd_N0a2k3omnuMA_GuTNJehQ&oe=69A6DFAD"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOLhhQ_5sawQ7kNvwGlp_gs&_nc_oc=Adlj-67eKqC7LWQhgiTPFAJ_8V3GkbmsEgzYs8AJUzSKaIkaFZP6sLiISrFp14PBoKc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfshTGX2h9zi3G8UNBKACRsIpSuSSao48c6co13GNGkX-g&oe=69A6BD93"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV1TdJXdAoAQ7kNvwH3ERm-&_nc_oc=AdmBxukn9s0Kj08hSg-Ldv9_hDNMIB4adXlsdmzOZTr5PQvrKWvgnTYEkG56Nnxlupw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftDmbHJiQgiU0-Lzszvxue4pG03Yq9WemgZWXU2E2_1Fw&oe=69A6BCCF"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgCnzY521yYQ7kNvwGbQ5jB&_nc_oc=AdmwHh_2R-XK4mVM2TdXupHDM0Ng-h3XAxKCK_8A71prX39IykvzP2AiUd2wvUxM2OY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4k2CSOuyJqDADtsyPvOnTSejY_i6Orwb-MJ1OdbgQrw&oe=69A6EF75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MarukTrailerCover.png", "id": "1191805982376267", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819934_1191805985709600_518751295776875195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKcppxf8vioQ7kNvwHSoFL-&_nc_oc=AdkT8RyGH-2URRBIo1GMIcFx8Wa2f2LSwT5P-4cOjKFIqNmm6zIKtmWJRM39cv7b8e0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvOciAVCIV1TNWE1qfu8_TBEXOuAWyhMQC8NkDasxBsMQ&oe=69A6C109"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War. You will explore the world of DrakkenRidge and **save the kingdom from a dark conspiracy**. \n{793813286458729}\nThe world of DrakkenRidge is composed of **5 islands**, and many dungeons. The main storyline will take you from beaches surrounded by palm trees to snowy peaks, and you will **explore 9 dungeons** where danger lurks at every corner.\n{2039964113409891}\nUse **swords, axes and shields** to fend-off your enemies! Watch out, some will buff themselves to knock your weapons down.\nOr be sneaky and dispatch your foes from afar with **your trusty bow** - or the dwarven flintlock pistol.\n{563070166833032}\nSummon lightning, freeze your foes, then blast them with a fire spell: as you progress through the main story, you will unlock **multiple classes of spells** that you can combine together for surprising results.\n{1334468658251559}\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or flintlock guns.\n- Craft additional equipment using the various workbenches in your Hunter\u2019s lair.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/PrivacyPolicy.htm", "developer_terms_of_service_url": null, "publisher_name": "Garage Collective", "support_website_url": "http://www.garage-collective.com/", "website_url": "http
38_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMkfSEeBak0Q7kNvwH45pBS&_nc_oc=AdobrPkx7Ov-RgN8GX_hpD7CfRvEqEZAUp-77iEzpCcdUZNEEx7q_ej6cgyPkOijkQA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af607J90ruEwwiRbUAfqiYT1e2y5j49odMPbeo5qYEINCA&oe=6A11A92D"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvLMkJIHqd8Q7kNvwGY4F89&_nc_oc=AdofMO8ob5FmY34kjIOGO8A8OLRx0Ye5GMZQQ_hTw76nR6b2UiyMutspSbC0lu_vyAs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MkiVRkJGV7Vzo4kR8NNlkmggXMs4NKohAE_lidDkCxQ&oe=6A11BF53"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7E8n5kKwZ8Q7kNvwFXaAun&_nc_oc=AdrBNUdEs5XHT44VbyezvOjAqJ2OwhqhxJZPIQiUJIejgGauyAlk0mwauseWyKKvMDI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IQ_dAC4eTdM0aEq9QaPMcroEwr-DLdvwpk5mZk1mD6w&oe=6A11BE8F"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iOT_YkdWx0Q7kNvwEYXaYI&_nc_oc=AdqzULMLaFNHzNPCfKueaUskeeHYLOOSGeGUl4x7x_FLgmwrMmXHZMCLJm4bsC1vbo8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WbIW25y1EQd5eZg2C12ESdQHuLMLGdetnMTO0pmqbZw&oe=6A11B8F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MarukTrailerCover.png", "id": "1191805982376267", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819934_1191805985709600_518751295776875195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKgYYsVZPB4Q7kNvwEYc_V1&_nc_oc=AdrdSIhTokm2Y1BT-U8wwlazDxxPjG-Aqbw3e12xeRAuI291081rYL3lO4Km8KReylU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hOJAPl-ymYM5UsPL9NuqMWgNq8gcb5o5CIEHG2_RMNA&oe=6A11C2C9"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War. You will explore the world of DrakkenRidge and **save the kingdom from a dark conspiracy**. \n{793813286458729}\nThe world of DrakkenRidge is composed of **5 islands**, and many dungeons. The main storyline will take you from beaches surrounded by palm trees to snowy peaks, and you will **explore 9 dungeons** where danger lurks at every corner.\n{2039964113409891}\nUse **swords, axes and shields** to fend-off your enemies! Watch out, some will buff themselves to knock your weapons down.\nOr be sneaky and dispatch your foes from afar with **your trusty bow** - or the dwarven flintlock pistol.\n{563070166833032}\nSummon lightning, freeze your foes, then blast them with a fire spell: as you progress through the main story, you will unlock **multiple classes of spells** that you can combine together for surprising results.\n{1334468658251559}\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or flintlock guns.\n- Craft additional equipment using the various workbenches in your Hunter\u2019s lair.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidg
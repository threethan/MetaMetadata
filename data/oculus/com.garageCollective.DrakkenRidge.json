38_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOsOTV9zoLcQ7kNvwFMaD-0&_nc_oc=AdpsLoGcNr2209M3u-u2_seqTu5UBeRT8y8d71yVLLG6pT345FbVDNPlpngL2P8vPH8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVseumz8gJOtRXZpyiDb_gAd26LuuzUgRDIE_QecVO0w&oe=6A7DC42D"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DX1WLFlyV8Q7kNvwGDUG3H&_nc_oc=AdqdOL_X6HMBJcLHUnyhSiJqnDko9HC3qoIf3Mhn9jGyD4ogJ-h2ciRIrRSj5qV0Uds&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVR5E_Fh5-Nug8DxUBHyvD1Kf8Lb_7Mn0bKufpiPMvcQ&oe=6A7DA213"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVoJN3zGQA0Q7kNvwEAVUl_&_nc_oc=AdqezU_fmYaiRCDlbJkG77opyCaZLqjwRC3eYZ1v4-oEJXTH98Fz_IKBDs6jmNY0K_E&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1n0N-C5-KQNnxk6ermNCigJx4XAvDLGiFERfoxdHHwQ&oe=6A7DA14F"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCnDU2pXN8YQ7kNvwEUhcWF&_nc_oc=AdqDGQMzy2qbTmGgROjtAejbpv3f_oVfitzQIG2WazQ3pTLH6URHmER3l6-Yb9wz9Fg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP0JbOdSFtu-6lBhARqF4udy-4aYoHGJrEPvRefgLO0A&oe=6A7D9BB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MarukTrailerCover.png", "id": "1191805982376267", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819934_1191805985709600_518751295776875195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T08TuS3f3fsQ7kNvwEj-HZz&_nc_oc=AdqliBI4NkKuv7gf4oWyvIo01CM752Mw3rFjbt-3E6ZPPfmzdk_pma-HJR6zUD2TjCc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9ZWtyFWJfp1XfN7qUVyThkWHPaA-mWQ5iY_7pCJakcw&oe=6A7DA589"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War. You will explore the world of DrakkenRidge and **save the kingdom from a dark conspiracy**. \n{793813286458729}\nThe world of DrakkenRidge is composed of **5 islands**, and many dungeons. The main storyline will take you from beaches surrounded by palm trees to snowy peaks, and you will **explore 9 dungeons** where danger lurks at every corner.\n{2039964113409891}\nUse **swords, axes and shields** to fend-off your enemies! Watch out, some will buff themselves to knock your weapons down.\nOr be sneaky and dispatch your foes from afar with **your trusty bow** - or the dwarven flintlock pistol.\n{563070166833032}\nSummon lightning, freeze your foes, then blast them with a fire spell: as you progress through the main story, you will unlock **multiple classes of spells** that you can combine together for surprising results.\n{1334468658251559}\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or flintlock guns.\n- Craft additional equipment using the various workbenches in your Hunter\u2019s lair.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidg
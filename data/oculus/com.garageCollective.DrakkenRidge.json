_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IU8uYEwGE8oQ7kNvwHicM8e&_nc_oc=AdomzSkMZqaZykYH4KGiZr-gZCVccyKnSNz6gIB669_0QzIMvy2Zu2BrVIFvslQ7HaI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85BRaVsn04LYsNZFTeId0KHhD--yjTODBLoBODSDRlNA&oe=6A4513AD"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zX1x_Sfc_IUQ7kNvwGk6UxP&_nc_oc=Adq1UhhjJRGpafQ6YfJBG6ZBCmv6c22acUd3lsFM9v9qUgBVL439btM5asSndEqW8rk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q4vkhWsnMXu_XnG8e0R4W9cY5CNHvwXlB0KvjcPXHgw&oe=6A4529D3"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqIr4KUrDC4Q7kNvwFsCIkX&_nc_oc=Ado9CAuXuw-Imroeo8FR8yyMT_I15sfQVfz8YDMDmZv_chG2i9gtVvipH2QrhhkrMKw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MZClzsxhX_FbpFCIuQR4OfsB_Y0iUVNc3UAvc3NVegg&oe=6A45290F"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGZ82UlzBJsQ7kNvwHEsp6g&_nc_oc=Adp2gQHZb_soIEPc8ypA3FOrVoDS02ufngWHbUKZd4gptXkPi8ZmhXRCcLIl1v7jyaA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ghGQjEEvjd1M1-UsPHwhxnGDB5NJeHNGVOAXpM0fDBQ&oe=6A452375"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MarukTrailerCover.png", "id": "1191805982376267", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819934_1191805985709600_518751295776875195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Be28hNfedzIQ7kNvwFousKb&_nc_oc=AdrNckUlI23PrXIDxn41t8fbPBNL9dY3wwh_LtZGPniPwJUZJp8R0HB8YiiIXMU_JBs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84Czu4boF53j0dp4MXn8Hib3Yj_iZeury4Y97FrZLOqA&oe=6A452D49"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War. You will explore the world of DrakkenRidge and **save the kingdom from a dark conspiracy**. \n{793813286458729}\nThe world of DrakkenRidge is composed of **5 islands**, and many dungeons. The main storyline will take you from beaches surrounded by palm trees to snowy peaks, and you will **explore 9 dungeons** where danger lurks at every corner.\n{2039964113409891}\nUse **swords, axes and shields** to fend-off your enemies! Watch out, some will buff themselves to knock your weapons down.\nOr be sneaky and dispatch your foes from afar with **your trusty bow** - or the dwarven flintlock pistol.\n{563070166833032}\nSummon lightning, freeze your foes, then blast them with a fire spell: as you progress through the main story, you will unlock **multiple classes of spells** that you can combine together for surprising results.\n{1334468658251559}\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or flintlock guns.\n- Craft additional equipment using the various workbenches in your Hunter\u2019s lair.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/PrivacyPolicy.htm", "developer_terms_of_service_url": null, "publisher_name": "Garage Collective", "support_website_url": "http://www.garage-collective.com/", "website_url": "http://garage-collective.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25288340457527230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499295661_1436959208437871_6546944982557457165_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAOwz9Tjj60Q7kNvwH9eufv&_nc_oc=AdrhC-fO-ZOytt1XP2tr3TN7MqzjJCHXb6QbsLxCagjUynLrReKVvQJVOMWJ_GAYtew&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h7eHYKlNW84CB8ECSoGOvuhcWh4l0TUsJIMM8V-WKPg&oe=6A452E1C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DrakkenRidge", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Role Playing", "id": "821934236779161"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1757005200, "lastRevision": {"nodes": [{"id": "6353835798070981", "release_type": "MAN
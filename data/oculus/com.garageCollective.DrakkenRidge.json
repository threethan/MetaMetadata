_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m192DX-PQy4Q7kNvwHizBgd&_nc_oc=Adp9FwH1KgdBJvC6daKmXYplijf3i1m1a2yqpmp1qPQps3KyP1sX2l9tjDqWY4LCld8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtD0IdalMjviMMpaf0OhtugNtR3VXWT-ar3dFAEUFRpg&oe=6A54E5AD"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvCfiMVAo2wQ7kNvwGO-5Hx&_nc_oc=AdqRtgmrmKmh14RRfAmSnjoWI9D5hisXfKAw9Zbkqv9k71nowRmfFJrlLCwayVUccqg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbUaFjLUkD2dBRr-ko--YrbK2ZNmgFmk5rM5Z4SzUl4g&oe=6A54FBD3"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnagrBL6SDUQ7kNvwGwFRit&_nc_oc=AdqX8dHF_cJ6sC-UEYUkhZsYMpiMWs173fvLcAtndItsZNO_lC7eizvWlvLS6nsQBws&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW05HqjVtE4ysi-vZnUnTSJa3kSwjiDt5iaGnRBwLG-Q&oe=6A54FB0F"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QfzMKTmq3sQ7kNvwHdD7qB&_nc_oc=AdqwxpUw_gaO_WQBQZOWE4VEXaqG4ZdSvKH1MkSt8_hMmVuTLzRTT0ReNnbOaeklchc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBewJSyHQwBxJ3BWB2kYhiJg02s5X2wwC_IbZ1V8FXT4Q&oe=6A54F575"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MarukTrailerCover.png", "id": "1191805982376267", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819934_1191805985709600_518751295776875195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lE5QTxLW84Q7kNvwEVtJa2&_nc_oc=AdoUANIo6_uj5L4Kvwzz1esBMk0InfaTGXW7RFkwAFuSE0ry6J0YkR-W4WQhuiId8ww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAveDy3BbdgFkqfd6SkyxUNVLwZJWE8IUAAPxjtCz2tyQ&oe=6A54FF49"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War. You will explore the world of DrakkenRidge and **save the kingdom from a dark conspiracy**. \n{793813286458729}\nThe world of DrakkenRidge is composed of **5 islands**, and many dungeons. The main storyline will take you from beaches surrounded by palm trees to snowy peaks, and you will **explore 9 dungeons** where danger lurks at every corner.\n{2039964113409891}\nUse **swords, axes and shields** to fend-off your enemies! Watch out, some will buff themselves to knock your weapons down.\nOr be sneaky and dispatch your foes from afar with **your trusty bow** - or the dwarven flintlock pistol.\n{563070166833032}\nSummon lightning, freeze your foes, then blast them with a fire spell: as you progress through the main story, you will unlock **multiple classes of spells** that you can combine together for surprising results.\n{1334468658251559}\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or flintlock guns.\n- Craft additional equipment using the various workbenches in your Hunter\u2019s lair.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/PrivacyPolicy.htm", "developer_terms_of_service_url": null, "publisher_name": "Garage Collective", "support_website_url": "http://www.garage-collective.com/", "website_url": "http://garage-collective.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25288340457527230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499295661_1436959208437871_6546944982557457165_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53Cmpf0sYmYQ7kNvwEOWtpc&_nc_oc=AdoQea_-f30LhF4FEoVmiZrbMzDmo2j_Xg8tUfn-4E6D4mKK3FGXoNwsVM9-vmbFiYE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6lR0p5Ux0k7guYAJT3Ij7EL2fkAtozX5nQKSJvr1g_w&oe=6A55001C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DrakkenRidge", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Role Playing", "id": "821934236779161"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}], "release_date": 1757005200, "lastRevision": {"nodes": [{"id": "6353835798070981", "release_type": "MAN
_sid=6e7a0a&_nc_ohc=dr3xmWhXyhEQ7kNvwHJjTU3&_nc_oc=AdmBUH5J7kDsW_jTkYu_nBGWl-FCZLOdLQVAWC21PbfNAIlkTNihEBsWCpLhKZ_bVgw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afyvp8EnOnHdngzSHCCr3wqPAiPDK4XaD1SyltWA4UBBXg&oe=69AAD42D"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8WhpHF-0uYQ7kNvwGkB6sc&_nc_oc=AdkffsZeycBrpYP5ZN0cUM6jcmktI8pM1SvmtQ-39TiMSAFK4WML79ycZvfmZsCW63Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afz8fnNgyOMeeKIPPD8Rm8-7xIr8gy0IfIZVo74hGW7vvw&oe=69AAB213"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6f4p8Nw7vjwQ7kNvwGbVo0A&_nc_oc=AdnjIYDZZHPFZDIFldCJTRErASRvQpZaKVuTRJkF2k70raTgcEcTSGzrPGuznaWoTuo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3klOnUjkxiwLd5ewoUxCh0Ak8KCcu5eGCLCMv-qTT8g&oe=69AAB14F"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wO-zjh6qpjgQ7kNvwE6htu-&_nc_oc=AdlJ6TCxPSe4eoGnbp7Qou6hpOEzV4ZzYXSSNxvZfMTfw9Nh3zbz696oO-m0i_LJ1Tg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afy9I2o51p4bqusWcgtuYchYHutBbgJB2ydXAT0hTLArSQ&oe=69AAE3F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MarukTrailerCover.png", "id": "1191805982376267", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819934_1191805985709600_518751295776875195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmoKDw8l2_IQ7kNvwGG8v8X&_nc_oc=AdkM_Z-hPc-juEGRr2Si-3VWr8UeCsu3lK049K5oZs-lUe43HbNm1pwwnU48teWIoK4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afzr8ZspAjs3eWBBuwTEHLAwL4axB_LXaii-IhECH2xM2g&oe=69AAB589"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War. You will explore the world of DrakkenRidge and **save the kingdom from a dark conspiracy**. \n{793813286458729}\nThe world of DrakkenRidge is composed of **5 islands**, and many dungeons. The main storyline will take you from beaches surrounded by palm trees to snowy peaks, and you will **explore 9 dungeons** where danger lurks at every corner.\n{2039964113409891}\nUse **swords, axes and shields** to fend-off your enemies! Watch out, some will buff themselves to knock your weapons down.\nOr be sneaky and dispatch your foes from afar with **your trusty bow** - or the dwarven flintlock pistol.\n{563070166833032}\nSummon lightning, freeze your foes, then blast them with a fire spell: as you progress through the main story, you will unlock **multiple classes of spells** that you can combine together for surprising results.\n{1334468658251559}\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or flintlock guns.\n- Craft additional equipment using the various workbenches in your Hunter\u2019s lair.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/PrivacyPolicy.htm", "developer_terms_of_service_ur
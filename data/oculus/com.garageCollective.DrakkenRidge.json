825050_1464035238107765_6350430113432465038_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UbEmeEUYAEQ7kNvwHhUP5r&_nc_oc=Adnmbby59-ZxdW9YjkiorWfoqx8_f1AVFR-nO950D3qtx3RmyO5Amgl8AuTIvfkmxjM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfueKHbGNJqgDRRw5HooE9A1CN1wGozH0dVSDDTn5iyM6Q&oe=69985F2D"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=up1iOy6wAN0Q7kNvwGo9t0f&_nc_oc=AdlueutfvDANoUDxe2Q1_d7y9c6ejJU92c3ivLlXFyuOkasu1ln2WnOoEy54D7r7k-g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfubZZSnpkm4dpyYM5p-EOyIFFG43cv-jjNHjM9K0pD2RA&oe=69983D13"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZ79sCdfjhsQ7kNvwEoyXFa&_nc_oc=AdlM6qoeKkGTVRqWvjs9hu-FGQe6iGjboWr6hZpsfsX1GfkqvPLhjrTb9pQyAKSXRec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv4eU8L-GDV8UvyFj2n3kkKnWJ-o1U9UdXCumXrM7j1JQ&oe=69983C4F"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgqZvrsf2wwQ7kNvwFwoeFW&_nc_oc=Adngdlp3niPV7sDRqG9YWe1eJm5f-2FObYk80AZOGFfqtUfFcLeRpxjrOsJZL15UX3I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsRnwEaAqaspJdOQ2moaZy49QO_r6bY-XG8i0zvxSB9BA&oe=69986EF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCard.png", "id": "741409101661743", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619717_741409104995076_6992182711301066185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtCcWbSKD-EQ7kNvwGtzbDp&_nc_oc=AdlS57Jp-vfOFL80Xpz3A621bn2tUVjmkd02QrohRS-8Nda4tcpmCvJH-K2D4WYWl1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsRDSVIPg_BeuPGdEzrV96Xqal-IeOrv22O27b07LsE0A&oe=69985623"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War.\n\nBut now is a time of peace. The Order works as private militia, maintaining law and order, both on land and at sea.\n\nYou operate in the DrakkenRidge archipelago, a string of islands under the authority of the Duchy of Eaglemoore, located on Drakken Isle.\n\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or black powder guns.\n- Craft or upgrade your equipment using the various workbenches in your Hunter\u2019s lodge.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/Privacy%20Policy%20drakkenRidge.htm", "developer_terms_of_service_url": null, "publisher_name": "Garage Collective", "support_website_url": null, "website_url": "http://garage-collective.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
nc_oc=Ado9yDz9pPbNem71JhYH0VWRDUihb9Zsm0FcvGqpMMeoSnmWfT0k6bhlb-7NqRsl0oU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2EMRExRFcx9r3tjIQhiqHB_N97RZIr-2IdwkKuP89xfg&oe=69F2052D"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Vu2IMXAinsQ7kNvwFQK7nj&_nc_oc=Adrtp8D86Y9SXSENifJ_iI-XpkAMht0Ho9Au63J4plOMonDSN9C8mVp40ib6u6ZVwtg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QECIvm7ZxnG_vWVZTQntH0_bvYzXJEmDzUpePzqmfcg&oe=69F21B53"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPBr8XZllJwQ7kNvwGR5jUD&_nc_oc=Adruj6Kt2fd02y5MEUESLIwmggUjwOBrPJZ4FZCjCvv3LbRh79kp24d9QPKxT-AL1hQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3_yGYppJS--RBr_QcaAZ6r83Cih0YV5INskGGAE19oAA&oe=69F21A8F"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-y5xXhlCHcQ7kNvwFP0xPg&_nc_oc=Adpa_p80yUqu-zePmLBFd9IaU1zGvOtnHrJbgIemeHo25I9QeZP-QX0c-x1KPN93YAg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00xNz8nhKPSz2DCHhaFIKIaJ68ZQzL_36kh2k0coYBYw&oe=69F214F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MarukTrailerCover.png", "id": "1191805982376267", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819934_1191805985709600_518751295776875195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-gmuHxoxs8Q7kNvwHmaR-L&_nc_oc=Adr69t63X2OG8Esy1VPgTawse-z6WoPlzfJc9m9OJCUktdRMGdIAQ52uMEWgSkbENig&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Z5hMaCEhPAKmZyWchXsOIRdvgDN285PId0oYmLXAyAw&oe=69F1E689"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War. You will explore the world of DrakkenRidge and **save the kingdom from a dark conspiracy**. \n{793813286458729}\nThe world of DrakkenRidge is composed of **5 islands**, and many dungeons. The main storyline will take you from beaches surrounded by palm trees to snowy peaks, and you will **explore 9 dungeons** where danger lurks at every corner.\n{2039964113409891}\nUse **swords, axes and shields** to fend-off your enemies! Watch out, some will buff themselves to knock your weapons down.\nOr be sneaky and dispatch your foes from afar with **your trusty bow** - or the dwarven flintlock pistol.\n{563070166833032}\nSummon lightning, freeze your foes, then blast them with a fire spell: as you progress through the main story, you will unlock **multiple classes of spells** that you can combine together for surprising results.\n{1334468658251559}\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or flintlock guns.\n- Craft additional equipment using the various workbenches in your Hunter\u2019s lair.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/PrivacyPolicy.htm", "developer_terms_of_service_url": null, "publisher_name": "Garage Collective", "s
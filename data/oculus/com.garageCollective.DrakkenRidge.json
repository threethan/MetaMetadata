825050_1464035238107765_6350430113432465038_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZW1_g1GVp_sQ7kNvwHYuU38&_nc_oc=AdnNcdWz3kARAzXXQKTSf4ywEC87VX79608KQzCKSvhmJdQoY5kR5AorCwD_n_9Yg8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftuuDVxB4qUDfAnA9uF9Luwtkpk-AWaVjkA0cK0KaykZA&oe=69A2EB2D"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zd5htG961TQQ7kNvwEAzoHK&_nc_oc=AdkSkyxbONqEQuU1gFj-oWim41Carqxu1DHUyB7RTSDiFd5HbKBZNT_Q6EzSNFhwR1w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsLLheLZufW4wndfuj8ExPR7U0JD0HbNNZ4NNCdXzEGdw&oe=69A2C913"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgHw9OhMxLsQ7kNvwFNvKPX&_nc_oc=AdmQSjHGOZdgZVlyAXzCDCF4mYFjJF2TWlJXXnVg3ELDmcDxb4Rcb6VWZ4B9tvgGHLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsTKsZqsJBYmG-0_XxTiYfo77u8KnlymDz1xZpEurdFPw&oe=69A2C84F"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8InoYkY06tMQ7kNvwG2w3-f&_nc_oc=Adl9ZwvmDxx74O2U13gx0sGEdat_f0kuXQRSp09v4jcsIhjkU92_zPL_DnZNsa31yFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4TC_42iwmNSJElsCpdQYzLtdd11SBdKCpvbNB3xB8Nw&oe=69A2FAF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCard.png", "id": "741409101661743", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619717_741409104995076_6992182711301066185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1vo11OYwU8Q7kNvwEt2wWi&_nc_oc=AdmChn12-gerWvymmBcyg4ujQ0rt3T-4xZ6QYVx4YqJTp7emFk__FaOgdLw2cwAcUJ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv6iqyUOZPaMtxM4m-7YM-3JhjZB9efcZzIydsaVsLCNA&oe=69A2E223"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War.\n\nBut now is a time of peace. The Order works as private militia, maintaining law and order, both on land and at sea.\n\nYou operate in the DrakkenRidge archipelago, a string of islands under the authority of the Duchy of Eaglemoore, located on Drakken Isle.\n\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or black powder guns.\n- Craft or upgrade your equipment using the various workbenches in your Hunter\u2019s lodge.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/Privacy%20Policy%20drakkenRidge.htm", "developer_terms_of_service_url": null, "publisher_name": "Garage Collective", "support_website_url": null, "website_url": "http://garage-collective.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
38_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IU8uYEwGE8oQ7kNvwFzyY-E&_nc_oc=AdpWlZkzLgeVL-lfcrojTAZlcOuCsbbD-fDiKVqtIaKluHYT48ILhvDKTfbFZyeb8Ms&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o1KVbr71S8bCfKOCdIE-wBfA1HOk-czH1Mk_tZ-rnjg&oe=6A46652D"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zX1x_Sfc_IUQ7kNvwH2N6en&_nc_oc=AdrYK2hB-znEUgqvTtO02wtcvrkAVwRI2rvuGIHjdLlTGmv2q4VafL--Wy67AB2JBHQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hBeSGSe31lypM1XVPet6WBvUBQFmKuHHam3g7xqoZng&oe=6A467B53"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mp_OfUNRkYQ7kNvwG7UulG&_nc_oc=AdqMOptxVntrHp6HyM0DrLqwWqY7HJt93eEsaJLQ6vbHxJRA2j7fxoXSacFHy0L5hGs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mFXN0W1jxGSZ6UKcqvSutDPr1ozxy7uQHSYusM2izEA&oe=6A467A8F"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGZ82UlzBJsQ7kNvwE6LQjj&_nc_oc=Adr_qa6gX3JmFnTvSjsx562kXf_HnywkwceVJBR3QUGaj1wXI_rRm9mkEkVjdiizdhg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZRnNRahp0GN718HdsaD6ec_H19uPYtA7LaW9pLYj0Yw&oe=6A4674F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MarukTrailerCover.png", "id": "1191805982376267", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819934_1191805985709600_518751295776875195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqcj4LR1KJYQ7kNvwGjQtc8&_nc_oc=AdqCtyjcdvj5hdS4HPI0mn_IhWk3X2i5Tra34KdhwI7Mm4abya7iwaG6U_W5GK2ojJY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_buWqU6H4Gvyb5PH3VyXuaBOaK1-VRJs7t5tlAOkx2Hw&oe=6A467EC9"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War. You will explore the world of DrakkenRidge and **save the kingdom from a dark conspiracy**. \n{793813286458729}\nThe world of DrakkenRidge is composed of **5 islands**, and many dungeons. The main storyline will take you from beaches surrounded by palm trees to snowy peaks, and you will **explore 9 dungeons** where danger lurks at every corner.\n{2039964113409891}\nUse **swords, axes and shields** to fend-off your enemies! Watch out, some will buff themselves to knock your weapons down.\nOr be sneaky and dispatch your foes from afar with **your trusty bow** - or the dwarven flintlock pistol.\n{563070166833032}\nSummon lightning, freeze your foes, then blast them with a fire spell: as you progress through the main story, you will unlock **multiple classes of spells** that you can combine together for surprising results.\n{1334468658251559}\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or flintlock guns.\n- Craft additional equipment using the various workbenches in your Hunter\u2019s lair.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidg
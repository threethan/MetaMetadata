825050_1464035238107765_6350430113432465038_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaHy59j8VSoQ7kNvwEXtKrc&_nc_oc=Adl0Qjjfj1qiCVChzEukfrPxip8pl2WQ1SQsaupnhDzkl6VmFFSVs2ZGgTqh18Nh0Pk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftYVFVddSaUitejTeXqPHHtwQC3XBn8-2KQC3SepUJpRQ&oe=699EF6AD"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68OnfY_LXjsQ7kNvwFxS1Rh&_nc_oc=AdnOGUWoWa63eMCdve0jdzweZ3FzlMW061aJYqFicXYynxZ7f7drYK0oYKIESMI-MnY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftAjP33XJcp6NemaotvR_diErBquNhIp3Bhf4OyVpeeOA&oe=699ED493"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpmfD0REoXYQ7kNvwFZDsOj&_nc_oc=AdmJOoD9nmYX6DyBRH7LY7Uzo3uGFNuX7BTPaegfutsa2DpFN5cYs0I1f-au0LGzB0g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuKNdw59NZ-jMDXYbgd2tWAxjdnFIqsw7gi421g6loAuQ&oe=699ED3CF"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7ICoKsSLWgQ7kNvwFjHA8V&_nc_oc=Adk5ByqX5qacEOueWOvSh-UCzO7594iQjyTpnsa0qsWQe4vAynk_BepcMo5q1Vxu1YU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu-DzyA2_5fsRpq0yYsur9qpsvZGjDdAiQNm1sXMVgKUA&oe=699F0675"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCard.png", "id": "741409101661743", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619717_741409104995076_6992182711301066185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHAv9rHnWkAQ7kNvwHyTS-g&_nc_oc=Adk57vrk_7omwlT2zJZZMz7k3GLjcYvks3lPXQ1YeREUoRHfwPkvx06tAWOL6AEf6JA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsH6pbUbIQQgxdZ8SHK8op7nq86Z3iYKcv15jmPP2XH4w&oe=699EEDA3"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War.\n\nBut now is a time of peace. The Order works as private militia, maintaining law and order, both on land and at sea.\n\nYou operate in the DrakkenRidge archipelago, a string of islands under the authority of the Duchy of Eaglemoore, located on Drakken Isle.\n\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or black powder guns.\n- Craft or upgrade your equipment using the various workbenches in your Hunter\u2019s lodge.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/Privacy%20Policy%20drakkenRidge.htm", "developer_terms_of_service_url": null, "publisher_name": "Garage Collective", "support_website_url": null, "website_url": "http://garage-collective.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
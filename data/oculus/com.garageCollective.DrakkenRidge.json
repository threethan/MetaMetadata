825050_1464035238107765_6350430113432465038_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd0LgFjU5vMQ7kNvwG0Kb_o&_nc_oc=Admagz0PPDi-cIHk8NfrA2a01vpBHB_tHEXlpYn5vHMr86X03NthH-Y6Yqg_0umfwq0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aftd0c00mw2nvaSyVH8RB5hrEc4aws9cs0jXbbtxrWLF_A&oe=69A58E2D"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOLhhQ_5sawQ7kNvwFIYVXx&_nc_oc=Adlb3QXQ_0rt57UG7KUVJbiER-j17gnXKXz52Xv4UYOAmCj7MRlkNhebfKb-LwbgISg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afsdidc1F3DqugfO75bGFKl0E6qgmoFZL1Sbz1zqfBq0-w&oe=69A56C13"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV1TdJXdAoAQ7kNvwFHm6I2&_nc_oc=AdkFZs11OjQfh0mlhCqrGMSxuAxLmRKpMhiGYfMtawezS0Od7UhwJdPReoFbcZbYOn8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu-36A0LM3reKEQ9V17BFe2k6Bw6swpOiTrhbEiaL46og&oe=69A56B4F"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8InoYkY06tMQ7kNvwGUWJy-&_nc_oc=Adlfol-9of5d4LRlc6AiCkmTMvbSaAVK_8AzZhT0BmXm5co0SQ_382l7V4Vae9h7i-s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuBqTMCgs7PAix1_En__GUgLf6jPZ3HMc7sejJNzf67cQ&oe=69A59DF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCard.png", "id": "741409101661743", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619717_741409104995076_6992182711301066185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdJHlMcF0YIQ7kNvwGYKtFo&_nc_oc=Adla82OAHmwtiOBDl9ZZrESclNnRiaAlo4l5Muuh2EpzlvZj6nRnyQZNV495sJU94fA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsMG9VKs8BKrJbKsVWgAByFabFmDrQRrumugNPzDvRq5Q&oe=69A58523"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War.\n\nBut now is a time of peace. The Order works as private militia, maintaining law and order, both on land and at sea.\n\nYou operate in the DrakkenRidge archipelago, a string of islands under the authority of the Duchy of Eaglemoore, located on Drakken Isle.\n\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or black powder guns.\n- Craft or upgrade your equipment using the various workbenches in your Hunter\u2019s lodge.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/Privacy%20Policy%20drakkenRidge.htm", "developer_terms_of_service_url": null, "publisher_name": "Garage Collective", "support_website_url": null, "website_url": "http://garage-collective.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
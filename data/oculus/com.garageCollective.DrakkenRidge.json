scdn.com&_nc_ss=8&oh=00_AfzMz30b58bU3x9fwhVOsucofA9GPd-nqOCMccAQ1VhDhg&oe=69AEBF77"}, {"file_name": "2.png", "id": "1464035234774432", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825050_1464035238107765_6350430113432465038_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61la3xXh3ooQ7kNvwHBnhiU&_nc_oc=Adls6NaRo9YZ8SpLnaKhJ2qu_asGgeMmSqtKxvJmSsSBIzu4rFeqqN3IZpS3VELyMpE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHRfce0DIsK0-Hef75PrfAP4MB9lxAdbH-rLJuYNcK3w&oe=69AEC8AD"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoN3a1Qk954Q7kNvwEgmCcC&_nc_oc=AdlLCnPMPlTz_OfI1JVuO6zdzjUnb-fgY-kbRlWqx2VCTSDvvlf3JKgscsqNE2h0hps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0dJyfgcc4ALe7EA8XgU3_83fseIQdZ4zbd5QvLNb-_Q&oe=69AEA693"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JevujK89kkAQ7kNvwEOXHo6&_nc_oc=Adm4QSlUExgbvHWsewFevQqBk-K4eDPwQBurYaqrIaEfeeAHwVlgKCN7G1GwW4yENOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZzePu-dhW29Btpzg20ZL_drSLBIWpdM7q0xAU_sUrYw&oe=69AEA5CF"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qpUyuSnoWAQ7kNvwEpTLyL&_nc_oc=Adm9ZllbxKxjPpjtIg5aJnIENcQNVzu5wVJovTrbF-1XiS-0FMm41jbPqwXGh5yxEoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEm5rEHtEGBf_9NxWCVpnzMFnFM_zaOVWwbhZBrZFGxQ&oe=69AED875"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCard.png", "id": "741409101661743", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619717_741409104995076_6992182711301066185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UL4Ct5TTlUYQ7kNvwFahPQ_&_nc_oc=AdksFAvk9wAzhLpHGoYSg-RS2DIoOIjdtjxaBfEBbwHpSGXrShL5oTkxiqvLyvDt8bo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxmbv8vuLKv-yIricFNC-Tt0hQRIG_ixzFUW31m_9wRsg&oe=69AEBFA3"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War.\n\nBut now is a time of peace. The Order works as private militia, maintaining law and order, both on land and at sea.\n\nYou operate in the DrakkenRidge archipelago, a string of islands under the authority of the Duchy of Eaglemoore, located on Drakken Isle.\n\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or black powder guns.\n- Craft or upgrade your equipment using the various workbenches in your Hunter\u2019s lodge.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/Privacy%20Policy%20drakkenRidge.htm", "developer_terms_of_service_url": null, "publisher_name": "Garage Collective", "support_website_url": null, "website_url": "http://garage-collective.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_top
_nc_ohc=BhxWViv5O3cQ7kNvwG5aROX&_nc_oc=AdnB92loOHcU0qGKgMrTpg_m0ZVZpvgMtmfmeywnnpv4AXlMW5JRbbbeRO3sdANRN40&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNj6XLZ-if-TJjVlo81uRvB5fsMIsl9BnrpcHscht1HA&oe=69BE9AAD"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7lQmz0jvugQ7kNvwG5I89_&_nc_oc=Adkz1orrmXX5gtGvB7zYcP4j59QEEFglV5eyM3RzE8LNb-RMzBsw_8AIpTSNnchyvbk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3ktwIIH_ZGklKa0McPzojfd5ORxTbUNYJfbXw1waRIg&oe=69BE7893"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXMElWbe5o0Q7kNvwGnxn9U&_nc_oc=AdnMz9aLzJ22UYQEfY5MgFa87DkQqzs0QoVsSG2carLfabaCw4s7uguq37M24MCTTJI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIWeliHbCHq8HggzHt9-zaAnkLmg81r8hvym9eju6DIg&oe=69BE77CF"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWQJ_owYigQQ7kNvwGE-dsd&_nc_oc=Adn1sfGUaS2tmFa9Uc3wvTPcsLYoFuYbsMNYiPEqrXaTshjQA_bYhK7G5od9R7hYrCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZcJ1RW2vZLsm5pklOs-H30qMRXCi04LeaaNMmZNGq8g&oe=69BEAA75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MarukTrailerCover.png", "id": "1191805982376267", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819934_1191805985709600_518751295776875195_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTxzAaGwO0cQ7kNvwGh8e3I&_nc_oc=AdnV-KBRSfFgncimoWnm0ysNWweVLeQODNrnv7xgbMSn5vJn8dNJjKyrnP2C7k4TNwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9MLrzfInID8ljbRAwJ6Kpmh9Y8EmpvQ-X_ahcCIRKDw&oe=69BE7C09"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War. You will explore the world of DrakkenRidge and **save the kingdom from a dark conspiracy**. \n{793813286458729}\nThe world of DrakkenRidge is composed of **5 islands**, and many dungeons. The main storyline will take you from beaches surrounded by palm trees to snowy peaks, and you will **explore 9 dungeons** where danger lurks at every corner.\n{2039964113409891}\nUse **swords, axes and shields** to fend-off your enemies! Watch out, some will buff themselves to knock your weapons down.\nOr be sneaky and dispatch your foes from afar with **your trusty bow** - or the dwarven flintlock pistol.\n{563070166833032}\nSummon lightning, freeze your foes, then blast them with a fire spell: as you progress through the main story, you will unlock **multiple classes of spells** that you can combine together for surprising results.\n{1334468658251559}\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or flintlock guns.\n- Craft additional equipment using the various workbenches in your Hunter\u2019s lair.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/PrivacyPolicy.htm", "developer_terms_of_service_url": null, "p
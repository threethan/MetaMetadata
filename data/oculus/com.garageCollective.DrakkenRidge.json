825050_1464035238107765_6350430113432465038_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd0LgFjU5vMQ7kNvwFrvhNE&_nc_oc=Adni_fHrH8AOj7XmLGhWq-tJEzGY1W0xZ4kMnnXd71cOzmfO4l3wcuYxZGC_Hm0jz9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuWFuluDH0A7ldqR7KVFRDd_N0a2k3omnuMA_GuTNJehQ&oe=69A6DFAD"}, {"file_name": "3.png", "id": "1262779848655479", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827286_1262779851988812_2074666845427705724_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOLhhQ_5sawQ7kNvwGlp_gs&_nc_oc=Adlj-67eKqC7LWQhgiTPFAJ_8V3GkbmsEgzYs8AJUzSKaIkaFZP6sLiISrFp14PBoKc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfshTGX2h9zi3G8UNBKACRsIpSuSSao48c6co13GNGkX-g&oe=69A6BD93"}, {"file_name": "4.png", "id": "2145163935970022", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830007_2145163939303355_4408055858764707651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV1TdJXdAoAQ7kNvwH3ERm-&_nc_oc=AdmBxukn9s0Kj08hSg-Ldv9_hDNMIB4adXlsdmzOZTr5PQvrKWvgnTYEkG56Nnxlupw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftDmbHJiQgiU0-Lzszvxue4pG03Yq9WemgZWXU2E2_1Fw&oe=69A6BCCF"}, {"file_name": "5.png", "id": "1541830890337346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303476_1541830893670679_90843930670861152_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgCnzY521yYQ7kNvwGbQ5jB&_nc_oc=AdmwHh_2R-XK4mVM2TdXupHDM0Ng-h3XAxKCK_8A71prX39IykvzP2AiUd2wvUxM2OY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4k2CSOuyJqDADtsyPvOnTSejY_i6Orwb-MJ1OdbgQrw&oe=69A6EF75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCard.png", "id": "741409101661743", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619717_741409104995076_6992182711301066185_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdJHlMcF0YIQ7kNvwE1NSnM&_nc_oc=AdkQWWt6ceHyK7ndUTjFPSuBi64B8LrbR1qLMdAsndSOMly9lelz7hgJ43pBlm_Lzak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsl-26C0DiUOulGwruIqXHIeh5w4j0lHBMI5cOS5vmH3Q&oe=69A6D6A3"}, "display_name": "DrakkenRidge", "keywords": ["RPG", "adventure", "fantasy", "magic", "pixel"], "long_description": "You are a Hunter, a Novice of the Mage Order, an ancestral organization tasked with policing the usage of magic, particularly during the First Kingdoms\u2019 War.\n\nBut now is a time of peace. The Order works as private militia, maintaining law and order, both on land and at sea.\n\nYou operate in the DrakkenRidge archipelago, a string of islands under the authority of the Duchy of Eaglemoore, located on Drakken Isle.\n\n**Core GamePlay**\n\n- Change the Fate of DrakkenRidge by fulfilling the main quest and a trove of side-quests.\n- Explore multiple islands and dungeons, solve puzzles and defeat enemies.\n- Cast spells using ancient runes.\n- Use melee weapons (swords, axes, maces, daggers).\n- Use bows and arrows or black powder guns.\n- Craft or upgrade your equipment using the various workbenches in your Hunter\u2019s lodge.\n- Learn new schools of magic by acquiring essences from Bosses and fallen enemies.", "short_description": "DrakkenRidge is a semi-open world VR adventure game that will have you travel many islands, explore many dungeons, and battle your foes with magic, ranged and melee weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.garage-collective.com/privacy_drakkenRidge/Privacy%20Policy%20drakkenRidge.htm", "developer_terms_of_service_url": null, "publisher_name": "Garage Collective", "support_website_url": null, "website_url": "http://garage-collective.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
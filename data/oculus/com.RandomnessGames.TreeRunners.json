", "keywords": ["Fangame", "TreeRunners", "Tree", "Runners"], "long_description": "Welcome to Tree Runners, there are classic tag games, infection, and even the challenge of the floor is lava! Leap through dynamic environments, evading opponents and challenges. Choose from modes like Infection, where strategy is key, or Floor is Lava, where every move counts. Customize your character with a variety of cosmetics for a personalized touch. With endless challenges and customizable options, Tree Runners offers heart-pounding fun for all!", "short_description": "A gorilla tag fan game with normal tag, infection. floor is lava and more! New Update: Winter Update added snow, snowballs, pool, new spawn location, and some winter cosmetics!"}]}, "developer_name": "Randomness Games", "developer_privacy_policy_url": "https://sites.google.com/view/tree-runners-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Scriptplayz", "support_website_url": null, "website_url": "https://sites.google.com/view/tree-runners-app-lab/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27451649821145728"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210885_2386402085085367_8102028989706320988_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qpexl2SpH8Q7kN
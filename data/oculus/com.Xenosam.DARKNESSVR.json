": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982625_949721433023651_9051503734647849790_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8BErbCxBaAQ7kNvwGMn3eA&_nc_oc=AdnTAU257fhPj78fda0XU9C4wDbuaY4PWdbX6ojM5k1pragFJXevieZ24z97bR-q6Oc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv8cS6SPsl0SV6294RYu0628bvyJqsXtdrFGW0XIAbU6Q&oe=6999BAD6"}, {"file_name": "2.png", "id": "598347896572554", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831145_598347903239220_6002657845272258296_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YK0gjAPtJ8Q7kNvwHUBLW5&_nc_oc=AdkZ9o9quju00wyqcIzXyvuV0eDltCdjsT34ljNQh1rQU1JVRDbMaty69rdH_YR-2Ds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft-Aph27ehGvwzfA1QC2FlCFtUlPiRtyaYXnxj0T_9DmQ&oe=6999B4A5"}, {"file_name": "\u30b9\u30c1\u30eb 2025-04-19 020758_1.1.1.png", "id": "1005292218369415", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392183_1005292221702748_959948122684379104_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DL0RcSo7ud4Q7kNvwFY2gGS&_nc_oc=Admp01ngdhwiC1v8iFeuSkrjC6bq1d5VqT0Xh4njWUW28eRFgrPDs_TRoZHaPy2XElI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuLQL_XtDyEWcsn7iToTta73poCnlAKA-8-GsfixfzdaA&oe=69998ED1"}, {"file_name": "\u30b9\u30c1\u30eb 2025-04-19 020811_1.1.3.png", "id": "1611007172945240", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392058_1611007176278573_6786826597370647844_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBJpb0ByB8wQ7kNvwEC_PH4&_nc_oc=Adk_owvDinpqRWw_TEeaFc1NE0FKnOTyepbIclRJcOfhTzHJ0yEgFAa9i6DAZS1BIy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft_Yc3GplxxJVcUj3nYrOAR3QXcG9K0B94RZV1WpoWYug&oe=6999AB99"}, {"file_name": "\u30b9\u30c1\u30eb 2025-04-19 020807_1.1.2.png", "id": "2635893566616738", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396955_2635893569950071_7913880576553535797_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1PJv7KvHcAQ7kNvwGkEDIB&_nc_oc=AdnRIHcaPxcmnxmdbxIs98v5sEAUEpj-lZOxGUjLjA4E0TpP_pHpjvEiS_WQym2IyLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsrAtv85mzUziwqtPQCBbPj7Lq_K0o__42cGKExGis22Q&oe=6999A218"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30d0\u30fc\u753b\u50cf.png", "id": "301560976131290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974500_301560979464623_3178722934129632622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSVnFoGBbz0Q7kNvwHbtjDv&_nc_oc=AdkUB2vNozXH3-mVXcQTY1YhCM9MzyXebPwRjgjHDBTSIqpiA0fQ-R99YM7PxxL8p5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuJkpDU6CNMY3o5M2D_Zhc2Cjep2ZyJupWtLk-ztz-HJw&oe=6999995D"}, "display_name": "DARKNESS", "keywords": [], "long_description": "\ud83c\udfaeGame flow\ud83c\udfae\n\u2460 Select from 3 difficulty levels and start the game\n\u2461Keep killing zombies until the game is over\n\u2462 When it's over, shoot yourself in the head to end the game (return to home screen)\n\n\n\ud83c\udfaeScoreboard item explanation\ud83c\udfae\n\u30fbTIME: Survival time (does not affect score)\n\u30fbKILL: Number of zombies killed (zombies killed with a knife are not counted)\n\u30fbHIT RATE: Hit rate (number of shots \u00f7 number of zombies defeated x 100)\n\u30fbSCORE: Total number of KILL \u00d7 HIT RATE\n\n\n\ud83c\udfaeStrategy points\ud83c\udfae\n\u30fbIn DARKNESS mode, listen to the footsteps of zombies and search for enemies while shining a light on them (be careful as gunshots make it difficult to hear footsteps!)\n\u30fbIn a pinch, use a knife and stay calm!\n\u30fbWhen aiming for a high score, avoid using full auto as much as possible and try to hit with one shot!", "short_description": "A horror gun shooting game where you shine a light in a dark space and defeat the approaching zombies until the game is over, improving your enemy search and accurate shooting skills!\n\n--- How long can you survive...?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://00m.in/MdJLn", "developer_terms_of_service_url": null, "publisher_name": "Xenosam", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCFeCuk-4FhT-Q3vCwzMgD9g", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24793506350316103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982539_1370438674355266_4574573133595813781_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUQfeK8z1nIQ7kNvwHwWC0J&_nc_oc=Adk9OMkr-X2IR_fHCzrfB5Xutkpb4ObW2EGZJ8OAe0FmQLcL4A9NV1-r5UfWMEngsAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftsG88opPmLC5DELOO_OzBh3kmtTxKOlbdP3gyFjV_UvQ&oe=6999B277"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DARKNESS", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1712350860, "lastRevision": {"nodes": [{"id": "7427293397364001", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7427293370697337", "is_first_party": false, "enables_in_app_ads": false, "is_conce
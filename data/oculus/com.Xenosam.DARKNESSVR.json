": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982625_949721433023651_9051503734647849790_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1JK6BAIJi4Q7kNvwFoZsQJ&_nc_oc=AdnO_oIlxoWJ6lOJT-jg3udkd1cJF76pxmvd0majHnkm_KZSZF_0WOut2DYaakme-9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfslS6UxdUVxBufIKGw6E7DtdW_HNZbdA9i0zm-qoRL90g&oe=69A05256"}, {"file_name": "2.png", "id": "598347896572554", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831145_598347903239220_6002657845272258296_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bAnegBqByYQ7kNvwF4FQA3&_nc_oc=AdmUBOJ8kZc1f8tUwTitLOX8U5i2JMaX5GPPob2UHPc_dBC-yaoMFUJXpDMo8QzFDAE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJnCuWLHRM8KfMgrnaaj67q08UMA1aL03wx8iukcXvTg&oe=69A04C25"}, {"file_name": "\u30b9\u30c1\u30eb 2025-04-19 020758_1.1.1.png", "id": "1005292218369415", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392183_1005292221702748_959948122684379104_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aMXXHKwEJoQ7kNvwEDSaF2&_nc_oc=AdlfHLyH60kGF1iuFjMnycZwguSSDgV3X2PXw_4r7vxtYUtJQ_fC2tc9O69ltbIThWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft9afjbI0MiasHyG3L4BohwcwQqHcxk5rNUhHmvdnymXA&oe=69A02651"}, {"file_name": "\u30b9\u30c1\u30eb 2025-04-19 020811_1.1.3.png", "id": "1611007172945240", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392058_1611007176278573_6786826597370647844_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QccB-DA9DUQ7kNvwGIQxfD&_nc_oc=AdlokV3KZcCr_KxmxfMSXPw2KxEcRodWP_J9mD9jlKVvDCDBOY87ji7qNAJYpt3fcfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvOJSvyrs8XHIfrHPF70qdeVFktk2OB0jammtXp2WJT1w&oe=69A04319"}, {"file_name": "\u30b9\u30c1\u30eb 2025-04-19 020807_1.1.2.png", "id": "2635893566616738", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396955_2635893569950071_7913880576553535797_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCtwD7OZVisQ7kNvwE261Y8&_nc_oc=AdmTYm7AHdodR28k7SPJDSji03F3o8Xn8UgjXDwZpQNZnRAFxp-Co92dMW6mTvUmBCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftVdrIzdDjop-2NMmJ8nqSgWorBtq1JEfrBsmbKzHZWKQ&oe=69A03998"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30d0\u30fc\u753b\u50cf.png", "id": "301560976131290", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974500_301560979464623_3178722934129632622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0_V4D7FLjEQ7kNvwFyimnQ&_nc_oc=AdmT8kriVrIJwmW9HqaV_h0QKyRn2n5gPctoXo5fI3XXnVEdC7yKukimeCwrmFHwmIA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvWi9HcXWe0Lx9kTQ1or7ZmutsnBPxdyyNUc-YXX8jWgA&oe=69A030DD"}, "display_name": "DARKNESS", "keywords": [], "long_description": "\ud83c\udfaeGame flow\ud83c\udfae\n\u2460 Select from 3 difficulty levels and start the game\n\u2461Keep killing zombies until the game is over\n\u2462 When it's over, shoot yourself in the head to end the game (return to home screen)\n\n\n\ud83c\udfaeScoreboard item explanation\ud83c\udfae\n\u30fbTIME: Survival time (does not affect score)\n\u30fbKILL: Number of zombies killed (zombies killed with a knife are not counted)\n\u30fbHIT RATE: Hit rate (number of shots \u00f7 number of zombies defeated x 100)\n\u30fbSCORE: Total number of KILL \u00d7 HIT RATE\n\n\n\ud83c\udfaeStrategy points\ud83c\udfae\n\u30fbIn DARKNESS mode, listen to the footsteps of zombies and search for enemies while shining a light on them (be careful as gunshots make it difficult to hear footsteps!)\n\u30fbIn a pinch, use a knife and stay calm!\n\u30fbWhen aiming for a high score, avoid using full auto as much as possible and try to hit with one shot!", "short_description": "A horror gun shooting game where you shine a light in a dark space and defeat the approaching zombies until the game is over, improving your enemy search and accurate shooting skills!\n\n--- How long can you survive...?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://00m.in/MdJLn", "developer_terms_of_service_url": null, "publisher_name": "Xenosam", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCFeCuk-4FhT-Q3vCwzMgD9g", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24793506350316103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982539_1370438674355266_4574573133595813781_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5trziTOfiAQ7kNvwErasOg&_nc_oc=AdmXRPdj3UAKFZEWFGNL2-oXgxU4ItwNgpWPIX32-8ev_CLeCm_PGgCMtR9XDRdiDHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs1tsnKOB2ustjrcOvt67vQAUXeFpwg8mytH3fc2f5bFw&oe=69A049F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DARKNESS", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1712350860, "lastRevision": {"nodes": [{"id": "7427293397364001", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7427293370697337", "is_first_party": false, "enables_in_app_ads": false, "is_conce
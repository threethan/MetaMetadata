71_7913880576553535797_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjI6r0KejFkQ7kNvwF-pyqC&_nc_oc=AdokEv3iRmTwsgEz73FqOtO2Ps0tazIVi9UjmBry4-XR8mfeL42KhbF4wj3jW-95sDE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO9T8gyjCdc88QaAHC9OC81Itlsi25Rhtiw1oGh76Dag&oe=6A5CC018"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30ab\u30d0\u30fc\u753b\u50cf.png", "id": "301560976131290", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974500_301560979464623_3178722934129632622_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CV826PSJposQ7kNvwH_E7rV&_nc_oc=AdqstrMHGLXuxNKA6X9A_xzNFd58_qt7ZjtfSnVE-6diwfeaYb9DBE1HH31qgbw3ero&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuvaxzAYVKbo3YyBSvHHBG6pGwqqpO-tkjLqebsdhJPw&oe=6A5CB75D"}, "display_name": "DARKNESS", "keywords": [], "long_description": "\ud83c\udfaeGame flow\ud83c\udfae\n\u2460 Select from 3 difficulty levels and start the game\n\u2461Keep killing zombies until the game is over\n\u2462 When it's over, shoot yourself in the head to end the game (return to home screen)\n\n\n\ud83c\udfaeScoreboard item explanation\ud83c\udfae\n\u30fbTIME: Survival time (does not affect score)\n\u30fbKILL: Number of zombies killed (zombies killed with a knife are not counted)\n\u30fbHIT RATE: Hit rate (number of shots \u00f7 number of zombies defeated x 100)\n\u30fbSCORE: Total number of KILL \u00d7 HIT RATE\n\n\n\ud83c\udfaeStrategy points\ud83c\udfae\n\u30fbIn DARKNESS mode, listen to the footsteps of zombies and search for enemies while shining a light on them (be careful as gunshots make it difficult to hear footsteps!)\n\u30fbIn a pinch, use a knife and stay calm!\n\u30fbWhen aiming for a high score, avoid using full auto as much as possible and try to hit with one shot!", "short_description": "A horror gun shooting game where you shine a light in a dark space and defeat the approaching zombies until the game is over, improving your enemy search and accurate shooting skills!\n\n--- How long can you survive...?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://00m.in/MdJLn", "developer_terms_of_service_url": null, "publisher_name": "Xenosam", "support_website_url": null, "website_url": "https://www.youtube.com/channel/UCFeCuk-4FhT-Q3vCwzMgD9g", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24793506350316103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982539_1370438674355266_4574573133595813781_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKv39-2jMjMQ7kNvwFdRYPp&_nc_oc=Adqqw8HiSAxh-2seGG-jqzanIcV69lhbCeOvjGNFazO1MdOPBYp1B7vxA9ALNwfC2Q4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-Ou94Y29S3J9jEpwyPTRPVjiN1Xh2Io2GfhmQdF5mJw&oe=6A5CD077"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DARKNESS", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1712350860, "lastRevision": {"nodes": [{"id": "7427293397364001", "release_type": "SCHEDULED", "administration_s
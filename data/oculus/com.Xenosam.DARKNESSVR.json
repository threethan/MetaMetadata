ED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7427293370697337", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "665296032370629"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "3021033741402614", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DARKNESS", "keywords": [], "long_description": "\ud83c\udfae\u30b2\u30fc\u30e0\u306e\u6d41\u308c\ud83c\udfae\n\u24603\u3064\u306e\u96e3\u6613\u5ea6\u304b\u3089\u9078\u629e\u3057\u3066\u3001\u30b2\u30fc\u30e0\u958b\u59cb\n\u2461\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc\u306b\u306a\u308b\u307e\u3067\u30be\u30f3\u30d3\u3092\u5012\u3057\u7d9a\u3051\u308b\n\u2462\u7d42\u308f\u308b\u6642\u306f\u81ea\u5206\u306e\u982d\u3092\u6483\u3063\u3066\u30b2\u30fc\u30e0\u7d42\u4e86(\u30db\u30fc\u30e0\u753b\u9762\u306b\u623b\u308b)\n\n\n\ud83c\udfae\u30b9\u30b3\u30a2\u30dc\u30fc\u30c9\u306e\u9805\u76ee\u8aac\u660e\ud83c\udfae\n\u30fbTIME\uff1a\u751f\u5b58\u6642\u9593(\u30b9\u30b3\u30a2\u306b\u306f\u5f71\u97ff\u3057\u306a\u3044)\n\u30fbKILL\uff1a\u5012\u3057\u305f\u30be\u30f3\u30d3\u306e\u6570(\u30ca\u30a4\u30d5\u3067\u5012\u3057\u305f\u30be\u30f3\u30d3\u306f\u30ce\u30fc\u30ab\u30a6\u30f3\u30c8)\n\u30fbHIT RATE\uff1a\u547d\u4e2d\u7387(\u6483\u3063\u305f\u6570 \u00f7 \u5012\u3057\u305f\u30be\u30f3\u30d3\u306e\u6570 \u00d7 100)\n\u30fbSCORE\uff1aKILL \u00d7 HIT RATE\u306e\u7dcf\u6570\n\n\n\ud83c\udfae\u653b\u7565\u30dd\u30a4\u30f3\u30c8\ud83c\udfae\n\u30fbDARKNESS\u30e2\u30fc\u30c9\u3067\u306f\u3001\u30be\u30f3\u30d3\u306e\u8db3\u97f3\u306b\u8033\u3092\u6f84\u307e\u305b\u3066\u30e9\u30a4\u30c8\u3092\u7167\u3089\u3057\u306a\u304c\u3089\u7d22\u6575\u3092\u884c\u3046(\u9283\u58f0\u3067\u8db3\u97f3\u304c\u805e\u3053\u3048\u3065\u3089\u304f\u306a\u308b\u306e\u3067\u8981\u6ce8\u610f\uff01)\n\u30fb\u30d4\u30f3\u30c1\u306a\u72b6\u6cc1\u3067\u306f\u30ca\u30a4\u30d5\u3082\u4f75\u7528\u3057\u3066\u51b7\u9759\u306b\u5bfe\u51e6\u3059\u308b\u3053\u3068\uff01\n\u30fb\u30cf\u30a4\u30b9\u30b3\u30a2\u3092\u72d9\u3046\u6642\u306f\u3001\u6975\u529b\u30d5\u30eb\u30aa\u30fc\u30c8\u3092\u4f7f\u7528\u305b\u305a\uff11\u767a\u5fc5\u4e2d\u3092\u5fc3\u304c\u3051\u308d\uff01", "short_description": "\u6697\u95c7(DARKNESS)\u306a\u7a7a\u9593\u3067\u30e9\u30a4\u30c8\u3092\u7167\u3089\u3057\u306a\u3089\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc\u306b\u306a\u308b\u307e\u3067\u8feb\u308a\u6765\u308b\u30be\u30f3\u30d3\u3092\u5012\u3057\u307e\u304f\u3063\u3066\u3001\u7d22\u6575\u3068\u6b63\u78ba\u306a\u5c04\u6483\u30b9\u30ad\u30eb\u3092\u9ad8\u3081\u308b\u30db\u30e9\u30fc\u30ac\u30f3\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u30b2\u30fc\u30e0\uff01\n\n\u2015\u2015\u2015 \u541b\u306f\u3069\u3053\u307e\u3067\u751f\u304d\u6b8b\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u304b...\uff1f"}, {"images": {"nodes": [{"file_name": "\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_\u6b63\u65b9\u5f62.png", "id": "1370438671021933", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982539_1370438674355266_4574573133595813781_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxsHNbSkqX4Q7kNvwHIEZwD&_nc_oc=AdpMizyJxYm1gnVIL45iNIg4Y5x39oO3HHSuC30QZ27O6C8GBmnGWUMKYdfpuuX4zxY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERFh6JFf16tMQxW3XG2uFa4ElfCDRDnBJmEClNdIGxfw&oe=6A95B937"}, {"file_name": "\u30ed\u30b4(\u900f\u904e).png", "id": "1112286563346945", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/43997717_1112286566680278_8262643853129945661_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TIiYunuu0cQ7kNvwGPornf&_nc_oc=Adq4SqV-FMB4srV2FrCIwOCnHCGgbE2pC-8RHxpNQYqSMzL18Cvt--WlE9f48h_wwhg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC306Six5YXojipcjIzhF4zo3drKmjrx95EMqLDBSRNg&oe=6A95DCFD"}, {"file_name": "\u30ab\u30d0\u30f
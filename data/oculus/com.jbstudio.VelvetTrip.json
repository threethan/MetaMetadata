746273596_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSIIjkqMa1oQ7kNvwGjMnER&_nc_oc=Adr04XPBZFgq12pvXuR1_ut0FohR5A3IqVST6mKvYDnz_IhPzAFTONIj4jccWWy4RFg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46cGinT8aaWLYGFUzLW0VAUmWrSYwz-C76G9VfiWHD1Q&oe=6A0C5092"}, {"file_name": "2560 x1440 (1).png", "id": "1328871992579384", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823943_1328871995912717_3145177252431335756_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33j5H3mkmFUQ7kNvwEAg-WI&_nc_oc=AdosqkJ0f59Ms0vLf5g7_NJyCPP9Wn4927tSeCPuznJjQLd1v02IEAcFiHYTgRV0xFQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pUM3EC4tyAp-2rqMfwEM7IoUoy_mx7gTE3-8QB82sxA&oe=6A0C5396"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-99g5tNaWkQ7kNvwF-b8uU&_nc_oc=AdoseOsPtMii7nvgDB44qoLvOj6uMgn0tfD3zFdjsSUjL-fdizN7a1PDyZwvI84c3iQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OyTSiLR4N3gtI3qWW0ZakjnibGCvIE7ygvfrJz8xNDg&oe=6A0C7322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x1440-logo.png", "id": "3700943656709564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618270_3700943660042897_8749273494339803378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoOeQThB7ykQ7kNvwHdRfC7&_nc_oc=Adr-uLyurYw8p1IfDNZfWjKZDPO-f5IEGjz8k51hfwcu1p2ccgyuqfFzpi-WiSeD14Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N5-1zJ1_tGpbhX-B-YHuD_boFmfXS2RcNpGRBs6dBtg&oe=6A0C539F"}, "display_name": "Velvet Trip", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Velvet Trip takes you deep into a surreal psychedelic world, where colors breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.", "short_description": "It's time to experience a world we've never seen and may never see a surreal realm closely resembling a psychedelic journey, a unique world with distinctive environments and lighting, brought to life through a VR headset."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24478043688478998"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1131716899117304"}, {"status": "PUBLISHED", "id": "1345615557444999"}, {"status": "CANCELLED", "id": "145081481325
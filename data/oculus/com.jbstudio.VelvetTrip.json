g", "id": "2138464939982021", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIYO3ZibCt8Q7kNvwETeep-&_nc_oc=AdrXcUDsobKq5W4VoYYZGee7AbBuWWeprOfPYvkJ8U1oOf_odrDbmkD2kazoYJEYmaY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwO9I_Af14v-kp0QFMDStl-vFaK9cxnfcNLM62GTCanlg&oe=69D11FA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1251938039699679", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821704_1251938043033012_2844570761361988560_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wAhO-3sTm0Q7kNvwFQTtul&_nc_oc=AdpS1UArYntQRtJXZDVUcGWTRCkWt2nUhgkYRx_4PasHnohD7_aPN3C9HrFrud3r5k8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNDhCEgybg49MNzm6wBn6wtSLO9S1Uvhp5v_GwKDLGmA&oe=69D10BE0"}, "display_name": "Psychedelic Trip - Velvet", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Psychedelic VR Journey takes you deep into a surreal psychedelic world, where colours breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n{905857818952167}\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.\n", "short_description": "It's time to experience a world we've never seen and may never see a surreal realm closely resembling a psychedelic journey, a unique world with distinctive environments and lighting, brought to life through a VR headset.\n"}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26341936765423005"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619113_955050296914645_159362205557305167_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGcINH8tk2AQ7kNvwEQKh1O&_nc_oc=Adow1B16Utch5T8OSer2DJgQ_JjTe6ki_DLDAjFrmnGIBd9oc2G_2UE33wR8ThfJkxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyV7aQgM9pdoOtM-faCmNuAKB8I-ZX4gsp4wF9rlWccNQ&oe=69D0F8ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Psychedelic Trip - Velvet", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1757146680, "lastRevision": {"nodes": [{"id": "24377366438546724", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"ap
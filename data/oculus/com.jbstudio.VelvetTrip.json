UVsXqOkdyvd5hWq_6fW5pavQuuE47Z4-ZBnldUQ&oe=6AE357D5"}, {"file_name": "2560 x1440 (1).png", "id": "1328871992579384", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823943_1328871995912717_3145177252431335756_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9H0QdAEIvMQ7kNvwGj6Edy&_nc_oc=AdqhYMwXR9R5RcFzqlOYCKp8yhhdta7bRjfZi9o5JZiFQ6j_2CwbdjUXK_h_EtD_f0k&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMneXw5Of7X4_zOPwkJx43toPjzaD20r5jvGglF8qZO2A&oe=6AE33816"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT59qvoNkgYQ7kNvwGQ_FKf&_nc_oc=AdqOhUbKk6ES16p5477fQI0X_tquemjOilimRtrFg5GqNKeGWnlF7KDN9kR1EhJdXZQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMoFdScemBPn69xYiTh7O_e4LMyy-30OdlIGJHzAQ0yw&oe=6AE357A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1479527013586576", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818860_1479527016919909_4907182485101700506_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12zkeu2PstEQ7kNvwHCN9of&_nc_oc=AdoY7iND5bKrIvXDUTjMLupxDHjOngXQ2yiixXGf4LO1Zj9hcY102BGADpd3FvnMO6o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDGLjukwNsMGKSXQIB2Cw942IbX3xC0O4pYojm8_bIdg&oe=6AE368C2"}, "display_name": "Psychedelic Trip - Velvet", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Psychedelic VR Journey takes you deep into a surreal psychedelic world, where colours breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n{905857818952167}\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.\n", "short_description": "It's time to experience a world we've never seen and may never see a surreal realm closely resembling a psychedelic journey, a unique world with distinctive environments and lighting, brought to life through a VR headset.\n"}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28701347039481954"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824741_2259415854818055_1169688414337342268_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vjixmi67EUQ7kNvwGiRdV6&_nc_oc=AdqwRR0GMo0q11UUfm86yq1XjaL2f2kP6QGyeB1EV_yhqAkucGS9F_nnott0rvqeovk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh
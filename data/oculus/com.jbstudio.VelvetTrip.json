ontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoMXle0P3CIUQnzBDUaZbO1diyeVOo1P7R0-dGJ1gIQw&oe=6A6DE296"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YptZqAtFAYwQ7kNvwEHsN1p&_nc_oc=Adqy9aBP-poIMiQLzn-p8xEB6gAU3p882WFx7zGqa7W6MMIWHo8VHrk7qptyTI71aG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTie44lJ_THRNVEhUubLaO24SlwC5qHqaw489JmnhFrA&oe=6A6E0222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x1440-logo.png", "id": "3700943656709564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618270_3700943660042897_8749273494339803378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rB5-4xqFnHIQ7kNvwFKZHMo&_nc_oc=AdqPN6ty8AYruFCW5Lax4vE0xU0AWKh3VRR87PeDpa9wHK6wbId7VIBzPAdaCycgyC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyFMkXJKAlyTUKRk0v0AnxOgKfeDkvbwfxEZ2XaAaLFg&oe=6A6DE29F"}, "display_name": "Velvet Trip", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Velvet Trip takes you deep into a surreal psychedelic world, where colors breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.", "short_description": "It's time to experience a world we've never seen and may never see a surreal realm closely resembling a psychedelic journey, a unique world with distinctive environments and lighting, brought to life through a VR headset."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24478043688478998"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1743198236717725"}, {"status": "PUBLISHED", "id": "1131716899117304"}, {"status": "PUBLISHED", "id": "1345615557444999"}, {"status": "CANCELLED", "id": "1450814813251840"}, {"status": "PUBLISHED", "id": "1627799618466338"}, {"status": "PUBLISHED", "id": "1251016986574627"}, {"status": "PUBLISHED", "id": "1606762313977107"}, {"status": "PUBLISHED", "id": "1427835175737036"}, {"status": "CANCELLED", "id": "818169111312587"}, {"status": "PUBLISHED", "id": "865624116248695"}, {"status": "PUBLISHED", "id": "697145286119295"}, {"status": "PUBLISHED", "id": "1055179270159373"}, {"status": "PUBLISHED", "id": "1472925737054144"}]}, "baseline_offer": {"id": "1131716899117304"}, "is_approved": true, "firstOffer": {"nodes": [{"start_tim
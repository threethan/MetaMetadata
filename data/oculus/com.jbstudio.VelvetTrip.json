7K-L&_nc_oc=AdnT14bcRFFBqwpZVR4ZRQfzVMotxk_r8SKBTATeUhAeQf1BPW7JCkUxgFV4wA8v3Qg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfywE1W6ssgzfPeax5NECz2uERFe7T9LkbDzKPy6ydJWaQ&oe=69B3FF16"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBJImwwqfKoQ7kNvwFrOfSt&_nc_oc=AdnxtXFYziudyy8kww-p2fX6ffzed0Ag6TTCVWJhVwhYcxj-894kjDSnyBd2MacEkL0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRVCmKBdIGk-rBjWLqQN17nFzjn19Nt0KpFdYYIuuvTw&oe=69B41EA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x1440-logo.png", "id": "3700943656709564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618270_3700943660042897_8749273494339803378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0rqRRJUfdwQ7kNvwFQ7iJ_&_nc_oc=AdkdE6Wtnn4Z85ZlVCqhXUpqAa3eBhfxGjPQEg_clxCLxkGQYA0CjpuyKsPLUAtXblA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6tBXteETAJt8hw073sVsDmMTZjuRQ3np0xXxMKjM3RA&oe=69B3FF1F"}, "display_name": "Velvet Trip", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Velvet Trip takes you deep into a surreal psychedelic world, where colors breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.", "short_description": "It's time to experience a world we've never seen and may never see a surreal realm closely resembling a psychedelic journey, a unique world with distinctive environments and lighting, brought to life through a VR headset."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24478043688478998"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1606762313977107"}, {"status": "PUBLISHED", "id": "1427835175737036"}, {"status": "CANCELLED", "id": "818169111312587"}, {"status": "PUBLISHED", "id": "865624116248695"}, {"status": "PUBLISHED", "id": "697145286119295"}, {"status": "PUBLISHED", "id": "1055179270159373"}, {"status": "PUBLISHED", "id": "1472925737054144"}]}, "baseline_offer": {"id": "1472925737054144"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774288800, "status": "PUBLISHED", "id": "1606762313977107"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24549782697971763", "v
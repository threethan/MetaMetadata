8871995912717_3145177252431335756_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03QIUNQ9rakQ7kNvwFvNkjG&_nc_oc=AdpiZdGskoiecZcdq7xsmeEUwTNw7U9oP3FebiXCPd2OTOQ-M78cxmqMHNUhzzD3u1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af270iGBFVZwBpzHV2hkKw6vqhwLqB4YRZshOL2YN3ao1A&oe=69E4C696"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRJiCqyB9gkQ7kNvwHhGiIR&_nc_oc=Adr1o6l35eRisCIS7Yxdy0phR-6Zz_6vLKHr6LUEmsXrQB9Q1uz-hsP5FPjwWRo6MBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BH8qidSOVhdwrtLTMu-DccyOsJdkt6opO_Hk46F2TSQ&oe=69E4E622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1479527013586576", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818860_1479527016919909_4907182485101700506_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MO89nV0EgXAQ7kNvwGVesI1&_nc_oc=AdquD_EAko4yT3bfwO1AkBuGyhi7r5A-1tQRDP1eNwbEjO4o9AQJOnGYXun9d-kEceA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AbX8CYYMOiEzfvEV2DONUFd5W0S0RaJAk7vetfe63Xg&oe=69E4BF02"}, "display_name": "Psychedelic Trip - Velvet", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Psychedelic VR Journey takes you deep into a surreal psychedelic world, where colours breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n{905857818952167}\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.\n", "short_description": "It's time to experience a world we've never seen and may never see a surreal realm closely resembling a psychedelic journey, a unique world with distinctive environments and lighting, brought to life through a VR headset.\n"}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26378957895054225"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_966004659342016_1426043610734836001_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqYubRlGSjQQ7kNvwHMPU4z&_nc_oc=AdqH0n9dE-tfKzbelm0oeJXPoIjGTSxmRwZeAmhWz08HbLXNjavf8XEzVcX-8a0kGYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pcByVcrR2QlYLKf15urjJ6lKScxIaRexs-1SLSoZGzA&oe=69E4E76E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Psychedelic Trip - Velvet", "platform"
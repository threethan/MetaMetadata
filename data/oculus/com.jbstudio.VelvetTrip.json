HgyGR6wg_AeLVjMZrBEadS4Xa_b5sepKaqHZzbQ&oe=6AE0B4D5"}, {"file_name": "2560 x1440 (1).png", "id": "1328871992579384", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823943_1328871995912717_3145177252431335756_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9H0QdAEIvMQ7kNvwGLKkyC&_nc_oc=AdpohVqmp_BaE3GV9E38K2b6fJPeh90lKrv95kQZu8rI_jE6bHY5VskoioYdx4ZQJrk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIJcAl4432012Ldgjb8MFt59KHPekIqI5u2OpV-_ISJQ&oe=6AE0CD56"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4sf9pgSLS0Q7kNvwHZ-mDw&_nc_oc=Adr__65Nf2pAx9PV-KT6x8O8Mk9EsK7_Z_Dz5kgqTzdshen1OO__HxXbvufI9aalQek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXgDwk0hgQ4IIoc58juDtCSXjrqgGL7W45D0csvhhllA&oe=6AE0B4A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1479527013586576", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818860_1479527016919909_4907182485101700506_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12zkeu2PstEQ7kNvwGIhfzP&_nc_oc=AdoJNFDJMFiKcN0LLBQcSx5e88a5o_oCitAr1-VQijEBHr7S0uqTjbAmycxe1ollUw4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYsBXDs4CIgIX388w_5DdkFNFExdJlalB-YY5hpxm_0Q&oe=6AE0C5C2"}, "display_name": "Psychedelic Trip - Velvet", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Psychedelic VR Journey takes you deep into a surreal psychedelic world, where colours breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n{905857818952167}\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.\n", "short_description": "It's time to experience a world we've never seen and may never see a surreal realm closely resembling a psychedelic journey, a unique world with distinctive environments and lighting, brought to life through a VR headset.\n"}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28701347039481954"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824741_2259415854818055_1169688414337342268_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vjixmi67EUQ7kNvwGBe5sY&_nc_oc=AdojrnZgtZuL1uQS4BtWoT-G1JokN0bsjZAERRFmg40LkinEg57CNbM6LEgIcPfDGMU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh
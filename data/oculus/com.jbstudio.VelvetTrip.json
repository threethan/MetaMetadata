68_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlJZG5BqJeMQ7kNvwGL8mps&_nc_oc=AdorAafRcnCnU-4ooszp8j0QiiKYxFVENzG-f7qkBZiiVWX65R1lWOSUrj_x--1_EZI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZsA43Fq7Aak2HRM_GiB0wygejJEWK0w0FkFsGlGZiDg&oe=6A22DCA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x1440-logo.png", "id": "3700943656709564", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618270_3700943660042897_8749273494339803378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0JoNCkxcUQQ7kNvwF0ztlQ&_nc_oc=AdqTVIiuFErTG_XFTyl-lzCzcvaYKr7hLknsg6PnckiI8EgT2lUsLNrGQm-RjfYHDqQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bUHU4vFK-uUHoWUhUvVTG4ru3xKvO9aau41VptF1DoA&oe=6A22F55F"}, "display_name": "Velvet Trip", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Velvet Trip takes you deep into a surreal psychedelic world, where colors breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.", "short_description": "It's time to experience a world we've never seen and may never see a surreal realm closely resembling a psychedelic journey, a unique world with distinctive environments and lighting, brought to life through a VR headset."}]}, "developer_n
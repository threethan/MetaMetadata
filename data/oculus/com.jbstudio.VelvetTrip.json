6184746273596_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILvTVLskAM4Q7kNvwGA2rus&_nc_oc=Adp7bHdVreMbGz91lWWVot_6904451x_f3Arl9BOBGqPJdk1GepGgQdhvKD0dr6Y0tM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhXq1P5dbLlnCboe8PNbGbc7d5kd3I7t4AQcprgVoN1w&oe=6ABD31D2"}, {"file_name": "2560 x1440 (1).png", "id": "1328871992579384", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823943_1328871995912717_3145177252431335756_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1NDgpmc24sQ7kNvwHXtLWP&_nc_oc=AdqoDRv_92ZZ5i0rpJ3_Pb8Xfz2unbW5FvuITvUM7anzggPdiwmSDfqNlDu5DwWibpM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvwO18L5Wy4t7ujJnaunA-v5Pypv9WBa_u3xwtlth8nQ&oe=6ABD34D6"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5ri17dJMv8Q7kNvwFW_kya&_nc_oc=AdrB4CzwIGVCjY6jzDgEWSSVU0WEQhM94qrJZPOB5_xWAZvmDU4PrhhoqiNK79x3umY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDKRBbTCBh4UPAoH6atLRKe6LDRRVJCGIDFkor538P7g&oe=6ABD1C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x1440-logo.png", "id": "3700943656709564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618270_3700943660042897_8749273494339803378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z3nHIJS5cEQ7kNvwEk3ktT&_nc_oc=AdrCXA0RFJ8w3clA-Ehy_PEvWT0azUobhcnF_a_T7G-px6fD07X--QXeuv7LHcI6mC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtoQa4H944nmAP0_76DcYn0ZaT_2OhzgqWV0cDjkWsbw&oe=6ABD34DF"}, "display_name": "Velvet Trip", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Velvet Trip takes you deep into a surreal psychedelic world, where colors breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.", "short_description": "It's time to experience a world we've never seen and may never see a surreal realm closely resembling a psychedelic journey, a unique world with distinctive environments and lighting, brought to life through a VR headset."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24478043688478998"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "815857271591212"}, {"status": "PUBLISHED", "id": "2598742603893590"}, {"status": "PUBLISHED", "id": "174319823
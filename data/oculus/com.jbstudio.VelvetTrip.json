t-hkg1-2.oculuscdn.com&oh=00_AfvzYjM9lBoKgAMCAM5SE3HK4RBLNlpvFbQaNNy5WKxX5Q&oe=69A18712"}, {"file_name": "2560 x1440 (1).png", "id": "1328871992579384", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491823943_1328871995912717_3145177252431335756_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlGFM5jzx_MQ7kNvwGdAFB7&_nc_oc=AdmhVbbYPFj5zyzjgZk6ADfJ9DNXYmMooLsgvuipK8i6ryV1buzzLuwP66qcio-kOes&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvW3VKIEbRIZ1YD_dLwTwbTl7l3v-SiEyls6Xg3t3-MWg&oe=69A18A16"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYknMbfgT1sQ7kNvwHNSDev&_nc_oc=AdnxUGiEehZSV_rNxIHYR3kk4khhj2NlhDwBgqvyuKn2D7rtsjJJ3pkfSAam_1FEv3k&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs4ooHlyTUD2pHhihnWdQN1Fj8KIJh-r9i7JFkOPfOvNg&oe=69A1A9A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x1440-logo.png", "id": "3700943656709564", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499618270_3700943660042897_8749273494339803378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0dHjuAlqKMQ7kNvwHULr3o&_nc_oc=AdkOHZwH2-FsXxki22TE4GGHWVzb5a1KcwRV4C_2SkLCfI2TIBdOkmafEETXy_XafAA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftF0qFG06IHqb4ar7gzif7XU5xjWH5mY5PqO7atIIKTbg&oe=69A18A1F"}, "display_name": "Velvet Trip - Virtual Psychedelic", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Velvet Trip takes you deep into a surreal psychedelic world, where colors breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.", "short_description": "\u26a0\ufe0f Before purchase: This is not a game but a surreal VR journey with a moving camera. \n\nInspired by psychedelic visuals (LSD, mushrooms), it recreates research-based experiences useful for therapists and consultants. It\u2019s a unique and powerful app that lets you explore vivid colors and dreamlike worlds without substances. May not suit everyone, but those interested in surreal VR or therapy find it truly mind-blowing."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24695017240114974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491821686_1278453043720276_3711703538338631596_n.png?stp=dst-png_s360x360&_nc_
Fv4Wi9Q&oe=6AC27AD6"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QWz5x0WlBQQ7kNvwGW06vt&_nc_oc=Adpa5UPhch1gqMmYyljUMKXizaciwto3jaF01ipJfmTjO7s9wBMgmZ81sGioCNYqJWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxHhjagytwV-KG5864F_w0YxOqf5DSSwuYA4qzlESwpQ&oe=6AC26222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1479527013586576", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818860_1479527016919909_4907182485101700506_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f11kauHEarwQ7kNvwHZPcbu&_nc_oc=AdoTVNG3NVPzsU3ymw30GD_Q0F0gRN4YofKyIWkC7jgdBV2akELi5v5iGb5_XFV7sgM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC4v5i4mGjrWmMziqX_HjwcjQ65ffIe9gEYLyrotIyZw&oe=6AC27342"}, "display_name": "Psychedelic Trip - Velvet", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Psychedelic VR Journey takes you deep into a surreal psychedelic world, where colours breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n{905857818952167}\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.\n", "short_description": "It's time to experience a world we've never seen and may
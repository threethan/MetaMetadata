46648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqB2xtoJ_QgQ7kNvwGOjY-a&_nc_oc=AdoxXtauSr-seXW4_gWUsqBsHaocACjI3RPRPXEQVdvVbkV21AkFhSkxTGob-QtSdP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wy_dbEwaYNiKscbqHERvCXWBuMh_kYQS8tu7t7-6rmQ&oe=6A145C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x1440-logo.png", "id": "3700943656709564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618270_3700943660042897_8749273494339803378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6psV4_Y5sFcQ7kNvwGnNcU1&_nc_oc=AdpsnWZbUxyrKRJOlszuZy37XUfeVlaukpCvgihVssjlH9ybmebehMz3oyJAvLJtC3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gOI8asUo1SGj8728MrzP-IHYn3kV5J0i2qKRif6dXyQ&oe=6A1474DF"}, "display_name": "Velvet Trip", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Velvet Trip takes you deep into a surreal psychedelic world, where colors breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.", "short_description": "It's time to experience a world we've never seen and may never see a surreal realm closely resembling a psychedelic journey, a unique world with distinctive environments and lighting, brought to life through a VR headset."}]}, "developer_name": "JB Stud
8PfD7AT0N4Ger60Vjs4AdUL__UPOq7QMzERY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIe3rfNm543qED8p4fDq37itQ_j7ca171GEpYwY2_N20A&oe=6AB15452"}, {"file_name": "2560 x1440 (1).png", "id": "1328871992579384", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823943_1328871995912717_3145177252431335756_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeQ6txs8DtkQ7kNvwHjlUEc&_nc_oc=Adrus-XVXBtmOvesKvI1dQoz-f-QOauYcnC5gWHw7K-NsogyWRBO9lirDB6XO0cimI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL1oNmjYx71SpQwxpakb1o8Xz82QPJlsrxwa1F-TAKeQ&oe=6AB15756"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMTjlVmjj00Q7kNvwHJEmWc&_nc_oc=Adov9iqR6GFDSXG39JVSFqTkdCCnBiplcIWuo0NZL-iMbHoxL5U5L5NZ6dgnXa0Smjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3ysHvCLbyEfl95Nz_QMMjElt_FyL4mKysBRLAHlZA8A&oe=6AB13EA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x1440-logo.png", "id": "3700943656709564", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618270_3700943660042897_8749273494339803378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBZ-vIxhh_AQ7kNvwF8r9K4&_nc_oc=AdrFazLkJaDRAloNVff3QYHe26fimUS4cseZAqsDoWaTTks1SZD4iponZcebUOJnsL8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvahYBiL6geLksf60ehRmOcYSOSMX1XPJ6ICU0MUdfig&oe=6AB1575F"}, "display_name": "Velvet Trip", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Velvet Trip takes you deep into a surreal psychedelic world, where colors breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.", "short_description": "It's time to experience a world we've never seen and may never see a surreal realm closely resembling a psychedelic journey, a unique world with distinctive environments and lighting, brought to life through a VR headset."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24478043688478998"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "815857271591212"}, {"status": "PUBLISHED", "id": "2598742603893590"}, {"status": "PUBLISHED", "id": "1743198236717725"}, {"status": "PUBLISHED", "id": "1131716899117304"}, {"status": "PUBLISHED", "id": "1345615557444999"}, {"status": "
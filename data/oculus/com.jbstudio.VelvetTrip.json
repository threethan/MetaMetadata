6UZhUOw&oe=6ABFD7D6"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QWz5x0WlBQQ7kNvwGuHVhS&_nc_oc=AdpFTWLNJmDs2wbrU6wroihGbz-LxPYD0ZvfuHday0wkFHJ8rGrTXWwSGOBUittb6OE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6WUGkR8CTCbqfm9s58OJsoID0Jp9ZHIxIGTrVRGbFIQ&oe=6ABFBF22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1479527013586576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818860_1479527016919909_4907182485101700506_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrNZLBfsROIQ7kNvwGg3sZe&_nc_oc=AdrEcevjfto4dc9lJhh15wy2jQJqbH4HKwnV595jxGbhn9bBxcPBfz_PIYAl2VNLw9I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6uJg8jOZvae1zugFwD9ZKmLN-zbBTfwgm5qMtcjKW8w&oe=6ABFD042"}, "display_name": "Psychedelic Trip - Velvet", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Psychedelic VR Journey takes you deep into a surreal psychedelic world, where colours breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n{905857818952167}\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.\n", "short_description": "It's time to experience a world we've never seen and may
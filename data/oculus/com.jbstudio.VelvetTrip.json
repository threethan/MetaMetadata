3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQdXbb3XyWGZ2Q6ah6-oy_j7n3FKsDYjngmSG6dXPqQQ&oe=69B2A853"}, {"file_name": "2560x1440.png", "id": "736758622682755", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312231_736758626016088_5053526184746273596_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ov83Er0Pe_MQ7kNvwHkNAvv&_nc_oc=AdnJN3tT9GEn3cZmdPJvP-Z91vlFbKftT-nGyGIZq5s7AXcOAc9xXNowGMm1DYOlEKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyG4fGKAC_SpF_Irw9uYW1vgKLhdB5aZ4ZJlSlav5BU6Q&oe=69B2AA92"}, {"file_name": "2560 x1440 (1).png", "id": "1328871992579384", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823943_1328871995912717_3145177252431335756_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EAxBNGpDhEQ7kNvwFUGabB&_nc_oc=AdlR2fzBv_0G_Y0n0vXeJG4QVYD8Phgg6KeCYTpBclXbtCW9eXNCNbuNRvKeDP1KjzM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwQ_k9T-r8OyB9HE7Aoap82Nsm245u-BDohT8UwSKYfhQ&oe=69B2AD96"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBJImwwqfKoQ7kNvwFlUTCz&_nc_oc=Adnr1FLZ5BtAc0g0QnJr1Eh3n6l8D7jyKNZQYpKZIclBzuWyRnvGqVGCEjOwYFfpBWI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwb5qIBz6NurkIugUDOp8Mn95s2_Hxx61g1UPEotJQk6w&oe=69B2CD22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x1440-logo.png", "id": "3700943656709564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618270_3700943660042897_8749273494339803378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cq_6ceo3qnEQ7kNvwHLOVzc&_nc_oc=Adk3JkV4FLRLXcAszrxB1p3urMKNRo4SnxQeVXavvV1gd-Yvy1KuywGbPc_PFvufwLU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyI6WlpsYcsMXJ2YfDX75JJDhLiaMOewx1ixLaXoU2Fg&oe=69B2AD9F"}, "display_name": "Velvet Trip - Virtual Psychedelic", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Velvet Trip takes you deep into a surreal psychedelic world, where colors breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.", "short_description": "\u26a0\ufe0f Before purchase: This is not a game but a surreal VR journey with a moving camera. \n\nInspired by psychedelic visuals (LSD, mushrooms), it recreates research-based experiences useful for therapists and consultants. It\u2019s a unique and powerful app that lets you explore vivid colors and dreamlike worlds without substances. May not suit everyone, but those interested in surreal VR or therapy find it truly mind-blowing."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_me
e": "2560x1440.png", "id": "736758622682755", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312231_736758626016088_5053526184746273596_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ekLoq0B-gIQ7kNvwFNnaiW&_nc_oc=AdlBvDM_0f329BP4k-D3pO3bzPKMTZVuir8jSvB6_mJ1Qlp71Xnb1IwNK26hspS_WqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvBgbILDM6KmJNMZ2IlZEOVcUEs7qr4Q5yg03il-f2vUg&oe=69A97012"}, {"file_name": "2560 x1440 (1).png", "id": "1328871992579384", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823943_1328871995912717_3145177252431335756_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ek0CZlqDOx0Q7kNvwH8yyTI&_nc_oc=AdlgNwPk-Xxgh9wjMChnx_vClpv95HXv0yrtMI5Rv5klYgPEUifIQiIHAL1EA7W7kq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs839X0UpnJVuiKQHgQuqSkHdLY3QXqQSwrpiSIjTfaxQ&oe=69A97316"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgDS8EuzdOQQ7kNvwFtj8Rj&_nc_oc=AdmnUGRkebsGJySRP_1MoY7xAUXBKh7F10lZ1HLGX3VmvovDVODII6F_VFCntDdzpIY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftjKwqhShkSigXKi1fcy_CJbbp-aEbXtmkhUDszRbFDNA&oe=69A992A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x1440-logo.png", "id": "3700943656709564", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618270_3700943660042897_8749273494339803378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDsu4gjmsHYQ7kNvwHRxDKf&_nc_oc=Adnd5cg1aYh38AHFLA-eOBIPkUXrJgRjSOwCr_oNVFzY-LIM3oYnbTYSVN6CTRi25zE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu74AZyNlA_rkBBcjEZ6Czfmf_fj_Ve0QVegZjQXY2n-Q&oe=69A9731F"}, "display_name": "Velvet Trip - Virtual Psychedelic", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Velvet Trip takes you deep into a surreal psychedelic world, where colors breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.", "short_description": "\u26a0\ufe0f Before purchase: This is not a game but a surreal VR journey with a moving camera. \n\nInspired by psychedelic visuals (LSD, mushrooms), it recreates research-based experiences useful for therapists and consultants. It\u2019s a unique and powerful app that lets you explore vivid colors and dreamlike worlds without substances. May not suit everyone, but those interested in surreal VR or therapy find it truly mind-blowing."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH
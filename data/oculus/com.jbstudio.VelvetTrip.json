746273596_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNqARS7JRwIQ7kNvwG75SFU&_nc_oc=AdrKf4gx8Ee2X66s6gf-gBCMNQfbOnig3CKKlRGpqhzsiMdMZw3DaWdLV2XoDEF0bnI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VXoTdHQHoyg1aHln0S_YjjlrlHcEqg14y0U8gTIbEvg&oe=6A09AD92"}, {"file_name": "2560 x1440 (1).png", "id": "1328871992579384", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823943_1328871995912717_3145177252431335756_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f_0nP4GPzgQ7kNvwHcZFyu&_nc_oc=AdqGt711SL3FkPsruj-ELLwMa9amVlYNZM9mh_wWgU4Sjpbsxpz36ts89zdXr5ZIxLY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YxKV1jdyxo3ZTrwyFJZwnDRF_qI2h845K4juNYl8VdQ&oe=6A09B096"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-99g5tNaWkQ7kNvwHn7Vvz&_nc_oc=AdpkIuMn3a8eVU3nyZ8_bTmeogVmC3XjzoQXh3tCdTNPHeGYGa4QvujiYPr5tpRU8LY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40QM14qbfYrLQZ_lZuKRbpC0AKOPhn4NjtDusAoeamCg&oe=6A09D022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x1440-logo.png", "id": "3700943656709564", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618270_3700943660042897_8749273494339803378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ybiWo0iwKIQ7kNvwHzfOl_&_nc_oc=AdqWTtULJQEThSu3tWv6O8fEOqzR4Mkyz0Vcm0HZ1nEJpKsTUXpL5Q07oFEW7k4HYyo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fdo69HZCehRqavwVFPbqoIxnDPTaE9ntALC20ngxRCQ&oe=6A09B09F"}, "display_name": "Velvet Trip", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Velvet Trip takes you deep into a surreal psychedelic world, where colors breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.", "short_description": "It's time to experience a world we've never seen and may never see a surreal realm closely resembling a psychedelic journey, a unique world with distinctive environments and lighting, brought to life through a VR headset."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24478043688478998"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1131716899117304"}, {"status": "PUBLISHED", "id": "1345615557444999"}, {"status": "PUBLISHED", "id": "145081481325
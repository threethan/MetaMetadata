8871995912717_3145177252431335756_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03QIUNQ9rakQ7kNvwEy3NHW&_nc_oc=Adqc4ZDWIX3WaQLrH8otRh3xp0oe8ui04rdRAk2QJwXpED7xO1unwh0MO0YbsVFCTiA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m0qnORGkwA72w4oC_YRhdWjCylGin5ZoS6O1d32A7fA&oe=69E61816"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoFbHg8t-yQQ7kNvwHXwshF&_nc_oc=AdoL0sotIFh2b7YGbBT5Is__1prE1uVT0pV2hieATqIFofQMBkBSbe0H_GUu7QXjmuQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e1vJXpBqQ_sBO5yBG2Cq7xk117dKoy7MJKv4PKJ2v9A&oe=69E637A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "1479527013586576", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818860_1479527016919909_4907182485101700506_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MO89nV0EgXAQ7kNvwFIhO7c&_nc_oc=AdpzSmtkwdhQ5T7pKmG6jER9wkn-AAYERxWbi1PM-hdLiASAHY9OHCRUv2p-IbWZPMU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BFJOv6SWpZnCgiZxswk6TiFJKOk--G-ikUtdoTuwzyQ&oe=69E61082"}, "display_name": "Psychedelic Trip - Velvet", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Psychedelic VR Journey takes you deep into a surreal psychedelic world, where colours breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n{905857818952167}\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.\n", "short_description": "It's time to experience a world we've never seen and may never see a surreal realm closely resembling a psychedelic journey, a unique world with distinctive environments and lighting, brought to life through a VR headset.\n"}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26378957895054225"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819854_966004659342016_1426043610734836001_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqYubRlGSjQQ7kNvwHCh-mT&_nc_oc=Adoa7u5EN6MUnNRQugK8Oao16mqdk6BdoqSNJ0sH1W0oeBUat_XAY7H7LmGZOVZXlHU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2r9JQWPCE9_IdM9u-3ZLl9oyuVs_MoKAcQ7vDlAEyvLw&oe=69E638EE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Psychedelic Trip - Velvet", "platform"
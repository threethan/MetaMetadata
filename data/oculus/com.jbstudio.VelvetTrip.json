in6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQ0EQfe3D8lLx2KVZycakY3QGIby-SXMw8JZ9dvlJK2Q&oe=69AAC496"}, {"file_name": "2560 x1440 (4).png", "id": "2138464939982021", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620368_2138464946648687_2895817815258228863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GuMEyXAUR8Q7kNvwGekCml&_nc_oc=AdnCTMdU3t3Z2UqvfDi09QUi9_CNdvzRWkT5IsnqnqppsVTTcm-mb8R4sdGRFbaeDOs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfysVswQVyAHPsyx3VjkrNthMFxglCWZjUoxv_RMvn2zrQ&oe=69AAE422"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x1440-logo.png", "id": "3700943656709564", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618270_3700943660042897_8749273494339803378_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDsu4gjmsHYQ7kNvwHeQK0C&_nc_oc=Adl9eMahi_UYF0o5DxCO9D_Tz0z2mNXBYMcRrjIQniA2b36HLgFJj68u3gM5rZBK3NI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAXiYXE78mKwJTqtI32ydmn0XTje9rK6I8ObCItIZ7PA&oe=69AAC49F"}, "display_name": "Velvet Trip", "keywords": ["meditation", "relaxation", "surreal", "psychedelic"], "long_description": "Velvet Trip takes you deep into a surreal psychedelic world, where colors breathe, shapes flow, and the rhythm of nature syncs with your mind.\nDesigned for those seeking meditation, relaxation, or a safe psychedelic-inspired trip inside virtual reality.\n\n\ud83d\udd39 Features:\n\nAutomatic camera movement: immerse yourself without any controls, just let the world guide you.\n\nSurreal psychedelic landscapes filled with giant mushrooms, vibrant patterns, and dreamlike atmospheres.\n\nPerfect for meditation sessions, relaxation, or simulating a magic mushroom trip in VR.\n\nBuilt for VR headsets to maximize presence and immersion.\n\nVelvet Trip isn\u2019t a game in the traditional sense it\u2019s a guided inner journey. Put on your headset, let go, and drift into this mind-expanding world.", "short_description": "It's time to experie
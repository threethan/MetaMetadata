ng straight to your headset.\n\nAre you ready to become the ultimate table tennis champion? Grab your paddle and step up to the challenge!\n\n", "short_description": "Step into the virtual arena with Table Tennis Star, the most immersive and realistic VR table tennis experience! Whether you're a casual player or a seasoned pro, this game offers precise paddle control, lifelike ball physics, and engaging gameplay that will keep you coming back for more.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://blackholeinfiverse.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BlackHole Infiverse", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9939326106103042"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_4130223483789789_2540537965627731811_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQtH5u5BQMoQ7kNvwGR2SgU&_nc_oc=Adq-z_7N02OJGWQMYJvTCgpGpyHJPD2x9itHpAAkayall8vv5EFrdnPD_eIv4UlQh5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QmYgWTQbG6jYS-C-cQI9PX2T65zX7qv9TCF_WIqPOjw&oe=6A2598F6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fals
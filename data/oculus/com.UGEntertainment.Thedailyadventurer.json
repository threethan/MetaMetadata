luscdn.com&_nc_ss=7f20f&oh=00_AQRDnxt52I0JJ9xMS9XRPPMB1XQvAkGD4cH41WEXqkcvFQ&oe=6AEB3B39"}, {"file_name": "com.unity.template.vr-20250602-015716.png", "id": "1414480203336305", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821799_1414480206669638_8913084822286967399_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Js2cX2Ok8IEQ7kNvwGmUS2R&_nc_oc=AdqonX8ctvngONES7Q8r38U110Bpy4Fs0WewfTdbGZoeTq7LrrSi3QbqRMPvp5maB8Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbvmpbijsVUKsvEGvhEPO0b93_gQIgBFF7wJApqExBWw&oe=6AEB55C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6807\u9898\u56fe1\u6539.png", "id": "1017051663525704", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619131_1017051696859034_3972916854438054725_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_FgBxZk-JkQ7kNvwE99S06&_nc_oc=AdpgrKyfRhCz4ap8QzP8NIn12ZlGtGVU44DzjBWjtCkI0bcADBMV4HyRDI4mJF6lycw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS68Lq2Ei79TJXtvUi6AX2f25YuqIBqYV2aAdYWGhdZsQ&oe=6AEB2EEE"}, "display_name": "The Daily Adventurer", "keywords": ["LightRoguelike", "Strategy", "Leisure", "Action"], "long_description": "\ud83c\udf10 This game contains no dialogue or written instructions. All gameplay is visual and icon-based, making it accessible regardless of language.\n\nThe Daily Adventurer is a fast-paced auto-battler roguelike built for standalone VR.\n\ufeff\nAs the master of a monster-filled maze, your job is to repel waves of greedy adventurers invading your home in search of treasure.\n\ufeff\nManage your resources wisely\u2014use power-up orbs to evolve your army, defend your spawn points, and unleash deadly AOE blasts.\n\ufeff\nWhen fully charged, take up your sword and descend onto the battlefield in first-person action mode. Slash through enemies yourself and unlock new powers every 10 days!\n\ufeff\n\ud83d\udca1 No text. No tutorials. Everything is visual\u2014learn by doing.\n\ufeff\n\ud83d\udca5 Rapid-fire rounds: survive 20 enemy waves in just 60 seconds\n\ufeff\n\ud83e\uddec After extensive reinforcement, the unit will evolve twice\n\ufeff\n\ud83c\udfae Descent Mode: enter the fight as a powerful warrior\n\ufeff\n\u2694\ufe0f Equipment adds effects like stun or crit\u2014no raw stat boosts\n\ufeff\n\ud83e\udde0 Strategy-focused: resource management is key\n\ufeff\n\ud83c\udf19 Night phase lets you plan, equip, and buff units without time pressure\n\ufeff\nNo menus. No interruptions. No distractions.\n\ufeff\nJust you, your monsters... and a maze worth defending.\n\nYou can find the background story of this game here, presented in the form of a novel\uff1ahttps://ugentertainment.github.io/the-daily-adventurer-info/", "short_description": "\ud83c\udf10 No text. No tutorials. All gameplay is visual and icon-based\u2014perfect for any language.\nThe Daily Adventurer is a fast-paced VR auto-battler roguelike where strategy meets action.\n\nAs the master of a monster-filled dungeon, defend your home from wave after wave of greedy adventurers. Grow your army using power-up orbs\u2014equip, enhance, and evolve your units to unlock their full potential.\n\u2694\ufe0f Descent Mode lets you dive into the battle in first-person: slash through enemies, unleash sword waves,"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/UGentertainment/the-daily-adventurer-info/blob/main/privacy.md", "developer_terms_of_service_url": null, "publisher_name": "UG Entertainment", "support_website_url": null, "website_url": "https://github.com/UGentertainment/the-daily-adventurer-info", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMEN
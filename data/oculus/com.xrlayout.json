810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVeTn_bH9O0Q7kNvwEnQb_u&_nc_oc=AdqOflEu4suLgjGx2N0dPrERLlPYGGdzBSvO2wrodZHZEy1ntzJnnfn1PMnKbaXTALM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBafkHZrSAlSRkHNylcN_muGmRQe8xQeNT2DsRpRmYQgA&oe=6A6DF280"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAWZoEFq6IMQ7kNvwGH2nE8&_nc_oc=Adq3Wx3-1e6TAgP6nhra-BzlcgMGd7_B6toVfD1toHl3IZMK7sanRmjRo_ePv4FyRiE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVcfg2crK5_8ZY02xuTAO85DLpcmLmmxDV6oIDAKGzSg&oe=6A6DE12D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l38hAeu3Sh8Q7kNvwGxpqo3&_nc_oc=AdqKvYUbCIn1k1mDbHe2tlVsUwspTDV8XexMU-pH9mhAOmP0S2l2MWJsJUbEk9b3tPU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDKb4irvoFLkeNaDdMftZK1g52GCMrk373vqD0rOLRtQ&oe=6A6E02B5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZpOMuc-r70Q7kNvwFn_Q9A&_nc_oc=AdoeSJFRRi2NOHfY8XICffUQ7Gp-02lCeA1n9Fgp0fCs364_3_TdSG8PN-oAAhcj6-8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLWBJWII4aQzowreBot2OlswWKOgzg5RZpg_d-4AHROQ&oe=6A6DEB9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53iXTV5YYikQ7kNvwG8cy-o&_nc_oc=AdoFic6Rd4Ybx_mNX-PMJBP7W8ZjVkT1vBlu1alCwV7sBBzIl-ztBpg9QXuaJA2FCH4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpxwTQa7PNYokTbjCcQe19kiTD-li6CYiS4GsK38V8ww&oe=6A6DF861"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
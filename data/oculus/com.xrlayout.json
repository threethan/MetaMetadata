66f4\u304c\u3067\u304d\u307e\u3059\u3002\n\u307e\u305f\u81ea\u5206\u3067\u4f5c\u3063\u305f3D\u30e2\u30c7\u30eb\u3084\u58c1\u7d19\u3092\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3057\u3066\u4f7f\u7528\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u3001\u53cb\u9054\u304c\u4f5c\u3063\u305f\u3082\u306e\u3092\u501f\u308a\u3066\u4f7f\u7528\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\n(\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u306f\u95a2\u9023\u30b5\u30fc\u30d3\u30b9\u306e\u300chttps://xrsns.com\u300d\u304b\u3089\u3067\u304d\u307e\u3059\u3002)\n\n\u30d3\u30b8\u30cd\u30b9\u7528\u9014\u3084\u5f15\u3063\u8d8a\u3057\u3001\u65b0\u5c45\u306e\u30c7\u30b6\u30a4\u30f3\u306e\u969b\u306b\u3082\u5229\u7528\u3067\u304d\u3001\u69d8\u3005\u306a\u5bb6\u5177\u3084\u58c1\u7d19\u3092\u4e8b\u524d\u306b\u914d\u7f6e\u3057\u3066\u8a66\u3059\u3053\u3068\u3067\u5b9f\u969b\u306e\u8cfc\u5165\u306e\u969b\u306e\u5931\u6557\u3092\u6e1b\u3089\u305b\u307e\u3059\u3002\n\n\u662f\u975e\u300cXR Layout\u300d\u3067\u30af\u30fc\u30eb\u3067\u9b45\u60d1\u7684\u306a\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u898b\u3064\u3051\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\n(\u8a73\u3057\u3044\u64cd\u4f5c\u65b9\u6cd5\u306f\u300chttps://xrlayout.com\u300d\u306b\u3042\u308a\u307e\u3059\u3002)\n\n\n\u25c6\u6a5f\u80fd\u4e00\u89a7\u25c6\n\u30e2\u30c7\u30eb\u53ec\u559a\n\u58c1\u7d19\u306e\u8cbc\u308a\u66ff\u3048\nBGM\u306e\u5207\u66ff\n\u81ea\u5206\u81ea\u8eab\u306e\u30c7\u30fc\u30bf\u78ba\u8a8d\n\u97f3\u91cf\u8abf\u7bc0\n\u8a00\u8a9e\u5207\u66ff\n\n\u25c6\u64cd\u4f5c\u65b9\u6cd5\u25c6\n\u53f3\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306e\u4e0a\u30c8\u30ea\u30ac\u30fc\u3067\u30e1\u30cb\u30e5\u30fc\u30d1\u30cd\u30eb\u3092\u64cd\u4f5c\u3057\u307e\u3059\u3002\n\n\u25c63D\u30e2\u30c7\u30eb\u306e\u64cd\u4f5c\u65b9\u6cd5\u25c6\n3D\u30e2\u30c7\u30eb\u306b\u30ec\u30fc\u30b6\u30fc\u3092\u5f53\u3066\u305f\u72b6\u614b\u3067\u4e0b\u8a18\u3092\u884c\u3063\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u79fb\u52d5: \u5de6\u30b3\u30f3\u30c8\u3
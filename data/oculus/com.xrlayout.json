810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H1Gh6CB8RYQ7kNvwGjvNm9&_nc_oc=AdpkZUJ3LeBCKM37U9NcOVIW34Noag5D4unYETbpMNBChQZa3eqjP54fEAtHRHO3Bfo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSGAg2brmRsR1ZfC-Yra1F7a0fj6fRMSQXKj59SrSmLg&oe=6A974180"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjACKUSbqhUQ7kNvwH-tzgl&_nc_oc=Ado5G2kMpuAfJJhAxcKZgyOaTOFoXpMDcrE0u2m6ARY5r-lg7XBXF0AHSdvMEqh9yIA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw51OdFUkgmYKPZielVl-chIpZxN39l1CqzoKjcx9kOA&oe=6A97302D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2IShii-iOUQ7kNvwHj1wsx&_nc_oc=Adr5rjNWWRactgEvJ-r6Cb2yUrHFKs9bb_2aZSdsHJb6rzGaMjkm8hh4C-Zb01kLGYk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZAWM__O-Aer8dS4J3CRjvBx0zEzHGzEKRpNzH03bPZg&oe=6A9751B5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQfZdvC7WPQQ7kNvwGGIkfz&_nc_oc=Adrexu9QuMsVZYsGJ1DqI7ug6B3f1G162eWxMJgytfG-RZTQx1TT-vtbzg5d9cW_vE8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIF5cV0ancpNEG0Cw3k9vc5I-jzufLPh04iWgDv681kw&oe=6A973A9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=km6-z0zdl_EQ7kNvwEYziuj&_nc_oc=AdrPPfvbJpSIVd0xpDEKq2lA7Mmi6oQrIxnXpKa4ORyS7rc3ioFMqnvpWALr2zqw8T0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_JQfZBw5VsbzASS2_ZToI_l5Ya26mAt0oFX49eO0k_w&oe=6A974761"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
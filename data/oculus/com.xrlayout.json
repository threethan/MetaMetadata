810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a79xxPUQWU0Q7kNvwHGR8LG&_nc_oc=AdrHc8sVdfyk4FsDx1ymZXZbf7TtQ7tKto4PHvC1mtdkTDKyyQdmaxPeEDmvW2Qmey0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OUdURxMZxDfAnO73zifdVaPAcqi69or1WVOy6EQ_1Uw&oe=6A2AB600"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aunPQj7UbCIQ7kNvwERxCvj&_nc_oc=Adp2430FIdu7mf04hmksVZgnGbMfHpD0V76i1N9RtzP0c4z0wxHsN1goVgJ1wpnemeo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bpMR_cdGWvvbgbEQumUu6czD5FySWmu-M4ESK0afmPw&oe=6A2ADCED"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlPEt-BbQlkQ7kNvwFdAA0k&_nc_oc=AdqV3AtHdmOifA2RSd0axnDjZ4umjr36lnDNQ5kdoEI5Fq5WKycJUuLTfE9CrBBHB5I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_iwszKaKxqZ2DvmbDBjcB-KS2pukR4l1UzCUFHGsKqw&oe=6A2AC635"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1olel7XG4IoQ7kNvwE70N69&_nc_oc=Adq1kuDZNJwZkAV4fr2gfA3Zt5CuOkVpKzkteuVXJKlwzeFkgV3WQ0LJphw1l6gJkrM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kau9TlUc3Sdg14MnG5U5DshC_px024Fyct6-SGMBROA&oe=6A2AAF1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmqIJhI3pVoQ7kNvwHIQaXg&_nc_oc=AdpcpqMGlvpL5uZ3bKOkBMpMEXSZ9wpnNr1R1j9BGt4UEsx82vRGo13fh6YWbtUPiCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6D8z4Jkqiuer57AnVgW2boIilBNB3umF8Y1ZVMoM67w&oe=6A2ABBE1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
_1136248810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7Gvx6ps_kMQ7kNvwGcSR8B&_nc_oc=AdodwIEb2u2yNoJii5tg0DSzaChZGQ8UxCQiVyTLPFNyte1hM_vcFcbL9jq4F-oBJgQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKqqpCbnu0moU2c0Hq4NRAhBBhiL48pRgC_Vk5HDqBWw&oe=6A8D9680"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrxhU_Q45_sQ7kNvwGv48yO&_nc_oc=Adp1fF0o5S9YNGpyYw0kF_ixFX_ft8HUJ1bCaXED7C602lV5ZQQKN9pKSwp4Pc8-n5s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMIyS7ND37XzYEoJsVk4zwbAiN7AwNimK6Vma4Kjl7nQ&oe=6A8D852D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAgF7S06uvIQ7kNvwE8dZTx&_nc_oc=Ado8MEDk6woxE0oeaBeDUnfqZgjWy2P_FTREGrdIQ0aJbpJwWYtogPRix4wpyqjOib0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvANDY2ND6Qf1lx6OWedMEtKvvr4BcUAsHyMeI0d6PiQ&oe=6A8D6E75"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeB_cq7WFOIQ7kNvwFR702I&_nc_oc=Adopb4LF1kisbWlBOOFUBrmyhMzqIBa5EQCMLFES3v2ZOA_HECZRj848DXF3s1z1yXo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxvGXD9M4rxuMADCwUG7kMNTd9BedxwFNU3RajyhoXwg&oe=6A8D8F9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M62XTyN-kGYQ7kNvwHFTd6l&_nc_oc=AdrL4kjzQqDqHqq5bKk8THWAdHITZfQ_Po4VK8smj10ZsXdj1Ay5pNA0va6DtQ1OWKE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL5wHnPgKIx8HHgR3msdK2B4RpcO8N3GlCGH59NiYdhw&oe=6A8D6421"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\"."}, {"images": {"nodes": [{"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1700921013769246", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57575360_1700921017102579_5965761788146700936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FoGVljy6OoQ7kNvwFtLZdr&_nc_oc=Adq5kQQb5CKXsRpd_324f7UyVEQ8RCRDvqCllF3wGeMRV_3rJ3M2uLwSUuDs6-jFnLs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4kULq1G7bwQ7Twoy0LZIoL2Q5aZPwJLiPuRjdgJ9qwQ&oe=6A8D876D"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_3000x900px.png", "id": "1109468820180572", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031429_1109468823513905_91045592395151573_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmSh-k4256IQ7kNvwHlrL6S&_nc_oc=AdrIjxSwhdS_M_XbJQND5N82qGk_T95PKPJroFoA8A24VlbxadY0iYNiUyuP0BEcD3g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBTIkfxTh1uAC8Lr6q6BBD3cu5AP777i_f-A95aYMFUg&oe=6A8D89B1"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "741753654793576", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75488373_741753658126909_1339597984623439031_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6ewd6FoDYwQ7kNvwHEJhnA&_nc_oc=AdqxIXqSQ36YDEPeuQn_xOuq3GMccSt8gLkMR-XdpOlD-pVm0Ixsl6VJGV1KWM4fE84&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJv-RbSZVUTNJbrdF9n_V400SwyCoVbA_tzlEy0c5A8g&oe=6A8D64FA"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1440x1440px.png", "id": "435753252347472", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75367598_
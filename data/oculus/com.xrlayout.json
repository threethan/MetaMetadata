136248810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mfT-UNUxYIQ7kNvwGHkBxB&_nc_oc=AdpdUaHganKtoUTvkkR_b-qbLQqLJMhYECSTiKSwk0v20XF24Qc9eu0wB-ggb7oHmXw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZfQ7Z-NJUqGFpN2Vs-PI3oX-oAc8AEa39ZcMNpi8uZg&oe=6AAE8C00"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUH5oAz0qLcQ7kNvwGbg0Dk&_nc_oc=Ado9Xzekp87kqqfDKgzYHSYkfYyLnOmZ3TYgLI9WRuvF7w5J8tWx4NM7ABYfV71U22c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1nix7lB3JNpAbIGUIH7AyHkyWZnfRJbS-d6r4tLbFaw&oe=6AAEB2ED"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0mXjVl564YQ7kNvwG5Z0wY&_nc_oc=AdpDyngXmKYT5IlTBNoeWMz-4ofc-qDtaBj6bSzdQSjhaRNMht_QKSXAOq2GKnZ0660&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsKizMIbgDNEjWvPqUIE_j36zV80H_rDbh-jVam4tovw&oe=6AAE9C35"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tyi-OHYiWj8Q7kNvwH0PxGS&_nc_oc=Adqbc1qt-igpAOUSSokDD3ouOf1w5ulJ35ek9I-KtS8Cw9yd7SOqKnfCsXZun18XNoM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhT5VDMFSUwWwjC2Cqug8HrD4jh1SVwxumgZWBXQgO3A&oe=6AAE851D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dASQg2VbzoQ7kNvwEhlmxs&_nc_oc=Adr5zQf2NaqAJ6cXIdF9_FxZdZqM2SjRxwyj7PFB3ajMRflLX3TPrDuhGTGmeIQPaDI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLv2834r-arCHTZ0fC4tum7aHKoXHEeMzDGVJhxhzvog&oe=6AAE91E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business u
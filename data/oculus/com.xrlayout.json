810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-is2OafYtsUQ7kNvwE6q3Fg&_nc_oc=Adobe6DvcCaNHAxYgxyIwMLJrRfxRmCawi4zNSsZMsn-WYmNpUfBxwsPP7Nounn1oCU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdVn1zuge-TCHwfhIHQXMWK5jleMC37L67ULAMKh3Yxg&oe=6A675B00"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cYlyMNFiVMQ7kNvwGrtktr&_nc_oc=Adr1uwvJVl-Dy5lJAQgkVat60rMDuBUOl-rB5MjJ2qfGvgZNSiImWlP3JPB2qoQP7SY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfDL6RcBgVFb66_sGZ7oJBlQlkyhvd-EHZuAj-iskALg&oe=6A6749AD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSqOS_XJuwEQ7kNvwGm35de&_nc_oc=Adq-NVuhfjLNMWDnWPUKisArt70m5u9Aisd2U5I8xVGLwLWXdJ_3NUWLAvTEahHi5zs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0AgGjxLJevRJjTQG8JLjq1_ZgFv0eAfe6gKKZCKvIQQ&oe=6A676B35"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7dXJ0eKqzQQ7kNvwGG4_vQ&_nc_oc=AdqNUonORoEaI77xpvvz4Lk_RTffk_393Klx5iCi5p-LKccxVlDFZpNX7uLKc0iCz0E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4fXHx8q1glFm7xzgK5ls5Ubqnth27LElpTQV15izPZw&oe=6A67541D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KllBLdxQkn0Q7kNvwFD20hE&_nc_oc=AdqV89y9PUIn4Gt-4VvHFm4FEd9FYhnu-qEPqpdHUGLeIsWBUFXEkp_J4JHK1e19CJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxhnhLYYI4UjA8nJdb10Nqjcoku6ZrK8o88lMRQTp50A&oe=6A6760E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
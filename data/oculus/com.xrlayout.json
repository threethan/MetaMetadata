810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1sA8-WTFLUQ7kNvwGNrj9U&_nc_oc=AdqY9OZAWluyBpF2AQj636Me5chwgJQXUUiLz3EQmli3s32HaJgVRk_ZcZpMp_cPNOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cEBGHU7EXx0qJ1I6hvb6bxvQDc76ZEFHaI-JqYS-tKg&oe=6A086F00"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnTGk5i9zjoQ7kNvwEyG9lW&_nc_oc=Adpm146ZlCO1Q2mAr73YCOOUtwzL8tq37CYPjtnjGO60bUPnTlLtlsxnicn3r2FrsL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48OutU7jJiKczsd5zwv37NtDqH7Y5C1TXkYX6ThASHhA&oe=6A0895ED"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1PSIU18RusQ7kNvwGW1rjL&_nc_oc=AdoRTtbfadE9CLmTR9-E9V-EjeYL7f3YlZYblpWQ3idQSt5oqLgZXGWCU75hd5UnCno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Jj8C-Xi0jUNKyfPunHDtA2Z4rA20HC2DWYpnj6MhL7g&oe=6A087F35"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kzsndOYa28Q7kNvwEJwZl8&_nc_oc=AdpabU2LIMMZv5UGDjXbMWRHnT0b7kAZF2hmXJK5UzU6idBMA18twj3Ecf3IiQyDXYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Iwe43xJKnDQ4TT6xVAO7hH6MDxtezl5B7-R5YONyxSA&oe=6A08681D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbQ30vP292MQ7kNvwGlTjv2&_nc_oc=AdqdGILSwTBkXe9yItY6W4N7cbprKZ7VHOSaSJGpSzmdyV1UWmfIjmdMApc4DhKUlVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zH5v7FYOxyhQ9sBntz3VpRgFKFqiJB37u9RvhQ4-BNA&oe=6A0874E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
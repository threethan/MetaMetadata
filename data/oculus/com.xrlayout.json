png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAL7w28ehNEQ7kNvwH9bMGQ&_nc_oc=AdkXzgZer2wSePSLPg-kgWIwQdDWreQEfs7pLzeXF45PDPe-x0BSb95W5n3jEofNoU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-wRcmVHCVZG8S4NLHtvSpdbyGIz1j9mmJFIYcSXS_eQ&oe=69B40F00"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSTo3DNlq6kQ7kNvwGBF8NJ&_nc_oc=AdneesvL3m32Wq5rp-Q9r8oxCD4520ou5aU8Ff7uY__2e1HEZKQdcNatvKxEccdTBvI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzUK2Z7CiAVPx9fp7s8YoLV5Y69F_ZyKWaz73NknLpixQ&oe=69B3FDAD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FHwZWZLT9IQ7kNvwFcJ27e&_nc_oc=AdnZh3jvoYu2gDuzkRdcXmme0b-Lye29KpFZVvlp31H6_Su9EkV92ymqqk1vEFwjclM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfywbAEvheta7qFs8OsLo5TLoNuuQh8_Ka4u_sc8iFXInQ&oe=69B41F35"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3o6If6sFWIQ7kNvwFYxnTD&_nc_oc=AdlVHeL4qfLLXUUdqj2zuAQNtuMTasoOWq2AK6itIJy-oZvUUPDQwVUWkmY237T8DEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDDRS9O09zZ1quHj96ByQC7MyOuydLVGPsb1VcqFdHEw&oe=69B4081D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9ezT_vXQAYQ7kNvwG0ge97&_nc_oc=Adnou2kifF-fAGtpHCRaPmUwowW2ZXKFuUgq1E0dz4fdLCELEqGV_RT5Oa86zVaFnIk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwiPLtQR_hp_ggYBjjiJQOcYyb5shXWsPaULmTEMN5Nmg&oe=69B414E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allo
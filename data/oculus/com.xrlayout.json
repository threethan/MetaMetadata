nc_oc=AdpQt3g8GkHxOP6xpXsLvpHaWEC1CNAN4rSKvs9O-6qwEJe0L6Rl0J3cKBX3w5HlUtY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2fHkLRZYeJ68qY54nP2c0z7RiVsF9nRfztp6jkK4bbIw&oe=69F0B400"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1vFiyNVfigQ7kNvwFp5_AZ&_nc_oc=AdrQ-SWxG9Fy_DsESam3_jsijPwzjfzVL8UERZc4SfJj985SmDF8-w_KSrsaHHkmAtc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1D6cBgAa5qCbtLRxmFsIl3-dFmstH4si6XwJgAOGYDSg&oe=69F0A2AD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJj4oZhv7pEQ7kNvwESodzW&_nc_oc=AdoVlD5HPu9Ppve4YYM32DqpZgz24Q5J4o2Mahzji9HMElbR_Owfnyct0xO8XRp3tYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2P7Dd1iphV3C8EFVBxwtCUx3RKl_v0Qatnrqflia4D2Q&oe=69F0C435"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YX3Iij1GDzUQ7kNvwGbe2kZ&_nc_oc=Adq5puQjUQfdNtG18NBLv5ZJaNJwJPmIX2SlhZNLTGTHODpf7h6FtOw6vZo901Zfpqg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3rRecuKSavLA1MEps-OCNeUR528TZmK3exHanwdPZOiw&oe=69F0AD1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEDLslfxiCIQ7kNvwFRyz7v&_nc_oc=Ado7g4uAzVO78w3Y_n4JaUDHBXbExn7s_qvyzaD9Q-87Hondg9KHkSZr2jKr4cT9zkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2a1oLlM1uMiEb1WdK3ty1WG_fWnRo2i6BvIzPF-ldOnQ&oe=69F0B9E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imagi
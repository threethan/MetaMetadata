nc_oc=Adn05qbN3kaCGagoZ_VofBe6XANHt3f8WFQnm7zIW1y792pWIKuOGXuWSTmDE-8A6Wg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftG8Azrtvw9z0Uwp6dxNWmFmmr_Zx_N940deZvMlt8tXg&oe=6999B100"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qXIn2NNWR8Q7kNvwG0E0KS&_nc_oc=Adnl8-TDpsZzHPjBDFfFns5of7DN15KN1mm7mkdg2dTlHlcXm0kZaKSmIkLvmfTGNUY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu5bNhUVjeUvkoY9iJP6EZY6RuH0W8ehsymrUpBEjlw0g&oe=69999FAD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjECnrz8te4Q7kNvwH3-7LG&_nc_oc=AdmNbVP2VZz74RuV1YOsXGXoghmOOblrzBo0Uum_WquWhNhbmtPY4aQBoH1TtWmjjns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsGVAHBB9JPoCAA-rSM1ogdBZNZv3gLalTc4awOcNBqgQ&oe=6999C135"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iovfd1lNn6AQ7kNvwG9PQSp&_nc_oc=Adk42tM2hsy3ifvhl4KugQBugDkiN5RWJYp1hIgcW1Epvh-fcpb1eTPRDxqyPFiW6Hw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvB7KbYJpSsSvqjh9xhnHryk7Y9HE4MvJaFxjcZBDbhTg&oe=6999AA1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjfvMzQs3xMQ7kNvwGQYMBO&_nc_oc=AdlZ-22jaOvy56wUfeHxaEK6zjWaeK21nJEkQ_2HiQqQOjgd9ujv3SLqCI-lfOXdPa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0flj8U3LHNSti1mbZRTCZU0XZP5QScBkkWERFLkBiEw&oe=6999B6E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imagi
810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYdHJvHjkkoQ7kNvwHTIReQ&_nc_oc=AdqS9phnM3O3RvF3_UdIfwSE_iJjp5uCXQyl_v4UtiFRr1t5sbGGzyDQPWTRtU2FcAI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhiRkAnhx442NK5BVm-aP7L1C_aK-T93Kotb664YFS-Q&oe=6AC4F580"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw4TMOBehUwQ7kNvwGkyr_Q&_nc_oc=AdqVgK9kftMOcI1hOEJON9d4GqmIID9vwSpwaZQ-0mfjT6zLgWX0PHtOcKc-iIPbW9k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOopzpfIy7qsAmCMH7tvinQ8lTBBnw_GJJEM8ViUOtKIw&oe=6AC51C6D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxXc9daRnkIQ7kNvwHsvHEX&_nc_oc=AdrV4646DOdPvEiauOdQndCXEC3GbwexWd9wTdKjntq29tgt26Kun8iNlsn1shOq6TI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUkgE2lQog6MlVUajwTCPCPSuS0Y3ib0pmY5JzL1bmqA&oe=6AC505B5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qREEIiS3wLQQ7kNvwFHLosI&_nc_oc=Adrm4q-xoAEKf_s84PV--6io1Xv-kYFf07uQKHJkG2PJSzaPbhWDDT3w_RB4Fkq5aOQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ-CRKV2bEsT7-X5jFUYBJMISc6LxupYp0DPbjY_i7rw&oe=6AC526DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5BldTc3VZYQ7kNvwGJ6Hh-&_nc_oc=AdoyXWt6TaTpQEiYYbEIcQYHQeWEQKVDucPoxRX0qBm9oSUAGfzMZnsUZ32j-Hjo1g0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv2_dRILor8YyKRib6SyXJy9zWgmBnODZApAKG5-Z2TA&oe=6AC4FB61"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gqb9D1gID20Q7kNvwGehYuM&_nc_oc=AdqE4CFDvblyGCiVgO-tPD0Wa4gwjRRSilCehgoY8Uu7iFnPsQGwVQzsGc_h3642kZs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXo1haUtrY5-Rjc-jRlKTdHelMar7XV-aMOmQyrENKPg&oe=6A81B900"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pmaOBKpH0sQ7kNvwFQQ-VF&_nc_oc=AdqoMo1kOwqdMBpiQVbdOv-DXTvsdULIsjq76tpslq64JL8RzOgNBeyFmvEDWqc0zPk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqlWDRM_iRYmnlS4vtiLHATvniDL5YSpf40eapB-waaw&oe=6A81A7AD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vaCXMZuKzUQ7kNvwFRvOuy&_nc_oc=Adq8otecAUtn2H8W_-CMAkhqa8pjv2bPtv8w7301wsyXzdlv1HV5TNWW0Ns6PqzO-Vc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCkhyQ_Q526nOXf2dfKSR1iUdsZSaXkf-23IBYo5efaQ&oe=6A8190F5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJxosVgzY1MQ7kNvwHwk1Yg&_nc_oc=AdoE_Ofea9SPuYQZOcgo_NZfx6mKj3tjzpMbg5vxHaKJEpVEyVEGaOrFSXluj7P-p1I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDVZsQa4cG62yL-PLtX-Gjyf-iJU0ZzFKj8qKJHIj65w&oe=6A81B21D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1r5jOhfs2sQ7kNvwGpSEzk&_nc_oc=Adpq8b5xV-dRIu05uBsuzGXREUQAssQhZb2FhDed-8SSjmInkUaToXhjO8GlGtlHBvk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV3-b9bmhuz2c7dqHJImUFt1QZps-SvMFEtoOuN8stvg&oe=6A81BEE1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
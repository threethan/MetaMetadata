_1136248810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIRE8fMauEMQ7kNvwF8VofW&_nc_oc=Adq96_TdooCWLhYwpyIZ_nw4JtJ1h3oLAp0ig54I9S7bhvHbkbBAuwoLQ2diU1nMhtc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFORNLuRVc2fwC_-EX7DRcrGp1ddalNXG87Q0p25zjUXw&oe=6A85AD80"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnCOMETAtKQQ7kNvwEUnu75&_nc_oc=AdpcnsnmO0CIN741IVnXk97-xNIwxpmsDUIsvlVrGE3fOfz5DtFS2ILwFc-A8LnU4FA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr7nJtzr7sV4rjIGRcJ2apb4J3LNJwRay5eW5xIYX3Dg&oe=6A859C2D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5W49yGUXyOEQ7kNvwH1QHnU&_nc_oc=AdqCOxTTksXDI3Sfa0AMh3yqA5OnGAcckfz9aqmf9U1vo-ZUEDUXwoGwHsdpsctCmHA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEph6USu3AY29-wt24Nvj1M10SqgXouhVkPYZw8bJKdfg&oe=6A858575"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iphEVB_qO1gQ7kNvwG9Zr6o&_nc_oc=AdqPU-j73SPxHtumxbPwhqDxmXBK_2GoWP55FBdr4UW-hKX8WNKIG-FtuSvqW6d0Jno&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErdNm5qJGOG0b20KZ4dG-9czYbLXbm4xEW0XJMJh1qbw&oe=6A85A69D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=We4C2CvT4ZEQ7kNvwE7UCp8&_nc_oc=AdoTWXFeLb8vFOBz19nTKHRav1gmBlBeZPpe6NQm1SEi_hIi89XtcujV_kIkEPTd_Mk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpVtqrWFhKl3q49EF9VIhTkkqNTNOb69VJHbmiq1eaiA&oe=6A857B21"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\"."}, {"images": {"nodes": [{"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1700921013769246", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57575360_1700921017102579_5965761788146700936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDVExmBDHjUQ7kNvwE4kFvd&_nc_oc=AdquHt17TFWlemmckoTZ8KO4skA25HetMnp6cimq-0WBSbKaXrDgsc9hcmYlsbVAoM8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMAFczUoZFlFdHJ_HlrCqsj26b5szBPVUP6edIJ6NcPw&oe=6A859E6D"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_3000x900px.png", "id": "1109468820180572", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031429_1109468823513905_91045592395151573_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-06BghXtA4Q7kNvwGt2UQJ&_nc_oc=Adop0nrsIvgflfj0THXSC1u04NXF3fF1GoQPk4FXbg-isr_HM9trc1V6l9Dd0NkXzZs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrFqyhE6mBR58o1Hy4rd6E8uF_YkbqFP4Ae83e78CVAQ&oe=6A85A0B1"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "741753654793576", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75488373_741753658126909_1339597984623439031_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZ7mbDBWQYQQ7kNvwH6JTke&_nc_oc=AdrC9n1YUAmcCbhSiHT80Yh4xUCZidoZyJF_VoanGm-wjSzzuJvGHe-FteJIGeT6G88&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6qOqEcR7YgNqh3AqGpq_Ffp-3KUfqkKEngkGotUGUGA&oe=6A857BFA"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1440x1440px.png", "id": "435753252347472", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75367598_
810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHs-FoRyM_0Q7kNvwERO8vO&_nc_oc=AdoWD2JU_3GQ9pA3jk4EvcwNFwBSBM5MwKvGWt5nmImcxtfZoooBq_ZYFR7UVlPmh_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvZCJSLxc2sEL81sIuOSz4MUlFgx7jQGAqCj-0Zk6oIA&oe=6A903980"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVY-kVFcHhIQ7kNvwFDLR7W&_nc_oc=AdokKYdbu_2-xCdIyWF1cNwBjZS98nJ2SSSiv7LVgMDHEqMeZWTs4PkuNdgD6UkmvmA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0rQvtoxdmWmn8zAsid8gzAwWU3wGO8EKLeXG4aVkmWA&oe=6A90282D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkOtp3QglMIQ7kNvwE1SVLI&_nc_oc=AdpeVNFUSih7bJhvxHgnaikqQN0k3v68_YfA5WV50oMztHFS37_Q79zQacMA3fKj6tc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbrNTqqV-32nqWogVC0zIQB5MZWxNTPzhGxXdu-Lr_GA&oe=6A901175"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSo_7T8-ficQ7kNvwHPXIQa&_nc_oc=AdoXuWONMLl0IT099KlpHEBw15jz4aHl00oqSPOqiTKPPzNL2X8L69vhE7gz0wXAvUc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmQ8bXjZXWotehEkU5YXzgGsw2rAC_h143JmG2Xv383Q&oe=6A90329D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M62XTyN-kGYQ7kNvwGhkyZn&_nc_oc=Adr231zssMFewYB2eQUUKSVBli9mpkLzQ2O1BngRpeebsFc8xutSiB5INQNl2VR62tg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLhwcwayHNNOzk-Kzf-ZA07RXknYdqcypNa-tRXCAN9A&oe=6A903F61"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
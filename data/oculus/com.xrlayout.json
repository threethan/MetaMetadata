810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXJCxX6miH4Q7kNvwEpIwEb&_nc_oc=Adqzb0y4U0OQZ3mmLbM_O3U_Zd3UQOSUXxaFe5_gw_rYU9h5aFeUrXwMdoisNZaOS18&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNbuoAsMSZKBQx2nhkvIoMdEmJ5Itf6bqRuN5vyefrvA&oe=6A5CCF00"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdovdEgsXCcQ7kNvwHWL-ue&_nc_oc=AdoK7Ju8uPQaxxoZPVaClR7c3B3Vl5ByqAX6wqn2OYVMJPVEFW8i0ALLSCLslA6_C6k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmjLnTNkYS4FG90sW1ICRl2FhTrCLLluyK5Nr86-h0gw&oe=6A5CBDAD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khR74tOZaaIQ7kNvwGzaFCN&_nc_oc=AdpUinw4vWmXVeK_qNdBfhoQlmyezAgktS5TYgAM42ZWmySvE2fjnJdanK634TJQ8d8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWMF-HDdE1G8f93z7xK5V4mVESZQXi4hhKazV46zOf2w&oe=6A5CDF35"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNbnAFL-vMEQ7kNvwE-R8rM&_nc_oc=AdqCHNQhJzZ5PsXaGnbnD-_oXwJ678M8w3nq5sZzy_Nd5E6gvp6Oa4IY4i103GFI4jw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHiSrdm27Wt44JfI17Xawd_pZ-M0wOSoG4ivwyrCZnAA&oe=6A5CC81D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkGuR8QPxkcQ7kNvwGaQHdT&_nc_oc=Adp0tBFpT6GiJ26B-OsitkY_08z2W9hUSXHHO9VKBtOcBPM5dGQ_-lC7gSdRBdUd8Z0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzk09IJ_tRZuyWmMkVvUe3ZPrFfNcEr3sC2y6orBWYYA&oe=6A5CD4E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
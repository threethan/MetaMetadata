810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JD0UsAOt74Q7kNvwHO9KE-&_nc_oc=AdoOXP82C1L-W-EjH6ndISJOjznCeS2mDb2eUOOOEFSqSuEpn968xRUPCl0ZmyucG-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRHQwxmuIhv9DIFZpNd8IogguKFhCFZarVqvtXMQLkQQ&oe=6ACA73C0"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9cLk_YrfMQQ7kNvwF03VLs&_nc_oc=AdpmeICpABtVafJMiSr66whoq2rOpCUf8J9Ml8Gt9byNyN4gIBxij63E1PmzrAmyAdE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjrAsO6CVCkUrFiutDF8l3-nqjznr9RO1i8OY0dVbKEQ&oe=6ACA626D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pA3eZbI6z7sQ7kNvwGi8loC&_nc_oc=Adq_dHA03Syp7IlCzqs_qXWT5b6wNO5DOZJn1tztSAi4tfDOepJKSIP-JVelPYgfizA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmvGVuqnJr40WRp3BpEHCHYg9BbMN9qR-ID_MzmecmfA&oe=6ACA4BB5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sfz9fbU8b0EQ7kNvwH8pfN6&_nc_oc=AdqfG0cZP2IjVZj9HsmxI7wg7dbgJ2r5n7KoTdJG8t6_J1yn0OHstfkyGycuvmDLQgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1hkrPuZOJFj96RFSrB_3oAaaYKcg7QlbwM-HiFnQbqg&oe=6ACA6CDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uuHxAFEPdAQ7kNvwGdd-ZF&_nc_oc=Ado2BGu27NxZgE8VRpvO9tEqC1rrZ4yyBfK5H45GYD2jf0NkJ3NxTanKTGag9rW7EEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgyhUBxnX0XVFotRv__fsLwkmcmWk7GhegQ6AogVDQhQ&oe=6ACA79A1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
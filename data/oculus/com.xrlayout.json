810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCsjjbQYxeAQ7kNvwFvORi5&_nc_oc=AdoKVp8raY63xZeEhoDZp_7KWeMuRQ9MVEkh0_4PijqRGP46v5WxtTOu0uVtCisISSQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NYDFDfb5P7Qra69kNKGbVGVZCbsAI4J8PtfmNHn8RXA&oe=6A0DB500"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4VPCTnKyVMQ7kNvwH_dLCW&_nc_oc=AdrxIG6aASywT9vStXqWCr_GhDorsjqBXNcgW03IgiDBsiujpmRJ9pH9kcDarcIXN74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X_54FEIIT9rfw4BXgWtnfgAz2hsQKj-rzdePJlAMf_A&oe=6A0DA3AD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPVxq0ORBH8Q7kNvwFNjxfR&_nc_oc=Adrnr_0_0HoAn_cPe4GSEKyGfYW2a_WmDLSWoyjOJ3gePHR_wLiJIiHMWOOdTN_hW18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AZpxUfzHkKBk3ZYaIfc__lyOI8vYIue7PWjVg6zIUgQ&oe=6A0DC535"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twPixuGEj7gQ7kNvwFmfoyQ&_nc_oc=AdqChsmNSZfyciZJSflAqOJV_DF7to1Df_BUybjTDWDc-DBBSSkBspKi4clqh8yGbQE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bnm9QS4zdhBGM-kjsYO6E69om4MjYm18hdft-lKjveQ&oe=6A0DAE1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJIecS06fGsQ7kNvwEIVF4j&_nc_oc=AdodHRMJJCOHgXUXwIbLMU5hF1FTNbMRBj7vhR_dgDUL_etWn3NO93GFEGXhKgx51fo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OtDRfIMFq5_J1e3Y4fIjD0NfBZw_ETfqlrmIAS3Aecw&oe=6A0DBAE1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
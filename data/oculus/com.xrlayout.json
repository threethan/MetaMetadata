png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yf_X9DTdZ_wQ7kNvwHVQwgX&_nc_oc=AdmfcbOyD32AJc7Z2Yx5aAsARjVIBNxi8d6YVQliDwk6-cL-q_BNR1wn-YgzNErzveQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWXKeZjb9RCbwF_Tqz7hoY9MsMqYN2620swGGnb0o2Og&oe=69BD4980"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t423qpgTaQAQ7kNvwE8a4-V&_nc_oc=Adk54T1yz0XLC-v_MT-JawwmHxg0rtL3_ycShoNgjabVsjWgY7CpbWcwGbT4smF2BcU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxos_Bcmvsev83yfTv6u86htGLmOj7caAxOtA5xt5N4SA&oe=69BD382D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wB9ReKAj3LYQ7kNvwG6NV7b&_nc_oc=Admmk-p7O9i3Eq33kl-WQkIvrXV8HSDLhzxExdvgDZo8Xx-eWkBTCiBSe21RAcZR34U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOO8ORo7wb1mtH1qiPwl9qdqp-ozy_IfmQe1MHTJZCdw&oe=69BD59B5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_MYYN8d0_wQ7kNvwHnvg6n&_nc_oc=AdloUbP9P1xcxY8nH7ViijGAMFeHJNy-yvmJAwHDGd1Zcj0DLHasF_VsGr5ZibCQfRI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwi6iOPcJ_H30b7hrVuHUDf6fp1uC9BJMIyKYaSS1yvoQ&oe=69BD429D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlVel2QUDLAQ7kNvwG-0D7U&_nc_oc=AdkrZyX78f5BSeOeKL3qhMb_RRJszE0BF7--G2QlqDdYjHDjY09EUcVkRlr_SM1D6N4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx_dEK5NqLWVSQX4NnWD6z5gwxmzNp9truyqlU_QD2erg&oe=69BD4F61"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allo
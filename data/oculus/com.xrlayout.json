810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMf5ficIaJ0Q7kNvwH-kmtB&_nc_oc=AdqB_pcorQIeIi5FsmbrdA1AWd6znRp5C5-L5Z4evauBmTk1KLErb737AiTS4Nc7K08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MtNbU7j_-T1fNRDxklONJjqIlfs6aGDEdaQcxCZyqwg&oe=6A2EAA80"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1tWcSc0msMQ7kNvwE9hNjb&_nc_oc=AdoUGb2eq1x3sHRNfgv59cHciid9L7gqkjqcbq8W1QwEThjq7HfmbJik_1u1Kd9Ijuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s6oekLKJZ6XtbToaHSvLDex8Uzep_Mp6tXphyjcpmAA&oe=6A2ED16D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vzg6QRduTgQ7kNvwF20T75&_nc_oc=AdobfaInTWxG5ohjZ-1xnn4_K8Vz2rKpT1NPqxsJTwqf1TuIEiMtMvtVcYn_g1yeWXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HFb_i_LsrLWQCvJpFDJEFvOV3NADJ8ItzEFjOGLcGUg&oe=6A2EBAB5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_lYmYTl_80Q7kNvwE_arcj&_nc_oc=AdqC4k3RyX854d-9258P-KfIlgxCxuCja2XgYmfPuAhesPUjSOzoOP2n19T-3gwbqJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H0Z-kH7ivKUEH4xBvK8iIBCZM7vWno6LUf6D4IqzU9g&oe=6A2EA39D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK0w6LhDH_cQ7kNvwGqHdaC&_nc_oc=AdpDDTuf4MWIjwWs65IpmPUrXUNxUFxjTKEW6jyK5SZNp9EaBOY-vGXgB4RFKo_ystk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8f4NNFs-q71YcyazsNtzp_Sjjm7NASrDHGb2FbkoOQMA&oe=6A2EB061"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
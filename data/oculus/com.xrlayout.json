810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1sA8-WTFLUQ7kNvwGPjDmc&_nc_oc=AdoTqJAbj-AWhRDtO-lewjGr99j2qqAe288loaN0RhtRM0xHbKmwlq3WX_oqtk7CDXk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CfD05gJE5kAA0FRlqOiOmNYRFUYKFKgWnuHUoWln18g&oe=6A09C080"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnTGk5i9zjoQ7kNvwGk8n4F&_nc_oc=Adqtzlq_Rggqi3B4Kbvk3BOFPFF5xD5EB39Vb3dGLgVP9eUe4jhJ11DDrV-eMM0-VpE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cA7D1ahvBX6g4iZ4KZYSrggmp2laQtcz-zUdf9PQmGw&oe=6A09AF2D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAASL9hg-_QQ7kNvwGeWt66&_nc_oc=AdqItl1tbJUQbqFQ31a5oeIEEmNDNbRyfe_ibNXW1alsL9fsupn-fOGMmP34JeULofY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49aQ5PWMPIv0Rg_vH8mgwwX2hIht0ZlwYwBclUMIIPgQ&oe=6A09D0B5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kzsndOYa28Q7kNvwEDw9uM&_nc_oc=AdpjulAb6QrY_z0f1XtlSOyQmEhVBW7ATNOCV7gRZzU2l0zqDpYI8Ukbi08DLFM7D4E&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UXm39dIki5dhFgdW4wZw2h3udRN6-fUKnAAeQZm2i6w&oe=6A09B99D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJIecS06fGsQ7kNvwGGUZlV&_nc_oc=Adrl4xGEeq2-GmMbEf47QMiGJDitVTct86IJ60bltGaYVNlGWHgjx9M2uN_NEaGBCQ8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7V5ZcTrri4nR2qdLUrBgw8IhPBkB-3IzFY6PRnhIWQ4w&oe=6A09C661"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KB5pTcJIsEgQ7kNvwEImWF1&_nc_oc=AdoHNcQoUI7VPnK9ZCd5kxamszfhRrWjKdJBF-5W_NRjc2G-idnkvdVIdVXc-HMxTYI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cEpnsLLDdyBeQaSgNBXnWvAPueHWGcKBJoZNZ3zNjkQ&oe=69D65600"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKswkLytZjkQ7kNvwFzRRGC&_nc_oc=Adp_BNhhno5YMuD1l83obcR-4bzkkDYcEofuE4e7Ja7W1iFsx9cEdCF522hbgX6SQ_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DcASmosbdgynebMLEEtuCmn-w5pIKAh3s1XkJ-ETQ6A&oe=69D644AD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfFC9n7MY_UQ7kNvwGVDHK7&_nc_oc=AdpXZ2x-48rFmpEX-L6XlUHDbQTPqWk2FFAVY0HVtmYDxxw7-rllKmQFKEe3AXpnu-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ynFYp9kmfjCzYcfFo4H7wpI80_yQPpGSbpdhKGeecFw&oe=69D66635"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFuIWkklJwAQ7kNvwHXP85Y&_nc_oc=Adoy66dxArscuIIpfgXHeBvE3W0kZNNcJXlBvF5Ekos4yQTBLsl9JhtMC1egNBDdKzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SGnSujIH7S2JFnSNs9-tvE_AFAqAXq3Pj3U2Xcl0uFQ&oe=69D64F1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvP9BGMIHMoQ7kNvwFCfyrH&_nc_oc=AdoTDL84TAkr5u6ett0azwg2bhHF07KoRFq-sCX5MqI3tVYF3ENqhpxMZZwgOv0QAOw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Om9PmcGMx2KbRRbA21kITt8f7On8sYU8J0xXvzLojXA&oe=69D65BE1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
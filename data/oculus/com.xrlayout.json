810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KB5pTcJIsEgQ7kNvwFb8529&_nc_oc=AdoMpxUXstl7A828PO02E9uwCVXn9z1nruFaDW0EPZPwyO-G0gjwxbqfX2XCdNoGlvY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22apehipfLDJUt5sD-dFcbahiTl7mxqAr2T2A9hwybMA&oe=69D7A780"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKswkLytZjkQ7kNvwEC3p6S&_nc_oc=AdrdjIY1gOdisrF4Jl_rNJJS5ZaLb1jxK1n1mCDk3LI1vQKHomXCrMW3jzPO-NDTncE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21Fom0pjEfDU7OZp3VAyeosRF6vvCgpySMQIo8jKjPuw&oe=69D7962D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfFC9n7MY_UQ7kNvwFo4rTM&_nc_oc=AdpsJBon728jnsadXrVY9d0gKVoAqbCCB3sm580GPVBroarVeureIMYe7HgMmrEP1HA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q0Rp16Yuyfm6GSM8Ze7elt5TRmRSLv0htPjedN0eZdA&oe=69D7B7B5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFuIWkklJwAQ7kNvwGHhs3a&_nc_oc=AdrEsVnEf-dj7_TfrDFyRq-CtC1chvjWb0n5NSHI_IYD8A8yA8itErNDQYDWvScf704&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mQoMB3-hMrkPQUDXTtHe9aNq5oU0XneNS4MPB2irYHQ&oe=69D7A09D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xINfkF9KSE8Q7kNvwGqhtaO&_nc_oc=AdoPf94oqwCIEm4Wj11i9DWbrI_QmR2MWN9nnkLgxKfkCzr9QqVR3Q-da6L8zLYil7Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kRamyoURY3Ht8yU63P0VY2qrwg-KGmiSB2uFTS886RQ&oe=69D7AD61"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
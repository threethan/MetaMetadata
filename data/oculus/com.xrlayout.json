png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sudwi68ciEwQ7kNvwFO_7Yt&_nc_oc=AdmIZakFlCvNd6SaZatPZG46KFdat-O0V8-dLQz7KnnCoxE7I52i2yqM5E8HMJBsQ38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiEUsUgsWDtO6wyXheZ6vWF2rt0eAb0UvCqEGoceyNxQ&oe=69B6B200"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bgQjvXaaPoQ7kNvwGEEmWE&_nc_oc=AdlhF2YVOD3caR_KCR3uJF_fydT__6lMSWxdWlv5JP45wdtTUJmzL22phELedHs0gnQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWysNPJpkhhpdsa-dlIv_m4R4Dl14eaN5qP_l4pHGqNA&oe=69B6A0AD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpxX53WMYj8Q7kNvwHwJnYz&_nc_oc=AdkEdjZ3NrwkscD45iKRoCILh8oVe5L8lmmchD1fc094lKoAe_pB50Qccb_J-AHOKZE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFlNi5H6h1mvoz4xicWSGmStGz5fPd0hNX6-_BI37psg&oe=69B6C235"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BMSHJQ8eGUQ7kNvwHAvsdZ&_nc_oc=Adn_iAuZLTTYPqnQPN0SZluuCS0cB00ymLyx7GQJiiZWtmaHgB5rndKW49Bw11mx1C0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfylZvnMTM9755_J72qRsWDVAmyfNijzIlMSFtUlykNCYg&oe=69B6AB1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9ezT_vXQAYQ7kNvwEF14H_&_nc_oc=AdnKtwFp5LJ3UD5kCDHumyyrnyCKwOpvp7dQ1w5Ptnll6J5vpOBIWgoEeeJPzm75E-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOh53ZOFsnY2xKduweuecBe0ctmF23-K1Fu1a4700YSg&oe=69B6B7E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allo
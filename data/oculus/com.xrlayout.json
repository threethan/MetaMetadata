810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJoK-9a2KNYQ7kNvwEebOwZ&_nc_oc=AdrSSg6cUkfOH0vE9-2drsK4dX4fNJdRZIqDvJexfHSwYkrdNorEW5IKwaRUXtdV-u4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR09lrDG1AISWEGer1lA-MYJ6UUmuGZ3lejqUoE5KG9Ng&oe=6AE9DF80"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7NxK_BWOo8Q7kNvwE0InYH&_nc_oc=Adp4AmuYO6mhl7Dqgwvo3LxdCajhsQ8pguQO0uIedLkKjilFfB_4Ss9iA79EvTjsABA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU20kSWa1L0XmOHlghrBM7WaYWPv3285-pb_R36W4A1w&oe=6AEA066D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2p1sbBQTikQ7kNvwGdQout&_nc_oc=AdrbJDATl40fs1bz6JbS2N7dlAGf0tblQYwwrpIxLOSbVk6Ccc61yA0kKLFfmWEw7Ao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9h_LiEUhRGC8ehfPnwA6pJGIMunIZcMx3-LCiNL4roA&oe=6AE9EFB5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIVMc6G5GXIQ7kNvwGoStnP&_nc_oc=AdpNWDG2nrhGtBspfkZwELryeAbDyPAPNXqbHdVCzODNnCfPzubSVKQdLhAgQDMG6Jo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5KPpyvwQtvbzIQVlyWqaaZ_WX2WrO12U37pI5u6m5Gw&oe=6AEA10DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mgh8x-jqi0Q7kNvwGxzRff&_nc_oc=AdqF6h9I7k4c9DOmvLn_HBsT9eaSsK_5JTbOj4aoe5ttfEkHg4r5CBIywPPRXz3q2Lc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8qlIfsf3osnX-uo0Oqf1MxXbh-Ra0ZsOPsxeu1SMQDQ&oe=6AE9E561"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
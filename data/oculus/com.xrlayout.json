810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H1Gh6CB8RYQ7kNvwGBMyWO&_nc_oc=AdqW8wY3nhLzIxuiX0g4S40DV9gKSWLYdWTfQFxh1NdFZlpOt4AA4WcFa4hJ5KqKHZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNRoO727QxDTQaPdskkIZDj9pb5tWIVIkMjtvoH4Rtrw&oe=6A985AC0"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjACKUSbqhUQ7kNvwH9qM5r&_nc_oc=AdpBB6mc4Os9IQT0BSo09p2AlgXWWmvHb4Jj3-Yn1mrQx6i0qin-VWosv9-povdIoL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI-oLf1BQVeHSLnF_xhrKGgtxKCrUxQJF9oGf-ZTd_nQ&oe=6A98496D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2IShii-iOUQ7kNvwHaNnjM&_nc_oc=Adpw_kdHlLBuc4Y8hlh0WR_FjeLSRxK9W7zLbMXbdtUKAijwz6JuojonHuEvO4lmi4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIug8nb7IeUxsyiPdhSa7q50gPXuRnv21eHeyXKGshwug&oe=6A986AF5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQfZdvC7WPQQ7kNvwGi8mnN&_nc_oc=AdpVga0rgNcE0RZLIlQ0ftOCRGLYEFNXk2fmQHGBew0LejJ_YT6VUT3Q6urk0nsIotk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWp8fzM8FdUY4nIGiKKAHIO3N0tOdU9gmJAJVIO-oztg&oe=6A9853DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iym3nXQPnpcQ7kNvwGMTR5O&_nc_oc=AdrRoZpl518-KzT2OAxKAHKykjlBBsQX_inPUZ7RAPkJPmwSt2sapsU0mVS5UtZ3vDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjuEMFmYCDzzKgK1p84OoT7bbFt5QkguYWV4EXc6zYxw&oe=6A9860A1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
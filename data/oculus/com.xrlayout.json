810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ss7Jn6k0oWAQ7kNvwF4xprF&_nc_oc=Adp3L2HZ6zgbdB5i3LVgBnn8-6pNI1NwtkSRC9Tqsshoud-4D2DS46du20v58j1wyfg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCraCp05R2MWECIWoW5qvz_CO1jcmbj3BlnWNsNMreT-Q&oe=6A524300"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MRqmyfjPVoQ7kNvwEH49sr&_nc_oc=AdrcwAIeQWaYv3dtWE5-8FKvmGyBWkEQjIpWN_JlEsMQcc2YP36U03fVlFJy_wCr2Jo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT9ZbDJXX7y42WFkK4VGeDsEqMk45rpvgLrLL7l3oayA&oe=6A5231AD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGBmF7pdHPEQ7kNvwHoP6mi&_nc_oc=AdpHD2GSe5zuIT_h1gb33HlZYLursYU_yrfRsZ4UW99Byw4ty2bTfNBDMyh2ex_U5n0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsm33ClZnEqNNC2_1BW-TRMO78OQ_-cLSAaQrDZHWDwQ&oe=6A525335"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve1FvzKLFvgQ7kNvwFKVfY8&_nc_oc=AdpAmEX1QwWJhjy3uUjpr1c-9r67UZGCQ3s6lLWnzX_ngbfAzXlAFG9IlQVtvv3CQyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVqH_hDOrxVrvCXebZDG8l4xDKepmS2EWZRGQZpfiXCw&oe=6A523C1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GalainYgneMQ7kNvwFeRSTX&_nc_oc=AdobAONliBuzF8O5xMyuyEVq9_Sz-r-w4J36WPDjukWcxOhqvuUzhFjrTyhZRJWhJNA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBykde4XDbvc9wikEhlpyqbHQ-FT43w1fF8vOd3HyBFJA&oe=6A5248E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\"."}, {"images": {"nodes": [{"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1700921013769246", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575360_1700921017102579_5965761788146700936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmNWNYFKngkQ7kNvwEORBHY&_nc_oc=AdqnuXNHpEVzIBFvDAK3QHKJORsmGL34AJ1zu3W5rBWkgk2UXx9_QF4z3YLupDRwTTs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgcJvY1KgUSHoF8FeUf3yvyaIoGEH3QZUbT6eMFGiNzw&oe=6A5233ED"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_3000x900px.png", "id": "1109468820180572", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031429_1109468823513905_91045592395151573_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3WGUAZB69sQ7kNvwHy8DnX&_nc_oc=Adqjpv8ARcyXeKKSoAtYzrstwRHO-Q3IP3AnBuKXcJ4KmSX7NOtY2FOm00_jKFEph-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1myQkPlrYJ1YfCG7TvXQPmZlwtEWCwxYDTZAY0jomPQ&oe=6A523631"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "741753654793576", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488373_741753658126909_1339597984623439031_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zP_RqEkSwkQ7kNvwFLd_Tf&_nc_oc=AdpLrRfj1uZB_EEfp9fHEUk1gLThtJR82YBntHh7IXJ7k_vx9_wZ20ze6h-RurPbRgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIAT_P3QV3nHz4ZBS9dUka79qW_cy_A2XK19KVHSjYzQ&oe=6A5249BA"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1440x1440px.png", "id": "435753252347472", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75367598_435753255680805_45484
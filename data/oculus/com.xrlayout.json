810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fqx8KVnltfMQ7kNvwHkFSjb&_nc_oc=Ado6rE_0UisamHKIVX90scS-76DSMUTXyLnx6fwM1TGlyvqUN2bl3NRd_5RA_BRLwwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCrtqe2ue_ZvBW3uXMJFYXBo3wiHkaWit80BydN413vA&oe=6AEF5DC0"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGkesT27x_EQ7kNvwHVlPKC&_nc_oc=AdpHPmDO5jD9uUun2vHHJynbwCJtX6WUjN9SOa1SywW-qwfxWR439Pystb1zsP5e9KM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxoqYBy0Z9cqlUZpDmuvNvvvdOgCubCK8CSlHbxqzh7A&oe=6AEF4C6D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3twczktRrcUQ7kNvwEBJy9-&_nc_oc=AdoSC44da1aAoEyvK0oSOkF755gzwz2iHYLf0OtYgCXlUKkG8Ay1MwLBe6YTY-Ow_N0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4FF_4RFWmk8CpOc64-j6jFsWyynOxJXxkHLOAPxdssw&oe=6AEF35B5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFGJq0tXW7oQ7kNvwHC_qaN&_nc_oc=Ado_VpuOc0TPfRcTK0OiZFTMy8dB3ajPccf8sssPF0DgcPuF-xlSEZ0FgHUckP4UXMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsDDy2guNQvCoxgMy5XKDZBL6RAo-uOO9w6XMpgqkLeg&oe=6AEF56DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfAhYe2KI90Q7kNvwF6d7nl&_nc_oc=Adqa4_CTVCLkx4HLbHtAloU8Fw1rMfVB2IdFd1X-GXHEWmNHUr1TQEFH06bIkrpSABk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzWTj-7F8w5P3pG9IrHkq0zY1qkTZxleTKStbv3-2cHQ&oe=6AEF63A1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\"."}, {"images": {"nodes": [{"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1700921013769246", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575360_1700921017102579_5965761788146700936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0ycigeiBy0Q7kNvwFBVS1r&_nc_oc=Adr4BSjagJed_DOacQelQyrtoDt7xAr7sHreAmJ3eLGjArpdF1J5nB0QJNF2hPn-akY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6JCFtOgDnex1QSgC2_zNxKFfxdF3UeKoONJbONifT3w&oe=6AEF4EAD"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_3000x900px.png", "id": "1109468820180572", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031429_1109468823513905_91045592395151573_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60JFfdq9wzkQ7kNvwFg9drr&_nc_oc=AdoJrd4qxsiyHZgyxkiyYN7mUxkbMQ7x-DYKIGFIMcb1v9KYnkjBawpCX2hEKTXKYRo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1spf_X4rThqeJuZiQLlo8MMwUjSM06P60uedNezn1RQ&oe=6AEF50F1"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "741753654793576", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488373_741753658126909_1339597984623439031_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dX-75BlIiCYQ7kNvwEIfFK4&_nc_oc=Adrb9riS0U50Y3muzdSoVvlyOXBeuktTu0LnvrK2Z_LSjarQHxRsQLxrVXvnlIxImek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0YSC7iMDTuwT_tJkMb-ndjEXy4OjFo1Ur00RGglP7ZA&oe=6AEF647A"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1440x1440px.png", "id": "435753252347472", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75367598_435753255680805_45484
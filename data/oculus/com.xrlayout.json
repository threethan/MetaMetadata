nc_oc=AdmlbZCqXX2U2bz8CEtPIkuUyVY_K3jTsIEoZNFlaIeyMmk2K74pwwYkm8GuQqkPr-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv44ZQXLJ1i4gjRbOKBWr9ZWGeSGaePieaFEnkj-rJ-5A&oe=69A2EB80"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11OgUlINfVEQ7kNvwH6C4Pc&_nc_oc=Admh7iCDpSso-N7jGaIw1JDG8sp7OX3R987fuqUhpTIVjP9PfMRPFXdC1hZxEECgB4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsfJWEyatKaGrnC_QeIPTCZ3NeF_fLbCXoBbTNXCSzt2w&oe=69A2DA2D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ae4g1uC8cOYQ7kNvwEb-ffM&_nc_oc=Admfl2qvlT52qEt7VSeIrsdaK1YZyijyrUw-tEYnvrqERZHmMM5FepoAHx04ZMLcYGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_FCEXteJu8BXo2e60BbMB4hWwTAd65rVunipPSpcmDA&oe=69A2FBB5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKm9pfcIpUoQ7kNvwEuaPot&_nc_oc=AdnBrLmKm0GFarr08ifemWt6Ju3bX_b0rhsrrwQrbOUUDjR-3Te0XaqKhIaB4RRc2eM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft5Czjlhs7nRSFx44RAeBqXqfyvt3MjbCGJtyMFjaVX7A&oe=69A2E49D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atMdeRGHjNQQ7kNvwEq7AKZ&_nc_oc=AdkTUFQX1LjDKPIaMDJOSWbfz99zg9zKDNV2dQ3m0VOWBDdWWUK9ockQRuu-dJKnKso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuhgk7Xt4xf9X8EZoYqiG9rO-dtQpeX_HOHKMYpmsS2sA&oe=69A2F161"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imagi
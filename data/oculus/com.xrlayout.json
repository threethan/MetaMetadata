810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1sA8-WTFLUQ7kNvwEcK5IJ&_nc_oc=AdodB5i_T32eUpT0abQ04yidYgYRqWkuiFjrb-1NF4_WGt99W0jiO6VI4qooRZfoN8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-wDuflVFNlhY9XL5nID39Jushoc6HiqKCJ37d_d0ngg&oe=6A0B1200"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnTGk5i9zjoQ7kNvwHr7CUi&_nc_oc=AdoDCo4GqzSQf9XpoiV2Ul4kETbVqji7zBN7IoS3MAYioctHnMnZBbMaAj7gxI3fXAs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ED7rWrV4l1yzIlEWX_Ibav7hzIKErTv-pQlm6qH-N-A&oe=6A0B00AD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAASL9hg-_QQ7kNvwEsn_OF&_nc_oc=Adp7rXhRGR8fMX1mWmzE9k30D2TYYWskP8xabv-BjT5Hnmgx2kk1lSV_oONAiMpO5xc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hiQGuZb3fJc92OEyz1D0qwcJ-TB8phkIF86FjyvfDmQ&oe=6A0B2235"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kzsndOYa28Q7kNvwFf9Niv&_nc_oc=AdoDWU1UNn1u_qrZ0HPrmurRSD1qc2fFgAR6CpM9-yaBNku6KLZAYvOr9ytTFzGdGsg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DhMbJlBBKYeN5L85m7Tli1qVVs9T8obR6uHyzF0Y7gQ&oe=6A0B0B1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJIecS06fGsQ7kNvwGjBWb2&_nc_oc=Adorr84UWtgI9mqsnQvXrT7zsXHIw6AtzHx0EdkSVfKmTboq6orHpk3p4jSq5Fmb4Mk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-UGy_ekZ1lD0e_HyzLxmKCU7Brtg4GLjPzgIpzvXDiQ&oe=6A0B17E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
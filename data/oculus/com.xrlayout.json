810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHs-FoRyM_0Q7kNvwF-KH7T&_nc_oc=AdoJG7St7av6VNLIx3BaNGjsX3wtS4Tgs81reHVtAmZKqIPKlQxMbdUF9j_R1kkNOsM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8Btc7JFIAJMsTAacavnW10QoJAoxCdRbpMLDhtZ6pNA&oe=6A92DC80"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awP-Llu6SyQQ7kNvwE2UaI9&_nc_oc=AdrP_XL3kUxrW9-HfctICjw0sczWm6nibRZG1MuN8v77AwPye3i6yXKYw_emhs08eUo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN4pNcun0-MYUaqTN6eAmZ4OatljgPeXhrS5RatIzjsg&oe=6A92CB2D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkOtp3QglMIQ7kNvwHRRsTA&_nc_oc=AdqZh6SAaklrAeYkfQyvlUgXY9xDSqmZd-oitCQMx0DPc6jPKFiDkUz3zynkiLwrw08&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaEfYlhoHP-xD0Syx0LyIhLQEJaq_7clbW5gTFQzx4Fw&oe=6A92B475"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PRRsLMzxCkQ7kNvwEFSgei&_nc_oc=AdrUMa1XMXEwL1wqHFDgtipYnc74Kb1zCB-TMhGrxP2ncGEZH_wHBqdSEWMv0myyLmU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGxuwsrJGd_YPyTe50j6mlkLadnumRV0oY1Yor_UWzMw&oe=6A92D59D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZI4w6172EIEQ7kNvwGJWvJ6&_nc_oc=AdrokMnTsd4RWVIFbxH8284E17EhNC44sX6Kji09A4JraNX2ldN-UKJhk9w-t7075HY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfWVfXwPboi-SE_CwqaGqQiWVKPv2GxBbdM4etJQPPoQ&oe=6A92AA21"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVZI92Yj91gQ7kNvwE4WsuH&_nc_oc=Adpu-W-w_Z1OK5FonuXvrbalFAw_S5Uiiynp5yT81fHwZDx9ueWn6dVsHtZuNxUE4qg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QtnL2Ywa5TC-CAeIssFyegvVBdvc-IXCLp5pebdeAmg&oe=6A3E7C80"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmH9hBEX9jUQ7kNvwHv_g3-&_nc_oc=Adrb-eVzlKc5sHLPnsD7gDQhfD5zlzA2EEEi2Rcsgl9snSWHyL5irHL0ETM_kmRA8AI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j-qVfh5l4RRDWMln75HmoLt6KcnIUetfKkHa-6inncg&oe=6A3EA36D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2wj1HWOijYQ7kNvwG78Uzm&_nc_oc=AdrFjy-irfwozTialh-SCFgtZi52p6tsNi3DfJDVSSPBd6rHw6ZmMZTtXfolB54qzyw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pq6AFW7qKoRv-nQ0_pjCfvyP6QBtuPBebxTLOkiPQqg&oe=6A3E8CB5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq5WoxlGCdgQ7kNvwGbtsGC&_nc_oc=AdqSOkiXSQoCte-EjrYUrmw5pHJe6QlwCelkrpg9LQB0xSkazeSkV8eu5DowhybJQJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_REPqKWydnYzEfvKMl_4lYFm-p_sm0BPp14yEWR6u08g&oe=6A3EADDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I97x8K2rMyIQ7kNvwFGxnhW&_nc_oc=AdrYZosCLPc-gRpSenrrz8qVaKh91UjyiAjQlFVNHXipo3gEtJYoFpZlJXvDRkzKjgk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4MKK9qxIgIO_rofvsvRo6JBiV06urVhxmr3eRyePQYA&oe=6A3E8261"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwlCdrArxhsQ7kNvwFSWvU3&_nc_oc=Adrj7nOY7CamgTWVTMI3BI3_hVVFhDPWTQCTC0TLaQ6357_CQTzeSQ_d57sg-G4fXPM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCYfcOOsiZZFxoPfY1QxYrYecyYvnMOs1ddryLeZThng&oe=69CE6D00"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3FmKOu3Lf4Q7kNvwHZ9Yxe&_nc_oc=Adr391TOS36rFEl9brQiaDnIIbkrMQO1t5QfNR3PygsUgtyNIPleDuxhliz7LlSLvWI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPCmOwM_Ln3Q_808Uz6WdbJcxD7ejM_jf0S-MPpnc-eQ&oe=69CE5BAD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCP_-iDSbwAQ7kNvwGjW2Kl&_nc_oc=AdoA8DjiYKynmyexBKpUD5puIBvsKuYTYxHVD3Atki_KvFOY7U8B9Ndjo-eN2jGGc_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxz76hb2GRpltlW6qwiVUupWWKJJBe3OoUrz2qBY_lSIA&oe=69CE7D35"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5mIRwqkQBAQ7kNvwFfJQJc&_nc_oc=AdoK9Z5Pxi4I2hZoopA8QKTT_lUqP90erqJ9tpHQo6ghHl9j9rOLKaFMfIBZZJD9gNM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyIpZJQY9q3uAV6n688Q4ZVn9chV74yWIEe30Nu3AzNA&oe=69CE661D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iTorxkXRLMQ7kNvwEt4hQ9&_nc_oc=AdrmHfFKIkOIhoE_HeaueDtFbtrbGJQExiqMJnY5dYLWODq0rl2yKAt8VWj-Jq6r5Hw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKE16Cu3SajufV9fs0CjOy-cWUfsNxIFYICfTf4LHRxg&oe=69CE72E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\"."}, {"images": {"nodes": [{"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1700921013769246", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575360_1700921017102579_5965761788146700936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZ5M5y9ZzzMQ7kNvwEqEe64&_nc_oc=Adp24offcZYjR-CaWbrEFpQSE4smR6HBHlo5RZae5jLCKBq-Cg75n2MwQlh_Dl3q3OU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzurkTPYr55eP33DF2KcKJaIMRFMPddsgUZUIc81q_LOg&oe=69CE5DED"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_3000x900px.png", "id": "1109468820180572", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031429_1109468823513905_91045592395151573_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nMm8d5zMjsQ7kNvwHRLKhx&_nc_oc=AdqoarZIWHCRJw1CWf1R4aUl5EcscYxyxu0kvV9BXOrPssp3nmIJ2zMcGwBQ7Ts3Jvo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzU-YtPqxcgsv74hUKdtaAAqaD_igDNAMadegYGUD0_SQ&oe=69CE6031"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1080x360px.png", "id": "741753654793576", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75488373_741753658126909_1339597984623439031_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-k6Noiggt18Q7kNvwG3NDha&_nc_oc=AdrbdewYRbwJybpbLOp460Hz4qvhRC0e_Fo44Cn1ggjX3kUeIamp5WEr4m9em7Hca2w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_2MHm0v9HSHfyR_RjfnYaj4ZhwCvJb3dkK820c8YvvA&oe=69CE73BA"}, {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1440x1440px.png", "id": "435753252347472", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75367598_435753255680805_45484
810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BY0Q9_lkhHsQ7kNvwF4uZQM&_nc_oc=Ado9Hkbv-5PP4K9U3nEHcyYbvl7wGUPoeRXVRx2SOgdT13CDrJhKDwMl9AbHaoXbciE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Y-0mlEumrFhoAkeXEOKax_Ncssu0NWhgsIFZVCVvoBg&oe=69D3B300"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlBAkNEBEVoQ7kNvwH4uq73&_nc_oc=AdrAvVZa1q3LUQJOWD-DizTe8AYRvzSNjV3CN-2BTrvFx9abvjv-KeLMSeJzXULfk4Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LDFvoxhACGJ69zw0jLT_Rug2MxwhFLzfvuDAK6Am1Dg&oe=69D3A1AD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaercHr-rHwQ7kNvwFBKZAl&_nc_oc=Adp4N-LBQFom6ESK5NY7Ra3HCHMZ_XWMsyT_M8ZLgh2IWatCflySFeTeDhptntWFN5E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wWaxP0aySO-q26-mqhCzlVilhUVMAhorvn2YX8S5sZg&oe=69D3C335"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9sKfyqu-IAQ7kNvwHtCefW&_nc_oc=AdqOjuJRCksz-ba1g_wmRTH5SZne3QsitosvvEKc500UtULmIjya_SPW_ZjMVaWg3tE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pgpXuGZBktk7pHlog3QETb94I-9L4d2sLX9-Xc8ue9Q&oe=69D3AC1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvP9BGMIHMoQ7kNvwFPyQee&_nc_oc=AdqMXHhZio6wJUnZMxB7E6S3pPzNJyoqp43f67M9IPNdUqx2yMU2DAFUWdG0pgp_3iw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VvHmbaUYJ5D36_yRtj873_ojtkl9gQHxDBe2hIPZATA&oe=69D3B8E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
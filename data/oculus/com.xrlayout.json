810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMkAZDaX0FgQ7kNvwEcYWKq&_nc_oc=AdoRMLah-b02widaJNNmZRlE5TwZYGF3E919Jkp4OloNz11I1OjG4gjy9RAuSn5_k_U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGjfyBw98K0G4LJhJW4igAa5skZxGVY8xqkzW_x8D9Sw&oe=6A563780"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrfK0Qe0OfIQ7kNvwFunHCl&_nc_oc=AdrAkOW_nXPB0jtdamFan2rYGhOfQtTPGbXY1y30ATohwgEZeEts0KMq0mg2bw_VXPg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCBg592cplz3ILSWAc1-NSUEwxirbHUfPnyLtiivfG5Q&oe=6A56262D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0h8BQVqU-DUQ7kNvwEABO8W&_nc_oc=AdrxLqERERrRjB5O7OZTj7Pelc6wfh29e67IHhMK49NZP6_DKugC8LyqqVd-cO6Tyi0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDktnl1XXLAK8WY7OYbkPXzJjZ1UNfaSUkfMTfxttasbw&oe=6A5647B5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0OTgiD2N9gQ7kNvwFNrPxK&_nc_oc=AdqipwurONqup-AsWDv2237zAz7Uq-gfsIJ348Wym06dEwKtOacSsWAVtYx7aI3CISE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBBwnR12UsKnJvefU6wzOKFGuyuN2674rkoOnhe2mVDQ&oe=6A56309D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adLRP7KlMyYQ7kNvwGM-VDv&_nc_oc=AdoO4zHbjpVjzNphyCFl4mGUjoQgDJs7unAjHZXdY99kFV8mteej_gvhX0NS1ZOahKs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe7_dPtQrbs8GbwEqHVwH5vMorgP0jxTK_VYJehsXuOQ&oe=6A563D61"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
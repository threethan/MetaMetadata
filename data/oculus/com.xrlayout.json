810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oemBXQzv8mEQ7kNvwE9MF5V&_nc_oc=AdoklhWoQ2E1NEV5FgIIVKdIkKN3y5dU-T2IJQTVA7tE7MTbn8WqzWqyKVJtPaKe5Jw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Gi0RM23oK9QZzGI_sCeDpuxXVXTTLopKelrCb2XO9UQ&oe=6A184100"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slSKzT3XZykQ7kNvwFwaFjD&_nc_oc=AdrSbnbhmQvbO19j5thlY08PILts8rrXNXmZ37b-Od98yiawqArfqoSHQITz2izzF9k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TgxacCJklKPUKIXmch10fl3Fpfvjn0IqCJQdq0yV2QA&oe=6A1867ED"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nliBIHQKG4YQ7kNvwFa0YiP&_nc_oc=AdqXtz6W_rJa83Ia9xeC5ACLVk5MMXLTPXDut9jiEXsg0FYtHH97qyjauq63cZ0iRhA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41Jnp0DNooet85ei4a7Gyh_UdayGMHrLu8ha_zPYKAWQ&oe=6A185135"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCV12sIA0gYQ7kNvwGgfJpe&_nc_oc=AdqZ0OKfGlO71DloOS-RLt-04_XJqOIIpyTW5qdpQpxGjtuMkxUr6KvrxtMg1ud6pJ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EtcjQFWO0j6040gswQ8ylHlOccNmmd915PM820rlEuw&oe=6A183A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyxknGlPBTcQ7kNvwGVdODZ&_nc_oc=AdqQ0CpgRm3I06qutMU9uSTIhOzyxX_g1GH-tjsNj4Lr2dVAmf-Jt8UGpsMifaG4xtA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5td12-QsGWHcuyNVXiRWSMOXWuTBY7cSDfr-zih-VCDg&oe=6A1846E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
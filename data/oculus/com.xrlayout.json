810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elOyL44BkKMQ7kNvwGQJP9S&_nc_oc=AdoiB3tXb7dWWtAebIX449CAxr6kEhdr12oMU3ctdGN6KcYpMhQKtNB6A_S6XnEHbKo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bWdAmvU0AELXncQW9yFn-X8-zv5PIXghM6GTIZZ_sCA&oe=69EF6280"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ut3ZetxB99cQ7kNvwFPUSU5&_nc_oc=Adp5q7GdT4F711DQSVsahG6vtboG_CKi_IJo3KkJgZYXltDq70S6ZqiI1lxYgBKN4vE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af326RZXQcO6VOFM51dm_dOwhqZHgUreycJDSpH97U0oEg&oe=69EF512D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJj4oZhv7pEQ7kNvwG445X7&_nc_oc=AdouRuuRgSwqacodUds6BZuA_rA0U9Cuv8Oj8brHW4J5CSeGUzCNI6_fpM8IRC_ysBA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NDf66GuztJuxV4mwJCmfSdDdaKaWWz6ZUCBROPvcz5A&oe=69EF72B5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9N4i7FDCQgQ7kNvwH8olws&_nc_oc=Adqq9lY5pcxCNRNbdahaPqz1pGINm73ZuC7urTK3zV_rq2UsNu81KqrWDlVVNNQEmlU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OvmB3mZE_XuEf7gcCeteronmT1hjXMc99DoePFS1euw&oe=69EF5B9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEDLslfxiCIQ7kNvwEodva5&_nc_oc=AdqBGlHEP9edNsYNe97hgcp4NETG2ifn6mAmW79GO_N0ibkosjEyRmfGWO_NcUb8DBg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31KPcJwgamxV559kPpRzlJ_8NCUUX83t0dnpZ8DUo16w&oe=69EF6861"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
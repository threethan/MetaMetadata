nc_oc=Adkow-Du_X8aMiuZORUxF9WdLd2VlSqIIFeh8cWjN6GbVZUvKlg_mWzE9epuyMRUtM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuLdKawwlmoft5tJsSVm9J5G6iy2Hv6_VFIJO1dYICFmA&oe=699B0280"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qXIn2NNWR8Q7kNvwEjS51i&_nc_oc=AdkNL36gPhTCsmQHb94tRykCdn7XUdLHs_GrILchqby4bCIVIUxcdK393F33nE6-pIE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftdNqkZXs1Oq03u1uLy1Bw9BWKp39DCuPGgubyYGxHTqQ&oe=699AF12D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ji357t0hvmcQ7kNvwFdZOHG&_nc_oc=AdmkPWu1V_lWI01rFrBUBZAhVEFGFcBmtWQ7pZD2bFRz9YPG61NPtSV_6qsc9YTH5k0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfulLoTUK_sqvmF7YyG4UAMFMj9RlVAonxS1uQa1teczfQ&oe=699B12B5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iovfd1lNn6AQ7kNvwG_VY2T&_nc_oc=AdkgCCDa-oMuR5ZfKirvaiggXsFr3w5713rRaWvnfyBvSbK4HOnKonGbuPeFdKdNE8k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfttibswmBG2iMHoT_jP0bPSK4OmK1ywpIrvLYMef6YjNA&oe=699AFB9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjfvMzQs3xMQ7kNvwFCmgnQ&_nc_oc=AdlFoxj2l37QzndBXSjAZ2GyfIgkKPvlusIXDffYM7MAeOEVeKrGdFnliwvqwE1xitY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvXVpXQQiDmGZsbzsJMZa42U_zDD7ePr-DCEbMUzTTeIA&oe=699B0861"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imagi
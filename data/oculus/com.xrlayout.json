gQjvXaaPoQ7kNvwFKjFbW&_nc_oc=Adlm0m7_NrMD7-kKLwPzso85u49coIyl_rBaxKVI5YsSe_BCdD2BsiuVcRwWdiIMMUI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzNGYBjanMEIHpgn3mvPKFSZRvLP2cMx0mhvv1QGS6qoA&oe=69B54F2D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FHwZWZLT9IQ7kNvwHn96Ux&_nc_oc=Admtycczos6vk5bzdC54JfJzUXlSJOhys2cTEMu5bkpSPSasNyYxUJmH4exruvjg3dQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMSWDSJ7_ZWkXE_HPENBqObJH0o8N7gchuSvtBd2_umg&oe=69B570B5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BMSHJQ8eGUQ7kNvwEfkepi&_nc_oc=AdkTqxzj2cglRT5gS3cgP2wRfIZYjfQOFIk5mnKJ7qyb5KOulWNhQYNZd6mWEimxzOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyREMFWbzK8Zx_4dIwo700RTchSMpv95--wmaEVJcmYug&oe=69B5599D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9ezT_vXQAYQ7kNvwHyR1UM&_nc_oc=AdmYoi8t1da8sEg9OFtBRexHq2chJ6dE4XKVk7C2OS7PhZFsP5X3F_aN4uS0c6_Ja1o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afznu_n489hvWbH1WRw3L-AmzAczP8ezG-lsv6N1RcdQbA&oe=69B56661"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\"."}, {"images": {"nodes": [{"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_1008x1440px.png", "id": "1700921013769246", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575360_1700921017102579_5965761788146700936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTa9hu-a
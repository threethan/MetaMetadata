810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ss7Jn6k0oWAQ7kNvwFHwjW2&_nc_oc=Adq_fXj_ZNObRujIZvlXaX5XKT6OgXCmOPkF8fLpaVe6VgkSysyc17dLO6eF78Yw6Eo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiqjw2xWcyUxf9GPwL2_aEc5QTvxfyUalVDPNfPibkYg&oe=6A4FA000"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MRqmyfjPVoQ7kNvwFhb48P&_nc_oc=AdqctQSt1FQcAteIWIUKyI00x63TNwTwDf4nLw38-Kld565JD07tg492FKTHAXVF3I8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz_hsXrwrMY63wyzPHXKvIuuSOQjyBf5ae_amxoohSbQ&oe=6A4F8EAD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bx-lhTlIAt4Q7kNvwGm2730&_nc_oc=Adpz4DIs0k-2GQSYxsk3kYmkvmS-ZcNoYfoj1JPZTji5IhGDvK5EGjky2dvYHIIkdyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxDv-C5h--9f_Pf4GjP-0qTY1KYyOUNFiHJtWI4eN0Ow&oe=6A4FB035"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve1FvzKLFvgQ7kNvwGnktqL&_nc_oc=Adp3d1DtPqI2OZRM-QmvyO-15d3NgxnSb3vVotfLrr5DEBn9-yat5FWUnZ4Zbgouby8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3e7PwwqykxVP3QCDkTzF1R2z4YX3O2-KZ58B1IiCzQA&oe=6A4F991D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbTRsskt3VMQ7kNvwEpwrdb&_nc_oc=AdpmMGSuoPAshsiJ9CpaYm43InZDmAsmJShhFnn4SkdyFpaG1pGe4f3g7CG8ZFoKwtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB98lQt5sG8cHylM8wyLXTBO6l1vuc4U0M2r_RWNiP68A&oe=6A4FA5E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
136248810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ona0UUZtpMQ7kNvwEvJPIw&_nc_oc=AdqpbzdlhCJtts7FwkrKZucAZUrwRlXuVIMWTo4MSYwCCgVgL38D0-hthGrnH9eauC0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfJSTnAQldSVdetqqDsTPA6ZaUP1x27QIiYARHn48dOA&oe=6A7DC480"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvvEhzWcWIUQ7kNvwF2fR3M&_nc_oc=Adq9akX6IIFy5xMX6Gv2Cb2bbvp_cUr8xdHw6x9kEGb0lRm0gyRtDyFa_C_3-0B2CKE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhNfpz8CMI4R4Fr5na9_5E_Nc6p4txdVvoTZlDz17rGw&oe=6A7DB32D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYVh1LRf3OgQ7kNvwGb9bIA&_nc_oc=Adqtudqm8vkCKKPTAptwTPZJYHwUp-XPqJvQzsX3Dh7WuIEOlXYPBMuzcahE1opDKQg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvaETMXsa4zXwwZNatxoV4_loTQVvSV5R7yOW8qC7Hvw&oe=6A7D9C75"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yM6kziZU26oQ7kNvwHWpYKQ&_nc_oc=Ado6tIZUReR8cp4XvAkLPa8QL_u7myj2MX-4FNp-rj3o5LGnKh_98Chl99AduPnXusk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8rpL9T8tvfJX8RqbibGOYcKGXn6n3CJsyk9j88IRlbQ&oe=6A7DBD9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NNExw15OcUQ7kNvwHGGNhW&_nc_oc=AdpJRcRtUv18M8qyfy1dFUuCbk2X4tb6I_jD5eVrMMBkbEUb4jS4EEfx7DYVy0qjMBw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3hkJj41xOsgBXkWtfnKRvy3lRLfFEPvcyRufrgCfW9Q&oe=6A7DCA61"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business u
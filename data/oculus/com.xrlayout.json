810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hbMIkJtWh0Q7kNvwF_P7gG&_nc_oc=AdpNpMm__bX70AVS50W6fOJtcsqNTRaLZ-_tAD12qCDFwNFfPmg3VQHBn8TyenCCicI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyjbqgws61lWXzOR5kfUCGkpZKtI0LjWuz9wOcUl8LA2w&oe=69C53280"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIfXvww3jDYQ7kNvwGtjxLR&_nc_oc=AdpeVUBEg3RE9exvIDnZSLgJvzGzCUB6ceIOegaMMP1k3I3G6MPhc7Vi1u4h4-QhgH4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBhAU3iJq80qJu5MVNZ_2HccuPFfXymod2_l6lRbzGRQ&oe=69C5212D"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0Ywji5Z4bsQ7kNvwFZkzvA&_nc_oc=AdrjnkzVzPP68Aol4E7muO2Glw6JeGnOVLdudSB1RhyHtm34Yl0AxEWdU6O8ZsB-_pI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgTcMVZ_2Y41gt22xdaAoRzfZ-ZAlqaApCyipA9WpACA&oe=69C542B5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Oi4YY4UPbwQ7kNvwGIuPLL&_nc_oc=AdrLbui-K8sVJtse6GEGaCsVzS1SGISFppOf_S_5d1esvOQsvyPg4-VBmKHHaMjmAlQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxtl9_HRuYLZkXsarAVKt0vAXLlFO8etDfCkAQdB7CZVg&oe=69C52B9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZuFqBW7hAQQ7kNvwG4l9wZ&_nc_oc=Adp2Hw3I50wqAwQKkgxlEQJA_JhV_VuzxizLayIor2jmRoyy9LzwSE41GwWrsM7TDfA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyx6F8Qr5JRy-imTWfxs41lzc6gnuBdaDTE2T-pMIgXcA&oe=69C53861"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
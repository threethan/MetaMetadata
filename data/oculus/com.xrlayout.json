810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxRzaw-FXxAQ7kNvwFps1AJ&_nc_oc=AdoKZR06HbX_hD545s4IBNuVQhRfHk2xRzLtW-MjWe-JfAA2rrrqPy1C98Awj_5kTfQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfXZKCuUynT41q92PcA-ku0BZmdgyGAE9nKyC00GppzQ&oe=6A5A2C00"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdCRLpUWfXIQ7kNvwGH_Hwg&_nc_oc=Adomx04FwNMOCTiby4JZ7gj5LhlZSs02jpuzsiGH8QMaa4SkBe56DeRmS_nL4n1iTaI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp892KYhdw8x2SFYcJv2KAQo9-GZ09HurtzCSrd0gU9g&oe=6A5A1AAD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHiXeaUfo2sQ7kNvwHlblVC&_nc_oc=AdpEvfJbTKMYSATyysWOMFGg78opbhnpUQtJ-5G9rSHVWGkUYAye0yEBWW8eAPgUNGA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIDUYlShD2nNWxhtl32s5qH931J86CN7qKj6kC4Qqe0Q&oe=6A5A3C35"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5ULAmvcb0cQ7kNvwHr0be0&_nc_oc=Ado2XN-DleNfwowIGrBYgoRYB4XTRmNMOLkFCXm2_OL_TS2xuz5KBu2bcY2z_kCV7wY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_Xh2RBRHrDjXWvvsbXqm_kGL2kdno4Fj1_BLxk1uS6g&oe=6A5A251D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkGuR8QPxkcQ7kNvwGFPr80&_nc_oc=AdphtHRfrw_iu9TGp2AfQm76Z5-r7uDHIi_uDLuMjd_zHa4yLDO4T1y3VyDse_o1V0s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_RvPOJzUj4rE4kFMcOM8k0_n5KBegSwXtdrYh6DxWcA&oe=6A5A31E1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and business use, su
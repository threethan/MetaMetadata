_1136248810736299_6712741067953882829_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7Gvx6ps_kMQ7kNvwEIojsz&_nc_oc=AdobYpPdY7RADsdmeAwjnZsydv0G1m5GGqz4_neRs1DbPP7NWw3bygtcoFYM8KKgU2U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPXd2VBsJOMXsGV6ift4YJJ_acv1HXyrieZaOtxjEzKQ&oe=6A8EE800"}, {"file_name": "scShot_2.png", "id": "920896889775145", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57568678_920896893108478_405013918484303518_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVY-kVFcHhIQ7kNvwET3D6O&_nc_oc=Adq-TE3WnwGEWrO8Ia4ak4v_cSMXq1HkU9G2pg-BT7uJv9NS5sdmbnqHcJyZvJ39WKw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwmEY96wzUXUq-i7xknRgfV8u0XCLs9vf0mxb8IIkl1g&oe=6A8ED6AD"}, {"file_name": "scShot_3.png", "id": "1072868457118337", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569423_1072868460451670_4210713844247774611_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAgF7S06uvIQ7kNvwFLRIrQ&_nc_oc=AdoZ8cBObO0DpOEIbc1ykWFyW2-rTStSO_-Nwk-5oQ_38inMk18DCYkJHY8y-6SpwUs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOfcFE3-HpAC5m36DAGhMtxK1LskjmyZ0v2EFn2toO-Q&oe=6A8EBFF5"}, {"file_name": "scShot_4.png", "id": "2081005358961264", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57570294_2081005362294597_8056307412813670589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSo_7T8-ficQ7kNvwHK9SGa&_nc_oc=AdpsqqtRdTCjHqd3UtSCVKuO5Nb6_0QJCHA6kJic5AeicEf8qPghTwMXDsmQ6B4Beqo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbrzgZibbvbb_g7slu_KDiZ1Lf7Q10zUytlegbgKU3OA&oe=6A8EE11D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XRL\u30ab\u30d0\u30fc\u30a2\u30fc\u30c8_2560x1440px.png", "id": "2415607391972644", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75254874_2415607395305977_5123172794916816011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M62XTyN-kGYQ7kNvwGndmdD&_nc_oc=Adoeyssn-Tr-42Bn8vGXs-vICYxYFakPw2_DefznGdALaFGE4gqUkq_sH1GhXMaXmAs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5E62_xkJqqrBxcbSUjiVLbLKncGrFDpgUPIWzQt2E3Q&oe=6A8EEDE1"}, "display_name": "XR Layout", "keywords": [], "long_description": "\"XR Layout\" streamlines the process of redecorating a room.\n\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\n(Uploads can be made through the related service at https://xrsns.com.)\n\nThis tool is valuable for both personal and business use, such as moving or designing new home layouts.\nIt allows for testing various furniture placements in advance to reduce errors when purchasing actual pieces.\nExplore imaginative designs with \"XR Layout\".\n(Detailed operating instructions can be found at https://xrlayout.com.)\n\n\n\u25c6List of Functions\u25c6\nSummon models\nChange wallpapers\nChange background music\nCheck your own data\nVolume control\nSwitch language\n\n\u25c6Controls\u25c6\nThe upper trigger on the right controller operates the menu panel.\n\n\u25c6How to manipulate the 3D model\u25c6\nPlease do the below with the laser on the 3D model.\n\nMove: Move with the left controller stick.\nZoom in/out: Click the B button on the right controller.\nRotate: Click the A button on the right controller.\nReset rotation: Double-click the A button on the right controller.\nGravity: Click the X button on the left controller.\nDelete: Click the bottom trigger on the right controller.\n\n\u25c6Special thanks\u25c6\nBGM: (C)K.Y. (C)L-side (C)\u52b9\u679c\u97f3\u30e9\u30dc\nModel: (C)3D Shaker\nImage: (C)Pixabay", "short_description": "\"XR Layout\" streamlines the process of redecorating a room.\nYou can easily rearrange a variety of 3D models and wallpapers provided, or upload your own custom items.\nAnd you have the option to borrow 3D models and wallpapers from friends.\nThis tool is valuable for both personal and bu
AggenTg-gUP989Vy3JCr8hlZgYwFVXmyPohs9JGOgW6gdAYV0OtA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9X16ijKRbVZtCx-aMLB3ash-qpMfnGbAukGGQKppLzw&oe=6A95C300"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZp1wsxkNGoQ7kNvwFiSQKQ&_nc_oc=AdrI4gGJgp-dtzBLEPY852kvLvBChe3P-FkU1uAgzQTC3o1aFC4AFIMSvsOTq7UHQtk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwONjO3cvhnr76rVG8TM2Rr5vvRU9JTVxyfdf7yJhvlg&oe=6A95D7AC"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uEUqii5ueoQ7kNvwGGPWAH&_nc_oc=Adoia2Bod3Jp4VM8xK3PoOHh5BP0ka1M-iqBAOgTV_4z_a2Rqpg9Le9yOX1JZzIe58Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxkjbI79t2KCUxvvjjiyH83VIAYfOZd2S-3yxMyYSz4g&oe=6A95BBE1"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMPEBo0m4EYQ7kNvwEZ9pOg&_nc_oc=AdplQoVhV6NJRD8O2gkrpbDCfQl67kDxvUSPrpdb_G-Vtl38b_OKk9DNu-EJcL1qOhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPtzM7BKzFs5CWCzEXUJo1955RpMt915CY6VyJtt8D0A&oe=6A95CB9E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLe4WQ7so80Q7kNvwGTSFUQ&_nc_oc=AdpFXMUnbDf85Yt8ym0Ub6tU7WH7p1-V21QsLtKbNBFuK5gjTeIcJlHryJ2PkiXHJ8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEX-fWxHaV9PpvTHsIq7MeqNq2M7LJ1p7faZaHx9HPAuw&oe=6A95AE93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"],
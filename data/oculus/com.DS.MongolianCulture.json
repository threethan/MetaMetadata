eLG-rq3rat5U5PnOZTE_RuM3Bbwo6sbBhnqfX_tVcqy97IKUhNPo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScFjam_wg-RqcNCoiht3i7cEXjK_vWzi5ymte8bxYknA&oe=6AE747C0"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBCJOme3LCoQ7kNvwGOyw5n&_nc_oc=AdqE4hmdUEotG4PjU_pWTQiRVbob-MG-Wj1v5NscNDFti4NYFcLvFnINd6qeBy1Fx1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKuvGwDXF_LCusv4Wk4TsuxQfzBwMTz2Q7D1wfhTrQog&oe=6AE75C6C"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2tRKp7CX8wQ7kNvwHwjsAL&_nc_oc=AdokjcElGkjJZZU-QCRbB-qPQbKvOdObWATQFh6L15cvmcDDYUi_3R3fMH9Nwyu93ms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq5IWKttQ33QrbSy9QhP1GQIMgR26TU6j8T9zlBdPLeA&oe=6AE740A1"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LdRW4mGdg4Q7kNvwE0z5hp&_nc_oc=Adr02J3tfuZ5bb8E3O2AAES2GzGuw-3FijM193NbajO81Ssc1sfM-8bzb8HXR2C7j5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy-oMW5_MZMH6LnZ0YLvuCXORi2MaE6qnw5L9ZAMOOJQ&oe=6AE7505E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TV2rZxh9ujMQ7kNvwGf8I8I&_nc_oc=AdoFqWtQCsaTUCRbYSwc0sZWkwxRLIiDnQbRGiQ1HzqIot3u_B-wH9pyN0m8giXHPzw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZivc__U2N2vIv8mMO-m4P2068REUJjf2CtEsnguiYvA&oe=6AE76B93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"],
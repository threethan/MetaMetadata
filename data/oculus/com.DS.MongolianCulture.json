mL5PW8qa5qT3HUDJH7ni87vFKeWzauGK8J2p2D2Df2SMhVmAA49Xcc8FFI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6VFtblAYekRs8292teGmIOY0lmoXbtvffyod_UZvy4w&oe=6AA40B40"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_KE_1Pcc6UQ7kNvwFx-E3t&_nc_oc=Adq0a4Alliwp0gRScfkNGUOR2IqWNhjrctlbfGUp9d1tzkp7FGKtitOLMH2cXmrlUWc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2NPJnstw617syNzcmnUcjpcixPFEZi-aGWb60AUaOqg&oe=6AA41FEC"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yTx4XuWv9UQ7kNvwFqFFSf&_nc_oc=AdpPzv2hR6YpkIUKAvziUgOGWG_InC55at8p5_SlJDQZmLLP9yscSwJrLYwqkVncfp8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwIme_yQxlB5IAU4BF7onOSSUIX8FyumpG0orrxvbsNQ&oe=6AA40421"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cr8OGjrI4ToQ7kNvwEV2l6F&_nc_oc=AdrlqauibnvoIjTM5vZ1fOM0dhjgEVxtrd3gpBtUwO05kzXyYmcKty0h72QyfD-MYug&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFPOgc06Tj_CLPN5TVUrSt30wMd5I-Z7N53VICHGKTxg&oe=6AA413DE"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=668XDIl1fZsQ7kNvwFaGPZw&_nc_oc=Adq6LtNDLT1n1AvCEs753lG3z6z_cgc2BzZKPu_Rv5kFaGzDLmR81b2wreziCwOFjNk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEnns9vo0iiFumrzonECluFVGF3a-DyV9DR3SQfyuoSw&oe=6AA3F6D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULU
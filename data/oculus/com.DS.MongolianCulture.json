5", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=on6FMP1EdPMQ7kNvwFylTbs&_nc_oc=AdlKfOubv9MPUswOkwN-Qmg58tz9ei7DJz7oBwk8Ik_5FqX-qs_UVsY9oBKaNCiht-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs0SxDQBfFkBRD2edFvKMMHl5QR_2imcRp-j2lpmWd_jA&oe=699998AC"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGhf_QYtt6QQ7kNvwGnhNfY&_nc_oc=AdmADgiOkUnJVJRBwurxv1IxSonIHIrGTAkyDBVkl4fr0af7LfPXb-wMAMFbd7PDC_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvj8YNgXtzMFo3xyws5uun7LH_88B_LesOspBDzjSmijA&oe=6999B521"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrnpFGth2jcQ7kNvwGWFHNV&_nc_oc=AdniQ2_FmtgXnrjI9tPk-YftsVpqZPZL8WeE7Mw-1RMkG_2ueLC3W7xkKS2cypJwzwY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfupyS6NW8uYqS86lF0Gskwt-ClVX_TueOQGj6Bf_JpxaA&oe=69998C9E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHa8U5KKzZcQ7kNvwF0Ttmq&_nc_oc=AdlQdjuCD1HKnwSFEg41p7gZAlQ_j-Xdap8vMBOA4XFxterWJFidBLuoytWuh4Ne-_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftz3ivJ3pvfff5gYIurN-hUSX-RfK36O820dHxdxy_eNQ&oe=6999A7D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29286177197662416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391915_971077541882817_83
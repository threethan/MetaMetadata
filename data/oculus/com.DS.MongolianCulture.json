-D_YkgJqSMeQvr_m2SjC6VDZKdszqEWNCbl1PC4jPW096RJdg7r0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE-4rlWIyJCdI8cyu17NiJC9dPn8NDsssjTH4dcBAfgQ&oe=6ADCBBC0"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nN5E_w71pUQ7kNvwHsssc6&_nc_oc=AdqWOu7Eo-_3gd3WtWB-4LFKidpd7l8G6iTrwxRmHTm6JcJy7iDCmOfbsm0YRK0VcFI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJCT53Ol4eilI79u-tuj5RxLZTu2FRI0e3OYTv5bxWPg&oe=6ADCD06C"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ff041IxcEkQ7kNvwEh6PoP&_nc_oc=AdrCRsUFnfLsXH77rkMx5L48fkhRUOZ5CKE3fXk_r9FFsZIYcNNAlAqRG6Iu2pMqRHY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwopsqKK4PlKmvDoRb-WfItVipYKqgTxd8IktATs0N-Q&oe=6ADCB4A1"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CY1cORdmVJgQ7kNvwGTeE17&_nc_oc=AdoUNqgU0bQchmc_p55uNE0wtvk4J_ZmmTW4LWWNSDeONDO38p7zG-3cX23pwkp3OcE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrFafcHF-H-p0UOxeIUAClvuP5qTesjR2CTEH4qbEeSQ&oe=6ADCC45E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqmL9ZHoL0kQ7kNvwGtnqaG&_nc_oc=AdpO2DVzjfB8YfGTEpXo0WlrAuqC2e5R5WZUiA4jrN5-Mw45kpl7oq2w50ttl2KHTaA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSYz_d7Enzh5GG7CvP692D8_-zQ10YN5DEx4_AYKs1RQ&oe=6ADCA753"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"],
FAacjWFITYh5IpPQ0q6bdmdN9q8q-hep1wJJYjA&oe=6A50FCC0"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJCNggQuaKkQ7kNvwF4Vuzl&_nc_oc=AdoNiahJZjC-quwmD5P0_ZkD4tS-mnAafuPaiZrikrf25xndg1daARgn6dmqxn6T6uM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2bKrCXeUIre2kWHSDSch0jdA_hSivqjVdphfrphyG1g&oe=6A51116C"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U783-Lj2i0gQ7kNvwFoxgaV&_nc_oc=AdrxnKj6F1nWmU0KhJaAn5sL3r50O7JcJ2llVAmEMo4vTP1N-7BLVSMmbbpzJh2DS0s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIV063vl3LNkhSS-8AEPuyhF93lAum0FZ-UYLjjYagsw&oe=6A50F5A1"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pfh1FD27ENIQ7kNvwHfYFL7&_nc_oc=Adp1QGK5Ow3fCGPIu4UNLk3RYDbkrt0eMm6fsWGYNIT-ROy3PV7BOaGM1XW3iWpHT7Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBb7dObc0LAuDGLf0IL0h0ij_ZuU64BH650BwSvUm3nuA&oe=6A51055E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tq_7zApMD2gQ7kNvwEn1jQF&_nc_oc=AdoTFq-SUqHts_Z9he8dcOfBQ7hpyWmq_tpmIaJYMwfWWmGhRHEMaRpvnwQ7KP7YYJk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIAj3dp9qmIDyj9N4Ad80p5i_qNUlM3gjLgZCe-Jq9Yg&oe=6A50E853"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29
5", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oz5TWy-CC98Q7kNvwFlVyb5&_nc_oc=AdmzURzjvr52qOhHuXZu-Bb9R1E1beDvkgobhZD_IK_QHjQ3lZwZDBDY2lrSlg92mjU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft7pz4zBYTlikWPxfqO3oiCdpkEbZcGeLbpgFPLMnDYew&oe=69A0302C"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6hMt1ECZ54Q7kNvwENIfN7&_nc_oc=AdkgyQValB-1hdyt1Xkyus8EZbj5mX0YbZd1nW2UvGV8TdaWf6OxMgjuvEy2tfcSl1g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0xg_Z8MuUm3MPqJUZz85aHuaFi2mXYGnCZdALfqz2cw&oe=69A04CA1"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IXKxDpENAwQ7kNvwHLedX_&_nc_oc=AdmhdvlS1j3X6sNNlkbqqdA2f01vglI5uOkgpV5bIiZUgNDmWhpa4GhPopYMEqVdIc4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsFttWAWfT6BGnpL6jeZMSBu1MR2SB_snm2c1kVq6VD4g&oe=69A05C5E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqbhpoHJiW8Q7kNvwHEzIsB&_nc_oc=AdlDv1bC2BdDqUsUqDsekQS8cZEz4vXt8mnCBJZafx_LWVSaVi77f2Db_7lhV5WI4LQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuSxAre21rrR6pZkIU5257DbkHo8UEhtdb8zn5g6jx7nA&oe=69A03F53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29286177197662416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391915_971077541882817_83
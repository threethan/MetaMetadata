sPO8okN-5vYH_sdgSb_mUVyljtpbGpbDCIIfj9A&oe=6A5F7D40"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuIQ18_1glMQ7kNvwGRf7KJ&_nc_oc=AdrPk1MCl-yHsNqMaIHaS1mUo-ppXsljDWMD3PfztrZPzfMLpfrH7vT_DbvIu5OqoXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_9atkXiAGcLGCSf4EWFWh2XTRvtCU0OkEo1hVJ387Qw&oe=6A5F59AC"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eF0ZAuRvie8Q7kNvwEE_pgT&_nc_oc=Ado9Xh0A8zywMTXsUjnMhuRipTmt5UqzPw88r-7ChVur5NKo1znBhKfOsqMq02RUVb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3_SRR9hzWNHMHEIUPCaDNhwzOWOBHEZpwGWBTRX8G9w&oe=6A5F7621"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rRLcaGuH80Q7kNvwHMmTwY&_nc_oc=AdrSSNtQ4UNOTEgfMgWW5EvS60MztY47iaowsY2AMprFtL5aftc5Z_822oioX-yuknQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFS0qt4tpDLgNUHa-lt2o6g9NoPZ5lqXoPYHQVGKPpng&oe=6A5F85DE"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-czApJZ7gq4Q7kNvwEt1tLg&_nc_oc=Ado2BFI6-jnXngQYkFs_g1V1pvgu_LkqOK5iaW-jvuBj0rpp39UdJYimgDBrsqyJlBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRAF9nHp0kHacjh90CeypjJRYpBkuz_321THREq9jEFw&oe=6A5F68D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29
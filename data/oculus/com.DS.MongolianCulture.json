VtouCiQ&oe=69B2C8C0"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9cBynnZfjcQ7kNvwGc3bcA&_nc_oc=AdmP1j15EkHld00h_YGuEyHR_HJDuitvmF_5kdDNooHpO9YdWCAAYpiiFb54ma_0f9E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwB7C1Rg5GpukJiUkE4PouTIQuTGSjz7rw8rZoo6RKiDA&oe=69B2A52C"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqsDoqGJW2AQ7kNvwEphCKO&_nc_oc=AdnEd1pdKZc4-SbLQgZ9l6nx7DlWM08FjdHeAgDpfUajqabqUUm32hx1e1ziYMhopsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwnckewgO0uZ4eiI-ztHUMJEvAUA_FWIg7uNoxfmNO8dA&oe=69B2C1A1"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYkFGuqG9uMQ7kNvwFP1r-8&_nc_oc=AdlXjhfn26ngXrmmpa7r-TRQXxe-18llzxxee31RyoDmLzcw4Q2mPJyjESPD4x_PpSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0oDevI3ycVQwUcXTRDiKFDnPav35Wp031GwY03fOS1w&oe=69B2991E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVMOUH1WK4UQ7kNvwFh7x5z&_nc_oc=AdkFy6Jq376u379m94DrhzH7m1IDqKJiOlk7Z0DZj_E_i1HfnutUxP0hRgV88rZKwxw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfywK0BEctbN7Vq3xnkxKjeiuYmS-OFPtnrh5rzp6sDwjA&oe=69B2B453"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29286177197662416"}, "review_messages": []}]}, "co
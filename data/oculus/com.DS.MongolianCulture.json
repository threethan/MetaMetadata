jtJC4n4lXG3dVBGQYFhHB8qBUIA-Igtoi_BeWpA&oe=69C53DC0"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvUKQLEeLsQQ7kNvwHd8Iu0&_nc_oc=AdrzAzBryy78qRrt41h5nArR7-GVAFnnObdCvZDAxu7gaav-JIc0gMUHO1w0tGN6R0M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDIqm9epUST-Tikv8ra15SxCZlWQcXrueJrTq8rQKx4Q&oe=69C51A2C"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKfZBj4C1QoQ7kNvwE3z726&_nc_oc=AdrMsONAnd9KJ8nm9LSQ-nJUgxrnXhkXB7nndht-vEW3FwktehKu8MmUj05cvOCvqcc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxt84vU6Z_Q4DJeYqPzFhevkl_wTPeAqM7sOy9vdkyZaw&oe=69C536A1"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IATZzS8CPOQQ7kNvwGHbaMA&_nc_oc=Ado9acYRGk6MjlrXznu7BtfI9WvOQY5_VH0LmRGgnTn-lWYTo66a4Zx22l-1UUOSmKk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3zef0fkT-HoBC0SoBXMYbh25yrN9Q2DjlbvQ8gY9frw&oe=69C5465E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4x8XRvKXRYQ7kNvwH8z5rL&_nc_oc=Adq6HHv3GmR137r1pohtbMXmT8Q9MzXOaAHd5EG_WW6_lpruKaVGCkclyLT5i80E5gU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAd9l8XjtZicopDje9vwGIPi86UgJ7E43ab7rY2IZHWg&oe=69C52953"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29
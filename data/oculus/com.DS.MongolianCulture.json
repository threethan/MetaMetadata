5", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akI9V66yxiwQ7kNvwELkWf3&_nc_oc=AdmPqQNlpvTY524e6fYXF4T7cyIioPSBcnCyg-5zF-gcIqWsuOPBpCwxFDUpVZ31qx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftCC_g_XaYZGDKFLhfgHU7jYHsO6dGQXmghSjpaTOJw3w&oe=699AEA2C"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGhf_QYtt6QQ7kNvwGswZjD&_nc_oc=Adl5oyDcw_nUowV1pbHbSdeepU1CkMcap7fa3O6XtygpZAQxjGsqiUAdPAe03giioqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs03S-UpF5oxrPJg90IGWFeDCiN1wZ1501Tb0OBEfW8EA&oe=699B06A1"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZBnXSVYr0wQ7kNvwGULqWO&_nc_oc=AdkiwCFewZj19BtGyQ5PDvYtB_SwJ_KYrx1XOp4dm-7rz_zFxHAjBgzszVx5HR39Lfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftBSnge8JymkMBqFShzyaZ2hePMtzR_JKaqxsiVC6JTdQ&oe=699B165E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHa8U5KKzZcQ7kNvwH2LPOI&_nc_oc=Admb2bpj0XJaWVHinfF83Cei6crZr2wy0FM9YwUy_1iOmBpZ47-Rbau0v8Gi_PwNxEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvz3kAll1JZ6AB-bC5NB2DH_u5LSMFssd7yy32bN6IlJg&oe=699AF953"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29286177197662416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391915_971077541882817_83
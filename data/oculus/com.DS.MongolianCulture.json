7NCoOdg&oe=69B17740"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXDBK8_GHiwQ7kNvwHUtFuS&_nc_oc=AdloqjxKeFGnIon6Devp6s4X8XyTvPBw80ZnU4yJyFlwCniO66oZAIpBOf-DmW8bJic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZiJ774zcIHI6NT87K65sJwPImsV_oGBv9vzq9M1AAkA&oe=69B153AC"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqsDoqGJW2AQ7kNvwE1YrWx&_nc_oc=Adk19zhBaLrF7oyDAJm_wP_GkJ7fpQmqXOseq1tB3gQPHU5EaSO1ltigRrpgELKa5XY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZRs2_eHQQPgVFs9h8kFrkt7xajVZvcJuPDdYo3lDZ9w&oe=69B17021"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfIkPbDf0_QQ7kNvwF9YvVc&_nc_oc=AdmeSWmTIOc5UllpG0LhQRw02zYWMx60rqLSnX7E8qUSckG8_jC0gLkbfHbaWr6y7Vk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRCF6GB8O_aUVXGaVZdbWCKGbwLvarzkLNQq-s_zN8oA&oe=69B1479E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVMOUH1WK4UQ7kNvwFPA6dz&_nc_oc=AdnWLwvYWdlKIiPw_Qq6A4lLh4axxLA2t7HQc3gs7ku203iAkrNDZxyjQZFMtFjzkXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxaZmfmeudM-mSW5PVYTMPwveV8tad0g3pOCGUosDqJg&oe=69B162D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29286177197662416"}, "review_messages": []}]}, "co
7kTlw9LJrPxta92TkL8-zuZ4UpKZNm8q4MPMzaA&oe=69EB7940"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGj_IqMRygoQ7kNvwFt2tvr&_nc_oc=AdpTVCd0srNTqXGTNB3C5_bp1WpE2ajKxUWQELgBQnfHX_yzAa4oqQG_qYu5rxcwhMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zn3RMjPkX25b3-vFdjYc-R9ePmk59XleTxStJfZHm5g&oe=69EB55AC"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxCTnH9i460Q7kNvwH-5wGK&_nc_oc=AdrPWSFZ_TCHlvfVLEb8gjdxMLJ18cAYmdl3l5smDl465me9gGRdqGCMJsoYc3Gz80A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fksbZiSBWtIcWJ-lKTk7Mc32PtdQ44wa_doU98XCEvg&oe=69EB7221"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2L7g_KPnE8Q7kNvwG8H67y&_nc_oc=AdrD2mZgN-Uq4RKfIqNETcl2YZyCG3fNtYvApVZcoIan8EfeZHZTkZexIyiYbGYdg9E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Gz75-NkeYZj1T7Uc-9dfhozbMjwvhEeXL8PzNwf8sWg&oe=69EB81DE"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am1Q5Vs8zw4Q7kNvwF9vWRB&_nc_oc=Adqg_2n5lNtvZGqBJyoVCNadh_05rZyTN4CW_hOjqTG_IfzDBbVOTu7ncFux4V0hwJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Nq0AvRaW3NZHGuMuXLD7UkHenLW8LPV2kR9mBlP6RCQ&oe=69EB64D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29
QHAPf8ZIdv7SrNz00aO-4S-8ue20WPsZJj6krWZTUxN0w&oe=6A858080"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iC4-BbTd6ccQ7kNvwGpMxQQ&_nc_oc=Adonn6UzCwEuWbNkR44J38-_GtjgMLztY84I6hcv-jtm_abN56NxnritBfnW8wUxNd0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEelERNcw9SScy0AqjZGJ1EvhAiI16CcGqex8F0AHdI2Q&oe=6A85952C"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBGN74XMQ8QQ7kNvwHzkzot&_nc_oc=AdonFfwfnzy1qkoUX_cyZs_YDDo8EjIEy3K2XbhhMp_7WNKXz_-8gBRXS08NoyLIJDQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR8tZ4yfA5tSx-yTPg3_5HudPhsnkGdp64tKIbRBi7lg&oe=6A857961"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vAtgkUuCy4Q7kNvwFUv6l2&_nc_oc=AdoQjdPy035-m149lv3_bQBP6tAsU8bi1yf_WWzpc0ubRrYLlJwf-6Bam4lguVxrlJI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZMGTKTmawpGTu14tbxAWQxwslV54COZUmo2RGCwVrwQ&oe=6A85891E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erScYbmLR70Q7kNvwE_xEyp&_nc_oc=Adrehw8gcMlExbxauY6uizFQxea2WoUpfoC8ko9Ndy5R_Azet3GJGh6PAFTmOMJKa3o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN_tJpEqhruOJ_fn35VdRUxhPrwlfaLsEgz_H3WJ6djw&oe=6A85A453"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "
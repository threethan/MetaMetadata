D8-fgDOGZwBJISg0WOJXiFt5iaPXs3WWJpdItiQ&oe=69FF3FC0"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz4zPqD0l4AQ7kNvwEPE9hk&_nc_oc=Adr1JlG5d3qXkDIP1-dOq5p7CgZyg3oQKdpyhb5ZP34E2PS3lJ1EfF2_p0s-ziIBUZE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nzeR6FsLAVusyzip6JSUlz3oQ8_58CYphqss2sjbW1Q&oe=69FF546C"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr2ZBYx1i38Q7kNvwGRhhh1&_nc_oc=Adqp1KwhAU3NLPlJ9kgCNgKwrNXnRcKacsK8lJ-OG1b2TKmYsz4PfhnEtrtmbG6ddNE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fDeRtlCTCulnF7t_K4zrCG4b0uANfxAZfWP8kM7rHgg&oe=69FF38A1"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbs6dhBKI0UQ7kNvwFOjIOy&_nc_oc=AdqWaIkdLe1hw0N5wqgqm8u1JGDJUifwBpQd4qsfleT3vB__6jZvIhrLRhNm4t3nAjs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HBXDt4l4XpUQuz8UOl6e3MY1d2nqqpecosNWJBBxVIg&oe=69FF485E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzv8KTrrNy8Q7kNvwFbIfEc&_nc_oc=Adqlu0mb0Yf7wHp4W2fHUnKQ8FqlBoHjEVFA-TzbsdPurORfFByUK8PS213nk9y5SuI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KZ7poyCY7vlYjLkRS4t26tnk5YCvMCxIwDAsedSXY1A&oe=69FF2B53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29
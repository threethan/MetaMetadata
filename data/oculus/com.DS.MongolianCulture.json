eym4OS1hrGrwSQQ4enA3vnhBJC6O5iKsKPbUsuw&oe=6A296FC0"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tyb4clcdLiQQ7kNvwFaXKQo&_nc_oc=Adpvb260Eyv5aahsoFBOvbdfJsKmaL09ZEaXjKRjT0xiJjundSAosIuC3wM8BjrZgIw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SksInZgflC2dIenKbRaW2UHbKqWZnwcZGjzfGTth3hQ&oe=6A29846C"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGjPPcUUawQQ7kNvwGs9l0L&_nc_oc=AdphC8JrmzmfzlNeBangnaC3RPwQUhoLZIGqr92PhmHDgauF5n3hsqqAKkCJZseKzBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8A1hcuHtHRXuRWmwhA2ZSlyZA20edegrj0eLUzERqRpg&oe=6A2968A1"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HY78E9M3vKAQ7kNvwElXARg&_nc_oc=AdqwaccQdoomnoCySbRvKasV0VTk2DCcmuMgJrRCBCCGNa9v7PCwHVQYDt2kZEJ-SzA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CbU_hiLLptex3Z99KdudadLJFl8CnAM4LCSqolQ7w9g&oe=6A29785E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIT7E64mKFkQ7kNvwEFMw1-&_nc_oc=AdrqtjlbfAY-0op9fL1_sL3rG1aBesJSusZgkMjdu04jDd9arUo6iq-LKRtgmpmTgO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l4IpFS60V9TFl6aKME5yYd7UbmydbHgtKy48-Au8vAw&oe=6A295B53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29
yy0WkWZEgqyMUt08ogu5CcyJ45wA21rQoJHW2eADnB2NfAqPGdiA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9Oq_W7_ZcvNq6Q8XjksucOYOhWlZDPDjkpUSGuFBG8w&oe=6AA2B9C0"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qugl-7sVPTkQ7kNvwHWk8TJ&_nc_oc=Adrn509ibkzEhMXSlpl5gTg1Z1lyBt9oc2KWCSqaSSCAanPOCiNO75khOkAqe-P_LmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcrF7YlP0auy6lCJzyMDRyRL1JohQ0_4NYCEJpUJ_y8Q&oe=6AA2CE6C"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yTx4XuWv9UQ7kNvwFKAX3h&_nc_oc=Adot2SLu77s05j8HjoNl9eh1smvd_fMcrep7oTK7yIxD-8sNZB59JEaII_Hv0d4lEaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3leuCaKMm0IjEOTopqGhtdFvPOChFbhQ7q6m2Q_vduw&oe=6AA2B2A1"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T4127z53pQQ7kNvwG7C1X9&_nc_oc=AdoRQ_ce0oLr8CmJPXpXHF5eX68rdVnRWo_XzKGmZnuIJhZzZuuGSIHsc334w8Qgtww&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIakE1dJsu6gGQzlhfLGX5mp_yJtp3KzkKlW2YiXdZ60A&oe=6AA2C25E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=668XDIl1fZsQ7kNvwHCZas2&_nc_oc=Adr6Q0g3zqm-DKCKJsNMqelL4-PC_g9VerMKgIsQe7z0kHyV0mFZs5k45KnlBpqwS3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-vj-3A0Cd3mj7SdXBREVlDJK0kAxtTo2iYtt50Loj6g&oe=6AA2A553"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"],
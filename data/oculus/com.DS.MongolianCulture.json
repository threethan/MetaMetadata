5", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe2euEdPgAoQ7kNvwF9Ew50&_nc_oc=AdlHcm1sO9yudnpHhp4fexc0UpjaGtFGc-dWyNldMXWcOfYK0-l04rii_HACCO2ift8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afudz4eyjGzV0AuMBK4Tf44smakqrsNdH5PsVnGAW3i5vA&oe=69A5762C"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-zsN3h0C8AQ7kNvwGOSx-N&_nc_oc=AdmiM-r90_M4v4iJhEsbh3-BE3rqHXVQE_krVe8DY5TyiPx63kZ6SGLGukggTcESKtQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuuG_1abe-9_p9Vek0rSMxrD28SSHcp7WvrK2k74P8Rgw&oe=69A592A1"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haBQPP_VKy4Q7kNvwGyJUjE&_nc_oc=AdkrEQL1YM-43ozyQKRl-TmN09cq0gqBro4whkzClHHu4Onkhh4-oM9qgoni_EMzfis&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afub3iv6sC4oKPcNvAzY6YtrNWFc_yo7NbEuNJ4cgdjI5w&oe=69A5A25E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPwGX0XdqpMQ7kNvwFtv_y7&_nc_oc=Adm5QqB5dVUi-mos6gUx2j3RfSM3kFICnPEQnW1Je3gSzIzdAT0OPAqskwZ_t7sV5HM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsivlz42XaR2-qOLe73XE-jfe1ki3R9bh4XccG0QmnTrA&oe=69A58553"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29286177197662416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391915_971077541882817_83
KFOB3p6Arrvjt1gGDnUhIZob3b6FgvWBq8K-TVIKElfDV6EurgYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwd1ZNrpu1oe4MonEWtI4ZSqUBr7_SChh-Dtie7QHFaw&oe=6AF5C840"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWANtQAaijUQ7kNvwG1VzzN&_nc_oc=AdpdKgWgIyOV7wbAvep4HBZKh21bmNjR3uKRskvrK1up756CvboMUlaUUJA3D6E8DF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzYWxIoaNk9hGItwuyNhmV6DS_ll3Xss2F_a2Fh2gjWg&oe=6AF5DCEC"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZ96zIcD_2oQ7kNvwHDYIyD&_nc_oc=AdoFpFDUvTLeVMPcfD93uBagyexSHeH7AXB40-KO99B78YWZES0rZzBz6qv49aByeF8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTULJfGnSAclv4WXwouxvR-CeYZpwV1iiMKkQS0H6xygA&oe=6AF5C121"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6akNAypLzsQ7kNvwHFvOHQ&_nc_oc=AdofDcerKitophAK7iVu6tTHB9brDcg99NJL2XlJLrwLkl5SS9QonUJASm3t61ikJXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUO5CXkpotZyoNY6XBhMZ9LXHmJrza14AMjOm9PCALtg&oe=6AF5D0DE"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbb_Gf_2MBIQ7kNvwHMMKPw&_nc_oc=Adr1-UTU3ZBHtXg666lz1XK7ndTb7V8tZRuSWnouPnsUwDNT4oI2PKB-Q-j5_QVKJQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCU7dkycBLxS7sw84RUl1uMoWeIFqIhxeKZgX7cyUPVA&oe=6AF5EC13"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"],
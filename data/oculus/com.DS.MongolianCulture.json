wMflY6w&oe=69B80EC0"}, {"file_name": "image1.png", "id": "670747682318485", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392325_670747688985151_593183297293682052_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGGdHTOqePQQ7kNvwF29Y2v&_nc_oc=Adn70yBw3mur6nKBKTa3E0qjgCLvJaxO8JreGm7aaOqUH1SgFdz-KKwmx14D7h3S9_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx_LyaBspDd1zKB2Rl4JF_CMhnOSaNGcdU2sey3kmgY1Q&oe=69B7EB2C"}, {"file_name": "image5.png", "id": "927931879266902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391887_927931882600235_2849852558886303557_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eRUJR7JpAEQ7kNvwFTa5nL&_nc_oc=Adkqhk_eVlSwEuw_Q3AG8n6u5qdWGdBwbCQ4sxGYvMrxuYhQpctt01JWkijrLj4yrVs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzq8-E-etlnzzrf0eHhnBv1DGMGHhxNp5-bxK8Md5XzwA&oe=69B807A1"}, {"file_name": "image4.png", "id": "2132104113877296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392105_2132104117210629_247270124176761506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de8caFR2A18Q7kNvwEYq0L9&_nc_oc=AdlOrV1ERqLp6oKJQdcSyCysM43RPwYm9Z3tZwUXziau_ILWs5GTn04Pl6WzmgSxU9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_nnrSetZ68pFDubnrkuP0BVTZmq73uEjM86MGTsM1Tw&oe=69B7DF1E"}, {"file_name": "image2.png", "id": "1553495091993127", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392314_1553495095326460_2634876365981849467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKTUKYrTWH8Q7kNvwGCqYe2&_nc_oc=AdkrPpHJJO50pSc_ZsBH76EkxtKGqteuBVKRZO6nFj7LDw01be6n9D06G3ZJiV1yGIk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCD3HUBdx25ONxxRTM4D1riU-2251II7Fa9-vuntUiyQ&oe=69B7FA53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Culture World Expo", "keywords": [], "long_description": "Mongolian culture is a rich tapestry woven from centuries of nomadic tradition, deep respect for nature, and a resilient spirit shaped by life on the vast steppe. At its heart is a way of living that values harmony with the land, with animals, and within community. From the round, felt-covered gers that dot the plains to the intricate craftsmanship of traditional clothing and tools, every element reflects a balance of function, beauty, and meaning. Hospitality is central to Mongolian life; guests are warmly welcomed with offerings of milk tea, dried cheese, and genuine kindness. Customs are passed down through generations, shared in stories, music, and everyday life. Whether moving with the seasons or tending herds beneath the open sky, the Mongolian way of life continues to embody freedom, resilience, and cultural pride.", "short_description": "Rooted in ancient traditions and shaped by nomadic life, Mongolian culture is a vibrant blend of craftsmanship, hospitality, and spiritual connection to nature. From the art of the ger to time, honored customs, every detail tells a story of resilience, harmony, and deep cultural pride."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29286177197662416"}, "review_messages": []}]}, "co
22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKvR5hOizSkQ7kNvwFzIG_l&_nc_oc=AdoisKG4m9WChKj_DMutTP1vbhgcUvCw84D95JxeJi8bmmLcad4SGfq5asNP3tT3OTc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZE3tGfHPjFn2CDU7xvq3cHf_rj7Dwco2-nV5IHs-LwQ&oe=6ABE8961"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oya_vYVKTdoQ7kNvwE0DabQ&_nc_oc=AdpujzNTKuzFnHpDk40V-bPrmQEG6LUKkxUwP3tCfljhTYhx_9lmvKJitX4kKCHz4do&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcQ1GG8LgbWCLNbUHazHuDoh7UqY99fgF-LtXUI2nQWQ&oe=6ABE7D62"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwWlpCA8FeIQ7kNvwEhNQHY&_nc_oc=AdpEyKi0Sbs-BUqucOhf_zbqmFsNQkP-uEohRCtqYc78EJvEzULUDVR-1nFltf5WZn4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhlIHeEAUDS_cbohSqG6kp4xMkJgvJ3JoAZ1z8asEWEQ&oe=6ABE6078"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Or6E8wSIWk8Q7kNvwHoGaSG&_nc_oc=Adoh24gWrkYoGNepmns4Kk3r_CNHom86puuLLrBsBzYU9gunnlrclmEb8qSijuwFnzo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr7Em3Ij_RhpGEeQV-JQs2YHtxA9FeqCXOBPz2PnP2aw&oe=6ABE6573"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtRAmGLd7QUQ7kNvwF7Jwzc&_nc_oc=Adq4PRDgOjQAvWu8kevs3PjgOvtJW9BTmMVCld32JDrCdDgyOM6axUcusN9ydgBKSck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6pnQRbpyPbFFnPip8g-hU-__pVkU_cu9kjkRYeOw9GA&oe=6ABE5EDC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
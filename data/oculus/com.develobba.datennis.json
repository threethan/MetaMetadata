22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pWlelXtb8QQ7kNvwG4yxWm&_nc_oc=AdoPcL7fJjIBoMgZdcPRleCj3-1K-kq9JOnJqmQr-H6iUee1uMjU42bEesMVFpT-Nzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwGCI2I9N_kngsKyxq3gAICIbGgPGEmojUVFaDaGDMlg&oe=6A4A8561"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCM711VcLqcQ7kNvwFTRZyA&_nc_oc=AdoSFXp2K2OMmcSSKfDvI4qEXTyDcUy_EMbp3SUUmFwJwndDxp73VD1ePUrj0shAsJQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5QbL1f2Cwric87_324nZMnzoYYlgm1ZHcE2tGAnp7gQ&oe=6A4A7962"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8A16ZT8ugMQ7kNvwH42FVl&_nc_oc=AdqIepYj_byGzvbD6VM3UtcO2F9YTkDPn-anB-mzX7sVKVHLSzTHzlVZO-VyxmAzEOE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMDy0qUe9qh-mL9REH5tYu2RKi564QSaSGp6fV6G4mqA&oe=6A4A5C78"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7G_bV5hjAwQ7kNvwHsWPJt&_nc_oc=AdoF3nT_0isTROh7uQHDS4Pia4t52Bt2dOODqWWctYfdtT_YIdaC2xQ4-C0ZepEogu8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4LT2dtaXe7RgPPsskWcIrmE7Zvs57S6nQrL1GL9x3Pg&oe=6A4A6173"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiEfIzRgyhkQ7kNvwFk6L3h&_nc_oc=AdqyL22gjN7RNd1rbxzX0tT3xE0onWHP8J2GwHgCwroVhVvuAY2wFBvOGF5tazqAUXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2CMNxnxx7Zi64Y4-5-6b7XhhgdwwM0JafAh1X7-AJwQ&oe=6A4A5ADC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ojOu1D2aVsQ7kNvwFAs1ga&_nc_oc=AdqiFf0Wl-a6tUZ2wcKJGkYtlU4oidRH9k-Wzzz9YdW1MtTqdRrpBW892heDRyxK6Xs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ObvoI6k9Q8hQEvzPzh2H1Tr2tL8V4I-jJxwetbpyPYg&oe=6A43EDE1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFJvPYlRHjwQ7kNvwEbuvMl&_nc_oc=AdrZhhiXPlWxYe0z_Om6OJr5gSrWxGicUVNcX2VlKA00mDcPrT29Jrtdd4Vb6Obawbs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Pewzvlc1u6CzHieake8GYVZFgmADm0qpSAGOBUlLx_Q&oe=6A43E1E2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIGCiSfCWEwQ7kNvwHdlT9s&_nc_oc=AdpPZuVluR8qoo3PTxHu80LMjIDVexMYfIKAKxvcPV_eR7fZk9bU289zfr4AOsjQJsY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JFJpfdqBUD2_I4Apxl5KlJI1yZOyVMEn_payY4wUQAQ&oe=6A43C4F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXbtSXhSoWwQ7kNvwHB-KYX&_nc_oc=Adp0FITZ_3831dWSWi8n8mRmq2DLlJ-yzlgfOgSFLKjJITip8R6beZ5MaT5du0usXsA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u6FF6Ckx0fPwVc7XJaClXXPSWWweNv5MoOjR_wrTxnQ&oe=6A43C9F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HXg_RfxzSEQ7kNvwFAxE_b&_nc_oc=AdqtV1mtSc8DXOvCAdsEpoupFDtNGIh9F5w3uDQxZiKY2-IimtcED4eKHm31t0pUtn4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m9D3oI7oU4FjFwawt-kz244h68OXJ4_lHfhMoYueGxQ&oe=6A43C35C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
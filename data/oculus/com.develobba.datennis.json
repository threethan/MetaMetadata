22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq_NfAe2PmAQ7kNvwH_5jpj&_nc_oc=AdrlLUerchTBmpFkpnInUzqbZdOeGjqe6VtXBzlWLqSdVUf41hr3rt7PVHH8Lm0lCWk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n5OYw78h8rGqh-j7-yHfGiVpU4_hw2_chZeIjVBIXWg&oe=6A1AD721"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSenLEhgwZYQ7kNvwHGnxND&_nc_oc=AdoS-HBLHayPBgZ611ss5cBW74sLE1J8zCmRyanbDgd1EuV6WZJHn2NY7wJ522KajJs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46Vuccoyb0-VSJF8prsrcALZKM43LPi2X3Bv62LG9zeg&oe=6A1B0362"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiXSQcHQTc4Q7kNvwHZIUhZ&_nc_oc=AdoRdmReaBMol9WZCOAOP4Guirz8Uf1LymdfVYLkcelDkLzBowbm5DWgRlmxfC_3qoQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Df4QTGElgHhBOAx-JJMs5HCpC1wjls_QPintLJABCQg&oe=6A1AE678"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YVREa_CdCEQ7kNvwE9t2dz&_nc_oc=AdpG_idSfEQBgWj_nWgNw8KV-IOsCi8DfIu-joRlHEtqLZedRm4XUUf-RhWKDQCZ8fc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V-lPS8pnBTRPt8VyLy51CzGpZDreJP34yP0vuKGSLBQ&oe=6A1AEB73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7vajzj__OkQ7kNvwGl0fdP&_nc_oc=Adr8FAbnqa7_D-V_oLV3V6R-S47XUzoZSYKLAj3jOHw7Tl7gd8RDwm6LyN1UgbgQUT4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dZ5M94UuUIDvHDnSIltn7GNf5ge9pihw6ytGpor14JQ&oe=6A1AE4DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
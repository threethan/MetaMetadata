_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG1Ranz08gwQ7kNvwG2kQGL&_nc_oc=Adk_jzmQf2gk8g6S0PALORFsf8WUnmQMD8ECzn_vBW4x1fxyFaK8paiFzsKJRkaryXE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTCetPJ0wfEw1dPySKo8OT0irSOBj9dhrW-V6uE11_Aw&oe=69AC1921"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTcWLowhYQUQ7kNvwEPu9ar&_nc_oc=AdlXrQlGxJKsdKNz7y4yt_xHoNNKGw37nVgs3s51tLrTH5t9ss0hTY5urjwtLd3lPIs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyvVuEIOop5XHeXLYIX4euYODiy1h2Whok2InVh-lHKXg&oe=69AC0D22"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xcxoFwijWoQ7kNvwEk3qDS&_nc_oc=Adm1tUWox6bbW3V2-ce0-I8PqIafoG8uHbxhRDBKp6BuaTa7T_-dmO3OCv2vDb81teQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwt2zatMITiGZb_ietLPd_dNz7jWdb12YOBfWZ-TOHVSg&oe=69AC2878"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUNQ8rgLNSsQ7kNvwHtxpf2&_nc_oc=AdkA05XqZkXAtyzzujD5AejaHLU17mOtipCKahN5DBOITiPIVVq5ZucarcWPlB33Il0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxM9mPaEIWCvhRgaNfTeIEMiaZV4iPiaAH00qsd8LzOFg&oe=69AC2D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kB-AthWIVWgQ7kNvwHpb652&_nc_oc=AdktHRlE1oFPfMAXpyPnbRO05xG9SgCbmj4NmwwBn9x2e1b4b0UtYwbfMm9fYnYHtHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPfSFWnXdYd5FEI7dwh4jcwQdxv7-J5ixRmrrWG4IzYw&oe=69AC26DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000
22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZ0ZwYpRoY8Q7kNvwFmjVmd&_nc_oc=Adrh7krpZts3-d7P9K0Wcu6m5JSxWGNiN4Sou25eZRzkVlSIsXwJjpA6F6zk_zm4vN8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6poj9UO5OmAkRP-oZNp3KdhbEwOX5nlWNVRxkx8R4Bgg&oe=6A0C56A1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eix5XQ9icVcQ7kNvwG63uQF&_nc_oc=AdoroTQZxJGWmwwmrYhHuj4keiKj9mV17q76VzsfvzBioKX9LK6RBLIGNghG4BTuFBA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OWAo4AEBWPMeczSxOesPjFSHfUTo3V0YuQLS3GneHpw&oe=6A0C82E2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxHN5572SEcQ7kNvwF6RaJe&_nc_oc=AdoJOoW39H9JQwLmCbfvueVr_DvTkFdcpgVQ3jL7LZs7nfnBWMhCqiZY11vgRT3YE1o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WQzcAehyXIXlmMFY8XOVzPXKgmLMWBnDtgA8wR_WJTg&oe=6A0C65F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwctzozGCxYQ7kNvwFPJd2r&_nc_oc=AdrljbV5UNSS2ctxxsMfBZBpKU2nYcYc2zKbqVdB0d_PdUjEng4oz_L5g_KtHKueo9s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BBDV1R4HYlBh3z32LgX_IEn0yCLl7Xk8jonSQJNmA6w&oe=6A0C6AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTTIt2_JPqkQ7kNvwHSS5Xc&_nc_oc=AdraKBMzfkuVwtiae2imfSvPgL_q7AAog0R3irw7jGYZTJxWMQpYeB2vCwfuUIrURcM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yPFuSN3LhIM0fqWOH7Q68kiAaIayGTetjxkIzy4GizA&oe=6A0C645C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
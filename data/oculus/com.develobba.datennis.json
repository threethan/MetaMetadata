22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQ0n-LN-HrAQ7kNvwEXf2Nh&_nc_oc=AdrKK1aWX7ZqZdoUO_RVZ27r-3BA5BPKCBHoZC5Zobomuapwh1vWPCm-mz_wgo7outE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvPWBod7Tg-UPuJ9SwwknhKY45tAfHT8q8pBrJ-0PxKw&oe=6A4E41A1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHjM5_H9QjAQ7kNvwFIxnKN&_nc_oc=AdpxLwtvDJiJyC8u3nTbMeMG2l0weG4gmooSjXrIEaCimj2Hn0WoBpBac7R-CisPAPQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwRNKUBSBC-v1v9_WFEQI-H-4y4GP0Jvby3_5mu78Unw&oe=6A4E6DE2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkybaL3LhuUQ7kNvwFO0AxC&_nc_oc=AdoniuDuu1R8IO8Jsdzr7bDlIHN5MJ0wQs4xNcFmMEhPsLXLu3G2D3Qi7l2VuARW-dA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG8mv_6ragrhJBKX2bc0wIc5fVlNhkyMLx-01biBXgRw&oe=6A4E50F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USPCXnonwqQQ7kNvwEJY0nK&_nc_oc=AdoGLCgCr8KjY7VJSWpCTKqJafkUQhT1xId6zKJHj9UhZW5f11rIAjwen-MPdQhA6vQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1uAOBaG4jx_3kMEm4cX5ZmXWJsz-cYYJt_yeuOp9jXQ&oe=6A4E55F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITH1C0bu5SYQ7kNvwFqaUQx&_nc_oc=Adopw8QHWpZrHffRv7bmGyE6gYxxGCLgwVBwlroOwLWR8tlJlL4d_172Gnll5J8aRjQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsrGpvFuX9a0Iiaq9IUQYYSeJHinAczQ3wSr9xr7Xh_g&oe=6A4E4F5C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
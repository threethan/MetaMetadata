22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgheXEiLSxUQ7kNvwHm2LDA&_nc_oc=Adp6bwj0Ba6JR-wpKfjQ8fLBICkdRpremF6QWzbiZT6t3e6KzM50yK9CKemT7yi5QcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRduAxzYsUxnm-HMPurvE2asmrieSroXrnx5Frbb6P_3w&oe=6AEF50E1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB_OeCd09mkQ7kNvwEGz4RK&_nc_oc=AdqTY555J86NJF-UT7eGax4He1IjunDYdPQaNF5Cqf80CubRHSpjerKqu237cUWgnSM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJvMmt6Jo6oCkRXegUdmuNYLQdD1qRRfMpuZHlqIaNSg&oe=6AEF44E2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hC1R3XY5dsQ7kNvwGnMrFW&_nc_oc=AdpZZA3LQ-dRSOgNf5Y3tQn8STPYkbyBAF59AtJZBqNhd6nHybv2V16IjA-4y_BLH_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7Jxhfunk1rzeslc2GvYvfVWPNNWh3pOhe3TBKMhc-VA&oe=6AEF6038"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0hgpsPNbhgQ7kNvwHWeCZt&_nc_oc=AdqRO8VnxobXiA-82xfiWOt1zFwjWK6I0hIzhSHdWpkXs3RP8RD9hZmwzE7P77VLogI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLg7UTodMaCKOj15iRyw-sJmzzg-RndJn6bAsklakgzQ&oe=6AEF6533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zA5QmMfFT0Q7kNvwFxO770&_nc_oc=Ado3kblzcHMVyCIaMqONlzmAVWf1r3VDqmpEUDAImzJ-4rF0h_lUkjqec6jWev1PchA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF9zuvUKPmGes0MANh0jDRSygQFFR6XKO-QR4qvYA4UQ&oe=6AEF5E9C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
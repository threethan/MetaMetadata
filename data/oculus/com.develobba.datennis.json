22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-USQ2cojqAQ7kNvwEGE9Bz&_nc_oc=Adp-x5MxIeOGd5eQRHFky2SDXdbb5KjWjRYOvBoS35j5gJ6bHj2V4_W9Wsszt0_rJ6w&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01DS21ICT4U8PtcVO8FOzBopiQCGefvbKADJaxk4J_Nw&oe=69E226A1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sidA4bjOJpgQ7kNvwGZxDHF&_nc_oc=Adp7ahlIVcHi1Mt_M6wP08EFRQx8uB9YRJ5bsAhxmxKyT7vC-KmPvZTmWW1ns6ZcndI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eDEqwlWgrZSrmAF_Sqvj2LJ_38ICHJniLwNavb9_HNw&oe=69E21AA2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHzVyfUitdUQ7kNvwEGCKS7&_nc_oc=AdookBbrmR3KO79ciQaWvaXjx5AzcClbh12egqhFe4YWSpPgvcwVBPo8cNaNF3aLrBw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af151Igw5XIagFyVn1DkgbR-rJUoh7RqdzytXivDU-AvsQ&oe=69E235F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBUP1RqqDSwQ7kNvwHGEN62&_nc_oc=AdoTJ-Gz_v6MUjWLZOBHMrRVnkSMqHO4IAk0MeXlcTDQ16p3KOzZ9p6t9gKdCdLu_o8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iSN7ir0v5h5ZHrS48SywFw4g8KkiMTRqQn7ue3I_Qng&oe=69E23AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTOODdemCFAQ7kNvwFr58F-&_nc_oc=AdrQ9OfYI-XTYA6Zmi2mx-99tm1zrPOJ_aHwDRjW389IRAg7D5cfGYf-bG3FavynSdU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VouWW73fHEFpN9i_FswmQTGSVdF6SgPdXF0dyVDZTNQ&oe=69E2345C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfijWlO-YXAQ7kNvwEX58gm&_nc_oc=AdoqBX5mabPN857HF5Dw2QnHbie1o3YVeRsNkvyjp75eavjxHvzFhQgw-_qvi1VfTxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lm7RD8pyAamIlQ_nOeO2ytdG0Jpn7RTNhknIczQa7og&oe=6A2957A1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83qidASk8o0Q7kNvwHg31RS&_nc_oc=AdpxgIqLHwD0MberNclRaZ6ZW5HIEFQXzPi9EUtD5V_DXYXhZy-dmxjW-TGgbLHbJNc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rdlXYTlK1abiZ-y8zvY34Ho6RPeEqE_P6jEN4ujMEhQ&oe=6A2983E2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4hfajPAbzAQ7kNvwG2Pf9K&_nc_oc=Adr5VbQS9vRuHNtFzmUaqESVBaU4dowjLt6TUGny3quSH3a9_GjjAWHO-Mms6UWdBHM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93XCMtsXlwU4LxJyAP4oCj6bZKy-7o71Xn1gt9yQy1yg&oe=6A2966F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPZTAhBLFzoQ7kNvwH7K2Vz&_nc_oc=AdpmUhgitC8g04lli5VDtuOT6BdAL2-sFiSN-14lQm6gJTp8Foqz-uAe6h8Hs6hTBbM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8npFa8c0GuPmSiatpuBoiVXFVuHYCV_BET2zlbGFQ7LA&oe=6A296BF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Szwanb3Us9QQ7kNvwFxyIb6&_nc_oc=AdrEnxcyMDsxBdDMykvsjXDx6VM7z-1RgE1UY59No-DmRD76qK4hrgDY3flG98ouiLM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BKRoOxicjSZbQ5lGWRMuaPiYSUfmFHHH5je6riSJ-gQ&oe=6A29655C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq_NfAe2PmAQ7kNvwF6w0Ca&_nc_oc=AdpqLGsxwR3eYFQX__xB5OuYB3DIO7aUsEIltgXdIlVIOEe5i0NX5GpNiBCQVtCE9xc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50dC-5UM7ZYb1LBs_uY1RRrJ6pyGjH_VaeQaTr3xfHeQ&oe=6A183421"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yf9vgdUYffcQ7kNvwHgYXYr&_nc_oc=AdrehIGsR-UnWF2__iZAKkMDglLZ7dTZ3pQInoFRwVKIwzubK34uNtgUHPID5242BoA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xQ3UWYQGuiQlewsGUNLKLMH31FU3fGtshkQ8D-bXYhQ&oe=6A186062"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JNvkpPFbQ0Q7kNvwEcYpRl&_nc_oc=AdrcRjq2edO2VmIZvad_1cZVt_zWBCi4ouD1-5MuOH5VyMzx3XxXYjks8RVPWAfxQX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tXHpqWH0RpKYyE_wlCkQbhYYdiWJX-GBm7RrpZJ6c1g&oe=6A184378"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0DoYcCCtm4Q7kNvwGcecAG&_nc_oc=AdpPMMFjdewx5PJCC13DXGHGx6D_NfJr5CXi1NzBSpt-1VZsFOouJyYDBigvhm7jYpU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gFkLNTZgfWeca5Aw5F2NPUvQBsumY3csdcK_RvUUiiA&oe=6A184873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSnEFEDkecwQ7kNvwFXYDa_&_nc_oc=AdqrQ8uJyq6RdURyxWQygqs1hiuAyEdkxET7lI1mMvpsCx3yG8jYoFryG-LkoOBUGr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Opv8ftZz02tpWnGsZrmq1swT2Xsf7Ky3W9R0D2f4xmQ&oe=6A1841DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
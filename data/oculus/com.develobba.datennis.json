22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmsmbXrmNYAQ7kNvwHw84gZ&_nc_oc=AdpdcidOK3RpQUareWODNMmbSb8Sz3IcgyBSmqElvHmhGPTGM3PrS0916WAgRwosoW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51mCZ77JPqKBa8PdwWj7fDZuCHf3oO_tPD-qsQej3Gxw&oe=6A007921"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dti203OK3csQ7kNvwEGHBIJ&_nc_oc=AdpmkxKFImT8ZhQ9yXWPO5uBlIBuKiYsxVPDg-N1UVaHuOG5MbK7EaY4ju8zu_5D910&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CdCOSr0FvRFcxGfyxG4csKXnPWvljZ9RGgMAZYjqqsg&oe=6A00A562"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2tfbncgnmUQ7kNvwGB4uxT&_nc_oc=AdqOwR2u4xP5rdKSP-w7G8fn5h3gZMK-R5RI4VayNKA5YKklxe4yaDF0Wg-k7UmJU4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tXp1p760g_pDmkqzPknYcc1AdH0dseeuGTxJ2YJtR_Q&oe=6A008878"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QmE2C8aoWsQ7kNvwEvVtgB&_nc_oc=AdpSqwkiFUFYotCyr_LkJwVQZVY-Dyd5VAljiFhaSmuvJ-P6DQChd0ioTw4QEd7wgoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EHIeP19cSJqFZdgU9iQM8wIobc_v-sTNE_seMbPr84w&oe=6A008D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0IkxxjoZCgQ7kNvwHOOmsa&_nc_oc=AdrxfNohOA8xhhn393IiceU9NpMa5M_JlAX5KSesLNgU80Jk9Me4-EZgTNOtvtQq-8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VITMpEsa8wMyYKNo_K2zc5ai8MIpu6GexfiYNsAmZRQ&oe=6A0086DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
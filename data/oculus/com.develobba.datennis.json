22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LnTiFolk2oQ7kNvwHTYp7q&_nc_oc=AdpxGj4HMSKUgLQRtoQzeV3nsc9g9Slg76jI6gYp_iAKimsjFZf-0Do83oH2p80qRRY&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHjLqbzDT3yDQob3bGiE7Qn5FgphuBv_-gchXWFIsdcg&oe=6A917E21"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eap8ySlSxv0Q7kNvwEPR-x8&_nc_oc=AdqxaHQCg0o9m3NTmfJbozsulD9GEul5T7CaJV_G7Fy0v5_Z1qRz-jTtE2CASaAOr44&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzjEBHyYp9Zm0cGgMKASm16WNolZkGpXiNVHi6jyCPrQ&oe=6A917222"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWC5avkgOMkQ7kNvwHjKO31&_nc_oc=Adp9sikGGVwthl9a52B83Uee3JoE4TWw5Z09pbU4Bk2heIsMgrnaL2zF6BSNORici-8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1iPrVTKHE6XurPbXKBlRmNKrdVq8hNs0vgE3kp5H1bw&oe=6A918D78"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GssDM2pHv50Q7kNvwFzxAXA&_nc_oc=AdopRTFh6OLKnfHHuje2otkRIDFeX6msFzkDVlptP_9MpNeb9FlRr2QFJjiJ7WFPczs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8ze12e0pUHqQFCB746ysMphZ3YCdXFgJuo9AL-qDzBQ&oe=6A915A33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsZH_z7RJxkQ7kNvwGkFdAI&_nc_oc=AdonPrgAiacpYXHJv_tkiJA1rL_YKmRtdLUDapweayKqQ1YdySHiw77IBRO7PjWjQj4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHCj5WcfuJ6EeZdHdcLZQIeyGebU8VF8HAcQx-HKW5OA&oe=6A918BDC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
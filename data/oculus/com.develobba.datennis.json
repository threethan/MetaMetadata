22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3H4K6Uha6kIQ7kNvwHQFczf&_nc_oc=AdrqF9uKTqyd-MmTj8QnAqJqDeO10OAfKR_w-QnqAUE0VSu4sGfCLWLAzqVp5uMKbt8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr6DHuDExGPObLYo9Mo7UhzWwD3Z4V4D5L8PNd30IBag&oe=6A86F221"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-1qY_wFLxcQ7kNvwGP7VRt&_nc_oc=AdrQeY6yDRoUzBc-wcmNfZadPygIgoAWfZ2ImXFMogy6Ha4aOJcKzWZDOzfqEjDO3ys&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOxxabT-XUIQiNXr_AXglsEmPSzgGLbDcGMZpfZQ6x5Q&oe=6A86E622"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eS6RNMhlSXYQ7kNvwFQ4YxK&_nc_oc=Adr2xvDl3hRwFaokjLYU6HGHqO6ZsYkA8dnc-BrY2zvEv6jWXmQlLp4AHddJsAH6pGY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj80OeBrmgzYhS5zB8t_Rub_rSEtIfFJqU9xMEc076vQ&oe=6A870178"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cS3f5EHtZAsQ7kNvwHI1p2J&_nc_oc=AdpeKsSt2XjN--OqwJ6iiZiYNASpbgoapDVRkpSPmynRsJuUnVkoP8jtu8V9lu0laLM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkVdu2gG0uH8lzpz2CGHcEGMOhJNQ-cPYm4aYUHxUUiA&oe=6A870673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAXNnPmWQXIQ7kNvwGhHv4M&_nc_oc=Ado-O83eX9jU4dEXIK0f8mIA5TyPp-q5xZ1we5TQ-EZuSiOqeRmTNfi9b9UrHx09lgk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvxSfv0KtOBe8tHOqTgTpmMtm8RqTm9dmi8ctFVjBwGQ&oe=6A86FFDC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
-WSP5GBH-wBMmBcDa3Pf1yckVJzIHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aFW_5RjrsdqKBerEjZ7-PYEwoi0jBSqdNqcHe__WOiA&oe=6A1D7A21"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSenLEhgwZYQ7kNvwGaObWo&_nc_oc=Adp4cGwfPG06cdsTnGDZv4KRiA_wCdWS2oMwe8CnyNhwOlGDE3f7xgtmtPJj4XBoFrY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_NesxbED7YhdBWoXEg3z4BtcCWNA1DqMOVZ-rO88yIw&oe=6A1DA662"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5prRBJh-jW8Q7kNvwFZQEJn&_nc_oc=Adr7rsjc7xNrxWOX9VUkVtEN5f6mhnnuBXzLxSTBn0-XmgWZ2HLApXdkj0KAMeYsN-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WhVsgVwgGt8PO8ohvXd4nurlk1Ll44M_FXTQCT-NY2A&oe=6A1D8978"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YVREa_CdCEQ7kNvwFQ1lCs&_nc_oc=AdqoFrj-purMYQZZV7lEdiaAKX_TPf3JmfQFIynlbcp7WBkOOvJ8N3EJSA0LHVV_bUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZqVH2L_kSxTf3wCMg6oVFOpmCjt7kPqTsyxn3TXrBbw&oe=6A1D8E73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7vajzj__OkQ7kNvwEbgPvf&_nc_oc=AdoVq-afxHG-18ucOCzhC_8QF7B8nkhkphh6F5bt-wCZLivtzY2HnUtMNr9z70EtAvg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62ZxGViMqIADYgf-1kvnep_m0zIHuCYdcIcCn4i5Ls6w&oe=6A1D87DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type"
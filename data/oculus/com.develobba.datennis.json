22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMA8WE125KMQ7kNvwEGVq5E&_nc_oc=AdqVol4amnBeyRq6pr94IljMoEu1BtUaT0r0q_nrLVs8p44EK25Dwm07GS5aQhV_kO0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_2u2Zqfma5C_qPHUI90wGuQIgMXgMW82YogQwi9s12Q&oe=6AC7C3E1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URBNJoufhy8Q7kNvwGK9ppe&_nc_oc=AdovE7ASF2VQskBehErBbvmzqe6E3HIH2WEBtLEFtycD_0D--VteM_QtB8Vkkj5lmkw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc8gnCXGadupS6Xpk0MoChN7hTr9is_8wPCPW-QxiahQ&oe=6AC7B7E2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpqnwJdPsUwQ7kNvwGbiH5_&_nc_oc=AdrvVDIFSb_r7v3Y9ZZYKHKKb2wLJpCF48_bKL99QpwopTDVrBLV05ruFiR5JgCJ94Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4IsICrFGOnVq7w958mUQ05jLFp0bz_3XWqaHLhd832g&oe=6AC79AF8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cxdjbyj5gagQ7kNvwH-00Ot&_nc_oc=Adp91a0b_AzEhPvvXrOizN6At5pISOr9Qj_RF2rgYnt1vxbJwQ0yJJcqb0gxYfunabo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPViSTUTa-FEMJZDBWyuv3qRo5azJqLz3NvPPFOVCRWHA&oe=6AC79FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BeSvp94UA4Q7kNvwF1Nco0&_nc_oc=AdppLlhdwLVeJzGMpg7kwYLcFgm3FKbRIAgsW8YsRpRONstMo6LuvfGh6O4BTUf-etU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRteV3f4-JrFAblY6diQykn3n_U75lCPQj9QmXobXUWg&oe=6AC7995C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
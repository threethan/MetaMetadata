22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MwKjbNab9gQ7kNvwGZm3oq&_nc_oc=Adq-iMOtWUH1PV6LyGPtxWEdpkshdyAOGULAr9l_62M6G847AHvyA2WMz9yu1R2MxwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBI3_G8pESzGyByREmzkDEquUW5_TZlVo8C4GSMg29sw&oe=6AEB5C61"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsOkCuabuo8Q7kNvwE-RNKP&_nc_oc=AdqBGitfS2OIN1YvbE8ohPnpBandfdzEttvoTOnlB8v9EoxqnmP9xX8b6u6DhkJJxfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNdU141oCdsnigrY-PVQd5nbIKD-P0ABtrB4xWnU9euw&oe=6AEB5062"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LXy3ze7WQUQ7kNvwEto_2f&_nc_oc=Adqb17XvFoKDtI6KpY_dWVsBNtu49c_JlhYW0Vlx1RaXkg2NNae3CIDoUEci52ousTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIr03CJ0J0Yrdh7xcjNnTa7cEA0BzmsPHFjkiJwfW_Pg&oe=6AEB3378"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRfCyAVfqgQQ7kNvwEAZfWV&_nc_oc=Adr8c4HWNuc_7rKazFozSbgiFE3qDehYQEucw66s-gE3CJ5t4ChCt1hDIzNwLNgSuGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUSrHlCBHQAK2fIaEBv35fvwAyIv9WciOj0iSAyShjqA&oe=6AEB3873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqRXAqzBZOoQ7kNvwEy4Yzf&_nc_oc=Adr3KYAc0Jbbyo6MAH4giW68iGU_K1aGDMhHwUbTfK_eztH_IUUQDNhpjVrPHcAAfPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA2x-4VUAxDNGGqHn_9VE8ZrtfLNHGW9lBDH4akIl_wA&oe=6AEB31DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
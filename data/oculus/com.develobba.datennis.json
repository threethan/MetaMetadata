22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8mzAVraeCgQ7kNvwFOjALK&_nc_oc=AdpgAO0e7ea_KvKt2rZ_yEb2ZnOUYPF5iDks4A6Lr7a6KFPUQsKJshb9pe3FEVKvmcc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dvi3hZh8MsRUqnorx4f_cCximlDhIGiavD-PhHN7BlA&oe=6A104B21"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8x0fu75w1EQ7kNvwEnFFMp&_nc_oc=Adqk-ZhVpG0g7W4U3Vpl4Cm3j-r6sb6rDfGSCqBx6S-9U871Fe8Yb4PjvXmJk0jSGBk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yz2Qyq6NqkE1KtSAZu_1HE1ZkN9AS-QFMknFCRvd9OA&oe=6A107762"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUY_eMI4j3IQ7kNvwGKCwnQ&_nc_oc=AdoqkFJ6QnJ1yyM7uml54OdZG2xPcO_fGFY5hCq6rxJkLnlGIZnhib9-fIkmOqNhA_o&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HM9uS1X6Tzfuvf2prvSheH6VPTLjPcMrWAPx4fPHTJA&oe=6A105A78"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoUZGsYB0-QQ7kNvwG0dDd8&_nc_oc=AdoRR8ptdlbyLLtDWoUszDXevEF6hNSh-W7RpfRGp_Qdvb3Kd-SPHblQZUU-hZRneG4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52oVUMoFGh1Udh9z5y7ZPVcpo388Q1FoeCizPQ9pyAdQ&oe=6A105F73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GS84-8-zTg4Q7kNvwGqa07n&_nc_oc=AdrvXEoLAiqOn_ThU3XiNoHlmkrHdPL1P5nQs6CZv1AMf6vN-_EzJoNZwGml0ROwZ7E&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qGg540xDT2z4nWSj6XzhKgh_cInGuZ1U8WYMDOqbWTw&oe=6A1058DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
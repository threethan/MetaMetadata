22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QD6oOPuGd8EQ7kNvwEuDPn7&_nc_oc=Adp8m9-mkqI2IiouXNk9xcnomDGVAuEFnKEYS8fLrm8fl01bDSy4N_GMqhcO8MVGV7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pzazn27DBu_0iSxFp9xn9vgZx05EMv60tKOlt9Itm4Q&oe=69ECB2A1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkPxrtBuJd4Q7kNvwFzwfiO&_nc_oc=Adp5E7VNJZR1mJeJZg4Nttr18PLMNIoZUX7DrQpj7t-Fbxh1wQPpQ5WcHPSbBbPH7bI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pXrM7nt5Fj8UVAAxva2-xyE73iNTeFBLjCqi0OeFOMg&oe=69ECA6A2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snUSWqlj2oIQ7kNvwHYyvE6&_nc_oc=AdpuqOf0cg-aTkNEnVdCtwvS0rMaYxAhCifEDcgZS8Fo-iYFsXqZCsxL0h0F-nGis_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XkoO8jaf0LCm2v2c5sWL98O2xb1fIM1o0tQU99lGt2w&oe=69ECC1F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIb3ANzyJLkQ7kNvwG-177B&_nc_oc=AdqLaOsVlFQZ5wyGVLyqX5-73a_TXI4N55h1SY_3A_K-UIKLFW9FUoFTD6Zg11XbAK4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Mqn81SobME3FAYrX7SLm4JGKzSOVlt-dCIfBORcufDg&oe=69ECC6F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoU54AGaJtUQ7kNvwEWCpxJ&_nc_oc=AdpV1K3jN5Zr-GHVKoY12_TOiWwBIfTzBEX5h3eu54NHajFdWEm73aGQ2lW0dc45Fvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3f14qqg-qEA0nGe27V2anvbraB2GXcYBUyNcp7ig5pjA&oe=69ECC05C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEzH5DbDgj8Q7kNvwFvgEAE&_nc_oc=AdqjNIRnT3LKXd8S65heywcCoEzqVu3SnfDBldFV5MK4oXjT83O-H-cGMk4yQgElUYo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CSaIpro3SUuds_moJ7RK0gNnHFJdKJynol1Jxu2toaQ&oe=6A4112A1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRSFUdzqReYQ7kNvwE2oRWK&_nc_oc=Adqa2XfYQ9MAjQhzzjvXhy-_cwrzPjHEhmraE0i4clQOlEueLpUcF_iuuFtd6ZXhiAY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IeEZsbvlgqtYlh94DJQ3M42rSSQQr6XCvTFVkZ9EfGA&oe=6A413EE2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIGCiSfCWEwQ7kNvwFmewAX&_nc_oc=Adp6NpizAI9zFnqgnAmp-rrnHv29KVSTwDWbnnyyHEbJauSTi6Jzsmz2EyW0jOYSiEs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YPvHub8GRXqfNGvV1DX-3ustpOqyvzXqygY-5IdJwGg&oe=6A4121F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ymb1iuEIiJoQ7kNvwFwOMHX&_nc_oc=Adrmy0pitxd88MXRTv4t5C0HUcUescHx0FQsYj1ZRXHBiJjyi9FLN1ZU5c8eNkbGoo4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j-Brvj-o0HADALmMar1BtE24U3Bw5kmb07ou_nPTyag&oe=6A4126F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNOUSNeBqLsQ7kNvwEVqRih&_nc_oc=Adpf1EX9yrP2FDO-6QhxMaueaNjGKfwZgznJRjjx9kEe7JE5dwzmg4TztKBGT7nArvk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bmhlJuHWVdlF-DVkoHYmvxUe0mcRy6oCmxKgjMGnfbA&oe=6A41205C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
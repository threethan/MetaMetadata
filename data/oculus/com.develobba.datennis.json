6099518322589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pDM4vpQtiUQ7kNvwHfsME0&_nc_oc=AdqjQzZzdwNQSUMiwpMpJSHg9_N-3MNTE_eXxnDSbkl2458bxQ8XSjaKzYgoV7zCMbs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIr5ASTmBcKW_mfJMqmCTOdfJGoxyNeHWlHlHwE1G5bg&oe=6AAE7F21"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0GTQ5IKDTcQ7kNvwFLTg52&_nc_oc=AdqPTvllTojqHRM2JKtlsN9j6oes0Tc2Z4smKqH_eGX8x8UCiZW4OTJEaKFrbPmaHek&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLq-my8XBinZX_H0bOYmtaezbu6KF9e21n75SlkuitM4g&oe=6AAEAB62"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytvOUPXmlU0Q7kNvwF535Qd&_nc_oc=AdrxqPQ-Wrcic2pahQHjhA-8RmE1TvOZtNNlajO3nfSjspMGhVIBve6Y4PcsfYmrocs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHPEyLAyX4E-60MtkavEtx_OcViGjz7N-8RNGoB75CuQ&oe=6AAE8E78"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC2Er9dw_fkQ7kNvwGtk5X-&_nc_oc=AdqSgWt8R2OrNNcLGa4-mwQcbVRyxByxNEMZPDLe81mSx9EQNg1XenH6w1tdz2C56dI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAZ7snT0hogtK1HnGU8w0o9eyDhsQ3RaZzxo_3NRG1Mw&oe=6AAE9373"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSnvICgErakQ7kNvwG81w7D&_nc_oc=AdoifvvG-w77Zn9tB6eYuZqD0DT2kURm8rkBO6YBQvTyvoDSd9mqFrFVyL6cJAOuAV8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4bqe6ITFQb4nI8lsxMwZ55MA-0NuABNAzYFS97DUWoA&oe=6AAE8CDC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9-PCGpLJqEQ7kNvwHpzkXc&_nc_oc=AdqL_Ax4wVxyzTUb3oaBsg0124PIIK6sd6QZ8Fnp81ce8oom71MEecnL-M5W6lcgTaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAZ9cTSoP9s6W5Sx89a8A75m1TkBvffvFY4ICkuM-Fxw&oe=6A523621"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HE3ZWMfSGDIQ7kNvwFp6zBn&_nc_oc=Adol3nxp_DHrvit89bWAYrxtdFec9eWVsk3OX598Ni9eoF6xi9nf5tXX26Sknd_cDdM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZg80wls12oIDtpmmUYp7t_fdmsQhBssvGigzpGcx3xQ&oe=6A526262"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgDN14pypXQQ7kNvwG4cYSd&_nc_oc=AdqDFkmFx8hW7rBVugcIZAWjH-vgq_m_VvmVkxjAqM40kOALGH5nHxEfoVfEYWzEb6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmmdEknyJPEb9YE4IAgDX6nQGvuWFqSR9O6G1fmSWJ8A&oe=6A524578"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIzOKLV2z_AQ7kNvwE0Vpe_&_nc_oc=AdqnceqyBEf2z1xch_tzzjSnmKB6tuYAOzUQrq7TohE15RqKF9ORb9qR2h32xc6nOxQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6t5_LzWiB7EsOSM5hcBg3iBmm2rDqoVrezr15pcOK2Q&oe=6A524A73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vjk4NMe_X9UQ7kNvwH2gusB&_nc_oc=AdqahxG2hijCc6VktjVMDGUqy0tkpeQwCkR1Umc1KaOlfsQGJXBvCuTd5y8uBg7vjxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWXGi9nGZd2QL0DIRkci0ov4SWmUfpNeB_tOJIp7KM5Q&oe=6A5243DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
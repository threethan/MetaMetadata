22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ox9S-KxvLCUQ7kNvwGg05yd&_nc_oc=Ado0vB1siWWGbTfaETTh-tOi6IwCNlnkPvi20Lu6FYJy8H7FYStsFQqJvgVl3irU9wQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkt-HtRouk5oRfpa4eQ1l_KlN81HnzYm4gVq22YtSiMA&oe=6AE48CA1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGXX-nueKycQ7kNvwEq3UuZ&_nc_oc=AdoSbWZdyOJgSFWup88oTAfhjYkF9Vj4ucdWtEid1khGTOmyZGx4J6YAtV_WY7LuUS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNmi3xp9MAOrK_fQNeRnQDr4G1JmikeJtmSVQkILQ3zA&oe=6AE4B8E2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97wH9QUoGRoQ7kNvwFR-P07&_nc_oc=AdrXH2DdKH4_z3aOJ3F7BKef3rp2EdRcVMbWrvR96sPg6_b4zAHykMj9Ykm2Q4J94wg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWF2alLPadzNZJ9f9sNKbFMDW4KImgO4xk79GQA2CZIg&oe=6AE49BF8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWhf7Md1zmcQ7kNvwHRnKxp&_nc_oc=AdpRZipL4jqUJs7sMmGYLEGNKvCahYwHte95CIVAuQWE-NQ50GuR8aWEH-IERT4v-CQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4aFD6X-cj6yeZfmvNZROV5yFH2dM_kGJPiqYs92oVKA&oe=6AE4A0F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dhhumE-8moQ7kNvwFMArKT&_nc_oc=Adr6im1atn5vrIBp3a3EBJfCjsF7xS7vACYnMpq90lerV0zho05nwVJL7HmUm-NeyD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJoJDuZJQwMDE-M49sa8_ReGG5O0bEbC-zY9L3DJPOCg&oe=6AE49A5C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
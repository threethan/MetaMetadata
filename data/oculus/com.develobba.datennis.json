22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87WlabrAyjYQ7kNvwHPhQMA&_nc_oc=AdpB_veMfNy8zHhQx8XgoF_-U_ACRUzv9yzsyDQlH9cPH8TFiJw6bEFYziMYkeG0cZo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg5TZJwcsd54dQfXZ4bYoZ42hwbZyfNGB2yAOAsRgp1A&oe=6AE8B961"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsOkCuabuo8Q7kNvwGnb6x6&_nc_oc=Adq_JrFc3Y3Y23uPqcoDFD9suSfw3Jewt-hwfhbsIh-phyhhIhRtkZcn8pptHx2yiYU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzRW0GKpZNQyrHenz3gsfUs2UuZjiIg4hxsVWq58lt6A&oe=6AE8AD62"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPDmE-A0cYsQ7kNvwE9DtKz&_nc_oc=AdrJPTKy6jzjg18tR9hQscrISYV0aBLICOjNqDrUPNqo1J_IJqpFp0HH6-EEnQpBxM8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTls6vU0EXI6ilEh4KJA-_EiZTZDQ_kvh37Yx4FlpwN4w&oe=6AE89078"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRfCyAVfqgQQ7kNvwFViAEP&_nc_oc=AdpHT9K5eVRjTIAid6523IShJ9GgfD47vqerbwE9ULc5cuimLqMArpQ5B9xHeOnsZw4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-LMxkCqxYLKhGldAd0OFZ-9m7F5KFVZzuGEf5N694lw&oe=6AE89573"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqRXAqzBZOoQ7kNvwGP-fxe&_nc_oc=AdptTsRGh6OJrw0lekEWZg4xaR69j724T_sDFuAkShibwzzPbNqocdIzVv9LrU7-vs0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbV4tZH8O6YBxSAsPUcgXe8CH-6T6e2wntkzJZMmbf0Q&oe=6AE88EDC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
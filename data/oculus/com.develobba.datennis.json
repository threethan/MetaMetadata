22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhRwhntnKeIQ7kNvwHGjTyh&_nc_oc=AdpAvoBmPTV7Q2-mENqHig5QKX3K8vc0x0r4lY7TRG3K3ckAQvzv6cWA80YdiroiBUs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXjWviYLqtFuwSvVuNpiR7yNmFDGr8e62HHVsH_gwIKg&oe=6AC520E1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URBNJoufhy8Q7kNvwHY2XNm&_nc_oc=AdovdZ35RjpTC4NFoIKWYAp2wbnaJwZ7hzb2KxCsqnz9Xt4XfzH5R7jwoxZccxWfv0A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNK8oL_atTGMasoZdBet6fEbQHV3oazyqvVFsfxyvokjA&oe=6AC514E2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYZIoLiNE4YQ7kNvwGklj5v&_nc_oc=Adouln_8va7j2lGy7xfjVuWhj8VpvxGUNRWBk1HAbbhmZ3H32aMD5bWp8F4w4-SxgRQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-1ApBHTWt2oKmBZUrBx6fkvUW3p9-8IkUI0cuAfM5Fw&oe=6AC4F7F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cxdjbyj5gagQ7kNvwGbIsg7&_nc_oc=Adq2UNHcnUg9c1PSb5O2tEDBvELmQkt_vtK_Zf1bvrOMscKFL_4G4DiY2PRgh9fCUJ8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzOuJjC3nyV1qkN21AaY5LpZ5FgLi1dU3kq7jVX0FdPA&oe=6AC4FCF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BeSvp94UA4Q7kNvwH4GkiX&_nc_oc=Adr_6vGkP0AF4fDuyXVxKKHB02KSf8KOLreTH6EnbyXC6L_vHA7exrRjz9u84LSeduo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJWEUI13tIyWzVW_ziK7ngORgjt6WJTf4ThVvx4A994w&oe=6AC4F65C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
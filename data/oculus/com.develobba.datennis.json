6099518322589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8mzAVraeCgQ7kNvwFyg9fj&_nc_oc=AdrX31aM2BeR2UgZHAEYFH8ttGgWnlOXJdCO47mf6VBM-phPAvvlDpjpxtJWQqB6PXQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ms-eRQpbKyjy-9_NuK0fopjANmdHS0Sp48X5PGiTRGw&oe=6A119CA1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8x0fu75w1EQ7kNvwHdVfXF&_nc_oc=AdoNkaKkAevYDWUdNkUeLx6FAEE02VgAJC9ja8w1U9ve3_wWPJBfE8eMS__BmwEYkCg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41qhc3lbK_bGeii85sMUQfi97-aOv-rj69pbL5L4G7qg&oe=6A11C8E2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnpbRdhS5SwQ7kNvwFFO8XP&_nc_oc=AdoUfQcbAkTJoroW0wkDlRLpqsdOUpzOVpWFbiiXffE6sPZ5bctEpCq_seyOBNSlWDQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xiqiYj13hQXSNEy3iR9IrfBktbW9lxjxMs4dzEAef7Q&oe=6A11ABF8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoUZGsYB0-QQ7kNvwFYkBH0&_nc_oc=AdpULJGwx0Ld86DdgddqMs3M4I2Vbr5KpdDIDVjrwTnRsATwqFqyAda70iXL_PAl1bA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hQNo2zTJ52GcjABdyg4Oa5SMcfmPgJkTovmsTkvKULA&oe=6A11B0F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GS84-8-zTg4Q7kNvwHi18iQ&_nc_oc=AdryQOMK5k1GX0ERvXaML37JV5GE4MUZmquUHmYaLYx7GVfES4QYMVy7Et2mwrb9zjQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x6KxX2jSqfUhmNLiqbLhGjGloeNDXzY5D2uSDFRjB9g&oe=6A11AA5C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQ2brRIpwM4Q7kNvwEybCqZ&_nc_oc=AdpYkhYK24Q0M8AyQT2wND2yk3gK2cmwnBcagFyzMswAUVsut4wN0wZYQQm88u4Wi4o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ILMEkSCMUi47j1pWEzdb9_ljzUMUAjU7iAP6VEe71FA&oe=6A2449E1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DB9iRl8y-CUQ7kNvwEKHwrL&_nc_oc=AdpjCq8A8khSc-YjYmNYDKEdS9BhrCwudugidtR3iQSPpG8Ft10QovA_6htO6AQWJ1I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VMdbLuBJGPSlJZdF02NeJPJtmohma2SXDs9lNVHHrvg&oe=6A243DE2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayHFMWSC62AQ7kNvwFSseRH&_nc_oc=AdqoVrcd8ey2oxw9h-7sqosRTWMbPDW7evjqzvOdG_3eO3eM-p2YpoR09070oDwTT-k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o2Nb16hzKrPa5M-YRbiE--2perH-nZ32rQ6MlnnkyyA&oe=6A2420F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS6BwvDZqiEQ7kNvwFIhijp&_nc_oc=AdoEKGeBYRQaunMnUOc3bqFvrl6hcyFJJAOZJ3d9kLq5jp2UlbDFa_DTlhKRlduIfkI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w-C1rg7qGoohAX3oZ4UmdJ7z9jIQvNMNCX5Qw1L2WfQ&oe=6A2425F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hC-LT4m3esQ7kNvwHMIV7X&_nc_oc=Adr-BdXrmTtuvDCoUk4nbkAVRGcYJmpX1umNJwI7lWS9UcnvdM2JN_O8ngFn_PzDXks&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wrGSwvjQQ5nxJmGmiSqbkANs_3Yd2hkgx1yww84jiHw&oe=6A241F5C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
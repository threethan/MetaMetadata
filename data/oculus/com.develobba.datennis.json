22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7oNEhgud-YQ7kNvwGXvob6&_nc_oc=Adr6cVfJ_R5gxH6tBRmp1P4g1a4WX8519MOI9grvH6mGbwICoJJg0m2DdMKPA0uzYAU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5IIT8ex4mPSV9CcuJkfl7R1Fv1H8D6EcC6pnXtbmRIQ&oe=6AA544A1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8lTXFYoz_IQ7kNvwHW0rGp&_nc_oc=AdrvrlnODPVSk-30qmzENdV6ZuMBcHeXhIm-X9O-A-lLBUXTMlUc2JbRSGALxymV80I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk-wrcZehdUPevmlYOSJ3_-U9ibxPA9h88DkI9l_N3cQ&oe=6AA570E2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8V_SwcCnF9kQ7kNvwGZrLVj&_nc_oc=Ado5TDPUAAxNvoMdtXnUL-2xjPOR4vPgjE2R_KmCvy_Nxfwba7QQuj5Wpks6A8qMfUI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItOCSoje5LajtoMhV76GtPyCr1ovGmiah3TSKvxuMfiQ&oe=6AA553F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QQ7PDZaUAUQ7kNvwG4VFtQ&_nc_oc=Ado8UST7b4cZgzXn7KPN3QOVvHrdzO8a6tI-5QhfsMuFJfjiNotGvI8EXAqzCGKwabw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSnCq3Jlp-0eG3dipJS0mPbqb-RkQA_mgeuvUcuNc7fA&oe=6AA558F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxXdmH2I4CQQ7kNvwHPxBxQ&_nc_oc=Adr1YHwejCiM0OHArtDuWUY9IQ2SUgobkVpmOBTMUJnTgF43Kp8oA74K-oYMO5vFoRU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyOBmBmLZmzJu3wFdvaDWWTd8fW28qa7U5AarR_KSV6A&oe=6AA5525C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
AgzuVzK5hJhJj-xB8AdvR0rnDcsuko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8SfaMZAs9WwJ8ZLr-maHHfFjllXKQyqop7TwvyaCazA&oe=6AF88B61"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2TOqnASwWwQ7kNvwGlcI38&_nc_oc=AdqtgB-EbW_PyZ7_AjK1i6YgOCpcBQR1pY-nTnuY8aeiuM9Z8xhgwiWd6K_bTkJFTXo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJBCeWeIo1swWvzwdlgYSqSmgUpFpkQlZ8IDIx4iz-4w&oe=6AF87F62"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lEB6d3lii0Q7kNvwFpDZ-3&_nc_oc=Adp9Fet4fT26_ECOJTvDVVadF1-NEoIfAeVIP5tsvLRxih_mGBIO6ofOEzijYY7iIfs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmAsNn6lKQGxj5VupdjrV4VTKW-c3kZJbBFFJ7emokwA&oe=6AF89AB8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JW58sdXc4BMQ7kNvwEx9P_j&_nc_oc=AdpS7Pb9KP9C8ZhQTEvJPLfNIrATPGjDm7lPY6E85VbNasUkkZnz3KQossRlC8e2vMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaybLVJsseiz0wgttt2Y5jL28_Zm5ftR0mpHXnOxLD1A&oe=6AF89FB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mN0Ex09b-7AQ7kNvwF1y7lK&_nc_oc=Ado0HNxonXVCRkchS0CAtzVlmJWlVOY8MpMdqO7pJD6ujGkzyRXrOPxof1wYh40ojWU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeQQUcW-_zDKGpNtN6j9kw0Lv9MbG3uwpJKpY_x2L3CA&oe=6AF8991C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type"
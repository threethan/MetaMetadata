6099518322589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyob5HmpV8wQ7kNvwEOuqU0&_nc_oc=Adr2mCzkE80AxY3pkL0IRWrkCnagBH7hqMQzZLVo46HI1POYm4naHHKulsj5vSbwfEg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XN1xMSV-c-BpsB4lvTe2HAOn5GeIZ0LE7jSVYTi8R0A&oe=6A36BEE1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeoXndUmPXsQ7kNvwHCH_jK&_nc_oc=Ado70A7S1Ut3pYJ6PaKaB80TcnjR0Vi54UqetPZsUmUtXit0ATiTCz17qJXT6MMV1MA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1HCzUksWmUc0lcPEDB4hzluWiUOEFC9I2aYuN8vO7Zw&oe=6A36B2E2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t6Gpi2TRS4Q7kNvwFp0DyX&_nc_oc=Adr9HrG1AOiKhNrSu9_Uge00-1bZSBh1e8WB2KyHuJ9ZEJyUg1KwrvY6sMCwKgDlMGA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Sk9-HTiRkHGlPLAntuUqMDn99wx92wQ8rc9Id0pgn1w&oe=6A3695F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hkkdbw30HucQ7kNvwHexFJc&_nc_oc=Adq9qTTGMoplBGM8D7ZjuAplmzl-rOm5kYpljKnc1A_75-Zp93TFfpwIeJU4v3DUZyc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vZQqNHVk50SGbA-ZTwxRTdmWLvJORFy0OC_Bc_17fSQ&oe=6A369AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWp3CRU1GZkQ7kNvwEQPA9N&_nc_oc=AdqJeIK64E_gg8Vlm5fGCH-Pb1Eo0eVMN-DLsEVyDyKhqbITLBWhY7vVIWi_WZIOC1g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zc488UlswSu4O6tFNnNWyvYR5moMJi84cMJw_NxibMw&oe=6A36945C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87WlabrAyjYQ7kNvwHElGv2&_nc_oc=Adqe53IV64iqRwEnhhL471ulZ7ME4yrCNY-wNhkSOrntp4KpCRwofOzF3QoUksDWPmU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0tmgXnRUTY5z-IK0UDiN_633iRLNWqQH8sKrVO0pn1Q&oe=6AE767E1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGXX-nueKycQ7kNvwGHPL60&_nc_oc=AdpdPSlRL5etTgZMhphzYZYy1SkXOGkpK2jSI6FkeueijEJ4c0NGd2HCmxtiuuIgxYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp9K6MWLFRpWMG1rgLsQe6J9hd_a6JCbp8LAEQxCJ8og&oe=6AE75BE2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPDmE-A0cYsQ7kNvwHuVA1T&_nc_oc=Adoo0VwImSY7UPAzpIvdMpdDiZ3xM0fyRkQD8k361CSjvJnhrSBZfRASCYmTRYkq5f0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4hgEtdbYP2pcvwMXkd9vyng1tO9BAdIDIF7Hxaihxkg&oe=6AE73EF8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWhf7Md1zmcQ7kNvwGoS3oe&_nc_oc=Adpkr2xms1v-V2kjgkduQgwEjT7l3kaEH8cEvHP-Oh54rkdBt3sbYybjjcwj0acUktQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU3hdOjvbrOOKfNV9iBBaRLQS5R2Rtg03EwBqW2n7Qug&oe=6AE743F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dhhumE-8moQ7kNvwH4neCC&_nc_oc=AdokT2CtihKZJVxEK7bKZRG_Aly2PpE9eyf3zfS9ieCbIhsAcW9UktC7q9MfgBi_CME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWb-heIdu1IzXTUauml89UeazUZfUt2qjYSt8IqUGttw&oe=6AE73D5C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
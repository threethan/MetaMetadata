22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgMnN8h597wQ7kNvwHeYpHQ&_nc_oc=AdrIQGq78kuiLKflMLYEV7ikAN72eEtfS1MkPB5L2PIinbx-hNuJkY3HvowQaArNcoo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF4bqJRK2Yu_d8EzkkIlJNRUtYn1sMpK-8plVsrGklmQ&oe=6A9FFEA1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYwqTwKzonAQ7kNvwGyfDbD&_nc_oc=AdqOA2XSFKbmPpSA8DWMwVPAShy_ZdRxxUdWRfcWz2vJh6mMIu0D-SWWrVROdJqGRCg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVZ-gf7EgTeFp9GKKqLR17Kf-zRos8Tht0KUlhYrJBWw&oe=6AA02AE2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQdNTHmlxLUQ7kNvwGy12mu&_nc_oc=AdoV7XQ68wDkk8waWcoS_ibFTzFW6zf41q8xiZ4ZBocYMJbZfJZg4X-n48mlwUYklX4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJybVUwe9-qQLfD59N1SGe1cueWO7y92YytjASuRR8I-g&oe=6AA00DF8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQMOBCBkYM4Q7kNvwHCUIvQ&_nc_oc=AdoWUkj6IoRS3j7U05b7Ch1kShv3uVCTSlcQ6om9kWPSIoCipBvOey7hoqS87g0_z3A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQBqVIkulj2PbetNCM-OxGHkfjJ5ppYE3pmIF7I6IkLg&oe=6AA012F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaXRc1PW2NgQ7kNvwFVrstx&_nc_oc=AdqFyrrtzbyUaSHRyINuMRtpntuV75npjhG4eVD2VS300VvYT05bX5OpsBZ5XSM5G-k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL_FudObR_QDPKsL-I2rjQmaB5AO820uLp8P_WtpHKtg&oe=6AA00C5C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dap8-iyD8lUQ7kNvwGcs9W4&_nc_oc=AdqKpXrYUM6qIzJDuJ8ycPimDtDeoCgP3S_8-NYBoTpivRVtSqbaXxRCAxatDCKKDyM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr15RW1TLVZ142r3RvyB3jTnTDDP9GbZdGPb3xe-bmqw&oe=6A9734A1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQY4o_rkHLkQ7kNvwHOgObm&_nc_oc=Adq2UII3tq4E1YSPK0ThUj-v555dcmaxKT5TQktSiW9K0oXNg-4iduYok0lWMEMSeuM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0hI1A-ni22x4ME1g98qr0fvknmTx4wBtNc2CTURf2Hw&oe=6A9728A2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0n1w63Uxn7YQ7kNvwHD-wVu&_nc_oc=AdoygYQPc39WsDIMKDdkLqQc-vnsz5eCPmC3aeCu15yrxuAsM_7WISJHrHN66GZLIwQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWoQQEWc3q54VBPTfRcm6S43ZO5bUVvuNR2lx5ZFMVBw&oe=6A9743F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wH5ldp5leUQ7kNvwFFPhL4&_nc_oc=Adogzmwbo-NT1A527am-Ueow4lVr0_2NFshwwTo3I_bQ9LRYTJ2TLAu0ap3utx7Z3vk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMJUXeM26nebCwm93oIjyX8J4n_z8XW2EUCRaRHFkGgg&oe=6A9748F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OTNx0AzsdsQ7kNvwHBGBPQ&_nc_oc=AdoSevVTFzJSFtOykpgRh8_6_QB6BcogVwJHUAGhJuSD6WxTv29TCiwen-ECSp_UBjM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnhECXY7C8-_OLiQsJ5EEctedO7m-KhlXrxlT3_d7usA&oe=6A97425C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
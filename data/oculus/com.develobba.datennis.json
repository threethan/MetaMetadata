22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxILzRP3BlUQ7kNvwHSksuL&_nc_oc=AdpdBz4UrxiI0DYYjgJhsBTVY_NK65IlFjKuAQ2gTkTYRHVz-6D31wc2sJStEd2y49Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDczmeuc723f_8PALSzuNbDauqbZrtarHAmLubbSrBWWw&oe=6A54D921"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HE3ZWMfSGDIQ7kNvwGVYVx0&_nc_oc=AdpKhet7Xe5Qfbrt8Gj9PjizKFZMf_87Kj_7mwOW8fzeqyVerLFK8ZiGyK5aNNMThJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDak_BcuCrYKn_NtahucqDOZ20fJAoxaG5TlK3XK8JYPQ&oe=6A550562"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tQnZXCrheUQ7kNvwGVN2gB&_nc_oc=AdonjUvgr9FvRMlcERUAz4RDI99sucvpdjWsTPwQMyxG-W2z3vytqn5bbG6_xjrfMJc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW7YN4pMc3cy3sN4nCXY7NJhRrR_bk3aM_bP8E-bNH5g&oe=6A54E878"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIzOKLV2z_AQ7kNvwHVYWD5&_nc_oc=AdqQPO27j3e43IUJ36kId_h_tsrVGBU0cQOyDzXfb7PJ201uOlB5nuCUFnpMWr3JxvA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlCB1DhtJ3WkP8Uu3UofIUWoZCxYY2mnc5s6eRpH_1Fw&oe=6A54ED73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vjk4NMe_X9UQ7kNvwHcpLCm&_nc_oc=Ado2RUmc2XHj7zmSqaxNFCDQmITubNbbzrBSd_g9PixDMvsy9Ag3Btq70dmLbJeWDO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbHeigr0uI4q7R6WHybMePHxWKN2siCVh5q2AS5vQYEw&oe=6A54E6DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
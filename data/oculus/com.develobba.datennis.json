22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dap8-iyD8lUQ7kNvwEVK9r1&_nc_oc=AdoFSVzoHN4-HpNrs_a3Ri9U_wlZhmOUPM0QTJjiTBgLHqnMFoM3GNPvSmT8uKhN1oA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_8iIW6G54xVGUT_BJZgRup_3uIV7YLsnu3monDAz-Kg&oe=6A95E321"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQY4o_rkHLkQ7kNvwGq6Qyn&_nc_oc=AdpnBUKs2ECGFqMoeRUmhMWTpsMQ2efFrEELm4TeLQw6XY4eKBATU03j-Ezukz6GPxw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKl4RrGttdd0s1YBzWsuN8-tIMIdqjODiqFa9kYHJcMg&oe=6A95D722"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0n1w63Uxn7YQ7kNvwF2K_VM&_nc_oc=Adp5-PGtifiDy-oSNIthHr6lMGRYw1NeFyVsYpSB6Fmq27uDtar_XbVzF5gQBEop71c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlde12tIwb-pF9E7qozTZwiC4s8Djzgllem1cF-CDyyw&oe=6A95BA38"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wH5ldp5leUQ7kNvwHKeho1&_nc_oc=Adqlb9zZRVqHa9IVMXe3qP4DnlHxZ78yKSa8s4qFCC31jEpBb_ff75YNhqMWdux5cRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHbvheV313EZbFD-L6IKd93KuUSv_YRNnyAgKHcfQI-g&oe=6A95BF33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OTNx0AzsdsQ7kNvwEmN0t8&_nc_oc=AdrM9NxHfzZgn__dEB4-u-FBhRJ4s3fgE4OMRsCQj6eW5Bbhllf39FF2q2PGDk52xz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa7qhB74VC59jkf3pnSuAvcytJb0Cplmyzst2YnolZ4g&oe=6A95B89C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
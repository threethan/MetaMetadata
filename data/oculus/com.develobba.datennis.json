22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3H4K6Uha6kIQ7kNvwGtnPSH&_nc_oc=AdqiAej_4plKbxMftIGVeHpyREH7is9bIB2vbcJ476NlFCTlROlg6_g4j4Pi846tuUA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcw5s61mhole8kG0gMdGhCGlHYV_sD4XceNlvdm0gzyQ&oe=6A8843A1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-1qY_wFLxcQ7kNvwG2zHj6&_nc_oc=Adqcw2ZfoDuZn4DNVAOX0oEwUVzno216DzGsZYTqCE8jDoNYLv21BQk_0y7HirlZDwE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBot3moOmxz2ayaNmeuLiK0hfBK42Vs3gxvh8BWEGXHw&oe=6A8837A2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4-T_y8fTlIQ7kNvwGOpcW8&_nc_oc=AdowGtj-vU_O2MxYNjegcMDIW0v_72q9CtucjzllTv2V3VkmFmGhD--7If9wEtCn5q0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdGi7-VuAARNUlZcaMvra96tjpLFMc37nTlaxF0rWtSA&oe=6A8852F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cS3f5EHtZAsQ7kNvwFWo_Sf&_nc_oc=AdpQrVWAp0efQrRZctHnxOde-RKMlMaCiKwk51wFgmRXHkGnBypAIdFbw3dzTH-fqn8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3yHNBUBK9N2Mw3bcB2vphn3X1qiD1MXDEm1KMXv6bnQ&oe=6A881FB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAXNnPmWQXIQ7kNvwGy_uJy&_nc_oc=AdreNuOErStuCE6X96H9aMAb4C47vh6oCMZrN6jlHULY9Gb5cJSRg7KcA9FwBzqtvVk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQi2HxQLSe2aizEGoUnMRxtFsBB-ItF9Lybydphinktg&oe=6A88515C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
c=AdmF7wtI-h9O_XpML0oIdxVq65LE5XypmCQDi-xbk_J7dlypIdyGGL2I8sTpJICkOik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfteTe9vL01zMS-QEshQjhYehya5r0EFykg-prKGD3e6Xw&oe=69A6D321"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qms-1GT4-8wQ7kNvwEHt16m&_nc_oc=Adk5PuRakDxOi0Wwb_PsTtpPXBjhBFN4znl1_0b9kXDj5dHipD2pqRruFlsBf6pIQzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-GNilHvLaMA2j5-iGA3HPgjJxrcueoWsF1_iQGkvgZw&oe=69A6C722"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvHzejufRVIQ7kNvwH0CBlR&_nc_oc=AdkMbLT4o36jPeMOPEodlzMIZ3cV_fT5g-HKAS8QGemD8X82JrJaEIl93uq9_uCuSPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvU6z2abegBhVjPkJjkjDtG4ijSiL3JldFiGdm86ZPSeA&oe=69A6E278"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz7W5eLrJwEQ7kNvwEc2Ky9&_nc_oc=AdnSQAN3_23GNQCi27EvbkNnKUL4cvUA4uwUU-YlPHpjFEJp2yqdODX7GDaYUEUlv6Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfubMa1jrtWuPeoqWVrX26jYZip_mWyR_nveMoatPQqPEg&oe=69A6E773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFAwLHAV5lwQ7kNvwFjtLqp&_nc_oc=Adn1v5wF2mRLLVzB3uyqzG-pkfn1vBwMTPqTfNzyx_8sAJq9mpjCJ7AJlfY4_wRhahk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswltnLuShI-Ti6TBtEcVkazaGcksHEKCFAaK50yEgqng&oe=69A6E0DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres"
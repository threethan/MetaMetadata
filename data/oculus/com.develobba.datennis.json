22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWE5wqxXUXQQ7kNvwGb8nCS&_nc_oc=AdpvJ-CpFU6tSvBUta93JCRVzbdcWTWOOfzp8zN7SsV8eZpIBn_cHzo-NnjON4wWoaA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9m3y4TG7dvQLKd0hPeh8gr0lhRs4-LIkok3AjUKPpXw&oe=6A65FCA1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xdr09CytDuoQ7kNvwFNgxXu&_nc_oc=Adr_UT2HTkUfuiG-_RjY2XMWI5bxfwsPKNJGvTmZqYcG-KfK5TO_kFvyj3FF7yiluHQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEDLR8XvXZVrhrU9O6lWRZIh88HqG2_tRP5x1-zcrmkA&oe=6A6628E2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dpy-zJQYp6kQ7kNvwEW0RP7&_nc_oc=Ado9__75qRRmcyiiz4kzE3pO4mHNTjzfVtQx53LSJSD-KH7FnzmwJMp1qmt1hH__D80&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjjABwXqxF1VVow78moLTQR0WwDsGXod3_0rnNdHk-iQ&oe=6A660BF8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1QXGVj16hIQ7kNvwHh4lVW&_nc_oc=AdryYwbxEs0Q7184ZyoPwIfD3w4RxKzSVNBOOLOrCfNyvQ1MNr4oRbfyLgW34BshJO0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfkCPsNSVB8U9cQRX5AuJcLk_zowm-KeusJsyQiepbhA&oe=6A6610F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dd_6qPGvQGEQ7kNvwGYT9bF&_nc_oc=Adq_Too3hV0isE0ZJFFy4K-a_K--VGqywOF6qkB4i0yLfupHacDjJy9MidMEwbJ1Egk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSwI2XXJndM861J_4d-0GZtOo3fkcHU7KwNBElW3w2yA&oe=6A660A5C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ov3baex1T9cQ7kNvwG8MHAl&_nc_oc=Adr1KTT8eh-tfEDJrhBn_ItNsLUbXQlLR52gGa54oHXV2DktDQgb_SJL6k27pcGzyR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cX6kGGKT2JCMMYXL7g5GP4zjpVc16E19psxTrmHbkJw&oe=69D3A621"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k646g8cLsZ0Q7kNvwE4hefh&_nc_oc=AdoPc15KpCMykp5o6Vf4EBHyrw_S9BXn3XaeWXdAIBhHQOuutRa7NqgqFwUJdH2vV-s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DOgP62ARxXeS5_X0Pc3mJyrZlmHQ4xw11ZABQ1krJTQ&oe=69D39A22"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rmo9nhGs5qUQ7kNvwGup35B&_nc_oc=AdqQvQtbzAyqsTM9V0AvMP_j07DOHjtdNz7UCRUux1uoQnCbqKhdMkTjoAU0B0B94z0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hnJ1O6z6TYgdVy5TixHw7g3R38-EPyxLSiyNxr8ka_g&oe=69D3B578"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_udsKFQw_0Q7kNvwGdXA6p&_nc_oc=Adqvw9ZM99noAhU8rTvtq8qOEAUHC9snSRXv5Ojk6fY70qaluARs6qP0orGeelnBZ5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PDlj0e_UBB6Cc978GZF3qBCfnF8lUMwAF9VAZVOCRsw&oe=69D3BA73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iX4EyLaFE6YQ7kNvwH0PGWu&_nc_oc=AdqMYvnKuqI4bad9pjc7qFa3mm-gGHrJ3kRdknUKOr6PpdWmKNYjg-LFlsmWYzxRZEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16pFf8kOJG47PqXYtaiPqjlYy1CfJZfMagW7N7JrechQ&oe=69D3B3DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
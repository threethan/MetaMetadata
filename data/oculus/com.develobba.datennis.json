22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EY3VUc1ElrcQ7kNvwHboBGO&_nc_oc=Ado_CHfd13V3Pc_O1qNIWrYEzgLjLhNU0zoDdpJUTtUhuWnn0kLxdYNkc1VlEyW4ILI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEO39OpSjSoGMC328Rv53KnhNVRpRVYm7WtFaojgNm7Q&oe=69CFB1A1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAD9b-Xgc78Q7kNvwGXLo_a&_nc_oc=AdoP686UrWPRdmbyyQeCI_FZ4jtuSeG5037OLOwLfYhrxOTOgm7h2RgjEHAjqUlfjrg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy08Fb3QKP7jKmVP6sPB4hGMb0ANd8ah6K2BQvEk94kIw&oe=69CFA5A2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsONpmn2r4sQ7kNvwE0L9lJ&_nc_oc=AdoFe8z_2uEE0dPSSoGl3GPiarLxhhfW0EmiM-zwB79etcabseR2q0mvONPJEB3DEaQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyO1XIURuTPV_KjWm9iCC3LmWctv7wgs7LAc-qJHZ2A_g&oe=69CFC0F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCle06FaNzsQ7kNvwF1yy9j&_nc_oc=Adr2a-CFdOMtvDcU8VEfkSZKoToHtdWJAWcw04vgOEmEj6JgaVCLQ7nTfmT06EYIcpo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHRdsLJyocuSxK6yf3tJVIpuKELjkFKh1iwHLXAuBZcw&oe=69CFC5F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--r5lwMIegEQ7kNvwH2wWcj&_nc_oc=AdrTeoV3nvUXUIcGxRj2ajzKrkS1VjrYH1Bo-WqiQss4fX_nCd51tmTfsIkF2EPHBOM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxdex5vthOlxKc1BjtkUJFmBDyQzW--C5BPET5HMDHu9g&oe=69CFBF5C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
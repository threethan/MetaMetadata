22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QD6oOPuGd8EQ7kNvwGsjad_&_nc_oc=AdoZdh3vhqKL5xAokhb62XVaY5eSAVjmba1EAjffhamsaVkm3I2aBMePQqfttBi7lkI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ZJdq_WthuK7JU8vAdnow4axDomQzHRUcNy8Nr7thZ0A&oe=69EF55A1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK97VBq2ZPIQ7kNvwEAyzGg&_nc_oc=AdoP1-GNooCsU0OYAuUvFxM2NZK4S1Bn6fcHI2jdtjhzBxtX88CIM8bPZjtrKNg51VU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UpTPcUXIRphattks9t0bgRH6q4r_ARhxwbVUrOjn8-Q&oe=69EF81E2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohZ--xtkAUMQ7kNvwFqNEfS&_nc_oc=AdqWJjWMVQPpa-rXqsMNSfv22hXuQJa9oeMlU1x6KJuZgJkAzFG6Z3_wRAJbcI3nCi4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qJxsSf-LBKkac0AcLz-XVTlBq6DpxRxuuTL_IGMTZYw&oe=69EF64F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sz_t23zEX8sQ7kNvwGAIL2H&_nc_oc=AdqRJ0aXLfgBhXy1uJGyZTK0Ps0cSLKn2MDGo9Xiz4Kqk1eFTXaFStCDE-BOiKOsBvw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09OEaTMJX-gpG34qc4kK8n89Vq0fSmj1v6zRugEeQiyg&oe=69EF69F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvl4SLOTM8oQ7kNvwEN7lFu&_nc_oc=AdqD1zUOTMGK5J2vUZIxzc_YWss5JQZqcyVv-qNko8OxyYui1qUuOabcCDoX9MuejAY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2t6njVYqDYbsdOb2ZMg9GWIuNro-9eYeqoFoYeZce3lw&oe=69EF635C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
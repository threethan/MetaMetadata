22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-crxqQNXZEQ7kNvwEKR4CR&_nc_oc=Adp-u27LItw75D-Td9NuQF4igeaL4pNbbsRFCL63A5xcABgGH5Um_kSAsS13j8m0Uls&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY0BKdgH-eFWVG7kAKRDVYJAu8Lz2uV85KXyaQYMpk6g&oe=6A5A1F21"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klmxwlN2GlgQ7kNvwG2W4J3&_nc_oc=AdrWrREjjF2mEwpbnWsA1rTfBb5n5ZXCgcjYUcmptQPRlBOTPbO9yiedcicU-H7o7HE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFsTTGEwUsj9fU-7rJaiVf3MX6Iw7Wo2MlcYNwheq3gA&oe=6A5A1322"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jkiDY0m2qgQ7kNvwGFze31&_nc_oc=Adq3Ybf11gkISZp9-ZvGe-EE4N82Z_UcxetxU9CYdH5XFkAvSXzjBKSxO6N__EwFJuQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC23DV9SULfPctWmzJcdXi3dyndaQUwCh0R_Qa61Yt70g&oe=6A5A2E78"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JZCZ2sjHxAQ7kNvwEVhr4v&_nc_oc=AdrdQ6FzlEWcKkoRhz7jgij6arCCKWSeHo2C8As9MaQQeNcMsjXcfM0gKMbj_XQ8CQk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuw93WyI6RGuWcSC_wYbpXtg1lM_VJPfozPND6y-136A&oe=6A5A3373"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idcfzYmChD0Q7kNvwFIySza&_nc_oc=Ado6LOBsVU3SoL5h-VlBUKjzN20YVMxP-dyoL8KOBja47ZrdqBjW0xrRPr3TsNZ4Wi4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4uJUWNCLnMT7x288ufocGY0l7yn3Yun82KkIH7M5muQ&oe=6A5A2CDC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn2VaRIHt7YQ7kNvwGM61J6&_nc_oc=AdrhHBNqnUPwrdFaCWhEeMj8SfhQp3rQZH_PGQPGQjXztMsTZLnuzaqXthSfkyku3B0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_siph4RlfV0ssHfMyX-7FbZCL8NCQ0RK1ZJVEPsLLvyg&oe=6A2E9DA1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxlTJulyHdgQ7kNvwEu1Agl&_nc_oc=AdoBSKo7wHtCE1qTUXq7pgZ2HgBQbAWLNGY7dmtZ50_8S3LR1BIsXRbHlMot2job8Qs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85M97NO7o-phgBBPJue8bKux4nC-txyNDbTA2rv9g0uw&oe=6A2EC9E2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hETUy9JrSIQ7kNvwH4ANA8&_nc_oc=AdrwhvUEzhF_E_aKbqRTItcPJB8Eh0qeNqeLtoQ4GhmKHwdz0022eNa2TbxWwIrJ6d8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ir0FCPBF2mnXNobv5QtJSrl6DzYut3Oi50DTYDtUboQ&oe=6A2EACF8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6k5V8BLdiDQQ7kNvwH4AQg2&_nc_oc=Ado9e8h9I80OJfbIUv2Usonkp_QwFxi_Jqroe2wlSr-nyKecqp4-kxHSEY2WTmVJ60A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JmoVWAg0NJdvNJHvVfZVeODJqrL9oqdUyuEsK8gZ-tw&oe=6A2EB1F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfOY2bxC9vgQ7kNvwH4dV_7&_nc_oc=Ado-pnuRCzFlUYvLrBI2XujlSFrfI3VKzfJ0K9VNGjz4iwGIkueoioh4RZ67sTSsx7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VzZr3kbLlT7NHdKRwNyRbmKkUYZlBLjUu1RnYeblv6g&oe=6A2EAB5C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
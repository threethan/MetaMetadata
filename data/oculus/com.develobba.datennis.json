22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwMq1UKyWrEQ7kNvwEjtBz5&_nc_oc=Adrw7oNtvG_AeH4egGBPVm5QhOfFNE4zhHfQwn8UxsydXi5Fw5UhCU6B4S5F5uEFrI8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sLM_3jVaxDy1F7riXnbTukqdagcME2CFJzA4IT1eHyg&oe=6A0B0521"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eix5XQ9icVcQ7kNvwFUBayW&_nc_oc=Adqf7RHcE-Jski5LkyOsHA4IoUJOLYWT0ODgMqgGOoiC2EMm3W3VaCkdcbBQH73NWG0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HS--F_FRFyGNuSZDbRVEMD6vTHthPqDuyj-0-pZPGNw&oe=6A0B3162"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxHN5572SEcQ7kNvwH7yiwA&_nc_oc=AdrqB0-tZ3mvKNWnfLUajWNBP5FcloNYpO59P4ypZ0H63Nbleo12QfbUT2LHQVXxr5Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54ZSZqCNVd3oNcF-pZ_PSZ6-zAf1LgKsQNgIWj722Dzw&oe=6A0B1478"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwctzozGCxYQ7kNvwHEZWvp&_nc_oc=AdotHfUqpY-GdCDnYqwRa1PWB7y1Sym350Dze_cEOge3wUdhY2CWl81K5solyFD3Kzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kRWZJYRk3n4uN9t4VBdTtGO7QbPnhjvl5c1SxYgnJXQ&oe=6A0B1973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTTIt2_JPqkQ7kNvwG-qu6o&_nc_oc=AdoGnysrHejFTjGdQWiY5TSpUS6mkcN-BnFBcTDRnRkM3Wj42ZG3kzZmp35oU0KNDW0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MU44kOwQ7JM9WhYrnhv9mfCRSQaN9wYLdRr_g__geAw&oe=6A0B12DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDaqenKiF24Q7kNvwHa8kCF&_nc_oc=AdoyGNaWOIs0K_tSNRC75VyrICpjH8kbcSLAcWLDug60adEd3wLzJqi7Ax17B3yfKh4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt8p4KvbketfTXOytTm22PULhSric-M8bnbHVj7_wj9Q&oe=6A8AE6A1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pJ2mrZ24lQQ7kNvwGbas1P&_nc_oc=AdrDom84AIYixDamHB9wX5HNhxNB1da0Rb0A07MmM6yF2d8FY_Y4mBmum1FBwCmC0Qg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBbkb-ADgBQrZU1X9jDxQDjUaMc-9OsQUWKYY3_4aR4Q&oe=6A8ADAA2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4-T_y8fTlIQ7kNvwFWZKSI&_nc_oc=AdoDMyYgWkqFa2hdFPp4awSgyVYGObYY9X4zJWIefDyBaYZYbM2SpWoICwpV0XSqs5g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrOppu1uiGHnF4C2c4OQ74oRIkKeOEi61LRW2Wi1UgKg&oe=6A8AF5F8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-MzRr93QEkQ7kNvwERE-KA&_nc_oc=AdrDvB1FY_m5qKiSLd1v2BQoRHZTiW4y7IQ7bF_iBhQYtKTNoo_f1Dcq6LP2aPgSqLo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrqUdZJ5unE5MrkTD_Jpu7DUudUncDsQWdQaiOE5G9Jw&oe=6A8AC2B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8UsfcmYtdMQ7kNvwESdFb2&_nc_oc=AdpO12kLtedJWZ5LHevYR9o4sfGcjJi-HkTL9CWmq4YwNBpkRYcrPB1hnZZrbOVAKyE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvrUBYtpwD6-nbghGj3bwxxJH1WsgxxPoLYX99gvXOYw&oe=6A8AF45C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
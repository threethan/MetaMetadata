22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LnTiFolk2oQ7kNvwHwl5OF&_nc_oc=AdrL97arOb5-Y7xHhNWrjlEJtT4SFonexJiLtKvH_payehrMCnXkTahoMLRifwB0Di0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpy2HTf7x9El5j8-8khzMMyNrdbIQYN-jRv54Iks39sg&oe=6A902CA1"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfhPcrOwY6IQ7kNvwFzKQwy&_nc_oc=AdpOoeynbcz41DKTit8ijJ50KDWL_kRUjWirpkaouFfvBg0-NwD-6WHbdQ6Vx8ERkHw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl0tS_--x5rcir5w8f2pL87RVO1lNClDJ0ERqDozxtSA&oe=6A9020A2"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWC5avkgOMkQ7kNvwG44gCs&_nc_oc=AdouYvZONVKBnqlngBzi62g1_A-fLR_rDkVemfLt_A1NvgqvwmOnuBiDiOH7b8fulso&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO4Qz35tacKgCGlUxk55_abQb2iwXIuhizm5onk2uDbQ&oe=6A903BF8"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2fscVaIi5cQ7kNvwGrh9nm&_nc_oc=Adp1kwmg0ZEmnZHLViA7v28jtslMStHnw-Ph6dMCMgZtmiz-BOnqxX-RdhZdzreN45w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP08Q-qQEaoPKk2Y3tKizU7y2auUgTrsqBiwpBavs_Mw&oe=6A9008B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DfC5-JI12oQ7kNvwHgL6GI&_nc_oc=AdojyD1FhFdmU3BIr3nfgjP9kXyP6oogOIRCsaeveBN3sU3tQL-J8VQ6ZIcxjFLp7NM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG80nL_Q-v4fw0c3mWAlFK7WG6lgEyl-UsIx7mqFHKyGw&oe=6A903A5C"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
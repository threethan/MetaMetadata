22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEzH5DbDgj8Q7kNvwEvKQLp&_nc_oc=Adqwi1ro3PFrH60HopE8xHR0xXCgAUTqQnMdm4wNEhEwMjZCGpaySf_2Q61co7lS9GM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ELpznH3VOi6mXIHKYaksslkywNmDpbbH4f0GzIZn2tw&oe=6A426421"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFJvPYlRHjwQ7kNvwFTJ4Se&_nc_oc=AdqGBG-UlZUsfOVF7iTlGjy5VFbNffvHT_bVvlHfNrlrpbVP2TRSv9nz3ZEosJxfI5s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af849gjq4AIgMQgKmfA0p-kh0wcZIbq_4dvpg15ro3Vp3g&oe=6A429062"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIGCiSfCWEwQ7kNvwEthKTW&_nc_oc=AdqsVWn-V99ILfQYhZGSvwn_ceKMxXuxgmccYw1WGtofRS7lrZadBzIWrwmE2gY9fc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AY1xJrrOb8bPqa4UDToS1URqL1ujPNKJd_viU1LVq3w&oe=6A427378"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXbtSXhSoWwQ7kNvwFin34W&_nc_oc=AdrVFbwkUTQRaJf-WicOHvecT1Ldj4I4kP9ORDY2KPUk_Rjzq9hxwtOkcZszFB9mLZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U5wpKuCuxNzetRopSCuUbnLNugzJC4E6vZmSgJTw-FA&oe=6A427873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HXg_RfxzSEQ7kNvwEx87UL&_nc_oc=AdpzLgQvBzDL4r58sKK-insAgwfAgtmRz5VSBGktCqiTr9FZYgDgAmgiguOd5f8KgqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_qATWYYMS4CSdlRALPbgM2ZSLHpb1RZ8wMuwd_dKGAQ&oe=6A4271DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
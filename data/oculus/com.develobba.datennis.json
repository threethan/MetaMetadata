22589_2329745849334894999_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKvR5hOizSkQ7kNvwEVE7wL&_nc_oc=AdppQGwdij9eiZ6I3XegPaDcBrt1Uk3GBALI25lcuGMc83q4Q6ho5C9ae24HJq0Cggs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMELdGxgorFg5eYfTJ0XAC2JQwX4gbCxILYcSWif5EWhQ&oe=6AC12C61"}, {"file_name": "ballmachine_1.png", "id": "682339392969628", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566679_682339396302961_116730398533214167_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6ZPe23Nx7wQ7kNvwFOZU5c&_nc_oc=Adp53fHYuS_Pt8y0w0LBttsmmBOR6J_jRftpEbc6Y2fgfnxVtiCS-e2GaLAUB0xyVew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNscBBbsh6ebZeCUuVcrfP_AZcYvm_S-OJ0eEuapCa3uQ&oe=6AC12062"}, {"file_name": "serve_1.png", "id": "5613594218655172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_5613594228655171_3811930753073499238_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6OLIbzBRz4Q7kNvwE7DXzp&_nc_oc=AdrR8uLtI_eO4rOLlsANdknIA19pAqZwmB_wSE8C3WQeijHO4JYxvLH6rwAy9FR8ymA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmbQ0PQLqlYB9lKMlC77IaXbb-B9RY1UblelHOBXh2BA&oe=6AC10378"}, {"file_name": "serve_2.png", "id": "2188864944598842", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_2188864951265508_6932600627149019002_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rn7lxR9mVyQQ7kNvwF-XfCb&_nc_oc=AdpFOFGgYhfkTOD_NXBKfOVuaK8IiwzUm1BPjUT-ythVGGcbcXi1k0QAhp2DK3mHlBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNehlNeeqszfiolCGwYbnDNj6zjpURPKP1pd5o5rAgfDA&oe=6AC10873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo_2560.png", "id": "466305945239221", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031379_466305948572554_4720262355186550109_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvgRGHYfQ08Q7kNvwHTeZYp&_nc_oc=AdrRvqb1Lj3yYb_kIZX7YavBGLViIWz-mGd_6r7FafcMua_8U8z2jyQO9tdjN8ZFa8I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVfBtwBsEStqsGJ1hWnPS85bw-1xkOxHIiTT02YqD3uQ&oe=6AC101DC"}, "display_name": "Da Tennis", "keywords": [], "long_description": "First, you have to practice with a ball machine or train your serves to get ready and get comfortable with the interactions.\n\nAfter that there will be several seasons where you have to prove yourself against other opponents.\n\nIn upcoming updates there will be a clever KI to oppose with, different courts, opponents, cosmetics such as design your own tennis racket, statistics such as \"fastest shot\", \"best rally\" and more.\n", "short_description": "You want to learn or train your skills in Tennis? \n\nGet this game!"}, {"images": {"nodes": []}, "id": "513272930169742", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Da Tennis", "keywords": [], "long_description": "Zuerst musst du mit einer Ballmaschine \u00fcben oder deine Aufschl\u00e4ge trainieren, um dich auf echte Gegner vorzubereiten und sich mit den Interaktionen vertraut zu machen.\n\nDanach folgen mehrere Saisons, in denen du dich gegen andere Gegner beweisen musst.\n\nIn den kommenden Updates wird es eine clevere KI geben, mit der man sich auseinandersetzen kann, verschiedene Pl\u00e4tze zum Ausw\u00e4hlen, Gegner, Kosmetiks wie das Designen eines eigenen Tennisschl\u00e4gers, Statistiken wie zum Beispiel \"schnellster Schlag\", \"l\u00e4ngster Ballwechsel\" und mehr.", "short_description": "Du willst F\u00e4higkeiten in Tennis erlernen oder verbessern? \n\nDann ist das dein Spiel!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Develobba/DaTennis/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "Develobba", "support_website_url": null, "website_url": "https://www.develobba.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
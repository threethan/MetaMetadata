n_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8dsjjS00fYQ7kNvwHWkIVS&_nc_oc=AdoetAYM_84q_SyCHhTw5azC-Ce_s7Tmtlc0YWAaIGjBj6tTbH7zBiO2nt5v4GZHnsw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXd2uZ4sweIGzTLYuZY2k9hTRzc-HsBx3K4nuozlI2ag&oe=6AFDE02B"}, {"file_name": "Shot1.png", "id": "803700595014307", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982447_803700601680973_1591206922646626521_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgA2qCP7TqsQ7kNvwFrZ9zN&_nc_oc=Ado81PtXstrrkqBxgJXBYRvzqNHthNIvGbbbZcG7gY0nYtlngyCV-u4k5Zz_LMJD_wk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNioy2jwIb4z_NV1deV9-LvUvKEqXXhUaINYk8dX6g-Q&oe=6AFDE0BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TitleImage25601440.png", "id": "1837762326691967", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001681_1837762330025300_8418234960234389342_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEGGc3AAsusQ7kNvwEAgTte&_nc_oc=AdrtfE-LXxDS5FP5yzMOkDJbJs_j8syHUHWeY0Uha-IduiLFVbuOel5Pn45oSniiYuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQveIim3QqBqS9S1gPGjNIO6Sw6Xs2OtXEbsKHbLFUv1w&oe=6AFDB4D6"}, "display_name": "ShootEmUp", "keywords": [], "long_description": "\"Welcome to ShootEmUp our Mixed Reality Shooter, an exhilarating gaming experience that brings the excitement of the battlefield right into your room. Dive into a world where your surroundings transform into dynamic landscapes, providing the backdrop for thrilling shooting challenges.\n\nEmbark on an epic journey through 25 challenging levels, each meticulously designed to push your shooting skills to the limit. Strategically plan your shots to knock down virtual bottles scattered throughout your environment, using logic and precision to overcome each obstacle.\n\nBut the adventure doesn't stop there! With regular updates, we're constantly adding new levels and features to keep the excitement fresh and the challenges coming. Stay tuned for even more thrilling content in future updates.\n\nImmerse yourself in the immersive world of our Mixed Reality Shooter and experience the thrill of gaming like never before, right from the comfort of your own space.\"", "short_description": "\"Immerse yourself in our Mixed Reality Shooter, a thrilling game that turns your room into a dynamic battlefield. Test your shooting skills in challenging levels, where logic and precision are crucial to knocking down virtual bottles. Experience the excitement of Mixed Reality gaming in the comfort of your own space!\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/shootemup", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7751806434931948"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2240045329843565"}, {"status": "CANCELLED", "id": "1530166790996479"}, {"status": "PUBLISHED", "id": "1304734027522248"}, {"status": "PUBLISHED", "id": "587624580316265"}, {"status": "PUBLISHED", "id": "855146896598678"}, {"status": "PUBLISHED", "id": "2291748941224010"}, {"status": "PUBLISHED", "id": "1113216676649759"}]}, "baseline_o
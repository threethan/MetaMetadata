2.oculuscdn.com/v/t64.5771-25/38974871_482176544443089_7033509287637890671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUNlDXMqo90Q7kNvwGomGeR&_nc_oc=AdoKQ9JL9P6T-7BcTBPPsPvRshxQp4hr0pQxv0XfdNJVnwMEKqCTlYkVBoqDUoSpVJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtTzlZTXV3QtOjc-_mxMMPvE_0dBGgkqj_Y2_AGJLRGg&oe=6A734A8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "1021889813014077", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974746_1021889816347410_4770436519144545523_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJshxYt8sdsQ7kNvwFcnXY9&_nc_oc=Adol32zei8D-y_kSR-GUSm6WCgm4pJKlIp5s7Totaig09t0zr82A5t3cLjOkiY575UI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE30lSKinXG9LJ8WJjtiu8AmAZmfPnqSciT7SGzpQp9Kg&oe=6A732C21"}, "display_name": "ShootEmUp", "keywords": ["Shooting", "BottleShooting", "MixedReality", "WesternShooting", "CasualShooting"], "long_description": "\"Welcome to ShootEmUp our Mixed Reality Shooter, an exhilarating gaming experience that brings the excitement of the battlefield right into your room. Dive into a world where your surroundings transform into dynamic landscapes, providing the backdrop for thrilling shooting challenges.\n\nEmbark on an epic journey through 50 challenging levels, each meticulously designed to push your shooting skills to the limit. Strategically plan your shots to knock down virtual bottles scattered throughout your environment, using logic and precision to overcome each obstacle.\n\nBut the adventure doesn't stop there! With regular updates, we're constantly adding new levels and features to keep the excitement fresh and the challenges coming. Stay tuned for even more thrilling content in future updates.\n\nImmerse yourself in the immersive world of our Mixed Reality Shooter and experience the thrill of gaming like never before, right from the comfort of your own space.\"", "short_description": "\"Immerse yourself in 
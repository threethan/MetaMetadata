1.oculuscdn.com/v/t64.5771-25/38974871_482176544443089_7033509287637890671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkJzeKZ7T9wQ7kNvwEkPA1m&_nc_oc=AdqwzrbVPufqqyWYjJWJoZloakFwONSR4cmfYY33fqnIQjwUOcvKgej2dCzz9S6JG34&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzzp__nnIjSCgHrOdmpu59BKaznmm12EpasInx1nYYug&oe=6A9407CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "1021889813014077", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974746_1021889816347410_4770436519144545523_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSmaCXPYJ68Q7kNvwEkoxXN&_nc_oc=Adq9Lcfa3nRl-mwsQ4D5-519R29ThWmCHm1_RHcWcl__6b8B6I-K4GT0PPfdNgKUCZg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOzXUunpjlkSSKKAI8QcQd1P_GISoQR3blce4QsinQmg&oe=6A9421A1"}, "display_name": "ShootEmUp", "keywords": ["Shooting", "BottleShooting", "MixedReality", "WesternShooting", "CasualShooting"], "long_description": "\"Welcome to ShootEmUp our Mixed Reality Shooter, an exhilarating gaming experience that brings the excitement of the battlefield right into your room. Dive into a world where your surroundings transform into dynamic landscapes, providing the backdrop for thrilling shooting challenges.\n\nEmbark on an epic journey through 50 challenging levels, each meticulously designed to push your shooting skills to the limit. Strategically plan your shots to knock down virtual bottles scattered throughout your environment, using logic and precision to overcome each obstacle.\n\nBut the adventure doesn't stop there! With regular updates, we're constantly adding new levels and features to keep the excitement fresh and the challenges coming. Stay tuned for even more thrilling content in future updates.\n\nImmerse yourself in the immersive world of our Mixed Reality Shooter and experience the thrill of gaming like never before, right from the comfort of your own space.\"", "short_description": "\"Immerse yourself in 
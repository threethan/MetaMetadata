3.oculuscdn.com/v/t64.5771-25/38974871_482176544443089_7033509287637890671_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7xG9TCwqOsQ7kNvwEUapkZ&_nc_oc=Adp-G_--wtsJCrrKsa5N2zR1JmbdYx1ezEtVjNg-66h79GRscqjNTW5z8MfavUjkxrc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzE8S3cBsjMFoS7cULjHCnlx3qacyyRcEzxVKegdd8xQ&oe=6AA16F0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "1021889813014077", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974746_1021889816347410_4770436519144545523_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGQZDPMszGgQ7kNvwGI4c1B&_nc_oc=Adpfb5BFDtM5Ps_NIIFdynEhzMCczzuWoGJdwsK49oJOL8ye8F0vIjfTSVE1P5EKM0k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg4_m8dJwio0K-DooHz-dWclgkx_PSPAEfOtLRfScTSA&oe=6AA150A1"}, "display_name": "ShootEmUp", "keywords": ["Shooting", "BottleShooting", "MixedReality", "WesternShooting", "CasualShooting"], "long_description": "\"Welcome to ShootEmUp our Mixed Reality Shooter, an exhilarating gaming experience that brings the excitement of the battlefield right into your room. Dive into a world where your surroundings transform into dynamic landscapes, providing the backdrop for thrilling shooting challenges.\n\nEmbark on an epic journey through 50 challenging levels, each meticulously designed to push your shooting skills to the limit. Strategically plan your shots to knock down virtual bottles scattered throughout your environment, using logic and precision to overcome each obstacle.\n\nBut the adventure doesn't stop there! With regular updates, we're constantly adding new levels and features to keep the excitement fresh and the challenges coming. Stay tuned for even more thrilling content in future updates.\n\nImmerse yourself in the immersive world of our Mixed Reality Shooter and experience the thrill of gaming like never before, right from the comfort of your own space.\"", "short_description": "\"Immerse yourself in 
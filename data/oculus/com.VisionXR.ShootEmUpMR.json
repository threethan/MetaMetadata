uscdn.com&_nc_ss=7f20f&oh=00_AQIpyZ2BAjuk3J-OOoRwL9-0gbnY5ZqdOXD2x7DZddQhGA&oe=6AA4027C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TitleImage25601440.png", "id": "1837762326691967", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001681_1837762330025300_8418234960234389342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bX3dGKFgSJYQ7kNvwEqFT7u&_nc_oc=AdrkFiPMuU_SixeEOOhEUFhW63KjT5KDO0q8DlcecEF_E2h6wlRzq0URVQ9Bo4pWoKw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK39BO53FgThvYtxjPMsbnQ2NQd1LunRBMsnBWbxEu6CQ&oe=6AA40ED6"}, "display_name": "ShootEmUp", "keywords": [], "long_description": "\"Welcome to ShootEmUp our Mixed Reality Shooter, an exhilarating gaming experience that brings the excitement of the battlefield right into your room. Dive into a world where your surroundings transform into dynamic landscapes, providing the backdrop for thrilling shooting challenges.\n\nEmbark on an epic journey through 25 challenging levels, each meticulously designed to push your shooting skills to the limit. Strategically plan your shots to knock down virtual bottles scattered throughout your environment, using logic and precision to overcome each obstacle.\n\nBut the adventure doesn't stop there! With regular updates, we're constantly adding new levels and features to keep the excitement fresh and the challenges coming. Stay tuned for even more thrilling content in future updates.\n\nImmerse yourself in the immersive world of our Mixed Reality Shooter and experience the thrill of gaming like never before, right from the comfort of your own space.\"", "short_description": "\"Immerse yourself in our Mixed Reality Shooter, a thrilling game that turns your room into a dynamic battlefield. Test your shooting skills in challenging levels, where logic and precision are crucial to knocking down virtual bottles. Experience the excitement of Mixed Reality gaming in the comfort of your own space!\""}]}, "developer_name": null, "
pX9tx0_vbAc_R_gNRFQwTi51i5wtgrt4LPxz4ViSaoyRyek4z9k46Tw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiJx1LMfuMKQ9yNiZqqSXHfFTFFa_8P2gyZgfaZQqeqA&oe=6AFF31AB"}, {"file_name": "Shot6.png", "id": "482176541109756", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974871_482176544443089_7033509287637890671_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9V8DbJSUYYQ7kNvwGPY5e-&_nc_oc=AdpooXSzCP9ocGTVU9z_uB9nBUUsKVC6kwF6ytLkA_aa_lfNxi69fLdyB9B7MmjfMtk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYQbm8qno3aeGEX3VhdgUDT_e2scsNgRA1smOkSLs5zg&oe=6AFF098E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "1021889813014077", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974746_1021889816347410_4770436519144545523_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Q1-lEnFWuUQ7kNvwFcM4FF&_nc_oc=AdoA5zEOZkmwkKIepvOMNNOg3D_fTIYdIk8f5jOuL7mSZd7NBIds7xYGRsTas4Xg0wE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAKQD1PiCxtV6gl40wYVotCLQVc9wEOcltK1umar0FMA&oe=6AFF2361"}, "display_name": "ShootEmUp", "keywords": ["Shooting", "BottleShooting", "MixedReality", "WesternShooting", "CasualShooting"], "long_description": "\"Welcome to ShootEmUp our Mixed Reality Shooter, an exhilarating gaming experience that brings the excitement of the battlefield right into your room. Dive into a world where your surroundings transform into dynamic landscapes, providing the backdrop for thrilling shooting challenges.\n\nEmbark on an epic journey through 50 challenging levels, each meticulously designed to push your shooting skills to the limit. Strategically plan your shots to knock down virtual bottles scattered throughout your environment, using logic and precision to overcome each obstacle.\n\nBut the adventure doesn't stop there! With regular updates, we're constantly adding new levels and features to keep the excitement fresh and the challenges coming. Stay tuned for even more thrilling content in future updates.\n\nImmerse yourself in the immersive world of our Mixed Reality Shooter and experience the thrill of gaming like never before, right from the comfort of your own space.\"", "short_description": "\"Immerse yourself in our Mixed Reality Shooter, a thrilling game that turns your room into a dynamic battlefield. Test your shooting skills in challenging levels, where logic and precision are crucial to knocking down virtual bottles. Experience the excitement of Mixed Reality gaming in the comfort of your own space!\""}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/shootemup", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9687060784739827"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982729_1762585660814308_4509826349536174600_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwUbx71AfMYQ7kNvwEC4l6m&_nc_oc=AdoO8EJYEdW-gIz2lDyglr2UuLuBGcQPAdU_x5Jd3GF4LALYInizaw9bz6kXDvzkEfA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_A
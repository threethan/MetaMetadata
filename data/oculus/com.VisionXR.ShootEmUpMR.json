4x6h3oq1QZ6eyotfq4533O7kmAd5vuY7d_5e-mfdetMUAV8-x_0mcmk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTQpW3xkCgoR2fsh8aBsjgiWtUs0oPRz9XGcHhON4sBg&oe=6AFB3D2B"}, {"file_name": "Shot6.png", "id": "482176541109756", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974871_482176544443089_7033509287637890671_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQk8ARr0nBkQ7kNvwHUZvwN&_nc_oc=Adrpwxbxe5Cc9tcvGe9anUluYCTIukS-EeVpZwIzJVVaf8GyvfpQdPBcTSgdJuAom7M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSnvuC5vhjM1IeNb59R2rp6jRcyvk1ZXNT6WU0OHZFUg&oe=6AFB4D4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "1021889813014077", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974746_1021889816347410_4770436519144545523_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgT_-SvUFCsQ7kNvwESyNxD&_nc_oc=AdqWZajvYy5kzG9XBVkSEh70ckRtnc0F6Qf7dXMyGJbSfGthgMv77kSj8VIsJi7tw30&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6HbsbpKvJ1b3XNoijHhxYTHbuoddDOZCnDTQMVl6sbw&oe=6AFB2EE1"}, "display_name": "ShootEmUp", "keywords": ["Shooting", "BottleShooting", "MixedReality", "WesternShooting", "CasualShooting"], "long_description": "\"Welcome to ShootEmUp our Mixed Reality Shooter, an exhilarating gaming experience that brings the excitement of the battlefield right into your room. Dive into a world where your surroundings transform into dynamic landscapes, providing the backdrop for thrilling shooting challenges.\n\nEmbark on an epic journey through 50 challenging levels, each meticulously designed to push your shooting skills to the limit. Strategically plan your shots to knock down virtual bottles scattered throughout your environment, using logic and precision to overcome each obstacle.\n\nBut the adventure doesn't stop there! With regular updates, we're constantly adding new levels and features to keep the excite
3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPK3cQibMwJRowpPzJM2pTH6RHb89XLuNQio0hQdaN_Q&oe=69C6960E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "1021889813014077", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974746_1021889816347410_4770436519144545523_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCm3jAbZjWcQ7kNvwGIvd_g&_nc_oc=AdrCD1onlT0Jn0KPkV_3sEa3DW-8Zxv-eZ0YbCuUk1BYBROuBzytC8Tge25pfgQZtBQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIPeyXx_1p5cyLYN4WTlaB_mUien6kyCsWhx3omRsIRw&oe=69C677A1"}, "display_name": "ShootEmUp", "keywords": ["Shooting", "BottleShooting", "MixedReality", "WesternShooting", "CasualShooting"], "long_description": "\"Welcome to ShootEmUp our Mixed Reality Shooter, an exhilarating gaming experience that brings the excitement of the battlefield right into your room. Dive into a world where your surroundings transform into dynamic landscapes, providing the backdrop for thrilling shooting challenges.\n\nEmbark on an epic journey through 50 challenging levels, each meticulously designed to push your shooting skills to the limit. Strategically plan your shots to knock down virtual bottles scattered throughout your environment, using logic and precision to overcome each obstacle.\n\nBut the adventure doesn't stop there! With regular updates, we're constantly adding new levels and features to keep the excitement fresh and the challenges coming. Stay tuned for even more thrilling content in future updates.\n\nImmerse yourself in the immersive world of our Mixed Reality Shooter and experience the thrill of gaming like never before, right from the comfort of your own space.\"", "short_description": "\"Immerse yourself in our Mixed Reality Shooter, a thrilling game that turns your room into a dynamic battlefield. Test your shooting skills in challenging levels, where logic and precision are crucial to knocking down virtual bottles. Experience the excitement of Mixed Re
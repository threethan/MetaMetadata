q8MCB2wDvu8Br77TwUTlnkCgLwxR41jZZQ4KqpJ_ng95abIkZIvVARk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMP0PdQPTEy9C_LtcgL0HOXK14aR67HQpUbeQWKKQ0pA&oe=6B086C2B"}, {"file_name": "Shot6.png", "id": "482176541109756", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974871_482176544443089_7033509287637890671_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbXEML6Wz4EQ7kNvwHJu4bT&_nc_oc=AdodJPu-HRjQh3rbqRuAZ7a19Wbn255smYsV3p6OZB-E1pqfgq469_LvwFftD6GRiCs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQb_JzJufzps18HjjncXH1MSWIOxJd-4v4mO8uvnswXw&oe=6B08440E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "1021889813014077", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974746_1021889816347410_4770436519144545523_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiAKZa4zysAQ7kNvwEvriAv&_nc_oc=AdrUMPSeJfZ93i4dsnNe-L6O1oaJUpaFP3NC-Q21JP5sng-brjVfn6cgkQnxi3AL08o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0yQZCkc625pGizJSasVeOLbQJ3uxwJLQ-a69BoXKNJw&oe=6B085DE1"}, "display_name": "ShootEmUp", "keywords": ["Shooting", "BottleShooting", "MixedReality", "WesternShooting", "CasualShooting"], "long_description": "\"Welcome to ShootEmUp our Mixed Reality Shooter, an exhilarating gaming experience that brings the excitement of the battlefield right into your room. Dive into a world where your surroundings transform into dynamic landscapes, providing the backdrop for thrilling shooting challenges.\n\nEmbark on an epic journey through 50 challenging levels, each meticulously designed to push your shooting skills to the limit. Strategically plan your shots to knock down virtual bottles scattered throughout your environment, using logic and precision to overcome each obstacle.\n\nBut the adventure doesn't stop there! With regular updates, we're constantly adding new levels and features to keep the excite
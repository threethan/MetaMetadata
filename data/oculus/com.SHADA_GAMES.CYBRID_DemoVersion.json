5hH4MqNSVjrz_IbSZVaW800Pdjg&oe=6A9725BE"}, {"file_name": "CYBRID_MQSc_03.png", "id": "1270323991300238", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499296119_1270323994633571_2200587565310649627_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfkHbWfg9B0Q7kNvwEx0HBZ&_nc_oc=AdrBM2xvS9V9eEC5DOtWb-v92Hagu3DyjANGUNk7kUGUxdaVAiFV-z6hswLxMkCWSm4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE73G4ZpXEq1XzImNsfwd94_sWcB9F6Nbdu4yTKJaC4gw&oe=6A971E0E"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1111876566970671", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491818916_1111876570304004_2276251155993577744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaSn-w71kA8Q7kNvwHFL_FI&_nc_oc=Adq25icajutjak4CJxJZgyN09gB2w2vpP7fTegxHxuR6Fh24sU8rBfF31AX7Sa0swWs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJi2t6M1el4xXFUaNzwToHkwVj4TYepb-Z7oMPdbFvsw&oe=6A974F7C"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2457926987919470", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499308204_2457926991252803_5902535425955303293_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vKQTv3hbVsQ7kNvwHyK8IE&_nc_oc=AdoE7RzhkbA6ZWfZRvwY-D6x_SdPDB591M2cloZh8x80OLbNBs30twTfTFYZJUmpJxM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN5jr3Tz9jFwuaNoHtVSeJCLLWXgoyG6D1ZSea-tQNrw&oe=6A972A8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DV_MetaQuestTrailer_01.png", "id": "1667620500546596", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499303971_1667620503879929_4901330468401561725_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kA1JrM_LwcQ7kNvwF52vAU&_nc_oc=AdpgsKANGQEGo3BjkmMB4vh67MZ2wsQVmeCjlZezFcQQI_YdkxlHRpHlXxJSPrO5grY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBGDVrxyML5WJ-4nW6QcR6dq0l2Xm2gDEeKKgGD9tykg&oe=6A974817"}, "display_name": "CYBRID - Demo", "keywords": ["cyber", "rhythm", "action", "beat", "cyberpunk"], "long_description": "**CYBRID - Demo** is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n\n# FULL VERSION:   https://www.meta.com/experiences/24008454042113681/\n{1774681720078655}\n-\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n# Feature\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n# **From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID - Demo is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SHADA GAMES", "support_website_url": "https://discord.com/invite/3HPfxg2YAD", "website_url": "https://sites.google.com/view/cybrid", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "con
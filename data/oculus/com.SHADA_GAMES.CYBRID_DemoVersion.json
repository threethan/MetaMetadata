dWFt3SOMxz9miZBOpGijtjBoSBg&oe=6A1DA37E"}, {"file_name": "CYBRID_MQSc_03.png", "id": "1270323991300238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_1270323994633571_2200587565310649627_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jP_C86qJOLYQ7kNvwGFblS6&_nc_oc=Adr04OH6Tl3TgUD9xAmDsFv8zsxV_qLsp-10MzX1HSYYAKS0UlOdwnD-UShpvgu8KY0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xusunqD0jd-RrXMSUa8jr_GoIaMGdJZPSn2Ui3wBHHQ&oe=6A1D9BCE"}, {"file_name": "CYBRID_MQSc_04.png", "id": "1111876566970671", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818916_1111876570304004_2276251155993577744_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI7bYUsSFZIQ7kNvwFQjtIu&_nc_oc=AdqaMdzG5ape-8YyaTaVdOfXod5PgLA8Mbd9-Ui6h9KXfJ7_IQCrt3n1Iktgbm86ogc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LPQk-QYmhetXHaCIJzNP1bLMToqhEozgsLaozkaedsg&oe=6A1D94FC"}, {"file_name": "CYBRID_MQSc_05.png", "id": "2457926987919470", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308204_2457926991252803_5902535425955303293_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nVV0_gpqkYQ7kNvwHccw2r&_nc_oc=Adq_fwYAYiKipBdDAoxj8eJU9hM1cYmPgZlckQWVpJgOU35MclhSlYyTMONl1_LVaoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Pzgz9BaDq0sN8nLjzcjzQSmhudR335B2lj9J0EiYaWw&oe=6A1DA84B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DV_MetaQuestTrailer_01.png", "id": "1667620500546596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303971_1667620503879929_4901330468401561725_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66DBDKsmX60Q7kNvwEXR-7c&_nc_oc=AdqglHCoeKxQ5kOTdJzjH50QFVaYxCY8fx31xq-d2nh3yRuohh5VQM57doT-O76e1uU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tsqIujJWvoULi9KGv3J3ynElA_ipQiQ1XL7WggcF_cQ&oe=6A1D8D97"}, "display_name": "CYBRID - Demo", "keywords": ["cyber", "rhythm", "action", "beat", "cyberpunk"], "long_description": "**CYBRID - Demo** is the action-rhythm VR game of the Cyber Future! Featuring cinematic visuals and lively levels timed to an electrifying soundtrack! Use your swords and pistols to slash and shoot your way through the oncoming cyborgs. Run, dodge, and jump among the neon lights of the city to a powerful soundtrack! Immerse yourself in the Cyber world and feel the adrenaline rush!\n\n\n# FULL VERSION:   https://www.meta.com/experiences/24008454042113681/\n{1774681720078655}\n-\nRun. Jump. Dodge. Deflect bullets with your sword. Switch between swords, pistols, or wrist-mounted blades. Whatever you do, follow the rhythm. Your success depends on it.\n\n# Feature\n\n\n- The main thing is to follow the rhythm, it is the main thing, the success of the passed level depends on it. Color matters! Blades and swords will only cut their own color, so swing with discretion!!\n\n- At your disposal are different types of weapons, swords, blades and pistols! and...\n\n- Use different modifications such as: time acceleration, error immunity\n\n- Customize the color scheme for levels, weapons, and enemies to suit your taste\n\n- Dynamic gameplay will keep you on your toes\n\n- Additional endless levels\n\n# **From Developer**\n\n\nThe game is made by the forces of one person", "short_description": "CYBRID - Demo is the action-rhythm VR of the Cyber Future! Swords and Pistols are in your hands. Slash and Shoot! Don't let this stop you! Run, dodge, and jump among the neon lights of the city to a powerful soundtrack!"}]}, "developer_name": "Tom Reason", "developer_privacy_policy_url": "https://sites.google.com/view/cybrid/menu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SHADA GAMES", "support_website_url": "https://discord.com/invite/3HPfxg2YAD", "website_url": "https://sites.google.com/view/cybrid", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "con
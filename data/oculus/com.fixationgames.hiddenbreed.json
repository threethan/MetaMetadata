etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVcdo6Sklr8Q7kNvwEMDKmX&_nc_oc=Ado9g1nLiuvN4iZRdH3wIbBhqP_zKfqRNRLekOIXCLlY7T9uLEqFI148ixTMzmo4mt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4yd2_DZYNO17p49jL4l2FcK0ODivcyzx8SAeRsTKwLQ&oe=6B01BCFC"}, {"file_name": "HiddenBreed_05.png", "id": "1199204234516052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75302218_1199204237849385_3514117115698024278_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQ86zwFcm4wQ7kNvwEaXKVV&_nc_oc=AdrglfArG_JzzOMhCLvT4Iz8Bmo8yd134Zxdup61Bd8v5TVpEH7f6exihWcSm23O8Zo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRASyrqBBikE3r46oIZTO2uKoVGzRW9MjZFAqxlMXwd7g&oe=6B01CB3C"}, {"file_name": "HiddenBreed_02.png", "id": "1254162912294205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572947_1254162915627538_5215355207963233467_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb4CgLgS6wgQ7kNvwEgT2s7&_nc_oc=AdpS94uDTx0NLlhr-drilyBXPewp8kyF4VZCJq514E6YoBVF3hruUixXmtgTLImMK9k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqNSqoPKbrJBcaOEvxh-QG18NpJn_4KDslrOagsNkClg&oe=6B01C316"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OkgTRFk7pIQ7kNvwHEhzZp&_nc_oc=Adq-XZ3TFv9kMxCr_s5kYAbG3GWHGe5Lo6FSl8vedc9GFZDFPk0tfIkg7ScED0ODytg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAFjIUk6irHfV5HiwbKO3ZCmTEeeJU1UfQWRVNCj6jXQ&oe=6B01C739"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yWOxmdAv84Q7kNvwFYIycx&_nc_oc=AdrlN9bN6xy4olqsKmiOIExflMJYXxme_KZYJAXwAExe5Jq9y9DuzjPfyMI7nJ0WlkA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzoOtupKouya4bMzYn0cWdLCAZmwgi1xotxUte0SoiDg&oe=6B01E91D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/
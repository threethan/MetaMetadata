kNvwED3RAy&_nc_oc=AdqpMlN-R6wwuJ5Vml07_MfxbPkyeRRU0YQnxD2iGzV2ZmMs6ZKXvx1YRXE9Nq2P1EU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzEiF1cSsbrZ1UmjBLTP99mw7Yyc8EEZ6PHkABxMSe7A&oe=6B0DBA6E"}, {"file_name": "HiddenBreed_02.png", "id": "527691840434361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393887_527691843767694_3049882066401243301_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5NMJrNyp2AQ7kNvwEkTo7A&_nc_oc=AdpajIxUtZ-4eRqsZyKKB2S_1WXCbrwdhTuUPD0UCOId9rG1AoUgTjy-v0NRKpjXtBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTcTsMO5k84wUgpo_2qkVU6J9EOjW7TYycrkE6C6TSbrg&oe=6B0DACFE"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIcodA1aEtwQ7kNvwFABMsl&_nc_oc=AdpT_snSahXnW5jLJ7qLXr5gWjMa4weVQTt1sxRU9p_Tr-Q4QyU9bBtTjPtZn3xV4DQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1mXiPYewjsSaH1PLPPOfKzajP29VBqrN8JM_0IdC0cA&oe=6B0DAA3F"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkqB1wD78Z0Q7kNvwGDN0LN&_nc_oc=Adrt6SUBYJOdDddSwXuuPKqx9ZhvqUFDoCLWD-7IZjtsHyDC7NDOM7ECF7o_lUsrnNo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQROPifNJVC8ZruYdeao5TSnbr1GO_BgBy7339oRntqB7g&oe=6B0DC4AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=antkrqp9Fu8Q7kNvwETM8ME&_nc_oc=AdouaiT23c_9xCA_8sjEERa_gjDdogmijX0bmvY8p_Vq8lBAxl5wUP87pOol8GG4aK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSA2WViSw0uerOeWFAZelIFI9XjfBwOjHK4IKGSoqmSnQ&oe=6B0DC48D"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationga
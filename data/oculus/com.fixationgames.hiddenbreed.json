etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcMuqIr8NZYQ7kNvwGEjRhY&_nc_oc=Adq6tNbkZYHteNFlyspPol2cPB82ShjCbL1o6coW_7CyaBy6ar8i3_I7UJnxogBqDv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpAQM_An1jKnj0tCwCYi-e3lAOWN_FCLpsUjregXgLIg&oe=6B0D9A7C"}, {"file_name": "HiddenBreed_05.png", "id": "1199204234516052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75302218_1199204237849385_3514117115698024278_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZjz0PK_YpEQ7kNvwFHyNT5&_nc_oc=AdoH5i2bzfpv1yk7iWKfFWyZdSC8z-cgVe5QA62HdZhtWuuqPTdgwCPwjkob7ZYlj-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzzT7BIqlw2fIxVaehbQHKCNG3kL2DGheQBkAeKDcN5A&oe=6B0DA8BC"}, {"file_name": "HiddenBreed_02.png", "id": "1254162912294205", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572947_1254162915627538_5215355207963233467_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSpWqGLowtUQ7kNvwHU7AYL&_nc_oc=Adp2fsvCMVQF9WuXqpOM57xFievvEvsrKJVAF5r__KuPIou_v9mcsHHCGbnEvm4V4H4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpBPbJ-pQ9Av-jy1hUY0jsbMJT-DakrEn0dq1ZPF_bUA&oe=6B0DA096"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bt0sMj6bKeYQ7kNvwF2fFHz&_nc_oc=AdrfJwinrNaPJ4SZQMrt8qUigPYjyREuQQHUejCzuVhFmjAqAy9VjV1UMx4y9vtmM4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSEQOJL8iuJNWYkkytV7MVUrJh6R9N-QnloOkcXK1oFPg&oe=6B0DA4B9"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYABl5Y9PA4Q7kNvwEuQBYj&_nc_oc=Adr6vhExz0D5z5D3Kpdz5luxipdiUflUZZkq_uE28bdajJ13mf6RcBTjxuZp4sxVkgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTgFL3WjGiD2qQ0_T__azVUPW5j9Rl1KKU80mS19EzIFw&oe=6B0DC69D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/
93887_527691843767694_3049882066401243301_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1kfwMVuogsQ7kNvwE7W4mw&_nc_oc=AdoQ-YMMmV3Q9C1WutM6tbXJBV5T4O__upOJDW6JprUVjg_p58j0PooizGfT77UcK-g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyM3Pq4dr0KUo402h1pOhyu9lagl678i3KyDeYOdCIWg&oe=6AA159BE"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI9lAgBPayMQ7kNvwGbsN4o&_nc_oc=AdrrG7vlO1XH0r7vxHNsdtTrJYa3AobhpjcX0UquFbAaJX8m_D0EqcKWXRK3jEf74-8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMFRvqVa0-wpO7XN39w5rExVWS1mhxYejhjIdbKaaSNA&oe=6AA156FF"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHoosPS8sIoQ7kNvwFaf1_O&_nc_oc=AdqX5EngxOB0C_9RDsrkwKgTAJJ5WmTO2aroRidUakUbBhT7gGOFEbGDEjT0ObdUfh0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISq79-ZwZzocCSW7KR84Yxwtj_SSMtd3PylGIq07V48A&oe=6AA1716A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCKr5W3VH5kQ7kNvwEFVa6N&_nc_oc=AdqK3zNAeL4LfWPBGSwgYnCYgOLsIoXsjjcKfDOLz3o8PJ3LZtFW_4sakg4sau0r6Nw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInWuOONQV8v_5BvuITZiHYW-klzRXzIrJ9uAfdYJ8ehg&oe=6AA1714D"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics
ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572947_1254162915627538_5215355207963233467_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2xBGhJ_LbkQ7kNvwEj4LF7&_nc_oc=Adqs3523sAfekoqWErYUgsh1jf74l6UZJFThqmKF6Do1XsoPNzXeoLnph-hOZIwrlkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZYldEPA_tpLlRaAiqdjT_ubkJItzXy4BIZ_g4wwpJpg&oe=6A9EAA56"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-V9i3XAJJgQ7kNvwFK0oE3&_nc_oc=Adrpyjq5OZyMPPPJVM_9Vhp5232BOzbMYW94kxkNOE3z5oAL3yfy326vC0-DNNaWKG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnjEhh02mLD3Okg7kZRMd8Xf8xOsA4_OkZzEvX_nknlQ&oe=6A9EAE79"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPFshVjbiq0Q7kNvwFVQPot&_nc_oc=AdpbF_BOKciGasNX3rnfdADGZ3fTeNto87dbapaGUf25z_8Hqe04TvRpyUH61ILa2nQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdtNYE6jn2YGNTtea55NaM-YNFqI2B62N75-JPco-1gw&oe=6A9ED05D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/", "website_url": "https://fixationgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27396919573285075"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "f
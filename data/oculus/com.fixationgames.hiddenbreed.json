kNvwHDWeSd&_nc_oc=AdpHBTMWpsNBwx1JQ7deQ0Y03O_u0dKbztRjUlb_AXF0oLrGf4BLCHsrl8ouIBDQMDc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuWU-30JOjRf618sgrfXmRc8nHdbUSu72cxddz2HfkiQ&oe=6B08746E"}, {"file_name": "HiddenBreed_02.png", "id": "527691840434361", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473393887_527691843767694_3049882066401243301_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUNrxtEsrYwQ7kNvwEtBoMz&_nc_oc=AdqlagGicNYJsH2sfMBlSwV-VO59LSzwUtRalIS0kijKpLoMBcMO7vEd-XZE1WrBNJE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3gmTH9Ead6LPDPxw5l81tU8c_fYHR0fvDfN29yihJ-Q&oe=6B0866FE"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvY0J0cf95oQ7kNvwFkcPkl&_nc_oc=AdrEgfuuG7LT60M5SlBkK8GNyFiM3qd9JYLr5gJsjZ_9227yG8rRcvPjpBA93sylrDQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0ZzymC0ORbFIqEgeLBxqjsAX087cZW-GWaL13K0atlw&oe=6B08643F"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40gKXDR7JXoQ7kNvwEZIVRA&_nc_oc=AdrAiWnnj2FOGd34FhAcGfowxlico6yVJ67JoWOGt_8NuUvwnUEIqY1bgKcT2Xd2_eE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFfXK0Kvr_C5-p-f-1ZgejdCBshzXipjyZ3bXeN9tO4A&oe=6B08466A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1977abv_9cQ7kNvwG5qWxk&_nc_oc=AdrNtnXecZOq_LzSpH0YBLlZuD5ZszV-Xw1bElXNlH-3FZzWdehz2JD3tWltB0C_kFs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI2G2ItYV23CyFKo4HgpbmPiEh2YUuht_FJ22DX6irjQ&oe=6B08464D"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationga
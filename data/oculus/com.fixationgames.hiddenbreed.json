kNvwEU8RQt&_nc_oc=AdrknPgsvf9uzWcC53LRXWMDOV_mhkljRpwDLefZdCAKNe4FXaSHPAeYnzSZ_FNsoV4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW5rAUyCgJuFLzEEK43HoEfrhUAGP3c3XGZvBUeh-eUQ&oe=6B0722EE"}, {"file_name": "HiddenBreed_02.png", "id": "527691840434361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393887_527691843767694_3049882066401243301_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUNrxtEsrYwQ7kNvwEJwkye&_nc_oc=AdqtlIgFzBzVhHugJClHibLAZXqhhweXtxN_UUkQwCpSQdYuZH77KnF1cQ_P9SgNuTc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3Q8XVGN-bKf1QWbO9QlwYlnpAVVEvwkT24jt1Pp6Rhg&oe=6B07157E"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFwH8ZM-ZSsQ7kNvwExlkae&_nc_oc=AdqdY2P8Hrl7vR1btaL2PwyaYcTunQ2hUh7LP8qW7BHJHZRB6osZFzn0NoA5y7DRESc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeYomnM-WZa9vcGYDJ9xDUT_mYM05P-xvqatNJJwsh5A&oe=6B0712BF"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogco81Y5tPMQ7kNvwE6Eq52&_nc_oc=Adq77z1syhqU_8SvjmVBoBxZND6xmwF0aeRQVetiiY2pgsHnQG-PzHHdf4JZnu08Ra0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvhzlsMido_kJ3fRwVlnwQwiwL1J3FPl8a5mSr4t8QaQ&oe=6B06F4EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0H8dF55cF8Q7kNvwGltPm3&_nc_oc=AdpeMPxDzmjeW-dH1n18c9esO4F_wYU4zxlNBRkjUBaYvqlkqdNu-1KwmmngdJeLRfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJBvfUM2KXrp6g3EUPTcPFO-blnfdkGs8ooZ2PHK_crA&oe=6B06F4CD"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationga
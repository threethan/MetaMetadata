etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVcdo6Sklr8Q7kNvwEnq_D9&_nc_oc=Adpver-IUkyCeSeI1OGHpKgDWJzX2AJ6aRroLjm6Q7WvUJz1lYDO5RILfyZriNFgoZg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkr9F4EjAFaw1O76txN49nKbdaff4wZ6PebM9twGca1w&oe=6B030E7C"}, {"file_name": "HiddenBreed_05.png", "id": "1199204234516052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75302218_1199204237849385_3514117115698024278_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQ86zwFcm4wQ7kNvwEbVleD&_nc_oc=AdqDpTDjIlW_iC6qgtfGpA5aExBHqUCkTa9OiOjjFOr7oIvtDMSbHNMiVY9k07I1940&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGKDQEccuFeWtz8o3k_HyuqGM3f8_dIup4UhToehFjyg&oe=6B031CBC"}, {"file_name": "HiddenBreed_02.png", "id": "1254162912294205", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572947_1254162915627538_5215355207963233467_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=940wyln8SbYQ7kNvwHvi4bS&_nc_oc=Adpb3x2vYRKsU5DoKbx8mySf-SZjQ8f0FWJZpkkcXMPM8-madn8JKHb8fQPsXhkEOMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzbPaamndVtnRK42wrHBziUEvvSY4fO-wzIB6m9VHRgg&oe=6B031496"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OkgTRFk7pIQ7kNvwFWvjOL&_nc_oc=Adq5DYsrHvLMwQKyNHlW1YWJdlzr92zq7llKVp2K_H5FdRtX4aMJtxGugD___xFVOQc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbKlVaC2po_ThfJS7J6CA4jrhv5DRVnND9lAeaGGxtcg&oe=6B0318B9"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yWOxmdAv84Q7kNvwF37Wnt&_nc_oc=Ado118Kqoy3C73T-xnyyCUVkl40QcP3K2GKPTfcYqkHmFie9tzUEw5XNYYNLFKgp2gk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6GogL9iVC0a1kxlzOBuWp7PiW8WBSTazsHvJOo6f6qA&oe=6B033A9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/
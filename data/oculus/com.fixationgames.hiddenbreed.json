_sid=6e7a0a&_nc_ohc=ff49XN_YMh4Q7kNvwHn7Vkt&_nc_oc=AdmVog3ALmls39Q_gzgiPLtsqPkp59lhp43_TDI4k2ams0o3VxhZ2OBYkNi_nm4dVPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftYXsSuG66IMnos-ON_Jt1WuPSbsz04Gki0RsTHbKw0AA&oe=69A97356"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfzIZeZ7k5wQ7kNvwHCHXFb&_nc_oc=AdlVOUHSoqhcM3By-3XPSD1DU-iEyMyk22FpyutM680nUNlDCu70UJDBs03q5J6HojM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs77Nav8nTysIhFc574EMh1jJ62GvJ6ty0xjBIDSWYkIw&oe=69A97779"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lptqqXChSTwQ7kNvwFQCLDO&_nc_oc=AdkH24cz__tkP7w18EF1y8s7bzlg1mmynDPqtPVw8Lwax0m3igrj0MGCwVS2-rmFmtM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsZy7QiC87un1mEf8p3Fn68yKIvi-MHvaFxLpdn728-tQ&oe=69A9611D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/", "website_url": "https://fixationgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27396919573285075"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": 
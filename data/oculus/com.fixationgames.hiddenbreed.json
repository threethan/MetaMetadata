kNvwHYWCKU&_nc_oc=AdofbvmQRUWpbTMzQbhWH8ZXZ9nbjxaNx7qHFHKN2SDAuLuPpqg9VKOHMGiWNoPA26w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7z_OeXHqqzX4vjLFDa4uc6quhZD7lj3tNx3j2oxAlBw&oe=6AFB456E"}, {"file_name": "HiddenBreed_02.png", "id": "527691840434361", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393887_527691843767694_3049882066401243301_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jc-XcJxQSCwQ7kNvwGiZlJz&_nc_oc=Adpf-4bkl9Tw5zjCnsnrWvwP2M9XGBJHvxYAN7imEI4r64xk3_aTd8BbOfnzZzT3MMU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrOTiNS-hklzrbTvU4neBuBeou3Nehr-OVHOdCZ2jmyw&oe=6AFB37FE"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKpb8G6XWpAQ7kNvwFuMAXi&_nc_oc=Adra5zBMK_fx40HIHjIoERjPES_mphipjzJibbpcpLJsD8e4HRGYumzE-fN-ARcBlRo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-dfKZ2OrherGRJoYlPV-0EVPy4US6cFi6aA-TDHaRLA&oe=6AFB353F"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3nKlH7A-g8Q7kNvwGGo6lT&_nc_oc=AdrkmZM05N5ZXj2Rww01DEiwTbD1TkEFaFQgVAy2xeZtooO-vND29AfaAXHWA53Olcc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPZmg6IxgwDHHANV9SGdxCiy7q2fxP1-Vw31HdNEuQrA&oe=6AFB176A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21GMB44leoEQ7kNvwFEbdEw&_nc_oc=AdrMLQGeexbmZx8Fts-NW8bOozKiNyTFSWQhO82D2Mp1a3nBcbXWFcvZ7soNSgb-6gA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrWIEPRnwt2MZeDGVMpbfGCgYY42re916zJjE_Gzkq2A&oe=6AFB174D"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationga
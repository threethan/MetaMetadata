kNvwF2I7YR&_nc_oc=AdrM9sDmxdDpRW815f-kM5EZlpl0nV-vXkKaauAQv_6iGpp7YmeSFuWJvmwWdvY0sq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_DGLjC65LlmqjO5pja196ehxb6Qwdg6aHMUx0GG_gtA&oe=6B0F0BEE"}, {"file_name": "HiddenBreed_02.png", "id": "527691840434361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393887_527691843767694_3049882066401243301_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5NMJrNyp2AQ7kNvwHZIc8w&_nc_oc=AdoL1Lm2kq0Vlsk5epnI_OJ6Kc1cpXhgUEcrsiOoS0DzZmGPluuDohzkJlvhByKaoeo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFJaC2Mp5d0BrMbMg7Wp84ALl2WJ51s-snfeAGCEvWHQ&oe=6B0EFE7E"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIcodA1aEtwQ7kNvwFvkWcK&_nc_oc=AdrnsUpFX286IRQb79ntyedl4J-4NUjQNi_B1jYj7G2uUABsnJIV45cc6Z3Ps3dU0Gs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVSwwQwrrGkEiMc4VsmHPyKMVMuJbXFwfJiapEdnUAaHw&oe=6B0EFBBF"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkqB1wD78Z0Q7kNvwHrTz7e&_nc_oc=AdqoGzVMW9Aja-tO6VVUlsWKqrI63f-6BdIPQ6d16rkNH92PD_6c7BLvmwvZeWuj6DQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX28Ctx_MqfCQmjgk-Akt-BQWEyzU_lnH5zExhQ5KNT-A&oe=6B0F162A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=antkrqp9Fu8Q7kNvwGCMDVe&_nc_oc=AdplnQTYJvq3klSV63DQho1sn7amr8-YwHHXZXiMbZZ6vFRivvEA_LOSUxBSY9RhctU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVxYr7FTL8CIEuMTQ34hH94-ElTEYiDL8PIOGr01a80bw&oe=6B0F160D"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationga
kNvwH1JB_4&_nc_oc=Adpl4m31NkbSBH8k_GVppfS2ooR6nY71ZQPrRxg8vT6mbDizwbCyuoLKZCsEq-VtjCc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVqQZWRJz62pm47a_Q0fwj6TmYCm_WZPNJ1JImih18k5Q&oe=6B105D6E"}, {"file_name": "HiddenBreed_02.png", "id": "527691840434361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393887_527691843767694_3049882066401243301_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5NMJrNyp2AQ7kNvwH7iPsY&_nc_oc=Adr0rp1QkgE8iMedCUiaC-nNyn77Iz-MbRkdR38tZx_BkznysXKPCz_sAwFhSfyl0pE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUUUUgGpHRfrVDG_onIcvCIYS9QMMalauXVYIYlikxrbA&oe=6B104FFE"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6HDVF0HEzYQ7kNvwHqgfTf&_nc_oc=AdqweoY1FdetH0ubbyf6r6jSOu1NaZDLyDeBFMJX1yGmls8HxESnalfYWgwocsEzOIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXGiAhUJhR9CIVUEo2i44mL37LwahwVlxNwDRr9MmIgzQ&oe=6B104D3F"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUFwiIa654wQ7kNvwG4VFMP&_nc_oc=AdpaY8N88Zmy7wumQI0465tUtmY4SUaJ63DUY1F2hwKwaOm9GZtXBth8gaFQg8PDw4c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX-2TkkumoA8RoHdbYADr58qPvmWXSgF8pF51nqUIZVWQ&oe=6B1067AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UA5JeieTj0wQ7kNvwGR2Ug7&_nc_oc=Adqn5V5pdKnrYkyI0ZxInO58lkeVhLxD3d63cf5tTZ5uqy8mUwH_YajRMMLyB8o2DDs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWir0LQR3CNC6IJQJ7QPKN-hS5vGTb_QFEFhGflxgqeIA&oe=6B10678D"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationga
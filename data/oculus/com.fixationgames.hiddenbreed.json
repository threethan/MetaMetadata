kNvwFw_zf3&_nc_oc=AdqbFwIN86PNJ25r-hXIimkhAsrfZJ_EojLy4AJzxyC47yiHd2eueuDIHJmh_iGj5MA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROnEBS4V0UsJAwXMW6Py6kgt_jdhSEOuAyzctziGUUrQ&oe=6AFDB02E"}, {"file_name": "HiddenBreed_02.png", "id": "527691840434361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393887_527691843767694_3049882066401243301_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jc-XcJxQSCwQ7kNvwHQK3zT&_nc_oc=AdrJGUiVCvj-erTikaQL0drLekD1T7elchCtt8IT4L39OSSjDaMoRJWObyLDOgrhgIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7UHOVsTykn0Vn13ejx2l22Us-oHb1ZSCP4fcgtT_9Mg&oe=6AFDDAFE"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juJ7JwbfZfIQ7kNvwFrrX7D&_nc_oc=AdqUjmh2W7gH3_qXyaxRoMLvO2KonkLm0f24UZ58lY6pdOIMaPZ-CO4Z8LZIQsvW5qw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZpEOo2i16brsAICauM59cTSx-NbFj1gYGyIorZ3oNbw&oe=6AFDD83F"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY6eUYziggcQ7kNvwGxGKJF&_nc_oc=Ado2Y7a_mO2C75mOh2-QYNaEJZQVcHOoTSUOrGAG08CC84R8q12VBs6VkEIFhwLn_M4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScEtVlA-aaR7qzsCLL7toc6q7QHwdfi-cNTfLZads8AA&oe=6AFDBA6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPa5vFZT5FAQ7kNvwHagIhu&_nc_oc=Ado3FdJas0ZcRHcAehUV2pqGB6gDYBP6U-1iIMBc9poYBPMbgxDy5hxt-uTLnRU0iWQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFzZvujdsi87foAakdtIoxsvDCVJncwfB7CRkYfV9B7Q&oe=6AFDBA4D"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationga
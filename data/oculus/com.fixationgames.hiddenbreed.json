etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOyL4QbtD7AQ7kNvwGDQ8PN&_nc_oc=AdqCED_3-W88DhxsKO1Q6FWhfMMEOlxHPrXDPyZG0a8f9LIA9LKOchVEQw5QtUq3P_Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRnRYFl-JlK36g5jTwjeMbgKASpL2E_zx6PVcJBQ3XEUw&oe=6B0B2FBC"}, {"file_name": "HiddenBreed_05.png", "id": "1199204234516052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75302218_1199204237849385_3514117115698024278_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2qQra575fIQ7kNvwFCCTFI&_nc_oc=Adq4oTpCfsjltskMhWXkDykkZip13X03HRMH7DzZv6lVOEby-3JL4X_qTF7T8Kz469Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0qBDs1K5QfK5HjQtRiC-pYjwATmT7oqOzzNjUY8iUdA&oe=6B0B3DFC"}, {"file_name": "HiddenBreed_02.png", "id": "1254162912294205", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572947_1254162915627538_5215355207963233467_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSpWqGLowtUQ7kNvwHlEFFM&_nc_oc=AdpDP_jfGk_iIscrxftL6ameurg_lYmtgZbkNOROvSHplsvuILlcRVe65Rz-gmg8Slo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKpxT6Ot6UYMEcEY4zJBpaQ-laLu9uRb1oOL_INLZd5w&oe=6B0B35D6"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5J8fNot_ISMQ7kNvwExJBJT&_nc_oc=AdqgbsSW4_PuFxd1AojhpZ7qMymGhYnZ4nG8_2v6zK8Z8N8_bEPVQFEJdxcL6EuMth8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQChWoXxtchtdkINSmyC6ATI34yuQnqJQK5YYXk5sfpxQ&oe=6B0B39F9"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WnLPkh5g9sQ7kNvwHhOqwp&_nc_oc=AdptJOIgxip3guWSl1ylEJlopr_-XGsOSNwkiMosSSwwtiaM3wNRMhh3xwRfj2fSD2Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTutDnR-h2AJO3fPp6aUtlZoTPiVBqI57uGxit53xG99g&oe=6B0B239D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/
etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcMuqIr8NZYQ7kNvwF3TebV&_nc_oc=Adou8igD3g71vagmrMJF52k1Xgg_V-Jws30I0hwjq2HwEYxbwMJpDxMaB5Q9QWbGVAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUVmzAVxdzTFMENyBaxx64SCCqmCzFIBMcPVhH4VM7Xpg&oe=6B103D7C"}, {"file_name": "HiddenBreed_05.png", "id": "1199204234516052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75302218_1199204237849385_3514117115698024278_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIsAqVtMi3EQ7kNvwFbpY9q&_nc_oc=AdrBnPwiH39ojAVKhGRGFc6l3n7dCOAVByhJaRMiwvBwNy_dToBDJJO5uHY4ev3xV2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWTDoY3tCqYp_nCdxyHQBNPA76ccxakE-gm6Kio_OyReA&oe=6B104BBC"}, {"file_name": "HiddenBreed_02.png", "id": "1254162912294205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572947_1254162915627538_5215355207963233467_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QTEXoGLq1sQ7kNvwED5ivP&_nc_oc=AdqzsAWXjKyfSn8MwRkNzWdlyZLBVH3zNKhJK3WuUoqW6rmBZN-_YCUwfnOQ-dMDOXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWa4eSqPUUd3GaSDUDcgJOryHgQdZAXMA_mO5a4bzK3aQ&oe=6B104396"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bt0sMj6bKeYQ7kNvwGzWnzT&_nc_oc=AdoVNEEr_tXP799crHVcWxMHRSTtgIaZHz2TsyqXd6_LMdA1shd-hkipLwriBsNFKjU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUCAyRj3eGgcfcdRVqGyh4jFE9iRb6s3XRm9qAr-L7ggg&oe=6B1047B9"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx8QNMu2vv8Q7kNvwHYoKVe&_nc_oc=AdoylH-hRvmSMwpSjvN2KnBEaDsWRyjjToxLYeEPCLyvyIs2QWDQZnZSqpfiwvaz4vE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX51zk8L3FXypYL_bnIEOO2mzlqeQSCVJdgg51qmaIdqQ&oe=6B10699D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/
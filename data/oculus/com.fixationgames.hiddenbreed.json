etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOyL4QbtD7AQ7kNvwEvN92v&_nc_oc=Adoyv40Ojy4N0djTkkyUz7HW2J4pLlA1k5dw9G2H2lPuQ6HXWppOOgrZs9X6LpO8FyQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtoE_6AVzdWnY6xeLo0YqmKDKx4tzLO9DJo08CkdylPA&oe=6B09A5FC"}, {"file_name": "HiddenBreed_05.png", "id": "1199204234516052", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75302218_1199204237849385_3514117115698024278_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2qQra575fIQ7kNvwGb6Buh&_nc_oc=AdpK9SineS2jb_DjjRY_o-tYU1K8BMvAjiE-FZ3ILQdIl4_SdMpkEs8Ga75BH4aNaSo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP2ZBvKd1nAcyyYwuX10A39ZdaBrC0cds15nADzlV4Cw&oe=6B09B43C"}, {"file_name": "HiddenBreed_02.png", "id": "1254162912294205", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57572947_1254162915627538_5215355207963233467_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FARn9HddjA0Q7kNvwGRN1Ly&_nc_oc=AdqOUumLisGtmC2hetIsvtoSyoEzupb5n8B7JaMEwbWYXMJAeFKkvpPGew5NsyvSCqo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMpD-U_raX7AIIqOmLl_v7_SZ37Be6mAeihjZNcLIRRw&oe=6B09AC16"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5J8fNot_ISMQ7kNvwE9EP6_&_nc_oc=AdqpI7RrDj8tdJ-9X7vHJFe5E9TEx4iiypx0Mld7lbMMuGQ2LIv7FdCT8GDlR4t4fBM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtNxZUdOUV1Ll63PciEQAPpMWFyanLI7-AaMGKu6_Vxg&oe=6B09B039"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WnLPkh5g9sQ7kNvwEUoUmi&_nc_oc=AdrJCzSdQOzMDlxOTyj_JE8sEpPfklPgneFIrq2Mq7C0Jv-W8AFDGuhXkg4q2sBA1vk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2zdFyYSgyJN1m44sPhnLAkofW0E02M1BqVMnfZJZ8rg&oe=6B0999DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/
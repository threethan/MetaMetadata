etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BVOaPvLChMQ7kNvwEOwdGN&_nc_oc=AdrsK5NLiLv8ESynjIVcZlqCQ1-D3uhMqbdCgFfaF56yzentkU8bPSbzySXSAK-Cb3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGV9D0sPv6jI9RVMPwsB43TGQi4LfFaTtNsRdzGaaCmw&oe=6AFDC87C"}, {"file_name": "HiddenBreed_05.png", "id": "1199204234516052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75302218_1199204237849385_3514117115698024278_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VA_Hm_n4_YQ7kNvwG3yYys&_nc_oc=AdqiRjgpIFQISyd-Dg1RLd9KhucrfNTnHWdZZ1_HeQo-XffY14X5YpvzJ9ztiwN463E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFfkeI0NELF3vQrvW5TRebZh2H95RpxEgkqpFBU8beyQ&oe=6AFDD6BC"}, {"file_name": "HiddenBreed_02.png", "id": "1254162912294205", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572947_1254162915627538_5215355207963233467_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qs0EdQwdgS8Q7kNvwGF3QlJ&_nc_oc=Adq7h9TWNTI8cfMvFIM_MWGN5y2vF-bptgVm2cS8t3pLlEMpql2KNWqJ2eug8GLh8uk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw7V_6BFPvB5Pz6o1vm0EGne2ytuWfFt9H70_FdSbRBA&oe=6AFDCE96"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edvk-0GtasYQ7kNvwHDNiQp&_nc_oc=AdrOhKVJ03IMM-_AZlxWuza9e1b_ypuh4m8DUyEgQ_GUXTjVO9YwBUKxMgy7miZWmgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuS77qLs6GxZP2yD1v3AFHtnArpX0bA1M5El0SDwD5yg&oe=6AFDD2B9"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IT36XvOS_WQQ7kNvwFebCsO&_nc_oc=AdpRRakzoonyK2cYrmEo7fW4i0t5Trns0Vd9Hq2n_mcUQUS7wepV5ZFDkC2z8Rt2wWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2b74PK5BoxG8YkctKHKuerXgOLS_TWliBDFLvK2rliw&oe=6AFDBC5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/
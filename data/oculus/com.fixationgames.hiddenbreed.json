93887_527691843767694_3049882066401243301_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osof-CJKK3QQ7kNvwHfgODK&_nc_oc=AdpYJnzLPq7vgWTHi5_-X_S-QMptIJvhNDygjuKtM_HoYOvwCjbRTbMilvzWcz6kQDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKoYFMusEdmtfhuejRBU9-x_jODXyDMC6YoPHCD9bPJA&oe=6AA69FBE"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZ54Brff7CMQ7kNvwEmRzLl&_nc_oc=Adrf2D0UrJcnld4DOHdLQf_8JkVaCd_yH5D2DHx1E09SENqilM0oj8qit11TYMoE6qg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8QwDPbinwNQkxj_Rgur_aXljqi8yA_VIylUvGsjz7vw&oe=6AA69CFF"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAguVGMycp8Q7kNvwEkiOBz&_nc_oc=Ado_u8TnSqa5fjMsFR6QSzJ9ljy_GfsooDfuRp1DrJ9BloElwVdTEyevoCK3FxA2XY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeVIZJCtA-YX73eyQgVGZQHa8DZ2Slgahrtt_WSvOhDA&oe=6AA6B76A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sz7u1KafCdMQ7kNvwFw0zw5&_nc_oc=AdrP-GtEExZXSoyD6o_bPbkRp9c2GYy4nwRXS1vetr55ejtIW18jROXWqrgQCK9mtco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaFKGQ94TkqehCYRKt-dc6vwTbedC7v0_j_fUEIEufNA&oe=6AA6B74D"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics
7a0a&_nc_ohc=h7rWi3W2kRcQ7kNvwGo-mqw&_nc_oc=AdpBMV8kp1O5o7AFxRw8CpmiLeLEdolaXfEdnCKW0oou5WL82-4AjUKqYZjshh5jIuc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af02jzrtDhArevPx598uz6sIlGY_UBWgY3z4t75Ei-q5ig&oe=69F2023E"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5I8LTD7o5IQ7kNvwEBqSlg&_nc_oc=Adqw8uLr-xuFHijpRQQqrghY0FlNzIDQ0F70cWBkva7RCSw9hqxREdsMPKkp1vj5C9U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3VBmK0iLp821WhbNc6oDCmacB1jkmdWM7U6AvDKmGVvw&oe=69F1FF7F"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsENzlU9eKYQ7kNvwHd7hFv&_nc_oc=AdqatOJ5-pGmKKUSyNLGW7gJNFWiOHq_mD1TQr87WGf2ejynhDyRZr2ADAwdjAwJDd0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2MoQ--UNbsKBEIs3FoMvrBECbm2fLX510d8mAKsH7NiQ&oe=69F219EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8Y6MklB3wgQ7kNvwEIODBc&_nc_oc=Adogjo72GUPFikxmQVJIO3Rcljx8AB0pnTBrBvmwZ6r1OMvlQZ00OlC782mOibYpafA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2PbajCNN_n8kYNtdMYyGE39TucVPMvpCFaNnML7ojYMA&oe=69F219CD"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhFtd_E8w-QQ7kNvwFsqN6B&_nc_oc=Ado57qtgpFGFKnwNhq4qLV21lsC45MlMcC2FZ31CFxfzGUQY63VR-c7oWJfciDLN09Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIRfvP72h7PR4Zf-e0tISzIpRZfvlorDFOiTxgxdHNhQ&oe=6B0702FC"}, {"file_name": "HiddenBreed_05.png", "id": "1199204234516052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75302218_1199204237849385_3514117115698024278_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xrlih81bhwQ7kNvwFStmwU&_nc_oc=AdofjWPZK2hf9QXNh1HqSFTZswr3ncZowOxkCLQt7X95v_kOYPbdZql7cvyia6gmXss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZOuV20R0qWRHJOsRsY4b6onEnZmKg7N5aRkw0B3sf2A&oe=6B07113C"}, {"file_name": "HiddenBreed_02.png", "id": "1254162912294205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572947_1254162915627538_5215355207963233467_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FARn9HddjA0Q7kNvwEXoCTM&_nc_oc=Ado458GErolqFxgdAd3wLTRhuPrOBndABZ_3fBb2LOJ7MbJgwR6bnWXiFzE01brzMFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkGq6qakK0_lzCcLRVFxIo4F6jdNxubAi5PzHx9n6z7Q&oe=6B070916"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDw0uJJnhzUQ7kNvwFC_3aT&_nc_oc=AdppO0RniTZvm2dlri4cu0AFfRmFfqJdo_4UVcdIWKjD_lW9MpCWhz8rxNUoDLULeGE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGT_NV2BPwT6v7S2FMS4QPoM99lS4ixCN6VQNetqGLRA&oe=6B070D39"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAD10sUsq9gQ7kNvwFl1BNy&_nc_oc=AdpYiB4Fmzz1DXiaGRiXLspD5qGSf6sD467B1eVotyaVUWII_bV26IhX1WuIRmV6S88&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaC16hWGKuCH9ODWYYxsTJV2ZWwYCrcIRPf3lNjG3DEw&oe=6B06F6DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/
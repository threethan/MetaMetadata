kNvwGsU7r8&_nc_oc=AdrYVwPmq5JEdpvJMotME3FyygQXjCSpsAQ2viDOAX_nq_pLv0p_BzFuRLbp_21Jqe4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOPjEKCrP42Ikc1Sea2Beqx_T876thh0rrxwqT-aq5gg&oe=6B032E6E"}, {"file_name": "HiddenBreed_02.png", "id": "527691840434361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393887_527691843767694_3049882066401243301_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80LIpgzS-9cQ7kNvwGI-nWs&_nc_oc=AdojHrzFWSgrypFDuSbmaJukSq31qtc3jBYdnfebeoXgWlG4TrNLLDTbBAgNNcCnVVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp5_RjEl1NwdotfHaLxEoYljtCb6CBB4ddJW0wkN2eKw&oe=6B0320FE"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7loO_sDAsxIQ7kNvwEX1Yk3&_nc_oc=AdqnDGXCJTyEJhreJ3gYwvChwu_yNSX5SyV0cKi76MonGJhmRz5MccgAI0qbDrlowAE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ_9GfRgsM25ZDubpWWfqZ2jCKD0DdTPIkBD379JVXBA&oe=6B031E3F"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtfIyl5wum8Q7kNvwFkoJ_r&_nc_oc=AdovGxhMlcFxDW5bErkgnB4z2FEgUMwaMVlFs2bVv3JdJ9JnYPXvmOYQHXw0ZrKgSZE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4Jbl4fDqGxHlxx4wMEcSWdF9xWHvKzuA_2DpnPNRIdw&oe=6B0338AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M23I4QcMUnYQ7kNvwGkFk_k&_nc_oc=AdpZyLtxdKhZ7YaGc2Edpsm9usQcxAbHvR6vXfqcYUzA9a1Q2skGoprmnEzh_CagBfY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVxN9ZYP9iZzZzGzAPzFkS7daRuATu8k363Fv6ZjsRdw&oe=6B03388D"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationga
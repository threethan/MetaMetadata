etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOyL4QbtD7AQ7kNvwEDVaw7&_nc_oc=AdoQvW89k1_a_-eSz1jBiIEucQyK9GhaySo2wccw88rYnuL7EoZ-kJX9ydWUlAR0rFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQD_1jWr2vt47bZlKjPudBXlcwg1XyUwkYM4hZ9bGiZmg&oe=6B0C813C"}, {"file_name": "HiddenBreed_05.png", "id": "1199204234516052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75302218_1199204237849385_3514117115698024278_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZjz0PK_YpEQ7kNvwFWbj1C&_nc_oc=Adrzo6HB2weJwsihJ8oauFEbidtf8QqxIQPzF0DGa1Kb7_cE7QvZGrY4j3xYXgZmd4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3on_ji6xr38aCQ-iRTSAefSalq_RPHbpn6Wx7yMvTkw&oe=6B0C573C"}, {"file_name": "HiddenBreed_02.png", "id": "1254162912294205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572947_1254162915627538_5215355207963233467_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSpWqGLowtUQ7kNvwGekAp4&_nc_oc=AdqzRU4VQszLBZHHFVy70pPXINhP_XSGfSc2htN2VClk5WLDvIH91m8qHiCuhGkwdpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTI4jdCW5a_8hrnklfyVwM2DgZvZQVPU2DK_MOvTeAhTA&oe=6B0C4F16"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5J8fNot_ISMQ7kNvwE0L3-y&_nc_oc=AdqB18DvE490Xk94Xh92Yky9ecnzS83vJGTmF6ykstLPbrY1aacXPxtuD8q5m8NYcDw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjXfVFNVZuunGeCNzCNSW4Jbqx7c7SrutW9Y3l8xBcVQ&oe=6B0C5339"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYABl5Y9PA4Q7kNvwExsZ_E&_nc_oc=AdquQa9zAg__F0U5e1UIcK0exU_PmdYhP41-JVvbbmLBLw49e4Mjv632W7kuhmfaOx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUS_5-geVGoVTWwOgGLSLU66QjpnQGXhvgdGmo3f8sug&oe=6B0C751D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/
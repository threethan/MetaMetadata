_sid=6e7a0a&_nc_ohc=nkWeQN9PGg8Q7kNvwHaSQ9q&_nc_oc=Adn3DZaOndnmI7v05_XCozi4M0Y7DY9tCgBV43gGb6rlUogihqK9qOMduW5w-O_OeEY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfU2H3dCTkwI9_u64oDlqxoXlzInDs0asj7RutYAm4rg&oe=69B00AD6"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvj5KVlGTl0Q7kNvwHxtQBu&_nc_oc=AdkzhIMyxxai1w78t1WHrpIDBf_rQskpoBRpEGIBCp1fLi2o5dkoBavWjVbPuu3CXPs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxW2ue7i-Z0--Gi1cSowj07vMBbzK-Imj62KH0lZuItVA&oe=69B00EF9"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QE1ykBFAe4wQ7kNvwHgb3wB&_nc_oc=Adn4kQl44pUzF6ElhbYC4Yvz1bbsyuM2yOD6lM3BOtQmh63FHOy1RGWgSA48MHvchfQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afych1J4MRSL6KYqI79U2Abq63x-lgf2FAkkm-m6Cy3yhQ&oe=69AFF89D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/", "website_url": "https://fixationgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27396919573285075"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": 
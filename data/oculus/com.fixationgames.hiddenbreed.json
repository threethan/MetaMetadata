etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BVOaPvLChMQ7kNvwHM-Pq6&_nc_oc=AdqBhvvmXgfw4pXl8lohzaT-M-Iq6U4yG8ZI6e2lFfK3wcKO6DZHrCHnnSGrJHIqkZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl1hHjaLj6eOmUZxZire2HZvcwHNCJK6Q1tDzfqJZTQg&oe=6B006B7C"}, {"file_name": "HiddenBreed_05.png", "id": "1199204234516052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75302218_1199204237849385_3514117115698024278_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VA_Hm_n4_YQ7kNvwGEBgpP&_nc_oc=AdqNHnIdzGoQsxb4m6IL73rZBe9XEfuj3KYXvluhlldtTcgywPRdXxpOgV4p6co6abU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzmfVHBVWR1ENKwoVJgGsdA3gGN65tKL1pR4yk7sSnuA&oe=6B0079BC"}, {"file_name": "HiddenBreed_02.png", "id": "1254162912294205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572947_1254162915627538_5215355207963233467_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb4CgLgS6wgQ7kNvwFvFqMh&_nc_oc=AdpnT2qlcTyq1jy8eg8m9-tdzNZjeY2tO2nE_h4vcAkgltNCu5IUjaQP1AFdmy-hLcs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOD2jtrqlnL3-5t1_eY7tfnoh9X5t0ZqVnmGUjYlFAzg&oe=6B007196"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edvk-0GtasYQ7kNvwE7PG-j&_nc_oc=AdrWZJV1TxXNykAByTW5vjzA3VOQEUvkLK7w8D_xtxzfGDgFwNmrVGzETyNAujwpeAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMPpTJi0TW1CSXFty8gJJKwTpMsu2MJeClc4ZadCuaIQ&oe=6B0075B9"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yWOxmdAv84Q7kNvwGnpP0w&_nc_oc=AdozxXImszB5K9GE4ZNP1JA9hmngXmcTXVguhlCTDTfPl9JKN9E7TsKkJrsnQ5tHEjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIBMY0HaFJttLOVAslBhrCpcQlnWp3X5ObdeRY60cohg&oe=6B005F5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/
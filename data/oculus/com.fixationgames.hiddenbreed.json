kNvwEDO2AC&_nc_oc=AdpRWe0wT4BGx5BqjzVN4mHiMLbybuV1N-29MotcRYqMS1Dr2NtTGqwMs3iv3xmFjrs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcPlxys8a78o22s35Tb7PqB74y4iAKNsveJ-b-7DCnIA&oe=6B00532E"}, {"file_name": "HiddenBreed_02.png", "id": "527691840434361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393887_527691843767694_3049882066401243301_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6_cvtDPAf0Q7kNvwFunw7k&_nc_oc=AdotkPU3ww9Ue6Yq038K6F8HJQSqJ5XF2EypZK2k9R2NssV_j_uf9OzpQ3p-7-m9s0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPAtFyxkxn--yrGrpkzCwO4tDgluNFbHgR5-mGDB2bsg&oe=6B007DFE"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7loO_sDAsxIQ7kNvwFIDxTJ&_nc_oc=AdpzQeSybAPEh9kw4LQAsU97qhcNDlxPzS6YiN2etOr4uh0qI4j7SGeWb3xOMYjzw1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUjLlKdlX0Sze2Qz6JdLEjJ0OpN3obaCwSPDzHpHVDFg&oe=6B007B3F"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtfIyl5wum8Q7kNvwEz4b4_&_nc_oc=AdqLpb-Z4tw6rYS34s6LeHAaqTZD6muWbsHWLoeUh9lq2p5HAZvU8_kT8eHW7OF1RI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfI_OJwNGKjuuaD4pVJuAUo4atzYKspwQwA05sG_Yy1Q&oe=6B005D6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M23I4QcMUnYQ7kNvwHIs5N9&_nc_oc=AdpsgB4FnD-SKnqfCUdPqwsqc8Iz2f_LGc2f6y58MW17gsGH99YTAAhjJibOxUqxQqc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdmfclVzetiz7DiG6paoYDsoJIJy4ul1h_qzVaka_YCA&oe=6B005D4D"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationga
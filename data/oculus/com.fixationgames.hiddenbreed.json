kNvwHjvixo&_nc_oc=Adoe5R64WJ6BnwCeLsDkx6dWtxW2DZMO7obrtWqV-9BIM-foIexIDZtrHzyi0WrsjZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-13wNceA5lR_jGfvVmef6gG5Y_rL8Yp56o-T76GWWMQ&oe=6B0C68EE"}, {"file_name": "HiddenBreed_02.png", "id": "527691840434361", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393887_527691843767694_3049882066401243301_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CHtQO8OpOwQ7kNvwFAniuj&_nc_oc=Adoy00wptNpW755eOl37ZDeIjQBPAiRHtExTR9310tGFs4VKszNUvdUxcMAl934LmSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQvWancLBsPmUO1hQ29AnB38MmxvxnzbJr6HrLJcBFh8g&oe=6B0C5B7E"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIcodA1aEtwQ7kNvwEaie-N&_nc_oc=Ado34DEieGKtTi3F77H5CMxt-AjhkdsO-ivzkCebuG-9OUvAviEc8BloiimXnQoIAqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFUggZTU5Ax45QidIweoi3BWQjDUr7WSi-eBiNXjfy7w&oe=6B0C58BF"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkqB1wD78Z0Q7kNvwHs7nP3&_nc_oc=Adof2baTw3UEc1dDbTU2Nu_pUphJCAggaohQQuldiZPDHTiwrP4uW_3-kUWtIgKCww8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjbrE__fIRsGn4UIaB9X2Q1j60GipqRGKak-rbtkekoQ&oe=6B0C732A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=antkrqp9Fu8Q7kNvwHH7MWB&_nc_oc=Adp-3HIM4A120PVDCpIavK7GnG4ScEqzmEtd3YWuj4HAkQqpBmUs_QoDSZ61HrY7_kg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRg6NuIvaxv8rU5GJzATmvrcuVoXqHmdc5DEB3vRJWqFQ&oe=6B0C730D"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationga
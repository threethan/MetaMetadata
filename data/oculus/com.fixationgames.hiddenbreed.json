etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhFtd_E8w-QQ7kNvwEeoTJk&_nc_oc=AdqUU_Cny9uIzrx9oPR3xsMqm4b2-_xAvKq4D187q-VWVboATGHwdXTd0AsZEe8Mk0Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh-VyJ56ZtXwuOWBAglGp7W98D5X-kPSDw9zOgQkhyLQ&oe=6B08547C"}, {"file_name": "HiddenBreed_05.png", "id": "1199204234516052", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75302218_1199204237849385_3514117115698024278_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xrlih81bhwQ7kNvwGnNes3&_nc_oc=AdoWQulJ5Ac6s6NsiCxbv7dE0ChjWzwAySzKhhPuwFmcs6-kdMgOtS4Vt1lpWXr5-04&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScE0Zpheu3x_KcpivOeF5j4N6RdLEymFqOTscwwBIeOw&oe=6B0862BC"}, {"file_name": "HiddenBreed_02.png", "id": "1254162912294205", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572947_1254162915627538_5215355207963233467_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FARn9HddjA0Q7kNvwGFuLXq&_nc_oc=AdqXajKsgvl1XrxY6cYTNSwnW_5nX9jKqIXq1WvR1XEaz3qeIKh82DLFnaOibuVKQ0c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsO165OzwMyWrGCx2Gxw15cyRRiN0MxCsqbmozxu96yw&oe=6B085A96"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDw0uJJnhzUQ7kNvwEVNmc9&_nc_oc=AdrAqVRQcNQAey8kMclVn9MLlsnbuCUHJ_Klm6vnTonJkl9UUfg-JteaEr_dMMQChHw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0zWou0E8rHu4Rg18KOTEAItYpLzlx_fZ6BcuTyBOWag&oe=6B085EB9"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WnLPkh5g9sQ7kNvwEep_sq&_nc_oc=Adp8rVHo5F3WVUtHcQA4u2Ru_svIEX4EFFd7xFRw0iJPYdRMLYQPgkQsgBRJ9TbdqzI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdSp75uF-IAt99WaIvdddY-V3hmA-TAHvabtI2jfiirw&oe=6B08485D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/
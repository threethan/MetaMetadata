kNvwHCN3Ib&_nc_oc=AdrSJKE8uinh90RKtnOQqF9TUOnqlhp1ys7B4-Ilpf3zGBKH2DNUjfZ1K5ekg1sfBTM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlw_clJwv3xTR3AEQukEpeTKlgTgbOmHZYija4fkqTGA&oe=6B09C5EE"}, {"file_name": "HiddenBreed_02.png", "id": "527691840434361", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393887_527691843767694_3049882066401243301_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUNrxtEsrYwQ7kNvwFLlqJZ&_nc_oc=AdoqSBk9Gvy9CipZPKG_W0k5RCPBDwaXec6y5mII9WbDij7-Kch8fWJsaePDUnNOw6o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFbYYEc9xE_QKIg-wN2IGFF2pMXnnqd4hE1jkHdGl5wQ&oe=6B09B87E"}, {"file_name": "HiddenBreed_03.png", "id": "4019822888265256", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393997_4019822894931922_6550084163668242564_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvY0J0cf95oQ7kNvwFjW7-M&_nc_oc=AdoPULiLiw7D83G2Fc3hMAzNjzblBu7sUnvWkBjK2hdOKYu2RSkV-8DZedLYvMrmhWk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGV9CAu5hsGe_VwkmFEpIrNwSeP7iLisi5cNTYO1ihaA&oe=6B09B5BF"}, {"file_name": "HiddenBreed_05.png", "id": "482590001563789", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391893_482590004897122_2450256572767357988_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40gKXDR7JXoQ7kNvwFoUclr&_nc_oc=AdpaFYhBum0PhM2nP69Xt4BDO3Kt9g3pLzqwwHGNpySPqcURqLn12A2e0_rkrf9Z7dY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgAQmhNG8jlP2BoHipyMY6i08abKgOchgrfsL5XYJC6Q&oe=6B0997EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hidden_Breed_Store_VidThumb_1440.png", "id": "1403282327314066", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982460_1403282330647399_7005692104303911067_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1977abv_9cQ7kNvwHuySkO&_nc_oc=Adp5HB_eYb_qhRDUlKPqZ0fxXB4vBfPz8vMKDz2l0lU91cGDq3iWuj7wCaCRBNWmlyI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbuIZeBWiXNQpYgqQ-Lv3QAAOZViQQqEsdeW-ZT2q_nA&oe=6B0997CD"}, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationgames.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/hidden-breed/", "website_url": "https://fixationga
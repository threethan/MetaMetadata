etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iT8XGCMHmYQ7kNvwHRRckI&_nc_oc=Adr05yRcN6FK0M4_jIoAm_0XSe0zGyzhG8YL3KYKyPvgtxmkpP8s0QP8al405-SCbXg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSXKiQIn3n6tdXOtG0FFticnUeIZe8RVstoqlGe6oA2Q&oe=6AFB257C"}, {"file_name": "HiddenBreed_05.png", "id": "1199204234516052", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75302218_1199204237849385_3514117115698024278_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ho-98OLsWbkQ7kNvwFwcSqE&_nc_oc=AdqLecj6D1W8_FOcVk2sEv-vGt_fOy7THMo1V7TlBdUiaLv84M_JPR7s3Uia-EC-OaM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZXxiSCFOZVWe_FT6QGuSeuoBX7-rN2e1l2ld1gdeyTw&oe=6AFB33BC"}, {"file_name": "HiddenBreed_02.png", "id": "1254162912294205", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572947_1254162915627538_5215355207963233467_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qs0EdQwdgS8Q7kNvwHwC_6p&_nc_oc=AdryjvViIpFJ9VRW-AVvbFO5M-XHno7JAgx_59HycLU1aCILrs4AZJdc0PJs7wHr7kQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsVf9sHpPlSuJXFtDSQEaMFT7vh1ok2HDu7bbbiyTMbg&oe=6AFB2B96"}, {"file_name": "HiddenBreed_03.png", "id": "1081058037363061", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75234370_1081058040696394_1714198644243625836_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxATV-S0km8Q7kNvwFv_lb7&_nc_oc=AdploeYOrw5PAo1yFCoLzlVom0dq9JSaDtomXGK8z9g8PmL3w7AhG4SyM0YyvK75t9I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWk8pXOiMOhGUQAbjC2TTDm5HM119Wp8LXO2Hzn1Nrkw&oe=6AFB2FB9"}, {"file_name": "HiddenBreed_09.png", "id": "1105365601105986", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001719_1105365604439319_8995008551237380976_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6F8aGFhPqUQ7kNvwG1Lz4f&_nc_oc=AdpbNGlHlh9zqYVC41DQoCyvYY643tFaNO5rd88uqub4idwKupMCZ9fBg0V_zWefK4o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAmYdg2nTHJciWdVaiwHdUf-9ZeViPTBklKz2xYuKXwg&oe=6AFB195D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hidden Breed", "keywords": ["Aliens", "Horror", "Action", "Adventure", "Singleplayer"], "long_description": "Step into the boots of Laura Mendez, the last surviving geologist on an isolated space station located on the desolate moon in Xenos star system. What began as a routine mission to study the moon's unique geology turns into a fight for survival when a hidden threat emerges from the ground. Alien gel-like creatures known as Colloids,have infiltrated the station, killing three of Laura's colleagues in a brutal assault.\n\nAs the last line of defense, Laura must navigate the labyrinthine corridors of the moon base. Armed with her wits and an experimental weapon known as H.A.A.S., the Human Augmented Attack System. Her mission is to exterminate the Colloids and prevent them from overrunning the entire facility. The battle intensifies to save the moon station as Laura must face off against the Colloids and their monstrous leaders in intense, heart-pounding battles.\n\nWith every step, the stakes rise as Laura uncovers the dark secrets behind the Colloids' presence and their ultimate goal. The fate of the station\u2014and possibly humanity\u2014rests on her shoulders. \"Hidden Breed\" is the ultimate alien-killing VR experience, blending sci-fi horror, strategic combat, and immersive storytelling in a fight for survival like no other.", "short_description": "Step into the boots of Laura Mendez as she battles gel-like alien creatures called Colloids to save her moon station in this ultimate alien-killing VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixationstudio.com/games/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Fixation Games", "support_website_url": "https://fixationgames.com/
.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ajok5szIjvoQ7kNvwG0u_M3&_nc_oc=AdqmxKM70UP7rRTevVgPeTbgLwGeYbYq2y9RsBIqnEtOEZA3XgxJqeQHHyTovMLFsqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5LIvKdnNIpVTh1T_nIOmMCVU05xR5Kj8hO58V191RQg&oe=6AB91C7A"}, {"file_name": "4.png", "id": "1385287423473013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593832569_1385287426806346_4630636440962566903_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6apPH52ilz8Q7kNvwEV-AbR&_nc_oc=Adqws_oUBCfpnwo6I6SRnSvPEYmKjv-epxTC62cyeroAXodPQ44OYEbIGM8ogaO_H4Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ57s2RNh7c-hnqR7RABBA9zJcEMFlw-OVh9n2uqT9dbA&oe=6AB92B82"}, {"file_name": "1.png", "id": "860359390199735", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825497_860359393533068_9153246262206985402_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GxeomUhyR8Q7kNvwEon7RZ&_nc_oc=AdpsWnUewmWb74XTHmWvCI8rJwl8Sp8ifl6GXXDotGxY--C2-pjaYDk3OtmuDrY5LrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcibfc4tPlkCx86zMyYNsmIkZyCbiwvho75nttPXAKfA&oe=6AB91921"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Spider Hero VR", "keywords": ["spider", "webshooter", "hero", "superhero", "swinging"], "long_description": "Become the spider hero of a massive open city in I Am Spider Hero VR  an immersive physics-based web-swinging adventure built for Meta Quest.\n\nAim your wrist-mounted web launcher, hook onto towering skyscrapers, and build real momentum as you swing through the skyline in first person. Time every release, chain daring jumps, climb walls and rooftops, and turn the whole city into your parkour playground.\n\nThe streets below are alive with stylized characters and full interactive physics. Grab, push, toss, and web-pull characters and watch their exaggerated ragdoll reactions. Create funny moments, experiment with the physics sandbox, and play the hero your way.\n\nExplore in free roam or challenge yourself to master advanced movement  longer swings, faster routes, higher climbs, and stylish landings. Easy to pick up, deep to master: the better your spider skills, the more spectacular your runs.\n\nKEY FEATURES\n\u2022 Immersive first-person web swinging with real momentum physics\n\u2022 Wrist-mounted web launcher for swinging, grappling, and pulling\n\u2022 Open city free roam  climb rooftops, leap gaps, find faster routes\n\u2022 Interactive ragdoll characters: grab, push, toss, and web-pull\n\u2022 Lighthearted physics sandbox fun with endless replayability.\n\nI Am Spider Hero VR combines spider web swinging, vertical exploration, interactive characters, and lighthearted physics fun.\n\nStrap on your headset, fire your web, and rule the skyline. The city is waiting for its spider hero.", "short_description": "Become a fearless spider hero in I Am Spider Hero VR. Use your spider web shooter to fire webs, swing between skyscrapers, climb tall buildings, leap across rooftops, and explore the city from above. Master physics based spider swinging, build momentum, improve your spider movement skills, discover new routes, and enjoy an immersive spider superhero adventure designed for Meta Quest."}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": n
=69A56DE2"}, {"file_name": "KoalaSpooky.png", "id": "484109640355493", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210390_484109643688826_5842314139655731616_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WQZ7QJ82r4Q7kNvwHOVhDl&_nc_oc=AdmROYd4bvTHDMYe3aoCkb4q0rYE5zQYz7KxznqU5GbyLwf-mpjItGBluWwC496gYX0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftR5dmX4uZCGlBRfb581I-Gacp5oD2kKQdpWdw3NkuvKQ&oe=69A582C7"}, {"file_name": "BeersAndBoomerangs.png", "id": "1283185035815633", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57575358_1283185039148966_3162988417370070068_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GBF7mBCYLcQ7kNvwEhwHQe&_nc_oc=Adnj5VGBT5YBw9yV9QEO0cDaoso0GrrJ1d73-EXQIByrZHbDsevG-SUI1NraL9kK7g0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsIymHEBhbJeHUak15ZACCGHDflI-gSLmj9blyvodyruw&oe=69A58DCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tRAILERtHUMB.png", "id": "1247212049410434", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75647712_1247212052743767_3164805702378939385_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkJ5BcoIFXMQ7kNvwFebkUx&_nc_oc=Adl3V0wFf8kqkX-GrvW-ecwRAfXFYkTtbft3raT07Ye49w6uOC4QWHBUMsnCTdEI8Fs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvAbfxo96FEJQDRIG0bwEP2YF0hK6UXzDRIyqeQF5kQrw&oe=69A56912"}, "display_name": "Beers And Boomerangs Demo", "keywords": [], "long_description": "Check the full game at https://www.oculus.com/experiences/quest/3767842406602776/\n\nKangaroos are trying to steal your beer! Throw boomerangs in VR to survive the wildlife chaos. Cook for your mates, and save your Aussie BBQ!\n\nHave increasingly perilous BBQs where you survive against different animals, in different scenarios and cook different food!\n\nFull game Features:\n\nFully Physics-based interactions\nA campaign mode with 15 levels (6 hours of gameplay)\nAn endless arcade mode (Infinite gameplay, be the highest score!)\nLovely Annoying Australian Fauna\nBeer skins\nBoomerang skins\nVegetarian BBQ alternatives\nNon-Alcoholic drink alternatives\nTons of accessibility options\n", "short_description": "Full game: https://www.oculus.com/experiences/quest/3767842406602776/\n\nThis is a short demo of A Chaotic Survival/Cooking VR game where kangaroos are stealing your beer!\n\nMulti-task between cooking for your mates and assaulting Australian fauna.\nMaster your fully physics-based boomerangs and defend your BBQ\n"}]}, "developer_name": "Witty Platypus", "developer_privacy_policy_url": "https://beersandboomerangs.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Spelkollektivet", "support_website_url": "https://beersandboomerangs.com/", "website_url": "https://beersandboomerangs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "FOOD"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30770263962620141"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031599_581378576249809_4925083800397028654_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiPHh6KRdy8Q7kNvwE4I_MG&_nc_oc=AdmnJHC8eTOliCf9J_7xUuVkE5xeUBLPWl78mWvto8D87HZ55TT1w6WXHLQ14-oUOEk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfttxgIWH7u1R4mG2EzQOPyKdrRoCNPOQQ0fxOfTtkyZnw&oe=69A57A3F"}, "is_concept": false, "is_
XHKx_NkjhA&oe=69DCECE9"}, {"file_name": "screen_2560x1440_2026-01-07_13-44-30.png", "id": "858221243861467", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820496_858221247194800_5720083369100478317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-s5LtGzKHAQ7kNvwFUzUlL&_nc_oc=Adrdq41jvviZPtmdxogMBf6LiRPIvKJ_SJZ03u3rP7Nip7wI07i53AqmGyTFPN6OVSI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oBqD0ftF2AnpbIB7rt-2KiRLZ655qTz6acix-clejhQ&oe=69DCD55F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PDP_v2_12.png", "id": "891386263939442", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820496_891386277272774_2487784657977788050_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouIMXLJOItYQ7kNvwFl5ohw&_nc_oc=AdpJo9dMG_ygJZ0y_16Lg86EM3tXb3IPBbO38n2LHqTPnOHKyufB-07vkMgVdWfc2pY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HNwxJkqgneasqh6Nvj0QOpFs3GsTUhfmccIFMp2FuUQ&oe=69DCEF29"}, "display_name": "Salmon Man", "keywords": ["salmon", "climb", "river", "parkour", "rage"], "long_description": "Salmon Man is a **physics VR platformer** where you climb upstream using nothing but your paddle.\n\n\ud83d\udc49 **Join our Discord** to get the latest news and meet other fishes: http://discord.com/invite/m5j78bjFhY\n\n{846923251581570}\n\n\ud83d\udc1f **An epic journey**\\\nFight your way to the top through a world full of wonder, physics based obstacles, and absurdity. But don\u2019t expect it to go easy on you.\n\n{899146752505482}\n\n\ud83c\udfc6 **Built for speedrunning**\\\nYour paddle is both your lifeline and your biggest enemy. One wrong move can make you lose all your progress, but skilled players can compete for the fastest times on the global speedrun leaderboard.\n\n\ud83d\udcaa**A true test of will**\\\nUnlock new paddles, complete achievements and side challenges, and push your limits as you master the physics-based movement. Salmon Man is made for players who love difficult games and the satisfaction of earning every victory.\n\n{1613659970087547}", "short_description": "Salmon Man is a unique VR platformer where armed with nothing but a paddle, you will climb upstream and explore a beautiful, absurd world filled with humor, physics-based challenges, and rage-inducing obstacles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Valem-Studio/SalmonManPrivacyPolicies/blob/main/Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Valem Studio", "support_website_url": null, "website_url": "https://valemstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "nl", "nl_BE", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr_BE", "fr_CA", "fr", "de", "de_CH", "ja", "it", "ko", "gsw", "es_VE", "es", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26112721465066210"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824741_1423272919549347_442500986601678963_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_Nqn9y7U-IQ7kNvwH1VDjj&_nc_oc=Adq4_w6-ZxX4lfvdZWL-9XTCzK6akucYzlw6LirMv6WzYmkpK8z6DucS_L5m2BOA7sc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZBaxY-ZhTeFZaQLAb9ND1WoLWaeSVhYBHzhAWOtQayg&oe=69DCF622"}, "is_concept
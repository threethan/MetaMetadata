ng", "id": "3196524343836287", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822550_3196524353836286_293337360976621089_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFFj-hT4b2AQ7kNvwHC1-Hb&_nc_oc=Adkov0pwsduESRd11eJEGcg3qOlj5VMVo8ljKhOmM3zM-LehZOVhJqkfKo_pDHj5HuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBPJiSpylp0JxQUpKx8s--i4rjbtdyRdU--wm-eY_37g&oe=69AEC869"}, {"file_name": "screen_2560x1440_2026-01-07_13-44-30.png", "id": "858221243861467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820496_858221247194800_5720083369100478317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Upe19zC5Ts4Q7kNvwHxHwBQ&_nc_oc=AdktK-PjLcBwCv1PvXGB_zyXlo1suT5uKhxD5q3yMXMTy45MC8AbU-qtourxtshMyak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7Vsae1vfqwaV15VVYvkAIkte0sZxkBT-ZZcl54R29IA&oe=69AEB0DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SM_Couv_2560x1440_Lava_Update (1).png", "id": "1563288368065558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314643_1563288371398891_7707251246985098879_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Es6Oi7M6_X8Q7kNvwE16O9u&_nc_oc=AdnZxnE7EPewGOOV9FTwN9r3LzpC2DN2vS_tgEUz_hKA6hIiiBxXuhb4bLT_8-fG0NQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxT2N9XW9LZ1eQwI4hzkyLFl2IWgHunZWC8-qZfqCDHcA&oe=69AEC12E"}, "display_name": "Salmon Man", "keywords": ["salmon", "climb", "river", "parkour", "rage"], "long_description": "Salmon Man is a **physics VR platformer** where you climb upstream using nothing but your paddle.\n\n\ud83d\udc49 **Join our Discord** to get the latest news and meet other fishes: http://discord.com/invite/m5j78bjFhY\n\n{846923251581570}\n\n\ud83d\udc1f **An epic journey**\\\nFight your way to the top through a world full of wonder, physics based obstacles, and absurdity. But don\u2019t expect it to go easy on you.\n\n{899146752505482}\n\n\ud83c\udfc6 **Built for speedrunning**\\\nYour paddle is both your lifeline and your biggest enemy. One wrong move can make you lose all your progress, but skilled players can compete for the fastest times on the global speedrun leaderboard.\n\n\ud83d\udcaa**A true test of will**\\\nUnlock new paddles, complete achievements and side challenges, and push your limits as you master the physics-based movement. Salmon Man is made for players who love difficult games and the satisfaction of earning every victory.\n\n{1613659970087547}", "short_description": "Salmon Man is a unique VR platformer where armed with nothing but a paddle, you will climb upstream and explore a beautiful, absurd world filled with humor, physics-based challenges, and rage-inducing obstacles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Valem-Studio/SalmonManPrivacyPolicies/blob/main/Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Valem Studio", "support_website_url": null, "website_url": "https://valemstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "nl", "nl_BE", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr_BE", "fr_CA", "fr", "de", "de_CH", "ja", "it", "ko", "gsw", "es_VE", "es", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25725686400436387"}, "review_messages": []}]}, "cover_square_image": {"uri": "https
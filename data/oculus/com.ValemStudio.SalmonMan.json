1-25/491820496_858221247194800_5720083369100478317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kZAH11DV3IQ7kNvwEo6tkU&_nc_oc=AdpBdWpFAn2AYJ_nPNQDno84FG38VMVV2LaGfY3_7vDWmBcclPmqsP32r9Hj0SKF5D8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPL3yOwT37__Z0P-zXe-_sjmART0N82zjeuCYUhTBcCdA&oe=6AD0F31F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v7.png", "id": "4652819101656953", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823296_4652819104990286_6618881355694027696_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KL5axm3dCEQ7kNvwGhKodx&_nc_oc=AdpElIZ2VUfoFLrZ0YaeuQ7H44M5JE9-C8ZW6I-flj5_l4aYj6n8NmzcxXLqo-1NPKY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUeSzKZPGXSSxj8W16a0gpoHaSkOp-VwwROMDmWZCBbA&oe=6AD0EFE2"}, "display_name": "Salmon Man", "keywords": ["salmon", "climb", "river", "parkour", "rage"], "long_description": "Salmon Man is a **physics VR platformer** where you climb upstream using nothing but your paddle.\n\n\ud83d\udce2**Now with multiplayer**\n\nThe new multiplayer update is here! Jump in the river with your friends, race them to the top, or just watch them fall back down.\n\n{1025239890304687}\n\n\ud83d\udc49 **Join our Discord** to get the latest news and meet other fishes: http://discord.com/invite/m5j78bjFhY\n\n{846923251581570}\n\n\ud83d\udc1f **An epic journey**\\\nFight your way to the top through a world full of wonder, physics based obstacles, and absurdity. But don\u2019t expect it to go easy on you.\n\n{899146752505482}\n\n\ud83c\udfc6 **Built for speedrunning**\\\nYour paddle is both your lifeline and your biggest enemy. One wrong move can make you lose all your progress, but skilled players can compete for the fastest times on the global speedrun leaderboard.\n\n\ud83d\udcaa**A true test of will**\\\nUnlock new paddles, complete achievements and side challenges, and push your limits as you master the physics-based movement. Salmon Man is made for players who love difficult games and the satisfaction of earning every victory.\n\n{1613659970087547}", "short_description": "Salmon Man is a unique VR platformer where armed with nothing but a paddle, you will climb upstream and explore a beautiful, absurd world filled with humor, physics-based challenges, and rage-inducing obstacles."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Valem-Studio/SalmonManPrivacyPolicies/blob/main/Privacy%20Policy.md", "developer_terms_of_service_url": null, "publisher_name": "Valem Studio", "support_website_url": null, "website_url": "https://valemstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "nl", "nl_BE", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fr_BE", "fr_CA", "fr", "de", "de_CH", "ja", "it", "ko", "gsw", "es_VE", "es", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "27662409883430686"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820141_951660547625213_8027692361167552300_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkX7Rz_ECqsQ7kNvwEhcXDG&_nc_oc=AdrO1d6yWgB6l6bemneflERcJ28Joc4RgRoPogk8856F4BoMZ-2cyR-pBUqL2EXwon4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj399bZL
"https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499311597_911500732043056_2738076814494509321_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaDRSzQBnTkQ7kNvwGelVwE&_nc_oc=Adqlf2pZZgBsPH3AU9tnpCiQ54eRvs5AGAmolPi5X5vLNzMf0SnCNI34ZzeYHkhJDMA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSGn6VL3R9CZLUWdfG5qlHHUHDhk1D0t36829-YpupHw&oe=6AA1780E"}, {"file_name": "55.png", "id": "1783429736129629", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312470_1783429739462962_22612288642664688_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhcdRfvx3o4Q7kNvwE7EFD6&_nc_oc=AdpTMeA86mtyAhBVWn556PjYuF6u8m4zhtAIIlYqbbisFcICW1FD3SawNI1V2CPTGEg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvEO6_WJ1jnOD_8MkjESE7WWljIdP7yX6dQHG6OKvohQ&oe=6AA16FDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Truck Offroad: Driving Simulator", "keywords": ["Truck", "Driving", "City", "offroad", "mud"], "long_description": "The ultimate off-road truck simulator for Meta Quest VR.\n\nLeave the roads behind and take powerful trucks into a massive world of mud, snow, mountains, rocky trails, rivers, and extreme terrain.\n\nThis isn't city driving. This isn't highway cruising. This is off-road trucking in VR.\n\nFight through deep mud, climb steep mountain trails, cross rivers, push through snow, and haul heavy cargo across challenging routes. Test your truck's power, traction, and your driving skills.\n\nCONQUER THE TERRAIN\n\n\ud83c\udf32 Off-Road Driving \u2014 Explore forests, mountains, muddy trails, rocky paths, and rugged terrain.\n\n\ud83d\udede Mud & Rough Terrain \u2014 Battle deep mud, steep slopes, uneven ground, and difficult trails.\n\n\u2744\ufe0f Snow & Ice \u2014 Drive through challenging snowy terrain and fight for traction.\n\n\u26f0\ufe0f Mountain Trails \u2014 Tackle steep climbs, narrow paths, rocky roads, and dangerous descents.\n\n\ud83c\udf0a Water Crossings \u2014 Navigate rivers and difficult crossings while exploring the wilderness.\n\n\ud83d\udce6 Cargo Hauling \u2014 Transport cargo across demanding off-road routes.\n\n\ud83d\ude9b Multiple Trucks \u2014 Drive powerful trucks with different handling and off-road capabilities.\n\n\ud83c\udf0d Explore the Wilderness \u2014 Discover mountains, forests, mud, snow, trails, and extreme terrain.\n\nBUILT FOR OFF-ROAD VR\n\n\u2714 Immersive first-person truck driving\n\u2714 Off-road truck physics\n\u2714 Mud, snow, rocks, slopes, and rough terrain\n\u2714 Cargo missions and exploration\n\u2714 Multiple trucks\n\u2714 Meta Quest 2, Quest 3 & Quest 3S\n\nGrab the wheel. Choose your truck. Leave the road behind", "short_description": "Conquer brutal off-road terrain in VR. Drive massive trucks through deep mud, snow, mountains, rivers, and extreme trails. Haul cargo, climb impossible routes, and master the wild."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1251940441341552"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1742988333562110"}]}, "baseline_offer": {"id"
uluscdn.com/v/t64.5771-25/38982512_572196321400957_2125003273257883232_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1d0oxuf70sQ7kNvwF2Xtwg&_nc_oc=AdpkH4hQxPEb-OGZgk-OpN32U2OT0ki5rnp-jF_aGXMXMHKG0bElhFJhqCgIZ0FRSu4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKphXpcil6ouL_1_N7QQcJYeK1npSYWHpTso7l2uBAIGw&oe=6A9C10CF"}, {"file_name": "Vinyl_OneDeck_Record_1.png", "id": "241240560836984", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982483_241240570836983_4041723412206166416_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYo8CLyuXoQQ7kNvwF9nJEx&_nc_oc=Ado9DvaU7raXBtxS38sz-XVh01YjpBarv9Uet6RLAE-Er1iqhuP-Y9AR3-Q0e_hNjUQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWYtvJaBL0pxp6dV0aT2zdg9FtzfqUPObxoueIWM9DDQ&oe=6A9C3C24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "6245316808924812", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982694_6245316812258145_9171284627882694461_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLaXWFF6UEcQ7kNvwHsyCEg&_nc_oc=Adq0CR14on-ucpd8byXLR7KwYcCIU--qlmcnbSV70t5iPN_1bMTWzppoGfnIBoKRpP0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBcDA7MaszWLWBX_wwQfRdvQEYkDggFuzDpWzuQGBicw&oe=6A9C22AD"}, "display_name": "Tribe XR | DJ Academy", "keywords": ["Social", "Casual", "DJ", "Music", "Free"], "long_description": "Become a DJ! Play on official AlphaTheta equipment. Learn from the masters at the Pete Tong DJ Academy and pointblank Music School. Join daily workshops. Connect with the community. Perform to the world.\n\nSubscribe for your free 7-day trial:\n- Load your own music - including via Dropbox\n- Access tracks from Beatport, Monstercat, TIDAL, Soundcloud Go+, and pointblank Recordings\n- Join live workshops - more than 30 per week\n- Level up your skills with game mode tutorials\n- Livestream to Twitch directly from your Meta Quest\n- Join multiplayer rooms and jam together\n\nIf you decide to cancel, no worries, you can keep mixing with a free, limited version of Tribe.\n- Play with the starter decks\n- Mix up to 5 tracks per session\n- Join multiplayer sessions\n- Continue learning with the 5 day DJ challenge\nYou can always re-subscribe when you\u2019re ready.\n\nJoin the community on Discord | discord.gg/tribexr\n\nStart your DJ journey today!", "short_description": "Become a DJ! Play on official AlphaTheta equipment. Learn from the masters at the Pete Tong DJ Academy and pointblank Music School. Join daily workshops. Connect with the community. Perform to the world.\n\nSubscribe for your free 7-day trial:\n- Load your own music - including via Dropbox\n- Access tracks from Beatport, TIDAL, Monstercat & Soundcloud Go+\n- Join live workshops & multiplayer rooms\n- Livestream to Twitch\n- Cancel anytime"}]}, "developer_name": "Tribe XR Inc", "developer_privacy_policy_url": "https://www.tribexr.com/privacy-policy", "developer_terms_of_service_url": "https://www.tribexr.com/terms-of-service", "publisher_name": "Tribe XR Inc", "support_website_url": null, "website_url": "https://www.tribexr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1672577396871977"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "MUSIC", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "de", "fr", "zh_CN", "ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27965096293131629"}, "review_messages": []}]}, "cover_square_image": {"ur
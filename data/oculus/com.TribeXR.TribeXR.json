6xsYeBI02IwLC_sjX7c0E4WyVdSq8HobH7IoeA&oe=6ACE5252"}, {"file_name": "migrated_image.png", "id": "731863730680116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974495_1470589263082650_6368686439764328448_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4Sbup6eqMwQ7kNvwGAtBtY&_nc_oc=AdqzU77HsEMRgg_qx3NEP8e9eoMMwnOkNt83AYLAOODWlIGweqpupU_54dTqSYQmpKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRUqSU_Bst2yJGnXYV0AWsuHchskLrg8zX1UOaUwNrWQ&oe=6ACE4FEB"}, {"file_name": "migrated_image.png", "id": "220366849050746", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974499_707742899670916_7295427879867777024_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiTAqVEJ81cQ7kNvwHjpYyj&_nc_oc=AdrkbHUxo4F-m6Us0MQE3JxlQZiszwFBZgNSjVaNhrCw28PJq7IpwjNZFwl-wEmzMf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOctXUlLO-sE5fLuhjNkGB8t8MMfZK03tii0yTI6QS5wg&oe=6ACE450B"}, {"file_name": "migrated_image.png", "id": "654641102019922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974685_413211822650152_1417785566451204096_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAIEepxvTh4Q7kNvwHucr2L&_nc_oc=AdqnA8brw7ocJIiULR4F4ZqOc5Y6e8G-51r3FrUSMN8JTslIikF0lr0JOzrzzQWGgxI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCtlPLcxAtH2m9PDdgmS3RgPUiENxHp_rIoQbXkykaFA&oe=6ACE6946"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TribeXR DJ School", "keywords": ["Education", "Learning", "DJ", "Music"], "long_description": "Hello DJ. Welcome to your VR DJ tool. \n\nTribe XR features a fully functioning pro-style CDJ mix deck. Upload your own music and refine your own unique sound.\n\nGain access to learning resources such as video tutorials, interactive tutorials and a free 1-on-1 intro class. \n\nTurn things up a notch with 1-on-1 mentor classes with professional DJ's with our new VR mentor program (beta)\n\nPerform for friends and the world with native live-streaming integrations. We'll help you set up your own VR live-mix show with real-time support. You can even request to play a live set on Tribe XR\u2019s radio show.\n\nJoin our Discord channel and have direct access to the Tribe XR team, mentors and a passionate community of music enthusiasts.\n\nPlease note: This is an early access app and we are adding new features and refinements week by week. We only support Windows 10 at this time.", "short_description": "Hello DJ. Welcome to your VR DJ tool. \n\nTribe XR features a fully functioning pro-style CDJ mix deck. Upload your own music and refine your own unique sound."}]}, "developer_name": "Tribe XR Inc", "developer_privacy_policy_url": "https://www.dropbox.com/s/sw8jva5kswf857u/Tribe%20VR%20Privacy%20Policy%2012142017.pdf?dl=0", "developer_terms_of_service_url": "https://www.dropbox.com/s/sw8jva5kswf857u/Tribe%20VR%20Privacy%20Policy%2012142017.pdf?dl=0", "publisher_name": "Tribe XR Inc", "support_website_url": "https://discordapp.com/invite/qdhNs2U", "website_url": "https://www.tribexr.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "MUSIC", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "339262744724400"}}]}, "scheduled_offers": {"count": 27, "nodes": [{"status": "PUBLISHED", "id": "1250255723292023"}, {"status": "PUBLISHED", "id": "3014142328645998"}, {"status": "PENDING", "i
619059_1843911593695376_7893056823588280643_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2L9zBM5jUUQ7kNvwGLpcpN&_nc_oc=AdpGkqMi-nEENj2cStNaMsZlD5AB7npnru1RMnvY3-zRge1J2BzIUDLqx57Jya95ibc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCjvQMMNLbz8lhPPv38nmErnt8iIuzW6T7IGBFC1Vngg&oe=6B0703D4"}, {"file_name": "RSS5.png", "id": "1097212082914301", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593718973_1097212086247634_2349568167714209543_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cni5OC4y1F8Q7kNvwEa80Bo&_nc_oc=AdpGMLu40saDlQ_dPCXolomizzgg5f_wpmlX3GNK8MIrXIoizVKGfekTkfZ7jIkFjYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD3LJtIS9yqbKwx_exidm2jdWDRU13Rj3bfIYR4b0WNw&oe=6B0705B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ripple Cover Landscape.png", "id": "2093652891331701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_2093652894665034_384451258166243117_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoVS8kajcjkQ7kNvwFLMooG&_nc_oc=AdptzaLBMD9mMX96RNXZrbpVse6o8U5el1Y4w-yORGFXT5PWHaxIZPWmXpNSGBdlr_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6fTz-gkmPeKtcGflCt4E0yDfcnLlygXPvENKxrKzbAg&oe=6B07170B"}, "display_name": "RIPPLE", "keywords": ["horror", "multiplayer", "escape", "ripple", "parkour"], "long_description": "# Join our Discord at [https://discord.gg/ripple] for updates, events and giveaways!\n\nDon't touch the water. Something blind lives in the poolrooms, and it hunts by sound. Sneak, climb and escape with your friends!\n\n# Features at a Glance:\n\n**Stay out of the water** - It can't see you, but every splash tells it exactly where you are.\n\n{2011945012825625}\n\n**Trick it** - Throw a rubber duck, pebble or other items to make a fake splash, then slip past while it hunts the noise.\n\n{29445300635074587}\n\n**Survive the poolrooms** - Cross drifting platforms, memory bridges and pitch-black rooms to reach the banana hill.\n\n{1133681565918533}\n\nInspired by Infinite Shift: Backrooms \u2014 KORY", "short_description": "Don\u2019t touch the water. Something blind lives in the poolrooms, and it hunts by sound. One splash and it\u2019s coming for you. Sneak, climb and escape with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bonkogames.net/privacy-policy-1", "developer_terms_of_service_url": null, "publisher_name": "Bonko Games", "support_website_url": null, "website_url": "https://bonkogames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1372788892595058"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620559_1679555687004292_618414272704551954_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdblFKrRJ9AQ7kNvwEYl2he&_nc_oc=AdqdTBM7eykUGmWPoPvXjovHSnZMyeGPmqnAFJ8sj84LOPcm0rSQHYo8ny1_PP7deGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlSTXuq4ldLLsmGzbOYBZAtIEElLRHa8xaNd3UhcNdtQ&oe=6B07158E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RIPPLE", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"},
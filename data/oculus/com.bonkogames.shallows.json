luscdn.com/v/t64.5771-25/499619059_1843911593695376_7893056823588280643_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdbEbqLgZCUQ7kNvwFULTaU&_nc_oc=AdqlBe8YbKKBK6PFl-4Mz1jDJpILugPuq1DzOdZkKDRC8ybYtwcPFC5Ie7n1JesaCm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTIdMTOf8zSO3QcPQOHEsxjDgQFmxO1JpyhhGr0cVPgAw&oe=6B0C8214"}, {"file_name": "RSS5.png", "id": "1097212082914301", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593718973_1097212086247634_2349568167714209543_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f92Y5VZar4EQ7kNvwEm82xY&_nc_oc=AdpJo3BILDQW73-nHaw_T9HBktvDHBcf4_hvpNaIXV_Z7FEtvcn0Gz_b8JEXkOId7e4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWEVvTO4d8JhCREuUQcfTeWFjXhBF64s0qBhfQ-kXOUw&oe=6B0C4BB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ripple Cover Landscape.png", "id": "2093652891331701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_2093652894665034_384451258166243117_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clch6QhSX0YQ7kNvwFvhJfS&_nc_oc=Adr21gZvYBmJXC-2A7R0oyibjBfGgqNKsDFHf0_l5ADDz-cFOEmpM5f_qsBbZiAWxTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6uExdVnADLFYSwAkh2rt_PrE9JTMHOFDx7KSGwJywtw&oe=6B0C5D0B"}, "display_name": "RIPPLE", "keywords": ["horror", "multiplayer", "escape", "ripple", "parkour"], "long_description": "# Join our Discord at [https://discord.gg/ripple] for updates, events and giveaways!\n\nDon't touch the water. Something blind lives in the poolrooms, and it hunts by sound. Sneak, climb and escape with your friends!\n\n# Features at a Glance:\n\n**Stay out of the water** - It can't see you, but every splash tells it exactly where you are.\n\n{2011945012825625}\n\n**Trick it** - Throw a rubber duck, pebble or other items to make a fake splash, then slip past while it hunts the noise.\n\n{29445300635074587}\n\n**Survive the poolrooms** - Cross drifting platforms, memory bridges and pitch-black rooms to reach the banana hill.\n\n{1133681565918533}\n\nInspired by Infinite Shift: Backrooms \u2014 KORY", "short_description": "Don\u2019t touch the water. Something blind lives in the poolrooms, and it hunts by sound. One splash and it\u2019s coming for you. Sneak, climb and escape with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bonkogames.net/privacy-policy-1", "developer_terms_of_service_url": null, "publisher_name": "Bonko Games", "support_website_url": null, "website_url": "https://bonkogames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1372788892595058"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620559_1679555687004292_618414272704551954_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RxdVhvs6msQ7kNvwGGp2xJ&_nc_oc=AdoWrDWktTfFzDCjYixvkWwoPL_LXFO8MJfOvyy_O4L-jaEr7jSaHihuW8_qpKp6eDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZv-Z1XcKl8ySKVwf9MuTz7fCmnsrLndLjNAjXZuXDrQ&oe=6B0C5B8E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RIPPLE", "platform": "ANDROID_6DOF", "context_category": 
luscdn.com/v/t64.5771-25/499619059_1843911593695376_7893056823588280643_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SL702WEuY-cQ7kNvwEDPKon&_nc_oc=Adpf8t-5W4hQhChmEsvhUDoP7lNemO3ttNGV9DxrOYkqaUO1z5fZMDoiGa5CsQy-bVA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8xS6rCz7f_jCDZE3bdEVuqPQV6sHvZ8qSWkIBCFneuQ&oe=6AFDC954"}, {"file_name": "RSS5.png", "id": "1097212082914301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593718973_1097212086247634_2349568167714209543_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kn58s0X8PUQQ7kNvwGyWk-x&_nc_oc=AdrHwgtQMTulJN_CmP0HG5lnEi3vBioLGwFH4IrdEsOw6ItDDCy0Gfd0whavkalz3Cs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIUUShpksuFHb_-mNyG4KU-RHvGUMVudw5alD7P7Xk6A&oe=6AFDCB39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ripple Cover Landscape.png", "id": "2093652891331701", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673536876_2093652894665034_384451258166243117_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mshQlqwHX-cQ7kNvwEEIMlJ&_nc_oc=AdolAoAnaTX60wrMPVR_Q8WHj38zz_-tE15K4d4JTr9nnzd6nZmSan7-WOngprX_APE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9LgMUcFPrGPbbOyX5NxFuJTKc-6mAMtjf7utSYwIROQ&oe=6AFDDC8B"}, "display_name": "RIPPLE", "keywords": ["horror", "multiplayer", "escape", "ripple", "parkour"], "long_description": "# Join our Discord at [https://discord.gg/ripple] for updates, events and giveaways!\n\nDon't touch the water. Something blind lives in the poolrooms, and it hunts by sound. Sneak, climb and escape with your friends!\n\n# Features at a Glance:\n\n**Stay out of the water** - It can't see you, but every splash tells it exactly where you are.\n\n{2011945012825625}\n\n**Trick it** - Throw a rubber duck, pebble or other items to make a fake splash, then slip past while it hunts the noise.\n\n{29445300635074587}\n\n**Survive the poolrooms** - Cross drifting platforms, memory bridges and pitch-black rooms to reach the banana hill.\n\n{1133681565918533}\n\nInspired by Infinite Shift: Backrooms \u2014 KORY", "short_description": "Don\u2019t touch the water. Something blind lives in the poolrooms, and it hunts by sound. One splash and it\u2019s coming for you. Sneak, climb and escape with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bonkogames.net/privacy-policy-1", "developer_terms_of_service_url": null, "publisher_name": "Bonko Games", "support_website_url": null, "website_url": "https://bonkogames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1372788892595058"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620559_1679555687004292_618414272704551954_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1BddH4iHgAQ7kNvwFngZok&_nc_oc=AdrG1lMnxrAdyFH6lM5K9nzTyeAVA8efF52XcBTndTaW0lYuBFSGaz0AWE8WCrwqD0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStPpIzq41KXr6v4v5UeN5ZFZQcDtwqa4euOLzt1fepdA&oe=6AFDDB0E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RIPPLE", "platform": "ANDROID_6DOF", "context_category": 
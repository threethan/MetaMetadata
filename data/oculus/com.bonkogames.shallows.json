png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clch6QhSX0YQ7kNvwEHjbjc&_nc_oc=AdpONW1uMcKRhdGT4iu0YyTj7juNT28Ih78XN2hZ6bcp_AhlDqqhkwM4tV0nPAKI1xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSpzhhKfNVGJ7iBxESXbjattaBdpN4OJwlDXu850BXn-g&oe=6B0DAE8B"}, "display_name": "RIPPLE", "keywords": ["horror", "multiplayer", "escape", "ripple", "parkour"], "long_description": "# Join our Discord at [https://discord.gg/ripple] for updates, events and giveaways!\n\nDon't touch the water. Something blind lives in the poolrooms, and it hunts by sound. Sneak, climb and escape with your friends!\n\n# Features at a Glance:\n\n**Stay out of the water** - It can't see you, but every splash tells it exactly where you are.\n\n{2011945012825625}\n\n**Trick it** - Throw a rubber duck, pebble or other items to make a fake splash, then slip past while it hunts the noise.\n\n{29445300635074587}\n\n**Survive the poolrooms** - Cross drifting platforms, memory bridges and pitch-black rooms to reach the banana hill.\n\n{1133681565918533}", "short_description": "Don\u2019t touch the water. Something blind lives in the poolrooms, and it hunts by sound. One splash and it\u2019s coming for you. Sneak, climb and escape with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bonkogames.net/privacy-policy-1", "developer_terms_of_service_url": null, "publisher_name": "Bonko Games", "support_website_url": null, "website_url": "https://bonkogames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
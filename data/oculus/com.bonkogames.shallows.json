9445300635074587}\n\n**Survive the poolrooms** - Cross drifting platforms, memory bridges and pitch-black rooms to reach the banana hill.\n\n{1133681565918533}\n\nInspired by Infinite Shift: Backrooms \u2014 KORY", "short_description": "Don\u2019t touch the water. Something blind lives in the poolrooms, and it hunts by sound. One splash and it\u2019s coming for you. Sneak, climb and escape with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bonkogames.net/privacy-policy-1", "developer_terms_of_service_url": null, "publisher_name": "Bonko Games", "support_website_url": null, "website_url": "https://bonkogames.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1372788892595058"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620559_1679555687004292_618414272704551954_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8fmyTtu8NkQ7kNvwE3-Wkf&_nc_oc=AdrAL5YaTaxrncvH92roeMRGsMJep-beQr0JNCY5gzNGscZg7s60Fb0rxZypwD0a2Ak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvrBFMahbJqky_dy_xx7QN-CZBemd_OxAk8ydNuQfrBw&oe=6B05C40E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RIPPLE", "platform": "ANDROID
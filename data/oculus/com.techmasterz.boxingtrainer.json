66teaEt14rMDFlG3Zy9zpUVctmnQPA&oe=69F0C93E"}, {"file_name": "c2.png", "id": "553548121104703", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392100_553548124438036_278848396791843923_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pY7vE29uA4sQ7kNvwGywtdM&_nc_oc=AdoGki28xWtbV6LE8pojyTqbEKHZsanjXkGeWiZB8dPAIXWW7OzsI4tuB4bFX77YLSE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0Yn5yYF0-WEtNv_djzCHeeqfZOtNeHqehih0SVr8GQ_w&oe=69F0BBFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "c0.png", "id": "1376781033358612", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820486_1376781036691945_6419174330199715797_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUXCufudzG8Q7kNvwGVVLVL&_nc_oc=AdpDkHWRpcu4mg_qCOnay4zK2j0y7qX0RTPnXjTy7iunF2X3TebPevuG-1mhkW0AzBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3NlnPbVmG6DnGRdFT0GR6z-IZWhxZM02afBz0JJFoMuw&oe=69F0B86B"}, "display_name": "Boxing Trainer", "keywords": ["boxing", "box", "trainer", "sport", "nature"], "long_description": "\"Boxing Trainer\" is an immersive fitness experience set in a peaceful landscape.  Compete against over 80,000 active players and rise through the ranks of the leaderboard.\nPlayers can select from multiple difficulty levels and set their own training durations to suit their skill level and goals. This VR game is designed to enhance boxing techniques, endurance, and focus, with interactive features that challenge you to reach new levels of accuracy and speed. Whether you're a beginner or a seasoned fighter, \"Boxing Trainer VR\" combines physical exertion with a calming environment, offering a unique balance of high-energy workout and scenic escape.", "short_description": "\"Boxing Trainer\" is an immersive fitness experience set in a peaceful landscape. Compete against over 80,000 active players and rise through the ranks of the leaderboard.\nThis VR game is designed to enhance boxing techniques, endurance, and focus, with interactive features that challenge you to reach new levels of accuracy and speed. Perfect for beginners and pros alike, enjoy the blend of physical workout and stunning virtual nature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tech-masterz.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tech Masterz", "support_website_url": null, "website_url": "https://tech-masterz.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33878253188440426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974876_530875446404816_3283796185123561685_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTlqqj652zQQ7kNvwFSyhN-&_nc_oc=Adr3UK94J92Pw_ky49pvAaVrAWywMG_q3oKv_aICESJL-ILJIygYeml57lPhdRSnoiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3BUDuqerHsalMF6Parc_npajM8UBbR_8mdQq6H7_6DzQ&oe=69F09BD1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Boxing Trainer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "159219297431
XOCN70gIzeLUrYkQ5hLQP0G3tZ7Fk1YU-U1n5f8AiRaC1D-4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eN1UP8Jd3JkJ6HuGgltfOWS3rilIRSZI2cD9Gg1IMBA&oe=69E63D3E"}, {"file_name": "c2.png", "id": "553548121104703", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392100_553548124438036_278848396791843923_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFNx-jbyIOgQ7kNvwESb-zH&_nc_oc=AdoU6t486twkH91v6t4J3gn1a3lqIdAprCqhljtB_uvmmztpw7XxkSvzGlYUF17TrUQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ab9PoG-BzUIssKd9BQSAp3-OB6g4mvJIKBJcC_Ca2SA&oe=69E62FFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "c0.png", "id": "1376781033358612", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820486_1376781036691945_6419174330199715797_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDJRKhngJ6oQ7kNvwGC_fUv&_nc_oc=Adrhp3YIWdec56v5mECeZsHEq2cmMo9bpqgi-fm3cfo9zHItCLt9W2gO4SjAyAGSYPY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Fx5jjGeW0qdzVf5lkEKbqzSIkirlrI8D0cyjmiDIiVg&oe=69E62C6B"}, "display_name": "Boxing Trainer", "keywords": ["boxing", "box", "trainer", "sport", "nature"], "long_description": "\"Boxing Trainer\" is an immersive fitness experience set in a peaceful landscape.  Compete against over 80,000 active players and rise through the ranks of the leaderboard.\nPlayers can select from multiple difficulty levels and set their own training durations to suit their skill level and goals. This VR game is designed to enhance boxing techniques, endurance, and focus, with interactive features that challenge you to reach new levels of accuracy and speed. Whether you're a beginner or a seasoned fighter, \"Boxing Trainer VR\" combines physical exertion with a calming environment, offering a unique balance of high-energy workout and scenic escape.", "short_description": "\"Boxing Trainer\" is an immersive fitness experience set in a peaceful landscape. Compete against over 80,000 active players and rise through the ranks of the leaderboard.\nThis VR game is designed to enhance boxing techniques, endurance, and focus, with interactive features that challenge you to reach new levels of accuracy and speed. Perfect for beginners and pros alike, enjoy the blend of physical workout and stunning virtual nature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tech-masterz.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tech Masterz", "support_website_url": null, "website_url": "https://tech-masterz.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33878253188440426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974876_530875446404816_3283796185123561685_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Fh7KozYEB0Q7kNvwFPJtmi&_nc_oc=AdrL6iJvL1iYFvcoQQzRVyzGn0Ps1PAvp1JmTkZCMYU4Zl6U-oXvKfo5rp2eoG6z7WU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rZ6_he7djRu2T73pMReFgg_TF7yD3sUIaZkLzdB5ULQ&oe=69E64811"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Boxing Trainer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"
l5IuZBR8g8l6pD_X9giiP-rUv67-wgfXL8e6Q7zu1qc43zps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_4rfebvtW0vFI1pkM12jylc9745iaucGZIKnYT5pL_w&oe=6A734DBE"}, {"file_name": "c2.png", "id": "553548121104703", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392100_553548124438036_278848396791843923_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1RkdpKaZt4Q7kNvwGEVF6E&_nc_oc=AdpFqixBAAryWbqcfvbUUED05GFhDaCO15sdgUIVCya0vPgm7D2SKznykAuMts9qN_A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGivwPKph4PmHYoUKPSjMu0-cWLwbS0UnV9YZ0g_UdsyQ&oe=6A73407A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "c0.png", "id": "1376781033358612", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820486_1376781036691945_6419174330199715797_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4JQm2gc4roQ7kNvwGenm6V&_nc_oc=AdpV3Ziw57dmzVB_Wlylq6HW3UpFWbtTNx6qzMqxfgWw1gDs8X5dQJFAcLP8wMCpuxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOs4LbYPDMUnNSFmPY3OIlqbIYQCTdgtsaoTHNpAEgOQ&oe=6A733CEB"}, "display_name": "Boxing Trainer", "keywords": ["boxing", "box", "trainer", "sport", "nature"], "long_description": "\"Boxing Trainer\" is an immersive fitness experience set in a peaceful landscape.  Compete against over 80,000 active players and rise through the ranks of the leaderboard.\nPlayers can select from multiple difficulty levels and set their own training durations to suit their skill level and goals. This VR game is designed to enhance boxing techniques, endurance, and focus, with interactive features that challenge you to reach new levels of accuracy and speed. Whether you're a beginner or a seasoned fighter, \"Boxing Trainer VR\" combines physical exertion with a calming environment, offering a unique balance of high-energy workout and scenic escape.", "short_description": "\"Boxing Trainer\" is an immersive fitness experience set in a peaceful landscape. Compete against over 80,000 active players and rise through the ranks of the leaderboard.\nThis VR game is designed to enhance boxing techniques, endurance, and focus, with interactive features that challenge you to reach new levels of accuracy and speed. Perfect for beginners and pros alike, enjoy the blend of physical workout and stunning virtual nature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tech-masterz.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tech Masterz", "support_website_url": null, "website_url": "https://tech-masterz.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33878253188440426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974876_530875446404816_3283796185123561685_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scN2Ydi9MZIQ7kNvwF2WHIs&_nc_oc=AdoURslG0VYMMGQMkeHuFFq_n7GOsIQXSL9wC5VukAXr-o2QJgfpehvGg8d5TBAWbD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRgTh8Z3g7tuBOE0mz1D_MBeVPY81SZ3PJEuNv_tn8Zg&oe=6A732051"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Boxing Trainer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"
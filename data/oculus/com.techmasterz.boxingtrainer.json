8VieTHw&oe=6AFB3804"}, {"file_name": "3.png", "id": "888314089945559", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221326_888314093278892_3539446827075582925_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNY8jQipxu4Q7kNvwH2Ywi1&_nc_oc=AdpyQlzUpLSaT-JFrRPcIFSpXUM95VRmQr3cORFUyJSjrybM_tcuPFmxdj8Qnyup_2k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJStO308Df-e2-ipvDs0DJSfIl4MZGkh0IiWMHE1Sg2Q&oe=6AFB43A3"}, {"file_name": "5.png", "id": "1083352220080730", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57572942_1083352223414063_2777459696356692896_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNNH2hRFtCkQ7kNvwF_2luc&_nc_oc=AdpgjL8JxJCErCpNYSw8LIm3LgQcCex34Q6CXV56a_a4qPTXqhC5GZMJElP_W9OuMj4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt2ULgZa0zhbirG9CXl1HYGbHcPALKi7VO8vHhttyqPA&oe=6AFB24B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Boxing Trainer", "keywords": ["boxing", "box", "trainer", "sport", "nature"], "long_description": "\"Boxing Trainer\" is an immersive fitness experience set in a breathtaking forest landscape. Players can select from multiple difficulty levels and set their own training durations to suit their skill level and goals. This VR game is designed to enhance boxing techniques, endurance, and focus, with interactive features that challenge you to reach new levels of accuracy and speed. Whether you're a beginner or a seasoned fighter, \"Boxing Trainer VR\" combines physical exertion with a calming environment, offering a unique balance of high-energy workout and scenic escape.", "short_description": "\"Boxing Trainer\" is an immersive fitness experience set in a breathtaking forest landscape. Players can select from multiple difficulty levels and set their own training durations to suit their skill level and goals. This VR game is designed to enhance boxing techniques, endurance, and focus, with interactive features that challenge you to reach new levels of accuracy and speed. Perfect for beginners and pros alike, enjoy the blend of physical workout and stunning virtual nature."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tech-masterz.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tech Masterz", "support_website_url": null, "website_url": "https://tech-masterz.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "2776542286000603"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28264025983196536"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1358971629730869"}, {"status": "PUBLISHED", "id": "1017714471101353"}, {"status": "PUBLISHED", "id": "734757092404554"}, {"status": "CANCELLED", "id": "2868242023346031"}, {"status": "PUBLISHED", "id": "1352519339874544"}, {"status": "PUBLISHED", "id": "1935145873980403"}, {"status": "PUBLISHED", "id": "3917166075203797"}, {"status": "PUBLISHED", "id": "1422190555591293"}, {"status": "PUBLISHED", "id": "1098635942029401"}, {"status": "CANCELLED", "id": "4013589785526307"}, {"status": "PUBLISHED", "id": "1797492367492072"}, {"status": "CANCELLED", "id": "1013113504217546"}, {"status": "PUBLISHED", "id": "589950910183911"}, {"status": "PUBLISHED", "id": "428785813591330"}]}, "baseline_offer": {"id": "734
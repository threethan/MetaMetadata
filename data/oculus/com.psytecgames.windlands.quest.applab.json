cPTjl_dJPYwo5bdtOulPeg&oe=6A883814"}, {"file_name": "Shot8.png", "id": "952950959039117", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982706_952950962372450_6385585660614713996_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poavVW3OKMwQ7kNvwExf5_Y&_nc_oc=AdrbLF3Nzhli0eSBaIHYEXilxxr5q8w5Pu8lWKlpuHrJR9rJzw3n74Mk1sAVyfhMfJY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-ezPOLawwsykQnuUunqa1MsJgDE8_6gmszuRCTn5GoA&oe=6A883501"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560_1440_Oculus1.png", "id": "1138853546573929", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001717_1138853549907262_6485199567914041408_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3ApEE2PgZQQ7kNvwHoccFc&_nc_oc=Adr7dLWgaiYIIvJG4A0Wrsrw7C7doIIfpIeBOFCSkBEZsIzWgsCNPu7-lBKmIrHj4T4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_Wd2Ogi-Hgxj3S_I2SULrpxbus-JrHbxLu1PL-u-s7w&oe=6A8838FB"}, "display_name": "Windlands", "keywords": ["grapple", "parkour", "swing", "hooks", "explore"], "long_description": "A first-person grappling hook exploration game.\n\nSoar through the ruins of a fallen civilization and discover the secrets of the ancient world.\n\nIt appeals to those who want to explore the breathtaking vistas at a relaxing pace, while the challenging routes attract gamers who like to master the skill of soaring through the towering environments at top speed.\n\n{423280110561253}\n\nGameplay Features\n\n* Designed and built for Virtual Reality First.\n* Grappling Hooks Focused Movement.\n* Variety of expansive levels that reward exploration.\n* Multiple routes provide a range of optional challenges.\n* Optional Skill based Speed Runs and Time Trials\n* Goal Driven Gameplay with Easy (Hook Anything), Normal and Hard Modes.\n\n{1506211596983092}", "short_description": "A first-person grappling hook exploration game. Soar through the ruins of a fallen civilization and discover the secrets of the
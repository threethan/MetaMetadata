=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Io-hl788m4Q7kNvwEm_Lxq&_nc_oc=Adl03UYH0j7ilFHZ3T1mh_vU5ZETnxP7fTfwWuN4U33pChS7lqWM7R91pjJfpRGqOcE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftta9W_udotOrd0kFbUhs5K0DvMhy3Dvft7wW18upueNA&oe=699C3881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560_1440_Oculus1.png", "id": "1138853546573929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001717_1138853549907262_6485199567914041408_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4PprWpEMCAQ7kNvwHXvLAB&_nc_oc=AdmN9JB0WAndb2TaMnIr-B_GMKMhYNHvot1N-0c3SoLR9VGf7bvCdakAwW6BuNLvx8Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuxwUCGmJone3ygEDX-qXpRQY55RZGDyNKWNBk-lTq1rA&oe=699C3C7B"}, "display_name": "Windlands", "keywords": ["grapple", "parkour", "swing", "hooks", "explore"], "long_description": "A first-person grappling hook exploration game.\n\nSoar through the ruins of a fallen civilization and discover the secrets of the ancient world.\n\nIt appeals to those who want to explore the breathtaking vistas at a relaxing pace, while the challenging routes attract gamers who like to master the skill of soaring through the towering environments at top speed.\n\n{423280110561253}\n\nGameplay Features\n\n* Designed and built for Virtual Reality First.\n* Grappling Hooks Focused Movement.\n* Variety of expansive levels that reward exploration.\n* Multiple routes provide a range of optional challenges.\n* Optional Skill based Speed Runs and Time Trials\n* Goal Driven Gameplay with Easy (Hook Anything), Normal and Hard Modes.\n\n{1506211596983092}", "short_description": "A first-person grappling hook exploration game. Soar through the ruins of a fallen civilization and discover the secrets of the ancient world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.psytecgames.com/privacy", "developer_terms_of_service_url": "https://www.psytecgames.com/terms/", "publisher_name": "Psytec Games Ltd", "support
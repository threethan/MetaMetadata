=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31nJC5hc00cQ7kNvwFOkZso&_nc_oc=AdnOSc8jAJiY8Z91gcl8j4w79D0x5Cj3_FnLgD1BIYaNLy0xZsfH3xajVK7wcaBF-Eg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsA_UdG9q8wSrHJTV4p0hVwOoQsxiAk5eVSfR2TC00zSw&oe=69999581"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560_1440_Oculus1.png", "id": "1138853546573929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_1138853549907262_6485199567914041408_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4PprWpEMCAQ7kNvwFRxxid&_nc_oc=AdlwwTphmc09HBAoFvO5UApElq1YrqWMlD3UFiImMwAaZAfklXWoJTrTzi8tFk5DhNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsqk7TJAQB2x-cwUVUn666XODF84ZPDbqQ_gtdrrc-2dQ&oe=6999997B"}, "display_name": "Windlands", "keywords": ["grapple", "parkour", "swing", "hooks", "explore"], "long_description": "A first-person grappling hook exploration game.\n\nSoar through the ruins of a fallen civilization and discover the secrets of the ancient world.\n\nIt appeals to those who want to explore the breathtaking vistas at a relaxing pace, while the challenging routes attract gamers who like to master the skill of soaring through the towering environments at top speed.\n\n{423280110561253}\n\nGameplay Features\n\n* Designed and built for Virtual Reality First.\n* Grappling Hooks Focused Movement.\n* Variety of expansive levels that reward exploration.\n* Multiple routes provide a range of optional challenges.\n* Optional Skill based Speed Runs and Time Trials\n* Goal Driven Gameplay with Easy (Hook Anything), Normal and Hard Modes.\n\n{1506211596983092}", "short_description": "A first-person grappling hook exploration game. Soar through the ruins of a fallen civilization and discover the secrets of the ancient world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.psytecgames.com/privacy", "developer_terms_of_service_url": "https://www.psytecgames.com/terms/", "publisher_name": "Psytec Games Ltd", "support
=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gX_tLA4FpqwQ7kNvwFCSxV5&_nc_oc=AdkITNZBeH8OeoLMJ6Mmdeht8PQYWltBIiZGWqcDLaGE9J0W8S532g3yJbC79Uln_5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsUe6PVIcOnCLkOivKUcsnbxz6gTpRZ6P9b3nOrMSAtJQ&oe=69A6C481"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560_1440_Oculus1.png", "id": "1138853546573929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001717_1138853549907262_6485199567914041408_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0HwJHtMMA8Q7kNvwFvaDKw&_nc_oc=AdmYvPXpnz76uw4GUtK1z47O6RPf0kI5hkWLxKJnXI26t9iepG8cQA7_HQcQiQaL3pQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft9wsS53qwUxELZCoEZ5S78fx40q8ycIjYwpuHJNd6yfQ&oe=69A6C87B"}, "display_name": "Windlands", "keywords": ["grapple", "parkour", "swing", "hooks", "explore"], "long_description": "A first-person grappling hook exploration game.\n\nSoar through the ruins of a fallen civilization and discover the secrets of the ancient world.\n\nIt appeals to those who want to explore the breathtaking vistas at a relaxing pace, while the challenging routes attract gamers who like to master the skill of soaring through the towering environments at top speed.\n\n{423280110561253}\n\nGameplay Features\n\n* Designed and built for Virtual Reality First.\n* Grappling Hooks Focused Movement.\n* Variety of expansive levels that reward exploration.\n* Multiple routes provide a range of optional challenges.\n* Optional Skill based Speed Runs and Time Trials\n* Goal Driven Gameplay with Easy (Hook Anything), Normal and Hard Modes.\n\n{1506211596983092}", "short_description": "A first-person grappling hook exploration game. Soar through the ruins of a fallen civilization and discover the secrets of the ancient world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.psytecgames.com/privacy", "developer_terms_of_service_url": "https://www.psytecgames.com/terms/", "publisher_name": "Psytec Games Ltd", "support
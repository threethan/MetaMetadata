rRMOSmWkrBMq5Q133YmtpA&oe=69D4EC14"}, {"file_name": "Shot8.png", "id": "952950959039117", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982706_952950962372450_6385585660614713996_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhAU93LW7ikQ7kNvwE_s5m4&_nc_oc=Adqrt6AIYxiMT9frZCnbzfGQgySCErZzO6mmWnvtOfuCCdS15IXSyPGBxKw74A5O1g0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sk6aoliJNwhq1jpTUKmRi7wZs4UFMyVXdtu9minRR6Q&oe=69D4E901"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560_1440_Oculus1.png", "id": "1138853546573929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001717_1138853549907262_6485199567914041408_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXFT1c4oEoYQ7kNvwEksUhx&_nc_oc=Adp_NROBjs-NEPt1HYOiHFMGFLddaWvQrtYxirLS9z-LpDgvy9NmNpsAadUk3ygP3c0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ezwSiGN5RR2c7nquoRkyPSZmumN98FYBbNF1xxvM_Yg&oe=69D4ECFB"}, "display_name": "Windlands", "keywords": ["grapple", "parkour", "swing", "hooks", "explore"], "long_description": "A first-person grappling hook exploration game.\n\nSoar through the ruins of a fallen civilization and discover the secrets of the ancient world.\n\nIt appeals to those who want to explore the breathtaking vistas at a relaxing pace, while the challenging routes attract gamers who like to master the skill of soaring through the towering environments at top speed.\n\n{423280110561253}\n\nGameplay Features\n\n* Designed and built for Virtual Reality First.\n* Grappling Hooks Focused Movement.\n* Variety of expansive levels that reward exploration.\n* Multiple routes provide a range of optional challenges.\n* Optional Skill based Speed Runs and Time Trials\n* Goal Driven Gameplay with Easy (Hook Anything), Normal and Hard Modes.\n\n{1506211596983092}", "short_description": "A first-person grappling hook exploration game. Soar through the ruins of a fallen civilization and discover the secrets of the
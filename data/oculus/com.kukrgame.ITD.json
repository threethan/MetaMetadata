FDB9C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1739405316703298", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310831_1739405320036631_7827816632474558353_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrCQmsY9ddgQ7kNvwFAruga&_nc_oc=Adq_C8SGxV3d6JEclAF_-VS3T0YYMoLWiAfDv6mkxrg7oRQKtwYcrA8FgCGv42tYVKU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQldHaPytM1wGk2NiYPViRPxTwc-_Zz4hcxTWlO_wgg2g&oe=6AFDBE11"}, "display_name": "Dread Meridian", "keywords": ["Action", "Adventure", "Survival", "Horror", "Story"], "long_description": "**Dread Meridian** is a survival horror adventure across the frozen wasteland of Oglanbyen.  Play as Daniela, a researcher who ventures to a remote arctic island in a desperate search for her missing twin sister, Isabella. Scavenge for resources, solve cryptic puzzles and battle unimaginable creatures while unraveling the mystery of her disapperance. Will you pierce the veil surrounding Oglanbyen, or succumb to it's terrors?  \n\n# Terrifying Monstrosities Await\nTest your wits against the twisted creatures that stalk the island. Planning is key to survival on the lost island.\n{1487942029048846}\n\n# Explore Treacherous Environments\nImmerse yourself in the dread-filled Oglanbyen, where you never know what could be around the next corner.\n{1431589748031015}\n\n\n# Fight to Live \nScavenge ammo and supplies to survive the island's hostile inhabitants. Customize your weapon with salvaged attachments. When all else fails, rely on your trusty knife and fight to your last breath.\n{4145081619104038}\n\n\n# Uncover the secrets of Oglanbyen\nBreak into research facilities and abandoned mines to gather clues to the whereabouts of your lost sister.\n{1254396619348329}", "short_description": "Dread Meridian is a survival horror adventure.  Play as Daniela on a desperate search for her lost sister on an frozen island spiraling into madness. Scavenge for resources, solve cryptic puzzles and battle unimaginable creatures while unraveling the mystery of her disappearance. "}]}, "developer_name": "KUKRGAME", "developer_privacy_policy_url": "https://privacy.proximabeta.com/portal/privacyPortal/Dread%20Meridian/?uuid=70560e07-6af0-44b3-9d62-35040462140b", "developer_terms_of_service_url": null, "publisher_name": "Level Infinite", "support_website_url": null, "website_url": "http://dreadmeridianvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24391582450505299"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "2217368495485836"}, {"status": "PUBLISHED", "id": "3764142123737310"}, {"status": "PUBLISHED", "id": "1382272357432252"}, {"status": "PUBLISHED", "id": "1209852901346697"}, {"status": "PUBLISHED", "id": "859462763628942"}, {"status": "CANCELLED", "id": "1592020288359562"}, {"status": "PUBLISHED", "id": "1212757960287033"}, {"status": "PENDING", "id": "2602476613463131"}, {"status": "CANCELLED", "id": "1221244063274796"}, {"status": "PUBLISHED", "id": "25764504889906311"}, {"status": "PUBLISHED", "id": "2254634851687098"}, {"status": "PUBLISHED", "id": "1094813465997923"}, {"status": "PUBLISHED", "id": "1264204765754399"}, {"status": "PUBLISHED", "id": "852738390474910"}]
scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031494_1517239955352312_2354441777905859980_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNZUGmDl0jAQ7kNvwELqPa5&_nc_oc=AdlVrBr9zTdIHC1_Mr8zkNefjaX-d7ik4yXCFjR8V1i-Ts8sQ4QvMOjQLL8WgwlaEkY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfujIeiaWHkFiEMlM2Y3X1fd76ZqBLtMUp-IS5QjZFLK6Q&oe=69A1A074"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail - English_6.1.1_6.1.1.png", "id": "1591219538025076", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75458096_1591219541358409_2274893126090893534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwfg3TzGH5QQ7kNvwFq_bDn&_nc_oc=Adk2ikxRV3oBvyT4YS08L_YNemqQXEuVT_9K03LCX1veXWghn7ZNVyurWRL5Hp7MsmQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftacRBvoCd_eOMEiiPIpsp2cZJ0l20sHbTod4dVChf7Jw&oe=69A1ACC4"}, "display_name": "ASPIRE VR - Cabin Relaxation", "keywords": [], "long_description": "You are welcome to join us to depart from your everyday life worries and struggles. You will have a chance to immerse yourself in a safe and welcoming environment. You will spend 10 minutes in a warm and cosy winter cabin with our gentle meditation guide. In this guided sleep meditation talk-down, we will guide you through the snow to your own cosy log cabin. You can sit in front of the fire and watch the evening fade into night, knowing you are warm and safe in this sanctuary from the storm. Developed by Bournemouth University in collaboration with the ASPIRE project.", "short_description": "A guided meditation app, developed for the ASPIRE project by Bournemouth University."}, {"images": {"nodes": [{"file_name": "Logo - French.png", "id": "1306941010166324", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982497_1306941016832990_4976895719360778207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZvQTVIEkZEQ7kNvwFxfMRD&_nc_oc=Admaf8SJx4uXqz4QQ3mZXslhUjdX91eGabkTV9SEz7shs7UCdnPE6kMsuIqg
scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031494_1517239955352312_2354441777905859980_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEFrupm73yYQ7kNvwEldDR4&_nc_oc=AdkBYQ9R7Vc__ie38NCf0gbTcwtOukJxFqupUW8831E-DrNerrWgfcFHmIsUr9qOpWA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvkRI7evSDsE_DRGdubCNrYYPOEbNIJSgKE_fBcZB0gKw&oe=6999B774"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail - English_6.1.1_6.1.1.png", "id": "1591219538025076", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458096_1591219541358409_2274893126090893534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_9w_HaIgwkQ7kNvwG1Kdjx&_nc_oc=AdmZ6ImPD5wvMx-FvLBUGGFChAAJi0RQBIiNuq5uw1TsNz0YERzN3v0ka1Cfh9684z4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYds18yJG_XZwgjsgRHQOiiP4-BegvRUsYiQb1fi518A&oe=69998B84"}, "display_name": "ASPIRE VR - Cabin Relaxation", "keywords": [], "long_description": "You are welcome to join us to depart from your everyday life worries and struggles. You will have a chance to immerse yourself in a safe and welcoming environment. You will spend 10 minutes in a warm and cosy winter cabin with our gentle meditation guide. In this guided sleep meditation talk-down, we will guide you through the snow to your own cosy log cabin. You can sit in front of the fire and watch the evening fade into night, knowing you are warm and safe in this sanctuary from the storm. Developed by Bournemouth University in collaboration with the ASPIRE project.", "short_description": "A guided meditation app, developed for the ASPIRE project by Bournemouth University."}, {"images": {"nodes": [{"file_name": "Logo - French.png", "id": "1306941010166324", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982497_1306941016832990_4976895719360778207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NovkdQSRgYEQ7kNvwHggu_S&_nc_oc=Adkq6_nnGAZ1zOseiRjUwsWSMmdQZYq2Jaw2ClFLPkbxl7kEcGq1QLs-HtC-
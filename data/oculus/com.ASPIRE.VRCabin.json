scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031494_1517239955352312_2354441777905859980_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aONuJCXkR58Q7kNvwGVsQxM&_nc_oc=AdmdnxWQbPfxcEydNrrQMjiqv7mAP6r8S0bC78b5MCy7X0o7GwlHa4YjxGurGKuH7Mg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft_pLYjNuzCq2om1d7itBLFGot7ubXnP2ryHrUWQWWZuQ&oe=699DABF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail - English_6.1.1_6.1.1.png", "id": "1591219538025076", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458096_1591219541358409_2274893126090893534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VsAvUVdILgQ7kNvwHBrje2&_nc_oc=Adle0wBXNd6eGC4vRdPQ5--mkAzTasfdoRQf_8cruDGYgu-3AAHFmUCWzCKWE1WrYqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsE-gFR9D-5Ndr12V9dATyBEAZdO7cUOhFl7MLX2NJOhA&oe=699D8004"}, "display_name": "ASPIRE VR - Cabin Relaxation", "keywords": [], "long_description": "You are welcome to join us to depart from your everyday life worries and struggles. You will have a chance to immerse yourself in a safe and welcoming environment. You will spend 10 minutes in a warm and cosy winter cabin with our gentle meditation guide. In this guided sleep meditation talk-down, we will guide you through the snow to your own cosy log cabin. You can sit in front of the fire and watch the evening fade into night, knowing you are warm and safe in this sanctuary from the storm. Developed by Bournemouth University in collaboration with the ASPIRE project.", "short_description": "A guided meditation app, developed for the ASPIRE project by Bournemouth University."}, {"images": {"nodes": [{"file_name": "Logo - French.png", "id": "1306941010166324", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982497_1306941016832990_4976895719360778207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbblza80Z3AQ7kNvwFSJfgv&_nc_oc=AdnN0LwTIq5ho74TwR-5QEMXIZ_wPNMFJbvkZJk3jOPfkJ1bjkOmbS2yY65K
play_name": "ASPIRE VR - Cabin Relaxation", "keywords": [], "long_description": "You are welcome to join us to depart from your everyday life worries and struggles. You will have a chance to immerse yourself in a safe and welcoming environment. You will spend 10 minutes in a warm and cosy winter cabin with our gentle meditation guide. In this guided sleep meditation talk-down, we will guide you through the snow to your own cosy log cabin. You can sit in front of the fire and watch the evening fade into night, knowing you are warm and safe in this sanctuary from the storm. Developed by Bournemouth University in collaboration with the ASPIRE project.", "short_description": "A guided meditation app, developed for the ASPIRE project by Bournemouth University."}, {"images": {"nodes": [{"file_name": "Cover_005_0100_Portrait_Logod.png", "id": "1625644861231695", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031571_1625644867898361_5430440843453352353_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mD5W8Tn12VEQ7kNvwEv0Y_A&_nc_oc=AdmvkGE6JtvfyoUYYGzpUF_IMtZrP0uDAAQZzk2N4bTXklZOAtaEMm3zidmFeVueKss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afum3FhXeUV8pqOUBdo4S2V1bPlYbRh8FHro3gC5ZaEEzQ&oe=699D80D5"}, {"file_name": "GameLogo.png", "id": "1383607632419127", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375752_1383607635752460_2771600840751507374_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UbYftaDLlIQ7kNvwETfu4p&_nc_oc=AdmEtmDPeV4Xu4yyRFLL-B5Yjnp5o0EhAE9tJkuMmQ794dFhxJ7HotmwgsIppft2Ls4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvWqQ_hAbDWE4kh-KRfQuvM8eLgwdHHuIgctI2BJVHo7Q&oe=699DAF07"}, {"file_name": "Cover_002_0100_Square_Logod.png", "id": "895402555068405", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974585_895402558401738_5282044189950902019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zczD
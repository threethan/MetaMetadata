scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031494_1517239955352312_2354441777905859980_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zRKZmvatQ4Q7kNvwHzsGg3&_nc_oc=AdlJU5jqxciLql5pOdLUuKrLFaJB4FjqxwIov8r_Wi_TaNJ2W_8H8dcOqXVdWt6uMsI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft9nXo7RxONMpEHndnLW0UkQQmZ_viAp9js688_KaOCbg&oe=69A44374"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail - English_6.1.1_6.1.1.png", "id": "1591219538025076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458096_1591219541358409_2274893126090893534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Mmti_HLEs4Q7kNvwHMliho&_nc_oc=Adnq79uQqenR8SlULLZS7l2iH97GRStrJzE4Wu6SJZHXHgJ-sRCWAbrf0WUdjbp6g3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsoVmB_eE1UKhJj89lZ4Vq0zQI3FSRER7b3Ry7-N3Vh5A&oe=69A44FC4"}, "display_name": "ASPIRE VR - Cabin Relaxation", "keywords": [], "long_description": "You are welcome to join us to depart from your everyday life worries and struggles. You will have a chance to immerse yourself in a safe and welcoming environment. You will spend 10 minutes in a warm and cosy winter cabin with our gentle meditation guide. In this guided sleep meditation talk-down, we will guide you through the snow to your own cosy log cabin. You can sit in front of the fire and watch the evening fade into night, knowing you are warm and safe in this sanctuary from the storm. Developed by Bournemouth University in collaboration with the ASPIRE project.", "short_description": "A guided meditation app, developed for the ASPIRE project by Bournemouth University."}, {"images": {"nodes": [{"file_name": "Logo - French.png", "id": "1306941010166324", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982497_1306941016832990_4976895719360778207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJYruCnOipEQ7kNvwHQ6g9n&_nc_oc=Adm-svDi5PugMXTHHBPCRn5axuOG8boc8iN5LVqGWi_rGP6HA3EMor2KFc0l
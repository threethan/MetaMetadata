scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031494_1517239955352312_2354441777905859980_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aONuJCXkR58Q7kNvwE_5y46&_nc_oc=AdkNJ4lPFTTp0G-j5dnsaKhbLoLuCUB-P7ZbwH6-3a1EsZzrxjbz0Z71GOyKPSjamBQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsmlg9KA71hwRWG-rckuKS16fHDfHHgbwXjOjBnATiFmA&oe=699C5A74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail - English_6.1.1_6.1.1.png", "id": "1591219538025076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458096_1591219541358409_2274893126090893534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VsAvUVdILgQ7kNvwEmQFn8&_nc_oc=AdnhnsgU4VDbWKQKbEmjE_vrmJeGUkcSihsxLH21ajUyDnMcX2BfwF9abBr7f-ZatA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvxWePU4Aus4h7AyQ6wQFmkLiW_P9rw6izIFHy3md-jEw&oe=699C2E84"}, "display_name": "ASPIRE VR - Cabin Relaxation", "keywords": [], "long_description": "You are welcome to join us to depart from your everyday life worries and struggles. You will have a chance to immerse yourself in a safe and welcoming environment. You will spend 10 minutes in a warm and cosy winter cabin with our gentle meditation guide. In this guided sleep meditation talk-down, we will guide you through the snow to your own cosy log cabin. You can sit in front of the fire and watch the evening fade into night, knowing you are warm and safe in this sanctuary from the storm. Developed by Bournemouth University in collaboration with the ASPIRE project.", "short_description": "A guided meditation app, developed for the ASPIRE project by Bournemouth University."}, {"images": {"nodes": [{"file_name": "Logo - French.png", "id": "1306941010166324", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982497_1306941016832990_4976895719360778207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbblza80Z3AQ7kNvwHGc7tP&_nc_oc=Admj4ft1xe_rbvnTpm9HvROAEQIsV6oGj8srZ0tZBstBXujZhJmWHaSK3FId
scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031494_1517239955352312_2354441777905859980_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zRKZmvatQ4Q7kNvwEQNXzR&_nc_oc=AdlhlnoztY1cjsBERsttBHyxIjY_WusnOFkHdKPlDB0D8B4fY5ANP5sATFaGzzCOZRo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft_qUcy4qFtP4rGGC8-4SUX51Kzgqv6RWko0lMjsGVmiA&oe=69A594F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail - English_6.1.1_6.1.1.png", "id": "1591219538025076", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75458096_1591219541358409_2274893126090893534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Mmti_HLEs4Q7kNvwEce4SD&_nc_oc=Adl5BIOXsT9fXVkQL60xbOpmxO1M2MxEjXY6RTlW_eh1UyBdxdYw9sSWKXHd51TflyE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsMi971-TdAuPXMOo6iwJDzm8Epwb8IQuJl6QSo0cuYtA&oe=69A5A144"}, "display_name": "ASPIRE VR - Cabin Relaxation", "keywords": [], "long_description": "You are welcome to join us to depart from your everyday life worries and struggles. You will have a chance to immerse yourself in a safe and welcoming environment. You will spend 10 minutes in a warm and cosy winter cabin with our gentle meditation guide. In this guided sleep meditation talk-down, we will guide you through the snow to your own cosy log cabin. You can sit in front of the fire and watch the evening fade into night, knowing you are warm and safe in this sanctuary from the storm. Developed by Bournemouth University in collaboration with the ASPIRE project.", "short_description": "A guided meditation app, developed for the ASPIRE project by Bournemouth University."}, {"images": {"nodes": [{"file_name": "Logo - French.png", "id": "1306941010166324", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982497_1306941016832990_4976895719360778207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJYruCnOipEQ7kNvwFmJ0wN&_nc_oc=Admer2borNmb_X3XGh3ITt_aw7AXCgBEXnWjNrywcmYo6S0WEffVUpO5bxhE
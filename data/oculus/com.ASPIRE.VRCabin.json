play_name": "ASPIRE VR - Cabin Relaxation", "keywords": [], "long_description": "You are welcome to join us to depart from your everyday life worries and struggles. You will have a chance to immerse yourself in a safe and welcoming environment. You will spend 10 minutes in a warm and cosy winter cabin with our gentle meditation guide. In this guided sleep meditation talk-down, we will guide you through the snow to your own cosy log cabin. You can sit in front of the fire and watch the evening fade into night, knowing you are warm and safe in this sanctuary from the storm. Developed by Bournemouth University in collaboration with the ASPIRE project.", "short_description": "A guided meditation app, developed for the ASPIRE project by Bournemouth University."}, {"images": {"nodes": [{"file_name": "Cover_005_0100_Portrait_Logod.png", "id": "1625644861231695", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031571_1625644867898361_5430440843453352353_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3YN7H9u36MQ7kNvwGE_Y_T&_nc_oc=Adm2Gj_7yw-hIYja_MsCxdf27P1nuD6tL9r78fe73zV69JgUMvOYoMOHu8goXCKAnV0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZez5dytdgMykNha4xM9Ei-4EpdlyyZ8GC81mO93ioMw&oe=69998C55"}, {"file_name": "GameLogo.png", "id": "1383607632419127", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375752_1383607635752460_2771600840751507374_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cpfuu4g1Dh8Q7kNvwFGBiKM&_nc_oc=AdlO6WxTtjxPFT4Rk6ejkTW6OfKFyRWEqGKoY-FZ8u1ThiZWJeyj2Q1Hfl4b6Jmkoow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfukyQwPM9kfjx4R7n_xZM0rdoXi5uAyAUMzXa0u1ZRtQw&oe=6999BA87"}, {"file_name": "Cover_002_0100_Square_Logod.png", "id": "895402555068405", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974585_895402558401738_5282044189950902019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9Qt
scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031494_1517239955352312_2354441777905859980_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3GmYWcuTUkQ7kNvwFY47Yc&_nc_oc=Adq8bYPbbL8J3isWPDAjH7Btt29shlaT8iZh_EQWuTwWHH_22CEMKFG7yrlYRPTdcNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1GNwEmD_YuX_-HDeBEGE9k7hj3bL1e9FdHyoUvXi4gXg&oe=69F0BA74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail - English_6.1.1_6.1.1.png", "id": "1591219538025076", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458096_1591219541358409_2274893126090893534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iif0DNxILD0Q7kNvwE9a47E&_nc_oc=AdodFC1rH99POtYA5RbRRh0z8Q_u5Zmk9XOq_yTt5Y1gZduvazX1VdZx_a3WwBYdXFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2TuIFY7ADltDxiAhcftCeC40p0WydsSaFmsApg0jaMLg&oe=69F0C6C4"}, "display_name": "ASPIRE VR - Cabin Relaxation", "keywords": [], "long_description": "You are welcome to join us to depart from your everyday life worries and struggles. You will have a chance to immerse yourself in a safe and welcoming environment. You will spend 10 minutes in a warm and cosy winter cabin with our gentle meditation guide. In this guided sleep meditation talk-down, we will guide you through the snow to your own cosy log cabin. You can sit in front of the fire and watch the evening fade into night, knowing you are warm and safe in this sanctuary from the storm. Developed by Bournemouth University in collaboration with the ASPIRE project.", "short_description": "A guided meditation app, developed for the ASPIRE project by Bournemouth University."}, {"images": {"nodes": [{"file_name": "Logo - French.png", "id": "1306941010166324", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982497_1306941016832990_4976895719360778207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Glpi6TDEX4sQ7kNvwH4gQZh&_nc_oc=AdqPjYplNzjIqs2xVGHJXEh_YUTghGMRX7uusuGWAwSrr_7CfSkSSbL-mCNT
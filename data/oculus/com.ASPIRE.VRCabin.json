scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031494_1517239955352312_2354441777905859980_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zRKZmvatQ4Q7kNvwGZtOpn&_nc_oc=AdnNtO-RMfr4l0RdtraDPKbewXtfmJAc4kCseZUAc4eyHscs2Qy6hVF_U71C8mc8UnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBl3WpEoOEtDP1fxn5ZXz_xjoxoh0LPub6DFljnjIxBQ&oe=69A2F1F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Thumbnail - English_6.1.1_6.1.1.png", "id": "1591219538025076", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458096_1591219541358409_2274893126090893534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwfg3TzGH5QQ7kNvwE73J5w&_nc_oc=AdkqYZXi6rWVRlW8dyk8txckAooQRVy3dc5e8TbCP3lR7AvTuxHAd1vuxl1Fdw9srpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfukPa32sVEmzTcWz6CQIM-USSdJcDyz1oXo-oLkpUwf5Q&oe=69A2C604"}, "display_name": "ASPIRE VR - Cabin Relaxation", "keywords": [], "long_description": "You are welcome to join us to depart from your everyday life worries and struggles. You will have a chance to immerse yourself in a safe and welcoming environment. You will spend 10 minutes in a warm and cosy winter cabin with our gentle meditation guide. In this guided sleep meditation talk-down, we will guide you through the snow to your own cosy log cabin. You can sit in front of the fire and watch the evening fade into night, knowing you are warm and safe in this sanctuary from the storm. Developed by Bournemouth University in collaboration with the ASPIRE project.", "short_description": "A guided meditation app, developed for the ASPIRE project by Bournemouth University."}, {"images": {"nodes": [{"file_name": "Logo - French.png", "id": "1306941010166324", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982497_1306941016832990_4976895719360778207_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJYruCnOipEQ7kNvwGtUPkg&_nc_oc=AdngnTNADHkELRw2Ar3Q3qXLT74kBfGyzZEWspsAoNbnvwNY6DTAo6MrHVDe
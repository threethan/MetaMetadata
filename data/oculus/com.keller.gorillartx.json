0311026_n.png", "id": "2468767460229722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311585_2468767463563055_8093103047344851686_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEihJuUdxxEQ7kNvwHE9eoe&_nc_oc=AdqaxA3e-iCbsro-XfaDKQS-BUg7R_xEWRP8OFZJtru0q_hg5mWvhdv2mTJxejiSeOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqvsG4tnDmE08I8BtqOGgrXsbo86dhIiRZKtIF-glVNA&oe=6AC10895"}, {"file_name": "491830613_1368943301282639_3973662496061716263_n.png", "id": "2392366247940397", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310720_2392366251273730_4470293012257197707_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKjFtCQfrxUQ7kNvwH2jiBK&_nc_oc=AdqinvJ8lkoYTu_rkwZljKURJKGcyQuTp3g8dDDXav2Ar5w3U0-I3JO8sjlusnK6fKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGW-Z4OTh4vgXXxhOZSEm6FDBU2s_0JShggehJ5U5gag&oe=6AC128F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RTX Gorilla", "keywords": ["Rtx", "Gorilla", "Scary", "Tag", "vr"], "long_description": "Welcome to RTX Gorilla, a multiplayer VR experience built around exploration, social interaction, and immersive environments. Move through detailed maps using intuitive locomotion, meet players from around the world, and uncover hidden areas scattered throughout the game.\n\nExperience enhanced visuals, atmospheric lighting, and unique locations designed to make every session feel fresh and exciting. Whether you're exploring with friends, searching for secrets, or simply relaxing in the world, RTX Gorilla offers a fun and engaging VR adventure for players of all skill levels.\n\nFeatures:\n\nMultiplayer VR gameplay\nDetailed environments and immersive lighting\nExploration-focused maps\nHidden secrets and discoverable areas\nSocial experiences with friends and other players\nSmooth and responsive movement systems\n\nJump in, explore, and see what adventures await in RTX Gorilla.", "short_description": "RTX Gorilla is a multiplayer VR adventure where gorillas explore detailed environments, hang out with friends, discover secrets, and experience immersive gameplay with realistic visuals and smooth movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rtx-gorilla/home", "developer_terms_of_service_url": null, "publisher_name": "Kelley", "support_website_url": null, "website_url": "https://sites.google.com/view/rtx-gorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1146356391898179"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_1915688919121769_7441418416248019680_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmM7hasYdwoQ7kNvwE3h6hw&_nc_oc=AdqJHZjubEHqHq90K5-FQyTZ6yzlJUU3cV432ekIrUc3_9DEkH-t-iK1KTM_mNNiQC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO54QUyWrv8Ne3_CqLju75BWhjwZRF0mlY_i0u_-yd1Kg&oe=6AC1129E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RTX Gorilla", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1782323160, "lastRevisi
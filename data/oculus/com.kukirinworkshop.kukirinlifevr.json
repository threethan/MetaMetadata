tent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWAyVomBU4oy1z2yduYO8iLaRJe0LWKLFTAxbbLtwZYOg&oe=6B1066A3"}, {"file_name": "05-VESC-unboxing-2560x1440.png", "id": "1620222649327589", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771253_1620222652660922_9194706595538368155_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS_-CpGxTtUQ7kNvwEspKQx&_nc_oc=AdqEW5BdWQG_CENAzGJ1LWKVB1IpPwon5aHw9KOuJyc-lN1bpcCA2kj0sW_AmCwVWAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXh8DhW-NXmRXROlmtC2q4ATb_MFhT5bmkTJX6cCh0URg&oe=6B103825"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scooter Life VR", "keywords": ["elscooter", "scooter", "customization", "simulator"], "long_description": "Step into Scooter Life VR and turn a boxed electric scooter into your own custom ride.\n\nStart in the garage with hands-on unboxing. Pull off the tape, open the box, remove the packaging and unfold your scooter. Follow the tutorial to learn the controls and get ready for your first ride.\n\nMake your scooter yours. Remove parts and work on them at the bench, spray on layers of color, draw with markers and add stickers. Use the drill to remove the dashboard screws, experiment with different finishes and save your design before heading out.\n\nExplore a city built for riding, with streets, elevated roads, tunnels, skateparks and parking areas for meetups. Practice wheelies, try tricks, jump from ramps or start a police chase. Control the throttle, brakes and handlebars as you find your favorite routes.\n\nOpen your in-game tablet to create a named lobby or join other riders. Meet friends, explore together and talk through proximity voice chat that fades as you move apart. Use the tablet camera to capture photos and videos of your rides and creations.\n\nScooter Life VR is currently in beta and continues to receive improvements.", "short_description": "Unbox your electric scooter and make it yours with spray paint, drawings and stickers. Explore city streets, tunnels and skateparks, practice wheelies and tricks, or meet friends for multiplayer rideouts. With hands-on garage customization and proximity voice chat, Scooter Life VR brings the ride to you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://scooter-life-vr.jorunnlindoe.chatgpt.site/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Jester labs", "support_website_url": null, "website_url": "https://scooter-life-vr.jorunnlindoe.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "1417107431487876"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842245_1835480090693410_8190775943039054408_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHTXrZKZaF8Q7kNvwHz6fRC&_nc_oc=AdrKVHzsVS5v6MHaktTKJpgI2f9jYY27wPjXrjFqIdbG9CeEzVfFBZQRin0fBtY85lA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWArqp9_esrHnnR8-Qv3e1G9-Qjv9BGB986cNBSuWrMYw&oe=6B104518"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scooter Life VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
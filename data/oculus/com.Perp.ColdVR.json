ng", "id": "481601350940445", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974580_481601354273778_7180081567096817641_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAZ2xcJq72UQ7kNvwHwUUb9&_nc_oc=Adp1P-VdTGSsVVBf0AKjZzIK5u31ZWSsO_4pkBfe1e-m89O2S-PUOQdEKf9LWUBIvjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU7TVmBx5p1lw9W80a6fXd6Q8SEX5YDcQKJYTwBfrm5g&oe=6B045712"}]}, "id": "1107294797445349", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "1066798021577734", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001676_1066798024911067_4420300632721532808_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbI2steIY0oQ7kNvwEbZQw0&_nc_oc=AdoTNn7C2N6WeV7qCY41Extutp1lBFpjaxnn709wgJR9yjeV3xYVbbJC3kAWLqHDgGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV23vlXcm62PYKF4t2MNQDzIrGqNUYxBFpVME66vDThg&oe=6B04691E"}, {"file_name": "2.png", "id": "484878454599632", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982550_484878461266298_7487318708982432952_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lijoztUk-McQ7kNvwGv8J_c&_nc_oc=AdoygvZT8y5FaezWBTuuCXIJDbdnVMDmLG5C4fHCZejWfWBX5bFTXLEIFy2h-38_GCE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRllOQb5kApobfD2yZijMtdUIqj931Az974d_MByyDDsA&oe=6B046D10"}, {"file_name": "5.png", "id": "1084851403193868", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348036_1084851406527201_6035021478763734340_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyq9eLQoXssQ7kNvwFGGtsv&_nc_oc=AdoGVkLSM1yflxCo0l-KrFSpNInssEDURO7ptQ1LT2RTA22EiS2cjJrZnF3mFPxKex0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv7zCuXJ8D2Htqxb_9j0l_SWfdvGKlnsLAg3-mCi_ENw&oe=6B04736A"}, {"file_name": "1.png", "id": "3971858813097934", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031370_3971858816431267_802567673086440238_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAFg_JlPtEIQ7kNvwE_spNo&_nc_oc=Adq1Lrw90k6ZaxSMbcFPWe6YFmrKMlIUVO9ju2q_qkOHFJ2zCeNqLGh2ECoaXpmcjUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHt27tdHmTcha__Lc_IDl06e4fnTj97GGTAkEXtbkh9A&oe=6B045E57"}, {"file_name": "4.png", "id": "550038530983305", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569443_550038534316638_8198551644078577180_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpb74kq_4oMQ7kNvwGP8g3z&_nc_oc=AdpRwPOErOVVjg1pi-BUzfBf2Blab7cx1K5mj7_knlGGeMlRIuUL1Htmr-sDzo7Z4a4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwiDjjPgDMRJ_xLgOmKmFKOOzbWIf5SPV3UNjbohaC4A&oe=6B04774B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cold VR", "keywords": [], "long_description": "'It's like Superhot but the cold version. I like it! ' GamertagVR\n\nKeep moving. You\u2019ve got to keep moving.    \n\nBecause in the high adrenaline shooter Cold VR, when you slow down, time goes faster, and so does the relentless enemy AI. And you really don\u2019t want that to happen.\n\n'I'm looking forward to this one!' - A Wolf In VR\n\n'Its a blast dude!' - Frontways Larry\n\n\u201cReally does feels like the SuperHot Sequel we never got.' - Beardo Benji\n\nCOLD VR is an exhilarating virtual reality game that puts you in control of time.  \n\nStay on the move to outwit and outmanoeuvre the relentless enemy AI.\n \nThe fate of the virtual world rests in your hands! Time is your greatest weapon. Move to slow it down, stop, and risk everything. \n\nDesigned for those who crave a challenge and love the rush of adrenaline.  With its twisting mechanics, this game will turn you into an unstoppable machine as you adapt and overcome challenges in each level.  \n\nAs you progress through the chillingly beautiful environments, you'll face not only numerous, more powerful enemies, including those in the scary Backrooms levels, but also environmental hazards such as deadly lasers, moving platforms, and unexpected surprises for those daring enough to explore. \n\nOver 40 levels including the feared Backroom levels\n\nStep into the shoes of the protagonist in a unique blend of live-action and in-game storytelling.\n\nYour choices will determine humanity's fate. \n", "short_description": "Time is your greatest weapon! Move to slow it down, stop, and risk everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://perpgames.com/2024/11/13/privacy-policy-for-cold-vr-on-meta-quest/", "developer_terms_of_service_url": null, "publisher_name": "Perp Games", "support_website_url": null, "website_url": "https://perpgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27465772359736846"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "1881673659670237"}, {"status": "PUBLISHED", "id": "1081069967828098"}, {"status": "PUBLISHED", "id": "27894708640151180"}, {"status": "PUBLISHED", "id": "2139087006659200"}, {"status": "PUBLISHED", "id": "1973884933261350"}, {"status": "PUBLISHED", "id": "1278365414451719"}, {"status": "PUBLISHED", "id": "1727050695149375"}, {"status": "PUBLISHED", "id": "1232224942391634"}, {"
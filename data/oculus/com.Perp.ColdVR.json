ng", "id": "481601350940445", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974580_481601354273778_7180081567096817641_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjrVV7ZQjd0Q7kNvwGGFyEZ&_nc_oc=Adq81cHrLGzyQQ6OBJy_xM2bgTvB2KUeohmhvLIwZ5DCzivRg5yJpRgONzmIVSN90eI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCIGISp3BwIlc_Au8Vld95vfim1k56XCRMfmsqdVRWZQ&oe=6AFB1C92"}]}, "id": "1107294797445349", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "1066798021577734", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001676_1066798024911067_4420300632721532808_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ujTdL3icegQ7kNvwH4RMFc&_nc_oc=Adpb6hxsp7X5QAIk5fGdzkxBP77GbAs0_M9R6m7DomOdzVmluYrrXA3hf4j3mngm-M8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRku1thpoTATJ0HgYPfKYkRSfOHNhHTXkWwBQLl4EEn_w&oe=6AFB2E9E"}, {"file_name": "2.png", "id": "484878454599632", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982550_484878461266298_7487318708982432952_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKxiAgIak8wQ7kNvwFILyP3&_nc_oc=AdrM7dYjK9b4HDEORw6Gz2oGQOnpxiNjFr54abdNY1jZ0xi7QBSc04ctElnO2dIr9Sk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzQv0qbYtp6fDQ84SOGRx8ms1fjnnLZ-HD6GdjrNbbBw&oe=6AFB3290"}, {"file_name": "5.png", "id": "1084851403193868", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75348036_1084851406527201_6035021478763734340_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ioic3__2EkMQ7kNvwHLFA8i&_nc_oc=AdqKYpUGYUGfwcnJsFYHCR5lW0hcbCo7JDabPZlcgaHabtpWQpySQYTFzQRpqLzzC34&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgz8HliWt_eKRmpD1QtTliKewvczBy7yGsGzhdJni20Q&oe=6AFB38EA"}, {"file_name": "1.png", "id": "3971858813097934", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031370_3971858816431267_802567673086440238_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsXd9EGFXOUQ7kNvwE_x9tM&_nc_oc=AdrzsbWRxT5w25yO0l44Ew9RVJnVh6wE8_nHTajZjWGHH4QvMKtMYNPK6Vt8GDMUm54&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9MzGKvQcqAGrrNZWwi9uAsyVozIksa65r9ue_yLHBWg&oe=6AFB23D7"}, {"file_name": "4.png", "id": "550038530983305", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569443_550038534316638_8198551644078577180_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nFhbEzSgTsQ7kNvwE9DGM8&_nc_oc=Adpjz0HPdOrK1w9x9wT28ksIB1GOVJsy9Nm0WkyMhwgDCt_c4mqPcQhhZnK1u_vlGTE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDV6AsV06sG72H6WeMQ9dDz7Q6WaDkfjC772x0bgIQ0Q&oe=6AFB3CCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cold VR", "keywords": [], "long_description": "'It's like Superhot but the cold version. I like it! ' GamertagVR\n\nKeep moving. You\u2019ve got to keep moving.    \n\nBecause in the high adrenaline shooter Cold VR, when you slow down, time goes faster, and so does the relentless enemy AI. And you really don\u2019t want that to happen.\n\n'I'm looking forward to this one!' - A Wolf In VR\n\n'Its a blast dude!' - Frontways Larry\n\n\u201cReally does feels like the SuperHot Sequel we never got.' - Beardo Benji\n\nCOLD VR is an exhilarating virtual reality game that puts you in control of time.  \n\nStay on the move to outwit and outmanoeuvre the relentless enemy AI.\n \nThe fate of the virtual world rests in your hands! Time is your greatest weapon. Move to slow it down, stop, and risk everything. \n\nDesigned for those who crave a challenge and love the rush of adrenaline.  With its twisting mechanics, this game will turn you into an unstoppable machine as you adapt and overcome challenges in each level.  \n\nAs you progress through the chillingly beautiful environments, you'll face not only numerous, more powerful enemies, including those in the scary Backrooms levels, but also environmental hazards such as deadly lasers, moving platforms, and unexpected surprises for those daring enough to explore. \n\nOver 40 levels including the feared Backroom levels\n\nStep into the shoes of the protagonist in a unique blend of live-action and in-game storytelling.\n\nYour choices will determine humanity's fate. \n", "short_description": "Time is your greatest weapon! Move to slow it down, stop, and risk everything."}]}, "developer_name": null, "developer_privacy_policy_url": "https://perpgames.com/2024/11/13/privacy-policy-for-cold-vr-on-meta-quest/", "developer_terms_of_service_url": null, "publisher_name": "Perp Games", "support_website_url": null, "website_url": "https://perpgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27465772359736846"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "1881673659670237"}, {"status": "PUBLISHED", "id": "1081069967828098"}, {"status": "PUBLISHED", "id": "27894708640151180"}, {"status": "PUBLISHED", "id": "2139087006659200"}, {"status": "PUBLISHED", "id": "1973884933261350"}, {"status": "PUBLISHED", "id": "1278365414451719"}, {"status": "PUBLISHED", "id": "1727050695149375"}, {"status": "PUBLISHED", "id": "1232224942391634"}, {"
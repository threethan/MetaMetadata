oc=Adr0C62bcAzaDwnTj8XyJVmbdDRQIk9bTm-ATfyWAvEmD82qFdhsbm0AfoV6ZFWgQfE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReNip4dRH4lFEpsZ0d7KXcuwdnoeEkHPd6garVSM1UVw&oe=6AFF1072"}, {"file_name": "screenshot_meta_5.png", "id": "1001267178059228", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974785_1001267181392561_6408251747435581049_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xc5TSUPZZZoQ7kNvwHp6Va_&_nc_oc=AdqPs73bKaqB6k8G6eA5uC2PAW89IG8ZQPLrAHL8tqnDhNxNTyyBjVsH0QuGU0oqatE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc4CyAwAVuiK4g7BANFRSMS1nXxCxsBZZqx-oR97YVOw&oe=6AFF2FA1"}, {"file_name": "screenshot_meta_3.png", "id": "349791551463844", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86601733_349791554797177_6181038885599336627_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pShpY0i61iQQ7kNvwG0J_dc&_nc_oc=AdoIZXcdOlIkhd1KmOuvDG5d8ZLbW4m7M0k0sDCo_BK1SgHO6992IAw39A1XPgQiN4c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJnpJu8FYmpVR39s9nfnNyzhVQ2zc-aoVL3op0zd4m9w&oe=6AFF316B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ES_Dark_KeyArt_Landscape_2560x1440_v2.png", "id": "1158608572230601", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462964_1158608575563934_6079602369579162800_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GvCYLfbYF8Q7kNvwHOi9ZZ&_nc_oc=Ado7CZT_NTC6BXhkLjNdxjNl2-v6e-OisGrlhI0x3Ulcl9K6cMC4-KVqdJrBjoJRhpY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqFSQHGA39siScFFGw5H0NGnDFtOFDvHvLGeA-sGL2oA&oe=6AFF0701"}, "display_name": "Ember Souls", "keywords": ["swordfighting", "climbing", "parkour", "action", "adventure"], "long_description": "Ember Souls is a thrilling VR hack-and-slash game blending parkour, climbing and environmental puzzles in a luxurious Persian palace. Harness the power of the Ember Stones to unlock new abilities and use your combat skills and agility to defeat the mysterious Shadow Sultan.\n\n{341059369020002}\n# Climbing and parkour\n\nExperience the thrill of acrobatic climbing with an innovative assisted parkour system that makes you feel like a powerful warrior.\n\n{2119194938451917}\n# Fun and visceral melee combat\nEngage in intense sword-fighting with over 20 different weapons against diverse enemies, each with unique combat styles, using advanced physics and a dynamic gore system.\n\n{837536108286763}\n# Environmental puzzles and traps \nSolve intricate puzzles while avoiding deadly traps to progress through the levels. The VR environment allows for creative interaction with the space, such as moving objects and climbing onto platforms to reach higher areas.\n\n\n{731427878959476}\n# Time and energy manipulation\nHarness the power of the ember stones to your advantage with abilities like slowing time down,  energy shield or sending a shock wave to stun your enemies. \n\n{966989418228804}\n# Stunning Persian palace environments.\n\nExplore a breathtaking palace with 5 diverse settings, from the opulent sultan\u2019s baths to the serene gardens, each meticulously crafted to immerse you in a rich Persian landscape.\n", "short_description": "Ember Souls is a thrilling VR hack-and-slash game blending parkour, climbing and environmental puzzles in a luxurious Persian palace. Harness the power of the Ember Stones to unlock new abilities and use your combat skills and agility to defeat the mysterious Shadow Sultan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualage.io/privacy-policy-embersouls", "developer_terms_of_service_url": "https://www.virtualage.com/Games/EMBERSOULS_EULA.pdf", "publisher_name": "VirtualAge Games", "support_website_url": null, "website_url": "https://www.virtualage.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cate
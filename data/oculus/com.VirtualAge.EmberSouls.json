t-sjc6-1.oculuscdn.com/v/t64.5771-25/38974785_1001267181392561_6408251747435581049_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqPOCcwgGkAQ7kNvwG2CDE0&_nc_oc=AdrrmJUmKts2imdLd4mxdZD2U5J6naQrXM8j81WeHFNgjE0PFduxiCN23nx4_nXNKM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaNZS9H74hwGz_Ax6DTBlLbX7p_tfOAm85VtTtkH1gjw&oe=6A7489E1"}, {"file_name": "screenshot_meta_3.png", "id": "349791551463844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86601733_349791554797177_6181038885599336627_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2yw04bPndcQ7kNvwF15wdC&_nc_oc=Adr5d5IhipaLYDN0e5Y5e2iAWP0BGG5br5QWbtRo-UrI9vRc2LovL5zjLEwBEtPqVKQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsWYp5eIWDG6pcVEUOBEIlMElhukKd-aOcvv8FPda-TQ&oe=6A748BAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ES_Dark_KeyArt_Landscape_2560x1440_v2.png", "id": "1158608572230601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462964_1158608575563934_6079602369579162800_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_6PwurVWdYQ7kNvwHjh3-_&_nc_oc=AdqPZsCQNQpZD06iG6JbyrSp9ZBVhkIvMYrvmBg620-kcmKFlHDo4_5sn52Cq3P2XGg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvc9b5zAQhCCr3xyzPkhXh7MkxXw35bhu1fMXZi0T6tA&oe=6A749981"}, "display_name": "Ember Souls", "keywords": ["swordfighting", "climbing", "parkour", "action", "adventure"], "long_description": "Ember Souls is a thrilling VR hack-and-slash game blending parkour, climbing and environmental puzzles in a luxurious Persian palace. Harness the power of the Ember Stones to unlock new abilities and use your combat skills and agility to defeat the mysterious Shadow Sultan.\n\n{341059369020002}\n# Climbing and parkour\n\nExperience the thrill of acrobatic climbing with an innovative assisted parkour system that makes you feel like a powerful warrior.\n\n{2119194938451917}\n# Fun and visceral melee combat\nEngage in intense sword-fighting with over 20 different weapons against diverse enemies, each with unique combat styles, using advanced physics and a dynamic gore system.\n\n{837536108286763}\n# Environmental puzzles and traps \nSolve intricate puzzles while avoiding deadly traps to progress through the levels. The VR environment allows for creative interaction with the space, such as moving objects and climbing onto platforms to reach higher areas.\n\n\n{731427878959476}\n# Time and energy manipulation\nHarness the power of the ember stones to your advantage with abilities like slowing time down,  energy shield or sending a shock wave to stun your enemies. \n\n{966989418228804}\n# Stunning Persian palace environments.\n\nExplore a breathtaking palace with 5 diverse settings, from the opulent sultan\u2019s baths to the serene gardens, each meticulously crafted to immerse you in a rich Persian landscape.\n", "short_description": "Ember Souls is a thrilling VR hack-and-slash game blending parkour, climbing and environmental puzzles in a luxurious Persian palace. Harness the power of the Ember Stones to unlock new abilities and use your combat skills and agility to defeat the mysterious Shadow Sultan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualage.io/privacy-policy-embersouls", "developer_terms_of_service_url": "https://www.virtualage.com/Games/EMBERSOULS_EULA.pdf", "publisher_name": "VirtualAge Games", "support_website_url": null, "website_url": "https://www.virtualage.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["
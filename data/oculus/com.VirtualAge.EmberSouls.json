oc=AdpYfrsKoa50dR4st9KwA-g8orgbQIU-a7oBFJcV1Fh5Mz3JUeOYp_dR4JicU08qPlo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBJYLACRD8qz_ZniVpIfy5NmypNA_6y2Ojvq5FerGQhw&oe=6B084AF2"}, {"file_name": "screenshot_meta_5.png", "id": "1001267178059228", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974785_1001267181392561_6408251747435581049_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28cVgTSmu1oQ7kNvwFykEmB&_nc_oc=AdqvfZKPhSONaAxap2C7OKLtVZ5mxb6X15iH1am2QJzY-Ekiczmm1lJVxiO0EnRDOJ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE95nEQb0ZZm97m1fW0Z_MJuSkBV-kRSLwQa6CX4myNg&oe=6B086A21"}, {"file_name": "screenshot_meta_3.png", "id": "349791551463844", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86601733_349791554797177_6181038885599336627_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AWPcaImDGoQ7kNvwE8XFmi&_nc_oc=Ado7RhZBOa5nJ2e05X4-Yc7tNrgS7ff7zGHipvEsy6bdUpJm-YWMOZzAuYV8GguBVVY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1aWe8Q9AZL7N1ccbOEr_MSc4Lh25ASLYvvtHO-vx89w&oe=6B086BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ES_Dark_KeyArt_Landscape_2560x1440_v2.png", "id": "1158608572230601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75462964_1158608575563934_6079602369579162800_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVhdOvmE4L4Q7kNvwGL6ASW&_nc_oc=AdqrvZInvWsKk_0aKsBs4XUGROU0uLxEAZvEaAFMGzYikFNLweicemJPrX9ZCbNnoBU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuEvBu_IkXwI-4214aSxTzCOXcAnm9ahvM1im-1v_acg&oe=6B084181"}, "display_name": "Ember Souls", "keywords": ["swordfighting", "climbing", "parkour", "action", "adventure"], "long_description": "Ember Souls is a thrilling VR hack-and-slash game blending parkour, climbing and environmental puzzles in a luxurious Persian palace. Harness the power of the Ember Stones to unlock new abilities and use your combat skills and agility to defeat the mysterious Shadow Sultan.\n\n{341059369020002}\n# Climbing and parkour\n\nExperience the thrill of acrobatic climbing with an innovative assisted parkour system that makes you feel like a powerful warrior.\n\n{2119194938451917}\n# Fun and visceral melee combat\nEngage in intense sword-fighting with over 20 different weapons against diverse enemies, each with unique combat styles, using advanced physics and a dynamic gore system.\n\n{837536108286763}\n# Environmental puzzles and traps \nSolve intricate puzzles while avoiding deadly traps to progress through the levels. The VR environment allows for creative interaction with the space, such as moving objects and climbing onto platforms to reach higher areas.\n\n\n{731427878959476}\n# Time and energy manipulation\nHarness the power of the ember stones to your advantage with abilities like slowing time down,  energy shield or sending a shock wave to stun your enemies. \n\n{966989418228804}\n# Stunning Persian palace environments.\n\nExplore a breathtaking palace with 5 diverse settings, from the opulent sultan\u2019s baths to the serene gardens, each meticulously crafted to immerse you in a rich Persian landscape.\n", "short_description": "Ember Souls is a thrilling VR hack-and-slash game blending parkour, climbing and environmental puzzles in a luxurious Persian palace. Harness the power of the Ember Stones to unlock new abilities and use your combat skills and agility to defeat the mysterious Shadow Sultan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualage.io/privacy-policy-embersouls", "developer_terms_of_service_url": "https://www.virtualage.com/Games/EMBERSOULS_EULA.pdf", "publisher_name": "VirtualAge Games", "support_website_url": null, "website_url": "https://www.virtualage.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_cate
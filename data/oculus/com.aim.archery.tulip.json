ng?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R22S6WkjFs0Q7kNvwHfc1aY&_nc_oc=AdpFB7qX2QR907A6Dr313vYijHItR3K4DXu0jxx0yOAA5tK6zJlnRPydfJ9eSf7X5m0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af946pYZtlPgM8Z3SyD5vEu1mWEKgy8LJntcJ4tPjPvxcQ&oe=6A32A38D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aim True - VR Archery Shooting Game", "keywords": ["Archery", "ShootingGame", "TargetShooting", "ActionGame", "ArcheryGame"], "long_description": "Sharpen your aim and unleash your inner archer in Aim True \u2013 VR Archery Shooting Game. Designed for players of all skill levels, this immersive VR adventure puts the bow and arrow right in your hands. Whether you\u2019re hitting bullseyes on static targets, challenging moving objects, or testing your reflexes in timed challenges, every shot counts.\n\nWith realistic bow mechanics, responsive controls, and beautifully designed environments, you\u2019ll feel the thrill of archery in its purest form. Compete for high scores, refine your accuracy, and push your limits as you progress through increasingly challenging levels.\n\nAre you ready to steady your hand, focus your eye, and aim true?", "short_description": "Step into the world of archery like never before in Aim True. Test your precision, speed, and focus as you shoot targets, break records, and master the bow in a fully immersive VR experience."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT
, responsive controls, and beautifully designed environments, you\u2019ll feel the thrill of archery in its purest form. Compete for high scores, refine your accuracy, and push your limits as you progress through increasingly challenging levels.\n\nAre you ready to steady your hand, focus your eye, and aim true?", "short_description": "Step into the world of archery like never before in Aim True. Test your precision, speed, and focus as you shoot targets, break records, and master the bow in a fully immersive VR experience."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24411719618451277"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823485_773880075012334_2452581963798679205_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvjuiIXyPX8Q7kNvwH28AhQ&_nc_oc=Adpyj3EpYX4hBEVQhEY_lh72T_TP0k943hBxuhhk1zIfRTFL1-tHOvnUkcdEaD2MBz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FxJcguanU_U4zjKivg2acWOL04YQ-9RYS8cjtZZM1mg&oe=6A0464
HtUHagfJTlsQ7kNvwEpMJyC&_nc_oc=AdpXhtuL3V6ijh3WI-lkS8qesO5PnmvCkYiMA_ns3JGlxLJ9y3rl7NEFaHbZ29Cqlhg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtvG3WVYNeWFQ7h8eROrcrFHSN0COvr7WbyxV_SpdxfQ&oe=6B0B17DF"}, {"file_name": "3.png", "id": "1074124831162492", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822818_1074124834495825_1710767892505576282_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMx0vHfxxF0Q7kNvwFWXAlz&_nc_oc=AdoO4pNCJoGnpssyzEwtnbYnqRs1n9hTN4J9-3js0BVEtNfOcIF6VNCeRxxuxAg4uko&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6GdMKtjejPNizkVRB1FF3sS6rcD81vdglplA310bNNA&oe=6B0B11CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aim True - VR Archery Shooting Game", "keywords": ["Archery", "ShootingGame", "TargetShooting", "ActionGame", "ArcheryGame"], "long_description": "Sharpen your aim and unleash your inner archer in Aim True \u2013 VR Archery Shooting Game. Designed for players of all skill levels, this immersive VR adventure puts the bow and arrow right in your hands. Whether you\u2019re hitting bullseyes on static targets, challenging moving objects, or testing your reflexes in timed challenges, every shot counts.\n\nWith realistic bow mechanics, responsive controls, and beautifully designed environments, you\u2019ll feel the thrill of archery in its purest form. Compete for high scores, refine your accuracy, and push your limits as you progress through increasingly challenging levels.\n\nAre you ready to steady your hand, focus your eye, and aim true?", "short_description": "Step into the world of archery like never before in Aim True. Test your precision, speed, and focus as you shoot targets, break records, and master the bow in a fully immersive VR experience."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name"
.com/v/t64.5771-25/491820208_1139883331381406_2755752504875906515_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3fFk_aIbZoQ7kNvwEP5rmy&_nc_oc=Adl_NXQ8qcy7YWHH9CXwvk2AGxNC7PfWNugFxocOuZmFSuV5LrbESZwbpeogu6XFu8k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft4MREQVWQSVZJHVdnHi9vku-LbnLMiTAJ_5cyOMEEreQ&oe=69A0531F"}, {"file_name": "3.png", "id": "1074124831162492", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822818_1074124834495825_1710767892505576282_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpkxCtNlgpUQ7kNvwGdNRYR&_nc_oc=AdnCMBI8JRl_kcbl4pEwOD5bvIX9SmuBAELo9E87hCnuCBTpbwDFWBhtHuTRl83sAVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvj_qdKz4MrCjCyVvMxISkPx44gVueW9iSDiz1Irr8KxQ&oe=69A04D0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aim True - VR Archery Shooting Game", "keywords": ["Archery", "ShootingGame", "TargetShooting", "ActionGame", "ArcheryGame"], "long_description": "Sharpen your aim and unleash your inner archer in Aim True \u2013 VR Archery Shooting Game. Designed for players of all skill levels, this immersive VR adventure puts the bow and arrow right in your hands. Whether you\u2019re hitting bullseyes on static targets, challenging moving objects, or testing your reflexes in timed challenges, every shot counts.\n\nWith realistic bow mechanics, responsive controls, and beautifully designed environments, you\u2019ll feel the thrill of archery in its purest form. Compete for high scores, refine your accuracy, and push your limits as you progress through increasingly challenging levels.\n\nAre you ready to steady your hand, focus your eye, and aim true?", "short_description": "Step into the world of archery like never before in Aim True. Test your precision, speed, and focus as you shoot targets, break records, and master the bow in a fully immersive VR experience."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.
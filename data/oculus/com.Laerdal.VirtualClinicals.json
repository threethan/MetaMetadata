."}]}, "developer_name": "Laerdal Medical and Wolters Kluwer Health", "developer_privacy_policy_url": "https://thepoint.lww.com/Privacy", "developer_terms_of_service_url": null, "publisher_name": "Laerdal Medical and Wolters Kluwer Health", "support_website_url": null, "website_url": "https://www.wolterskluwer.com/en/solutions/lippincott-nursing-faculty/vrclinicals-for-nursing", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "247454454647972"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1531640100825641"}, {"status": "PUBLISHED", "id": "1281607362486928"}, {"status": "PUBLISHED", "id": "170081902774204"}]}, "baseline_offer": {"id": "1531640100825641"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733486100, "status": "PUBLISHED", "id": "1531640100825641"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28940855358866951", "version": "2.12.4"}, "id": "304236241913868", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5120023298043491", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28940855358866951"}, "release_status":
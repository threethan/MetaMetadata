wdSXp-4MEb9Z3V67OojuGk0Qa8l6s6HXKoVdgSJrT5t_6W0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSBtw8N1uHTmZb8M-5H263r3w8pzCw7WFJmuGGBqf3Iqw&oe=6B0DBEF9"}, {"file_name": "03_song_details.png", "id": "1457827652960912", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_1457827672960910_8115106364697402142_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfv6tIcFhd0Q7kNvwHQDjer&_nc_oc=AdqLlN0FjHr7hDX18aL4SOwmF8AeAd0cM8OJkU_VuVkX-0gP_oGwkGpsHH3KRX_1mPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNLDKnuf_He5RKl8GRq4xRUszjFmRIHghnapa6teudog&oe=6B0DC2B7"}, {"file_name": "04_my_progress.png", "id": "992461879965406", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_992461886632072_6211575489421381398_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk9pRGnFb8oQ7kNvwE6h-nv&_nc_oc=AdqLPyfSp_FtDcQHZCyg-FLjwS1lJ9vXS6_gzt87J3GPaj5Vrm_L5VipfbYVexk0MTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRGxBFfFZQtoWUXAHB0EzFEjpIsyBSNc3fG9_qpSp9AmQ&oe=6B0DBE75"}, {"file_name": "05_piano_alignment.png", "id": "1678751870636424", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1678751877303090_4986771366585204770_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjUu5qXRNi0Q7kNvwFjlAWw&_nc_oc=AdrDBhWH6uzMWODUkbyETvw76POQGkWzfyQRkkAR6iJ7XtkuQmbgx5Pi2cnNVFSR54Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ82c4Uzmdyl0U60Cl6UkyWYEYmaRqohV9CW3PHg8JFZQ&oe=6B0DAA92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1594198222013052", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1594198225346385_3119361313983366939_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBsUSuI4utIQ7kNvwEOqA3b&_nc_oc=AdoUlraLUXWT1XpaqldRQwbfHZcYKp1--Ww_smWlH_7xqVwc2zl_aprPx7lOLuXYM3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLdp0K5GRNTjGjRigH_9M7didhcpWlGxYSLYqF4dPHlg&oe=6B0DA968"}, "display_name": "Easy Piano", "keywords": ["piano"], "long_description": "# Your piano. Your music. A little magic.\n\nTurn your real digital piano into an immersive mixed-reality experience. Beautiful falling notes guide your fingers, keys light up as you play, and music comes to life right above your keyboard.\n\n## **IMPORTANT \u2014 REQUIRED HARDWARE**\n\n**EasyPiano requires:**\n- Meta Quest 3 headset\n- 88-key digital piano with USB MIDI support\n- USB data cable connecting the piano directly to the headset\n\n**A compatible physical instrument is essential.** Acoustic pianos, Bluetooth MIDI connections, and virtual keyboards are not supported. Please check compatibility before purchasing.\n\n## **PLAY AT YOUR OWN PACE**\n\nFollow falling notes aligned with your real piano keys. In **Wait Mode**, the music pauses until you play the correct notes or chords. Adjust the tempo, master difficult passages, and build confidence without pressure.\n\n## **YOUR PIANO, BEAUTIFULLY AUGMENTED**\n\n- Automatic piano detection and alignment\n- Illuminated keys and elegant falling notes\n- Real-time feedback and progress tracking\n- A curated collection of piano music\n- Import your own MIDI files\n\n## **JUST SIT DOWN AND PLAY**\n\nNo sheet music required. No complicated lessons or distracting menus. Choose a song, press Start, and discover the joy of making music.\n\n**EasyPiano \u2014 Experience the joy of playing.**", "short_description": "Your piano. Your music. A little magic.\n\nTurn your real piano into an immersive mixed-reality experience. Follow beautiful falling notes, play at your own pace, and discover the joy of making music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://splink.org/easypiano/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Splink", "support_website_url": null, "website_url": "http
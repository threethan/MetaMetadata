cm5kNEEAbsD4QCLu2cXXq396XCzSxnTTPrIqlAHCOPJLDq4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyGCd1UYbKO6Q-7rr1R1geZCXOJGWkPKv4toyUK6qVRA&oe=6B09CA79"}, {"file_name": "03_song_details.png", "id": "1457827652960912", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_1457827672960910_8115106364697402142_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1G220TlQQ8Q7kNvwEswuuV&_nc_oc=AdrI3W3Hj5xfaQ15zaazR6sTtJkX8j1oeFM1wAHvQbpxgA1UPD0JajV97eUEVymX80g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFCM6jPudkOZqPaUx1-KNCcAzt0HgPuws9F2dUUILl1w&oe=6B09CE37"}, {"file_name": "04_my_progress.png", "id": "992461879965406", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_992461886632072_6211575489421381398_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBQmVGJcCw4Q7kNvwEmL9q2&_nc_oc=Adoe4SzgDamWswFjevJa5_FX0cbCa7ydjU6N5fsPMfgN20MbdiFm0ILj2Prgj8rejMo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWd-GOsMhW9DNaFs5dmHNQFzzRYJzGv-sU3evN0mTWSQ&oe=6B09C9F5"}, {"file_name": "05_piano_alignment.png", "id": "1678751870636424", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824322_1678751877303090_4986771366585204770_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3safJvJ7u1EQ7kNvwFD1eCr&_nc_oc=AdogenuLwY2uZTE26cSd0hKxz5cycD-giVbCfS5lBlkAnxeNxRSzeFP7CI6ehfDYlw4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbgcJ_x2irydXo8z7elc_LNOq8r-vutjnoAAdQdhiJhA&oe=6B09B612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1594198222013052", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823837_1594198225346385_3119361313983366939_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dUIngQGL44Q7kNvwFMWsKL&_nc_oc=AdpRJN0uO-0bWiDxRvbOiGYrSQBM8XubgxK94YHFs7DS3QS8FSX48VqL4G64zkhoVhA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzBIeJwK2c34MrkLQlEMJ4KlUuSkh21kul-dvEv3uvNg&oe=6B09B4E8"}, "display_name": "Easy Piano", "keywords": ["piano"], "long_description": "# Your piano. Your music. A little magic.\n\nTurn your real digital piano into an immersive mixed-reality experience. Beautiful falling notes guide your fingers, keys light up as you play, and music comes to life right above your keyboard.\n\n## **IMPORTANT \u2014 REQUIRED HARDWARE**\n\n**EasyPiano requires:**\n- Meta Quest 3 headset\n- 88-key digital piano with USB MIDI support\n- USB data cable connecting the piano directly to the headset\n\n**A compatible physical instrument is essential.** Acoustic pianos, Bluetooth MIDI connections, and virtual keyboards are not supported. Please check compatibility before purchasing.\n\n## **PLAY AT YOUR OWN PACE**\n\nFollow falling notes aligned with your real piano keys. In **Wait Mode**, the music pauses until you play the correct notes or chords. Adjust the tempo, master difficult passages, and build confidence without pressure.\n\n## **YOUR PIANO, BEAUTIFULLY AUGMENTED**\n\n- Automatic piano detection and alignment\n- Illuminated keys and elegant falling notes\n- Real-time feedback and progress tracking\n- A curated collection of piano music\n- Import your own MIDI files\n\n## **JUST SIT DOWN AND PLAY**\n\nNo sheet music required. No complicated lessons or distracting menus. Choose a song, press Start, and discover the joy of making music.\n\n**EasyPiano \u2014 Experience the joy of playing.**", "short_description": "Your piano. Your music. A little magic.\n\nTurn your real piano into an immersive mixed-reality experience. Follow beautiful falling notes, play at your own pace, and discover the joy of making music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://splink.org/easypiano/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Splink", "support_website_url": null, "website_url": "http
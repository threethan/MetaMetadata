qb_6Z8bZNtTMm9_lWu9_9llTciRgPymBvTml5Krzmd8cNEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVUoVuB5New82pfR8zIuST-WQXyOezaT_NaUEmYg6icHw&oe=6B0F1079"}, {"file_name": "03_song_details.png", "id": "1457827652960912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1457827672960910_8115106364697402142_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-j0P8r-g-kQ7kNvwGOz6we&_nc_oc=AdphNlwHb9NrcAogyoasNE_5VCzRd1TmG_rtwJYLEY0tLnK8bokCdAOm1fSUeiAdBgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWwk0pC3hUpWeWelGFNM1G7RKuW_F2jwdD_2Pxe2_CnIw&oe=6B0F1437"}, {"file_name": "04_my_progress.png", "id": "992461879965406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_992461886632072_6211575489421381398_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk9pRGnFb8oQ7kNvwHjeSN7&_nc_oc=Adqrc83AeAh0YkPdM_ZoguKX_PB7utE79YPEQ3j6_fsihKxf9A7FgwBFOKbe76mCpfo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUHOZZcw5TKkXb0vC6ukLaMpdrNSV-_7aSwdrlzkbVyVw&oe=6B0F0FF5"}, {"file_name": "05_piano_alignment.png", "id": "1678751870636424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1678751877303090_4986771366585204770_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJj2atjg-7wQ7kNvwHOOn6v&_nc_oc=AdrV_Pp-o8XvhiZAkyb1p-_LuWzn5_Zvohmm0ItJW8rSR_4T9WO0Ix0JhlUU1wPm1vw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUnAPlXnUtgjP4SQRd02y_AFqAcORsaTCfCrimK2GvuGQ&oe=6B0EFC12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1594198222013052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_1594198225346385_3119361313983366939_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBsUSuI4utIQ7kNvwFk39Cz&_nc_oc=AdqKUcB8gujE1LzXX7OFtUjgPqkYa1vx6Oonqw65FU3s75P47Nvmi_aWC_5L5MIeeqs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU93_A0KwdT1mLQtK5hb1dE-gwTwrn54ohJPmvPI9S0sg&oe=6B0EFAE8"}, "display_name": "Easy Piano", "keywords": ["piano"], "long_description": "# Your piano. Your music. A little magic.\n\nTurn your real digital piano into an immersive mixed-reality experience. Beautiful falling notes guide your fingers, keys light up as you play, and music comes to life right above your keyboard.\n\n## **IMPORTANT \u2014 REQUIRED HARDWARE**\n\n**EasyPiano requires:**\n- Meta Quest 3 headset\n- 88-key digital piano with USB MIDI support\n- USB data cable connecting the piano directly to the headset\n\n**A compatible physical instrument is essential.** Acoustic pianos, Bluetooth MIDI connections, and virtual keyboards are not supported. Please check compatibility before purchasing.\n\n## **PLAY AT YOUR OWN PACE**\n\nFollow falling notes aligned with your real piano keys. In **Wait Mode**, the music pauses until you play the correct notes or chords. Adjust the tempo, master difficult passages, and build confidence without pressure.\n\n## **YOUR PIANO, BEAUTIFULLY AUGMENTED**\n\n- Automatic piano detection and alignment\n- Illuminated keys and elegant falling notes\n- Real-time feedback and progress tracking\n- A curated collection of piano music\n- Import your own MIDI files\n\n## **JUST SIT DOWN AND PLAY**\n\nNo sheet music required. No complicated lessons or distracting menus. Choose a song, press Start, and discover the joy of making music.\n\n**EasyPiano \u2014 Experience the joy of playing.**", "short_description": "Your piano. Your music. A little magic.\n\nTurn your real piano into an immersive mixed-reality experience. Follow beautiful falling notes, play at your own pace, and discover the joy of making music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://splink.org/easypiano/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Splink", "support_website_url": null, "website_url": "http
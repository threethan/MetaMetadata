uVgWGVwkvYCPrJvTHJsxqL85QtLZSEVpeH_qThoPacFh-Hk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlbLf0sIpO-FEndJliNrQFXOunbvLX91B5-eqosto7ow&oe=6B072779"}, {"file_name": "03_song_details.png", "id": "1457827652960912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1457827672960910_8115106364697402142_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1G220TlQQ8Q7kNvwEw4huI&_nc_oc=AdowEGESQbv3M2Afl9QoLFOqQSYwiMpUCPuBUie-thPvh-tFo7aUCkbBHAHbw8E2ntY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD7GrqwaHRnHtsFBiROwDV1f01lqLqT5lcg0eoC0R5yQ&oe=6B06F2F7"}, {"file_name": "04_my_progress.png", "id": "992461879965406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_992461886632072_6211575489421381398_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gi2pwKhQ6usQ7kNvwFa5Z4w&_nc_oc=AdpD1ywgEOrs7bQJZCyhCyu3fJwFq14J7xMTryVt1f_-p4sat12E2zJmdK0NqzsVFl8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNGB6V95ocNurSeiCxL7bMDMMLeOrh83IJQ7J3yRFRvw&oe=6B0726F5"}, {"file_name": "05_piano_alignment.png", "id": "1678751870636424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1678751877303090_4986771366585204770_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3safJvJ7u1EQ7kNvwHxu-NG&_nc_oc=Adovbgl9AKaBnZeXO6CnqQemWXWyqO1MfbjG959WILJG9WrAQ0qM_cTVaQifqXcy6rE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN6a_8e9XcSIANgZ3JKBpHesfGoN29wnJbGAUJEkiNNQ&oe=6B071312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1594198222013052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_1594198225346385_3119361313983366939_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8G0kdccEfsQ7kNvwGzGJuN&_nc_oc=AdrvTup5gqtVE0O3BYpyp0l0bLuQ3K9QQOItVBPcsyzEyBzjMAkiO9cRBhu-YaQ5YoU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg61k4JtVB2eoz7T33g9GxmSwXV8pcYVz7OkDrzMeI5A&oe=6B0711E8"}, "display_name": "Easy Piano", "keywords": ["piano"], "long_description": "# Your piano. Your music. A little magic.\n\nTurn your real digital piano into an immersive mixed-reality experience. Beautiful falling notes guide your fingers, keys light up as you play, and music comes to life right above your keyboard.\n\n## **IMPORTANT \u2014 REQUIRED HARDWARE**\n\n**EasyPiano requires:**\n- Meta Quest 3 headset\n- 88-key digital piano with USB MIDI support\n- USB data cable connecting the piano directly to the headset\n\n**A compatible physical instrument is essential.** Acoustic pianos, Bluetooth MIDI connections, and virtual keyboards are not supported. Please check compatibility before purchasing.\n\n## **PLAY AT YOUR OWN PACE**\n\nFollow falling notes aligned with your real piano keys. In **Wait Mode**, the music pauses until you play the correct notes or chords. Adjust the tempo, master difficult passages, and build confidence without pressure.\n\n## **YOUR PIANO, BEAUTIFULLY AUGMENTED**\n\n- Automatic piano detection and alignment\n- Illuminated keys and elegant falling notes\n- Real-time feedback and progress tracking\n- A curated collection of piano music\n- Import your own MIDI files\n\n## **JUST SIT DOWN AND PLAY**\n\nNo sheet music required. No complicated lessons or distracting menus. Choose a song, press Start, and discover the joy of making music.\n\n**EasyPiano \u2014 Experience the joy of playing.**", "short_description": "Your piano. Your music. A little magic.\n\nTurn your real piano into an immersive mixed-reality experience. Follow beautiful falling notes, play at your own pace, and discover the joy of making music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://splink.org/easypiano/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Splink", "support_website_url": null, "website_url": "http
nc_ss=7f30f&oh=00_AQRGxBFfFZQtoWUXAHB0EzFEjpIsyBSNc3fG9_qpSp9AmQ&oe=6B0DBE75"}, {"file_name": "05_piano_alignment.png", "id": "1678751870636424", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1678751877303090_4986771366585204770_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjUu5qXRNi0Q7kNvwFjlAWw&_nc_oc=AdrDBhWH6uzMWODUkbyETvw76POQGkWzfyQRkkAR6iJ7XtkuQmbgx5Pi2cnNVFSR54Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ82c4Uzmdyl0U60Cl6UkyWYEYmaRqohV9CW3PHg8JFZQ&oe=6B0DAA92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1594198222013052", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_1594198225346385_3119361313983366939_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBsUSuI4utIQ7kNvwEOqA3b&_nc_oc=AdoUlraLUXWT1XpaqldRQwbfHZcYKp1--Ww_smWlH_7xqVwc2zl_aprPx7lOLuXYM3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLdp0K5GRNTjGjRigH_9M7didhcpWlGxYSLYqF4dPHlg&oe=6B0DA968"}, "display_name": "Easy Piano", "keywords": ["piano"], "long_description": "# Your piano. Your music. A little magic.\n\nTurn your real digital piano into an immersive mixed-reality experience. Beautiful falling notes guide your fingers, keys light up as you play, and music comes to life right above your keyboard.\n\n## **IMPORTANT \u2014 REQUIRED HARDWARE**\n\n**EasyPiano requires:**\n- Meta Quest 3 headset\n- 88-key digital piano with USB MIDI support\n- USB data cable connecting the piano directly to the headset\n\n**A compatible physical instrument is essential.** Acoustic pianos, Bluetooth MIDI connections, and virtual keyboards are not supported. Please check compatibility before purchasing.\n\n## **PLAY AT YOUR OWN PACE**\n\nFollow falling notes aligned with your real piano keys. In **Wait Mode**, the music pauses until you play the correct notes or chords. Adjust the tempo, master difficult passages, and build confidence without pressure.\n\n## **YOUR PIANO, BEAUTIFULLY AUGMENTED**\n\n- Automatic piano detection and alignment\n- Illuminated keys and elegant falling notes\n- Real-time feedback and progress tracking\n- A curated collection of piano music\n- Import your own MIDI files\n\n## **JUST SIT DOWN AND PLAY**\n\nNo sheet music required. No complicated lessons or distracting menus. Choose a song, press Start, and discover the joy of making music.\n\n**EasyPiano \u2014 Experience the joy of playing.**", "short_description": "Your piano. Your music. A little magic.\n\nTurn your real piano into an immersive mixed-reality experience. Follow beautiful falling notes, play at your own pace, and discover the joy of making music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://splink.org/easypiano/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Splink", "support_website_url": null, "website_url": "https://splink.org/easypiano/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1356931184178111"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1371110535039562_2353387521000708240_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIn2jNyJECIQ7kNvwFamtyF&_nc_oc=AdpCO0um9J90NeIdbXUTCQqhP
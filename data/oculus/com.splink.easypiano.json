F1wdU83nmixk6Z_Z4zNgxg971m8IxMT8yoJl9tXmKI9oOf0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3fb9QpZcEKOZu3W_Za1aJDBob-RQfenc2dcny35M1KA&oe=6B0840B9"}, {"file_name": "03_song_details.png", "id": "1457827652960912", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491823279_1457827672960910_8115106364697402142_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1G220TlQQ8Q7kNvwHOVYcw&_nc_oc=AdohroBYxfOWpraPeJ708p8kjfMqSXvfc7jMsPv6dJIP0Xa8UuVVG4-c40ytr5WO9oY&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqQfC7N3WMQMqvPZT-g4BLJjd-R5_8jS2s86yYyIqSyg&oe=6B084477"}, {"file_name": "04_my_progress.png", "id": "992461879965406", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823901_992461886632072_6211575489421381398_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBQmVGJcCw4Q7kNvwHMq4Ye&_nc_oc=Ado1gHiP2GEcaHE3jvMhbiq_QyqIlSpcYCAptWUMfld9W6g5ijSQOSB4krTqbab_K4Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkeThMS6kQ450HjmaW8EvVeVy2BKAlt3JxBkHPG4_TsQ&oe=6B084035"}, {"file_name": "05_piano_alignment.png", "id": "1678751870636424", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824322_1678751877303090_4986771366585204770_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3safJvJ7u1EQ7kNvwGGzRDG&_nc_oc=AdpgXcggC9SF2-rt2YyXG24zePqlToou2wcvlxMO5vlh5NrjWbLPmxEDQI9-9r_M3Qw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVU0TnnJ-GB_iFrO8iwT3yNGulztJpv8skBh4DBS5U9w&oe=6B086492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1594198222013052", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823837_1594198225346385_3119361313983366939_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dUIngQGL44Q7kNvwHuHI0h&_nc_oc=AdqxABCVoMAgbOSX52yAFoNhcoDqsRlY8a-bnvXwyQQC2U_ZEeQjIqmq5sAR1kXs34k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr53dTGdoNpLxN_oCUm3KRdz2imwnY_gHG44Ai-i5enQ&oe=6B086368"}, "display_name": "Easy Piano", "keywords": ["piano"], "long_description": "# Your piano. Your music. A little magic.\n\nTurn your real digital piano into an immersive mixed-reality experience. Beautiful falling notes guide your fingers, keys light up as you play, and music comes to life right above your keyboard.\n\n## **IMPORTANT \u2014 REQUIRED HARDWARE**\n\n**EasyPiano requires:**\n- Meta Quest 3 headset\n- 88-key digital piano with USB MIDI support\n- USB data cable connecting the piano directly to the headset\n\n**A compatible physical instrument is essential.** Acoustic pianos, Bluetooth MIDI connections, and virtual keyboards are not supported. Please check compatibility before purchasing.\n\n## **PLAY AT YOUR OWN PACE**\n\nFollow falling notes aligned with your real piano keys. In **Wait Mode**, the music pauses until you play the correct notes or chords. Adjust the tempo, master difficult passages, and build confidence without pressure.\n\n## **YOUR PIANO, BEAUTIFULLY AUGMENTED**\n\n- Automatic piano detection and alignment\n- Illuminated keys and elegant falling notes\n- Real-time feedback and progress tracking\n- A curated collection of piano music\n- Import your own MIDI files\n\n## **JUST SIT DOWN AND PLAY**\n\nNo sheet music required. No complicated lessons or distracting menus. Choose a song, press Start, and discover the joy of making music.\n\n**EasyPiano \u2014 Experience the joy of playing.**", "short_description": "Your piano. Your music. A little magic.\n\nTurn your real piano into an immersive mixed-reality experience. Follow beautiful falling notes, play at your own pace, and discover the joy of making music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://splink.org/easypiano/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Splink", "support_website_url": null, "website_url": "http
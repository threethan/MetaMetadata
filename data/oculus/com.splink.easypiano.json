Iod10X_iNADM8hTGYZ7rOCyvAXjPPohtPnSGj-NyGWN8TmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX2lns3fC46iczlcx70HvCjGY3nEVBN302ZOfQJPPjLQ&oe=6B0057B9"}, {"file_name": "03_song_details.png", "id": "1457827652960912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1457827672960910_8115106364697402142_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bawx2sa6EawQ7kNvwG9HogD&_nc_oc=AdrHF0xgOUDP0dyTPOk1Elta06UbDSg86ikNoYsUMsHVYVRp0vhw7_l4UanVc96UaYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwdUyJD4EoKdQ5yTLyeYtBseNXLy183cE4zowKVQPAwA&oe=6B005B77"}, {"file_name": "04_my_progress.png", "id": "992461879965406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_992461886632072_6211575489421381398_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0txY9Q4gUoQ7kNvwF3VPv9&_nc_oc=AdoOkS-dK2cBllEwn_gpKy7wJ6dYScaW-wHgTz6qlfJjAGhCgfko8IMsuJ2mCNGUSuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz-lABvry625obPJg6Whv5s-Bgn5H4v49RhrML_qm5BA&oe=6B005735"}, {"file_name": "05_piano_alignment.png", "id": "1678751870636424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_1678751877303090_4986771366585204770_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJN478Im2GYQ7kNvwG1LnC9&_nc_oc=Adr-8j_s5MAlGSRMdx2uHG3QaXsm0OZpKlW2WFuZQMUDgpMUJccH4SxLA2619qAnmqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO-mCisDke-C12sVzNB9CzWKJ4UUeKPuXfx9sxt3ZH6g&oe=6B007B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1594198222013052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_1594198225346385_3119361313983366939_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjGu5PO0eOEQ7kNvwGahKJh&_nc_oc=AdprL43bB05Sd-1moYei_A54Gbt-tpCgczU5QCVtBDg4HT7k0XrJMUsIXGstadXS50Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTA4N7FwFVqS3vayBsNJlYaLjXe14VSAKE8jNsssuD2w&oe=6B007A68"}, "display_name": "Easy Piano", "keywords": ["piano"], "long_description": "# Your piano. Your music. A little magic.\n\nTurn your real digital piano into an immersive mixed-reality experience. Beautiful falling notes guide your fingers, keys light up as you play, and music comes to life right above your keyboard.\n\n## **IMPORTANT \u2014 REQUIRED HARDWARE**\n\n**EasyPiano requires:**\n- Meta Quest 3 headset\n- 88-key digital piano with USB MIDI support\n- USB data cable connecting the piano directly to the headset\n\n**A compatible physical instrument is essential.** Acoustic pianos, Bluetooth MIDI connections, and virtual keyboards are not supported. Please check compatibility before purchasing.\n\n## **PLAY AT YOUR OWN PACE**\n\nFollow falling notes aligned with your real piano keys. In **Wait Mode**, the music pauses until you play the correct notes or chords. Adjust the tempo, master difficult passages, and build confidence without pressure.\n\n## **YOUR PIANO, BEAUTIFULLY AUGMENTED**\n\n- Automatic piano detection and alignment\n- Illuminated keys and elegant falling notes\n- Real-time feedback and progress tracking\n- A curated collection of piano music\n- Import your own MIDI files\n\n## **JUST SIT DOWN AND PLAY**\n\nNo sheet music required. No complicated lessons or distracting menus. Choose a song, press Start, and discover the joy of making music.\n\n**EasyPiano \u2014 Experience the joy of playing.**", "short_description": "Your piano. Your music. A little magic.\n\nTurn your real piano into an immersive mixed-reality experience. Follow beautiful falling notes, play at your own pace, and discover the joy of making music."}]}, "developer_name": null, "developer_privacy_policy_url": "https://splink.org/easypiano/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Splink", "support_website_url": null, "website_url": "http
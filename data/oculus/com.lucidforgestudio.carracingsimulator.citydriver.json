NL5n1hpATtGCWK9FksoDc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUIw0zUEVrC06izK6ZpDkO8KtJn7K7Ajd0moeixSmRFQ&oe=6ABBC55B"}, {"file_name": "2.png", "id": "956797027358010", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824318_956797030691343_6840270192664985768_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5henRfQTC9IQ7kNvwFXStF0&_nc_oc=AdpcDXVeU1om8xtOq54rckoPrmeRCLQ44YnIPktj6PY4zGCfzKOsQ8aFmGO2AFwOJxM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ0AXrhgHC4xM3rul43_PqBJUP2EcNIF1w2iCHE5dnRA&oe=6ABBE41D"}, {"file_name": "5.png", "id": "1375848304449003", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825575_1375848311115669_1126684699492293710_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJRCB6iq2mAQ7kNvwE3ugSF&_nc_oc=AdrPITh88X8QUUV-c4TGegkU-btgLq0hZtMeCg-2Ae8bwKom4Fsp410863ff8y9p984&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhmoDWds1UhE_aWG3U0c4oRG6T3K5FGsCtV6QOir18jA&oe=6ABBB81C"}, {"file_name": "3.png", "id": "1892890122097796", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823910_1892890125431129_352052578194761750_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pqZiNlhlv0Q7kNvwG3s1-d&_nc_oc=AdpYi_33oV5T6zxvCPy0JSZPzquTS-zXRhk4Bg9XDKwX3OLt_Dvp81qZ1fclA9o_VXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId5uWEgtS18RZISHoZeqtdEBJdjBs2b67lZ4FiaIsRpg&oe=6ABBDE89"}, {"file_name": "4.png", "id": "1318658026527908", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1318658029861241_8888419522344590635_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZVu7camZnIQ7kNvwHfAmM9&_nc_oc=Adp7UrfNWqP68CweRqIkmDiHqYU7Ufke5h7FfHQ3WoKGHOmBPANNt28lp5th3htbV3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdb-QOk3904tx8ZX2iwEksHlCaw7nJFrLPhGcHnFJLrQ&oe=6ABBBDEB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Racing Simulator: City Driver", "keywords": ["carracingsimulator", "citydriving", "drivingsimulator", "carracing", "racinggame"], "long_description": "Car Racing Simulator: City Driver delivers a next-level driving experience designed for fans of speed, realism, and open-world exploration. Step into a highly detailed city environment where every road, corner, and traffic system feels alive. This carracingsimulator combines realistic physics with smooth drivingsimulator mechanics to give players full control over powerful vehicles.\n\nExperience the thrill of citydriving as you navigate through busy streets, highways, and urban landscapes filled with dynamic traffic. Each mission and race is designed to test your driving skills, reflexes, and precision. Whether you enjoy relaxed cruising or intense high-speed chases, this game offers a perfect balance of fun and challenge.\n\nFeel the excitement of carracing as you drift around corners, overtake traffic, and push your car to its limits. The realistic vehicle handling system makes every turn and acceleration feel authentic. With responsive controls and immersive camera views, players get a true racinggame experience that keeps them engaged for hours.\n\nExplore a vast open city where freedom is yours. Drive anywhere, complete challenges, or simply enjoy the realistic environment. From smooth highways to tight city streets, every area is designed to enhance your driving experience.\n\nCar Racing Simulator: City Driver is the ultimate choice for players who love realistic driving, high-speed racing, and open-world exploration. Get ready to become the master of city roads.", "short_description": "Car Racing Simulator: City Driver is an immersive carracingsimulator experience built for speed lovers. Enjoy realistic citydriving with smooth drivingsimulator controls and high-quality environments. Race through busy streets, master sharp turns, and experience thrilling carracing action. Explore open roads, avoid traffic, and enjoy intense racinggame challenges. Perfect for players who love fast driving, real physics, and endless racing fun in a detailed city world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1211032928755818"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1710235587067471_3718192991453017390_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gF7NT6nx6sgQ7kNvwFukg5n&_nc_oc=AdoqKDxk_VPu5Y5OZ2pj7D0JVe-8vtKiJUarY2IMjdSg6qmsYlNvQcDVpkxVh73EOTs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI63gi7NQrGQbmeep00YLKURlA6_k0vHW5kRKbG3t1zlw&oe=6ABBC81A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Car Racing Simulator: City Driver", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "3315291881
Ziwqg&oe=6AA3FAD1"}, {"file_name": "ballar4.png", "id": "2384109955122659", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982683_2384109958455992_180369892112312888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3eRv4TFuaYQ7kNvwF7fk_l&_nc_oc=AdqtkWgZQS5Iw7eY9inJiFVffjwwwWhqFchQdpexJ1cxgnwGi1N_HBxnB06iOEgQnEw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhxvPM-ZMl0GHEcECz7QqFkpH2AqIqk-CaMXV8OWP4RA&oe=6AA4135F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BasketBallAR", "keywords": [], "long_description": "Ditch your gym membership and explore this Augmented Reality (AR) basketball experience that will have you aiming higher and striving for more! Channel your inner basketball superstar, rack up points, and brag to your friends.\n\nControls:\n1. Use the controller to point at the wall and use the trigger to place the hoop.\n2. Click and hold the trigger to produce a basketball. Let it go to shoot at the basket.\n\nIf you like this app, please let me know in the reviews, and I will add more features!", "short_description": "Channel your inner basketball superstar, rack up points, and brag to your friends."}]}, "developer_name": "Scrub Scrub", "developer_privacy_policy_url": "https://sites.google.com/view/scrub-gaming/basketballar/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Scrub Gaming", "support_website_url": null, "website_url": "https://sites.google.com/view/scrub-gaming/basketballar", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "s
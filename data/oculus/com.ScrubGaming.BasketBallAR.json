}, {"file_name": "ballar4.png", "id": "2384109955122659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982683_2384109958455992_180369892112312888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6ESKaztSDcQ7kNvwFtpx1d&_nc_oc=Adrg8V7dnL7EwlzuofAo6s2wBM6Z-78HNv_nnB0PSow2s4QvbpEE8uyXRPk8Pmwvalw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFPeJq5UO0nIOcUO125tQV48J02ILVXY1nOOv99jmNwQ&oe=6ABBCE5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BasketBallAR", "keywords": [], "long_description": "Ditch your gym membership and explore this Augmented Reality (AR) basketball experience that will have you aiming higher and striving for more! Channel your inner basketball superstar, rack up points, and brag to your friends.\n\nControls:\n1. Use the controller to point at the wall and use the trigger to place the hoop.\n2. Click and hold the trigger to produce a basketball. Let it go to shoot at the basket.\n\nIf you like this app, please let me know in the reviews, and I will add more features!", "short_description": "Channel your inner basketball superstar, rack up points, and brag to your friends."}]}, "developer_name": "Scrub Scrub", "developer_privacy_policy_url": "https://sites.google.com/view/scrub-gaming/basketballar/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Scrub Gaming", "support_website_url": null, "website_url": "https://sites.google.com/view/scrub-gaming/basketballar", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7551082544935414"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1364308970948956"}]}, "baseline_offer": {"id": "1364308970948956"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1711651260, "status": "PUBLISHED", "id": "1364308970948956"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25646544218295970", "version": "8.0.0"}, "id": "1068226080929879", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7526177777425891", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25646544218295970"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789664392, "id": "28665766783040350", "version": "8.0.2", "version_code": 10, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7526177777425891", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25646544218295970"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789608609, "id": "28656562063960822", "version": "8.0.1", "version_code": 9, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7526177777425891", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25646544218295970"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1068226080929879"}]}, "change_log": "Welcome to version 2.0 of BasketBallAR! Thank you for all your support so far. BasketBallAR v2 includes the following improvements:\n- You can now place the basket and shoot the ball with both controllers.\n- Keep track of your best round with high scores.\n- 3-point mode at 7 seconds left in the game.\n- You can move the basket position after placing the basket and in-between games.\n- Improved basket graphics.\n- Added basic sound effects.\n- Switched to Meta's controller models.\n- Will fallback to a default environment and still work if you do not give the app permission to access your scene data.\n- Added tooltips to help explain how to place the basket and shoot the ball.\n- Other minor bug fixes.", "created_date": 1765868678, "id": "25646544218295970", "version": "8.0.0", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7526177777425891", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25646544218295970"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1765784199, "id": "25638264295790629", "version": "7.0.0", "version_code": 7, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset
": "basketballar-2560.png", "id": "1465675054324444", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974905_1465675060991110_343086147365620516_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fm0hTYu6584Q7kNvwFN2jwn&_nc_oc=AdmLMYwXLtZbZDJtRMH8FVpsXRwosuMd7qgqww5i-nG0TV9w5cinB0WxFf5KXGDtPEA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvQVREBtoCcsyoDViCRWBZsFCyC3jff3GMn_ylEYRCfrA&oe=69A19BF0"}, {"file_name": "ballar1-test.png", "id": "395685096544146", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974753_395685099877479_4977241992779144840_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2CjE0yYsgkQ7kNvwFm_7r6&_nc_oc=AdkE43HXr-PXjokiCm2qhCq0nO6g4x2-c4lyZsAe4dDB5-kW13-Y0-WfSdYoUq3JCAM&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvXeeab8lWaFUPuxWZpkq-n7ptkARBJcL3qYrsB52PwUg&oe=69A19069"}, {"file_name": "ballar5.png", "id": "283072461547226", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39036613_283072468213892_5317777036935146514_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3guMv2rS98Q7kNvwHwhe4Y&_nc_oc=AdlMMXBFqr48a8--8lybHVondIz3EoazqlQWJECQAcB-hAUP1l73-ufXc4e_gioJrMQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afu2rKyh727-G0cUI__kTkuDvAYsr21jaAS1XnQ-vYtC0Q&oe=69A1A25E"}, {"file_name": "ballar2.png", "id": "1181022306218023", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75230048_1181022309551356_6071489749183097168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piBMh15CvEEQ7kNvwH4pxvX&_nc_oc=Adn5AZ0oVrtbNubjr0f1cfhLOL-Qz_H9mOuTLHh0mFvsPVxbJgnpLKC5klwgb6hwUgw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuggnanX2LOSHtde33m83smiyj2k-DANRQ6bBcF6ZUOeA&oe=69A194D1"}, {"file_name": "ballar4.png", "id": "2384109955122659", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982683_2384109958455992_180369892112312888_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybtM5U9YwjEQ7kNvwHePY9s&_nc_oc=Adkup5hzYIfi-Lnl_MsfR336_7gQOBKWeRJdb5HuwEfcaObBjMuhO0Cd-o0xi33d4N8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvaPzm39tSkDG1EmqAfK48F-JEU4gZD2SlQNO35-h8adw&oe=69A1751F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BasketBallAR", "keywords": [], "long_description": "Ditch your gym membership and explore this Augmented Reality (AR) basketball experience that will have you aiming higher and striving for more! Channel your inner basketball superstar, rack up points, and brag to your friends.\n\nControls:\n1. Use the controller to point at the wall and use the trigger to place the hoop.\n2. Click and hold the trigger to produce a basketball. Let it go to shoot at the basket.\n\nIf you like this app, please let me know in the reviews, and I will add more features!", "short_description": "Channel your inner basketball superstar, rack up points, and brag to your friends."}]}, "developer_name": "Scrub Scrub", "developer_privacy_policy_url": "https://sites.google.com/view/scrub-gaming/basketballar/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Scrub Gaming", "support_website_url": null, "website_url": "https://sites.google.com/view/scrub-gaming/basketballar", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7551082544935414"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1364308970948956"}]}, "baseline_offer": {"id": "1364308970948956"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1711651260, "status": "PUBLISHED", "id": "1364308970948956"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25646544218295970", "version": "8.0.0"}, "id": "1068226080929879", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7526177777425891", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25646544218295970"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1068226080929879"}]}, "change_log": "Welcome to version 2.0 of BasketBallAR! Thank you for all your support so far. BasketBallAR v2 includes the following improvements:\n- You can now place the basket and shoot the ball with both controllers.\n- Keep track of your best round with high scores.\n- 3-point mode at 7 seconds left in the game.\n- You can move the basket position after placing the basket and in-between games.\n- Improved basket graphics.\n- Added basic sound effects.\n- Switched to Meta's controller models.\n- Will fallback to a default environment and still work if you do not give the app permission to access your scene data.\n- Added tooltips to help explain how to place the basket and shoot the ball.\n- Other minor bug fixes.", "created_date": 1765868678, "id": "25646544218295970", "version": "8.0.0", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7526177777425891", "is_concept": false, "latest_release
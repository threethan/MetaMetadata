6Wvd&_nc_oc=Adq5BAaUpnbY1O64-lMpeG2CqcPP5bf1i4kOTpMLBYhVoem58Z0qv9nxzhJziyNE6Cw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-OmYVPlD53zb2Ez7ltj0TwzPmsEuOgJI-QwYXMvmsWw&oe=6B085DD0"}, {"file_name": "Meta Quest Screenshot - 2.png", "id": "954971382620839", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75622024_954971389287505_3695925960083280134_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2ee72cftSoQ7kNvwHhWdXV&_nc_oc=Adp5mFKbQTXfw1H7asV-KQ51-uWqCjzymQ2LgKZw_NmvyVtWuTspRdSBX5fm9YuaWBU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPPP0z7bvK_t6-d9XtVP-DwfGPHYUbjSA-55TruSl1JQ&oe=6B084838"}, {"file_name": "Meta Quest Screenshot - 3.png", "id": "209909248601450", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031571_209909251934783_916183043909806198_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob7rIXEnCU0Q7kNvwG0P_19&_nc_oc=Adoo9kw561_r0hN9yFXIpdCMUu1efv-ngX16vgcnl9gij2Oo_jAQyrc0T9vYoFNrEhE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeHObVEPc1nx9kvzFZDROXPYdFtuR_WZquUJueGTu0ww&oe=6B0843DF"}, {"file_name": "Meta Quest Screenshot - 4.png", "id": "261846916502400", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001664_261846919835733_9001348606434030919_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KE-W2bEJPqwQ7kNvwHlcOVn&_nc_oc=AdoRWPcjVdwlaHom7wW76kw-xUCn8JF9ZspA7NEIInUsOKaSxpGQK9Tt69HgJ_ZPSrk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkdHK9FMFpf0uG8lnR9_s_dZRmIxSTo8rmqpBEXsIOUw&oe=6B085522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WildXR - Trailer Landscape.png", "id": "3533980690181946", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974535_3533980693515279_7459242962070103796_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-IJE86sAqcQ7kNvwF5YqXo&_nc_oc=AdqQJ9RDZlEHKEf3zDMD6EQ5CcO_ScnwHyoGxXA7Dbx0KAsu4nQZp9fLAgaOLKBHqvg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwKChLNcfRpcbDeNsQBvDQjKt-65CdAdZsKfymJ6IpEA&oe=6B0861E0"}, "display_name": "WildXR", "keywords": [], "long_description": "Explore the natural world in a whole new way with WildXR, the immersive virtual reality app that brings the planet's most thrilling wildlife experiences to your fingertips. Dive into an unparalleled adventure where you are in control, witnessing wildlife encounters at your own pace, from wherever you are.\n\nWildXR is more than just an app - it\u2019s a gateway into the heart of the world\u2019s most diverse ecosystems. Get splashed by elephants as they wallow in African water holes. Marvel at the captivating dance of birds of paradise in the jungles of Southeast Asia. Watch in awe as spider monkeys swing through the jungle with ease, or witness endangered green sea turtles visiting \u201ccleaning stations\u201d in the deep oceans. These and many other experiences await you.\n\nIn addition, WildXR now offers a library of short films and documentaries, including wildlife adventures following world-renowned veterinary teams and conservation stories.\n\nWildXR consistently releases fresh virtual reality experiences and educational content, providing an ever-changing and captivating gateway to the wonders of the natural world. \n\nIn this latest update, we\u2019ve streamlined the user interface and enhanced the ability to watch and enjoy the experiences in non-internet-connected environments.", "short_description": "Featuring more than 150 species filmed in 360\u00b0 virtual reality, WildXR allows you to encounter exciting and rare animals from all around the world. Enrich your knowledge of Earth\u2019s remarkable wildlife through animal encounters, short documentaries, and wild rides. In this latest update, we\u2019ve streamlined the user interface and enhanced the ability to watch and enjoy experiences in non-internet-connected environments.  Check the app often, as new content is added weekly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wildlifeprotectionsolutions.org/wildxr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wildlife Protection Solutions", "support_website_url": null, "website_url": "https://wildlifeprotectionsolutions.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10028153320638500"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982722_1924892807871177_7948343363858534153_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwDAfbpCgVEQ7kNvwGKePO3&_nc_oc=AdoolZ53gngbK8sfiphrI-xDC7yr4RCThc3PYBmLmHuY1LP-MlnK_RbFtY3gRuSxcVQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5Ugoq_pkAl9LsF8Sbk0kxfN3nsp2DT54sXgwWcwuCDg&oe=6B0859D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "WildXR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1668616320, "lastR
BHE1&_nc_oc=Adppn9K116i8_cPUpTyNueZJ8g_nCX_IL0L0R9vbzJAVzs81mNt_3Cjq7uir2OLNACo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVP8__1IM2uN_2pl4QFfqbQdaEn59yp4SO3KPHa0b7H2A&oe=6B1046D0"}, {"file_name": "Meta Quest Screenshot - 2.png", "id": "954971382620839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622024_954971389287505_3695925960083280134_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2aO8qFgm5AQ7kNvwFPUSO-&_nc_oc=AdpB5aG7H64xj4elltAg8bdfN_mziFJxBtnaQqU5s82g8sx9UFvCoT2TJYmRmr5R4Cg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU4mwfYJSj2RhuaXU36p39C_xl0wVFmPg-bfkFD7WHSOA&oe=6B106978"}, {"file_name": "Meta Quest Screenshot - 3.png", "id": "209909248601450", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031571_209909251934783_916183043909806198_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjN8rv8PRZIQ7kNvwFcIj4i&_nc_oc=AdqN3v1dr2-1rHuWnlwDsT_7V9iCBMQLsH9pgGM3ouQfnGH5PD7CTXkJX-Fxmoz3AWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUDc3On6tmZiGmROzYKght76TocmXg_k1SCGJa7ZhKF3w&oe=6B10651F"}, {"file_name": "Meta Quest Screenshot - 4.png", "id": "261846916502400", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001664_261846919835733_9001348606434030919_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4_fR1IQI1YQ7kNvwFFbxZo&_nc_oc=Adq6Q9REz2ceTgCMZU4yl8diqi2WQK4QQkfcdDRK5u9wHSQkw0Ves9u-P8mgUxKGJmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXh6ZDB4TiYYBrpGI-cZj6kNOlAA2IIg4I8dH38SczTEQ&oe=6B103E22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WildXR - Trailer Landscape.png", "id": "3533980690181946", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974535_3533980693515279_7459242962070103796_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzBNZbYaZYEQ7kNvwGgK0LB&_nc_oc=AdqG9cS4E6OK4VcACq8Oy4RmhhR_-clL8m9IwiY1o6S6vZF2ga7pbXgU-DdTFY5zk9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUjjo2gmCCUqKPeyjaByy4FUHVP4JVtT1BI93WIiWiZXA&oe=6B104AE0"}, "display_name": "WildXR", "keywords": [], "long_description": "Explore the natural world in a whole new way with WildXR, the immersive virtual reality app that brings the planet's most thrilling wildlife experiences to your fingertips. Dive into an unparalleled adventure where you are in control, witnessing wildlife encounters at your own pace, from wherever you are.\n\nWildXR is more than just an app - it\u2019s a gateway into the heart of the world\u2019s most diverse ecosystems. Get splashed by elephants as they wallow in African water holes. Marvel at the captivating dance of birds of paradise in the jungles of Southeast Asia. Watch in awe as spider monkeys swing through the jungle with ease, or witness endangered green sea turtles visiting \u201ccleaning stations\u201d in the deep oceans. These and many other experiences await you.\n\nIn addition, WildXR now offers a library of short films and documentaries, including wildlife adventures following world-renowned veterinary teams and conservation stories.\n\nWildXR consistently releases fresh virtual reality experiences and educational content, providing an ever-changing and captivating gateway to the wonders of the natural world. \n\nIn this latest update, we\u2019ve streamlined the user interface and enhanced the ability to watch and enjoy the experiences in non-internet-connected environments.", "short_description": "Featuring more than 150 species filmed in 360\u00b0 virtual reality, WildXR allows you to encounter exciting and rare animals from all around the world. Enrich your knowledge of Earth\u2019s remarkable wildlife through animal encounters, short documentaries, and wild rides. In this latest update, we\u2019ve streamlined the user interface and enhanced the ability to watch and enjoy experiences in non-internet-connected environments.  Check the app often, as new content is added weekly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wildlifeprotectionsolutions.org/wildxr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wildlife Protection Solutions", "support_website_url": null, "website_url": "https://wildlifeprotectionsolutions.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10028153320638500"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982722_1924892807871177_7948343363858534153_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yMOcaxX09sQ7kNvwElhBXN&_nc_oc=Ado2Fo1Cwz89RTjWLWW_PUzFOH_0VqQvPemYQnNtL5M36hU6Ff2B0a2uCirLAGpGfmY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXZ6MDsNVV72qtbEEWMdd_TRBe3UBKMPD0I5goN7Ailvg&oe=6B1042D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "WildXR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1668616320, "lastR
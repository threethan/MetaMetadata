m6IW&_nc_oc=AdpeMZ10AqCmr75IrvB9lk8MYKFP3ncBaPgFCvcx3ZKj9XwAhHG295g-6PzlqNPY2Uc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3M8Egbw6SY9a4Cuq4BnzBbT1jdKx6yseUwWKseSQi4g&oe=6B070C50"}, {"file_name": "Meta Quest Screenshot - 2.png", "id": "954971382620839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75622024_954971389287505_3695925960083280134_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2ee72cftSoQ7kNvwG3KpyX&_nc_oc=Adr6aJZW_RJvov3dt1jeBWnU8CD6PmrSV0D0sGQJFWQjoRQ-CQsAlv7f6BWyEQ0L1Vs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvbKg4bu3B0N3M73noGsDLcztu1PJjkVx8zKvbR9UhXg&oe=6B06F6B8"}, {"file_name": "Meta Quest Screenshot - 3.png", "id": "209909248601450", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031571_209909251934783_916183043909806198_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a96O6fKlzCYQ7kNvwHDJZaU&_nc_oc=AdqbLQxhnG-encgFYJGFB1Rebu67mQeP7g2qIpm7aik38DRjpe2-Khtp7hGpxCNZpBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTOka70EJaDFnHSiCXn31K8q-2A1GrWlS35oEhYVAs4g&oe=6B072A9F"}, {"file_name": "Meta Quest Screenshot - 4.png", "id": "261846916502400", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001664_261846919835733_9001348606434030919_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQPDWUwhJloQ7kNvwGDe33K&_nc_oc=Adr0uTF3ufn1j_U-FXhbgtci7AZO9Gu4zxasTIPwJ2ANK8ROgWsNcou5Uopab1TIQZw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSET6mknwVwGrMdJvVB0-1pnAhU3Ze8ztcexGhs54i7vQ&oe=6B0703A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WildXR - Trailer Landscape.png", "id": "3533980690181946", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974535_3533980693515279_7459242962070103796_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-IJE86sAqcQ7kNvwE74QV7&_nc_oc=Adow2q7SIlXKLwsEJ3ebd7a7xRUQDnydMfZstGn7FKJTJj9qVJm3hGuAXS8r8_IxKS0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjvGQAY2lH3mS96vJbyXBx-66BjQv2OWSnoFTzA7qI4Q&oe=6B071060"}, "display_name": "WildXR", "keywords": [], "long_description": "Explore the natural world in a whole new way with WildXR, the immersive virtual reality app that brings the planet's most thrilling wildlife experiences to your fingertips. Dive into an unparalleled adventure where you are in control, witnessing wildlife encounters at your own pace, from wherever you are.\n\nWildXR is more than just an app - it\u2019s a gateway into the heart of the world\u2019s most diverse ecosystems. Get splashed by elephants as they wallow in African water holes. Marvel at the captivating dance of birds of paradise in the jungles of Southeast Asia. Watch in awe as spider monkeys swing through the jungle with ease, or witness endangered green sea turtles visiting \u201ccleaning stations\u201d in the deep oceans. These and many other experiences await you.\n\nIn addition, WildXR now offers a library of short films and documentaries, including wildlife adventures following world-renowned veterinary teams and conservation stories.\n\nWildXR consistently releases fresh virtual reality experiences and educational content, providing an ever-changing and captivating gateway to the wonders of the natural world. \n\nIn this latest update, we\u2019ve streamlined the user interface and enhanced the ability to watch and enjoy the experiences in non-internet-connected environments.", "short_description": "Featuring more than 150 species filmed in 360\u00b0 virtual reality, WildXR allows you to encounter exciting and rare animals from all around the world. Enrich your knowledge of Earth\u2019s remarkable wildlife through animal encounters, short documentaries, and wild rides. In this latest update, we\u2019ve streamlined the user interface and enhanced the ability to watch and enjoy experiences in non-internet-connected environments.  Check the app often, as new content is added weekly."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wildlifeprotectionsolutions.org/wildxr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wildlife Protection Solutions", "support_website_url": null, "website_url": "https://wildlifeprotectionsolutions.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10028153320638500"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982722_1924892807871177_7948343363858534153_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwDAfbpCgVEQ7kNvwGZ6pJW&_nc_oc=Adpa7_Ehzf8mrpQPOAZX28zSzWAnvIcSy6Mpm3qEihJSYqmQit5jybUv1rSv7Wkjp6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx1guG84yftI1yLuKgScDEzG7O0QzMCVnbGP0HmlkhYw&oe=6B070850"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "WildXR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1668616320, "lastR
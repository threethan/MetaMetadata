1_239301091424644_958811503937053888_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr0EYulB2o0Q7kNvwHR3fe_&_nc_oc=Adl5EY4axDLA2N5d7aEOByY035-mGTd7T8qqspZTRtL4W6NB5af2MetC4tsh2MwGAyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsgUCnU3zArHG_AYaZGO0e7QdMoYmJff0l_vkReqSw4og&oe=69A6CF36"}, "display_name": "Electronic Universe", "keywords": [], "long_description": "Electronic Universe is a complete electronic musical shooter game.\nThe worlds were designed to fit with the electronic music created specifically for the game.\n- 3 Levels of difficulty (Easy, Medium, Hard).\n- 6 Fantasy Musical Worlds.\n- Shoot the obstacles to keep going on the game levels.\n- Charge your weapon with ammo that you find over the levels to be stronger.\n- Use your powers to destroy more obstacles at the same time.\n- Enjoy electronic music and rythmic decorations of the game.", "short_description": "Prepare yourself to shoot obstacles across a electronic musical game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://edu2019sanchezde.wixsite.com/website/politica-de-privacidad", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://edu2019sanchezde.wixsite.com/website", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "721988388754920
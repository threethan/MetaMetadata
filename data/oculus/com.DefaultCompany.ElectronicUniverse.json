dn.com/v/t64.5771-25/38974531_239301091424644_958811503937053888_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__VZkHr9Ei8Q7kNvwFoolzQ&_nc_oc=AdoJkXah2UCNKlsA3gNO57olsrgbFAtz8UwOdZTE-ZPl2Ggt69dFtWrW_a19dyVg2Bc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79L0yiYew5edxcJwYby9CCbFxDL3ONxkw4d0oVX4Mg3A&oe=6A11D0F6"}, "display_name": "Electronic Universe", "keywords": [], "long_description": "Electronic Universe is a complete electronic musical shooter game.\nThe worlds were designed to fit with the electronic music created specifically for the game.\n- 3 Levels of difficulty (Easy, Medium, Hard).\n- 6 Fantasy Musical Worlds.\n- Shoot the obstacles to keep going on the game levels.\n- Charge your weapon with ammo that you find over the levels to be stronger.\n- Use your powers to destroy more obstacles at the same time.\n- Enjoy electronic music and rythmic decorations of the game.", "short_description": "Prepare yourself to shoot obstacles across a electronic musical game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supp
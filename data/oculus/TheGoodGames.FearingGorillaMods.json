11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2wPf5OTF3wQ7kNvwF0KSnd&_nc_oc=Adr7dkyUWcJmjIHUOANg7u7v_fiLezuYAwWh5JzQubxIMnpPosxxnjnUTeDzlP-ZRek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fJ_wsO1Mq-XZj58tPcW8S2KlBIwhG8IzBo5fh4Emb9Q&oe=6A2AD24E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wW03uta4FAQ7kNvwFJSeG_&_nc_oc=AdqlSHXV_bo0NsJRysH7FAmBjUG7BlS0W9k30_BAkq6BmdaM_FBqvwyefPUKAjDsdH4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0K8c7PX80DWB5OPn0jVtKHbmLpc-tHm6CvsKA7FyiHQ&oe=6A2ACEBC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=273zj3-xfrQQ7kNvwFeey9O&_nc_oc=AdpU8M3ld6x711KT3vQcCN_gZSg7zvx1Kix0lNFeKA1OAZ8jP0ynmK4JQoSkilfC5Mk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gNN8DI5x8v6mxruz3HSCjgpW3EUT_FAMn8VHMcsHFIw&oe=6A2AD48F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
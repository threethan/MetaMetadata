11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veMLUe9mkdQQ7kNvwFQ2T2Y&_nc_oc=AdozdVRTjeI4GCYPQWuC4oOPHeHyFKLfjcqo5nrYAt4p6j0N6ULHRAHRLtens8t6waI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkNmxxZZN5Zz0_kaJI_xRhxJgBONWcQ-K2bO_MWv-u4g&oe=6A4E6ACE"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNNu-8UbrAQQ7kNvwEQRvG7&_nc_oc=AdpNJs5ysrtU7kNmzZ9CGRhNtvWASd4dLs2Yqf0byLsmgH3Fb-VZYPaMPIFIBz0pE2A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFZyeJ0koHc2KbAWZ8mNzzCgkoekFV1TwJq0onh1h9lA&oe=6A4E673C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9MNm34nwIUQ7kNvwF5fQ3D&_nc_oc=AdqcTsKx_MSm50BmaIGDBoPGagwkhUwxKXZhLJSTu6ASCRJUhqI0pC2vlobg3zN8Jy8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrdIpxryBJNcjb1mTsr2Cawxq51gGNQ_IOqr-Wf7hpJQ&oe=6A4E6D0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
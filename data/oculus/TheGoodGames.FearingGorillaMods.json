11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bXE5-3JbRQQ7kNvwEpq4fj&_nc_oc=AdrTtrFrWwcWwZhx3gE5vV7pcPKeFaW1MJ0BYgQyerderLWv_NSH_V4uHmYtgzo6Z7w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6bQiIk9k4O4RA1PHiGJddEI1dsVucaNf2Mxh0vdFtXQ&oe=6A60A78E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za0B_VR639MQ7kNvwGj_khF&_nc_oc=AdoMUGAr7BpG2slmk8bRqgZ1rw4j1y8_-TYKIzQ7ch6MejhUSlULSqWUG-yAncSme10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlDG5IRxFkqKgzdxCi_EIA9jji8Vw2NnlasutE1gX4Lg&oe=6A60A3FC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RC1jQFz6sBgQ7kNvwGrTPVD&_nc_oc=AdpO0dcoACoNIxPJEbKfUMGuZzqWBFZcDbksAGi5ypPjgIDSv_-T1FcLlqUIdEh1_1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7tQkVnktlUa0fUlEzpsVY1qCAISPZYq4EEiYSiD81Xw&oe=6A60A9CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
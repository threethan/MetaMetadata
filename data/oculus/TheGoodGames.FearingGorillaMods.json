11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUzIKqXigeAQ7kNvwF0Qfa1&_nc_oc=AdoRwWaluSoPXWrjQvkH1nrSEzHzFPzSpCGG2BugtHkLNrtbEg2fbf3zZa8nfpm-GDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTvMfBB_OHydpswOkU02SI-S0tGxY0IA70bzCa57LW0w&oe=6A525F4E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VXQ2MG4ePAQ7kNvwHzpCnS&_nc_oc=AdpVCAD91ccbPU-ogX7QHZeU3OkvUYk8n821khNI9wpsoAvqnuY2B02RWqMOm88bddQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCug7E5LyhwVwh_WnlbrDhO3xlo307Has5FrzKbDapzaw&oe=6A525BBC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x32UdddvoyMQ7kNvwG6SZkj&_nc_oc=AdpTGNGdpyT12GFPRZ8bUSdPEXTF-AQvjOxHsr54NszpRl8T1PQ4dw2x_ado9Mj6dao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCy6OjpiO1GDyB0MaUEH3cKNmsAxtAdTLtv0DU1PhXqTA&oe=6A52618F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
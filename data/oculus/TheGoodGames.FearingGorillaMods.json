11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYprP6kZH68Q7kNvwGz6sti&_nc_oc=AdpxxjUAjmGnyux8hN8dYOlz0Hoz6EtZZJoFDj7kUX-bXaP3awXZm7cdePjLf-MMlgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_yieTKj8twcOGgHQeYNTJZAwanpCntsDXX5ctJAAh0A&oe=6A38014E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYPOd74JGrcQ7kNvwF19tXY&_nc_oc=AdqjxkqNMSMWEZInJ2-bqxtXkm-wItJoCdHPvDRWeUflKqk3hv8FLsVdLVl3XHca8as&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BLjw3lo4qaZXPyNyw3UY58LigQZgZ5NHxpiEIQMKRZg&oe=6A37FDBC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJIgjYH3SD4Q7kNvwG5qZdP&_nc_oc=AdpTcVaOb7_Mk1gdvzZQo4e8l-uAhzhnHQxBwJ0IrRYDWrxnQF2K-ib7xkyKZGdty28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9T5IzS8_K3hevq8oQJY2fiM1e3-6du_3m7UlY8N-mZDg&oe=6A38038F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
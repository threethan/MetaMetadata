11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd5VdPhvynoQ7kNvwGUDxpP&_nc_oc=AdpBecy6HbInFoa-SdMSdFLahVefTfPMrYO9S3AJEsAEDJmIHPNFxu-4VB2Wn0YZKm8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWJ67646UYkMlG-qpQUZdl0pjOT_MGrX5FWwtu65aWww&oe=6A68908E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URqhNMrwwGwQ7kNvwG6nN4J&_nc_oc=Adp6prtwwmphw9MZlJO8doSQm7n5aHhwl9oEo_JxmFSVXZ7GyMSoFkweY7MtNzT-gS4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiP0EajLbwHY5D-ldma-9-BQdLiLcalg5JzQKczCYMxA&oe=6A68C53C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=842y68bSSjIQ7kNvwGU9Jta&_nc_oc=AdrqdsIB_VpmcOZ72eDpHIKcaGXNnFXDpvNppaBY6cPk5WJPHhOMOS_8uq-oSynkrVk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_peVA4Z2cV11kZR3yGntL5ExDLiCHC6D0czA_yNnJQA&oe=6A6892CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okASuKrAdBQQ7kNvwG-e--d&_nc_oc=Adofov7WsyqGdRjEcLYbCxaIlRyb6mlO6H0aspuAYzriYdjO1tYs6eUHfnE85IeZlCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA80lJlHySD1KlxfioQugnIzyWryroKDhiGQna0YEWFA&oe=6A5E048E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za0B_VR639MQ7kNvwFNX6Ae&_nc_oc=Adqb_2axLWDo9OemeAJuzJhG39ymhqweP698MOIz6LUh1vccsLjJQlhuNmumEqdk6Po&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-7NOeBLmNrqOTIsSQ-Kj9qGDb_tpneRCS0SZkhuAT8g&oe=6A5E393C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z33KAF6E1iYQ7kNvwHkqsWu&_nc_oc=Adq-S6OOy1Je33zaiKi3XAds7L0dIwB4Agb2gURjzQWTxGG-4dDCqEQESBz6un7lqx8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDG7kDRoCVwS4MvpBLbFXwxBto6MBwrppQftufjIUIfUg&oe=6A5E06CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
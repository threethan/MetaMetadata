11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcLSTnO3haYQ7kNvwEXK3nB&_nc_oc=AdowC8IjqZcUkJWDPOYZBqTQZnchNxhGq1jBC6TlUQh_rElqYaONGFUw_g8GQG9i5Ac&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pm3UDckxZN0WUGkPeDswQnhy4AV1axPGuwccfSTxCVQ&oe=6A13174E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsV64ER3el4Q7kNvwEgeMrq&_nc_oc=Adq7iuesOI1BYvgSFuMGYm5cG3XJjzzhfdxZ3R3zwVa_wo7xNcJgqqrjx0sGxOO8MF4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6684owsdz78Zc-PRJSsDYJSym5DIjTPgmXHjbmlqFUkA&oe=6A1313BC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=482e-Ph30TwQ7kNvwGjcmst&_nc_oc=Adoip-RRKuCgKFYUg6eVx5x84ahoSqsBsqFbdLbKKgymuHQ4mciwHd9UZ8-bnElTNp8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qqwYUIIVSGzTr75ibQwBjkSPn1tsuD8h7KvySnt4u8Q&oe=6A13198F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
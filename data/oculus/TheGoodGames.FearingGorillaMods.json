11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ag8akS0BewEQ7kNvwEb_m0R&_nc_oc=AdprjuI2QIRSsLt6cWNJJgysj7wJvmq0_ltpBMnsUzmY418zVTHTkr9LpQpGl0ChVCU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ofTa99q6E2xHBbr1xDnD_RtI302FpbZ8rMAZO5vsLTA&oe=6A340CCE"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnhMb0hz-1sQ7kNvwF_BDrL&_nc_oc=AdrQ5g4R0NDeusNzkJPZaBNy9nWvxNFI9pTkBgvif4mX_h1xLHKDc7H_Ze4NHqgntY8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l4VZq_lzBz90a7Q6H7YOynGJ7NX2kPzk0SnMSGA_l4A&oe=6A34093C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02uqJkpqPKEQ7kNvwF6oO9V&_nc_oc=AdrN_e5RiFHi9gM1WjIp2atca-m9gXFfoM-kADXuPF4lJMLAD5Zoce5v8IwDS1KSM-Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xmLgeJPjLTwb43aApyUeP_SvQPDnSvRY1Ub4dniaeDQ&oe=6A340F0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
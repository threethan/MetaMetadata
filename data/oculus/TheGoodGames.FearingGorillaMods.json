11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py_JVM4mr2UQ7kNvwEMS32C&_nc_oc=Adq0p-Z9q6sX7wLL_JFHcacYMMwcqy4wr2sMSTWeolz1NUfNqr_ERw1sQgY2JhM0BxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwX_g5_x4eIfa4KPBlRq-J8-f8ynngQTuE1P7nDpANUA&oe=6A6DD68E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umT_ysJc11sQ7kNvwFxXlpo&_nc_oc=AdpTcG_s0wadlSWiz1DCz0-Ys337g6JJfvxYYsTW1tvPITGzMyTxKLAyBrWv1sxvFQw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc3LuZVxvAHJqeleBBPgA1xaqVPGqD1KOaGR6F5mWqxQ&oe=6A6DD2FC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOmOhqoNEtIQ7kNvwHyMzU-&_nc_oc=AdpQfMHae7AoroBMoDX8HzHYPPE3qib56OtJrsleo_lC7JUxXf8YRxVfP-sUSq2BdzU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYpHSTS39KUNNfVitf8yQv_95k-zx6w-b1u975IMBrSw&oe=6A6DD8CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
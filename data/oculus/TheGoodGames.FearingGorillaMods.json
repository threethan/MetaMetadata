11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQsQbz45wOEQ7kNvwEFio2n&_nc_oc=Adoc2lSS-T3b1QXFY0QUj3MEjd7A9qfnHG7kAckorC8HEhsyrMFoGi305X7G76yy3O8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y0tsqBT2YyAd57Uv7LydgP7-FMFSK3aJTXgS8v3E1vQ&oe=6A43DECE"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FVlIVutvWIQ7kNvwFY90Jt&_nc_oc=AdqQOzlT773kwKfGSYxvO-UlWaQmI2Nl0SVqA0e0kRYM_-zlxhOW8-NNVETOJXukh_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hFl-yVBYizui0ktmoCshHGCYgayLfqX5DelbMWTqEsg&oe=6A43DB3C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8dae1Ffhm4Q7kNvwF3ujhf&_nc_oc=Adp3gqV62641SO76-d8lhU2Ff15dLfE_eZpJKKksbe81mZaE6mlriOx1G2SThA6t-Oo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GCbojkE6Q7nWk_ENfasul1Zpf4cVmSOeuCDqaBua8gw&oe=6A43E10F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
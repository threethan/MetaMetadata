11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBsy3c2bGkkQ7kNvwGfqw3b&_nc_oc=AdoNSf0sIh2GzavFN3LVWTXeCOxOUrEHd_dcfymM3JJRnmyaqsWlRgfGqdOz-Ddo6bQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PrVexWRCIRPkJyeiL9PlHGcpyp0SKCafA7iVC5IqKNw&oe=6A1B004E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Nd07ly5AbMQ7kNvwFDn9XI&_nc_oc=Adouo5cSygudu4lcB116J0s-E2sfvQxAiVFEPbU4tRTgasq5UoWMe-bZoIuU6pecB4Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4go6DvXxideQV1pErCokfPnS_fZP6j06ykp8l6ufnZ4g&oe=6A1AFCBC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mr1iJ2eL-tkQ7kNvwG6CH8K&_nc_oc=AdpCAuPMFp2q4v_6Ofb94Vk-UOAtKZZACRanox1Cg7OS-RSDoArH4SPK0CcJa3XiKJ8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jcmC6n5Kx82Bg_-QfO2iRs0IORDVKc7xBxQwtzue6Kw&oe=6A1B028F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
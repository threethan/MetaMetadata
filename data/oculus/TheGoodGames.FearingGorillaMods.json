11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sad4MIiDNuIQ7kNvwHlqwu3&_nc_oc=Ado0FcJXk4zevWT4cBrsw9Kb_KnXeg0CUFp4Qe7-FOTZFSZEnFOorTcJUfdTwfy-VVk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-9P9Asg2xs4UjHgMjo-sK2PpY56gHCXhqQtpZRKkGgA&oe=6A1C51CE"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Nd07ly5AbMQ7kNvwGTp2Sx&_nc_oc=AdqQx7OH-HsViARJH_9bZP9BqlUQQy_A02LPOdKLsmggROl5XiaMr5fAhuLiLdhck8A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62tsii-N11r8UC6qbm6rHZAbD0WPFWPWWdpmPdowuPEw&oe=6A1C4E3C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkDTa74Z95IQ7kNvwGoxCBQ&_nc_oc=AdoXrrUj0rCNq8onfhXi3zKR8KyUFoVIK4o2pp_jUA7pAoYIWRLOpQtdI5zKw7OkjD4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78CN_v6Gs_UlhfvOsF_qIxTVQHv3-Dt6uvDIAxx8eCYQ&oe=6A1C540F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l67c8GXIuV8Q7kNvwHdiFWr&_nc_oc=AdpEyI6i7tOng3EWucsuaIkECRcK08HM6NpvYKPFMU_WiSlhh-6r1jXyJlvz-W8Ebww&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_NhhOtLJvvCYUGHDlOhKnCzaSryDk6Yec-GjT0zHBXw&oe=6A6F280E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umT_ysJc11sQ7kNvwG--Dt5&_nc_oc=AdpuE5KwHjaGkwHOoGCTJPPxOaVqX0-WJRXkDn6AUC7DZWBdWw1Z366tYYcc0gBamI0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZDoO8Q1Ity-Q6Xg__PVvwZjts_bZzWFvnRgzHcEei5Q&oe=6A6F5CBC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIrFOC_bsVQQ7kNvwEYrPyg&_nc_oc=AdoB7fSaXvnWaFSg_OIhbffJ8irW4htK2MqnuUd-J4dwDYyBHkjREKKHVxKNcsYi-Bg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUqHrXL_RK52muDRPuSf04n1WkRs-VMUNerWQciMsC_Q&oe=6A6F2A4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf8u-WCUpWQQ7kNvwGIk5y8&_nc_oc=AdolDQdYjNJnWp_UWvPe-78kMzt1xnHAor-iIqwxLnBGgZ0XH7GironZfrlVBf7ap2Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnQIp5pGNBRosBUUlzn-ecM7xU9IXoI3E3JHjt-iYUCg&oe=6A5A484E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSzfcM71TN8Q7kNvwGcQL0d&_nc_oc=AdoSioDaUj-XK_YimX2gZDbbqV3E4TWzDccjfoHrJdAP9uHkqGrh0wqoHbg_X4tQe0U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBleO8zjWtMmu7zZjuU7ylCXk1HBpv06RAGnz59os_fOg&oe=6A5A44BC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJbE9__xJzEQ7kNvwF39UXS&_nc_oc=AdpP3Wi-zVF24Oo6lhtTHr6dYDRYmdgaboz24Y6lhGLqSQfr4YkmtxBYqSpRnvgGI6o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuwN6RYoywOxbcXTeEzxGJ3Hs4bMfVjMuIqsJtCGBDSQ&oe=6A5A124F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2wPf5OTF3wQ7kNvwG2-yOk&_nc_oc=Adri0-_i7juHMStL_rUmH_i0KoglQ8lck7eN-0YUfp-bdQW6f4zr_E330dG7XRtnfPE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N4vOAodj25x_VSe-KO0Xs701e7O8K-NwdZE2HS6qU4w&oe=6A282F4E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58f7yesEXL4Q7kNvwH106vJ&_nc_oc=AdqRF_975xigabYlhN0wLLVJGSeVGiySFKmOFudzZTFz3NILSs-VHNVMmMCose9hqRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gpre2ZZtlG4dAI13NTKA9pCj5PZZjKs-QcPsCnQkG4A&oe=6A282BBC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=273zj3-xfrQQ7kNvwFsLLx4&_nc_oc=AdoY2UXntogTQNJ1li155a1l9c8wGnwSPX3RQBFkbvD6kdurDY3BoNH4H6zPdUhaK2c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81P9JhzOyKQI-spOKmhzMMb7tl0VBxZlTHmeX176zyRA&oe=6A28318F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
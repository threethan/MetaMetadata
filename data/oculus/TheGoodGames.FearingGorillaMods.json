11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8Gqj5n1-G8Q7kNvwENBkdr&_nc_oc=AdoOfG4ckjCbrbM0MKBXr4R6SRJsBgYbPxoP1r7AhYzcT6FoeWjcVedLn6d5_Avb6IM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vLRqIxIdnrhBpxk1fdo7nAur9j4TEMLQaboTP9vvAYQ&oe=6A15BA4E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsV64ER3el4Q7kNvwGHr_Cg&_nc_oc=Adq_s7naEv3tJqOUGJb9gUM9c_xzeCt71wiAxh-SqWds2Z5nM0aEKAJUk-X9he1Jpnc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-wviZDpquNQKac6JsJuR1txEgjLqnGtaYurGDd0HPkw&oe=6A15B6BC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKTW7fC8N8UQ7kNvwHDXb2H&_nc_oc=AdpIN3rYy0ZX6V-usDsoA6Aa6qUiQK7dJJD2H6Xzeq8CexU9RB_5ryeRJjjr1jW58dY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7akY5i21dFmnfB-1HUxh14BChs94BqNPYFIAofy8CZTA&oe=6A15BC8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
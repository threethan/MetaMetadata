11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wf8u-WCUpWQQ7kNvwFlUUPn&_nc_oc=Adpy2EpVfukfJ2WnZ6WOe1aP51NazUcr0cSG6-Y8eJj7tVgiTsjqk3th3CO0z-6WRKY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALZff6kIflhnq3tFAJ7Xz_7pEHNLajaN7waczRF4_XUA&oe=6A58F6CE"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IBeYxzEdKwQ7kNvwF25pMq&_nc_oc=AdrEQOOGqT2YRdtuOw50oqITPUxOSzERZVeT0Qo15oqNS6uVVCC6XXnQ5acHYRF_XOg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiZlWKItoeBz5EONRkXgx6OuaJ22b5_VDSPl16HRXCSQ&oe=6A58F33C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJbE9__xJzEQ7kNvwFobnCo&_nc_oc=Adr_O8iw0FelngRvZzECuaT-Y1uud-q_n7i2ys6fLE-3FZYW3wp-2ue33fe_grkjoVI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCq1Jy8u5X3Fna8G4RysuCWedzzlx2hW77Cq06ugoRxfQ&oe=6A58C0CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
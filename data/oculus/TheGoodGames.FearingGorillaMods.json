11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lk82dh2VjkAQ7kNvwHsuYw0&_nc_oc=AdqFJmVZsQEmoN_DYYpg8L_vqj5gzPUfJBOuo8paXTdrCnArJSfiAu3lizKt1OwDWH4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6teIPYpdwo4v9cGSRoLV-iCEdzFLZCiwFNQWEubnSTwA&oe=6A09DCCE"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol5rUNFoCsUQ7kNvwG77Co8&_nc_oc=AdqSWc28dfrQsgiHgeZ7VvDvDXfMu_SwBQ5OfN_J4kN3cQLKGmbIQV110LXB0c3FXD4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JlpZUzJ4ai4G6GX8qQ2OarzOplcD3jaShCekK8w56Ug&oe=6A09D93C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5zYYFRm4dYQ7kNvwF_K5JK&_nc_oc=AdrzKa5fGQICOYvqTPa9r3_mbj2DzocxicTC1RxZ3HQ9OxxmfnfADnkHXRrzTQJ90QQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tvskfTSPzhsHQzk-6FnHS3z2ZWRzq6_OjNxG2t1u_Tw&oe=6A09DF0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBsy3c2bGkkQ7kNvwEn86hi&_nc_oc=Adr3O9JoRLxG8NFGN0z5T9voWPQFDt_VloTfKbmv-yNvIU2afgaP1z-9X45b0qzHVLM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50uuJQCtRS97UxJzEIFK4lU5L_5XMopYsXJ3Uwxw8P8w&oe=6A19AECE"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZ2y6nb_d04Q7kNvwH1j8X_&_nc_oc=AdpksnfPEWfGdgRj5ah_PkABz0lCVa9Q4mnJz5R1O-sItIn7FTxytj8SEse3OWpRARo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67sqehmz6kefhEm7EHeuekJ4yz4Bc0vskfW4ui_V22EA&oe=6A19AB3C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mr1iJ2eL-tkQ7kNvwE_vrLA&_nc_oc=AdrkXab_XbOIwcRWMGu4khgdBrgziQ9JZaD44gJOb6I2IaIV4uw2E_yUXLjC95jKHhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7II14aj8Y031L1Zm1WwcIsAb3kcj_Br8oZu9etwznsEQ&oe=6A19B10F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
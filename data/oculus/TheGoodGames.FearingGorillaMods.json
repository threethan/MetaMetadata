11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uk9wpO5oAOEQ7kNvwEZ4iET&_nc_oc=Ado9uoFgRBBZmmlOqXfgoKFCnbtCyf5vY5dLqaTmkUeAPo16yDLC6DAVC6Wio5ZwwCk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SqbZOduMoeUjdsyp0yZd88UL50YnEx9eXsHUaRrujCw&oe=6A26DDCE"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58f7yesEXL4Q7kNvwG5KCr0&_nc_oc=Adreh-EnXYN552ysL607zG38hGu4z2eIqvoB7HZUj2SOBPhKt2hKof27ATdHkbTCVdc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Zqqe2ReVZRSKRCay2aQUPK8yeyyR2Pl1dmIJa_xSo8A&oe=6A26DA3C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3VBnbIQioIQ7kNvwHmzxQd&_nc_oc=AdpOQ1wJc284VynxILgdrUvTjVI9CbuHbFgphUnRs0TtdMaPtVe9qm0EzpwR4dI6rWM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Xb0yCQcJ-kjBsDmg_0HBp2kqXr9dZNJt--76xrY2yBA&oe=6A26E00F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
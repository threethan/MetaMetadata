11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf8ahgVyXWcQ7kNvwECDaeF&_nc_oc=Adqipi-EK0mXYR11rzYaizR2-s7epFAoyzyOmSi5FwwwRBASzlHkvPPRh9rR8ThSt0g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8be-qZ87TT55Zuzaj5J9bkArZRGAXJRdnqLx7CdG-zmg&oe=6A3D474E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cd6WkXK7HwQ7kNvwHCslkW&_nc_oc=Adr6qFgnkr5vFB_K995UJOnkrQ1R4snukzD04faaE7tn2tT0mYC0CRFQhnVqRT-UcKY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85l_dneuVZIgJaUuGbAbhf2aza8NgNGWcfaGbGEGPM7Q&oe=6A3D43BC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkPahxsZaSQQ7kNvwHZWcOJ&_nc_oc=AdrQK1x6FOsg2pgmhtsrPR9bJmANHYp7yXZWvrUoGDjppCZI9CBfzLqA_jqCT6cdjXE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zUoT8Pm6OxmVV0YQX9llCbmKB-Uz6WWd_uKuvOi3O4A&oe=6A3D498F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
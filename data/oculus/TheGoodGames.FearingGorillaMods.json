11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd5VdPhvynoQ7kNvwFHHso9&_nc_oc=Ado6okL8Zns8oscT6iPLvkce2aL6uCEc3atMTnVBgSlrv4or4KrY_Iy_WwFmvO9b4cw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq4PLx_TgRNyeGIgPe7JYnf15NXKBVeqiyzw21yr7d7Q&oe=6A69E20E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHowmdmdF7YQ7kNvwEx0uzY&_nc_oc=Adr457QnpOQ_bJk7_PSXF-PB-QA5tcYsfjnIzfUzmmQbSfdozgrlBbQeii0Q5cMnOg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-YUAUKGT5GgB-qBQr9ajuIofaErIG8TE3f2L1aiAo7A&oe=6A6A16BC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=842y68bSSjIQ7kNvwE9ZxX9&_nc_oc=AdqY6ByyqVo3SDSNPRhtAyY_vHMwdZs0NDOmgki46_loeWzv37v7_2e6bPjJbk0_-hg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmHAlLeIm6ClpZ_iGOnJ0UIdMongeQE7GBBpvFZMbt8w&oe=6A69E44F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOCBpZbGAlYQ7kNvwFgWkv7&_nc_oc=AdpllTT1PYVO0WrLQCVtdLADDpqhMZMYsHgS_UkKyrttrKTJthNX031Cm-j6YcJPmLk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CLNjpPZG3WhGQ7Rit1tjsGFSse3ICa5nu8Czmm8HHbg&oe=6A2D754E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wW03uta4FAQ7kNvwGC5gLF&_nc_oc=AdpMbQsXKg7c0iL27pULmjN7gvZESvNbaR84RKwIv1RvxGFiD1YF9SO7zNvc1aHEf9g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MFAieIVZdCIDVbEkFLFZsGZSomvpnLwiRwJPXyO0VdA&oe=6A2D71BC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wi2LlenKmpUQ7kNvwGyHVBx&_nc_oc=Adr6qmp0LzwnU6fHvwOQzVYkEQp7fr1tCUKZJ2Tr30gbtfz-5Xn37_ls0QDDbZL0LJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hKi_KBnVzcDGmCMCibEUhjXTZkyOCGzaRI2eLSUlnDg&oe=6A2D778F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
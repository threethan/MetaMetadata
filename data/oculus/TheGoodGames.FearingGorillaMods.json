11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lk82dh2VjkAQ7kNvwFFxrP4&_nc_oc=Adr5Q6EfeYv_H4S5miAw80wicUWzU5GkQc-WoM4b0y9-9pTIO78YYzhF4FyOjUJwt_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60evpJGRi1qFBLpjl8j4UtO7jwCK1VUCS_FSRpqeJ3_A&oe=6A088B4E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol5rUNFoCsUQ7kNvwE_v208&_nc_oc=AdpflBN2XKMRYW4eKNSjgDuZlgz0huo6DpGkiAbKTY7LnQ00GYYYzhnFxt7YAvXONRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l6cUnDjXhCzbvgPpwdx0BrZo3T5pofwRftq1LL0h8jw&oe=6A0887BC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5zYYFRm4dYQ7kNvwG3AHQD&_nc_oc=Adq6RJMC4t3ttzs8rcVU2cf5Ur_QHbVZJzhUhp4zX09FvcW_3x2be8w24X3I6eU80AI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WsbFDh8RbvqnNypF6h4ZNbvzRUe6J5tq0kaWWsEpu6Q&oe=6A088D8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
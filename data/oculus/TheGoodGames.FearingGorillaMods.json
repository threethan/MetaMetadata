11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf8ahgVyXWcQ7kNvwHNxykh&_nc_oc=AdpVcDO5AoBdnEpcP9ZBt2SYRqw1t3V0-tI-e_llCwM24ZI8XrI2anNIxgP2YMI29y8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9la2fs9fJVbDVykmIscozi6H4sAImJABiph_aj6lrXNg&oe=6A3BF5CE"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cd6WkXK7HwQ7kNvwHJ-72o&_nc_oc=Adpcqqv-uQhq_zpE_586PAPYdUGZ9rHXr3yjJp2zVNbNF4GeenzNp4Jnbm1Vwu2K1jc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9T9IkHHE80hbZssYD86IsbQmpNzltxvwI5e3abRBx8vw&oe=6A3BF23C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkPahxsZaSQQ7kNvwHlzwbQ&_nc_oc=Adp09lwbIpfxvfecHIibdv6qzyUXZYGjw7wDUXh52iYLJxmyU5kM_1ObiKL6ZuY1-74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t0DMLdEFXgCyYZBr1UJRgsc_gxEKByOOZ5Tkmlkc3rg&oe=6A3BF80F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
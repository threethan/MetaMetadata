11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2wPf5OTF3wQ7kNvwHC8pot&_nc_oc=AdrtM0gQpKc0-In5SSuDun-nj2v5rKWVbg1ysDa2PnNL9GhXXYwCaF-r3Go505Za5po&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86LlPSPwmL0nyv_Cs0StH79Dif9tqbI6XKJzW3PF1Kng&oe=6A2980CE"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58f7yesEXL4Q7kNvwFsrTtJ&_nc_oc=AdqqJT3yQ7VkyS-eFR-NiesVfRZKC449__iQcn2tzDJATjc8VQhtBd-aIMAByS6aPK8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fSyRqlVzNVSgSiVF3d1sUGUqhMtO5cfsrvChfzcarew&oe=6A297D3C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=273zj3-xfrQQ7kNvwFzWVtL&_nc_oc=AdrY8uNplkkhJ0Y2v5VWYa8jwQuXK96GCjk6s2z4zyZt3sH6JXeg0aGoAK0-YHTwqkM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mJNWFJr7w_FZfHcEK5z5qNxnHvHJ3GhYYH64gGa4WJQ&oe=6A29830F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
39_920208467311529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQsQbz45wOEQ7kNvwHxtVWn&_nc_oc=Adqoz5rQoKBIzj3NKf1WJZJmXOlt10Cy6sFdUdpKYlN_gU-lSVgDQznZrvhyiAt-3Ls&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BNbxK8vxbtak92iSffjU0a3SPW7wzV0wi2rXY-A-4eQ&oe=6A4681CE"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UR6zP6nW5moQ7kNvwGYxDC9&_nc_oc=AdqpUFduvtJ3cQ0IrEVviTnIYz3up6a2R0Zoq057NR192eAH8tEBLWb5IhuSLMmbWMQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kZBTCGNHsC7fhmu5uip4rThzCNOFKmtTsTI8lhmQVSw&oe=6A467E3C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8dae1Ffhm4Q7kNvwGsm47E&_nc_oc=AdoS9I0Y83xGBPLEQEDQI7FsKDxtsW1JGLNdFcvzQSPOFNAiQHYEt5FFGZKAh1f08b0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pwKiHrYuZGjNQmibDu_F6hU3dibsttNu9cLlShuxWbg&oe=6A46840F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBecause in Fearing Gorilla Mods, the faster you move\u2026 the closer they get.", "short_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/evilgorillamodsproductions/home", "developer_terms_of_service_url": null, "publisher_name": "Evil Gorilla Mods Productions", "support_website_url": null, "website_url": "https://sites.google.com/view/evilgorillamodsproductions/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26355557194052782"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26373429818932186", "version": "1.1.55"}, "id": "1649715636180342", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26355557130719455", "is_concept": false, "latest_r
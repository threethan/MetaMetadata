R experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/evilgorillamodsproductions/home", "developer_terms_of_service_url": null, "publisher_name": "Evil Gorilla Mods Productions", "support_website_url": null, "website_url": "https://sites.google.com/view/evilgorillamodsproductions/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26355557194052782"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830467_1467011008484261_6074691370652674801_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siu-o_kStjYQ7kNvwE0fo3H&_nc_oc=AdonvO5GmpE5xv994lUInjOGl0d9qr1v36Pm_8fjYmZ2J5yTcUya7sNxFWRIhgNf3tA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Xi8gMdnZ-6pVyBLY0iRE6uCUEgClrixlvzJzaNn61lw&oe=6A0F2304"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fearing Gorilla Mods", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", 
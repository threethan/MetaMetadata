11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zB1ols1ESQQ7kNvwH3-v-O&_nc_oc=AdozE4QxlkZoUSCgMhHimzZn8WI4WS5XsCUx-QmqH6iKA5OKHjuUGVL9pTdcRUvHmnA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yXKdBqiu_8DaMZgtkkeUozfPD5ClAqiTXBtBN8UVBsw&oe=6A2197CE"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPkNeJieS2MQ7kNvwE337Pr&_nc_oc=Adq2Gx0NLWRENkKYNr2UWWQ-AGdkjvVzNQPzB3AmQjQgaradGblIhCaE6VkBPT-80Sg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af817WdxVxJ2Qk6veL6Knjp8yd9YFJg4BNnm-bQMzFKn_g&oe=6A21943C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bf-d5O7bAOIQ7kNvwGqLs-g&_nc_oc=AdrlqEePVXm4HLwMEVaC02JNiwTwZLMuLregymTqsiddnkG3G1f8biQ0Pn7_LqQE92c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gE9LvFASFzS8XZq1NLTRhgFQmydEBxsQQwSNiwckcpg&oe=6A219A0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
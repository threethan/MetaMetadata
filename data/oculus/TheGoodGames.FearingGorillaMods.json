11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcLSTnO3haYQ7kNvwGYyeMC&_nc_oc=Adq2oTdlC0zQ-wJFfxnvQpTvK9DN9E3stw9nLy6ePPB-62Jo7SbZXhn4M_aQO99HH-4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HW2JQK_dnx7t3PAeXRuge9qzLjQ_VQZ_eyPEVcZf65w&oe=6A10744E"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQ83b2m-pWUQ7kNvwES8oLb&_nc_oc=Adpuuod09Z02CJ02UPXd9urnBRvVAOiHR43dEFiCOHUny3XwwEFJz6dyk12VUDpYMpY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bEOc79B6C225HimjZw9SLmeTgGUM1sK4MngEf6zVk0g&oe=6A1070BC"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=482e-Ph30TwQ7kNvwHbTBEP&_nc_oc=Adq5nEFFh8T-ZSl70yF5rGdKOQxbjAuYXmX4X5G6z5I6PVTJZOI_sHWgsW-FeO2GHU4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KUEiUvKlMCuaf21RMIW_ORc0Gl6-zkNyxciBOU3tdGA&oe=6A10768F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
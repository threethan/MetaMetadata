11529_7426344507261182898_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf8ahgVyXWcQ7kNvwEN2fq2&_nc_oc=Adqivc9ZDFotHesseRj4DdNmu2b7dCL_zR4tZHnR_3hjaykxJVIOAo3VxLtUm8UHghQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GHROe0-GcAndIyR4QpG_vQTjjdBoO_Q3wMf6w33bNMg&oe=6A3E98CE"}, {"file_name": "h3_gms1.png", "id": "1332607855388522", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821725_1332607858721855_2680668123054283316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcrliTJtZGUQ7kNvwGeWDNm&_nc_oc=Ado-sx6S96wjTFzTFMpj-HgE6NsxTr3ksfwFFwM2vIVhER62RGz33VhpC5sSypg9ieY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TuDgrpG2G9JWS8UyW3EvMYC096ZnCGefFmUKgYgVcWw&oe=6A3E953C"}, {"file_name": "h4_gms1.png", "id": "1129168019345173", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825305_1129168022678506_7471267289336592263_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkPahxsZaSQQ7kNvwEpJEQk&_nc_oc=AdoHq1MaO9X-9Bv72qToPaO-AC9W7vO-sO1PTjqlAU5OTHrfNY7IH_dJZZn-dWsoa4g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jokXq3SlLLW5_PmjVootSA4AU08FC1F7wPS6qpLe9jg&oe=6A3E9B0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fearing Gorilla Mods", "keywords": ["horror", "gorilla", "mods", "tagging", "monkey"], "long_description": "Step into the chaos of Fearing Gorilla Mods, a fast-paced VR experience where movement is everything. Propel yourself through eerie environments using only your hands\u2014just like a gorilla\u2014mastering momentum, climbing, and quick escapes.\n\nBut you\u2019re not alone.\n\nLurking in the shadows are terrifying monsters that react to your movement, your noise\u2026 and your fear. To survive, you\u2019ll need more than skill\u2014you\u2019ll need power. Equip and experiment with a range of powerful mods that enhance your abilities, bend the rules, and give you a fighting chance against the unknown.\n\nRun. Climb. Hide. Adapt.\n\nBec
ailer_thumbnail": null, "display_name": "Myth: A Frozen Tale", "keywords": ["Myth", "Frozen", "Disney", "Animation", "Storytelling"], "long_description": "Experience the world of Disney\u2019s Frozen as never before with Walt Disney Animation Studios\u2019 animated short film, Myth: A Frozen Tale. Just as you settle in and enjoy a bedtime story with an Arendellian family, the home suddenly shifts around you, as you are transported into an enchanted forest. Things are not as they first appear, as the elemental spirits of air, fire, water and earth make their presence known.\n \nThe combination of traditional hand-drawn & CG animation are choreographed to an original score resulting in a visual poem where the audience is front and center.\n \nNarrated by Evan Rachel Wood\nMusic by by Joseph Trapanese\nRuntime: 8min 10 sec", "short_description": "Experience the world of Disney\u2019s Frozen as never before with Walt Disney Animation Studios\u2019 animated short film, Myth: A Frozen Tale. In a forest outside of Arendelle, a family sits down for a bedtime story and is transported to a mystical and enchanted forest where the elemental spirits come to life and the myth of their past and future is revealed.\n \nNarrated by Evan Rachel Wood\nMusic by Joseph Trapanese\nRuntime: 8min 10 sec"}]}, "developer_name": "Walt Disney Animation Studios", "developer_privacy_policy_url": "http://disneyprivacycenter.com/", "developer_terms_of_service_url": "http://disneytermsofuse.com/", "publisher_name": "Walt Disney Animation Studios", "support_website_url": null, "website_url": "https://www.disneyanimation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play
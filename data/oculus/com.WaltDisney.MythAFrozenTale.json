&_nc_sid=6e7a0a&_nc_ohc=mO66SCTuKqUQ7kNvwFWec2O&_nc_oc=AdptWrNrDH1hm96g0OgF7cK3OYo82_drwoTPwMFdANm8SU_6PwWz1_Obs669y1jtRps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu9qglSTEo0JsBRIr-7FZa59h5-sX-AEqWRROj2fCrSQ&oe=6AE0C7C8"}, {"file_name": "Nokk2.png", "id": "568952370471747", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001675_568952373805080_6145614440258067219_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiyoeeKOT2sQ7kNvwESB-i4&_nc_oc=AdrNccPRHPoV6vsADSWDxbnivzEFc22bx8rF7rHAUZjwqaxjdHbb5fWvvvoMpXJ2eqY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiT4tGkzODjpOqOQCCYAXsAhLMYTHEzXEOm6qu-SRQ5g&oe=6AE09F4F"}, {"file_name": "Giant2.png", "id": "254975742504158", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974655_254975752504157_2180870506718998325_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5nnv0XxPEgQ7kNvwGHs-eF&_nc_oc=AdqWcnd2rmy6t3rB_3sA80ktK9rPE2QDeGusW2DsoDCSddvqWB4Vgo2x7wFzLPu1w0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNytmJDS80HTwpXD_MdYPjifPBGTYQKhnqLa2Q2zq4BFw&oe=6AE0CB8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Myth: A Frozen Tale", "keywords": ["Myth", "Frozen", "Disney", "Animation", "Storytelling"], "long_description": "Experience the world of Disney\u2019s Frozen as never before with Walt Disney Animation Studios\u2019 animated short film, Myth: A Frozen Tale. Just as you settle in and enjoy a bedtime story with an Arendellian family, the home suddenly shifts around you, as you are transported into an enchanted forest. Things are not as they first appear, as the elemental spirits of air, fire, water and earth make their presence known.\n \nThe combination of traditional hand-drawn & CG animation are choreographed to an original score resulting in a visual poem where the audience is front and center.\n \nNarrated by Evan Rachel Wood\nMusic by by Joseph Trapanese\nRuntime: 8min 10 sec", "short_description": "Experience the world of Disney\u2019s Frozen as never before with Walt Disney Animation Studios\u2019 animated short film, Myth: A Frozen Tale. In a forest outside of Arendelle, a family sits down for a bedtime story and is transported to a mystical and enchanted forest where the elemental spirits come to life and the myth of their past and future is revealed.\n \nNarrated by Evan Rachel Wood\nMusic by Joseph Trapanese\nRuntime: 8min 10 sec"}]}, "developer_name": "Walt Disney Animation Studios", "developer_privacy_policy_url": "http://disneyprivacycenter.com/", "developer_terms_of_service_url": "http://disneytermsofuse.com/", "publisher_name": "Walt Disney Animation Studios", "support_website_url": null, "website_url": "https://www.disneyanimation.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GAMEPAD_VIA_TOUCH", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "470419704463001"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "358237191806628"}]}, "baseline_offer": {"id": "358237191806628"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1591894800, "status": "PUBLISHED", "id": "358237191806628"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2980603175341654", "version": "1.0"}, "id": "780011009200680", "channel_
s94Yt7df2UDLE6u9Fh2Umm6hsYYP0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8EoNDF60LlSIn7WfBQ9t86niShEelkiQX5LvcVrdB0w&oe=6A316C00"}, {"file_name": "com.glocksoftware.horrorgame-20260114-104346.png", "id": "1910051799596938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821099_1910051802930271_5093697632380196663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44ArWRGv5FAQ7kNvwFnFOCl&_nc_oc=Ado_WXqiFQA4adYBQUydfjSDsFXUQQcUt8UeTe5sikUR3yUdlIUE0_MqBfKSKS6jJ7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tcuFgNKW7cZ5_VGQPbkjPP19ogmOxUq-y815_dr7C9g&oe=6A31471B"}, {"file_name": "com.glocksoftware.horrorgame-20260114-103557.png", "id": "1406115264546505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818860_1406115267879838_2631368577935749496_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnRSKI7hbSsQ7kNvwH35EvH&_nc_oc=AdrphnHWsjh3460ZyE9fkQ_c-qLr8owZWHxM5hur-_AaVI9e8t4NVSiq0I6C1vtBIIA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eCe-ZQ0Sa21l_qDQ955TezeUPL0d4q1rp4XqcEh2S8w&oe=6A3166ED"}, {"file_name": "com.glocksoftware.horrorgame-20260114-111655.png", "id": "911517787897938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824307_911517791231271_4588332304987211788_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7rXZgdgFt4Q7kNvwFfpg_S&_nc_oc=AdoZ30ICmoZE-f7Tr9Elxj7VcDs4hIq_uS689ulhGc1zLiAMJkLSH1vd95VGEH87iUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_5rvMHKs9c2YTNisE6tNuT6o7TbSxxj0JhSPwnG-fnQ&oe=6A3177DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-07-18-14h53m09s181.png", "id": "24523165587385059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821115_24523165607385057_3752300522125326141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwYkPfmuzcEQ7kNvwGwIJEi&_nc_oc=AdqHC33UV_XvXjey3j7KWmsyFrROiiUDXNX_vgN5Xwlqwf-NGj4FRLRxYhw6Bp2wyPY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jTZ5oe6s1tyvhkGHQkm9Iavsue_BwsRs2xsxbXbm2kw&oe=6A315240"}, "display_name": "Forgotten Possessions", "keywords": ["horror", "stealth", "survival", "scary", "psychological"], "long_description": "**They say some things are better left forgotten. In this cabin, they are hunting you.**\n\nForgotten Possessions is a raw, physics-based VR horror experience crafted by a solo developer. No hand-holding. No safety net. Just you, your flashlight, and the crushing weight of the silence.\n\n# WHY YOU WILL FEAR THE DARK:\n\n- **Ever-Changing Nightmare:** Item locations and scares are randomized. Every run is a fresh descent into madness\u2014you never know where the next item hides or where the entity will strike.\n- **The Guardian:** A relentless AI that listens and hunts. It reacts to your noise and tracks your last known position. Silence is your only weapon.\n- **Unravel the Truth:** Explore the cabin to find hidden collectibles and piece together a dark, forgotten history. Each run reveals more of the story.\n- **Scoring Mode:** Beat your high score and test your stealth and survival skills in a franatical collecting run!\n\n# PLANNED FEATURES FOR FULL RELEASE (NOT GUARANTEED)\n\n- **Difficulty Modifiers or Difficulty Selection:** A new mode where the AI gets stronger as you progress OR a mode where you select AI modifiers yourself. ", "short_description": "Find and collect items that tell a dark story in an abandoned log cabin, but watch out for what lurks behind you. You sneak through dark rooms against a relentless, adaptive creature. Forget combat\u2014patience and stealth are your only mission. Experience a dynamic world with randomized item locations and a reactive environment. Evade the guardian as it reacts to noise and hunts you. Piece by piece, reveal the chilling past and examine items in your personal safe room."}]}, "developer_name": null, "developer_privacy_policy_url": "http://glock-software.de/privacy.html", "developer_terms_o
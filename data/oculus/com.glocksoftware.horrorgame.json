r4x8ABeS4nWNIamKLAaEmIOPA-RA1Ilv1VXqQ6EPXy72B1vgXM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbr8nGnXQV_UJmACYdtvtlyMpQJk9RuQ4OrksQWXYmcA&oe=6B032E7B"}, {"file_name": "Screenshot5.png", "id": "564151086525007", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974654_564151093191673_8784663539304125960_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2gPjnAaNN4Q7kNvwHzYpRb&_nc_oc=AdrluVuxCOy1yzF02SymZfhkcnp4bOTNTMIfk7Ojso3rQb-TPcxl48kFrWPC6ofcAn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV_sgY_l9Fn3oyGlEOLhZnJICdebvy3NIAlMb_W7vBaw&oe=6B031527"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forgotten Possessions", "keywords": ["horror", "adventure"], "long_description": "A game where exploration, hiding, and problem-solving take center stage, not violence and blood.\n\nCollect items while being chased by something unknown.\n\nYou'll explore a dark and threatening cabin with outdoor areas, and an unwelcome guest could be lurking around any corner. Forgotten Possessions is a gripping horror adventure from start to finish, leaving you breathless.\n\n# Features\n\n- Collect items for a mysterious person in exchange for handy equipment\n- Detailed and atmospheric environment\n- A truly eerie creature\n- An exciting blend of horror and adventure\n- There are many dark secrets to uncover.\n\n# Why Early Access?\nAs a solo indie developer, I want to collect feedback from real players in a controlled feedback loop as early as possible so that the game becomes successful! At the same time, I want to provide interested players with the fun at a reduced price as quickly as possible.\n\n**Your benefits:**\n\n1. Reduced price compared to the full release price\n2. Contribute your ideas, suggestions, and feedback using the integrated meta-tools\n3. Have fun with the latest game updates exclusively for Early Access players\n4. Be part of a growing community.\n", "short_description": "A nerve-wrecking horror adventure game where exploration, hiding, and problem-solving take center stage, not violence and blood."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.glock-software.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Glock Software", "support_website_url": null, "website_url": "https://new.express.adobe.com/webpage/TrGbP9J57KQRc", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27751870847792268"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1756854602076668"}, {"status": "CANCELLED", "id": "1429758805937876"}, {"status": "PUBLISHED", "id": "1480878193950625"}, {"status": "PUBLISHED", "id": "1358056769772660"}, {"status": "PUBLISHED", "id": "1773231127185551"}, {"status": "PUBLISHED", "id": "789586460752167"}, {"status": "PUBLISHED", "id": "941278835090221"}, {"status": "PUBLISHED", "id": "1220028059649379"}, {"status": "PUBLISHED", "id": "873102912363024"}, {"status": "PUBLISHED", "id": "765563536571565"}]}, "baseline_offer": {"id": "1773231127185551"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1756854602076668"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39985123661133531", "version"
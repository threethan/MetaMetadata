RqiVX0wSRtLdNHWD37It_DpiN6OHs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FxZ3_Dg_IGCNsDPd2tkCHUDEsolJ6a5XAbZDpDEEalg&oe=6A47D580"}, {"file_name": "com.glocksoftware.horrorgame-20260114-104346.png", "id": "1910051799596938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821099_1910051802930271_5093697632380196663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lFqmmVVcAEQ7kNvwF9qjl6&_nc_oc=AdoToHdR-hRhuprZK1BBPD8rSgNIX2Gyjgk-LnBHSOY5EwiahWn-h97tPj5okpLhgAE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iTfYmQaVBVWSnWM335b8FA1dwjdXPemsSogejnRfFuA&oe=6A47B09B"}, {"file_name": "com.glocksoftware.horrorgame-20260114-103557.png", "id": "1406115264546505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818860_1406115267879838_2631368577935749496_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZPsWMfzflcQ7kNvwFg9NvJ&_nc_oc=AdrHCETX6piKiCOMYNNFwQjn2hMEfczQ7eeXHPLvZoZ79-mjXYQTDo8p5h3Lpg_OhOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qTRBt5-I5-p9IlZDhNAz9msfuUjH6V3X3z37vGYfdKg&oe=6A47D06D"}, {"file_name": "com.glocksoftware.horrorgame-20260114-111655.png", "id": "911517787897938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_911517791231271_4588332304987211788_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GKIzEPyCzIQ7kNvwF6WkSl&_nc_oc=AdpnCzpwIWrU_AKdOWI3-l6nKK7-xT2LssLK6_HnHxqhvgOgIAcM86nAsA8KSQ0G3cs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HbfLQm4_zkSwaWjn13E1d5b-9txMCBf0nrdIFq73-Ug&oe=6A47E15A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-07-18-14h53m09s181.png", "id": "24523165587385059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_24523165607385057_3752300522125326141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ArBSMzHTh0Q7kNvwGUthUZ&_nc_oc=AdqA2UOei6L7xuwk9Mj6KZ12npl57cbKmGk_o1nnf9akEqonmdPWG3Qqyt_JWV18b0w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zk45Jp-G_u1Yv35t1-YWtnFcbhOGTX6Wk1tDWEAdrqw&oe=6A47BBC0"}, "display_name": "Forgotten Possessions", "keywords": ["horror", "stealth", "survival", "scary", "psychological"], "long_description": "**They say some things are better left forgotten. In this cabin, they are hunting you.**\n\nForgotten Possessions is a raw, physics-based VR horror experience crafted by a solo developer. No hand-holding. No safety net. Just you, your flashlight, and the crushing weight of the silence.\n\n# WHY YOU WILL FEAR THE DARK:\n\n- **Ever-Changing Nightmare:** Item locations and scares are randomized. Every run is a fresh descent into madness\u2014you never know where the next item hides or where the entity will strike.\n- **The Guardian:** A relentless AI that listens and hunts. It reacts to your noise and tracks your last known position. Silence is your only weapon.\n- **Unravel the Truth:** Explore the cabin to find hidden collectibles and piece together a dark, forgotten history. Each run reveals more of the story.\n- **Scoring Mode:** Beat your high score and test your stealth and survival skills in a franatical collecting run!\n\n# PLANNED FEATURES FOR FULL RELEASE (NOT GUARANTEED)\n\n- **Difficulty Modifiers or Difficulty Selection:** A new mode where the AI gets stronger as you progress OR a mode where you select AI modifiers yourself. ", "short_description": "Find and collect items that tell a dark story in an abandoned log cabin, but watch out for what lurks behind you. You sneak through dark rooms against a relentless, adaptive creature. Forget combat\u2014patience and stealth are your only mission. Experience a dynamic world with randomized item locations and a reactive environment. Evade the guardian as it reacts to noise and hunts you. Piece by piece, reveal the chilling past and examine items in your personal safe room."}]}, "developer_name": null, "developer_privacy_policy_url": "http://glock-software.de/privacy.html", "developer_terms_o
.png", "id": "542396641994567", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031369_542396645327900_7225339964235227264_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJL85dz-qOEQ7kNvwEyl-za&_nc_oc=AdoHnjM_zPj4KkZCBGFSc_fj5ekh7QoaxBW_rL8GKICqiBdNk731H2P2JEwjlP1u0Zg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElMXVhDnrtegDftXmDdfiWozvgXXEgMpt2124xl8BzTQ&oe=6A89A09A"}, {"file_name": "Screenshot3.png", "id": "559350380070083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982568_559350383403416_8892106795999702592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9atRmf8vw04Q7kNvwGvj7jb&_nc_oc=AdoWaILynj_HlWKKSe0ozVL-V2qkie11vwv0V2VeiuWEaMWbSTXzMcE0CIMfzDqfMZg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7v4iYp8axpgQsZJRMmrOdmYkPM1Ef19sMPlRQQJr2-Q&oe=6A8973FB"}, {"file_name": "Screenshot5.png", "id": "564151086525007", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974654_564151093191673_8784663539304125960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_a-QvwdHT14Q7kNvwGRxwIa&_nc_oc=AdrDorVEsLs7MGKxP8AagFvfAJHUETws5ckrfIylk8RaS7QslU_-QoEnDRufTSyo1iU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHGEbqC4bPGYwFTK4al9uuXOSkuso-_gWQZ_u11_fKlQ&oe=6A8992E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forgotten Possessions", "keywords": ["horror", "adventure"], "long_description": "A game where exploration, hiding, and problem-solving take center stage, not violence and blood.\n\nCollect items while being chased by something unknown.\n\nYou'll explore a dark and threatening cabin with outdoor areas, and an unwelcome guest could be lurking around any corner. Forgotten Possessions is a gripping horror adventure from start to finish, leaving you breathless.\n\n# Features\n\n- Collect items for a mysterious person in exchange for handy equipment\n- Detailed and atmospheric environment\n- A truly eerie creature\n- An exciting blend of horror and adventure\n- There are many dark secrets to uncover.\n\n# Why Early Access?\nAs a solo indie developer, I want to collect feedback from real players in a controlled feedback loop as early as possible so that the game becomes successful! At the same time, I want to provide interested players with the fun at a reduced price as quickly as possible.\n\n**Your benefits:**\n\n1. Reduced price compared to the full release price\n2. Contribute your ideas, suggestions, and feedback using the integrated meta-tools\n3. Have fun with the latest game updates exclusively for Early Access players\n4. Be part of a growing community.\n", "short_description": "A nerve-wrecking horror adventure game where exploration, hiding, and problem-solving take center stage, not violence and blood."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.glock-software.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Glock Software", "support_website_url": null, "website_url": "https://new.express.adobe.com/webpage/TrGbP9J57KQRc", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27751870847792268"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1358056769772660"}, {"status": "PUBLISHED", "id": "1773231127185551"}, {"status": "PUBLISHED", "id": "789586460752167"}, {"status": "PUBLISHED", "id": "94127883509
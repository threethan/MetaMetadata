LXAH0Ydm1uiTRC9RyjoWgnFXITFyw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcsKxLYJUKG6ciinTU9mUlCvIPWWpbLbHtx8ekgYAxpA&oe=6A576F40"}, {"file_name": "com.glocksoftware.horrorgame-20260114-104346.png", "id": "1910051799596938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_1910051802930271_5093697632380196663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wy29FrftzIwQ7kNvwEAM7gB&_nc_oc=Adqa9moEAoKbs9X8CUDknFJQuyAtgYApJpAmowhH2ucJoB6J7c0Hn7i42zJQBi0eyIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo6TGdlWOEByWunx95kPPQE4Xil6knwG3pmLkT0jjHkA&oe=6A57829B"}, {"file_name": "com.glocksoftware.horrorgame-20260114-103557.png", "id": "1406115264546505", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_1406115267879838_2631368577935749496_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Sy8Aqu4wjEQ7kNvwGSJD8U&_nc_oc=Adr9HFxszaefbQdHE1Qj3vMW9IrzlOnM5AwajnNo6weHTz_IQ7epKAZXyV59kqkKvVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHe8o01IyMGn26ZkbBolXl2pKwUeKRjbCertiKWtS-2w&oe=6A576A2D"}, {"file_name": "com.glocksoftware.horrorgame-20260114-111655.png", "id": "911517787897938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824307_911517791231271_4588332304987211788_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bTEhngGwkUQ7kNvwFYIXVr&_nc_oc=Adr0KxquSfbkLI10561mtymtavtTI2OIRMF4Gs4-klSJ8xl0zbboA7ViUxY0nb30w7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIy17qDKyGLTiufeMH0bW5bVEjNdf8YSKM-apItK_TnQ&oe=6A577B1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-07-18-14h53m09s181.png", "id": "24523165587385059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821115_24523165607385057_3752300522125326141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhF-GxoG4vIQ7kNvwEtB3qf&_nc_oc=Adp2cb43F4aqG_hBzXJBwMiyBAdtaEfP1NULuYnNv9ep3hchwDm-9y9NMM2tGHRcw7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFyCWFuOOwRv-PfuKe2CYOUn0JPq2_evXwtB9ZTUTxmg&oe=6A578DC0"}, "display_name": "Forgotten Possessions", "keywords": ["horror", "stealth", "survival", "scary", "psychological"], "long_description": "**They say some things are better left forgotten. In this cabin, they are hunting you.**\n\nForgotten Possessions is a raw, physics-based VR horror experience crafted by a solo developer. No hand-holding. No safety net. Just you, your flashlight, and the crushing weight of the silence.\n\n# WHY YOU WILL FEAR THE DARK:\n\n- **Ever-Changing Nightmare:** Item locations and scares are randomized. Every run is a fresh descent into madness\u2014you never know where the next item hides or where the entity will strike.\n- **The Guardian:** A relentless AI that listens and hunts. It reacts to your noise and tracks your last known position. Silence is your only weapon.\n- **Unravel the Truth:** Explore the cabin to find hidden collectibles and piece together a dark, forgotten history. Each run reveals more of the story.\n- **Scoring Mode:** Beat your high score and test your stealth and survival skills in a franatical collecting run!\n\n# PLANNED FEATURES FOR FULL RELEASE (NOT GUARANTEED)\n\n- **Difficulty Modifiers or Difficulty Selection:** A new mode where the AI gets stronger as you progress OR a mode where you select AI modifiers yourself. ", "short_description": "Find and collect items that tell a dark story in an abandoned log cabin, but watch out for what lurks behind you. You sneak through dark rooms against a relentless, adaptive creature. Forget combat\u2014patience and stealth are your only mission. Experience a dynamic world with randomized item locations and a reactive environment. Evade the guardian as it reacts to noise and hunts you. Piece by piece, reveal the chilling past and examine items in your personal safe room."}]}, "developer_name": null, "developer_privacy_policy_url": "http://glock-software.de/privacy.html", "developer_terms_o
_q_aB-m3EFO0oDLpBxmCxNMRxRaDQ4Ww0pSuiCRg&oe=6A79B62D"}, {"file_name": "Screenshot2.png", "id": "985741880053962", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982568_985741883387295_6204767685484150067_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28C_Gpzf1r0Q7kNvwHFvuM_&_nc_oc=AdqQmD9eabwg7p3QdhpS2SzC2-Q2XUU7qpqjSlKa95vmLUGtZ5jexvFlnKWkt-Ta6bs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFSk8mxmEOJs1JRZsqUEu3w-g6uYw4rdLmTJ3Ea4HFqw&oe=6A79DA50"}, {"file_name": "Screenshot4.png", "id": "542396641994567", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031369_542396645327900_7225339964235227264_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkQpVszVEi0Q7kNvwHlymEe&_nc_oc=AdpA-6zXd_WITCXU1AdelGFrMBDPfUzELTgkiRLOIGMxQbKoGcl_59NeHkJSWjHtdeo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-YpT-511TTli-3pi_HpB1fWyw8Ix7a5NgHqDvj9IFYw&oe=6A79CE9A"}, {"file_name": "Screenshot3.png", "id": "559350380070083", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982568_559350383403416_8892106795999702592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7NgueeS-7oQ7kNvwGIeisz&_nc_oc=AdpKmvjPmYuJxV64at-KW5SLf4i3GnL_lpG1KKA2Rkm5Ki_x6wh3aB74aKfLakdMek8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnOdYFBHz4n1oGGUgwdUBs76AeyQehCqgicIK7quLoZQ&oe=6A79DA3B"}, {"file_name": "Screenshot5.png", "id": "564151086525007", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974654_564151093191673_8784663539304125960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZB_B4_zXMJAQ7kNvwEBAXDJ&_nc_oc=Adp5IEtOsulkkSTEhPkTdpXRQDX5lSZx-CU37PGenP9Ewx9jeXBVeHfPAtmwbugH4To&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhN-0whRMN-7_iGfC9M4oGbnAuixUlu46thTwoNx9sEw&oe=6A79C0E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forgotten Possessions", "keywords": ["horror", "adventure"], "long_description": "A game where exploration, hiding, and problem-solving take center stage, not violence and blood.\n\nCollect items while being chased by something unknown.\n\nYou'll explore a dark and threatening cabin with outdoor areas, and an unwelcome guest could be lurking around any corner. Forgotten Possessions is a gripping horror adventure from start to finish, leaving you breathless.\n\n# Features\n\n- Collect items for a mysterious person in exchange for handy equipment\n- Detailed and atmospheric environment\n- A truly eerie creature\n- An exciting blend of horror and adventure\n- There are many dark secrets to uncover.\n\n# Why Early Access?\nAs a solo indie developer, I want to collect feedback from real players in a controlled feedback loop as early as possible so that the game becomes successful! At the same time, I want to provide interested players with the fun at a reduced price as quickly as possible.\n\n**Your benefits:**\n\n1. Reduced price compared to the full release price\n2. Contribute your ideas, suggestions, and feedback using the integrated meta-tools\n3. Have fun with the latest game updates exclusively for Early Access players\n4. Be part of a growing community.\n", "short_description": "A nerve-wrecking horror adventure game where exploration, hiding, and problem-solving take center stage, not violence and blood."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.glock-software.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Glock Software", "support_website_url": null, "website_url": "https://new.express.adobe.com/webpage/TrGbP9J57KQRc", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb
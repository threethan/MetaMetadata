295_6204767685484150067_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSkNe4hOWkMQ7kNvwHViFiT&_nc_oc=Adoxyme1iOZVr-iAS51IK7mbuToT7ufDT5kXmgmWMhRx8gXkNvlbRgb_maooCVVENBM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1dEgIITgc4HzITI7kK1NXZAeoCA-pwGST7tB9uQ40vdg&oe=69F20FD0"}, {"file_name": "Screenshot4.png", "id": "542396641994567", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031369_542396645327900_7225339964235227264_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvUPm2cY-SEQ7kNvwFIA6lw&_nc_oc=AdrzTAIzi41RIG05GydI0WqSwjRr5ETuNC197pSKGEZzMg6LX3ZImst6voH72rD3gy8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af29YmmPd_nXVamT-mZBLeG7JVl2x9KaC-XeeJJLVbvqWA&oe=69F2041A"}, {"file_name": "Screenshot3.png", "id": "559350380070083", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982568_559350383403416_8892106795999702592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAOSle333XoQ7kNvwFFRsrd&_nc_oc=AdoAS_8aaMgNoGJDVkmKLkh5IPyvz_tNbNLlnluL-GkJ-NRscK75EdUtbNR8-c2jGLg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1p4kRCiSp3jjwtPm3iBk4rQq8t5jfcRdwev9NlX59XQA&oe=69F20FBB"}, {"file_name": "Screenshot5.png", "id": "564151086525007", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974654_564151093191673_8784663539304125960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIB6g0ZOuCEQ7kNvwHeFWR1&_nc_oc=AdoTNdRyy7T_mcALuioTAhzijqRw6vHj4diNZYGhRcYPFAcG1JBsoR1E-AlXpjP3aeo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2KjLHdduOBEoHL6dA3gI-7JGtsVJvBqNBN7ZBw38kw4Q&oe=69F1F667"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forgotten Possessions", "keywords": ["horror", "adventure"], "long_description": "A game where exploration, hiding, and problem-solving take center stage, not violence and blood.\n\nCollect items while being chased by something unknown.\n\nYou'll explore a dark and threatening cabin with outdoor areas, and an unwelcome guest could be lurking around any corner. Forgotten Possessions is a gripping horror adventure from start to finish, leaving you breathless.\n\n# Features\n\n- Collect items for a mysterious person in exchange for handy equipment\n- Detailed and atmospheric environment\n- A truly eerie creature\n- An exciting blend of horror and adventure\n- There are many dark secrets to uncover.\n\n# Why Early Access?\nAs a solo indie developer, I want to collect feedback from real players in a controlled feedback loop as early as possible so that the game becomes successful! At the same time, I want to provide interested players with the fun at a reduced price as quickly as possible.\n\n**Your benefits:**\n\n1. Reduced price compared to the full release price\n2. Contribute your ideas, suggestions, and feedback using the integrated meta-tools\n3. Have fun with the latest game updates exclusively for Early Access players\n4. Be part of a growing community.\n", "short_description": "A nerve-wrecking horror adventure game where exploration, hiding, and problem-solving take center stage, not violence and blood."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.glock-software.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Glock Software", "support_website_url": null, "website_url": "https://new.express.adobe.com/webpage/TrGbP9J57KQRc", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
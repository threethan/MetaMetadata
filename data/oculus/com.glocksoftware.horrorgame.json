.png", "id": "542396641994567", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031369_542396645327900_7225339964235227264_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiLXxMaWKxEQ7kNvwEgSCER&_nc_oc=AdrvUZEg62TyS-cHcMoneQD-AOux52e3UKIDUPNBh0niqk6E_JJ3qnPRweixB-6r-C4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6EtC4dytrlIu7k6JoXFBL9Lw8j4J_AXSNUrcsxf82cw&oe=6A9AC41A"}, {"file_name": "Screenshot3.png", "id": "559350380070083", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982568_559350383403416_8892106795999702592_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmiozAgzyQQQ7kNvwHuZDGy&_nc_oc=AdrKlP2d7CfPkkv2uW5RR5gEamCycinhv3tVI34OkXMq-JFXQmcfG6t1YsofKFe5Tws&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3GJ0V4QQf8Tt6Cu5Kiac2Ow7_JLW00sr3tJH2nkRCSA&oe=6A9ACFBB"}, {"file_name": "Screenshot5.png", "id": "564151086525007", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974654_564151093191673_8784663539304125960_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tTQrVuv8gIQ7kNvwEy4HsR&_nc_oc=Adp9qP4gEzFgmtuG0S2bU-mrvNAp5Al7GkdIimF3iJRP_V2ls6ehub-yveCXMesiYO4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYBMGqhz89JMubXVJ46Sw4BServld3izQ_F6H-TgJh6Q&oe=6A9AEEA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forgotten Possessions", "keywords": ["horror", "adventure"], "long_description": "A game where exploration, hiding, and problem-solving take center stage, not violence and blood.\n\nCollect items while being chased by something unknown.\n\nYou'll explore a dark and threatening cabin with outdoor areas, and an unwelcome guest could be lurking around any corner. Forgotten Possessions is a gripping horror adventure from start to finish, leaving you breathless.\n\n# Features\n\n- Collect items for a mysterious person in exchange for handy equipment\n- Detailed and atmospheric environment\n- A truly eerie creature\n- An exciting blend of horror and adventure\n- There are many dark secrets to uncover.\n\n# Why Early Access?\nAs a solo indie developer, I want to collect feedback from real players in a controlled feedback loop as early as possible so that the game becomes successful! At the same time, I want to provide interested players with the fun at a reduced price as quickly as possible.\n\n**Your benefits:**\n\n1. Reduced price compared to the full release price\n2. Contribute your ideas, suggestions, and feedback using the integrated meta-tools\n3. Have fun with the latest game updates exclusively for Early Access players\n4. Be part of a growing community.\n", "short_description": "A nerve-wrecking horror adventure game where exploration, hiding, and problem-solving take center stage, not violence and blood."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.glock-software.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Glock Software", "support_website_url": null, "website_url": "https://new.express.adobe.com/webpage/TrGbP9J57KQRc", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27751870847792268"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1358056769772660"}, {"status": "PUBLISHED", "id": "1773231127185551"}, {"status": "PUBLISHED", "id": "789586460752167"}, {"status": "PUBLISHED", "id": "94127883509
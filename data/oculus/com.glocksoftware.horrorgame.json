l_j1a3XBZXM4q7iLYqrDd-M6wIo7k&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75V7UIKo3LbDUuSUlbHPhWLhX8jvkJ2yxYsGa9XtGO5g&oe=6A1C5400"}, {"file_name": "com.glocksoftware.horrorgame-20260114-104346.png", "id": "1910051799596938", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491821099_1910051802930271_5093697632380196663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MEHt85zz-IQ7kNvwHqt0fW&_nc_oc=Adpe_FHjiVLF_-49pohM794FVIPc0zyHfVN0GcnC9JSwN6tVXUE982W95loXYJ2ML3U&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61nHqWlm_tg3vC9GS998ah5hQflaqUXw7ap_tQHCwHVA&oe=6A1C2F1B"}, {"file_name": "com.glocksoftware.horrorgame-20260114-103557.png", "id": "1406115264546505", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491818860_1406115267879838_2631368577935749496_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdRVIh-pYW4Q7kNvwGNZh8D&_nc_oc=AdpShM6gKXl_ampbTruV1mu1ioosSTcENtC2DTRt8kA7GRZTCRwABLpR9KakJoJXrGU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yip6Qx-RDnvrbaMEbMwO4GmIrtjkT2VUoUnaItrQIUw&oe=6A1C4EED"}, {"file_name": "com.glocksoftware.horrorgame-20260114-111655.png", "id": "911517787897938", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491824307_911517791231271_4588332304987211788_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meXae-fOoXQQ7kNvwGJdBV4&_nc_oc=AdqcWRGbfNBYNybAdHNeqiVfpZQfvgiTuJrIkYo5bTQk8bwTS4a_XQqjSCMFi3XN1ys&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p2bjbrpWHwvnJEuNvfPwUZSJ3Ys-HmaKJpFpqirS9vQ&oe=6A1C5FDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-07-18-14h53m09s181.png", "id": "24523165587385059", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491821115_24523165607385057_3752300522125326141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tL3BY9UX45UQ7kNvwHFc3eX&_nc_oc=AdqRm__56Uc5a3NgRDLqgpMbGi-ZByO7bDMM8qrW0KV_c8qHAC8c1_pj75269AbX5yA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63B85M5UmZgu6Rzy3BfvfkAAwZ0UsXIIW57E5UP6b7Mw&oe=6A1C3A40"}, "display_name": "Forgotten Possessions", "keywords": ["horror", "stealth", "survival", "scary", "psychological"], "long_description": "**They say some things are better left forgotten. In this cabin, they are hunting you.**\n\nForgotten Possessions is a raw, physics-based VR horror experience crafted by a solo developer. No hand-holding. No safety net. Just you, your flashlight, and the crushing weight of the silence.\n\n# WHY YOU WILL FEAR THE DARK:\n\n- **Ever-Changing Nightmare:** Item locations and scares are randomized. Every run is a fresh descent into madness\u2014you never know where the next item hides or where the entity will strike.\n- **The Guardian:** A relentless AI that listens and hunts. It reacts to your noise and tracks your last known position. Silence is your only weapon.\n- **Unravel the Truth:** Explore the cabin to find hidden collectibles and piece together a dark, forgotten history. Each run reveals more of the story.\n- **Scoring Mode:** Beat your high score and test your stealth and survival skills in a franatical collecting run!\n\n# PLANNED FEATURES FOR FULL RELEASE (NOT GUARANTEED)\n\n- **Difficulty Modifiers or Difficulty Selection:** A new mode where the AI gets stronger as you progress OR a mode where you select AI modifiers yourself. ", "short_description": "Find and collect items that tell a dark story in an abandoned log cabin, but watch out for what lurks behind you. You sneak through dark rooms against a relentless, adaptive creature. Forget combat\u2014patience and stealth are your only mission. Experience a dynamic world with randomized item locations and a reactive environment. Evade the guardian as it reacts to noise and hunts you. Piece by piece, reveal the chilling past and examine items in your personal safe room."}]}, "developer_name": null, "developer_privacy_policy_url": "http://glock-software.de/privacy.html", "developer_terms_o
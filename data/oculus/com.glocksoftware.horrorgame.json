jK0pLkrOHHMBhRYS_ylZHpAzpZag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9yMoF8msGktGHLWpLdZK6BiR3WcsJWz1-zqVlb8dQBg&oe=6A7C5940"}, {"file_name": "com.glocksoftware.horrorgame-20260114-104346.png", "id": "1910051799596938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_1910051802930271_5093697632380196663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xua2YpS1054Q7kNvwFtsoKx&_nc_oc=Adqx6uBo0R2XoBDfpOUoAHbLZUNqIiCNMEvgLARiTx5L9K2jlo4NpHnY9AFWZPPI8u8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrgipRmW8l_hP6YzLNS8ssW2svUcqhiL69W4WlenenqQ&oe=6A7C6C9B"}, {"file_name": "com.glocksoftware.horrorgame-20260114-103557.png", "id": "1406115264546505", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_1406115267879838_2631368577935749496_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyZQwkQtHIAQ7kNvwH4j7ug&_nc_oc=AdrCrHoc_jhZuHQgfl8WkKSXpZe71htGxu75uFAhIvMm8nkJ8_nGftE2z5wna3CISrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvBPNQ5YW-OtAwegPRGuahNV8NSBgFH_vOBOwtCe1FBw&oe=6A7C542D"}, {"file_name": "com.glocksoftware.horrorgame-20260114-111655.png", "id": "911517787897938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824307_911517791231271_4588332304987211788_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuauRYMi_LkQ7kNvwGxmhle&_nc_oc=AdpS4Qw0ew3wrmfZi0FQY2X5hkdeqTVEF6DLFkra1RJyDiVSjBFU_evOI3xdiP4Fi_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhEesKOhxE7HklxKUACuY1MvzPzCOYYUOjelkvue98Bg&oe=6A7C651A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-07-18-14h53m09s181.png", "id": "24523165587385059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821115_24523165607385057_3752300522125326141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7vRWfLR9aEQ7kNvwGkrhRA&_nc_oc=AdpiPcf3Cn7GFyuEX7OJ_ay7HIPp74EoYPjqM9t7uodnBhY_mrAf54SpXtSPjw9m1-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2T1b_nz6W7-ZRNxQjluzIVCrXKgnt-UP5tLlHmLLeQA&oe=6A7C77C0"}, "display_name": "Forgotten Possessions", "keywords": ["horror", "stealth", "survival", "scary", "psychological"], "long_description": "**They say some things are better left forgotten. In this cabin, they are hunting you.**\n\nForgotten Possessions is a raw, physics-based VR horror experience crafted by a solo developer. No hand-holding. No safety net. Just you, your flashlight, and the crushing weight of the silence.\n\n# WHY YOU WILL FEAR THE DARK:\n\n- **Ever-Changing Nightmare:** Item locations and scares are randomized. Every run is a fresh descent into madness\u2014you never know where the next item hides or where the entity will strike.\n- **The Guardian:** A relentless AI that listens and hunts. It reacts to your noise and tracks your last known position. Silence is your only weapon.\n- **Unravel the Truth:** Explore the cabin to find hidden collectibles and piece together a dark, forgotten history. Each run reveals more of the story.\n- **Scoring Mode:** Beat your high score and test your stealth and survival skills in a franatical collecting run!\n- **Hard Story Mode:** You know all the tricks and locations but want a bigger challenge? Try the unforgiving hard mode and test your skills even more!", "short_description": "Find and collect items that tell a dark story in an abandoned log cabin, but watch out for what lurks behind you. You sneak through dark rooms against a relentless, adaptive creature. Forget combat\u2014patience and stealth are your only mission. Experience a dynamic world with randomized item locations and a reactive environment. Evade the guardian as it reacts to noise and hunts you. Piece by piece, reveal the chilling past and examine items in your personal safe room."}]}, "developer_name": null, "developer_privacy_policy_url": "http://glock-software.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Glock Software", "suppo
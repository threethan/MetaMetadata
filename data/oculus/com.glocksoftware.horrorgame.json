bXBQ0-E2e6MM72nd3kYk6zH8HK28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb-KfOgeN9oR8NtuIVQX5UC2UW3wYtGhImJ8VnIS1I1w&oe=6AAAB600"}, {"file_name": "com.glocksoftware.horrorgame-20260114-104346.png", "id": "1910051799596938", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1910051802930271_5093697632380196663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sua3U5aRVRsQ7kNvwGpMqrn&_nc_oc=Adq8HCh_tBlWWxi0lU0vGI7tpyrUgwAm3bjF_6MzejnKb38vF-ylireVeurm2Z3fSek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt1e5LTjS-1NGcwAc8xvQ_L1ztu85qLjR49Px9PZKIgg&oe=6AAA911B"}, {"file_name": "com.glocksoftware.horrorgame-20260114-103557.png", "id": "1406115264546505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818860_1406115267879838_2631368577935749496_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEZO-QJVc6oQ7kNvwHu6tPf&_nc_oc=AdoEMqqsGI01rxMM6SM31lakWtdVrJvEEWcX3znbUmE7yO2GvzZLL7Q2lIi4huXzU2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0AOiRm0exUR4IyZqKkEi_aSFjoGYF6IqTC4OstJvDvQ&oe=6AAAB0ED"}, {"file_name": "com.glocksoftware.horrorgame-20260114-111655.png", "id": "911517787897938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_911517791231271_4588332304987211788_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VX66kJlnIIAQ7kNvwEvCmyr&_nc_oc=AdrkNl-u24ySPA31JLkI1rlx1TQ-mS3EaGJHG4FdbR5LS9nTpbU_Y4kacq7s3_Hb39I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4-VJ8o22tCCNJ0UT3UkMDqWRiYWggELCAEPxUXWrwcw&oe=6AAA899A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forgotten Possessions", "keywords": ["horror", "stealth", "survival", "scary", "adventure"], "long_description": "**They say some things are better left forgotten. In this cabin, they are hunting you.**\n\nForgotten Possessions is a raw, physics-based VR horror experience crafted by a solo developer. No hand-holding. No safety net. Just you, your flashlight, and the crushing weight of the silence.\n\n{1521524765935490}\n\n# Why you will fear the dark\n\n- **Changing Nightmare:** Item locations are randomized. Every run is a fresh descent into madness\u2014you never know where the next item hides or where the entity will strike.\n- **The Guardian:** A relentless AI that listens and hunts. It reacts to your noise and tracks your last known position. Silence is your only weapon.\n- **Unravel the Truth:** Explore the cabin to find hidden collectibles and piece together a dark, forgotten history. Each run reveals more of the story.\n- **Scoring Mode:** Beat your high score and test your stealth and survival skills in a franatical collecting run!\n- **Hard Story Mode:** You know all the tricks and locations but want a bigger challenge? Try the unforgiving hard mode and test your skills even more!", "short_description": "Find and collect items that tell a dark story in an abandoned log cabin, but watch out for what lurks behind you. You sneak through dark rooms against a relentless, adaptive creature. Forget combat\u2014patience and stealth are your only mission. Experience a dynamic world with randomized item locations and a reactive environment. Evade the guardian as it reacts to noise and hunts you. Piece by piece, reveal the chilling past and examine items in your personal safe room."}]}, "developer_name": null, "developer_privacy_policy_url": "http://glock-software.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Glock Software", "support_website_url": null, "website_url": "https://forgotten-possessions.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED
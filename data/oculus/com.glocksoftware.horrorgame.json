tKqB2IREVd2XHIXus_ZcsgHSe34Ls&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1FaQ-36fs2-3hdWVqGcUKUSNykAcOWzedpeG5XqWkaw&oe=6A6CBF80"}, {"file_name": "com.glocksoftware.horrorgame-20260114-104346.png", "id": "1910051799596938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1910051802930271_5093697632380196663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzSJowSbW6gQ7kNvwGL1Ybq&_nc_oc=AdqCsF_O1wlKtCtmZtZ2O8OH-YQFCulhalr6q0DKMajUos6CkL3E4xY8EEvOUw8WZh0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF4rzL78EMt2HwrsFkZ1vF1TZwZuSNiqzFJHJjyJzmXQ&oe=6A6C9A9B"}, {"file_name": "com.glocksoftware.horrorgame-20260114-103557.png", "id": "1406115264546505", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818860_1406115267879838_2631368577935749496_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnYuVWvkbyoQ7kNvwGH4xSo&_nc_oc=AdoQKXAe2IfX-WvK9xQIHtnoSwwTgIoDSekH-NYLVlNcq719_GwSmGsN0bf1O96ctEA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3_nfXQKX8S2Hzscp-XNqsmGHCWfuxPW5sfI-OkivFEA&oe=6A6CBA6D"}, {"file_name": "com.glocksoftware.horrorgame-20260114-111655.png", "id": "911517787897938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824307_911517791231271_4588332304987211788_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHrFg01DcJEQ7kNvwFhiPmH&_nc_oc=AdpuPDFMB5qeIXfGKYagbiXE7p5XxGwsld86o9sYNx1B6oUA9iKfo8nSTmkFzGhU3f8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc_Me1Hb3NE9yzy6VCERgBBBtNN27lX_PaBYDFLYEvYA&oe=6A6C931A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-07-18-14h53m09s181.png", "id": "24523165587385059", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821115_24523165607385057_3752300522125326141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FqByT2tlX0Q7kNvwHTnS8S&_nc_oc=AdqMCF8suvko0JHXKihO7ABvu9RNO04jnw_YOmDXZ-YPc3wfOGQWJoJn-19RxY4u3UM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjBBoh7XD6cYEzXwdeI6sLWzBlS9FX4KtrpLN96uVo2Q&oe=6A6CA5C0"}, "display_name": "Forgotten Possessions", "keywords": ["horror", "stealth", "survival", "scary", "psychological"], "long_description": "**They say some things are better left forgotten. In this cabin, they are hunting you.**\n\nForgotten Possessions is a raw, physics-based VR horror experience crafted by a solo developer. No hand-holding. No safety net. Just you, your flashlight, and the crushing weight of the silence.\n\n# WHY YOU WILL FEAR THE DARK:\n\n- **Ever-Changing Nightmare:** Item locations and scares are randomized. Every run is a fresh descent into madness\u2014you never know where the next item hides or where the entity will strike.\n- **The Guardian:** A relentless AI that listens and hunts. It reacts to your noise and tracks your last known position. Silence is your only weapon.\n- **Unravel the Truth:** Explore the cabin to find hidden collectibles and piece together a dark, forgotten history. Each run reveals more of the story.\n- **Scoring Mode:** Beat your high score and test your stealth and survival skills in a franatical collecting run!\n\n# PLANNED FEATURES FOR FULL RELEASE (NOT GUARANTEED)\n\n- **Difficulty Modifiers or Difficulty Selection:** A new mode where the AI gets stronger as you progress OR a mode where you select AI modifiers yourself. ", "short_description": "Find and collect items that tell a dark story in an abandoned log cabin, but watch out for what lurks behind you. You sneak through dark rooms against a relentless, adaptive creature. Forget combat\u2014patience and stealth are your only mission. Experience a dynamic world with randomized item locations and a reactive environment. Evade the guardian as it reacts to noise and hunts you. Piece by piece, reveal the chilling past and examine items in your personal safe room."}]}, "developer_name": null, "developer_privacy_policy_url": "http://glock-software.de/privacy.html", "developer_terms_o
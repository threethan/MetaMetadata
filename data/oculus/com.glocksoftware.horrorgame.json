nt-atl3-1.oculuscdn.com&oh=00_Af2bZSSsdiYAi0Dj-lsyhbgVG-7FfDxWg_n1HLn94ZxDMA&oe=69F1EBC0"}, {"file_name": "com.glocksoftware.horrorgame-20260114-104346.png", "id": "1910051799596938", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821099_1910051802930271_5093697632380196663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MV8eg8mGuQQ7kNvwExrkoW&_nc_oc=AdrG0OJkNktGGHex-TQZr-NQcxNjMgksR7iGB7DegINNWBtCSJiMijDkqswO5VRKkBA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2_rfK7bDxJoP4dCTsO6m1oGD0DzM-asV6ptsSZqbcwLw&oe=69F1FF1B"}, {"file_name": "com.glocksoftware.horrorgame-20260114-103557.png", "id": "1406115264546505", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818860_1406115267879838_2631368577935749496_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnJc_2VNxNoQ7kNvwFEEQAa&_nc_oc=AdrXCqQiOtB5qbNQJpsut10YR3AYiaFtwRcTDwqD3eYYbcpnSDaqlBfNyhHIw4eoFmM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3m0fkah-T8ZIz9uuAr7uV9ztgVMXIHVmDCWWukvdvJPg&oe=69F1E6AD"}, {"file_name": "com.glocksoftware.horrorgame-20260114-111655.png", "id": "911517787897938", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824307_911517791231271_4588332304987211788_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVquImTnEJ8Q7kNvwEbYeYL&_nc_oc=AdrBxrthcPhVCpq6FTvMIoowae6a_4heAG35vXR0B2UA6BUu18f-_ELdj_qlPIxyk_o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jeGr6G7tN4Es6Zaj182HAVNRsrO4dLxAEIv59QXTL6A&oe=69F1F79A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-07-18-14h53m09s181.png", "id": "24523165587385059", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821115_24523165607385057_3752300522125326141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11QGhioRziYQ7kNvwGQJFjN&_nc_oc=AdqIswQGf7QFqiFtZje1htAFSf2Lh9Cr54AHxVTtF5T3t6SCV8pV79kIrN6n7Y5brY4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af19wdw6xc34mhFQFleuTY7eFG_fS4NU1p3o15ZG2pj6Cw&oe=69F20A40"}, "display_name": "Forgotten Possessions", "keywords": ["horror", "stealth", "survival", "scary", "psychological"], "long_description": "**They say some things are better left forgotten. In this cabin, they are hunting you.**\n\nForgotten Possessions is a raw, physics-based VR horror experience crafted by a solo developer. No hand-holding. No safety net. Just you, your flashlight, and the crushing weight of the silence.\n\n# WHY YOU WILL FEAR THE DARK:\n\n- **Ever-Changing Nightmare:** Item locations and scares are randomized. Every run is a fresh descent into madness\u2014you never know where the next item hides or where the entity will strike.\n- **The Guardian:** A relentless AI that listens and hunts. It reacts to your noise and tracks your last known position. Silence is your only weapon.\n- **Unravel the Truth:** Explore the cabin to find hidden collectibles and piece together a dark, forgotten history. Each run reveals more of the story.\n- **Scoring Mode:** Beat your high score and test your stealth and survival skills in a franatical collecting run!\n\n# PLANNED FEATURES FOR FULL RELEASE (NOT GUARANTEED)\n\n- **Difficulty Modifiers or Difficulty Selection:** A new mode where the AI gets stronger as you progress OR a mode where you select AI modifiers yourself. ", "short_description": "Find and collect items that tell a dark story in an abandoned log cabin, but watch out for what lurks behind you. You sneak through dark rooms against a relentless, adaptive creature. Forget combat\u2014patience and stealth are your only mission. Experience a dynamic world with randomized item locations and a reactive environment. Evade the guardian as it reacts to noise and hunts you. Piece by piece, reveal the chilling past and examine items in your personal safe room."}]}, "developer_name": null, "developer_privacy_policy_url": "http://glock-software.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Glock Software", "support_website_url": null, "website_url": "https://forgotten-possessions.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34869540419358573"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491828806_757552057010990_8479664881330519934_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSOwSMc1hFsQ7kNvwGyPAF4&_nc_oc=AdrMVUOYsmVRBhwqbvmm-LAlDTKwcXhH2V52bNe9eVvabcGBaKcpEP4IxihDCiCFqns&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lYfNLvsifTTzGCBC9LdnBpMYRO9Ak-0qXsVl9y6F-GQ&oe=69F1EEF2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Forgotten Possessions", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1772114400, "lastRevision": {"nodes": [{"id": "24809058138740235", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24809058055406910", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": 
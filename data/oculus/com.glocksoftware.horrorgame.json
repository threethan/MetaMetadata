y4cd0RCDVzf2DEn6zHHxYRl2UOTTU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBttgHlDF3PipYqbi6QS2cP5Iaie_NVNHoTRuY3KEpWFQ&oe=6A69E440"}, {"file_name": "com.glocksoftware.horrorgame-20260114-104346.png", "id": "1910051799596938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_1910051802930271_5093697632380196663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzSJowSbW6gQ7kNvwHk3iJN&_nc_oc=AdrZqLSqNLjQbM9fBrx6-4wZKvFCMxzjlgExhuEjSWUtEDN5xbvvOmMk0py3kpko0vQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFA8lyGzzJbgksg0stLKelC8fbjq_o4ycRw92JtsPTkA&oe=6A69F79B"}, {"file_name": "com.glocksoftware.horrorgame-20260114-103557.png", "id": "1406115264546505", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_1406115267879838_2631368577935749496_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GofBi1kTyYMQ7kNvwEVfxrT&_nc_oc=AdreT42Q2WXGeWI5LPF5A2J2_d3z2DKGAj-UVMLcEWfnHGCTA0_WUt9Ub2RuuNYFPXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPhG8fu88Vu9zEjmCHuFsAR-ilPMup5Uxvm73BkMO_DQ&oe=6A6A176D"}, {"file_name": "com.glocksoftware.horrorgame-20260114-111655.png", "id": "911517787897938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824307_911517791231271_4588332304987211788_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHrFg01DcJEQ7kNvwH7ueAw&_nc_oc=AdphhMSU3bxLQKl5rL_ddnMc0Np9bgZcEUqWH3Zs24oeRAfb2HqeUV7zfpGHU9mh6s0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzFT5ky7winXqgyUJe7AAJVTG4hI1dmBru9xOPdKcmeA&oe=6A69F01A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2025-07-18-14h53m09s181.png", "id": "24523165587385059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821115_24523165607385057_3752300522125326141_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWJ1Lf3usmYQ7kNvwGbsCx7&_nc_oc=Adre0m_UdjQv-uafyHeToj224_rAuE_veFm1mXi0GZvPwY1AssbuWIOtOBfOa5J_miQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQmpWQPngTmM-6MAE8JJqSNzBbsqNA0XLstX6WKnXLvw&oe=6A6A02C0"}, "display_name": "Forgotten Possessions", "keywords": ["horror", "stealth", "survival", "scary", "psychological"], "long_description": "**They say some things are better left forgotten. In this cabin, they are hunting you.**\n\nForgotten Possessions is a raw, physics-based VR horror experience crafted by a solo developer. No hand-holding. No safety net. Just you, your flashlight, and the crushing weight of the silence.\n\n# WHY YOU WILL FEAR THE DARK:\n\n- **Ever-Changing Nightmare:** Item locations and scares are randomized. Every run is a fresh descent into madness\u2014you never know where the next item hides or where the entity will strike.\n- **The Guardian:** A relentless AI that listens and hunts. It reacts to your noise and tracks your last known position. Silence is your only weapon.\n- **Unravel the Truth:** Explore the cabin to find hidden collectibles and piece together a dark, forgotten history. Each run reveals more of the story.\n- **Scoring Mode:** Beat your high score and test your stealth and survival skills in a franatical collecting run!\n\n# PLANNED FEATURES FOR FULL RELEASE (NOT GUARANTEED)\n\n- **Difficulty Modifiers or Difficulty Selection:** A new mode where the AI gets stronger as you progress OR a mode where you select AI modifiers yourself. ", "short_description": "Find and collect items that tell a dark story in an abandoned log cabin, but watch out for what lurks behind you. You sneak through dark rooms against a relentless, adaptive creature. Forget combat\u2014patience and stealth are your only mission. Experience a dynamic world with randomized item locations and a reactive environment. Evade the guardian as it reacts to noise and hunts you. Piece by piece, reveal the chilling past and examine items in your personal safe room."}]}, "developer_name": null, "developer_privacy_policy_url": "http://glock-software.de/privacy.html", "developer_terms_o
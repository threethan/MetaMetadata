2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhhb-z5qfAIQ7kNvwHtOolD&_nc_oc=AdpPDFLLHKpF4MOV6jVhDaXzoAZjq3OkUW4CW9rA699oKwxTnV_TfffOrnaXKb_IET0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDkYy3Fixqb7CkP6mZnxjfpyM6cVOktHXiXV1dlDxOnA&oe=6AAD2B5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFATbs_vZMMQ7kNvwHPuEPL&_nc_oc=AdqRwaN9Qj2S_jXLH9DGmOV8P16S4kwiwnXfMHMxvHc93SzqqE-CYn85NwnFfxXKK_I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwMbYQuRUUfeAw6gGstH5aq45VtSAhGKu0G-GHi478ig&oe=6AAD3DA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMbeMS4JpzwQ7kNvwFLALQt&_nc_oc=AdoYTCDwURSzTgRYAFUMWNDuxU0tgUPVST8mTlwq4v3Vr0NS4eqqty1FggGeFayabh4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpYiJ7zAauybLLWSxcHwOLNbJ32uBov3FYoKV6QUgQMw&oe=6AAD4347"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLkVoDWKswgQ7kNvwHA37L6&_nc_oc=AdquJZnppUXF50erUrITCncObFxsUfPzHWZXptH-SGaOJ6K8aAK7vBOx_NaBnr0f8Zw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjKktuu3ZHJmBNJQCcnCEfTuWe6MTa1-5KURYhjoABoQ&oe=6AAD4638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXLZWgGlCC4Q7kNvwEDnWwz&_nc_oc=AdqIBxV2SvzK3hwa0nXGznvgcLoZNOwRmCIPWAfZrYZVnjuN7i3esRoHTL-zAKm1iBk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR8iM-OUr-zfhGcks9y83YBGc2qAGbkQjXmqHwMjIiFA&oe=6AAD4886"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
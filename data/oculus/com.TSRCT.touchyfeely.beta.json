2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uG641hcVM4Q7kNvwFaPYyI&_nc_oc=Adpj7Du0uDAlLHcqfgpH-VXggjKaHVAhP-FzpqJzJEk5BmlWIJfGwnjZaBXAu82JJ-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyRLLTcz4s4rzAHsMUkiKUvDZUwmfuTRGwKEu2K6-_ag&oe=6A771DDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9paQ1CZy3aEQ7kNvwHC8Fkx&_nc_oc=AdrnkZjz5VWS0wScEcrftvAp8hLiSzAhbrZb6rlegI5hLmx4muaOSOCShln3hFqqvAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDY6EzI9dfhuwb8cul0vSsqvymtVU00wAgVEYB2XFgfw&oe=6A773029"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wupw5egF65UQ7kNvwEFjsXV&_nc_oc=AdrYydHvuKor2RRetLhQKCrABumD4rctFPDLCORz1o1vOjX8omy7LzqULY20wRFwmiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLpUwAptMN5HoiaDFiTVfj-QUg6JkcafbEpdAT9zLntQ&oe=6A7735C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L30vU0Xo5l4Q7kNvwHO89so&_nc_oc=Adq0oXS44a_HksoYEyHViVLkHRMmNscMW-JTs2yk6-QcmhMImhdCQf096Fc09KGYcrY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIDOnBds6x2x4RoltYGHbH8a-Tox2Etq_1HVX1tphi0w&oe=6A7738B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9tvjSeEj8kQ7kNvwGcUaEw&_nc_oc=AdqS4869y2sG428Qx5SafezxIIee7gjK-gbmPmqSRHyQO2-TNu0unZdqc9Xc5r-4obk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOzjVnW-hLoOSAN5vdKlp4lgxD8KD6EtUsZA6diK-DFw&oe=6A773B06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
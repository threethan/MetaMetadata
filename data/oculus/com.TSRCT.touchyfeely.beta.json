wGkw9UT&_nc_oc=AdkBOndrcFBO6vmiGj1dl7IT0ZESjhIdgcXqu-pA18bQMflAYJv_jOrWLLj9c8E3Nq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsIc2fV33PbZcRQGJ6fa96Ge0KYBKmZOd5Eix_krNAQXw&oe=69A6D0DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9H1qvDBDdEQ7kNvwEAAjsi&_nc_oc=AdlDwTTt0wT-QKDmDIZwHAIIwho89oukMnDVREguDw158fmEoytF4V-f5Z57SnMuDZw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0JVa-0fuvoGptcu9SWkq_wAWP3A_mKUkfe0fhtKTDfw&oe=69A6E329"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaPEZKUiKFMQ7kNvwH4js8j&_nc_oc=Admn8FwEjyMPh1hYXEo4jaIxW184XyLRZ3DBMaFOdJDaPecNcJvCAG1-Nz_JDU437fI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsG4YWnigFppofhegP5wBXsoMScXo469jCiQHZRD-no3w&oe=69A6E8C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQg0d7_vTPsQ7kNvwEq5gmt&_nc_oc=AdltTgrnZBjC10hXkXgBqhbW3QohQzuhl43xVIJ2hCRmfHJuFwRd34SXAUMFtcqQSB8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4_3uX27CEx30TaWUdk2x8ncssnxv4fcWWHQfF8QdpFQ&oe=69A6EBB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1Tu2QKUtscQ7kNvwHEnm-I&_nc_oc=AdlS5FdBlLf00L_V5A3wgBQcazCowRlWMo-C0sKxUb8H-X8FVg9D01NQQ5C-HL_sUiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftcnMWMqNKPE4J72Cyon8qV4JslL4pkQM1_tQfFopjIpw&oe=69A6EE06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
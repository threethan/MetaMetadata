2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXEdijKNfAcQ7kNvwFPm4Q9&_nc_oc=AdrK_D4JOTenx6dOeTIjpRis-D2phhtyCkQPyl6CiPYd7F7oqxSTXZtKe-4gTi-Wak0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_hf7lK5-q7uafigSYMasQmsg96uJFjNgZrU7mtbiQUQ&oe=6A070E5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0li0Szed8CcQ7kNvwGReV9f&_nc_oc=AdoihYjtv8eDndrtYEaWh-jNJb83iuOotsF6zKSrfLaagLMjfQQ7CNXtt7mry5twUJc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uUukNR1dz1ptQDW5iPnGHx_a4LztpVSXEuTBIv9LVww&oe=6A0720A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYlwsi5ou_AQ7kNvwEjNyOM&_nc_oc=AdoYlG5G3DJpa5l1xQNoVj4moo_sVzfgtAq1GIc8oM-N_sRpRdF8JVz05bm6VO_ytxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VsnOg2U97Z7jsuVt1BLih-IGpFy_kYD2DxtV3DH3ezg&oe=6A072647"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNk2kavHQ5QQ7kNvwH14o4x&_nc_oc=AdqiCJtd-OOuRMH8_jLL_JWBrW46IZhrQIEV1ecyREx1HcEya2SZfXLxCMECvkgnXgI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PzkeZsQq0nJWi6U3IDD-SBFGwLFClxPSgb1lLOqKVVA&oe=6A072938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiw47315jvIQ7kNvwERkndE&_nc_oc=AdqrEkLa2I9LuYYDMFzZhp2PTdAh1toQDjlRr4vxQmPKboIuYXS1B-saPx5FWEairSY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kr_GLzE1Ox8bsxBrDictKcecU87CB-gdCmPL_opFa_Q&oe=6A072B86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
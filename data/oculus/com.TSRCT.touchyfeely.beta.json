825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiIb_PeifhIQ7kNvwHuql4O&_nc_oc=AdlnaE94iawx4HUi38wFyxFQ-hRXwKjtbaO_srCPAnXfwsG87svtnwb0HWPyxYD56jA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQWUYbfAsD8KuAK4451p7t6Qv5fDE1K25p9poOi5vAiQ&oe=69BFDD5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r46O7G9KASgQ7kNvwH3-60Q&_nc_oc=AdmcWEXgkkqN6Oqw1wY4LPsTtw_VVcgRvPX-v8dZ-fyZdsikd292M2TFfqKx8wobAtU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzPCIyrWn5pvhVU_y_5X_14gvIIIa_3cWs2r2tF7XNkTQ&oe=69BFEFA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCR9o0qQN14Q7kNvwEhYX5B&_nc_oc=Adkf93f7Q7TBM1x0rJpVPUMKmbIWjf-515dyCaHuUpE4N-VPjrgVu2ZtnSSDLO5JKY8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfznuTue-vnQEnve5QY_nWEStmSio25sm9Lw6nGlgyp-Aw&oe=69BFF547"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJC3SZnZ9vsQ7kNvwHDsIgN&_nc_oc=AdljUWv9Xv8d6Ghigj05mpS5p80Q2Ukt2W4p_C7Iwwv9X4dUTqpPvNxxyGXo9SwA1BA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgPk6n25fYZ0f72qIASxpaYcvrZEKOkS_gy0QjG4gdwQ&oe=69BFF838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aH3Hc1djwsQ7kNvwE5xtsa&_nc_oc=AdmqKDMaZNOvKbWUzR75XlBGxbXL6Rs6e1WI-OWwfyUMjsxSsM2gGoLrjvz8Ke3YI4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxz8Goq0my7SXN93GnFeylLTxdxlwcra9KPAAGHHZAtCw&oe=69BFFA86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWA8_n0sNCEQ7kNvwE318G9&_nc_oc=AdrndMvsdTID8oK9DAKeaCQs76wJuUnEoEvh1x16bUhyquN56M5nGaKnWqbodPnO-hI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BbN_XC7MutFt1qOUWNiOX00i4qRLzueGB5r8IefwpZw&oe=69DE2FDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWPfS8xqD4IQ7kNvwEXkkD5&_nc_oc=AdoV8eFsHXZrMhtwnbiM433QbX7tWymLUakdsJsdhsRbvWsdGuO5RfDm2NBK3En43_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34nXvHzo2jR2p5oKRlCZbBR3gOOBk3fi-HZyX0i_n5Lg&oe=69DE4229"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8DwnTNQREwQ7kNvwHMC1fm&_nc_oc=AdrXHxZIKrakpIeduifATQ0A5qsopS5T-1CxEwG8qfV26xUnIfCb3YxJFxlpxV9KKPc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kcV4h0CQfDHbF4jk3WdhAd-vmqg3xNvlUjEm57fMdHg&oe=69DE47C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQ12UuMmRAYQ7kNvwHkOEBE&_nc_oc=AdpWZqGJH42ot1UPnsTslcNAReqQnof3Ax668J7APsvbCXz2Dv7V2Vc-mkuvf3lUXXU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11obT7MGk7zjIaUUu_H-2LhwXtpMvm_prQw0D7RM7YQA&oe=69DE4AB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3M1ixU-4nIQ7kNvwEIDCc0&_nc_oc=Ado52wFbAjI30rPboe_gJSwVuTZgYrYZBokDVa0I_XmEfVEdpBKUPPpqdmkIBMTB89Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TKvOvx3xUrhp_nUD6OFNbHW0tl_yEXYE_l6J3ZifLOg&oe=69DE4D06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
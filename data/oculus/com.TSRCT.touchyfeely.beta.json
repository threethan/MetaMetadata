2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcSUT_FZfwUQ7kNvwEKaeYQ&_nc_oc=AdqYgHwaWwTT-xUcRkf23qQ9Jb9zCYATBa4DmHA0UFPgArcG6UyCKRsu35mh7vxB7MI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa_XJVcergOJ_2KJ3mmYdmZ3gPX0Euv_MpFg0EtM_UZg&oe=6AE48A5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkmoxu8aWlEQ7kNvwHOV8eL&_nc_oc=AdoHgN6I2E0mznzFZmGIawFP5DlE6uqRDO8hE7dEfdYyCb94iiN8ETpV573lg-ewpIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT7OL_KvDhF9q9ctMUUE-D441nDJFzC7ubzIbbUCBVBw&oe=6AE49CA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJoPU64agL4Q7kNvwGudJ2D&_nc_oc=Adq3uY-Js7M5Y1iftP-EpEyRYAgs6aukKLCgIunKPvvkLwkmXt91-b81rV1ZMa77cg8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTdf41fXktkbN7rxS8baL7JQtnGLUdCwNUthnz8JDNrg&oe=6AE4A247"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQhejOtjXasQ7kNvwHkkT38&_nc_oc=Adp-XHCWaKmyr6PoJiV9h2jEpXwYrP0JZ3mI1oTuCF6FsPSRYmbsQqjswNX7jceC13Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJH35-9CJsXxQmHrMKX0BhpLs_h1tB5BJI2lTTL9jCQA&oe=6AE4A538"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIBuw9CVQuIQ7kNvwHb-lJs&_nc_oc=AdpYnxnqFir4s_DuIW4YkLU_YjdBl5fz9DOTRxjhIPxQMKfxxLIk5NLVPNrWp2CjKO8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuu4Zwlyu3ZQ9UVAEUiEKtiLxN6HLQxY9V9ZetUo828g&oe=6AE4A786"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
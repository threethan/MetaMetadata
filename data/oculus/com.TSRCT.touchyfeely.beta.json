2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdKBKg_k_VsQ7kNvwHKj9hU&_nc_oc=AdovKttVQCfCEDjwUdp1OY5hnZHpR9UBhFuGazbvHPzPGbWKIqKXu6HCBe6i5sJ7rCo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IdXn4-6oQP8IRrCRrsrzwyKz93_sR94GKy4sRJ5ThFA&oe=69DCDE5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWPfS8xqD4IQ7kNvwGxslJD&_nc_oc=AdoIt9EZUgrrl8ZPgU52tv1XsTlTDTDmWgAI7AMe9gmW9L_k4PiEtPR_aAe_T9QPWLU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3r7myr5B0Er-fdbOpkxs77Mvv6OVihM5hlis0gGke-PQ&oe=69DCF0A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8DwnTNQREwQ7kNvwHjpNv1&_nc_oc=AdpWqwTi_YbUE2vlYOWY3fB22E_Xnml-1ncnucNMtNmNHHW01tPlZ-jQs30TCRvs9wo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2f5zHZWAQgpsS5NP784Ujq-wKnJdWDWDIO3k5JjOVJ9w&oe=69DCF647"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQ12UuMmRAYQ7kNvwEd66F6&_nc_oc=AdpxwjrSEQlD2EU13GyBsXaFq8Im6AZTV0y8RDHSEjM1d3X2meRnz6kBp9mR_XHWHGc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rNUwH5xuyAMJ-X3asNguF5fglax8_6-7mKUUDFl780w&oe=69DCF938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3M1ixU-4nIQ7kNvwEa5AN6&_nc_oc=AdotlB3Kk9Q2jqstnwgw0w133uWLLLxmBdfDW3WkhiN7iFIr_DQdx22A6O2VNQUK4-g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nlw6ZuTjDiSmd1IkB_jirzzXjdDUrbipiHsV3RIzUfQ&oe=69DCFB86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
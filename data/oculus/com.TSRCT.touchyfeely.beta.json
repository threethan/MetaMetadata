2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R168YQSwJVcQ7kNvwHca6yY&_nc_oc=AdqKV8eFRI8GH7LG7VGuDVu37QcOs05X1b6eRqKBPrV2ywnocZFqg2ihOFwaN6_Am0Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlFuCwmYqSZAWOCMNKrMcW0VgVMrBwGq0mM7yt7UUpkg&oe=69C5235E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uR-xQTAwGwQ7kNvwF3iYXK&_nc_oc=AdoZdOvMoF-n3o5Y-5l2zTAmfaoCGGmkZLmZIwQ17Lknqm9NsrI1nNdZE7Xgmh4Yq4k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXY-8z1uqXhd7rm2xw9lsI5LBWtjCz_Io2eWuKD2gxRA&oe=69C535A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STXWgSP6ZUEQ7kNvwGE8lqm&_nc_oc=AdoRyHmZXCe7qRoWxmRKhRmcOnA9Zc5-6XVFBhDZOMPJJGYz0KsuaxQEcrAQdp3u7mI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGeN5paojsRHpdYbFMMQCi5W0lc6MJ304KlQFnX9f9bw&oe=69C53B47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aisJMzMBx8EQ7kNvwEYtmi5&_nc_oc=Ado63D8XoG9lRkIrIAaSXcRESIMScjUMqpiHukaGuCnaZaB4roFURtQ-5-9SOBv_Zb8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqNdQH0XY9FcuNmoMuc0YEJZO0qfCOkXCdJoVcoWDmtg&oe=69C53E38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwBfyg7gBRkQ7kNvwFe4qCd&_nc_oc=Adof9x-LaHf9ulCzO0JkFSbVeX0cUKvVVAf_T14G4mHzQkvl_vA04y0ofxU6tjW9cp8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwy5m8uiTMUILN3oCqhGDFmUIy0mITjlxwQ0oNKYi_bbg&oe=69C54086"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
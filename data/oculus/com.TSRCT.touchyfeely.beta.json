2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6aTBWmdvesQ7kNvwFLVFAV&_nc_oc=AdoXISIP4ON98wzQoUbuB2VnnryOs6adnt9w35Zee1eiFy1R3KbP8ceiVk6TggtJiuc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEwaglAr15gMLlsIB0r3LCg21Pv9dgkifLsbXBRMmNYQ&oe=6AB7EF9E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcnIFFmfpGoQ7kNvwEWxrCl&_nc_oc=AdpezntkLWAVMBvktx3izO6qSEIz4cP_fChOdeRq5aqGi-ujLsRc0VPy27llqowhZSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI47jb9zKB1-5UUdnCu7HrsMP0Eh1VMISHw6f3mCnTiAQ&oe=6AB7C9A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2We6PLWnqEQ7kNvwE4lJEK&_nc_oc=AdpoOHw_qjD31j17zXs5mPz1L-PYJyMdnQ-FwXLaMHKgbkTUTaVlZ6dYqk2FH-n7aKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVWnkuxJKbvQqdCPlLGLlYdwrvpPqtbZBV1P1ENn0g_Q&oe=6AB7CF47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1BC7Ed82ioQ7kNvwGLMZYH&_nc_oc=AdosD8DOvWo7yN9KzGtpk-KBcr2ZzhKEjXwVzpE3IbkTB3IgE37kEoFaN34duHx96wc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnmJONancc76152uFccI9WzzEqIhRJ1vpfdkuaoPg7-g&oe=6AB7D238"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZ1yp7ntWrEQ7kNvwHB6ULM&_nc_oc=Adp80as-PHANy1fs0srBazkEGmNPOQYKJVs0s377RjLL8zDkNDhEgCiz4NpNNxjCK7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOUl5ncuy1UYjJfNjo_nunS1NS8J8NY2tk0aA8E04i3w&oe=6AB7D486"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
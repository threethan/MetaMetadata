2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMlR9AdUylQQ7kNvwGsaQS0&_nc_oc=Adot97TJXtzIAhurkoKyhsDawLVYb0yw3vjYUQpdqUYDFZvSKGAVWsWb-xOiudf_6YI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3lS4npIBtj0zLjr-Kt24vu6uwDe1yVQLoiFBOLNuULA&oe=6A41489E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKO8FKUrOycQ7kNvwGj8tKq&_nc_oc=AdpY7RSHIzryO7nDKzbnNjMXZWQWLdKUt4gqKSLhvQJ0-oQsZcbiEtUxN6Jv1iUjYHU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mCRYbmBT8AzTdk_69LDoTtUUbE8YsYchJ3sBX5BjhsQ&oe=6A4122A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waiwKBpWbR4Q7kNvwFDzkNz&_nc_oc=Adq9msY50tYHdduPHxzhJd6x3eQ76wAsf5xa56mzaE1tEriMlYEUHuWLhR5aAFlodlQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kGdLuly413pPFoEk8WtXrV7_GXkRLJsBSw_OwU8XMqw&oe=6A412847"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAm3dkAP5P4Q7kNvwEh5vbs&_nc_oc=Adopobev4Vp6kDuEHPy38MO0Kt1M1UtbukFG8_9wKnXunBaqApwUwBiay3x8AX_yDLY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fkyb7xytyEiyDPaWcDCHJYzzf6_qfwvZKsW0FFUFK5w&oe=6A412B38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHwsL69lzKYQ7kNvwFcvw3T&_nc_oc=AdopyCkIJf5g7-n8c99PQ4Pr1tK9-aaBDUc79S4emvc3561K1eUhfnIUO2YYo2mE-Z4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EsQAf5OmVVVaTLeDt9RRNuWCClf1gYPzCzYJ0n5nfQg&oe=6A412D86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
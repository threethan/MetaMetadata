2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcSUT_FZfwUQ7kNvwF0kjmt&_nc_oc=Ado_-PALowLA5egLZOUdKrWUgJa3bgLR0V9oP9y7DuvB7e7IgjNIumUAZXC7a-LAjYE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeZ-UdJjBT-GpmhSKpdKAAJhGLyLfKHGUuFuFcx19fQA&oe=6AE6141E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAtsMt5emCUQ7kNvwGrVCI5&_nc_oc=Adop3A3qlnzqzx00FJaT42ZCpU1yMK5iB1a5JrEFgjNF2IjWMge0lOL_pzyQuFnuiUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM06lSFXufHpc7X_YAMvRx2VwQEY7MmVN4uVaRXQo4Vw&oe=6AE5EE29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tkgvKhtLvIQ7kNvwEYCwCI&_nc_oc=Adpc1kVM3qUuqUUp2xPOAaDPJKO3UrKyv7NG93X5A829UAeAIHNCy4ro8_BrOnK-L_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXZ8OAZg5WpYjS2AXiwCa0kfjcJWVZJJZokh9PSslUbw&oe=6AE5F3C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvC3eLscoS4Q7kNvwGvKAwX&_nc_oc=AdqUHnLKyhDmM94gWzLn3YOYZcrMEiWRMnB67PkypLtKX-x71R0_LxyjGftPjDoVEyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM886_gLVDSw73vCEvN7chqlO6gBR1szJz9BYoELGzvKA&oe=6AE5F6B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIBuw9CVQuIQ7kNvwHLMQbk&_nc_oc=AdpDDq31DYN8SIV4xqdYe3uY0VRi9y2xeascDagrEu3dhdxkoM6w06_-85JinjbS6UE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMONQQIEwogtAGXOASktOOB_fpkldPirc7sYOIqXtFM9Q&oe=6AE5F906"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
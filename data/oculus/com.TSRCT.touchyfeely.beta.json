5843_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwWnNZsBwlcQ7kNvwEZIFgb&_nc_oc=AdroRTIRZt-yb3SgPTB-BX1oYne8cSAHY564e3LqHtCoQCRKyBbuIvm7zHjj8UuALeI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTOfYy2E5VkbASVLPR7Khdtlu9bEsTDQQeIPRs9BvOvw&oe=6AFF209E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5E3Kh322w0Q7kNvwGm5zAP&_nc_oc=Adrka2VPv_KGAObbeACNJ0aUw55w4b_5blmGKxfWG6cMsyVkziNExVERh-pEs59I7eU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWDGPTaAIa0iYoHyY0T9bwj0eswLKNOv3sT7S0_J6sqQ&oe=6AFF32E9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vnnJRvvSD8Q7kNvwFRj5U_&_nc_oc=AdrWDWViadGqzsPvR8JUOQhqcJ61DXAOafeeqz8V7260RtN-2Cjjt_9hEE7Z_10subY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbSuxknDAt_TopwiJMJrCNDMNahgT2Z0JRDY-HDa83SQ&oe=6AFF0047"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XM5j5qfydQ8Q7kNvwG1j4H4&_nc_oc=AdplOj086l30SUhXa8warc8unAe9yNk2GaipJaRxie944kVz_knLgpZO3I8oF5n_7MQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMu5nifkBGYvgIrfbe5igJu_aFLdUFaGfuwabEMqjrHw&oe=6AFF0338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4EMwp_XQToQ7kNvwH23zzV&_nc_oc=AdpcgxVIU4q_Js23UoL3IMkMbCL4v6gWO0nIVxW_kOS56nm4cDX1SeL1aA0wbfjrHCg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtwHbRbHVRroxAre7q6qsK0CgPA-Gl4TwPKWIpSz211A&oe=6AFF0586"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommend
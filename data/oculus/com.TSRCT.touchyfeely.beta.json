2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlPKBEQeYwQQ7kNvwEM4lTz&_nc_oc=AdpwLs2DUsIzQe2zGN390Op_FwmBVtEns820uzwZ-EUeYY3w_nuPZThr8FpOzk-wHOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMBiJ55tIXSHL3z10CEyE97vqye45bgLv84cD2zMJ3qg&oe=6AF1F19E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNk2rMeaaRUQ7kNvwFMROis&_nc_oc=AdpaBRl8g0QeG2s5q_BMFjnsA2JLC_iL_Zx4cUVbAZC2K1iJp1PSKBO9LYhOnN_xVZk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTdHZrWDf_oJO7gwn5V-UO9n3_0RQpR242o_wRC3UqNQ&oe=6AF203E9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZ1pL50EcLcQ7kNvwHtqhcz&_nc_oc=AdpPfJAv-uXRRE1z8UGKFyGLHmp-RK6guAXFKke7WnDGTCoBq6mdyHdHZ75std1y8wE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_hAIYpoKuRLa4PsRGQoVCOlJO_tv6Q1Es9McBlxHz3w&oe=6AF1D147"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTql69CNyqIQ7kNvwFjVXi-&_nc_oc=AdpnKljWOZbpzGzkYePriV4hAcDkRuiEaKs_X_DsnzORFXNRAZt7QGxHn2lLuL5ITcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTblnPAVuN6Ro1iga543NE01hGyHynAB0lEclaGypm9pA&oe=6AF1D438"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d_xMDe3wo0Q7kNvwG7zCIm&_nc_oc=AdrccBMCVtGkHO0J0ciBDKZgujL0cv4JnhWVNUIs1-YKKz_r3XbUqzKehubkqTog4cI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzQxR4HENS1vhe3qCP27tmZ1R3uA2AGU8oFrIeYh1CGA&oe=6AF1D686"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
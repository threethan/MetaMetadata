2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4BThQaY3OQQ7kNvwFWvdYo&_nc_oc=Adrsv1Kn7cvylZmmd0gvEHGc1Le3jgNxjk2iuTWqtrGlEjgJamL592knfm33G1huYCE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfVUghunDsfa0Cz-6ry58ynXQps1dtZ4Q0tHIbSi4P1Q&oe=6A71D7DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_jBAVjPG-IQ7kNvwELVDRE&_nc_oc=AdqKINKQQ63JUHYk6U46zwjqv2ap7VYEmfimOmhhc2DIXOyNVqQhMGPP3N_lD684JkA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZA6azRHfp8hrmC_lGL6EaQpn0CJ0o7NVf7wkPj2fywQ&oe=6A71EA29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h-G52B5qmcQ7kNvwHGCxfG&_nc_oc=AdqrJZgXxGnD9mX82giQqHLUw1pDOR1zpp-2iybX7LxdXbQoUB9AfBl6Z_Q6KCiAo8Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdgLuCGPZ1y0x9njpg42sDfxx8My4UXPwkDuM_HT4Jdg&oe=6A71EFC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmmwxL8aZBUQ7kNvwHWkA9i&_nc_oc=Adp7OVJFraIaOKXoadMfCtTzoB0iw1p1cZ1t06vaqio9i3YYN2itTTNv8JUjn9sEQS0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd4t0zXZ0mvT2tkj5pd5SbL8Q2SmvHDDXT2_nngZxGWg&oe=6A71F2B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ct5oDZbFRqoQ7kNvwEDxUpT&_nc_oc=AdpFVB3eoNSdVqK0BkbERWRiE3_6AKh9AHYhhjm55-QFXhiVzm7OKJHJYBz1y4wdQ3s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgLkhK5nJevQCz5FdZBh_-tGnzvv2m9PC_SmKfhHFJvw&oe=6A71F506"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
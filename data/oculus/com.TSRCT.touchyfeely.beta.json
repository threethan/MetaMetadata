2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_hpkMGE2xgQ7kNvwHYGGdx&_nc_oc=AdoMUclrPVyZ_YaRn5g5lQbD6VmHfwhB6DRDI8Dn1RvWIuWsMiLzYYPLPgm8RQQULhs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWWxuaXoMZyCeeiJfWqTXhvL7N3eGXfHJ1R3wSTGxU-A&oe=6A82FB5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZZmQymQT0wQ7kNvwFeQuSJ&_nc_oc=AdoDFJgt2SmyMzhBFCsILn5tlOJ3xEEmCJiqd_yIPTBpnxbd1iYhwyeXtGFMoDH7JJs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7BmPSIwhiB3Zn6B2gSiwNGr3XDmQTUr4benZWS0keCw&oe=6A830DA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbbWEzH-7DAQ7kNvwHGTnlY&_nc_oc=AdrKL6pHGcAuHtDnopQ-xgd2k4p96RMzzcYGc_R3LfJ_vJPZCbt_8_vV-ppktq5owyA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZUfccUAgWpZH0iK2e6DWXENwsdxnAWq_tiJFNNH8E6A&oe=6A831347"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQE918qp8B4Q7kNvwHI86VI&_nc_oc=AdqEfBgaFGPqbk-lcy2PZAgziLNQwvD0obzyi2wZe6bi5AhYJwZGHXYBPqI2qqiI9k8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbm0or0uFkvsrgM6JsWqCdXrogvoorWwexWP9SzYBU8g&oe=6A831638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruTFBVLlt9AQ7kNvwGvT8Lr&_nc_oc=Ado7lvRzoK0bXEgX4aG0TX9WAoiZJP0bAOMFubVkUEysAp6djrVXsCQDFnSIKIUrOZg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSXK64oRP6oJkuacTDfp4hwoYpmdZr83hqlVVAWumn8A&oe=6A831886"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
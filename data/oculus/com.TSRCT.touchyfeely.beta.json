825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZH32x7DFntAQ7kNvwEmo9YS&_nc_oc=AdkTQThQQhXkjsR1dvShtpEokCJ3gCXTvBBlwt7qXAX33b6zq1DfRGQ3vw15W7m3NY0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw-AcbrIltQ44JYqAxJ6Z22gDTI6AXx9leQk3KOOYsuTg&oe=69B3FFDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MrMiPQ1O58Q7kNvwHDdTRH&_nc_oc=AdkEYzpayBu82XQEFrTZ8Lk-Nb63OVZbFJccj_3bEfNxiX0_8KCOPYs5_4jG9UrYIAs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzO0W1OxOv28SHgntutlpEThdOAhHCxAqlJiRFWZ99UhQ&oe=69B41229"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsvukDr3vXAQ7kNvwGeIgHq&_nc_oc=AdlRcpaX4pb06oaN0jSC5GRo232h-U4SW7J8SAzfFpCK1D2vidIneWzE3SmS1ZpcfH4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzBg68KKt9BKRWbxSFFHLtXeSkouwwMIQLK0DQ86jhVUA&oe=69B417C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCuFSxUeWIgQ7kNvwGhKMGg&_nc_oc=AdlW2lbJJ1u8QdLsIx7qSAthUH_5Qq8KIIDdY_s6ZMDLmlyexWkVuF5R1K1PvTv7C2c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwK1a4krdfsw3Lb5LU3y0xvXhBMaNkrN1RVfQQCsqPN4Q&oe=69B41AB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxDjtInU-qwQ7kNvwGbU68C&_nc_oc=Adlqr9-1su80xo-gDzQkOpeO5qlLstzv_-oyvGpNE-j5HXUGlJalLe70-AsSuakXlJc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9JCZXQygdqGsDp2Jynms6ulFKKZ7MEn4lItmT_vrmLg&oe=69B41D06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH
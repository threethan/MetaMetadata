2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqtPhIOggRsQ7kNvwFbJOFJ&_nc_oc=AdoJRbYlTp7690Nl5BkfG9YTE2CEbEihoEqGjovFeB3ku0Vs7XqsmnpwYkOvSsRR4PE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs0VLmSKCCcMWnkP13VC9-dRT3y4D5ykZQY2ju00WQpQ&oe=6AEDFD1E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtGe-fFSq0sQ7kNvwEU3Rab&_nc_oc=AdpMEjXqXTZ7PoODLAUpV21ltC_1zJlkVzvUjZE6JG3TMuQd3LYpe01pfYWnEuAd_UM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBsbcQ4MnoJFQSFInng7a7Ov2k5DaX-hdFpxMuBAOTOg&oe=6AEDD729"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BBqmLlXaawQ7kNvwGIP_0C&_nc_oc=AdrlW0meJTMmZuTPo13up0E-Xc1iJ6iNnD-FyipEwV1z1rZw9orZI0ST1Ndb4fJWJqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOJW042m4zTanVxleXE-qoyeKuCbNj14yaX9XhYOjpQA&oe=6AEDDCC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_aLlrD3ZsgQ7kNvwG58B1c&_nc_oc=AdoBIdGNIPoT3uUmfRojScLoWjD5zZNRNZyO4ealF3DmcPDECIiSNrJsmBtIZ-Yb__U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ7CRQD4qsWeNPsGt-kO6NKirgqlasw77OZWfmYvZS7g&oe=6AEDDFB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n75ZiBAf8tUQ7kNvwETeTX9&_nc_oc=Ado_DTEUB_8TMx38B1ZALVPYzIQ9WUXvh95IXS_mIFeuAYUXYtGovSkwxUqSJU7P-TU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpfvTI4uKA04NdWFQcjZ4c8iRUoonVfk3XGE7Y5TIhhw&oe=6AEDE206"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
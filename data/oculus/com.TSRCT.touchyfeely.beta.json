2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1W_XavUCKcQ7kNvwGwZNO0&_nc_oc=Adq6MK8zUCL3nxVdu3ocupgQjtzgGq0F5BHJlH3DJ0j58Np3c3cQGAbAuDeczRlf9RI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXjcjdrYIlpr3_OW8WhtQxvfDJdtdgoGs6dj-X8TWVww&oe=6AD39F1E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLbybeV4k_4Q7kNvwHht13g&_nc_oc=AdolJt0uoGZP-hAYaBNmloN4L5zJ9cWUqArPeOsJZ4ZYJFFOIYQdP2M77c-51Hwwavk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-oDIGOrhzhBComFsYLb5vD-Xv5oJWq9I6-qtG5cigzA&oe=6AD3B169"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bk0J6rrZuMQQ7kNvwGnNJim&_nc_oc=AdoS9wZjk-dkoi6Moibtezuedf0Gz7SBBnpBMHHOtrd-OYbe5HpbGVJhx49ad50j3Js&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsOo8yo9oOwGO2NERj3iMBkusA3Mosdd-S_ycWjazc6w&oe=6AD3B707"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQHUS0jsMQ0Q7kNvwENEpL4&_nc_oc=Adq3t-PSnwozoSRQVMAiZzvWgn9PQ9ZQktRlSRoijevxURq-89zXZsKSd81OAkwiwcA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT8IibDsXACwJBBWzpyyucxpwPJXnIZ4xUF8P4Wuy35A&oe=6AD3B9F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIyM1QZwMRsQ7kNvwHAxbc1&_nc_oc=AdrV0rzjPEv5uA1PiP6WycVWQZ_KlhVh_u0xv34IRhdPYqvIHnFNl9LnAyb8fknhvIE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9e7o_3w9YS-ZFr_qH6DYbjkmScX1ZH8wzq9Jv0cT8Vg&oe=6AD38406"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
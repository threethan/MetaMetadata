2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdKBKg_k_VsQ7kNvwGQtmW4&_nc_oc=AdrId_Wjf_IMVwucekcpV4AvC7nffgXyPK5xiieub0ksDM3lY35iAVf6RbhfDymq8b4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HpMczz7Bl_F4ermn51IhueKvL9-cJRNMtzAIWCln8-Q&oe=69DB8CDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VZpb9vi6_wQ7kNvwH1tMRV&_nc_oc=AdrZ_JxMRpi46IUTdptBeervLIEkQSHCwgv7Up-8RB5J-YxOAZbsInoKA1hUggAL-NQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18siJ-EO2xXD4yE-VBiBrz4-r2tNRQYhYYAjIafxbb0A&oe=69DB9F29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v95HIsraWsQ7kNvwGnC7mi&_nc_oc=AdpnkeGkMTHVRKYVhl0Yp-X-2vjO5Iw7xPpydtiUqgIsqzT9b_lB9lt0SpQCGdgoK4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FB2YU-rcIOFDF8-CCBCOkLHRWsJPXeubQfu_qxjX-pA&oe=69DBA4C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAJvVQusrrMQ7kNvwFEGu9S&_nc_oc=Ado15CS7dxcKPX0VFPms96Bzsecz5X7eCM0bQU3S-aG-23DkjQxKM5H2YhFQzJvTL14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g_3hQlmh2rCyh5Lvs7q_5ed6-cKOIUQtD_crlbOFEvw&oe=69DBA7B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3M1ixU-4nIQ7kNvwEMCH1D&_nc_oc=AdpL0pM_CyeqCXy0i5nFNW1c0Kl0TqNc6dMKnKQapG-SIYaL04Hy_3go5s4Pi7nVt3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MC8VijnoYWmL8yozsOO8qNM-bbf4oc9xfwY00yEOr2w&oe=69DBAA06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaoafeJkJFEQ7kNvwFU2Ktv&_nc_oc=AdpF1JCerqfHD51NVHHysVHXGU_G4KtYALKEJ3ZrRYRuUul4v0kBPFnk2CmAj6QN-pI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_7pmk7bjKomcjcRxbS8OTrPCBUiyjoNgsN8VINNJdRw&oe=6AC12A1E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RrBEL065hoQ7kNvwEWtURJ&_nc_oc=AdqwHOMT3-mMKDz7nE68QfyXGwr-1uSPkJYSLfPoFvVIId9En5ZtBdrBo3GpJ-C_IIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0urPem7uzxoq2b7FRU3B8LHQPlrbwv4Fjfd_wjHViAA&oe=6AC10429"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ypgPqG7oAIQ7kNvwFOtLMP&_nc_oc=AdpVvtZwnRMbZiOFlyiH62VBmjdjalXJFGG4DylMajUqw7LoJaKYEtejFWKacF2pJ_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFvfNofaTWUTIOjLILobeljFwzw9PC8MJXAa_kUj-rhg&oe=6AC109C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YmEEaZx7EYQ7kNvwGLG9xY&_nc_oc=AdrQGdHnrwwIFOSbz1pKmg3opG1kQU4DH1XAJmpwyq5RnWEzzkSJnvvFdV7WSVpHRWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeJh5pQtobkwdGWgQQgL05ZYz_KVc67fdnufy6tIaOzw&oe=6AC10CB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Gg98jpqOIwQ7kNvwGPB42n&_nc_oc=Adqg_J5Z4efiGsQ52EI_5AxQa0uPml8YBW2zu_grmkTAIUni-si9g0WYpxIRkSQozjI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLngQCFkRKnhP3zQMYxD0KnKdgqD6scFWjxdkddT6E8w&oe=6AC10F06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
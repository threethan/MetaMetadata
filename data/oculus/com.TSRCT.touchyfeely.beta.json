5843_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhlx-BvN75sQ7kNvwEoZf9l&_nc_oc=AdoGuX2IJJvpal45w29GYUb2Dn6kz5tsYCUz8D4wKgUjPtnNBPaPiHHYlCrBEHVP8eQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQhoX0s7DHDFU7LkmIvErq5dKqKKX8IAzLIa0axlwAw6Q&oe=6B0B365E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAl1jTjPOT8Q7kNvwHrajmM&_nc_oc=AdqejQmgHbs_bnEJca-DCyuinnTGJgbYestQIc7_d2D04XQ5sC50JtsTmaAdJtMS81A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQeUj1f_6y3vODC7FNyz9JUNy6scpLXzwfnQH2RRPU64A&oe=6B0B1069"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOqrAYrxPocQ7kNvwETakFL&_nc_oc=AdqIQFz8vnu5Uqrz-qdLnJzLheXcFKjYx5iE--r3a_sZtR2bArlE5Vu646JG9RyynAk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQizNSar5GIEFE0-oHVPmF0gZKcPoeVHa9gK4lIcIzIDg&oe=6B0B1607"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BM2JWhS8KAAQ7kNvwGOKExL&_nc_oc=Adrz52kx9rN7FIiVwzlbff3L-chTKe_yqPLB16NqI5RcF7PD8PAOk6IXJqVtZz5bylE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPM4imcV0VDGeEmxRMHZ-p5PHHbYnxLXrp9cCHlmNfpw&oe=6B0B18F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=he3GHVgyPV4Q7kNvwEJicMW&_nc_oc=AdpGIYUIlSbxFf3rxM0Xcp-KepsvIDcCLFHNCmiOmbF442gbhPePtmexr8fk8UHKtE8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRm-0qZ46BpvYgEt7uSujTvI2slLCb01f14uIKNxiP65g&oe=6B0B1B46"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommend
5843_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVZJCfvUQD0Q7kNvwHjSvHt&_nc_oc=AdqY3k3_Bj7oEHwDrNa-t3MXyNpREjRNsBgZjh7P43TvspH4RGLGbrMAevX6oni23Xs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6xOvzKFamz28hSW_DezYo8VmlyD2irNAP3SyFGLl8Kw&oe=6B03151E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7cj4b3rZQ0Q7kNvwGCCnVR&_nc_oc=AdqQlAx7dO9FbYdwCJcH2M6RkD-VNUduShXarz05YzqhvliaqL7GTKKuU8F0BCYPVrI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQET6gYCPi-NY93hee1_xyqQLANQuQcGMhtYiq712K03A&oe=6B032769"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Knp-TIKw_kYQ7kNvwHZIu9P&_nc_oc=AdqLbhrXqYk0EpIReb0IPa1PNgxlmFkClzn-fAk1kPaQGcgI1FfWPToC22muu4_0N9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNwErhqexSpv-tbRpLwMkUgKv3Z6my3I1f-zXaksWUfw&oe=6B032D07"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sWtkn4iE4QQ7kNvwG6i3V0&_nc_oc=Adroe4LYAwyDwjG7Usympe7fxRAKRwR8kNUqXBx-ZBeIFK_ETkIQtq6BmrD5HEokWaA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg1vQ5swvLyVo1VrVrFsR0gTyjjxejKPXbDLhZwYblbw&oe=6B032FF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6lKmcUZlR4Q7kNvwF0-IeI&_nc_oc=AdrF36GPQqoRikP5e2zA_rG3-cwXqg25PWwwkMRsPOqW5JPB9XsWWYui0E4jHcjtGLI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkv1jpXa7z36FU5W4sKxMjMGg4dIAdfOEA0VfiRqEWrA&oe=6B033246"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommend
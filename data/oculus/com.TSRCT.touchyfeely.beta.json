wFHKZct&_nc_oc=Adkv5LCU4zTojpnk1YRy-Lo7dOfTIoCyFUMpMP6lW3NYXZWQQ9f2tVRNgbYnvhbMD1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuDvdwMJES7yjqRQew1mwfkdQngHBAGuZjTCFTeR9DnPQ&oe=69A0395E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWBCWwYUktQQ7kNvwECBpXE&_nc_oc=Adnh6TXEAW0v7-auO-Xqbw5nf8BkHqVzpdJw4l4GLAgftXH0a-qt20ewYzX3zJXEaq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft17QXBuXf1c56QdJ6zytStacNXsnTAil9hbItmja-uQQ&oe=69A04BA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MaQ-WJaJtgQ7kNvwGfqpbD&_nc_oc=Adn3kU819yJA6xRd7ovZCFQheLHLMipbnI5uXk3EthlA-Xl7ZNK_LdxtfCGEV_3kcVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuXLOEg1m0__At8vLrbTdO5J2hAPY3lVe98LDSaQlk0xQ&oe=69A05147"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shwILzy6HvEQ7kNvwGJPlyh&_nc_oc=Adl70Y9l0ZHyNUggFaY-0bXbRokwd04gx51W3j7m4Rame75HY3nCrnDMl1DwqFuWNS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjreHkiKGGFuONGXaSeSQFN0hiF9firGBX-WrLDptFng&oe=69A05438"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6Gdd4wtlCoQ7kNvwHggwBV&_nc_oc=AdlTaqhahU2Vgw5l11uZ2Ey9vkjca1T5u3aHtLwHCBsRCttCty-9vThejECUiheVeGM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftblao8L4idTk8c-i7fkDZ8ZNbAjx3dHt2g5RfO9ju8KQ&oe=69A05686"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TO3jgfnyr8Q7kNvwHqyGNb&_nc_oc=AdqVRWlRyoaB9GyYNuE0VqAJbWK4TIUe3vB5DBb-GyGceCV6eZgton0bp3rshnAJ_OA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZohudmSOdC60-ACkqWEQ9KqE7gvPq5j-3EJ3VkPMX8A&oe=6A1048DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oh34gtqhp5MQ7kNvwE407gv&_nc_oc=Adot2-kIHhICaRwHKRutPwNwCz-HVvf4xEVE2K4BJGj3t9arChIF1kJ8Yy2nQREZMjk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50LGsKHkoYu56Dz6dUN7Wom-50a8eqA4bSHVHEvWfwXA&oe=6A105B29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMxjwiwtpXkQ7kNvwFIjV4y&_nc_oc=AdrDzy9v8hAHAa3G8SbZl1G_Wn9RdLlvwyOT2HKCSU9-WndsG2imKpNTbs-0j7JqxpU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xWNOVtvZ_Cw5rkKbwNgRM-1PMu9cVejQgBfqOOXfKVQ&oe=6A1060C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXGUCswPdkwQ7kNvwG1yfNQ&_nc_oc=Adoh4vsPlZMs3p_Saif29C4zdLyFgBfyHSJj1ldE2_RL9bD6KH5cZehG2fYxotoaarI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vBmweF0axfIPFL_nglTze8gMGjj3uj276IfS6C4qUrQ&oe=6A1063B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFo-ELJj6KoQ7kNvwGMo3FV&_nc_oc=Adqm-jkujnq0n_o-Juk72807xREdIMBAf7pZ4I9hR3MfEp5V-ybe7PGvI29G3mmXn4U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QQic8GbpoETly0JfxeX669IxwypRsm-Q2ERJeT9DYkA&oe=6A106606"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
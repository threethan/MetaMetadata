5843_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVZJCfvUQD0Q7kNvwEZOmHU&_nc_oc=AdrI4bGgf5NccY03WNRiSYHF3ljBVEJPTV6xcBnInWGuUv25eeUy-lpLN7YgI0ze8Sc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvWwCFAwQaB9tzdu8M24iIVBh3ls5wx36mGO32z0faLQ&oe=6B04669E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7cj4b3rZQ0Q7kNvwHXWrak&_nc_oc=AdolDrshnAQpFlcenJ6IHYbAHSOGyjnMaiS15X_yo5dgOHc4btL2D4AjesiT3zuVG2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwRTg2P6VWi5hbVF_xE8hL1ryKnEzmEXxBn4TyBty7jQ&oe=6B0478E9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Knp-TIKw_kYQ7kNvwG4n0WO&_nc_oc=AdoEapL3MSimBRLqc1QJc7gO9oA9rsXCqm9CTfVCrgAPirG4Unp01gabZoR9QvVOTbk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtnci8UYLGBk8TEycD2QVi3-Bkh05tsXXAtuBLSka-qA&oe=6B047E87"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sWtkn4iE4QQ7kNvwETJBZz&_nc_oc=AdpW6meJ5Y04Yhfa2LUVZe9K58DTPhyemVR7Dv-565delB7KEs5wUwKR-7U8tLp5vcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnVFAjuVQU6lG1NgYNCPxfQB6UJObvH8kNLs-DowbOjA&oe=6B048178"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2VBfQnK8B4Q7kNvwE8PNfU&_nc_oc=Adpy1efYfhh-4TLeXTO82e98OQX--houapI1Qmd_ftG9Zs2sPE46DJC6i6VkRxMQCcs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiPQkMnj6HMfYILZoqdjSy0U28YVWtwkjpgqAO7CL5zw&oe=6B0483C6"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommend
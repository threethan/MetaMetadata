2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlZbFCD3RLIQ7kNvwENCCdQ&_nc_oc=AdqY9uWECVtNnoGV-u8O2Zm42bIAuCdk7IJZOGptd7_uKspr__WtvXcLa-GElU39-gI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9JcZfGVF4fCvIYl8XzTF_Rk0zrnv_otOqWo8OepLZkQ&oe=6AB0069E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwpICMlvqH4Q7kNvwEuUaYd&_nc_oc=AdoaUEHTE4yGYrnWDc9quPJoQ3dbvo5Z0SkNUmB55CbVja9UPpa-i9ayfOP-KlFw20E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLysUgtqxacNGsZr7ItfR9c28mImfUA3rD0-zg6ip4NBA&oe=6AAFE0A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaCQrxnuwz0Q7kNvwErcy6a&_nc_oc=AdqLSz0ZZHVeG5mJf-K8fKtBheniUGFNHMwDBIp1X9wTgBMavcd1DtMoB78Y9ugC8z0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqz3ma11qIjfAwdLKXJWFmJTiDweCh-ldkdkPZ-DxCyA&oe=6AAFE647"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-g61tlzavYQ7kNvwGCJjUP&_nc_oc=Ado7iK5Wr-60X0U-70l613tK-GCUIAnTSsGJTuaBJRRPz-gCe9iX3YtK5GQCSoDzUWQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnq9MwUe387m78cN5QHTqcXhK1K56ug-LcAYwYaob1WA&oe=6AAFE938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXLZWgGlCC4Q7kNvwFtSVt7&_nc_oc=AdoHH5jI5upG6gTWAhvDmFBT79MDMtdYvQRE0uwjq2AszBRQIo75U5QdzhFkdHWuIWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS1R7iNxUJVG-9OOhbHdoWtgkg5eGJglVoNw5KzrCBvQ&oe=6AAFEB86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
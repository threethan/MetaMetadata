2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtOIpKFVHdoQ7kNvwGCxLf2&_nc_oc=AdoFiwj4yF61s1h1RCQPhYULUsyky0z6dhJssVE9fQiqfK_1SxoOvtpcQOSiadlVYt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA9diiC0hdMswDricleEKqovzH3mQN7OTBCO91gLhiOA&oe=6A984B9E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fsue3BMjzRAQ7kNvwHVy7t-&_nc_oc=AdoGPq5HImI9vTJoVOHvEXtPn8sljTtUaKmgIWTokzwegacoCnVyp1uc-XishPROJiQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwKNj50SAOZNgaUu_5EAotQSVOODC0_JbedXg-0Z68sw&oe=6A985DE9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPntrSlpkDEQ7kNvwEXUx6R&_nc_oc=AdobvvV-2IGioBny7L8zLpF7CsXfQ73I6xPMAezmNk4Gx1h-igUGpN_lmAmI3VkpClM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5IxN7ex1b3tAeDBYS8wR-_IIpbArfWswdnLdR4xJJkA&oe=6A986387"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLbQNKDTOFsQ7kNvwHF6Z58&_nc_oc=AdoosqKGDe5rKh1q9aY9XeiFCOuI4QUalldKyPoilSBfL_PWkCEschHtgv6xyZaw4Vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEfkXZPpv7_M0_qZdpbvZRcaSy0XgDa4Sx-iRmbp8AgA&oe=6A986678"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jr7t3JyaikkQ7kNvwFPgwYW&_nc_oc=AdozBCvLzIOASeUgXAFgtr_IlFg4X9tsTVAokKzUSeFGC1QJ2VR7HYfnnlKtQRemVn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnvH6oSCOvb96bpxK-cX_Gd9I2Av1L5e-DOC20FaFXPw&oe=6A9868C6"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtKkUUNtxYAQ7kNvwE8IeSa&_nc_oc=AdpIuJj4CSB96To4c7m_J8G7oZ3Lq2UT_6zCJFNHOnCEBRGOkCtZO7Sn2Cnrq3qN-dA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ir0S4ZgEzsNlrfY-9n4gy5voSEzQiFNlam5iYo9WvEQ&oe=6A046B5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0li0Szed8CcQ7kNvwGdRxoy&_nc_oc=AdoHobJtC37652q-hoPcKxHatS8I1HTz2iIfNnDtKijub2xRUZRGMmAUIXBz_ZWkLv0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L34J-81_Tgf3pFi6A1I45Pcx1bhwvAdgnXZHJGOIqyA&oe=6A047DA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYlwsi5ou_AQ7kNvwElutE2&_nc_oc=AdrBW6TNc664dTxj1NxKNysBj-iUKchckkY0YhyNsmTQtyTRmfaCauErnz-bLpHS__I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G2JWYnLWmJ8pGglW1mCfBD0akz2O8v3yG3zoZHjruaw&oe=6A048347"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNk2kavHQ5QQ7kNvwHO1BA4&_nc_oc=AdqVErdXfAm4MQE1N_AGP8FjRTY38GwUh6I5AW1L94QhuqMVlFLk0gRWFS27TOwoIMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JTSKvs2_rKCqvn-nmUX8qwDxr4WL3p_7dcBEg3ChX-A&oe=6A048638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcODMAJeI-8Q7kNvwEHGMxz&_nc_oc=Adogwk6tCTJ3KyeohPykDUpSdDNH-O_rAEAd3FZkMrFcsjk6XisXhwWyZqJ20RvRLJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6262Mmo4hH0hJoKc4dZNbk_eH5o9gvNJ_se5AZcfhHQw&oe=6A048886"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
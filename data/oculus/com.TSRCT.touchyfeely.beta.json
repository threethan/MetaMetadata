2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4BThQaY3OQQ7kNvwFQv3Y5&_nc_oc=AdokY_eDG-iojrHvKI3IFSrK64ynGsyvSRHwrKw1998Hj0_fH9wGGxcm2kh4Rq-IhRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYZ3wC_DyO3iIcUQi3QzZvFXhPfu1APPlIw4FKv3eR8g&oe=6A73295E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kI21QqBEjakQ7kNvwFhHr7M&_nc_oc=AdpoiV7INZPrv5CJkidn4_cnx1Q3i0MB3dt4foRYk89CI6A__VLeXiAkY14oPBSaVeQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFbTA-xbPVhHRoabDvVkW6PFKbT6wZT_QRy7bRiY1D2A&oe=6A733BA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpFJ-CH2ytIQ7kNvwGpvOjn&_nc_oc=Adqo7-lQLISmtJr8hOyp25wIp-jIGRb0nDv5GTj_ZQxOkxtteMeGJA4ZD8XuPT75RTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5E-eEzyAI-mykqiMGi637mShDuV8NVGP6U1Lix_OAmg&oe=6A734147"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=as4pRnJqBVkQ7kNvwFzMq-V&_nc_oc=AdrMkXNADG2OYFw9n9gr_IpGdEwXJJyTwiwZTu7akGl0EcM5pcvSJp7nD-E6LFYAEsQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFyLmYXCLjT_KJ0wIyGIWKuHKld78BMhNfRf56k07Mdw&oe=6A734438"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ct5oDZbFRqoQ7kNvwHyp44l&_nc_oc=AdoAom246gpMWdElNn08YZBNyzxZwsoroQpbZ_fMkUEzYAKORTM3kSiZ3TlS9VZ0aPE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZRqZM2UzDPtfUQKqGIAupizk6d-UmgG306P5N0tguiQ&oe=6A734686"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pinje_Bn15kQ7kNvwEzPCUB&_nc_oc=AdrJ3ICnW3w0iclpo-iw13vZruntJs_8XqE1_s_Y9w5NI6sk6FCfUlK6SXnpK5sh3_U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UYKICyNv4pndNUU5p6S4yQYVBkjFLuQCcKPXaYluhGg&oe=6A3D541E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz2Ch8x0gsYQ7kNvwF2tnyv&_nc_oc=AdpzxGl1K8mPF4fusQXmabx8_5S-JkWq-QWJpN9ej7lWIxtNyc4_d--A2zRukfip5Wc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GvGHFZpev4RYXpMq42i94wdqnI6SjAwmBsIJj67b4Ow&oe=6A3D2E29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21-vE8ob-jcQ7kNvwFRZTJ9&_nc_oc=Adrytw1I0wZcBl10EsF_YNYGReTSVDksVeCwW9QNYXwrRotNnfYRAz1e28o_Hmptl04&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nJ-JtCoyJvUIsbdmBsORHWHKVjm8xI6UqTo63rUbXpA&oe=6A3D33C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pH7D_fe-2DEQ7kNvwGm6NR2&_nc_oc=AdoYRLl6Ec_Xf4m2e8cPf3f2QJQY_7rbTlhqW4qqW8ugCAlfms7sB1opOL0rhd5wCE8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88iTEiWlrSXQCrK3SDeh6W_55wTNmefSNC3guWqgvoFg&oe=6A3D36B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQlNBj-JCm8Q7kNvwHGfrVk&_nc_oc=Ado366Rq2oCOgSsuIPSg3qfNBpCuIC123b_CI4xUH4ut-ZGWbmjzK2FBW3HvsR2uY90&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6IVpDvF6ZvAOEwT8yut4Ao7GXuMM-c3Frbgzvxxr1RA&oe=6A3D3906"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
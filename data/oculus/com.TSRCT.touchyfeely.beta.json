2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38Plfqiw6e8Q7kNvwEMaVEj&_nc_oc=Adrhi1OxttrSHmAhvLUoY-jYDBqLZLtp4PMjfh2e3TKmT6PSbcxFj28Cn_KMPlKUeBQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ojrbmuuB7z5ezKtgoJF1WZeZCdzAvYN8CZnOLr6HdSA&oe=6A4504DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClVhjQEb8SMQ7kNvwHHBlla&_nc_oc=AdoBtT5GBifwaWwav9YETFR8R38BQ4K_kyMZcpK212ZLgCVfbiuq9rtNzyuPFILDO88&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UKAFlT-I31Vo487O4qeL30tjwWDAH6wljKa64gQ0Pfg&oe=6A451729"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPX5jYkof3cQ7kNvwFe5CFW&_nc_oc=AdrAbIIc6UWedjGRteAqeUBpAklnTm0ylUIYOvPYho4GCEDyxTJH5dEpHmQs6VU93ME&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MhSvkdrLFjDjqCRx72s3rKTAnRCULC7lNZ0hrulf-Bg&oe=6A451CC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1ESLBhh_nAQ7kNvwFKJqVr&_nc_oc=AdoFSl21kGYUE3KuPlFlGlAVuzTP0ChzoHYsZSx2eFZzmVcS_1Wzyq6rXfO3elOZk48&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gi103aGfeSg64vqoJI3VfJ0fIWPneXTJ7qhi6JZ26Fw&oe=6A451FB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NR1aWYe5ksQ7kNvwEzVOt-&_nc_oc=AdrzWGV-Ckoa5sMrzjPTF6vkkolXjGV9KDNM0ev2y_eDaq1hbuqkCpHDp2__Pf8TU4w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sfaUX__K36Z6O8frNyYisyM7OtUq4hKXTfSfL0_4PhA&oe=6A452206"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2SzBo_zKXAQ7kNvwGS3gmz&_nc_oc=AdoCmC1d59BnBAccSAGnk0JQ8obK33QSoGFO8ZWqJFShikTsEDLedbIVi9V_RO4CGcQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ML6ppDNVqcRevHT1FrU3Do2FPhfpXC34P5_ilsJrKMQ&oe=69E2245E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kZ8YFzLGmUQ7kNvwFNDGTm&_nc_oc=Adoct0H00maHf6XPFNMbM3UemhunmbggeQCfcdnrGN6SwnP4GJhi7_1-ABQioz0LzCA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uFLEz5nPWtMHzLz1weilEKdhuXOkm4y4pW8vTN8uYqA&oe=69E236A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfocfcR6ESoQ7kNvwGQcZ6m&_nc_oc=AdoofCGhBTpeI8iLQjsTndN0clvq9xkAIHEOtN_sBX-soim9lgmRciI4oki2aCwu0Jc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Y4YeaO5AAIj0CXluxok8oeeNpfp7vGIqZ_QANzNvbIg&oe=69E23C47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSERhdYWmkUQ7kNvwEMOIBJ&_nc_oc=Adq4FTvBXpNA4mwjWBNqJotAfieu5jyw32A59UYy-Anxtvj19xkjYff7lAwenl7AOB4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W9eR3bGgF35uEu-d0yiaZLZqbCQEaHkXKCDKykd3vdw&oe=69E23F38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zvK8BAVa8QQ7kNvwHpGJbx&_nc_oc=Adrds3nNUBxu8foxXVWytgwn6KvGqrDZkCsrDiNHXYHUSrmWp5kZTmA1boHlumyhAqM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M1zPEwZp0tZI0_3dVPwUAbqlURi3YkRoLmObFF_6TCQ&oe=69E24186"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrttkQ0oxM8Q7kNvwH0QjMf&_nc_oc=AdoVwhRLaTFcDY3RnKrMfeei13FxxjlNOvRDqdynd-mak8NJ57pfZ1SVqZDmhcv7X3c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpOMdTnUpBEcF4EIsjZ4FuJsPUdQo9F2LEHte2gMm20Q&oe=6A5233DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTayFWtXR7cQ7kNvwHAKKWu&_nc_oc=AdpB5JbMoOFh-rGNwu8IUs9C8Az88pUvesqaA6gbgRkH5NDXncHGHx_9w5aEf6URFkg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ7x0m9AAizREP-AoNmOICpgnk6AXRDfEBChnIqGZvXQ&oe=6A524629"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJgRtUTT-UwQ7kNvwEo-zs0&_nc_oc=AdrbbRvdu6AmXuP1O-Ivh6CLl8qjkvYj3UeSFG9Ass-GzPcvVdSb5UPUBP_8tCcqVdk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXHqebwTx0NGef3KjWyjTqq8-iggdyNKyZ74ZLhnq7cg&oe=6A524BC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMVbd01yohgQ7kNvwE6zOZk&_nc_oc=AdqSELO-TCDOOH6KBbrOQ8ziv6FJyelF0TO-GzDBwKi135ZeME1Y3A9lDj4g4_1JKSM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-yHKujCVW5fcssMD2c_7IP2rarpl963jFN74JanAOcw&oe=6A524EB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udot8mE4Y0kQ7kNvwEGOrJL&_nc_oc=AdrVoM6lNUIQkWFe6qCIb_8Hu6FNlRRUrc5zs-zYZ4HeTroqShHrZbynlPztsnpW4Lc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxGD-zOURTMF8qzNppGHTAY4346_MuMTrW3yy2of6jVA&oe=6A525106"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
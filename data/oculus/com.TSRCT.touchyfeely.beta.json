2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jVpDg6zLt0Q7kNvwFpWjhB&_nc_oc=AdoFcGolDS8sXlskqbOsLT7YcQlt5SSUUWuQsA18jrO0xR2XQOTbUNcKxVNlQITS59o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALNPL2TxUr5yZcYE-VshfXCsjK6OkOiVCEQTMp9Za3ZQ&oe=6A4B9C5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIaNb2wdopMQ7kNvwH4HJwG&_nc_oc=AdoZdnS5BiOYS586D8w6KFa_Xzrc0M1gVIewBePSYG_S0jnFZaiPqwp5-3FSSoYIB9Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2C1j_s64ZqGWsGK4O3ACV6qA9jqciZrf5mb5-H9odRw&oe=6A4BAEA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FllyYRhUDV4Q7kNvwEiiiHh&_nc_oc=AdpAnS4vKe_jkJg3wIyWzH8r1fpGUeRgCq0uJSpprFlfFsGvo26HhiJYmSCDPW7LgjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhYeJCck8I0nOnhh1m0IUBgqiXhCsVb7zR5A5NMkbUSA&oe=6A4BB447"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CX_sxh9N4xkQ7kNvwFThtYc&_nc_oc=AdpTFPcNrPoJsHn4MneH8iU3epcFEn6qv6dBgMmpFtSlJlSlkFgamkdKeNvpmZlQD7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2pA4mKhPuaVK3V5oO1swF3xVKvs5nI0d5K9wVMIxj4w&oe=6A4BB738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JC1hdjg9CcQ7kNvwEZYoZU&_nc_oc=AdpVgVHEpbU2JKa8zCW6gb0SSkesbX_zKWMlTfc_nmM2TOp42hc7JGyjWh_1Fcb6uYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjptdAbPAZf1BWedBcLEwn_tUblWRnXNL-qNprJ27P0w&oe=6A4BB986"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
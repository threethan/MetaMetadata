2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW_9iCWkjGYQ7kNvwFKj0uj&_nc_oc=Adpm_x1OThGP4c__OtlSwDt3DmUOnV4rteDzqcsU09dhMwI0scDbg6VSt7q3nnH1l5Y&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpfg4N-E-7XtuZvWKSY8sdP0GTX5IaeL-fNY-TIxBSNw&oe=6A941EDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idzzggwuGnUQ7kNvwET4T5c&_nc_oc=AdoOXWdaBpdhIWTZC05qMEuXeLsO8vu6pKmXksXoWiMFM5EXjiZRr6xZKI96wJy0U_Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn7NSVxT3Ejuozig4GmGY5g5urpWNsp3TTY54HxKOK3A&oe=6A943129"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0W30eYUYJfMQ7kNvwE2VQ_p&_nc_oc=AdrdghKYjuED1BiSn3AoIwZ7Ccn0_sk_e2BPLyIP0nL50ZsQuMKH8CdKQNxud1QuXRg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6uUMkp52JvHHt0nQg5zaDPBI3alZbuyeAO9Vuyu8guQ&oe=6A93FE87"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2CM5klZ2zEQ7kNvwHFMPUa&_nc_oc=AdpbgYKNZEaWh4RB8Py6S-ztgsY0LsCO7nbmyJEvHNEv0Aqdad6i_JRHMmei4YuIlWQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrtY52I8f9d6VKHu_Il6Dgjbi82DEnRCanOpXOHnvU9A&oe=6A940178"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfBJADRIx2QQ7kNvwGp8Q24&_nc_oc=AdosJFUwDd3Mgm5n8wmhefXYU4gY7lHlt-aacBz5KwGxU4y3hfTL3N3jQDZjjbNmFjg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ7ao85thyrgKh59zQ2X8dFanugCS-F7a7xhvFWnfZdg&oe=6A9403C6"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
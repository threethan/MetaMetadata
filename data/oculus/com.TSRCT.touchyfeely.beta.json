2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5AMUM9x_gkQ7kNvwFCVa2F&_nc_oc=AdqyIxOSPfyeBy5EEdfPRz6v_u9-uZY9eYcITIYso5SF_OqCZwBUYc4eVh4ngCPSqvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P9rAsTTOx4ubgF2j75fBAqzOgk7nTeotmafY_WXtcOg&oe=69F9DF5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixDeY0waQ-cQ7kNvwHELrED&_nc_oc=AdqM5LeCTQM7wRmEym4wYKp7e2-oW_aPM2Ck801gXWVIigjAJf96siznxaL-0EKzRk4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OJHv6BnLgSAb2B97fGjFK-eMQijfrQNTc6WSTt3rNPg&oe=69F9F1A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGdOynEFAuEQ7kNvwFj1vlB&_nc_oc=AdpfSvFGkaf_CeHYUIAv8m0dwCsDPaeifygv230ZMvwpT2Gf3daZrqyOetcbe7ml4ZI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54ysV-wzc10JkW1VHprVz8l91JmiWVC2WEJqybvm5knw&oe=69F9F747"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OE1M0AzhDAQ7kNvwHlEQ1N&_nc_oc=AdpDrgpHtWbdtKiB8bblaKJMttIlJ0tH6iRmPeCSChSg55wKUIj2W4pIaNP9uRBRXJg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6moBLu1ca31SCjxbtdkI47-EUyrA62Y6KmOLvD_S5arg&oe=69F9FA38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxNa11iGNfEQ7kNvwEpFoqA&_nc_oc=AdrSQDI7FQ1dagRDG6ob_Bn4nDZbINbjTC1Ghx3z7hUBmA8CRDwCGr2gtgk9nwJNR3E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UyvPR3ToXsKvg4tP9ek95DjUCVbrJGAL86nR84XE1JA&oe=69F9FC86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
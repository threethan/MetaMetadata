2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOrA7DSwYBIQ7kNvwFvTydK&_nc_oc=Adoju8_WBQweWFH-jkmWIOp5Mb1hqeHdCBTaGqiTpex1AlP4H0Gd4ypEL1ZBQ3WoN-c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeJqHGODPkuZIvyzT2rcTVqOrIFicAXvIaiJanv3n2ZA&oe=6AC51E9E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8KLLdQ83pwQ7kNvwE6JA95&_nc_oc=Adq6ovG3xeeKz9c7pnzqBoqorCadSURzfJw7Fpj11s9ldZwOH0mwPmCKrnpeEtzEWDk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4qyAMxVNCfxBXVpcgbgg91dRHC65C8ImNjDwfWFR4Uw&oe=6AC4F8A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqvkXLwxQKIQ7kNvwFDY6Eh&_nc_oc=Adqlx_e1XZ83bduNtRXnUPtXEwsBuGYls4gebsfP_OtQChszmZEIitL32oyAE90A2c8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcHTwFU2c0EMGW51R3Eu4RQxfYfkQSNMm1Ui1qQdjWrg&oe=6AC4FE47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMO0uuakBvwQ7kNvwH_oX8w&_nc_oc=AdrzewIExp8sOJW-6SYbCVOz4gbEpMYlPcDEMX4TPz3NvUatBiwI7Y5ycQd7AiY_Akw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj-2Xqgzl6SIi6sLSE-6KJD5cDqsduGt8hkhAB-Jd9LA&oe=6AC50138"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKbqg9S5qKMQ7kNvwEeNmtB&_nc_oc=AdotC6_lAoD-a4AcXH0PPLs6Qbdn0CAZ4rgEv0A8cXe7v1dc8naV5FEaAfwZoy3QTjM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMo_7w6QKqYBkV4xoY8ftDMUyvNbxo0h6DelMrDtqReZg&oe=6AC50386"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
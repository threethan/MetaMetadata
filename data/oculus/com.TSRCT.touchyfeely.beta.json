2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHYs2WLWD7QQ7kNvwG3dYQa&_nc_oc=Adp4Ncpfc7A9jzYHzPdoBZhCDeU9cWRlID4LimMYShplaZ_T17xBkq2VK_Tz-Ov8mFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4jhIagQbEiGtNwoQhrs9ce4NcyM9jyCK1LncRlEEZzA&oe=6A5779DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AxlwRBH2EYQ7kNvwE9YTjW&_nc_oc=AdpTi3rD7hCjbeVNLfBHX6X7yD5P_dQCvjaUczznC9OBRW4rtS3VQhka4OYjpRXSRHI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkyyZ8mlYlrNvJF9ZK3eQB7tgfRe6-qxq4aJ3Putbssw&oe=6A578C29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lveXxtxgt3QQ7kNvwE--N3k&_nc_oc=AdpSpzvk7vf3l9I7LoxR7O4dbvoCl2X2Zq91YTAG7bIcVLaWFuVwyf-mwES7WFU-SNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEtc7d8xN39ZQ-4kkDQ7LDzzgJWBIOw6bpYZFzrXykqQ&oe=6A5791C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwxbW4bAPZUQ7kNvwGrJ9as&_nc_oc=Adp8OEjcxa6it0rhBh0_vnPPClqagHp6WgI76YdT4hrmeThlaz4KsRqI0IcfLuG2cxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZAV562VmwHEC0s7CKVa2hZXn0Pwy_FsqRHq4yeMoE-w&oe=6A5794B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDGEfV9RvB4Q7kNvwFnavfB&_nc_oc=Adp576UY-wchpQqNesMn2cdBInKnwY3Y4nb-uoXCWq03U3Jmy4sdetgTXhrNso4-YM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6ftXYPbD6WQVv79luXlA9Ot38aoBXoJLgR0g_YoXyuA&oe=6A579706"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
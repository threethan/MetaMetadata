2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXEdijKNfAcQ7kNvwEZExQw&_nc_oc=AdqHG8woEj3JMDjggVRCviH1NtXmbn7Kfmv0Pr-uQ2-P3bygd9E0qaOM9vBdGk5B2zY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GZQla0Xbpt99pGe_uzQs3hgaNxw5hGH_m6WCqcHWADg&oe=6A05BCDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0li0Szed8CcQ7kNvwH4LVDT&_nc_oc=AdrELTCTVfOAaMcqSy8hZ0pFT0qX2seFnGHAJPHKW_9gq24_OZD8d-jgqY_h4Zjo-d8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y2RKR_AfdTNCoz84Hyk2lLabvkzVsxCBpDWeUPJnR9g&oe=6A05CF29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYlwsi5ou_AQ7kNvwECmPvq&_nc_oc=AdrU7n1i2nGXhgg3PuLtqvgsa2944zyHaazopbkyv95XAhTqSGxC9FUGeHlIOiYFJ-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dZxeXALKnQPzATP-4DUBiLDTq7fCIeoo9reSBNia-Ug&oe=6A05D4C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNk2kavHQ5QQ7kNvwGD4ySw&_nc_oc=Adpuoo2qM2I4zTftxg6sMgMEJzRCyR7tmy6no4_zQ8FB7QzrVbtoRahh_6EgyF7MdVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5U2ZqhidaZj3AZQhAmzMvCWwcGwQ14RB9gfBGFU2c3Og&oe=6A05D7B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcODMAJeI-8Q7kNvwHYh0wc&_nc_oc=AdqsE3p5ebXR3eW0Ggs1HVrDQ0f2UILTkneZgpIknReat-DZyS8UMTwj1Xo0c_YaPrs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ALamPDb6wbvulVzVFP0OXBWv1vwUJiF2sH7yEAiGYSg&oe=6A05DA06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUnypS0fE_gQ7kNvwGRDNY1&_nc_oc=Adk_t3OUNDDlumYajbKjnX65IT3CsbGh9q0IvJIThZ7G-kGpLIqohSu7kTq2iz7g1Pw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfykL5YPIOBttgca_AYFsTtCD6upcH7Fhz3w-4N-Ol6-jA&oe=69B945DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hicpE0hgUc0Q7kNvwE8X1zf&_nc_oc=AdkM-x_J2A6yKa8Tl9XyeNEe8NEvUw3_PZQSQCJyD833fAp5_bdzruc5V6TjV4OayIM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx6rxlyw7ga74grwZxjYdgxOWeXkEMYjjI7rL3fnNI2nA&oe=69B95829"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vSUbhGFxIUQ7kNvwH8Qgl4&_nc_oc=Adl9dMIcH4pW9dxpY5m-CVieMPjiEXG6KB5P9BfYwCkPN2l-ogK3MI4LNrQlIGc0ExE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy0EN99S0x28bpWrZ2YzjxwkrSVkh_oGs7iznHS2zPAZA&oe=69B95DC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bs_UsIOvPckQ7kNvwFfGXEW&_nc_oc=AdleYowi18ksZP2SiMztez2dC-GwbRPRiySpRcIjH15xUFiSOOJM4_3aBxucKftcRtI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzO3cu5IApt_Cy6BsXdsEeu4kJKtuV6KiyCy8RZ4mAEWQ&oe=69B960B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDaDYuzibEEQ7kNvwEobpNe&_nc_oc=AdnMpcGzdPNMe698NGBW3jedpZHGEvUS83dVyNvam45IyAul9EzVL4HYVGqzTb1wXkU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afynl5bXPhUw-FRqdCmVZcFN92J9rbwMeFjkPQpAlpeo0Q&oe=69B96306"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH
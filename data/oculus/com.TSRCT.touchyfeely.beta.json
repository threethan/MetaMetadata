2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_hpkMGE2xgQ7kNvwHU8QL7&_nc_oc=AdoSIwN1j0CiSnlcI-DlwKt6UOxKfHLNjWhnqeSggQBJracMLUqUX9pN6eHoeJ-158A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBIcqeWFcQxMUB614FB-7kTRycb2Mov-xmQNlj4FSGXA&oe=6A80585E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9iyfe_xcIQQ7kNvwH407Mj&_nc_oc=AdrtQEM-ND7jnf8yZ6e3REUt5b3DhgiRoIC8liW12K6xiGK8pKggt1VjOWdDAW6iOP8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAwNCmBJZuRg1U-ixOQA1JXt6H-VcCZStBQdstbAaSJQ&oe=6A806AA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKMcy1CQigAQ7kNvwHgGkpd&_nc_oc=Adr9-N88m8FA_vcq3IKd-fP-oyhozdsEYqOvmI9cl0pMI9r-wOEHlbaW0-Rk4cqXnbc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPtVg9DU3ev90eyqGYAoJW5awiFksDAbak8BJEaG3HkA&oe=6A807047"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtSWE_L6BGYQ7kNvwHWBlRE&_nc_oc=AdqNm2xJHJFGaB2YiVeri8JKSamPs3U_KD-3iaU689y39uCRyFPqd95Rzvi_6mpTDl4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtb48O2HMXzjKkBi1gdXV62RNmHa8iArkBL0PlrVNH8Q&oe=6A803AF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pirzW0iP2ywQ7kNvwEaMfIB&_nc_oc=Adr46w2exIiK3Up3irqh7y8QvuQnDZCG6_4VV9m11lNBSQ194GpWI0bQ-vIwy7T-SE0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_Suh1P8VG9U5afPmC3CD8B0Seu2nAx9B0cZeziKbdzA&oe=6A803D46"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
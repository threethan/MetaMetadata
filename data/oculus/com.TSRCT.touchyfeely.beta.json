2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsQAQZjpz3kQ7kNvwFnyMj8&_nc_oc=Adq8wY1qkiUtwYkgvdXI7KteWeSsveX0c64XG6awwjJ9WKFyz80afj_zpXdHF7iCw1M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HEXGIGy088MQWDo-0phw1qsfe89VbUQUcUQBDW8OQag&oe=6A09B15E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3doC1UPZ3EQ7kNvwGIxFJM&_nc_oc=Adpp7mfjRkuXm2wXnsIqLp3UOmIZItud_1Cu5aZXUDgLMBmlbMdhif60TC0-EM-lAbQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ynurfha0qZcnUNWQwAihXZgnxzBxAACDkd0T69nKdWw&oe=6A09C3A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TNmwsjUgJEQ7kNvwE3ROgN&_nc_oc=AdpA72sokHgTl2V27xHB1PxW5nZGrG5n0RD7PEZ4AY4yHW5wLJgDF47THDPmM8yntqA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QE6Ysffok4o7VgVpE-Olmm_Ix33fNxr-qnLgQHUS6Iw&oe=6A09C947"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKwa1n4XJ8QQ7kNvwF4tMKH&_nc_oc=Adp7ZacKkB649HaDL6DNRDikaC5z61o8gmNdCAUgae9zRKPjlAJ2ChkzE7qaPMjGk4A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KjSNQinlmUq6-j_UhLSIEcMjRJvhDg-Xeq_NJrleIyA&oe=6A09CC38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiw47315jvIQ7kNvwEI1Dlm&_nc_oc=AdrV3QIYE8oLih4aN2U0VVd-pJ9_lIRuzWi9gdPpUIxHzD0rdCkL3KDpUTuf-GCupo8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sNT3ZdoCWWLEjUvfW62uND4dJkVbJ6-XHwKXX0dKuWA&oe=6A09CE86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
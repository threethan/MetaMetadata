2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0w2pgdGPHdMQ7kNvwGsLh8m&_nc_oc=AdrO_3suC1cgA0ldCDB4qObYiXq2HGM9n8akp4JeGdlFwaae0_WK6SgmZ3dr5Qc2M2g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuwlPPpigeMhmJJUbX8SrHgaKyuZEwjshYbXkkR4J_rA&oe=6AD0FC1E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm-5tZswtf8Q7kNvwGTMGba&_nc_oc=AdoS9t8BtWs-99JgZh59nuVhSbuaht92k3sZw2yBipMScxzjDPEZLEqqsvFPY9pXU34&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZKmcU47fwGKJ2_p-4AE4DabskEM0kI7A99grTYY0P-w&oe=6AD0D629"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAhGnGR6a0cQ7kNvwHCdExL&_nc_oc=AdrPXWTEBgV3CqtLaiPeFFrxMSnVlx8Mqb1SPuJ_RgXrpEwJ2xrt0JLxOFNRKcK2h3I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZF9MI8leOC43mW3U6xt7S8WThUDAhg2-inD8mAMoTHw&oe=6AD0DBC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwT204YQysEQ7kNvwFlyzYj&_nc_oc=AdqS5cgKk4bTGk6Wv5dFXprKfI52-WwUs1_JrL7I5bEJxFajfWAe8BgvX3Iwj0Lw4Ho&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONc8fP58g3g5GN2dUJgFHS_0hIWkzTOPeiRgiAsxJ_yA&oe=6AD0DEB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIyM1QZwMRsQ7kNvwFyguU9&_nc_oc=AdrxWx8_7SAsWfxRjgafEzJpNKWLa8Ly9nFs6LoARgHD4MkqpNN96mx8p91AEdX2RgY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOreDSdNlJ07Dm5gSVZUHnlmGAdawxyNqL9Iie9z5WF_g&oe=6AD0E106"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
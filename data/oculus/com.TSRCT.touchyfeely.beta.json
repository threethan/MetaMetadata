2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcMMw0j6MZwQ7kNvwErw_jx&_nc_oc=AdpnBVOAesbw-eqnrSp2T6KMKvLgHZkl9rpbfj2JpN0j8HNTooaQtJuF_2fbn0tKRCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zxcC_dok2yXPpOSbbHvW1qs_za_-BqJXjhw8sK9cD2Q&oe=6A380E1E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd5q1HY7a_AQ7kNvwEnD02e&_nc_oc=AdpJKLGDl21IrVlgvJTniR0BHHaC0sPiW6wjClNpn_kxuCzYhUchK4rVIuQQuY7wE2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qhYuPhP4RAC7prJQrbns8mrJOsGNl0r-yfzAv8L9MTw&oe=6A37E829"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4awyEIaM30Q7kNvwF2rxHU&_nc_oc=Adpa6FkZ_REAPPpE_5PMVCjYZVWgUWlhorgBmlyp1KwH-r-jRcfhcQLxXDEEB7Noo4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5R61nhvq-gZ4rZ0X6eF6SL45an3PnN_0I7N1EeqFMaQ&oe=6A37EDC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRvhfhd3rtYQ7kNvwFZh56f&_nc_oc=AdqCtbwRlHT-Mo7OWeC-oRJl2la8GTDvs2zN4dBu319XeLRGsUq_FCxLKRl2pyi96yw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W5qDJMOIjXswKviY495VLUaZ1Ughjd7cqYPnLOubYFQ&oe=6A37F0B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Af678xeFnVIQ7kNvwHJxZHv&_nc_oc=AdoOXvBj6Gwex8-mra-3L9r8HvFiU9LPRfxd3RMW-aFETf4rXbhpKiaQc5-raZF9P7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gH5vCxVQ3VkYu0tcki6lW4Z_1SXPiEVL9GKwDOIOq7Q&oe=6A37F306"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
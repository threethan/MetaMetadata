2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtOIpKFVHdoQ7kNvwGZvIo2&_nc_oc=AdoGp-F0MRT_rbK9qjgSJ1YiUnKL6m7MKOyX5Try2jPZDFTndQcnKaninIA8w7IZE8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJELl2XpLm2BuMRbBKUQbAkvOFcBO4EZTqt5nO3f1Mwvg&oe=6A999D1E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fsue3BMjzRAQ7kNvwHh28pV&_nc_oc=AdpqeajJvApVi10f60wOp_5b0PUMHzNgengGSFU2PaRl9H_OSUSj-NkAjUiyad5Nrws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMZJJp2RxiH6q0Rh3Xk7jtq8uKvSVcP4IiQq1VQYNUOA&oe=6A997729"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPntrSlpkDEQ7kNvwEg9CdD&_nc_oc=AdorManfqD1C0ufImQ495Jf1W8BmQlefqYZ5u66n_ja_rUCWU1cs7XNJqiXV92R2MsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPc5XNFyJyxACEQPn5wH_Aa0hq9Uu9dUxL2z8ZmF6rAQ&oe=6A997CC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLbQNKDTOFsQ7kNvwGUetqU&_nc_oc=Ado4lCPv091r9ZOZUJo_J1Jvr11JTE0IxEg9i0jldzFB_cnPtPjnqrNMVyNr_IJyMRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrxfE2nandVwsKelKfseKKkLSi9YSX5tXcUhF5za7ZgQ&oe=6A997FB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8B0iHe5vDDgQ7kNvwHBdLoW&_nc_oc=AdrA6Osq0NKSRiNdFxjP3OGjICAcSZxrtixggTjEX2QbqRqfoIHaTMWWwmeGh9J-GjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV3SHjQt46lnG3fA9QdFFj69WTV1v0wnoeeeBJiiAwaA&oe=6A998206"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHYs2WLWD7QQ7kNvwE5tndR&_nc_oc=Adqe5fAmru7Ycrrw7ABOcOtA-ynQcTs3pjzwkJxvlkpwc3B2udmuppkUN6yTJPD985c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGZ7Y3PgIBxlkXu2VI1PsSAPkeA5Z_sN6HBI-eC81X9w&oe=6A56285E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neG8RMFbANYQ7kNvwFyR3O0&_nc_oc=Adrk2hIVfUuYFXu3InZTaDSUwQrcEqAnBLzr7x6RphGcUDZuR9LuW18CwFQJ7GJqVUQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBp7R5FSUF26jctBCao3Rp-yDTSvCEj5SaLusyoIpWPIA&oe=6A563AA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvXunKcjzLoQ7kNvwFCS78O&_nc_oc=Adp8tCvztdIq8PFUOikKFwNMbPbXQu1mjYDvaO7JQHZk-K3kMQIP9OlIbMXTyIJHYpE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBItj4tTmB5KTmw_eo93td5Bb8uzA6r4KIzRMCu6LHGw&oe=6A564047"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdFG9KUXLN4Q7kNvwHHZuqv&_nc_oc=Adp7aRcOooVqppcZXSQY_EuaM0hskCUAjFvI4d5C8Oya7hE86Kry8nUgtl8H4JYvQXM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrqvReX_aTl4j20v0tQ7z7X1ekzwDP4yeuwTxqjapSqA&oe=6A564338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDGEfV9RvB4Q7kNvwG1--7X&_nc_oc=AdrliyKf8nH1HSrZAY7tk9HWZV4qLmNKS7hw6rVi8ZN5KrS2UbaH5avNT8chJbfokQU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzbfkykXPbNIfkBZmq_1p_d_A1u5AFWAqkm8phrr5h-g&oe=6A564586"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
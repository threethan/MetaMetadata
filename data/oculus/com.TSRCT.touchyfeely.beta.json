2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A84Ot_iS0cMQ7kNvwGeJyJn&_nc_oc=AdpsmYpM5ABrcLMuLgv0yTQAj86rCaN3R4YVMxAlp75pMx8snYorrLVb3inx7EStonE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcvA-QWiwcsEKD26KVFZ0d-fJPigiXOWVJnvppDdow6A&oe=6ACE591E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm-5tZswtf8Q7kNvwGHQ_Aj&_nc_oc=AdqWTBbiZjmKErhoXDDdBu5GpM0WOuM9eSMjvS1l5n3I981eACjK4rxdQ14NC0Y8UF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXte7NaaU2qVz3ToRStI7zN8p4chmWDxI0q4pHrYk3NQ&oe=6ACE6B69"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAhGnGR6a0cQ7kNvwEsGBhj&_nc_oc=AdpseXZkRTqLRAXoR5rGXZeF1B63XYdwwtbSitRFn7_L0d03HlBiykOhVMEIgDxY8Xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSjSXn1oY_K3hmZ8B8jiBVNpJ-neWcOrS2MvmtQaBopg&oe=6ACE38C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwT204YQysEQ7kNvwFO3rBk&_nc_oc=AdpTKAo6vX0NczxvesdhJjA67Ra78Jbrn-q0xjs08SSPFW2qMh89GpxHU6SRwmdFquw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDjXkXyhENiMU-wlQCqbJDyvSBGEBY9NUi7nimrmxBzw&oe=6ACE3BB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnwPz6nA1TEQ7kNvwEulLqT&_nc_oc=AdpG-bVB5FyhIc0Qg8evrrAaCeIbt_P7-9OnU14zajsjp8aU8Lxff4buloUirikeNWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN237CbQIo0_tbzP1Z_0WkLc_CjoiH4ubPHV_jM4I4W_A&oe=6ACE3E06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
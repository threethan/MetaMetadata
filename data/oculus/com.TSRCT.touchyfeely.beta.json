2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlZbFCD3RLIQ7kNvwG0TPKU&_nc_oc=Adp2pHm1hGPaPR0vZxtPgNOnpWcM6pQPELYRrMAKE7HI3M1mnjI6QBN2mq59BTLGBvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZaIgfIbx60JgsTSgxNPg6621gV2H3Py0WhGlsxhEfhg&oe=6AB1581E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwpICMlvqH4Q7kNvwGBmhn1&_nc_oc=AdoTi0kdy83kQyG9ITjV9t81Yk7HF_IVbsy4WcajOh_rl5fmR0J4Oy8b5jGbCaXO_Mw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGt-5wpDPWWZhTe-EVeg72yFU9l4TbW7jaCoOTvCS-Sg&oe=6AB13229"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaCQrxnuwz0Q7kNvwH-HzQT&_nc_oc=Adoq90d6Q3IqswS5St7vwxPuc8MHajvkxz1PtPgosBIXECjLkTi1pFt_A3INzrquIMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4xG6dasDb9Lt4s8Ihb3M6ovuvArmgPYW8mbIUb5WDMQ&oe=6AB137C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-g61tlzavYQ7kNvwGwrR6P&_nc_oc=AdrCD8htVXfgXM2tEd3i1lvJYXYkn7PpLkQDNzc5jyC5bGPfPEeR0vjA837tDkYZtOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYBcUIx2lPkFgzK-_Ziixpbr_xdd02252nv3Us15Fu9A&oe=6AB13AB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRaVNx1rIIMQ7kNvwFD1SY4&_nc_oc=AdrI1xTs0Tn6RmhlmEXpMGRajJP9XFyOhwgnDvFapaaYviT3KBBljUqzapb9MGCHuLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZAMsQljzluZVXWuIt7uKaGawitgLIl4z44n7lOp2iwA&oe=6AB13D06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
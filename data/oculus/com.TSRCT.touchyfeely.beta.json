2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUTP32Bl3VEQ7kNvwH-nAz3&_nc_oc=AdrKwwl9KkBYzq22gRoULL49itFnujDG7i68MeXYc4Btm_8DCmg_jn4S2EE_OsvszCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpvct8g53ZgpWFdt3paRSja19n98G5n7YOArthWRXoRQ&oe=6A4CEDDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIaNb2wdopMQ7kNvwERCyrf&_nc_oc=AdpSN4CKesvl9xcnHtM8Fioek3c5Gf76MWRgz8qcfJbxT9fGfKJbhbeZHsJgtLSOjws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8Uf4bc0seORWAdduRdpGTYd7RBf93K0vI4j2XMMltiQ&oe=6A4D0029"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FllyYRhUDV4Q7kNvwFVscrm&_nc_oc=Adqwj5gDyMc28PCKBXVQtK0HR3RvX3kq6Sa-u2F282YO20LxwfbYjDfKxtL__2OpNL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWomDDsFIiefo4slbrXU_jlOgj8ZLPCbFbI4xcFEbQOA&oe=6A4D05C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CX_sxh9N4xkQ7kNvwFKpZBc&_nc_oc=AdpCeORUBNinoI-Q91hqpRF2HrmUkEQLrRQQvd4pcUTSe8fDVkcHBcEUT6kz9N2bTRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArnYsVhcIrPM8BpfJTLL7oasSvWWNnxQjTravoKvTJxg&oe=6A4D08B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JC1hdjg9CcQ7kNvwHfa8R1&_nc_oc=AdrIF8OwZxtUwkPLyqrf4tpEIWciuaBa9synfnuvrMONGUUpRFNbZOF0kNTQ3HBxL54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3_6JVFSZ6YCPRrNaeoIwr8CXBIRaJtZ1gmpkyuheApQ&oe=6A4D0B06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
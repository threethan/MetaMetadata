2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahY7efm81e0Q7kNvwFHpk-m&_nc_oc=AdpAMBI0tAmVlb5GR4A2O-AEmVfoxcRwHg6IFhla6TppxWD4SPdfNHcqeWksaWl8Urw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB1SYxNRZC9yCu2FXLSOYzW9-TaJzTIycffirqKoANng&oe=6A69EEDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3SfDxng1EEQ7kNvwFAjVVH&_nc_oc=AdrHMNvcrG2ZWzNUxgkUWk439pWPUVeWmtRmVwXjHmGY-nZ15a3WuugORQyhm1J7qU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8N50-9A4HemGob6EjRvaYBIbDt7l-LkE4qa_ixYznYA&oe=6A6A0129"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIM0t-_0G2wQ7kNvwHC03UO&_nc_oc=AdrW9wRpTsWHhYEMm7doXcDGuVsARe7zDXQx97Z_tsj5k56QWwPYjYO_Gu89WLIDvFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBR3omiSRg8wEWpWb9FCjsmxrUZf6rEy98osA3RnOYpRw&oe=6A6A06C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EMmHYKGA4AQ7kNvwEYe7VH&_nc_oc=AdpgWhbec23N_f5M5IavcH1WvWMca2pe0xonNKIVkb3RB0pZyHm5sHb7Iev6blIAPgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgqZ19T2FIZJk_IoXqb6GTgUXCFqD69UkvfroCuRbvcA&oe=6A6A09B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-2ar7kdIqQQ7kNvwF7YcEa&_nc_oc=AdrGMgxqm0cKAz3JLDhzGtrXSYJUHNBlruEBB9W7j9TpEyfMZTO3yhu7iHXmMrhz654&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY-3j6wTs169Nja7psDCU_OjjWZWtgih0ieR21s5JEHA&oe=6A6A0C06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
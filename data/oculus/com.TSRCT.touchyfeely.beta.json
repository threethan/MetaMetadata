2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNjiAjqBAX4Q7kNvwEfJcbQ&_nc_oc=Adqp4QDnvzJy-O2JYU95HZhQNWMRmKgbW_fUfFppc5hj4kbmM1UqWHplZNYO7ZVt9dc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM2vzBf7buczY-fIa7i0XaC9J_UZw_aQJUcInnaiZonA&oe=6ADDF2DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPKvlylfx7UQ7kNvwHHdttm&_nc_oc=Adrm_pErKA7M-NYQNNRhCaGN8zG3i4j4ovBJBVFXfJJ6GiyVEtnhsbNL3IpMZ6JvQK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8MBTkD9VdZXc61tkOdojcNPPX0R5Qr_hDrr_Pf1rCKg&oe=6ADE0529"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hV5TQfp7_R8Q7kNvwFBYeAE&_nc_oc=AdrQg6yYNJ48lQrqdQ5VkQIF2QRUoBSftiD0-e0PlHndFCNHZVAuUukTqMXKsK_0cZY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJXpAYxAmagbgV6_LAtmrs1ejDEPuVSG681kMj_TPRRQ&oe=6ADE0AC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5JSVQRCs90Q7kNvwFe_thE&_nc_oc=AdplN3l4cFrW_bUtiTEGfl2JgtB9FqgDvidvMsoCgew2UPAMGEf42mzmv84azAEYHcw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy3KACGeSC4oVsIb2IRBhjzfiWFS0gImNWi9jbpomilg&oe=6ADE0DB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ySS2zgTguMQ7kNvwHh5R7a&_nc_oc=AdqFgOjiu27Mf3qLFM5gH_tvRnHTX3bMRgkmm6zPkqdvTmLFB3BtOHyazKegxoQVGfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2D1ZNhYDFH63_rjj4XhWplL4Ref6fqPJnq3ZpD4bhgg&oe=6ADE1006"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
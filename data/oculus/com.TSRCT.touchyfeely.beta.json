2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-13_MjNy-YQ7kNvwEoeQRV&_nc_oc=Adp4tcm92VGG5APmtOG4WDiV5gLOBOzWglo2q9-tTGVPwphcL238R6MJmkTeNfaBU_A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zYUWwxf1MXZM2NcyNQQAlw-kmRCtWWkr1OrsjOuxjwQ&oe=69E618DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jo-K9a0K0IIQ7kNvwFAHCYZ&_nc_oc=AdoB6z9tV5pE8NrVMyNuuLnEKbZ8DcIMY8eo2q2jg5PsgfzDqBClMk5YZGQv0bHmG54&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zfyV6D82tj9b_ct4ZNuIddnoWTSktBRzyXeu4VcoRog&oe=69E62B29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R6MKZoG-n8Q7kNvwF8FyCs&_nc_oc=Adq77mjJTsvvaIAcrNnY_UHw8N6RM2ugyyBfTpIkDx8F56ReTszVAG51scJW9tM9EiA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fIHG0kdAaC3PPugwRh6C5aBUrB88uZV9KmYpPw5g3qg&oe=69E630C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LywRfCBkMoYQ7kNvwFYAIaa&_nc_oc=Adrb85kM5lwgy2yeVY5f9jg5Yqxd7Huj0A7yREIs0K5SxAL5m9s4MgUCUu5TGVzjVZQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WcJiAatkJMgkOWBffFb_5jzMTj1pf4sOYx26r8s3lUg&oe=69E633B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F46yMyw-TPsQ7kNvwFpUl9L&_nc_oc=Ado49OojZRhLrjcJgYPO7p3VXz0JYxE5yRBO3hG-rRlTNFAFNnDJyItiEDpfiRU4fpw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FMJf712WEr-u49dC6XhZP22geb4aYAapq5tUkurtguw&oe=69E63606"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACvgDUiPI-YQ7kNvwEqBLaC&_nc_oc=AdrHJ8kmOpQwhHqGquTU9PTm7pmAeYlEcNpNywVESbz0SWXq6vamg796jgyW-qbaSVg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPQHxTdBKuDGiEfFaMDja2JkeXJ6n4ACNoGzyX0dLynQ&oe=69C674DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uR-xQTAwGwQ7kNvwHs2U5d&_nc_oc=Adpi6JEaQdx3SvFI8hLG2iSdL6z9EX1ET1WkBuB_eQgKoT1PkDGUm7xzTrgee3PlF68&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNa3WVn5Lg7wdm42Aw1Hmyeop1HqCDV26kIVPyewgBdA&oe=69C68729"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STXWgSP6ZUEQ7kNvwFHrMT4&_nc_oc=AdqPajlK0NTb_bOGqLHS4LvNdvIEKPgn_2FxJEMhaHjPyC997ubhp_faC8hYRIcmZQ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_FLFMtCIHJadG6SbRV4Xn8CXddqsEPu7vctY0lwDq4A&oe=69C68CC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aisJMzMBx8EQ7kNvwFOnA78&_nc_oc=Adpb8sK-GW8xDTlIm4yq4-CytI7EK8npoRAhSxfv67sZF5wgyFtQ1anDGt17FLtBtuo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRpcjI9sYdamoxtJRmfN6zXyd22AFCK4e1VEECjIaRMQ&oe=69C68FB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwBfyg7gBRkQ7kNvwET-7yL&_nc_oc=AdooC_0kUMllgjX5DyqyReTZxookq_2Tj36G9ys7IH_H2NlVEtSqSji7jezVG2vgLX4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzeLzIrMwX7cA3WBQ1EWcERX4b7xUTYdHUcPMX1Gl9cg&oe=69C69206"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
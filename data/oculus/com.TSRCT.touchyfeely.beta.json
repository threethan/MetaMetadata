wGTBB0e&_nc_oc=Adma8cxMQFMI7Gzc8c2X9NUgpkvpqLcO3fgbfNzsQD4HElU01XLXPvHKN5gpe4LlfLA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftWCgww6oRGUSQbGIKs4HLuCdbDfFMn2nzAn9OVDK1gyg&oe=69A18ADE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1rTE-BpprIQ7kNvwGFo6me&_nc_oc=AdkG9IOfwCPZjhlEWU9CnD8S_Uc6Vdif4h_ytESIEPrAEwUK74-iCLlzizvFu9Qu7jc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsnPQC4haZZkgnQiVUcCQg3ndThZ2DNhnJh444EWE23-w&oe=69A19D29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7lcbByCp68Q7kNvwFPCnTy&_nc_oc=Adm_zwtzVH443hvrXjCLAGFjJRT8S6rqBypaczQq3mwO-IQbcixiIuij7Gs4AKx9w0M&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftRbkufIMv0kBFAEtH49E5ytb1xQ2v0IeIkRodUK51UFA&oe=69A1A2C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ezHP3cC1kUQ7kNvwEPvcSs&_nc_oc=AdkDTKVYTxPnhIBMq2nyBFQH2MLKPR2KXXGYXHdwmVozCjPPuT0ZVzLsyUWtXTPEt5w&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftfuVbiAuWr7M5gMchGduvmt8H-_F_ZVEn3UdikaA8bhw&oe=69A1A5B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6Gdd4wtlCoQ7kNvwFgVhl2&_nc_oc=AdmZfDxasIB32Vegb07Cr8sLbYF3bml1sVzIst_O7gLwF6VTBiR_Ja32fDzDIENoeSE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfteVkpaxztkKtWEIiAYZWRqiXKVHZs2Fs9ktFKzKg5Peg&oe=69A1A806"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUTP32Bl3VEQ7kNvwGpfTcA&_nc_oc=AdoVw4s8uqexPDrrOmpUayyy14JRH4-LXNm3WbqIXUavIklWP_GE12Am0YFgmsNOVe4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDszCpCCSdnGD6qY9jeQ5c5HefVPZcoWcpBc0do-F39QQ&oe=6A4E3F5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIaNb2wdopMQ7kNvwGTmesx&_nc_oc=Adp0VcqUr3BT9THZlQRSUZzYlIu7Fmp4pY4R8WBn_6jDqli7w5RkzRcL54psOatgmKk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4zwCygKXlrvefWQZG_Z1lBcrgLu92WY8X7gu09zCs7Q&oe=6A4E51A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FllyYRhUDV4Q7kNvwGYOsE5&_nc_oc=Adp6Ik67amhroyJXeJSm2NpBlNuLFT2MzkathqdCDd0h6ZKI9A1Dgi3_kg3nUK7-egc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtKdMYHRpcXX7R1dPevsGkpLM2AniHV76_QyTFKX9ljQ&oe=6A4E5747"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CX_sxh9N4xkQ7kNvwFmYUhZ&_nc_oc=AdoTwDiDs27MA4zlVKKjEIHsiC_06j2H7GQUr39iiu-X3kTXP0mQwZE7e6Xy9WXlKgw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWe0-PBN-3jkY9Bk0UPPCRcfa_K5PiTFDFNimccMz51A&oe=6A4E5A38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Etu8cp3o5YQ7kNvwECK4ZN&_nc_oc=AdphHT0AJd23S9Ygq7NzcrMh9uO-FxmTPTiBqL9X7DI8gR6mWBCKpR98mFMriIEpBls&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhxNzYKwHYPDQwdYDS6pWwH12_G75N6oJIhepmLe6c8g&oe=6A4E5C86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
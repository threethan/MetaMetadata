825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDIyshYQ4jYQ7kNvwGtMq4q&_nc_oc=AdkaU13QaHYUGhYuGdSbOGSlpzJaa0J81Bh8yYBwn2sIoKrG-hqZResLlf6LccZW-AE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx13iD1zB4ERRFT4ukpHtYLo-5xEki_h9jw6fL8F-pGSg&oe=69AEB9DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcq7XxxLV3UQ7kNvwFtm0e5&_nc_oc=AdlYyF9-sZ0MWXbl0bwa6s18rWlivlvny4KCcyQB1FhxYMCo-KEPxja8ebpT3e2Wp_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxX1T2_N9tBqHXfN52hRVrTqPtpwwLFPuxklnPgRSTRKg&oe=69AECC29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJ2NS53ZsAYQ7kNvwG2KIR5&_nc_oc=AdnSdVCv8LYInl7A4hc0HrS-TYAlWK0oxHcdgrcwFAJuBXRnn8_8m0YWic0XA5b4wJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwm86HOhqID0_ucLhUgtD3vqKFAjcUQQYUpjr6X4W1ivA&oe=69AED1C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKr62KgI_R0Q7kNvwElmx4j&_nc_oc=AdmJAE_4THNXrnHiKXu-pGnXFtY197mgHw4M2nGa9bwdTgvXBDLr-Cnq_GKtdUC4p3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtWbuYqKe-5Z5FqcZ9DW_AfbOzgdDL61h24kE2FeF46A&oe=69AED4B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlXWE52WdTgQ7kNvwExKeOo&_nc_oc=AdnjYpBrudECUwiorbTmAwdd2O233774Z7nUv5YKh-BoOm2iDFQ_j_90wow0mRxx3bU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyI27RvT8zjJZVweAD_kapI-IeGfX5pVP4Js0l1SzXYGA&oe=69AED706"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH
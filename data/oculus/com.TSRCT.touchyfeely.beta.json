2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahY7efm81e0Q7kNvwHQu2fL&_nc_oc=AdpT_zZVW54hVIvgy1i3zPAYCcjVCG1PFNsJrvycmJtbh2XfAYFF01B0zuFVJP_ABuw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAa5K37jqOLoXuRBZ5CwhV-IRYUpKTiBNGF-cTogyNP6g&oe=6A6B405E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K34oarkHm7IQ7kNvwHjlqZe&_nc_oc=AdoWUjbn8zpTuphN9jyWAWHvnNYewS2y_Kww1Ggh4Nsqmc1h6nB3Ez3ydOKDtn293zQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJOwUOjtU1vRNs6xzzNDLPDeD82BIwkmkIFtmi14OSJQ&oe=6A6B52A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhdZ71myfZYQ7kNvwH3ITj4&_nc_oc=Adrvrh_pQtViee7OK_3KfbYvlSadf1FxBx3H5TeupPsylo2iGRd-l_0rxh_y5RhzCKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABcegybmRX08vNGvNBkKzthgmh3aECm8kg_PvOApkRFw&oe=6A6B5847"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3KadiX29XsQ7kNvwEE_UaL&_nc_oc=AdrPPtQK0CZBqbOkMVqZ4cFTKlfMjhOB7qkIMFEnSNx75kqzbxTz1vn2AAP5IqjH3PQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjHrwyQrH9Hk5Kk-o-4HbYu-0a3vC0aafHv2JxWcBlrA&oe=6A6B5B38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-2ar7kdIqQQ7kNvwFuAkYL&_nc_oc=Adpfbgi45gCQUWZhyotyvPcvc0SvXLR3IGwTkADwQRayyAahf6dlhFt2peHLqTh1azc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0cTJiulsFNIBhoa4l4MVUC3cDFcnxeckkaCHRhf01ng&oe=6A6B5D86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
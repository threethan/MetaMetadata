2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdKBKg_k_VsQ7kNvwG76pYR&_nc_oc=AdrlzUNIVCctRoT_42yr2MEMd82uH-qBpgYjkXhFVPy3LHhO3wLC1X6QjBUi7KMhyT0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1upeGA5WwYmJp9P5nzg4EMFlogA-z-kRSsTFr2M2wscw&oe=69DA3B5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VZpb9vi6_wQ7kNvwEZFfWj&_nc_oc=Adog5OoaO_5CwtaCa4ZIhv3BcPC5AgD3dp8IrggckI-ZBsRtAFYrPd_DrRw09By9CAw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32jQJqvjwjrwtOOee8J4hXxJl0gHrim6Gr7WOR0YjBPw&oe=69DA4DA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v95HIsraWsQ7kNvwFJN6OW&_nc_oc=Adr4Gp92qiU2c7efOCtw6J1t8ZycGOYf0HIp3pcOS06k7Ug0SaQgWkaxIS4htUecg1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yw5gQu52buDjsw44yGozgZHl2dLJRc1h0pSKf2wuFGA&oe=69DA5347"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAJvVQusrrMQ7kNvwGjFO9j&_nc_oc=Adqo1k2bs_gzO02D9v_oLPidgbSS-5LOy8H2UwnN6RmtMxs6n1Q_1DfGVbI4V48A1uo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jp3ipwZCLK6evSSO8cj1QCUPyXXbTH7Zg4bH60uXHuA&oe=69DA5638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1F05067rnyYQ7kNvwEHrN_F&_nc_oc=AdqR_H4Be52FZpTagoaATJO99szPF5gfOt0LjpmZL13cmdAQ5hjBG8UWDBkePgEnN1k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dBdAdjRjV47r551--rjIxOi53quSzWLOXZtfzeiwcFw&oe=69DA5886"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
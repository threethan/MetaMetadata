2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TO3jgfnyr8Q7kNvwEJ8Hd7&_nc_oc=AdpwgEwYzX2EZqGX_kyRzqr93ONfflKGLmBKOaVejwQYDKM0g5lJBk51WkMYLPM_IFg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42EcbktyYdR9DUWHVOMb0B--9lL2ZEPX-EuwIgkoRtSQ&oe=6A0EF75E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnQoYKjzhysQ7kNvwHWfmvZ&_nc_oc=Adq6Lac_MWVYOnrjX76xFDa-47IwJ2cGnXhJJgm3CYocxmAhzS60AogA9yi2jr7rfos&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mPzXQu42m_MwYbypDQaApg8vmuJlGqY3qsS2E5cQacw&oe=6A0F09A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsgdDrIG20YQ7kNvwFaDe8x&_nc_oc=AdqvivjEU6GrONrR5lYYQViMcPqJCOaC1xvC8CqdXqamYQmoHDwGdkIKRg8nUr-IJgc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RZRc8QqmCIdcnX50noHXYxV8tgNcO-zebfuNaP8zN3w&oe=6A0F0F47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PWGj9wgrXwQ7kNvwFS-HMB&_nc_oc=Ado0LxmIyXcrDyQGR1KeyaWtjLIGgW4VtBXmBr5i-XKdAgQjKbTmyNvt7e8KNotXG7c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zEf4X2MFUH414ozgf0ayY_UNK-JfNb3xpEPrTbQSJ9A&oe=6A0F1238"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFo-ELJj6KoQ7kNvwE_dSmx&_nc_oc=AdpnuLJiChvcUABOhjvYdJZ6DUg-8hclyh2Mrnk-lrzCMXog4qsjlvaGWkGGtZWQiCQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6djp4zMhWqlWqqkSFwWp11uUMi2vp809SOYy94CyJt6Q&oe=6A0F1486"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
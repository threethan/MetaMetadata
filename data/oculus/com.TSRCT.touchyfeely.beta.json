2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A84Ot_iS0cMQ7kNvwGl3Vzz&_nc_oc=AdoqJYSq5dtM1kQkj3uwD-WLhOYajJ9QwifhhkLWzGjvrCb2-0JkboVUQ-x5nkfsrmM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoTPOJzLSOPWXIz-e6HI8PgkfzLnVW3HpbNLE7Cqm5XQ&oe=6ACD079E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9nGoH2iHHB4Q7kNvwHFp-hr&_nc_oc=AdoWJxjCadRBsF5vP6bhicHykuNdLUDGlpg_tBtqFDMrOFNxOgP8eK6zEPHJ5woiuA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHBh6ids5a-QjjLgwgO4UJ_jYSfqQH7J3iDfIZ69nhbQ&oe=6ACCE1A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEP8EkIG2YcQ7kNvwG1tRlR&_nc_oc=Adoz8uXfsXN-DOilW_OT6xMqPCSv9fSy4Daugn5QoVCrgt7JUCQbAy26aVCem0qJ4is&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPvK8r-y6bEbXxRDExsKDRstnexOn0W6bZokJMW4pkDQ&oe=6ACCE747"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KedsBnob2vkQ7kNvwFTDizR&_nc_oc=AdpQ0pKfatMwEH3Jhi9_J30TPAxGl415W2AwID53d5zyyGxQZfxTOVDDglwJKelfiXY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGZfogSTmiUL969YAm28jsxTMUq8M0R6PKitonYdj_BA&oe=6ACCEA38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnwPz6nA1TEQ7kNvwHZUsEs&_nc_oc=Adqgm-MRNctVEH4DSAIdEuU0WuQ0Pde7JkYmXhQoDDGEUxTEM8kgIV6zQ4Ec_r3glG4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzX0siirzTOO_UQK2z5P5UiypE7LEjfLW-ROIs2opgag&oe=6ACCEC86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8cscht6GkgQ7kNvwGV22Gr&_nc_oc=Ados9P3U0C8hjKuD1Ql2HgulLjcyZL0Gt3oWssX5jzQl86Lo8xkukpSRjOAaG0JqLNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUUgMWTZM1BJ6BQo34ub4g__fxoA8VOhl9OMGRCDLW5w&oe=6A5B6E5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNR-8vJM-akQ7kNvwEDa0X8&_nc_oc=AdrQyi8bycqNm2nhJ8GJuqBjoJoBNflh9ytPaFJEQXeorL8UFAvO0fsWZtMNBctzLHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVVu_hb6MXPwuIOSoUl094dZ9MXDX-slZ2ju3dEcXbuw&oe=6A5B80A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pu4JPV-ioG8Q7kNvwEvTptO&_nc_oc=AdoYoNqheMfQSd5xzCvP_IkC5f1jLrC7ziUQmV79jRSbQq8lIE9CzHxqBebVcp-RPZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcbDRWL5KSa9RfT3g2_VVFofUn0OVXivj6AsJTffSvzQ&oe=6A5B8647"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnxMStI-6uIQ7kNvwGohNl1&_nc_oc=AdrWkU-EvMo8LUcFqkPsBX1iLtpSPVf2FPH3-Tv6Hd5JnQcROR9tI6a433rIqD4Uzds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0kUMkRfrlfwybfaOpQx4fsB3qTpiW2bhYearXyPPo4Q&oe=6A5B8938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCni_-zB1k4Q7kNvwHkhWMu&_nc_oc=Adr4lTyHxJAPvJZMfLojuPJ8AC598uCbUjv_JAKn0KiRY083WkhsS9gndH_YlJX3gl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXOvC3OD4ELOYEpavto_Fk1b-O20J0ki2psj4fp2gNng&oe=6A5B8B86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
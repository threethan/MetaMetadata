2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jVpDg6zLt0Q7kNvwFNDtP5&_nc_oc=AdqeOeCMsBQU4gdwlW8M19trU9wQ7iZuccQwVZaU2UrQtYZxFG6FZuq6yIVICZyk8e0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBglEtTWOAy0GSLIZ0ow4rn9yyjgrM7Z3VxwwFun7bDcg&oe=6A4A831E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVKqIvyj1q8Q7kNvwEo1uKj&_nc_oc=AdpzzTsqq7QBhrS29EizamnU_fq28HCmJtGWI73krQmfv7Rzp0RIhej4sMsRq3g2R80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPsdzt1JmyDHUbzypUCtFvqc9g43mtOhdF27rUBMdlag&oe=6A4A5D29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHCA9f2NtukQ7kNvwGiwE26&_nc_oc=Adrmw3Ss_DpelytrNqDYC7X_y7Pmtkzi10oal-4x3F_b1gwbWOfCBC-EiEjajIwr-Qw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDz58lTAysw9-DV_VQkBwmt5XcQApAqqzov3Yc4b_RzLg&oe=6A4A62C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAbdTglnxREQ7kNvwGtb7jK&_nc_oc=Ador2JxJPnYUqqbV_Y2MADuQG592REYpH-v-kpl-vlmcx-ac4815na14Al-AatC1Uzo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApH-HAs5S4Vx2VxcX9cFg3mZgkkCnH9mR02_lNVGp26A&oe=6A4A65B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JC1hdjg9CcQ7kNvwGopHT_&_nc_oc=AdoqYZs787-ernExU6MCYU8LeerbvjXN6BqJXnd-yDu28C2lw4yhhx-0FIxqgbpI0q8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfxM9lW6Vvte3ChbHbRU7DZlWrlnxxeWWevzR4FTigwg&oe=6A4A6806"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TO3jgfnyr8Q7kNvwG3NmSQ&_nc_oc=AdrsDTmcyFnG8t7G-o0B1ZFzvsWnS2AjfwRhovghPMNbZxCgG8fpEDnYYJCatZyi61w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55Bxy6eG0-khi4XE3y0rvZcaZequ-3aasKgDJtfA9ITA&oe=6A0DA5DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnQoYKjzhysQ7kNvwHXpu_t&_nc_oc=AdrCDezz2pGwMwragbms5Q3uRJNfl8kWM4_xTAVtkxtkEp6Bo_GgAADl5JcI-USO3IA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YhtMBXfFVZCACy6EC-WAk27QkDXcDIlk2jESNxM9tsg&oe=6A0DB829"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsgdDrIG20YQ7kNvwFH0WLf&_nc_oc=AdrTpR9Y6bUGutQpJnFD0qd2B9JVqX6-vYbxf2rP9orv3aadflb-l5ua9J5HPpfPnUo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69QSvFYp8Qs74_pI181JJVuac5Zm8r-XDexUVwEnhplA&oe=6A0DBDC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PWGj9wgrXwQ7kNvwGULI8G&_nc_oc=Adr2ChEwAX58SnD03AV1CafSeA6oL7hxrV2LZOcQ79eWhH4yLMSk4UZnfvJympq1PFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l_4MOrtaDMrz4qukpT2GVmynoKmDcd2j_4fIFQT2mNw&oe=6A0DC0B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ez2-R8RHd8Q7kNvwGfOIRo&_nc_oc=AdrSa-dUlIxfD3NBRSm-ycTEt_1jF5e-m-JRQf6gk6PkH3tPwHz1HdQ8ygTyf6lUO3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F2QBn-FYrkvQZGwHICbE6UW8LghmJtlEfpcNgeuxsDg&oe=6A0DC306"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
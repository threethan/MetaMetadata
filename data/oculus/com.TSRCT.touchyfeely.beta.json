2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW_9iCWkjGYQ7kNvwEds5FP&_nc_oc=AdqPvm6unVdUqc2h4fM7XNum7mSxGxW_3sXKBgmv8lBDm_BPH1VJD865OL_F4oWf6Y8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5Q59ewUkG3500hAz38SRY-_V9zy8hrW7F5Ig7PNAS-A&oe=6A97325E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fsue3BMjzRAQ7kNvwHPKSzv&_nc_oc=AdqUmnQ1grOQmCgElIvRK21iKUi_B9ByJniGgQcBx-dXvMgQRGI2i-MYUw5CWPbNAaM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMFrKsZtFlMwuMnWqpWEXUTKLDwQjX5g2gAN7qSIF4bQ&oe=6A9744A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPntrSlpkDEQ7kNvwFFqz90&_nc_oc=AdqbMJ-IjIaI6KBJlugPoAaNtZjP5vJNvxBddlw53-JhrKCDWBPG_N3WUfmc2qrgqzU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTzl-7loiDDWLl4kczQFvGT_4iHegHZ0VJYs3FSVt3Cg&oe=6A974A47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLbQNKDTOFsQ7kNvwGJXkH0&_nc_oc=AdriklMfblB9japJerrNCMy5SnARf5_lST5mUeCxP1yTzkGlYjFdx8puJMAR-67So88&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6uejkbQbDc7m7N3N02Jf0pSZtUNvmFXOzZBwUqMRx3A&oe=6A974D38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jr7t3JyaikkQ7kNvwEFs9sf&_nc_oc=AdpR3jJs_lO-hNVD2PxxXyjST5C6to3jhSfIpTpZlosaspHhOobu4Gurj8-heo0T2Kw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSaGr6R5scadR_g5Q6IBcU92Ix7uNTMrnqpq9FO0tkdg&oe=6A974F86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
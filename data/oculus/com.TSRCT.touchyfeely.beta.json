825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiIb_PeifhIQ7kNvwFDpNO9&_nc_oc=Adkk8glGY_c2Dshi23tGGaUnRwVDu-Q2RtXf_NpKewWdpAj9PCotLVtPf-MQW-dGTC4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOjDejM0tZMt83vinVaqYpYBRFEDVL4JBirmRzd59E4Q&oe=69BE8BDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r46O7G9KASgQ7kNvwFbkT8I&_nc_oc=AdlVjVWt34Z4tFLgRmcwgjd420HDSqwzDyLPWOMK1M_NgDovmoBI3zsyoK3DWw8ODto&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyykGjyIkyN9NbNrJ6PrR-dhxTMzWGKtN8IPKjMjni7Sg&oe=69BE9E29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCR9o0qQN14Q7kNvwGnMjCU&_nc_oc=AdkHBTXy5wTw8qLglu5hMlBcCQZAR7PzHELgcnhb376zLEcJt0zzPZgS-MOJEDBg8PM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxsrd3nLhomZRIZGUlT-yPi433fs2L52gQDrfcUj3x4-g&oe=69BEA3C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJC3SZnZ9vsQ7kNvwEFgUUi&_nc_oc=AdmO6r0oeB0LtEy3B7n-3k8GXmg4EpSayvcGMOCn--KBda-IgTNHGz_2dPrBTUWYNzo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzI7D3mZq-cDofI0n3-B-FQC5mj5Z95AgIKp9TcOh9mVg&oe=69BEA6B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mByn2ra5oKIQ7kNvwHlhMbV&_nc_oc=AdkAIPCXNuZQaz1aQESe8Hbf0NJcijeJbwVDz4J1GZE8_299vCayQvUiHcoMHkBWjsQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxARMjJ8JEU5ry5FXrmhiXsXI2Mq4Ftnir9ve7iIwhYNQ&oe=69BEA906"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH
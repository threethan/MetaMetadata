2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmTwnJt9Q0gQ7kNvwHZZaMF&_nc_oc=AdoX0Jb0TnbeenIJiGnC2Sh2FSIoVzBjW7uCl1dY18A1STUBjOnjGxwWU3SCrzMLF8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAko1ebI4jVlWMFv3oGAObQw6Wzbq39EIa7XJGg199Olw&oe=6A60B45E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCK2XtZ5DOoQ7kNvwGgm-3D&_nc_oc=AdqJ33EsJqaqB0khYeMjVtzaQW1i8UNPwLS52OHsGuPBQlu19asd7Oe2Vebu8drn5Vg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-CMd-CJfQ9EqkKfU3GB4rferY5iHQrgPvp573RnkG_g&oe=6A60C6A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8ddbsiRQTMQ7kNvwHrgKPz&_nc_oc=AdphlWE75JhZfHFJJnI1sQxBRAbykipzlZE8T4UCu1ZV8t61DMORhth-OiUWg368X40&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7G_O_dkwQRfaUco_wdBiVwObGhvqLuO4gi6JeY6b6PA&oe=6A60CC47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pdT4SoViB0Q7kNvwGvp3nt&_nc_oc=AdoWK_MHkLbIFlhvfT7GJRNCAqZxq3zLiIdhLZQgPss8SkegW5W6XQwcP41_3MMK0qo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAkgTzh1JS5nID0cytxLIjAt9UoDhfjMBAXEntfuQAMw&oe=6A60CF38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKLxJ7PaSj0Q7kNvwEQ0CNk&_nc_oc=Adp6fXZFwSRv0gGU669hYYz8zZNqPaZ4eVDDJiONybiq-b9fOiQeXv64vBaby9_4jaM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-O_-OIdCREqjhZn1LT5luYdMLjEuMEwxUGiP_QRnKJQ&oe=6A60D186"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
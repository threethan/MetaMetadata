wFcDuXG&_nc_oc=AdlKUE--KGQN-FZzQm2QckiTuXDkFndJjYKfShyTupH8WEK9zse1j1XRGxJtD7w-wlI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs-JI6TP4DyB9wp6UJNR65Kl0Kzi9FYQjQpkcd6_-SkRQ&oe=699EE7DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWBCWwYUktQQ7kNvwGR0Anl&_nc_oc=AdmY9Ov3SJmhBETD88ZgHz4UY1XVg-dVKRNpkUO7us5qFM0lvr0ENtlwG9K9Uks9dw4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfupiES3KtcDe-sxIdjhWfDWLK2VZPeruYZO8ituin863Q&oe=699EFA29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MaQ-WJaJtgQ7kNvwGQSaTd&_nc_oc=AdmDPKgrR94SExNnrQcbBQuh-ceDWQAbHiheQ-hNwEEEnT5EblCjZGhi3F0Md2VG6DE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsR3LXEIdAiF62jbcaUuA9wyweagNXVDFHibQhG2qsZdA&oe=699EFFC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shwILzy6HvEQ7kNvwH_7HzT&_nc_oc=AdlSkeTxcYtjGd1SpP2ieEn6VK1NIAtFRbhpPRD7GF6wmGotGRVMow44HZslYmxHw-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsCbH9FLmeqYUuFj7BfhjN79JRjuVyXjeZ35JZG8NrnKA&oe=699F02B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruqTs6y97YQQ7kNvwH2OvBv&_nc_oc=AdmrG4Y9fTTejhYS6wqEuGTKItybzWQBjditECVTIXZlytXEWqh4ZoZzLYciIkM_6R8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsKJsIS8MnidNI68pQNl2EdFZf5NO323c71R4W8nfKV3w&oe=699F0506"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
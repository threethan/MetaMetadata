2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXfeTSlkq_QQ7kNvwHgJitE&_nc_oc=AdqcNDKVgJGmzG7i_OWhVWZQTT9sN1ws53jCsKiiHdE0KHddnP3rl724h8VSVlEzTd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YbAkweQMKIRKwfODI9NwZnfGui5IHFj4MsGLz0AAz8A&oe=6A1D77DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARAFOsZ59XoQ7kNvwFKQHqG&_nc_oc=AdoU3Q43wZ5FRilMKp1x-S7YqsaEx4u9eQZJzQcYCTt0Zu-C3cd7gj8En73vBfXLkNc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Lpq-pOhP0-rUQuORAjsTY3YqRu222JjvzuaK8vJQbpg&oe=6A1D8A29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkuGWmG9occQ7kNvwFIXXzt&_nc_oc=AdqPOKgUlx3agYJQaZVdrm_J3YjDa6TjidJZy-8IOfZK5dQDF6zrW_3ieChyYsoM3MU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h3lv2D_la44T3qO6perkC9_EEB-It2GlamIjj4cKDfw&oe=6A1D8FC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KovacfM2tTUQ7kNvwFUiCyd&_nc_oc=AdqVoseiI2Py-2L5gITRemOZN_L5sDHe-Eah2TWk9Y1eUmRy-sdLAiPgxOnkxKc1EXA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53WyRhj4QsFNDbdPcgWvU6XnJ1MvOEZstL5Ptaf-xZ9Q&oe=6A1D92B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLje84ppO2IQ7kNvwG-lH26&_nc_oc=Adr-z5rrklJB5f1uKcbepmGYS2wrS0rMM5maKRDtKxMb7VRtXbBMtaU57pZSnv_zsOs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_V0kGFnFiUKTTLromuirLyQsL6u4_7C3ZVjTCvGNhpQ&oe=6A1D9506"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
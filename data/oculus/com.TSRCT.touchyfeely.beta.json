2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2SzBo_zKXAQ7kNvwHGmGhe&_nc_oc=AdpKm65JHoMSgpfAhEO3y6edRCRtMAEpkTcNHoXNDTxawUHiUI1xxe2nNGjCy5WBYI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af383Swwc43EXsmJqxgmNXU2OdsNc47jFgwPzF2TyZFyKA&oe=69E375DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kZ8YFzLGmUQ7kNvwEv1vae&_nc_oc=AdogbGYp-v-wM1hnmhwIlx420r4-hjkH-Gwsgnx1FTsVeDXqX6_Hgd8uie0Tqw_pBmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0i2ijIatK0TXA3_2I4AMMsZUzVFwKYnysYfpP8YLRLdw&oe=69E38829"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfocfcR6ESoQ7kNvwFm4BeK&_nc_oc=Adp7xqmD7AXttDYnhnJBwztgJFvzv9Z-X4iItaN2jpjP3Ct-eUgX4j7rWz_wfVQ4c9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HnZIAYHwPk04vhjgRKIYeUavcV-boI0whN0oi3YLFkQ&oe=69E38DC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSERhdYWmkUQ7kNvwGPW0AS&_nc_oc=AdpM7BCuxSArYiK7ip5mjGE0bYfNzvX5-ZzEb0U805cqhkQJ18E_AtF9iJ9Vljt45-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1y2XFvNOJemzMhmPToqKooaPcMmKkBxJIrIaLObomvtg&oe=69E390B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F46yMyw-TPsQ7kNvwFT0IOd&_nc_oc=AdruL_cSqmS6K3X-ju7a8Ox4XSO3zJ97N3ALbZyWPCSZtzdNnQovStDHcQsMaybYK50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YU9c_Xa0NVMn7qyM7p9lQMvkGsHOjoFCJG-q1QNMhVw&oe=69E39306"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-13_MjNy-YQ7kNvwH9ziZE&_nc_oc=AdroNlkBkl-xcyUJCqzOqRhaRUJU_nTIASIjFTXN4BNU2bEaXuZgBhzHxBn5kSDFCTI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OhC6uisAp-SMuuBLTC856vGmNzMkl4XDSj9F-rf8a6A&oe=69E76A5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jo-K9a0K0IIQ7kNvwHGBD4N&_nc_oc=AdowfRDFsQW1-MF8tDibKxYg37fNAbxOErdoqxgGXaHFt-e1Jz5YN50QvXyCKuwJtXU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XTCq4CU8XCm1B16gBk5NzvYxeMQXLp7M8awNaHc3nwA&oe=69E77CA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R6MKZoG-n8Q7kNvwG9-JYW&_nc_oc=AdoEM4XYmZ7eC3VyKEQDwtM2ghUA7wrrl4FoqR2vXK7uO-IHKJ9_mdLf2P5wL4yYJ6E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Of0IedtLlBMUeOYdRxS65GbLYqeaYVql5AOYnIBYSGA&oe=69E78247"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LywRfCBkMoYQ7kNvwGb5zIu&_nc_oc=AdpIrqpMsrMqyL0GpSSlznCmHpBbJz-FyKcc4-ARl_BCf85ZeIYYa17cx0ko0Md9Ioo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VoddoSrBgjXNMyQ0Up2ghBd9k3qqn-2Vb-Wdez2UVpA&oe=69E78538"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWMYSseTjXYQ7kNvwFTvWL1&_nc_oc=AdrtNqSbYSrp_dJmT0QHKK2cCHW9Z8uxc7fhfKLPFuPqSIW94ZbhG1WgHrykpHBJTmo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OjHJ5JmZJEoWX_67i6AiO2UmLyolJUzLEUmOIF-OYtQ&oe=69E78786"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
5843_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2N8YFYWEyHAQ7kNvwHEB-G-&_nc_oc=AdpQ9KKOCqkevzN5w3y6eWyXo57eevueYq7qb62LKwvMcA8nq0KZCj8nHbPWQ_7MmTo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROMUV20NbtfE0e2eb_BHTsga3OPeE7nMkyP8c2GrkITg&oe=6B07099E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDaYH5vWOtkQ7kNvwE2-kYM&_nc_oc=AdpeP8zkg3mttFV1e57xPGS60wjtJjwd3q1BPeJ7wLhQa5np_G1IO6ShuqcQKK5PagA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyeIUdhDhjrnZes_aQ7LyCrjuQWi_u7q1GxmFttVQlIw&oe=6B071BE9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8z6v74RLsggQ7kNvwHriTQ8&_nc_oc=Ado70canRhyRvBalusscnufCM5Z2kUI_L2JFUaAWIEt8JOltIIl2RQNUbBQvx4wzLz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUvrenGXdkj1JB4L6a9wOLiD2oWqr6AzwxPk232OxZ7g&oe=6B072187"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJbmvU5QjO0Q7kNvwGDiKXV&_nc_oc=AdoAL6mGDdpytA1FndaZrFktshzDTmjuSMGJqzzWVz7jvi6iEXJH4pzrTpPeOpjvQTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY1vx4B48dVW616BzCzBFj-LA1ejsBKKHSaltPbd0otA&oe=6B072478"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2VBfQnK8B4Q7kNvwFVkcF2&_nc_oc=AdpxEXzYLoZYD4imuDMzaEGnoPWDhLC1qYvwrh8OQBKt1YT6-tOy6MNOohXc2aAS4YM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2uaKqSu4lBOwl9ukaGeKAfMDRV28ROHbubr5A5icjvw&oe=6B0726C6"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommend
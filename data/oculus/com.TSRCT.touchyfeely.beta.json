2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R168YQSwJVcQ7kNvwFhM77X&_nc_oc=AdrriTpyGJiWFvIfhcvCbaxL7mEl2XvhJLMWA_4mOYx2kwwOf1MDr0Tb0SgR1VyIurg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwd6m7b2iOUHTzPxBno7g_k2HLIdQ0lahTOWbduJWeBeg&oe=69C3D1DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbXJW4Sb4gUQ7kNvwGYw6SA&_nc_oc=AdpX-LYyP4iExtwwgzDD_IMKKA0EE9E9Lmfx7caoMKwL1Q4PXYeeLughomJTXXM587A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyp_PeWOrSxZSD1wYp_HFb6L1OYLtcs2187FRlhW2uJyQ&oe=69C3E429"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOTnKjFOlrkQ7kNvwGBka6v&_nc_oc=AdqLTzzdGswOS8HsdsQhAkoeFSMBbatxaSeswPW2RyGkJmA5_C8wvF3fTlTolAfM3HE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyC9pMAZRk88s4cN5cFDMbLmYm9hhmCYU6ogaTkwvNsXQ&oe=69C3E9C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etNpfie5uJQQ7kNvwGJ0m95&_nc_oc=Adq_opwzM8Vftf9m5qE63Eo6wsD2pghWLHRjMU9an4Efx2pbtuRYqKU4xwyV_KG0cFk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtoUPD1RZSfb2NoLq2kyz71dQ3G5jTaDwz0I-8D8-g8g&oe=69C3ECB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwBfyg7gBRkQ7kNvwG2wVdo&_nc_oc=Adp7ItFX5lqgkr5VQ_0Ba8Qy4x9Qo3Kp8BcPMrCt82hsdEhvw62VDZrqrxGThSwrse0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpfQQK61GccduK2DgLTdOVL58R83gJR4Wl3qfWTkFIsw&oe=69C3EF06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkTsphR_4bYQ7kNvwHrLHfR&_nc_oc=AdqA6qBP4PPTSg4FQ5ohb8_-KcnWCX8zutavpHyLdwX5_8aacx6UOtgBPyAOGS_UySI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSZfgN5ByAl0T0p6Zp9IKRNZpP34ItZDmlr4krkLQgqA&oe=6A674BDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3SfDxng1EEQ7kNvwGusej7&_nc_oc=AdosT8xIB_PhWztLlyok9_W26l4Yhuqs4O5PV1gf318eVOcWPoTDAa1n-SzkB6NL0hY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBezB2b_VnDfjHFsAs9-fGEb2KX9ZSjnF9DBB6o1gtTaQ&oe=6A675E29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIM0t-_0G2wQ7kNvwHa7ptK&_nc_oc=AdrJy6mThSiAj2H0y4E54RGbhqNdaiUMAwKeoQt7cECNcVlu21zccajToQ0Hn-oMywA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUxdK1qxy9RnarfEJlCOOBnZusCoN7QhrtN5nsevKANA&oe=6A6763C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EMmHYKGA4AQ7kNvwE_hiU8&_nc_oc=Adr9YjanMqk3F8BitGlvMmqQM6jXS8xUkL-5oezEj1f9EA4eNEsCwM6emlfMNRuckHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzRzcQ8MuCofuFpLP1c5ynNMR2xFYJPO1n7mitdaYnjA&oe=6A6766B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlEKdBH8OQAQ7kNvwFU48Fi&_nc_oc=AdpnPOMX9dI1ZOCxibHz1H7jWm5T6PW5FUc8GwZHrvzC3komaLj3Ew9y7i069kfHcXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiUoOPLMNw9Bjjl9MBnFnQ8PZdm5hVQbhNbLLUzyvO7g&oe=6A676906"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TvxL5mKpI0Q7kNvwHhkl8P&_nc_oc=AdpUv6fx35exM734npky_-gqE8LdZOKtN9RfB6O1wUJ7iz7vAUr_CEp1zrzlW3DvbvE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9HmxesZwBU5ukaFNeJJKU83lDQN1a9sN8x5-xUKftjA&oe=6A917BDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtcucJhjfjIQ7kNvwFI5QpW&_nc_oc=Ado99Mi8hI-epVKrhqOUOgqT6BuILGWlHAXaOLJYzfSvRs1nQrnMe43f-9ivuaMJbfw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG02cFUpVONWAqhAWHBMKF0TW3Ra670ZQWAB87sBVuz5A&oe=6A918E29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLitJ8PGQ6oQ7kNvwH346bL&_nc_oc=Adr3xpjnY8_19OPgEW-LsfkFPXPBtTLTPPGNohuqGs98kFCc5mfC-RlrzHvNipkSkUI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_wFzv5_0FvK_OxWmMGtsG9HCzCtawYMMpouTx4gBrSw&oe=6A915B87"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDWssLBViI8Q7kNvwHOHdSv&_nc_oc=Adohf5baj0yJo-PQHCMV5g9cFm-WzruBcdSq2FekF8YmfVmIlkPCX2egDzqD9mJly9s&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA-VI1ZH8gFXBoY_lns_dOzoAofy-AIKnM0SeCd5fgeg&oe=6A915E78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfBJADRIx2QQ7kNvwES36fg&_nc_oc=AdpRTl98E5vRZh4Aq_gp661hQ_f-EHB7aeLOvpPxN6S_kcBmgGQcBupOA4uzd3J08j4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzQJ4jRvNw2MkeWJhEqKIsxoKjEKlwMKl818Po-S2vIQ&oe=6A9160C6"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
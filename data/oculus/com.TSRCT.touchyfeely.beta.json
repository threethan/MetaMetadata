825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A96K0oaN3yEQ7kNvwH0Xv30&_nc_oc=AdkudttbN2K_xk4tLuw0mDNQuOKRK_BaKb5iNQTm995tqNdtMuCFTXo7i_hDIeF5VgU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMgb919JjRAM-f7CZMLyxEicdCn2ax7UuS370uVOuBbQ&oe=69AD685E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcq7XxxLV3UQ7kNvwE517pP&_nc_oc=AdmGiiNJ9dcRB_fRUlOitdJ1O1cBiRehOBMmVIzbFUllAPaHPvw5x2z2WYxQOgnhJek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwr17kA6ll52ZfnlMWRsSch9t8--aYvqScQz1GhYNJL0w&oe=69AD7AA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJ2NS53ZsAYQ7kNvwEFcl--&_nc_oc=Adm5j9RHqFu5Il_fVdCJxeQCqNfDPpo2XE7juWen_wcEGh_TNRHbqCRF_vlibch74t0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJCCpfJmAeBb13swRN9kPW49LlCCdU4OETycy2Vl7xiQ&oe=69AD8047"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKr62KgI_R0Q7kNvwEjTivQ&_nc_oc=AdlHFxuQZarUw5plDWjK42TtXv6BNmAra-GZoFVEH7awBjZ6bd8lBbZ-6WF87s0SxO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxI0awhFfDujw1nZET5CjRKeLy4VyCz6clZAuV1h0hS6A&oe=69AD8338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlXWE52WdTgQ7kNvwE5CJ6x&_nc_oc=AdnzxumMmkA_cX-xhmrNlFnVUMN1keRxU7iCsTCaBY0D7S5gB9zm6dacG1PNJErfNoA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6ZRq_O_yfyfWRXyEbrDYl9bRjMoERTCzIq49GEnOtkA&oe=69AD8586"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH
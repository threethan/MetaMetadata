wE1rTrl&_nc_oc=AdlIT5GBUxKnDMamaNAngmomGnHqSX4qGd8z8Y5hHMrZQ37ikJ3XbXH_OcyFpO68IDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvrKlhok_wfRKn1BCKJH4Y5ry8F0W1xbxtryeyDKjfnXA&oe=69A2DC5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1rTE-BpprIQ7kNvwEKjs_r&_nc_oc=Adn4awYhGO6JeNfITC-jFv2V5ujiCbHqp-4gHlNf2M-XDtJByPpcfVo_aYWi6kJBMzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsue5_ODjoA8FuoB-Sn4oAdrJyWpjOUcOIE4dPCGh7RDQ&oe=69A2EEA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7lcbByCp68Q7kNvwGGdFsb&_nc_oc=AdlEeiZUm-2O6Ee8uI8qgGKTIgOAVamZDAegyk9N8ZsPCbcbmtSl7qab_Q2NErMsk_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumMi7sVDopKY2P5brHCBF9EQIYn8QJvew7CLviYnFeXg&oe=69A2F447"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ezHP3cC1kUQ7kNvwGKH1mz&_nc_oc=AdlfDViXGMWGSGNBFvCmbcruS9f3armysYtNgUswlmyy1G2HdgZm871bDaDju5BYyY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsd6C9BgGW0tqRUPVGs9jSmZ2zhGhlqR9Ptqo9BegG6Gg&oe=69A2F738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6Gdd4wtlCoQ7kNvwF9FY9j&_nc_oc=AdkZHCkpFoZotCRc1Wz4ro8a1-yG2U_FBirsx7DVUCzn4U1hUeGe5an_8ZeGykd1TB8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZZFlQ8kizxyp3AfCJy15_uP3YN9j6-iZgRci3QvhZsA&oe=69A2F986"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KU35TkLJFDIQ7kNvwHacO0a&_nc_oc=AdpjTCZBxllOd0lZwPxjjP2R9B8hrx0iUGiW0QmjUzjzaQVMEWAnUejiX4YbLyzUEjg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F3K3yTHnYmi0Av5tq_zwvrv97sEhmULw6OTVqAeGCww&oe=6A2D49DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLCm2v6wlV8Q7kNvwHqu23w&_nc_oc=AdqZZWn7LnxPHG0fe2gASfEEPhRGF-Qrfm0-1VLIuUDzIMaxhlAuvgf4d6UHFpp2VPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9VYwMOoN1prMgiCoI1Svh4KqYRwdp5QI1DcXOoCEc6Q&oe=6A2D5C29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyCELuo7Ju8Q7kNvwFs48Hh&_nc_oc=AdobaXHG9tdxWdma6ilvQyx-1zKmpVG5WiJFbYOn7JYEFaUqFTg6Fim0C3ZEYbkaWSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wjRpkyPMMy3FLuf5KfOvCcGwAJt98JUO_f3dqu9pOmQ&oe=6A2D61C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqhXT4wF5ssQ7kNvwEEZW9q&_nc_oc=Ado_ntofquNxTu5DGAOlWne5-BTbFJnc7oQ6m9NiIdSt14Vh9uif8aWOuEKDqzImu08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sFhwEZ8jAZiTEUfbuH60Ssblo4GiJ5Lm1R5MskExtHw&oe=6A2D64B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNbrpmWBDl4Q7kNvwESBFym&_nc_oc=AdogtnAO4y5zCOnGCciuxryS6oNrHit6KXVZVdvSsXcBIJIRsgFsJt4x1coNi4KMyRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VrKnzYiaGVhgnOKczDrI2l2ASwPR8l3ft5hi6qivYZQ&oe=6A2D6706"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxmhZ92ec9wQ7kNvwGHQVuh&_nc_oc=AdqSEwrRdY6NDK1rFNB2D-IZweUeDA4DC12bC89kQRG1MXWBSTivHEG3j2flm_IY66U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2bxHFwT5Gg691ewasrnLKWlWO90ZBIV_XdNhkIGXgaQ&oe=6AB69E1E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcnIFFmfpGoQ7kNvwGrd9sD&_nc_oc=AdrK5DU8q9_0kr3elWEoPn12wT4kAqJjZ5xDodgGwR_UE-5v_YI6ieoD75BDfFaG7wk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL73VY1WFWK9AQCk1wMNr0tyqdLXTNqcL-fK9f_0_vKHQ&oe=6AB67829"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2We6PLWnqEQ7kNvwEGjKSB&_nc_oc=AdoNrNOSvuM5HCEkjCg0BAB49cwk6Gt8ifwA_u5uJRr9z4CYzswdE9eo39aGGC_14wI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkK4mittQYLZpKIQ9FLqgqzK_b2Gn1ZG4LZFlPGjEkQg&oe=6AB67DC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1BC7Ed82ioQ7kNvwFtx-Kg&_nc_oc=AdqrB5oAoPgPW34zHMveLQHU4fw8kJWVQNXzU-LOfnjVvGZjMnrdhMBZ2Yxq9YZ5TRg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbeEmgpszfA9jYFpZXl3wWvA64swd-dWvq_1y7c9qpGQ&oe=6AB680B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZ1yp7ntWrEQ7kNvwEJCh9k&_nc_oc=AdrqZdcyOsU2ouY8o43TlxbCEv2BBAK1W_qHnqeHNRirUGOIIDHCL8JQpmWAeVq-VEI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINbBU5x2gCcE_WFbNXn8qUHtz0fRlkocjDa4ps1MTFdA&oe=6AB68306"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0CENxBlQW0Q7kNvwHAm44J&_nc_oc=AdrCYgBHTSJsX8n1XdOaUq2Ashvfe2EN280dBstJ-f-MGnNtR0jt3Rdp1oPAZAxiSow&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gCN7K8Y8nuGt5jwLrPaTgyIrvY_eu71A2x7bK-Zn-sA&oe=6A16E05E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDTYTZ8KT4QQ7kNvwGhNGHs&_nc_oc=AdqOAQr-DpcMYQQYQZquNpeveUjISH7kTttD6eMtmUp5ar1OghdZAwyUWrD2KTbGIG0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YFG6kxeEaQ-t7FUHxWLk1RmiFFQAWDd2HBbf0NAQtEQ&oe=6A16F2A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPq5KgvYe4oQ7kNvwE2zpJW&_nc_oc=AdppwuBZZrL2r5HB5H5ZT05n0_Bj5f6gxWQ2kD_urHwWYHSwJnKqbLU9ifsqLK1-Shg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uoLpnlhZPP_hM8Q_G0Vzw7vItnYWFEZFxzQfYYoBuAA&oe=6A16F847"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VphRSH0yzA8Q7kNvwH2F7Dr&_nc_oc=AdofcEfZzA_kl9IPU9XmaJ7yCRHqfIg6NJi19iNTkw5HOvU2dIrpSWUn8vyqDczNdUs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c1hipOnT_fxaduyHDBB95L8OJ3agmNwytTlZYIUWFOw&oe=6A16FB38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AF9bJtsbVHQQ7kNvwEIBPpZ&_nc_oc=AdpkvyL2oYBnvlWycPc6IZkNQE8o8-SuQaUiFR0N5XHusb945lFfm_ZgMAfOwpRR8Y0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BTQI3Bfqz8EqI2p8fYyMGH9bN9NFJHBWPxlHGKrcksA&oe=6A16FD86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
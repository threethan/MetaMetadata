2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6aTBWmdvesQ7kNvwHhInz_&_nc_oc=Adr_uPYcsOXHw2HcWWJ3StmlmZJGRove_kirZopte9Q_wpoMX5yGz4fIvL0JquloNUM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIX9DtyvagmAqNPxVSX1eLo01-Z-_PqJVBsGiD4oHNUg&oe=6ABA5A5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZpc4RHeNcUQ7kNvwEAwb2H&_nc_oc=AdrOR1LpT5X2pM2D5pY2QORO_Q2GZXWfzwjWl_mlKsonEUqax0sabw3L0N0_wNlEhB0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlub1X4y9G97hcbXF0GbPSbOrEE9rWecN8i2AZiVWOdg&oe=6ABA6CA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XWE4JjI2FMQ7kNvwFr8h_Q&_nc_oc=AdrL1a6ejUyq9b3Vw28ZuU55zARbOAzApDqEPGY3Vx2a_xkdk17NBy-HOA7LQcD0VSI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCgJFmYxLD4dDhCTrLR3-0hnGYHcs5BpTXf5C7vsO1fw&oe=6ABA7247"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T57orMAXhAYQ7kNvwHtDxVH&_nc_oc=Adr7KhmsepHKDSnN-80FwSHLzVkDl66kwIYnu8Zhcqmtf8JDxu5VTovs_SFz0UbxzUQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpW6aq9Sov7ehqfOZ6yGATxm7zk2cjpF48StQ7I7YIJg&oe=6ABA7538"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-qmexUAg90Q7kNvwHMaW0r&_nc_oc=Adr0w9pF_oPx7LHdikrdT1tOBgrza-e1yRRUDZNBXc35oWkXS2LC8v6Y6mz87vmXhPM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN_cyRw9SFonX2j91lFwbqHBfw-lF1dJoiix9I1No1Yg&oe=6ABA7786"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
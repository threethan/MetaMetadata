2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESC5eeugz-AQ7kNvwGselNk&_nc_oc=Adqcr41SzZ9imKq2x9lIbW_C71U77G0gssvXW93MalpeC8YtwOjc-XCkEn2PDxIQmI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAbMhr4Syy7jLhz9nAjCVwU9EH_TDcYrMoXvdBErQXPQ&oe=6ABD359E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZpc4RHeNcUQ7kNvwGwvXXu&_nc_oc=Adqf4nsUU4VNoOyTDJcKAp9w7poo8Ebs2M0YYAv2m3aICkE1KXHcFAYEx0lU-PLh0P8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1vsmD68qFDN-abAB1l7JWvqLiPjgrqtuICJINRqpyWA&oe=6ABD0FA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XWE4JjI2FMQ7kNvwECMS7J&_nc_oc=AdraCoHN6YcK2Uo8sNYwnfjHqpxky_0bAgtCIxHoE-j0mW7b_e5YKjPhXgm6iRl0-Hk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7xiGRprVbHNgi12PMF0StA0bzhADJNvP479jHH7MUSg&oe=6ABD1547"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T57orMAXhAYQ7kNvwFUSzi-&_nc_oc=Ado8T1ib8a_ET4zcE50lZsrboMTcvLRpWCl6nJqzSOGgw-XRgPh5z2KTJhTryh_b1AY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-Jt5P3xRAGexNsXluw8w1XEt5VCxjcAY7Q_wCoxCi7A&oe=6ABD1838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFAloOPUqS8Q7kNvwEhG1Ns&_nc_oc=AdolTe_-DZScLcOrjdNaoBEmVDJKrz45jvj7mAd3H_2jizM_2-rqPOmMlSh1SNh5G8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiFUHyKLLsBfQ9sDi7wuYPVYOfLaHlg3OBEHDCp5DgVQ&oe=6ABD1A86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
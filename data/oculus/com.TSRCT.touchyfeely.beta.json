2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bU-D4uZE7y0Q7kNvwHz5XxF&_nc_oc=AdpoPle8n1Gp_dRjfpTq13FHQzkCWdQ-UYdrMbiTpChb2zZKI4iAbazt8uJvcfrZ69g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Wh5TdSvJ7NByelg27gTyUmKKy_LcDbPOi4A7lc_NMvA&oe=69EA0D5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oCnzj1jGUkQ7kNvwEwDcDM&_nc_oc=AdqGyWlVTfcABRWYeXDNNyIFjQKDWanGBfSUuD9gifVGS4Ct9TU-y2GN0A1FprD0Q_Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33jS7OFyzsPhonuSPZUNk2WkbJafDydhGMbGN96wh5Bg&oe=69EA1FA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDBIh8fEXTEQ7kNvwEyg2c3&_nc_oc=Adq_Ec0IjNT3sOFRS1CyEuAkEzyWnM89obyNvMbbc55lUfAH-qcuTcqB_zEnYQNktio&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fF_TgdRobUYBWmGpH6pCFZMba2e3MXyXRfrFH81_qxQ&oe=69EA2547"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DamtMdCkMcUQ7kNvwF7kA7V&_nc_oc=AdozhvldCWRb9iLnH0YnKqdr7bojFa5Y6_nFrVWpTpYYpYnEtmxEDBn7dayio5lL54Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30YsEU2vXE8RbPV4uDOB0okPkE1K_pVNW8TY7qYfZHvA&oe=69EA2838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWMYSseTjXYQ7kNvwG9wBtE&_nc_oc=AdrDch2rKGhAran5J4LmzfNfI2UEquw-xrsX8s_9mgUocKmkz_1KlskZbpZlwHHA5iI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22SNjSnp8wz9FiRq2dhpJyFmJ75o1KfvsJhOSo3Cr-XQ&oe=69EA2A86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
5843_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhlx-BvN75sQ7kNvwERIbNb&_nc_oc=AdrLJNm7wpeizJygz6UtIUaKl-pR3gxTlRGr6RrHkF6CsBedOmDTIymitgXVsCzHxT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR8oUoUFVpr4UttmPSHjnZPrVe_gLefl88yl5-QNts7sA&oe=6B0C4F9E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAl1jTjPOT8Q7kNvwHu_445&_nc_oc=Adq5yQQpgC7TT6l7AbxWWp3wqbvM8kQrWsWmSeT7mlMfsMof9yOYr3b41x_C2VZpkV0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4-FI2lpKeU_hJ_gHxP8zf3hIWpmMlIBnZinNX2UTs4Q&oe=6B0C61E9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOqrAYrxPocQ7kNvwGZodBk&_nc_oc=AdoU1hMHBuh_kJ9v_t4gUJ9narujQ2n8qpXfZjaZNOPZz48P4xNNV5MadTG0ATTiBeM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjnQHKYUVuVek6bdyOMPy_SkCKx-b5o2EpHr-WV3mNGA&oe=6B0C6787"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BM2JWhS8KAAQ7kNvwGqwvqE&_nc_oc=AdqFZC1FWmb0-9b9Fgdo4lXc7F433Wx_qsNM8HQ51mYM7cZazQ2Eg2-caoy_NRSEbOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSYr3A98ibzhu5XmnvtFl5XMTsXNY9_iNFPwnrQfqTTLg&oe=6B0C6A78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhcC5EFc9M4Q7kNvwHrRXk3&_nc_oc=Adq02OwGoTQN6jBF4s1_j5noHEfT5o7XIMv-5poNLbOFDCtFMvf8eLL8lGH0b04dIX0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDme0mIOM_WMCVUxzu1NrklR6XHy2-XNsahZ1t5R_5aA&oe=6B0C6CC6"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommend
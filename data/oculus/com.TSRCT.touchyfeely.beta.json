2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jK2s7MVi_XgQ7kNvwExjm4w&_nc_oc=AdpCuGyl4oghZW6qST81tQxY4jwfG7QIlf2Oj7z-ivutc-HDgrE6AZYtM24vUMuMwXg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz824CI2HrTvIEKx7A78yJEDNdcDZDOZFbWNQwIoVls5Q&oe=69CE5DDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbuG2U6N2iIQ7kNvwHvV8_y&_nc_oc=Adqn4DPh89_a54K96qhCbJJF4oXQm7dWgwuxc-Meh6NzeefVJRuhi_0JoZeSRtjPRt0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYt8z6hHOjMdfFuQ6JKFXctyvDBRweR04y3qMKPvlqIQ&oe=69CE7029"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdWkwILljaoQ7kNvwHu_SBo&_nc_oc=Adrdoy_ll9sf0bk4tXCmpLAMlWTBs1ofbigFEn9njH8ETAVq5wDSr-KMHK2ezt5TzOY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzmzp759Dhkc1XoKlwaENf8MIan0le5TAyCHja27S9HHw&oe=69CE75C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnahBWLib7oQ7kNvwEe4Wmi&_nc_oc=AdphNLCKOPJmgBQw2SaENsS6VIWKDfLzV2MVle5Awx62bE8NzL_CKh7xWQXA4EsMcXE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyk_RBR6JIVkNxI5mxKT2Hl0IuZhwqG8JyRpN4hBtqnEA&oe=69CE78B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fC-bm-TgQOoQ7kNvwG8pSId&_nc_oc=AdpndZGEGrdPUlCTgybWxpIEJZ98OGr5hEWCFSGJXnlqS7brmzJde1MZF02F2JPyTns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-yOmaikWrGMOYl8AvORr9pQWc94qlOVJz0XqNw1-DLA&oe=69CE7B06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESC5eeugz-AQ7kNvwGszfH3&_nc_oc=Adrnc085gFXvn8K28Nr61odkq6Yl08MV0ExRvbGu39vKITjiyPKqwTAWgzJ8Ae0GqEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8MlXp6bzROmKgz0_Rjy59K0vs1-yA9-6KhQNsKZkMKw&oe=6ABBE41E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZpc4RHeNcUQ7kNvwHclsUa&_nc_oc=Ado7hxHIzyx9p8jFybWDR9C6Mglac7i7gnhFd_TI4nBfj3qI83A0dXt-Q8urfo_ZdvQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRPhe3SSm0nFEix_y6u3N7LkXbwIkxyhxU1GVMvTQQYw&oe=6ABBBE29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XWE4JjI2FMQ7kNvwE-rBzb&_nc_oc=AdqiNx3AGJ_aUFj09ihbnsguuEtoiVYnRsoXJLJ_eqYHKE7-POiF2xqxC-X2yHQKdW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_wxhPekKlxt0fi_TAjQ1in39iqnL1uwTHX1TUYLOeRg&oe=6ABBC3C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T57orMAXhAYQ7kNvwE9jc0_&_nc_oc=Adr3SmsGLJtUjkZ_SLBqHiVVaHkzfRV7ogeQyj_mF2K6PJveNhl_c1VFP--YWxtv0CE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLpTEJhZ-olnGWU7u3i72Vdcm3LigQFT6W8w2Ii5pTZg&oe=6ABBC6B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-qmexUAg90Q7kNvwEhZS3o&_nc_oc=AdrnRCWUBNlzRdDqkWoXNhEqNyIW_2sNypoH3OwswV6kMj8wV7xh6vgxE8eJB_e-pok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxcVJaI97wYxbBGu2EAp0di55DLRFrU93h8xkgntjAvA&oe=6ABBC906"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
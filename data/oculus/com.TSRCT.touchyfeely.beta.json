5843_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2N8YFYWEyHAQ7kNvwGbHcAp&_nc_oc=AdpUzI2nKwFaxf16uOidNw5lVb8-QljMFwD78Zs4wdASv22_agkH4gONp_xRMlxtq7Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSii69xzxRAhwXwYhsx5xYRkXteI1yU0yWDhWsblBrWzw&oe=6B085B1E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDaYH5vWOtkQ7kNvwGd6zKK&_nc_oc=AdocxleJ5_PR2hMErj_O_c_8tqdtFVl5N-OeAF9PJXp-rz6rFsDOgyn7xtDQk5yogy0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDIzqhvYB8kSU_JF6KY7_g9GmJ63Ge3M3bMvEtzI3tAA&oe=6B086D69"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8z6v74RLsggQ7kNvwFluAtA&_nc_oc=AdqrYLwHeJYzKVxud8P7StlIt8mTL4VSnyLXUIjnnshVhSpn6S4EkOnYpdoeQCVYfls&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmun75Td8wqd2EUqsbd89_0JMJcym47iGAfHztwqKdSQ&oe=6B087307"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJbmvU5QjO0Q7kNvwHHWqJo&_nc_oc=Adr0nRNEFpdiPFnerwXoBIchMLG3yRDw9Xdgah1aLzXmQmpO7zdhgn51hAtUI3i6IMo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTlRgWVLEPxkprzAeZAmH4hFMCaMBG0oNWP-gD3cKBbQ&oe=6B083DB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=he3GHVgyPV4Q7kNvwG-A3ky&_nc_oc=Adq7wZNSEpydEhoP70Poohvpdb6IVbRRa2vSKELejP3OkFk1WsuGokAsA0y_KyvMrp8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUourzYMNiQe6C6OORgldadN_JduPF8ByWOnObHU-ykQ&oe=6B084006"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommend
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0CENxBlQW0Q7kNvwGoqYG0&_nc_oc=AdrQRz8N2JEvezprvr_g6KNMWXlpm-FDCWRf-tu_p-0c-0HzY0-9fQXnkGY3OTnGBlk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QpUXT2aZoJl21dREiXLS8djVD0-I8rxZ--kLm34TZhg&oe=6A186A1E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leVmfu7Fox8Q7kNvwGVQgLR&_nc_oc=AdoMUeMoGHv_IU8f0dMGN7Rrb-fjVCCCH5-Gyap5u_0NQnLTlA8BQY7wuTjZJ60SCtk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P3_ikaJozliIgLTLuid5kWU2vcqmCOeCJfzAen6GtSA&oe=6A184429"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnH_ZJgHSQ4Q7kNvwGkLYpi&_nc_oc=AdoRkUZcRBj-l8M21kZxoszcq9DPuxXzJgflcfl_a4JqvrEOldpp53M-BEFsmq6OzXU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68pnR53-VewGroSZdT3yVwwFQO5HsH1iu9aDWE2TOysg&oe=6A1849C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCaU4eckSf8Q7kNvwE_tEOh&_nc_oc=Adr-yJbjYfdQ1yCD6hVC6SAW6Yyd0CtcT1ZPG6U0F0e3uHTu0Mp8bG-kJJ84_siCMf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o2A5e5s0880t5-L3rWXPI4ukUS41OR7kG5Iy_r3XHvw&oe=6A184CB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AF9bJtsbVHQQ7kNvwE0ve0z&_nc_oc=AdoBIhKAk38Vr7Jx2YrOEgcY37_KsskbKjYrcvHAFfbxgl8DrzWCHMpaV3PT92Mbjs4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zdue1Vg0cgGsql3ZkVE-fwq5G-K4gpttwcBVair_JzA&oe=6A184F06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uG641hcVM4Q7kNvwHmvRwB&_nc_oc=AdodRjKfof2kx2OaE2Iy91It-HR_3rLh_z5rPjKCdeXen-YJGxWIJ1g18naWXkEE-Dg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuy7H-K172dY5aokfTdWSHPBqDs7MMWnofzemzTxirTA&oe=6A75CC5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kI21QqBEjakQ7kNvwEM9el6&_nc_oc=AdqgT7nSri8nIEj1AuwC5pdI3oNzyPaxOtmKGtjlT99BSo5yEV8lEKJ4JyXLIyrBQZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWQSG2Ydq00ST0cXIqFU4z4joixN7CQEd90valg_bKAA&oe=6A75DEA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpFJ-CH2ytIQ7kNvwExfs2N&_nc_oc=Adp36Iqcvze_Tkf8RJbfTJOpa6NBhnfplG4GoePtV8JdTGIzTWqp3Sm8-bL6gJ9htd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwEjnsPCE2zShw0IXYqAvdA_oPhm9Yxp8XygYsdkDbDw&oe=6A75E447"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=as4pRnJqBVkQ7kNvwFwl9fa&_nc_oc=Adqoi_aXIP9C8IKjDfBliEw_2lkIT20ZS42-uZxZO3JDJg9YltmJLflgoCyGmJTnDdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIBUb28fMEak_Oh3MJ-qBKpXBPVdfUvUK1IpFJsuW9yQ&oe=6A75E738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9tvjSeEj8kQ7kNvwEghGR1&_nc_oc=AdqFpFA5JkpSg45E_hV5F3dTNGaquBP73lKcFqTlaIutWXGkxfUn3JqIEbwR3BZmhcI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGWWi8ihO1b-fb0421PhoMrNPoQFLaXIePYNurJrId4Q&oe=6A75E986"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFmNcwdaEpoQ7kNvwFN9EGx&_nc_oc=AdpZKEhqTcr6Aqd9f-0qaEgRITMouT8CUHTlpTJGZxlXpCWSDwSaz9R7YM6k69NgHPQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmL9Oi4hmwsudPdnl2ZD0hF_YcGSmGz3aBGKSYQjiltg&oe=6A88415E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95QwobaBrvQQ7kNvwHGfIsu&_nc_oc=Adrz_nfPRV7KmfzsJxRuQM9taCqbXIgdSOpntDcdZdXQBcsjV_L5i7E7F6cpZHhlWwU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvxWIKGQnH2CBUHb8if6niFlC6Jn__BFl5pi0TMvz7CA&oe=6A8853A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm_B2zPTZU4Q7kNvwEyaRcN&_nc_oc=AdrLqQWsbIFjHuG1k6f_DYkKlJVBIOJyiKDBlIhPkc7KCtlXnt--eljhmDoFeZ3HeRA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE0FFf2qq91NZ7kqVpGqR5EFK73exuhdfq1X11gEULaA&oe=6A882107"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_czKQHLGbQQ7kNvwEOPJmp&_nc_oc=AdqrU1YwQ45pwTdLVxUv2CJ_5y3WvSboBjH2ELxAiyPSa4xLEhkyLDpEJChzOjEi2oA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER0H5rKMM4ZoSj46r5ymiCefeYc_8MztKfhyWqSKDKMg&oe=6A8823F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1t93BQtLTpQQ7kNvwGSJtFV&_nc_oc=Adqatweq2koqsRY7GKVqjpl87pvd_Fi1fqaKpPXPWb5zXJv_T2x4pV2S92N621EGo2c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsR2QBNIdyT_DvZFwFUBTaxg2cAlqTDI3HnoYsNqiy1A&oe=6A882646"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
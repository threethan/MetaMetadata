2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQMQL3Q7r58Q7kNvwEVZXlb&_nc_oc=AdocQdRYDgJ-5DtjmSRTPZAj8G33Mfisd61BA9-zwJ5wjeh_PnHGe4bArakmDxsikfM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIREoSTiKKmLTTVOYBiti4d0bi72kwQ4WIEb6WtB2aEYQ&oe=6A9C401E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zRJhUNeh18Q7kNvwEI2ORl&_nc_oc=AdpbJnk8sEmfCd53RGPdTBcbl24T_kcHV8xvvMlZ1qqrjHKs56jxXE3ZoNWwMQsvEOQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbIRygVEc3WIrRZszqMP1ioPUcguSWTgE1LnrS2wCvfg&oe=6A9C1A29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qtrgn9e_Xo8Q7kNvwEFltua&_nc_oc=Adqe9T-OsqsPLZd6_SOqTxYXWU3iGdwgMuJhzvgxPhejXSJjdQ5dC_O6CjOYE1G6BCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT4j5tXYHWEGzQimcD9nnFESV95nWABtDLrhVC-yJq-g&oe=6A9C1FC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyVpE85Kx4QQ7kNvwGxakp3&_nc_oc=AdrmkxsdM-_X_UJ325XI3u65akH8xtcXJRLn3Fqu83XB9sMD-suwZDSQwks7JNwJqco&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqfh2fJLaWbtuLcJwPiIhDBAj4PtdiXHwpf0UsVcjhwg&oe=6A9C22B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8B0iHe5vDDgQ7kNvwFCov2i&_nc_oc=AdpL4rOqr9zaybI_0EVwPWuZFZFhSu6i_c2RSryZXYgaEoaTzHwxDsJie_AS1QP9Xrk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGAHKx3YPmmcoBlGBWRS8d9ba-3N9WbYjF8U71c5MhWQ&oe=6A9C2506"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
5843_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVxEtB7R1voQ7kNvwGG3YUh&_nc_oc=AdqYPVaDbuQeIRze1lSF9VqtSnjSne3CDmyRGUJwrMN-Df6MoGLquEfnjdBBr6pnxGE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK5DHg3BxmdbvboecS0JIvCWKhx-isnyAXrSK6mGe0DA&oe=6AFC7D9E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o09GIvolYn0Q7kNvwHZCN70&_nc_oc=AdqISvKGjKI6p5BYJnBXxeCSFPRWlMhDY9eh-g1NdBuuwc2mX7w5lHENQW_UZ5VSLnE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYr2xy3ykQ5cg_tJufO94DuK6EAlphcBivGYSPZW754A&oe=6AFC8FE9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lY9mSttUM8gQ7kNvwHBRVrN&_nc_oc=AdoTbo9LJrdDCjnu0YivaYNgO2LWadGiFApK7fzCWzJBO3WV8riKt3nN1hs4-uaX3Z0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOLiKBxK68MjlY09Xekbx--MZvQogpMi7l4SElO2uErQ&oe=6AFC9587"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14m4xrM7hA8Q7kNvwGo1osI&_nc_oc=Adr06xiKDM8hok0S_QNjm-yqf0iEAfJfLUX94Uty9xWTRf4-SNic9w8386cpQkBnZi4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9WwZHwATfneat3s4EpWqWycCbMLm1-GnaajbiY8IP6Q&oe=6AFC6038"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4EMwp_XQToQ7kNvwGDBeC4&_nc_oc=AdoYMDH8hAHH-N57lXyO7pQLVl1w9fJOvHQs3mAAMuVnAHvGPrdTdMhEAtZEuK0Hcao&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6b6cLBsLtbMKCE742rCoE2-x4UTW6XnNazj7dFn7UEg&oe=6AFC6286"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommend
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=973VjcjjuZYQ7kNvwF09r7L&_nc_oc=AdpwX8UQfo0ZNRSwDzPJFoQlDeEkDpWA3GH1kFbekmhyTxR3svuYnMplDdotdxFKkyw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_v9qOyFmDXH1ALL6PkMhJsZQirpH_wNWcH1zIX8eUfA&oe=6A86EFDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95QwobaBrvQQ7kNvwHhuaS0&_nc_oc=AdqAZoo64NLCvZQFql1hpxRxUE1if5uTN-Qa9EC6-e6daEKokqZpvhazxK3RB8s5B4U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgCvVzTpar5fRK29JlGntWDVVM3VLX_6mrOt9Zlltjkg&oe=6A870229"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm_B2zPTZU4Q7kNvwHA6zKg&_nc_oc=AdppwDgVJ5jsNGpN3DqaWfi8QwweRoav6tX49gYzTUUax-QO2VggKnlnPyWbfa-cdwM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYGM75rwMNW58QbQsfVvVLl03FZRLM_NIWoZu_kZ_69w&oe=6A86CF87"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_czKQHLGbQQ7kNvwFwXi7S&_nc_oc=Adr2QSqiuGoRhl1GsClJrLGcim5aO3sFrZ-JpjaNx2iVR9pIROIqs6cvAsXtSSXZCgg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERPgxBFa5ZylXh6WHoX-WCAYg7oNQ4eGYtQnmGQmcnPA&oe=6A86D278"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1t93BQtLTpQQ7kNvwGo59MJ&_nc_oc=AdoFqak5JxTWxOdkleoxBtIIuI0JZ_GWiaEPEm8gByMrPANRqR65fOetX7StJIf6qck&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlYnlybKmWZZMC26jmAULHriAxZew5y7LbNGJQQ-rjkw&oe=6A86D4C6"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30C_iyACOrMQ7kNvwEx28e5&_nc_oc=Adl7WPXfKlPgpCMvDw6y6pXmWHL7DBwUQEq2hmorEnrEUy-XdC3H1C4lxqJxXih1Jek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsk2G3VsRIOlxrogKJn0ldOWnvA3EtgqRImohjDSFaxEQ&oe=69A8225E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9H1qvDBDdEQ7kNvwGP40XA&_nc_oc=AdkiArpl4Xl86nBdweBCWLbIXE3ytGr8mbcfuon7GX8w9s2e01CoDXiCfu0WS1-9xrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuF6X9BtamGVIBu3ycsHXsQmnFYKWI8b-J-svEht-4KDQ&oe=69A834A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaPEZKUiKFMQ7kNvwEK_DR7&_nc_oc=Adm6xGcb5MK6phdDlmDRrmmOodShKAR8jjE9TXPpO78WO1RL4fhmJsiGBcjVtNOAd7k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfunfI8S0JNnSAH0yXEN0aGRlHpQAPKcpGoxFG4lUNAkPA&oe=69A83A47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQg0d7_vTPsQ7kNvwFsd5W6&_nc_oc=AdnJU6uMonJCcLUMGv9uwMydVmApSRuWO-iMz8zZPWzqfqfDvNIkfbzOIgRHmLJVewc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvmhVAvCMg9TMqby-nCXa2yKuJLh0C3T9EVPBEFbtcbFw&oe=69A83D38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlGwp_sMvxIQ7kNvwHFvk76&_nc_oc=Adk13cEmGo3ZM0aH896jmQo8nwSfLEm9ez1n8-Lrkktfdw86bqDB0Mvy3L3zi0hDvuI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afux2V8g_wHOQEfOL7YyHGPhx5nwmV5mgqaBPjr7sY-YDQ&oe=69A83F86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH
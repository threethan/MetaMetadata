2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KU35TkLJFDIQ7kNvwE-aEwF&_nc_oc=AdqqZpjwXD8RA80-7K1JZBZrYGfP_NcnLp-dcLHu_7AaYyiUzG2o9bQENj7S0j5TbEw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-L6P8EksgDyPhKAka69d6nt_p49PxTiWmHVR0xeFeP3g&oe=6A30251E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVj_DhqqItcQ7kNvwE-SPe9&_nc_oc=AdqMyA9J5XBoHr81-MWeSUOhz5imxF9JaZxrEq6OT7wEL4QBBPeuGlW6r6u5Z4iwLmc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x0lH_als8RnSkN6lvWa_DcHl1nf3l5q2uVuKXwrPIdw&oe=6A2FFF29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrESzntKg_8Q7kNvwF4P6Ri&_nc_oc=AdrnhBMLWx6URNJJ8IRxZRtB26ZvsQDhZTjCbPgjeXGi9YnJ5Ox_LQyLmyRcfhaTAI8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ngyPsIR4UCw7gcIAANLRc-8d6ZxRegFPti7XsTUEKGg&oe=6A3004C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9ztB8UudqUQ7kNvwE0ticZ&_nc_oc=AdqSA10Zxs4q_WAjniwFfIM5b23NgVYCa42CNSJ72WF0LMdtDabAJZJ6tks54VV5RG0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lXM0iuMUpQweH7cwCfBnN_X3_Zixc031-PBFpM3XcJQ&oe=6A3007B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb3AXBix3kMQ7kNvwEJhPH0&_nc_oc=AdqT39etN0ZrXti0jxnrFwBcbD96utHHKhi-hZ6l-FMlO9CGRzJ_1IVmrEkIC1mP-xQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iVK5-qlG_YJxwzwEZnKEbh0tMlTiCVkTpjadhNzHKzw&oe=6A300A06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
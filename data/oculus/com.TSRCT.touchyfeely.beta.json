2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5AMUM9x_gkQ7kNvwGUJzoj&_nc_oc=AdoeupUrFMHhF3Q3Fg7GZg4VfQduugGAcCu4ISNyQtaMpSekpLAQodz8G6t4ix9I5wY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F9p8NEAnZHghoXnugl0SbNhZw5npzbs5ohxguksdaOQ&oe=69FC825E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VTJcHkYZ8MQ7kNvwEHKBKl&_nc_oc=Adr_wO1z397wy5lFxKX55i4YrE5q2Aee-N8NdkIAY8yZTKkOOHxcJ2Lksd1nwxZi7A4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JFQi3vA2btmQdrW7Mc0MXT__vYAGjiRsUDv5ofFj5KQ&oe=69FC94A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqKGrA1jyYwQ7kNvwGkbOcI&_nc_oc=Adq1q31EqN98m4PAh09vhEfCE__7b-USrUHR9rECOGGHPD2gYQBmkyuS_aGihxJXUak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49t-Fo8LcxtwpHXrCIf9ZcB3O4WEBGWkjCV3MHdvjfxg&oe=69FC9A47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iePWuR_AwncQ7kNvwFp6hSa&_nc_oc=AdpBVQARX2j2uUoC-5eA0704NWAXPIr22efh5l7V5W6QtHLiFF_Ag-JqAB1b52chYZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73GY2zW-xK7C1kDDr5iBcMKvcMYTWj2jmiOx4yO-NT8w&oe=69FC9D38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OWwBsmJFcwQ7kNvwGsOp5O&_nc_oc=AdoBIHXEMa6bTtkmEwRw6D27IzwfF8OELwAV4BLU4mt_y6jC-OWCL2Z5p33vhxbeLLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iiKcJLCjiVvvGEbvyh55le0fwstB4u_yh7fdDQmLLdA&oe=69FC9F86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
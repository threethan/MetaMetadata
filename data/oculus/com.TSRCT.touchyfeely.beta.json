2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDuWYRTUEDkQ7kNvwFaFewr&_nc_oc=Adr2ie9xT7h1QRbc4wgfvSEuP4ahiPhMNMV6l41JyzC6ny0fFed7Enw3bx36gel_Eb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGkjEPk_jOYcyN38_EP-H5-iiDyJmLETIU96WEQJRX8g&oe=69CD0C5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbuG2U6N2iIQ7kNvwHY4dO8&_nc_oc=AdoVKXJZl-Xgzn5kLROrpZ6qEY_-q8jwks1caCiifqjB4zvoZM032K-z_va5iYJow_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyS_c0lS409b-eHuZYTHsutB4G6mLIQFSzFD8bodCitQ&oe=69CD1EA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdWkwILljaoQ7kNvwHAF2zV&_nc_oc=AdrefPCV4eWvXGW2t2KR-EFQtF7HpzgyxDHe__8NOidXnU4DKhGlgcw5fuTgRwBmA1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMCDjf3Svff6Wofl0Cn8EHF66xArDcBwVPY5LnirqvmA&oe=69CD2447"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnahBWLib7oQ7kNvwFSfLh7&_nc_oc=Adr9LsLdnMv7FyPtDl7mSATdz1VpiaPuiffa2lNHHCQuEwdeVd_Ud_89Kom2wQmhM3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afws-UiW7dB_VtryN139ddi_VeZxR3sKbWQUpwV3uD3caw&oe=69CD2738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fC-bm-TgQOoQ7kNvwGAv9XK&_nc_oc=AdpK8FCyfd4CN6ubNEKVtTOkuAS6aJud8mis082UwJyH4UoVEbPox2HRn8AGZQ22BW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIXBpv3OUOBx68GU-uUrmCfehT3ab5dwvHHrMGGFOOaw&oe=69CD2986"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
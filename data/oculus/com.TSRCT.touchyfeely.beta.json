2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pinje_Bn15kQ7kNvwHtruAY&_nc_oc=Ado-nDWjqiBQDPIRc5f3Rt6HueuNlJAXoo4cNcRY2C1_aNqO0fAzfSmclozIRUaFFKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Gy03brtZIEFoEeNufAheEOdmCwVGGXFL41peG2s9cUA&oe=6A3FBEDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKO8FKUrOycQ7kNvwE4TZ1n&_nc_oc=AdqoqY99SA9fbdZp1roTx1LHnsg0hRYdDWM2hNwsmjs6piF-VfVBfFMcztDLUDMRWdQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ujfe9MRmZuozFBNrziZs_tpvRReGjTIm0fq-9rL_SDg&oe=6A3FD129"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waiwKBpWbR4Q7kNvwE1S60B&_nc_oc=Adq2ici9ByW30zWVmfY8k2mYHl8_Wm-knfiA6Rn-r3tr3yj-Ew33coCBWufhrg3ED40&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mfzVbsFBG6oqaMK4k_BpWpTv6DQ1wijniP-IqcqjAwg&oe=6A3FD6C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAm3dkAP5P4Q7kNvwFXM62k&_nc_oc=AdomvYTUby56Pcd2yarYC4exTzpowvFNqR3xr31rylhB5HAx8Mrby9G44HSMwHxv4x4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f5vIAQoBa_PXBj1B3H2G5q1fgxH9D9OMgNGKJL-r9sQ&oe=6A3FD9B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHwsL69lzKYQ7kNvwHyOn0r&_nc_oc=AdpHuTA4yNp3ZuDVGr2FiuUtU2FF0QvgxHUI85a1L5_qChdkjLtmr8Bl97JgRDnA5uo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l4orlN7C10WxMGu4mlNKAXZenzLX7tEkodi9W1V6Atg&oe=6A3FDC06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
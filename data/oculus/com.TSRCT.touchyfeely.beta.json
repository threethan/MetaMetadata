825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiIb_PeifhIQ7kNvwHCR3da&_nc_oc=Adr7u76Xj0W8nKolm5wfjvQ9-LzoajGA8enR3is4wWa23fisiEooYds9X-8G3mrPwEk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9t3_9vZ_8JQYCkhIAoEO9ZaoNpXw8VOdgKh02_G1dXw&oe=69C12EDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbXJW4Sb4gUQ7kNvwF4I8Hf&_nc_oc=AdokGZ6TLHnIXjM9iFecCy0rfOt82ef-cA8qd8yJPfcoXBdYYf2SuxntTh-ecRwmXjA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAbyQHDaMm0ICIPGUD-av8DmKkPnzeeahdrL6E-WyaaA&oe=69C14129"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOTnKjFOlrkQ7kNvwFMfXi1&_nc_oc=AdpFQ7_0jMUUYCrmsrdppf8EEtcQqMiHQ8GhTzKQaMtyEEi2PCsKagSUGtiHGBO3o3c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYubgxR4Wlk45f1NX6DNxHAw5Y6_kAh_y9-vFRqyR27g&oe=69C146C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etNpfie5uJQQ7kNvwF6AR9B&_nc_oc=AdrEgtQlm4Er0OFaXmzPsSLYRu26i0tYFau3b-Q5rv2l9CZBSTqLOOHTNWevMezLgdY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz1XbY5VKNf3uRBiBFTCTbyeMo4QoeQ6lz_sR4VEhos6A&oe=69C149B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aH3Hc1djwsQ7kNvwGUptYo&_nc_oc=AdqiqhsR9wQ3jl77gyKq6Z3Rfd2ajpZftOlRQfMIF8EPmA3WxST-XPPMqXjAg61dg-I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzhyv1pbIQ2pZegaWAshd8gKQw5qWc32n-baQk4s4V9hw&oe=69C14C06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH
825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZH32x7DFntAQ7kNvwEJACrz&_nc_oc=AdkhAv5Tdq8ftGigMJtNVPeiRsAkXQGly1mWwLMeGcJkbpuUkUsdEp0RXCXH6xKiUak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz4tQGgS9cAVVjP6uIrQZfO__wz-qADgiDK0ESjWMYrEg&oe=69B2AE5E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MrMiPQ1O58Q7kNvwHqvHFP&_nc_oc=Adn-54gMLgUeYg7U2u3BuZVtL0ERQSj9vpFatprNNYs64dxOzvKROm4ILf-q2MBi2c8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_95eHHNa8dQ1QFssNQruHbTbZKPWHDh1zzJ50rlnw-A&oe=69B2C0A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsvukDr3vXAQ7kNvwEqFmy2&_nc_oc=AdmZXfxHMy6PZbZ2G27X7-moXgiffAPmiFLn_KewTFil39TfwPJyylkexJXCqC6pyUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz36e9gZI_f-OoixKd0wIBoDhjPbKL1nQujKygWVuNMUg&oe=69B2C647"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCuFSxUeWIgQ7kNvwEzI_0k&_nc_oc=Adnlj1ptAMyuQnufin6XiKHPhkDJHZS8_qCrhyl7bBFULPlrgZUm2yjskozX8-slZsY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfywlpSbI_4qdRAyPbLBD70TLxPX2odxaNQ7gubbO1ilew&oe=69B2C938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHKGPu13k6UQ7kNvwGVM-Br&_nc_oc=AdktoiE1usTrkWxccIGTgeoz3cQsYg4SeeQTb1XTYD4JX-ddsdw05lzpxMOstv4k4mw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afws4ImIrRaMP68PDp3gA5_5pLCPmaMrs8PYYi1ICAMYVg&oe=69B2CB86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH
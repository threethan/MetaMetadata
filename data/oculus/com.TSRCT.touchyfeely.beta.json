2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diHRsTPnT9wQ7kNvwE1OkW5&_nc_oc=Adpms12MnEkPiZsFURNCXfz199F0F4Vpol757osW6NSqN9K0MwGZVZ1sPuq066IJNTA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlXAWgEa7DKZ5Ue17CAg7IP2kztKW8xpS_QeQTGg4P0Q&oe=6AA14DDE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNrH0TVvGG0Q7kNvwF079mf&_nc_oc=AdoFFPS7MQ-NFdo8fWsFPzneGBkDTWyA1YVNfTK-OusxyyQla4LLPFaN5bWGzrrOpO4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjboVZSg602y6YqXJw34CEQzLE-0AOnWbtOZCGS1sLWg&oe=6AA16029"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZLcxY-tg4IQ7kNvwE56mWH&_nc_oc=Adq8YjDwk0q44aTrD7zMwEpTdutFuPaeo2QZ9wdB56lPCwIMk1u1kms4VQPoCMAu8IM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ53YOT4DViXbdkqLGZFr1e0pasnRXFXC8O1pNEZc9KeA&oe=6AA165C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfQns6MbolEQ7kNvwFmwSll&_nc_oc=Adomd6ZlEDWgteigAx0N2ViealLnbvCFO60yv3dSctL9dAxkaguhNCvI8Tu5lDzYjqE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtrgS2nIT26xP__Q1PKawydFaBXfmr3ifrbmNTlXxAyw&oe=6AA168B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFAuHLGwvVAQ7kNvwFgEJ2E&_nc_oc=AdqiXMaH5ZdCLNGtDdrE6ByURs76geep2H2lf6rScte-FxEKsvp3QXQ5SVRd0VUMsz4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwOq6W-tOZAI4w3wgNl9CJw5ZK7y5h7cTAggxjvcxcjg&oe=6AA16B06"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
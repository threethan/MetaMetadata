wFEwbTQ&_nc_oc=AdotbYV96gOepPOFCpK8vcHz2pejd6Zjgie40r6qmTjj_Tl2vupTYriJBmM5Gj1P3Cg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2xTxomdACJpPBMLrRiEQvYRPkpn3P_oiClecGAKBG30A&oe=69F0A4DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tQZ3-VSnv8Q7kNvwHZUaQd&_nc_oc=AdpLDrBjcXqTXP57PvKwno7dnaEWKmyyN4YLFWXahJPPbBcBPCd7lEsHOSIgwDxQ99g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1qZBFNa1-TAdJZVn_w8t27z1kImZoJX_pxiygzrjHQ9w&oe=69F0B729"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVQEeOJoZfMQ7kNvwG3gfSp&_nc_oc=AdrxkbUAOMYlhfH0wPCvRrEx8bHHw6nanO7kgytmVsTzF54qYFims1b2PMJogRMs8C4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0OsriVM38-BwOetQ2kqtJja-VGKK19hqyk0CeqME6qzw&oe=69F0BCC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iALojxUpnOMQ7kNvwEM2X1N&_nc_oc=Adr8It666H5Un9rFE2k6Q7fx9dyZ-7sqn3LE3q1Xh9BrWFQmUpooVpQr3Xik2X3JvwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0btrB18RApeTw6M1tuqkhmvzlCNwN8S5NOZ3-Pg5rZGA&oe=69F0BFB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXWNvGHasnYQ7kNvwFO7V69&_nc_oc=AdrhXM6phon2waT70b9oyNFRa47RUooRijNavCivdlBwCXujsnC7HaQMNM1d1SVwDBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2srvpeFgRcBwAvBfbQODebqpkK2OgOkGKVUNfnvKKc3Q&oe=69F0C206"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"]
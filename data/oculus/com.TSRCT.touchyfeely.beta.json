2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4BThQaY3OQQ7kNvwEH3aDc&_nc_oc=AdpaFtDc57SEgm7_-aNNrJDLoCftbCW0CvQn_aroLR3T1mNVf3SojZGBIyZ5lgTvwNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8uhl7QB0Y0XqAzoJ-BEWt8hUhUbu3kYzGa0m8iC3KPA&oe=6A70865E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_jBAVjPG-IQ7kNvwHttDsl&_nc_oc=AdplnPwesWvVKxP-2qwndkNKH4Jwk_dvRZ8XjaMx5EBr8EvbNWb6-8ZUxKByylurmWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpROwMJDKd0PF49r2fca-bbhiDqYxeJfXDvs5HKZfevg&oe=6A7098A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4h-G52B5qmcQ7kNvwHTrW61&_nc_oc=AdrYQk52C2gHvRc9Vs23I_iWRUyQEL4-K9SIHpXqJMAO_EmtbN2yRLOBgyZxguklm9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1PCtQ9GUDAOFa87ctut8K_Dt2upZNNITG084zNkcjmw&oe=6A709E47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmmwxL8aZBUQ7kNvwE7fDX4&_nc_oc=AdrjmS4PPp5blhZkL9GU2N3IBjxqo1VxSz04-2EcgpK3h3TOzk-ErCAamVnha88zm_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTzlgPzqsSGm3imUHLuzjjMdU6lxZPML3SuSuUAIfAmA&oe=6A70A138"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jExRW3HFXEQ7kNvwHxtNjw&_nc_oc=AdqgR7z67mSWzg4zr7Nr2GVU0uv-Bz2eh-gqpc6vT9_okUyNSfxfY2LKeOjIZmgV_FM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuaklrhVhaKofyUzHtKwKrB0cqgC0AmtQfA7M5cRlbPA&oe=6A70A386"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
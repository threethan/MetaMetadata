2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dijO43abvLUQ7kNvwGbA3z4&_nc_oc=AdpSe2TqsIa42_omiMzvgPZHX7wMn95yRjCvMElbset_ZjmNc7cWkoVR9vqXzJ0UuDI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wVTShGFPk3QqG9QyjY96ZsYhy_zpgcqf4Vym6Xqos9w&oe=6A2C309E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLCm2v6wlV8Q7kNvwHEtPdq&_nc_oc=AdrvX6KJBkKF_8BADq2PNt7cfD7uf3ZDtbw2e3p8T-r0ZzGRe1JH7hbBfnR0knDP5zA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Zvd9bkpM5mL83SpDOHGe4Zk3VlNqTun6l3NvKFNp48w&oe=6A2C0AA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyCELuo7Ju8Q7kNvwG3rGlY&_nc_oc=AdpPbWOm8snp-mkXJv8c_lbSNVbh1NX0W6OQYrX0PgQ0-h73IjR3TcVYCU2i7r-FFWI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S8_ltMVaoMR-O48wkNyw00zNxJyQ672ydxrGMo7406A&oe=6A2C1047"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqhXT4wF5ssQ7kNvwGY4XKq&_nc_oc=AdqCos0hiS6VfL0VTAZe2pCqbJ1xPxCK9l1HSEB4zsBoBSagHgUj6fOWcB0ldQd-jKM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yDf5tzQrxSXOkgk5N4esFTiAoHxwdLAhH9EAR3lh6fA&oe=6A2C1338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNbrpmWBDl4Q7kNvwEdbz27&_nc_oc=Adr2sMn77NAlqFhL9TBLaaQPKUTdtjpSv_SfbLsiauV9Lk733ASJVqKdgzgjXmCFGcI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tL4RdNT_heI6qxMqVNwnSBLM0fDs-2u-8-A5pR0Tt6A&oe=6A2C1586"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
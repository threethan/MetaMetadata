2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SfWP_ftuU4Q7kNvwH2NwYA&_nc_oc=AdqIaHRKLpZfFeipyPnWiTPGcwDIUt6BmZ_JBLQjJE_yjYlhRBRaZK-XPslhNCb2ecM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY5X2vdV7ykmnH22w_KVZNer7hezNDyTnpb19d05-xCQ&oe=6AE095DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPKvlylfx7UQ7kNvwEtL3mW&_nc_oc=AdqoSrncGXSK3kMHKtrbXwNC56s8p8OnO2LcTeieUyMwSRV8G7GhnNpGIJJ50IWTbTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-FZVtmzXP3v_8E277JD8okmdlQPWXiaP4zzcr8gMjdA&oe=6AE0A829"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hV5TQfp7_R8Q7kNvwEvLfap&_nc_oc=AdpRVKhPzqNOWK1hZMhlaLgvVd8SU-OHA5MkPYApFeS18H91IQ6aq5oA9o-g6hd06xo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT92LsuMuh30pSHOuPl8qEe_pr7_4r8VJCmL1eL5IhkA&oe=6AE0ADC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5JSVQRCs90Q7kNvwFwDsP5&_nc_oc=AdoRSnK1BNF5SmspohD8_B6b0pIMRsVEgF2Gdx7QiA1itqm1DVs6LGmIiH1VWcuPhtQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuEr2tl8vogz7G8PSnswjODnTnMR6L1nsNcFapHP2xYA&oe=6AE0B0B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlISgyvwn3MQ7kNvwHo820N&_nc_oc=AdoQm75eI6KB0L-4cjI6yto2m4xHIozEBCxzhr_ne5VLOrtots0t_g_sSAawqQdqSQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHUvknJ1wEVtyGks1m4TKU5zc5ZZTafaEGewlKe4C5PQ&oe=6AE0B306"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
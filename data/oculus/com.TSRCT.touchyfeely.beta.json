2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtOIpKFVHdoQ7kNvwE6KA2d&_nc_oc=Adq-L9hW_TwLzmcUw-obXg57IW-_rccuxVkYCv2YRElJnoqJh7ztjeZRaUJwOgIyIOM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKslVroL8n7f5r9jhQYDiey6k2-qHFSgTsoCqW3WcLzqQ&oe=6A9AEE9E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zRJhUNeh18Q7kNvwFSzx4v&_nc_oc=AdpTkuBlnaMGKFVCR6ADhgkjE_cuDg_BwqO0aJJW7XKiiX8pcegFOdEUq7fdsE8Ccco&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4I7hgNuZcnh4FBJ5IhYMv1WbZktwDz7Cx1FLiDsEnrw&oe=6A9AC8A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qtrgn9e_Xo8Q7kNvwG5lAmm&_nc_oc=Adp9gWKuxxYd9YjCtMYoGahQ7yDhpG6GuQd7BE5RgTVdE-g-Mf8DSHUX6uXHos2TVdU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfo6OipdWhhrRhXyDsDCQmIjVlbzX5NwOKfdaedxQZPg&oe=6A9ACE47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyVpE85Kx4QQ7kNvwFrlPjL&_nc_oc=AdoJUSlEt8QRL4u0J1BeJ-ysDEdhghcL8h9tWRNW0Lzo2JSEQplwPs-huwS7dLl7Zp8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvaasnczoOFnlPo2GXW0fClJeC4l6faE7dsN33GS-4eA&oe=6A9AD138"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8B0iHe5vDDgQ7kNvwGapRVN&_nc_oc=AdoC1lSI84X9AqLyq_olypuSV50o7Da7LZkX6ehC2TAJ2_mmTcTwm1OsA_Cfn3gcTCI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzWrWpu3NAFdGu7G2FHzULcYv5SLyINhqiitLo3SjCtQ&oe=6A9AD386"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
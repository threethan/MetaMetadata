2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMlR9AdUylQQ7kNvwFjNY7w&_nc_oc=AdrrOvYxQq1mOrdMuSJ3yJAdoL5HfcWwREgtkpt6Xz1qwFvoUMy-fG-iM069MqBzsjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FSDMWlw9aUYGCZSJcCaP9hHxUDAuni_t6cM6Hvqf4XQ&oe=6A43EB9E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClVhjQEb8SMQ7kNvwFAlcg3&_nc_oc=Adr6DtYGyQp36_52OuYAzvaxIwkztZKcUGjq-CMsexV9u-YUlHYzIuaHbPFjylgBjvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yocRgKuuUTEOzBIs3pVVndL1-2uEhgBA1W1riO77ZXg&oe=6A43C5A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPX5jYkof3cQ7kNvwEB23rR&_nc_oc=AdqcR8yM3ec_xzl40vHnKEAoPspiBPRxfmtD9KgGvBIo6bPA-lJYr1aNk8faj3MVcfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lZ8ryb14H5oa5pPDgX9qxkFfuzmg3_Koh-dpFidbudg&oe=6A43CB47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1ESLBhh_nAQ7kNvwH-yFRf&_nc_oc=AdqW9ysYumSbH0rMvU1np6DIWMRnagQ2uZNpDUVjTf8qHBg4-5MKYavK-Q4otdAiSRw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CYTSR_WgdQS7BRD9DGkumrN-IDpmW_zif84LTWsq80Q&oe=6A43CE38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NR1aWYe5ksQ7kNvwFLP-FL&_nc_oc=AdqSEQdcKOm_ETn59yS-x72GHldk9T27CfkFlr8ddr7rHrvK6rTnpCE9EHAjw17HRI8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pbkpylo8CQDpBYprzOOF-tcEhGTTCi10AcSO4VbsVlQ&oe=6A43D086"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
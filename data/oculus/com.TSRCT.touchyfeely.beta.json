2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxmhZ92ec9wQ7kNvwEQl__Q&_nc_oc=AdoQkP86WVKY-IhUD7DgT9D9mdwSAP-zwFj572Njdbot-NtzasCcs64a5yze22rgxXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhkaqZbr9irfd9yjqde09arkczAVFTLnh8wEUkFl-mnA&oe=6AB54C9E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6l7x29c5FMQ7kNvwHh6tey&_nc_oc=Adpr2cT1kbsVscowYu2cnqTc12V7A9mgv57w2RNdLd0pYDj2YLTtvnxKMX9w53Q5qTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7WW7pZoxPQZOUczpsHUHXSq3RQlVyX4-kdeSpFl8hLA&oe=6AB526A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ85PZJyKOkQ7kNvwG8KQ4d&_nc_oc=AdphCXX2jvaqlfzp4KV5-ypbgODd-F2aifsr7fOZ1AsuAdQGH1hC8Vh0Uul832Qs_CQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgwtfITKtgH092o-Hsw8dcUqTS7riEfCPvOC984ChYUA&oe=6AB52C47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMbQVKaSeH4Q7kNvwG_on0T&_nc_oc=AdojN67sCeUfVxlGwHZEC_xrnZKdwQe7clk2KZK31V0nMQFoWUgrD2hJyxbbQVXdTbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYYomdjBXFftloagPuzQBkHCvRVjAVX3paXCVpCHe5yw&oe=6AB52F38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZ1yp7ntWrEQ7kNvwFD1esZ&_nc_oc=AdrFj0TxqTngnjBF3yWHffB9D7Y2pUG7v5cCDMXW0QKq_TZQKC9ppQphW-Gu7EHbs6M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE0hLnsOoZZx_rKAdZL58w_eYp2vCi7coVhWZLHHSzZw&oe=6AB53186"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_hpkMGE2xgQ7kNvwGFYtpL&_nc_oc=Adp2WR7jmmEy5aOjmLbJOkPIoApu_mTb_l2c_bsWNprv6B3LrrHqA778NgJNryBqamA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu_tZjhNYmEiMWgVBX68gZ2JJ_WBD0a0FLVzIUG8Uy6A&oe=6A81A9DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9iyfe_xcIQQ7kNvwFzgP3i&_nc_oc=AdoPZxYTkn1EPZ4x_7Vrck3VliOm0mdwxOv6uQPxLQoIyqIydvGoCkmb2bwK010EaMk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGfrLT5ffLiO_gPNGHktuj9I_KjPqU1knFF7SqK6XmIg&oe=6A81BC29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKMcy1CQigAQ7kNvwEw5lnN&_nc_oc=AdrNEFuKtoieBL1AzDuNTf2k1VrOK_e0hdMzyUQR_coPfjGVwOhgRHSbz4rRNADjI1U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4XoaFe58pL-RTdem9Ts2b0i2P-P7QyE7y3BULbkiOiQ&oe=6A81C1C7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtSWE_L6BGYQ7kNvwEWEsor&_nc_oc=Adpq5PbCtuqczP5UBqgPZbg-8W_Ic-TrYJiqCYyf42NxaL5-6sxfXqTf8ss4MJqSpqs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqAzwE34j8g2TmGcGEG1LUyD_XRwd-FZxVCfwjuKkU0w&oe=6A81C4B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruTFBVLlt9AQ7kNvwGRQ4eh&_nc_oc=AdqQg7_q0RYhLBFPeLfYg09ZELfWCKHg0cD1e-wSrtauaeJJ6n_GvUh96zjXOCNAMUI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk5uLGupUhdryGTsocOPoskdjHpnDxdVKC6D5tjU_OPA&oe=6A818EC6"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMa3KTS26eIQ7kNvwFMt8Sv&_nc_oc=AdrvmjKgDVu1HPhEOCNmqZH4Dk4U0B4DLw-_7lI4bJikFcBbeaRWrGBt0O_0tE7p-DU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H4iedGn-DeShqykUqyEAGW7Tb0SoRsJbkMddqscwZcw&oe=69D7985E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j5nBXBe3rwQ7kNvwHVkyeo&_nc_oc=AdpcWHR9ciTCC3Iv5sg1LyC18zRBSRVoSIiwMNUlXQOLwe_dyYsbZ6pROAr1aDdp8AE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t195Z5UboKBr47F6-AThx6xSccwk-nYW6I-OUUL723Q&oe=69D7AAA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NRtI7qaVvMQ7kNvwGFWdlZ&_nc_oc=AdpmtGROWVf7eal02XhzGNq8svZCtoAB3YhyB-pSO0YOQkDv7M8SVYG8dnTBevVfv9E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af178i8eN2ME_hAbiP0cJg3WnvPaWr1gWW-syNeH4kJ-TA&oe=69D7B047"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfvprdVuR3oQ7kNvwEigujw&_nc_oc=AdoTBI15KNyUgLnCi8KLZIp8Ixio1pM5B_BswsCaI8NJEghhP316bKW3qPrP3u5tmO4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kxtuAReM1AxxFqIEtKPhxPzuTbEb_YmQPL7FF3JQ7Pg&oe=69D7B338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1F05067rnyYQ7kNvwEwqYuj&_nc_oc=AdpBbW5U5Y7kL1w_vNAmK7uj4kGz3XQ0eNulhuuGuEaWAkQqUqjblKmoalHL1yM6UjQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Tuma4rtvwhMqUzGnAQa43ZQF1YRdungjqKWWVaEy1bQ&oe=69D7B586"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
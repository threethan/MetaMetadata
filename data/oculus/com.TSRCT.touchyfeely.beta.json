2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBPqcZ4BhDQQ7kNvwFRIr36&_nc_oc=AdqsBWCDhTMu9OpMBzcdqKpGVwKG_NpGtXqVeWXf2giZaRY3h9gkwAMy-w7fjEYBhFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dUaP0xxDT52NgSsZel1BWONNhZvvWGRPhv_0Dt-1xAg&oe=6A19BB9E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leVmfu7Fox8Q7kNvwGITYks&_nc_oc=AdoiO-hrDH8Dro9PF60NU7qGL-dq7ZqaJQZlZkT4mJuAdjjmbMTBiY8oiOHHbnMq-TE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CV31PQ-8pogk9Gn11DMTRCMWnOhqbK6S5F5wpIbfsJQ&oe=6A1995A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnH_ZJgHSQ4Q7kNvwHbe2Xk&_nc_oc=AdrYuFTR4haN4acLN2Ka8Ss0O1l7ieOh-oontQJarF5EzAYvhCVgU_Jz2HfWTcq33sg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55bzA3ce87RzLQzxxl81akufLTldDcKonGMDKqfUF3IA&oe=6A199B47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCaU4eckSf8Q7kNvwHopPjd&_nc_oc=AdriMrtfOUwdHd_Lf7FIUXyB3oIWJg4Lnm4QYuaFxwomYBIiS12beAH6LcGVdXLS5HA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4H9fyd9zKIjYk0IUbLKRptX0mzX9mMLLSzVO2fzG_Jgg&oe=6A199E38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AF9bJtsbVHQQ7kNvwHiuH3t&_nc_oc=AdqsAuzzcn2cbuyLFQrYVGa0Ht8CyZjYo3ejwVPMM4YuLS6oYAl825ZmZcbWx4a1-kc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iNrFF9L54sN93hFGSEDqcbDFtLbFgWsEvNcaxx02SjQ&oe=6A19A086"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
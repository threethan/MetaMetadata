2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sCTyuLWB2kQ7kNvwFeGwbP&_nc_oc=AdokOcYjeioepXvoket-hK30GL83w0_T0CGWlEhvboJEtTe_1CyHPfwnEMkwquxqLL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvh-N-DuhMjlhrbjQsHBFosFdmkhQqwM5c-Q6lDsbiMQ&oe=6A5F62DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCK2XtZ5DOoQ7kNvwF4-XIT&_nc_oc=AdoiFqtoPHqddYXAVdDkVmklyLp9rRpuBSFsO7eUSUCA6ZMaM9QQ43DFQOprLN_tiCQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA53lVtma08YASB9xEcwpxC8PWFrhXnzWtMEKWwCoznMQ&oe=6A5F7529"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8ddbsiRQTMQ7kNvwE8yUjh&_nc_oc=AdprtFWLKZjJ_wkynXRJ0IA26ty2x0NRF6N62gIXPGn0Y-sHXw8Iwaaz4W5R_EvkF9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5E3zPsPKEg7FnrEv8q-fXMnma1Gkq4aT8pGlhTwzu4w&oe=6A5F7AC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pdT4SoViB0Q7kNvwHG0eO-&_nc_oc=AdrtSxQiMjP_CQ8ww_CO3LyduOks2xUI1CdwZgsOXmE4pDht2Kkku9hMVmYt2cB6iUY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADpITGC-TX0hXDjGY2jhrfCR01y157rQzCfZKrpTSEew&oe=6A5F7DB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKLxJ7PaSj0Q7kNvwGqZYqX&_nc_oc=AdoAo2W3xmkYgUqJIrzchVWHM5y6svHcXb_WcZb2lIL4wmfHFGVb1xoThtaY7ib7CMc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyPonqu8yelyX69cp0MZaPF9aJlULsTHDu8qje13CmZg&oe=6A5F8006"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
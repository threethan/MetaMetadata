2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11N2ucUaorwQ7kNvwFOdMoY&_nc_oc=AdrMa-0IqCwZ5GrrdmB9IihJiE0SlkxwP_xe9iz4WQ5fvpCkHIVy1qCAwYELLuZEzFY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--uhAkJW2UklsWj2W27-J4VWHdARE7M_lK0AVlqETFZg&oe=6A21A49E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbTXE3NqvZQQ7kNvwEaOP4U&_nc_oc=AdocuapKncseyHmu3rk4S1C9-UWMwBjmz97w8WyMPD5N7FKgtSpZPipK-tBVMxWxTlY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0SXqoC7nbbQ7Mxtu_t-EA-sHJ3M6AzYFI7NpciVkKSw&oe=6A217EA9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsI4tQpCbqoQ7kNvwFJuBVR&_nc_oc=AdokmWCM8ngxM0CImiUBWWfvJoN2SAApIs1gQ9CV-mx3o5onpwKBs-xSX4WdTULJawo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KRl_kFYsc4M1IOZAp02wX3t9CxrY4dyozHho5nJfX_A&oe=6A218447"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPWFikfsfBoQ7kNvwFfGfeH&_nc_oc=AdobgMX24kyMC6ZiT0XQsH9ShvQ6VXZjCKvhx4P6dFP2h8k4-ogApqv2PnbudNbos2A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af944_3O87-VXNNA--dQLPnvQLjEwdjdgUgN_1e8PFcsbw&oe=6A218738"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7s6uiCWbR6UQ7kNvwFhLv4w&_nc_oc=AdoHE48tj0XGeRsWtOSVcW0JtPoi4Hf_NVdORzoR6L7sMNGlTJXRA2UJcmyKbAqS0ns&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y1YseoX1NPmrD4voMngj5DbzS40_G6Vj6mx_Z11VlHQ&oe=6A218986"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
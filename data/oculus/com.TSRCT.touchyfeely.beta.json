2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlPKBEQeYwQQ7kNvwGiJQ_L&_nc_oc=AdoOZCax041POXhTP71VP-Dn1dnovQER0wF1lhBKwVIELrk1HDxVKaswFR-schb0-44&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKDdcdHtxMBc6H72sHeM-F00TdjSNZIQoRIBM-aCfqjw&oe=6AF0A01E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtGe-fFSq0sQ7kNvwGXyKLi&_nc_oc=AdrhIVPL0AMVyQROoYkHh47s0cqhqfhYlMb4iojEyD-ssrl-1LFMEN-UkSo7Qnj1RU4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKEqZ-A75lbQZIqiqG_HZ_FsKL-WChHKDRc0eOExsGZg&oe=6AF0B269"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BBqmLlXaawQ7kNvwGCaDit&_nc_oc=Adqw7jdZXy2Nbr130thnwX8gAvtUZwxb-PV1_t6zyksEq1347G6QPSrwANQvL0AbmQo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFu_V342IMORqQP0jdJDkRBy417UY4nQ7tgq3OE4iSjA&oe=6AF07FC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_aLlrD3ZsgQ7kNvwHkbuQ1&_nc_oc=AdqFJeMrN7_ozqPbJijTA2J_OKsej50vz7A2D9dxKMbstwMjRs_r_Cqpf0WRCY-0UCE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3bRjLovGkLX1ApvoEkysb9GsDKOsEUtDefpZH_Jcmbg&oe=6AF082B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d_xMDe3wo0Q7kNvwH6jSqQ&_nc_oc=Ado0qbtqAhVUfnkoBQZiMBGk0550ZckZL9Xo-0cxBsbsu6IZ6zhqTuSgnd7j-BhJUHs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRswnnhtscQWAMWa_99QqVQtrWhcQpFfxd1UqNd-rhxTw&oe=6AF08506"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
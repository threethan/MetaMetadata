2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1_R9OIUDwMQ7kNvwFL2HzZ&_nc_oc=Adq7JB16KIIxSMkVSzIO_5Cy52dQUqW65_L6O3SH6_AX9UXNJ7bqMzNA62ImyH_g5sk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af052qq_zi5h9pK_uXIcCXIdnHFzW6A5LHuExAUD4gdZVQ&oe=69F347DE"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tQZ3-VSnv8Q7kNvwF2Kb5x&_nc_oc=AdpOOhD1IyaBXV_BUjNs5vv6MftyHE4l-Re-Ystsa_e4TA-us7eV3HIjfa4TesqJhQw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2acdrTw5vV071vAkPF_MX3-Q83owPdwU0fbMRxBM6TEQ&oe=69F35A29"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVQEeOJoZfMQ7kNvwFuuWHz&_nc_oc=Adrb-1g73C4tbqOLMoeiHHGMDA7WPy7bvjhS10qHlYCFfr2I8rTRIzwYSgVKVDQ3zns&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0FIe8X_kedMti4udFfwZ8kHb8ORwgNy4ky9BG4v39rIQ&oe=69F35FC7"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iALojxUpnOMQ7kNvwG0kcYu&_nc_oc=AdqhThwPcq2lxmmi_wNd0tHj5rQSss-LUqnmFn3JqiBRgX24B2UlqCMA1QPy6d0vzUE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27ISMKPccBGy0wvOYgJgNYKv1sWn0IIF4I5vj9lpDHqg&oe=69F362B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdnBhkshp38Q7kNvwGBb1nw&_nc_oc=Adom_vtDLglXOfIvu3npL65lOA1-1D87tUpq9D6tpLoUFHS0tf7TChrPKohzgIXQf7s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rwTyRom4V14fH491h3ZNwQEP99H4MYl74zhcPOMCg2A&oe=69F36506"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
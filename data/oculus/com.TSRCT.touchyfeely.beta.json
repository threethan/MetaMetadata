5843_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhlx-BvN75sQ7kNvwGOH_1X&_nc_oc=Adoi7RHj5EtX4s2qUXkpE95jce3unouiDJDGeq-80fH6iiyDZKXhvCs5RSaiqapaNwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPOtSoT8YTpKTvszFenKVNcZNJdBrNmdY1ST3bIBKkwg&oe=6B0DA11E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouQiw4aP2XAQ7kNvwE-e-N5&_nc_oc=AdrQT4fcDja3TQQQqJ3K5vAX7hKk_w49zH6A5ycuGTgoEbyhlS7SpWiCQzfzSRbD6y4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1EBwrE1FzqmzPGIC-yMuALQ5UsPjpbh51tdkLs5MSNw&oe=6B0DB369"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvXxBa57XpgQ7kNvwERpMQI&_nc_oc=AdoNbj-Te_oaLbDydsK-9Eloug7B5-CXAHS_xpSJ9xaOlpYM1DBAfa_X01MS-SMlqCA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTc_Z70DPqPYcXbypst-_AArYuvVAV2y65UsTQx-id2Qg&oe=6B0DB907"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6lkWvB-Zl8Q7kNvwEZT5_R&_nc_oc=Adq0G54Cj4-SfUkBxhzeterqgX_66QH-BIFUG6IFy--TZo9MAoGxTIx54lXCOyMYazE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBrlFpnRiHhjztWRk0B7WVljKtOmkpHG4Tu9-Dn17GsQ&oe=6B0DBBF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhcC5EFc9M4Q7kNvwFKR8Xs&_nc_oc=AdqG-pbPY0ywejCTWc-WiB1QKM3x6F5rgEpyU3QMvvQb_Fb2PyoZkoAfdK1uKyWope8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTISasdnyUgnEQbcuynBos92MRdZbKmbospAp86EEqxAQ&oe=6B0DBE46"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommend
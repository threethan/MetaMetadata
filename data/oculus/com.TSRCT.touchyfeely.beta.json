2_1356901974671529_9207502790765825843_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0w2pgdGPHdMQ7kNvwFXlrkp&_nc_oc=Adpw1e14p78cPK6NdM_Ys2j4gdj4v6hjNZywsrNIBR5_04mTHIJy8iBDrlQFLjw1Mg0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwxTPsa92SnESBEYyXdogxoCrPISm1m5277YZoVx79qQ&oe=6ACFAA9E"}, {"file_name": "Art-08.png", "id": "423516152088910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221323_423516155422243_1805999941798606348_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gm-5tZswtf8Q7kNvwGfHEZ0&_nc_oc=AdqHSyHwlhXTKSaPXSMCkUjNSUe_ELTspT0XQFbTUPwCQz9gUDRBP2qc8uPmOZGrM_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNIIb_0rsr6YtN1PJfLs8JnFfvgNCNw6dBqjed6xsplg&oe=6ACF84A9"}, {"file_name": "Art-08.png", "id": "1891902310961288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75196225_1891902314294621_2238078460830108184_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAhGnGR6a0cQ7kNvwE6ddkn&_nc_oc=AdpA8U94KX--Zsv3sl56eL6t_bxqOYnYmH1aUW_bRFCaJs1q6fezKk5EcAVnQvC61B0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6ampuVSqUUv9UE-L-lsz83rYDPszSJ6zxidjeYSPBQg&oe=6ACF8A47"}, {"file_name": "Art-08.png", "id": "782210065728523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974769_782210069061856_6175752411345744086_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwT204YQysEQ7kNvwEy_EmM&_nc_oc=Adp5ZU6BfSRZjMG1bh1J0y2GlL_B8WDLafEl7ytQ5j7Yb_kfYY547Ylp62ALUslJpF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsM8RN1SPL_y326H71MSN8qJR4WG-AwTSxlRYHoeMhlg&oe=6ACF8D38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-08.png", "id": "423398472215020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_423398475548353_5249155989052516159_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnwPz6nA1TEQ7kNvwFCyeOD&_nc_oc=AdoK6EOhP4U4KG91dTDwLTthn7gjCLoPHxiuzSGW-GzZmuYyPhqiKY-esVIFiU5KOcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzrSp42AL2_x8zYqlzOsxFt7QwTH9AaQzzVQjE20CLdw&oe=6ACF8F86"}, "display_name": "Touchy Feely", "keywords": [], "long_description": "This is the first draft of a system I want to use to build experiences with hand tracking, it features\n\n - touch response, this is colour and sound for temperature and pressure\n - custom shader, I'm learning shader graph and want to make a battered comic book style\n\nWhat I hope to do\n\n - create a small short story in this space, about someone packing down the apartment of a loved one that has passed away.\n - polish the grab and feedback mechanics based on some feedback\n - add teleport and explore hand based teleport\n - work on more natural engaging interactions\n\nI'm making this public to get a read on the grabbing and the art style, I still want to add audio and polish the mechanics. My goal is also to create technical and creative experiments and share them. I want to publish often and develop in public! You can see all my development work at https://www.twitch.tv/samueltates and develop with me on Saturday mornings!!!", "short_description": "a hand tracking playspace, testing out grabbing and visual / audio feedback\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.samueltate.com/", "developer_terms_of_service_url": null, "publisher_name": "Sam!", "support_website_url": null, "website_url": "https://www.samueltate.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
image.png", "id": "637072993742928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504601_381183235594896_5588798328172183552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6NTYMz5OXQQ7kNvwG2G1E8&_nc_oc=AdnIyNKOs0I7PCRisuIYOF8NkaXaZQ75sUUI4yMlrXgbTkSSxBMwbjwaD-x5RXKR0Zc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftkDtT5AtOaz5hKlwKSasgG8O47aVqtWjbCvCUDsbIUtg&oe=69A96D1E"}, {"file_name": "migrated_image.png", "id": "2406758169615796", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138960_1392905707436755_9122556866516221952_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUO0MGdM2cgQ7kNvwH6Hd0J&_nc_oc=AdlMU8Tg63HLhy3-8QLyZ3RhybZh7VMXnUihNkHHgJZ-x5Qa7segzYtbpPHyfAiarRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afsp0xAjc_eKWuiGwLd-MgrLrsnLGE6NRHTdR7zs7qok3Q&oe=69A96A58"}, {"file_name": "migrated_image.png", "id": "1669615673177303", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602284_986307178135757_74665936266723328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zH6iZ35S9tMQ7kNvwFKcdx1&_nc_oc=Adkho0nIB0pkbXrqm9V0MxbUfKdX10ufotliXGWBiMEahRtZ5I_qEDSe0zA5Wh0QYoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvuFwpeK4bDsb2gwS555SVqLXFwnOxLyWMBzr2eZSq09w&oe=69A97334"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PhenomVR", "keywords": ["Electronmicroscopes", "SEM", "materialsscience", "imaging", "microscope"], "long_description": "Phenom-World is globally the yearly number 1 manufacturer of desktop scanning electron microscopes and analysis packages for a large scale of applications. The Phenom desktop SEM is known worldwide for its ease-of-use, speed and reliability.\nThe Phenom electron microscope is the ideal tool for investigating any sample and analyzing their composition in a short span of time. The rapid sample preparation and the incredibly short feedback time improve the efficiency and effectiveness of failure analysis, quality insurance processes, or non-destructive testing of materials.\nPhenom-World is based in the high-tech region of Eindhoven in The Netherlands. This strategic position and partners give Phenom-World access to the newest technologies and best resources for developing state-of-the-art equipment and applications. With representatives in more than 40 countries and a fast-growing installed base, we are committed to supporting our customers with a highly skilled team of specialists.", "short_description": "Phenom-World is globally the yearly number 1 manufacturer of desktop scanning electron microscopes and imaging and analysis packages required in a large variety of applications. The Phenom desktop SEM is known worldwide for its ease-of-use, speed and reliability.\n\nWith representatives in more than 40 countries and a fast-growing installed base, we are committed to supporting our customers with our highly skilled team of specialists who provide application and service support on a global scale. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.phenom-world.com/", "developer_terms_of_service_url": "https://www.phenom-world.com/", "publisher_name": "Phenom World", "support_website_url": null, "website_url": "https://www.phenom-world.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "904649030225682"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331199_1441284982579531_21005551817614950
H0wnqw&oe=6A858241"}, {"file_name": "migrated_image.png", "id": "637072993742928", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12504601_381183235594896_5588798328172183552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT4iGNYGnqQQ7kNvwH2t7L1&_nc_oc=Adqww0WDWZ976Qb3XeALAXwW-ARnGXta1w7O6Vmz5Yy54TlI9NZYEccoZ1f8LwR74NE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOqX43Ig7dqKcEC3TOyiSOvU6JZNwh1Rc1VsZYsgwxMQ&oe=6A85979E"}, {"file_name": "migrated_image.png", "id": "2406758169615796", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12138960_1392905707436755_9122556866516221952_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7cMnFU1l0YQ7kNvwFVVeGo&_nc_oc=Adr0RAKHF84ewKQNTMXEPUIp-VbdxXwOlY6RYWcWsopVPmHcacDFwwxB0PkpFhWyEOM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4Tc5qbWC7VNECegHhYZYUwD6acVRTsehSRZ4GKUykYA&oe=6A8594D8"}, {"file_name": "migrated_image.png", "id": "1669615673177303", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12602284_986307178135757_74665936266723328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yqsVYu1qCsQ7kNvwEQh_ke&_nc_oc=AdrmeLe2CATyDvude4WDlOyfzACy5q9jSo1z7ajfYzkdCmV-jrDoAOhWGSZiW1GOIn4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNROJvs0H6we0Q8Hv12am0DtOefW7E0rq1iIAxqnJ3mw&oe=6A859DB4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PhenomVR", "keywords": ["Electronmicroscopes", "SEM", "materialsscience", "imaging", "microscope"], "long_description": "Phenom-World is globally the yearly number 1 manufacturer of desktop scanning electron microscopes and analysis packages for a large scale of applications. The Phenom desktop SEM is known worldwide for its ease-of-use, speed and reliability.\nThe Phenom electron microscope is the ideal tool for investigating any sample and analyzing their composition in a short span of time. The rapid sample preparation and the incredibly short feedback time improve the efficiency and effectiveness of failure analysis, quality insurance processes, or non-destructive testing of materials.\nPhenom-World is based in the high-tech region of Eindhoven in The Netherlands. This strategic position and partners give Phenom-World access to the newest technologies and best resources for developing state-of-the-art equipment and applications. With representatives in more than 40 countries and a fast-growing installed base, we are committed to supporting our customers with a highly skilled team of specialists.", "short_description": "Phenom-World is globally the yearly number 1 manufacturer of desktop scanning electron microscopes and imaging and analysis packages required in a large variety of applications. The Phenom desktop SEM is known worldwide for its ease-of-use, speed and reliability.\n\nWith representatives in more than 40 countries and a fast-growing installed base, we are committed to supporting our customers with our highly skilled team of specialists who provide application and service support on a global scale. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.phenom-world.com/", "developer_terms_of_service_url": "https://www.phenom-world.com/", "publisher_name": "Phenom World", "support_website_url": null, "website_url": "https://www.phenom-world.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "904649030225682"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculusc
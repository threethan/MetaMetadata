esktop SEM is known worldwide for its ease-of-use, speed and reliability.\n\nWith representatives in more than 40 countries and a fast-growing installed base, we are committed to supporting our customers with our highly skilled team of specialists who provide application and service support on a global scale. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.phenom-world.com/", "developer_terms_of_service_url": "https://www.phenom-world.com/", "publisher_name": "Phenom World", "support_website_url": null, "website_url": "https://www.phenom-world.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "904649030225682"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1939676546260476"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1489597200, "status": "PUBLISHED", "id": "1939676546260476"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1411428225568774", "version": "2.1"}, "id": "423954997953043", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1406387342739529", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1411428225568774"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"
nc_ss=7f20f&oh=00_AQLzjF-afX9Xqxgl1VsViEFhmjw_Mj-aAywjFQ_QVpTA2Q&oe=6AAFF3EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-12-24 220044.png", "id": "1553650645516809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982653_1553650648850142_8415360079989085049_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yX9ElGyvfxwQ7kNvwE39leG&_nc_oc=AdqBQabpYAm8ruds51nv47qweZszMR6GoZQX_DCs7sG6TyFqAe8LfB-YLrMzf7eUG5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiEU4FkFMfdSKVBLG4wKAzyiFmhdFzeVZWtVwOzu6Ztg&oe=6AAFEBB8"}, "display_name": "Fast Food Universe", "keywords": ["Elite", "comfort", "food", "simulation", "Fun"], "long_description": "Welcome to Fast Food Universe, a cosmic realm where fast food meets the vastness of space! In this vibrant and imaginative game, burgers, fries, and soda cups float through swirling galaxies, creating a playground of excitement and fun. Each level presents unique challenges, from collecting glowing fast food items to avoiding obstacles in dynamic environments.\n\nDive into colorful, fast-food-themed worlds, each brimming with surprises and creative designs. Strategize your moves, master tricky patterns, and unlock hidden secrets as you journey through this deliciously crafted universe. The game offers engaging gameplay for casual players and fast food enthusiasts, with a perfect balance of challenge and fun.\n\nWith its eye-catching visuals and playful design, Fast Food Universe is more than just a game\u2014it's a feast for your imagination. Whether you're a seasoned gamer or just looking for a fun escape, this game promises hours of enjoyment and a cosmic culinary adventure. Get ready to orbit into the tastiest galaxy ever created!", "short_description": "Embark on a cosmic adventure in Fast Food Universe, where burgers, fries, and soda orbit like planets in a colorful galaxy! Explore vibrant, fast-food-themed worlds filled with unique challenges and surprises. Dodge, collect, and strategize your way through dynamic levels as you .uncover the mysteries of this delicious universe. Perfect for casual gamers and fast food lovers alike, Fast Food Universe offers endless fun and a feast for the eyes!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/fast-food-universe", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27869322322682813"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1008975401773222"}, {"status": "PUBLISHED", "id": "813613921470824"}, {"status": "PUBLISHED", "id": "2620943338275178"}, {"status": "PUBLISHED", "id": "1097894609172408"}, {"status": "CANCELLED", "id": "686517524112398"}, {"status": "PUBLISHED", "id": "642779321904182"}, {"status": "PUBLISHED", "id": "637382575887908"}, {"status": "PUBLISHED", "id": "1294339154941852"}, {"status": "PUBLISHED", "id": "906290384949992"}]}, "baseline_offer": {"id": "637382575887908"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787079600, "status": "PUBLISHED", "id": "100897540177
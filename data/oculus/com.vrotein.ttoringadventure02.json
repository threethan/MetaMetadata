age.png", "id": "228310495023338", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162823_1841611646079799_6098893396141670400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxkZNu4m2ngQ7kNvwH41vbP&_nc_oc=AdmxrAfoWlgIqJDdOguAA3nEYI7z2VTE3DowIhRtBcDYe1V5WerKuvsqkkOgamUUbvg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTy45s4cHLoPT8AedWIXMmqVVEVJ5f6neMTIACg7mzKg&oe=69B179BE"}, {"file_name": "migrated_image.png", "id": "153672775828601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12602069_631102340417775_14906341130764288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sm1qQUQuwooQ7kNvwFLZVig&_nc_oc=AdlSl2hMosm6-VxxgvNwdCigWfRrUHJP-ozf-TAB4Gn86SAecGggLAVZ5OYyE-d6XWU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXxr9mykApHuN8l64ZhpBO-E0yuu4iPCsbV34LM1hIjA&oe=69B17519"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_landscape.png", "id": "1860260744243734", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602284_1860260747577067_188394771889258496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqiJmL5k1y4Q7kNvwEvw-8K&_nc_oc=AdmtTZP1OIuwRx5SNoTIcRQZy1cA2CLbD6zg5ccka-r5zBQensaR3aG_EIi0j5VNbCk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLJlwJrr07CHbj_00RdOUHiK8pDNT2_m5v7Vl3lMzfxg&oe=69B14AD9"}, "display_name": "TTORiNG Adventure: Moon's Tears", "keywords": ["puzzle", "adventure", "animation", "microworld", "ttoring"], "long_description": "TTORiNG Adventure is a voice recognition based interactive animation. The story progresses through the user directly engaging in conversations with characters in an imaginary world. Consequently, there is a high level of immersion and the player can actively participate in the story. There is also the benefit of cognitive development through a story with a concept of deductive reasoning as well as logic, observational, analytical and the application of other skills. Also there are many interesting features including numerous puzzles and a \u201cmicro world\u201d experience. Through this, players can genuine and fun experience that can only be had in virtual reality.", "short_description": "TTORiNG Adventure is a voice recognition based interactive animation. The story progresses through the user directly engaging in conversations with characters in an imaginary world. Consequently, there is a high level of immersion and the player can actively participate in the story. Also there are many interesting features including numerous puzzles and a \u201cmicro world\u201d experience. Through this, players can genuine and fun experience that can only be had in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vrotein.co.kr/", "developer_terms_of_service_url": "http://www.vrotein.co.kr/", "publisher_name": "VRotein", "support_website_url": null, "website_url": "http://www.vrotein.co.kr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "PUZZLE", "EDUCATIONAL", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "367350161453016"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "297687690696324"}, {"status": "PUBLISHED", "id": "334259943642807"}]}, "baseline_offer": {"id": "334259943642807"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1497718800, "status": "PUBLISHED", "id": "297687690696324"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id"
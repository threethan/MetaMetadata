dn.com&_nc_ss=7f20f&oh=00_Af9gImxCl29M-sRlD_wwiY9G9vI7CSKELqSxRX38tmxZlw&oe=6A4675B5"}, {"file_name": "migrated_image.png", "id": "228310495023338", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162823_1841611646079799_6098893396141670400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVK5pL5_X4cQ7kNvwGboch0&_nc_oc=Adp4ls-bK4wL3zHW5IC1KNbhYAqKj9m0tuh63lcygTxPBeI_W4qjEn-EdZfuPCDjmVo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FsWXBqsrLSenHqIOMfGpuNqTvNbj1fOb-PYkrhoM1VA&oe=6A46733E"}, {"file_name": "migrated_image.png", "id": "153672775828601", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12602069_631102340417775_14906341130764288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bu1RkPDxtsQ7kNvwGOGZ9U&_nc_oc=AdoeIIdvQ_NjQ58a-_-NBPqdJUA_Nah0K43t899QjNZR9cFhfLq1hE7iqI5fsub4LqE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UYgvJxSanZkvRAikF06o_VbrhRZOetFUxjs3JzQOWFg&oe=6A466E99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_landscape.png", "id": "1860260744243734", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12602284_1860260747577067_188394771889258496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAHMioc7iFoQ7kNvwF5mlzw&_nc_oc=Adpkwz1IdJqUnaKYuc0rqyLL9FR2uh7gEkaouiLZbdPBILVImGLoNNbg53_zFlGwzio&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OxVM9NLkEhAfBbkaLivKKSmZFU8xOArpdpIbIMmKd4w&oe=6A467C99"}, "display_name": "TTORiNG Adventure: Moon's Tears", "keywords": ["puzzle", "adventure", "animation", "microworld", "ttoring"], "long_description": "TTORiNG Adventure is a voice recognition based interactive animation. The story progresses through the user directly engaging in conversations with characters in an imaginary world. Consequently, there is a high level of immersion and the player can actively participate in the story. There is also the benefit of cognitive development through a story with a concept of deductive reasoning as well as logic, observational, analytical and the application of other skills. Also there are many interesting features including numerous puzzles and a \u201cmicro world\u201d experience. Through this, players can genuine and fun experience that can only be had in virtual reality.", "short_description": "TTORiNG Adventure is a voice recognition based interactive animation. The story progresses through the user directly engaging in conversations with characters in an imaginary world. Consequently, there is a high level of immersion and the player can actively participate in the story. Also there are many interesting features including numerous puzzles and a \u201cmicro world\u201d experience. Through this, players can genuine and fun experience that can only be had in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vrotein.co.kr/", "developer_terms_of_service_url": "http://www.vrotein.co.kr/", "publisher_name": "VRotein", "support_website_url": null, "website_url": "http://www.vrotein.co.kr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "PUZZLE", "EDUCATIONAL", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "367350161453016"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1213665102065513", "version": "1.0.1"}, "id": "1741241397565
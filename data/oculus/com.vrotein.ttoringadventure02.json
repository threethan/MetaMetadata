dn.com&_nc_ss=7f20f&oh=00_AQJdig2k2chrsQH3nhPLIKMZ1mVjyQe7b0340McY04pSZQ&oe=6AA41035"}, {"file_name": "migrated_image.png", "id": "228310495023338", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162823_1841611646079799_6098893396141670400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiXFGwjEr5gQ7kNvwGt7PC8&_nc_oc=AdqhRbF2roeI2R2VkJnBAwU2epIB0nHWEUGqMrL8cfEEVWlRdWTrV_c7--oFz6oIWX8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtkY1c6I7KEgu0dqczlE6qZgEzSa8Y5JzJiN_4pmbsag&oe=6AA40DBE"}, {"file_name": "migrated_image.png", "id": "153672775828601", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12602069_631102340417775_14906341130764288_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x03_m3afigMQ7kNvwFDa3Yu&_nc_oc=AdpFQvWVxygRkHvaNrboYIKYdSIRe3ET4LO7LNhCMD-4O7SH4NyP1x7jG1zmqIy2IhM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-ZmujXDGVFMa_IEOX4UN3PkeUCuwpiXC9wN8wdSu0Kw&oe=6AA40919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image_landscape.png", "id": "1860260744243734", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12602284_1860260747577067_188394771889258496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPZrk4BdbfYQ7kNvwGJ71OC&_nc_oc=AdoHOl3DD0Uz5UAf6o4M2yFBv0uHX-pjGeSk4GAfG5Wiu5JYSbwlB5oguLLKlrLWgyk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkrqMU5B3GiRv_opInc4-wtVZTIXkBgNpuKBun3nUasA&oe=6AA41719"}, "display_name": "TTORiNG Adventure: Moon's Tears", "keywords": ["puzzle", "adventure", "animation", "microworld", "ttoring"], "long_description": "TTORiNG Adventure is a voice recognition based interactive animation. The story progresses through the user directly engaging in conversations with characters in an imaginary world. Consequently, there is a high level of immersion and the player can actively participate in the story. There is also the benefit of cognitive development through a story with a concept of deductive reasoning as well as logic, observational, analytical and the application of other skills. Also there are many interesting features including numerous puzzles and a \u201cmicro world\u201d experience. Through this, players can genuine and fun experience that can only be had in virtual reality.", "short_description": "TTORiNG Adventure is a voice recognition based interactive animation. The story progresses through the user directly engaging in conversations with characters in an imaginary world. Consequently, there is a high level of immersion and the player can actively participate in the story. Also there are many interesting features including numerous puzzles and a \u201cmicro world\u201d experience. Through this, players can genuine and fun experience that can only be had in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vrotein.co.kr/", "developer_terms_of_service_url": "http://www.vrotein.co.kr/", "publisher_name": "VRotein", "support_website_url": null, "website_url": "http://www.vrotein.co.kr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "PUZZLE", "EDUCATIONAL", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "367350161453016"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1213665102065513", "version": "1.0.1"}, "id": "1741241397565
6905", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031518_1113760809920238_374040494887525675_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Beh42zZ4KGsQ7kNvwEvNo2a&_nc_oc=AdpaSSPYXeRVT1JKqO4ZB_44KLZHkUX_Cz3pI1Uvl-ZwEMJj301ZUC_BMFYqDhuGDnQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3RV346-UdYg56bRhAR_PbYk5VoJYM013o1kBGifEMQQ&oe=6AAE8DC5"}, {"file_name": "Screenshot-1.png", "id": "832532242169712", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031457_832532248836378_3663210356497322076_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_2fJGgPFwEQ7kNvwGpPOIQ&_nc_oc=AdqzvUNd3M-V9g-KUxF89Z7A088Dd_9fE5-rfSK8rsZdcPk9tuO0hztZIf73DHIloSw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8pYp0BqksHr76YMZoQ-nFFa7E-gd--D-6EvPuAd2mtQ&oe=6AAE8F91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Shotta video cover.png", "id": "998125558115830", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974670_998125561449163_5721044183343334113_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYt2DaTm4lkQ7kNvwHdvFyb&_nc_oc=Adp4ozJ1EkHy4eRW5W7Pv5sTY2aIaU-nKDaLciBYS0kupzoFczGwjnRVgBeOFhEYDOA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8r0C-W06JKe7j59xGHpn1qOXKDxvuiriT0J1SYSXhOw&oe=6AAEADCB"}, "display_name": "No Games - Drum & Bass Music Studio", "keywords": [], "long_description": "Play incredible Drum & Bass live in multiplayer, with the sounds of UK rapper Harry Shotta and acclaimed producer Erb n Dub. \n\nMix and match hard-hitting drum sounds to generate the perfect DNB beat. Compose wicked and wild bass lines by moving the controllers around, adding hair-raising effects, all on top of Harry Shotta's classic jump-up style rap virtuosity.\n\nPlay solo or with up to 15 friends to have your own virtual DNB rave in VR!", "short_description": "Play incredible Drum & Bass live in multiplayer, with the sounds of UK rapper Harry Shotta and acclaimed produce
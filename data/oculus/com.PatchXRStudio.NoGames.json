6905", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39031518_1113760809920238_374040494887525675_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAyW0SGMD4kQ7kNvwHrNIeL&_nc_oc=Adq3dOeLDsLg8_m6e_kQykx3SEA7BSp2w2nlmoPsGzHPO6JF-YxsuRzB1djH-JEoapE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vJc7P92np6REYmV-QgiQ3cTDOOKvrC6XepQoMEa9jDA&oe=6A393845"}, {"file_name": "Screenshot-1.png", "id": "832532242169712", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031457_832532248836378_3663210356497322076_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d21c42cNX3QQ7kNvwFJA1Ry&_nc_oc=AdrSqkV4YR3G8NENrOTgMoxJB5BIrebaYvPo0tVYt8NITqtbf4emRbj5gFPpnx82S9k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81x1Vk4i7iBBPVtHeaWbJimhz3CyMcV3R-1KN6DV3Qfw&oe=6A393A11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Shotta video cover.png", "id": "998125558115830", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974670_998125561449163_5721044183343334113_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FuGLEMIlGUQ7kNvwErtTDF&_nc_oc=AdrN6I6-1xQzZi2K2zWg8F3BwVcZqBn527ptxFB_ac7WrbouyI3NSCtD4A9GwaAUi5w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rEzoRBp4-Gtupv5Gp-ocQecu7WiTzR-bzK4t2vD831A&oe=6A39584B"}, "display_name": "No Games - Drum & Bass Music Studio", "keywords": [], "long_description": "Play incredible Drum & Bass live in multiplayer, with the sounds of UK rapper Harry Shotta and acclaimed producer Erb n Dub. \n\nMix and match hard-hitting drum sounds to generate the perfect DNB beat. Compose wicked and wild bass lines by moving the controllers around, adding hair-raising effects, all on top of Harry Shotta's classic jump-up style rap virtuosity.\n\nPlay solo or with up to 15 friends to have your own virtual DNB rave in VR!", "short_description": "Play incredible Drum & Bass live in multiplayer, with the sounds of UK rapper Harry Shotta and acclaimed produce
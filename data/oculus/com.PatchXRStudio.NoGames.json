VlgQ7kNvwHgwz03&_nc_oc=Adq6swVcEtBEihYAJSZ4ogDbBpsF_fq86bHHDFaTjWapqbUgUqOWSoIBBA1X3_Oi2aA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyv4IQZjKBwKGWUN9qmcymyOBjNdmjQ_i0Eie5jmUW1w&oe=6AFC9230"}, "display_name": "No Games - Drum & Bass Music Studio", "keywords": [], "long_description": "This app was created with PatchWorld - a modular metaverse where you can build experiences like this from scratch, we intend to take over cyberspace.\n\nAbout No Games - this is our collaboration with UK rapper Harry Shotta and acclaimed producer Erb n Dub. \n\nMix and match hard-hitting drum sounds to generate the perfect DNB beat. Compose wicked and wild bass lines by moving the controllers around, adding hair-raising effects, all on top of Harry Shotta's classic jump-up style rap virtuosity.\n\nPlay solo or with up to 15 friends to have your own virtual DNB rave in VR!", "short_description": "Play incredible Drum & Bass live in multiplayer, with the sounds of UK rapper Harry Shotta and acclaimed producer Erb n Dub. \n\nMix and match hard-hitting drum sounds to generate the perfect DNB beat. Compose wicked and wild bass lines by moving the controllers around, adding hair-raising effects, all on top of Harry Shotta's classic jump-up style rap virtuosity.\n\nPlay solo or with up to 15 friends to have your own virtual DNB rave in VR!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.com/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics
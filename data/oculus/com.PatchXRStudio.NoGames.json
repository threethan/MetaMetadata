6023510567067", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569468_486023513900400_145284436897299379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FS5116E3T88Q7kNvwHbZMp1&_nc_oc=AdnQ8YVRI_weakxR1HGSluLljCIioogr9cXwzW3hFKuG6xL2ei6jyDdQKHPWOrBAx6c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs1ws84uxkatYH_7wLlf0zVyOF21Hq9WCUWE1LzECwJfg&oe=699C5696"}, {"file_name": "Screenshot-5.png", "id": "1113760806586905", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031518_1113760809920238_374040494887525675_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQOhVD7I5cIQ7kNvwFqXmRF&_nc_oc=AdmjGjTmYwbVFwvRkFjREH5Q3P18RVVIWIdUHqQvxc7UEtCk9yj9wa-JysX1NIr2pTc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuRJ5DTKeN__mp7EVMKai1HfZslAskXnG27J31xW6AxIA&oe=699C55C5"}, {"file_name": "Screenshot-1.png", "id": "832532242169712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031457_832532248836378_3663210356497322076_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcdAU_hDdxMQ7kNvwGQztcf&_nc_oc=AdkVRn-MQzPgwacz16l1vMVyzcl4VB_kGOp57rBspFNopuJkY3fRykTZ6NoKjV0dHsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfverQZpU2gbbLGZQNotOZ6cQYFBSKjMYY51edWhPaWsog&oe=699C5791"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1118375069235788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974458_1118375072569121_2864568641225082773_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgSlXcI7i_sQ7kNvwHtsDbZ&_nc_oc=AdlECgfR8kAkbBMNdSZNJXzVYZ03iAWtQtwEezLWK7uHfkmytTPcrpXZ9zOznzj0Yjc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuOvnocithyY49N0UIvy2LsFTFpcAss9ahkSR4-UhTq9A&oe=699C5970"}, "display_name": "No Games - Drum & Bass Music Studio", "keywords": [], "long_description": "This app was created with PatchWorld - a modular metaverse where you can build experiences like this from scratch, we intend to take over cyberspace.\n\nAbout No Games - this is our collaboration with UK rapper Harry Shotta and acclaimed producer Erb n Dub. \n\nMix and match hard-hitting drum sounds to generate the perfect DNB beat. Compose wicked and wild bass lines by moving the controllers around, adding hair-raising effects, all on top of Harry Shotta's classic jump-up style rap virtuosity.\n\nPlay solo or with up to 15 friends to have your own virtual DNB rave in VR!", "short_description": "Play incredible Drum & Bass live in multiplayer, with the sounds of UK rapper Harry Shotta and acclaimed producer Erb n Dub. \n\nMix and match hard-hitting drum sounds to generate the perfect DNB beat. Compose wicked and wild bass lines by moving the controllers around, adding hair-raising effects, all on top of Harry Shotta's classic jump-up style rap virtuosity.\n\nPlay solo or with up to 15 friends to have your own virtual DNB rave in VR!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.com/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26002674749379575"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982662_465574579558256_1604267806852439902_n.png?st
602132_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzQFuMJZ1VQQ7kNvwH6k-Ys&_nc_oc=AdoOnGLOGIaLIzejOwWA2xbolLP_yaCU1uQIA8ak8mtyVsdgjPcqiwcLMPBwU2-JWKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQLN0qqHRyyDof229B-rV3Zpi9QbWySVWa0NnzSM7qaNA&oe=6B0DAD96"}, {"file_name": "Screenshot-2.png", "id": "486023510567067", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569468_486023513900400_145284436897299379_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHnIwggdCM8Q7kNvwE0cdNT&_nc_oc=Adq3D6AWLFOc7los-4RZzPTorpB0I4ArStH355kdTNnG0xJYJIfGern_4WnOEIXRWxw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7CipOkcJmHGyTTyxVHc4IIMXForermm7WIxB88G5JVw&oe=6B0DB2D6"}, {"file_name": "Screenshot-5.png", "id": "1113760806586905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031518_1113760809920238_374040494887525675_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp8ebkmrnw4Q7kNvwHd8jjr&_nc_oc=AdoG2Eu4DogSrEkBmA2gumappB3a9lpKN7BVuNYQe2zAlvZLYhSr79sY4VNHPe6VDY8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQX0GaKYqXWrxFhT8aNFohkDrNcmdWPGu8exxG3fjlZBA&oe=6B0DB205"}, {"file_name": "Screenshot-1.png", "id": "832532242169712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031457_832532248836378_3663210356497322076_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsm10y3nL-oQ7kNvwGZ2u43&_nc_oc=AdqJB8kldmUTMQLNCH8bVrvg8pGuQ1l4oT0aILJTOkmTzCC-coj00o9cgrSVSN2S0s8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1Kel3RCD0NAwj1rI331I6z4hocOWabF62KXASS0UbFQ&oe=6B0DB3D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1118375069235788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974458_1118375072569121_2864568641225082773_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ExNGC0tZI0Q7kNvwFhL-I6&_nc_oc=Adqn_aUhvJnj-Ty7BeVCpQdpoL-UCkx11hPDVjco3af6eWLef33O2wNINf2uec2USqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQv1xJCAaP91SEHOC8GULIabtRVm06yCPSkihE37Actw&oe=6B0DB5B0"}, "display_name": "No Games - Drum & Bass Music Studio", "keywords": [], "long_description": "This app was created with PatchWorld - a modular metaverse where you can build experiences like this from scratch, we intend to take over cyberspace.\n\nAbout No Games - this is our collaboration with UK rapper Harry Shotta and acclaimed producer Erb n Dub. \n\nMix and match hard-hitting drum sounds to generate the perfect DNB beat. Compose wicked and wild bass lines by moving the controllers around, adding hair-raising effects, all on top of Harry Shotta's classic jump-up style rap virtuosity.\n\nPlay solo or with up to 15 friends to have your own virtual DNB rave in VR!", "short_description": "Play incredible Drum & Bass live in multiplayer, with the sounds of UK rapper Harry Shotta and acclaimed producer Erb n Dub. \n\nMix and match hard-hitting drum sounds to generate the perfect DNB beat. Compose wicked and wild bass lines by moving the controllers around, adding hair-raising effects, all on top of Harry Shotta's classic jump-up style rap virtuosity.\n\nPlay solo or with up to 15 friends to have your own virtual DNB rave in VR!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.com/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics
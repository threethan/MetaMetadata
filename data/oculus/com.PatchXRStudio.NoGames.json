.com&_nc_ss=7f20f&oh=00_AQEqhWFW5QaddNnX62AUHiWrFOCkcFpFQWDrjsqpXgUgyA&oe=6A85AAD6"}, {"file_name": "Screenshot-2.png", "id": "486023510567067", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569468_486023513900400_145284436897299379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39Jmm1csIcgQ7kNvwFoSo6p&_nc_oc=AdqxvPkjGxZzLBBDEWVuSPHYehXj7E9vDZ-wNUBu4QMQcnLyVlcw-IROJb4_TCfg0aA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvJLQCNfM2VnUrzsi6M903kFLbW6gqfXZ-UqVHTKR1xA&oe=6A8577D6"}, {"file_name": "Screenshot-5.png", "id": "1113760806586905", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031518_1113760809920238_374040494887525675_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wyZp3AuLzkQ7kNvwGqTihA&_nc_oc=Adr7uHINoEIINwFo7-wRMRJ7HxUZJVQr_-PPSrLmg1kozuh7bzGnxaA_Xq4xOTAMilE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1YfE9xj0ENrC8sqr854KCYMdlpmxpIB2DIyvHja7fiA&oe=6A85AF45"}, {"file_name": "Screenshot-1.png", "id": "832532242169712", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031457_832532248836378_3663210356497322076_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnw0ZOHZV8AQ7kNvwEVZIF9&_nc_oc=Adpg9cLDdStevTzHc9W3JnNqJNfyF6rY3RJlBjk8_Pi3hkt6rbkAHNAHANJLWKrXB1Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqmCKZ_yEkYhErf3ugiJimypWimnDLniKt_-U3VZIV-g&oe=6A8578D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1118375069235788", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974458_1118375072569121_2864568641225082773_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijCFPfmRweMQ7kNvwFEF-yi&_nc_oc=AdrLEZgsjJZn1lXKwnoGUPIDkBNwZ2TLKx46nvmxGB7mL3lkDFOdDs6y8tLigd1KHng&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2EhDMIkFi1Am9SpCSiClgPk6hkrrdpYJmTKwJ0xj_uQ&oe=6A857AB0"}, "display_name": "No Games - Drum & Bass Music Studio", "keywords": [], "long_description": "This app was created with PatchWorld - a modular metaverse where you can build experiences like this from scratch, we intend to take over cyberspace.\n\nAbout No Games - this is our collaboration with UK rapper Harry Shotta and acclaimed producer Erb n Dub. \n\nMix and match hard-hitting drum sounds to generate the perfect DNB beat. Compose wicked and wild bass lines by moving the controllers around, adding hair-raising effects, all on top of Harry Shotta's classic jump-up style rap virtuosity.\n\nPlay solo or with up to 15 friends to have your own virtual DNB rave in VR!", "short_description": "Play incredible Drum & Bass live in multiplayer, with the sounds of UK rapper Harry Shotta and acclaimed producer Erb n Dub. \n\nMix and match hard-hitting drum sounds to generate the perfect DNB beat. Compose wicked and wild bass lines by moving the controllers around, adding hair-raising effects, all on top of Harry Shotta's classic jump-up style rap virtuosity.\n\nPlay solo or with up to 15 friends to have your own virtual DNB rave in VR!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.com/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "
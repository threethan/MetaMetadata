6023510567067", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569468_486023513900400_145284436897299379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FS5116E3T88Q7kNvwF-KR3b&_nc_oc=AdnAf7Z8XrQR7d4inH8U18p6ZQZMajemZ-1xwlMKGoiggnzMpIi5swBZnVvS6smtpms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvkrsIiJuE9PfK79rQvqayAoOTMISUmDTbpe-ThZoysvQ&oe=699DA816"}, {"file_name": "Screenshot-5.png", "id": "1113760806586905", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031518_1113760809920238_374040494887525675_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQOhVD7I5cIQ7kNvwG1HMr4&_nc_oc=AdlP5AAtU5kcIu3TrU_QmHVH3WhqXX_ar-l_maAGK7fhtCKM9wIK61ouYay-ixPnds0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3sw8G6wKE5bNyowirChD4SXEmVxoncca0rXp_qFVfmA&oe=699DA745"}, {"file_name": "Screenshot-1.png", "id": "832532242169712", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031457_832532248836378_3663210356497322076_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcdAU_hDdxMQ7kNvwEnNhec&_nc_oc=AdmXfhqm8T2Absif3jIjPPE0UejWYySIEQwYLtdIVghb6wi-CfXygB6b_4PBne2hrDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuFJpGrz1o2NYQhuBFb6K82gj9rfdLGfhilK4C54-rN9Q&oe=699DA911"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1118375069235788", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974458_1118375072569121_2864568641225082773_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1K95FzrPh8Q7kNvwGlR8xE&_nc_oc=AdlJnDST0s2zOgRYWuQJdsaXSQ-nY9nGLOYUYfQ1k1PMn7Kt1aSkW0DizvUQXLtTykw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-8s9Hc9pL8pyU_u9GtcIuZe8R5sHPyMwPUPEmZpKyXA&oe=699DAAF0"}, "display_name": "No Games - Drum & Bass Music Studio", "keywords": [], "long_description": "This app was created with PatchWorld - a modular metaverse where you can build experiences like this from scratch, we intend to take over cyberspace.\n\nAbout No Games - this is our collaboration with UK rapper Harry Shotta and acclaimed producer Erb n Dub. \n\nMix and match hard-hitting drum sounds to generate the perfect DNB beat. Compose wicked and wild bass lines by moving the controllers around, adding hair-raising effects, all on top of Harry Shotta's classic jump-up style rap virtuosity.\n\nPlay solo or with up to 15 friends to have your own virtual DNB rave in VR!", "short_description": "Play incredible Drum & Bass live in multiplayer, with the sounds of UK rapper Harry Shotta and acclaimed producer Erb n Dub. \n\nMix and match hard-hitting drum sounds to generate the perfect DNB beat. Compose wicked and wild bass lines by moving the controllers around, adding hair-raising effects, all on top of Harry Shotta's classic jump-up style rap virtuosity.\n\nPlay solo or with up to 15 friends to have your own virtual DNB rave in VR!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wiki.patchxr.com/privacy-policy-201", "developer_terms_of_service_url": "https://patchxr.com/license/", "publisher_name": "PatchXR AG", "support_website_url": null, "website_url": "https://patchxr.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26002674749379575"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982662_465574579558256_1604267806852439902_n.png?st
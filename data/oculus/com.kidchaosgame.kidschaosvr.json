B048B64"}, {"file_name": "3.png", "id": "27889006677455540", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_27889006690788872_5892385024626880050_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgQcr5BUgKYQ7kNvwFvvBo0&_nc_oc=Adp6dCnDHUDE_QyxfWAzh6q-ECU3r_ByNe2X3g8Jmv_Dmb0xZmZ36oMsj3Lyy5AzPuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQNWWzBFkmmymG62qsW7CEwP5HbrV1sYHoXA6UtnsRPg&oe=6B0469DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1520530352448427", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825415_1520530355781760_8284703000227799053_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AeT3lJqSbMQ7kNvwG7-kU6&_nc_oc=AdpL3jnJ9z_kK6DLqQxgtTQ9cTtxt0q_vD3sm1C69oJz8YUrPYjFDqeWvPORyA4AVVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMpqg-EdikqlUTUSifG-0n0Nays4I6N_6E1nwg7Iz7mw&oe=6B0459C5"}, "display_name": "Kids Chaos VR", "keywords": [], "long_description": "Kids Chaos VR is a funny VR daycare chaos game where a normal playroom turns into total mayhem.\n\nStep into a colorful daycare full of toys, kids, silly pranks, funny hats, food reactions, and one very dramatic grandma trying to keep everything under control.\n\nPlay tag with the kids, run through the daycare, use toys, unlock hats, collect coins, and create chaotic moments around the room. Throw a banana peel, spray a water gun, play with a ball, try different foods, and watch the characters react in funny ways.\n\nThe game is designed for short, energetic VR sessions with simple gameplay, bright cartoon visuals, and playful comedy.\n\nFeatures:\n- Funny VR tag gameplay\n- Colorful daycare playroom environment\n- Mischievous kids and a dramatic grandma\n- Banana pranks, water gun chaos, balls, toys, and surprises\n- Unlockable hats and player customization\n- Food items that change character face textures\n- Coins, achievements, and replayable challenges\n- Short sessions made for quick VR fun\n\nKids Chaos VR is a family-friendly comedy-style VR game designed for teens and adults who enjoy lighthearted chaos, silly interactions, and playful sandbox moments.", "short_description": "A funny VR daycare chaos game with tag, toys, pranks, hats, coins, and one very dramatic grandma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bloodhunterage.wordpress.com/kids-chaos-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Andris Games", "support_website_url": "https://bloodhunterage.wordpress.com/kids-chaos-vr-support/", "website_url": "https://bloodhunterage.wordpress.com/kids-chaos-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1023569923652438"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "952515214321230"}, {"status": "PUBLISHED", "id": "1047715981577742"}, {"status": "PUBLISHED", "id": "4430700573861590"}, {"status": "PUBLISHED", "id": "1902643227070431"}]}, "baseline_offer": {"id": "1902643227070431"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "952515214321230"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results"
t-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHncaa1uXEtoaxPIgIFZ2qSX-ili0_rLxG2L98XbQ3SHQ&oe=6A95D7E9"}, {"file_name": "5.png", "id": "2107070706688263", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827973_2107070710021596_9114578226310347654_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vhfi-vdDuXkQ7kNvwHbeMCG&_nc_oc=AdqtvQ6R1iI_5VI1cii-klt21gPibq3asNClTR6avVOnR6ynb32JGsaC5h0w-qHhln0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFf5BvWezGDjzlOSfuUW7SAGNeU_lgyn9iZn4E1BPBJQ&oe=6A95CC03"}, {"file_name": "4.png", "id": "1292100016082342", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_1292100019415675_3693858776978539303_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNZ0iePWHfwQ7kNvwFGpUOd&_nc_oc=AdoDBhFlKSYjU265CCj4wCEjYPXY0Y7YcugAglFg3D_3GFKaQFxy0F6b2BkMKfePq8U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAtx_OPNZBVkx-xFLO8egg-GF-aCpUZILFw_448IjDCQ&oe=6A95CD64"}, {"file_name": "3.png", "id": "27889006677455540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_27889006690788872_5892385024626880050_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fev6f4iIWDcQ7kNvwHbD5In&_nc_oc=AdogFl82r6x30RI5uuhlZDp4SlGoPEjOuKEFf6k0Z6x6hRZ76xP6OsbWDMsnjd8JSnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqcWWXSLjZiSvdryrDUxKBdKJouPljMdp_bnW4rWtZjw&oe=6A95E41F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1520530352448427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825415_1520530355781760_8284703000227799053_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tL_fmlR59EQ7kNvwHNZ_5C&_nc_oc=AdrX8IZSLpuiFp78HciUC2UoehlBcIe4WKXr0YWEagtKO4ZpIPVhEXZxdzKhcwakuJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqqFvETuyJq8PwROFThQ-9DGC3PO-A3tBqxP39wXITkg&oe=6A95D405"}, "display_name": "Kids Chaos VR", "keywords": [], "long_description": "Kids Chaos VR is a funny VR daycare chaos game where a normal playroom turns into total mayhem.\n\nStep into a colorful daycare full of toys, kids, silly pranks, funny hats, food reactions, and one very dramatic grandma trying to keep everything under control.\n\nPlay tag with the kids, run through the daycare, use toys, unlock hats, collect coins, and create chaotic moments around the room. Throw a banana peel, spray a water gun, play with a ball, try different foods, and watch the characters react in funny ways.\n\nThe game is designed for short, energetic VR sessions with simple gameplay, bright cartoon visuals, and playful comedy.\n\nFeatures:\n- Funny VR tag gameplay\n- Colorful daycare playroom environment\n- Mischievous kids and a dramatic grandma\n- Banana pranks, water gun chaos, balls, toys, and surprises\n- Unlockable hats and player customization\n- Food items that change character face textures\n- Coins, achievements, and replayable challenges\n- Short sessions made for quick VR fun\n\nKids Chaos VR is a family-friendly comedy-style VR game designed for teens and adults who enjoy lighthearted chaos, silly interactions, and playful sandbox moments.", "short_description": "A funny VR daycare chaos game with tag, toys, pranks, hats, coins, and one very dramatic grandma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bloodhunterage.wordpress.com/kids-chaos-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Andris Games", "support_website_url": "https://bloodhunterage.wordpress.com/kids-chaos-vr-support/", "website_url": "https://bloodhunterage.wordpress.com/kids-chaos-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
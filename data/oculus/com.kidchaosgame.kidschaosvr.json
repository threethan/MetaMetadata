n.com/v/t64.5771-25/491823746_27889006690788872_5892385024626880050_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fev6f4iIWDcQ7kNvwHbD5In&_nc_oc=AdogFl82r6x30RI5uuhlZDp4SlGoPEjOuKEFf6k0Z6x6hRZ76xP6OsbWDMsnjd8JSnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqcWWXSLjZiSvdryrDUxKBdKJouPljMdp_bnW4rWtZjw&oe=6A95E41F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560-1440.png", "id": "1520530352448427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825415_1520530355781760_8284703000227799053_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tL_fmlR59EQ7kNvwHNZ_5C&_nc_oc=AdrX8IZSLpuiFp78HciUC2UoehlBcIe4WKXr0YWEagtKO4ZpIPVhEXZxdzKhcwakuJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqqFvETuyJq8PwROFThQ-9DGC3PO-A3tBqxP39wXITkg&oe=6A95D405"}, "display_name": "Kids Chaos VR", "keywords": [], "long_description": "Kids Chaos VR is a funny VR daycare chaos game where a normal playroom turns into total mayhem.\n\nStep into a colorful daycare full of toys, kids, silly pranks, funny hats, food reactions, and one very dramatic grandma trying to keep everything under control.\n\nPlay tag with the kids, run through the daycare, use toys, unlock hats, collect coins, and create chaotic moments around the room. Throw a banana peel, spray a water gun, play with a ball, try different foods, and watch the characters react in funny ways.\n\nThe game is designed for short, energetic VR sessions with simple gameplay, bright cartoon visuals, and playful comedy.\n\nFeatures:\n- Funny VR tag gameplay\n- Colorful daycare playroom environment\n- Mischievous kids and a dramatic grandma\n- Banana pranks, water gun chaos, balls, toys, and surprises\n- Unlockable hats and player customization\n- Food items that change character face textures\n- Coins, achievements, and replayable challenges\n- Short sessions made for quick VR fun\n\nKids Chaos VR is a family-friendly comedy-style VR game designed for teens and adults who enjoy lighthearted chaos, silly interactions, and playful sandbox moments. please. I really need it. Please leave your feedback.", "short_description": "A funny VR daycare chaos game with tag, toys, pranks, hats, coins, and one very dramatic grandma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bloodhunterage.wordpress.com/kids-chaos-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Andris Games", "support_website_url": "https://bloodhunterage.wordpress.com/kids-chaos-vr-support/", "website_url": "https://bloodhunterage.wordpress.com/kids-chaos-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1031165766226187"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_1360569546003622_7897494839230245579_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FL-Wmm50tqsQ7kNvwE5qEkl&_nc_oc=AdojSqLVIsKOybDgHo4UWtBGQ8xB5peTADGB6rlh_rfGP20unY9vuigG4mpD4VK2KiY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPuA6EjORo4HLzW5Xdo7ho5rSPXULXiP74PPZR_3i5oQ&oe=6A95CDDC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kids Chaos VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GA
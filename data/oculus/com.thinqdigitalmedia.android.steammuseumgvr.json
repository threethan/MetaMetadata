UV8G7LWlwJgi9Oab74L2171YzJjQKBQQAQPtGY5SEitCX9Vsr1SCaCuWOxOkc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcymngJKDGyfLs54tYBRNhUg568VUX6qs7KJLpptFEEQ&oe=69AC260F"}, {"file_name": "migrated_image.png", "id": "620143261878205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410407_431043990683447_6598023992425054208_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCO4E7D2rUYQ7kNvwFaiUh8&_nc_oc=AdmIFL5Oa0PG_xIoYqfsi9c2emHD-zQ8Cbvq3nsv2RHx4jxIsR35SVKmkTF_mbWQwLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwP_axHufwDziVmcTNS0q_PUyOUelzWCM3CdnOAAo_hSg&oe=69AC303F"}, {"file_name": "migrated_image.png", "id": "212960879763624", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12504728_177101676251695_4757862245344477184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8wla7HrsfQQ7kNvwEj1Yvx&_nc_oc=AdlBRYzTTG7z0k2dgOaXGI4y9nqWeXkyp5tqJvdFpRCgA6--yajdd1oWzlWYIgE-oF4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzM1JlDEUOY-SaQ-0223bl41fHSN4Cc_Rk6x1q0JTZH8Q&oe=69AC236E"}, {"file_name": "migrated_image.png", "id": "194973208467587", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139031_362168807600396_4963161935496347648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ti-nGMt8ZLMQ7kNvwFqHUwm&_nc_oc=AdmCpuRSuhFATST1MoYUh8dD_EopBVUhCi7TBs2Ba4O_9xB2jEWFMW6QOUtUFE3z3yo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxs5xcJk1TPYawVnxuBoTIaISWBovpBl6SIl7DbrDpRvA&oe=69AC12A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Steam Museum", "keywords": ["London", "Museum", "Water", "Steam", "Engine"], "long_description": "London Museum of Water & Steam is an independent museum founded in 1975 as the Kew Bridge Steam Museum.\n\nSituated on the site of the old Kew Bridge Pumping Station in Brentford, near Kew Bridge on the River Thames in West London, England, the museum is centred on a collection of stationary water pumping steam engines dating from 1820 to 1910. It is the home of the world\u2019s largest collection of working Cornish engines, including the Grand Junction 90 inch, the largest such engine in the world. The site is an anchor point on the European Route of Industrial Heritage (ERIH).", "short_description": "A companion app for the London Museum of Water & Steam. This experience shows the steam machines installed at the museum and demonstrates their functioning."}]}, "developer_name": "ThinQ Digital Media Limited", "developer_privacy_policy_url": "http://www.thinqdigitalmedia.com/privacy-policy", "developer_terms_of_service_url": "http://www.thinqdigitalmedia.com/terms", "publisher_name": "ThinQ Digital Media Limited", "support_website_url": null, "website_url": "http://www.thinqdigitalmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "629497504975600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386220_613220832356359_3082686319705456640_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z147soRdDmcQ7kNvwFP5ONL&_nc_oc=AdkKQ9vI2VeGPgXOlqZBlAgTQ9Ztf9S6Ng88dot6vN-gpJtCX-2SHFjEILKegBg06-k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwvMj0enozobZGyZr8_zOiaMvMaicRfaR8jA7tg4wl7KA&oe=69AC29FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Steam Museum", "platform": "ANDROID", "context_category": null, "context_topics": [], "rel
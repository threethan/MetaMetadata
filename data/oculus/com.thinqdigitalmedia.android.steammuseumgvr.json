Bn0wNdCUolOqMoAMfmxNo-up6ydjpouWH27mJ-prQVLmoAYMqcwaKxGBCateU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftx0oxzdKndCPjFLduQuiG5txUpXp_WoXyWwo-mP9VndQ&oe=69A8318F"}, {"file_name": "migrated_image.png", "id": "620143261878205", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410407_431043990683447_6598023992425054208_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Cj7Jee8IdcQ7kNvwHDC96Q&_nc_oc=Adn1fPG5SLtYbSReUXwJB9yWVfy16tuxIbxgbRgI6sCSqp9aaEfyuO0ZdEnLCGh5DRU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvMjLPejNLVkapS9w7Zx963dZQl2_PSOrqGnB0-FGRShQ&oe=69A83BBF"}, {"file_name": "migrated_image.png", "id": "212960879763624", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504728_177101676251695_4757862245344477184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OOmP8GSZ_4Q7kNvwElc1hg&_nc_oc=AdlKzQKzXz8iS9Ct2S8kOHH-mPXPJZd6TqkitmabBFH4cQfPZtzxeIuhi72pypMxem8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftJTSL_HHZj_ePR80LFuMtnf0wLdivc1uzL7_V4TRTrbw&oe=69A82EEE"}, {"file_name": "migrated_image.png", "id": "194973208467587", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139031_362168807600396_4963161935496347648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e-TSvqF0bIQ7kNvwFZ72zy&_nc_oc=AdkmFcu0osTHplZEIl0MgGQCzbE4kxt7gUKm1fPVtvHj_lRD7Du9uVFdM-3Lyair4do&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvst-osVCn0ZgcxvYgQLYcALuUmGLlKxi0Z7cRco_-eOg&oe=69A81E27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Steam Museum", "keywords": ["London", "Museum", "Water", "Steam", "Engine"], "long_description": "London Museum of Water & Steam is an independent museum founded in 1975 as the Kew Bridge Steam Museum.\n\nSituated on the site of the old Kew Bridge Pumping Station in Brentford, near Kew Bridge on the River Thames in West London, England, the museum is centred on a collection of stationary water pumping steam engines dating from 1820 to 1910. It is the home of the world\u2019s largest collection of working Cornish engines, including the Grand Junction 90 inch, the largest such engine in the world. The site is an anchor point on the European Route of Industrial Heritage (ERIH).", "short_description": "A companion app for the London Museum of Water & Steam. This experience shows the steam machines installed at the museum and demonstrates their functioning."}]}, "developer_name": "ThinQ Digital Media Limited", "developer_privacy_policy_url": "http://www.thinqdigitalmedia.com/privacy-policy", "developer_terms_of_service_url": "http://www.thinqdigitalmedia.com/terms", "publisher_name": "ThinQ Digital Media Limited", "support_website_url": null, "website_url": "http://www.thinqdigitalmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "629497504975600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386220_613220832356359_3082686319705456640_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DjMStKfJ10Q7kNvwHlqX1K&_nc_oc=Adk2XchLdejryFUSp5d2plLAZ0cYSnMli1Qqz3DqEpT9yqD-zw-sFnV64CxTxbgceBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afurc0rKEKWEQMS5Vqneduhv8paUCg6UsHI-nsEClFBbSg&oe=69A8357F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Steam Museum", "platform": "ANDROID", "context_category": null, "context_topics": [], "rel
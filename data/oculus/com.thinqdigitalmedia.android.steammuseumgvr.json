yhtl6AXl5Uv0oLtm3PU_M_ciHft0D2Nh0nky0KAQ-FK91GIDTGOsWLKc59vqM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzzAY04Qj-6syAYJPKCCs5S0tJTRgJRMvbkjqbC4-grfw&oe=69C13E0F"}, {"file_name": "migrated_image.png", "id": "620143261878205", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410407_431043990683447_6598023992425054208_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgVsTXF8vLMQ7kNvwEh7JDU&_nc_oc=AdoYFvd91IAyGlB05pDaHw6WYcr-8bg2oxpwt0A9oOls3l_4VNsdRrA-XdiLCADXX24&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwIv8Odo6iRO1i9UPyjJzoXaMgchWh7aBOYgTxixu0igg&oe=69C1483F"}, {"file_name": "migrated_image.png", "id": "212960879763624", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12504728_177101676251695_4757862245344477184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yxV07bcXMYQ7kNvwHLglPM&_nc_oc=Adrqyi2b_EHzBWz3uG34T89dT9Nq9IM4Kbd0PcVtBsg8w2bVKrbBcES2Tqp-XvUeQMo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyV_BkIlshzMPU1prmHrcY7EN-ISRbKUUxDTAPNui-SKA&oe=69C13B6E"}, {"file_name": "migrated_image.png", "id": "194973208467587", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139031_362168807600396_4963161935496347648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxY_DlT4OZcQ7kNvwGMjjg9&_nc_oc=Adphgp6twXWuMnhgtOOG-TtMD4apvLfxheBlnZUtALBGgEZf9XKcJH1U8VDNf9PceGA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-DkNB2P3G5K2JcjFMn7z5fVqA3p0ktwKExOiPaV1lYQ&oe=69C12AA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Steam Museum", "keywords": ["London", "Museum", "Water", "Steam", "Engine"], "long_description": "London Museum of Water & Steam is an independent museum founded in 1975 as the Kew Bridge Steam Museum.\n\nSituated on the site of the old Kew Bridge Pumping Station in Brentford, near Kew Bridge on the River Thames in West London, England, the museum is centred on a collection of stationary water pumping steam engines dating from 1820 to 1910. It is the home of the world\u2019s largest collection of working Cornish engines, including the Grand Junction 90 inch, the largest such engine in the world. The site is an anchor point on the European Route of Industrial Heritage (ERIH).", "short_description": "A companion app for the London Museum of Water & Steam. This experience shows the steam machines installed at the museum and demonstrates their functioning."}]}, "developer_name": "ThinQ Digital Media Limited", "developer_privacy_policy_url": "http://www.thinqdigitalmedia.com/privacy-policy", "developer_terms_of_service_url": "http://www.thinqdigitalmedia.com/terms", "publisher_name": "ThinQ Digital Media Limited", "support_website_url": null, "website_url": "http://www.thinqdigitalmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "629497504975600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386220_613220832356359_3082686319705456640_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utPxM3QePtwQ7kNvwGI5r9f&_nc_oc=AdqjUNu3lSUdxyoNuCWUsXOcyDTBfds6wuM_858QyuD81GebgkwArtS6uWl4MGAZoxI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxpivV5vj8yqQK5hoAXpPpR8uzAm8ofK1lpYl_390ISkQ&oe=69C141FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Steam Museum", "platform": "ANDROID", "context_category": null, "context_topics": [], "rel
2x8xRzVJReaX58Uv1tXQLAhO4wQha27Jo7OXz_Ebu0usYDFdO-EZLvZBQxH_s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9tTayfCSbXLIt8ihAuNbZLwr-Zo2efiqAf7FR2W06xQ&oe=69BD498F"}, {"file_name": "migrated_image.png", "id": "620143261878205", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410407_431043990683447_6598023992425054208_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbfh9Oo9P5cQ7kNvwE1PaOn&_nc_oc=AdkEShgCOxJ6E84An8gK80xVZe7jYcASWo61L27U3PNPSSkBaekxdooVxq6cbLaWtdY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-HW-n4GGW1s7u8-sedtv07R3JKupicQAaym40V67XVw&oe=69BD53BF"}, {"file_name": "migrated_image.png", "id": "212960879763624", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12504728_177101676251695_4757862245344477184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSfrKYIsXO4Q7kNvwHNd7Km&_nc_oc=AdmBnVMMJDmyXzeysrTx8Z0U7GZpFeWiqmaQclQOGyrnTPLtt5YQbpvtSmlt8qmlnEw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxahuXM4ORv5G4U1FseyDoeDhFG5IBwH9ciCbpc2qXqEQ&oe=69BD46EE"}, {"file_name": "migrated_image.png", "id": "194973208467587", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12139031_362168807600396_4963161935496347648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmFUD6Czlm8Q7kNvwEfB9tn&_nc_oc=AdlXouXdtQLx6uiJ6SbQIUSZXtsQXhrKbucCKKsZo8-vju5ne_hquJOcSrO1xf7IISc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhDnvqozDsE1lCSJT7YzkYjBbNi7kWOa99zAKMFxJ36Q&oe=69BD3627"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Steam Museum", "keywords": ["London", "Museum", "Water", "Steam", "Engine"], "long_description": "London Museum of Water & Steam is an independent museum founded in 1975 as the Kew Bridge Steam Museum.\n\nSituated on the site of the old Kew Bridge Pumping Station in Brentford, near Kew Bridge on the River Thames in West London, England, the museum is centred on a collection of stationary water pumping steam engines dating from 1820 to 1910. It is the home of the world\u2019s largest collection of working Cornish engines, including the Grand Junction 90 inch, the largest such engine in the world. The site is an anchor point on the European Route of Industrial Heritage (ERIH).", "short_description": "A companion app for the London Museum of Water & Steam. This experience shows the steam machines installed at the museum and demonstrates their functioning."}]}, "developer_name": "ThinQ Digital Media Limited", "developer_privacy_policy_url": "http://www.thinqdigitalmedia.com/privacy-policy", "developer_terms_of_service_url": "http://www.thinqdigitalmedia.com/terms", "publisher_name": "ThinQ Digital Media Limited", "support_website_url": null, "website_url": "http://www.thinqdigitalmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "629497504975600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386220_613220832356359_3082686319705456640_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zNCkpNFBFYQ7kNvwHEbmDb&_nc_oc=AdlvLerFneu5wSGz4r1TbVw1Hq_OxttCZLFLQHIbsp7TGL0FugKNgOOcahWgAQlZ-bk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwgw59zhw65-1CCulpIrc3M_CFfnbwDyPGk-1jzc3ICKA&oe=69BD4D7F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Steam Museum", "platform": "ANDROID", "context_category": null, "context_topics": [], "rel
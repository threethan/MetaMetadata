tQrsP37YX_i33gQjNtf5kb6KtcX3MT6CHnX_P7HaZ2eVmml5p_OY31LkDG9_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-LrZjeHDRlmZNTSQp37THYaNp8-W9Gf8bmsJCfdsQLg&oe=69B2BD8F"}, {"file_name": "migrated_image.png", "id": "620143261878205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410407_431043990683447_6598023992425054208_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N58EZE1w0HAQ7kNvwGQ0pBj&_nc_oc=Adng_I2ynNBsTmsqqiHs4eUDpTgfHkDp4cNqjDnrzr9ZpLy8W24LM1ViS71tMVrx2Uw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxn7NRImQqEHgK76wFHQ9fzOOmxsLapxG16uy_KBoDMnw&oe=69B2C7BF"}, {"file_name": "migrated_image.png", "id": "212960879763624", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12504728_177101676251695_4757862245344477184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_4nBK7vj74Q7kNvwF0imqn&_nc_oc=AdkadafrCGEIB2XRawTPqe0zJ3VeQoz_ZWDNzGsXuk0Atf755YzPJkNYpN9bEtCkOSk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTJnu_A7mEXmi0FHxR7fTq9z0hynKSKXQcrkYQZGLPkQ&oe=69B2BAEE"}, {"file_name": "migrated_image.png", "id": "194973208467587", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139031_362168807600396_4963161935496347648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSYvbyouVlMQ7kNvwGfBVWW&_nc_oc=AdlFEdDrCRdxmrDQSr8r-LO3alIXOUkTVEYRO6NyRKInok8cCPxJ6pkS2QOLsCgbtkY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzonJF0wAArwCMbfNS2jmpJxvcqFkR4eUDDYWwn4fHdXg&oe=69B2AA27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Steam Museum", "keywords": ["London", "Museum", "Water", "Steam", "Engine"], "long_description": "London Museum of Water & Steam is an independent museum founded in 1975 as the Kew Bridge Steam Museum.\n\nSituated on the site of the old Kew Bridge Pumping Station in Brentford, near Kew Bridge on the River Thames in West London, England, the museum is centred on a collection of stationary water pumping steam engines dating from 1820 to 1910. It is the home of the world\u2019s largest collection of working Cornish engines, including the Grand Junction 90 inch, the largest such engine in the world. The site is an anchor point on the European Route of Industrial Heritage (ERIH).", "short_description": "A companion app for the London Museum of Water & Steam. This experience shows the steam machines installed at the museum and demonstrates their functioning."}]}, "developer_name": "ThinQ Digital Media Limited", "developer_privacy_policy_url": "http://www.thinqdigitalmedia.com/privacy-policy", "developer_terms_of_service_url": "http://www.thinqdigitalmedia.com/terms", "publisher_name": "ThinQ Digital Media Limited", "support_website_url": null, "website_url": "http://www.thinqdigitalmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "629497504975600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386220_613220832356359_3082686319705456640_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TflXFSSWAj0Q7kNvwHfr1Zs&_nc_oc=AdmvGs-fiaywcGSGlTzk8F4RgLcgmpjsX4AMRK_qKuCzOATFYld_hwizaN_u0OxIqgM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyi_0P9qAANQDE_8nJOEuM3yJb38eEZZAlWVx_EZm2_8w&oe=69B2C17F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Steam Museum", "platform": "ANDROID", "context_category": null, "context_topics": [], "rel
alCS-9lnHD4Hc-my5jM6d_6JVMG1GGelqq9sKu4LHgOZrDFBuOAYrHBoihV4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzd0GYjkAVFv6WlT15WChZloWUwmYm87wpgY9aoHa2ZgA&oe=69B16C0F"}, {"file_name": "migrated_image.png", "id": "620143261878205", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410407_431043990683447_6598023992425054208_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N58EZE1w0HAQ7kNvwE29Wei&_nc_oc=AdmGhxXYTH-UpUgk0kDMdsoP1sZuXag0uCJ-qqXLibs98luPG809160DtpXlPJSlwRw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy38KGYUJP1uWR8U2ehb-wAmHGDpM8MB5P5PjSvV2cV1A&oe=69B1763F"}, {"file_name": "migrated_image.png", "id": "212960879763624", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12504728_177101676251695_4757862245344477184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_4nBK7vj74Q7kNvwHGW9aN&_nc_oc=Adlym-pn5X2egpBXo06ZM8mUYZdxikHei55a4ZhN0w-A0UWc59WxGLGuuSv8vjEYpNg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEh5bcNawvJ3AFd_6_phiyxpLsrnwVDZKIzeIB_mJv6g&oe=69B1696E"}, {"file_name": "migrated_image.png", "id": "194973208467587", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139031_362168807600396_4963161935496347648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UavdN_mn3kYQ7kNvwG_giPD&_nc_oc=AdmDOUJZSelDeE5Ed5rXv8YRyZuEcsQW5vT7UR7gS1hHEBMU0OXH7xZD34gwd0V0xEY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDp9bcfU72M6O9FN05va2C8HCetzYbmzmsMbZgAMv1EA&oe=69B158A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Steam Museum", "keywords": ["London", "Museum", "Water", "Steam", "Engine"], "long_description": "London Museum of Water & Steam is an independent museum founded in 1975 as the Kew Bridge Steam Museum.\n\nSituated on the site of the old Kew Bridge Pumping Station in Brentford, near Kew Bridge on the River Thames in West London, England, the museum is centred on a collection of stationary water pumping steam engines dating from 1820 to 1910. It is the home of the world\u2019s largest collection of working Cornish engines, including the Grand Junction 90 inch, the largest such engine in the world. The site is an anchor point on the European Route of Industrial Heritage (ERIH).", "short_description": "A companion app for the London Museum of Water & Steam. This experience shows the steam machines installed at the museum and demonstrates their functioning."}]}, "developer_name": "ThinQ Digital Media Limited", "developer_privacy_policy_url": "http://www.thinqdigitalmedia.com/privacy-policy", "developer_terms_of_service_url": "http://www.thinqdigitalmedia.com/terms", "publisher_name": "ThinQ Digital Media Limited", "support_website_url": null, "website_url": "http://www.thinqdigitalmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "629497504975600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12386220_613220832356359_3082686319705456640_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TflXFSSWAj0Q7kNvwFJDsa3&_nc_oc=AdnO3p070_rHMgJjcDae6Zq44FKidvXThR88yFQ3YIxFwEKZeCYToK046ZTqximz1No&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKrIOV5xr70EfIP_7KHgCzc4thR2HuuL2yHGFGXUS27g&oe=69B16FFF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Steam Museum", "platform": "ANDROID", "context_category": null, "context_topics": [], "rel
he Grand Junction 90 inch, the largest such engine in the world. The site is an anchor point on the European Route of Industrial Heritage (ERIH).", "short_description": "A companion app for the London Museum of Water & Steam. This experience shows the steam machines installed at the museum and demonstrates their functioning."}]}, "developer_name": "ThinQ Digital Media Limited", "developer_privacy_policy_url": "http://www.thinqdigitalmedia.com/privacy-policy", "developer_terms_of_service_url": "http://www.thinqdigitalmedia.com/terms", "publisher_name": "ThinQ Digital Media Limited", "support_website_url": null, "website_url": "http://www.thinqdigitalmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "629497504975600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12386220_613220832356359_3082686319705456640_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brH7TtIwZhIQ7kNvwGvTMtl&_nc_oc=Admp79hj1Mo_cukBTIm1EbG1CHwgE7ZVwxEtKoDv070695ZPFhLvmy7rA1rFTWOJuas&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvaFpixZ_ufS9zasBLEGFiDmWTsRkNQ0H5tX7ybz8O6IQ&oe=699C57FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Steam Museum", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1520924400, "lastRevision": {"nodes": [{"id": "1619623754735427", "release_type": "SCHEDULED", "administr
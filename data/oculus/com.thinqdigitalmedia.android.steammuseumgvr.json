io8G4hw9TPBmg5P9_B24GxljiQi7xvmM8IRh2IoTXEh85fVKliSVeZXnkYINA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzENoPbB4lj-plvmAx7uuV0z8adrqrIQSW3OITI_Hb79g&oe=69BFEC8F"}, {"file_name": "migrated_image.png", "id": "620143261878205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410407_431043990683447_6598023992425054208_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgVsTXF8vLMQ7kNvwEtS5I3&_nc_oc=Adn5sqGRXJtEMW4nrkZFKKqMMX74dUvj1TM7h4z-R6Yb1NJzd9cir-y5N-yUi4k0k-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZt4EwpdQcLuZ9uNdVbttm0-4TMRiYOnjcixNKnbRHCQ&oe=69BFF6BF"}, {"file_name": "migrated_image.png", "id": "212960879763624", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12504728_177101676251695_4757862245344477184_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSfrKYIsXO4Q7kNvwGSe3QV&_nc_oc=AdlfRqlAoPgL4jcSgu1gE4oeJ3pKz4d8ahNEZxCx6SRgjSVQoMcKRhLW-yHxY0WCp_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzbl1rWQiwXxbrlE3TcANwBi4WtnP2EWbWaSopq18D_Dg&oe=69BFE9EE"}, {"file_name": "migrated_image.png", "id": "194973208467587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139031_362168807600396_4963161935496347648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxY_DlT4OZcQ7kNvwEQ46Ro&_nc_oc=Adl173MbznIoj81rqVxwMSpmnoKevbjY_NZq0a77eAldMWUZ4i2TSPIHquBLGyoI414&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwgi10jJVr3_PW3btwgJ4xbbw-e-vM7x6SQViPK3kSu9g&oe=69BFD927"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Steam Museum", "keywords": ["London", "Museum", "Water", "Steam", "Engine"], "long_description": "London Museum of Water & Steam is an independent museum founded in 1975 as the Kew Bridge Steam Museum.\n\nSituated on the site of the old Kew Bridge Pumping Station in Brentford, near Kew Bridge on the River Thames in West London, England, the museum is centred on a collection of stationary water pumping steam engines dating from 1820 to 1910. It is the home of the world\u2019s largest collection of working Cornish engines, including the Grand Junction 90 inch, the largest such engine in the world. The site is an anchor point on the European Route of Industrial Heritage (ERIH).", "short_description": "A companion app for the London Museum of Water & Steam. This experience shows the steam machines installed at the museum and demonstrates their functioning."}]}, "developer_name": "ThinQ Digital Media Limited", "developer_privacy_policy_url": "http://www.thinqdigitalmedia.com/privacy-policy", "developer_terms_of_service_url": "http://www.thinqdigitalmedia.com/terms", "publisher_name": "ThinQ Digital Media Limited", "support_website_url": null, "website_url": "http://www.thinqdigitalmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "629497504975600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386220_613220832356359_3082686319705456640_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utPxM3QePtwQ7kNvwFWgozY&_nc_oc=AdlGHTAVU4FKoKAnztdpYR-cMsRlRDfpT_hntyu1hxjTlgOqeAum4HkqXJ_wbA_hCn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtXpFkQgn5fXCRdZuQvLw9BkcXDM86T3RqKfftK0tdbA&oe=69BFF07F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Steam Museum", "platform": "ANDROID", "context_category": null, "context_topics": [], "rel
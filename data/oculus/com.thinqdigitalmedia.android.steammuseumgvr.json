 "migrated_image.png", "id": "783251512078336", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138782_1712490692106236_5889572834916696064_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnBnwzUS7QwQ7kNvwH83SGa&_nc_oc=AdrDvIFXX6ggN7hlHzD11Eom1tWDj5rlcE7Lbd933IAjTvxr4s_eOK1ijmVVXV1kU4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTfJCIlXWN15w1tV0pOZV4ARgzRO8ijOAaCFGDVsiFBTg&oe=6B0C5ECF"}, {"file_name": "migrated_image.png", "id": "620143261878205", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410407_431043990683447_6598023992425054208_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dv0HH1RvMXEQ7kNvwECPubN&_nc_oc=AdoWWaORjaiYLbnREVFgUdYH2WJEMXXgEAiikzLJDos3gFd8TwkBFF4mmr5TVtZ0btY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZgtqH1Fg3eB7iiz-LMd1cubO-7sBu-btnUL9WzLAXVw&oe=6B0C68FF"}, {"file_name": "migrated_image.png", "id": "212960879763624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504728_177101676251695_4757862245344477184_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJQ1MRce7YIQ7kNvwED8iF8&_nc_oc=AdoKXdsJpGs_hHeiSPt6C2Ps2HiXNtJzSVS5GUYerJYgmROonFMZLzC_NVXw9_2NUos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQY3csq10wG0QzT29JjlvALBlJ401vEDHhNGLzOFla3iA&oe=6B0C5C2E"}, {"file_name": "migrated_image.png", "id": "194973208467587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139031_362168807600396_4963161935496347648_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mR8ejWHuHsQQ7kNvwHkFyxd&_nc_oc=Adr1HGYaVzPKx3PmFiMU0zbOTM0mqL_0lOVWpYFra5x-MhEA7bhrLwKKXe_FJjbCJW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPND72tLe0vPIMRU061OzxTjrUXChgelyFGG2HV-mX4A&oe=6B0C4B67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Steam Museum", "keywords": ["London", "Museum", "Water", "Steam", "Engine"], "long_description": "London Museum of Water & Steam is an independent museum founded in 1975 as the Kew Bridge Steam Museum.\n\nSituated on the site of the old Kew Bridge Pumping Station in Brentford, near Kew Bridge on the River Thames in West London, England, the museum is centred on a collection of stationary water pumping steam engines dating from 1820 to 1910. It is the home of the world\u2019s largest collection of working Cornish engines, including the Grand Junction 90 inch, the largest such engine in the world. The site is an anchor point on the European Route of Industrial Heritage (ERIH).", "short_description": "A companion app for the London Museum of Water & Steam. This experience shows the steam machines installed at the museum and demonstrates their functioning."}]}, "developer_name": "ThinQ Digital Media Limited", "developer_privacy_policy_url": "http://www.thinqdigitalmedia.com/privacy-policy", "developer_terms_of_service_url": "http://www.thinqdigitalmedia.com/terms", "publisher_name": "ThinQ Digital Media Limited", "support_website_url": null, "website_url": "http://www.thinqdigitalmedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "629497504975600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386220_613220832356359_3082686319705456640_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QI2ImkEaSM4Q7
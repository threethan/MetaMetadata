1.png", "id": "1700990534510654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310817_1700990537843987_1857024209331261302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPNC5M9PIeoQ7kNvwHeZnpR&_nc_oc=Adr7yiDrMuoe7AK4i5qTQCkpcEwltZTwWkBKh-YnG3d6QybEnqaMxWYeJdxFoMcwuq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJo8asp6E9KD012JiMR1uFkNjLq_aGUrDsmF1XACda_wg&oe=6A983C90"}, {"file_name": "2.png", "id": "2276167933133740", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307962_2276167936467073_1964886733501638361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rX9HTRyrVGMQ7kNvwG6Jcto&_nc_oc=Adr2gAn18I1hTEpwStWZe3EKE-GV3iVp0iZKp9JdNqUb69NvkShZo6_u0EU0wsoJ16w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_yT0zha1TcMl_q-PIJ-Bc3VPRdXZrXSfaNwc5KxCkWQ&oe=6A984125"}, {"file_name": "4.png", "id": "2244809049600060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310651_2244809062933392_7458208668891606375_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdEKk0USevIQ7kNvwHR9Jdl&_nc_oc=AdrWRxjXUF01cqDZnaVdw33txteDL4ntV_9KqEZ9vhoxHMqBpy_xN58NPU_WXDQ6dFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhIQ8Fe7uWTBWZ5sDTTEsGwPYD7K73BqaZSWdibUgm_g&oe=6A98353C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bus Simulator VR \u2014 Open World Driving", "keywords": ["bus", "driving", "simulator", "city", "parking"], "long_description": "The only open world bus simulator on Meta Quest with three complete game modes \u2014 and no loading screens between any of them.\n\nBus Simulator VR puts you behind the wheel of a full-size bus in a living, breathing open world. Real traffic. Real pedestrians. Real bus physics built from the ground up for VR.\n\nTHREE MODES. ONE MASSIVE WORLD.\n\n\ud83d\ude8c Bus Parking \u2014 tight precision challenges in real urban environments. Maneuver a full-size bus through loading bays, city blocks, and narrow lots. Satisfying when you nail it.\n\n\ud83d\udee3\ufe0f City-to-City Routes \u2014 long intercity highway runs with real passenger stops. Pick up and drop off riders across a connected open world. No teleporting. No fake transitions.\n\n\ud83c\udf0d Free Roam \u2014 explore the entire open world at your own pace. No objectives, no timers. Just you, a bus, and the open road.\n\nWHY THIS VR DRIVING GAME IS DIFFERENT\n\n\u2714 Open world driving \u2014 explore freely without zone boundaries\n\u2714 Realistic bus physics designed for Meta Quest VR\n\u2714 No loading screens between zones or modes\n\u2714 Native VR controls built for Quest 2, Quest 3, and Quest 3S\n\u2714 Living world with AI traffic, pedestrians, and dynamic environments\n\nThis is the bus driving simulator Quest players have been asking for. Strap in.", "short_description": "The most complete bus simulator VR experience on Meta Quest. Drive city routes, master precision parking, and explore a massive open world \u2014 real physics, no loading screens."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1228627137006216"}, "review_messages": []}]}, "cover_square
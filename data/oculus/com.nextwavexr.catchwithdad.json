v/t64.5771-25/499311606_1098337825908747_8313719895705996689_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkovTR-uQA0Q7kNvwFo5Hoo&_nc_oc=AdpU1fZ94K88GBPQq5-N_5tqvW4pX5KK9oxSl04IkRSk1A9gTDHC2FfG_wXHmuUgi_U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8C42yMEU9gnwWk8eOCZJPDkVrOwHg2jLzWD9WmNLHew&oe=6B106663"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Catch With Dad", "keywords": [], "long_description": "**A familiar afternoon, whenever you need one.**\n\nRemember the easy rhythm of playing catch with Dad: a ball in the air, a sunny backyard, and nowhere else you need to be. Catch With Dad brings that simple childhood memory into a calm, single-player VR experience.\n\nChoose baseball or football. Catch Dad's throws, send the ball back, and play at your own pace. In Free Play, there is no score to chase. If you'd like a little goal, try the optional ten-throw game.\n\nChoose your throwing hand and customize the skin tones of your hands and Dad. Whether you're revisiting an old memory or making room for a quiet moment, it's just you, Dad, and the next throw.", "short_description": "Remember the simple joy of playing catch with Dad? Step into a sunny VR backyard to throw and catch baseballs or footballs at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stormxr.tech/privacy-policy/catch-with-dad", "developer_terms_of_service_url": null, "publisher_name": "StormXR LLC", "support_website_url": null, "website_url": "https://www.stormxr.tech/development", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memor
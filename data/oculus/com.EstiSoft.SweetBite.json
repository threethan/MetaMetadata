20f&oh=00_Af_7HfZnWmDMtyWV14QTtpYlV1QBRg3L9MOgZnY9tglfyA&oe=6A45325B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-01-06 005923.png", "id": "1290986908774365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974689_1290986912107698_5632170865368596861_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRZ0mrRLmsoQ7kNvwEhrBw9&_nc_oc=Ado8z4YL0ejSEv1RMe9HUGNdKjagNYt8h8O79UlKW8q9tgA6amoA6nhztRD7b9wP4-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_glpzHN3RnPwpyDCZSF3zE15PFhSnYaitZunYyvoEgrw&oe=6A453326"}, "display_name": "Sweet Bite", "keywords": ["Arcadeidle", "idle", "comfort", "elite", "Fun"], "long_description": "Welcome to Sweet Bite, the ultimate arcade idle game set in a mesmerizing candy world, now available in stunning VR! Embark on a sweet adventure as you explore vibrant landscapes filled with chocolate hills, caramel rivers, lollipop trees, and gumdrop mountains. Immerse yourself in a dynamic environment where every decision shapes your candy empire.\n\nIn Sweet Bite, you\u2019ll manage resources, unlock upgrades, and conquer challenges that get sweeter as you progress. From building candy factories to collecting rare treats, the game offers endless opportunities for creativity and fun. Designed for both casual players and idle game enthusiasts, Sweet Bite combines the joy of strategic gameplay with breathtaking visuals.\n\nExperience the satisfaction of watching your candy kingdom flourish while enjoying the tactile, immersive interactions that VR provides. Whether you play for a few minutes or hours, Sweet Bite promises a delightful escape into a world of sweetness. Get ready to taste victory\u2014one bite at a time!", "short_description": "Dive into the candy-filled world of Sweet Bite, an immersive arcade idle game where every level brings a new layer of sugary excitement! Explore vibrant candy landscapes, manage resources, and unlock delightful upgrades as you conquer chocolate hills, caramel rivers, and gumdrop mountains. Perfect for casual players and idle game enthusiasts, Sweet Bite offers endless fun and stunning visuals. Get ready to build your candy empire in VR like never before!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/sweet-bite", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1725996564472128"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8619029941557019"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1007675088493505"}, {"status": "PUBLISHED", "id": "1407916617502585"}, {"status": "PUBLISHED", "id": "1251878920004432"}, {"status": "PUBLISHED", "id": "1756294375299324"}, {"status": "PUBLISHED", "id": "1216829320000472"}, {"status": "PUBLISHED", "id": "1329160334972454"}, {"status": "PUBLISHED", "id": "2133155100413410"}, {"status": "PUBLISHED", "id": "2647930512057625"}]}, "baseline_offer": {"id": "1329160334972454"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779303600, "status": "PUBLISHED", "id": "1007675088493505"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename"
5/39031391_954012088314146_7608439113510813696_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuRy9Ln_9kAQ7kNvwHVkXbM&_nc_oc=AdpAjNHjVp7VqzejIu7-OdirrSCXhtleLi5LhtBowPnHN2oSorD216_vTo8F7TQj7wM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWx9fmvQht06Qqpayuxtc4BFETRU1woP5H8x3sUeetPAw&oe=6B0F1825"}, "display_name": "Ninja Legends", "keywords": ["ninja", "fighting", "combat"], "long_description": "Experience blood pumping action in immersive and beautiful VR environments. Hone your abilities with unique ninja weapons like katanas, claws and the staff and pair them with special abilities including a chain dart, shadow step and the bow. Enemy ninjas will utilize cooperative group attacks to swarm and surround you. You'll need to attack and block 360 degrees of action to survive.\n\n18 Levels\n4 Difficulty Modes\n6 Ninja Weapons\n* Swords\n* Claws\n* Staff\n* Gauntlets\n* Odachi & Wakizashi\n* Naginata\n4 Shadow Skill Abilities\n* Bow & Arrow\n* Shadow Step\n* Energy Blast\n* Chain Dart\nBoss Battles\nDaily Challenges\nUnlockable Secret Modes", "short_description": "The Most Intense Combat Experience"}]}, "developer_name": "Coinflip Studios", "developer_privacy_policy_url": "https://playcoinflip.com/privacy-policy/", "developer_terms_of_service_url": "https://playcoinflip.com/terms-and-conditions/", "publisher_name": "Coinflip Studios", "support_website_url": "https://discordapp.com/invite/camScV?utm_source=Discord+Widget&utm_medium=Connect", "website_url": "https://playcoinflip.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, 
757271666", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031443_308026813423271_8543626061340999680_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbZWr9u4iV0Q7kNvwFbve3y&_nc_oc=Adqu91tv3okSnKmxs_jrV6P3MwLBw9yt7WkSgLfpJqwzi4KAxtdWOZY_Sy6ARGNY8z4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWec6lbczjFvMRHzGBkCSdI41CI075zfwoCDlA20opog&oe=6AE5F41D"}, {"file_name": "migrated_image.png", "id": "2352556178180870", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982508_321844942069986_7603895248565043200_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjlpxtONv2MQ7kNvwEHI7zA&_nc_oc=AdonALfY5_AYjittUhgAVfJ6FnU6d_YVOlb8VyOvfwrZgffJQTVOAwQC-c4KeJ-E5N4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEek05Fhe9QYlWGSRMmCninBz9ZVqbCpFPU7F2R9XX0w&oe=6AE60F6D"}, {"file_name": "migrated_image.png", "id": "684343542373533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982561_354007435474542_5840407944847425536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydJDzARmJyAQ7kNvwGzJKBw&_nc_oc=AdrJ6l3_KUTzWzoL2oSSRYCCYaJ7ffjvKyxvsefSqeFJ4j1gjQiyq4_kcjiUrWWC6mk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObwu9u4bqSQuGkU-sHtPYAQ3aYYFle-O6mGx8newI3rg&oe=6AE5F950"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_Cover_Landscape_2560x1440.png", "id": "773359876720028", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222941_773359880053361_1774345806852026991_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRC3dw3nL7cQ7kNvwF1GMBj&_nc_oc=Adr_DNe0-UkPN0nKNcU17SjxnkgA2NQSHXV3_z6IBV4UelKj2VmSx_GxAlJEfCBe-HQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7lcfnVjml6DPcnvw-9DUdeQ83KhekbdLjJ4l9v6fGSw&oe=6AE603A8"}, "display_name": "Ninja Legends", "keywords": ["ninja", "archery", "sword", "saber", "sairento"], "long_description": "* Rise to the occasion as enemies attack from all sides. Defeat simultaneous threats like an epic ninja.\n* Get dropped into the action immediately with dead simple controls that you can learn instantly.\n* Coordinated enemies give you endless challenges to solve.\n* By design, there's no running away. There's no hiding. You must fight!\n* Archery Update: Play 6 uniquely styled archery levels with leaderboards and endless increases in difficulty\n\nExperience blood pumping action in immersive and beautiful VR environments.  Enemy ninjas will utilize cooperative group attacks to swarm and surround you. You'll need to attack and block 360 degrees of action to survive.\n\n24 Levels (Including 6 Archery Levels)\n4 Difficulty Modes\n6 Ninja Weapons\n* Swords\n* Claws\n* Staff\n* Gauntlets\n* Odachi & Wakizashi\n* Naginata\n4 Shadow Skill Abilities\n* Bow & Arrow\n* Shadow Step\n* Energy Blast\n* Chain Dart\nBoss Battles\nDaily Challenges\nUnlockable Secret Modes", "short_description": "The most INTENSE combat experience on the Quest. Fight challenging enemies that attack from all sides while you slice your way through beautiful environments. Now with 6 styles of archery!  Unlock amazing weapons and special ninjitsu abilities in your quest to retrieve the stolen Shadow Scrolls. Do you have what it takes to be a ninja legend?"}]}, "developer_name": "Coinflip Studios", "developer_privacy_policy_url": "https://www.coinflipstudios.gg/pp", "developer_terms_of_service_url": "https://www.coinflipstudios.gg/tos", "publisher_name": "Coinflip Studios", "support_website_url": "https://discordapp.com/invite/camScV?utm_source=Discord+Widget&utm_medium=Connect", "website_url": "https://www.coinflipstudios.gg/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MO
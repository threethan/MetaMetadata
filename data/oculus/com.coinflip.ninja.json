aqSMtw5R9Af8SJhODMYt4qZwhGU7N_cYhRh3Y-K2tw67WNvcgZefP7elM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUNkzNI57HzdpFUoBL2Zx8quw93NmSN7LhRP7x5f_Epfw&oe=6B105FB9"}, {"file_name": "migrated_image.png", "id": "533833757271666", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031443_308026813423271_8543626061340999680_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPcAdToV4l8Q7kNvwGZb4C7&_nc_oc=AdrgJN6UiNHsjUe3s2Dt2jBnjo_DjrxI37yJGanYopsxqqbGnVCviUcMMeoaAzUcgbY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXpyDl-uy8Dq1BBG3WhP1JSjlyH4NJXan3Xwr2J3DjyAg&oe=6B105C5D"}, {"file_name": "migrated_image.png", "id": "2352556178180870", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982508_321844942069986_7603895248565043200_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yV_LofQuIQMQ7kNvwFNwijH&_nc_oc=Adr94HPjkcTDLiLinQgidVOY2N_odPvhIFSNgCstFIyqetMKQ1df0jvZq78HUJkeeGE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUfaXvmTvYiDF9XASTwVxEAi_24361bu_X-cXSvDpNxPA&oe=6B103F6D"}, {"file_name": "migrated_image.png", "id": "684343542373533", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982561_354007435474542_5840407944847425536_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3HRlZUFN0YQ7kNvwFBVfvS&_nc_oc=AdpN1mSB2Dm1h3-Youf5z9iX9ppMjaQ3FYBPNV8dVwyPekHBgexNJgEvfC1hCe6nm84&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXsMRyFy2aaJGtXjzKfi-EgLr0m3HJ4weOJgx8qC6BOfQ&oe=6B106190"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_Cover_Landscape_2560x1440.png", "id": "773359876720028", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222941_773359880053361_1774345806852026991_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Lj8OzK2S6QQ7kNvwHS6XUP&_nc_oc=AdpJQhkrZoVNdebJBNbIZwDIgN-qi4_C2JDldY66ehyt6QVF0tmbYHJRpmOugAUDm2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIXToYY-kTQjLCSEKtm22ZUlV_Hv0XSi2KIQsYNvU2qg&oe=6B106BE8"}, "display_name": "Ninja Legends", "keywords": ["ninja", "archery", "sword", "saber", "sairento"], "long_description": "* Rise to the occasion as enemies attack from all sides. Defeat simultaneous threats like an epic ninja.\n* Get dropped into the action immediately with dead simple controls that you can learn instantly.\n* Coordinated enemies give you endless challenges to solve.\n* By design, there's no running away. There's no hiding. You must fight!\n* Archery Update: Play 6 uniquely styled archery levels with leaderboards and endless increases in difficulty\n\nExperience blood pumping action in immersive and beautiful VR environments.  Enemy ninjas will utilize cooperative group attacks to swarm and surround you. You'll need to attack and block 360 degrees of action to survive.\n\n24 Levels (Including 6 Archery Levels)\n4 Difficulty Modes\n6 Ninja Weapons\n* Swords\n* Claws\n* Staff\n* Gauntlets\n* Odachi & Wakizashi\n* Naginata\n4 Shadow Skill Abilities\n* Bow & Arrow\n* Shadow Step\n* Energy Blast\n* Chain Dart\nBoss Battles\nDaily Challenges\nUnlockable Secret Modes", "short_description": "The most INTENSE combat experience on the Quest. Fight challenging enemies that attack from all sides while you slice your way through beautiful environments. Now with 6 styles of archery!  Unlock amazing weapons and special ninjitsu abilities in your quest to retrieve the stolen Shadow Scrolls. Do you have what it takes to be a ninja legend?"}]}, "developer_name": "Coinflip Studios", "developer_privacy_policy_url": "https://www.coinflipstudios.gg/pp", "developer_terms_of_service_url": "https://www.coinflipstudios.gg/tos", "publisher_name": "Coinflip Studios", "support_website_url": "https://discordapp.com/invite/camScV?utm_source=Discord+Widget&utm_medium=Connect", "website_url": "https://www.coinflipstudios.gg/", "category": "GAMES", "comfort_rating":
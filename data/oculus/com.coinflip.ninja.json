757271666", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031443_308026813423271_8543626061340999680_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ghiNKT5TIQQ7kNvwEflTd0&_nc_oc=Adq_UddOv_qBVngLXytdgiobuiOre9Boa8_gEC2K7pW3ogyaON_VShXXeka4pgL1RcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q9Pv_ZLCRoAZvfqh8SqKHCUH2IX_OQP4fwSatTMGMIQ&oe=6A354B1D"}, {"file_name": "migrated_image.png", "id": "2352556178180870", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982508_321844942069986_7603895248565043200_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEHSAbj2jNkQ7kNvwHuy8wm&_nc_oc=AdofypOBlhU9iDe5G-HlChbGEk5oZCLbHq09xeE8omuAfC7T08IfjwXL84ZlJT10mdk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jJoGE4dVgTbD8PFMQkG04nGyj69HXAOFHor_JdKYbxA&oe=6A35666D"}, {"file_name": "migrated_image.png", "id": "684343542373533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982561_354007435474542_5840407944847425536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LT7Q_sde3skQ7kNvwHw5FBj&_nc_oc=Adqb_l6YQhO5kedtc9c5O4HvTUY7dLrLv9FjzpNQh5TUdqd-yoJpCCCq8vpcAiIvA0g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JFwx4bej9THKvIoUaYm0I6U3JRcJwnSByu06RMpVNgA&oe=6A355050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_Cover_Landscape_2560x1440.png", "id": "773359876720028", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75222941_773359880053361_1774345806852026991_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSzyKptR8ugQ7kNvwGZZUX7&_nc_oc=AdqioZUhuH0Ul4ogWW6JJ3gjBH4GeOB_n_1a5HKczS8_CWtxQaaZ3gLkyLZCw4cylrg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HU8Njv7bRwm-z_pNiKDCDtLNsv1e0BYWJCvQXeOzwhw&oe=6A355AA8"}, "display_name": "Ninja Legends", "keywords": ["ninja", "archery", "sword", "saber", "sairento"], "long_description": "* Rise to the occasion as enemies attack from all sides. Defeat simultaneous threats like an epic ninja.\n* Get dropped into the action immediately with dead simple controls that you can learn instantly.\n* Coordinated enemies give you endless challenges to solve.\n* By design, there's no running away. There's no hiding. You must fight!\n* Archery Update: Play 6 uniquely styled archery levels with leaderboards and endless increases in difficulty\n\nExperience blood pumping action in immersive and beautiful VR environments.  Enemy ninjas will utilize cooperative group attacks to swarm and surround you. You'll need to attack and block 360 degrees of action to survive.\n\n24 Levels (Including 6 Archery Levels)\n4 Difficulty Modes\n6 Ninja Weapons\n* Swords\n* Claws\n* Staff\n* Gauntlets\n* Odachi & Wakizashi\n* Naginata\n4 Shadow Skill Abilities\n* Bow & Arrow\n* Shadow Step\n* Energy Blast\n* Chain Dart\nBoss Battles\nDaily Challenges\nUnlockable Secret Modes", "short_description": "The most INTENSE combat experience on the Quest. Fight challenging enemies that attack from all sides while you slice your way through beautiful environments. Now with 6 styles of archery!  Unlock amazing weapons and special ninjitsu abilities in your quest to retrieve the stolen Shadow Scrolls. Do you have what it takes to be a ninja legend?"}]}, "developer_name": "Coinflip Studios", "developer_privacy_policy_url": "https://www.coinflipstudios.gg/pp", "developer_terms_of_service_url": "https://www.coinflipstudios.gg/tos", "publisher_name": "Coinflip Studios", "support_website_url": "https://discordapp.com/invite/camScV?utm_source=Discord+Widget&utm_medium=Connect", "website_url": "https://www.coinflipstudios.gg/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MO
757271666", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031443_308026813423271_8543626061340999680_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ar7qow6SWmAQ7kNvwFaz9UW&_nc_oc=AdoA7sIQQhQvRh7WyFhDH214xhbWmB4n7SMKWr3pGfV7UQdn-dtyogles1EFS_tCxSQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5keQANydFoKnN-eovQoMt_AI47W3ORsoqSgkV3c1y0A&oe=6A4E579D"}, {"file_name": "migrated_image.png", "id": "2352556178180870", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982508_321844942069986_7603895248565043200_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZP4ld0S6fAQ7kNvwGppym6&_nc_oc=AdrrCPNRFspsNN2xDWsMnDlYXXPK7oF05l_7AF3KbB0VvcAUKzK7TQHMRRgvubrY2OY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfrfPswwYLtGRZlugH0QAHaTPq6akPlshnRhLoJgIYDg&oe=6A4E3AAD"}, {"file_name": "migrated_image.png", "id": "684343542373533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982561_354007435474542_5840407944847425536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQqLzmZtAo4Q7kNvwEEwnlx&_nc_oc=AdowaUTJOMokWFDRfelan5rMwCrYKGe5LJLVSKlfJIK3QNoxHco00Dx9akAYTJzozpA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6xYGysg3iQTTSNOERqGmiHX1s6bhW4qKprRKaWzYPcg&oe=6A4E5CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_Cover_Landscape_2560x1440.png", "id": "773359876720028", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75222941_773359880053361_1774345806852026991_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aZmw-OW24QQ7kNvwFGin7v&_nc_oc=Adpb4bTwNkmcmoeW4i8ZeWC5l7ywjOwx8GqEdN2PSsSHmLg4CGxKilWI8xSU8Re7w3s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYCWiaHyTTcG5rMlSlEfOchgm1MBQxCQ6_mR2dc8WjvA&oe=6A4E6728"}, "display_name": "Ninja Legends", "keywords": ["ninja", "archery", "sword", "saber", "sairento"], "long_description": "* Rise to the occasion as enemies attack from all sides. Defeat simultaneous threats like an epic ninja.\n* Get dropped into the action immediately with dead simple controls that you can learn instantly.\n* Coordinated enemies give you endless challenges to solve.\n* By design, there's no running away. There's no hiding. You must fight!\n* Archery Update: Play 6 uniquely styled archery levels with leaderboards and endless increases in difficulty\n\nExperience blood pumping action in immersive and beautiful VR environments.  Enemy ninjas will utilize cooperative group attacks to swarm and surround you. You'll need to attack and block 360 degrees of action to survive.\n\n24 Levels (Including 6 Archery Levels)\n4 Difficulty Modes\n6 Ninja Weapons\n* Swords\n* Claws\n* Staff\n* Gauntlets\n* Odachi & Wakizashi\n* Naginata\n4 Shadow Skill Abilities\n* Bow & Arrow\n* Shadow Step\n* Energy Blast\n* Chain Dart\nBoss Battles\nDaily Challenges\nUnlockable Secret Modes", "short_description": "The most INTENSE combat experience on the Quest. Fight challenging enemies that attack from all sides while you slice your way through beautiful environments. Now with 6 styles of archery!  Unlock amazing weapons and special ninjitsu abilities in your quest to retrieve the stolen Shadow Scrolls. Do you have what it takes to be a ninja legend?"}]}, "developer_name": "Coinflip Studios", "developer_privacy_policy_url": "https://www.coinflipstudios.gg/pp", "developer_terms_of_service_url": "https://www.coinflipstudios.gg/tos", "publisher_name": "Coinflip Studios", "support_website_url": "https://discordapp.com/invite/camScV?utm_source=Discord+Widget&utm_medium=Connect", "website_url": "https://www.coinflipstudios.gg/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MO
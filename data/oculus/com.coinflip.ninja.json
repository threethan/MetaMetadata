id": "533833757271666", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031443_308026813423271_8543626061340999680_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVFknRoQogMQ7kNvwFC5OI_&_nc_oc=AdrEPOe79upxvCvuv1Noz_4qXGBpAdd-M0BYab55dg6xz7lF5HyfK7K7gg0d-hOkSe0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk2l2UoPC8_EppUN3kYa1tWvFSsSMi4UZLWGN62EWWUA&oe=6A857E5D"}, {"file_name": "migrated_image.png", "id": "2352556178180870", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982508_321844942069986_7603895248565043200_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSom7T32CZkQ7kNvwH625CT&_nc_oc=Adq3TbYb22Y08n5665QAhDXxYaSV40iYvW8r2QwwL0pxIuPoUHH89HvypUtw51KphMI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFC1NBEEsJ_3wOihywM5o6qXUyIbHv-3KELX3clp-_U9Q&oe=6A8599AD"}, {"file_name": "migrated_image.png", "id": "684343542373533", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982561_354007435474542_5840407944847425536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YtWcxdzlvAQ7kNvwEr7Y11&_nc_oc=AdqM9rNmoYGcFYgIlIR9WBmrMp2Qd-6O5Jhj7jAbOUKz2XJfuMfXu0BVkHcAIMYj6jc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESR5Ki1QxouV4O2kgZKGZ79YsIoud6Q0uep_OdHT53Yw&oe=6A858390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_Cover_Landscape_2560x1440.png", "id": "773359876720028", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75222941_773359880053361_1774345806852026991_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWAlI7IqK3MQ7kNvwE4XoiE&_nc_oc=Adrv0MBpPjjw5A9iOWq7hFLkD2RcEsblySPMszDL108T72H7S5UtqjC-uqK-vXRq_nU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzV-0tpisT8fGcqTfxo-syi5peL6euTOA4XANQ3kCRnA&oe=6A858DE8"}, "display_name": "Ninja Legends", "keywords": ["ninja", "archery", "sword", "saber", "sairento"], "long_description": "* Rise to the occasion as enemies attack from all sides. Defeat simultaneous threats like an epic ninja.\n* Get dropped into the action immediately with dead simple controls that you can learn instantly.\n* Coordinated enemies give you endless challenges to solve.\n* By design, there's no running away. There's no hiding. You must fight!\n* Archery Update: Play 6 uniquely styled archery levels with leaderboards and endless increases in difficulty\n\nExperience blood pumping action in immersive and beautiful VR environments.  Enemy ninjas will utilize cooperative group attacks to swarm and surround you. You'll need to attack and block 360 degrees of action to survive.\n\n24 Levels (Including 6 Archery Levels)\n4 Difficulty Modes\n6 Ninja Weapons\n* Swords\n* Claws\n* Staff\n* Gauntlets\n* Odachi & Wakizashi\n* Naginata\n4 Shadow Skill Abilities\n* Bow & Arrow\n* Shadow Step\n* Energy Blast\n* Chain Dart\nBoss Battles\nDaily Challenges\nUnlockable Secret Modes", "short_description": "The most INTENSE combat experience on the Quest. Fight challenging enemies that attack from all sides while you slice your way through beautiful environments. Now with 6 styles of archery!  Unlock amazing weapons and special ninjitsu abilities in your quest to retrieve the stolen Shadow Scrolls. Do you have what it takes to be a ninja legend?"}]}, "developer_name": "Coinflip Studios", "developer_privacy_policy_url": "https://www.coinflipstudios.gg/pp", "developer_terms_of_service_url": "https://www.coinflipstudios.gg/tos", "publisher_name": "Coinflip Studios", "support_website_url": "https://discordapp.com/invite/camScV?utm_source=Discord+Widget&utm_medium=Connect", "website_url": "https://www.coinflipstudios.gg/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED"
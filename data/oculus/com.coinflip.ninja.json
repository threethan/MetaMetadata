s of action to survive.\n\n18 Levels\n4 Difficulty Modes\n6 Ninja Weapons\n* Swords\n* Claws\n* Staff\n* Gauntlets\n* Odachi & Wakizashi\n* Naginata\n4 Shadow Skill Abilities\n* Bow & Arrow\n* Shadow Step\n* Energy Blast\n* Chain Dart\nBoss Battles\nDaily Challenges\nUnlockable Secret Modes", "short_description": "The Most Intense Combat Experience"}]}, "developer_name": "Coinflip Studios", "developer_privacy_policy_url": "https://playcoinflip.com/privacy-policy/", "developer_terms_of_service_url": "https://playcoinflip.com/terms-and-conditions/", "publisher_name": "Coinflip Studios", "support_website_url": "https://discordapp.com/invite/camScV?utm_source=Discord+Widget&utm_medium=Connect", "website_url": "https://playcoinflip.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "430354028835548"}}]}, "scheduled_offers": {"count": 29, "nodes": [{"status": "PUBLISHED", "id": "835060489054550"}, {"status": "PUBLISHED", "id": "1839945566918776"}, {"status": "PUBLISHED", "id": "736593489218908"}, {"status": "PUBLISHED", "id": "3994075250847706"}, {"status": "PUBLISHED", "id": "1622168955097939"}, {"status": "PUBLISHED", "id": "648035160890568"}, {"status": "PUBLISHED", "id": "910966827802212"}, {"status": "PUBLISHED", "id": "896965571997441"}, {"status": "PUBLISHED", "id": "844001247159987"}, {"status": "PUBLISHED", "id": 
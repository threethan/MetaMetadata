40999680_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQsEgFWaCQQQ7kNvwHL1Nu9&_nc_oc=Adnd7JSlWDWV3F6RqtxSBYnUd5BI4mPk-Ivc9qTEp2zHjwPomA8GyOsBuQ1yA3gbYMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftOBmJzDl1OckAWqdXVHrZWBazRlQX8PdYMAMeXng5nBw&oe=69A6E91D"}, {"file_name": "migrated_image.png", "id": "2352556178180870", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982508_321844942069986_7603895248565043200_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1Y6OxiZOCQQ7kNvwFUfiXP&_nc_oc=AdkSDciWMNgMSCHYx7LqoFALLSOV6wctUGrCyKbPjHhxt8irjtmlWktmkdQta0ezSw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsu5LJt1Jm7oFV0f440U3XZNgpVlbiX5ZrQ3jB80vkRkg&oe=69A6CC2D"}, {"file_name": "migrated_image.png", "id": "684343542373533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982561_354007435474542_5840407944847425536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-8OPbxL2r4Q7kNvwFBbXL7&_nc_oc=Adm20g3TDE-JCTvFQFeIio56b_Gl1hTNJZE8hM2nBmu5Jru6jSmIY4Ayvgu71adrxf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftaXf9Sstgovbd4Yv3nFzOSKZJlLd70DWh6mc6RBSCCNA&oe=69A6EE50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_Cover_Landscape_2560x1440.png", "id": "773359876720028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222941_773359880053361_1774345806852026991_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fN7AVS-Pi-UQ7kNvwFBd0rw&_nc_oc=Adn48_4vgOclIJuVv5CoBhFVtvORO-QOz7Rw_oUx1xAsmlRohnhaxmppkvESjKW2wHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afux00dBbTE_t1HeM_qOLoR4j0nk5HWP6tDveyyIhSDvxg&oe=69A6C068"}, "display_name": "Ninja Legends", "keywords": ["ninja", "archery", "sword", "saber", "sairento"], "long_description": "* Rise to the occasion as enemies attack from all sides. Defeat simultaneous threats like an epic ninja.\n* Get dropped into the action immediately with dead simple controls that you can learn instantly.\n* Coordinated enemies give you endless challenges to solve.\n* By design, there's no running away. There's no hiding. You must fight!\n* Archery Update: Play 6 uniquely styled archery levels with leaderboards and endless increases in difficulty\n\nExperience blood pumping action in immersive and beautiful VR environments.  Enemy ninjas will utilize cooperative group attacks to swarm and surround you. You'll need to attack and block 360 degrees of action to survive.\n\n24 Levels (Including 6 Archery Levels)\n4 Difficulty Modes\n6 Ninja Weapons\n* Swords\n* Claws\n* Staff\n* Gauntlets\n* Odachi & Wakizashi\n* Naginata\n4 Shadow Skill Abilities\n* Bow & Arrow\n* Shadow Step\n* Energy Blast\n* Chain Dart\nBoss Battles\nDaily Challenges\nUnlockable Secret Modes", "short_description": "The most INTENSE combat experience on the Quest. Fight challenging enemies that attack from all sides while you slice your way through beautiful environments. Now with 6 styles of archery!  Unlock amazing weapons and special ninjitsu abilities in your quest to retrieve the stolen Shadow Scrolls. Do you have what it takes to be a ninja legend?"}]}, "developer_name": "Coinflip Studios", "developer_privacy_policy_url": "https://www.coinflipstudios.gg/pp", "developer_terms_of_service_url": "https://www.coinflipstudios.gg/tos", "publisher_name": "Coinflip Studios", "support_website_url": "https://discordapp.com/invite/camScV?utm_source=Discord+Widget&utm_medium=Connect", "website_url": "https://www.coinflipstudios.gg/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
15N0J-B4Tq8xcOJegz2_CYxz38E_O4-oySmw&oe=6B0C63DC"}, {"file_name": "01-discover-ar.png", "id": "1657770585828940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1657770592495606_1571222690349496808_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQwcQMZ3uQYQ7kNvwFgZ8vM&_nc_oc=AdpAYKv4-7u6N0mo1dqU021sPYcCR_0zUOX4ZCOAT1fjhMNaMyW5rQhVKzot0w6zU88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSoH2XyATX2BuFgMUra6mQAmS6QcJoBUdU7TYs7z74T5A&oe=6B0C687D"}, {"file_name": "03-layers-ar.png", "id": "4322446854566875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827585_4322446861233541_6586201847991209184_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thSA7e_qYqoQ7kNvwEg_VnP&_nc_oc=AdrU0v5Z-zBLIv5xMv2-dmwMNE-QbDjgz0_5BqtlifoNO2_tv2Gqdn9K1YczTKOtjIA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTg1-uICNEILBl2HO11Maf9qYX78aFN8gq3I9mU5NO-XA&oe=6B0C73E5"}, {"file_name": "05-volume-en.png", "id": "29223255900642499", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_29223255920642497_271107877268252407_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsUMLB4azlMQ7kNvwGm5DYH&_nc_oc=AdokaPcIxtm-pr126qv3PBSKvfrQN1_rl69u1EtxNNigpM3FL_1Fhr-sU6M9MAEdL3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTa56f3P--8u4BYY4OMio_gGxj8G1_EjDVlYhPwC7Azg&oe=6B0C7C47"}, {"file_name": "06-anas-controls-ar.png", "id": "1485442113458670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1485442123458669_4642390027951355017_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ebO3TGWXn0Q7kNvwEoF1RZ&_nc_oc=Ado9Y23PzqdZT7N1hBq8eQH_VBg25G-Tc3bj3PqJzk9EUpopc5opIkjk-Hi9PTSQa70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQeTbp5W1lFCHLYqIrtkk69yCOWxrJF4SS1LTSJPb_1Mw&oe=6B0C679E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mujassam - Immersive Geometry", "keywords": [], "long_description": "Mujassam turns geometry lessons into an immersive, interactive learning experience. Designed by a teacher, it follows a structured path from exploration to explanation and practice.\n\nDISCOVER: Distinguish flat shapes from three-dimensional solids and examine cubes and cuboids.\nEXPLORE: Investigate faces, edges, vertices and dimensions through hands-on manipulation.\nREASON: Build volume with unit cubes and layers, connect length, width and height to volume, and distinguish area from volume.\nPRACTISE: Choose answers, explain your reasoning, use hints and receive feedback through progressive activities adapted to Grades 5 and 7.\n\nSwitch between Arabic and English. Arabic narration by Anas includes replay, pause and mute controls. Touch controllers let learners interact with objects and lesson panels at their own pace.\n\nDesigned to support teacher-led lessons and individual practice. Session progress is saved locally on the headset using a numeric learner code. No account, online multiplayer, advertising or in-app purchases. The app supports teaching and practice; it does not replace the teacher or a formal assessment.", "short_description": "Step inside a geometry lesson. Explore shapes and solids, investigate cubes and cuboids, build volume from unit cubes and layers, and explain your answers through structured activities for Grades 5 and 7. Includes Arabic and English interfaces and Anas Arabic narration."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ZuhdiZahdeh/mujassam-support/blob/main/PRIVACY.md#privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ibrahimieh College - Zuhdi Zahdeh", "support_website_url": "https://github.com/ZuhdiZahdeh/mujassam-support/blob/main/SUPPORT.md", "website_url": "https://github.com/ZuhdiZahdeh/mujassam-support", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "c
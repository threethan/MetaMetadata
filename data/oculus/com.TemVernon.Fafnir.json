ildren of Fafnir", "keywords": [], "long_description": "Children of Fafnir is a wholesome puzzle platformer where you must rescue a bunch of tiny dragons. Solve simple but satisfying puzzles by manipulating physics objects and controlling tiny dragons over a collection of fractured floating islands. Enjoy nice scenery, solve puzzles, save adorable dragons and experience a mysterious ending.\n\nThis is an early access demo version containing 7 levels, representing the first area of the game and accounting for roughly 45 minutes to 1 hour of gameplay.\n\nThe game is under active development and feedback is very welcome!", "short_description": "Children of Fafnir is a wholesome puzzle platformer where you must rescue a bunch of tiny dragons. Solve simple but satisfying puzzles by manipulating physics objects and controlling tiny dragons over a collection of fractured floating islands. Enjoy nice scenery, solve puzzles, save adorable dragons and experience a mysterious ending."}]}, "developer_name": null, "developer_privacy_policy_url": "https://children-of-fafnir.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Vernon", "support_website_url": null, "website_url": "https://children-of-fafnir.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "482405576566238"}, "review_messages": []}]}, "cover_square_image": {"uri"
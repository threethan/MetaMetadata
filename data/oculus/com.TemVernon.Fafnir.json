m/v/t64.5771-25/38974453_2827920283998257_6027237510039223770_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoZ_M5Zb_B8Q7kNvwF1lAJY&_nc_oc=Adpm1FKkRPPFhcby_YWWSIQmFfGe8yvYQj3hIjAvcwcci-nRh5rsxbZ8R0K3moIkVzw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9DSaHo6qB6EAWznchjbhMe3nOLbkEcdp7xt4D8mPwwQ&oe=6B05D10F"}, "display_name": "Children of Fafnir", "keywords": [], "long_description": "Children of Fafnir is a wholesome puzzle platformer where you must rescue a bunch of tiny dragons. Solve simple but satisfying puzzles by manipulating physics objects and controlling tiny dragons over a collection of fractured floating islands. Enjoy nice scenery, solve puzzles, save adorable dragons and experience a mysterious ending.\n\nThis is an early access demo version containing 7 levels, representing the first area of the game and accounting for roughly 45 minutes to 1 hour of gameplay.\n\nThe game is under active development and feedback is very welcome!", "short_description": "Children of Fafnir is a wholesome puzzle platformer where you must rescue a bunch of tiny dragons. Solve simple but satisfying puzzles by manipulating physics objects and controlling tiny dragons over a collection of fractured floating islands. Enjoy nice scenery, solve puzzles, save adorable dragons and experience a mysterious ending."}]}, "developer_name": null, "developer_privacy_policy_url": "https://children-of-fafnir.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom Vernon", "support_website_url": null, "website_url": "https://children-of-fafnir.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT",
hAQ7kNvwFG6l01&_nc_oc=AdpVQEIzG7S23OmW4b-g4CsklANvx9SgyR4wLcbm8xV_IeILG4vusi5QYDAgzijHANg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3nT02ejS8pvA42G9F79WwDZ0ncaKMdYsR4HM9fiMysw&oe=69D0EEAC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTR9JHkaoWEQ7kNvwHv3iSr&_nc_oc=Ado4XVzAKSYb5x-hslLXyeyE8pRf7iQOLC7qYHOFQwHp4W-ySx3-C865P6i37wWL1dA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-m6r6qNlzOGeqiGkJCyUKbkV6wQP1t_5jnrovDNaDDA&oe=69D0EEAA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfJJAZ74gjoQ7kNvwGJ0ku9&_nc_oc=AdpOjDWEypGuCXh17ynVQ-ChW9C7vuu1ijz1H4gixpv_Rmwo9Z8Sc_TJv4UkOkm9omE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKy3DUwe9HXWfKBZ6AcYSndfIcmWX-szf8qMD48HAqBg&oe=69D11CBA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjAiz7tA-ccQ7kNvwEFZQFR&_nc_oc=Adq-YZyqdDVROhNxGGJxmgHrmdejnSpxZWOYOu8V_8jAPq6AhM20zsB4j3HgF__yypY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLEgErynUOlsosLRwnPunjXf51xuIxTaA2n7c35e7TlQ&oe=69D10352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZIMj0DFhEsQ7kNvwHFF6-D&_nc_oc=AdrU41xt4BawjjSbD0z0qmQdwH-4dH__iH0yGlQtjb7N4T6ti1KW1PkPqzecTB8JKx4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5k3-XH_0l6_OQ7GrvJT2vXIF3jQQCEoL2Q9DVGoSOxg&oe=69D100EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
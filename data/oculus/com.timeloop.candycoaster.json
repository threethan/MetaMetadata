38Q7kNvwGlwGbg&_nc_oc=AdovJiuYKzOpteH7NrlCdcFDPuQuFc3R69fo30ciu2jMlAH3d8k2bofjO4bCmpvne-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzPJg0ut5G4rchVJzTN3z_i1XDQgorz2QEpSvP6LSM7g&oe=6A9ED0EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-E0LxmbnKAQ7kNvwHUtmqA&_nc_oc=AdrmnPqOKJcVyMXvNy1g6CROF9ffKFBQeiPXcDmELIQ-5HV0ahw6arLEImne1YN2PV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqtYjG3LrOynjOiOO6u3afQQf5cqUe06aMg1tbxk9r2A&oe=6A9ED0EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC_iIG4PQHgQ7kNvwFxDELP&_nc_oc=AdrQzfU2FEVlUcV4BUBTSIJIoTEUSOU7x3NhERxAqP8KiEHf7l9mrqjU-ARrLL81USU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPzgSpK3v2_exZajNej0tKw_qqlNLPfaTvGI6B3aNUJw&oe=6A9EC6BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hat09EywRWAQ7kNvwE8V2It&_nc_oc=Adp7gflTRPPi2ZMalAEDjCyEk0RuLFogwB4twNC0Bj8Ty69Wf_WzMsbxPAD0EXGLoiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-KCytIzgCIVna713lRZr1_QZx1-Ou3ldmHCsjlxG5mA&oe=6A9EAD52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G74z11uGsIQ7kNvwFvgrPg&_nc_oc=AdpjXmXB3jPpQz8ED_AJOtIYu3hY_c0RqtUHA-Q0zTpsVotEmpKGrkvQZGKtL7KF1-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQrrv7wSO1H6tDRMVyIA33lBUKB_51vxRi6Xz7hT1rqQ&oe=6A9EAAEF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
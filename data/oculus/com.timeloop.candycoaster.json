ikQ7kNvwGdy5RA&_nc_oc=AdrP9RO7LU51dUPvlifiJ5TjtEoqwX5OmsMsmpeNi2zgk1We77VF_5HbFUVAzqxOvjQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7nyHQrqK7TvAFmfnAuCGRvUn7Ec3L1kcvLQdnWbfWHw&oe=6A34076C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2FAfnj0JRwQ7kNvwGDmuG0&_nc_oc=AdoksKf7UhgnG5iZUduZyRAKjx2TU4SlpkqJL5nGFNZyySOLdzKzwPByppbxUE0rbUg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1mowXQ23tAuAhHvvw1Hz5BGElWC_HM-bP6ERclCHz2g&oe=6A34076A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Kt-iwBVW-kQ7kNvwEJxdqO&_nc_oc=AdqUdEHkqH2FstaXEWUfwU3dIDrwE8ZEh_nmvR0YiKpNbKbIw6CwHk-PkX83b_U0s1E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hpzelw9q2p-PdWk7vJiqmhwvftvXfM7d5ApZSM1ifJg&oe=6A33FD3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDJakMGMSwcQ7kNvwEij_Xg&_nc_oc=AdpxB7BK0N-4ie9vmxOll6BnpUcU8nmrFhlXZmvlq-I80oXUyx0P-Wl5NZvb1VKH4WM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BqjGEYC-W8uMREHGl99l6QiVqfHmhim-XCei96mFKpw&oe=6A341C12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1zS9jcSNRYQ7kNvwERyzMV&_nc_oc=Adp3YjuGaL3zDy77dgnPe2JPWoLZkEJPOjbpCgrUIss9JS3ki0p58PXN1SAHdRFkBXs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yHHSTmQdXEy9Lg9bUYtRGq4QmeeMIgEjcAPmHMG208Q&oe=6A3419AF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
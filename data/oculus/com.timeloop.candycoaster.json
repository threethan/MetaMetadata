mEQ7kNvwGuTQtx&_nc_oc=Adr_FBsu-zYkmmP6z5_8nPGY0Tv4Z0KYlCITzT0Kh-KguHvMIimn4hfp7s4leCA7Scs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxV1SU38D7Va4V8c880DClSVQdacMOI2-xnW-vfqfM96w&oe=69CBA8AC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1_OFCRHkDsQ7kNvwFZIKvU&_nc_oc=Adobj70hEddKYQgKZ1p0a6kSXtdrt2evg50LP4D_FpFrhPDz1fdgn2aRDhdWvhlzc6o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPz3u6RhOnTrTDa7GxWF-LLNnyNZZZlSmGF4GkBxRJ5A&oe=69CBA8AA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-_fC9CqcAMQ7kNvwFtH-Ko&_nc_oc=Adq3nnbTFf4mvbwn9IjtCUHsY0A2iIUbwqpJSmzH-YWj0J32gqv58vvTokY1-dozCZ4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxehhC9Aj4ddxNMYpVmWWOYIFNs_irVOgIZDd6ZrLno4A&oe=69CBD6BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pAkKmmIT9IQ7kNvwG-mHST&_nc_oc=Adql-hzOBqIDICq3_8oZ_mamZoRJH35zpa89kIhx49gOPaY_UREYaeJIfKU11eO8aTw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEHEiOBgQeIIsx2h2sxG4P2ugWQ8VAPXIsUU-thUddGA&oe=69CBBD52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hRDbd3lbyMQ7kNvwGhRN3t&_nc_oc=Adpwq6VbvBzF8FTWr_g5i_v0rrwfYutP25qA9ET0jjBv2h-TI-CpGV4CVAK0F0CXia0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxpj-He3dHkTTLzEAhAMtX9hWDU-VGbYu8jyeRKuYAGdg&oe=69CBBAEF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
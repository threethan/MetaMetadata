ikQ7kNvwHMzssW&_nc_oc=AdoVtsjJJei5JqrJWrGXA9uiE4ou6a18AYBDvJsYCihzKEkNb3YbggDhkoOnaoDC57U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e-fhfc5SPBD2ZK3SXncvlEmOt6uGFyURpsxkfNmrQwA&oe=6A3558EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pp3_WFKsS8kQ7kNvwFgNNQ8&_nc_oc=Adq1AjdcTiiFuAWs50aGe7Yavqd5PenVy_MDdTlRz59D0qFyG0hjSlieh59XwUAIAQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ggbL12PvuBURJgIx35p64JkjxazKmAVVDvkakZ1xjFA&oe=6A3558EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Kt-iwBVW-kQ7kNvwGRbcd0&_nc_oc=Ado10aoE9wlyfV4s_FZUEVRbDCsYvoc5D98g5z419OFKRACXgQzN3dBS8shy7wk_1u0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uup2rbohlE_yW-e2Ifl3Xd7LbddDruX87Pyh0vgg6Qw&oe=6A354EBA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfafeNjkyJAQ7kNvwF9NhD-&_nc_oc=AdoCUOh0EYVA3G9FMqcFInszMdFpsOTAUZCKC2V_yx9jIMgFZW3HYp30Pqh3H1z4Jqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mFan5bLNo9kVqBUMoj_uJpN00lo9MPMzZ8G9srkE1DA&oe=6A356D92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1zS9jcSNRYQ7kNvwFh_7PV&_nc_oc=AdoNGVkwBdEXqHitj8WNwuV-XMKrvin7Bjm0oEkR-u539URcqRdQvQbd_bDBqcntFio&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NhbXLEEwlUoV78rTH4akH_3XKw-2cdzVma6El0oMlDg&oe=6A356B2F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
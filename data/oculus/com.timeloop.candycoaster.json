jWMxxXwQ7kNvwFHmEgw&_nc_oc=AdpoLBrWr6LZrPmvLCvXP5J8rYJnJZZuTeRAQzpYwaAyjvo45yErcJpqdDrFn2Fpq7g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81-Mo0og8pF538fH_0nemQDx2bybq7moe37J47gbXfEw&oe=6A394D6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xq-DlflAkaAQ7kNvwGpd-rA&_nc_oc=AdpHMf8RnlDB3h7o-eXUqFqzJ3GD0cbH6WmbnWbuiyrw7YQt91i5MI3Pilc7Ll4GHRc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qj9ppTj0ziTW1eech15vFddXcPacR4VG1f9GLZPASjA&oe=6A394D6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvFBI7ZgeMEQ7kNvwHpQlBC&_nc_oc=AdorZVqJwuS6f48Lan-bUADuGdjheiL5bF3Oolp2JtLBi4BzUdQc8zTgSqVl2aqB1XE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U0rDeyWMDhnRyPr7rSRJOF7qNFFn213yWcQmRiynLkg&oe=6A39433A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGMK9_lryqcQ7kNvwEQn4SY&_nc_oc=AdqZaCSjJAaZS3uEP4opyVd0vXINnOhNf0ziylIP8Zfx2_x0WxuI8k4Sc-trzkiaxVo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wwHTwo3uvqfp3T7JqXZKGaoo-He_uxmItyCACgGltbQ&oe=6A396212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olY9ApP0RCQQ7kNvwHqaIBP&_nc_oc=AdocS5mQLt_bveo75tnh9qMIVPbrVHEl-eXACMrZonNfcc44lddRQM2OvdJMZBw-zPg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ONdeQiKcIyqzWhKf4j_Njt85KfhhpU5a3Hjb3pSX3mQ&oe=6A395FAF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENT
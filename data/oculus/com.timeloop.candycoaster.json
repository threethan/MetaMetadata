RsQ7kNvwEGM6AR&_nc_oc=Adr44DfCpv_KZuo9GWF4PG7c3n5Q0v6jRBnm2XOrxEzocE9M60pHsnUPjOp4XrPVIOw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7Nyl063L1G4fQb4EZY5vlClK8UwfJcYRNksxmdk2XIQ&oe=6AC900EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAk1I-yIMvwQ7kNvwEAiZVL&_nc_oc=AdoiPIzd-LlSMs8kXWYp-VQq8Odxxdtq7kBOtw1CjKqWzF6cCEyLTcMOcKct40fv33M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN-_h-kybvC_ObOgKSqShM8Kn0FuUVDUKbqeU0BFLEUg&oe=6AC900EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8seALhpOC4Q7kNvwFe7fdr&_nc_oc=Ado9IvVJdcNVtuFdn4uaVp4UGT-HGZVSu4JhSZWElcbuuusyza6Zy6kPJ5QqO2BEIxs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO7Yuk2165YnuZtaVoY8QFxv2dZC8Ae_5ljnTOg5mWWw&oe=6AC8F6BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqbqdhcNYp8Q7kNvwH8Me2W&_nc_oc=AdofD1ctBkz_oJpCOvQeNSrUcsp4F-KM8cxKJexm1RRd_Fow3VFJNIM5jqEXcL-Jbkw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA9qMHmiR6oLx6mSPqJYlIMnGvXE8w_hrr1Q4Diexlvw&oe=6AC91592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9sIp7pxjH0Q7kNvwHj1rQa&_nc_oc=AdqSHgVxul9X9L8pouttTO33X1Bvo20RCMxa6G3VEBe2YAvb1j-urAhS_xbAR8W5yus&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsmAK4BziDMg7i9NnywM2DZzIol06zY_0AeMk7GlWIdg&oe=6AC9132F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
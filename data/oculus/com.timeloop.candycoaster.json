uwQ7kNvwHAVFG2&_nc_oc=AdrVtLY5TLFx5o9_NJVcvGsN_QX0HG86LrgZBI2RrIFe4A_hjnxyzfowDeG2x_UYoEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9RVAP2UxaN_crErYBoWdunt-XZYXHRQM7S2Mc0GyuLw&oe=6A7EF4AC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLNTdalOIY8Q7kNvwEg8CcE&_nc_oc=AdoxSu0pHVCMnwAdvd3XAwsatHuPvdUoGp4BYJJwoQhgtmYZXrzAg9OIH_LgIzI1sM4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgwVFE9dkN5iCtJhMkkbqgph2BiH4AaCL1pHCYr5sH0g&oe=6A7EF4AA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkWAphMYXtgQ7kNvwGjDHSX&_nc_oc=AdpR_AYG9vuuk6VA7v0qn932qO6hEJMzm1BHkVZmG6wPa5Y2mVFTN1zNb_-mQCuYSlQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE86IqFWUTMlgACYcPXsshyPi0joLXDOubV4Jp6Nur0AQ&oe=6A7F22BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pB8ItluAygQ7kNvwEc0Bpm&_nc_oc=AdpVcByr6kFGTwJJMHXcs2zmOxOC5Au4GaM3prPc-wvrwTn3x22ZMw7ODrvXXk3VvTg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQJPsDTUJmzmZ3CURuUbG9hHDBLBDLmA_-zL6kMnMFsw&oe=6A7F0952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5NznrE_wwoQ7kNvwHV-Z1c&_nc_oc=Adqt5pRcz60rOg0AWumyusNHfQH3b0zyA1j2fIoVrvgvnqnWFgdtgK3mw-bCZJWw7co&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuGkW6KyRZ0gaIeTJ2ZPHnp11LI6CcP_IBAF3L_4vDPg&oe=6A7F06EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
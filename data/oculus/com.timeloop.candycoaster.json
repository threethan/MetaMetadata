7gQ7kNvwETF12i&_nc_oc=AdpE3DrSO1qSIZUpORmoNU463p1RDVro2ix03AAs4HPuc9XYVulvjPg9R1IbpuGwrVw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zMwcjT4c2tSUj6SQCXdfrom_5XZBiuWv3M91Xcy-7VQ&oe=6A0F1D6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCh9T8INYCQQ7kNvwHBCMdS&_nc_oc=AdqJHSIRDxOBisrZhJiKQmJJkB0Vx-IjOVhunPxwoZImzu5MLRJAIzXRSTZwbEStcB4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hWvzUWX0pJtSN6tA63w2yhOTJdKXujBEFNG6ZPonB6Q&oe=6A0F1D6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iiuw4esCuqAQ7kNvwF8CIsV&_nc_oc=AdpC9CR-qlh3SV3y2Nzh6L9q2NFMJXsUOUBhUrjDWlWrnmQvZnih2ch8-0_ssQhS1Qo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vihzuSObCceeUU4CeVflSEOSr4JDoHG7wCYk5Ry3JYA&oe=6A0F133A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e07qkg2GB88Q7kNvwF2y3cE&_nc_oc=AdpvCyzb10zZeY560MLVI-6SI0QB4u643W4xKcvLeisvvkEbZFwJePVZ1CCfq9-vd68&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aqf_ILVCZGdZwf2gIhcPkcebQhfY8KIJdaMSZuO0VZw&oe=6A0EF9D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRnpY1YbXbcQ7kNvwFPirCG&_nc_oc=Adp9DZWIqn6nm8d_FD2-jESUSdyYBOxQpAeuW4sqwAUzR1zaqJFL8ChLZO6tO4-Yh3M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5U8vrNzXWOd2ZK3BrJaF2hcUzE6q9VDnGWqcrX4BD0WA&oe=6A0EF76F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
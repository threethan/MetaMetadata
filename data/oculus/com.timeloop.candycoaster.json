toQ7kNvwEy1uga&_nc_oc=Adq7Iod47xp50eUpUln6ksXYb0_hZI6pMF5-X_nfrACRpGIQIpjLQ9hlSyvSGd1jVvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJacV-xj-OIqySGOtpM3hsA4HSfBPn0AWQVJqmrbaXMYA&oe=6AB7DD6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KG6x13pJIMQ7kNvwFvzqFT&_nc_oc=Adoivc8OPalZIdLniSRafnpTCclfOjdWG3X7ipjmpBplBtyUhfjaiNqHYU0NRL2ZUbU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXbcXVRr6RAyCnMIn-k5UGapUPD9D_NWu2dhtgbYgo-A&oe=6AB7DD6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDQSkHpzs5MQ7kNvwGu4tRf&_nc_oc=AdqtBgCIvk-roUitXSjY6Bj0alBt_rIzJfy5-MxyPVaDUi5E5jhgmJtPg88AJGOgXwM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJmOdXnxx-YvKq-fZAQ8DOpns-NCjUydM9nCM6o3BQ1g&oe=6AB7D33A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13yv_K61bW8Q7kNvwH3vQnW&_nc_oc=Adr8RxY38cuQ9ImJjJ2cTNwaP_Hi3JfCyZwK6AYckQqGpgjc0QFwQg6yr5ex1jSvJts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeVzwVTiogFqgCm0OSqiV02ARjFmAPR7ESZiInQ7REpQ&oe=6AB7B9D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlOFn3FFCuQQ7kNvwGxOfS9&_nc_oc=Adq2Ai0S-Nb1v6VDlAZ09zzOIAbVicftuKtP6QzYXwo38ghALDPmMwtlXESWsTqy2bc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOe4RYtcqcwImr40aCTpGvntpoybfe8v4xDchCkXTWJg&oe=6AB7B76F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
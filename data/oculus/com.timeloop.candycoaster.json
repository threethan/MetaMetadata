A0Q7kNvwGAAaPk&_nc_oc=AdrQho0n7LXuo0IOjKvvwIPf5jbvcb2wo9Q2Ne1FATapljJvf8WCvTePpR7bezLW34I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20_zS2m_7CRPmgHmfxUwVlC1cTzjqET_QyJJdVxe2SIw&oe=69F7626C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5woM97iruQQ7kNvwHQVeJZ&_nc_oc=AdoE2wt5o0Hku4AX9F0etDNRH6PJPxAl7S_lAYLyQC8enMad42y2fgwDj4K5l9hKCIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30a8tvyfrS2quTOt5obkbFmbyyyvnO_xZlyjpOM_J9rg&oe=69F7626A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmNEUkNlfrwQ7kNvwETqLpc&_nc_oc=Adrj2pJjNuz1z-BiARIzxSQRH9EfzRCm3TF_IY1H_rx6GlUxQydpDV2DyG_FDqMbEtI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0wNaJyH17uinH_iHqTBfDj8XHgPROfE3u5OIYPrnyDOg&oe=69F7583A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXBs4gSZl6oQ7kNvwGgoT84&_nc_oc=AdqI7hMB2RzTIMoq4TN7k2clKm5Z_zuaWj2NsV3iOERt7OPQ_wUwNPWp6vbYfRbns88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06s1YFfaLCIR7wI0Zl8cRupd1ZGfsq5ttyXDA2_WRz6A&oe=69F73ED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvem39hG5cMQ7kNvwFu_Vl-&_nc_oc=AdptY7085uh2Ir_eDLVyI117nOYV0KSWQAn_5oCeu9QDF-2cjZWzXNZRLykkNcxG3W0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Kf7z9hQqiK8XqD_2VF4jYUbEgDDZU0y4PE4Ifn_wDdw&oe=69F73C6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
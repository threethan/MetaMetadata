38Q7kNvwE8_1je&_nc_oc=AdqMVe6Da-XWYVYajc2CfD8a7JUSe8ilbDWffweWRv1JWKzauvLA3D_AbVI_7hl0fqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4OQcvKcellOqZeqaEEuhc4Y7XYX28NeIrgokOcpyhpQ&oe=6A9D7F6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-E0LxmbnKAQ7kNvwFWhc0j&_nc_oc=AdpBr4nroUyfr9vLcKQOThlDBFsS78mx8I6d1TFyh66RtzwjsdtuDpcm5aFVZ_3kMBg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3Eryb-03AjPhCwpeODHCny1Rtq78sPtph_OTg8-_CWw&oe=6A9D7F6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC_iIG4PQHgQ7kNvwEBF3hs&_nc_oc=AdqMS0LmB5dm9FleNbAz3tkM3dtJR0XjIJYTjXWE2En6gSwCDsqMKAm0ffm_grhuBf8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWwvyVzDoI4xSlf10YDmG3MaQtZWGXKAitqOShmmDw3g&oe=6A9D753A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hat09EywRWAQ7kNvwH5m9V7&_nc_oc=AdooIYptbTYsvJ23JkRmfA3UQL6P7QawpIH9GFKHGd_OtElInKKilxmhu9hEwi_7LCs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRJZVmPu25KdvjWfY_kUI6xO6gHKEn6Gf1C8etGZSz3A&oe=6A9D5BD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G74z11uGsIQ7kNvwHm48jF&_nc_oc=Adp18tLzozZ-GsgY3RCGyeOMKILBRXjpso77a87SdPTjs5onGBQuAjp1qAnEPSXKLTo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5CAAR_syOpVg1w-GTROEfkzdnTYtWx5XcMzbiGZC93Q&oe=6A9D596F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
LMQ7kNvwE5yRe4&_nc_oc=AdpDtBJVrVrcvJs1LRW2zbMUn-T8HGPoNZd_9W6NTRnZHffZ_ofYzY_WaAoBnxx7XjA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtCBpv2vxHRdnGB8hC7qxdH_FI593iIxg2KzbJ8daUVA&oe=6A734F6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXJnenFzCLwQ7kNvwHJ8d6q&_nc_oc=AdqB0UMxl60MedpuBHgHj95txOlxSLVSi--yKHJS1qktiq4OsfdoqA4_ZB0gJrkVfU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdSFnPFKDftF5rx8O8QNkwYB7iC8NpGOJLcNM-V912cg&oe=6A734F6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laEBtdnAshAQ7kNvwHyCLpq&_nc_oc=AdqlqPVpdlEeDyk5qCky1qCZJbYx4qpK-mNlodAPWqG3ovyGxXQspMsNu1iaQkn9ZdQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGS3Y7vx8exaGthHXxlDvxvupsG1_7QG9QaZhDr1FdXZg&oe=6A73453A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUL-lGSPzg4Q7kNvwGeVgr-&_nc_oc=Adp0KVmy7eTMkAFgErxDA_MlY2HE22V0ZwRHtYBEOlsbEjfeipHLpjNl5d8KFX0UB7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7rIYBkjTcAb8f856nORxI7zIg24qBKLKw49VNWTFJSA&oe=6A732BD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6k0cIRuTYaMQ7kNvwGuYTPA&_nc_oc=AdpdNQlZwdnnh8tvQV59eF8ICKMSuiNs09z_B8Q5pMRPoOUHamuRxjsNtdeP14GjGNo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnIMiJRuPiWcZXku1nrXenEk9zne-tnjIX6rCn3qbTZg&oe=6A73296F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
f0Q7kNvwGlW932&_nc_oc=AdpBPg-atiRRiWUZNNFS-LskcDhWmnne4l5JNt_tN0yoYlQijuug1uXm7b8ygriiZRI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ343jnv0UeFK_0pwqMBiZp1FOOypKGPjTIUNTb9WW7fg&oe=6AF08DEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZghiiJKnNUQ7kNvwFyPvbf&_nc_oc=AdqKkyvqGjEfiYN9ZV6k2Rhs-3W-aio6rEsagRQ4Ac_J99Tqfxhcdig5zajAa0T9XpM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRseyYLXVpU6L_tLMQLvqPKJRWFWI4oYbrL8siMDHQdLA&oe=6AF08DEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwwkfFqAzx4Q7kNvwHwH6vx&_nc_oc=AdpdJ3NAHImHx0KkYqQQmAur09tANGFJ28R0QVoOdVT-UEgCa8rmV3ZNbQq3ACUJsdI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQTWrwntuWsx-GWAL-aTU8eeihjl0F6Y55T2fg1d0x2Q&oe=6AF083BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4k1mX3yrlAQ7kNvwEp7LpL&_nc_oc=AdofOx0RQBC0i7YlhSfONmCP6WfaDvnNri2xqu5bixzy6Wc-qgNY0AHuWtgnU-NydDM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHtoR8Qx7Mvfr7GFCiWJ829wasyNKur-ojrMbkWLe6mw&oe=6AF0A292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beyd7VlDNMcQ7kNvwHgqauA&_nc_oc=AdpYMRb68TPczEO1oKcNOAO1SEgSnnwqMyKHGwuxiYpKfbyDTxB6jMFUc-pfIy6DGJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYdxZE1TZCbSfpRP1nxTsQBaiqlVjxrgvHJVHki0vdGA&oe=6AF0A02F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
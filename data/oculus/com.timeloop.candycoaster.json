jQQ7kNvwEWEdoX&_nc_oc=AdqXNYRR9Dlw3JVzV9q1bh-p2u8jo1WK3ulAQzy1hCUUtJguEdVUQyN4sD5sPjtzl30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVZmUhZ0PiZmF76X_Ep1Mll42vdpSTcGvXXAwcIhlZlw&oe=6A82E92C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyMLJ9ZB2fQQ7kNvwHEzRtX&_nc_oc=Adp4K3KL1Edvpj1hEYeg3wh0HlHsCa9CgLeAq71G3iEvAFnvzK55NB7bsnRHibkz6zw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4FpqRhyoxvob33sZU6vrEJKTBi4GeqrbkHy-yynYLWA&oe=6A82E92A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vfSLpzghfcQ7kNvwGEIFeK&_nc_oc=AdrxmAniG75o96uben7qQqXB4bRwjMcohA5lNIObWk96jQlisl82rfYHApCwgMCF3QA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA5QPo2HWRTEVpG8e74P0nYgMxJdCSEibvBTVUpGklsA&oe=6A83173A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDIMCqSLFEYQ7kNvwGlDnIr&_nc_oc=AdpODGSVsmCQIm7-V3CpJ-A8dHtF4JEHYqToeZgcgcuXufFmG71hJv4ZB2qWU_Y5xDk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdumSzw5529Q5tMovEe2QVC-JhFzvevLpx2BCsSbw7pg&oe=6A82FDD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFXAem7evm8Q7kNvwHELh-J&_nc_oc=AdqQYdvCSq6qxRAEbe1wZuojQZJ1RhVQkf2HJzU6OW23hue-tLSM2DdqYFo7TFfTiyA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEscY3HxDSw2DN3stHow9X0T5tNOdr6GzAW008eUs5VaQ&oe=6A82FB6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
64Q7kNvwHsLM8O&_nc_oc=AdqM7RdCzvvamFbnozP605VUy_rF9_EJwxUGXLuhZ2tbGREEUNnhpr7YhahjVwredXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7I5XtnfoDhZuOtJCNgHyxdVSgINJOxmxHig6_J_ieLg&oe=6AA2C56C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojmuC_Nc7DAQ7kNvwFd7hc3&_nc_oc=Adr9B_pl8CLjkFGgpd1tkNC2feLeaz3JVHdOM9SbsFYFm4XpJWL0yRFF34xUgV3-mhY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxRQ-RpAEd8wUPWOeFiNqkoyHLK__EqtuRITJXPGvKww&oe=6AA2C56A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqa57VlRFmsQ7kNvwGIMcYX&_nc_oc=AdqH2WzW4F4LvstySHCxpLeWNt-Fuvh-sOtJGOe-j_Vcr3zsJPvxOl_1_be7W8uZJdU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6_3F8Uh0ZghCBlJvjzgPXyUVQUKm2lAWAJop2bw-j7g&oe=6AA2BB3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXNu7sKhUWQQ7kNvwEgorHF&_nc_oc=AdphJ2ployu57lwVW2vczbL1E3zWvrJbG7tF5wIpQWmBDFQDYwARzEJqfaZsuAvQ5xA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0d2O04gJTtA5wNgQ9h-LGbze6HgAwbA2otqDLBe9YOQ&oe=6AA2A1D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VWzYHvX39MQ7kNvwHcfnVk&_nc_oc=AdqKpiraVCgg1n1CY2B1pkWeR1Cx0mU3FNickby4nDBFQHZuWUcK_jEsEN9XE7sYiYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK98JUJTqBdccFSDnZ-NWK2tkAtQ0ZmVYrW3DQv6crHAA&oe=6AA29F6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
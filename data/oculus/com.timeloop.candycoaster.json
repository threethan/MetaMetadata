B0Q7kNvwF0EgOE&_nc_oc=AdobYlP8OTKbjZVwHs04YIPSOJwPKjuU7V2eusp_9lu9I5cbYdGdzys1uhr_0pn04GU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJEAYzNV_nRZswau-dVqhoSJ0QYEmWwLZD2CcB1bNglw&oe=6A4E656C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J94mJa8wR08Q7kNvwGgbuzu&_nc_oc=Adr-q2fMEqlADpAZSe9cqzbXuJv5ar3tX-vrOaxVTnCW9if73K6HPD_jlsQLfONb87A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaS9Lks6A77FRbNqtGp3_QBBJSFX9lj9PIpkTPgJHLaQ&oe=6A4E656A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mn0qiUQjgKUQ7kNvwFohx8V&_nc_oc=AdqAfnBHZ4viJO-ICymNEyYSoyv3BkQ9giAWJywmr4ffeiY25cd6KcfqkIYEvOLum4o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi30p8jw_cN7hSKj0lwIICLclpT84CAbAu72LSjCFM9A&oe=6A4E5B3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlqQFG76vSQQ7kNvwEZ2jCF&_nc_oc=Adr_kTrw_u1p-VxNnxHci81rSzAAGx7jfYvKYVWphtsrrHmNGU8Ryojqu4j7yxLnjow&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbsSRZ4DrWjVd9p4FlZuNlBCa4Ui5_Z-GfZtoyjixqMg&oe=6A4E41D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1FTam_A-MMQ7kNvwF46F7A&_nc_oc=AdrfVziARyepxxl3f22XyRhZrgF4ONw8w4m105QK85Qia5cTyIGzYQ0KkaJF2PckeOU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsVA6IFTIvzEvvd-geqa6ooAK5cQuva8LlHsknl2y46A&oe=6A4E3F6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
W8Q7kNvwENhdqD&_nc_oc=Adq6H6enAqdRsHvF5tac69malpep_TRChtrE74H1Z1atj5suVS4V7gmMWQZDwsOvdJ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZDWYaCMx53X3llC0QDyyGvrV0BoA96Zl8GDII9fFyKg&oe=6ABBD1EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDJDlnKkb1YQ7kNvwEpF6CN&_nc_oc=AdreEkX7F6MSdO5LuMB2T_eDuDPECjsE63X8id69UBiDyfZRBMIQLlGIiK2tvVN5Hi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSorSnxVHJX1BT42iTuCTItDAeSdKwzTx1_qJo9I2azg&oe=6ABBD1EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGeSRmE8EjEQ7kNvwG5pS2K&_nc_oc=Ado4QED05bFUpBTql9MXDJ6nAOGg8Va4KCHRD61jdR8jdB3yI_2NtKayGNkiZk5Y_Ec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJNpumlyiH4irsiVfyaHnTUNPcA5Jl_T422MuP8dqFZg&oe=6ABBC7BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkrTbigsWZkQ7kNvwHmOO_l&_nc_oc=AdqX_Pl4ymrHhbnLe0VMr02GdA59lRDdLfA47PcFlW5XEFNHg7nwAkPqbzfXl7gJexo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5-4-pauUVIB17v7xu4c5OXTahxCir_LRoHuEOVublfw&oe=6ABBE692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICT-qtIZvDgQ7kNvwE6E6zT&_nc_oc=AdrwFe8RI1C9PNEpS4VAmpHZcN-1o3Z9UEHk8JpbwP_95J-Bdf9PayN9DR0EiPc47Gw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrlwNfFZJxXdK3OS923wReo51R0mQKArhiYHC919Q_kw&oe=6ABBE42F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
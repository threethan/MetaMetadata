6kQ7kNvwH_XbgZ&_nc_oc=AdrpAiY1RSNikJJkvbhd7gKlY7v0OoXINWQ1X8EJyUVhlMJu4i7QOEOt-Mz7AJVztdE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgMFxOhMif4hBcmWG0E888oNb8JS1gE3KrLBGlPGliTQ&oe=6A95CEAC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8kLs8dUBBkQ7kNvwHjWrmS&_nc_oc=AdpJLAVNjMWmVK8qVJrFdGOnHHglgaFCXcibqjb7rJAPDltUEPV579RcbAxSamNRAbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErDAM0HaCT7tIHOJY3cmAGgSE3sFOa-dQtNdi0lr8xCg&oe=6A95CEAA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iib_2q91OcQ7kNvwG6hpxK&_nc_oc=Adq_E1R2QinG2if-20H-R3SEGp2_6MfTsCXXeBHbSOETFCANnJ_s7yIwaQ9gYLu8Og4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZD62aFjPtRnrM7WEX_SJTKWVT4PjteCZzbwFvn_Wuhg&oe=6A95C47A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUDz9oGHs3MQ7kNvwEF7Zg6&_nc_oc=AdpgvX0m91HnvOMMhzfIam5LAkpS8cKK7trAcjdPstZnVB-ziz2mhrPF0SiOcg9DTJs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDexxomD68I1tbZza2f6vTMbA1BJO2DJYGWJb5OxrK5w&oe=6A95E352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxXguy9hx9IQ7kNvwErY86f&_nc_oc=AdoiPkab_bB1seLx9jN9LewnBM8Zy3d0QjmLKlofa7I3VMtI-XJcJAgjCNhvShNWk1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3lBYqDEwGLVUdZL7mVGiDExUXoaJpD-2vd7uGtIlITg&oe=6A95E0EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
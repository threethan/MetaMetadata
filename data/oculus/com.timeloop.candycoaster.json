vUQ7kNvwEKOD1R&_nc_oc=Adq4uMFTHM6X4906R8qEedcyeyHZKd8Cb0UvZKYprsfI-MfBhZG8PrgretaIbKjwjEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43lFZYeBgSicbvgwAnfLFAeLvDyZ-MuqDOym-wTYxufQ&oe=6A14636C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4-ZBDlb3Z4Q7kNvwEtd5_6&_nc_oc=Adpb08obkPnIqFR27lyxdnm7Rj4tK9UqBc0Qv4acgUdroI0RG9g8iRVIqx1jwIbLtDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HfWWvJiuQAfTihWh2uNy3l49_JJQeeHhvXyITNzgO_w&oe=6A14636A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4Tc278eaHMQ7kNvwEOq5me&_nc_oc=AdpBHEpTqwx0qju0FD8v8zCZXNvDORRMsqpHBPbtcml7gicphtgw8o_311srhsvB15A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YIib_CMD-DZDWVQhhcu4MlKdCD-EiIa1QFQmx0G167Q&oe=6A14593A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJ6KU5W09BMQ7kNvwFZtgsW&_nc_oc=AdrWCy17IaUPxhQAru9kbXn_dhIeKH4kO4aO3jjKplQoXfGZ3trpxtroPl5_udXihjQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F7AL8xemc0ZR97rOJ_tWBjHKwZmPCoB3U0dpgQTk2Bw&oe=6A143FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yak0h24g3xoQ7kNvwHvmZP3&_nc_oc=AdoO032FIHLv7MprA_5rTKCzJ8c89YQ-VMs0LDwRreKjrQ4UCI5vzTI64lJOAIHSaPM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-2FkgpASl-jxS6FrqvBZ7cy93nYtTOX2eyapXL4Isxw&oe=6A1475AF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
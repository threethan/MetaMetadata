gQQ7kNvwEI_-LV&_nc_oc=AdppGptnK1h9LHNVjieqMt0FMamOdqhaF8bRn0cn2ERq63bkRlPRE0ieEGfaID3sWsI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HjqWRs42hVAJWITv1AXtU0IS5Acw8aaPjRmQioMvo8A&oe=6A009CEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoXA_BiVgTsQ7kNvwFSIYUh&_nc_oc=AdrjWfjKg8Gcz0DyNR5-iSB01XMmRVUthT9hvpksBNs4L0yLUx6exbPlvpupEHdgyEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qencLUwB9sWoogtfd1mjQdmIdEPxCmXFBYMv7-ty5ZQ&oe=6A009CEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6Opt0RUgf4Q7kNvwFOFVod&_nc_oc=AdrIYgPo43ezxwQykD-nBr5O66GsbmE4jLaaZYWH5xHhjUg0_oEfazbMY6R7rp9CoCE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4190QZgnP_u9JoFcmQ9WFjPy_AOTONVmfX7hsxMIw5yw&oe=6A0092BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGFFRgSfykgQ7kNvwEAahRi&_nc_oc=AdoYA_6OgDJclFQBprIbUIGQ1DFb0npjwPjzZmUj4H0wCTTwCuaTtTe-hPfELR1tPew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GMBeJ8AAed6mUc9dPakVXvo8nHUQHSPzCN_hwm12ePg&oe=6A007952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Db8roeILS3kQ7kNvwFs35wn&_nc_oc=AdqVzgP4xusRqvPVDEmPRPhsBKdmtdnbQXT2y4WjpaLFM6ZOpx97BVJxxHnCUKXOktA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mW8NCu3w5Of42NJCAwYVqP2Tz-JoCJ5q8I9ucAPjjKw&oe=6A0076EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
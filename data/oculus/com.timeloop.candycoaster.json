voQ7kNvwH6b42k&_nc_oc=AdpRzQvzMHgbbeYA-2UMu9R87bkfz8hLXunbSU-vM9eukT4gyYQcuYuuC4JAtPMzzgc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKm5g4k5bnh7llyTUxb-wEmNFH5168dObmN_n3HbYLGw&oe=6A6CB7EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wra89Wp2yfcQ7kNvwGhzC0b&_nc_oc=AdpgCK6cX9pahhNyHXx0JjKeQbcgIS2Yacu1Q0MTE-CCkPduDKz5QsHlqtOnCawSxEQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeVd3I1uOEETsE1cWGTkuVh2fcfYghqLe23O2teKF_Tw&oe=6A6CB7EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCis6WN9gZQQ7kNvwHI2P1z&_nc_oc=AdoU0ObL89q9SMhiQ6R-wDKwVcPRIF-uARDr1HOzxDg5KYuPOyeyhUtgCItawB7uyZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXLdeMg3fp3Ul0xbwQP3NSWfikFPALD1-tbjfSBaHgyw&oe=6A6CADBA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ak7oj6IQQa8Q7kNvwFDPSQK&_nc_oc=AdqcW0stTuIoKf8CL3P0yK9p3fN6OMEfWhDoEpqqAT8D2ayu-G7h8tCDO05S5SDPC_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4rfG2nhxfuqxzX2kFxOEPca8fbkxDe9q8Un54V2n9-w&oe=6A6C9452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUXcjGbHM_kQ7kNvwEnXoF5&_nc_oc=Ado4Emznexu71jrMB946jbHIjd73kLWgTnfCwX5x19mHsevGH1qMVNOTg3GM3mdrX3M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD8j4P6UOu8-zxAEnG7mbhJE7V1l_XvtwGhoI05TQGuQ&oe=6A6C91EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
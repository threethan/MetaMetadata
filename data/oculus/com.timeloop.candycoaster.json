gQQ7kNvwGfBtMI&_nc_oc=Adre0xc5aKRog3FYuHO8ay5uw9F9Efu-KxZ_jQOstlQf5XvVaB3peuCfTi7faGbYz7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XqRbWWSNJjonNejFkL-45l4FSmNSETc9QSpC8XUpboQ&oe=6A01EE6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1x_63q3FDAwQ7kNvwFRtQNj&_nc_oc=Adr9ajBvmAQbZtfoit14TqKStEZaL47nsxmVqqFd8nAjcJbL-iMVp3D6GyPQ048uZhk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H6uhPjVolp7lGhsgFiqkQdO9LDByD-JBEZX5YvrrhIA&oe=6A01EE6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6Opt0RUgf4Q7kNvwEvuLZO&_nc_oc=AdquBxcn8j70sgbE0l23QCIay_YflojBCt_G6g98ccYIiVbhCLIH1DHa8t531Ij9B7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ycsRsleHDPykEIytqWdt4wqfytE1tFDziR0lfo-8-FA&oe=6A01E43A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b20DkLS9MKMQ7kNvwFYOYP_&_nc_oc=AdqUGk8XbARmuPvQpS7uuMxsAkNx2gV8ZukdD6800WRG4GheMUxwBjQs2o1V93RDxeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vJCo9j3O1JPKNQh9XRuI2bTG2CSV0YPRWL7l4Mq9haw&oe=6A01CAD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Db8roeILS3kQ7kNvwGIxtZu&_nc_oc=Adq3spaB3g54pPxY54KUvkjJO5b0HbQ0a0R4Yvp5GNsB2RhPtH1KgNNDIwFuYdMYN0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mmGxJrir6z6Z2d-aYchSwY_0wK12nkdYBeVTOcgmcXg&oe=6A01C86F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
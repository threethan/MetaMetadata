toQ7kNvwGXLZgu&_nc_oc=AdqAyOxRIovUrHFUvSNn2avgU7VNQgWxdDAEUfWyMGhfnuQkCf2RwjjXRtjiPuWvZwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNDG673ntZ1mjlqjKBxMdxk--9pz_KzTzpPfiPwda9Rw&oe=6AB53A6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QB1DAZN-NOsQ7kNvwFv3Lse&_nc_oc=AdoZ3LXwW_OF4a1n8eIVW7NHI3Fzlo_M0LvxhA08OeNDC_o3O4mwAC-wf7RodR_etX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTIEA9fyJIyFXz2FktOsj0QFnzGc7qiB6cfS0GIDlNkA&oe=6AB53A6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDQSkHpzs5MQ7kNvwHftk7p&_nc_oc=AdqhQfz3urG4Qe02IxcU6SZzWs1cc6hT8xdhZl-qc5r87uadujf5j9xxyVCOk2yFqAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLThw4VePFsbyR3wkkTAg60IJGRRowI7FIvypFZNVWfcQ&oe=6AB5303A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwkZb04AJysQ7kNvwEflT2h&_nc_oc=AdoJf3SjTPAmtuhDrWXws6CriH0uMrHlhgYiYD8Yo3AYNaTEAWjK3pOr0Za0uvjUT5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRK6DysxZHN28WL25Qpk1bzpdJfb6flVYF_oHftzftqw&oe=6AB516D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlOFn3FFCuQQ7kNvwHPOCAt&_nc_oc=Adp9CPaQFdZCE7Nz-HjhxqINm7dSdAj_Hxtr2WtE27kWQtz0sZLnef3KWHFncWK14tE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5M1YGC6-Bvs5lLzAWZ9c67ui7oH_E4VM8uSYPO_QgFg&oe=6AB54CAF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
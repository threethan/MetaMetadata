d8Q7kNvwFHBJZ8&_nc_oc=AdogcMxA2VPr-JRaifmB5Id-KldcjvLI1hbBHqrZoSOx4y8tvSwxiW1iDMnTcvG3H2w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDkH1cqBr67lnd9srNbtix87TGZDarb5Zxlu7nPjwlaA&oe=6A622BEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAk-_sKWc64Q7kNvwFtfIIa&_nc_oc=AdqwaLmELM0MbUfj2UTDsO8LcamIt8PlFTc2WqY8ODoIlU1Du3R7ib2Ep-o0cKkJGTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2V2XzhxXOMVdRmRrmAByR05W1Y_cU59LBjTF5U8nUUw&oe=6A622BEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVw3rPZux0cQ7kNvwHvOAkN&_nc_oc=AdrlUyhW3F-Lw6-1tK3D1rgftns0zKudvtwJRNSKC-TrmGL5YxNy6LRGGtRkAv_PEmE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGSAKi6iWW0PI4FxCacWUxRkm_3RN0OA4O3nf123aiDQ&oe=6A6221BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FA0wcHYj-rYQ7kNvwG8Aozd&_nc_oc=Adoimea9rjfYUOvfQtuj48Whi452CpB8RH1_clqZjePtNK2Exx3xFbRKWFlm0rdNjbQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtYgip9GtdHm4vdaDKMvzvUo_lnYACkKUbNQh8vBNwbQ&oe=6A620852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Foq6H9rHK1kQ7kNvwGX_5zD&_nc_oc=AdqEg03hyE3zVeaxONSKXpmKRyKqqKcBTPt5TuwJjWM4vTQ_J1H6i2ryX-rfBzERgAc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm59s03Y31AWybRF70LkXjCS9fMuP2SZhz7PRF6oFFHQ&oe=6A6205EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
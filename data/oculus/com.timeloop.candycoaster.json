30Q7kNvwGsWgnH&_nc_oc=Ado6y172uRI_6_iACag8_77e4ZGquSBZhkeeehE0ixWmY-2AmMYTn9NWN3UuTGav6PE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QFtNQeGDaKeu4ZnxG6rOpHZe47FeUwlC2c5SiurStkQ&oe=6A1AFAEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MP4aJZlYQdIQ7kNvwELcEa6&_nc_oc=Adp2_rlpjVAuPbda4OH3xfP7TGp4bYs1Nj2NRK3SfvY_4HnYZk8pPW7p-MMpQRUJ6dE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Dta74rU3j-8z5NjKyUgirfqkAzaSH15dFhu6jYeo1RA&oe=6A1AFAEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q_4CL5l1DgQ7kNvwGBSgAe&_nc_oc=AdrwUfF7TYMbm_FS0Wrudk6APVWekagZPcMC0cyFOrZYlez21atEFqbGQBpdPGOg8S8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72crWBAOgX2b-7hW33heQcmLHBORYdtEl6rZj0b7V-ag&oe=6A1AF0BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZTJ82vAnDAQ7kNvwHvppZv&_nc_oc=AdoanMK47yeC1MGBXY1-o_xLxC_9yJVYpv4vGCI8ZkY8mdPsF-2WHuab4r9KwiiKLxE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w5hDo-nnv7VdnKdnFvvKG2Bb33HFoGASLdQlLCoEetg&oe=6A1AD752"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4WWoRQwvPUQ7kNvwEgU5rz&_nc_oc=AdpXmGC82mPIZRCvYB1cjlfGinFMIF0IWfT5H8BUIeqnLj2LEnMm_LYit9oCd3YgvcM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eOQUZaHRHKZwLdlmiKvFlw12RAAwOWyI1tDSwCIs42A&oe=6A1AD4EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
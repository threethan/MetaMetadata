vUQ7kNvwF9vIx4&_nc_oc=AdrPgsWFfRGvxzwPBuXvN27wm8HxV4BHSmOY5xwxGHjeu_ni-Rcyu9fRF1si6W0Ncho&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zo3Xl_7Z78gl6qzBlr_daOqN7n8gmOAizu3cu4-TXTQ&oe=6A1311EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4-ZBDlb3Z4Q7kNvwEwqkLm&_nc_oc=AdpYYKHekId84SNoHgmSMRYLiB5rp9zpqWkG4dA9yGjCkxkowLhW0C-_pm88gOjm9UU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zfeE-50Gap1uxXas8HQaSROcd-E_Oq4VGtuCIpcDZJg&oe=6A1311EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4Tc278eaHMQ7kNvwESVxjT&_nc_oc=Adp8Q6jULk9gRc4U7jtJyro8k8my1OPbFigZUbFS2u-poS03KF5fDJsOifEjyLMX-iU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TiQFthENp_StrW6Dj8IkKmJDEE-BJ2or3mKap6mJS6g&oe=6A1307BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJ6KU5W09BMQ7kNvwFMK-jB&_nc_oc=AdqcigrlgY_ESIAde4JHGz_1_ysuRipPNoHZ-UpGl_7uhuH-Vk9HnN26Ggl8AnV97q4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HoYrFoy-ZUoPc5RYJFP9Bitx9db_xdmVdlIlTPa1VGA&oe=6A12EE52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yak0h24g3xoQ7kNvwGvPwY4&_nc_oc=AdrSKTCJKUanqMFoHB5q8XVI78neta3QWQrnSB_fbd-Zog-N_kQkmQKsPecSUs_1GM8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wzJdD7eeRldJtspJ1QGiwq1olNm3VhvbbPshplobByQ&oe=6A12EBEF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
A8Q7kNvwHHN5ou&_nc_oc=AdqZcm1iVDyJ9y21gPbcyTUZxXNrg3meUQuFBDOqWwkwSoGyA2ulanonSQzZTRUkx20&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3k653JISRFLcDNje6AqU6tCQDoPC82TSHczGrQ0SY9g&oe=6AE35EEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyoPkcKLq_IQ7kNvwFiUTyq&_nc_oc=Adr1JPEM8Z1x_s3Fn7TaRWbOkEYezG54Ck5gAWP_S_no7DLXtS-F_fb5fzSXg_sjimQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdZ0WmC8eZs8VuPXOMhO5L1XELZzE4ymiDurIiZZtMqQ&oe=6AE35EEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zevM1LxhVd8Q7kNvwGpipW3&_nc_oc=Adox0Tx4jQ11GqmPf-fJwPeGYy6zH_Lnjw14OxMLJDc-B5XfcEGXYJ8iUrmU_xd4RvU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOULrNVcfQT4SUqCbMrVLo9bw3xfjn29StkLW53WRYm1g&oe=6AE354BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQM1phidwTYQ7kNvwGWx4rX&_nc_oc=Adpzf69jDbCRa3rVXruRDrbaRbILiWdzd-Fq5HpfRtBeuhA0471zs2GkkEaZOWvGzKk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqBIGQZuevd8LHdWOMMa4Tso1WWKWk8P86FO-2ulNDGw&oe=6AE33B52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqcOiQ1GjCwQ7kNvwHztbqA&_nc_oc=Adoxu59jOq5ecewpX4hg0zvvbUVFO1yiO5m9ydya0EHzXta9sTi5Jz_gwiwBl1bpqSM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO31rCAJDDQgR1fpyDttL3taGV9PThG30-k81B3RCSsFA&oe=6AE338EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
vgQ7kNvwHHnxee&_nc_oc=AdrMgZ-WuvSVF6I1v1WEI-GQ3JpjB_t9ymdq38k7XcRecAN_FgL3K29Zd0FW728Hfw0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObM4JgiQz03lRmj2H1QFX6xk5_X0FrcH4NVFIgXncz3g&oe=6AE601EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyoPkcKLq_IQ7kNvwHD3nCI&_nc_oc=AdqSsJM9Cd76Mul-0gkrmBOBVZHY7bJvICPxdkvXWdZ-kesZTx5k_gIyb57nR0-vMwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV93R3gn6SIcSBUfBlUoILZjMZG_sTimqpgX2sPucLxA&oe=6AE601EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXBUmllVTaUQ7kNvwFrEhr_&_nc_oc=AdpaaQt1NFmGKyU-TldS7H95QN0yUP8UQcK8HmKY8xadX08ZD4TksafildgCsqfmcQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsb9rAxXafnxYTj30APtKWSJDFVAKmQiUu8uv3XKeTIw&oe=6AE5F7BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQM1phidwTYQ7kNvwGJPt9b&_nc_oc=Adr-KIh3_WOYy84haoboWHJOnoDW_aROH7fnZobUGgwp_kT2MpD_OcmAzroHLZhZcKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2WWTZRIGdo22WqggAgm8838_wrlG5Wlizlo4qfi_dcQ&oe=6AE61692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB2r0DlmrBcQ7kNvwFpSEJd&_nc_oc=AdrhbOWgLcFcp55q1AVdbt9I8XjsnasB7UCKBq-AW4JFWLaN9wwDbHMpiDIFCLcu85c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa2GcAQlsRw2irDaLvrgfZcMW-loQvieW6MMtncZN4Tw&oe=6AE6142F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
BoQ7kNvwEh0SG_&_nc_oc=AdrZR3soK4HeI4JiyeD4mO2-A4B58iuZG7KDgb9ZoDsCWZ4fc4rVCIZiiGjlbdL_0sg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHXuyrJfNN-_ze9utSZBG-G1WSaIi3pVlbL0iIlm2RVw&oe=6AEDEAEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrXIyp9gDGgQ7kNvwEUZ4f0&_nc_oc=AdoU3IQxc89Feygy-pGWkxdGcyn7zI_gRZ8X5-nIvd3dmM_TNmm53ibPGXveAj4K5oc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOLlDrAfrS4RunYmepKZX_DPdxIrEBJMaM19pjnHxVxw&oe=6AEDEAEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bicx1xXf2p8Q7kNvwGeF1rU&_nc_oc=AdoFNw-deNvncIzHGr3Rp_LqXljcasK9wWda0Uj0SUqrSQNX5KzcZFhcLmP8VTCi5z0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI6XetLqBYQ0yeDD3CLWOch1pzQzWffbZGgTRkl9bmjQ&oe=6AEDE0BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4e2ZivGGNwQ7kNvwFZ1NIN&_nc_oc=AdotSOw9VPfHumtvQ1cJXEw-3pFsZgQ9xUtUys-fRjOizTQGBzxDTfKhhcxZYW_DhcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9Z6qIh7ox-1H-voRfvlzfd58hSGw-PS86sFO9sR7Suw&oe=6AEDFF92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1LKjVKz7EoQ7kNvwG2PJJV&_nc_oc=AdrxJ1Sljf-9Zb5T3x3LBPhDVixRoxGxADJ-lGHH3YHOqgDURoa9RC1AEh3_989vjeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO1JLaYPZpiFKkBl-oHPn6UvWGnshheQlVs7reIWce_w&oe=6AEDFD2F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
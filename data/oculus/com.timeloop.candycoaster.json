hAQ7kNvwFkUFy_&_nc_oc=AdoiAkeInyQhmijsNLaN8s6RLouXeUV5q_JKoQVJ_Smttcg7VvuENi9uokZlhutK85o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34Dhf1F3WqPhCnfvjXbMdc9jRjFgwjpQ7U3AjC22uDEQ&oe=69D2786C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KuPAQa19lUQ7kNvwEiEScI&_nc_oc=AdqOt2BSQahw2MXDg9bIBjbrjF_ZkXsmxudy8_PW36VTjcdjkCVGyx736LuACqGnrko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fp9LUUGXOXQBnccMCv_i77XrkMYtGrtQT83OjdZloLA&oe=69D2786A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfJJAZ74gjoQ7kNvwFusZkR&_nc_oc=AdqOSKMKUPvh9HDXYWkWNquUejB2Pxjie7UTBsrYvn-UDYcp0Q6umVGcK7pYr2sUUGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2shaAed3CS1XX4vRoD58Mph6M40HXhWBCwONOkctvfJw&oe=69D26E3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCP3bWpANlUQ7kNvwG-Vcvb&_nc_oc=Adp13dJg8Ix_lzzIO_7WVmEts9i-PSpyJlzk-M_wv0Bg6qEdq1ILYYAYCWhVzCiO5t4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32zT-Hva6quSMB3Sl2sD5diPq0b4Nr8TFPGrM4ktjOcQ&oe=69D254D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZIMj0DFhEsQ7kNvwHr4CNd&_nc_oc=Adq7R7crPvV9BRIUiiLiQN-RCTVvLRN_-Vz-I-S7MsGw9sYRbwyxIi0FiQFwyE1UCZk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JivEnc-SGiAClGmqxRPMMxGxrUSpAy8k3tETFAN4rMg&oe=69D2526F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
f8Q7kNvwF4uUFT&_nc_oc=Adr1PFSz4rZqlXmWteH74_MKgMt58zR3NWCn2JaETxet-FDa9jHSdVrFAYhpSTowZjs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SzN3X-QkxwFCGhh-smT_uVd0Iu-WuoQ5wIh2ro3cOHA&oe=6A0C7A6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybMYA8kU4bIQ7kNvwHEntzA&_nc_oc=Adp3CN5rbLL2GWCdCH0Sp2wkucjJ8jQPVbsMN1s91sYrFJprHghEUANcOFSwvZquLh8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Plc3drDCmiq6M6eb4GroxAvAqgfpBiU9WOHGV57d9oQ&oe=6A0C7A6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMQmRX7F6pEQ7kNvwFI9F8H&_nc_oc=AdqxjjBRgtX4xAc9G6ETf0nJtAK0trEhtFXyHB-rYNMIRqA-jcMdtU3QcNl3oHF3tok&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ULI385kDQFt5RUi-3ZBhG72LizUdRnCwQgS4oby_7bA&oe=6A0C703A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_dSyS8TFOMQ7kNvwE3maVN&_nc_oc=Adpt_TgU5knEOuxSOSI9gPgJHVEGiQwi4r4X42d96qOiCHuYqyhiyOywLu3nsBXkAJA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af412jneYe2c5j1nbkLQs7jR6Z8o_r4FFmSswzOzQr3Tgw&oe=6A0C56D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_6IuKy-ydkQ7kNvwGX4Y4n&_nc_oc=Adr5uwa4RbmFLbZ2PWRhzknU0HVxBoPPBxlbKmKYRwVkdXy7WCtIUCwjl5MGPoyCM_M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WF9Ig0DHlYuQ2WJmhR6FhYGq1BdJg4OQjgEzCmdQPAw&oe=6A0C546F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
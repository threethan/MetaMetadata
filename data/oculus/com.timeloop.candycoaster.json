lkQ7kNvwE1OTDV&_nc_oc=AdpNfuIIBpvxCevA_qZmayDuKIaDVsoIjGY2Fyox3dqRaIOYHnFgfmx4UIfk8Qh-fVY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0JqH8l_iBOdTHs-RIcpHtLvWqdNDsfzCvcvUh2Vlc7w&oe=6AE8A4EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QV5IrieA30cQ7kNvwF-lfxg&_nc_oc=Adr2TZn3fxkshAKaR0tWLWzn7iK098p9xSriVVXFfU68V7pgOkTJ9NkQXehgm8byv8I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpbXgcEOjuqEZaqFD27b4rbG0i19WezuLqjVVkhCGjfA&oe=6AE8A4EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjtof2bbWkcQ7kNvwGFDlCa&_nc_oc=Adq1avwsDmywFQ1M72O28gCLfVusbktFdxQkpoq1oKGnLNAz5c-0PwqoOWnu-XgA7JI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3N0c6LQbVY3vBO9WOG_ufjlKbWYEaMlUPDwcr8n0Fzg&oe=6AE89ABA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsIgVkWe9skQ7kNvwE69NJl&_nc_oc=AdqaOhX-MnbDATcA_WmD7vl_ivS2Ccq1mFJopl3HpezZuhbmMXpxRHEw0fMSS5wwouM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtAH_70TsjAINm9nVwvjm7NXWxUgdShGgXz2vSxQf11w&oe=6AE8B992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEpy1EXAgSQQ7kNvwFF1S0_&_nc_oc=AdoDJL0d-_6bsL5psButwZpwPT-TDptGdqL9XHDWU-TAi03urcPAczSXLpXNjbn5DHo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuTrKq338l6rCPrFTXMV38CaQNP5vUHuD5Ay2oYGhTcA&oe=6AE8B72F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
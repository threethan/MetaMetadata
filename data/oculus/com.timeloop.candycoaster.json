pcEx97gQ7kNvwGBizkU&_nc_oc=AdqcwM9s_X3-ScjGujhv2BiOk2AsXBumHTXiUNh2zSO17ESxhCOKTDldbBPpMk9u36w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JhTKQEXk7cxElamWQGDVi6IxrvT-tu56EX2hPET-AyA&oe=6A11C06C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4-ZBDlb3Z4Q7kNvwGnp71_&_nc_oc=Adq9u4ncKWj9bj0e_V4SNW4kqC9mMQeDsolDIbUVO6hW7OgB0pNQLX495B4gwZgJJ2w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sh2ypODOGorKlLgrP-T_a72txV_DDAYuPbGRx3ts0qA&oe=6A11C06A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iiuw4esCuqAQ7kNvwGMTr1W&_nc_oc=AdpOR3nSrDx-F9hxHSxQ_dhUWSyhuYim7izjHQ6pAIsAAHptBMkgVNRt5cFWGtMdfWc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OVLPJk3R3PQNjM2H_RB9ksxY0Xw71zoTTWA-_IMl5zQ&oe=6A11B63A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJ6KU5W09BMQ7kNvwE0smpa&_nc_oc=Adr2Q0q4Y0k7je1f7l7z95kzhjYaKE3Ik0HRaqDY1zpXiy-eE5tnZ4LzdA4DBADBX3Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C6OywEzaKYfC6NBkSrYja7ECUOAchKdwVZbTLoBgq3g&oe=6A119CD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRnpY1YbXbcQ7kNvwFbU3l0&_nc_oc=AdpF4UtvRiz84gyRsXS9sKRbbAq8_GIUSRfY5BFBZiZt8DsKXOHan09_VxDZeOWY80I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ETMxijux8LldqEyCYE-4Ow1vLmmifOw-w4sdz4VMCdw&oe=6A119A6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENT
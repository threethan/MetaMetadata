VMQ7kNvwGSda0y&_nc_oc=AdpOcO8fcGJHo7rxQ-cOIxLC1FYtvfSNhl_fn_82cgm6d21UXMD7j-5icwlCjJsHgfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvAE6tSvWCmNt8IZNB-3lsMKwpGZ-bZRqAMvMsmG-Thw&oe=6AB145EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4rgtkikyEQQ7kNvwHV5ZFB&_nc_oc=AdotgTRiegsen1gyecMRCjvV8ilovjO9es7TUabjXMS4_vbGVkkQyuE-uGxe8Vn_ps0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7sdZbQx_NtLoTJ4ZXaju5_bW3EtLpmM1NPQWFIpA_iw&oe=6AB145EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcJ2TWf8slEQ7kNvwFrdOLn&_nc_oc=Adq4zC-c_rIm3mh6tfklrnKtAeSWX1-l3IFpMzUoEMB6Lg_zjseHSnpAeEISASxz1Jg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLJsZIg_SK8E0mk5CUFL8zbS7gcbRFFrc4MNDo6mkgvQ&oe=6AB13BBA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPau6WjFg8sQ7kNvwF6KnVP&_nc_oc=AdrmBMZ0RCZrhi2gQZ_6Wowe_zgwL28WWhUhOADT-EhhDLBRTzsxmhwnuwr-wt_FbP4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt8q94wuuL9KulJfeh3iB_04H3NtictzzSNcYP7ee3lQ&oe=6AB15A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7DzZCmXtiEQ7kNvwHC61fY&_nc_oc=AdosQi28OMS_rdVY7Q9AYsq-3MDyDa0OxrcKiYPtYjN57pSbqPV8hPex7N3WIvUF6fw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILHUSX_Ksa0e697EZ287kp3Ue1WF4XWyFgxPXyKHro_g&oe=6AB1582F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
hAQ7kNvwHjAdOX&_nc_oc=AdohiBSTkJrR7qustfqEcpOWlyW6U5jV5PnSG-Pdd7Iv8G-qu0WPP6hozdRlQIic9-Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXFGySix4MeG6pML1jMU-xTkln2M3-7Yw61blUmSDfPw&oe=69CFD56C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTR9JHkaoWEQ7kNvwG7GADT&_nc_oc=AdqliJU2pWB7OhbhrCM6_n6vbHVqnAklvlTou-8I4rz6iP_uQVFnwxSYR6508HomUN4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYNICn8U6NRe7CQG-Ef1fL-OXMDxauL6ZXXq4A3Dm_EQ&oe=69CFD56A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfJJAZ74gjoQ7kNvwFxPm6H&_nc_oc=AdpN6klPufPdXD7YHkla3tJLNvFRakutPfDITjzj2_Cx2Xj0xj6MQydhbiIZTOm0kYw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyavqOZqlaTK3tx3yM3gqoOcHjm-oRzWCR3gui5jBYAFg&oe=69CFCB3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjAiz7tA-ccQ7kNvwHqYo10&_nc_oc=AdrYkWI3G_ItbKsSqU99AeBnsrNi3-npN1IKf88HtulemdmgWjpgnRrjxezcNHLWl_Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXMXj5SUold_pjmcxsprpRf2Y-Fi17eKN9Vg7u3fz7iw&oe=69CFB1D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZIMj0DFhEsQ7kNvwFRpUAT&_nc_oc=Adp0KvrE5qvWnnePMfQnwfuNgUxM3JXopWst3MPEYYIbaWdShgElU593Wh6qvaja7H4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWZpq2hMZhiB8Veyp293MzvFIA9fRSIz_58kjBsFDAAw&oe=69CFAF6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
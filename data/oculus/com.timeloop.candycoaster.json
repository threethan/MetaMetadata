k8Q7kNvwEo-dz8&_nc_oc=Adqv8J-EnzKh0LFU6kWMkC4b5yabPcGuEng39X4WmIi1ISlAMU0-rbBwTm8Rd6FycmE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4_6fyHa8Jg0-XNyyqlnnGG65oRx1_oQmVbwOOO7fZ2w&oe=6A6DD12C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wra89Wp2yfcQ7kNvwE2qOlO&_nc_oc=Ado2qI4cbEH8Z9vUh8QpfVU5tRo2uQTj3VYeM6aI9jPCC30xgObDx-bK_7mqlhZT-m4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0UPMrpB3dN0y8Y6yjachplauR48-jd2B2FHGP12Rlwg&oe=6A6DD12A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfxKI3P5VBcQ7kNvwElwRnE&_nc_oc=AdqF0Lfyl-j2bbT3Sfa8I8hkJmNk6FDj4h91TrdzvytUYE4CHqTHK6ftF_XemI0zQ9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlpFXz4OUEOvsBCNKxaab-fF7HTaM4AHXF9gBg0TFT7w&oe=6A6DFF3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ak7oj6IQQa8Q7kNvwH4ihzH&_nc_oc=AdrDy5x7YKM2uvSazu5wM_LQd2B_tfOgzK_iiyWGDTO5e3qjuCIYrh2OpaeOavxEKTI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJE0IPCc4d3LGq2jzrl9GfcOdMpiuq9-YFxJIwkOixlA&oe=6A6DE5D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBlqezZy_ZsQ7kNvwH4yJt7&_nc_oc=Adq8BWAvo_X1oQe129Ctd7Ve4lk8rbUPy9bCipzj57fPOzVpWX5s6AaOhSaAMQD0zeM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlqlY4RMkwOhiOiXwPogY-VQwPJrhZ8amE672MnC-R6g&oe=6A6DE36F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
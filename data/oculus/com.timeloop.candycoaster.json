e4Q7kNvwFZAukh&_nc_oc=AdqwCgTzov9P1wdAI5zkI2qU86Jns-mgOnOGiPFvfypy7VXbl_TmKcS1Opqdpp9VXK8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVDqwTb6jwEqDeSSmJHmgsJ-c8y-6wusKY7CV6BpNvOw&oe=6A5CE5EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9FKZ7b2iLQQ7kNvwGuGLLg&_nc_oc=AdqtE185YjbTGNG-hWmnnFhGO6WqvT1bC4Ou75J_GneSiIzpnzNBpF7qp6uWOWhdrok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtRnlxrt9Drc0rMhRO49vBFGwJSYUb6zqGQH20EDbeSQ&oe=6A5CE5EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDWYh0VNNRIQ7kNvwGU-hYG&_nc_oc=AdqV02KeXpaE8Y3-8uGenvvsGWnP_J-ElouVqygtK6bzrddvCKXYbOYOFfEbxHgbGLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwVEPC-6A5H6EIiE0tWcUiZ6nClTrJdxL9SH4bkIRc3w&oe=6A5CDBBA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaPCdem5CjgQ7kNvwEEOkLv&_nc_oc=AdoqEVr9QMfDgmCUl2wOdMuLzehPkdM_kYQXzvVOjkg03PtOEyREzAc0Hp8BA19IwN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9qq5ri2eCVToXjcJInJD_YfJPYor0vZPgzfmZg9xkzQ&oe=6A5CC252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa3Tmzyy49AQ7kNvwGPWMMT&_nc_oc=AdoZiDpw9TIq68nStOKlBkw2JwnyUrB4Ioi8JByYNot92mEt5w-0AXDgfD1edcOUdRQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiU7h7lFDD3Q5TerssEJuOYqmR7YlmHVbTYuv2AjJRPg&oe=6A5CBFEF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
fYQ7kNvwEV5CfL&_nc_oc=AdrJTxrIw7PlebvTYswH6samluG_OQPsmCEehNyBtW1Oe3_nCfrA5rtMFqlkVq2_0IE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49bPvg5BacyKmYH7HWHJ_iKJ_FU03k5kFWIuxE1lgnEQ&oe=6A05E2EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJRNu8Nq2FQQ7kNvwGAaA3y&_nc_oc=AdqRt3pPHMsJokdvGKEcHZSqVff79x11gBBKgD0VM2MyAoNToLjlHJCLY5Q_9N8bU5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Kgn7raTMVsRvxQRxA9bIWR4Dz8d8zYzpDKWAJANzjMA&oe=6A05E2EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMxGCf-hBCoQ7kNvwELZKoh&_nc_oc=AdqB__u3g7ttCX2KmVBvjOuDeYbQkmTZh8lKNR49blE_arddFibfACWdgDLnVKGtmwk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KkIFGsRwcZ73tYNnxxQrREZlxH7SnBQ98ti4vxAqE_g&oe=6A05D8BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6TaVNK1UzkQ7kNvwFoHX23&_nc_oc=AdqbgIAEjmSUfLaekSJ9_LNsAmQvK1URRHuFS0DKDGLaTJObRWZh1WjotgI_J17T_78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a5iXfL-qjvJgoSAQ0tXdsVnJWYUrOQ4AdQphOqyldlA&oe=6A05BF52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hinyikR-wYoQ7kNvwGgh-aN&_nc_oc=AdqxhHPu8D6NVdvdWcnU1n6gWv5KJ951fx0CTuDlK19jNjPFMQcgNXd0oLQVFKxS8Tg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69FtiO4QVgnaIcAMYnXGUYbxV0s64hje5MCRA6qJbSZQ&oe=6A05BCEF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
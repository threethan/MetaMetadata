OcQ7kNvwFcH4mr&_nc_oc=AdpIBPQKo1SSUE_QMw_Vof5WjHzUpzpU44oBMEA-W9ykwlskTO_DxxEUR69KGRNqrnw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CeeP4YdNb8DqFwuZ0xPJG8rS9Qv3CRxjdRsoI80Q4kQ&oe=69EE27EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdgOjGUOPgEQ7kNvwHaPV7m&_nc_oc=Adrp3OQXgeaN7lxc1mxTRGipiHHQ6pqtZ4bfQtuzC1mW9C-viI0u1UZ99B38lbTw55I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CxcGKvMYI9S7qwpzjhnyZSEHgQKBg9_mdsrvY5kcZ_Q&oe=69EE27EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xXk2lM_hoUQ7kNvwFddwfI&_nc_oc=Adq66HphdE97XyARk9pR2-BviyLAVSEBuXwDgSaQH9G329KN-tVhEKvV30RcBrkKLII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_LFmUgtAbkGlVlZqUz32j1IUQydU8L8MzKWVn5fL4ug&oe=69EE1DBA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhXr8X0Q6TMQ7kNvwGWheRt&_nc_oc=Ado7_cZNElRHPCLwa54B-Q7QDs91XFPSDUPQO04TpxdNCbfX8SlPqO6gNp-kNR4AVLE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1orvZOk1LmTyps_BWm0w_wEqGGHop7yjGZp5ogOuWtrA&oe=69EE0452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dygvqfnyyUQ7kNvwGQd562&_nc_oc=AdoFZnydWjG7UXuF5JD6NjjoWFBBQOXs8Wo7mpvLR9q0bjocBmfR2CVSbzqOo6b0mpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RdtdwSXxMbBzbaLpqntKDnYwVk1KW5IcpMnYUK3r6bA&oe=69EE01EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
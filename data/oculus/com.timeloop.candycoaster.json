GgQ7kNvwHUXLUg&_nc_oc=AdoOpmB_XQOQQTULDJh1H1DUKJKK-L3WN6SxRnl3N5fMqkDAJR2OSG6rKMpPapc3HMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ5OUCkAv1zoEwXHyj6OQn8c9zdAKDCMB9vsy2Nw3q4Q&oe=6ACF986C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu0IuCarpq4Q7kNvwF6Lap2&_nc_oc=AdqFk-vcXIxhClXD6aDhQTlO-RFw0Di_IWA4t44_O_WbyA2LB9H_SW9qzeMXzUuZNNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh1T_D6N1mgtuH9p3JA24giBRucPu1purRWqzxTRmP-g&oe=6ACF986A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1glRE3xp9XgQ7kNvwHVMbax&_nc_oc=AdpZ28zrwbjHhA4Slez7B8c34JgAmOuW-dGkEkTF8cDUZZAEe7zj372fiGrZi4ySUrQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW5gcbfaka76DgUtuwqZ6-6lEPw67nYFgZVRFU9xgvPQ&oe=6ACF8E3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6X_GsRFgcbkQ7kNvwHhh7P0&_nc_oc=AdrhrF9FYlCZ4hgbuXfg60QwBX_knOXdPth92E21AV7ivC3omMGRmYkwu0QSPg-qG00&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuaYeb7SPVX1KKijrCDhPTd12VMU_Sl9bO1LlF4SzIWQ&oe=6ACFAD12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InfWKXy490gQ7kNvwHXt3Yo&_nc_oc=Ado4WuvXYRlQdkoe93oFEpfFdJooOMTVANPUrHaf3iBYkEQJbMLnD-V5WhC3z-SLL-U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYtwiwWfxTLsmFpPB_wmOW0UwKc_XEWWGIs9abNL2dcg&oe=6ACFAAAF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
EUODBZtJ__yRxCSaxBr0ZGjdar69LTn_XPnllFoJWk00dLHn-1F-iQBYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqU1gDUeIDLTgnZdsfYqTsWwI1u3sMy4ajUnK_R78u6g&oe=69BC0EEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkUwIioguR4Q7kNvwEZFShq&_nc_oc=Adm0KkuqaAfu1QbCUue083VKZo83OevW8DW4FkKKGCj9-XQSyzUfGDEYLnu4D6Cguuk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxeNX5svRZpoROpasfNoTTCevU90yHcG2qnL_t69S_zMw&oe=69BC0EEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3__GNoV4DQQ7kNvwGPiAuB&_nc_oc=AdkeQnuYn6WNcaKRNFdibeqPYcdt-Qfb1eO4FCee2Fkv9dkAbTD0fuSUV9O0aWpIJ1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy56hQzUtWNWoyr9UZetXzf4c7CpCTnBaGm2dvo4N5JYg&oe=69BC04BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NewK01bZTiUQ7kNvwHRX2Zb&_nc_oc=Adkcvm2Xqb2vZbg_fHOAmJ_bKVO23u7K9wEMS2_5GaroTzq7isyvPsbGpsGWqyeGR_I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyXlvHi4IdbDCJFq9B13txCvRCX9bQYik0UKFnD2RUcmw&oe=69BBEB52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dotvRjCR2DkQ7kNvwHbqv0J&_nc_oc=AdnkD7dK8KOxMS1UOJXHvlb7Lew82-HPI1-9sD0WJvrPhg0I1fKPZ7qglE9Bat2hzQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEeglLlzb1ax9lZLPBDuvNOIIoZfmVsXoxS9vEgCur8Q&oe=69BBE8EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfor
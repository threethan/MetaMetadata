P4Q7kNvwHYgOM-&_nc_oc=AdqQ75yP4Exd5RejYH9pVVn4i_3Lxp08QwPqV7D0hDhYKeyjsSJtU3wXmMK_gzV9jRs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rHx9mb2lmJbRoYcJl-D5CWOcpcGYGJ36-5iVbn0ZWag&oe=6A24356C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwKG96yyfBsQ7kNvwE8bMJP&_nc_oc=Adql9t6Rk_Zud7SlbzLW2DE5-esTCi2aJ9QHDXfzcMdnDyg1Bdq0rGMcwxiYPhIXUzw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89bwSgqJThcoVaCF2J1ax9Z50gChWRni2RhV0F4e_NsA&oe=6A24356A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZTyzes-5HMQ7kNvwGymASi&_nc_oc=AdoNtykDwWHOpDmgW9mXjwgeRMex1SkY67fq7bC7Owc64xRpKLoEKV0VTw-ldwMK560&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96USHozQ1rk22LAxg6jqUD8yopZdw5kNMNkssBXSu6yw&oe=6A242B3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxciAg3US_kQ7kNvwGPoBSV&_nc_oc=AdpokAjxM9JTm9Bb6g4ra4SKgiXvUvnRzuqa3EGilgPaq2yLHhTPTFNDBXcqSx0DWMo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zRCMNMD6lOKvLPCzKCAi6wLGr4m0Qp1Sk5EhQfBGv6Q&oe=6A244A12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pae71vQc62EQ7kNvwHsON6B&_nc_oc=Adry0H0yQpzjKY3WxwOwMlwFVGCxWpky-gAokaWYwioSCs-RKWcAVlJdRiyKwxeFqyI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EfSWPA5QkNasTX2PDgVJEUnQt7NDzNBXg_FVXXdMnUg&oe=6A2447AF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
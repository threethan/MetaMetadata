fYQ7kNvwEKoP9N&_nc_oc=AdpFmEc7cYxkaUQq0uiVbcyZapfBICyCsac756apWEp5kKZ6VthiENR8_0eQXiKE1m4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7to_cbrelbWzi6MdFmDLJsiC7AkkkO3mi-o3n-8atT5w&oe=6A04916C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1x_63q3FDAwQ7kNvwEM5xSP&_nc_oc=AdqWFDuO6HN6zWxdZq1lIKP2w24EVIQa2A8rS_KWWg3Z8pTfzsqXeEAXbxJeYY4pc18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X4TrMknlJYDkPRHaQuOL7JiP_S2Ju1rrvQglFIdVp2Q&oe=6A04916A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMxGCf-hBCoQ7kNvwH6pXL2&_nc_oc=Adoxp37ITpjvLa1DLpgnBUE2Y8xmPVuuz1XSeTdR8rolN9HdkEVrflFVKT3z7qfT1QY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fvKg0y4vNt5r18YRunkHvCgwkWcOMgBJxKyTb4fdXKw&oe=6A04873A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b20DkLS9MKMQ7kNvwGv1Kfu&_nc_oc=AdqtiH8N6jLCblZ7c5USDuLikCtMU8bcbHfJFz1GkZInsf1_qyc4dcYs31930mu2AQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WSiXfUCcX6dQs3CnX7oJ-b80F0Cw_fJ8Pz5tQTGlZtA&oe=6A046DD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hinyikR-wYoQ7kNvwHSSmcw&_nc_oc=AdosgXVRW77nfwTi3jmhhHPWR6QDzlM5Jc3yqTBQLevuWQpcGeehGSBPHvGqX7A2v5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UJxtF2e5LJUF8S4Lz2EFZ6UuLeug0ldjtSHpoyXnbMQ&oe=6A046B6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
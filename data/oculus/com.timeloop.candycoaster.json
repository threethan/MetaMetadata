vgQ7kNvwE4kbT4&_nc_oc=Adpxrni9TTuAMMRip4kimqqJKdh99q-q37Rj8NCS-UaNuKNXKuav6gZK2xhq2dQqg6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2_WFlrSoTgymxx3_F3yT_SpFZuj2zY5BdI8STs8BYcw&oe=6AE7536C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QV5IrieA30cQ7kNvwEczePA&_nc_oc=AdpfNT_HYundrO2IzmKZTw4vzmn8nYk1W0n608dChFgplPi1Yobtau8L4rIpeLxkRiw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6FTrdLE4xqQdOZw2Ewst3sL8Xb8k6CF6K6Rq6GMg60A&oe=6AE7536A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXBUmllVTaUQ7kNvwFVMoPn&_nc_oc=Adrv9NBZjEvW_a7onMeWnYEDupMzalXILoc3W3PmL3wJG7FJSY0b_1IoJS2c2WtsQ7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuiYwVm2h_l4lMtEm9oKIx-llzhzfvYF2HoeK4VAEgCw&oe=6AE7493A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsIgVkWe9skQ7kNvwGT0amq&_nc_oc=AdpubaR1XXXOn7fb8NP3Y5oGEhWk7K_Xx8J1yCP_FPBEfi2-Spl4LGDkF4XbhteI7iE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCa4-d8dR1SEkTFzzg7WJqTJitAESOh4p-DVyMOx4YMg&oe=6AE76812"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB2r0DlmrBcQ7kNvwHvwclX&_nc_oc=Adpg-oTZWk6slbiP2y3ith_L3mcgA-1jxVQAuUA-8XE3-1zTDFpMUXGNiAC0nU1aEws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrpDAc4K1ktDvANFgS55PVXdZ0Y1MBZhu8xNWRW1HjyA&oe=6AE765AF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
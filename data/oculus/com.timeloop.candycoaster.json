8oQ7kNvwFkG9Nj&_nc_oc=AdrYXTu1LWyo44FjukEX1Gty7LsgNG7qQQk-PmPHI-efXuZ1c0ejldc_oCXPvcdbWsc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UIg2VicpbLujzE_o-vpsOx1dLNto5eIkV68SOwSi3uQ&oe=69E24A6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWZL9_1aDV8Q7kNvwGdN6bm&_nc_oc=AdoIxLXKdPqWN94EKtpJ9IzaWCEpJbZNpdah6H2KfpE_ZZI7y8HV90C8meaHIRnODqc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jY-hbSbSivCKo1TBFTpO3Y0JL7YVaNvlNsGJY36_BHQ&oe=69E24A6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7lOFVGxav4Q7kNvwFTuhJw&_nc_oc=Adpc2Ji9IsGPFG-1aPH4Sv0tdxd_4BwZ17rWDO9tgpbwf1NjCkVnDAVNjafUQBt6of0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sAx6t4Tw0WvbsbPmS30XrjXBK5m69FqAuQ3IVL4DBuQ&oe=69E2403A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8neZr3NTc8Q7kNvwHs08BW&_nc_oc=AdooV5dLzJ4raa0M9RjLg3KIODihlkZbE04JfvkizNxpYmcZQLwsMhmqfsliBEew9Jw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af117hz16Grij3S26I5IP7KtgK4UMCnVyDaRjm75xpt9wQ&oe=69E226D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0C2XLPuDl6AQ7kNvwHq9_t5&_nc_oc=AdqUiy_FsN9Cao5KeG6sDdjzxnV8_NLjX8zsUKgxifq0lH0YvSHO5nZdJuZZvI6X5MQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0N7dKiIVxmwaAQOYlWwAQ0SkOeVOHBb5EdhNXf9vzBVw&oe=69E2246F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
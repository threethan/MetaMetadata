40Q7kNvwGt24RP&_nc_oc=AdqnRpySPErn5VlTHLaM09mVU2beLYDVUtx7Ti_No_YlYg5obvbNq5AI2MYiTQjkfbw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gfKqL85SBJhsYhSZpV-3tS5JxeQNDG0KKXsC5JWruPQ&oe=6A3D41EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8jSgmEjBOkQ7kNvwEgfo7O&_nc_oc=AdpRa6lCphX2QLl-oQ6kjXYE0jtACV0hsm0qBwiCY_o49B4anEDZHLpMvj97DK11vLc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94XXDaf0CgiU7FzDsGBJH3ihXCmvIK15L3C4P_yJ4JDQ&oe=6A3D41EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oNtJYY06v0Q7kNvwGX7Oad&_nc_oc=Adov0cfmEvhga3_QWIDygSzrj1gpieY580jecVJr1RXQOyB2PJhvfwCcE3vGSiS2HJE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k5hYo9vfpYFNzD1UawjnPecnRHj_6nJMqxjTw3usYDQ&oe=6A3D37BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfWavkssqKMQ7kNvwHMfslK&_nc_oc=AdqxDLkeUN21UbHzLiIE86funC7-cSnxraakD3ifXNPRJhRBG70h6GXm0cHyinWjHZY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86p87gSvjJ0K_8e-sHm68vrUnDJcAbzFo26-8GS44UoA&oe=6A3D5692"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcO2TqW3qqsQ7kNvwEW9pyU&_nc_oc=Adq29Q21CtfawT_u7BRJMvrw0HGNxO_r9oOcntKmjDw7dTY8eqWooCtpKVrrWDfqV0Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3IRTz8AaCtltkiEpzyLDFE-ndPafpWvXpN5HCuGlKrQ&oe=6A3D542F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
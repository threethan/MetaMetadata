0AQ7kNvwHYOnxL&_nc_oc=Adopihw0Aw20wzOBU57wHNYRaGwaZ4O_3j3l0a_HTajEz7o_Asmckro08B7AXLw02No&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Yx4tEIwNTA09ZktfTfM9kDfIlmKUI7ix_GWoqvMGswA&oe=6A1EEF6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSb7CB29rDoQ7kNvwFikdaZ&_nc_oc=AdrJAMEyDoiK5SE384VgnkD3ihKyYEbuLTSELIUeQDdt2B5VRey5ILgk-BC2T3wVhuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a6CUPp_debW2njFnJCFF-ZHCPAd2deHE71xmiQFaYGA&oe=6A1EEF6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yB0-xJLknzUQ7kNvwEQr1KQ&_nc_oc=AdowzpAi0JSjYfSSkMnSUSvNNfH2NHeNWsnWRyj782yWA_Na3q8ykaUuZNUxfvPKbGo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t6Msgasd1sarOza5K2-yZ-aBsER_k2N25PbsYqmvmHA&oe=6A1EE53A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgndySpZBZYQ7kNvwG-EJXC&_nc_oc=AdqdY9KlwbZFac5WOHGBwWoeT13p56eYz8FXKVYJpiShL4LZ0ABLeXu2hV0iBtWG-ao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74ICWIl3TYMs4fR013svqwle0jYaoJ01hY3Bsn2Abf6A&oe=6A1ECBD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jf7WA1EkgYYQ7kNvwFGl1uO&_nc_oc=AdqVOHj7Qo73Iu8GSjQRg-ZAJLD497gsAeSEyY3ogKvmYVTk2C73nNZGiJPUPDpzoHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fymXq65SPHahRrlYaQEs30ofFjrsdkM9F0KqjL6w3zw&oe=6A1EC96F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
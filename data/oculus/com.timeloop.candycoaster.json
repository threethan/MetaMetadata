40Q7kNvwHjdLf9&_nc_oc=AdoC6vAx5VPghWdaNAwvA9tbjbSW72RR5j-5C7aILbcNlEIcVY63WSoaf8muMZGA4UY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QMp0pSaCwfE0_0zNFUgWyhZn3J-ZAS-MHy-4vYhua6Q&oe=6A3BF06C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xq-DlflAkaAQ7kNvwESvMH-&_nc_oc=AdqBfuAcpX-2nuizEBWklqXjtXq0Q2rXEEK_sqV7uIdVsyOcLZO6SquZOAOpboBmXoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2H2ZSbzic_7V79zbaRa-i6JrIHhS8U3ldVWqmoEbJfw&oe=6A3BF06A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oNtJYY06v0Q7kNvwFnOQkm&_nc_oc=AdrtVtygKsRIEwUd4OOjII_uyE5mGUpEAnVucMMgh-ymR4qPuXvKoBIESt1HGvC3p5Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84rbK_9FTaurb04R-lco3c4r3Z9GnEYUWZAWIEIhnhqQ&oe=6A3BE63A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGMK9_lryqcQ7kNvwFAzS_s&_nc_oc=AdrqGCLdyHN3b3hdIinFelEddePNrvCnQa1K71Q9g5zLR-bRmzhzK3COvqbdzNI6gYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CSiihv-lKw_8BCiFKZo5krjGunadxQM47HfaABNoIbA&oe=6A3BCCD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcO2TqW3qqsQ7kNvwEEkXpN&_nc_oc=AdqyLleooI42aaxZU1l4wHBh-hDsW1op8-ca5d18RDAYZQTVQ-xuNN3ImeWkAJL5EXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m2NZ9lC7YZ1lLPu7eHcJrEs-3BwaYLt3VmJorZ8Ztog&oe=6A3BCA6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
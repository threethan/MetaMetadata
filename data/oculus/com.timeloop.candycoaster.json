ggQ7kNvwGb_ZnH&_nc_oc=AdrVDVxSYTb0o6ixxiB4NWGhjrZBNI-P92JTognb5sNV_EjcSnq_HTkkdnu9ltxhe8A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gFEqYbjotoXAEe_U4CoA8tSOcYL-vbUtruKfR94MTOg&oe=69E63EEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-zW6Ufd3dIQ7kNvwGG5ava&_nc_oc=AdpX_OFLHO86PYS_1Sysr-QkymF-epOUT4W0peOGoJLMc34rrqsWd5sZbO57lbdtiJE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MM5rC0htkhxeKT736igPiZ2rrS1WSziiY8qcR6DvPEw&oe=69E63EEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPaX5jFg7WMQ7kNvwFeSOHX&_nc_oc=Adp8-DMzuYiez5IqjSaDTgagE6lj8K3wZHF7HueCVmiLwa19a4IfIjwQorrjdFHxyBI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39YQ2eyP0Uy3_91vacCfcF8J144t8TA50BEohdmmM4Ww&oe=69E634BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=434mOSUWi4EQ7kNvwFstDJc&_nc_oc=AdoaLck-uOH2VZ9A9_epE_0ar9o9jJhDbjiOM-2AVGVxlf1_Gy__u3fpp_J6oK2DJqQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02ZwMakbr6R14DYWcimJ6T-g9FXedyfW10hRmPxor-5w&oe=69E61B52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WJZeb4ITV8Q7kNvwHg-Yy1&_nc_oc=Adq9K4KY7eUtLWAlM4f8-7UsDyTYdWOX38Q7kaHY8AFP-NQCxiAILiqwrsO2rqsYadw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FdkUk0VhE_l8yCdXiXxBwisa_SjLS3eaeXi7Zxm235w&oe=69E618EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
e4Q7kNvwFeu56E&_nc_oc=AdqxcEFZaZKmiWXlMONqSpL8KyroSxkR5vyD0IO7uSc2b4dK-UW3E7mrfb219FMaYwI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_WCjd2KwT1g_dDZ6Gr0q69Wa2sihKaT30X2OrukKBPA&oe=6A5B946C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgOCoA00RacQ7kNvwGUBxXd&_nc_oc=AdoCbsHU2AX-slhV8OfxKpyt2tvda_aDsLOhAavhNOjCVOxcUFS8_L1pJjSRq_XE3sM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHwasqb6juYOQzmVT94nY038bq2vyXAqYt7xBMyQXzKg&oe=6A5B946A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDWYh0VNNRIQ7kNvwGc92V-&_nc_oc=AdqYqJ_TnvYKn1oal5_TILgEPl6fpDn-jGNSzLPPy7xBIjnfW_fYW9mqTt19qGz2imk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHG-vmQAgLwTYT_oVicbEf7bGhKgvHm9Equj6RworlQQ&oe=6A5B8A3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6YmXlV4aZQQ7kNvwFgzOQA&_nc_oc=AdoM7k2FNuwAn_68IQEeVtycu1ans7RQKcJ2PTfSJPKnrR-p5wTEgQud8uS8Cxl6QBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYHLkOgFRuXMfhVFMBfhPQlLFfpzl2Lqgbmo-EX0UElw&oe=6A5B70D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa3Tmzyy49AQ7kNvwHIyfgw&_nc_oc=AdqO9bVqcsQtWh98zKfeAm1AjfCI473qkoloEVlnr8gjXXLHLjCT2iK_L8Ni3g6gQ5A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3trC8Rs8rKQnny4BHd7sr4OpdPSUwXRPU0oDlh84MOA&oe=6A5B6E6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
2wQ7kNvwEBfxU6&_nc_oc=Adr7Khx5Jfv4Sfp_D__IlqSNapZdJ2TgsPhFIab6lZz-OKVHQ-PprWTFzIAWn7r8eDI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M07xyWBiDZdWnuHceSyV4NkgGq0NPdgKF-YTQCMUySQ&oe=69D90FEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93o9mBrOqg0Q7kNvwGIt4GA&_nc_oc=Adqh_ngri8Nk_ifRk67l_g1MkdSXZA_baQWUomuWkz4x3zQ_fwrsFAjI4trl2oHl_Ak&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af070F5AKoNOT2y6F1NhK5uwEF9TFkHkkeyS1odrhTJjUg&oe=69D90FEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPJZ1k4zwQ0Q7kNvwEax8EU&_nc_oc=AdrRpcSuHcY8C5Osbkji9yAg964p49HSXLWpCDrA8rIwwy2Jan_j9l-pL2on9-VJUsQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qmC7qBzs3085X3K-T37mCwFaQwoty3ytmmkQ1Es-0-Q&oe=69D905BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq2pxT5ereMQ7kNvwE4DoKS&_nc_oc=Adr4TuZEXQIPlXnBavSdhzupY5L1oCGORcbbM51_oDfBNftcAss21L7x4vObIJxGfww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wLwk8ArprV2bz4arBLk-FFREiGw0g7-nsXcz1vYL4JQ&oe=69D8EC52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI-v8uPIwaYQ7kNvwHmTTxd&_nc_oc=AdqFh8zIhsvAxGErakqybVLk_8m7sjyy5Lv7UVHuqJJwMvFOJLM-kg3ifhwkATxaHZw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39-hjeTK_DsxuFUoDt9MfLS6Kh9Jd0-K93ZcVwAnud8A&oe=69D8E9EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
7AQ7kNvwEJgFYb&_nc_oc=Adp2bkM96aiaHfIEHSRBCt2XAEWLUt26Ls28vaFO3Bs1LDNIFA0VdZ5qDPwJsnR-TiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1ObYpvI1SMxPCLD-I3VXpmC3y5sd04IOIEdIQuE_tWw&oe=6AD23B6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu0IuCarpq4Q7kNvwHekKP4&_nc_oc=AdrptWfqtG6RtZbVBfQKx5_smYH5WptUA4kqV1Z22wzXyV4-rs5Yxoi6tuhSgtT4jOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZT8Chk5hFkBSFG03ZMe3Bkfi-gM771HbaB5DmVBfoOw&oe=6AD23B6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zLPaXilp9IQ7kNvwEHuW_l&_nc_oc=Adp9kOUjNhd2WylG6oRfa3UIPIPOjsQt0hII9KiyWbnCNetQa5KqZhDQGF2XCjnyQtA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXGGDcw-hNLcdHA2Cst4Ik1KQSJ4t9meRFvJkFwnrVnQ&oe=6AD2313A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6X_GsRFgcbkQ7kNvwFS3dj1&_nc_oc=AdrltDfMG_7eO-qgOlagd168uW9quELgQ1sl2A2F02kaIbjiBiktSnja6tEejUorncA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObHObNxDP-hqniFOF98DjM6ZPn4Ab-mL-vbQdG7EtzFA&oe=6AD25012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGvdGRtGWyIQ7kNvwGDYyaU&_nc_oc=Adoau27GerYJ7IH9oUBH6p6HJrOrXMqH7n3nUyq95zNaCviYzf92TA7AW4QRkJfo15c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhtnWUh3vlc78R-LpGn04Yz1CYqDs7rv5PqicpITCfCQ&oe=6AD24DAF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
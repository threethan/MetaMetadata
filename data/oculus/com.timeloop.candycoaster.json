QcQ7kNvwGPdche&_nc_oc=AdrIaVezPGyTzydve3wTffOgQdAof0gC1CEcxk3IoknD99X5dIg1z5N7dPakFN-SaSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzr-v7dv2Z1qKqhQhdauM0bFaN-RVjqfphONcxL3cTsIg&oe=69CA572C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1_OFCRHkDsQ7kNvwETiT90&_nc_oc=AdoTJ2KHs3xw2f1LMPx1goJzSVOEYN7tEcQ6_gJ1n2uY3bzWUXRUYeAe964NvBGmCog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxctn_TTBR4JF3ahkgIiC5eweAd_VxYot9HFY5YV6pDWQ&oe=69CA572A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYRSgBe1W9sQ7kNvwHXbl2Y&_nc_oc=AdrHhyQWJXoTq4h7qFIIrQG9m8REDRx-xChw7ur5iYSm7hXlcEvZPt6jsAPZJZIiekw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2UN3zPagrSGMXmQbqFMRWRsT71wICFG6XGZc4s2k-gA&oe=69CA853A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pAkKmmIT9IQ7kNvwEBVrf8&_nc_oc=AdqmEhFqdCZcoTOW-rQE33dJRG-JC_iLEYhPSrqBtphShSFT8fpoSrnxOCbjpdNC5ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxl6EyxFiXCgUZOTsYzQ4I7CnYeyPhvZffArAllrcWWgA&oe=69CA6BD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fxlnTUuSHQQ7kNvwHrb_Oz&_nc_oc=AdoT-h0VUbcpIUTb0CV1gZ7t3aVCklYfkuUyjG36lbIFpMFpN1Ibim0we9dWmnbMnfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRFLOEpHgCR1KDyEvrY_md-i9sqTY0iZia_7ljIsEOIw&oe=69CA696F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
W0Q7kNvwFJSvAv&_nc_oc=AdpfvdrDY3wDYxgdx5kbES7pFmSunAKCcfZHM7JtkVUABeNNslBq7qnIkmp44t4jEog&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJnt2P35JjxACiWdfZImG55cTfwFZ-RfZUgRIPa3TORA&oe=6A53AB6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoJiZhSq_OUQ7kNvwEHAMdb&_nc_oc=Adr0uM54YEhtJKr56ZB-w7vAmOIJu7StY8RS1in_KhP-40b867mFtUtB3StZQdrsT40&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDV6kyBovHMNBQ0DTZM6nrW7uawDII4hU4yHChUjQLt2Q&oe=6A53AB6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suZUoRur1rkQ7kNvwGKW0-s&_nc_oc=Adrk7wxVb2BSHTgZTb6w5RKdFdXGHaagMUEG-KcNMpGHCyQi0i0Cu32SMgBJPnFQfZY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATEMWns61OaEH1XR6H1tZj62H6AWJT8lAVmX9b2gBYCQ&oe=6A53A13A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bPhy-aezL8Q7kNvwFXJ-aS&_nc_oc=AdqiL1Atkxxbzeha0gonZhk2fVk2_vbSGSu6OxdBBZLtr_HdF6HkwlbDfX3Mhz-GLro&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_akhS8zIDv-Qc4ghh0k2mbJAAmBXsF8UI46lGGkNH9A&oe=6A5387D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-_Fwx-BivcQ7kNvwEnbqUV&_nc_oc=Adovp-H2A2ybMDn9yPfnJeelQQwWNRNxuAH2u3FuHzlD3_vO93TG0_UpfVh-sO1s9MY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8n0LObfZW3_9cSnxU3e0mcq6lmA9UBwroIC3XrL-ZDA&oe=6A53856F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
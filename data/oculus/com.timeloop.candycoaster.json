gQQ7kNvwH-u5wK&_nc_oc=AdrAYIijBWXrmvlah4Q0znBYp1R3DT52okUR4LTghZ-kgAxGPhGtUFoRJX2xcqKWgOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ca5-6M1LOszjhvdw4b8OgzEy2QF-BjXESBNAJGByJ0w&oe=69FF4B6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoXA_BiVgTsQ7kNvwFWw-jc&_nc_oc=AdoSKSicIJLnT9ZKz6rhzZswgwnsM1nGYevTzNyP9sxf1cBSqjJ4WxlBBGYreXvyKOk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CCUKDVgQr7RD-W2Rgk3mBgEpnUw1wgzhIE6hUaBbxCQ&oe=69FF4B6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6Opt0RUgf4Q7kNvwGPmX7d&_nc_oc=Adpld3KKLaXJSzHbzXneui0wIwX5dl8L36VWzURFfo8rNvaKS7ZQsbsSompcCJAsi_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49Jab0ORcYFBPmZtrd74d-tkjK8HrzuEwxVobETcvaVg&oe=69FF413A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGFFRgSfykgQ7kNvwHN6_ne&_nc_oc=AdrM-mogb38qe9u99-lCAXyPnaTdXS4dAD77kL3EQ0gknI8fYXJLqj1kCndSZvxNmYU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nOfyLEUolF4DejgX_MOpPDmdT-InyjX4qqeTV_RkHTA&oe=69FF27D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Db8roeILS3kQ7kNvwHixRRa&_nc_oc=AdotA19Pqi5caWQzE4Nvp9RlsZG_J6eFEV7NnyqHsh0b3xDjvdjkZsKKeItuqJmffgA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k5KuyGs8pBlkau4X9LftK2KkvUvQWHmzjnKIMrI3F4A&oe=69FF256F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
4MQ7kNvwEtrekz&_nc_oc=AdqkyFBjb_URylhf4aRo91QgaYEOUw8Q4P9GtwlrtEbgf4NjGBe--2GT0vzaQzKLn1E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsAN7xwNaM45Bu4bp0ykIYkM6XSZvC1Hmtwuy8-sznXw&oe=6A7C51AC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLNTdalOIY8Q7kNvwHLi1wD&_nc_oc=Adp9txG7xruU16sI7EqgWX_cv7EyIAxyfThjbgX4OGBKlvcEZ6YnsnDp60tH5YKEX9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvM-GBdT9v7LhbsxZAz31SLZiLrNav3DD6qtTEXbaV7g&oe=6A7C51AA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0-Ywtw17RUQ7kNvwHWEmff&_nc_oc=Adpu4EoGy7zbejbapFJzRyf5RZIr6VL2N-XQX1BiUAbz_EUXlJrs9IyeD7lHzPNbbYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOACuWziWg_JER5RpoEBYtxi0anfAxDMEYwxI3hKR2fA&oe=6A7C477A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pB8ItluAygQ7kNvwG2CNOH&_nc_oc=AdpT_VREcQCaWKj6ek9HqnocZi_8hUG9-10QOwr01abvBgZNLL3-4C66wHS5If630mU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRqoviLgg5RYdHNsfqHGqaycg5e0ouGVeQ7dOSemcAlQ&oe=6A7C6652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybIl680SQ2IQ7kNvwHGgQZI&_nc_oc=AdrFNxNj98RW97zSaoYWVdftJS0Xo8WcQfgIKXQu4VZiSpVsMRjZLCCUb-TUMs5agEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCcxMrue7H0udXA93uRGN4BX4mksZOsaT6ZjqJqC2b1w&oe=6A7C63EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
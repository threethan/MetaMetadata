N8Q7kNvwH_UUu4&_nc_oc=AdosSKiCCVuJIPGLnydk6CTmgnSnml9nh1gGcGkFKP6KTZwac7GalGtgU57rTru0SDg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEztoT_gDSCm8SV5jq620D3Fcp0UjjYgwXiTX07_4RnQ&oe=6AF9C86C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOMLQg7UHK8Q7kNvwHmsyzu&_nc_oc=AdoSUS1YMkF5VRUrpIwH-5SCSy-OtVd1Fs3i-pJxFm9ASzBUx627XkgQXgYRqY7TO6k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQIo9qXKDAkpGJ4G8PHezRWfmyRUYcsXbatCLv3wnTAA&oe=6AF9C86A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcMaFd6FuLAQ7kNvwHimVMi&_nc_oc=AdrbPtcooa6Tx8NqXq5tdOODnoQMFo63qlDpeClOS0kbWYEUalOYqzo7Vc7X_Jf0BLM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0vmOAMcGUMWUoSj0704Hmwq23iHpWjeKSPkqnupptHg&oe=6AF9BE3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFRNbXdnJo8Q7kNvwHlJFkl&_nc_oc=AdrQcAkt5lFBAfuYeZq41PlY2lPjszhCi1utZl7wvufA2X62Bv6BIjXjJb_v59mgmu8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaeIH2RvAQhPcJbyUGwo4qW8SF7SoOl62sSx8OYyAyNg&oe=6AF9DD12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0QcI-QCqrcQ7kNvwERLJ_O&_nc_oc=AdrOQn1PYln73QkEzvuROvJw4NNBbswMU1q4Bak53T1xUYlNvgHYHPpOctj0fST43L8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD1oS89ABSvtpqOl7q4Q9ORzGSlwsC3T1kKQ5nL9uxxA&oe=6AF9DAAF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
DkQ7kNvwGv9wbb&_nc_oc=Adpuutbbnzc_vgUi-DjfSJrwgFbiH887Z2JvGGNrMk20lRgwZq0K_xdxrAskF2QUmeU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JMPYDubC0J8Ovyk1_q8MFAI-SsnZFjKlNFiLFzDaIyw&oe=6A31646C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2FAfnj0JRwQ7kNvwHLZIRd&_nc_oc=AdomuF1jdhIikvEAWbMcQ1kmIyOjXe_8yMLbFtza0sH28O76NHzDygCnqDwr7KcSNVU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hVgAi3mMeRCSlhER5IFlzYi5Il18g1ZCuWiBVAscEUA&oe=6A31646A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CojEfVtr2Q4Q7kNvwGXr44_&_nc_oc=Adqw7Ab-Bw311OXh0fZrUu_HjdjdQugzIwS4iFdXyEZ76WOZSdZMdPzhCABhycWpIjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-cXklXH2UeNMFwJUnqujuBiaEuTs3-Zstp2CpesvWVw&oe=6A315A3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDJakMGMSwcQ7kNvwHEDEYU&_nc_oc=Adq_CPbnQfVVp1u_eVRdRCrDEOzgxIKF_am1PVWjrLO61yIkFkZTfAbLaqtvjAqAy0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aRYnVRcwfZRnk0BOFCPitwzxzwZ8P4OneEJX4LesJ2g&oe=6A317912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLHNQYzo_SgQ7kNvwGutXys&_nc_oc=AdrPgUHuEWSLDbp1hV8-fAlYQsqxTbAmURZG4qdXqgRFMCo9oMz92kMAEP2UyYv-C-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rUmUuLqcWwmckSsGHOFvwWMikbtB6XF_GBG0j-2oPxA&oe=6A3176AF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
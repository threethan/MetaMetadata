l4Q7kNvwEzyEkg&_nc_oc=AdpVm76fV9wmyhy49PMSlcaTQGlXHiJwyq2MiQeQnMoGCugFcAOLT8xkueQQ9ukhud0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdvGJ_ijCPIfsPiLxLIb1tAXKYgbc2vt5zMwiwA_dOJA&oe=6A5E376C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9FKZ7b2iLQQ7kNvwE3zLDY&_nc_oc=Adoi72yFFeF2vKYqWNJpvsimtH4KcxnITfke-ZQOCT1G77MGGdJhZHbgB3X4t-8rmXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFdMSIFuDxs7_qP1wgiGj3x53CNDQ6FRhCG6K3vI4Vrg&oe=6A5E376A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7E2bFjLSxMQ7kNvwG_y255&_nc_oc=AdoifetRB33ln7XgRTnE30zYdDkjvdzgh-QTmaGEGmryeTfmNYMdtGtlLxwUYwct6CU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2-3yiSmuzKRYM87mHsPOrOPmzMeXqIWNKiazSy68vuQ&oe=6A5E2D3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaPCdem5CjgQ7kNvwFw2BOk&_nc_oc=AdrLnfxj1pb1jkh5LobFpDjE4pK_AR7iCiBb7b8ocb0ZVTCt8-WFFzAnIh0aGOQSdmM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIY9b898sXzSeeXnKMjJicVMx6xvymCE-L9lTZvRbCiA&oe=6A5E13D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGtaWIqpg_MQ7kNvwHyUehq&_nc_oc=AdrZOaAmy37JegWCjlzviOuL-txesWlnLe0PE5Qo0ylUE9xW4Z-Zle9azSYP1CYEKVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEwl7W0iUjWVXY0yQTThWS8Iv5-y-k0KzqP_SGQcfEXg&oe=6A5E116F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
YgQ7kNvwFPoVI9&_nc_oc=Adpu7RBmB0fVW8g_WlyIrq29h2izSHqzmlj_GUY1R1OTflfvWtaiaJOoBo4JOzcCEcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjkp50xe5i5Y3_5MyPAd0X3JPca91sO5OCXizsgTtgAw&oe=6A770BAC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYip2vgGzb4Q7kNvwFtr2AV&_nc_oc=AdrRh6KFFUWHdbBwSQ-i3UxkxgGeBN5F4IgZMbd7IEH9nBV1QlDBEimSEYSufkcoBgo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGvSkfECfW-JiGd7QWF3d7myjT4Dy5Wz-5J9zne68jKQ&oe=6A770BAA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Js4sHFNTVRYQ7kNvwEjkvCx&_nc_oc=AdqChZ1AO_gkTz4OJpgcXoElD5gVjSuLIkEypRvUEVdmPvx8540HwvLMEU3Af-Ru60o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsgVHBiuvvGziydbV5cL6hJOdWiOKMnDKl6YxBQwc5gg&oe=6A7739BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7Lz3AKxHOIQ7kNvwHv3YgV&_nc_oc=Adq4modhflpSMUwailnVN_bSLYoyNMXm8INymyyszPbzJ14iUHJtQWo7vwarP5yL6Do&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuIrBaCSy4TkxiIFWBaifvlejrcedHc8BEfZ_ptXORVQ&oe=6A772052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THi41PKR3EIQ7kNvwF7wYMH&_nc_oc=AdrDiF4Jervg5ZaD3fjcDqxqtMC5o1e0QlGLvc213oKj1ydDG6-ozGoNlJ3p3KgzKFA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCMK2S4J4l-UJzC-EDpvQOlPTlfLpHOQIPtIrlGrBQ5g&oe=6A771DEF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
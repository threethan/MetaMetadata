A8Q7kNvwEltW-U&_nc_oc=Ado0ds_WQMOeYKCIJ3_8SfZKHhFEFD_Hb39b3YGcegJPdmHrgTJpeDxKgdYxU-8rE-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HVm1Sx3vZXUaCamVFdQfylHQwvGV_lHdbc3mZWEdvGQ&oe=6A47CDEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOGXsgQlRsgQ7kNvwEyKWeO&_nc_oc=AdrszGiG_n3XL1BZM-Isht7a92Jn3_BezeAHwLu0ONJd4P_VnaL6NWapssCnq9FyEdQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-70AME8JSjtIYNNv60n7NgO_edh08ZYcSyDM5XV5wDMA&oe=6A47CDEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skSpcq4RDt8Q7kNvwHO0__1&_nc_oc=Adox6a8MeE7gwSLzQHlo-Us5_rvCH6ozhx_0CItmGGWMlpVZvZncUk5MC-kOk8FXcwE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TP83X7Q51XIylpN1NL0Tw8rf2wyS4kXpmb6AJuAtXAg&oe=6A47C3BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOtldHZrlqwQ7kNvwFp9W3h&_nc_oc=AdqcPoNoPUNtZR8BKoad6qylEwUNYVz3JR2NKrk_to_j8SvIrlmXU3gCRG-RG_8fBg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SjavdP-RofGqK1Js7TXKjydKt9gX5VhcKiLSAPIiWng&oe=6A47E292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlSMCWDpLsAQ7kNvwF1qdZD&_nc_oc=AdokiksAxT4LSmEJPd8ufNCNxW3nAgJmRxmoa6DVZuV7dl8oqsOOfAd0kW2XBFUBoaI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nhrYjq8o_WWlX0fo-_NU5ZAmXZsF_0WzWAKq_WUzFBQ&oe=6A47E02F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
vUQ7kNvwGOe-Ir&_nc_oc=Adpu-llBQ4Rip8stW4NvyV5QO1NIFMcaME2t7cnMOQq8z5f-370qM36OgDWZnz2kLaQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UfSd2Oq_CES-RwuZtehe5PMnPiLNFP7p02ZwKuzGp3g&oe=6A09D76C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybMYA8kU4bIQ7kNvwEPDLvf&_nc_oc=AdpLmhZu_i_TBfH2846EvviRBq4XsFzzRB-3IBZGHOfiffRmfxBLTDi4w5Q-t8cTQjU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56AKj4icHKUorfpX04uMQWuIOZ-aBSmPzZrG21QJ1oew&oe=6A09D76A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49ON3NwdG0oQ7kNvwHUFAWx&_nc_oc=Ado6KsI_2zC9dN23NVTcaTp_lhS92RNVyf5n1eE6bI1C-C2MNPbjmaiFWnOcfBourfM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TQGBdRN42u095BrkPsK6ZJ2zXKReacb6MaQ3drmXXtA&oe=6A09CD3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_dSyS8TFOMQ7kNvwFHThgP&_nc_oc=AdpggVVWa9K9gyCv42zFdbP07vk3VZCH_8823nuiQl7160ybt0xZan5rw2RCQQDjQPY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4owvKhqFNT3x-sqt4Pm6mWE1z4n-PBemoCKNP9CRB7gw&oe=6A09B3D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfQZV0DWCqEQ7kNvwGKHdqH&_nc_oc=AdpLm6IXZoJ7dnV08pfxfsxEVKV22OFGEfhNY12yW6mRGD28QB5Vled2McV0WxJtAb4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MGZvHeStcbuTMhFhlDt5AYDkrshbhe3dQH-0sJc1YhQ&oe=6A09B16F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
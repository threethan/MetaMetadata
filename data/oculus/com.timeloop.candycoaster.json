64Q7kNvwEtHcLI&_nc_oc=AdrzYyXQxKxHq1lDk883XOBijQ_QGc8WEdwnMqF4NGIgN-oO8dYToz6-pPyIlMkgs1Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyksd-DCiLQs0ER3Ku-xxRJuR_2d01e6vv1X1jMtwbLQ&oe=6AA173EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojmuC_Nc7DAQ7kNvwHqw-wI&_nc_oc=AdooYgAQEzHiOkfHYmZF69OdoOXquIxDdwHVO44MTEFp2_VlQJSKnPo5rDZHbaCg3VM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJy68wjK7jSqKHdsxKWQGbgS0V5a7AGlusdbsLmySCZMQ&oe=6AA173EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqa57VlRFmsQ7kNvwFFCQ3N&_nc_oc=Adr0sm0biBd8etVlIclGR-sQF-gEVT1oFy8178VPdq44ZboKVX2qY4qKbns3pRmjg-c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4iCeSGIwg69JKbjF4A8D_B27hSKsvBn189sA-64tCBg&oe=6AA169BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXNu7sKhUWQQ7kNvwHwFoPS&_nc_oc=AdrnEgDMhUo0wCMgUjtH-x5XJh33qYROkRUkZQ6xgfxei23h8_1iFpNuNaho1NpgX3k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnI6Ur3097eAiKd34LGZOV2gEAc_eVjKBNLL1YtwO_vw&oe=6AA15052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VWzYHvX39MQ7kNvwHarfXY&_nc_oc=AdoJ-Y6LY6j7nrtAtmdYpK-z8sB17SPYGd16kkp48sr-RMEzJa3YdIKqoChMMGnxzEY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGcU5V03DwuZYpDAmIC2Hp2iJaqh6t36qxZ7mOHQFjnw&oe=6AA14DEF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
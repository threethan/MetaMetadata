uwQ7kNvwG4rMAx&_nc_oc=AdriK_HzEh6k6mk92myN3q8GFUZXutvjsBWGX0YxCqg1N5R0iWYWAfm5pCDWG2hyKRQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwc_xo-H3Y9TaxbPAFXyopJkcjl_Vy6VUJiTGSvCrMQA&oe=6A80462C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyMLJ9ZB2fQQ7kNvwFQnEYC&_nc_oc=AdqPFUMMNjJok8l07tMmAVnZac6sjedCBsYl0nEf-D__8FgtiUmm1EWQfEQY9_D1uw4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6owqgjyhXfzVvHrRlJEjmDCGeLi1QHgIC3BQHyrS4Sg&oe=6A80462A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkWAphMYXtgQ7kNvwHDMkgn&_nc_oc=AdpWR506E0cqu0rV6Q5bjRnAo4knnQ686V6kCDjb5-Er0GWKTeHt0V-m7TAygpLLLQE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbnMOjqtkibK0-1j36CdVSBmSgEgNl2jYgdOgBge4RPA&oe=6A80743A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDIMCqSLFEYQ7kNvwHGyNXE&_nc_oc=Adri6Ia5gTAGt8pvMPH0KAA01TG6hdiOoBMpfqV2xwcmhb1AaYSUjxVr0ySlhltZLFM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHacWJZO3Dqbj6pBgCSxxFOZJLHHXO0ANVBO89XoZwv6A&oe=6A805AD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5NznrE_wwoQ7kNvwGDgJm3&_nc_oc=AdojciwCWBFR8Pt6DQ34yWuc9nJhUpR3LadHkPyEfWO_HlOI0qQFXxyvaxwMDOK4wQc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPHuyZP27LMKEnu4Pe6zc5PrXh6fAeGpbLOfT4_jA3fg&oe=6A80586F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
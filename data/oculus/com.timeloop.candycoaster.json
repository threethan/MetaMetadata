A8Q7kNvwEjHehv&_nc_oc=AdpqZxL3IAYVfFoLK5Md8RY5JB_M4OeFhYSaYuVSs12KLRyjDt2tJc0kp-C9vVg5FAU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfMtAujL_TjdWIq-dt4pYGt3oIWgIptgg9m5_LYwC2yg&oe=6AE20D6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQmguMfT3dMQ7kNvwE0Sgzu&_nc_oc=AdpMf0bkg13Pn4wXNYTdZTSvjFchaDySt_sBRMK6AFjkVO0bsatRHBGfeEFPWs9bc4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdcnmSXWYt7JGlWEZiwLj-_TFHUxpL5fZDmjMqnSfFnQ&oe=6AE20D6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zevM1LxhVd8Q7kNvwHakvRI&_nc_oc=AdryCi99l2YpMojjapfnZ4_wVJk9GIb4ObI-nudvSksMsawHvmg30B6wzxSsLpCOUhU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjDmf4faQOURuqYDLITV7hrUUIKWw1YblaXho22hUrTQ&oe=6AE2033A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuNn0EOAjCwQ7kNvwGeEUHA&_nc_oc=AdrAWEYBpojHfSFCWUgnk6iYh86ndvWUBxMQif-03g0I7pnHiVOk_7BWq0bmoaXMtVY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8b6bFt-G3EP2i83BM6WwMDw6yrV8GTSNMhpO8rv8l0w&oe=6AE1E9D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqcOiQ1GjCwQ7kNvwFO4bDL&_nc_oc=AdoJvVuuoZU4jGUrejkL7fCa5VFa4HHU3PvKrOjHi1IVT0SmYhVtyl2NbIYbn2kf1UU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoa1-xMqIwAc50OQjuixIM5Y7DY8k0d5M9dhUrtxbXxQ&oe=6AE1E76F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
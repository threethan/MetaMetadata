W8Q7kNvwElPfu3&_nc_oc=Adp2RuASGRN1gZ86G5_CfDD7sPQYtvTRJBDsS5BEHTJEoVrlsGHBj5tF1i1qYpPU-sE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ3obEePenP5r2WFeQZ9nfG9U9wgjuqYSubUoZJV4xpQ&oe=6ABA806C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KG6x13pJIMQ7kNvwE3C2EV&_nc_oc=AdoOYHvAf5ML66-SNlHbmuC_Stxc96XFBwO5OkKtL46UDryhomxrN94_nZ1U7ZHfIj8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8gk0E7HR8WXQUNUlWdIPqhbK3FHtF_kVkEdoWRDINWg&oe=6ABA806A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGeSRmE8EjEQ7kNvwFM-MCv&_nc_oc=AdqOQX6pFeA-BlKZNlSetT8dwBOsjVH3OxO6jNdAapHCNLZXJPjwXZmyqbyHfxsygkI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYq0BSMlRURRKHmQsyO-yBrhcXu86lpKAeBv6o9UmNiQ&oe=6ABA763A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13yv_K61bW8Q7kNvwGVP3gP&_nc_oc=AdqR01Fp-byFa2l4_mj33P7crZJf1Syugx8BRx0RaLTwNAlf2hPQBcDsBJXVzOVjdzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfNfegZNUh3UmR-GldPIkJQHzC8KiEnoNZDCa7LDeIbw&oe=6ABA5CD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICT-qtIZvDgQ7kNvwEdi6BU&_nc_oc=AdracOEOdCGXF2NLiyvsVYHTuUqLCevSxhuZx2TRt19MYrGa-r8DjSyrkq2O6HIOtUQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA43xmtsWcdvIIGyoQPYw3Eq4fWx_EIj6j9uOpq5WB8w&oe=6ABA5A6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
-0Q7kNvwERW9ku&_nc_oc=AdqJGttyYXwkxg20kwPIxdeoPLh0A5m4JSPfmF4vQjxK5ZDHKMvihn_eA1ZdZOhBIFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VYaj6-JfWBnlRTNHdpYadrJ_kyEX4hBPjlLfl-eamwg&oe=6A43D96C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlsmaNx8-iYQ7kNvwE42yOt&_nc_oc=Adq3WI6SIdIgfjePijTWoa5K2QJgX6_pvqYrUiOe725OIuUQBPMAT7KL0T96Y2ASl44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rdu8UQ5sEdzll9GYGvUXmUxSgjH7DJgUlOPz8nUmV_A&oe=6A43D96A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSS505ohi7UQ7kNvwFL5ihZ&_nc_oc=Ado-Ksekt-lGSSJvORjjDp4aOgIfWRApO6M0lufO9XgDYAsvqLnE30VOlmJsynBk8X8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9shYfx0IVatW0ElaUm_EzLOuXpBQNC9UbWbUGCQI2z4g&oe=6A43CF3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIC11rrczaAQ7kNvwFx0wDN&_nc_oc=AdpeKbb_cCu2TwPkurF1lqOHi6J2W4_XfupkHQEcR6APmT3ehiVu4JP7-DM8POpJdn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gp32fQwxYbtJla4HeEidSpS2X3j5tPhtGFHbAGvkSxQ&oe=6A43EE12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VS5m3ekNYwwQ7kNvwGjcw69&_nc_oc=Adryl_0OqOZZ2qq_PvPNsPAxNblkgjD0h39A0N_DsalHxmsUOzuP7hp1V7oZfYCXfe8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uEs-P82OJk4BIDV_bPe5ILlM6RNBnGCijVkvEyRzIlw&oe=6A43EBAF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
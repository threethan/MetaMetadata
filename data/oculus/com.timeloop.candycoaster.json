5cQ7kNvwElG3FN&_nc_oc=AdpNrRf2mRdraAPJJWGa7wptnYSZX_FZovAtcbJBojZ8rwXdxzzQ-iaUrN7m8rMyVAw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WB_Z41LPdVmdUQCivA9igAGPsoE-nCqgSJCSeEFt9Hw&oe=6A2ACCEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XNueA58Ul0Q7kNvwEnUuw2&_nc_oc=AdqTbk-3D_LcdYF5O4vLcmpespTzLw9bzxSZqc0qpXgedhMSi3tqG6E3yZxcBlHYINI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L9zp7rORV_hCudno6SxjR6jBM7RmWPqdsCjm1-Ywrag&oe=6A2ACCEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHdmNJHuG5YQ7kNvwFn_qdB&_nc_oc=Adq3ic9x-nDiAjmxjOXtDLNm0Rwdyk7faK6H2NCEkQ5FcDsu-8Jd6byaBVx21AUu3Jo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PhfIg7_gyZaadR5Eh6LE0cdb2zrML7JOi_Ofrzu7p-A&oe=6A2AC2BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5i5DY_YCfcQ7kNvwGTj95_&_nc_oc=AdoRUH1w3jmMKLnGElqfwKsWmxrqM6JFKewIUxe2kmkGCiHWf7KfitOMxxPeuQJI3h8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wyBdvRRhT0DbaaSzWbAPU1P9cGkfVhNvLoZIzxPxCUw&oe=6A2AE192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC0S_gyf25QQ7kNvwETYhH5&_nc_oc=AdrIgt5ricsDHhocyba623lAsr98PLLBk2MQALuXgLzbBFB_RHZkNg_w0Fjj2qEPet0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-UTAXAkDTuCNKGE-1Op_wZ4Tazm4Hcbq57V79ntLqgg&oe=6A2ADF2F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
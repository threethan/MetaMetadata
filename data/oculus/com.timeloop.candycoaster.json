f8Q7kNvwEhn-Ow&_nc_oc=Adpawh-6ZIvWUabB-BCSW1cTst2s0JnrshT39UJBZWBeuKaw8hmvHoz7nCmZgIMIBFs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v5wqDKFwwRkmavdcIwf5avo5X7MozUuAbNJyK9o-NzA&oe=6A0B28EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybMYA8kU4bIQ7kNvwFvEflS&_nc_oc=AdrN6_6nl0ENr6rLz1K-BqDldFGWW2up7QaDMOpyXhxRuLwqCFXNSqFZyjYSVu_FuA0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YhNJrS5eqC__f9vkrZNxmcg1i6lR6J5j2-871v4Hnnw&oe=6A0B28EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMQmRX7F6pEQ7kNvwFFWJcL&_nc_oc=AdpxMDApuRTLejwvmQdR5im8PTO336s93mBRM4YphOjVHnXdWYRsoWM8FK078q_ugKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nHaXljBkEL39G1yJiU-HZeszLvEslhUtLkwP9Ku9cNQ&oe=6A0B1EBA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_dSyS8TFOMQ7kNvwEVtauX&_nc_oc=AdoEzILE4r7bpoRqVprHJyb8d22e4PDryDV-lYLQMBI3QbfpftWTSNp5kq33eDYDcVI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50BODpKOPfIz_0W6H5NKOcibnV9_mC3JMlWnGUdOWetg&oe=6A0B0552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_6IuKy-ydkQ7kNvwEahYIZ&_nc_oc=Adoqs8MNoy3GGWVkNUqtxM6FIDSXrqwg7uba02d1g5Ns-toefTTyWTF4NlOZmjUx9ZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FFrIQvct1MjaMld-uaXPb0NG1DPfh-PfRz8-HoObyjw&oe=6A0B02EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
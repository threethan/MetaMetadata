3MQ7kNvwHIQxiR&_nc_oc=Adrg4udp3gxyUY07zk9JYce80hnWgxo9ATIaM5fdCXbK6r195_2s_ruOOXMjGotfOhs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcYhEoZEBNPF043GXKpKEKrbeiY7tKUDzGHMZKt2q6Ag&oe=6AAD516C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJR85DO527sQ7kNvwH3cYSr&_nc_oc=AdoDt9s9ke1Ie5_jCs-5UWabZT_mHWBFxWfW6DLkA-3moX2R_qqcJc6g9xVRwv9VHZU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjmBx9fgXSNpDPbZzU-ktZiLeuKWfg_Y6w1VQCmzifGA&oe=6AAD516A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSCNmcdglRIQ7kNvwFdBG3t&_nc_oc=AdoKwG-T8gOPpVWAeodZbsAVy3khbXaOSkPwkOf0y82pfXu9m07hmEdbNt-NzmtO-Cg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI44nS4bS9GzN3teUNzAGjG1lgeeltIcTecUVw-tcSZTw&oe=6AAD473A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2w6G85PZlcQ7kNvwFLy4yM&_nc_oc=AdpYpJjvgVEuOPKzQWPNzVpvVcaQJDblaKszf1H8Pz7VxYB4xYoOIRvzx7Nnpr1v_IA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsmiID4d7lV0ernRXzcLgTf45LL8LBBDt4ZXZL_EAqPA&oe=6AAD2DD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C35VJfuXY0AQ7kNvwEPC3nK&_nc_oc=AdqY8UrHEZ1a0RSesSNljY7FKbfjZt81kT2D8nXe8kx5MaI5BCXpGndel3UXvqy7X8g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGA_YaOAd8c4evbn7RFgD9F1oJszpoq3A4foRQ31FhBQ&oe=6AAD63AF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
04Q7kNvwG1MjGj&_nc_oc=AdoVRE_QjqhTXETlWUKEzG7u9A8wY0ep61GtJ4f_eTB8LetAhxRtx1k_ip-lNMmYx_w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjnR5EjFw5sdVfLI31DvEc7eIuQwbw2dwuO2gjohHZLA&oe=6A68C36C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbU7FkQfDuMQ7kNvwFouCVP&_nc_oc=AdoCl9T7ZODkgH0XA9_MWnNjN7zudrpJkZTR4VgD1Tla2eyK3xpSk--LqTkEuDGspBI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA32AXepE3DTqY30GgGVJtio0TV3HkFNypoDRaiqn3Gww&oe=6A68C36A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIUShrSxIGgQ7kNvwGPluUK&_nc_oc=AdoSkhXCyTcrhf1yzubvpljeoNiKNSbX-0ZKqhiu8klfRA0RkWw_S6UZc5tYG5GttS4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCN_dfMS1Ogog1khMUOIkmRXXiP3D85j09c65vz_nRvUQ&oe=6A68B93A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=774iPEt2Oe8Q7kNvwHzaGLT&_nc_oc=Adp9e9sBqfp2dpK9FOBR7Cx9-aeylyjzOcoq2lslGlLQA0YIEGM6-eDd89NtwnLnU2A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxsx4JNdXygvbLlMBSJQlwiDaWq7GkfY8qou5193FSfw&oe=6A689FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xnf2cEFTkT4Q7kNvwEmi6EB&_nc_oc=Adp6_wXqY53ZBwPafPEuqJqiyPMZi6akV1gnEoHLsx1fxNjf8mefQd1p2wLmkjRO4mc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwM5MluXBi6nRFKSv3KXq35hzLFSuBMxz9FaU4hZRT3Q&oe=6A689D6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
YgQ7kNvwGqVLo4&_nc_oc=AdqFee8Oqz2vOUpA_WPakNNHBrtboLm75--r0-CkW2renIHXyDfGs2ciNTU_kNmOzIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8y0NQebMOP0r18kVTeiJUfKVdkHxDCohVo-8NUfPRVQ&oe=6A78956C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-M7ClKf2JgQ7kNvwEUGUvs&_nc_oc=AdqD6JbBx7X5IrnkCd3Cgwwt1_rnhwddwoUtbpj29RcgQPuGZMrVHxFPpXNSSt-9G_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSxd0wCR5GhK-BjUsmU9OFTR4lua4gVja8Kpi8p5mrkw&oe=6A78956A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Js4sHFNTVRYQ7kNvwGqN9EI&_nc_oc=Adq1R_rqzppcf2YKfODRui-Zr4UdrVyHFaXRXvtZPfkDFL8f1S_twr1kq_-wG0bdL3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk_fukquqR1xA_muPv7Gr5ukuxgxLgriK38eNsA39cKA&oe=6A788B3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9pvhoP9bfgQ7kNvwEPtJVs&_nc_oc=Adp3mBYX9cHm8Ww7f-5EwtNPbB6OzsArOZz4ft-B3HGbSRhSegMrqtvWY2IaPPOkSBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMfsqbDhDwM1rpyZcfPZ3sLcFjtCrsIHFIZF4AhdsCEA&oe=6A7871D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THi41PKR3EIQ7kNvwGov7OR&_nc_oc=AdrWh_3E0N4hUSKWqYZwoJkCPwunkio-eVlytd7nsHpAt7zGxlLgHmcZpECgm4JT9HU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhKwnIHDx1VpGNC3HRRnLtQEB33mRipEJBGqda4NgVMw&oe=6A786F6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
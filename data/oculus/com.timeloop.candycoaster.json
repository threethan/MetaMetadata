M4Ouu4UzCxNcmAPFlwqXTsucEqRvM22H4up2aFdVSGJ8Ao69cF1GfxY-8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsksJ0IIpY74zt-A5oCamPdMJOSHnOIA2sxFSrF_p4H0A&oe=69A961AC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mv1YOQjl9j4Q7kNvwFvtjmn&_nc_oc=Adkx7afc1oGlmv6n6cHo42o_K9_mgrTu45fUXVfqfKnPhI6Jws4JVl7gY-dfRnJXmOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftpd5ctyA3ZAKnSkAWmRmnDeCK9WM87b650FA94CUhE4Q&oe=69A961AA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUGLpC_qoU8Q7kNvwHjxoaG&_nc_oc=Adn-OkuPzByLNdlc0zY2B1W6Okij1XxgjIvGshtL8yUY7h3xzQRglWBL4lmQBlYFsj0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aftogx76cWi8WHoHCFdUBMf_G3B-og4CKfhznfBsAoRwHA&oe=69A98FBA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tf4tMFLCmGMQ7kNvwE6Tqzq&_nc_oc=AdljwvtzqhR-wLeHEVP5Xzo8AW9NhKvJoYeaG5GMlzFUMyu02ls_qJsllLuVoPdkiI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afsilogh1N35-lKcUT9Y4zj1zLtj0DYmkh2rCIh50ZonqQ&oe=69A97652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7MAZRn5P2QQ7kNvwHclRRA&_nc_oc=Adk7qehttyW5o6UB6uB0cr84d2fSxuBFcMTDhT_pwUQKnPyEOYyF3UMpk6zGtnNMRDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfurvElMoTbbb3PqnRRufAm-joowr5K_EshAJ9eawtP0mg&oe=69A973EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfor
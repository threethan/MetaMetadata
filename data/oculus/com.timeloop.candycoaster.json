k8Q7kNvwFAE0CP&_nc_oc=AdoE5o354S1JYVa2ukyGSDQjZTMVZba1lugMEnmxdfuCcI6q7AjdzNPlwy8wLcElHN8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBhb-7DeofN9-2AiwqctMQL15jouLKjPsG8vQcFyxCvA&oe=6A6F5AEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wra89Wp2yfcQ7kNvwFXxCaz&_nc_oc=AdqV9wheryrBM2SAyNfSeeH6RC7GjQDulVvXvHSfB64LybxLY8EErYHhDak6-sVpbkY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPih4_93WOdxIXhCT54XuGs7_uuO6PWWPF5h9RudkCyg&oe=6A6F5AEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfxKI3P5VBcQ7kNvwFvSlY8&_nc_oc=AdoJKoEMjkptUFqD0_svTyDdVjKfQgY68OdAOCQ7ZSkF54RKXkIqbVwoGQ_KkSRl1f4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmwMGaphOJHCWlUZTMgwgfY0HLNboIJojBXZiA_NPt5A&oe=6A6F50BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ak7oj6IQQa8Q7kNvwF-sLRe&_nc_oc=AdpPMYGgeZFry2tzKYee5fzcrkLhhXijr17KIJbuOxyzeNYXkCPWPQUA6OSlxJlWprA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxId2T5FzPsJzAf-8bzuRNuDhGgcbGi5wP8K5oCzl7aQ&oe=6A6F3752"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBlqezZy_ZsQ7kNvwG8a2sm&_nc_oc=AdqUF1Y8BzUzwluZzv8VP0FlvMX1DRTPtDYqpU3q4aAFJbaB7jMrj2fdcC0b8n17B9o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS5CuCru64gY_bngvdOGQ5uMfPs6fQQms5b7ImY3sMAA&oe=6A6F34EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
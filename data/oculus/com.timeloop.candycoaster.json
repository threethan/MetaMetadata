4QQ7kNvwFdzNVF&_nc_oc=Adqdcs4FictygRtJnv10_XgplO8ydDayKEFDlbByDL0MNMJ2htaLTVF0wyPt_dPeyEM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzLR9k6O1DU8r2ycuFUAU-NwKI5ig4KfBjePpZjI_aDA&oe=6A86DDAC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbNidlKG7LwQ7kNvwE1B7ua&_nc_oc=Adqfu01Fd_dZWD5LMSHlRRXjAdR8wnt5odgRLEh_SKW5QSqfKg6e2zQdEtTPHpCg4Ic&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXh7EhuKDOdu6skuoEjeYxj4LXNy_u4OkpurM9SoSUIA&oe=6A86DDAA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCKkju8TVbMQ7kNvwG8ZTXC&_nc_oc=Adp5eNy-MnBKO2FMvKa2xe2jzQzExqFhWm_89ZZjJJWrTj1__HSRwFYCJAN1J2Q_ACI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl-DMw-OtmZlxcn74VUzK-lQuaozDfvY443KIY2gYoRQ&oe=6A86D37A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cagUf0W2OacQ7kNvwEm_uja&_nc_oc=Ado3m2T-t7oTQXqbBDVgOoixhcMxwRnqA0eK1CB6nemNbhcZaVMaxgs6Fiqd2C0Osd4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLVHXPtoDHHfx8PNrdDc97LYR5m64J9nyO_C10swgTaA&oe=6A86F252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pvd0M-dpK4gQ7kNvwFQ15sf&_nc_oc=AdqluUVXPjOjS66YrMAHI89bXONx4JZ_gKFJO6Asqmo84UtjDGjc0tOjizdUvzlGNh0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4tEWQp2gPOWbQTB4EGIFxF47SLnDQbb30ZHAC87N5tg&oe=6A86EFEF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
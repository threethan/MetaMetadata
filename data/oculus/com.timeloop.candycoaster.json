d8Q7kNvwHKTaCq&_nc_oc=AdqPFFRU8XbE9q6GGNDukLj5sQZs_cgF4uKlX9HWT2pW0DYSPjt5aKSnZVYkeIOOevo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhX654By8pPLyshswscD8IU6aU4LrNTSY6dqvJLn5Xzg&oe=6A637D6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAk-_sKWc64Q7kNvwH_MBKV&_nc_oc=AdqT_cRUWRN_sCJALeroiUJiEb0Ks7BoRCLFwRVp5mLi_m1DF9Q1XuzzQCjgeB-61_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBlsTYrgtE_fCLSPMUQdACuLHhQNzOfsmVCE_MPu8lJQ&oe=6A637D6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVw3rPZux0cQ7kNvwHCAEWa&_nc_oc=AdockvMiVJe8C64CEs2vUfap_fYF8DKzjydcJ4_FMCeB7MBMxpeifqHW9QIyQ0KPoxI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtd7mgvQLZUQNTXxDFSQUBdbf0hG-_j-plVlkPCbeOeA&oe=6A63733A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FA0wcHYj-rYQ7kNvwFy1Lag&_nc_oc=AdoZgdcHZSX7gevyyw6MRwkM1Fk5U3RokJL0II-U3SKNsMBwX20x7xRnTmHo_2k0OB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJpG-N_r06y056QGeVL8pVIi2ckM4jwuZbNKc_84nvOQ&oe=6A6359D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Foq6H9rHK1kQ7kNvwHDi9WR&_nc_oc=AdomnoD0ifXeyaC-d6XXD3JaGbntdUvRCLLc6g2zYi_IjeY8c0PUprI_vCx1v340rS0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_zXsDiKEcTJDrP8QN0SBAdO-akxE01vEhxhfo2IRb4g&oe=6A63576F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
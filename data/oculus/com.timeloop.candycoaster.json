S8Q7kNvwHaLNQ0&_nc_oc=AdobsLuvWrB0Jc2QQkkbgL_vqKiLmOHm-Zf9B3f32z6R24bGnoEmTQaomjmpqC2qppQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JpIiyZo-Jto67Rk-692ys2xa_aJxZnOnEAwJCnIpJCw&oe=69DCCC2C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnMirJw5hGUQ7kNvwGzZguj&_nc_oc=AdoI7d-zJpC0wv9NbnbqTFjf4xIu-ekLSmGf11oyOXjNuEGcBdXkjVtvauHCFiyXIIs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22vCjqLcvhHUHMAIKtK9lzXgJeyjyD1VyxTwCPWLoB8w&oe=69DCCC2A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szdTSDiq2eAQ7kNvwEUtdSG&_nc_oc=AdqBbpLirkk65pQAiclkxMudMgTzrzEfiLLarj3kdXiTn5WOU2p1bwhe51lZMMajvls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NpzwyMh5yo85fSWvXakh0UPpEvb7fYMMkVYC993xW0Q&oe=69DCFA3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcG_bc4rVE4Q7kNvwEj2WG8&_nc_oc=AdrinEOV8s9ID7MdoKnbGT7p2J8fX9x1qIXAThXrdFzpDWKnMgOnekrSD5l7Svq6ajA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h7K_ru2TWZnsan43sSv448LJPaO2ISdBwY8WATMIVEg&oe=69DCE0D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RDdMyVCl6YQ7kNvwHB9bMU&_nc_oc=AdrMaTy0Gz3wBRCYOI3lNlScpUDfKLYS1B_Pb3XRUfP_quwdq_gTfbk-Whdlg3VwQIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QfIb7QDaGfDTLvr3LU8tyjSYP5vUKeG_0iftCKvLzwg&oe=69DCDE6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
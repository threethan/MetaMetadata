cEQ7kNvwGk0Tqi&_nc_oc=AdouN1lQUT5W90WRGDSwChnHFpZn5XTy49DMzr19sLHrbW9E-yDyHtd8eA1PxWe4grw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DvnQrM2MPW6MDcFxTZZSaskWgT468U83cs4AAZx7zfA&oe=69FCA86C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyGBNzKftbcQ7kNvwF6YGvF&_nc_oc=AdpD-LdjbFtiZ93vNqo8v-kE3UOYQqLC_brd41kuy1lq_3x9PqHc4RJzaY4gENEz1-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57t-ofpneIKYM9XcgXZO3c-RQB4bpaBRe6iGRfnrXxjg&oe=69FCA86A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrEcJx-CXEgQ7kNvwHAfZfV&_nc_oc=Ado23qVc0Y8ZQU-ns8rs2MZKhxm-sgKlBc0quFXl8ExRSj7PrlfHKCLHbCrMfwkHxBc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EN8Ux77UcIJqhxxiHvZVfIw_47yd4U_QphNgiHUCUvQ&oe=69FC9E3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvgPoLIBjK0Q7kNvwG8ByTu&_nc_oc=Adra8iQ2qZeeo0CQe3E_I8gIKFcP4rWZlx-Z7ys8Rn8qm7car3p5zpiFJIgrLuQML-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M0BpGcznsuy4f78ngi9nycf-CqayYdHY3U_NE3zDquQ&oe=69FC84D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpPP5-ZXm_QQ7kNvwHcsOcV&_nc_oc=Ado1niirT09oTLOR3X1vwmKyvA_ZcpTpyfHSyoK0gueWP0qTS8wVQI462tkJ9dFJbsQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5d4cfn7ZjsyqQm2gwtz_fNcbhcCehNmw5tLF5WjoOSuA&oe=69FC826F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
7AQ7kNvwHl92eN&_nc_oc=Adqco6eK9Kd35633yT1DkyQkqOOewL4cAzs1v7ivXDlduxyJ38XeXf7hMmEJPEuf8_E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlOKABVdWv3q9W2-3z0VyykDXRy_G3TocASvCXp8bJoA&oe=6AD38CEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOVnDNZBuuAQ7kNvwHm6X0m&_nc_oc=AdpOAuj6nhuPDNmTWK2aFTPP6J8BHgf1UeCCH7GZBIUtAh-JdXYn8mGSd_vyYBK2jg8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcezo85luWtQKFWimDvJdCt28fwi-KWj1rc7cqCBabEg&oe=6AD38CEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zLPaXilp9IQ7kNvwH5FTjB&_nc_oc=AdpTom5xqcbNJJuUgzsh7pI0DY94PUvJFX1abcmmfrMNo0RmMV62XnZ8rUxK39n1yOA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvLEYGaecKcunIS3BwUgskQntYcp1HBtmwVGTLdpmJVA&oe=6AD3BAFA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anzh8t1r0VYQ7kNvwHtepsu&_nc_oc=AdpK1HoQKvABbCWBNsFJnxgyiwWZY7Ieyp0teGoNXmp6BN0tM-hZtNWYbAKdNcLIxOw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEP2qqrc1XKaz7FdsynzPjVvZ16qb2l2X-yeXKXG9VLA&oe=6AD3A192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGvdGRtGWyIQ7kNvwF98LAv&_nc_oc=AdpmRB1jBoMiRd5ACqFQdHaL6ErLXeN4IYPxKXCJoPoinEFYN9vMRr_6z8lEje5zY9A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUvL8bjLCoVrDFoUozzJYGhHomRjXAqahhcoQi6YDYGg&oe=6AD39F2F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
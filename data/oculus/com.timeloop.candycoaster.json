B0Q7kNvwESLS1h&_nc_oc=AdpcREoezwXntVz_k1aW3n-UA1PrKXQQ8QHfgeibQBRPpf1IZvT8bMje9SvCV1onbQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3Vmzt0QmRBOcugMFZgGWgaUNgo-BlWiYvxReA3EEPgg&oe=6A51086C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoJiZhSq_OUQ7kNvwHKHZOI&_nc_oc=AdqtE_oz3iTIbxMiwrBJHQ_N5jlyGMihooRYKP1_-ovR_KhccIZyzDy03lEcDpxIBLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBavkzaxW8VV6R4-guZQFcHKTMszMDdMoAlwFop7L-7UQ&oe=6A51086A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mn0qiUQjgKUQ7kNvwFaSQXF&_nc_oc=Ado_pVq0DdD5hQblB_yX7JlLE9tln_fBg6678ys_9NHkIUENRi2rdZ0IlM5DtgpbzIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSiGu_w3aIVt2fUPC5wk1UfWcZy2eSWNQgybVmlGA88g&oe=6A50FE3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bPhy-aezL8Q7kNvwF7k_7i&_nc_oc=AdoFYxkVy68unfj9GBN9szWxftAYenjdCRrq9Ct3QnvILZZMyCclw0emz9J-T0K42gw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYkudJax_i3cOBoFqCONlm_7tlbIcJRjWo3DPAXkeSJQ&oe=6A50E4D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1FTam_A-MMQ7kNvwFyILth&_nc_oc=Adp_DrXkjATGgyY4sg0RWPsk7eSXOUBBoP-rSLiOtg_M6zyT5ezIY-LF-W5GkQaHmYs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfu2zWKUuCYmbHKV7JIM8SHWARwGHMcJGOQfCPIOfukA&oe=6A50E26F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
S8Q7kNvwE1Nzu9&_nc_oc=Adqhuu56jEctdCvg3On04XK_c1loyuGTE723mq86VIP-PslXofbQezACuwJqZjYC-KU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sNfuLHNaajWse2gB2jqmXf1ayClbdzshUxyRfQde8vw&oe=69DE55EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG0MPwUB1g0Q7kNvwENKAtn&_nc_oc=AdpFXvYmhsE5xYE9GQ8DA3CXPCYuxtmuSlm_EafWbkzx0PjhjHEoi5kPV1cFkT1xSD0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33jDcuUk4kndNA9_wNKidr8AzOFAfraaHUFKmCgqM_0w&oe=69DE55EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szdTSDiq2eAQ7kNvwE1G-rE&_nc_oc=Adp7l6fdJg39JUnr112YMU_UGH7aZFiq-MNr-wlz5XOGlxRmgsVBVUCcmOkbe49gyFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k1dWgzoyTpF6MxNNRxA0NtxKk1A-3eHUcZJu7E6oCZg&oe=69DE4BBA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycW6FVupXnQQ7kNvwEh2Elh&_nc_oc=AdpjmKdQzwduQmRgVainvza0BzhO4sBijnXx92qa1Cqy8KyNgBD9xVMGcFacWL0x028&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04vF-XtSMMVovZG8dfJfdgBpZHvJ4WJazSBhAvCQpaNg&oe=69DE3252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RDdMyVCl6YQ7kNvwEbDltK&_nc_oc=Adp97MibtAuW6j6IKkwKbFzIHQyKrfmncn92QqMws_u05mzu2iqEmiubc3p5ITlhGTE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YBkjEwhV3OzSUNZsul2Otmass-T-rSU2aE5tQHY5X_A&oe=69DE2FEF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ROLLER_COASTER", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "630604148241258"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974668_411405916276980_5265270746845806592_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46xYQdMmH9YQ7kNvwHP3n0j&_nc_oc=AdplsrRJ8cE2PuPPDaGKLLx5AYlildx-YbwHpcWZ8GeT1u4nCZoSImWsbTzoIeYQ-Qo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ryPi-6JJOxxZRxN86_dh2kEjqCi6uXMCZPh1rOvCFkA&oe=69DE273E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Candy Coaster", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1510250595, "lastRevision": {"nodes": [{"id": "960444994098466", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1607027939327680", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "269597076887867"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image.png", "id": "523983691869729", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162753_468984330150297_8541008055435788288_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sISwsm_OEFwQ7kNvwFQQolF&_nc_oc=AdrSe9JIGWGV0i8BW5q-tRg8
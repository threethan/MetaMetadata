x8Q7kNvwGM0Ath&_nc_oc=AdrjxtlO0e0Z11QnVK-5hYSGthxA6I2CzpBJAd8HimVTzNR2YQWIK72OPV_HE-RFvMk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lVy1NiZT6m6I9X9ITt9kP_la27-DUP-mvwlQbapzzUQ&oe=69E8E1EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-zW6Ufd3dIQ7kNvwHGIwoA&_nc_oc=AdrSLHReN1r1tj_nbqDkUeWUkLp4eYb_rBEknYzfvzeEAQtNHU5fguDrxL7twO2GoMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mpczLUrngIxRgv2aNTgBgiygmBxVWFFTnVN0GyXuYNA&oe=69E8E1EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GV1vftwbCv8Q7kNvwG_5fML&_nc_oc=Adr01p5PU-OuxTYXTmGlPgt5Poo1ZpT4-h_RzUIOwoduq8qytEjd1ZCpFQzOtUha7i0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0t2omKRsDeVfU4xnibWlxzF4HbecE-I4zbehGDIpA6sA&oe=69E8D7BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=434mOSUWi4EQ7kNvwE62-X4&_nc_oc=AdpTUGwMD0pEvMibIzJOk4t4lwHuTyv9VQVzE9Y454IwU-qj6Ki32wvqr3wkux8oOYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kEisRpTZlxg_5yasY-qYkApHUIuKktqCs3UdOCCUGwA&oe=69E8BE52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ww9OETNnr8IQ7kNvwGb_c5q&_nc_oc=AdqnYo3E6PjxUBe8TIPorpqj6ADJfbJSF5V0zi1xRMvUo-xxRT1BGkJIzT_g8SP8WjI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31TjoI2UaPXk2C3Nl0uETdOuNcfP4HftLiiaPVIeOdQA&oe=69E8BBEF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
cEQ7kNvwH4Zh91&_nc_oc=AdpZV_0ztks-hakm07E85BKEEBaXML-TH9IWC-frsNtF93KQQSzR5qiITzc0fXT6ZTc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QcdwWX4viyPShws3lSXcNiIL8DYTpzj8_a0fu7gNfpA&oe=69FDF9EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoXA_BiVgTsQ7kNvwGUbXrw&_nc_oc=Adr7wWflIHbCnP-W6W2YSNTwf4sAQhJx9W_FTsjK7c8zEjd7SbzBlU56tEH4swf0FdQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Jw7ZaYv1q--zq6rLxx-wMr0qUAB-5kBUZ-4zQ6OBOTw&oe=69FDF9EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrEcJx-CXEgQ7kNvwH_Jk_1&_nc_oc=Adq8-BHe6wbzZLCmA4mBX1rpIB__QqbXeRtASllMujdD-QsCtPI_8rAmpwJF5GFXxfs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rT4sloABnuRdxKyeBlMc2XMqzwsTyTcUtkV84XeLxBg&oe=69FDEFBA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGFFRgSfykgQ7kNvwFOyMUi&_nc_oc=Adpg1XSrTHLg0PsEmLd463l11e_N0fSi8DwBVhr4aYVXVzC3lpK6SZPg-CbgYW4edCs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wk6S9k7JtQOpjzKrg7DEpFpoT7iluYfBioaqj1bELlg&oe=69FDD652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpPP5-ZXm_QQ7kNvwGL_5rQ&_nc_oc=AdotvIIrFk67YnRP8rS7fiFylLYgZpDfSzkc8oFixcfzUGEXgJEhyn0u0UzKUrp8QFo&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l0-hncNRMEJVn4Nrl8FVia6FvEDLH1rjl7ViV4A9Ahg&oe=69FDD3EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
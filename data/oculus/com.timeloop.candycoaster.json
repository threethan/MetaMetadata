38Q7kNvwEijvP0&_nc_oc=AdqjKQcKdVAkg0L18n8BUg9tjLu8CYYmvmDjU8P4QjduZO2ro6EFWIiixZp4Gs96yjw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlstQeuBfNBT8-nC70fSr-1ZykO363zhhG7tf_Ve1qow&oe=6AA0226C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojmuC_Nc7DAQ7kNvwE1X-Se&_nc_oc=AdooAYoSN3dGy5kfRP-Wvmy4l8aVeOZFYCKCGKCXrwuxEJrBBmI6J9yGgukQjcAXjw8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA3C8oZc3_N34GzNG3T1eyqft8mI9eFXAjs_W0RRlZnQ&oe=6AA0226A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC_iIG4PQHgQ7kNvwFu9yCC&_nc_oc=Adr2QDw6InerhxOH0amPxBvGk-fG0YlQ2CrweC_JkJRA_UjcCHfsB1cFe0d-iDQFBIY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZoLu2FQRZh-3mO4AAaYR0pUwbAARtiexncAzDd7bHVw&oe=6AA0183A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXNu7sKhUWQQ7kNvwHlFVVm&_nc_oc=AdpfOizKvzf9kbX3Ot_lbQSq2tvK8KQ-a-vZFuJX9uH46g3d2bhmHVVulx5TbymVytg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMgFG5r4BCxg2a3PU_lOjM4_ZRTef1cUvDmB1lLm2hQQ&oe=6A9FFED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G74z11uGsIQ7kNvwGBM35B&_nc_oc=AdrM409NFPtbJ3sWwOMsiSIrKrSE-_llMG72Ka83sEfDjMN0mn4HzQr0ZEEx7Em-1Dw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVixZNosBTmR1xbKZlR7SsYsx1naz4To76YXdy6982yg&oe=6A9FFC6F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
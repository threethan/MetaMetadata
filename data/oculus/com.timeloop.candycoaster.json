5cQ7kNvwFXuvam&_nc_oc=AdoNeBDk5H_PJLuSkGZ0Cc4iM0YUV4ct1ESRwilaAGS9TysE6ugdXfUYm0h_9MV7R_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J1UiHCEPj4MJdUVV_tc_LPhqs3KjQkz5-KnphD8PtAA&oe=6A2D6FEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcKvYyiTU2gQ7kNvwGXoY-A&_nc_oc=Adp28ktLJP59HJlg-eZtmI-b-weaivHB6HiELcej5uWApJ9b65ZIHCmBV1MWwLFvGAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IV1q7K32yVVu2_cthoTVPUG40vVoPYOG6GOvXnq9nyQ&oe=6A2D6FEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHdmNJHuG5YQ7kNvwEF8Slj&_nc_oc=AdoVacFzxzTkBx1rhKa6fhJDlu3skEJ8FFBmDf0Be1dqTgcl7PTQXbxjAEOCt3Mb2Io&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2pMXHEP00d_My7TAVCcVa61Q4r4T2YzgtEKo6x5ve0A&oe=6A2D65BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVeXqR2TxswQ7kNvwHPflKx&_nc_oc=AdpK34ZZCy_LhRqPpUev9xG1zlrPAvl7VCkExQTEtH19rTN9gD1Gu96y7fCXo_-acBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3UAOFDxkqjgyZU8bvgjbeR7dcoGhTrH3pFeQzr0TDoA&oe=6A2D4C52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC0S_gyf25QQ7kNvwEV3TSI&_nc_oc=Adpb_Bm63YYqImj0LFaGHuTLoYJcMPmNglr8Mrvo1ccUKaUTE5v-lEh9w6JAaWQwf0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SkE0_HVD4Pa_0KIvcJCVHwa9cPL4w7spCfGCSKq5Gug&oe=6A2D49EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
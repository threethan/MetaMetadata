s0Q7kNvwG_oWGl&_nc_oc=AdoPmYaaIEAjk0hddWE-6RKWIx0JB4lfc4-dh0csp_b6YkRJ6Mr3RCMSpiA8J5axL-U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20d29ROs-nR1Q32Eddsas3dt0dEXJg_E_jF8pFhrycFg&oe=69F610EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5woM97iruQQ7kNvwHGKFxN&_nc_oc=Adq5NLUViOb2hhzMM3_ewGCbU_HQDF5SEuliOEVNGf1Qh-w7g0nCYNC93Od1rTWcFWI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2iiZpe1tAZVCKiCqoac6Jb6UoFgQMOekSW_w1jxE-1aA&oe=69F610EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAUvpyv7v1EQ7kNvwHYkbcC&_nc_oc=AdoriRQbJMNJ7Pcj5bdBY8jmELjYp8WLy5vRXqjjnJ07wj1kuTdT7lzIRPaNGUAypmY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Viu5nlzdgi1Gj1diP9kYRqKVd4i13wXXjV0fnSH8tdw&oe=69F606BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXBs4gSZl6oQ7kNvwHdaAT-&_nc_oc=Adq5dGRqYdJYfJtwlLUl4MDvQKMhnaOFVlXvOVxa5sfsJ714MiQWVGhVo58Z2rgxYbE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af145Bnpq8snJ-BfJYlsINk0g5CHb05D1HL1v5sYLNsyOw&oe=69F5ED52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4uCHqFr9QkQ7kNvwEZGDwe&_nc_oc=AdoxbnSnW2zoUc-QFRBm_SGslgirxWE57pZZbF38UTjPki8oldbF5xfa1gcgxEIEeoA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ZCxLfkjpztRk6u13PYYR-agTLTwBf_i_BIgHnnbLUBw&oe=69F5EAEF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
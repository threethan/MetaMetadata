H0Q7kNvwHRTSrm&_nc_oc=AdouCT3FzeTvtVyyxc7tJGzKMyVYYmVpSJPtroDQYZCcI1HFZwCS9bpnvp2Bv8AbiCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNHjifhxYRqgfmS49PmRDVMy9GO3Olo7pchRKLU5ZsGw&oe=6ADF6A6C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQmguMfT3dMQ7kNvwEGWBDJ&_nc_oc=Adr4xFECBSPxyI7jQb--4K1zvjBu27x2NDjk66fduFuJguK1j-2eS2v3vY7cA5YQaMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCHxluqpZ4FeRoIJ1g9O-L0mXjUuM_5Dzw53Put4yRqg&oe=6ADF6A6A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeQ_RRwd8a4Q7kNvwHByFed&_nc_oc=Adp5yEk8U3rk5zETLOXQiMLCHVyWxirjM3UkoPkFgUFTdTr6iTiVBYDpaA-UZZAVZ9o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdiToNyFV_YvoIJ4itYGBgej8TIzBcOkkv1lWimWgkLQ&oe=6ADF603A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuNn0EOAjCwQ7kNvwHrdel6&_nc_oc=AdoMnX35koPigG1ma6lbeyuNVmQvDtpTOCseFdgMRPKdW5fJrEpK_9CXRym0S9R9sjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9CsiGY6RnqzlTCT9XcPiPMGcQwqpxHpXoe21_CiK3MQ&oe=6ADF46D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rji-QY2MeUwQ7kNvwHJP-lH&_nc_oc=AdrD7CCfWVVlZB1C4TjSZOmga7LbkbbWaE9s_idKlJNQ0Y26ZWbH0OiK4sAuYJ_pkjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4KKar3yn-zXNc9a-8oIpd4QrenhZ-3UUy04DTxzvcFg&oe=6ADF446F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
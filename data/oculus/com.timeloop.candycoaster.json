QcQ7kNvwE36tlU&_nc_oc=AdrIprFDun-21FpK6WyIDlvwpHMvQpAICborxL6OyTqvcffdvv_vHqRGgvfTixZi8ko&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwmVo4o3YNxdN_fbX6yheLhgHPiGExDlZog2_-vgqaiA&oe=69C7B42C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRr2rZxa5-MQ7kNvwHyi0aU&_nc_oc=AdrdzUUyf-cqQ7SohoTvVuCcIv5glymN3dF26CSuFtlJ4yXWBfX8pGLzhNyJbZ6TnzU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyo26a7zNl6hQJ222XblzOLIMiuCV5hKUYp-iTHCmPJJA&oe=69C7B42A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYRSgBe1W9sQ7kNvwE-hkhK&_nc_oc=AdoMkPcVxuOFxnhdLYK3EmfpW_-pJtWKm8CjxJBRQZ03kU2r403lN3vjitSUk8ladvY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxn7iob6uph9hZwh2iGXsxl5VUlpzPDoyeZucgYeIGF7w&oe=69C7E23A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwm8HCQFAXIQ7kNvwEeV4oU&_nc_oc=AdpPewPI3JpYNYcs3amFSD_b1wVqhm7HkF58L_dkn88xz1s2O8-XkYA8UmRA0kQdRag&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXkOPlWAAuDy0F-y3fL_5ppJjq_BIQtrEoutbb7UQiWQ&oe=69C7C8D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fxlnTUuSHQQ7kNvwEwuDTg&_nc_oc=Ado_gOpX_NlH9bmjx9HgA7GSKNZzGwV5e5y7HSOd3o8nqPPquaepl0_wQPwotuyU_l0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypBeuk4hIKid2xsvKNiii_6G3tzHlSuQAr1gEgw4Z2Cg&oe=69C7C66F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
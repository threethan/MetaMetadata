cEQ7kNvwHrb6Jo&_nc_oc=AdpYu43UkJjlyWtXvAkWo-oT-SCdaoY79qDGv1kvfQIZV9OfCk9YP-YOQ5HDY70q0lk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48FhIlU8EVAdMv0k3AjC-VYw1qU4JQ3173ifY6EFid4w&oe=69FB56EC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyGBNzKftbcQ7kNvwEmyq4n&_nc_oc=AdpkzgMF91CULFGM8O7qmbFPhEw4sPgRVgYEvTMwUAXS9vozvUCR6qHcyoapPPVkL78&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S0znuLhmDghgDMNBpLhlsRar-9GbMvUkO9tSNKXYCmQ&oe=69FB56EA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrEcJx-CXEgQ7kNvwFy4o6r&_nc_oc=AdqK9OPoF5gejMczWpwOvCY6a9ds7vGui7VxJ4XuSlb4RRJQJMpgsW1Znx175j9ZdpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KoBtvL5sesK6sNOLmNGm2QQlhsHh3yaUH-QiGNvNNlQ&oe=69FB4CBA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvgPoLIBjK0Q7kNvwGuAuYW&_nc_oc=Adrv6xyA3g6vYF7129-P-4_hcfUwFhAuyiOMYHL_q8lDfwOahiGN7qRYWsoo4-TzMOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6E7yPl9VIbDbVMhHmyTzg6d3cw2Opf6X8q5EssFmv5gQ&oe=69FB3352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpPP5-ZXm_QQ7kNvwEOfbE6&_nc_oc=Adp4WjhGoh79zhE02sF83zENi0GRBHUWgVXRBKI308vpPNDFyWqj8EQSDXUHz5FlK20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af727yLR8tl7b5MNdfg2TW4CXLyzl6RSU5cD824cVEy5LQ&oe=69FB30EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
d8Q7kNvwFS_6cp&_nc_oc=Adrrj2G2vnD6qwNjdqq_XWqaWM-LJWaDBD3crhBfZUBB8UEzfkSF3j7S8HkOFtcwEZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKoGc3rha5vYFwAQV6drvhRxaGsgPCz7XhnOrj6PcSEg&oe=6A64CEEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcR3QtXxVNQQ7kNvwHDTDrg&_nc_oc=AdqE453vbG216jvFVh-qfIynQhJOfsifMZZQcBMv6m-E6I-NsdlCumrNWJzrMCpWNgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB77jFopfbmN7xroWIMjYOA-rC58Pi_3HEOQWZ1mNflhQ&oe=6A64CEEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVw3rPZux0cQ7kNvwF_96Ud&_nc_oc=Ado-ZwjAmEjjtT7T8y09LdnuBUUnZnEaahyiUfIYK8TO-4R-3_uYrNmlcROi5vIm81g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvy5kHHYceqDMd4GzzmghlCI7RKgh6GdOUD_Pmw912Yw&oe=6A64C4BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxKneGDSeCIQ7kNvwEty5kB&_nc_oc=AdoxnJCcKNQvQmsgjg2xH956SNvLH0kbc_-YolD_aMLYnYPG5Q399C87EYX4xhkrgCE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBt9BUpAyo7m0WqqA2gGnvK1yw9MG7ydigPMziVLD0JyQ&oe=6A64AB52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Foq6H9rHK1kQ7kNvwEUODUs&_nc_oc=AdqLod5vn5kCBYDU1fEcRFiM1Xh2FsE6UQgIleN85JikZTvlPBiBuTSPZZBvge3b7rA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATdcAfZXipBLhSq6vQQ9UU33FlREiIHGJYCM7DU7DFPg&oe=6A64A8EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
30Q7kNvwEyy3qT&_nc_oc=AdqtWdHujy_Abl-lm39MUuc_HwHAEB7-zLU9YeTFRAlUVUmzt5R1kkPpQltcuLVwuqA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64KnngYsNYHvjlBRJwGF26MayDDrJhkXMEFhbvmSmZzw&oe=6A1D9DEC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSb7CB29rDoQ7kNvwE9VXBS&_nc_oc=AdrH-6ONBZmrcMVWIpuuhNkiFeOQVU7DeSF4Hy9ztJQXyN2n1YmQ6HXtJf2mSn99tRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PjNptUu4JDgWqKKNjwxdFLz7OtdJNJzYk-FOZpFEjIA&oe=6A1D9DEA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q_4CL5l1DgQ7kNvwFsM96d&_nc_oc=AdqAc6YlzqiQxXj14xFNtb5OnALFLVmogSB4Mte_eV-9zPcGEQo1ilFbRI2WXFyBk6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GVtRsJ3KG-4eSmYsVITX4UcyPI4fckfd8nW6VdqCDCA&oe=6A1D93BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgndySpZBZYQ7kNvwFKciiR&_nc_oc=AdrGK9iTcBA29J3zqsu7frytjWO1esUk0CH5lVDDz7S3RPCTgM-J5VZAbtd5kkJxEAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7psuc6k1RGdsDEsiY8eoUA47ETu9bbKqSylqKR1kRSlQ&oe=6A1D7A52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4WWoRQwvPUQ7kNvwGzu2m_&_nc_oc=AdpQw_0D5c4pc3_CwDcUUWiRKDBbotLiWWoWj1hvxQPZkjMOOBcY5Hjdpn7MbXZqkx8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JW38hrm42G9j1v0dE50MLCrwkKXgT-rfl8CWnizh-GQ&oe=6A1DB02F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
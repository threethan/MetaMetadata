QcQ7kNvwGMrWrT&_nc_oc=AdrNT1sqlIVGLMgvr3-9ynx7Mt1kY-5QpCCvT0pl2cfE-ETtdMm9HDeXoGe_gQqE0bY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnezQ-V22PgzrZY5xMsltRQ2FUbfHTmzw0kma2P-yCBg&oe=69C905AC"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRr2rZxa5-MQ7kNvwFGYRAP&_nc_oc=Adqjvd5kOXOpNBBo7AYs03PPe5PEG2Bb_e9gAYMW-ql6ew5ZNekCJBFnydqyUB253HA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGR33UTu2EGF8_HdZMm8yPUyXswsfFntyI9V-bD7p-yA&oe=69C905AA"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYRSgBe1W9sQ7kNvwEd5DO1&_nc_oc=Ado_s4VGLHA6t3j5OE2kmwfAyOcl3CeZUaYODpoPbLIJUbEKdjEeNBD4C07BVhONoMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpWvPXc7EKhxphNtVjLEk9vwu4I-EnSO7MpgxdC3ENPg&oe=69C933BA"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwm8HCQFAXIQ7kNvwHP_7Lj&_nc_oc=Adpq6bwKT7dVoCaxSIu2UE5jPjsaHFWTh8iEB78D7JEkyz66dP27pSWOqWEysjdEdZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzzAL-wamU5k6AOWpZaGi0DbyP4vUQocLFBU49-TAcxA&oe=69C91A52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fxlnTUuSHQQ7kNvwG10NTD&_nc_oc=AdplTfx4XE03vLSfYooyzvRu4BJbjvp4fidG9TrOPry5EUSMX8BfhutZ_k0SIkWBL3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOQz6hlfxMLJ-g5IWR2WkCOP0eOZWSMyjGnPisGyfRgA&oe=69C917EF"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
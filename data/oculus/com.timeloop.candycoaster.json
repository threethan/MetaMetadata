uAQ7kNvwEVJbIF&_nc_oc=AdoZIXeKDqWtGcn68Q2SaM86pVl_hVMmVgqgM2GIkqIC28H_5xlc6ySLE2Mmf-Ztfyg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGHYnMDOoPvONiGjiv1j8fLMLQXe66_R_vDnweiTjSmA&oe=69C5112C"}, {"file_name": "migrated_image.png", "id": "502690537071239", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162702_148624805797664_1406264260845109248_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ1De7dQpycQ7kNvwHkNZSL&_nc_oc=AdqTMOZb9nINeO-BP41cRtaZKsKZvcDEocqUOBRH5cNOHuU68r9tlzbPcV8nbOhkJjQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDUgwJOOQJw-VXg37F70z4WIJEZR4C0GgDZHlbB16FjQ&oe=69C5112A"}, {"file_name": "migrated_image.png", "id": "231893251545452", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162702_1770509123244608_1334446454831316992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBGr-drYyRcQ7kNvwEsoZDQ&_nc_oc=Adol0BrZyomW46lg8-pytZcIaDjMlnrAK5yIBN5phUDXVcgiKGsLhv7ts4_mtCXSGPs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZrQs5eCSscMDST0SRcJ_ge9_OAToMaExnM3MTFbt1bQ&oe=69C53F3A"}, {"file_name": "migrated_image.png", "id": "143478247029436", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427594_646225505501664_663010188768313344_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaCC5RQw0wIQ7kNvwFBVG9R&_nc_oc=Ado69TwRN62IP6HZrHy0dhFXUKr7nUvEX2D4xQ5XkV2l5GOBoczS_GUPGI8LSwif9qQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyOk8B0RdRQKgYp1Q7TEY2Vt58Vp05MdCknvGVqmp7WA&oe=69C525D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/UYwH9t", "id": "1951936991584289", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974578_1951937001584288_8810081120805715968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWWUxK9a8qcQ7kNvwF214Sx&_nc_oc=AdpOl6jp3DROjg-HfogZwhTqVkW0Kq9nxjXZcctNhysJWG7aWczY3E1HfpcDc0W338o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7fFL18_Sd_H7LFcklFX73fzghGfSFBQhsGcv3CmyCLA&oe=69C5236F"}, "display_name": "Candy Coaster", "keywords": ["RollerCoaster", "Candy", "Funny", "Cute", "Thrill"], "long_description": "New feature: Gallery - Amazing 360 snaps from Candy-land\n\n\"Many of the VR Roller-coasters are the same themes over & over again. Candy Coaster decides to bring something new for people to look at & has one of the most magic filled VR coaster rides you will ever see.\" -The VR Shop\n\nSome User Reviews:\n1. \"That was epic! Really fun & great for kids! Like something straight out of willy wonkas factory of magical candy land. luved it!\"\n2. \"Big bright beautiful blast 4 the senses\"\n3. \"Don't let the cute environment steer u away from this gem, as it is enjoyable by person of any age.\"\n\nExperience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Icecreams, Candy Fountains, Desserts, Floating Islands & much more! Be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Relish the upbeat music as an icing on the cake.\nHint: Look at the Mystical candy residents in the main menu.", "short_description": "Experience a Rollercoaster ride in a Wonderful & Colorful fantasy world full of Cakes, Candies, Ice Creams, Candy Fountains, Desserts, Floating Islands & so much more! In this Candy Universe, you will be greeted by an overwhelming amount of Magical Cuteness that will bring a smile on your face. Mystical candy residents in the main menu interact with you when you look at them. Relish the upbeat music as an icing on the cake. Adventure has never been so sweet before!"}]}, "developer_name": "Timeloop Technologies", "developer_privacy_policy_url": "http://candycoaster.timeloop.in/privacy_policy.html", "developer_terms_of_service_url": "http://candycoaster.timeloop.in/terms_of_service.html", "publisher_name": "Timeloop Technologies Pvt. Ltd.", "support_website_url": null, "website_url": "http://candycoaster.timeloop.in/", "category": "ENTERTAINMENT
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jb3Gl_2VJe0Q7kNvwHZW_CS&_nc_oc=AdqMwnY-sXdnd7qiFTuTjjDXGdHEnrrcJIir5aaVDqhCjN6hHezMAMzpeIsGMqeVFkY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAcuCVx8-JaZ7U4BxVPHOUc4dB0J3zf_xFVm5pVPScYA&oe=6A4F9CD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSZMkduxgfAQ7kNvwEXEHSa&_nc_oc=Ado9LA-TINzRYyqcadUweuCJyGMi59-84OdgsqtTFFZ_k2ht0paQlbQ65o8n3m9wyr0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo1IhyMN5cNWJw7hz0r-JLZyY9TxoYLMz0xPMGJXks2A&oe=6A4FA9F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyH5kxhWmL8Q7kNvwFRwmiY&_nc_oc=AdrXX1ydbHyeSE3_uwblb2-E2UUC9mATT--cWT7xw2FlmuK9Cxny-4IyhxDuV_i9bYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1QB6mqj8Gy-7Z-OhfkmFn_4LORAuUJsqQzZhehzpSwA&oe=6A4FA5F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaH6a3KmCGMQ7kNvwGLg2vU&_nc_oc=AdqtKnOK4Fh9kTEBAkwBw4sdx6f4fNF5WCf4QT1sMPS9XlxjLc4Rc0N6t2Pz7lnKKec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd7PIr6Rknbow5vbCic9he_Zj9xx2GQ-aG2CKQpD8kew&oe=6A4FA6DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UGUSguplocQ7kNvwG487xF&_nc_oc=Adp8IzjYVihjOKHu1GUCw75FjPTs0qJe7ESS7PyS6gblobN01UEAd3Hs2wDVuHglFks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3xKsEyhVadQ6ahM5U81W-cJbk0jgB4f3Hpc5xc1EbCA&oe=6A4FA09D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
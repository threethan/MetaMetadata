dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-c6FEEmLrcEQ7kNvwFkQT4Y&_nc_oc=AdoDk6VJrI52KzQaJKYE_vqvmIoIksavSnGB9hPlnVajtP5GDNrOzsxmzTQHLkX_vuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtVh8aWa_kxlMORlcsIBOaTy0i6B2_kbabWMd1UWlRGA&oe=6AC643D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L86QB7bHN_sQ7kNvwFtUeD2&_nc_oc=AdrhFtW6penS5Wnaxw5wu61T2RBTKCMxUSaRkeuGdr5ad8pUYI_doms97CmpxuqqU-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHLuS5HX5d-AVV9JvUD12CUMCOqicbY4l0yNf9oOfeFg&oe=6AC650F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ngm37kp8bfIQ7kNvwEOrUO9&_nc_oc=AdpeYE6Eg1PNCoT7dIAyNtd3wwwE1TuH5eODkDpSzuTiKg6Ct-_NzXGLGcI1KgDxm6s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWc1CepMwzdWx47CpZWNqV4EJeGEHcXf5nCxdC-5akiA&oe=6AC64CF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaORydzV-LQQ7kNvwG-YBPu&_nc_oc=AdpNYV_wLw5WWR0x9JXBBZIm6zn90B-WWZAkH6g3h-Y0grZzENU59X4vjfynmwNl65g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-y2wu0Xywl_nvZ3MJCVTTbkqDPsFW0bwlFfhHT1Wf9A&oe=6AC64DDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPPzP4X_CY4Q7kNvwFvTtqy&_nc_oc=Adoz66kRYRFUru7u5ICDvcI7UAQLK0Ff1saDVC3ekn2PbW3CPlXE6JZPZGq_LDX2YCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs7qJgG3vPE5zGvyMgP6aNRpPK9Qup-xwnCNBBducRNw&oe=6AC6479D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
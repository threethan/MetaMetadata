dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wn6TLi8CLGMQ7kNvwFo_W5c&_nc_oc=AdpUbZQUh4KKL0ZR0OholJBqcCTKYSJLUKpgCtNpPld2XQN9wcPO9GQHfMp6HelXiTE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqlkhaQj0EJVwGkhLFAWAwu0DTUgzDdtEqOgTEukCRog&oe=6ACD1391"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlV3Yi7ZTywQ7kNvwGmTPY6&_nc_oc=AdqYK6uAuh6Dn4ZAGn_NEZ8zBMFsvNikobrHv8hVJcXYODv7d9KgCTjry6Nq8Z6uDuA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkrLozPP2Ml-HSNdqhWJaFqOZH166Xbc0LbIJbLhMHBQ&oe=6ACCE874"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu3qGce24PEQ7kNvwEpq_Id&_nc_oc=AdqGkyrAzgwQFYDQ9hjTIZ2MPDwD1NG--rql2I1fLEPSMLEdW4SlhQOvMQNRqguX3j0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6xjL93y1vLJHpmBOI3i6OwFw-U7EULKKolU7_b3qKzQ&oe=6ACCE476"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_AjqlUZsHsQ7kNvwHs6YlS&_nc_oc=Adq5kmTv40fWb9j3bFGlhjeBwstJo_Rwffza1b1n4ebwPQszbKaT9-RPHvQ6H-KRie8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGzrUTwhza4ABCFBUwUAMAVz0Citpp78fo_sOimR6S0g&oe=6ACCE55F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmrGCI50N4kQ7kNvwHoERM8&_nc_oc=AdozJTAVJIdYYBOUBNQTchWs8ZBW5xRjVitTWfeIuDFo4p9HVDQhujFuJJzirUsAXWs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoLuDZ4GL3Pxmik7oaF8jEKvdJA0JRGqQymwXBI2t0bA&oe=6ACD175D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItiA22JQvhkQ7kNvwGyUnnS&_nc_oc=AdpanOJoAmERqZz-9Br44WZUQqBdOZdUuxMlci3NM7c_OFK0oOUcsBybnEp8JjJwWdk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz34TgXgZ0Pe5qiivA5uE01hNAUY-mcB6p2z-py2-hBCQ&oe=69D10CD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnO5hy37E50Q7kNvwGQKtMO&_nc_oc=AdrsnDLAWR1GElDhjl4RT-LGi1-4rQ6LLVg7f7Z6PGbkcMH8Y1CDunldzCqlpLmvxJ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0eElf2dc6oQ2guEAkztPOEW28DIkm9nlLvopLI1MEEw&oe=69D119F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ-UVNHRnbgQ7kNvwFIN438&_nc_oc=AdoGbjEmqc4z6G4MgZZnAtC1vW6X_x5Hz6FGCiMCh-B6nlMhQFtZsG1ErmdjqIL2gAA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1QnL8zE-CPMnPj_1LU2D-SN0Mi1-AHMx-9-ZTOaoHZA&oe=69D115F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyR3-00sqJsQ7kNvwHfkp6p&_nc_oc=AdpmEWPfvgXXgmvv4dietYZjjEIZTfywJssIeYjOaXKTHwYrTVdeqd7WssuV2Xzd6ac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKC3he52mtNcitLO8ZVjAUehfSVxNyXG6o2BoyRZcTlQ&oe=69D116DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YApELGWHDjoQ7kNvwHbgzqc&_nc_oc=AdqTM-sHCv_caxg-d2DL3PMSzqjN2VcpFhQg4FHkAd9eScPdMFUKni5EfBlKZlgG4LA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxc_EC1UFKtHR9NFJXz1fzcCjua36B9a-e099vdNeMYcQ&oe=69D1109D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
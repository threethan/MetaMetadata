0a&_nc_ohc=6Jp8_HUN2N0Q7kNvwGncIGc&_nc_oc=Adl1i7epMPb_zyPC8-aMVYL_W-hs1fGrdeIuVPhE4XSSfY_QMgWB4W8-PCX7-F7CqCE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsO7Wt_rEgK7uPTtAX3Xb6Gh8iSI5v3S3Uqoeigte8vWA&oe=69A58B51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIdxMu8P9fYQ7kNvwEtxC0L&_nc_oc=AdlABLU219LzgkXjBm2LkJJCm0NDONbqz4LRUu-IIx5fNpJIFtOaUl9RATDpD0OrX9c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftX70lG9JudATgGB8HJlqfN0qEA3F3loIDDYb73T8k7Ew&oe=69A59874"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU4Mlxi7tCQQ7kNvwFKEBMP&_nc_oc=Admj00XFbgUCGLnR9nSxUcHIsc4vq8f81hRPJyGwqES8DzI9mhC6EByrKDvsesg7VlQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftgiDyxnWZfKLEdzXyfUfLHQLbu4BXnvr446aakhe5u2g&oe=69A59476"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW9w9P5RXP8Q7kNvwHp4vjn&_nc_oc=Adl_IC0mAl_m4Jcjdet296SZVfhMvv1lM8p5iK2I95mlC9VQe-Rsoh5U4m3aeXsYeUY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftFlRniCAw2JDa2zt5yk0pS1jZ7N_TbcD9ZahIq1uPwfQ&oe=69A5955F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpywA1-ktX8Q7kNvwGZKg8K&_nc_oc=AdmnxW5kDyxT36bYwI_SBiUL9NRZCehz7jUrkMctxtxFFNe8Yw2S-_Fr-D5PKVnDs7U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuB1uQPA8xKakuNy6KWmsZaTmhk5VBgCU2k1qzrIS846g&oe=69A58F1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [
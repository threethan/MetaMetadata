dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAMumw4eKJoQ7kNvwGkKtRQ&_nc_oc=AdqTJ39r3nu-7u2NKzB-FZFIzK9pX1o9jJi3U0xMxZXTGQWQ5kKzGjlhTlkzJgF1CjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA-Lyd_qSw6XAjohSgzV6OY6c0hC6rUnrhbdbCy8uEiA&oe=6A4A56D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AS0nf-YUSjsQ7kNvwFHVsOH&_nc_oc=Adqg-L6xrB1FecdNjtkX3e44L5s-2acqCifbQUROoSv189NVa-WxbgIbIOSYCjAtn3o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7rFOCV4k8t1RaRnijSPnw4RE9tc43QxNgSRtDqNB2Zw&oe=6A4A63F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbpVXuBgcUUQ7kNvwHP3ETD&_nc_oc=Ado__WZc61Co7IxEk65S5rHTUMRwUPQr7pqzaaWQ9pnd_l04jFIgDM5U3aApTeURADU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABEhhKszbWZviEJQP_RSVwLUx65_MA1HLkuMBn5BwFKw&oe=6A4A5FF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMjSsH-XVvQQ7kNvwG_oqOu&_nc_oc=AdqZsEZoLlA6uH-XmfLmrEJwUvQrMgDIvz3mlMOPc9SnGmUR9LWvxsMLN4RGD4wQElc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaPGCTnpGWVa7R1MUIqE8exb-LPkMvVw1u0Q3fRelJ9w&oe=6A4A60DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3-X6kZ3-3kQ7kNvwEuv4YT&_nc_oc=Ado-Ow8jhFLTd8JLw5yqjJh7SejmDDeXLXGmGS6dXwvOOjnlTeAC_T-4V3JZrjdxUVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEz5lpfT2oCGNITzzTAEiGpNegXYvqCwudA1y-tY-b_A&oe=6A4A5A9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
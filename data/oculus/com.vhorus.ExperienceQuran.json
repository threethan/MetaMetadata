dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8ZMprSe8hEQ7kNvwGGEvrY&_nc_oc=Adr5Q3Y86fbZD1-8IMKY9fmjnZ86mKZcseXenlUE11FieyHSnM4tmXjsxWU-ydMeHM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEyA7j7urHjrJS97vsE4V_mLeEzFNbkBvmiXJlbSwgiA&oe=6A5F6ED1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXP-UX_sExEQ7kNvwGioKzO&_nc_oc=AdrXmPhFw_1W6U10MWv1odF51DzZZXo6R42ck58uWpa2HEi5KB1lGKK2CWcEb-NvOUk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVP--NUY3YL2bPgGs_wSkr_VpFglWo9_sttvDDyCDrXQ&oe=6A5F7BF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Pc60_KIC2kQ7kNvwGXC9sP&_nc_oc=AdrRJuSgDAF2_yK0XJdvUKUtuD6TsYwpL36oKijmrqblPMnMg0n_Kif9cKDCDWvzO0M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdU940YwbDGW9TfsfqU-qxXuse7pQQA4Gw8lCFDt7H6Q&oe=6A5F77F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eI3llHXYFfUQ7kNvwHcCXqY&_nc_oc=AdqxPjGDD5jgmZLK_TkZ9AM9HbXAP76Qna4Dlz7E9JKrKnSWT3siGcRmHhiz0r1R_7U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrY0tkzsmxGXvx4qWzUbumF9C-3cfmOlKO4kh198cI9Q&oe=6A5F78DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzuXsKrec_UQ7kNvwHtZhaN&_nc_oc=AdpTl8wjSQdhSOT2PznxCC4se0RiCHQ7V0sAW72wtVyCFUXpQi1RliCYXO4BFhvTdzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_zNi0pHR2Vr-htgG87_9tc7Wt3pRhBE80mnKN_wUF9A&oe=6A5F729D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
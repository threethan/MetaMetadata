dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSI6_DG57zMQ7kNvwGgz-GA&_nc_oc=AdqNjzKrc88Gqr643wCX89lVpdYIIIubHaVR12uOzCWGYsuKZBdhM4N6Faj_joED-r8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnosKUceOpmHIL-pLw9k5Sj3cCGk11cTu7IAu1bEzNbw&oe=6AC3D911"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L86QB7bHN_sQ7kNvwEc0Uiu&_nc_oc=AdoGBkQA-P61Lo0hrxLX0n7iPMPQHZoQwHSlAwBUDS6Ww-kehHLIlTKPxsh6rP_A0-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiUu9T-0b8X0I3gxWCLY2GBd6BUpPKAD5p9MivE2Ddvg&oe=6AC3ADF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIuQ-Rm81twQ7kNvwFE_Dt9&_nc_oc=AdpOtcybCDPEbg-nvg38V9bCJpAq1EF-eJGKBm9fXygBYA6hkEM5ArFFh27aN99oUFk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5qol0YkyFabBTGCWjsbo-ekz9cRbQRWPgkHpJhoq9ZQ&oe=6AC3A9F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaORydzV-LQQ7kNvwF6-OGL&_nc_oc=Adr2ktQah8q6hXMsmLs1Q4UH8NDmnEUOeSbVTTUhLsw1HX6U7IcyTW5GjLz6-MimLLs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyYlaVW5rVKBd_G6z2a-jlGUiNek2TPkVtHBdutA-yZg&oe=6AC3AADF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayd-6uJepsUQ7kNvwHwRE6i&_nc_oc=AdrM2ecmDRIYCJaIp67b5vW8Ds5XbqpWMoGBvwnhKubxcbZYYb2MBz6LFkQI66CnFn8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM20HeQMkkhRmRiy-8cIVg3OLBjMc-KStSyaDeiSLqBg&oe=6AC3A49D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
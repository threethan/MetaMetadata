1.oculuscdn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUOyGJV6RB8Q7kNvwGG-Rg4&_nc_oc=AdrAsqOlLALysm3S1-harSO1Qg_wN-Bo9s_3NCxx_L3MU4Pm8TtRR_wOQEtdbsNdVEs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjb5_O1-pcJ-Nt17ncmbHi-N1NwNdeC43vI0pg8zLgCQ&oe=6AAE88D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXVCZkeK550Q7kNvwG0Xz4J&_nc_oc=AdqWj3RZwp2LZPisc2DA_mQOK5X9d7xouutIS4bOK9_88U1Qm-lFJ1W8T6GPqNR0SVU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7w3vZPCmXjH4zYrip7zii347wkhHRcVyea_5L80y6Xw&oe=6AAE95F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7ozszlwGFsQ7kNvwEvOf78&_nc_oc=AdqBjHLvzTjJMJPazoGviffKJVcpWTf67UrUerVnM6VUmxNxTYRVqvQ2B-SMKkeT0-8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqgYK_gx2z0Lug5tr4byiyU2sIt0-gdOTFBEC_HH2RpA&oe=6AAE91F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBX4iI1h_cUQ7kNvwGhHmwb&_nc_oc=AdrodzEUcsQT7Puk_ZMVeHB6bVK_SxfRg4XVJbDI18ZxHHRbn1lVwrIfozqFGiwqRTw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRERz1VH53dGu_9X7i7cUTHgIfUj7YovOY7uJz53sbPQ&oe=6AAE92DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WW2VaDAuVuwQ7kNvwEcS8r3&_nc_oc=Adr9vvJhruobTWrQ5TQyFgvZb-yj4UE7paR9y7plZ5Y3MBowYurQLycMHEeZ6jtWv78&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtxsrKDgEf-aawnLc9Oeq62wRJWyslM_WZ9hRKgi_KiQ&oe=6AAE8C9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics":
luscdn.com&_nc_ss=7f20f&oh=00_AQDsjAzMxg1wByDESsHpXGlobJkuP7YNZHKV7-weaNE0uw&oe=6A6DFC74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHCDdnQItuAQ7kNvwGzwaOD&_nc_oc=AdoAR-48e1dedwq_1To-_2nIKvFJrJMFvldbRD51cxuhrRpRxj6Vgx7etQMmvjzvFUk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb8vRjiEnw4K-Npg5y_L3TCBSkPv44y1-twYbPqa5Nww&oe=6A6DF876"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KltAjdRKJywQ7kNvwE5CFbC&_nc_oc=AdqsffQaFYzx0Bg_I06Hy9VqUmNS2Z8YwQNzK-F5lIdECNGOv44xicQcX4wWJ-KlAF4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCme5lOXIHJmT8dg7Ct28WdYCvg064O3Iyrrc0PAQzRAw&oe=6A6DF95F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPP_On8OUpYQ7kNvwHggOEg&_nc_oc=Adp_d6ORdZvh3Kwv8r_6DGvghpMjuweec1q1NfJvVGwMm4MDIX4BRI-E2JW4Un2s6og&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYAJd5TilHVf2gFJia3WeJSaoChsUOE7eNkdtBqygukA&oe=6A6DF31D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3078321749091066"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "156827075047449"}, {"status": "PUBLISHED", "id": "1535441743218929"}, {"status": "PUBLISHED", "id": "164987664093240"}]}, "baseline_offer": {"id": "164987664093240"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1513274400, "status": "PUBLISHED", "id": "156827075047449"}]}, "liveChannel": {"nodes": [{"latest_supported_bina
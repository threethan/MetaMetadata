dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LturXwydZQQ7kNvwFF9Kx8&_nc_oc=AdpkeJydfabCGQxGWVpzxpuHdpM5zi4ddQhgFwcNZ9MJVfgNHX7B_kZoEz0yxNuF72w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ipJu5hQTRH6MFke19vycqAaHTEgjR98QE87FcWRUl2Q&oe=6A16EC51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2p_u0XS3c0Q7kNvwEMDC3I&_nc_oc=AdozWLtenuDgnWOlygdeidxo7Og4RlY4Judq-7KS-jFyfb4nTyXy5hVr-sgvtU6XT68&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Py9ngQgJIL-fc_DkRiULS-rdHRPFBuOIBhcwKskYgEA&oe=6A16F974"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BxZS7xg1YMQ7kNvwE4RO_1&_nc_oc=AdpKaBLTTfqq-KVOtdZMzx8yLYEfmHSWD6NMr1r47mYVJFh4-fIRXcV6S3U84Wa_0o4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FAUSYuXzFk8W6vZ5woEyc7uFBRP0n1_z4gczaI2wSCQ&oe=6A16F576"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNRMpZPZarsQ7kNvwFAtyrP&_nc_oc=AdpQ-qC-GvU32YwjAkvzqUBI0rcValfLQmq83YLyvkRyY37LcquguhTp8fM3TInw4yM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qRzSxUMAlgHeejYi2MMfRY7BlU69N161jU09LRFET7w&oe=6A16F65F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XVgDPT7pAgQ7kNvwHt8d_v&_nc_oc=Adphzh77ZXWx2h8HATReVSFwXhX9--jMh8M7xFCLnhWVKPFgUIYVk_xmU3EB5V2-Ju0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jVsXtPlCP3zwkL9tB7lJ1385jqEdP2ez7dNFa1mOeFg&oe=6A16F01D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONZHXUAuQPMQ7kNvwHkhUYV&_nc_oc=Ado9MBd_yDhdJkEAUGykwRVlgNm1my3jwFS95sKZmf4APyWfoxjv-xGLMUBWfqttSH8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zJmqncaLE_lhfT2SvaxEQZzW77l_5KML9lmRXB2x5lw&oe=69DA4751"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1vimGHVTUMQ7kNvwEmHi7w&_nc_oc=AdpljMU8iuB42-nvolHgvAa7wGyQEhxJKWwVbhG6I4gTxc6IrF5Yb8PpCPcEEuTv_wg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lLnlXOA06H960Ifo31fOU5p4PoGMXVrc-H7TKF_qZFQ&oe=69DA5474"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6asVIMZ2u4Q7kNvwFd_CKK&_nc_oc=Ado54vH4-YkH1lB9UsMgdUS2D_6sjBQAaq3ZfIqtxyV6X_Cj6HNNe5ezLr6lgCAUmfw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-QnHgwIx3nI0mkZbub-6ESjyDpKB1Iie5EHCBornngQ&oe=69DA5076"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFc336NV25MQ7kNvwGfrH2g&_nc_oc=Adrcu7lDe5FZm5lc7gZhelVtM668X_3_4yGNBYIs7CjyCW5ZzzpqrGwg-3Y_zAwBUT4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04BlqoYh2-5-HYTQUV8p-fzdBhwkVwAg_4aopfTi6JUA&oe=69DA515F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeC2GbnH5SIQ7kNvwHaPBi3&_nc_oc=AdoOpl8hBfaZ4fjOJlWAP5koJdQnq7ohT47s430e6zF9a8Ux_-kba-ouJ0jGFCoA2SE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h-dyd25J2qdDDyDXwGEC3zOc6oOYi75fvrbbeG8_PTQ&oe=69DA4B1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
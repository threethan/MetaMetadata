dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8BIQEkJrZAQ7kNvwFyMUhr&_nc_oc=AdqxjbHTwLS7hxFmvUmeHuknJEzdhlgF9uTrNMYBve1vhHJhC7Q4xhU87hR2w2jOoYk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NxqX9dp4R-r7qNeViX69LMjrrJYr-eCK9fhEfwVc1EQ&oe=6A05C8D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KhMMp_AFrwQ7kNvwH5Shjc&_nc_oc=AdoSa6x0ZlmRrhGg4SVuGRB4JAJnjFm4C3MYXcrHXsxS4IV5S9KIdeBQUYVFW3iSbBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kUmzSkPJFXDICrubc_kEqaHEEWZnbqEH7KsuiIyKgsw&oe=6A05D5F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iebfzlbN8lUQ7kNvwFzVZVZ&_nc_oc=AdqrqGa2HAoR2cYTkzvb_92aqZF3B8MtGvQO8VMxHp_OFFnuy856czRuGoj63kirYQw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x6K01PCGcXoaeqBytefhf3RBrdqHp_ZHc6n-fUW9p-Q&oe=6A05D1F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dNBFBN_sdIQ7kNvwGEFnX1&_nc_oc=AdowrFKSVeKagpt4rDQQ1Fq6_WPOn4yzYYfSfzfikOSkqdE7FWeG8Rys2NlC0Uaz4Ls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r1qCltT4NHJn-6njvDkNH6DVf8x79ESIUu3zUZcyVXQ&oe=6A05D2DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK9ILnEx_aAQ7kNvwEKWbeN&_nc_oc=Adr0oH5SZjwFRb1dTP0uunRYjHeOUszjFC_JiOLQdtK1jWc6kVneaofLPVVErbp9UK8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78k30WxoiRMbXD3aQyWHDCMvL0o0t0OAJ5QCyJAcM9vw&oe=6A05CC9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
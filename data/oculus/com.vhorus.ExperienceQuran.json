1.oculuscdn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsdAqXGwGlsQ7kNvwE4LIPp&_nc_oc=AdorUdEmA1RKLs2nIvxF3QMkQ1OpdSYZpjcgfYtXhGeoh-XbtRW92CxG0GKBwYJne1g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5LjrI0T6gSN7kquleI2KIYQGyGd956c-n7L4TYDeNTg&oe=6A7DC151"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9qDe5YKSzsQ7kNvwFEeM59&_nc_oc=AdoQ7vzYS9I-hAjbiS6AYg2P-BgjWNCSMdCrF_2osPaFYmB0Jd8lvKMWA77YWJB9S3c&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYyxki5aC8AjAL4egNpkXy5YnwumhMfDC30vLqFsHwlg&oe=6A7DCE74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOaMJTQLr4kQ7kNvwGLaItU&_nc_oc=AdodiFT8jd7-trw_h3ieKnIT7eH-62hI2fw3J_4khxDp_Q3AZ_jvSZPlzfnrY3xApVc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpucuSNMiabEITY4AM03rKLRhPO40-L1pBHBdnkJ7t1w&oe=6A7DCA76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gadn4mwitCQQ7kNvwFYib-w&_nc_oc=AdrnjoWrHz98nmI0EKcAuBftvPWm1ZFIL_2dz2vyMs78OYED1Hit_-IEz2wO7CQjHlw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1OYRMWTsHGYy58RmcOEEs9ZAb8PiVJXX1Bc1WBgJs1Q&oe=6A7DCB5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZM-S6P4mYoQ7kNvwHSR3RE&_nc_oc=AdoXKWszr3TThRBtZqsl58Oa8J0dz1GHrtDKEeUGQRNZED9-IjkWvE-B2QkCoPNa9KA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYaXjlghSNclM-t_rr6NBH0hs_pv8g8dTY4ZT0VJhLUA&oe=6A7DC51D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics":
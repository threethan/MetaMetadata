0a&_nc_ohc=sLcuepdpUwYQ7kNvwF2xakh&_nc_oc=Adkh-hP7LF6cJi7pDYH9N4av9scb4Za0EBeqaSoLZx6MSV-9fdjxO82b-eXq6e339Lc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvvovxWuOXvNkAOZoWvUyW7uOHeFtBX2UT3ey5SVuoH-Q&oe=69A2E851"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIdxMu8P9fYQ7kNvwEpzkRy&_nc_oc=AdnbQ_1Iecv947A4V3l5q8GOKyQ3OnDiWYwrTEg3BjQ1f-gIy7OzE4YpfJBRrfuk7qg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvpHtW0pbWIgo0O_zGWlTDE1D09gjC6D9TD3k0nC-V0bw&oe=69A2F574"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwDVLzkwDlwQ7kNvwHKKRG9&_nc_oc=AdnOTy7teRLxAATjX7ThWUK7W3yZ-YTPHlULhdxd-dM84t59MHWA66r58jPlCuUunYA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftvxVTvE-QFqvFeCAgR5I3N2acuBGCmEGI9Vwk_u6ttzA&oe=69A2F176"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW9w9P5RXP8Q7kNvwH-ML50&_nc_oc=Adn0tvShOeTMOqtPM8DuR7S4boW9l6oUeN84pacP2YEnbgkcWNJNTpQKwM9_xpFnARk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsvCXJA5OaZ-MVuJVD14PdFMGSEhyRzXa0O75jpOJe53Q&oe=69A2F25F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXqWeNWLQWgQ7kNvwFE3Wdr&_nc_oc=AdkF5xj2l26PinijafamM2tbcvxznvwy4sMPrycOd4B6tMk0tl4Vg5sGjq2viwCbz58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuXav6Jqr1DcTgz1FdCOBuuP25gMX0j8AZRC8SCBwCjUg&oe=69A2EC1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [
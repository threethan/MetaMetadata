dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFPTSV-_Nu0Q7kNvwFmKxdZ&_nc_oc=AdopyZV_OgeZDMyw4vQb0xfL1AL1aUpLrhHpO1SWKxiRzMMPmP7YwYMlK1bXb7peqaM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M5y4XqRTrR3BMQ-cFrs_WKu-R1FIr_TCeu05i9Cw5vw&oe=69D3AFD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0xNyDiAv_QQ7kNvwFG3VGN&_nc_oc=AdqSbkuxW3kedA9N2okRnapTK4YGZIr2b_HmvC20EJohA-52pqzhsIUxYxN7ecEigw0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3B1wDjxTUwajPnVwHAat9_6wx35OM9NnPs1l4_hFtS_Q&oe=69D3BCF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRBHwq87SPEQ7kNvwFqEGUe&_nc_oc=AdqT_Lb_etVh4i3PJQ9Pf6Q3PILffKo8JFAy5xRMDX4FhVxwRm6t5dNHZKl-DCvOwnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dl2It8L-e9tkEGqbSw3uezHXSw_j4-78CvM5XA7pUZA&oe=69D3B8F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Czc04sJlZJUQ7kNvwFujFIm&_nc_oc=AdoF1WCbnRUi4JhkFCcoMyJNZ8D_I1YnSkL4jbQ1HgwtFOW8Rg-QJRKIUE9oiYQjhOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aTDnJKAYZJxTv2yzHq6o2cN-PV5w6XVmsTBfxU4PG1A&oe=69D3B9DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YApELGWHDjoQ7kNvwGYZHkZ&_nc_oc=Adp31OIukOjqhdUnik7bFKFAWlnGmpLGpH7Bk3euZfHeSlNnJXrP3bue9VGaBwJLXm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3j71XP-N9ogWTfZZS9mABcNOSaMRQ1D3JY8U9BWupRFw&oe=69D3B39D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
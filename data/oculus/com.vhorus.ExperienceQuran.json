dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6ySHniifeEQ7kNvwGsT_Tw&_nc_oc=Adp8Mutip2ll42c_qEn_JRR5x_-UTL1Jkpbmvdpks06YjFNvigjNAVNtFgwOYNvtiiM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW5xL2RGHmF60Uiy_NdzG2z2irPvasNB2FAykwGjrpSA&oe=6A8AF051"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gK_rivwnSkQ7kNvwFilZPe&_nc_oc=AdpVZr5J1ZpsN9zTkrh4Az_aQMvNObRUgiKO0gghJ2UKPRDPbIA4UXasBB9xnBzDMzQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGShOKs5YRHTNojW7tx_WFsZEI8RhgMWDqQ1Zt0vcqwgQ&oe=6A8AC534"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYENsLcKMI8Q7kNvwEDBNo_&_nc_oc=AdrnlrnY_r0JucMEc1GP4zvjRwEAMlfsngo46QzhYcBvYG-OhnPHnARLnS7FhGLkaiQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7l_EKuW-D362pnEKQqeMSRmSJiWJLzi4L6_gS59qz9g&oe=6A8AC136"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHCqBrZzPzYQ7kNvwFPpkrv&_nc_oc=Adr4-R5GtB3w6nk8uKTy5VZw5Lyg1_XOX0l9Cxi5MKd81zAHzpRgEPG8WsqTYUavY-o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrphEx2I8Rx8mRBViWHlzl2lZhAXyKkMqzTvaDIbbtkA&oe=6A8AC21F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwlwicFUPgUQ7kNvwHbuS2D&_nc_oc=AdoOE48jKfCvWpuyrIcYE2ehQm4JpQRGLdDWF1BZd4Dzhm51SSJlhKl2Qwx0IV4JsCQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEstM_r5GTOb47ITr2p5YU-DKlehu95-tsFGzmzbA4ckw&oe=6A8AF41D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
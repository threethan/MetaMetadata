0a&_nc_ohc=6Jp8_HUN2N0Q7kNvwGR0nO9&_nc_oc=Adn0x6n9NNpAhVY1YMEzrrNaNTotY8UKAHzJs1kSkAE92_s8RQ1kHLE7DIG2VfXZNoU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs9bUwbZZTWZ0qRZIM6ThahwsUq8PfMV2_nngKsRE93iQ&oe=69A6DCD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3SmmESRNL4Q7kNvwFx1nsB&_nc_oc=AdkeOMEvSbvYI2S6RoW3VHJy7_oLi2IBnnZsLy3zXBGoSEuc9PJSKH5PJOOq6ZS5jB8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuvFBbuXvD8_H5j9e7wlcnffdz8W5RbbSFZ_JQw-47jXA&oe=69A6E9F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU4Mlxi7tCQQ7kNvwFq_ith&_nc_oc=AdmQ_GZAlIpdk17NVnmc1vXBteY9F8eSvoE4mQ8mHmOkL_wafDjZbcjnUBPYfkcruiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsED4lBreSwwWH2Tqypg9568daDwdzdy11SAxTgbPacMg&oe=69A6E5F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSDsvcfFLXkQ7kNvwGoAh3G&_nc_oc=AdnvAuXp_DCTRBdu8V2b9KqHv9UplSuoBFF2cMTx37RVYcthPWTfICyudN0ZLvlsn6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvOOytED5uPb5e6Uq3npFcUALxeaum3UH1lJXrCJ1OKnQ&oe=69A6E6DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpywA1-ktX8Q7kNvwGUCiQG&_nc_oc=AdlwhRYufhBmb-mUL_1WOESylNmGmT3MZDf9phmvL1tfFdAdW_-j5L-yEpUDLnwlb4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu530mZIY6MI0HQZYuWGPby1j9h4yA1wkvdmAZ2DlMVCw&oe=69A6E09D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFp6Rz9LZv4Q7kNvwHeRf4B&_nc_oc=AdpxR9EOitzzlHMoHXZEgzuNcYVRHp834Uu8Wzaa3ImVDGcKbdTSDMvPZS4wcudTtB4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A7W49lG7LliBOnP61mGUkEt6-0t1-HASQql5OffUYCg&oe=6A1054D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uDImorVvVkQ7kNvwHMjBJB&_nc_oc=AdpJmop0MoVC0Jrek0YOCUARlzyWNO1YO9Qa7Mm_PqTAFLOe9Wh7iMdRV1RopdMmy3Y&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N-kily5Vv2cbDOAlpp9LaSsJVlc7046ILpXISbpV3Mw&oe=6A1061F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLxXhh4ficYQ7kNvwG6AIR9&_nc_oc=AdqyZmHKYsvVP0gAXZ8moZod3YNjo91442MiR6RqgyEY9JL9Kwss7rTnROKrey4pWU4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hhkP4BUMuss2AvphBNpWWz1bP1B3nw7eMZFt8fN_BbQ&oe=6A105DF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54Pcp1XghOkQ7kNvwEEE57e&_nc_oc=Adq251MX9pOHfdFrRT6OI9x4hN0LeZc-uHzu9KY3fRIkB3jo9uEIOl_6mf9x4gDPRR4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sXQwcPEVwYvI4IqsK6-ZDUXVd704Wt3PJQhH9xda4WQ&oe=6A105EDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl6ozToqSnsQ7kNvwEWpt-c&_nc_oc=Adry__zGEaziviLc70hu_04S-VxhR_BaO25KzQWqIfD4GotwKBvkS9tAwRbIIYsAzVM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62D6c1RD_b0iXg-tIf0wqkaH3TQLAxzn5UBbK_qJr8EQ&oe=6A10589D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=598JaG4FBeAQ7kNvwHLdSMp&_nc_oc=AdqZ6mtADgimFyvq-qH93rDkK8_ZKGIDAy_MNuoQ-ZukVmNCwckztzWg6YozpC1hKdg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR06wA63S9PViYNY2-T3_OwHbtLIv2JRHqYUg-0o_xa1A&oe=6AECB791"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqNRspH0y2oQ7kNvwEcGbSP&_nc_oc=AdqAiUn5TlJZ6Sj18JSL7mg-u2jlDDvy50Ka5a9o-ljgP-RnuqYP9q2S0AivGEjlWNM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHSMUtIFs5EYYuOqr2AiavDr7f5wcoaZTmHrUP1MUfFw&oe=6AEC8C74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDBrJ_YtFOAQ7kNvwFby5Zn&_nc_oc=AdqAoPt2YT5iMM2OwIbOGlaXHvXX_oRPEvdesjt2FO3Gwx4V8g5-uv6a3Gl0oGIz4Ac&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRvBZ5G8nGiYeuaFDxpo7cszhMdT13pXubaRKMrbZE_g&oe=6AEC8876"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJwQkDjOCTcQ7kNvwF1EqEd&_nc_oc=Adqt7kZta-z146SdQVU6B3IoVfE2SWRFiQoewwQSSWzRetBHKgNLVvBhH5DM3sElcxk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTw3L5OJtSIsObQLMM8o-MRNkgkrk-heiD_knU0aPExQ&oe=6AEC895F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeKeQ9FEttoQ7kNvwFQZa4V&_nc_oc=AdotdhuPMXXKsb3z03pZZ1hkD2kcFbsdWwm7Ua-FCKi9q0RaBz5xLs53VZtzw1hHma4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBwhlZvZhiGN8WX_eHfW7NyWBRsUoypsGTMX1XDgoAow&oe=6AECBB5D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
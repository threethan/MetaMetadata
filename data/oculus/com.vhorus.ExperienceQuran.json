dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU_EOjDZDSAQ7kNvwHmdzNa&_nc_oc=AdrhYoPCQF5vJbOIyzxrJmnj2_yvSZ9HQhoDY9-V6y3Z81DRXqw8zpsFmWQ8sn0Wjzw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZGxFClBQ6J4L1LGJ8Zdb2_aO0Rr4CJnuZiSC9TfujiA&oe=69C3DDD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I7uywfJZrgQ7kNvwEO8e9X&_nc_oc=AdqCre1aRK7iDGQgOP7sAOsw1HxzUFEaPSauWmJTeVlWQ7VbDSI8LaIdz5r7ui2dE1M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz43_ARWNdZ4AwHKbLmwHzziBlnHbOAE-dcU3JaXGo0DA&oe=69C3EAF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7wokvS1Fr0Q7kNvwEnE_k6&_nc_oc=AdrvgxOh_wX6zSyhSrC5BBLHqUpZVf36ERzuR7VDv9KoPx-6IwHO7lr7Y1PZ8h8hQLk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxn7aj2x9XtGGiu8ljGqLq4kfQn0FzsNwgT9yfiFKKwZg&oe=69C3E6F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3w-HisPEy4Q7kNvwG3bIH2&_nc_oc=AdrmL4KAkFAJYwJFrFVwbbTb5WJuxw06VCo8pFPZbbFo3lhomuRbthUcOZczIOamv-g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTXfh1cshX13q7HgKay3tAaKnWjTV2lfBbCJBMN7QWvQ&oe=69C3E7DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEJenN36JPkQ7kNvwEcq2zL&_nc_oc=AdpPANLI1DsLunkAE97J3ImYuTcoEpac4_wvtSdZid2eVQ8cv30G79MumilVoy8PSUM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlYvkkjVxftcEcSajX-MUs6YET324G1cmwh6mFAAqtVQ&oe=69C3E19D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
2346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxrCsiW61JcQ7kNvwHt9CYk&_nc_oc=AdnPic88gx16EFF1CZjvCTYQtcbyapVDG2ZhsNM9eGMCt-2yU-Fw_8wE3nxfPAv7B_U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3CtR_vkFvGqyUoiggRHSyksGqoYQne7mug0U-yXe0pA&oe=69BD4651"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmzOBQA5inEQ7kNvwEYjkuA&_nc_oc=AdnOGsE20wiJY8iv9Su0kHfN__iPH7nOycpaWF4yqHgA7_YBsbgMxbPeBKxK__9ohaA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzpCOQbTqIm53WZGCR5i4Xj_EWQv-_zG1vlr83-u0qfYg&oe=69BD5374"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6XmBt6BK44Q7kNvwG1WzJz&_nc_oc=AdmSz2iJ3A4xj8UcT8-ZgGs9XQA_rooB66C5qN8B_LIh9mjShMmhJhIPqZsDgmPEau8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDtjryF_4iuegnKA8oh2z3YRVDjvsFQnmOY4OEuTAMBA&oe=69BD4F76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaLlKQ5YgSoQ7kNvwGs6VBr&_nc_oc=AdlFv6LD0ck1GUIal5LbjcK--v2FNfbobooq_ILHULVQJylJedH_ChSFicXSI3Y_xqU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSgvx6u4hNvRD_uTgoi-tDiZIBtDwvDLBYpHeM5Qh82A&oe=69BD505F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AUcgRRCfRwQ7kNvwGinz7x&_nc_oc=AdmPW3KE8u5DGNAJLyoDYULhdA8CbhgN1ppYdKfYb3Pf2btjkHWpM94G2AdHmNQDzz8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2d06XM0s6aBZ9IWaZDG4mpaZV0_suP4GQEQJrFoeDLA&oe=69BD4A1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
1.oculuscdn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moO--ZZJx6kQ7kNvwH2-4_E&_nc_oc=Adr2fTmR65RPXIK_p4Rq3EaRU7hDkC4lhVRQiMExX2fanuLTKaeNU79PAA4W5drgqYA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kptbgOLvicqRhule-YOfy6KO2lGs9pVI5Q5ituFDS2Q&oe=6A230211"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8wU0WHxSoQQ7kNvwE5amqb&_nc_oc=AdpeYiKQ1Xgb0mCcaFseDpVB_Ri0EQob2GCrJGwQsb03eDQNnwTi5uxveodxL6AvH2I&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sXVeD7TwocGV33tGGfQuJDmEQk3HYJqwn5ZC9PuKLyQ&oe=6A22D6F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96mOPnXgVgMQ7kNvwGZAKCr&_nc_oc=AdroikB5XDnVs1JuXpBWxZY9MDLRiSOahWPkcE1Gzx1PHnvrsTVNOOWSqgNuNerHxn0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VbLrmd0pG6KLnXTn1TbisWtymrtMYpf3J3EJaTktZuw&oe=6A22D2F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln3pQKH_VvIQ7kNvwHuLOOz&_nc_oc=AdpQR9aRHOibypyLi-C-nLJZ8b11Rj96mc29trhrLilOAbTJcDgWUTqeIYj7rUcFt5o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86Fd0PENdUAuET7tjAjsQdymVaLclFbnxeEB12sUsfTg&oe=6A22D3DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4jGVDLr3VcQ7kNvwHhZR1r&_nc_oc=AdqK2nBBMOTx16dLQ_gvqoE09antSD8Hxm7V1nXkTr0ncRPKufi2yuR1kYDb75RSsHA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gd3Vy4_k5g-YkkhFQQMmmNFCPhlDBHy79ngAw3W2NWg&oe=6A22CD9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics":
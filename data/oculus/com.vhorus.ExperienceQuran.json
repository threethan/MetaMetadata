2346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLd-V7W7_tcQ7kNvwEOXzSa&_nc_oc=AdlVcvh98XrBvlXh7DJMJKSQjFTJO9Svx01nKFzHk9wZarcLL-CG7ikda5kAZ-fIDmw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzXNCd-OWL4jpKUmVxTLoH8FZfQnAMujrHqLn_gT4H8ZA&oe=69BAA351"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmzOBQA5inEQ7kNvwGzFhmE&_nc_oc=Adk5OYkcL7y1DUCmi1C3ZtuqkHHkL8vRNqMuSnkMhYJZhj9vqhyHMJRcRBU3a7swBSs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxsRdfa2At5WrdbyPM5dF8gpn0afMI0bz9hAr9KZapdng&oe=69BAB074"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CiCEaT0aONwQ7kNvwHkh9fZ&_nc_oc=AdlNAqKtjdHdJgXc0YSunTd7G8tGsnSDQvasrTPmSlENSlWMiHMUSGTtKJc_UU3HNLE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQ_y4tbtLjdjfj7gTYO7mWRFnRgBMS3rW2nHPvHOD82Q&oe=69BAAC76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaLlKQ5YgSoQ7kNvwEH9cgI&_nc_oc=Admb-ZH9fReVNCuybw9EPgWSGXBEqYGKK9gFwgIOeYxwYzV8GDMT9TYSpwZ3Hzdnj9A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyS61J1nVoX5JEwTcb4FTTYDNPZdq1I4yGEO55iW-ZQ8g&oe=69BAAD5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhAh4hdIT-gQ7kNvwFUbi3i&_nc_oc=AdnK0ZgLb6Y0_P5WreK75t74xPRKLr-LmPZAbKenpU3VMSKOGl_vjfwL9yXQsR66kqs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx40ZwGnRT3yWaIJ2u64l8dh89hjkEQDx1CL4BzWm2JzA&oe=69BAA71D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
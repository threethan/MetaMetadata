dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jb3Gl_2VJe0Q7kNvwG4FLGC&_nc_oc=AdpJC1tgJ7eVINJun7jErwcCQtzb4NlQS9P6qpAQqyc12wdUxRZVjseeP5pskfpWBZ4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMwZbU0Iwm-R5ZGHKEMMr1oBv04WLgDSRRBrInXssjWg&oe=6A4E4B51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSZMkduxgfAQ7kNvwHGurkt&_nc_oc=Adqxgu-FBr3FLKssI-UaID_L-YvtnXWQrugkYwdvUCSPi_0Ecs9-KT6XsIRSxCREn7s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYatpFzDgZaGRvOFVw1ggdozPEzS0DxgnfvpqfzwMrBg&oe=6A4E5874"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyH5kxhWmL8Q7kNvwFc2pR8&_nc_oc=Adr68piWhZNcD6f_XmGCiUtD1lizU6mO_iALbd39dyu2IbsBfvG6RsKgAkPrkBaFhiQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrhZ_f580RyjlkuOLlKoRFVlcwlCgzI04-RwxUkgQVrQ&oe=6A4E5476"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaH6a3KmCGMQ7kNvwGg_3Oz&_nc_oc=Adr1CG7SsJxANwy2csHsNFSB9xl1aj7ye9_dHTJ2P8XnLvuXy2GNvRq3xnbwjMsjy_s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5L2193Di8Y0D3GWR_mwFiDVB-EBWIAFmBRDu-_swmtA&oe=6A4E555F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6Sr3bn-254Q7kNvwH4DWmQ&_nc_oc=AdoEBWIsOqSHdPutnTWncYxw9yeoyt3d43dB9HEKnOoTSr1HtoGaFSUL0BdRjQ-UteI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3z_TRjWbrzvU6rEwusPzIILH2fdMsdTMOm-Hf2C4UOQ&oe=6A4E4F1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
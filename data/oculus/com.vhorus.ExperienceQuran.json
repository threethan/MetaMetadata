dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgrxu_42ahgQ7kNvwFQzaG_&_nc_oc=AdoVfSnFwpzxvFyZ2yjGBvH5HEHKLqitdR1qcdtBQYNo4z7-esJvIkXV7GWM8Muffgw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mUvS4JPztmCiQCae06RafObynGw5_UuI-oKyvSqeyGQ&oe=6A2EA751"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEKxGaupqLwQ7kNvwE9EqHM&_nc_oc=AdotU9Q7Mfg_MPR99Wwcfs6dHom-rclWPifvxRs3efTPyKB3Jgukw7HqNAjfPRnbPd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TcV1ziaFr_3R5lj_1Da9O6IfeaEfrQw6Ln0_wCtMdpA&oe=6A2EB474"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc73gT4NLUgQ7kNvwEyJDJi&_nc_oc=AdrBQBCo4yLZP17SFN2VvuRnP7oEyg5atASFMAbwoEbot7Cb8W5viF-2OA-7OlUOA50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yd04lu1Wx8LRw6bDzmkTsUO4m2N4jM4qfEPO9h5dLkw&oe=6A2EB076"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwSg0fpLvL4Q7kNvwE8_X5G&_nc_oc=AdrH9fi0qr5Z7jzo57sZGahMO7VFZiUh6aqYaeY0or9U3qdh03ir0NUFnxCmxfUEM-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kxVSy4EcOLveXCV7GlfZa3V4za836ysREXEDiSdrNjQ&oe=6A2EB15F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bY1RelZ3zsoQ7kNvwFO7lDt&_nc_oc=AdpbNrhTScq2x2LriDitOQARfLQ78r8sLNXI7558vQFFz9UUo4_ZMHCGJ8BFp2YoGL8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lJFZJ300H_JrfamEN5oC4ccDEJT9Q08S3V09YV7dqgQ&oe=6A2EAB1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
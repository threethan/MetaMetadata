dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryD3BpBfYpQQ7kNvwGduWmj&_nc_oc=Adr4p4PPL5Xu7Xgef_8CbvFRHpLhutC6XtY2hs5QtcWjWsb7xGQHuw0NTJ8eERaDAxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJV3jZ0vejcUAp9Ojp6gK3MqJ1jjHA6sm6l29NRdHrPA&oe=6A92D951"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A28hofwuzJ8Q7kNvwGTwu0c&_nc_oc=AdoKBn5GCVIkF_F9vyZiyh5b5RhurrAmBqg8RE4PP726qsI8qiKYvOaR1RJJM3Gb14I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOTUCObeHnEcO5EfoP0EmbNmjlK_n--2EVK41AQfpx8w&oe=6A92AE34"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpJqAPhEFs8Q7kNvwG2QlU9&_nc_oc=AdpW52I0zyyQrLmFlzhTTTbfKP7ZXpg6rTBGZ3yYiTmcSTrNQowEGkQ3qZ2FbDXCRUE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYkxkVJrbQp037bsZdYPC0uf8QKxxE5lz4dSLZJcrlkQ&oe=6A92E276"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnWE5-oBUW8Q7kNvwG4c1x9&_nc_oc=AdqmvTevXOXTpgAY6Jbgk__2tnP1C_6XBb8ZM8HsjGElSkBl06RXjsDOmHZtU9mb_1s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwfgUqz8scJglGmRTk3kfR1rsQ_hRGS-a2dEOV6nx_dw&oe=6A92E35F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDuoeiJTpeQQ7kNvwFE-pBB&_nc_oc=AdpBD0ca9KgJqHrL1gA8msPCeh2e9I7JnUV0N4NJq95pMfnZvRYo_HdbUfWaG4rB6Bw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJK_snXD5pfZTvxxDSpA2OT0mYuYycMWpxisj7KHVzqQ&oe=6A92DD1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
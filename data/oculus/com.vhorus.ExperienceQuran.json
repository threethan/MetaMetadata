dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVDIFQ6DFa8Q7kNvwFwVFLD&_nc_oc=AdrZrXo1c7vKjAbuyfs41-6IUFbwE-s0uYDMYyHW1_ZbwIs63iqMRsKnqYu9_cXuxwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRei2omb-SSibyySr4NodmKeitT9sjKTC4QQ-tyDZOERw&oe=6AF89511"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bcsJBqoR70Q7kNvwGQ8Epg&_nc_oc=AdpqQdCpncjD0hpC6uJIVag9ZGXmH7cKPczoCxL8pmb2se9UjOgB2p4Z_F9l8lZcjdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4LtrTuugqQ-5zuF2nMt0t5DSUuW-cU6HSkK3NDMvHzQ&oe=6AF8A234"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n68etKTqr-AQ7kNvwFQQbxz&_nc_oc=Adoy6v-q8vwof3-J_0o1bVDbazg5QgTO6yKToPHkJsz-RABH608W8-ANXlCCyiVg2w4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4vI4eBUxTOqUnyGWHTzbgLxDvmYN4wML0fO-SkMK4Mw&oe=6AF89E36"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpFFMQAnTvYQ7kNvwHgw6KO&_nc_oc=AdpnOFnoeH_LKtYPdaxem6M_ayw_1hC09anGtmm_qpfdz9Rwhn3BUK50lOXu5yDEKOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2-ctkw8ZXActV7vx6EitbnWZHJKTAhMCrpr5DVXV-CA&oe=6AF89F1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fL1m55DMkScQ7kNvwF-44H5&_nc_oc=AdrkHviT7qCFmK4NZoDXujy59W9Td1ShpyVVq9L5h3sK6pHNbZ5HgXQHxaeuu5Oh60E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBmPGEHMngFLceqzKmcKFBuL3rOBEE4Sv6Ln8c5-hyrg&oe=6AF898DD"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okXZkz-Zuh8Q7kNvwGM-yy9&_nc_oc=Ado5w-e-s_4mW7BBc9iBjsiJVEReXwHOGbxgCkof8xY4Ne2TR_k5k8dZX8IA9TYN-vs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Cwcdq1xCk7l2kcdEqf1qbkWwbFodxtYBHgSpbsy-Tfw&oe=6A1ED551"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRbTdNI7ZCQQ7kNvwFVLlCZ&_nc_oc=AdrCFtK5W44OZQ0ouWlYd7iQn2oF_3oVGaDJ7LLkIQU7MzwAhBva6MnlTBKjTyJJp0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73BikxAt3_yMUbTe538wQ7Ta7VIW-ia_jwWUDXvwqHwA&oe=6A1EE274"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnzmojpZIsYQ7kNvwEI9lW3&_nc_oc=Adqk5toWAcwrP57BFa0CuRQiuIWkC_HyAE1sXsSCAwodR_G5-Q0hvlGYN7LBEbZXtaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ASiuKDKbRyKG26VDzpzAQ9PgJgTB6zU6vRqxsTPPPEg&oe=6A1EDE76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C748dtscs_wQ7kNvwEY9Bon&_nc_oc=Adp2rKAuM5x2pBU-yHjWaGyxHZ5bRRD3wP9guKyOmTTqq-YFkni69gIjN5HFjlohG5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hRWPbTOhZJwcqf2wJNqQCmvVZ11IRv4RUap0zJ0N6Gg&oe=6A1EDF5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diB73eqGFusQ7kNvwFkkk15&_nc_oc=AdrDYXCdZHAj8IQKBT5OgoD7vaQAnNFc-Ie2sxr8bFbjV8UbRfN2ZszmibeJ8Hc5wpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Du_E2EbXyQGAYnvhFAP_AlzRMajw_c3m-X4xzjPfbRg&oe=6A1ED91D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
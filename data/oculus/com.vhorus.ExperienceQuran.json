dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VILBlzyAv3wQ7kNvwFkF4Yu&_nc_oc=Adof1LhWPkpfPIjdAQlbS6RMa_0B-OZ35p9dKLu4toIBXWkRQQgl8zCJu6jck7i6vgY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38f6pdzB3-L7qGVvzckeFcEVaHE0_o9UTiWwsm12GdZg&oe=69F4A551"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXyWyr7gog8Q7kNvwHpHBvA&_nc_oc=Adpw79kjQvLg0C-GqU_YZgRASdFwF58wxVAR-NARNwaixNFYhRJmUpmoRDgjLaNLSxk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yMyr-3jZRGNXVJao4t-jgv_ppDf_OA0WEk-BcLAk8Lg&oe=69F4B274"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNQxAjx0GMEQ7kNvwEOTVLD&_nc_oc=AdqZIkbv3_wTDJ0EsK4es2pjeXxq05z7hc-YEXwtsPXHKfwwlir-SwFXX7d9C3dsyUE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NOUEqlPs6xB1Ho_DRSdidh-UCWzSAShdP-xLgPJQgrA&oe=69F4AE76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJveU_mQcmIQ7kNvwFzEzSl&_nc_oc=AdoILXXgu418uVnFcKquyx8YSROScT-MfsOG8h3HgwZ9g1aUATV5piEB5Ks2psaM9no&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zAmm9Lc7ClLTNTkwwwNuC1aJ8sdYXMr_kaSXbrjPzLQ&oe=69F4AF5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpFVxQSzTU8Q7kNvwEOpurp&_nc_oc=AdoppekxG4-piU19bF1wCFA0zAE7W0ViKAe1UnwNeD1sI_LZRoBjVevHLtQG9TDj8OI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ucJYSJr_pKuP98VXz22NbWHAL7U4-Rk6n9Llkk4z0jA&oe=69F4A91D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aU_EOjDZDSAQ7kNvwF4E145&_nc_oc=Ado-436kW3uQCN7mXbL2osPirG9RSCG325t-S19_7cxF3BT9KfyRacP2QBYNI9lb5PQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgUa1o2KvoGjtSgm9tKhQ5sK9c6-DXgKQqkXvQ3Pwu0A&oe=69C680D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeXULPFvmQcQ7kNvwHRw0-w&_nc_oc=AdomlK7DX2L0GdRoAL1XFwA9a30cfSqqLWck2pXhW11ymeRtOf9JffcgJPDtot20Nq0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyyx9hJCFIYBOScHDONdPgXbSU7Du95OObp6wv2WJOsGg&oe=69C68DF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7wokvS1Fr0Q7kNvwFXH9sb&_nc_oc=Adpf1j5RyEn_VuWnCcfuaCXAQKJJYf0Jdu1Gq9vyLppo5oLekdBhP5Y3JAQwwETRDF0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNldoM5Zc_gSoWVlkF9bcvc-mlj2Fg41BJMYAxTGzNCw&oe=69C689F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJHFKtp5j24Q7kNvwEfb1dL&_nc_oc=AdooN1wcU_B4BrVCuCuKcwNYxLaQ9in2Spiyl0m5pNUueuL4qsZhYBFzp_Zf_XbiO2Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbE4hiUKz9NxVhpbIVhevuVFFbpDfQY3iBUEVKuW2LBw&oe=69C68ADF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMvTsNAC6d4Q7kNvwEnR_RI&_nc_oc=AdqIirp5PDXFPFEOF_dsE9tVg2xbzq4hM8ORvZvp5t-LpieMSuUzulHyaRhPQWwpHH4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwnjHCLa2FEI389hXz1PwE4DDh1ZeYh90dDEKTVC3k2Q&oe=69C6849D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
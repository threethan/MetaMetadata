dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YT5EJItzOxkQ7kNvwE_T3zC&_nc_oc=AdqUqTucGPx45t6_ZmM84hwaGFCQVjEyrIShYo4pb59--z7MGz4E-SEsN9msB2fsTHc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj-qfOZ39S7uh7-UI0Y-uHSSTOdKdGY0X3yHhjruESjA&oe=6AA00851"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjFudbpXetkQ7kNvwFuZzhu&_nc_oc=AdqdS6pe9tXcdQAP0VOZVw52SXo1NdaZ5HDR3izyk4G4wp8gsN11Q30cQgBv20vlH6o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPTbVMhZELx4Oghw7hxbuuX0fRIxz4ghtzmPp9Ouyitg&oe=6AA01574"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DnAQKUvthUQ7kNvwGScB3l&_nc_oc=Ado1P_0IzynKgkHFLYQ_snicipQRIvsYtCkutUF8yxo4xiY-7JTtnkxfDe-OP0XHs7M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRMCxld09_VG-Wy5avLwN6--oTtac5uiuPYr1A5yo09Q&oe=6AA01176"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbO_jxiAeUwQ7kNvwFJQIDj&_nc_oc=Adrc46awauJTLi977bGXCmE7nmfefT5bh5ohPQlXZWWQW5g8YfbcB9r21IOL1wAfSE0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkppEP_1tPdV2h_KtC9yM8GbgPEjwwXtEzJk00YLaTOw&oe=6AA0125F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4FSs69xF0EQ7kNvwEt4vIg&_nc_oc=Adr_nUPEdgHSxp8tM1A8kfaiwQKgevri-6dUBD9d1CWbBhfaInFs8lTL6Cl5r2UTgeE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgM5uc4bj6xci6foLRU7T1HcfBQkCPCNY-_4E0UuzbCQ&oe=6AA00C1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
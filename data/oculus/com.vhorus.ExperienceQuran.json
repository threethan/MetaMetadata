dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9f2xVD1UxkQ7kNvwGLKuQO&_nc_oc=AdrpMz7fziSsfBHK6ztzBb52Mv6VzSKRI4TUR10hqIdTSjHubgDZpDzkeBR9OZw8Oy4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iQjvF40oPZJIB4_hTjP11JQ331Wc9UCK4XECHb25Uig&oe=6A2D55D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEKxGaupqLwQ7kNvwF8jE6S&_nc_oc=AdoC4Gyhqa9UYj6H74WAfpxeOBstdkP-oMeb8VrkElxW_5sMyEwRLxz5foh18idyg9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CSE3Mu7draYjr6MbGWKbKS4wWdaMDnnq5GYsDj2LWbg&oe=6A2D62F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5yjOWHEdd0Q7kNvwFaTNE7&_nc_oc=AdoSJP8zSJYzpjt9-oILWG4eMfjdIpS6s8gzIn6iuaPvb2em9TxfFMq7RrEN1MdtVUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l7fP6_s4UH5vIq_xq1_5PDx5hjw_TSPelu9HPth-qJA&oe=6A2D5EF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwSg0fpLvL4Q7kNvwHZBfJh&_nc_oc=AdqP62wjwWj9Z8Ahv1l08RmjnhRoP2rY8ofFkfLPNKWAT_Kbmowm3bG8zXFzu0aQUac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hx9DEYNLlPwtBTg6Rx56eAIGDpzG9hEkPmv4-poNLMg&oe=6A2D5FDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bY1RelZ3zsoQ7kNvwG_zh8u&_nc_oc=AdqJTHFKcW7iqsM79KHp7huLx3TcJ2ZbRGKE7FVReQ9YcJoeUn-d4Q4qwR1MbI2okEs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KXe8HwhYKFXRbdZT2DbzkeoUgyDAoFeDX03HQvkHqDQ&oe=6A2D599D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVuUpPKWv2YQ7kNvwG1zQYs&_nc_oc=Adr8aXMPuXald5hb2iYohupTjX_PNoQLTTMDGYA0Hyedtg_Smc_46u6w1vOV0VVVbvA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_Kn84X1NycExW-U7SyP-oyZkRg9LtBFoyuCttwO2idg&oe=6ABD0951"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naCAX8UKnvIQ7kNvwGD0IvG&_nc_oc=AdosNdwfU_BRqhFp73hZO4SDWy3yDF4VRLIgxW1J1IIi76FxKjPnLdo2pkA2law3el4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL98l_obui-s7IX7Nq6NOz5S7US7BKjotLiuubbabpeGw&oe=6ABD1674"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXhBZ1Kz4M4Q7kNvwGwOypC&_nc_oc=Ado3Y2o9DzWAYFzhR859q-DZSt0Y_wvKkSkhQ0Yo0Qxs1Zr5mkpXyWdTECBLVnnuy9o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwc8x8mOKl2-kzkhoWrVhyEYkHbEaCSAmOkNBdzMNhZg&oe=6ABD1276"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ruZFcWBUQcQ7kNvwG5tD1T&_nc_oc=AdorDdRcxctJlbNyPa8YZ8SeHVA7zPuJjaFzsoy9XBJcjK-PA1L8kk7mmg_SRp4YIf4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEYkZxEUKwKzdJ9z7b2l4PuineKPVLiRqzDKAOBwRDOA&oe=6ABD135F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1H8PNb3SKbQQ7kNvwF9NXBO&_nc_oc=Adq_y5KulByKQ27lWPZ5l21vv101-hCtnfZ29eASVVchKOYSA9z88ieCZ7TI2B50eA8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa_MPv9vgiHFNBEYaBA3dTt5jCVY-ScmDOEAOeRh8ztA&oe=6ABD0D1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
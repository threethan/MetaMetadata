dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cb2znY6Va3AQ7kNvwFOYYHk&_nc_oc=AdqIhA8XI9-U_hKGOwH3zqP0tgcqAEeuWcBoo9ptl6Pm2U7EqQO-2GTilf7J1Bsic2Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpquTPjlST5i5l9fbn7-qB3ZiLJGgJrM984rdx6MF0gQ&oe=6A9AC251"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQ9r5GE8QhkQ7kNvwEfH-ei&_nc_oc=AdoW4rfOpnmp6X551WQsEaMT1g3yQjtRIJooXx6VFpuq0QCllXmn91hq7_4IP0YxUrY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm_Gqw3VIm97hgekKt49wjlcoz8yi5QFdAEejbEl3XZg&oe=6A9ACF74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5q7WLizRJ8Q7kNvwFCiyBu&_nc_oc=AdpB2Qk9aKn9LpJH_uEji3S5FwRvMw_InpvUejqheoiQPgyO5Upb7V9hqki6zYoJMjM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZIHTMQyPI4mr9FmJL_1R-OVXJB6RQyjOF4VfQbi5Wbg&oe=6A9ACB76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpHQ4ETKanEQ7kNvwEBmUkh&_nc_oc=AdoXFPm2zSa7hm0HB8JL6tSnmsI6pyKVg7oeB-JpWZueu4sj6mpEkQfGD9e02b29lGI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdOOY0TElCUWZsExVgHjFthTG74KGcBOe5LUYXQJQg0A&oe=6A9ACC5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTfKpr8LCtUQ7kNvwESM6QK&_nc_oc=AdpuMVLSB1WbfL3rr_bqAuuiTCNqDeO3t8K3cofEJz0obf2Fz6BNH0m1ZIGtXAux4R4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiY8HYskgrh1FeMY57JnGG7HCy4E7sB4lJSEuR6Pk8qQ&oe=6A9AC61D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
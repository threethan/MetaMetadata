dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4NPoiNxlHwQ7kNvwGV0__v&_nc_oc=Adrqa6uXn0Z21LpR7PTfgZTq9PyijWgl9zgfKB4Gjfl67OCf93FSPX8LSbWKLB56UuA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwlp5o6MCkQUXe50j-YP88dqcVWdWp5ZXytsmbNRbn-Sw&oe=69CE69D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnO5hy37E50Q7kNvwGn1e4S&_nc_oc=AdoNALKB6PGZqBT-KDypTfihR9qJw-y8M4xnaR3ev60-SOnYZMADWKOckBu7ziwru68&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwg87zSl6hbMIwOKBhpM2xNbg6qAKiVm2__WRyQskpoiQ&oe=69CE76F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2XtUt35p84Q7kNvwHlVtPx&_nc_oc=AdpwQvXKQuZB4B_JTwkRj-DSZz__9VDrOSwRiFhvh0WvZZ-7gzGcGHdLUyAJ2NY2_qM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVZ8FOtj67v1RfjNP__RYMl7t06EzQO-6Xyl5hnCa5cQ&oe=69CE72F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyR3-00sqJsQ7kNvwHxpjyf&_nc_oc=Adr6GCJM1AA5eOkjI4D3JLcaiuRMlYiCjBo1WIuIDVk4hY7usXgO-oTOX7Mu4KFfrQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqV-5Oed0wJ9TQHn78v_trLz_BEbQ74KlGTGG7lagMtw&oe=69CE73DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EybpkHrhv8Q7kNvwG519wB&_nc_oc=Adp57K9bbpB3WO6D70AVp154dfyh-SXaUzIotNhq5W_NCCkXqSolsuB5AoSMaXkej94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyT8MDqbb02Ju3ODfBCk4K82rzgzNeC1xmcARnyrOrNJw&oe=69CE6D9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
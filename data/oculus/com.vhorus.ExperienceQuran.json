dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wn6TLi8CLGMQ7kNvwG-vigO&_nc_oc=Adojw2Pp7Afm9F5cMS5ne4fBrtITx_lKLGDQ4FKcfd2KjZBGEiuav9vSNcBRlrss6aw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_dKqrQ0xIbVxu4UQ9jfVtb8KoL91AGUqJPx1Dldwo6Q&oe=6ACFB691"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCyiEUs7xM4Q7kNvwFVcTgv&_nc_oc=AdoQTAIpN4-Yh5rhRn8jSbjENeBzYpGcVLykgxMUF8hYgTMbR_GB4AYaOftqOnmLqdU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv7jFIlQUkOaEzmNQuKXqH8Pt1NX5a1lQNUfdZsYakqA&oe=6ACF8B74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iu3qGce24PEQ7kNvwH_Gf4h&_nc_oc=Adrsf0Mjilf3mXAHoxaCLRRseZ8ZDRHjZKHqCbNt6hTvdJ7kvVZw2-StCNUBIehJvPo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNle1C_FMWg6Wy_66SfNSXEgOn6FYT6xqZud1pinM6OBA&oe=6ACF8776"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_pUuQcn6wQQ7kNvwEmAhNv&_nc_oc=AdoBul_FyxXzqIdssuPVW9ik8_UDKnpa0J7jM3CI4B1ZyeX3MaD6hdtW4sz7uEs2WLg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuu3WC4S4IGVwvxtRyhytfARK9sZfTDrdsI7ny7o0X5A&oe=6ACF885F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Gk5p5Zeor8Q7kNvwGNAk_-&_nc_oc=AdoyVvFOw4WbxkISHSoGIjZvGKxvoVzeFqWF65i_RN5YwMDRyDAAMlZHo4Q_40TX8yE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB7HitYyFJyh4CH55QIUq-ySt-YceNo7hRNfyJCKNA9Q&oe=6ACFBA5D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
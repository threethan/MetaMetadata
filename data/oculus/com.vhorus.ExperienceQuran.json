dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PcasXFJd9WEQ7kNvwEonuUS&_nc_oc=AdrICMg4H7NBufUCf89lBxwn8jCCvfzdUsk8pqucy5wV1UkALt0piiRREr_OAiTXH8o&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4UeuDEtJHhPzgnysYH44PQl5qixTeHqtAemjIOtEYQw&oe=6A973E51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQ9r5GE8QhkQ7kNvwEf1lmQ&_nc_oc=AdqfvpLykobWdhbOgmUOSxaxhsSCg_jc4JeyTxozQIZ7r5OgdpRKEfUmdvUqI_InGro&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTiyIXR2PmBgwT7S3eYhA-sqwI4xaTL_rzOClGMrVd0Q&oe=6A974B74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKyZJCA_9-0Q7kNvwHOCyRr&_nc_oc=Adp8uNzs1KiJDc0XhKgSjQxMwci9ucpN-Q80EMV73bv_eJyBYa1P5-XjfaRi5R77brE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiNDshRbm_F9YK5ML8TRo5epebGIxyI_74iw0tMQmzBw&oe=6A974776"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rfq714QxR_sQ7kNvwGj9Jz2&_nc_oc=AdqhbxKWVotLGiDZ0o80tvTQioBSepFgpTh5leZQlxaYkezYOWG9alnHPeGN9sct2ZE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgt6eOFyWuTnA75HK-ctkNpwrWtTcFu3W5oOfIQ3XkBw&oe=6A97485F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGTylMepXLMQ7kNvwEVhZBT&_nc_oc=Adr_SvF1tBdwPLcNJXl1a72wsjlA-GZFOiOI0s06jLi7I4rJ0SrrRdJDGf_haU9ubFw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaNjPdCiaHTxjAcCTj3ZXQA4F_MvqyjPNikNvvoPGKOQ&oe=6A97421D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PcasXFJd9WEQ7kNvwH87-Zv&_nc_oc=Adp6mMg7AiW96f-qCYjhfAFQZ38t-2_0y1cnJYovjZdj5qWzjOtAegKIYPCdx7t5q74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHmO2zM3muTStdfVFxiRZ3phQqo-S5E7gHiifHNVcDTw&oe=6A95B491"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V97etQ30doIQ7kNvwFwGbRy&_nc_oc=AdoOFAQH0M6vxyu0ewcgplzqYKrQpBZziG7tEL0_YEUtz29jzDw3ytITing418pW_ps&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErJLUAw079chRYZ9ZCx68wRPKvgXmhtrv6MnlUaR-o0A&oe=6A95C1B4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKyZJCA_9-0Q7kNvwHuSyEN&_nc_oc=AdpP8EL2QUK7lBLAPRqbILbJxs2Xz3HLK3aoKkl_3yp0JBrOm8UCPX0rZ9P7h_ri8dI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDGG2i5k___8SvLlDtD9IKJPvGzu2uSBWQwcQkesE-Tg&oe=6A95BDB6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rfq714QxR_sQ7kNvwHM_hFx&_nc_oc=Adonk8GYJ8uGoSgwWmUxLlEukes2_3Zj8PvEO1ZjRczVIH-UalQF7N2RHrNTjo-Lpis&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEotr7T0QYLknF5YZiAN4RziYNMwqoLjWYDDZ3MBIIHJg&oe=6A95BE9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDuoeiJTpeQQ7kNvwEdLzuG&_nc_oc=AdpmF9nOk1hdGLxMgg8i0zNlQQn3I7gRYjKB33Olx-dbWDXxBxD9exGln1jmfjpvg9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6BBZMQBcWpLSGAmieCxqTJvCephiEKYHY8fbtBg102Q&oe=6A95B85D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
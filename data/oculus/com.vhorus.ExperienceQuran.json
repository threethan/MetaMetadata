dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-lobOiAgRMQ7kNvwEjYltt&_nc_oc=AdoWoJdf7xN2RNwHuRqsr33zR1lE-TrCBO_gA-ss1zb7nh7mov4s7MtZ7Gekmmg6ffQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PjU08oMX7vgLOHukfc-39W8i-6b-l69RyyaCpgJ0UBQ&oe=6A071A51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KhMMp_AFrwQ7kNvwHptxfW&_nc_oc=Adp_jCZchOi5oQJUbn4DrTMnSSyOvQW3Mzo3GnBgrnhfa9S2zm5jtI5bArVXR-sxqrU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uPXxiNl9mT31-ONTJur6yxkfStulXrcxzdehKFcsZdg&oe=6A072774"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKzbuz2fVlAQ7kNvwE2-FUc&_nc_oc=Adr9rXo58qaq4WLzRmRbkPla2gPUhZEdxMeNuHpFfxHK3T6iVn7dwAkNPDlTQjs-eGA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af791e4P-Dbsi6qkw7miqM_2UHPvYRmHgdXi5igf4zvMkQ&oe=6A072376"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dNBFBN_sdIQ7kNvwG_obEI&_nc_oc=AdrFqxQIhZNofsZRruMNC_NqDzIDkmnbfsFyxtjJyAbrPXwxjasj_ava9g6K32GBir0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af557opcnxHRF1JZTSWhHI5ulmkKWDk_lMB4rmPy4LcUIg&oe=6A07245F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK9ILnEx_aAQ7kNvwHGIDZV&_nc_oc=AdrXDIW2u8jrjNfaoNIcccpAyfJSrf-tLbTqQNoEjL47mxWu_yXKtX7FYVc-QoWEQrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z3Su31lsscC4_tPzF_nvVV4ua7S_Cpry97YFeJ0nMuQ&oe=6A071E1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
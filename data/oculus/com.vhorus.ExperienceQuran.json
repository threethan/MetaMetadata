dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iJYzo5rKn8Q7kNvwFq0fAn&_nc_oc=Ado4ujtmNYeV1_AbZo8-YDvZ7WVqQ_OKfY6v7XZXfS1AKaDNeNmIzmYL8m3pHwVTWbg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP39qmOE0DPkhdOBWdZK-QZ9-cQZR4UTkWbAJziOqmVFQ&oe=6AE49651"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hT6n3-qbQukQ7kNvwFcGX4K&_nc_oc=Adq6lhWGl3BZVJwqSMTnHLG0_wlmqacJmyhMTG5hql6495GTKaX_MyOJ-GqYoQ4hZEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKPhGpV4WHibeFtg9AC9vbKcnd67K1mllODLkRiFnP0Q&oe=6AE4A374"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxARTd2HcpQQ7kNvwFwByrl&_nc_oc=AdpxpWgzLLO-m_ma8wBSjcjQUSGs41yjeYk3OZ81vEdkEjMfM-Fmcd2EBxn6I2nHV7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzFtwD0qSszrOeE3DTaPW9GEeoAqc9PeIT6MYV2VBdFQ&oe=6AE49F76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUZa02jXKHYQ7kNvwEEymBn&_nc_oc=AdpDJqRpJ5t43ddGQ8DomJDQlH6r1ZKi7iJqhX6NgIhiy89XvAAy47UxtJLox5gf_sQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlm0V_rILfC9-0dINFKWrZ_vd4deARr1nnD589lZgNZQ&oe=6AE4A05F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zwJlTYWAAgQ7kNvwEgzCTX&_nc_oc=AdrgLdUOfHsW-fsDsGljrFXC2tkXEz4i9bTnW8XW0joW_U4XAWfBXAONNdoAN5-8rXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbq1Em0aNicr2ux4UIMhm-1SHk3yvz0GuV1AAPArNmHA&oe=6AE49A1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyRKwP-X_nkQ7kNvwFnFI-c&_nc_oc=AdrZ4wd7ovpSZaf4HsEvssiBiIqzc9AT7Pc5nxktdbVK8LS2NVcOLoKjv4-qUiN4Syo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJn0i1pJaHxSwxW0W7YH_AfSqGdG50D4DbLyUJX3tagA&oe=6AA54E51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sYQiE4LAlEQ7kNvwGvGOg4&_nc_oc=AdpSVnN4zMIhi1v9lI9ItvpaFbnF3mF1S6NsnkDzQfslLGs7vmRj151zU_5Zrvf7Pv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZPZ9SyRU7errRiyoNhCclX0F1o021Lxn2QAjMd76aMA&oe=6AA55B74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ayGaJ8aVQQQ7kNvwHiiL4u&_nc_oc=Adrknkb2QAaWVwKOkVUCwnEeuZx455jjSLhFyPiMtzHlAg1pjrcPtbcYw_tPTeFSZ1s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGlTxZFlNSPHacyU0Ki_iTsAbAJxy-0fR8wypIfGrZUg&oe=6AA55776"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX9ZWHFSEMgQ7kNvwEXInTZ&_nc_oc=Adox2Ns3DWwtLRfagp3Q_eHyRa8p9og1Ie1fnVeiwwYUKOKP5dXXAmgxB-M3z8oGDIM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFRbIS7ZZSMCazP7s4MUWa3iLlZy_bSb2dCWKWWhPFqg&oe=6AA5585F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPUfN-XG1BgQ7kNvwEkB3Jp&_nc_oc=AdosTwhz-UscQ57Es9BoTAaoE2KJmzrddu_LBTfO6pemB7vp0KFmi7rA8Oud2ZzcIiA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKn420wbY_LlWq8tjODxHBfkdb5190T2fzZ_gV1zFJpA&oe=6AA5521D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
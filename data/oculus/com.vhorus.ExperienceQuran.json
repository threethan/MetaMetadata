dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCflgFvV13cQ7kNvwGB76to&_nc_oc=Adpd4Kg10IIT7ua-Wx1kDfhPsIAr7Snz6ZdDmRACyg0ioMuiPJ56gJOUkHcxMTwPfZo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bE3sne-p-fuy84ElBzjW_eFkNHTSqZk5ehY5Lpxn8aQ&oe=6A26BE51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdKGamewmjEQ7kNvwGIaPYG&_nc_oc=AdrGzQO52-iK7294zlXFAqdfV_o2kdAwqaeXkBEQjNJOPsFcSDVVUAEMSNU9tO438rA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xTl5q3D0lKMhw44UFkFlCZ2pFr40AhO81U3DMcaq3Dg&oe=6A26CB74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMcdgXywxEoQ7kNvwGhRAMf&_nc_oc=Adr_zxaMuzbRH5pacbcHm8sH86I59UWy93_SCek8iFx7ML4KjxyPuQF5h9KrEOvGOxs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QMd8YhtGYdy-YZhUtNrk_e1eAfRLH_dlMIvxxxVt-cQ&oe=6A26C776"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBsuoj6yRMcQ7kNvwFg90M7&_nc_oc=Adq0I1u0LoBArdQotvrL4DZiH-OFC5i-YkXMulXNvrsKwu9J7gznfwC2b5JQZZ5SHH0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BADve7C5ygG6k93OUqBTTTJqjca6XVqkJnNtpMtU-LA&oe=6A26C85F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kx7WMqPoad0Q7kNvwGSf9SI&_nc_oc=AdoWHk-RW3AM87RkLIFCGO1LwfqX69JUhKEJKfwGcXZEqbiTrnkeSykjYF9PALPDd54&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PHsBH6P2LQofPeuwQbSPAStMLz3hWceE8G0HhePeD7A&oe=6A26C21D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
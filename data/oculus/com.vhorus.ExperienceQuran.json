dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydPpoFHVSwYQ7kNvwEg9SQ4&_nc_oc=AdqdDsQ4qRzzGjAYeo80Y5YnKyOAiUzruwVZyCqYiDV5LLWq5q2ebjeQPaao1YWxK-4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U84MY3YEoOZIKpu0msex_ACcO9ot3XRVPD8WnLPwDXw&oe=6A1AE0D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzX4nKsIihcQ7kNvwHIpoCG&_nc_oc=AdpzgxuuNZ_Vgvjrxcf8po-f9YfonROKulo1jXF9SqUGT63T1e7A3UrAVlXsaqjUchk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A63MEEm39NnqCDYly3UMyhbj6GUgkfLFWOw635CmoeQ&oe=6A1AEDF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vADs7WpAZnwQ7kNvwEayJuF&_nc_oc=Adowukdq-rqhOAdI10j9ngQghvVBMsKMnCIP2jFyAcMDSkqW8oFBUMthr671OhFGkuI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FNPcAvRzTeaJp3qPYmr1Fohrq_eOfVljxXiBnY2wT1w&oe=6A1AE9F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-eKbmKb3ewQ7kNvwG6mEmt&_nc_oc=Adp3KG7SiVyc3I7dVq9diwUrL-WTkxi__-LEgtHOXNoRzWqZbUzlfr0faRpLbnNqIQA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wLlw3kTY2h9P-BLw92d2Nnfj7bCOQpLMBvU8zZAuC2w&oe=6A1AEADF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNg9bmZUmhEQ7kNvwGIRN8-&_nc_oc=Adpux7xekJSUSyvnSEM1SHPv7WDKX_okCxK8GCVodiDRxpAxcIr8XmCYgnfeYntY1UI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SkirfOsnya5M2lI6B_COzV5HZbLyeb_DFsVhyX8BxDA&oe=6A1AE49D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxverbQcOBYQ7kNvwH17Rp6&_nc_oc=AdoqOA-15olDn7fDL6zHlzPruRlusEvDR6hxgvXRSWATWdW-bjx8DRtLxH0EVC-a5W4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rYBiKehEPYirZL_4WYgw8oRuITgezvJHvPvEUuDCtxQ&oe=6A3FCAD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vE1-SKXwFXAQ7kNvwG5BGsW&_nc_oc=Adq2iw6fMzcns-MVKwafmj7l4kdovGrukro0rd494XKa0qDDJKORlqR1lSoeV5aeuEU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YBUDNDEVbVwAo2MVRpEga7LsH4Y5fo_pGSwE8OKXweQ&oe=6A3FD7F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUPWt4Tvl_0Q7kNvwFDBwp1&_nc_oc=Adrxjs4CtCgH4nuNc1ooOAn-C-ALsPnsgOcG52uZRO7nPihIFQfdiinfpRDyvu_VOWQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94R9cgv2z7mm9bsCnMV0gdJKXcOtxAnrIsw-RoGKle2Q&oe=6A3FD3F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXvUV17K1NMQ7kNvwE22zH9&_nc_oc=AdqFH8NIkMcrCFj3vXLBfAOpGIu654dsg8lHjp1l-Uh2CrNZkG55eI1RD41cPwN9QPM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7fWerh9rKOJ3dpQ0ZZYcpXSP8_x9jRVt0x4gKbHY-9w&oe=6A3FD4DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYDeBU4vKsoQ7kNvwEasZ_r&_nc_oc=AdpVtfo2ko8W2-z2pgqEWO6SAmL9sWpkAbSyuKnLp6u5n7guS9FuPhVe-Sg7_T_0UyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dVk_651hUREV7QOBx_b3JnOTdXSHK8ED9D9mzgdj6ng&oe=6A3FCE9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
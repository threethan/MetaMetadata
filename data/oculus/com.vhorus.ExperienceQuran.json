dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpexLop5R_MQ7kNvwG1bzx2&_nc_oc=AdpTEipSPf1rOZjBBgLYMR02n46Zi0lpZ2ryXCLzOmmQ1p9qTxPsx7TpxzCWqPRsUlA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBje6HpqVlgTPjgRF4QvMeOnQ48KwF47WvRUwf3kX5JHA&oe=6A490551"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AS0nf-YUSjsQ7kNvwG_bj3r&_nc_oc=AdpThBih_xKH7Na4od-v-dAltzMCvSqZMkfNmYSJrc-UiarASoc0LUT_80Xad6l1_jE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDDigEG09QqKw-Z6w_EUb_b9JpqHg5avt0WSvPSKYMWQ&oe=6A491274"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pnTx4976EgQ7kNvwHrp6OP&_nc_oc=AdrBm9gTnqTk4giYURhuV6Nc8zIJ9LVVfaGhBtJoVqpDxupdnWQnIqwXlq21pKoCowM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJRco7Dg24ZZNCeTna2yDD_OEz79l6c9UoMgq75iEQYw&oe=6A490E76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMjSsH-XVvQQ7kNvwFwMDSP&_nc_oc=AdpPsQ-wFdLZ9z7ki0xY5tq0XKupJR3-w7p84Pl0uLXcG6xAscJiEZK3s1me7zgcj0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqt2eRZoXihENnBtLWJgRuhQNGDOYQCxFU_9Yo7iQw3Q&oe=6A490F5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3-X6kZ3-3kQ7kNvwF0bSY0&_nc_oc=Ado0vxj6-1PXBV2pAF48gLlwB-RrUwWtAaMXLF4KUywQgAAeF4OKeI8Rc9w8OVQ8fFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAsAXAOFRQ0fZiO4wLzQcWOXR6ZX1fEilelvGH5I3Xbw&oe=6A49091D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
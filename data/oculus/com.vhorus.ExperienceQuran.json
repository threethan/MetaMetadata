dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhoM93VBa0MQ7kNvwHysnIs&_nc_oc=AdoixhjpxfUEFrbYzJG3JLezzl7x9eNcO4MUzkQLOeJkUchlJlP0HzULwPEneD1Mgzw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pHGFPaqZF2h4BvgMmoXfEhVTnEmi7i5O7cgfq2Fu0Rw&oe=69F9EB51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usqDgTkZAZQQ7kNvwEeoWLQ&_nc_oc=Adp1qDSdYrNs2yB-IMJRHASnX7q2qO8zYnH_-iHvuVuP4O2YLc0sZfLVl7_n19wqhdY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X1_2izSUEDuz9fNNknEZqxcFvJ5hYynO-h6or6wioZQ&oe=69F9F874"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8y_Pi7J5rgQ7kNvwEEGNV9&_nc_oc=AdrZncvd9voFw2pa3392h7gUkAdWt_frGDNQ-hpkKACcncwEIS-UUNG8Eys_x_h9d5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tDInNElmTmp6KMmnYPzlRpj3dcTP4GN-mOADsSyVhwQ&oe=69F9F476"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xb9mBSdmFFQQ7kNvwE2BW76&_nc_oc=Adrxyprpw-yJRFACZyhtVSdU1NGxw-TAjF5qiu6HLZww2Fi0UMk2zAs7ohmFyVc9L54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EVK3kd9LhjS73CfqO4HTFOjIEiGNetpPsb1jYVLc5Rg&oe=69F9F55F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42QQ59nlJkgQ7kNvwGxiKA4&_nc_oc=Adq5UgkvhpGd9A0Qlk17u2Xb4OOYwGmXlHqHXPTF3N-pMgW2YheNfDbo154VeIIQkF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66ms6saWBql5ZPorflJgrDgt60UEsPCzICHGVSGniSDQ&oe=69F9EF1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
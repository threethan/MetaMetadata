dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-lobOiAgRMQ7kNvwGhD1uB&_nc_oc=Adq_FEE-81LiBC8krupfd1ptNsf6NVhPzGgzwQlQUwi_afvhsGcfaF_lagQLG9Ma-GY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zrqztMYQFYLMLyCFeiegSEPpEzgXr1IDEyvNHJEZcEg&oe=6A09BD51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoSev0O1w3sQ7kNvwEU7Odh&_nc_oc=Ado_l87ADaggtwo5ptJoe_qxD6-O6ekYry26WY6XKdpB-ErRbdKmGGZ38KsC0zf_5N4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vfRy-2UcxfgG6pSZIvysYNpXdiHYdjcd0aIzCSOus-w&oe=6A09CA74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKzbuz2fVlAQ7kNvwHeAdzO&_nc_oc=AdqJoRZHkJjUw5zdsEkW8toPp9kUMSSQNP3ShcpqSDXzUSbPpb5LLLgswvlNEIBramc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76lrsk7QNVbNn2omGF125Guv8hoqE-0vqNzXfZUcoV3Q&oe=6A09C676"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qj8TfzwXzUEQ7kNvwHb01Ua&_nc_oc=AdqNYufFPVJ80U3D8E4Ym9WG3RRIsdnotQtDX3rwDt6liZRO5u9WZxrHbBQ0JrmvVdg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qwzF4dwJo1yx5UaXLSSTZAB8eqnfgGnEHKUqpbiDPVg&oe=6A09C75F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=na1tz-56z9YQ7kNvwF3B-7v&_nc_oc=Adob2Foy23Ma6w-PYsaodDkTrl0jGDLNFeGxQCMYrYLqxfHejWa5Sc_gYrX-ceDAqEw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IEIZcR8-sKna0xhN5PfYMag6DuIuHDL7rA2NlAmCO3w&oe=6A09C11D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMBoolwMXhQQ7kNvwEbZVGU&_nc_oc=AdrsoL7EFM4qoI4jdtA9H_FfXWh3GD-MlHItQOG0IFb9uLIzib5hVgRnyQZrwHd0RZQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsPEX-sT2lvWBucJUbdQnIMS2bfuplGL9HpnpIrP7qeQ&oe=6A7729D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9x-retLSVO0Q7kNvwE7jI0k&_nc_oc=AdpjU1n27aM4G1-l68vErTqh2ZOMQbEGsPSm9HGCVUBGX3PeQtlH0LP5Bxxt_6MB9A8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0fX2v6lUb2x8TvMyopuOTuQroG8ouhj3vnkrEzCZJYA&oe=6A7736F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKJKYhHZNYcQ7kNvwGwEqRw&_nc_oc=AdogZgNEFzvIlKiWpE40eA1VNhg7MoyhjGwuxNsG_yt3twaVbdiooeNRCcW6qYHsAIw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCNLRUPx8UYRdgNWWiHu3KttrJOBK32PAwhgJLnj5i6Q&oe=6A7732F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6ykn9FajmUQ7kNvwEZrBuU&_nc_oc=AdoSrjxOvYNini-ciHuL-jLmsrbtFVSAAMH-q8YIFexIEACFnsww_fd84WNP1BQkPWY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcGS3c5F6OY93RQ6rWbeBUXulAyN1MVeBbXu4nnLNbBQ&oe=6A7733DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01bXFtMo0lIQ7kNvwEwrZiB&_nc_oc=AdoQ2jLEluPdcC0-2SJgyNqi2pQC74DpLL5XxlOK4GOSOLjB2Ag0oGJ4eVi4h6VSCOA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOYl69XVg9WAxwnSyfq92XfM46OA8cvc095yLQNrlZ-w&oe=6A772D9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
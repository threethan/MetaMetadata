dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-UuaGWkYJcQ7kNvwG3xvpi&_nc_oc=AdqYXpi39xomxnqoppFNhvqbRUxcYkN0HlINCdjh6xzOalS_LMgWzIAos-7Hipv32pc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHib9ahTY6wJ5QA2E4KXb-ZzD1GTrR3Mp7ZYg2Hb3VNoA&oe=6A884D51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gK_rivwnSkQ7kNvwG3t5qk&_nc_oc=Adot8ukU-5O9ahsz_zi9pxOos3GoGzC_qrRhcSjfWDTVFeT61nBWyvohL_0kThk-h8Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoR05qR0ikAzcCXgE_KHSoK-Wk7mPVPOD9kg2uMfU7zQ&oe=6A882234"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4Fbp6UzmCoQ7kNvwGJoyYr&_nc_oc=AdqVrUly0dgdQ4yCw5R1PpsMzrFZ-FC4Z_nQ8oFlE1Fl0rob1V0ce3sO1Xk4y0iU6zM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrwwF1IuWUNiRc4PHMzsZKmL7vsGT9rJ0jCE9xMZk5yQ&oe=6A881E36"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHCqBrZzPzYQ7kNvwF4tb1M&_nc_oc=AdpNCheoePHPgyYXlW8iDRrB8vIAgxooVdaz8bcbS_xqFVqLq1FQhF4ZYY4-paUidbI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhpP0Wb4W5BNAYD6pkcXHBz5hDIrB5Jfafam1HxyVPQg&oe=6A881F1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiCij-MsOWgQ7kNvwFKbpHr&_nc_oc=Ado5O6tA9hjnHAXyDd2VXp4814QPFstxXeu0J8pAmgqNQIzlDDw1aQ1buQbX1zLTCME&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOXAxk6oHcUPAhfi0gcSKMoI7YtX_2jQ3FMnfqO5acew&oe=6A88511D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
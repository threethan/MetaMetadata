dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMeKnbW2x54Q7kNvwHT78K1&_nc_oc=AdqIHL_biEitMn4QH1YDj9myO4HFnMl3Dc1S12mf0Ri4rfLyEhqFxtcSUtG2AYZ5cmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTivUOeOOI6trzY3stlHoNOf0f7mJA0zdRpoNa2aNBAkQ&oe=6AF0AC11"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9viU5fkJkNYQ7kNvwEK2RIN&_nc_oc=AdrPyq4PNwEfVfwnO2k7kEMMlhtgdeQET2s0W9RDL3jTwDYQ7GxcjD0yDIK53m9z8Dg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThM0GUaw0jXLa6HDgYjrVuazeQS5nPjxLgnpOypQy3rQ&oe=6AF080F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fo3XPiCtmiwQ7kNvwHSbERc&_nc_oc=AdrGLsl7T8zKnimEr59q1WBkxaPy_I9X_aYfXY8kQSQUY_MO242lJhnVkxcdOaT-TqA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeKnhxkRjeXEkfW4xwMrdn1ck87UR5wUxwcacaEIdWEw&oe=6AF0B536"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeYeVw98wfgQ7kNvwFzFEtx&_nc_oc=AdoOCodOP3eQUIewYfHSaODz8YkxNRg-DFyaxLjvGMgpjdaKd6zlZYerJitzHXD3WMQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQtKiYVCKUaXPY5558jVDewDnr4RqYH-Zrvbu3kKIfBw&oe=6AF07DDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fY8GWz6GCBUQ7kNvwG9Q3mo&_nc_oc=AdpmcZ0itjgxbpOL2eNrkXllJipzjWj3v0bUXg-NlhiSkjJvc_l5jIKNGGFM6vhQMmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUD1TWIt3qrTkTrDTCioXmIChcRk3lmRLkXNu_uwty3g&oe=6AF0AFDD"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
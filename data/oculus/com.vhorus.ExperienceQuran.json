dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMBoolwMXhQQ7kNvwFcTy2X&_nc_oc=AdrM-Do7tt4HF0xu9XtYf9CPSvM_Gnp5pq3ssg0RAOwgpL8nBH1aA_PDU7WZatd1pxY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVl-wh5b-Yjt2q1BPQ5FlTdmm51rvCuatmanz8-JAzfA&oe=6A787B51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_rCJ9fV6zkQ7kNvwGRdzm6&_nc_oc=Adoj43oK_L5TTVzfCIXd4yBb0GeJ1R1Y8LE4JnRn9pA6GVTYBGrvk95VSK2NtQOLwn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEskqjTAYmPA-2IcvjvSAjA-lelDjt2QS9aTd4V7VwFzw&oe=6A788874"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKJKYhHZNYcQ7kNvwFWRzz2&_nc_oc=AdoYdCi7K6mAPPzaUgR4HKUofFzTdMTf31PxD1gD5M2m-fonkIQX6r3zzHymf_QCDjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJZGqW7faWjOcB34-d18W_iwbT42VPsYwFeJoAvFDLvg&oe=6A788476"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpylBYNcPZQQ7kNvwF-caN_&_nc_oc=Adr5uXZT5lZ31yqyM9_rXTWCVPRMLWuW4nZtIdztOvL_RL38L2jI3gzqaqBvGFKnsGk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE3wXIkmPeORsDsPiNyh1QCd2Xv-jlqv_UNQ8FIBZxkQ&oe=6A78855F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01bXFtMo0lIQ7kNvwFoV3eO&_nc_oc=AdoqHsyREPnPvGs2iEr1xKwY97LTtyz0BTTX6gDtKDubc6-UxmsdzMSq0KcNJzA_Qcw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcd_f1VLY4yham7d_HaUYl-3l8wPcco1yROEFNniVtjA&oe=6A787F1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lf1mzgK2VBIQ7kNvwEcTDRt&_nc_oc=Adpb6O4ZZ7cSvwKt13wdLFbfwk7EE_jM_Ghh7kT_CcOEaXWB8DPD-UUk-jLVraMbGbw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PyQxxitKi2C8e_nGo0dMKdDsCganLLiSta7_95sUaQg&oe=69DB98D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1vimGHVTUMQ7kNvwGGrVHh&_nc_oc=AdpWztZviqmJ91WteNGogX13WCV5OpSFK6_dvk3EdMLmJYE3w0msjS-QxKz5jMEhPWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ix_itEe63EUo1ngzaEyYRyHQGuak8Il3wGY9_X11BKg&oe=69DBA5F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZ7DWNKhdZsQ7kNvwEWmRgh&_nc_oc=AdpV0R1urB1Is2CvKMl8IbjbTJpkXF47cO-Kx1VRXmkYoDO3NZ2IwJMDsBuvPaBImnM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ljx_PPGKzI9pLtzroC032VnSogDl4ufLXXpVMQZDWBA&oe=69DBA1F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFc336NV25MQ7kNvwHgZOP2&_nc_oc=AdoTghEgBJYUQb5BOFdNGNGE6_YPGj9z-HQkSxcxSnsFMFw5FJfl3y3xjlEnMe4ixEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IlLvnzS9syJeAz2FyBdq4F8F3-GXKSkJH6w7kM3Q9KA&oe=69DBA2DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeC2GbnH5SIQ7kNvwE5JwfI&_nc_oc=AdogJdadypz-D9EwgND9-xAoDMljK5YqHPfdWedPuTr7U3mRCYx-mJV97dSfDaP7gqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hOTMfUXfGQei0O5MLgKue0KhlZnKri2JMP5huuHwHLA&oe=69DB9C9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDaufdJ9yn8Q7kNvwG5OJey&_nc_oc=AdoI5Zn-ohHxl2-MU7cG65TQ_yhipuKKGOoxFpyRzIDxVFn7VARC2P5X74Y9zQNiMIA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJi6JSPLVmn8ZVBRUmLGF-icylqUw_YZkd5rIvsWWopg&oe=6A830751"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wwlAoT67dkQ7kNvwF6AuxV&_nc_oc=AdoZydRErkdmi5c-hZc7z3nY-R1mzwe1-fTY5mjzXm6suEfEKcqNdQKkRYKJen9wOCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESmBQaKhK2EUhoh0y7AIb_9e3CPhWTHvh6GqTfwIY-sA&oe=6A831474"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paKoSbHi0KAQ7kNvwGCshFh&_nc_oc=AdrbWAD7B-MtC5LZKy2lUUpiTRU5Qs2YIeGlTyWef_GJDQ7_q8ha3Kl0WNL0StBrLfk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVZknHSI2NUimAMFz6uDD9fWixwXVVsXWWrx3BJeOy_w&oe=6A831076"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbKWMcUl8yEQ7kNvwGXA3P4&_nc_oc=AdoNrLLMGmf5Y5w-_k9moBC_8oJ4AysqEfIEFiLEYfHCOvfkAqS670H36bSzJ0cFG4M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHORUc7nKcsVzvMQWM0iV3aLGdGurh8UJRNTFzvBwG3PA&oe=6A83115F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGgUYkPpjukQ7kNvwFWU7mk&_nc_oc=AdrCFRZuCQwEiWtZDt7fDhLc6QSonaqmPu45_nQBpLm5oZz5XQBdRB75KKyWBbc2A0o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAAvnOVez939zTd7YrcfxCgS3UxXZaL-LkL31Qhm-bxA&oe=6A830B1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
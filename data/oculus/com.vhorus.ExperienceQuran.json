dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iJYzo5rKn8Q7kNvwEXaj69&_nc_oc=Adrajerueqfjt3HBOX7AOK2f9rzrA4M7zrQAXtBEaZGHI9fil104YF8jt7LjyIhYS4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHPqMNIjGtai2iBpYV3z7q7pGgUbCizji9fpy13nYc6A&oe=6AE5E7D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hT6n3-qbQukQ7kNvwGlAOD1&_nc_oc=AdqcCODsHYsWZ5CLCos6tLjYVH6LUdQdmI5zaqTMALwhcVvHtHlT58CMzH3uSsCDC2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlH4Iv-Y7EUOSOCvCUSFHboBYQfVeqpVoaj0lwZPWv_A&oe=6AE5F4F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxARTd2HcpQQ7kNvwEhFDKM&_nc_oc=AdroXoBKec6jUdrIDGHd4m9-MZzlpSD4ZQA2CJhZMLImJv3yxvbp9KLijAvTZ8cvk5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEnj4PuE_0hWVfmMOCEV6FapG31m0uZDh54C_NWRWGVw&oe=6AE5F0F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUZa02jXKHYQ7kNvwFS4Kl-&_nc_oc=AdrlFzNGUViGk6Hd0ahAzqaFUvu1stLocJxDMfdrnvFHcmFk17-31_YOXdeKIkLoEcM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-98OugOQ1rcg3MuYPnQZdDiVsttUPApZoJHUzu0dyYg&oe=6AE5F1DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBgU-6J2LQUQ7kNvwHMRqqW&_nc_oc=AdqOBkou_gERTemTQCMjvc8NQglwhvoD7-zEWR0HbL7kGA6DK_0t1cWvXjEOgzPFv7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMl-91KPHkODe0oKVrOi8t80ItNPGgSIc3NrJFo3FTrg&oe=6AE5EB9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
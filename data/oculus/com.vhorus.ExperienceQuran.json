dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-go2Lqf79JQQ7kNvwHE_nLA&_nc_oc=Adobx6GVNc3KwstmowXcH8D_wu-mw5Q8iXmYpzcOmX7OdOe4cqbuHER7kkMw2sYNPV0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFDQJY4U0ipqusVpRHJ6zcfRTauJXyLogsdpfzQOANnQ&oe=6AE8C311"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-D7kuIkxVakQ7kNvwEnJOQd&_nc_oc=AdprhqrSBM0QycZyj4QFOoKsF1ub54EeA-rrugLb-zVmOqiTQA1Z9eO_RdjdWds15TM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSusJ1eDWJJwV9HuLVyjyyChTyrTnQ6WRL6IiGlF8rEKQ&oe=6AE897F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sk9SRi01Cd4Q7kNvwFLlP0A&_nc_oc=AdrkD5EMt98orCIgOi4p_4hnP0wD3upmEbfG-hS2MBeqf0R4hoWY2S781ThRToSqJGU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmpEtACBcqpms0TfVdjnyQ3SQIHJleLoYDLVcaD7KaZw&oe=6AE893F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4eJXHnjzmwQ7kNvwEK82Ce&_nc_oc=Adr6lvLqWFnzdcSN71Xtd7F42NhH-OKM5u5snaMS5u-YdBlQKL3nA0RkODmL97i76-I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQin04l0gfTvNOvLarOkqldoA_bXkRkEdtWTSu1aEn3AA&oe=6AE894DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBgU-6J2LQUQ7kNvwHtpX_u&_nc_oc=AdoYlqOpKAkkvBKqX6DmSUBXkNwK-MhtvkHYd6o3EIdhF9nb6S-IJNgtCd4DW7KXCUI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOzU0I077LaTpFFnxOejz42zOoPxU5tRF4aX3yO0PuDA&oe=6AE88E9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
2346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPkKjJzslJ4Q7kNvwE8BUED&_nc_oc=AdnZBqD5GLir39ZljW0eE1G1UUS31KbYOB9QOWPd9uQSs51-9b_N51z8yIgYXkxkeIk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvnQ1qM3_HM8oESj7C_VRY45lGgfSN4JdvhvAR1Riuuvg&oe=69A97FD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3SmmESRNL4Q7kNvwEcRY2G&_nc_oc=Adn9oCvjo4UdIKCilVmVOXirjWXvFmbbK5ZglIZlfx20PzB2KEoGaOW_n8QDdeXkEYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuYolEx2yfEd2rwjJvgqVLVWjV52OMFHAxskwbg-OGipQ&oe=69A98CF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzE8OaFs0fEQ7kNvwF6Bq0l&_nc_oc=AdkBE9Skw_GCr-i1lyxulJ0S5nwEtGf6zSu3dk0-cf19KnhCIDLMZK3yXSEuu2i4S9s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftK2dAHhRphcrVVwqNphw0N9rQvSRl9JZUBXrEP9v0bvQ&oe=69A988F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSDsvcfFLXkQ7kNvwGkNaNV&_nc_oc=AdmvnGBD5xGetmwzYQNGEVl4EP77QmBOefhHDniVE68dz2SIwBnc1DzWmk7x52Jt4ZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsQ3gDaXJVZXcerGjToI7LKt-TiMwDsl-LtRmIrLAyREA&oe=69A989DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP1J4wgvOFsQ7kNvwE_htoO&_nc_oc=AdmNKnmeHJDNt5N-ueeADl9p1zul-dtemCNvbjfLKIbL8rQFJ7ZcBz7PBEea7tbSxP4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfupWowLclaLkX0osONkcz7TKUQyr6M6j8ExVdGGpXqRUw&oe=69A9839D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
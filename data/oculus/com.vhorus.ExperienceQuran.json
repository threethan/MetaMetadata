dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YT5EJItzOxkQ7kNvwHlcM1C&_nc_oc=Adq6DD1c10VsQOOXMpCYEXBerC7ASNp2rywdc92LVr1_r5kPVFvZdcrFpuVrnsdXhOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCKjPDsRYsQjwaKDA6YXhYGDFZL30dwPAi6H01cBuN7Q&oe=6A9EB6D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m2lzadXCMUQ7kNvwF8pN4L&_nc_oc=Ado0-4evRzLFUAzyVy9ef12cX3yDw7UlzhI2TUII9wsBjSt0fIh1jNA3e946BObf3H4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTZyr5zV-626st5m6ENDY8TwqkR12uDxuxLvPsR-m7_Q&oe=6A9EC3F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DnAQKUvthUQ7kNvwFhlLho&_nc_oc=AdqY4hURYy9IC3G4GMYzK8vmiw--CrPpgC5Bu4OXRmXMsOCC3Y0aTKbMi292pdnpALk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2ejHKnU2xKgtyjULXiN2iYsaj9uEOSY534wEI-xJm1g&oe=6A9EBFF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwpaSPrQfFoQ7kNvwFt_2UU&_nc_oc=Adq1f5IXQEm0uNk5urKzHDssxbk5VywcR7YPlMopglPtYYqMjaGjAdxxiFgtr-5jPQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt1b40W7l_u9_fb49wegWsREZvYKSs7imeMsfyrAUDdw&oe=6A9EC0DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4FSs69xF0EQ7kNvwHo4tPG&_nc_oc=AdqXwILdsBBy64D15zm4FCF6wUFFhMvxvZpfi0cZHliNPh03ko8gb-UOe4hIZURJf7I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK4u1hTt19aDDActDilpHmY_VTdNwu4bjR0581oX9Xog&oe=6A9EBA9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
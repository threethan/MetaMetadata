dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVuUpPKWv2YQ7kNvwHS4I46&_nc_oc=AdrmN6mYgGnpGSqUyua8DamRciN5DIG2mIdgBFAV3WbMxipCh8qYeAhdrnKM2MY67J8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh7PSVHupWC7bAOJt2zQkxnYe8ABCmMVLeP2nGhU2Wvw&oe=6ABFAC51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btb7u2HbhjMQ7kNvwHS_vC1&_nc_oc=AdoAVjnYqN3astKzbdl7B55f2utVXwjZiLyQjil89dn2HQ0A8enARfXYrEJ6ddSX-Kg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP_UvtNBMe-vc4kryXGPABLhHVK5hrnNf-xwbYUiYdaQ&oe=6ABFB974"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXhBZ1Kz4M4Q7kNvwG3ADbS&_nc_oc=AdoVpSAQcikkri5aDjpGOH2q0d9_HBM2Dg6xYOzBw_LMZdDMx3N2JskPAv-XKE76O-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4FaoLk5Ca_f0RH7OgALqq-Nigoh8YK-LOlUmoWMcdxA&oe=6ABFB576"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG-iSWKW1r4Q7kNvwGCJqRN&_nc_oc=Adqj_X5DV1vIl2vGB-8sc-GMWjUuA1f8fSaCJkx_x_T_FMZ9MfcWPSYznJlTZkzIYKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4MzrcNsLmm6HmMB1XNO0CXFx3PuoVyl13kDrPJSzKnw&oe=6ABFB65F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmc1K8_JPQIQ7kNvwGgV1F-&_nc_oc=AdqqsCuGFvTgziHUIjOD_NilS2edvL-tIE2NA4qWnkW_OEuyYQt4kPIxTbsLwHEKQSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8hUX4d3PyQz7JXBBrkF6Utr7ufZys2w6C-LanUeypMQ&oe=6ABFB01D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
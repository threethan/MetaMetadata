dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbTUrtvQxBAQ7kNvwHdt_Qr&_nc_oc=Adpysu6RqFan58311sAKdmab_nTPC2D1UNoy1gI4yNHcePk8W7ArwqDVcgMWXb2xrJw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhPV1FDn79N2bFBALZieiHiLaqHr80zg4OVd2-vQDrTw&oe=6ADCAD51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bU3paRDNsD4Q7kNvwEyAm5l&_nc_oc=Adpb7VhXxmPLpZokxohzxD2GuPp2KE1cLMiJzKLArmtDB76BDfSrnARnWpnD_0NL_bk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyyKndRjh4VoqCuxoRweCSFaMhvUkkHMD_3GDp9-yRPw&oe=6ADCBA74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BBkv4HSUyoQ7kNvwHnm60c&_nc_oc=AdqhU1yGKW4eNnKnMReqDP5VF5ON_r-NZI3pxEnmEDXFIhA-WzXZPNQ5OJ16BgE7_4s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrEiN6Y02Uyv0RIbeaTXk8JQ7s8PAvlXtpYoFGJ-1BaQ&oe=6ADCB676"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoCVTxt6764Q7kNvwGikXOL&_nc_oc=AdpmRmgPXMXq1kyOdNVDH3bYkRdkTcM4p5Dswye_3VorwL9CGoFQ1MTyFyXJm2Mn5_E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtvTiiNX1rsIYDBNO1ZPR_YixtDD-BgvX92D_Mb_oxTA&oe=6ADCB75F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyizLDdQokcQ7kNvwHoU08B&_nc_oc=Adq_pv2k4_kNasmJJG05sFHtDQFbsPKuZzG6dW10vFYcpEKDuCP2sdg78pOOrdTumFo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNypFq2A2GH_RC5Q3Z1blzK7xm0zR2VM2e650nVTiD_Wg&oe=6ADCB11D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
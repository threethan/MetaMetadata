dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBV_UqYICcsQ7kNvwFN_59U&_nc_oc=AdpUP0SjHtvfVmURY1m_x911pRmzc9LlUBraqb4BGBfIWE1lvhxQGNpScDrWK5bZdYA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0E6OE_P38VmmMCCHM5-TwXH64sWtlmXT7J0OAqJDfg5g&oe=69E23051"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab_q_OR0HbYQ7kNvwHikQwk&_nc_oc=AdoXN6FGrSBT4HtEWYy6oQmxWjV2XxTCzzxPwY-BbrMh2GleigWlr-QGjMaoStHPWr0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NasYHvn93AmXyXofhu3SETRvvWA0GUDPAHgrdQYpMzg&oe=69E23D74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1x4fQe-7nAQ7kNvwGqD20t&_nc_oc=Adqt9aZ38IahfNgJHCs5D05nfSguLpsO_cluW1xcRFOAw1-7-Qf-YJ4ihItv13vuh2A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ttG20CNwVXqYrsY8q8rHGtAx0rurqzoJrmLjMcbwoWA&oe=69E23976"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP1ChybrHDgQ7kNvwE2I_ZH&_nc_oc=AdqW_sT37LrcuhxXU7Ly69lCOlZ7tbt-_8yDcCQK65zCrgfTpOjatTXlK9QjyJIDzAc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kpGZxB2WSNwIUGRFh3-NiJzBMSa1hq1AWBIj4miRmzA&oe=69E23A5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQf3JV2ciAUQ7kNvwHsqx4C&_nc_oc=Adq46-0ffvV9MteAWu8aeNnXbIoN60_94eAiBRR6SlXUziHXvWX40xOVAFF6Spa77Bc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bwDiNvG1nvSamP0kvCS4NbX6tjVNQCrRX_0v-tuvLMg&oe=69E2341D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
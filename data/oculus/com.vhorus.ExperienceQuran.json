dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-Bfo43xhxgQ7kNvwH38dNS&_nc_oc=AdrhNtRm8Uea_czFw_EmwMqfgrOIF7xw6pJCdxwIwnGdzyvr3zd59zZDxVBwXgygBys&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb0qmFdS0ocNXBAcxVli1EAudcVR1y8hOqie3wdxaH9Q&oe=6AA159D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjFudbpXetkQ7kNvwEjIpOg&_nc_oc=AdpOWH9ZhZYyg7WO-aGTsr_NnOtz6wdgi9lPZowCIR6-r0KD4VPJ1sK_t3hiw5nr1Ds&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxZ8yQw6v4xKpOgdt2qWAsNE9Q2QQpk1XTJ1KSKuenZg&oe=6AA166F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L44ynO_9GUkQ7kNvwGYykfr&_nc_oc=Adqv4NLSD9nGuaqJz0H9zsji6YCVu4sDgYZRDZVjhq_aBRDqq6JVYglDfcr-J-rZhGI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm2WM-iohfQzhESkWqjhjQRYm7yoJqctlqjyB3CQVepA&oe=6AA162F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbO_jxiAeUwQ7kNvwFDpWf1&_nc_oc=AdprbvM5gxpG-8JqnlhWDkvQCjDUmQOGeSDPEkYoALz_i4WMNqLpamGPXsVmWRXiL9I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs3_7uS0ImIpN7jOZ4_MInjHD7qn3pcQbfOHyRqZvSgg&oe=6AA163DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4FSs69xF0EQ7kNvwFrJvVd&_nc_oc=AdqkEMQO0PAQSbxZS17MzXQ7R5rK3xtLkMSdEjrcu7GQr-Wj0vDIlgFhETNwbfahSzw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJng6D-pvKeS68viDrvWdjDThsoGNjxfgskgeTP1L6zKw&oe=6AA15D9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
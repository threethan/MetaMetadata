dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9f2xVD1UxkQ7kNvwHqnnCi&_nc_oc=Adp5vcXtlfKuatw_vcqDD05VrY7lM2ZoWUc4fmEzXZeIRPKEKvEa-9Jedr8M3loHzEc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UuFBf6bZs9zv5lBBR_ZKocKF-Y9UELn1v0scAfqnn0w&oe=6A2C0451"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOi8mCU0UWQQ7kNvwEi3KnV&_nc_oc=AdoMQxbqsb5x6Jywn8sXyt4zEw2Vodr4CTq-I8C1m7_b2-Zqp5IN82B41c6CsMg3qOQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qhKrdJ8aRxhW6tcAP_8ypHiq8pRu4m7zTZIZCIp0j8w&oe=6A2C1174"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5yjOWHEdd0Q7kNvwEj9Gny&_nc_oc=AdovYdxJtb60RK2nImDAw7yOAeY-AbITMfGNoNrRVaqDiw6DN9zvoUl4x3X4AqJ3RWk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CYCITKrNWBjv4tuA6a6judnbSl0oEkm0rpGw8OhZTfQ&oe=6A2C0D76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-TEXneJl4AQ7kNvwHJA9RY&_nc_oc=Ado0EcVujC_fCnmJA_s5tIX2Mcvi7ycp1t32Qil0-NTiSseU9za1zpR2DEjDqjTe0WM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xWssVndXxtfARDI6XE3KIjJih_5ey9lB6wyasB3slOg&oe=6A2C0E5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bY1RelZ3zsoQ7kNvwGEBVUF&_nc_oc=AdrGJOJFsBEhKUoGmos-sNeOY8qf7xmP3WUPLQI0rYQFLWUvhGI6rdNnStxaRjLxrDA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fkI1cRpy3QL51L7on10zxYlwICC_pJdtyAU1vqCvbOA&oe=6A2C081D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
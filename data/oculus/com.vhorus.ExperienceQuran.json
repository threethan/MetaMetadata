dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFPTSV-_Nu0Q7kNvwHTBjyr&_nc_oc=Adoqw5oueNn43zcAW0RyiElFj3pwKbYAImfSFk0rm8ZpIkqRpmnqO1Bj8ycJj2bXLdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LxJcEaHjKHYPA7NeOvhDEhnUbzMqQ5s1mCOnlkDUD5w&oe=69D50151"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0xNyDiAv_QQ7kNvwELkktm&_nc_oc=Adpjh2DxoukXO4YvyxOV_UpsYjwyukIdkgFvDB4m5NTVsB50gUMD3SQPwESvkOaG4wo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jcv_bpHvMOqx3MQ95QiePWVDd1Y_GNng_LoezQAW8VQ&oe=69D50E74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRBHwq87SPEQ7kNvwEwPwvd&_nc_oc=AdqO_8VDdZHHVRagfY_jHFCBl2gDNH0HOM_LA9hxTvJtHjRVl-_t1X-gZABIh4GRTPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0P8VArJgHluteuiXr3Ghx02JWlAL43TejcZY663GnG-g&oe=69D50A76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Czc04sJlZJUQ7kNvwEBiRtS&_nc_oc=AdpHUtjmALI2fmzvluysXfCvqzBtysLmdzhAxY2xBVGD4iFTNScEefDbMqjxrcVB3bY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iog5MMVuI7kqSYQBQqYFudiOfDgOsR_ZHPTN3EY6Hyg&oe=69D50B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xq2fKdIhn_UQ7kNvwE7Stp3&_nc_oc=AdqkmTzA9YnMeqQAl6PeI8ZlYZoFzgGnspnChuLQHIvsRk_a_AxQ3roRF66cqeEOXAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sQwHTWwV0p_rPi2QqmPXElHbSPXJ3eGv57w5ekg52bw&oe=69D5051D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpexLop5R_MQ7kNvwGmKeA-&_nc_oc=Adrks0lLuQdnigZRpC2pC3JbAArtxfHWReZ8XQTeJlxLNEarQ01sNpv8enoxyVIt4Ms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aU13gUmzsPavYqkceM_yaKqnmWbzDhZEVLVBH7_5Eag&oe=6A47B3D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVdcxQhpSPAQ7kNvwH6KMVa&_nc_oc=AdosS8LQcbSkBbL6QDdhJNyusJPysyN3iyFyetxNb_AlXadGmNC2NZUt2WHuGaY30dE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ybIPIt8SJXRAPMbRG6T35rWK1jdB2EtzvxGem3p9ErA&oe=6A47C0F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pnTx4976EgQ7kNvwFeN5Rt&_nc_oc=Adpg3h7Me7OFFpLNaZI80j7Ax7zlHOCoQYavbsMrySzX5N8Sn4lIo1jSANgX21m8t2o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UQ1DJLj-nOp5r9F5zGJ9rBaqmFZmTP-7CfWhmH_Z5tg&oe=6A47BCF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuslJfYc18kQ7kNvwH60TJD&_nc_oc=AdoSCEv3jLHM_i6d-XsPcEzVtaRlcPEnugxnLAlMDaHbSRsIr2I-eKqD1XeD8mbWlJk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qNyybFnuAN6d1tkYjyBk39oUs8eSWeijUjGqzVYin5Q&oe=6A47BDDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3-X6kZ3-3kQ7kNvwGs-NaJ&_nc_oc=Adp7O9GikOodXRqTxXVa_S99iMyesP0YBS9Ntlb58JXAbnyFqnfSgxLFJ8KvFhA-6L4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w5G8ejYU3RdoYV0RQTo1Q_FsclgroC3Oq_eGPqj4xsw&oe=6A47B79D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
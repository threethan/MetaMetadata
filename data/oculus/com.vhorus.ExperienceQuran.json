dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCflgFvV13cQ7kNvwFWa36e&_nc_oc=AdqmJgsXwp_yO7ITj1gaatntduHUU8juJCntZ2sS6K0QoeLHQcZ6qt0YjAX9gI_4Hno&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Msy5x0sqFSZ42GqJsgVTrAeB1HQ4lOtLwvS6ww5HXMg&oe=6A280FD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdKGamewmjEQ7kNvwG1h666&_nc_oc=Adp_6KgrnjNWSv3h9vnpvmh9UNBOJ1RwdAGpCgWf5tyuKY005nB6bQilYdIeMECUy1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kwjCJVP7B-PsaBdkH-YpzDqPwUoJIh5d-Hc74uZPcnA&oe=6A281CF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMcdgXywxEoQ7kNvwF2U9od&_nc_oc=AdpK_S_6hajonLIhGGGkFlfir2HziaNbURqfFWJ-5PX3wv7vC2NDZ5a4Om0Eeg4lBcE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XeSl5piFJ6RBOLHTAORwpd_p55UDQEQfKZ3FrKAfa_A&oe=6A2818F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBsuoj6yRMcQ7kNvwFNEc_G&_nc_oc=Adp5U7oWvB0xlMrNaMzx_3kC2pV-JRmZN-yo4S3GTl0MoAspABDBErkLB7zTc_y5-NQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DZQSRox6Iy1SDfgWqK24oIbtIk9W6rhkPU1hdCL4DCQ&oe=6A2819DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hm-ztrEDPLcQ7kNvwH_SdEb&_nc_oc=Adp4CeOr9Wyu_vTygNiUfRd21uaRcJsHe3HUkHNeY6dpX87-BWW-GR3cd6efwsOx0G0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e9hOQtsfEiy6HP-m2ypD7TvRZMHU7P_xD8qD5l6jM8w&oe=6A28139D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbTUrtvQxBAQ7kNvwGma4G8&_nc_oc=Ado_zgCugz4fFTcfWrIhuovADn33ebZDkO7IT0sAiouVVttDcRxn3-m4gzPlPPmEnM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEs17amF6aTN64bDQfzR-0lkudrHX9Y6-I-WjDtcrc3A&oe=6ADF5051"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-Be91cXjqYQ7kNvwFSCn8q&_nc_oc=AdocOpvGqQYrwhW6CkWdV6P23OtqrEI6WkCVRxJme_HpIA1mRDWMSAdk2k5cJrz55JU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdjn1dzlecGde5TTbjkBvgeoyFD69RPb3LFhrf4nsX9w&oe=6ADF5D74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BBkv4HSUyoQ7kNvwFAZqEN&_nc_oc=Adoh4lIp7EiIdh0RpAX4ecpw_gCX9HpmZKHBgsI3Jhg_A52Hzyxv0O97YDA3W2fI5Us&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBGGI_WhMPVql8ODgRqZ-AUuoJlNh9o_H5CVy5Rw0Zew&oe=6ADF5976"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5kuNHIJlXoQ7kNvwEBDbUb&_nc_oc=Adp-fNlxrg3NIecycLjK6pXzwWWVxBIpabbM562GB0Fn5VKmqhu3Mz0GCXNpfVEQp9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5ygiHBIoLMkc_oFfjTzJwsZd55Ff4pX0A-5lyU48bFA&oe=6ADF5A5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BafIXEsMcQ4Q7kNvwGVqRyk&_nc_oc=Adoh_Ax98oxrB9KWlBSP08RSWBMG_iHSrDWz5-vVBFuQ4aroQ1KRNVunNsEyu3Hoggo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcDpvslaPBg07Ew4g-It_1JiHGIfHNAdrhljP2ZQx5cg&oe=6ADF541D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHoxNvGfZAcQ7kNvwGhlGhd&_nc_oc=AdqvjMVz-s5Xdb4so9Ajdl8dcEdongZYu7kNfHfVwp-PuAHFRt6_W6SBTz7k_tdms-8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnTNoXCEmYCvMzKqRPxW5vJpidMQImcxY9maJW79HOlQ&oe=6AE344D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hT6n3-qbQukQ7kNvwF9pruQ&_nc_oc=AdpC0gwpndUVWZbpXwdhN3JYa0Erf0QQOP9W3WEISH-Va3F1Mb3OM1dLXtO5XnXls4k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV8f7qFhjGMxEKUWcsjw4t9fl1uCjWUJnYET7rzxwJ2A&oe=6AE351F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gp5EhWqhBUQQ7kNvwFkgRMT&_nc_oc=AdocKETxBDtiHhvl9dhQ3WxXrpRA2-cO98gn7z_HyNNmy3RVQPAsmywdc4PsNX_cWko&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqZMYa2GYWvEXzFJjz1CScKgSl9WoXhYCPBJEzHpWb2Q&oe=6AE34DF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUZa02jXKHYQ7kNvwFTDRX6&_nc_oc=AdoAnyoJtrg6Sr722FtD-sHCXuvv5h8-Fe7Yaywos10GH5hKPsGATO1GgHXXrWwVROg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcVyvkmBg7WJKr49B9PnhhxW9xuDwegcX2eJuIkj0qHw&oe=6AE34EDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zwJlTYWAAgQ7kNvwFSY6es&_nc_oc=AdqHVBv3VyqIZn7Dr_gnEicKdYm7BGBF6kxyu47oNblkErnuQKzzSHma3rqE8hdhtvM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxoHA4rroojZ2VMh3seGQaoqJALpJIRbFfoEJ54R4KYg&oe=6AE3489D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6THMeArCIsQ7kNvwGg931H&_nc_oc=AdpAxSRf0WdmG7-NtkhYoJ-Ozb5WkFrugi2HTy0_eE5fGFLN7E68pBRuacWA9IeoJiw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af04M2tppaTKhpE7ZWA5sd4ktMT5DfIAGqp3yIr4A4lgHQ&oe=69F20251"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXyWyr7gog8Q7kNvwEiiu2D&_nc_oc=AdrHEbHaV2u6xEq4lnasW_P6D0vC02rk3y59s0QaRmWWMPbZvwmWWQKVhWPiTVXo4bw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1aBMZ0ui_6TOv9pb_MI2Hf_FqwyPiwfYRiZzA7qjGDkw&oe=69F20F74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvOBE704-HwQ7kNvwHlS4iB&_nc_oc=AdraKYYDvUDuN3zI8D4_uf4egWLUTEcNmzTA_MaYZjZHbXVSkAV_x2CPknN0q34gfmY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MqesHf8pWBhj_MWrBgBKi_pAQo5X_6wII8px4NmAyzA&oe=69F20B76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJveU_mQcmIQ7kNvwGZtvl6&_nc_oc=AdrmJM1g_rxMQ5QrP_0bI7HuDpxNYbr754JUFNwbJUjqK9vzTWKHssH3_apvWxBP_qY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1ZH0erycLuY4_Tpq9LcFlNCJCAjEdQLbdu6-CJTvxy9A&oe=69F20C5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fh9sG13bGNsQ7kNvwGSfYAO&_nc_oc=Adpcx_E1B9HzaPav8Q2jq6CBDd4onAvwphWcl6hBLUKLxiSTMH1Ax8WDs4poCohaAXI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af25LkYrQI6sSYvIoIxXFUMZfr6ibJJIzoGjo5rjVUChqw&oe=69F2061D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyRKwP-X_nkQ7kNvwFHhi42&_nc_oc=AdofvahjEKTjtSwcZeKBbmKhHPqasXTUf7G8AakJXytMdcYwSm-HO81HhyRRczes_N4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPySji64Isc2C0srppbbaF7L6poFT_kkO9ofadGts0YQ&oe=6AA69FD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sYQiE4LAlEQ7kNvwGZ0F3b&_nc_oc=Ado44JynJKKvjHWxns3YFIJF-SJ4jmcXz784jsufsyzyEHQ_noai9GF6JmPL7Aog_84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGx5a5rL9z9n5x-g1WiOxIuSNnzJjMDLj8dFPLsl0SAw&oe=6AA6ACF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ayGaJ8aVQQQ7kNvwEYLGIx&_nc_oc=AdqOxEUxiHARX6-bGgv9Hxc49b-WR2T7xKYnyZRogJKYDSzUlKGsr-i9tq08QjtArSM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtiPDFITv7WmI4TohBNRHB0m57qfHNPYmXlS355LI2cw&oe=6AA6A8F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX9ZWHFSEMgQ7kNvwGl8tOg&_nc_oc=AdokyJ9RkeJsVdLA3uVrMO8eFjm1U8Aii6lk8cSLAqXonnv0XQCo-sHK4-Di2Gc0gC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-c6djzDaomL57qH6Q58d0IWpaxCO3PVBp5AcgK1v8Mw&oe=6AA6A9DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfBprarXix4Q7kNvwH-N08O&_nc_oc=Adr8pgnSuerERVjn586TUbQm2zHNXsj0O-aQeRx2Xbp-dXQzgBNtMgo_BrYdhZfV4wc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwWd0FhoHXxfXHVjN-n_qrb-ViqLDzEOToaWNd9fvmbQ&oe=6AA6A39D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
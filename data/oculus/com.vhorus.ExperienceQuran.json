dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vd2YoUSB5DUQ7kNvwHKOxSM&_nc_oc=Adorh2vS4tzj83yelRUOKypq2vrSYlkzwsjt-nots5WU1i9XVkF_2IF3JWNvvZcaKgo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fw0nXL8YMxP2U6UY7iRNCuixn7bEOx-0Z0Sje9ovkOw&oe=69FDDFD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Bao5cV2WmgQ7kNvwHfAEhm&_nc_oc=AdrhLDEDIgjPF_lnvbnWfyqU4-uSE6YqyOmdpsDZbeMWdA8FUZYSdZ6pUGke_TdbILQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74mIsPiOescvSKl-Q1dwtOFT-GUTu_U_R8WaGQJDnMZA&oe=69FDECF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pW7MsCzwEoQ7kNvwGukC3t&_nc_oc=Adoqfj7YmgFRsqvEQzbzYh2D49ZeahEevYNn1KfbHkSGy7PQXrUCyvaetlfO265Tnxg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o4AiIMEJULdaR60PIE0W3ztkcoaUPXC-AkCtznYXZeQ&oe=69FDE8F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i12S99nhsfIQ7kNvwGtlMrK&_nc_oc=Adr5WcWlxnv5ggKKdIWLIM_g-cQUsQ_QmutAgd42XpjaahzCaFtmGjGAtfpMcbsvXQI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vyVH0LryuN4_3r0XdHEtx6UQ7VBioCO3f_5ZCv1HffA&oe=69FDE9DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKTLK2Q5G5cQ7kNvwEjsvle&_nc_oc=AdrWCjxQ37U_HRhZbgjQ0xp1jcSGUTgRi0jTfcyiyUKqqGqz1EjBYVmO258DDAbgee0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Y_R6L2n_Dpp4vf84Z8i8HVjcs9OOZl19WFcoq0o9nVw&oe=69FDE39D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJTSsge3ZU8Q7kNvwFoDenr&_nc_oc=Ado3aGhwJxZsd6vn4GkxspKfIvgJFEULvLDCaT98GStP6rWGvms0USN8NhNS0Suvfuc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpdFnSDA9aTar6k7vdc8xIG74NcWYr87cq1Y7b5g3-JQ&oe=6AD3AB11"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WvW-1mu92QQ7kNvwFCGEiD&_nc_oc=Adqc99V533oDQrVEY6XzOOaQma14Fk_IDsZzyWJpYmyE9jz8_JZr3FhLUokkMwVwKbA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6HX0yRCP3jN1mHbZMFBcp1NfZzHki_bQ2iI5Fu4LSKg&oe=6AD3B834"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btd_ruTEup4Q7kNvwGWh9SK&_nc_oc=Adrol86PHyuybvN5ZZ1MtapiChNOvpnkTZcR9tFu0_9A5zeRQq9SZqRmDx-8cH43BF8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFQUSZKbxgpj_KW0Fu5OGFnYC_zYuqgQq3jKf44E2FBQ&oe=6AD3B436"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIqGq6qT_joQ7kNvwGd4YFi&_nc_oc=Adof6X9lnzIhHpF_mhFI59CDIN5_YMV2ZgtseUTvP59hDAtiEJ9KDmyUMuXkI0LNQbo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBerpfjjSEhAD5oU9xCPrk1oZomKG7gyjeOQQeStNu9Q&oe=6AD3B51F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf8Kb76NFcgQ7kNvwHK27L8&_nc_oc=AdpfK51_qB5VXDH-kOz6dA95LF7ZSQl3BRyUHkuZzjpyR8GUnuNdrdpQu_r-RMMy29M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBaAtjDtdAFOq7WaaMyrHFHCVSilVk94ewwojSFAOemQ&oe=6AD3AEDD"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
0a&_nc_ohc=sLcuepdpUwYQ7kNvwEEir0q&_nc_oc=Adk2VAkNMvi1qdB0YV_zPVDZ1X66IY1RfYmNm0FsqAiXgACGo8wQRnMdQ5AxuRnZ-ew&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsDmrjDf4nsb0r_zKai5jcFPnJkizkkK1rIvtWJSmDTpg&oe=69A196D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1oMQSTpxSoQ7kNvwED0GFS&_nc_oc=AdnMV0X-oQ2UxwhuzV0q9S8leDTRyBLHfSr7kKQsXo6Jp6WQHMTJMD_Wip0gD3DobTM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs5dGOtu1NdwmiQAfFtP-e42Q_ZR7V_z-PvOcIcbkIKfQ&oe=69A1A3F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwDVLzkwDlwQ7kNvwG8d8iv&_nc_oc=AdmbQENMfhKLDW4B29Nfwvz-xuE3hBlJKX7j3ExQlG8cyqxboc32G8g1qA1ttRlEq7k&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvzKfJ6upS7uyuunr1qhMJndc3azfJm7hQXk5GLLqjg6A&oe=69A19FF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUdsv3uF5eMQ7kNvwG8E_ck&_nc_oc=Adl3MxC0pGx1r4Vh2i20HPhFb1_VDS-TZw1WTszLESKt3arvVUpayobM80ZltxQBfxQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuPocbMji9cKmY-v1R-ER8a1DnmOvZUKitOq-cce829CQ&oe=69A1A0DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXqWeNWLQWgQ7kNvwF7c_X3&_nc_oc=AdlDvBWQOLmiBgPjKt1m2EdQewZeE-U3D9gq-pJvq6XZcnUof_Lis_QUBpmYVGyScqo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsQMzNcvh41haNmoB3xQ9BriqYp9Zf0t0XVUTv1whetYA&oe=69A19A9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [
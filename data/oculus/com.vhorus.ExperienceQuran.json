dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryD3BpBfYpQQ7kNvwHJL4Qm&_nc_oc=Adr7GzNd15j3nlkAiVhgr6bca9UjmY30xaEbPCEsIONnIsqug5iD8E6uAM3r9h3qRSM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEieHjbcs4mNVg450tX89OGwz5HM-UN4BWzah6qkJOTVA&oe=6A942AD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V97etQ30doIQ7kNvwH2MlVM&_nc_oc=AdoldrmKL8lDY_99iFL2KPlEyiPXOTE9GdyxhhPjESkk1Z80x_gzfQlkMZYABftfp_Q&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPIGDIFsnZzypydAYsTYSfvPiUHiDn9WyzbCXDZqVG3w&oe=6A93FFB4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpJqAPhEFs8Q7kNvwHiEb8f&_nc_oc=AdrFyq1IMn9ath3L9klFwDDtJJ_koiRL8_mkfIzcaUyILAgcOd_gxSTGesvFXBrDPSg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFbHzAxBcntqJ0X2AU5BnoeGbDaVAyyRL6co5iY6IrIw&oe=6A93FBB6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rfq714QxR_sQ7kNvwFEPHC7&_nc_oc=AdraVCLoQyXWlLAXxp2qkEukfvS1KHNKAm7ujRK-MiZL7zWW-dskV7Ff9jx5VSufIRI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBPS7icptvi_ws0R_6oO9FC08xH3_6XKEaQJq6UlO8uw&oe=6A93FC9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDuoeiJTpeQQ7kNvwEApvqX&_nc_oc=Adp-YsktnFSXgV3YHQr5uxlH3mu415xGovrpW495yHH6RRKBvVD1NQM-Am_36lJ6rWw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRDBuN-E_v-KkRkeYDzuGXJV3UUH7uYTD0DF-U0Nxvaw&oe=6A942E9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
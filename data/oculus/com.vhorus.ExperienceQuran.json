0a&_nc_ohc=sLcuepdpUwYQ7kNvwEwruji&_nc_oc=Adn0optN1_UYyPYqqfQm-ouDRcqOjri9XNswG9YFCmlD8RyBY0XJBcdtMoCg7Fv2gMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftwISmtAcoUcHYczt3CoZCWGN9F1Rv6EznwbQ3h5_I43A&oe=69A04551"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1oMQSTpxSoQ7kNvwHyJurX&_nc_oc=Adkl6neiJTTo2xWzd8WEwl9jea5E0NSoZc0KIBsZvBoMuGUVyerhKVH95N4Fkf9SYDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftDv4rf2Jwwo4nb77YVcc6yxaFabQvgf3Z5-EqCUj0fSA&oe=69A05274"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwDVLzkwDlwQ7kNvwHS6dZS&_nc_oc=Adni1OevwAPcw7_iRZz8Drhdk8yBd1TZHjMgjDsTY66tex72cYwswPKkl_ko93xnkWE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfttIaQHlJHQUbR0V3j3uQzXjabkOm5Cc4JAoBlfFHyraQ&oe=69A04E76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUdsv3uF5eMQ7kNvwELewDq&_nc_oc=AdkefIWEPtvbvJGaW4ANaU20QF6VCXDqPdJjtuyb9sHiVsc7DpZn5xQMd0gtRl0EosA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsmDyUNREALi2Cq2kkYP6h_2Ni2Wc_gL4eGi_-sBmj6MA&oe=69A04F5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5XQt925e2IQ7kNvwGZY3FP&_nc_oc=Adkcqm09OLovuOb9jDKNlqMLCvxlUvaqBv8cn_tEgD8K93cL9IYuDgSaZj1t0qqoEMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft3T5JJYQMvLi2tHRA3lXEzljde_Dwq7AaHzByZRh1Rdg&oe=69A0491D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [
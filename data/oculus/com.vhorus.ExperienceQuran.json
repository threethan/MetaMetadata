0a&_nc_ohc=q8M0I1EWIX8Q7kNvwG5nhNg&_nc_oc=AdkInET9Ij64R4SN51zP9s23FO0GTUyEuN3kgWFiBX6DcvD3nwzxi-35sdYocxOqePs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfswtbSg-mUSWp6CvsX3lJwalHcam3b1Re1xA_8KIIvqpA&oe=6999ADD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omeeE3R1UFkQ7kNvwGmRHVI&_nc_oc=Adkzt0RmsXCq49xGMSAiamvyiKd9iYswEZnhgnQZy1EYfNHDbl2i7dQVCCMFENBGS2Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft2ug_-epuqKgku5kAKkZKk-fnMdilVprc3sY4SXVlKMQ&oe=6999BAF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuJ7BamQQ_cQ7kNvwFpJrrC&_nc_oc=AdnFtG73rASWS4sjfH7X3_b5yd2eOkMDcIMNd2r3SrUduQ9k2kvdbk0PYCjlK8x2meA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCfI_eS_xwxKLOxp3gDwcW7pw_wzON6luayIVA75Wpbw&oe=6999B6F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1jzVT51DcoQ7kNvwG012fM&_nc_oc=Adks7PZcoAOUvfRgDNB9DM7jF7Gu9wYYIYcdNqOFshCii51hz84qH8FE6fLC_oxH8BU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsxDxg2pmYnFJofLBHuvDbmnA64OcbQFXcnle8Jmf67eQ&oe=6999B7DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ft4n0pfbl-UQ7kNvwFcphpl&_nc_oc=AdmEVdF0U2t87znTWw85TDBUnoPjgFItwjB0ghEvuAedugSlhCSN12P6dUmrGtonteY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu-rHWLR-l1jpozqswv8P_WVD2R2QI6PcZuNDl5V2EFpw&oe=6999B19D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [
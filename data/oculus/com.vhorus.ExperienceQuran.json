dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItiA22JQvhkQ7kNvwFQoYiI&_nc_oc=AdqWATeLLUO_dQ9nJot0xOnWxj-qXd7gJ_ZYlJ-aXqb0Vx6FXE7KLgPc6_VKXd6W77M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwi9W-1CQNDzRINRsIzEW9Xg6fKkbAW80gxUTD3buhMjA&oe=69CFBB51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnO5hy37E50Q7kNvwHxVvp6&_nc_oc=Adqp3YdY16hprzpp09aKP0CDmbtkFliteNoPXOLpDlX1d8stwlCcr0W2gWD18_1fipU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwrn4jKfMWzx14hLs8wTIbR_f_JOQx6SSMHNvVw9rRZpg&oe=69CFC874"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQ-UVNHRnbgQ7kNvwFq3BRn&_nc_oc=AdqoPiCAqVGP85x41suX6nb551Y9-2jqXV6ccBzdwrY8huHPd1BRLwu4yZZOTbXppyM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzX2FqX-viL10NV4TZFLYzSxxKL8rO445DiZrMBAQehaQ&oe=69CFC476"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyR3-00sqJsQ7kNvwFYyZC8&_nc_oc=AdpUmmczUMgSYIaHC_TMeQxGkpU2kbtkp-y7990qN8DcaacPCANqQgrTuNqPKF8VeCI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxW7A_-w6I3_fAr3j2vaJOwet5qbGi_vE4gMVlK2SWWsQ&oe=69CFC55F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EybpkHrhv8Q7kNvwH8HSYs&_nc_oc=AdqF93ndMO-hI-0hdmLCpZzxuJEk5iuHx5j7a7IHS4sIYJZYY2JOu5pbFZCohGJqfdU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvcEGRG5gUBMI49DDbvM2yKqRsqjFYJbe2CWX5boJZHA&oe=69CFBF1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
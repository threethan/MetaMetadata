dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUnE3iNIMRoQ7kNvwGaunTs&_nc_oc=Adouua0mQHpk74qJrh6w_XoKUAspXxMxHlWBkaDj2Ltd98i3kw9KsdMihrkRRJoLbuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbF-jzuboOs-ijMlv13WjvNYFkcn5kqgbgu468yQIFyw&oe=6A523FD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uhxzA_cE-0Q7kNvwEGpslW&_nc_oc=AdrXG_ymCGLmgRuTBgEUNUIwARFbz64Fb-IQqwQlp3mWoKVeXLewxW3q6b36mU10LY8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuPMyQYb9qwPT-vtU2wXQg7gT9-dt84MdRPt0kL9WJfA&oe=6A524CF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28742qDnwQ4Q7kNvwH69Wy6&_nc_oc=AdpV1H_qrKvspTKN3c_ozN7dQIX2sEHTwjFNGLUaOz1_sEYgL9SdCXVrQge-YlpUVZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqVn-kkrtFq7xWh5SHpBs6loOWxub1s4thlfuF7JutjA&oe=6A5248F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORQMXEctLPoQ7kNvwFphpyZ&_nc_oc=AdqwliIG6ArxieukAWXvXNtLK_QY0zbTXegeidxTcQts7qz3klUi0VWe0kIzo-039yc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBssqNkot7XUB5myO7PL96ECYbt7Nd6GS6YM_hzz2_AOg&oe=6A5249DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UGUSguplocQ7kNvwHZsjlQ&_nc_oc=Adq8qxSDuJZoTVta7RxMhVeiOo-ym4GBcPA93Elg1hsfmXnMUTq7a--oPrew_kRJM6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCGhAYyw_gO4eR7O02gW_dQO1Mao7FUXBMOlhcZ4I1wA&oe=6A52439D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
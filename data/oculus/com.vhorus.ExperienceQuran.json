dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lf1mzgK2VBIQ7kNvwG-ceyC&_nc_oc=AdouuE4mlZjHo5TudhCJSAJyjaAHISa4vHR9E7Kkbj9P3hrzNrGdTmlJ0QlhAsNjZdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EIkqtJT8yp7h2-0Ye6d4VHRG0F5fxIIJ60MTF9tQ5zQ&oe=69DE3BD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r01A4pQQiZwQ7kNvwEOmN5d&_nc_oc=AdqwPGcfK_Ri0UhV12F8BqXtEl8dYlMwIvgjwc1L6IQ4k1ajr-HbHeCyIOm4p_GPb8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hXqXQ0Yy09cnNYsY2m4R1k9XDvRlY3Ylr1S2VT-rzjw&oe=69DE48F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZ7DWNKhdZsQ7kNvwFhAoVu&_nc_oc=AdqH4ggBCpedWfjI5ub2o3rG2M1kJtU5bH0nJ13TgxqVW4Z8rVkxUeW_MGK_BFTIPUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Yp2K-dETgg1vvJ5ubU5GXABEqJbpxXreKXdzZ27wwXw&oe=69DE44F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL_1OUD4aJoQ7kNvwHq1Bxs&_nc_oc=AdoeXQJjsMnhN06u8O03cVVHWFjkNy4IOEmaypbiZWgR3xgVS9Ms9lQRnFwzX6jVuhA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12FMFyBkk-O6ULSyFm_9i54YhuaismcK8cm2tXch7yCg&oe=69DE45DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94CLeE_Xbj4Q7kNvwFS-LnZ&_nc_oc=AdpN2Ogycal-8KtR7P8_zDnfTFQwwM9c7ViycJCNfba2q-7L2dLR7KgxSFjyyz4IbcU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QKBwUPNmk3Vv46FdpcVWOOmJ7keMg1E845bMMkinpng&oe=69DE3F9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
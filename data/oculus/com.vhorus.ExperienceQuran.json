dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVDIFQ6DFa8Q7kNvwEPL92t&_nc_oc=AdqEWTAFRP0nrpwcLB7m7T1L51iq1q0_Rb7ak9A3HYFZr4ZKYg_c_ef2TeoGIRXeEr8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa0GmVmbBz-afSaS0bosd-TIPZS9R8DL3PjSKDrT8crQ&oe=6AF9E691"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bcsJBqoR70Q7kNvwGtxphV&_nc_oc=AdovtCLH72_-3v9J56gonBGqDuLSIeDFgqQyGk4-FN2aDqrOgkWuZmVsbJDXhLEQWFM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeuwHJqEDZn4xsrT1lgNkbcR9O6izZLXzGmjlLlxBIDA&oe=6AF9BB74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n68etKTqr-AQ7kNvwEkqlSz&_nc_oc=AdofgVdJSYLco4mabBsbJsmTcgg3rMzKUvshIOIOOYibNRgfqdo6PD2VJbHQIuoNF-I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8L-xBj0rBz0lRSlbd1NQ_1QF1dj3MDYVKYrSFtflqIQ&oe=6AF9B776"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpFFMQAnTvYQ7kNvwHPAhp9&_nc_oc=AdqEvY8M_vLQLL565fPlT025MWxlW_CnK_gT_L73P5dQXD7n3kFJZ35gXL-Dygz41mI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVuia_zshhv_edHxj5U3be5Gu7xQ4bsmzm4_mimtZJhA&oe=6AF9B85F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lsbK3qdbz4Q7kNvwHxIf1l&_nc_oc=Adqzp1yzKUd5Wfz_Jcd4hM-6-w6Q91VEnOs89399VEaoeSxGtAb8OyNjE9k4MoI7Yng&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlopnCnC8NddHEECwvzZPmUOz58vYy0d_OmxorzNIRDg&oe=6AF9EA5D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AwQ1nYdL1QQ7kNvwHwehjq&_nc_oc=AdpDk-4UzY0LTyJ9MNJ30zg4usG_bt6IBhVB1IeOcaHWVvUFRT3FCI4dP581G-Ul9ZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhMlrBRlnB4rtlwx22YxvA8uwnEAJXIdn2cTMOpSbNSw&oe=6AABE5D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXVCZkeK550Q7kNvwFGpl-E&_nc_oc=AdqxZKsgfkEWYrKvkJOf9HKpXhqwv8n1QqTc2wIXhv7VnuQTia8UtpAtNFtbLJQlwrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9EcpB-GzOsTHTqLywFrXF3EKa5DG6wj_HQkGKUAX86g&oe=6AABF2F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQcw-YON2kYQ7kNvwGvA_fl&_nc_oc=AdoZbuN26CoDyGVzSocjprsFp-l5EgOJ4Qt3y5a1C8XlHCMcOSba2S7bhhM9b2WKRR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-n5c1DI1i_TYyMvOBFh27xQqr_BOHVsIPrk_-2E-Vig&oe=6AABEEF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBX4iI1h_cUQ7kNvwFeqDno&_nc_oc=AdoHeZOgCpkWtH0yG1oa-lB6oMSP-FQe8GbBAn9M74qe0m9tHR57vWnHRiF9DuE32ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMYiuXosioMBZGIdoP-jg1DZSZFv2Urqw51Op7bjcsFg&oe=6AABEFDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CeV7DEVrwEQ7kNvwHANX-5&_nc_oc=AdpOKttt_zbZfXMxlsus62wV_u5Cv6bVCsQC0Cb4zIAVjakTCju3ryla8sn1f9DaCSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZaNnQoVRI2whPIvtjE-U4SdKWOJUT1tRH4YmVs93vqw&oe=6AABE99D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
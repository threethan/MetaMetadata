2346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvPCBjvD2tAQ7kNvwEE655L&_nc_oc=AdlcXnXg1uu18LLk31ajeCfl4Z9_PlOsxckOHBFEC-vd5jSE0eQ6Uv_S3peVPj8DFwk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMN3m7QFlH4Nh4SrEkoCFiqwpIMWp1GL5xLDZc6nz86g&oe=69AD7451"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRlge3Km7hYQ7kNvwGOvw1q&_nc_oc=AdlvJA-pozGG4f0ZFS79CWhnvq2zpJx4fZG9G7Zzexew3U5Soy5kkaH69nhEIaUEBU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9-3O4uww-Ag9FQDgH3lq7dXQyR8pkCNqzXcAVN8bf6Q&oe=69AD8174"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ghu7XsH5SYQ7kNvwEy1UmG&_nc_oc=Adl-lAdhptX3AywIuaqLTfolPXQ3yiCdQm64varTwE5l_MHec3z65JeI8K-1XFCDJ84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDCN_MogmIRClw0JpjeR7Dx65aXXnwExjHoAsAjsluIw&oe=69AD7D76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2uGYgv1z-YQ7kNvwEpy1Z1&_nc_oc=Admbc3O6LInFS7d9D2uM3fVUsljOYs6vVjdg_XzZmrN6Gz7t3GTpv0Xw_ma-3DCzmRI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyspYFvBZREyBb04gARmn1p-_MuSvy0_nZHikxZxXPugg&oe=69AD7E5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPJWGSXj9DgQ7kNvwEtAdM4&_nc_oc=Adk1KtLcBxDcNezZNYoVhAzOkU-mRuwawvqdBu1kVhxrNW9TWh4cNKCp5SklS9h-1fg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfAXzhjnBvTj6TdXx86FkN9d_fZ5KuHWNWxV9rP2uZ7A&oe=69AD781D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
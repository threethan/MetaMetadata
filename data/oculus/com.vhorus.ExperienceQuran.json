dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66ZhzSUA6W8Q7kNvwHmdMKg&_nc_oc=Adqn65-Z7j_ekx5ab370EntTjKW-n5t-pDosPbiwdqKvSRDEqsMia-eGVWOlhjMjndc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YYXTI7kVAvQGAcdT1QnV_i67BZ2Pg2aZExxlgQekQlQ&oe=6A37E1D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtAriYdKxQMQ7kNvwHz0hai&_nc_oc=Adoydl6V4smdLl3e3OhpSXRDVjx3F0ie_efQ5HDny0xA5bYoZFFG9gI3bOtdaEk9fqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JG6OBpV-yDniK_ONEs5XmCVlHHdwBloTpbQT4uJfSDw&oe=6A37EEF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5xv7QJs-cgQ7kNvwGSIfcy&_nc_oc=AdqrEOIi9d8pvnGTOxEZc7hlqvedUl-PU2OD99SnYFy-h_MY6y-cWCGAj8KQgGciR-s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IaKuFD6JU_4o2atPUMHt5zUFW_aSRsp78AFfP3HfT1Q&oe=6A37EAF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1q1Q1zQInUQ7kNvwFCciB0&_nc_oc=Ado9dfYvNRUk2G4aJbA2UQe0b3z5fk-aJsmUKqKWEfINdF7O8bKKe5dSxUgQNiw4gSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--nxkv_4aqs11s6f0mBr4CNRHnGcs8jbOUswPt1P3S9A&oe=6A37EBDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JKA1vEzGKYQ7kNvwF7rvVj&_nc_oc=AdobC0llxAq9otqM0XItoXEcCDJ6uYjKHDR8ZjVHg2KTYe3pENBUtVkd2gkjgwwPmbM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tOdne_foWwC1aj_U3u9ympiu3EQxp1Al9-m1NzgfjzA&oe=6A37E59D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
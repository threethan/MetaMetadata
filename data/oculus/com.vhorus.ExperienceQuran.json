dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9zUOQG3d9sQ7kNvwEPzGKU&_nc_oc=Adr3Bjy4hODAARqeGd04zt56fpd4nNLfcKwl8lSz__bfQAQommxkLEFaD10wLwlSWL8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KrHwO_dFt4ahGgkH1hG6v6mHTDJycX3cbxLC7lASFBQ&oe=6A4510D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVdcxQhpSPAQ7kNvwFG2x8j&_nc_oc=Adp-p9MNjSsV-sJyNG5LmRcQrS-mM0UHrdEbOJVdaaUFyZC9EhNH7EnnQt5-xkFpkyM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_vsY1i0xvmaovzWyHFNAjAoO025ptKshikjuC62RFIQ&oe=6A451DF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLqE9EG9sYcQ7kNvwEtENiX&_nc_oc=AdqypgguD27YMw4ZLlkTZ9gdTLpXmfEVu_xdQfpf4ZVmrsLLU5LbKJeRXaDTJkEgYis&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TQN8UrEj8PJZgQsbuuv3Y1-RDoZpwhQL2g82Nm77_Qw&oe=6A4519F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuslJfYc18kQ7kNvwEi79am&_nc_oc=AdqFuPBqopX2RT9-mTzhUQGRJcw5zuHCLaHnuH-b7Y6ImEm2-u65J6EBKFkEJCGag5k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CmtiGx0dIrbroIlT4sMbTNtZAxIm5trxfMZrdxgXVCg&oe=6A451ADF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7f6DWqitTgQ7kNvwHQRDpm&_nc_oc=Adoz3NWuHbVSuYvtT-dLYNit2XXuYUPBjdmcoBWfZv_zMdlcKJtSyqDS2MK3iMbjRoc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TGo3SsIbcGLVadqSLUvU0P0nYIxuGfYbWwgS6E7v-3w&oe=6A45149D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
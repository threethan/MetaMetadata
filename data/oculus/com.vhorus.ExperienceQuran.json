1.oculuscdn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66ZhzSUA6W8Q7kNvwFcDCt6&_nc_oc=Adpou2i1jF161U7SOBZMUfqDmcDvexDw4q7leU9ohnyupQlgAE5uNAT9DAYfHP7MvV8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_drbywUj1Jp8SV9-3IWE2o_uxtyEjOZRI64tM3YHcqew&oe=6A369051"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtAriYdKxQMQ7kNvwFakfPG&_nc_oc=AdpFKdP35bZuxVb5X1t9Pp8HDbnXNQLX_xhRJ3n8nB7JjXcbqStl9e1c9xFEzwjm_M8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wtWqJY2jrBT5vty-Kq5F0oh1LxgJ99vSFPnL26GV78A&oe=6A369D74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5xv7QJs-cgQ7kNvwF7-PSn&_nc_oc=AdpkgTiUWiaV1klvsYT0qsYVHzhgMcJkOjpmbZp5Y3Bz--KhomzdU2EYcYNw9RQ_EMU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WKOFs7UDouDhFzglop5jbwoCXd7wwMRlB8-x55OJOog&oe=6A369976"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1q1Q1zQInUQ7kNvwEfUmjw&_nc_oc=Adqyr6h6rDkKGuL7WJRUOoThfuKLhNJlwl3pNjIpOB06NzoZv8EYBwDgsGV0-1UEYoY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mZKmrmHkgwStyjuCZHBkZcKTW-nXpx-0Ik0GTed6PLg&oe=6A369A5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxaDBSQ2hDEQ7kNvwFb40wO&_nc_oc=AdptUD2JBZzPbxWXBk5uPyQZIIXG083o3J2oOLyNapVqnLmCq7FO7CNY7h7CJjtXJzk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UeW7WYP1JAdx91n-X56--3_dK2K8ZonWENY7jtuLeCA&oe=6A36941D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics":
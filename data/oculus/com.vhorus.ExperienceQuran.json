dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUnE3iNIMRoQ7kNvwFtRjqD&_nc_oc=AdoFRaZs0CwMcCFtFWh8PGivYEXiX7J0h5ZpZcHAbnG7m5e-r2Hp2j0TltVgRAK9CP4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdV7LN6cAfyC2-AtTr2jdbs2wIG9VuMkhyE03-IlILfg&oe=6A539151"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uhxzA_cE-0Q7kNvwE1oHP5&_nc_oc=AdpY68_fHWFmizxOJiR4P5FXAYuxpk3BPeBctHBIyot_Ly3Y5uNSm91ijbA7KlrvsXk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAKx1j0fWyjqqIsCS9zjhG6LyGDdjTxXLsvmg_e7naaQ&oe=6A539E74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28742qDnwQ4Q7kNvwGvNPCI&_nc_oc=Ado6BkNVXQoMK6iGfxa9zlbLGp96Cr6kw75Tcu_xAIVvJWjqHp9klileCARGQkJJS9o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMQ_rog2dZpLnt0JzKBJNFBY7EiDv0mQxrs5K6qcyGIQ&oe=6A539A76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORQMXEctLPoQ7kNvwFDeV_a&_nc_oc=AdoVSnFSQoyLQoO9o2q0xPgnZ6DqI_LLOuCVptKIdHBsRu449tiC2IVkCSwlNedzEks&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChbFkk5mXoNor3lF-zBCbgToVHzBS6CV5kIyP62w87-w&oe=6A539B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZDeeCFhIUsQ7kNvwGbIYat&_nc_oc=AdrhTSWLpWtxPWz83HmAf29Co7g80nnfFyZXncJCpjlUdC4l4xyLkOq6pYeSR93ZMPs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxVGzaqRXOgITCJMKK4Psjj4VYZLuHFItQpJfJtSK9EQ&oe=6A53951D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
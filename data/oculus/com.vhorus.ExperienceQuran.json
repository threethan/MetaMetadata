dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhJxH0mOy3oQ7kNvwG8UDOU&_nc_oc=Adr1I1PvvkmR3i4kX2lAD0LtkBdBN1vRsPJVzi-grf9PJ2-Ggw29SSk3rMm44QJemsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL-_Tf7sJzAPaNWC0fVT1dNsMQa2OK65ZqqCqxX79WCg&oe=6A69FAD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDFCyqtR9RUQ7kNvwF8Fd53&_nc_oc=AdpmkNx38x1eOO-2lVv8hT24ubn1uK0chm-Ivjctl21MBXqyhUcy5uPve8eUHWFItGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS6vKpgvYLfUj433M1ChhU5Z-nuzdd_KqBl9byh_vA9w&oe=6A6A07F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFRXIPgtxjcQ7kNvwFhujof&_nc_oc=AdpqZxRCRLNgizw6LIthgxA6r6iA3UC4RQg0gBX_TzaG32qoY7H1MN8Cf_IKO4kBQbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBllYP_NI-HyOBS3RHuefLIRrSVcnWkRqUfHM0ECk1HZg&oe=6A6A03F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocqnnUanIX4Q7kNvwGd2Lls&_nc_oc=Adolqi8Mg1LQqzjoOqi7Um2RKiFCYha2_bp5cmCLmhlLSB68TYUQaD_c2LmxXXfxnyI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1mD4GlYXv2NBm1Ng5ZQ37ncOhKiWPEU0gWlzeJJY37Q&oe=6A6A04DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1-ZHAVffy8Q7kNvwHJtMlb&_nc_oc=Adp-rtrSGJTzwBqmdom0HRZuctoFxS-OERwpgaRGcyBX3DoOeRJfXnect_Tik2XMR48&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK_z09cQJsPekXCMdbWnSGbdEj2cUgNbl2bIcMuLF_kg&oe=6A69FE9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
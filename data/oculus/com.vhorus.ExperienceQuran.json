dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9f2xVD1UxkQ7kNvwE2fGum&_nc_oc=Adra7d_ye4IlIKhy7UbQJjcT_9fXB4ERuyLYPqGZ-RujisvDtH1eEy5GS5qousV2GAM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c0UuACIkR7gRNtMmhDxb77IygEJ2zdjBAAbDt3wTVvg&oe=6A2AB2D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOi8mCU0UWQQ7kNvwEL4ibV&_nc_oc=AdrBppx8DnCL0He3Lq-Q-UneUnxxK0muY8xUvr5dTrHkVO719_ykdMOF8goY2J2Vm9g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hhxcjMhSKgxSnfHTijo2ihx10gA_5yG-rDCAGRvTzjA&oe=6A2ABFF4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5yjOWHEdd0Q7kNvwEkOQXq&_nc_oc=Adqu7f5ILfTLWiGGMUeKsPQCPKc9NbDAwNDvGbwQKv7ZhCbJ1Jx0tnM00_LQ9bu6erY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PUkDjdqDUE1KosQpFTkajr0vztYrMnforEeQRHM7gOQ&oe=6A2ABBF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-TEXneJl4AQ7kNvwEoIm8X&_nc_oc=Adrey--7At7Q3urUkOX_kVMZ1Mq-TLUF_EiOCOyMuL3sjsXCzKZ53SOjwyeaUFWw5NY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NakW4J1mhR4mO59OXYlqLe0RRoKUhF6OPfFDUqPapXA&oe=6A2ABCDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hm-ztrEDPLcQ7kNvwExs9vx&_nc_oc=Adr-sPaq3Zjg6PDoq4zxuPOXlfYGwOJRJgvaNMqyv5ArCc6W1HAjCcURj72rfYRlrrg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gUErxUV-31Cki1iO4TH9K_YikJMXzip4PUSllJi9nvg&oe=6A2AB69D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmZ86WseWs8Q7kNvwHUe8Ne&_nc_oc=AdqWfTKxqeyZ4zTUns8i026fsr4e4yDO8NUjiT50pvPbAnDAhROuhmDh4IrJj-HTmNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eoZPuBbaMrdtp2mnF2JTu1HJG7-TyJQrZ6S_Gb_rbRw&oe=69FF3151"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Bao5cV2WmgQ7kNvwGW2mtp&_nc_oc=Adoyedl7YiEPl2NMkRlVVTx-lxB6saYFN21hzIDJ7kRadVeo6N8hk0S6av5vg4puTL8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PAlzImT9ckaLSS7nIFmzfwZ5Vt4tYvTDHEyTzr6C6jg&oe=69FF3E74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCT_OLYjibYQ7kNvwFHQYV6&_nc_oc=AdpdRZQBNTJUsWivxI3PhMvPgEM9vnWz_58vTcxQwAO0Xw23IQhjVaoeYcf8qV7jFoA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6al2SkM-B3BT1AQuS2vgEQ8wTUIyVanCTxK4K2oXRREg&oe=69FF3A76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i12S99nhsfIQ7kNvwEAvubN&_nc_oc=Adro7kHh7kkUhlivusXwL180WqbUQL3W0HOhnY8jky3qqEpu8pv6t45iMXTHAiqcU18&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Wo9673PO1nE6Mc0B-1qtp5ZdvXlOpWpdK7VCUn23PMg&oe=69FF3B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKTLK2Q5G5cQ7kNvwFdf86M&_nc_oc=AdpnfuBPnckB1o1ocfraBrj696mTuS4BKgoYa_G_cWN8NqsNMsY3FVcxzzwFgBgzaEY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zJDyManbhlaCKJ_VrEA4GrNXuc83q6Y2HWA3izZcPQQ&oe=69FF351D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
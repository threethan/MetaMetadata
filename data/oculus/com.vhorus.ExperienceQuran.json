dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwVcECTGZOgQ7kNvwGv7VtS&_nc_oc=AdrMAyRHVB0TFBWGRm4tIkjeRg-pNFhIO9sqbmKQgI8907hB7sOUiZ0ET0zyabXBBxY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4Ugf_QJ8eKE5lhgAketQwriUN6wII-HxhfYxOU66rew&oe=6AF5F211"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A8SO5TxA3UQ7kNvwGr-Vup&_nc_oc=AdqzMrll47exibyNL--wq9K4oBKFRgEratG3Cwm1U5R3WowD4XU6HevSRrqCLAujFCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTczNbXbHfqdBKnLe-UGYX7Bz5J5qTJsVew4kMU1yWHcA&oe=6AF5C6F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-O8EcDKj6E8Q7kNvwGWO2tY&_nc_oc=AdpAIhjaYPXOBr7iucf21fF4kuyrMLykQ7tbuieMraZgqshXxvlq1L8XjQnmLdAvHTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBK5dkREVoaRs3yY81z7XrLo8z1w5VDs_fnsxDOLBbDg&oe=6AF5C2F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtMFe9atPtAQ7kNvwH3CJyR&_nc_oc=AdpQO0kdaoiKvcObN1v5DoDgJcjWdSULryyXsVnh6vmd_4IM6NxsNdjV1GmQIV7X-wQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSccH7iHa1EbXamcJJUR5W7pQJ8QsxWTGxJx4ixaCrNA&oe=6AF5C3DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fL1m55DMkScQ7kNvwFqHIhR&_nc_oc=AdpZr2rrZ1iB9XxkqbNoAuGOSh81gqgFSX3qGn-nngZYK6By_gSkiNPae6_rsW7ODsY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4Lb_aAIDrZXvJCUhfmYQnbIMLV0ybI2vQA6pJF2BX9Q&oe=6AF5F5DD"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
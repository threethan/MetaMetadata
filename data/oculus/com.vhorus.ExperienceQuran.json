dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VILBlzyAv3wQ7kNvwGE1G93&_nc_oc=AdouDPxkXodqaoL1y8rfI0yCesLLI71GwQRbeFHIdGgreq95HmPb-HOjQawEfIGqsUg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3IEhAye227dNuTUhc_3U-xNCWDn6KoWoUspIKvK37Kxw&oe=69F5F6D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LjJIJ5d-rsQ7kNvwHG2KC3&_nc_oc=AdrXWwUg8xYAlF15Z9p9WU3L4DejwCODbkUUd_qiq9LyeVDBlQOuNZLJnqE9Auguyc8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2q2yb3A8Tfh91hK8-pHHEkY15mNQwvGyqk_5rokLK9pg&oe=69F603F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNQxAjx0GMEQ7kNvwHn22Fb&_nc_oc=AdqfP0rf_w3ObUiclVUVJ6TZZesP0fRUwawv0MIki7Xe_tQWE9_wjiJwmzudalVBzHk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1BFS7r1v2uPqKP9btggKsiOU5Wva_lFAhUy013ME0xlA&oe=69F5FFF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9FosSlZaOkQ7kNvwHj1I1F&_nc_oc=AdqJeClW13Q-q1YJGyc0YOMO6HBO651XpOQ7T3a1ZYb2-UCGqrdutg7468DWpg7Mw2M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QbBa6F1fBvp9njGecijWcPmTYlC6FosCYGp1HjZ6tng&oe=69F600DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpFVxQSzTU8Q7kNvwF0cMx_&_nc_oc=Ado4FYkQXDnJMrUneKr_yEJE2IG8nJfU_UvzjiYgZkX6lkeZV4uVJ_Xw4EeOtWf_fQA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0MFltyGD22ZSAnKNBMvT0JxGy_H2RaJ7H36-WF4DDmCQ&oe=69F5FA9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxverbQcOBYQ7kNvwG5y4g7&_nc_oc=AdrwhXfNbOtNKUU3NkCi4DkSHIR-w6Wg-bXTvE9ly4rB-NgI46uiIjOL_aFQ1sWh75w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rnngC5rwDfrBjrORKZUQU4fG1kdpIfGGp3h_L34ciEQ&oe=6A411C51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pI7GNUvHqekQ7kNvwGM_q7F&_nc_oc=AdrfsI-ENCDePZ_Ecn4-y13Opo7GKcBh-kOn9uCdtm1Mx3GJfNUt0T66D90LPejH-GA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dKhE6W3CTH0_nGUrDsjFz7m6N3M_WHyyR7kKCGD4EWA&oe=6A412974"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUPWt4Tvl_0Q7kNvwF6KSVo&_nc_oc=Adp8mrneHtAnd06Nd05FXbMK4iaOFPi8XWO6Mhx869LZkQwsrqCBRkTDoC65HDU-gr8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BshVahTEfFToNK3iaU5QqrZDzlV1VMWagjIOQtceABQ&oe=6A412576"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5vFjrOjEqMQ7kNvwHU4yqd&_nc_oc=Adr4nTFYMZB6GeVN-kgplToRbWaoNbeJ7nJRNeDyIgEMy0JnfNI76jybDFUBp4NRoiY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_u1Vx1N3tGIgayIDmr6jrz1kzJGI4FTNu7xis1IbC6Bg&oe=6A41265F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYDeBU4vKsoQ7kNvwFyuIQM&_nc_oc=AdqrOMdS23QyhsksEUspdAhfDAt7kl9a06MnbmQO9NkftO7Bb7sFZX4UCGqYeCL88xo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O7DnNJ7ZhgvfKOSyeWUunQZgskQ941Akn38pn6OwTzQ&oe=6A41201D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
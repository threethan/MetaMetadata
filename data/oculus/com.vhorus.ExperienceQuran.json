dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jb3Gl_2VJe0Q7kNvwFYBNsC&_nc_oc=AdotDuQy5Cd0b7vFP4BxRrIMMOC8jpKEaGmEVyrk8Z9EmDa9EMER0NjLxVw7eKqbSwI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEtDjHodKf70-PxLJwAffPT2O7PWqnmMMnMnLOk2m1GQ&oe=6A50EE51"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uhxzA_cE-0Q7kNvwGcLtTE&_nc_oc=AdqdObLxs-lc2JlgN1976bvUVlCTIeh61ZaXWx2vYbMFLxfeXiDRI93_XXrVZ5cy6Po&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKW_GUhPhF9QpovofZCkSQV2owrCGdty8lz2KSuhaXEA&oe=6A50FB74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyH5kxhWmL8Q7kNvwGXuczW&_nc_oc=AdrS6w8onvgW0w197m3fjXpkD1a5Nr1iEyk3CZ5x5dHm--4zEq7DJsv5MnhPveB8-Rc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGPt4k5dMhAKoLwvdF3a2MebYR3T6tJiFxViG5bJNOVQ&oe=6A50F776"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORQMXEctLPoQ7kNvwF0VqHo&_nc_oc=AdoUJc5OfV4_uBukv4vnaUgipCTndgNbN5Zg_vfTcTgaIM7RpdtoUvcvPwspH9HFAFE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUR58nwjg3woCsv-30xdieDCQJrSo2dCm1xdrL_pJ8TA&oe=6A50F85F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UGUSguplocQ7kNvwEkEjdG&_nc_oc=Adrh7PSOcaIR7Ry833FStqEm5lmn9TCsY3CxjVBFjX5wihksxBx0FssxjvdvT0B_NeM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyKBAERCJPh0tr93J8v2MhMCTYveg_8M0MBOhsRlG2oA&oe=6A50F21D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
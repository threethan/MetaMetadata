dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OomDpdpjcWwQ7kNvwF-lr0k&_nc_oc=AdrRMk7JD5VyiNBxqw_rKJoYc_aNJ4-sV2MCX8eWK2JFgbvftfT0OIafoeDHcSLvsD4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzyoh33RtLrgK3E4JNXPWbnApv_kIinhXMSv9oh_2pzcw&oe=69C7D251"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeXULPFvmQcQ7kNvwFFzMUZ&_nc_oc=AdqoQZmvg62cLtjP6riqb-1NooI6jrackTDosJI6H208zw8Orr5t3FkxeXiLHq3yiN0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWEMSHMNjeJakxBhjojAlTux1vFBkM3CtHlztjVJRMFg&oe=69C7DF74"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5cEDm5JGWQQ7kNvwGOuUMm&_nc_oc=AdrGihVe4t_k1mYfkkS_xsBR5cFZ4Fy8xavNNJcovX1TBfaeU1mEaO8eOILeJOUFANo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwarhPlxr2J6R_P2pjaKUg0uRzNOF5dTDzADgxfP_IvJg&oe=69C7DB76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJHFKtp5j24Q7kNvwF60Ten&_nc_oc=Ado_EM3l-YkZ0p6OO4zuQptovWLw-J6mm-wHvsGrRjiK_YW0X2hoFTakoTCCXQhP8SM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-Wp0zkQjapE3giOzoTVOFnrmouNyJemP5RAH5D5gBRg&oe=69C7DC5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMvTsNAC6d4Q7kNvwEUd3Ts&_nc_oc=AdrjnTxW-DOmmeYowIQxtPB9qmm-9QJtCY7jTpyPyn_2xMyHecHAg3YudXS0_sxiPu4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLD-dFEtw-s0Mcazs6SdPhv-GZCu2KjjpQboXICVHwJg&oe=69C7D61D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpggM0071dkQ7kNvwEFSoia&_nc_oc=AdqexucW-YcVU_VWmuieK0p6_d-F9CeocLXR2TGk9SXdznvFTnyhrwtDzsWRwKYacj4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOPcl2JDygj-qihstanpzIT2Zw1TWnAzvMxHXMsrn4pw&oe=6ACA7091"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vwL8g2Xh9IQ7kNvwFPR6fS&_nc_oc=AdojIFd3VoqBeIY94t8Ue9t1lHBjQJ7Jy-U4E29sFybnZtC4M39TJAfGLs-zR6Nkfjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-_k061P6Bj3ntjQvN0khAWSP5FYWFwvOs-mVcLDNWmg&oe=6ACA4574"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlcG8vQJvcYQ7kNvwGGn3FQ&_nc_oc=Adrmh9kBlXFAuK2wzChLcfX1uiUvcBOvyz45rWlkxiIWLexlfX3nmVVeIr6aq9KnvL8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV8b294evFB8fPpTVV7IA7cbg-uUF4irsq2Jtm6r5v3g&oe=6ACA4176"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddmD0ZTt8OgQ7kNvwGneGzH&_nc_oc=Adpk59bpeCSO3WTqLV2FbM5ocyvLFeWeruHezXPQSJcMDYX2Y1diKTXERPIg5DntBkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQ31xaqM5TH5F96kYWcEQ4sb_m1HJg6Fgjfh56VQFrPQ&oe=6ACA425F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmrGCI50N4kQ7kNvwEjp1Lr&_nc_oc=Adolgn_XpOQ4756VfGWrQnxc1TDtDd_arlQBmuIr4RSqJHDMuCSQzsLD1MQqHmdHmlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBepUZ9MozpiLjSqGgpKWVhtp9hO1F6Fj0O6XyZiJNEA&oe=6ACA745D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj4r8dLDkwwQ7kNvwFxyWHy&_nc_oc=AdpUgHECQkU1afj6YCLK4pazQHOUTWylxY0-uTmpb5iPUeZWDUWWhSx3miLzIlsU3R8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc1kJgUu2__q6SmBCi3nf_JlVmbapc9ALVFTwHJ5BZbQ&oe=6A71E3D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FGHp2iknHIQ7kNvwFS8odz&_nc_oc=AdqFWXynRukwd1nh1tXf5jIQO34QaY61KFnRyuOqbwvDpJvpyO6R8SxvONpI6DCDqBM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtzHZOfsLHn3KeU0RkBzS3CTqyjjkCjd2pUvFlW92jKw&oe=6A71F0F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZHqWBk_LkMQ7kNvwHioUMh&_nc_oc=Adq4ChMFzogiq9BuA8DyKrnkeKtM7Ydv0ImVwZgb3RRlPiKnzWYddlDz1ntrVcf2kIc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6aIILhId2yFysyctOAvZtuZ_FZ7QiOkUAa9Mgs6zXeg&oe=6A71ECF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY_kyf1ZI9QQ7kNvwFCOHa6&_nc_oc=AdpvPlTkuTHBfLrnEcMbjsly2UB-kY3j_T8mramiRe_fCrHJo35k1X-kb644Ov2Yyzk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIQrLOo35abJV9fhNwb1uv8wM3FKlrfBzNgHRg6x07JA&oe=6A71EDDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koIKBXVrVu0Q7kNvwHDMEjV&_nc_oc=Adoc1Xeh9wzaQNmlAnc0QuJao3MEE6Ogmfzm1V7viMdKeTbETw93mI2cmrZe3sCL5a8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0HLuwTRTEyRT_cBol37zetj6X5P39NBATB2hzAyKROQ&oe=6A71E79D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
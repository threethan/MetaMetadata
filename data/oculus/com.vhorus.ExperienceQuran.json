dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMeKnbW2x54Q7kNvwF8H9Pf&_nc_oc=AdpUEPp-ASKILtH_Sz49Q2d3S42aoF5XgTHhZJLuMYHrXTHzcqkOMhvJBHMyQgZwNh0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTv1lM0dVOZuLlojTTLZgR2hc0ApM356F4y6tF_OgLhg&oe=6AEF5A91"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9viU5fkJkNYQ7kNvwHMRT_z&_nc_oc=AdoTRvIAR5I2itc24bdmSA83Vu2buRPmII8Qh4xuDxYoAp-njSiQvFmngh_FXqZ0Rmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCW4zcAAkz8JxplZZn_7LFXQFu5gfkcgvfj38ln6iX8A&oe=6AEF67B4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDBrJ_YtFOAQ7kNvwFy4jMt&_nc_oc=Adol0sh-OEkxCc1Uyb9WtJ2qdWMSAhkHkowozi07Bb-KbkOykrppMltUiaZD6SMiSZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTTI7WkJtRCqOJxwt6cKQDeWwNSJRHfdPnova4IrI37w&oe=6AEF63B6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeYeVw98wfgQ7kNvwGyE3R-&_nc_oc=AdoZd9fYEByQvp2FHDXKHj3T4fqYnOc-Fj9AciA1YFwyBMby1y-PwkDfgWzoN4xWW94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZT3sbzLPJeB9ERB9is7Z9QbM-BPc3bmBxIzHcAbmT-g&oe=6AEF649F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fY8GWz6GCBUQ7kNvwGLdlJr&_nc_oc=AdomIYKzYZT_V-q2JYDRNawChDpzmveABZAaqHq_bsbHDmEB8vJQmJe0H91hTLYJWho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFDcnCmy8mx6XOhfjCY4Jtjg2HGdBUtUz3HeCNhrHAzQ&oe=6AEF5E5D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
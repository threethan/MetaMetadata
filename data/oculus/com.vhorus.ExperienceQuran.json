dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vd2YoUSB5DUQ7kNvwEZ81EK&_nc_oc=AdptaWD9uAGwTc-06Vnda3BorifJ-6DMy4pouaMYIhhu4uS3vEOEbNLcDs-3sC-lzrs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vanG5tDmFEGPBZcuSeGeoTlIkMGCDTwGj13gSshTXVw&oe=69FB3CD1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usqDgTkZAZQQ7kNvwE3JWYL&_nc_oc=Adp0wT_KEr4dAn1z3F8OT55WU0R70NUZqEtrCOTgfEd2ComBMlTEqq2oSWd-h44awV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lQ8KJN6vIG9Q_cykoL5bsIPTlq4kKiI3yep4IIkbaYg&oe=69FB49F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pW7MsCzwEoQ7kNvwEPh8gp&_nc_oc=AdoaH6k0-iY__G3wF_giuCAj0VT0ZdRGQWWi9kf27cqnnXKbeKFfQ-he-6K3mGu63GE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kj7HIV3wLKFPKBncZ5wOp8kl8gsH5WUmMvf2Xbt5wvQ&oe=69FB45F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xb9mBSdmFFQQ7kNvwEipP_J&_nc_oc=AdolyLmHTZNknbWap5wg4iKhlseviS3D1EB20Ex9hKVHQeyZKQBkYsTAtz5NcZbZjoA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w2PJYO-htiC-iZE2DopYaQTwTQ57js439bjNt9XYppQ&oe=69FB46DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42QQ59nlJkgQ7kNvwF4aD6a&_nc_oc=AdriWYoU08ZCsygWOGYMns-JEupXiQkU57_HsS0gGQyg-2M0qzP1qmhJIQ7qczcqBp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G-UpVTiybu6WUwcoTMizzMTBph9jc-sAbJd7Ftc4yWA&oe=69FB409D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
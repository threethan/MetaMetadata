0a&_nc_ohc=-vypJOrU734Q7kNvwFUuYNs&_nc_oc=AdlxD_GvLu23I2PFxIBZGNEsxGxQZU6N1yUSPOIDj2O2CvgBX7GLPnrhSQjgaCnJdK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afub2Lcdpx4j_1jYSRDLKizRMM5Yqm-s9KIuEmwcC1qx7w&oe=699EF3D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1oMQSTpxSoQ7kNvwHpuf3v&_nc_oc=Adm6O9nWJsQxF4Vvga1h1EIQKNAQnOAzXQLa5u3ypfC_Z9MO94yWsW_TrAPR06jo-Zo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftAKzPCUVZaFc7l0PLhGkFaLO4rwuiixC_PhD-4i7v3Fw&oe=699F00F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HofkiAqPr7wQ7kNvwGpzD3e&_nc_oc=AdnPLGvto1tNFDIF3A1KqWTDlyax3lPiL0bIY-gsg-vIrD8vQP2AAEkG0LOYj6iyWwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs1xtuo7r4q_HI7enVmqyTB3I_HtyhYju3gtAO_9A2OkQ&oe=699EFCF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUdsv3uF5eMQ7kNvwGMA7EE&_nc_oc=Adl48CDUYDSsBPd3DvFcMzFaR5Z-syuyScNLEsxE1EgQ0RGrEcYeo3_zv1Ep2uA1NsU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft7kvWOPpUTv8YkVoXwNfRPbDh_HIrg2vwL9vkNkRsyDw&oe=699EFDDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5XQt925e2IQ7kNvwEFsVx7&_nc_oc=AdkeXFa8IYEiGZyU-9JKQHh3cZiqBNODcQ2pVWe-EeF9GIW_V_67328VcqJo3P2OWCc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvvgHU9xuoIggGP8J6hZ-DFtn1QpPLcZwzcYA5EwqDWdw&oe=699EF79D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [
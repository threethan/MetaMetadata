dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iy3y1N6mDFsQ7kNvwGbaXA1&_nc_oc=AdoGcHothbHYk3BRRLWdKwfevk19mWUdjEFv0__bsC05ZXqKyrMNuRBQOa3Km2B4JKQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0u3dtv2-E4Syn2MtcWoSigWbWpuVmcAm8x4f8_qcQ6Q&oe=6A68A951"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDFCyqtR9RUQ7kNvwELC-B1&_nc_oc=Adp8xuN5UEgntARnY_Q1Bgai9EgeOP3qfQ2mbakeyf4x9qG6rcsm7Hu4jnmp8KJijRM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNiGI3sh_2MGrVl7G55YuejXT7v0O9u_-tdsF2Qf912g&oe=6A68B674"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ASNKWGN85EQ7kNvwEe0tkN&_nc_oc=AdrJmfRbwH6KGGyHb_v06j9-3P28nBOdHzZgKGxVo9yw8KB_ArCQYpZPjIrMUq4U3EI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHU2CQG9u9Ay2kA60nhXccHilr2XcKbQEDTHzYDXOvDw&oe=6A68B276"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocqnnUanIX4Q7kNvwF9Q15W&_nc_oc=Adr9YK8MkJrPaVPqkSEbjcKktenqSqNN10E1-FZIOGFYY8Rib1zZPwCUw751G0ruYpE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEvuOamzolxvm6JngOhD-hPEGDpg6-eA9KZq1-TAXS7g&oe=6A68B35F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1-ZHAVffy8Q7kNvwF-aNwS&_nc_oc=AdrUBTg982Vf3jlg8Q0nNZKicod9-tLdPNpl9176fKqYuyevEUQ0QY1ESUa45xEYfkE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVMScdaUdIPLlA9X2Wn7g3EOg0mSJcpkOrEApTxp86uA&oe=6A68AD1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
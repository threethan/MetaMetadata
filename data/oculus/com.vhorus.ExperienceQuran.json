dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwVcECTGZOgQ7kNvwGEAk2D&_nc_oc=Adps1pPbvFQi8i-28exk79XdRI2dVKvRByOSi-J-Kl27I-8IPQ9WSqH9jjBR7VfiAEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4b2VnXuYL0VdZTksU4RJkDvP3Nc4tYGt6XjQAdRefzw&oe=6AF4A091"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A8SO5TxA3UQ7kNvwFGVUxE&_nc_oc=Adq9NhIGplYuMhn4UXVZTlR10sRc2cesyeG70tpFiQ0aCynn7Eu7gVRU6ODs-OGdOGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiOo_GG5hGcIorQnc1lr2_2BpVzCtWh7JTEC8Qi-IAkg&oe=6AF47574"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-O8EcDKj6E8Q7kNvwH6kS8b&_nc_oc=Adqb4V5lZCZTW3fTVtTp4eF83dCXu7DsrxFYTwtJf7ZA-gSw_zm4tacOaxrnb_4H-Xk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaHWEe3jIcr3E2JY0PuIBlgyKx8142eNVD3_UPVmp_xg&oe=6AF47176"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtMFe9atPtAQ7kNvwE5V04Y&_nc_oc=Adq0miunF3z_uNzYjV9QiwyVad5uCvpA-uHggOjBZUQb3NGi-39vIIEsVtvjE0ioH3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLYV7dQz1vpaAO_62JTK6n0uPru0UKADtR2a5819DCkg&oe=6AF4725F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdhQZVuhUoIQ7kNvwHv-2Z-&_nc_oc=Adp3x0_lOwob9uOPvuayh0hnIWJOBVoOjfyd6qGyTrgtFu00vqU1AQ-_SDQEnhjfO3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgh0_L9MEMkvvy1JgQVrWhdetkue4vn4YzF-EMnR5ohQ&oe=6AF4A45D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-c6FEEmLrcEQ7kNvwF8fM1u&_nc_oc=AdptS0Ru1SLvv1y2lN5UpxMcMklYqT4cOEMU_S2QV7V51pyyXdyFXEY25vtHC9bNZCU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqt1DuWDafSzkwXaxpPbtiuXWC4NVOyUgCw8MWudHMNg&oe=6AC7CD91"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vwL8g2Xh9IQ7kNvwHt-3-t&_nc_oc=AdpP7a_naG4S0M0uvmb16h07i87QosB7CEPQ9HBoo2lvAnKNgA8XDhXWBdbcBqy6Swg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNU_dzhjduJfmdPCPTs8OpXByvGPrEsNdwuC-Gmum_bpg&oe=6AC7A274"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ngm37kp8bfIQ7kNvwEdhQfl&_nc_oc=AdpaxjtRXThJ9qESpTIlFCNmui2wl9HiYEKW22zjwYHzboxihEmlI7mcrdCka_PTPQ8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSeZQzhI_9CKpQ7yetSRDWvdXfeedApc62Incb1Pkv3w&oe=6AC79E76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddmD0ZTt8OgQ7kNvwFRaZ7_&_nc_oc=Adp5GpsTYLg2_-OpkpFPUhB_Hct8YFbATduru_zjyaSDNj2kCxwGNkKkJsm2SiNZpwk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsgkrk3Nv_BWg9lA8ejo11F_MUQqLTJd0rBWlFi_w3_Q&oe=6AC79F5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPPzP4X_CY4Q7kNvwFlwMFb&_nc_oc=Adp1pwByZkd_DqOClw6bZ1tpYlC7aiyW-vRhUY0GGMng4Lx3acbQDQ5DEmTy4HzSzfs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0r2YPScw5QDUCusmxw6W7b_EjJ-U5fK0QNSs1_AeCNw&oe=6AC7991D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
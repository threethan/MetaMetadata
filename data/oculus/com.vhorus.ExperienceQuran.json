dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AwQ1nYdL1QQ7kNvwFB58HZ&_nc_oc=AdolfGORr56JVGJgeudWL3bwW5jEUNfVf6-veEZNx0WXX929Kj0KLY2rg8qYd89JzJc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7n7oVxhfSU3ilfkeHwpAbwXFIMSKV9LbekjJQGB_wdg&oe=6AAA9451"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvOd7XSpQNYQ7kNvwGWLOC4&_nc_oc=Ado02JVqCXX6_qx7qSmuoEEnxrpzt25vUREJlGqmzHeY7nfRNXUkHpFSToCbjEa0kgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLor3-thOB3LifDHzix7x3hJxxhOd0IBeOLc6cTCprVcA&oe=6AAAA174"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQcw-YON2kYQ7kNvwEDKqDG&_nc_oc=AdqDoH1klJOXUz44qI_IPW8kpjXeDRIKTxRQtuBff6m3Rp-VDZuG_NtFzqMEiwkdaVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa5IQQGmjp8ThTe_ZnlD9Z37OF3L6dITH8qfRx5hwKgw&oe=6AAA9D76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFfR5ZPs_q4Q7kNvwES5w0s&_nc_oc=AdrOlWnSsPYCeavkI1q9ROObiDVznWjN7TFpWNnm-LFKGAHVf9Zu4RdhdMKxaY_yCcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDScseAipyxv7mjsMt0DnK-euLUp8qsfkwVwZic62RcA&oe=6AAA9E5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CeV7DEVrwEQ7kNvwF0OUtD&_nc_oc=Adors1XvzK11D5aUJf7PG5tX9Ie5zSNOJrYrX4yL7tWe07mj3JiVnAyJtL8UxZPwqzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH4Kxj_m50I0ppp-fj_vL0zM7nNcNDnOQmvOUdZyKJvg&oe=6AAA981D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
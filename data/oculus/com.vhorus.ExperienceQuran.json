0a&_nc_ohc=6Jp8_HUN2N0Q7kNvwHun7yo&_nc_oc=AdlzIVdOnqMTk7CIc0XOAwSvfqc3hXmjZuwZEn1x3dT-_WYdNqDU3hcQaeEuwKijg-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft4iRYeT_TCuwLTXCztzPNHh31iBY-Z3XL97loAquwCdQ&oe=69A439D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIdxMu8P9fYQ7kNvwHv0ghz&_nc_oc=AdmvKCCGpkp2AaNUHU6nBsGK-nBu1C8T7Fym329LXdvfIJoEhnabJNgeNDFr4-mWl9U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuaUUdkxyVSLkVkO0cgPuf-m3IYYLZ6PojK5Q0pUFe6dg&oe=69A446F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU4Mlxi7tCQQ7kNvwFhJJb0&_nc_oc=AdnEYdsbYULt5vVSRpR0C46Sf2_pilfTFecH_LNm5GnuqVZfq031inhMnzbKUFH--DE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsxbFh1A8TujMSdQLce6zLOMDGTzGX89IJVBHgWojIbWg&oe=69A442F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW9w9P5RXP8Q7kNvwE4FqNY&_nc_oc=AdkMJFv9sBbYD1V8_D0LgpyAYh8poohhH9z2ihMCLRxNZFqe0JJ8UAPau02oTcG8i0g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvZi4s8YpWSQzRCPkM296rDKdgdpm4Dvv8zShlJ-9FxnQ&oe=69A443DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXqWeNWLQWgQ7kNvwHGhM8H&_nc_oc=AdnhggzIatsugQ5iqHwvvK3sJAhs02BFiAIPD2MZiM2ztH3C20L8k6aGkGrsTEljDg0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvgPxIY-DuxDgioNVyNkgv3Uo1LQs_i0jYn3oZv_SyGXQ&oe=69A43D9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [
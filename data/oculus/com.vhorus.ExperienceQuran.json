dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj4r8dLDkwwQ7kNvwH4FmHI&_nc_oc=AdqmE7Q230WGaucT15cHpaG65UaHq8odXulIwBpsP4-SnKN8RcwPpD4xHp2oCAKXYQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNsebDbGucOa7vLJHuVYwYw-6WVBQ8ngF4hjsk2xNI6w&oe=6A733551"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FGHp2iknHIQ7kNvwH04XcU&_nc_oc=AdrgDtMbGrmw14K541qlkbD6kMl8drKcd3VPY2he87f0s6uKJ-s3AckJOiutwb_rYjk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdvLZJrwimC8cP88uSv9dHZwhJ_fGK0DRwh1P0SVqHtg&oe=6A734274"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZHqWBk_LkMQ7kNvwEeCh3N&_nc_oc=AdpRnpJIz4N5K9JGAqwNIF7pBz6GqbuMr84FtwJyBzildEDt26vR_zlhMUxOe9EfLx4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhgiBFspjBnhjTV0FwSg5OdjbabanSEr3gI7yORNLvUw&oe=6A733E76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY_kyf1ZI9QQ7kNvwGvq1oK&_nc_oc=Adp3RhNJS9xornJkTgz2b8qN-KVlZMdNohIN4T_7NtL19OzrSZCU7W2iWRHFWkDg7Zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAntZXukyxUni4hb5r_HumqMKx-vbAkDcPBbh3jYtj-A&oe=6A733F5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KutWsGFR0SUQ7kNvwFczTyz&_nc_oc=AdrwbARyLem9WrAP_eyA_WpA4ejU5kJFLraodWv2PL08WWu8sFPmW68WPM07NZVRXjA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIcfcrgxNjmFrD2AanW5XLWgY2CejEJ1uYo3382m7eTQ&oe=6A73391D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
dn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baQ5rtYPFfoQ7kNvwFQdrFb&_nc_oc=AdpBAICvTFx2BqN7jGJfYFxTEzi2HyP-dRWUrS62swwaAXSjTbOMmteI1rIJJQ2pNaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPpgdI0gz4WPBLhA4T1YjgJ3-Rsy5RVM5ktDCF_fg9PQ&oe=6A64B4D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KO9w6A8qF8QQ7kNvwHWjVh8&_nc_oc=Adr91fXMmXQdpTUzIbIWPYthCQF4gpvhxmLGPvStO_bPwH_JOKo1PN-Zu2NsNi5Ms40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHyiUeLdWH1PZLKVRulBbrOzvDw9jzbDf4k0_s14_nDQ&oe=6A64C1F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=194rBQheAREQ7kNvwF51xA5&_nc_oc=Adqnogx4D6IsrRyqSinCUcIimpfLo0ka3bRPZ3NVRI-SiOTUnkvgeebw22pOSDx_lgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoQmNnlHlWtkYzSVWalum6FqQ-7zEtQEjeR-9w73NOeg&oe=6A64BDF6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MF4tpZfvadgQ7kNvwFxoGA5&_nc_oc=Adppc43YFIcSFecZVtUl_ZkLHrthwBHjvQORWtEQiVfbzbANEfBxgniapZSMT0eJOZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDRWxlivFxoEOyc77NIKU8t45LySPATHN7tfAgU0KTsA&oe=6A64BEDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cI0N1K-DTjYQ7kNvwFRcLVx&_nc_oc=Ado961ALKjOBI7e1PusLGlcMW5GnVLshGjK2iXIjB26jH_n5OjGpTr9x8mfZFDJZzMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBc62qlNkepUWMz5H7jyDfudSRwM_NzHgUR1er_YYAO0Q&oe=6A64B89D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
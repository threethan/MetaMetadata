1.oculuscdn.com/v/t64.5771-25/11162718_352346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFp6Rz9LZv4Q7kNvwF_jHdA&_nc_oc=AdqcsEUpUSfehuu85pESxf6X9j2O3Q9fGdtQuScFeePwsGFS17qp_X4IX_yJESXGDVQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QLV2QZ10JFpuleWqu3kb9BjXosu5zg9K8e_47Ag1mdA&oe=6A11A651"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSr1kL8N0ssQ7kNvwEO93rv&_nc_oc=AdpsASqgQjGqhTiobHS64jrdf_UcdSOmvyyy4xtBQl0wrYyPl88OU0fmu5OEzBLT3No&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gqg6AB_7S45mJ0CMQKin3a_wxz33AbNfN-mApdCeUQQ&oe=6A11B374"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLxXhh4ficYQ7kNvwE7cL9t&_nc_oc=AdrJVdB5M09MxZ0SUzLQeN_PVLv_VYvhGUElVKGDMO4xPAHV255U3xb_5QgpqT3jMKM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h9cZZH-uwRlHFo7UFPPxKvIOk5IIpSPKKtLtiHsW0yA&oe=6A11AF76"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fkqI3_7AmEQ7kNvwFybmmd&_nc_oc=AdpRhxJKpISqa3hJMYXcJ3AeUkA0d4FndlQqKcaLZGI0RAN2ErQkaMn1cFFXBTrveec&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zq8Xd9UypjujLh3-rpokrHkBoC30-QTyW0hSBBF-J-w&oe=6A11B05F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl6ozToqSnsQ7kNvwEzjY_r&_nc_oc=Ado0aAGztJSrkfNdZfkOdJ_dNagknb094L5TBKbYuxygHQzn8hUDzUVtu1Ere8dq0NQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67O5G3kFzTxgezK6W-qwiRU1Kj4DxRrmENkZaDmFLZ0A&oe=6A11AA1D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics":
2346495204055_5009362675361120256_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxrCsiW61JcQ7kNvwGWrtbS&_nc_oc=AdnSAj95F_JifMu9slNrlU5p87gm-Dckz3HCl8bXg4DVQwTpc_wmhcr72LIjncSX7oc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYCKGU-49qLVHVusImdIg2s7FO0ZaBCK5E9nJZG9MO5Q&oe=69BE97D1"}, {"file_name": "migrated_image.png", "id": "614875575758628", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162704_1916690518594793_1766586509168738304_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptF3GvXCCCwQ7kNvwEeF3-v&_nc_oc=AdkZ7AIwZgcxfsx7PCtyzDzHDQw6MEa22YrPmQ5672fa04EFJ90yUAIB3ClzEJI57C4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpFzCgPEmipsJGsP7EKmgPrOuDQkc2LEv6QCWtk6zHqw&oe=69BEA4F4"}, {"file_name": "migrated_image.png", "id": "529818874618890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162731_130672431003308_8721812481946681344_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6XmBt6BK44Q7kNvwELdXUQ&_nc_oc=Adn3qf1qQbCdCw0WJ94KHS_n9m1k-1OV3GCiyd4Lctz0dh9IywD2b5MT5G1fNVRKAjQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVvTu1CEcDeNxf6byKKLN-wEVL4-J6i44-CfP2ROBMPw&oe=69BEA0F6"}, {"file_name": "migrated_image.png", "id": "235745147598562", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162695_267664700305002_7282962235507343360_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBSkE698SaEQ7kNvwHxv50H&_nc_oc=AdnQpYIQGKdyVGqAanbKRk08_ufpf3oL4_8hhgVO3wYphgydvgcSMKTulTPteLDXWYE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWkdm14pEeM5RXJdOv7vSQbQ8bdIjp8Dn1ycRuk3G3Lw&oe=69BEA1DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1_00174.png", "id": "126996218029888", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162766_126996221363221_8242773957422350336_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AUcgRRCfRwQ7kNvwGuiyuf&_nc_oc=AdlpNrOdu0RfchuLfy_QvFvrExH7whlKlvDkUkVmTg8TvsYxl6etOeAGMaSZ0Kd-cg4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCuR78PNs6udLFn7nCeuJ6pY9ck5aJhc-AvIaGTdKDlQ&oe=69BE9B9D"}, "display_name": "Experience Quran", "keywords": ["Quran", "Experience", "Vhorus", "Makkah", "Elephant"], "long_description": "Have you ever imagined the stories and miracles of the Holy Quran while reading them? Well, imagine this: you now get to live and experience these incredible stories while exploring their every detail brought to life.\n\nFrom the company that brought you \"Experience Makkah\", now brings you another incredible VR project: Experience Quran. The experience introduces the miracles and awe-inspiring stories of the Holy Quran using immersive, 360-degreed and storytelling techniques.\n\n\"Elephant Year\u201d follows the story of Abraha Al-Ashram, the oppressive King of Yemen, when he led a large army of vicious soldiers and elephants to attack the holy city of Makkah in order to destroy Al Ka\u2019aba.\n\nOnce you put the gear on, you will be faced with Abraha sitting on his throne, declaring war against Makkah to demolish the holy house of worship, Al Ka\u2019aba, as a way of claiming the pilgrims\u2019 congregate at Al-Qulais - a house of worship he had built himself - instead of at Al Ka`bah.", "short_description": "Introducing the miracles of the holy Quran using immersive, 360 storytelling."}]}, "developer_name": null, "developer_privacy_policy_url": "http://vhorus.com/privacy.html", "developer_terms_of_service_url": "http://vhorus.com/tos.html", "publisher_name": "Vhorus", "support_website_url": null, "website_url": "http://vhorus.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n